+        executorCalls.push(input);
+        return `sunny in ${String(input.location)}`;
+      }
+    );
+
+    let rejectionSeenByProvider = '';
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        round += 1;
+        if (round === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}};
+          yield STOP_FOR_TOOL;
+          return;
+        }
+        if (round !== 2) {
+          yield {type: 'text', text: 'It is sunny in Berlin.'};
+          yield STOP_DONE;
+          return;
+        }
