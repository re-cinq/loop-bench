+    );
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({
+      executorCalls,
+      mentionsLocationAndRequired: response.result.includes('location') && /required/i.test(response.result),
+    }).toEqual({
+      executorCalls: 0,
+      mentionsLocationAndRequired: true,
+    });
+  });
+
+  it('passes valid input with an unlisted extra property through to the executor unchanged', async () => {
+    const registry = new ToolRegistry();
+    const receivedInputs: Array<Record<string, unknown>> = [];
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+            units: {type: 'string', enum: ['celsius', 'fahrenheit'], default: 'celsius'},
+          },
+          required: ['location'],
+        },
+      },
+      async input => {
+        receivedInputs.push(input);
+        return 'ok';
+      }
+    );
+
+    const rejectedEnum = await registry.execute('get_weather', {location: 'Berlin', units: 'kelvin'});
+    const response = await registry.execute('get_weather', {location: 'Berlin', extraKey: 42});
+
+    expect({
+      rejectedMentionsUnits: rejectedEnum.result.includes('units') && rejectedEnum.result.includes('celsius'),
+      response,
+      receivedInputs,
+    }).toEqual({
+      rejectedMentionsUnits: true,
+      response: {result: 'ok'},
+      receivedInputs: [{location: 'Berlin', extraKey: 42}],
+    });
+  });
+
+  it('rejects a wrong-typed field naming the field path and expected type without leaking the offending value to the result or logs', async () => {
+    const recordedLogs: string[] = [];
+    const recordLine = (category: string, message: string, fields?: Record<string, unknown>) => {
+      recordedLogs.push(JSON.stringify({category, message, fields}));
+    };
+    const logger: Logger = {
+      debug: recordLine,
+      info: recordLine,
+      warn: recordLine,
+      error: recordLine,
+    };
+    setLogger(logger);
+
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'lookup_patient',
+        description: 'Look up a patient by identifier',
+        inputSchema: {
+          type: 'object',
+          properties: {patientId: {type: 'string'}},
+          required: ['patientId'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'found';
+      }
+    );
+
+    const response = await registry.execute('lookup_patient', {patientId: 987654321});
+
+    expect({
+      executorCalls,
+      mentionsField: response.result.includes('patientId'),
+      mentionsType: response.result.includes('string'),
+      leaksValueInResult: response.result.includes('987654321'),
+      leaksValueInLogs: recordedLogs.some(line => line.includes('987654321')),
+    }).toEqual({
+      executorCalls: 0,
+      mentionsField: true,
+      mentionsType: true,
+      leaksValueInResult: false,
+      leaksValueInLogs: false,
+    });
+  });
+
+  it('throws Unknown tool: <name> when executing an unregistered tool', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('nonexistent_tool', {})).rejects.toThrow('Unknown tool: nonexistent_tool');
+  });
+
+  it('throws at registration time naming the tool for an uncompilable schema', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_lookup',
+          description: 'Tool with an invalid JSON Schema type',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              query: {type: 'not-a-json-schema-type'},
+            },
+          },
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken_lookup/);
+  });
+
+  it('compiles a static tool schema once across ten execute calls', async () => {
+    const registry = new ToolRegistry();
+    let schemaReads = 0;
+    const rawSchema: Record<string, unknown> = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    const definition: ToolDefinition = {
+      name: 'get_weather',
+      description: 'Get weather for a location',
+      get inputSchema(): Record<string, unknown> {
+        schemaReads += 1;
+        return rawSchema;
+      },
+    };
+
+    registry.register(definition, async input => `weather:${String(input.location)}`);
+
+    for (let i = 0; i < 10; i += 1) {
+      await registry.execute('get_weather', {location: `city-${i}`});
+    }
+
+    expect(schemaReads).toBe(1);
+  });
+
+  it('validates a function-valued tool definition against the schema returned for each call', async () => {
+    const registry = new ToolRegistry();
+    let activeSchema: Record<string, unknown> = {
+      type: 'object',
+      properties: {city: {type: 'string'}},
+      required: ['city'],
+    };
+
+    registry.register(
+      () => ({
+        name: 'dynamic_weather',
+        description: 'Dynamic weather tool',
+        inputSchema: activeSchema,
+      }),
+      async () => 'ok'
+    );
+
+    const firstCallValid = await registry.execute('dynamic_weather', {city: 'Berlin'});
+
+    activeSchema = {
+      type: 'object',
+      properties: {postalCode: {type: 'number'}},
+      required: ['postalCode'],
+    };
+
+    const secondCallRejected = await registry.execute('dynamic_weather', {city: 'Berlin'});
+    const thirdCallValid = await registry.execute('dynamic_weather', {postalCode: 10115});
+
+    expect({
+      firstResult: firstCallValid.result,
+      secondMentionsPostalCode:
+        secondCallRejected.result.includes('postalCode') && /required/i.test(secondCallRejected.result),
+      thirdResult: thirdCallValid.result,
+    }).toEqual({
+      firstResult: 'ok',
+      secondMentionsPostalCode: true,
+      thirdResult: 'ok',
+    });
+  });
+});
