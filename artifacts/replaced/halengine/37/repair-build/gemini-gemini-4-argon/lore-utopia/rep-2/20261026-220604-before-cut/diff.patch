+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+
+describe('ToolRegistry', () => {
+  afterEach(() => {
+    setLogger(undefined);
+  });
+
+  it('throws at registration time naming the tool for an uncompilable schema', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_lookup',
+          description: 'Tool with an invalid JSON Schema type',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              query: {type: 'not-a-json-schema-type'},
+            },
+          },
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken_lookup/);
+  });
+
+  it('passes valid input including undeclared extra properties through to the executor without coercing or applying defaults', async () => {
+    const registry = new ToolRegistry();
+    const receivedInputs: Array<Record<string, unknown>> = [];
+    registry.register(
+      {
+        name: 'search_docs',
+        description: 'Search documentation',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            query: {type: 'string'},
+            mode: {type: 'string', enum: ['exact', 'fuzzy'], default: 'fuzzy'},
+            limit: {type: 'number', default: 10},
+          },
+          required: ['query'],
+        },
+      },
+      async input => {
+        receivedInputs.push({...input});
+        return {result: 'matched', clientMessages: [], suppressAssistantResponse: false};
+      }
+    );
+
+    const response = await registry.execute('search_docs', {
+      query: 'tools',
+      mode: 'exact',
+      undeclaredExtra: 'preserved',
+    });
+
+    expect({response, receivedInputs}).toEqual({
+      response: {result: 'matched', clientMessages: [], suppressAssistantResponse: false},
+      receivedInputs: [{query: 'tools', mode: 'exact', undeclaredExtra: 'preserved'}],
+    });
+  });
+
+  it('rejects an invalid enum value naming the field and allowed values without leaking the offending value', async () => {
+    const recordedLogs: string[] = [];
+    const recordLine = (category: string, message: string, fields?: Record<string, unknown>) => {
+      recordedLogs.push(JSON.stringify({category, message, fields}));
+    };
+    const logger: Logger = {debug: recordLine, info: recordLine, warn: recordLine, error: recordLine};
+    setLogger(logger);
+
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'set_mode',
+        description: 'Set mode',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            target: {
+              type: 'object',
+              properties: {
+                mode: {type: 'string', enum: ['safe', 'strict']},
+              },
+              required: ['mode'],
+            },
+          },
+          required: ['target'],
+        },
+      },
+      async () => 'updated'
+    );
+
+    const enumRejection = await registry.execute('set_mode', {target: {mode: 'secret-token-value'}});
+    const nestedMissingRejection = await registry.execute('set_mode', {target: {}});
+
+    expect({
+      mentionsEnumField: enumRejection.result.includes('target.mode'),
+      mentionsAllowedValues: enumRejection.result.includes('safe') && enumRejection.result.includes('strict'),
+      leaksOffendingEnumValue:
+        enumRejection.result.includes('secret-token-value') ||
+        recordedLogs.some(line => line.includes('secret-token-value')),
+      mentionsNestedRequiredField: nestedMissingRejection.result.includes('target.mode'),
+    }).toEqual({
+      mentionsEnumField: true,
+      mentionsAllowedValues: true,
+      leaksOffendingEnumValue: false,
+      mentionsNestedRequiredField: true,
+    });
+  });
+
+  it('throws Unknown tool when execute is called with an unregistered tool name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('missing_tool', {})).rejects.toThrow('Unknown tool: missing_tool');
+  });
+
+  it('compiles a static tool inputSchema once at register time and does not re-read it on execute', async () => {
+    const registry = new ToolRegistry();
+    let schemaReads = 0;
+    const definition = {
+      name: 'cached_tool',
+      description: 'Checks static schema caching',
+      promptInstructions: 'Use cached_tool when testing.',
+      examplePrompts: ['Run cached_tool'],
+      get inputSchema(): Record<string, unknown> {
+        schemaReads += 1;
+        return {
+          type: 'object',
+          properties: {id: {type: 'string'}},
+          required: ['id'],
+        };
+      },
+    };
+
+    registry.register(definition, async input => `ok:${String(input.id)}`);
+    const readsAtRegister = schemaReads;
+    const first = await registry.execute('cached_tool', {id: 'a'});
+    const second = await registry.execute('cached_tool', {id: 'b'});
+    const registered = registry.get('cached_tool');
+
+    expect({
+      readsAtRegister,
+      readsAfterExecutes: schemaReads,
+      firstResult: first.result,
+      secondResult: second.result,
+      hasTool: registry.has('cached_tool'),
+      missingGet: registry.get('nonexistent'),
+      registeredName: registered?.definition.name,
+      promptInstructions: registry.getPromptInstructions(),
+      examplePrompts: registry.getExamplePrompts(),
+    }).toEqual({
+      readsAtRegister: 1,
+      readsAfterExecutes: 1,
+      firstResult: 'ok:a',
+      secondResult: 'ok:b',
+      hasTool: true,
+      missingGet: undefined,
+      registeredName: 'cached_tool',
+      promptInstructions: ['cached_tool: Use cached_tool when testing.'],
+      examplePrompts: ['Run cached_tool'],
+    });
+  });
+
+  it('validates against the current schema of a function-valued ToolDefinitionSource and caches validators by schema reference', async () => {
+    const registry = new ToolRegistry();
+    const schemaV1: Record<string, unknown> = {
+      type: 'object',
+      properties: {code: {type: 'string'}},
+      required: ['code'],
+    };
+    const schemaV2: Record<string, unknown> = {
+      type: 'object',
+      properties: {code: {type: 'number'}},
+      required: ['code'],
+    };
+    let activeSchema = schemaV1;
+
+    registry.register(
+      () => ({
+        name: 'dynamic_tool',
+        description: 'Switches schema dynamically',
+        inputSchema: activeSchema,
+      }),
+      async input => `code:${String(input.code)}`
+    );
+
+    const v1Valid = await registry.execute('dynamic_tool', {code: 'abc'});
+    const v1CachedValid = await registry.execute('dynamic_tool', {code: 'def'});
+    activeSchema = schemaV2;
+    const v2RejectsString = await registry.execute('dynamic_tool', {code: 'abc'});
+    const v2AcceptsNumber = await registry.execute('dynamic_tool', {code: 42});
+
+    expect({
+      v1Valid: v1Valid.result,
+      v1CachedValid: v1CachedValid.result,
+      v2RejectedCodeAsNumber: v2RejectsString.result.includes('code') && v2RejectsString.result.includes('number'),
+      v2AcceptsNumber: v2AcceptsNumber.result,
+    }).toEqual({
+      v1Valid: 'code:abc',
+      v1CachedValid: 'code:def',
+      v2RejectedCodeAsNumber: true,
+      v2AcceptsNumber: 'code:42',
+    });
+  });
+});
