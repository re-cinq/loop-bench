+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry', () => {
+  it('throws at registration time naming the tool for an uncompilable schema', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_lookup',
+          description: 'Tool with an invalid JSON Schema type',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              query: {type: 'not-a-json-schema-type'},
+            },
+          },
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken_lookup/);
+  });
+
+  it('passes valid input with an unlisted extra property through to the executor unchanged, exactly once', async () => {
+    const registry = new ToolRegistry();
+    const executorInputs: Array<Record<string, unknown>> = [];
+    registry.register(
+      {
+        name: 'passthrough_tool',
+        description: 'Requires a location string',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async input => {
+        executorInputs.push(input);
+        return 'ok';
+      }
+    );
+
+    const response = await registry.execute('passthrough_tool', {location: 'Paris', extra: 42});
+
+    expect({response, executorInputs}).toEqual({
+      response: {result: 'ok'},
+      executorInputs: [{location: 'Paris', extra: 42}],
+    });
+  });
+
+  it('throws Unknown tool for a name that was never registered', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('ghost_tool', {})).rejects.toThrow('Unknown tool: ghost_tool');
+  });
+
+  it('compiles a static tool schema once at register and reuses it across ten execute calls', async () => {
+    const registry = new ToolRegistry();
+    let schemaReads = 0;
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Requires a location string',
+        inputSchema: {
+          get type(): string {
+            schemaReads += 1;
+            return 'object';
+          },
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async () => 'ok'
+    );
+    const readsAfterRegister = schemaReads;
+    const results: string[] = [];
+    for (let round = 0; round < 10; round++) {
+      const response = await registry.execute('get_weather', {location: 'Paris'});
+      results.push(response.result);
+    }
+
+    expect({schemaReads, results}).toEqual({
+      schemaReads: readsAfterRegister,
+      results: Array<string>(10).fill('ok'),
+    });
+  });
+
+  it('validates a function-valued definition against the schema returned for that call', async () => {
+    const registry = new ToolRegistry();
+    const schemas = [
+      {type: 'object', properties: {first: {type: 'string'}}, required: ['first']},
+      {type: 'object', properties: {second: {type: 'string'}}, required: ['second']},
+    ];
+    let nextSchema = 0;
+    const executorInputs: Array<Record<string, unknown>> = [];
+    registry.register(
+      () => {
+        const schema = schemas[nextSchema] ?? schemas[schemas.length - 1];
+        nextSchema += 1;
+        return {
+          name: 'shifting_tool',
+          description: 'Returns a different schema on each call',
+          inputSchema: schema,
+        };
+      },
+      async input => {
+        executorInputs.push(input);
+        return 'ok';
+      }
+    );
+
+    const rejected = await registry.execute('shifting_tool', {first: 'a'});
+    const accepted = await registry.execute('shifting_tool', {second: 'b'});
+
+    expect({
+      rejectionText: rejected.result,
+      acceptedText: accepted.result,
+      executorInputs,
+    }).toEqual({
+      rejectionText: expect.stringMatching(/second.*required|required.*second/),
+      acceptedText: 'ok',
+      executorInputs: [{second: 'b'}],
+    });
+  });
+});
