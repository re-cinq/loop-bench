index 0000000..2cad006
--- /dev/null
+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,147 @@
+import {spawnSync} from 'node:child_process';
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const definition = (inputSchema: Record<string, unknown>): ToolDefinition => ({
+  name: 'weather',
+  description: 'Weather by location',
+  inputSchema,
+});
+
+// An accessor observes schema traversal without replacing the validator or its compiler.
+function observedSchema(type: string) {
+  let reads = 0;
+  const schema = {
+    type: 'object',
+    required: ['location'],
+    properties: {
+      location: {
+        get type() {
+          reads += 1;
+          return type;
+        },
+      },
+    },
+  };
+  return {schema, reads: () => reads};
+}
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#1
+it('rejects malformed input privately and passes valid input unchanged', () => {
+  const child = spawnSync(
+    process.execPath,
+    [
+      '--import',
+      'tsx',
+      '--input-type=module',
+      '-e',
+      `
+      import {ToolRegistry} from './src/orchestration/tools/registry.ts';
+      const registry = new ToolRegistry();
+      const received = [];
+      registry.register({
+        name: 'weather', description: 'Weather by location',
+        inputSchema: {
+          type: 'object', required: ['location'], properties: {
+            location: {type: 'string', enum: ['Berlin', 'Paris']},
+            units: {type: 'string', default: 'metric'},
+          },
+        },
+      }, async input => {
+        received.push(structuredClone(input));
+        return JSON.stringify(input);
+      });
+      const rejected = [];
+      for (const input of [{}, {location: 8675309}, {location: 'alex.private@example.org'}]) {
+        rejected.push(await registry.execute('weather', input));
+      }
+      const rejectedCalls = received.length;
+      const valid = {location: 'Berlin', extra: {untouched: '123'}};
+      const accepted = await registry.execute('weather', valid);
+      let unknown;
+      try { await registry.execute('missing', {}); } catch (error) { unknown = error.message; }
+      process.stdout.write('ACCEPTANCE_RESULT=' + JSON.stringify({rejected, rejectedCalls, accepted, received, valid, unknown}) + '\\n');
+      `,
+    ],
+    {cwd: process.cwd(), encoding: 'utf8', env: {...process.env, LOG_LEVEL: 'debug'}}
+  );
+  expect(child.status).toBe(0);
+  const lines = child.stdout.split('\n');
+  const report = lines.find(line => line.startsWith('ACCEPTANCE_RESULT='));
+  expect(report).toBeDefined();
+  const actual = JSON.parse(report!.slice('ACCEPTANCE_RESULT='.length)) as {
+    rejected: {result: string}[];
+    rejectedCalls: number;
+    accepted: {result: string};
+    received: Record<string, unknown>[];
+    valid: Record<string, unknown>;
+    unknown: string;
+  };
+  expect(actual.rejected).toEqual([
+    {result: expect.stringMatching(/(?=.*location)(?=.*required)/is)},
+    {result: expect.stringMatching(/(?=.*location)(?=.*string)/is)},
+    {result: expect.stringMatching(/(?=.*location)(?=.*enum|.*allowed)/is)},
+  ]);
+  expect(actual.rejectedCalls).toBe(0);
+  const logs = lines.filter(line => !line.startsWith('ACCEPTANCE_RESULT=')).join('\n') + child.stderr;
+  for (const secret of ['8675309', 'alex.private@example.org']) {
+    expect(JSON.stringify(actual.rejected) + logs).not.toContain(secret);
+  }
+  expect(logs).toMatch(/location/i);
+  expect(logs).toMatch(/required/i);
+  expect(logs).toMatch(/string/i);
+  expect(logs).toMatch(/enum|allowed/i);
+  expect(actual.received).toEqual([{location: 'Berlin', extra: {untouched: '123'}}]);
+  expect(actual.valid).toEqual({location: 'Berlin', extra: {untouched: '123'}});
+  expect(actual.accepted).toEqual({result: JSON.stringify(actual.valid)});
+  expect(actual.unknown).toBe('Unknown tool: missing');
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#2
+it('compiles static schemas at registration and reuses them for ten calls', async () => {
+  const registry = new ToolRegistry();
+  expect(() =>
+    registry.register(definition({type: 'not-a-json-schema-type'}), async input => JSON.stringify(input))
+  ).toThrow(/weather/);
+  const observed = observedSchema('string');
+  registry.register(definition(observed.schema), async input => JSON.stringify(input));
+  const registrationReads = observed.reads();
+  expect(registrationReads).toBeGreaterThan(0);
+  for (let call = 0; call < 10; call += 1) {
+    await expect(registry.execute('weather', {})).resolves.toEqual({
+      result: expect.stringMatching(/(?=.*location)(?=.*required)/is),
+    });
+  }
+  expect(observed.reads()).toBe(registrationReads);
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#3
+it('validates each dynamic definition and caches by schema identity', async () => {
+  const registry = new ToolRegistry();
+  const strings = observedSchema('string');
+  const numbers = observedSchema('number');
+  let current = strings.schema;
+  const received: Record<string, unknown>[] = [];
+  registry.register(
+    () => definition(current),
+    async input => {
+      received.push(structuredClone(input));
+      return JSON.stringify(input);
+    }
+  );
+  const first = await registry.execute('weather', {location: 12});
+  expect(first).toEqual({result: expect.stringMatching(/(?=.*location)(?=.*string)/is)});
+  const stringReads = strings.reads();
+  expect(stringReads).toBeGreaterThan(0);
+  current = numbers.schema;
+  await expect(registry.execute('weather', {location: 'Berlin'})).resolves.toEqual({
+    result: expect.stringMatching(/(?=.*location)(?=.*number)/is),
+  });
+  const numberReads = numbers.reads();
+  expect(numberReads).toBeGreaterThan(0);
+  await expect(registry.execute('weather', {location: 12})).resolves.toEqual({result: '{"location":12}'});
+  current = strings.schema;
+  await expect(registry.execute('weather', {location: 'Berlin'})).resolves.toEqual({result: '{"location":"Berlin"}'});
+  expect(received).toEqual([{location: 12}, {location: 'Berlin'}]);
+  expect({strings: strings.reads(), numbers: numbers.reads()}).toEqual({strings: stringReads, numbers: numberReads});
+});