+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,129 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+import {setLogger} from '../../shared/logger.js';
+
+const definition = (inputSchema: Record<string, unknown>): ToolDefinition => ({
+  name: 'weather',
+  description: 'Return the weather for a location',
+  inputSchema,
+});
+
+const weatherSchema = (): Record<string, unknown> => ({
+  type: 'object',
+  properties: {
+    location: {type: 'string'},
+    units: {type: 'string', enum: ['metric', 'imperial'], default: 'metric'},
+  },
+  required: ['location'],
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#1
+it('rejects malformed tool input privately and passes valid input unchanged', async () => {
+  const registry = new ToolRegistry();
+  const received: Record<string, unknown>[] = [];
+  registry.register(definition(weatherSchema()), async input => {
+    received.push(structuredClone(input));
+    return 'forecast';
+  });
+  const logs: string[] = [];
+  const write = (category: string, message: string, fields?: Record<string, unknown>): void => {
+    logs.push(JSON.stringify({category, message, fields}));
+  };
+  setLogger({debug: write, info: write, warn: write, error: write});
+  try {
+    const missing = await registry.execute('weather', {});
+    const wrongType = await registry.execute('weather', {location: 981723645});
+    const wrongEnum = await registry.execute('weather', {location: 'Private address 728', units: 'secret-unit'});
+    const rejectedCalls = received.length;
+    const valid = {location: '123', extra: {identifying: 'Private extra 928'}};
+    const result = await registry.execute('weather', valid);
+    const unknown = await registry.execute('absent', {}).catch((error: Error) => error.message);
+
+    expect({missing: missing.result, wrongType: wrongType.result, wrongEnum: wrongEnum.result, rejectedCalls}).toEqual({
+      missing: expect.stringMatching(/(?=.*location)(?=.*required)/is),
+      wrongType: expect.stringMatching(/(?=.*location)(?=.*string)/is),
+      wrongEnum: expect.stringMatching(/(?=.*units)(?=.*(?:enum|allowed))/is),
+      rejectedCalls: 0,
+    });
+    expect(received).toEqual([valid]);
+    expect(valid).toEqual({location: '123', extra: {identifying: 'Private extra 928'}});
+    expect(result).toEqual({result: 'forecast'});
+    expect(unknown).toBe('Unknown tool: absent');
+    const diagnosticText = JSON.stringify({logs, missing, wrongType, wrongEnum});
+    for (const secret of ['981723645', 'Private address 728', 'secret-unit', 'Private extra 928']) {
+      expect(diagnosticText).not.toContain(secret);
+    }
+    expect(logs.join('\n')).toMatch(/location/);
+    expect(logs.join('\n')).toMatch(/required/);
+    expect(logs.join('\n')).toMatch(/string/);
+    expect(logs.join('\n')).toMatch(/units/);
+    expect(logs.join('\n')).toMatch(/enum|allowed/);
+  } finally {
+    setLogger();
+  }
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#2
+it('compiles static schemas at registration and reuses them for ten calls', async () => {
+  const registry = new ToolRegistry();
+  let schemaReads = 0;
+  const schema = {
+    ...weatherSchema(),
+    get required(): string[] {
+      schemaReads++;
+      return ['location'];
+    },
+  };
+  registry.register(definition(schema), async input => String(input.location));
+  const registrationReads = schemaReads;
+  const results = [];
+  for (let call = 0; call < 10; call++) {
+    results.push(await registry.execute('weather', {location: 'Berlin'}));
+  }
+  expect(registrationReads).toBeGreaterThan(0);
+  expect(schemaReads).toBe(registrationReads);
+  expect(results).toEqual(Array.from({length: 10}, () => ({result: 'Berlin'})));
+  expect(() => registry.register(definition({type: 'not-a-json-schema-type'}), async () => 'unused')).toThrow(
+    /weather/
+  );
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#3
+it('validates each dynamic definition and caches by schema identity', async () => {
+  const registry = new ToolRegistry();
+  const received: Record<string, unknown>[] = [];
+  let schemaReads = 0;
+  const firstSchema = weatherSchema();
+  const secondSchema = {
+    type: 'object',
+    properties: {station: {type: 'number'}},
+    get required(): string[] {
+      schemaReads++;
+      return ['station'];
+    },
+  };
+  let current = definition(firstSchema);
+  registry.register(
+    () => current,
+    async input => {
+      received.push(structuredClone(input));
+      return 'forecast';
+    }
+  );
+  await registry.execute('weather', {location: 'Berlin'});
+  current = definition(secondSchema);
+  const rejected = await registry.execute('weather', {location: 'Berlin'});
+  const afterCompilation = schemaReads;
+  await registry.execute('weather', {station: 42});
+  const afterReuse = schemaReads;
+  current = definition(firstSchema);
+  const restored = await registry.execute('weather', {station: 42});
+
+  expect({rejected: rejected.result, restored: restored.result, received}).toEqual({
+    rejected: expect.stringMatching(/(?=.*station)(?=.*required)/is),
+    restored: expect.stringMatching(/(?=.*location)(?=.*required)/is),
+    received: [{location: 'Berlin'}, {station: 42}],
+  });
+  expect(afterCompilation).toBeGreaterThan(0);
+  expect(afterReuse).toBe(afterCompilation);
+});