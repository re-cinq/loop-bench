+# Tool input validation
+
+| Field  | Value                |
+| ------ | -------------------- |
+| Issue  | re-cinq/HALEngine#37 |
+| Status | Draft                |
+
+The registry owns validation of model-supplied tool input against the same JSON Schema definition exposed to providers.
+
+## Execution contract
+
+- `execute` returns a `ToolResponse` describing required, type and enum failures before invoking an executor; rejection text and logs identify property paths and constraints without exposing input values, while accepted input (including extra properties) reaches the executor exactly once without coercion or inserted defaults, and an unknown name still throws `Unknown tool: <name>`. ([validated by: rejects malformed calls privately and passes accepted input unchanged](../../src/orchestration/tools/registry.acceptance.test.ts#L21)).
+- `register` rejects uncompilable static schemas immediately with the tool name in the error, and compiles a valid static schema once for reuse across executions. ([validated by: compiles static schemas at registration and reuses them for ten calls](../../src/orchestration/tools/registry.acceptance.test.ts#L69)).
+- Function-valued definitions resolve their current schema on every execution and reuse compilation by resolved schema object identity, so switching schemas never validates against a stale definition. ([validated by: validates each dynamic definition and caches by schema identity](../../src/orchestration/tools/registry.acceptance.test.ts#L92)).
+
+## Integration and delivery
+
+A validation rejection is an ordinary tool result available to the model for correction within the existing five-round default bound. The registry's one-line execution comment points to this contract. Executor failures are outside the validation contract; this does not promise to swallow arbitrary executor exceptions.
+
+The implementation uses a runtime JSON Schema dependency (prefer Ajv), updates README.md, docs/adding-a-tool.md and .specify/spec.md, and supplies a consumer-facing changelog and MINOR migration note explaining that executors no longer receive malformed input. Unknown properties remain permitted unless the registered schema says otherwise. Output validation, authorization and retry policies are separate work.
diff --git a/src/orchestration/tools/registry.acceptance.test.ts b/src/orchestration/tools/registry.acceptance.test.ts
new file mode 100644
index 0000000..e7a2d4f
--- /dev/null
+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,128 @@
+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const weatherSchema = {
+  type: 'object',
+  required: ['location'],
+  properties: {
+    location: {type: 'string'},
+    units: {type: 'string', enum: ['metric', 'imperial'], default: 'metric'},
+  },
+};
+
+const definition = (inputSchema: Record<string, unknown>): ToolDefinition => ({
+  name: 'weather',
+  description: 'Forecast by location',
+  inputSchema,
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#1
+it('rejects malformed calls privately and passes accepted input unchanged', async () => {
+  const registry = new ToolRegistry();
+  const received: Record<string, unknown>[] = [];
+  const lines: string[] = [];
+  const record = (category: string, message: string, fields?: Record<string, unknown>): void => {
+    lines.push(JSON.stringify({category, message, fields}));
+  };
+  setLogger({debug: record, info: record, warn: record, error: record});
+  try {
+    registry.register(definition(weatherSchema), async input => {
+      received.push(structuredClone(input));
+      return 'forecast';
+    });
+    const cases = [
+      {input: {}, path: 'location', constraint: /required/i, secret: 'private-required@example.test'},
+      {input: {location: 918273645}, path: 'location', constraint: /string/i, secret: '918273645'},
+      {
+        input: {location: 'Berlin', units: 'private-enum@example.test'},
+        path: 'units',
+        constraint: /enum|allowed/i,
+        secret: 'private-enum@example.test',
+      },
+    ];
+    for (const sample of cases) {
+      const input = sample.input;
+      lines.length = 0;
+      const before = structuredClone(input);
+      const response = await registry.execute('weather', input);
+      expect(response.result).toContain(sample.path);
+      expect(response.result).toMatch(sample.constraint);
+      expect(response.result).not.toContain(sample.secret);
+      expect(lines.join('\n')).not.toContain(sample.secret);
+      expect(lines.join('\n')).toContain(sample.path);
+      expect(lines.join('\n')).toMatch(sample.constraint);
+      expect(received).toEqual([]);
+      expect(input).toEqual(before);
+    }
+    const valid = {location: 'Berlin', extra: {keep: ['unchanged']}};
+    expect(await registry.execute('weather', valid)).toEqual({result: 'forecast'});
+    expect(received).toEqual([valid]);
+    expect(valid).toEqual({location: 'Berlin', extra: {keep: ['unchanged']}});
+    await expect(registry.execute('missing', {})).rejects.toThrow('Unknown tool: missing');
+  } finally {
+    setLogger();
+  }
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#2
+it('compiles static schemas at registration and reuses them for ten calls', async () => {
+  const registry = new ToolRegistry();
+  expect(() => registry.register(definition({type: 'not-a-json-schema-type'}), async () => 'forecast')).toThrow(
+    /weather/
+  );
+  let schemaReads = 0;
+  const schema = {
+    ...weatherSchema,
+    get properties() {
+      schemaReads++;
+      return weatherSchema.properties;
+    },
+  };
+  registry.register(definition(schema), async input => JSON.stringify(input));
+  const readsAfterRegistration = schemaReads;
+  expect(readsAfterRegistration).toBeGreaterThan(0);
+  for (let call = 0; call < 10; call++) {
+    expect(await registry.execute('weather', {location: 'Berlin'})).toEqual({result: '{"location":"Berlin"}'});
+  }
+  expect(schemaReads).toBe(readsAfterRegistration);
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#3
+it('validates each dynamic definition and caches by schema identity', async () => {
+  const registry = new ToolRegistry();
+  const received: Record<string, unknown>[] = [];
+  let schemaReads = 0;
+  const numericSchema = {
+    type: 'object',
+    required: ['location'],
+    get properties() {
+      schemaReads++;
+      return {location: {type: 'number'}};
+    },
+  };
+  let current = definition(weatherSchema);
+  registry.register(
+    () => current,
+    async input => {
+      received.push(structuredClone(input));
+      return JSON.stringify(input);
+    }
+  );
+  expect(await registry.execute('weather', {location: 'Berlin'})).toEqual({result: '{"location":"Berlin"}'});
+  current = definition(numericSchema);
+  const rejected = await registry.execute('weather', {location: 'private-dynamic@example.test'});
+  expect(rejected.result).toMatch(/location/);
+  expect(rejected.result).toMatch(/number/);
+  expect(rejected.result).not.toContain('private-dynamic@example.test');
+  expect(received).toEqual([{location: 'Berlin'}]);
+  expect(schemaReads).toBeGreaterThan(0);
+  const readsAfterCompilation = schemaReads;
+  expect(await registry.execute('weather', {location: 42})).toEqual({result: '{"location":42}'});
+  current = definition(weatherSchema);
+  expect((await registry.execute('weather', {location: 42})).result).toMatch(/string/);
+  current = definition(numericSchema);
+  expect(await registry.execute('weather', {location: 43})).toEqual({result: '{"location":43}'});
+  expect(schemaReads).toBe(readsAfterCompilation);
+  expect(received).toEqual([{location: 'Berlin'}, {location: 42}, {location: 43}]);
+});