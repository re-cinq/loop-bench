index 0000000..3224fb4
--- /dev/null
+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,163 @@
+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const weather = (inputSchema: Record<string, unknown>): ToolDefinition => ({
+  name: 'weather',
+  description: 'Return a forecast',
+  inputSchema,
+});
+
+const schema = (): Record<string, unknown> => ({
+  type: 'object',
+  properties: {
+    location: {type: 'string'},
+    units: {type: 'string', enum: ['C', 'F'], default: 'C'},
+    address: {type: 'object', properties: {postcode: {type: 'string'}}},
+  },
+  required: ['location'],
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#1
+it('rejects invalid tool input privately and passes valid input unchanged', async () => {
+  const registry = new ToolRegistry();
+  const calls: Record<string, unknown>[] = [];
+  const lines: string[] = [];
+  const record = (category: string, message: string, fields?: Record<string, unknown>): void => {
+    lines.push(JSON.stringify({category, message, fields}));
+  };
+  setLogger({debug: record, info: record, warn: record, error: record});
+  registry.register(weather(schema()), async input => {
+    calls.push(structuredClone(input));
+    return 'forecast';
+  });
+  try {
+    const cases = [
+      {input: {}, path: /location/i, constraint: /required/i, secret: 'private@example.invalid'},
+      {input: {location: 918273645}, path: /location/i, constraint: /string/i, secret: '918273645'},
+      {
+        input: {location: 'Berlin', units: 'private@example.invalid'},
+        path: /units/i,
+        constraint: /enum|allowed/i,
+        secret: 'private@example.invalid',
+      },
+      {
+        input: {location: 'Berlin', address: {postcode: 918273645}},
+        path: /address.*postcode/i,
+        constraint: /string/i,
+        secret: '918273645',
+      },
+    ];
+    const rejected = [];
+    for (const item of cases) {
+      lines.length = 0;
+      const result = await registry.execute('weather', item.input);
+      rejected.push({
+        path: item.path.test(result.result),
+        constraint: item.constraint.test(result.result),
+        loggedConstraint: lines.some(line => item.path.test(line) && item.constraint.test(line)),
+        private: !JSON.stringify({result, lines}).includes(item.secret),
+        calls: calls.length,
+      });
+    }
+    const input = {location: 'Berlin', extra: {keep: true}};
+    const accepted = await registry.execute('weather', input);
+    const unknown = await registry.execute('missing', {}).catch((error: Error) => error.message);
+    expect({rejected, accepted, calls, input, unknown}).toEqual({
+      rejected: cases.map(() => ({path: true, constraint: true, loggedConstraint: true, private: true, calls: 0})),
+      accepted: {result: 'forecast'},
+      calls: [{location: 'Berlin', extra: {keep: true}}],
+      input: {location: 'Berlin', extra: {keep: true}},
+      unknown: 'Unknown tool: missing',
+    });
+  } finally {
+    setLogger();
+  }
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#2
+it('compiles static schemas at registration and reuses them across ten calls', async () => {
+  const registry = new ToolRegistry();
+  let reads = 0;
+  const inputSchema = {
+    ...schema(),
+    get type() {
+      reads++;
+      return 'object';
+    },
+  };
+  const received: Record<string, unknown>[] = [];
+  registry.register(weather(inputSchema), async input => {
+    received.push(structuredClone(input));
+    return 'forecast';
+  });
+  const registrationReads = reads;
+  for (let index = 0; index < 10; index++) {
+    await registry.execute('weather', {location: 'Berlin'});
+  }
+  let registrationError = '';
+  try {
+    registry.register({...weather({type: 'not-a-json-schema-type'}), name: 'broken_weather'}, async () => 'unused');
+  } catch (error) {
+    registrationError = error instanceof Error ? error.message : String(error);
+  }
+  expect({
+    compiledAtRegistration: registrationReads > 0,
+    reused: reads === registrationReads,
+    received,
+    registrationError,
+  }).toEqual({
+    compiledAtRegistration: true,
+    reused: true,
+    received: Array.from({length: 10}, () => ({location: 'Berlin'})),
+    registrationError: expect.stringContaining('broken_weather'),
+  });
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#3
+it('validates each dynamic definition using its current cached schema object', async () => {
+  const registry = new ToolRegistry();
+  let reads = 0;
+  const currentSchema = {
+    type: 'object',
+    get properties() {
+      reads++;
+      return {location: {type: 'number', enum: [42]}};
+    },
+    required: ['location'],
+  };
+  let definition = weather(schema());
+  const received: Record<string, unknown>[] = [];
+  registry.register(
+    () => definition,
+    async input => {
+      received.push(structuredClone(input));
+      return 'forecast';
+    }
+  );
+  await registry.execute('weather', {location: 'Berlin'});
+  definition = weather(currentSchema);
+  const wrongType = await registry.execute('weather', {location: 'Berlin'});
+  const firstReads = reads;
+  const wrongEnum = await registry.execute('weather', {location: 43});
+  const accepted = await registry.execute('weather', {location: 42});
+  definition = weather(schema());
+  const switchedBack = await registry.execute('weather', {location: 42});
+  expect({
+    wrongType,
+    wrongEnum,
+    accepted,
+    switchedBack,
+    received,
+    compiled: firstReads > 0,
+    reused: reads === firstReads,
+  }).toEqual({
+    wrongType: {result: expect.stringMatching(/location.*number|number.*location/i)},
+    wrongEnum: {result: expect.stringMatching(/enum|allowed/i)},
+    accepted: {result: 'forecast'},
+    switchedBack: {result: expect.stringMatching(/location.*string|string.*location/i)},
+    received: [{location: 'Berlin'}, {location: 42}],
+    compiled: true,
+    reused: true,
+  });
+});