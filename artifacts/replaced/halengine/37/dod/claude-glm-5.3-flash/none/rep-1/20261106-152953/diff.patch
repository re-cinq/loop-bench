@@ -0,0 +1,220 @@
+// Acceptance tests for issue 37: execute validates input against the registered inputSchema before the executor runs.
+// Red until the registry validates; the passthrough, compile-once and unknown-tool pins are green by design.
+import {jest} from '@jest/globals';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+import type {AIProvider, Message, MessageChunk, SendMessageParams} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const recordingExecutor = (result: string) => {
+  const inputs: Record<string, unknown>[] = [];
+  const execute = async (input: Record<string, unknown>): Promise<string> => {
+    inputs.push(input);
+    return result;
+  };
+  return {execute, inputs};
+};
+
+const weatherTool = (required: string[]): ToolDefinition => ({
+  name: 'get_weather',
+  description: 'weather for a location',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}, zip: {type: 'string'}},
+    required,
+  },
+});
+
+const sessionAsking = (content: string): ChatSession => ({
+  sessionId: 's-acceptance',
+  userId: 'user-1',
+  entries: [{role: 'user', content, timestamp: SENT_AT}],
+});
+
+// Copies the messages each round sees: the orchestrator reuses and mutates one array across rounds.
+const scriptedProviderRecordingMessages = (rounds: MessageChunk[][]) => {
+  const roundsSeen: Message[][] = [];
+  let round = 0;
+  const provider: AIProvider = {
+    async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      roundsSeen.push([...params.messages]);
+      for (const chunk of rounds[round] ?? []) yield chunk;
+      round++;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  return {provider, roundsSeen};
+};
+
+const toolResultsSeenIn = (messages: Message[]): string[] =>
+  messages
+    .flatMap(message => (Array.isArray(message.content) ? message.content : []))
+    .flatMap(content => (content.type === 'tool_result' ? [content.content] : []));
+
+describe('ToolRegistry input validation', () => {
+  it('rejects input the schema refuses before the executor runs', async () => {
+    const registry = new ToolRegistry();
+    const tool = recordingExecutor('ok');
+    registry.register(weatherTool(['location']), tool.execute);
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({
+      rejected: ['location', 'required'].every(word => response.result.includes(word)),
+      executorCalls: tool.inputs.length,
+    }).toEqual({rejected: true, executorCalls: 0});
+  });
+
+  it('hands valid input to the executor unchanged, unlisted properties included, exactly once', async () => {
+    const registry = new ToolRegistry();
+    const tool = recordingExecutor('ok');
+    registry.register(weatherTool(['location']), tool.execute);
+
+    await registry.execute('get_weather', {location: 'Berlin', units: 'metric'});
+
+    expect({inputs: tool.inputs}).toEqual({inputs: [{location: 'Berlin', units: 'metric'}]});
+  });
+
+  it('rejects a wrong-typed field naming the path and the expected type, never the value', async () => {
+    const registry = new ToolRegistry();
+    const tool = recordingExecutor('ok');
+    registry.register(weatherTool(['location']), tool.execute);
+
+    const response = await registry.execute('get_weather', {location: 4242});
+
+    expect({
+      namesPath: response.result.includes('location'),
+      namesType: response.result.includes('string'),
+      leaksValue: response.result.includes('4242'),
+    }).toEqual({namesPath: true, namesType: true, leaksValue: false});
+  });
+
+  it('refuses an uncompilable schema at register time, naming the tool', () => {
+    const registry = new ToolRegistry();
+    const broken: ToolDefinition = {
+      name: 'get_weather',
+      description: 'weather for a location',
+      inputSchema: {type: 'object', properties: {location: {type: 'strng'}}},
+    };
+
+    let message = 'register did not throw';
+    try {
+      registry.register(broken, async () => 'ok');
+    } catch (error) {
+      message = error instanceof Error ? error.message : String(error);
+    }
+
+    expect({threw: message !== 'register did not throw', namesTool: message.includes('get_weather')}).toEqual({
+      threw: true,
+      namesTool: true,
+    });
+  });
+
+  it('validates a function-valued definition against the schema current at each call', async () => {
+    const registry = new ToolRegistry();
+    const tool = recordingExecutor('ok');
+    let definition = weatherTool(['location']);
+    registry.register(() => definition, tool.execute);
+
+    const rejected = await registry.execute('get_weather', {zip: '10115'});
+    definition = weatherTool(['zip']);
+    const accepted = await registry.execute('get_weather', {zip: '10115'});
+
+    expect({
+      firstRejected: rejected.result.includes('location') && tool.inputs.length === 0,
+      secondAccepted: tool.inputs.length === 1,
+    }).toEqual({firstRejected: true, secondAccepted: true});
+  });
+
+  it('validates ten execute calls of a static tool against the schema compiled at register', async () => {
+    const registry = new ToolRegistry();
+    const tool = recordingExecutor('ok');
+    const definition = weatherTool([]);
+    registry.register(definition, tool.execute);
+    definition.inputSchema.required = ['admin_token'];
+
+    for (let call = 0; call < 10; call++) await registry.execute('get_weather', {location: 'Berlin'});
+
+    expect(tool.inputs.length).toBe(10);
+  });
+
+  it('returns a schema rejection to the model and completes the message on the corrected retry', async () => {
+    const scripted = scriptedProviderRecordingMessages([
+      [
+        {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Berlin'}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'text', text: 'It is 18 degrees and clear in Berlin.'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ]);
+    const registry = new ToolRegistry();
+    const tool = recordingExecutor('18 degrees, clear sky');
+    registry.register(weatherTool(['location']), tool.execute);
+    const orchestrator = createChatOrchestrator(scripted.provider, promptBuilder, registry);
+
+    const text = await orchestrator.processMessage(sessionAsking('What is the weather in Berlin?'));
+
+    const fedBack = toolResultsSeenIn(scripted.roundsSeen[1] ?? []).some(content => content.includes('location'));
+    expect({text, fedBack, executorCalls: tool.inputs.length}).toEqual({
+      text: 'It is 18 degrees and clear in Berlin.',
+      fedBack: true,
+      executorCalls: 1,
+    });
+  });
+
+  it('still throws Unknown tool: get_weather for an unregistered name', async () => {
+    const registry = new ToolRegistry();
+
+    let outcome = 'resolved without throwing';
+    try {
+      await registry.execute('get_weather', {});
+    } catch (error) {
+      outcome = error instanceof Error ? error.message : String(error);
+    }
+
+    expect(outcome).toBe('Unknown tool: get_weather');
+  });
+
+  it('keeps an identifying value out of the rejection text and the log lines', async () => {
+    const registry = new ToolRegistry();
+    const tool = recordingExecutor('ok');
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string', enum: ['Berlin', 'Tokyo']}},
+          required: ['location'],
+        },
+      },
+      tool.execute
+    );
+    const lines: string[] = [];
+    const outSpy = jest.spyOn(console, 'log').mockImplementation((raw: unknown) => void lines.push(String(raw)));
+    const errSpy = jest.spyOn(console, 'error').mockImplementation((raw: unknown) => void lines.push(String(raw)));
+
+    const response = await registry.execute('get_weather', {location: 'Ada Lovelace'});
+
+    outSpy.mockRestore();
+    errSpy.mockRestore();
+    expect({
+      rejected: tool.inputs.length === 0 && response.result.includes('location'),
+      leaksValue: lines.some(line => line.includes('Ada Lovelace')) || response.result.includes('Ada Lovelace'),
+    }).toEqual({rejected: true, leaksValue: false});
+  });
+});