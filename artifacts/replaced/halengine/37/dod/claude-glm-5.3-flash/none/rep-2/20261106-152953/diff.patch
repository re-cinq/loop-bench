@@ -0,0 +1,263 @@
+// Acceptance tests for #37: red until ToolRegistry validates input (specs/hal-engine-tool-input-validation/spec.md).
+import type {AIProvider, MessageChunk, SendMessageParams, ToolResultContent} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+import type {Logger} from '../../shared/logger.js';
+import type {ToolDefinitionSource, ToolExecutor} from './registry.js';
+
+// LOG_LEVEL is read at logger-module load, so it is set before the dynamic imports below.
+let registry!: typeof import('./registry.js');
+let logger!: typeof import('../../shared/logger.js');
+let orchestration!: typeof import('../chatOrchestrator.js');
+let promptBuilder!: typeof import('../../infrastructure/builders/promptBuilder.js');
+
+beforeAll(async () => {
+  process.env.LOG_LEVEL = 'debug';
+  [registry, logger, orchestration, promptBuilder] = await Promise.all([
+    import('./registry.js'),
+    import('../../shared/logger.js'),
+    import('../chatOrchestrator.js'),
+    import('../../infrastructure/builders/promptBuilder.js'),
+  ]);
+});
+
+afterAll(() => {
+  delete process.env.LOG_LEVEL;
+});
+
+afterEach(() => {
+  logger?.setLogger();
+});
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const weatherSchema = (): Record<string, unknown> => ({
+  type: 'object',
+  properties: {
+    location: {type: 'string'},
+    units: {type: 'string', enum: ['celsius', 'fahrenheit']},
+  },
+  required: ['location'],
+});
+
+const createSession = (content: string): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content, timestamp: SENT_AT}],
+});
+
+// Echoes its input back, so a call the schema should have rejected shows up in the result text.
+const registryEchoing = () => {
+  const calls: Record<string, unknown>[] = [];
+  const reg = new registry.ToolRegistry();
+  reg.register({name: 'get_weather', description: 'Get the weather.', inputSchema: weatherSchema()}, async input => {
+    calls.push(input);
+    return JSON.stringify(input);
+  });
+  return {reg, calls};
+};
+
+const scriptedProvider = (requests: SendMessageParams[], rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+  return {
+    async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      requests.push(params);
+      const chunks = rounds[Math.min(round, rounds.length - 1)] ?? [];
+      round += 1;
+      yield* chunks;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+describe('ToolRegistry input validation', () => {
+  it('rejects input missing a required property before the executor runs', async () => {
+    const {reg, calls} = registryEchoing();
+
+    const response = await reg.execute('get_weather', {});
+
+    expect({
+      calls: calls.length,
+      namesProperty: response.result.includes('location'),
+      namesConstraint: response.result.includes('required'),
+    }).toEqual({calls: 0, namesProperty: true, namesConstraint: true});
+  });
+
+  it('passes unknown extra properties through to the executor unchanged, exactly once', async () => {
+    const {reg, calls} = registryEchoing();
+
+    const response = await reg.execute('get_weather', {location: 'Berlin', extraKey: 'unlisted'});
+
+    expect({calls, result: response.result}).toEqual({
+      calls: [{location: 'Berlin', extraKey: 'unlisted'}],
+      result: JSON.stringify({location: 'Berlin', extraKey: 'unlisted'}),
+    });
+  });
+
+  it('rejects a wrong-typed field naming the path and expected type, without the value', async () => {
+    const {reg, calls} = registryEchoing();
+
+    const response = await reg.execute('get_weather', {location: 42});
+
+    expect({
+      calls: calls.length,
+      namesPath: response.result.includes('location'),
+      namesType: response.result.includes('string'),
+      leaksValue: response.result.includes('42'),
+    }).toEqual({calls: 0, namesPath: true, namesType: true, leaksValue: false});
+  });
+
+  it('rejects a value outside a declared enum before the executor runs', async () => {
+    const {reg, calls} = registryEchoing();
+
+    const response = await reg.execute('get_weather', {location: 'Berlin', units: 'kelvin'});
+
+    expect({calls: calls.length, namesField: response.result.includes('units')}).toEqual({
+      calls: 0,
+      namesField: true,
+    });
+  });
+
+  it('throws at register time for an uncompilable schema, naming the tool', () => {
+    const reg = new registry.ToolRegistry();
+
+    expect(() =>
+      reg.register(
+        {
+          name: 'get_weather',
+          description: 'Get the weather.',
+          inputSchema: {type: 'object', properties: {location: {type: 'strng'}}, required: ['location']},
+        },
+        async () => 'ok'
+      )
+    ).toThrow(/get_weather/);
+  });
+
+  it('compiles a static schema once, at register, and not again across ten execute calls', async () => {
+    let reads = 0;
+    const schema: Record<string, unknown> = {type: 'object', required: ['location']};
+    Object.defineProperty(schema, 'properties', {
+      enumerable: true,
+      get: () => {
+        reads += 1;
+        return {location: {type: 'string'}};
+      },
+    });
+    const calls: Record<string, unknown>[] = [];
+    const reg = new registry.ToolRegistry();
+    reg.register({name: 'get_weather', description: 'Get the weather.', inputSchema: schema}, async input => {
+      calls.push(input);
+      return JSON.stringify(input);
+    });
+
+    const readsAtRegister = reads;
+    for (let i = 0; i < 10; i++) {
+      await reg.execute('get_weather', {location: 'Berlin'});
+    }
+
+    expect({compiledAtRegister: readsAtRegister > 0, compiledAgainPerCall: reads > readsAtRegister}).toEqual({
+      compiledAtRegister: true,
+      compiledAgainPerCall: false,
+    });
+  });
+
+  it('validates a function-valued definition against the schema current at each call', async () => {
+    let requireNumber = false;
+    const source: ToolDefinitionSource = () => ({
+      name: 'shifting_tool',
+      description: 'Schema changes between calls.',
+      inputSchema: {
+        type: 'object',
+        properties: {location: {type: requireNumber ? 'number' : 'string'}},
+        required: ['location'],
+      },
+    });
+    const calls: Record<string, unknown>[] = [];
+    const reg = new registry.ToolRegistry();
+    reg.register(source, async input => {
+      calls.push(input);
+      return JSON.stringify(input);
+    });
+
+    await reg.execute('shifting_tool', {location: 'Berlin'});
+    requireNumber = true;
+    const second = await reg.execute('shifting_tool', {location: 'Berlin'});
+
+    expect({calls, namesType: second.result.includes('number')}).toEqual({
+      calls: [{location: 'Berlin'}],
+      namesType: true,
+    });
+  });
+
+  it('keeps identifying input values out of rejection text and log lines', async () => {
+    const lines: string[] = [];
+    const recording: Logger = {
+      debug: (category, message, fields) => void lines.push(JSON.stringify({category, message, fields})),
+      info: (category, message, fields) => void lines.push(JSON.stringify({category, message, fields})),
+      warn: (category, message, fields) => void lines.push(JSON.stringify({category, message, fields})),
+      error: (category, message, fields) => void lines.push(JSON.stringify({category, message, fields})),
+    };
+    logger.setLogger(recording);
+    const {reg, calls} = registryEchoing();
+
+    const response = await reg.execute('get_weather', {location: {street: '12 identifying-street'}});
+
+    logger.setLogger();
+    expect({
+      calls: calls.length,
+      namesField: response.result.includes('location'),
+      leaksInResult: response.result.includes('12 identifying-street'),
+      leaksInLogs: lines.join('\n').includes('12 identifying-street'),
+    }).toEqual({calls: 0, namesField: true, leaksInResult: false, leaksInLogs: false});
+  });
+
+  it('returns a rejected tool call to the model as a tool result within the same conversation', async () => {
+    const executorCalls: Record<string, unknown>[] = [];
+    const failing: ToolExecutor = async input => {
+      executorCalls.push(input);
+      throw new Error('invalid input reached the executor');
+    };
+    const reg = new registry.ToolRegistry();
+    reg.register({name: 'get_weather', description: 'Get the weather.', inputSchema: weatherSchema()}, failing);
+
+    const requests: SendMessageParams[] = [];
+    const provider = scriptedProvider(requests, [
+      [
+        {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'text', text: 'Let me correct that call.'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ]);
+    const orchestrator = orchestration.createChatOrchestrator(
+      provider,
+      new promptBuilder.PromptBuilder({identity: 'You are a test assistant.'}),
+      reg
+    );
+
+    const text = await orchestrator.processMessage(createSession('Weather in Berlin?'));
+
+    const secondRequest = requests.length > 1 ? requests[1] : undefined;
+    const rejections = (secondRequest?.messages ?? []).flatMap(message =>
+      Array.isArray(message.content)
+        ? message.content
+            .filter((block): block is ToolResultContent => block.type === 'tool_result')
+            .map(block => block.content)
+        : []
+    );
+    expect({
+      text,
+      executorCalls: executorCalls.length,
+      rejectionVisibleToProvider: rejections.some(content => content.includes('location')),
+    }).toEqual({text: 'Let me correct that call.', executorCalls: 0, rejectionVisibleToProvider: true});
+  });
+
+  it('still throws Unknown tool for an unregistered name', async () => {
+    const reg = new registry.ToolRegistry();
+
+    await expect(reg.execute('not_registered', {})).rejects.toThrow('Unknown tool: not_registered');
+  });
+});