+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+
+// An identifying value a malformed call carried in: it must never surface in the rejection or the log.
+const IDENTIFYING_VALUE = 'caller@example.com';
+
+const locationSchema = {
+  type: 'object',
+  properties: {location: {type: 'string'}},
+  required: ['location'],
+};
+
+const recordingExecutor = (calls: Record<string, unknown>[]) => async (input: Record<string, unknown>) => {
+  calls.push(input);
+  return 'executor ran';
+};
+
+// Reads as strings rather than structured fields, so a value hidden anywhere in a line cannot dodge the search.
+const captureLogLines = (): {lines: string[]; restore: () => void} => {
+  const lines: string[] = [];
+  setLogger({
+    debug: (category, message, fields) => void lines.push(JSON.stringify({category, message, fields})),
+    info: (category, message, fields) => void lines.push(JSON.stringify({category, message, fields})),
+    warn: (category, message, fields) => void lines.push(JSON.stringify({category, message, fields})),
+    error: (category, message, fields) => void lines.push(JSON.stringify({category, message, fields})),
+  });
+  return {lines, restore: () => setLogger()};
+};
+
+describe('ToolRegistry input validation', () => {
+  it('answers a missing required property with a rejection naming it and never calls the executor', async () => {
+    const registry = new ToolRegistry();
+    const calls: Record<string, unknown>[] = [];
+    registry.register(
+      {name: 'weather', description: 'current weather for a location', inputSchema: locationSchema},
+      recordingExecutor(calls)
+    );
+
+    const rejected = await registry.execute('weather', {});
+
+    expect(rejected.result).toMatch(/location/);
+    expect(rejected.result).toMatch(/required/i);
+    expect(calls).toHaveLength(0);
+  });
+
+  it('rejects a wrong-typed field naming the path and expected type, never the value', async () => {
+    const registry = new ToolRegistry();
+    const calls: Record<string, unknown>[] = [];
+    registry.register(
+      {name: 'weather', description: 'current weather for a location', inputSchema: locationSchema},
+      recordingExecutor(calls)
+    );
+
+    const rejected = await registry.execute('weather', {location: 1337});
+
+    expect(rejected.result).toMatch(/location/);
+    expect(rejected.result).toMatch(/string/i);
+    expect(rejected.result).not.toContain('1337');
+    expect(calls).toHaveLength(0);
+  });
+
+  it('keeps the rejected payload values out of the returned text and every log line', async () => {
+    const captured = captureLogLines();
+    try {
+      const registry = new ToolRegistry();
+      const calls: Record<string, unknown>[] = [];
+      registry.register(
+        {name: 'weather', description: 'current weather for a location', inputSchema: locationSchema},
+        recordingExecutor(calls)
+      );
+
+      const rejected = await registry.execute('weather', {location: {contact: IDENTIFYING_VALUE}});
+
+      expect(rejected.result).toMatch(/location/);
+      expect(rejected.result).toMatch(/string/i);
+      expect(rejected.result).not.toContain(IDENTIFYING_VALUE);
+      expect(captured.lines.length).toBeGreaterThan(0);
+      expect(captured.lines.join('\n')).not.toContain(IDENTIFYING_VALUE);
+      expect(calls).toHaveLength(0);
+    } finally {
+      captured.restore();
+    }
+  });
+
+  it('passes a schema-valid call carrying an unlisted extra property through to the executor unchanged, exactly once', async () => {
+    const registry = new ToolRegistry();
+    const calls: Record<string, unknown>[] = [];
+    registry.register(
+      {name: 'weather', description: 'current weather for a location', inputSchema: locationSchema},
+      recordingExecutor(calls)
+    );
+
+    // One rejected call first: pass-through is a property of the validating execute, not of its absence.
+    const rejected = await registry.execute('weather', {});
+    expect(rejected.result).toMatch(/location/);
+
+    await registry.execute('weather', {location: 'Lisbon', precision: 'high'});
+
+    expect(calls).toEqual([{location: 'Lisbon', precision: 'high'}]);
+  });
+
+  it('throws at register time for an uncompilable schema, naming the tool', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken-tool',
+          description: 'a tool whose schema cannot compile',
+          inputSchema: {type: 'banana'},
+        },
+        async () => 'executor ran'
+      )
+    ).toThrow(/broken-tool/);
+  });
+
+  it('serves ten execute calls from the schema compiled at register without reading the schema again', async () => {
+    let reads = 0;
+    const schema: Record<string, unknown> = {...locationSchema};
+    const countedSchema = new Proxy(schema, {
+      get: (target, property, receiver) => {
+        reads += 1;
+        return Reflect.get(target, property, receiver);
+      },
+    });
+    const registry = new ToolRegistry();
+    const calls: Record<string, unknown>[] = [];
+    registry.register(
+      {name: 'weather', description: 'current weather for a location', inputSchema: countedSchema},
+      recordingExecutor(calls)
+    );
+
+    const readsAtRegister = reads;
+    expect(readsAtRegister).toBeGreaterThan(0);
+
+    for (let round = 0; round < 10; round++) {
+      await registry.execute('weather', {location: 'Lisbon'});
+    }
+
+    expect(reads).toBe(readsAtRegister);
+    expect(calls).toHaveLength(10);
+  });
+
+  it('validates a function-valued definition against the schema current at that call', async () => {
+    let requireCity = false;
+    const registry = new ToolRegistry();
+    const calls: Record<string, unknown>[] = [];
+    registry.register(
+      () => ({
+        name: 'weather',
+        description: 'current weather for a location',
+        inputSchema: requireCity
+          ? {type: 'object', properties: {city: {type: 'string'}}, required: ['city']}
+          : {...locationSchema},
+      }),
+      recordingExecutor(calls)
+    );
+
+    await registry.execute('weather', {location: 'Lisbon'});
+    requireCity = true;
+
+    const rejected = await registry.execute('weather', {location: 'Lisbon'});
+
+    expect(rejected.result).toMatch(/city/);
+    expect(rejected.result).toMatch(/required/i);
+    expect(calls).toHaveLength(1);
+  });
+
+  it('rejects a value outside a declared enum, naming the property and the constraint', async () => {
+    const registry = new ToolRegistry();
+    const calls: Record<string, unknown>[] = [];
+    registry.register(
+      {
+        name: 'weather',
+        description: 'current weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+            units: {type: 'string', enum: ['metric', 'imperial']},
+          },
+          required: ['location', 'units'],
+        },
+      },
+      recordingExecutor(calls)
+    );
+
+    const rejected = await registry.execute('weather', {location: 'Lisbon', units: 'furlongs'});
+
+    expect(rejected.result).toMatch(/units/);
+    expect(rejected.result).toMatch(/enum|allowed|one of/i);
+    expect(rejected.result).not.toContain('furlongs');
+    expect(calls).toHaveLength(0);
+  });
+
+  it('still throws Unknown tool for an unregistered name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('no-such-tool', {})).rejects.toThrow('Unknown tool: no-such-tool');
+  });
+});