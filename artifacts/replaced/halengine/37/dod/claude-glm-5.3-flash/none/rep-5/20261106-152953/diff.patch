+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, Message, MessageChunk, SendMessageParams, ToolResultContent} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+interface ScriptedProvider {
+  provider: AIProvider;
+  requests: Message[][];
+}
+
+// One provider covering every round: each call records the messages it was handed, then replays its script.
+const scriptedProvider = (rounds: MessageChunk[][]): ScriptedProvider => {
+  const requests: Message[][] = [];
+  let round = 0;
+  return {
+    requests,
+    provider: {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        requests.push(params.messages);
+        const chunks = rounds[round] ?? [];
+        round += 1;
+        yield* chunks;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    },
+  };
+};
+
+const createSession = (content: string): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content, timestamp: SENT_AT}],
+});
+
+const toolResultsIn = (messages: Message[]): ToolResultContent[] => {
+  const results: ToolResultContent[] = [];
+  for (const message of messages) {
+    if (!Array.isArray(message.content)) continue;
+    for (const part of message.content) {
+      if (part.type === 'tool_result') results.push(part);
+    }
+  }
+  return results;
+};
+
+// The request's message array accumulates across rounds, so a result is found by the call it answers.
+const resultFor = (messages: Message[], toolUseId: string): ToolResultContent | undefined =>
+  toolResultsIn(messages).find(result => result.toolUseId === toolUseId);
+
+describe('tool input validation in the orchestrator loop', () => {
+  it('carries a rejected tool call back to the model as a tool result and resolves on the corrected retry', async () => {
+    const registry = new ToolRegistry();
+    const executorInputs: Record<string, unknown>[] = [];
+    registry.register(
+      {
+        name: 'weather',
+        description: 'current weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async input => {
+        executorInputs.push(input);
+        return 'sunny in Lisbon, 21C';
+      }
+    );
+
+    const {provider, requests} = scriptedProvider([
+      [
+        {type: 'text', text: 'checking the weather. '},
+        {type: 'tool_use', toolCall: {id: 'call-1', name: 'weather', input: {location: 1337}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'call-2', name: 'weather', input: {location: 'Lisbon'}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'text', text: 'Lisbon is sunny.'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ]);
+
+    const errorSessions: ChatSession[] = [];
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test.'}), registry, {
+      hooks: {onError: async session => void errorSessions.push(session)},
+    });
+
+    const text = await orchestrator.processMessage(createSession('what is the weather in Lisbon?'));
+
+    expect(text).toContain('Lisbon is sunny.');
+    expect(errorSessions).toHaveLength(0);
+
+    const rejectedResult = resultFor(requests[1], 'call-1');
+    expect(rejectedResult).toBeDefined();
+    expect(rejectedResult?.content).toMatch(/location/);
+    expect(rejectedResult?.content).toMatch(/string/i);
+    expect(resultFor(requests[1], 'call-2')).toBeDefined();
+
+    expect(executorInputs).toEqual([{location: 'Lisbon'}]);
+    const retriedResult = resultFor(requests[2], 'call-2');
+    expect(retriedResult?.toolUseId).toBe('call-2');
+    expect(retriedResult?.content).toBe('sunny in Lisbon, 21C');
+  });
+});
