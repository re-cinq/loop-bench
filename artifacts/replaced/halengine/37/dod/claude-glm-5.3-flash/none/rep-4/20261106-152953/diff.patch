+import {jest} from '@jest/globals';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams, ToolCallContent, ToolResultContent} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const isToolResult = (part: ToolCallContent | ToolResultContent): part is ToolResultContent =>
+  part.type === 'tool_result';
+
+const locationRequired = {
+  type: 'object',
+  properties: {location: {type: 'string'}},
+  required: ['location'],
+};
+
+const toolCallRound = (id: string, input: Record<string, unknown>): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id, name: 'get_weather', input}},
+  {type: 'stop', stopReason: 'tool_use'},
+];
+
+const closingRound = (): MessageChunk[] => [
+  {type: 'text', text: 'It is 18 degrees and cloudy.'},
+  {type: 'stop', stopReason: 'end_turn'},
+];
+
+// The provider records every request, so the test can read what one round fed the next.
+const recordingProvider = (rounds: MessageChunk[][], received: SendMessageParams[]): AIProvider => ({
+  async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    received.push(params);
+    for (const chunk of rounds[received.length - 1] ?? []) yield chunk;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+describe('ChatOrchestrator schema-rejected tool call', () => {
+  it('returns a schema rejection to the model as a tool result and lets a corrected retry finish the turn', async () => {
+    const received: SendMessageParams[] = [];
+    const provider = recordingProvider(
+      [toolCallRound('call-1', {}), toolCallRound('call-2', {location: 'Berlin'}), closingRound()],
+      received
+    );
+    const executor = jest.fn(async () => '18 degrees, cloudy');
+    const registry = new ToolRegistry();
+    registry.register(
+      {name: 'get_weather', description: 'looks up the weather', inputSchema: locationRequired},
+      executor
+    );
+    const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'weather in Berlin?', timestamp: SENT_AT}],
+    };
+
+    const text = await orchestrator.processMessage(session);
+
+    const fedBack = (received[1]?.messages ?? [])
+      .flatMap(message =>
+        Array.isArray(message.content) ? message.content.filter(isToolResult).map(part => part.content) : []
+      )
+      .join('\n');
+    expect({
+      text,
+      executorInputs: executor.mock.calls.map(call => call[0]),
+      rejectionFedBack: /required[\s\S]*location|location[\s\S]*required/.test(fedBack),
+    }).toEqual({
+      text: 'It is 18 degrees and cloudy.',
+      executorInputs: [{location: 'Berlin'}],
+      rejectionFedBack: true,
+    });
+  });
+});
