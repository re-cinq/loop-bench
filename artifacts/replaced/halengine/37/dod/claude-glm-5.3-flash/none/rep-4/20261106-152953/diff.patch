+import {jest} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+
+const locationRequired = {
+  type: 'object',
+  properties: {location: {type: 'string'}},
+  required: ['location'],
+};
+
+const weatherTool = (schema: Record<string, unknown>): ToolDefinition => ({
+  name: 'get_weather',
+  description: 'looks up the weather for a location',
+  inputSchema: schema,
+});
+
+// The rejection the schema ought to produce: property path and constraint, either word order.
+const namesLocationAsRequired = expect.stringMatching(/required[\s\S]*location|location[\s\S]*required/);
+const namesLocationAsString = expect.stringMatching(/^(?=[\s\S]*location)(?=[\s\S]*\bstring\b)/);
+
+describe('ToolRegistry input validation', () => {
+  it('rejects a call the schema rejects before the executor runs, naming the missing property', async () => {
+    const executor = jest.fn(async () => '18 degrees, cloudy');
+    const registry = new ToolRegistry();
+    registry.register(weatherTool(locationRequired), executor);
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({outcome: response.result, ran: executor.mock.calls.length}).toEqual({
+      outcome: namesLocationAsRequired,
+      ran: 0,
+    });
+  });
+
+  it('passes a valid call with an unlisted extra property to the executor unmodified, exactly once', async () => {
+    const executor = jest.fn(async () => '18 degrees, cloudy');
+    const registry = new ToolRegistry();
+    registry.register(weatherTool(locationRequired), executor);
+
+    const response = await registry.execute('get_weather', {location: 'Berlin', units: 'metric'});
+
+    expect({
+      seen: executor.mock.calls[0]?.[0],
+      calls: executor.mock.calls.length,
+      outcome: response.result,
+    }).toEqual({
+      seen: {location: 'Berlin', units: 'metric'},
+      calls: 1,
+      outcome: '18 degrees, cloudy',
+    });
+  });
+
+  it('rejects a wrong-typed value naming the path and expected type, without repeating the value', async () => {
+    const executor = jest.fn(async () => '18 degrees, cloudy');
+    const registry = new ToolRegistry();
+    registry.register(weatherTool(locationRequired), executor);
+
+    const response = await registry.execute('get_weather', {location: 4242});
+
+    expect({
+      outcome: response.result,
+      ran: executor.mock.calls.length,
+      echoesValue: response.result.includes('4242'),
+    }).toEqual({
+      outcome: namesLocationAsString,
+      ran: 0,
+      echoesValue: false,
+    });
+  });
+
+  it('throws at register time for an uncompilable schema, naming the tool', () => {
+    const registry = new ToolRegistry();
+    const registerBroken = () =>
+      registry.register(
+        {
+          name: 'broken_weather',
+          description: 'declares required as a string rather than an array',
+          inputSchema: {type: 'object', required: 'location'},
+        },
+        async () => '18 degrees, cloudy'
+      );
+
+    expect(registerBroken).toThrow(/broken_weather/);
+  });
+
+  it('validates a function-defined tool against the schema its source returns for that call', async () => {
+    let schema: Record<string, unknown> = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    const executor = jest.fn(async () => '18 degrees, cloudy');
+    const registry = new ToolRegistry();
+    registry.register(() => weatherTool(schema), executor);
+
+    const rejected = (await registry.execute('get_weather', {})).result;
+    schema = {type: 'object'};
+    const accepted = await registry.execute('get_weather', {});
+
+    expect({rejected, ran: executor.mock.calls.length, outcome: accepted.result}).toEqual({
+      rejected: namesLocationAsRequired,
+      ran: 1,
+      outcome: '18 degrees, cloudy',
+    });
+  });
+
+  it('holds a static tool to the schema compiled at register across ten execute calls', async () => {
+    const schema = {type: 'object', properties: {location: {type: 'string'}}, required: ['location']};
+    const executor = jest.fn(async () => '18 degrees, cloudy');
+    const registry = new ToolRegistry();
+    registry.register(weatherTool(schema), executor);
+
+    await registry.execute('get_weather', {});
+    schema.required = [];
+    for (let call = 0; call < 10; call++) await registry.execute('get_weather', {});
+
+    expect(executor.mock.calls).toEqual([]);
+  });
+
+  it('still throws Unknown tool for an unregistered name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('never_registered', {})).rejects.toThrow('Unknown tool: never_registered');
+  });
+
+  it('keeps an identifying value out of the rejection text and the log lines', async () => {
+    const executor = jest.fn(async () => '18 degrees, cloudy');
+    const registry = new ToolRegistry();
+    registry.register(weatherTool(locationRequired), executor);
+    const logLines: string[] = [];
+    const capture: Logger = {
+      debug: (category, message, fields) => {
+        logLines.push(`${category} ${message} ${JSON.stringify(fields ?? {})}`);
+      },
+      info: (category, message, fields) => {
+        logLines.push(`${category} ${message} ${JSON.stringify(fields ?? {})}`);
+      },
+      warn: (category, message, fields) => {
+        logLines.push(`${category} ${message} ${JSON.stringify(fields ?? {})}`);
+      },
+      error: (category, message, fields) => {
+        logLines.push(`${category} ${message} ${JSON.stringify(fields ?? {})}`);
+      },
+    };
+    setLogger(capture);
+
+    const response = await registry.execute('get_weather', {location: 4242, requesterEmail: 'pilot@example.com'});
+    setLogger();
+
+    const everything = [response.result, logLines.join('\n')].join('\n');
+    expect({outcome: response.result, leaked: /4242|pilot@example\.com/.test(everything)}).toEqual({
+      outcome: namesLocationAsString,
+      leaked: false,
+    });
+  });
+});