+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,137 @@
+import {jest} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+import type {ToolExecutor} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+
+// Fixed so a rejection cannot be faked by it: no word of the executor's answer names a schema constraint.
+const FORECAST = '18°C and partly cloudy, humidity 65%';
+
+const weatherSchema = {type: 'object', properties: {location: {type: 'string'}}, required: ['location']};
+
+const makeExecutor = () => jest.fn<(input: Record<string, unknown>) => Promise<string>>(async () => FORECAST);
+
+const registryWith = (schema: Record<string, unknown>, executor: ToolExecutor): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register({name: 'get_weather', description: 'current weather for a place', inputSchema: schema}, executor);
+  return registry;
+};
+
+// The validator is only a transitive install until the registry declares it; this test reads nothing but its shape.
+type CompilesSchemas = new () => {compile: (schema: object) => unknown};
+
+describe('ToolRegistry input validation', () => {
+  afterEach(() => {
+    jest.restoreAllMocks();
+  });
+
+  it('answers input the schema rejects with a rejection naming the required field, leaving the executor unrun', async () => {
+    const executor = makeExecutor();
+    const registry = registryWith(weatherSchema, executor);
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({rejection: response.result, executorCalls: executor.mock.calls.length}).toEqual({
+      rejection: expect.stringMatching(/location[\s\S]*required|required[\s\S]*location/),
+      executorCalls: 0,
+    });
+  });
+
+  it('hands valid input to the executor exactly as the model sent it, unlisted properties included', async () => {
+    const executor = makeExecutor();
+    const registry = registryWith(weatherSchema, executor);
+
+    await registry.execute('get_weather', {location: 'Berlin', units: 'metric'});
+
+    expect({received: executor.mock.calls.map(call => call[0]), executorCalls: executor.mock.calls.length}).toEqual({
+      received: [{location: 'Berlin', units: 'metric'}],
+      executorCalls: 1,
+    });
+  });
+
+  it('rejects a wrongly typed field naming its path and expected type, without echoing the value', async () => {
+    const executor = makeExecutor();
+    const registry = registryWith(weatherSchema, executor);
+
+    const response = await registry.execute('get_weather', {location: 12345});
+
+    expect({rejection: response.result, echoesValue: response.result.includes('12345')}).toEqual({
+      rejection: expect.stringMatching(/location[\s\S]*string|string[\s\S]*location/),
+      echoesValue: false,
+    });
+  });
+
+  it('answers a rejected call without copying its input into the result or any log line', async () => {
+    const lines: string[] = [];
+    const capture =
+      (level: string) =>
+      (category: string, message: string, fields?: Record<string, unknown>): void => {
+        lines.push(JSON.stringify({level, category, message, fields}));
+      };
+    setLogger({debug: capture('DEBUG'), info: capture('INFO'), warn: capture('WARN'), error: capture('ERROR')});
+    try {
+      const executor = makeExecutor();
+      const numericLocation = {type: 'object', properties: {location: {type: 'number'}}, required: ['location']};
+      const registry = registryWith(numericLocation, executor);
+
+      const response = await registry.execute('get_weather', {location: '742 Evergreen Terrace, Springfield'});
+
+      expect({rejection: response.result, logged: lines.join('\n')}).toEqual({
+        rejection: expect.stringMatching(/number/),
+        logged: expect.not.stringContaining('Evergreen'),
+      });
+    } finally {
+      setLogger();
+    }
+  });
+
+  it('refuses to register a schema no validator can compile, naming the tool at registration', () => {
+    const executor = makeExecutor();
+    const registry = new ToolRegistry();
+    const uncompilable = {type: 'object', properties: {location: {type: 'strng'}}, required: ['location']};
+
+    expect(() =>
+      registry.register({name: 'get_weather', description: 'current weather', inputSchema: uncompilable}, executor)
+    ).toThrow(/get_weather/);
+  });
+
+  it('validates a function-valued definition against the schema it returns at that call', async () => {
+    const executor = makeExecutor();
+    const registry = new ToolRegistry();
+    let schema: Record<string, unknown> = weatherSchema;
+    registry.register(() => ({name: 'get_weather', description: 'current weather', inputSchema: schema}), executor);
+
+    const accepted = await registry.execute('get_weather', {location: 'Berlin'});
+    schema = {
+      type: 'object',
+      properties: {location: {type: 'string'}, units: {type: 'string'}},
+      required: ['location', 'units'],
+    };
+    const rejected = await registry.execute('get_weather', {location: 'Berlin'});
+
+    expect({accepted: accepted.result, rejected: rejected.result, executorCalls: executor.mock.calls.length}).toEqual({
+      accepted: FORECAST,
+      rejected: expect.stringMatching(/units/),
+      executorCalls: 1,
+    });
+  });
+
+  it('compiles a static tool schema once and reuses the compiled validator across ten executes', async () => {
+    // @ts-ignore -- ajv is only a transitive install until the registry declares it; this test needs only its shape
+    const Ajv = (await import('ajv')).default as CompilesSchemas;
+    const compile = jest.spyOn(Ajv.prototype, 'compile');
+    const executor = makeExecutor();
+    const registry = registryWith(weatherSchema, executor);
+
+    for (let round = 0; round < 10; round++) {
+      await registry.execute('get_weather', {location: 'Berlin'});
+    }
+
+    expect(compile.mock.calls).toHaveLength(1);
+  });
+
+  it('still throws Unknown tool for an unregistered name', async () => {
+    const registry = registryWith(weatherSchema, makeExecutor());
+
+    await expect(registry.execute('no_such_tool', {})).rejects.toThrow('Unknown tool: no_such_tool');
+  });
+});