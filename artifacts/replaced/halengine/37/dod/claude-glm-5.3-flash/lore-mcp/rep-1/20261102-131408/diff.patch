+import {jest} from '@jest/globals';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams, ToolResultContent} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const TOOL_STOP: MessageChunk = {type: 'stop', stopReason: 'tool_use'};
+const DONE: MessageChunk = {type: 'stop', stopReason: 'end_turn'};
+const weatherSchema = {type: 'object', properties: {location: {type: 'string'}}, required: ['location']};
+
+const createSession = (content: string): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content, timestamp: SENT_AT}],
+});
+
+it('feeds a schema-rejected tool call back to the provider and finishes the turn on the corrected retry', async () => {
+  const executor = jest.fn<(input: Record<string, unknown>) => Promise<string>>(
+    async (input: Record<string, unknown>) => `weather for ${String(input.location)}: 18°C`
+  );
+  const registry = new ToolRegistry();
+  registry.register({name: 'get_weather', description: 'current weather', inputSchema: weatherSchema}, executor);
+
+  const rounds: MessageChunk[][] = [
+    [{type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}}, TOOL_STOP],
+    [{type: 'tool_use', toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Berlin'}}}, TOOL_STOP],
+    [{type: 'text', text: 'all set'}, DONE],
+  ];
+  const requests: SendMessageParams[] = [];
+  const provider: AIProvider = {
+    async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      // Copied per round: the orchestrator keeps appending to one array, so a stored reference would see later rounds.
+      requests.push({...params, messages: [...params.messages]});
+      for (const chunk of rounds[requests.length - 1] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const orchestrator = createChatOrchestrator(
+    provider,
+    new PromptBuilder({identity: 'You are a test assistant.'}),
+    registry
+  );
+
+  const turnText = await orchestrator.processMessage(createSession('what is the weather?'));
+
+  const roundTwo = requests[1]?.messages ?? [];
+  const results = roundTwo.flatMap(message =>
+    message.role === 'user' && Array.isArray(message.content) ? message.content : []
+  );
+  const rejection = results.find(
+    (part): part is ToolResultContent => part.type === 'tool_result' && part.toolUseId === 'call-1'
+  );
+
+  expect({rejectionText: rejection?.content, turnText, executorCalls: executor.mock.calls.length}).toEqual({
+    rejectionText: expect.stringContaining('location'),
+    turnText: 'all set',
+    executorCalls: 1,
+  });
+});
