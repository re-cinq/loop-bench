+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams, ToolDefinition} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './registry.js';
+import type {ToolResponse} from './registry.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+// The schema under contract: location required, units declared, anything else unlisted.
+const weatherDefinition = (): ToolDefinition => ({
+  name: 'get_weather',
+  description: 'looks up the weather',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}, units: {type: 'string'}},
+    required: ['location'],
+  },
+});
+
+// A real executor that records what it was handed, so the tests can observe how often it ran.
+const recordingExecutor = () => {
+  const seen: Record<string, unknown>[] = [];
+  return {
+    seen,
+    run: async (input: Record<string, unknown>): Promise<string> => {
+      seen.push(input);
+      return '18C partly cloudy';
+    },
+  };
+};
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// The rejection as a value, with the logger's one sink captured around the call and restored either way.
+const executeWithLogCapture = async (
+  registry: ToolRegistry,
+  input: Record<string, unknown>
+): Promise<{response: ToolResponse; lines: string[]}> => {
+  const lines: string[] = [];
+  const original = console.log;
+  console.log = (...emitted: unknown[]) => {
+    lines.push(emitted.map(String).join(' '));
+  };
+  try {
+    return {response: await registry.execute('get_weather', input), lines};
+  } finally {
+    console.log = original;
+  }
+};
+
+const captureThrow = (call: () => void): string => {
+  try {
+    call();
+  } catch (error) {
+    return error instanceof Error ? error.message : String(error);
+  }
+  return 'no throw';
+};
+
+// One scripted round per sendMessage call, recording each request so a later round's view can be asserted.
+const scriptedProvider = (rounds: MessageChunk[][], requests: SendMessageParams[]): AIProvider => ({
+  async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    requests.push(params);
+    for (const chunk of rounds[requests.length - 1] ?? []) yield chunk;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ToolRegistry input validation', () => {
+  it('rejects a call missing a required property before the executor runs', async () => {
+    const registry = new ToolRegistry();
+    const tool = recordingExecutor();
+    registry.register(weatherDefinition(), tool.run);
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({
+      response,
+      namesLocationAsRequired: response.result.includes('location') && response.result.includes('required'),
+      executorCalls: tool.seen.length,
+    }).toEqual({
+      response: {result: expect.any(String)},
+      namesLocationAsRequired: true,
+      executorCalls: 0,
+    });
+  });
+
+  it('names the property path and expected type when a field has the wrong type, without echoing the value', async () => {
+    const registry = new ToolRegistry();
+    const tool = recordingExecutor();
+    registry.register(weatherDefinition(), tool.run);
+
+    const response = await registry.execute('get_weather', {location: 123456789});
+
+    expect({
+      namesPath: response.result.includes('location'),
+      namesExpectedType: response.result.includes('string'),
+      echoesValue: response.result.includes('123456789'),
+      executorCalls: tool.seen.length,
+    }).toEqual({namesPath: true, namesExpectedType: true, echoesValue: false, executorCalls: 0});
+  });
+
+  it('passes valid input with an unlisted extra property through to the executor unchanged, exactly once', async () => {
+    const registry = new ToolRegistry();
+    const tool = recordingExecutor();
+    registry.register(weatherDefinition(), tool.run);
+
+    const response = await registry.execute('get_weather', {location: 'Berlin', units: 'celsius', extra: 'kept'});
+
+    expect({response, handedToExecutor: tool.seen}).toEqual({
+      response: {result: '18C partly cloudy'},
+      handedToExecutor: [{location: 'Berlin', units: 'celsius', extra: 'kept'}],
+    });
+  });
+
+  it('compiles the schema at register time, throwing a message that names the tool', () => {
+    const registry = new ToolRegistry();
+    const thrown = captureThrow(() =>
+      registry.register(
+        {
+          ...weatherDefinition(),
+          name: 'broken_tool',
+          inputSchema: {type: 'object', properties: {location: {type: 'strng'}}, required: ['location']},
+        },
+        async () => '18C partly cloudy'
+      )
+    );
+
+    expect({registered: registry.has('broken_tool'), thrown}).toEqual({
+      registered: false,
+      thrown: expect.stringContaining('broken_tool'),
+    });
+  });
+
+  it('validates a function-valued definition against the schema current at each call', async () => {
+    const registry = new ToolRegistry();
+    const tool = recordingExecutor();
+    let requireUnits = false;
+    registry.register(
+      () => ({
+        ...weatherDefinition(),
+        inputSchema: requireUnits
+          ? {
+              type: 'object',
+              properties: {location: {type: 'string'}, units: {type: 'string'}},
+              required: ['location', 'units'],
+            }
+          : weatherDefinition().inputSchema,
+      }),
+      tool.run
+    );
+
+    const before = await registry.execute('get_weather', {location: 'Berlin'});
+    requireUnits = true;
+    const after = await registry.execute('get_weather', {location: 'Berlin'});
+
+    expect({before, after, executorCalls: tool.seen.length}).toEqual({
+      before: {result: '18C partly cloudy'},
+      after: {result: expect.stringContaining('units')},
+      executorCalls: 1,
+    });
+  });
+
+  it('holds the registered schema in force across ten execute calls', async () => {
+    const registry = new ToolRegistry();
+    const tool = recordingExecutor();
+    registry.register(weatherDefinition(), tool.run);
+
+    const responses: ToolResponse[] = [];
+    for (let round = 0; round < 10; round++) {
+      responses.push(
+        await registry.execute('get_weather', round % 2 === 0 ? {location: 'Berlin'} : {units: 'celsius'})
+      );
+    }
+
+    expect({
+      accepted: responses.filter(r => r.result === '18C partly cloudy').length,
+      rejected: responses.filter(r => r.result !== '18C partly cloudy').length,
+      executorCalls: tool.seen.length,
+    }).toEqual({accepted: 5, rejected: 5, executorCalls: 5});
+  });
+
+  it('returns the rejection to the model so a corrected retry continues the conversation', async () => {
+    const registry = new ToolRegistry();
+    const tool = recordingExecutor();
+    registry.register(weatherDefinition(), tool.run);
+    const requests: SendMessageParams[] = [];
+    const provider = scriptedProvider(
+      [
+        [
+          {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}},
+          {type: 'stop', stopReason: 'tool_use'},
+        ],
+        [
+          {type: 'text', text: 'recovered'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ],
+      ],
+      requests
+    );
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+
+    const text = await orchestrator.processMessage(createSession('weather in Berlin?'));
+    const secondRound = requests[1]?.messages ?? [];
+    const toolResults = secondRound.flatMap(m => (m.role === 'user' && Array.isArray(m.content) ? m.content : []));
+
+    expect({text, toolResults, executorCalls: tool.seen.length}).toEqual({
+      text: 'recovered',
+      toolResults: [{type: 'tool_result', toolUseId: 'call-1', content: expect.stringContaining('location')}],
+      executorCalls: 0,
+    });
+  });
+
+  it('still throws Unknown tool for an unregistered name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('no_such_tool', {})).rejects.toThrow('Unknown tool: no_such_tool');
+  });
+
+  it('never echoes a rejected payload value into the result or the logs', async () => {
+    const registry = new ToolRegistry();
+    const tool = recordingExecutor();
+    registry.register(weatherDefinition(), tool.run);
+
+    const {response, lines} = await executeWithLogCapture(registry, {location: '42 Sub Rings,Inner City', units: 5});
+    const seen = `${response.result}\n${lines.join('\n')}`;
+
+    expect({
+      rejection: response.result,
+      identifyingValueLeaked: seen.includes('42 Sub Rings,Inner City'),
+    }).toEqual({
+      rejection: expect.stringContaining('units'),
+      identifyingValueLeaked: false,
+    });
+  });
+});