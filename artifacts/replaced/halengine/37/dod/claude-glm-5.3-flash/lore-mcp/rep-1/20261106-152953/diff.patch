@@ -0,0 +1,161 @@
+import {jest} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const locationSchema: Record<string, unknown> = {
+  type: 'object',
+  properties: {location: {type: 'string'}},
+  required: ['location'],
+};
+
+const staticTool = (inputSchema: Record<string, unknown>): ToolDefinition => ({
+  name: 'weather',
+  description: 'looks up the weather for a place',
+  inputSchema,
+});
+
+describe('ToolRegistry input validation', () => {
+  it('rejects a call missing a required property before the executor runs', async () => {
+    const registry = new ToolRegistry();
+    const executorInputs: Record<string, unknown>[] = [];
+    registry.register(staticTool(locationSchema), async input => {
+      executorInputs.push(input);
+      return 'ran';
+    });
+
+    const response = await registry.execute('weather', {});
+
+    expect({executorInputs, result: response.result}).toEqual({
+      executorInputs: [],
+      result: expect.stringMatching(/^(?=.*location)(?=.*required)[\s\S]*$/),
+    });
+  });
+
+  it('passes a valid input with an unlisted property through to the executor unchanged', async () => {
+    const registry = new ToolRegistry();
+    const executorInputs: Record<string, unknown>[] = [];
+    registry.register(staticTool(locationSchema), async input => {
+      executorInputs.push(input);
+      return 'ran';
+    });
+
+    await registry.execute('weather', {location: 'Kigali', units: 'metric'});
+
+    expect(executorInputs).toEqual([{location: 'Kigali', units: 'metric'}]);
+  });
+
+  it('rejects a wrong-typed property naming the path and the expected type', async () => {
+    const registry = new ToolRegistry();
+    registry.register(staticTool(locationSchema), async () => 'ran');
+
+    const response = await registry.execute('weather', {location: 72531});
+
+    expect(response.result).toEqual(expect.stringMatching(/^(?=.*\blocation\b)(?=.*\bstring\b)(?!.*72531)[\s\S]*$/));
+  });
+
+  it('surfaces no property value from a rejected payload in the result or the logs', async () => {
+    const out: string[] = [];
+    const err: string[] = [];
+    const outSpy = jest.spyOn(console, 'log').mockImplementation((raw: unknown) => void out.push(String(raw)));
+    const errSpy = jest.spyOn(console, 'error').mockImplementation((raw: unknown) => void err.push(String(raw)));
+    const registry = new ToolRegistry();
+    registry.register(staticTool(locationSchema), async () => 'ran');
+    const response = await registry.execute('weather', {location: 72531, clientEmail: 'ada@example.com'});
+    outSpy.mockRestore();
+    errSpy.mockRestore();
+
+    expect({
+      rejected: /location/.test(response.result),
+      leaks: /72531|ada@example\.com/.test([...out, ...err, response.result].join('\n')),
+    }).toEqual({rejected: true, leaks: false});
+  });
+
+  it('throws at register time for an uncompilable schema naming the tool', () => {
+    const registry = new ToolRegistry();
+    const attempt = (): string => {
+      try {
+        registry.register(staticTool({type: 'object', properties: {location: {type: 'strng'}}}), async () => 'ran');
+        return 'registered';
+      } catch (error) {
+        return error instanceof Error ? error.message : 'threw a non-error';
+      }
+    };
+
+    expect(attempt()).toEqual(expect.stringMatching(/weather/));
+  });
+
+  it('compiles a static schema once at register time and reuses it across execute calls', async () => {
+    let schemaReads = 0;
+    const schema = new Proxy(
+      {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      {
+        get: (target, prop) => {
+          schemaReads++;
+          return Reflect.get(target, prop);
+        },
+        has: (target, prop) => {
+          schemaReads++;
+          return Reflect.has(target, prop);
+        },
+        ownKeys: target => {
+          schemaReads++;
+          return Reflect.ownKeys(target);
+        },
+      }
+    );
+    const registry = new ToolRegistry();
+    registry.register(staticTool(schema), async () => 'ran');
+
+    const readsAtRegister = schemaReads;
+    const rejections: string[] = [];
+    for (let round = 0; round < 10; round++) {
+      rejections.push((await registry.execute('weather', {})).result);
+    }
+
+    expect({readsPerExecute: schemaReads - readsAtRegister, rejections}).toEqual({
+      readsPerExecute: 0,
+      rejections: Array.from({length: 10}, () => expect.stringMatching(/location/)),
+    });
+  });
+
+  it('validates a function-valued definition against the schema current at each call', async () => {
+    const registry = new ToolRegistry();
+    const alphaSchema: Record<string, unknown> = {
+      type: 'object',
+      properties: {alpha: {type: 'string'}},
+      required: ['alpha'],
+    };
+    const betaSchema: Record<string, unknown> = {
+      type: 'object',
+      properties: {beta: {type: 'string'}},
+      required: ['beta'],
+    };
+    let currentSchema = alphaSchema;
+    registry.register(
+      () => ({name: 'widget', description: 'looks up a widget', inputSchema: currentSchema}),
+      async input => `ran ${Object.keys(input).join(',')}`
+    );
+
+    const first = (await registry.execute('widget', {alpha: 'a'})).result;
+    currentSchema = betaSchema;
+    const stale = (await registry.execute('widget', {alpha: 'a'})).result;
+    const corrected = (await registry.execute('widget', {beta: 'b'})).result;
+
+    expect({first, stale, corrected}).toEqual({
+      first: 'ran alpha',
+      stale: expect.stringMatching(/beta/),
+      corrected: 'ran beta',
+    });
+  });
+
+  it('still throws Unknown tool for an unregistered name', async () => {
+    const registry = new ToolRegistry();
+
+    const outcome = await registry.execute('missing', {}).then(
+      () => 'resolved',
+      (error: Error) => error.message
+    );
+
+    expect(outcome).toBe('Unknown tool: missing');
+  });
+});