+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, Message, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const weatherSchema: Record<string, unknown> = {
+  type: 'object',
+  properties: {location: {type: 'string'}},
+  required: ['location'],
+};
+
+// Rounds are scripted up front; the provider records what it was sent before answering each one.
+const scriptedProvider = (rounds: MessageChunk[][], sentRounds: Message[][]): AIProvider => {
+  let round = 0;
+  return {
+    async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      sentRounds.push(params.messages);
+      const scripted = rounds[round];
+      round++;
+      yield* scripted;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+describe('ChatOrchestrator tool input validation', () => {
+  it('feeds a rejected tool call back to the provider and completes on the corrected retry', async () => {
+    const sentRounds: Message[][] = [];
+    const executorInputs: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      {name: 'weather', description: 'looks up the weather for a place', inputSchema: weatherSchema},
+      async input => {
+        executorInputs.push(input);
+        return 'ran';
+      }
+    );
+    const provider = scriptedProvider(
+      [
+        [
+          {type: 'tool_use', toolCall: {id: 'call-1', name: 'weather', input: {}}},
+          {type: 'stop', stopReason: 'tool_use'},
+        ],
+        [
+          {type: 'tool_use', toolCall: {id: 'call-2', name: 'weather', input: {location: 'Kigali'}}},
+          {type: 'stop', stopReason: 'tool_use'},
+        ],
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ],
+      ],
+      sentRounds
+    );
+    const orchestrator = createChatOrchestrator(
+      provider,
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      registry
+    );
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'what is the weather in Kigali', timestamp: SENT_AT}],
+    };
+
+    const text = await orchestrator.processMessage(session);
+
+    const secondRoundLast = sentRounds[1][sentRounds[1].length - 1];
+    const fedBack = Array.isArray(secondRoundLast.content)
+      ? secondRoundLast.content.map(block => (block.type === 'tool_result' ? block.content : '')).join('')
+      : secondRoundLast.content;
+
+    expect({resolved: text, fedBack, executorInputs}).toEqual({
+      resolved: 'done',
+      fedBack: expect.stringMatching(/location/),
+      executorInputs: [{location: 'Kigali'}],
+    });
+  });
+});
diff --git a/src/orchestration/tools/registry.acceptance.test.ts b/src/orchestration/tools/registry.acceptance.test.ts
