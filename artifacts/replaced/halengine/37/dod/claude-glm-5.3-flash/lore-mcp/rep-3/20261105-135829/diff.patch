@@ -0,0 +1,234 @@
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {ToolRegistry} from './registry.js';
+import type {ToolExecutor, ToolResponse} from './registry.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+// The schema every test below starts from: one required string property.
+const weatherSchema: Record<string, unknown> = {
+  type: 'object',
+  properties: {location: {type: 'string'}},
+  required: ['location'],
+};
+
+const registerWeatherTool = (registry: ToolRegistry, schema: Record<string, unknown>, executor: ToolExecutor): void => {
+  registry.register({name: 'get_weather', description: 'weather for a place', inputSchema: schema}, executor);
+};
+
+// Feed the logger's real output path, so a leaked value is caught where an operator would read it.
+const recordingLogger = (capturedLines: string[]): Logger => {
+  const keep = (category: string, message: string, fields?: Record<string, unknown>): void => {
+    capturedLines.push(JSON.stringify({category, message, fields}));
+  };
+  return {debug: keep, info: keep, warn: keep, error: keep};
+};
+
+describe('ToolRegistry input validation', () => {
+  it('rejects a call missing a required property, naming it, without invoking the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registerWeatherTool(registry, weatherSchema, async () => {
+      executorCalls += 1;
+      return 'executor ran';
+    });
+
+    const rejection = await registry.execute('get_weather', {});
+
+    expect({
+      executorCalls,
+      namesRequiredLocation: rejection.result.includes('location') && rejection.result.includes('required'),
+    }).toEqual({executorCalls: 0, namesRequiredLocation: true});
+  });
+
+  it('passes accepted input through to the executor unchanged, exactly once', async () => {
+    const registry = new ToolRegistry();
+    const executorInputs: Record<string, unknown>[] = [];
+    registerWeatherTool(registry, weatherSchema, async input => {
+      executorInputs.push(input);
+      return 'executor ran';
+    });
+
+    await registry.execute('get_weather', {location: 'Hill End', units: 'metric'});
+
+    expect(executorInputs).toEqual([{location: 'Hill End', units: 'metric'}]);
+  });
+
+  it('rejects a wrong-typed field naming the path and expected type, never the value', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registerWeatherTool(registry, weatherSchema, async () => {
+      executorCalls += 1;
+      return 'executor ran';
+    });
+
+    const rejection = await registry.execute('get_weather', {location: 4242});
+
+    expect({
+      executorCalls,
+      namesPath: rejection.result.includes('location'),
+      namesExpectedType: rejection.result.includes('string'),
+      carriesValue: rejection.result.includes('4242'),
+    }).toEqual({executorCalls: 0, namesPath: true, namesExpectedType: true, carriesValue: false});
+  });
+
+  it('rejects a value outside an enum without leaking identifying input into result or logs', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registerWeatherTool(
+      registry,
+      {
+        type: 'object',
+        properties: {location: {type: 'string'}, units: {type: 'string', enum: ['celsius', 'fahrenheit']}},
+        required: ['location'],
+      },
+      async () => {
+        executorCalls += 1;
+        return 'executor ran';
+      }
+    );
+
+    const logLines: string[] = [];
+    setLogger(recordingLogger(logLines));
+    let rejection: ToolResponse | undefined;
+    try {
+      rejection = await registry.execute('get_weather', {location: '12 Acacia Road', units: 'kelvin'});
+    } finally {
+      setLogger();
+    }
+
+    expect({
+      executorCalls,
+      namesFailedPath: rejection?.result.includes('units') === true,
+      leakedAddress:
+        rejection?.result.includes('12 Acacia Road') === true || logLines.some(line => line.includes('12 Acacia Road')),
+    }).toEqual({executorCalls: 0, namesFailedPath: true, leakedAddress: false});
+  });
+
+  it('refuses an uncompilable schema at registration, naming the tool', () => {
+    const registry = new ToolRegistry();
+    let thrownMessage: string | undefined;
+    try {
+      registry.register(
+        {
+          name: 'get_weather',
+          description: 'weather for a place',
+          inputSchema: {type: 'object', properties: {location: {type: 'strng'}}},
+        },
+        async () => 'executor ran'
+      );
+    } catch (error) {
+      thrownMessage = error instanceof Error ? error.message : String(error);
+    }
+
+    expect({threw: thrownMessage !== undefined, namesTool: thrownMessage?.includes('get_weather') === true}).toEqual({
+      threw: true,
+      namesTool: true,
+    });
+  });
+
+  it('validates a function-valued definition against the schema current at each call', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    let currentSchema: Record<string, unknown> = weatherSchema;
+    registry.register(
+      () => ({name: 'get_weather', description: 'weather for a place', inputSchema: currentSchema}),
+      async () => {
+        executorCalls += 1;
+        return 'executor ran';
+      }
+    );
+
+    const first = await registry.execute('get_weather', {location: 'Hill End'});
+    const callsAfterFirst = executorCalls;
+    currentSchema = {type: 'object', properties: {year: {type: 'number'}}, required: ['year']};
+    const second = await registry.execute('get_weather', {location: 'Hill End'});
+
+    expect({
+      callsAfterFirst,
+      firstResult: first.result,
+      secondRejectedAgainstCurrentSchema: second.result !== 'executor ran' && second.result.includes('year'),
+    }).toEqual({callsAfterFirst: 1, firstResult: 'executor ran', secondRejectedAgainstCurrentSchema: true});
+  });
+
+  it('still throws Unknown tool for an unregistered name', async () => {
+    const registry = new ToolRegistry();
+    let thrownMessage: string | undefined;
+    try {
+      await registry.execute('no_such_tool', {});
+    } catch (error) {
+      thrownMessage = error instanceof Error ? error.message : String(error);
+    }
+
+    expect(thrownMessage).toBe('Unknown tool: no_such_tool');
+  });
+
+  it('returns a rejected tool call to the provider so the next round can correct it', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registerWeatherTool(registry, weatherSchema, async () => {
+      executorCalls += 1;
+      return 'sunny';
+    });
+
+    // One scripted round per sendMessage call; round 1 asks with an empty input, round 2 corrects it.
+    const rounds: MessageChunk[][] = [
+      [
+        {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Hill End'}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'text', text: 'the weather in Hill End is sunny'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ];
+    const providerSeen: string[] = [];
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        providerSeen.push(JSON.stringify(params.messages));
+        for (const chunk of rounds[round] ?? []) yield chunk;
+        round += 1;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'what is the weather in Hill End', timestamp: SENT_AT}],
+    };
+
+    let text: string | undefined;
+    let failure: unknown;
+    try {
+      text = await orchestrator.processMessage(session);
+    } catch (error) {
+      failure = error;
+    }
+
+    expect({
+      text,
+      threw: failure !== undefined,
+      executorCalls,
+      rejectionReachedProvider: (providerSeen[1] ?? '').includes('required'),
+    }).toEqual({
+      text: 'the weather in Hill End is sunny',
+      threw: false,
+      executorCalls: 1,
+      rejectionReachedProvider: true,
+    });
+  });
+});