@@ -0,0 +1,197 @@
+// Acceptance tests for tool input validation — the contract lives in specs/hal-engine-tool-input-validation/spec.md.
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import type {AIProvider, Message, MessageChunk, SendMessageParams, ToolResultContent} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import {ToolRegistry} from './registry.js';
+import type {ToolExecutor, ToolResponse} from './registry.js';
+
+// The calls an executor actually received, so a test can assert what reached it.
+const recordingExecutor = (): {calls: Record<string, unknown>[]; run: ToolExecutor} => {
+  const calls: Record<string, unknown>[] = [];
+  const run: ToolExecutor = async input => {
+    calls.push(input);
+    return 'tool ran';
+  };
+  return {calls, run};
+};
+
+// Fresh schema per test: two of them mutate or replace the object after register.
+const locationSchema = (): Record<string, unknown> => ({
+  type: 'object',
+  properties: {location: {type: 'string'}},
+  required: ['location'],
+});
+
+const weatherTool = (inputSchema: Record<string, unknown>) => ({
+  name: 'get_weather',
+  description: 'current weather for a location',
+  inputSchema,
+});
+
+const session = (content: string): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content, timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const toolResultParts = (messages: Message[]): ToolResultContent[] => {
+  const parts = messages.flatMap(message => (Array.isArray(message.content) ? message.content : []));
+  return parts.filter((part): part is ToolResultContent => part.type === 'tool_result');
+};
+
+// One scripted round per sendMessage call, recording the tool_result text each round is handed.
+const scriptedRounds = (rounds: MessageChunk[][]): {provider: AIProvider; toolResultTexts: string[]} => {
+  const toolResultTexts: string[] = [];
+  let round = 0;
+  return {
+    toolResultTexts,
+    provider: {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        toolResultParts(params.messages).forEach(part => toolResultTexts.push(part.content));
+        for (const chunk of rounds[round++] ?? []) yield chunk;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    },
+  };
+};
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}};
+const STOP_FOR_TOOL: MessageChunk = {type: 'stop', stopReason: 'tool_use'};
+const STOP_DONE: MessageChunk = {type: 'stop', stopReason: 'end_turn'};
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ToolRegistry input validation', () => {
+  it('returns a rejection naming what the schema rejected and skips the executor', async () => {
+    const {calls, run} = recordingExecutor();
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'current weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}, units: {type: 'string', enum: ['celsius', 'fahrenheit']}},
+          required: ['location'],
+        },
+      },
+      run
+    );
+
+    const missingLocation = await registry.execute('get_weather', {});
+    const offMenuUnits = await registry.execute('get_weather', {location: 'Berlin', units: 'kelvin'});
+
+    expect({
+      executed: calls.length,
+      namesMissing: missingLocation.result.includes('location'),
+      namesUnits: offMenuUnits.result.includes('units'),
+    }).toEqual({executed: 0, namesMissing: true, namesUnits: true});
+  });
+
+  it('passes accepted input to the executor unchanged, extra properties included', async () => {
+    const {calls, run} = recordingExecutor();
+    const registry = new ToolRegistry();
+    registry.register(weatherTool(locationSchema()), run);
+
+    await registry.execute('get_weather', {location: 'Berlin', units: 'metric'});
+
+    expect({executed: calls.length, received: calls[0]}).toEqual({
+      executed: 1,
+      received: {location: 'Berlin', units: 'metric'},
+    });
+  });
+
+  it('rejects a wrong-typed field naming the path and expected type, redacting the value', async () => {
+    const {calls, run} = recordingExecutor();
+    const registry = new ToolRegistry();
+    registry.register(weatherTool(locationSchema()), run);
+    const logged: string[] = [];
+    const record = (level: string) => (category: string, message: string) => void logged.push(`${level} ${message}`);
+    setLogger({debug: record('DEBUG'), info: record('INFO'), warn: record('WARN'), error: record('ERROR')});
+    let response: ToolResponse;
+    try {
+      response = await registry.execute('get_weather', {location: 424242, requestedFor: 'patient-778899'});
+    } finally {
+      setLogger();
+    }
+
+    const seen = [response.result, ...logged].join('\n');
+    expect({
+      executed: calls.length,
+      namesPath: response.result.includes('location'),
+      namesType: response.result.includes('string'),
+      valueRedacted: seen.includes('424242') || seen.includes('patient-778899'),
+    }).toEqual({executed: 0, namesPath: true, namesType: true, valueRedacted: false});
+  });
+
+  it('throws at register when the input schema cannot compile, naming the tool', () => {
+    const {run} = recordingExecutor();
+    const registry = new ToolRegistry();
+
+    expect(() => registry.register(weatherTool({type: 'objct', properties: {}}), run)).toThrow(/get_weather/);
+  });
+
+  it('validates a function-valued definition against the schema current at each call', async () => {
+    const {calls, run} = recordingExecutor();
+    const registry = new ToolRegistry();
+    let currentSchema = locationSchema();
+    registry.register(() => weatherTool(currentSchema), run);
+
+    const first = await registry.execute('get_weather', {});
+    currentSchema = {type: 'object'};
+    await registry.execute('get_weather', {});
+
+    expect({executed: calls.length, firstNamesLocation: first.result.includes('location')}).toEqual({
+      executed: 1,
+      firstNamesLocation: true,
+    });
+  });
+
+  it('keeps validating a static tool against the schema it was registered with', async () => {
+    const {calls, run} = recordingExecutor();
+    const registry = new ToolRegistry();
+    const registeredSchema = locationSchema();
+    registry.register(weatherTool(registeredSchema), run);
+    // Loosened after register: only a schema compiled at register time can ignore the edit.
+    registeredSchema.required = [];
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({executed: calls.length, namesLocation: response.result.includes('location')}).toEqual({
+      executed: 0,
+      namesLocation: true,
+    });
+  });
+
+  // Pins the one failure the ticket keeps as a throw rather than a returned rejection.
+  it('still throws Unknown tool for a name that was never registered', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('ghost_tool', {})).rejects.toThrow('Unknown tool: ghost_tool');
+  });
+});
+
+describe('input validation through the orchestrator tool loop', () => {
+  it('returns a rejected tool call to the provider so the next round can correct it', async () => {
+    const {calls, run} = recordingExecutor();
+    const registry = new ToolRegistry();
+    registry.register(weatherTool(locationSchema()), run);
+    const {provider, toolResultTexts} = scriptedRounds([
+      [TOOL_CALL, STOP_FOR_TOOL],
+      [{type: 'text', text: '18 degrees in Berlin'}, STOP_DONE],
+    ]);
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+
+    const text = await orchestrator.processMessage(session('weather in Berlin?'));
+
+    expect({resolved: text, delivered: toolResultTexts, executed: calls.length}).toEqual({
+      resolved: '18 degrees in Berlin',
+      delivered: [expect.stringContaining('location')],
+      executed: 0,
+    });
+  });
+});