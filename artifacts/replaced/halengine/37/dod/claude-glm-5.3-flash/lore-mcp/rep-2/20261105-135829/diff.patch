+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const session = (content: string): ChatSession => ({
+  sessionId: 'acceptance-session',
+  userId: 'user-1',
+  entries: [{role: 'user', content, timestamp: SENT_AT}],
+});
+
+it('returns a rejected tool call to the model as a tool result the next round can correct', async () => {
+  const calls: Array<Array<unknown>> = [];
+  const registry = new ToolRegistry();
+  registry.register(
+    {
+      name: 'lookup',
+      description: 'looks things up by query',
+      inputSchema: {type: 'object', properties: {q: {type: 'string'}}, required: ['q']},
+    },
+    async input => {
+      calls.push([input]);
+      return 'found it';
+    }
+  );
+
+  // Snapshot of the tool_result contents the provider was shown, one entry per sendMessage round.
+  const toolResultsPerRound: string[][] = [];
+  let round = 0;
+  const provider: AIProvider = {
+    async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      round += 1;
+      const results = params.messages.flatMap(message =>
+        Array.isArray(message.content) ? message.content.filter(part => part.type === 'tool_result') : []
+      );
+      toolResultsPerRound.push(results.map(part => part.content));
+      if (round === 1) {
+        yield {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {}}};
+        yield {type: 'stop', stopReason: 'tool_use'};
+        return;
+      }
+      if (round === 2) {
+        yield {type: 'tool_use', toolCall: {id: 'call-2', name: 'lookup', input: {q: 'the corrected query'}}};
+        yield {type: 'stop', stopReason: 'tool_use'};
+        return;
+      }
+      yield {type: 'text', text: 'done'};
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'You are under test.'}), registry);
+  const text = await orchestrator.processMessage(session('find things'));
+
+  const rejectionShown = toolResultsPerRound[1]?.join(' ') ?? '';
+  expect({
+    text,
+    executorCalls: calls.length,
+    rejectionShown,
+    retryResultShown: toolResultsPerRound[2]?.join(' ') ?? '',
+  }).toEqual({
+    text: 'done',
+    executorCalls: 1,
+    rejectionShown: expect.stringContaining('q'),
+    retryResultShown: 'found it',
+  });
+});
