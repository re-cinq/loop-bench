@@ -0,0 +1,193 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolExecutor} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+import {setLogger} from '../../shared/logger.js';
+
+// A real executor that notes what it was handed, so a test can assert on the count and the argument.
+const executorRecording =
+  (calls: Array<Array<unknown>>, result = 'ok'): ToolExecutor =>
+  async input => {
+    calls.push([input]);
+    return result;
+  };
+
+const definitionNamed = (name: string, inputSchema: Record<string, unknown>): ToolDefinition => ({
+  name,
+  description: `${name} as registered by the acceptance tests`,
+  inputSchema,
+});
+
+const schemaRequiring = (property: string, expectedType = 'string'): Record<string, unknown> => ({
+  type: 'object',
+  properties: {[property]: {type: expectedType}},
+  required: [property],
+});
+
+describe('ToolRegistry input validation acceptance', () => {
+  let lines: string[];
+
+  beforeEach(() => {
+    lines = [];
+    const collect = (category: string, message: string, fields?: Record<string, unknown>): void => {
+      lines.push(JSON.stringify({category, message, fields}));
+    };
+    setLogger({debug: collect, info: collect, warn: collect, error: collect});
+  });
+
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('rejects a missing required property before the executor runs and names it as required', async () => {
+    const calls: Array<Array<unknown>> = [];
+    const registry = new ToolRegistry();
+    registry.register(definitionNamed('get_weather', schemaRequiring('location')), executorRecording(calls, 'sunny'));
+
+    const rejection = await registry.execute('get_weather', {});
+
+    expect({
+      executorCalls: calls.length,
+      namesProperty: rejection.result.includes('location'),
+      namesConstraint: rejection.result.includes('required'),
+    }).toEqual({executorCalls: 0, namesProperty: true, namesConstraint: true});
+  });
+
+  it('hands valid input to the executor unchanged, extras included, exactly once', async () => {
+    const calls: Array<Array<unknown>> = [];
+    const registry = new ToolRegistry();
+    registry.register(definitionNamed('get_weather', schemaRequiring('location')), executorRecording(calls));
+
+    const input = {location: 'Berlin', extra: 'unlisted'};
+    await registry.execute('get_weather', input);
+
+    const received = calls.map(([handed]) => handed);
+    expect({received, executorCalls: calls.length}).toEqual({
+      received: [{location: 'Berlin', extra: 'unlisted'}],
+      executorCalls: 1,
+    });
+  });
+
+  it('rejects a wrong-typed field naming the path and expected type, never the value', async () => {
+    const calls: Array<Array<unknown>> = [];
+    const registry = new ToolRegistry();
+    registry.register(definitionNamed('get_weather', schemaRequiring('location')), executorRecording(calls));
+
+    const rejection = await registry.execute('get_weather', {location: 42});
+
+    expect({
+      executorCalls: calls.length,
+      namesPath: rejection.result.includes('location'),
+      namesExpectedType: rejection.result.includes('string'),
+      leaksValue: rejection.result.includes('42'),
+    }).toEqual({executorCalls: 0, namesPath: true, namesExpectedType: true, leaksValue: false});
+  });
+
+  it('rejects a value outside a declared enum, naming the property', async () => {
+    const calls: Array<Array<unknown>> = [];
+    const schema: Record<string, unknown> = {
+      type: 'object',
+      properties: {units: {type: 'string', enum: ['celsius', 'fahrenheit']}},
+      required: ['units'],
+    };
+    const registry = new ToolRegistry();
+    registry.register(definitionNamed('get_weather', schema), executorRecording(calls));
+
+    const rejection = await registry.execute('get_weather', {units: 'kelvin'});
+
+    expect({executorCalls: calls.length, namesProperty: rejection.result.includes('units')}).toEqual({
+      executorCalls: 0,
+      namesProperty: true,
+    });
+  });
+
+  it('refuses an uncompilable schema at registration, naming the tool', () => {
+    const registry = new ToolRegistry();
+    let message = '';
+    try {
+      registry.register(
+        definitionNamed('broken', {type: 'object', properties: {city: {type: 'nonsense'}}}),
+        async () => 'ok'
+      );
+    } catch (error) {
+      message = error instanceof Error ? error.message : String(error);
+    }
+
+    expect({message, namesTool: message.includes('broken')}).toEqual({
+      message: expect.stringContaining('broken'),
+      namesTool: true,
+    });
+  });
+
+  it('validates a function-valued definition against the schema current at that call', async () => {
+    const calls: Array<Array<unknown>> = [];
+    const registry = new ToolRegistry();
+    const current: {inputSchema: Record<string, unknown>} = {inputSchema: schemaRequiring('location')};
+    registry.register(() => definitionNamed('get_weather', current.inputSchema), executorRecording(calls));
+
+    const accepted = await registry.execute('get_weather', {location: 'Berlin'});
+    current.inputSchema = schemaRequiring('region');
+    const rejected = await registry.execute('get_weather', {location: 'Berlin'});
+
+    expect({
+      executorCalls: calls.length,
+      firstAccepted: accepted.result === 'ok',
+      secondNamesCurrentRequirement: rejected.result.includes('region'),
+    }).toEqual({executorCalls: 1, firstAccepted: true, secondNamesCurrentRequirement: true});
+  });
+
+  it('compiles a static schema once across ten execute calls', async () => {
+    const calls: Array<Array<unknown>> = [];
+    let schemaReads = 0;
+    const schema: Record<string, unknown> = {
+      type: 'object',
+      required: ['location'],
+      get properties(): Record<string, unknown> {
+        schemaReads += 1;
+        return {location: {type: 'string'}};
+      },
+    };
+    const registry = new ToolRegistry();
+    registry.register(definitionNamed('get_weather', schema), executorRecording(calls));
+
+    await registry.execute('get_weather', {location: 'first'});
+    const readsAfterFirst = schemaReads;
+    for (let round = 0; round < 9; round += 1) {
+      await registry.execute('get_weather', {location: 'later'});
+    }
+
+    expect({
+      executorCalls: calls.length,
+      compiled: readsAfterFirst > 0,
+      readAgainPerCall: schemaReads > readsAfterFirst,
+    }).toEqual({executorCalls: 10, compiled: true, readAgainPerCall: false});
+  });
+
+  it('still throws Unknown tool for an unregistered name', async () => {
+    const registry = new ToolRegistry();
+
+    const message = await registry.execute('no_such_tool', {}).then(
+      () => 'resolved without throwing',
+      (error: Error) => error.message
+    );
+
+    expect(message).toEqual('Unknown tool: no_such_tool');
+  });
+
+  it('keeps rejected input values out of the rejection and the log', async () => {
+    const calls: Array<Array<unknown>> = [];
+    const echoExecutor: ToolExecutor = async input => {
+      calls.push([input]);
+      return JSON.stringify(input);
+    };
+    const registry = new ToolRegistry();
+    registry.register(definitionNamed('get_weather', schemaRequiring('location')), echoExecutor);
+
+    const rejection = await registry.execute('get_weather', {location: 42, note: 'secret-note-77'});
+    const logged = lines.join('\n');
+
+    expect({
+      executorCalls: calls.length,
+      leaksAValue: rejection.result.includes('secret-note-77') || logged.includes('secret-note-77'),
+    }).toEqual({executorCalls: 0, leaksAValue: false});
+  });
+});