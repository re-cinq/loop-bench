+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+// Issue #37: a rejected tool call must return to the model as a tool result, not end the conversation.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const toolRegistry = (calls: Record<string, unknown>[]): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {
+      name: 'get_weather',
+      description: 'current weather',
+      inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+    },
+    async input => {
+      calls.push(input);
+      return `forecast for ${String(input.location)}`;
+    }
+  );
+  return registry;
+};
+
+// One scripted round per sendMessage call; each round records the message contents it was handed.
+const retryingProvider = (): {provider: AIProvider; seenRounds: string[][]} => {
+  const seenRounds: string[][] = [];
+
+  const provider: AIProvider = {
+    async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      seenRounds.push(params.messages.map(m => JSON.stringify(m.content)));
+      if (seenRounds.length === 1) {
+        yield {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}};
+        yield {type: 'stop', stopReason: 'tool_use'};
+        return;
+      }
+      if (seenRounds.length === 2) {
+        yield {type: 'tool_use', toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Berlin'}}};
+        yield {type: 'stop', stopReason: 'tool_use'};
+        return;
+      }
+      yield {type: 'text', text: 'done'};
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+
+  return {provider, seenRounds};
+};
+
+describe('ChatOrchestrator rejected tool call', () => {
+  it('feeds a rejected tool call back to the provider as a tool result and resolves on the corrected retry', async () => {
+    const calls: Record<string, unknown>[] = [];
+    const {provider, seenRounds} = retryingProvider();
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, toolRegistry(calls));
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'weather in Berlin?', timestamp: SENT_AT}],
+    };
+
+    const text = await orchestrator.processMessage(session);
+
+    expect({
+      resolved: text,
+      retrySaw: seenRounds[1]?.join('\n'),
+      executorCalls: calls.length,
+      executedInput: calls[0],
+    }).toEqual({
+      resolved: 'done',
+      retrySaw: expect.stringMatching(/location[\s\S]*required|required[\s\S]*location/),
+      executorCalls: 1,
+      executedInput: {location: 'Berlin'},
+    });
+  });
+});
diff --git a/src/orchestration/tools/registry.acceptance.test.ts b/src/orchestration/tools/registry.acceptance.test.ts
