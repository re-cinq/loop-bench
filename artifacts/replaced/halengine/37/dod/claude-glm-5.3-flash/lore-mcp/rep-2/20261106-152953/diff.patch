@@ -0,0 +1,161 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+import {setLogger} from '../../shared/logger.js';
+
+// Issue #37: execute must validate input against the registered inputSchema before the executor runs.
+const WEATHER_SCHEMA: ToolDefinition['inputSchema'] = {
+  type: 'object',
+  properties: {
+    location: {type: 'string', description: 'The city name to look up.'},
+    units: {type: 'string', enum: ['celsius', 'fahrenheit']},
+  },
+  required: ['location'],
+};
+
+const SECRET = 'person@example.com';
+
+const weatherRegistry = (calls: Record<string, unknown>[]): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register({name: 'get_weather', description: 'current weather', inputSchema: WEATHER_SCHEMA}, async input => {
+    calls.push(input);
+    return 'forecast';
+  });
+  return registry;
+};
+
+const captureLogLines = (): {lines: string[]} => {
+  const lines: string[] = [];
+  const record = (message: string, fields?: Record<string, unknown>) =>
+    void lines.push(JSON.stringify({message, fields: fields ?? {}}));
+  setLogger({
+    debug: (_category, message, fields) => record(message, fields),
+    info: (_category, message, fields) => record(message, fields),
+    warn: (_category, message, fields) => record(message, fields),
+    error: (_category, message, fields) => record(message, fields),
+  });
+  return {lines};
+};
+
+describe('ToolRegistry input validation', () => {
+  afterEach(() => setLogger());
+
+  it('rejects a call missing a required property before the executor runs', async () => {
+    const calls: Record<string, unknown>[] = [];
+    const registry = weatherRegistry(calls);
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({executorCalls: calls.length, rejection: response.result}).toEqual({
+      executorCalls: 0,
+      rejection: expect.stringMatching(/location[\s\S]*required|required[\s\S]*location/),
+    });
+  });
+
+  it('rejects a wrong-typed property naming the path and expected type without echoing the value', async () => {
+    const calls: Record<string, unknown>[] = [];
+    const registry = weatherRegistry(calls);
+
+    const response = await registry.execute('get_weather', {location: 987654321});
+
+    expect({
+      executorCalls: calls.length,
+      namesFieldAndType: /location/.test(response.result) && /string/.test(response.result),
+      echoesValue: response.result.includes('987654321'),
+    }).toEqual({executorCalls: 0, namesFieldAndType: true, echoesValue: false});
+  });
+
+  it('rejects a value outside a declared enum naming the property', async () => {
+    const calls: Record<string, unknown>[] = [];
+    const registry = weatherRegistry(calls);
+
+    const response = await registry.execute('get_weather', {location: 'Berlin', units: 'kelvin'});
+
+    expect({executorCalls: calls.length, rejection: response.result}).toEqual({
+      executorCalls: 0,
+      rejection: expect.stringContaining('units'),
+    });
+  });
+
+  it('passes valid input with an unlisted property through to the executor unchanged, exactly once', async () => {
+    const calls: Record<string, unknown>[] = [];
+    const registry = weatherRegistry(calls);
+
+    await registry.execute('get_weather', {});
+    const response = await registry.execute('get_weather', {location: 'Berlin', extra: 'unlisted'});
+
+    expect({executorCalls: calls.length, seen: calls[0], result: response.result}).toEqual({
+      executorCalls: 1,
+      seen: {location: 'Berlin', extra: 'unlisted'},
+      result: 'forecast',
+    });
+  });
+
+  it('throws at registration time for a schema that cannot compile, naming the tool', () => {
+    const registry = new ToolRegistry();
+
+    const registration = () =>
+      registry.register(
+        {
+          name: 'broken_tool',
+          description: 'broken schema',
+          inputSchema: {type: 'object', properties: {location: {type: 42}}},
+        },
+        async () => 'unused'
+      );
+
+    expect(registration).toThrow(/broken_tool/);
+  });
+
+  it('validates a function-valued definition against the schema current at each call', async () => {
+    const calls: Record<string, unknown>[] = [];
+    let requireLocation = true;
+    const registry = new ToolRegistry();
+    registry.register(
+      () => ({
+        name: 'dynamic_lookup',
+        description: 'schema changes between calls',
+        inputSchema: requireLocation
+          ? {type: 'object', properties: {location: {type: 'string'}}, required: ['location']}
+          : {type: 'object', properties: {city: {type: 'string'}}, required: ['city']},
+      }),
+      async input => {
+        calls.push(input);
+        return 'found';
+      }
+    );
+
+    await registry.execute('dynamic_lookup', {location: 'Berlin'});
+    requireLocation = false;
+    const stale = await registry.execute('dynamic_lookup', {location: 'Berlin'});
+
+    expect({executed: calls.length, secondResult: stale.result}).toEqual({
+      executed: 1,
+      secondResult: expect.stringMatching(/city/),
+    });
+  });
+
+  it('carries no property value from a rejected payload into the log lines or the returned text', async () => {
+    const {lines} = captureLogLines();
+    const calls: Record<string, unknown>[] = [];
+    const registry = weatherRegistry(calls);
+
+    const response = await registry.execute('get_weather', {location: 'Berlin', email: SECRET, units: 123});
+
+    expect({
+      executorCalls: calls.length,
+      namesFailedPath: /units/.test(response.result),
+      leakedValue: lines.some(line => line.includes(SECRET)) || response.result.includes(SECRET),
+    }).toEqual({executorCalls: 0, namesFailedPath: true, leakedValue: false});
+  });
+
+  it('still throws for an unregistered tool name', async () => {
+    const registry = new ToolRegistry();
+
+    const outcome = await registry.execute('no_such_tool', {}).then(
+      () => 'resolved',
+      (error: Error) => error.message
+    );
+
+    expect(outcome).toBe('Unknown tool: no_such_tool');
+  });
+});