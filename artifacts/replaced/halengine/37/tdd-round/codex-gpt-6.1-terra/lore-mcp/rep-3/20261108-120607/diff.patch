+import {jest} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+
+describe('specs/hal-engine-tool-input-validation/spec.md#5', () => {
+  it('rejects an invalid static schema at registration', () => {
+    const registry = new ToolRegistry();
+    expect(() =>
+      registry.register({name: 'weather', description: 'Weather', inputSchema: {type: 'invalid'}}, async () => 'ok')
+    ).toThrow(/weather/);
+  });
+});
+
+describe('specs/hal-engine-tool-input-validation/spec.md#7', () => {
+  it('compiles a reused dynamic schema once', async () => {
+    const registry = new ToolRegistry();
+    const compile = jest.spyOn(registry['ajv'], 'compile');
+    const inputSchema = {type: 'object'};
+    registry.register(
+      () => ({name: 'weather', description: 'Weather', inputSchema}),
+      async () => 'ok'
+    );
+    await registry.execute('weather', {});
+    await registry.execute('weather', {});
+    expect(compile).toHaveBeenCalledTimes(1);
+  });
+});
+
+describe('specs/hal-engine-tool-input-validation/spec.md#1', () => {
+  it('returns a rejection for missing required input without executing', async () => {
+    const registry = new ToolRegistry();
+    const execute = jest.fn(async () => 'ok');
+    registry.register(
+      {name: 'weather', description: 'Weather', inputSchema: {type: 'object', required: ['location']}},
+      execute
+    );
+    const response = await registry.execute('weather', {});
+    const calls = execute.mock.calls;
+    expect({result: response.result, calls: calls.length}).toEqual({
+      result: expect.stringMatching(/location.*required|required.*location/i),
+      calls: 0,
+    });
+  });
+});
