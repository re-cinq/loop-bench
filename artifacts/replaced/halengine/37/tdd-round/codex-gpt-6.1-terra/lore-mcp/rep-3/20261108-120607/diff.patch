+describe('specs/hal-engine-tool-input-validation/spec.md#9', () => {
+  it('identifies a disallowed extra property by its escaped path', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {name: 'weather', description: 'Weather', inputSchema: {type: 'object', additionalProperties: false}},
+      async () => 'ok'
