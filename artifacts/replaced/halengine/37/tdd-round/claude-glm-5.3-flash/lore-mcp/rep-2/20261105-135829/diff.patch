@@ -0,0 +1,197 @@
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry inputSchema validation', () => {
+  it('rejects input missing a required property and never calls the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'sunny';
+      }
+    );
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({
+      executorCalls,
+      namesLocationAsRequired: response.result.includes('location') && /required/i.test(response.result),
+    }).toEqual({
+      executorCalls: 0,
+      namesLocationAsRequired: true,
+    });
+  });
+
+  it('rejects a wrong-typed property naming the field path and expected type without echoing the value', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'lookup_record',
+        description: 'Look up a record',
+        inputSchema: {
+          type: 'object',
+          properties: {recordId: {type: 'string'}},
+          required: ['recordId'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'found';
+      }
+    );
+
+    const response = await registry.execute('lookup_record', {recordId: 424242});
+
+    expect({
+      executorCalls,
+      namesFieldPath: response.result.includes('recordId'),
+      namesExpectedType: response.result.includes('string'),
+      echoesValue: response.result.includes('424242'),
+    }).toEqual({
+      executorCalls: 0,
+      namesFieldPath: true,
+      namesExpectedType: true,
+      echoesValue: false,
+    });
+  });
+
+  it('passes valid input with an unlisted extra property through to the executor unchanged, exactly once', async () => {
+    const registry = new ToolRegistry();
+    const executorInputs: Array<Record<string, unknown>> = [];
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async input => {
+        executorInputs.push(input);
+        return 'sunny';
+      }
+    );
+
+    const response = await registry.execute('get_weather', {location: 'Berlin', tz: 'Europe/Berlin'});
+
+    expect({executorInputs, response}).toEqual({
+      executorInputs: [{location: 'Berlin', tz: 'Europe/Berlin'}],
+      response: {result: 'sunny'},
+    });
+  });
+
+  it('throws at register time naming the tool when a static inputSchema cannot be compiled', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_weather',
+          description: 'Declares a type JSON Schema does not define',
+          inputSchema: {
+            type: 'object',
+            properties: {location: {type: 'not-a-json-schema-type'}},
+          },
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken_weather/);
+  });
+
+  it('validates a function-valued definition against the schema current at each call', async () => {
+    const registry = new ToolRegistry();
+    let requiredProperty = 'location';
+    let executorCalls = 0;
+    registry.register(
+      () => ({
+        name: 'lookup',
+        description: 'Requires whatever property the source currently declares',
+        inputSchema: {
+          type: 'object',
+          properties: {[requiredProperty]: {type: 'string'}},
+          required: [requiredProperty],
+        },
+      }),
+      async () => {
+        executorCalls += 1;
+        return 'ok';
+      }
+    );
+
+    const accepted = await registry.execute('lookup', {location: 'Paris'});
+    requiredProperty = 'region';
+    const rejected = await registry.execute('lookup', {location: 'Paris'});
+
+    expect({
+      executorCalls,
+      accepted: accepted.result,
+      rejectedNamesCurrentRequirement: rejected.result.includes('region') && /required/i.test(rejected.result),
+    }).toEqual({
+      executorCalls: 1,
+      accepted: 'ok',
+      rejectedNamesCurrentRequirement: true,
+    });
+  });
+
+  it('compiles a static schema once and reuses the validator across ten execute calls', async () => {
+    const schema = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    const definition = {
+      name: 'get_weather',
+      description: 'Get weather for a location',
+      inputSchema: schema,
+    };
+    let inputSchemaReads = 0;
+    Object.defineProperty(definition, 'inputSchema', {
+      enumerable: true,
+      get: () => {
+        inputSchemaReads += 1;
+        return schema;
+      },
+    });
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(definition, async () => {
+      executorCalls += 1;
+      return 'sunny';
+    });
+
+    const responses: string[] = [];
+    for (let call = 0; call < 10; call += 1) {
+      const response = await registry.execute('get_weather', {location: 'Berlin'});
+      responses.push(response.result);
+    }
+
+    expect({inputSchemaReads, executorCalls, responses}).toEqual({
+      inputSchemaReads: 1,
+      executorCalls: 10,
+      responses: Array<string>(10).fill('sunny'),
+    });
+  });
+
+  it('throws Unknown tool naming the tool for a name that was never registered', async () => {
+    const registry = new ToolRegistry();
+
+    const outcome = await registry.execute('no_such_tool', {}).then(
+      () => 'resolved',
+      (error: Error) => error.message
+    );
+
+    expect(outcome).toBe('Unknown tool: no_such_tool');
+  });
+});
