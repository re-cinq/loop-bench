+import {createRequire} from 'node:module';
 import type {ToolDefinition} from '../../types/ai.js';
 import type {OutgoingMessage} from '../../types/messages.js';
 import {log} from '../../shared/logger.js';
 
+interface SchemaViolation {
+  instancePath?: string;
+  message?: string;
+}
+
+interface CompiledValidator {
+  (input: unknown): boolean;
+  errors?: SchemaViolation[] | null;
+}
+
+interface AjvLike {
+  compile(schema: ToolDefinition['inputSchema']): CompiledValidator;
+}
+
+// Turns a schema into a validator; injectable so tests can count compilations without reaching into ajv.
+export type SchemaCompiler = (schema: ToolDefinition['inputSchema']) => CompiledValidator;
+
+// ajv is loaded through require and typed structurally here: its published types do not resolve the same way in every install.
+const nodeRequire = createRequire(import.meta.url);
+const {Ajv: AjvConstructor} = nodeRequire('ajv') as {Ajv: new (options?: Record<string, unknown>) => AjvLike};
+
+// Tool schemas are authored loosely, so compile without ajv's strict mode or format validation.
+const ajv = new AjvConstructor({strict: false, validateFormats: false});
+
+const compileWithAjv: SchemaCompiler = schema => ajv.compile(schema);
+
 export interface ToolResponse {
   result: string;
   clientMessages?: OutgoingMessage[];
@@ -35,10 +62,30 @@ export interface RegisteredTool {
 interface StoredTool {
   definitionSource: ToolDefinitionSource;
   execute: ToolExecutor;
+  validators: WeakMap<object, CompiledValidator>;
+}
+
+// A schema that ajv cannot compile is a programming error, not a runtime input problem: name the tool.
+function compileValidator(
+  toolName: string,
+  schema: ToolDefinition['inputSchema'],
+  compile: SchemaCompiler
+): CompiledValidator {
+  try {
+    return compile(schema);
+  } catch (error) {
+    const detail = error instanceof Error ? error.message : String(error);
+    throw new Error(`Invalid inputSchema for tool ${toolName}: ${detail}`, {cause: error});
+  }
 }
 
 export class ToolRegistry {
   private readonly tools = new Map<string, StoredTool>();
+  private readonly compileSchema: SchemaCompiler;
+
+  constructor(compileSchema: SchemaCompiler = compileWithAjv) {
+    this.compileSchema = compileSchema;
