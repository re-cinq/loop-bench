+import type {ToolDefinition} from '../../types/ai.js';
+import {ToolRegistry} from './registry.js';
+import type {ToolExecutor} from './registry.js';
+
+const locationToolSchema = (): ToolDefinition['inputSchema'] => ({
+  type: 'object',
+  properties: {location: {type: 'string'}},
+  required: ['location'],
+});
+
+const recordingExecutor =
+  (runs: string[]): ToolExecutor =>
+  async input => {
+    runs.push(JSON.stringify(input));
+    return `ran with ${Object.keys(input).join(',')}`;
+  };
+
+describe('ToolRegistry input validation', () => {
+  it('rejects missing required input without calling the executor', async () => {
+    const runs: string[] = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      {name: 'echo_location', description: 'Echo a location back', inputSchema: locationToolSchema()},
+      recordingExecutor(runs)
+    );
+
+    const rejection = await registry.execute('echo_location', {});
+
+    expect({
+      runs,
+      fieldNamed: rejection.result.includes('location'),
+      requiredNamed: /required/i.test(rejection.result),
+    }).toEqual({
+      runs: [],
+      fieldNamed: true,
+      requiredNamed: true,
+    });
+  });
+
+  it('compiles a static tool schema once at registration and reuses it across calls', async () => {
+    const runs: string[] = [];
+    let compiles = 0;
+    const registry = new ToolRegistry(() => {
+      compiles += 1;
+      return () => true;
+    });
+    registry.register(
+      {name: 'echo_location', description: 'Echo a location back', inputSchema: locationToolSchema()},
+      recordingExecutor(runs)
+    );
+
+    for (let round = 0; round < 10; round += 1) {
+      await registry.execute('echo_location', {location: 'Paris'});
+    }
+
+    expect({compiles, runs: runs.length}).toEqual({compiles: 1, runs: 10});
+  });
+
+  it('validates a function-valued source against the schema current at each call', async () => {
+    const runs: string[] = [];
+    const registry = new ToolRegistry();
+    let schema: ToolDefinition['inputSchema'] = {
+      type: 'object',
+      properties: {region: {type: 'string'}},
+      required: ['region'],
+    };
+    registry.register(
+      () => ({name: 'fickle_lookup', description: 'Schema drifts between calls', inputSchema: schema}),
+      recordingExecutor(runs)
+    );
+
+    await registry.execute('fickle_lookup', {region: 'eu-west-4'});
+
+    schema = {
+      type: 'object',
+      properties: {region: {type: 'string'}, units: {type: 'string'}},
+      required: ['region', 'units'],
+    };
+
+    const stale = await registry.execute('fickle_lookup', {region: 'eu-west-4'});
+    const fresh = await registry.execute('fickle_lookup', {region: 'eu-west-4', units: 'metric'});
+
+    expect({
+      runs,
+      staleRejectedForUnits: stale.result.includes('units'),
+      freshExecuted: fresh.result.startsWith('ran with'),
+    }).toEqual({
+      runs: ['{"region":"eu-west-4"}', '{"region":"eu-west-4","units":"metric"}'],
+      staleRejectedForUnits: true,
+      freshExecuted: true,
+    });
+  });
+
+  it('passes valid input with an unlisted extra property through to the executor unchanged, exactly once', async () => {
+    const received: Array<Record<string, unknown>> = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      {name: 'echo_location', description: 'Echo a location back', inputSchema: locationToolSchema()},
+      async input => {
+        received.push(input);
+        return 'ran';
+      }
+    );
+
+    const response = await registry.execute('echo_location', {location: 'Paris', units: 'metric'});
+
+    expect({received, ran: response.result}).toEqual({received: [{location: 'Paris', units: 'metric'}], ran: 'ran'});
+  });
+
+  it('throws Unknown tool for a name that was never registered', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('ghost_tool', {})).rejects.toThrow('Unknown tool: ghost_tool');
+  });
+});
