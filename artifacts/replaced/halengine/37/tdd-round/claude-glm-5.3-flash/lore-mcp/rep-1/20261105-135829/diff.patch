+import Ajv from 'ajv';
+import {jest} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+
+// Records every emitted line so tests can assert on what actually reached the log.
+const recordingLogger = (recorded: string[]): {logger: Logger; stop: () => void} => {
+  const record = (category: string, message: string, fields?: Record<string, unknown>) => {
+    recorded.push(JSON.stringify({category, message, fields}));
+  };
+  const logger: Logger = {debug: record, info: record, warn: record, error: record};
+  setLogger(logger);
+  return {logger, stop: () => setLogger(undefined)};
+};
+
+describe('ToolRegistry inputSchema validation', () => {
+  afterEach(() => {
+    setLogger(undefined);
+  });
+
+  it('returns a rejection naming the missing required property and does not call the executor', async () => {
+    const registry = new ToolRegistry();
+    const definition = {
+      name: 'get_weather',
+      description: 'Get weather for a location',
+      inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+    };
+    let executorCalls = 0;
+    registry.register(definition, async () => {
+      executorCalls += 1;
+      return 'sunny';
+    });
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({
+      executorCalls,
+      namesLocation: response.result.includes('location'),
+      saysRequired: /required/i.test(response.result),
+    }).toEqual({executorCalls: 0, namesLocation: true, saysRequired: true});
+  });
+
+  it('rejects a wrong-typed property naming the field path and expected type without calling the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            address: {
+              type: 'object',
+              properties: {city: {type: 'string'}},
+              required: ['city'],
+            },
+          },
+          required: ['address'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'sunny';
+      }
+    );
+
+    const response = await registry.execute('get_weather', {address: {city: 42}});
+
+    expect({
+      executorCalls,
+      namesFieldPath: response.result.includes('address.city'),
+      namesExpectedType: response.result.includes('string'),
+    }).toEqual({executorCalls: 0, namesFieldPath: true, namesExpectedType: true});
+  });
+
+  it('omits an identifying value from a rejection result and every emitted log line', async () => {
+    const recorded: string[] = [];
+    const {stop} = recordingLogger(recorded);
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'patient_lookup',
+        description: 'Look up a patient record',
+        inputSchema: {
+          type: 'object',
+          properties: {region: {type: 'string', enum: ['eu', 'us']}},
+          required: ['region'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'found';
+      }
+    );
+
+    const response = await registry.execute('patient_lookup', {region: 'patient-4711-alpha'});
+    stop();
+
+    expect({
+      executorCalls,
+      leaksInResult: response.result.includes('patient-4711-alpha'),
+      leaksInLogs: recorded.some(line => line.includes('patient-4711-alpha')),
+    }).toEqual({executorCalls: 0, leaksInResult: false, leaksInLogs: false});
+  });
+
+  it('passes valid input through to the executor unchanged, extra properties included, exactly once', async () => {
+    const registry = new ToolRegistry();
+    const seen: Array<Record<string, unknown>> = [];
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async input => {
+        seen.push(input);
+        return 'sunny';
+      }
+    );
+
+    await registry.execute('get_weather', {location: 'Paris', urgency: 'high'});
+
+    expect({calls: seen.length, received: seen[0]}).toEqual({
+      calls: 1,
+      received: {location: 'Paris', urgency: 'high'},
+    });
+  });
+
+  it('throws Unknown tool for an unregistered name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('missing_tool', {})).rejects.toThrow('Unknown tool: missing_tool');
+  });
+
+  it('throws at register time naming the tool when a static inputSchema cannot be compiled', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_weather',
+          description: 'Has an invalid JSON Schema type',
+          inputSchema: {type: 'object', properties: {location: {type: 'not-a-json-schema-type'}}},
+        },
