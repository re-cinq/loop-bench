index 0000000..53e6d2e
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,81 @@
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {HalServer, HalServerOptions} from './createServer.js';
+import {startEngineWith, stopEngines, connectClient} from './wsTestSupport.js';
+import {setLogger} from '../shared/logger.js';
+
+// spec: specs/hal-engine-websocket-protocol/spec.md#4.3
+
+interface Frame {
+  type: string;
+  conversations?: Array<{
+    sessionId: string;
+    createdAt: string;
+    updatedAt: string;
+    entryCount: number;
+  }>;
+}
+
+let server: HalServer | undefined;
+let client: ReturnType<typeof connectClient> | undefined;
+
+beforeAll(() => {
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined});
+});
+
+afterEach(async () => {
+  client?.terminate();
+  for (let attempt = 0; server && server.wss.clients.size > 0 && attempt < 50; attempt++) {
+    await new Promise(resolve => setTimeout(resolve, 10));
+  }
+  await stopEngines();
+  server = undefined;
+  client = undefined;
+});
+
+afterAll(() => {
+  setLogger();
+});
+
+describe('conversation list over the authenticated WebSocket', () => {
+  it('answers the connecting user with their conversation summaries', async () => {
+    const store = new InMemorySessionStore();
+    store
+      .create('own-older', 'u1')
+      .entries.push({role: 'user', content: 'older', timestamp: '2026-01-01T00:00:00.000Z'});
+    store
+      .create('own-newer', 'u1')
+      .entries.push({role: 'user', content: 'newer', timestamp: '2026-01-02T00:00:00.000Z'});
+    store.create('someone-elses', 'u2');
+
+    const options = {history: {enabled: true}} as unknown as Partial<HalServerOptions>;
+    const started = await startEngineWith({sessionStore: store, ...options});
+    server = started.hal;
+    client = connectClient(started.url);
+    const frames: Frame[] = [];
+    const listed = new Promise<void>(resolve => {
+      client?.on('message', raw => {
+        const frame = JSON.parse(String(raw)) as Frame;
+        frames.push(frame);
+        if (frame.type === 'conversation_list') resolve();
+      });
+    });
+
+    await new Promise<void>(resolve => client?.once('open', resolve));
+    client?.send(JSON.stringify({type: 'list_conversations', userId: 'u2'}));
+    await Promise.race([listed, new Promise<void>(resolve => setTimeout(resolve, 200))]);
+
+    const result = frames.find(frame => frame.type === 'conversation_list');
+    expect(frames.filter(frame => frame.type === 'conversation_list')).toHaveLength(1);
+    expect(result?.conversations?.map(({sessionId}) => sessionId)).toEqual(['own-newer', 'own-older']);
+    expect(result?.conversations?.map(row => Object.keys(row).sort())).toEqual([
+      ['createdAt', 'entryCount', 'sessionId', 'updatedAt'],
+      ['createdAt', 'entryCount', 'sessionId', 'updatedAt'],
+    ]);
+    expect(
+      result?.conversations?.every(
+        ({createdAt, updatedAt}) =>
+          new Date(createdAt).toISOString() === createdAt && new Date(updatedAt).toISOString() === updatedAt
+      )
+    ).toBe(true);
+  });
+});