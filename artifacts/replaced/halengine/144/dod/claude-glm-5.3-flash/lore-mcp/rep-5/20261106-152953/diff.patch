+import type {Express} from 'express';
+import {createServer} from '../createServer.js';
+import type {HalServer} from '../createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './subprotocol.js';
+import {answeringOrchestrator, deferred} from '../wsTestSupport.js';
+import {validateMessage} from './validation.js';
+import {InMemorySessionStore} from '../../infrastructure/stores/inMemorySessionStore.js';
+import {setLogger} from '../../shared/logger.js';
+import * as sessionTypes from '../../types/session.js';
+import type {IncomingMessage, OutgoingMessage} from '../../types/messages.js';
+import type {SessionListOptions, SessionResumeOptions, SessionStore} from '../../types/sessionStore.js';
+import type {ChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import type {MessageChunk} from '../../types/ai.js';
+
+// A client holding the socket asks which conversations its user has, and opens one by reconnecting with its id.
+
+interface ConversationRow {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+
+interface Frame {
+  type: string;
+  code?: string;
+  message?: string;
+  sessionId?: string;
+  resumed?: boolean;
+  entryCount?: number;
+  conversations?: ConversationRow[];
+  index?: number;
+  entry?: {role: string; content?: string};
+}
+
+const CONNECTING_USER = 'u1';
+const clients: WebSocket[] = [];
+const servers: HalServer[] = [];
+
+// An hour inside the store's 8h retention, so seeded conversations stay live and sit older than anything made now.
+const SEED = Date.now() - 60 * 60 * 1000;
+const iso = (ms: number): string => new Date(ms).toISOString();
+
+const QUIET = {debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined};
+
+const eventually = async (check: () => boolean): Promise<void> => {
+  for (let attempt = 0; attempt < 100 && !check(); attempt++) await new Promise(resolve => setTimeout(resolve, 10));
+};
+
+// Two conversations of known times: the clock moves only while the store writes, so a real socket sees real timers.
+const seedConversation = (
+  store: InMemorySessionStore,
+  sessionId: string,
+  at: number,
+  userId: string | number = CONNECTING_USER
+): void => {
+  jest.useFakeTimers();
+  try {
+    jest.setSystemTime(at);
+    const made = store.create(sessionId, userId);
+    made.entries.push({role: 'user', content: 'hello', timestamp: iso(at)});
+  } finally {
+    jest.useRealTimers();
+  }
+};
+
+interface EngineOptions {
+  sessionStore: SessionStore;
+  resume?: SessionResumeOptions;
+  history?: {enabled: boolean};
+  orchestrator?: ChatOrchestrator;
+}
+
+const startedEngine = async (options: EngineOptions): Promise<string> => {
+  // Assembled as a variable, not a literal at the call: `history` arrives with the build, and an
+  // excess-property error would red this file on a type instead of on the missing answer.
+  const halOptions = {
+    app: (() => undefined) as unknown as Express,
+    wsAuth: async () => ({id: CONNECTING_USER}),
+    orchestrator: options.orchestrator ?? answeringOrchestrator,
+    sessionStore: options.sessionStore,
+    resume: options.resume,
+    history: options.history,
+  };
+  const hal = createServer(halOptions);
+  await hal.start(0);
+  servers.push(hal);
+  const {port} = hal.server.address() as AddressInfo;
+  return `ws://127.0.0.1:${port}/hal/ws`;
+};
+
+const openClient = (url: string): {client: WebSocket; opened: Promise<void>} => {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 't']);
+  clients.push(client);
+  const opened = new Promise<void>((resolve, reject) => {
+    client.once('open', () => resolve());
+    client.once('error', reject);
+  });
+  return {client, opened};
+};
+
+const collector = (client: WebSocket): Frame[] => {
+  const seen: Frame[] = [];
+  client.on('message', raw => seen.push(JSON.parse(String(raw)) as Frame));
+  return seen;
+};
+
+// A ping sent after the frame under test is answered off the lock too, so its pong can only follow
+// every frame the earlier frame was given; the answer under test is whatever arrived before it.
+const askForList = async (
+  client: WebSocket,
+  seen: Frame[],
+  frame: Record<string, unknown> = {type: 'list_conversations'}
+): Promise<Frame[]> => {
+  const before = seen.length;
+  client.send(JSON.stringify(frame));
+  client.send(JSON.stringify({type: 'ping', timestamp: 1}));
+  await eventually(() => seen.slice(before).some(received => received.type === 'pong'));
+  return seen.slice(before);
+};
+
+const connectedIdOf = (seen: Frame[]): string => seen.find(frame => frame.type === 'connected')?.sessionId ?? '';
+
+// Silenced for the whole file: the server logs every connection and close, and these tests read frames, not logs.
+beforeAll(() => setLogger(QUIET));
+afterAll(() => setLogger());
+
+afterEach(async () => {
+  for (const client of clients.splice(0)) client.terminate();
+  for (const hal of servers.splice(0)) {
+    const {wss} = hal;
+    await eventually(() => wss.clients.size === 0);
+    await hal.stop();
+  }
+});
+
+describe('the conversation list over the websocket protocol', () => {
+  it('accepts a list_conversations frame statically, whatever the config says', () => {
+    const stillIncoming: IncomingMessage[] = [
+      {type: 'user_message', content: 'hello'},
+      {type: 'ping', timestamp: 1},
+    ];
+    const stillOutgoing: OutgoingMessage[] = [
+      {type: 'connected', sessionId: 's1', message: 'Connected to HAL Engine', examplePrompts: []},
+      {type: 'entry_upsert', index: 0, entry: {role: 'user', content: 'hello', timestamp: iso(SEED)}},
+      {type: 'entry_delta', index: 0, delta: 'hi'},
+      {type: 'entry_commit', index: 0},
+      {type: 'entry_skip', index: 1},
+      {type: 'error', code: 'INVALID_MESSAGE', message: 'no'},
+      {type: 'pong', timestamp: 1},
+      {type: 'stream_end'},
+    ];
+
+    const verdictOf = (frame: Record<string, unknown>): string => {
+      const outcome = validateMessage(frame);
+      return outcome.valid ? 'accepted' : outcome.error;
+    };
+    const cursor = {updatedAt: iso(SEED + 2000), sessionId: 'newer'};
+
+    expect({
+      bare: validateMessage({type: 'list_conversations'}).valid,
+      limit: validateMessage({type: 'list_conversations', limit: 50}).valid,
+      limitTop: validateMessage({type: 'list_conversations', limit: 200}).valid,
+      cursor: validateMessage({type: 'list_conversations', before: cursor}).valid,
+      extraUser: validateMessage({type: 'list_conversations', userId: 'someone-else'}).valid,
+      zero: verdictOf({type: 'list_conversations', limit: 0}),
+      over: verdictOf({type: 'list_conversations', limit: 201}),
+      fractional: verdictOf({type: 'list_conversations', limit: 1.5}),
+      stringLimit: verdictOf({type: 'list_conversations', limit: '10'}),
+      bareString: verdictOf({type: 'list_conversations', before: 'not a date'}),
+      halfTime: verdictOf({type: 'list_conversations', before: {updatedAt: cursor.updatedAt}}),
+      halfId: verdictOf({type: 'list_conversations', before: {sessionId: 'newer'}}),
+      olderFrames: [stillIncoming.length, stillOutgoing.length],
+    }).toEqual({
+      bare: true,
+      limit: true,
+      limitTop: true,
+      cursor: true,
+      extraUser: true,
+      zero: expect.stringContaining('limit'),
+      over: expect.stringContaining('limit'),
+      fractional: expect.stringContaining('limit'),
+      stringLimit: expect.stringContaining('limit'),
+      bareString: expect.stringContaining('before'),
+      halfTime: expect.stringContaining('before'),
+      halfId: expect.stringContaining('before'),
+      olderFrames: [2, 8],
+    });
+  });
+
+  it('answers a history request with the connecting user’s own list, and a row of it resumes', async () => {
+    const store = new InMemorySessionStore();
+    seedConversation(store, 'older', SEED + 1000);
+    seedConversation(store, 'middle', SEED + 2000);
+
+    const base = await startedEngine({sessionStore: store, resume: {enabled: true}, history: {enabled: true}});
+
+    const first = openClient(base);
+    const firstSeen = collector(first.client);
+    await first.opened;
+    await askForList(first.client, firstSeen);
+    const ownId = connectedIdOf(firstSeen);
+
+    const answered = await askForList(first.client, firstSeen);
+    const listFrames = answered.filter(frame => frame.type === 'conversation_list');
+    const rows = listFrames[0]?.conversations ?? [];
+    const timesAreIso = rows.every(
+      row => !Number.isNaN(Date.parse(row.createdAt)) && !Number.isNaN(Date.parse(row.updatedAt))
+    );
+
+    first.client.close();
+    await new Promise<void>(resolve => first.client.once('close', () => resolve()));
+
+    const second = openClient(`${base}?sessionId=middle`);
+    const secondSeen = collector(second.client);
+    await second.opened;
+    await askForList(second.client, secondSeen);
+    const rejoined = secondSeen.find(frame => frame.type === 'connected');
+    const replayed = secondSeen.find(frame => frame.type === 'entry_upsert');
+
+    expect({
+      answeredOnce: listFrames.length,
+      turnEnded: answered.some(frame => frame.type === 'stream_end'),
+      order: rows.map(row => row.sessionId),
+      entryCounts: rows.map(row => row.entryCount),
+      middleRow: rows.find(row => row.sessionId === 'middle'),
+      ownRow: rows.find(row => row.sessionId === ownId),
+      timesAreIso,
+      rejoined: {
+        sessionId: rejoined?.sessionId,
+        resumed: rejoined?.resumed,
+        entryCount: rejoined?.entryCount,
+      },
+      replayed: {index: replayed?.index, role: replayed?.entry?.role, content: replayed?.entry?.content},
+    }).toEqual({
+      answeredOnce: 1,
+      turnEnded: false,
+      order: [ownId, 'middle', 'older'],
+      entryCounts: [0, 1, 1],
+      middleRow: {sessionId: 'middle', createdAt: iso(SEED + 2000), updatedAt: iso(SEED + 2000), entryCount: 1},
+      ownRow: {sessionId: ownId, createdAt: expect.any(String), updatedAt: expect.any(String), entryCount: 0},
+      timesAreIso: true,
+      rejoined: {sessionId: 'middle', resumed: true, entryCount: 1},
+      replayed: {index: 0, role: 'user', content: 'hello'},
+    });
+  });
+
+  it('lists the connecting user’s conversations, paged as the frame asked', async () => {
+    const inner = new InMemorySessionStore();
+    seedConversation(inner, 'older', SEED + 1000);
+    seedConversation(inner, 'newer', SEED + 2000);
+    seedConversation(inner, 'theirs', SEED + 3000, 'someone-else');
+
+    const asked: Array<{userId: string | number; limit: number | undefined; before: unknown}> = [];
+    // The real store behind a recording of the one call whose argument the ticket turns on.
+    const recordedStore = {
+      create: (sessionId: string, userId: string | number) => inner.create(sessionId, userId),
+      listFor: (userId: string | number, listOptions?: SessionListOptions) => {
+        asked.push({userId, limit: listOptions?.limit, before: listOptions?.before});
+        return inner.listFor(userId, listOptions);
+      },
+    } as unknown as SessionStore;
+
+    const base = await startedEngine({sessionStore: recordedStore, history: {enabled: true}});
+    const {client, opened} = openClient(base);
+    const seen = collector(client);
+    await opened;
+    await askForList(client, seen);
+
+    const paged = await askForList(client, seen, {
+      type: 'list_conversations',
+      userId: 'someone-else',
+      limit: 1,
+      before: {updatedAt: iso(SEED + 2000), sessionId: 'newer'},
+    });
+    const unpaged = await askForList(client, seen);
+
+    const rowIdsOf = (answer: Frame[]): string[] =>
+      answer
+        .filter(frame => frame.type === 'conversation_list')
+        .flatMap(frame => frame.conversations ?? [])
+        .map(row => row.sessionId);
+
+    expect({
+      askedFor: asked,
+      pagedRows: rowIdsOf(paged),
+      unpagedRows: rowIdsOf(unpaged),
+      anyoneElses: [...rowIdsOf(paged), ...rowIdsOf(unpaged)].filter(sessionId => sessionId === 'theirs'),
+    }).toEqual({
+      askedFor: [
+        {userId: CONNECTING_USER, limit: 1, before: {updatedAt: iso(SEED + 2000), sessionId: 'newer'}},
+        {userId: CONNECTING_USER, limit: undefined, before: undefined},
+      ],
+      pagedRows: ['older'],
+      unpagedRows: ['newer', 'older'],
+      anyoneElses: [],
+    });
+  });
+
+  it('answers an error frame, never an empty list, when the list cannot be given', async () => {
+    const failingStore = {
+      create: (sessionId: string, userId: string | number) => new InMemorySessionStore().create(sessionId, userId),
+      listFor: () =>
+        Promise.reject(new Error('relation "conversations" does not exist on postgres://hal.internal:5432/hal')),
+    } as unknown as SessionStore;
+    const StoreCannotList = (sessionTypes as unknown as {StoreCannotList: new (message: string) => Error})
+      .StoreCannotList;
+    const cannotListStore = {
+      create: (sessionId: string, userId: string | number) => new InMemorySessionStore().create(sessionId, userId),
+      listFor: () => Promise.reject(new StoreCannotList('this store cannot list conversations')),
+    } as unknown as SessionStore;
+    const fiveMembers = {
+      create: (sessionId: string, userId: string | number) => ({sessionId, userId, entries: []}),
+      get: () => undefined,
+      delete: () => true,
+      count: () => 0,
+      clear: () => undefined,
+    } as unknown as SessionStore;
+
+    const answerTo = async (options: EngineOptions): Promise<{codes: string[]; listed: boolean; answered: boolean}> => {
+      const base = await startedEngine(options);
+      const {client, opened} = openClient(base);
+      const seen = collector(client);
+      await opened;
+      const answered = await askForList(client, seen);
+      const errors = answered.filter(frame => frame.type === 'error');
+      return {
+        codes: errors.map(frame => frame.code ?? ''),
+        listed: answered.some(frame => frame.type === 'conversation_list'),
+        answered: answered.some(frame => frame.type === 'pong'),
+      };
+    };
+
+    const lines: string[] = [];
+    const recordAt =
+      (level: string) =>
+      (category: string, message: string, fields?: Record<string, unknown>): void => {
+        lines.push(JSON.stringify({level, category, message, fields}));
+      };
+    setLogger({
+      debug: recordAt('debug'),
+      info: recordAt('info'),
+      warn: recordAt('warn'),
+      error: recordAt('error'),
+    });
+
+    let failingUserId = '';
+    let failingAnswer: {codes: string[]; detail: string; answered: boolean} = {codes: [], detail: '', answered: false};
+    try {
+      const historyOff = await answerTo({sessionStore: new InMemorySessionStore()});
+      const withoutListFor = await answerTo({sessionStore: fiveMembers, history: {enabled: true}});
+
+      const base = await startedEngine({sessionStore: failingStore, history: {enabled: true}});
+      const {client, opened} = openClient(base);
+      const seen = collector(client);
+      await opened;
+      const answered = await askForList(client, seen);
+      failingUserId = connectedIdOf(seen);
+      const errors = answered.filter(frame => frame.type === 'error');
+      failingAnswer = {
+        codes: errors.map(frame => frame.code ?? ''),
+        detail: errors.map(frame => frame.message ?? '').join(' '),
+        answered: answered.some(frame => frame.type === 'pong'),
+      };
+
+      const cannotList = await answerTo({sessionStore: cannotListStore, history: {enabled: true}});
+
+      expect({
+        historyOff,
+        withoutListFor,
+        cannotList,
+        failing: failingAnswer,
+        loggedDetail: lines.filter(line => line.includes('postgres') || line.includes('does not exist')),
+        loggedFailureWithSession: lines.some(line => line.includes('"level":"error"') && line.includes(failingUserId)),
+      }).toEqual({
+        historyOff: {codes: ['UNSUPPORTED'], listed: false, answered: true},
+        withoutListFor: {codes: ['UNSUPPORTED'], listed: false, answered: true},
+        cannotList: {codes: ['UNSUPPORTED'], listed: false, answered: true},
+        failing: {codes: ['SERVER_ERROR'], detail: expect.not.stringContaining('postgres'), answered: true},
+        loggedDetail: [],
+        loggedFailureWithSession: true,
+      });
+    } finally {
+      setLogger(QUIET);
+    }
+  });
+
+  it('answers a history request before the turn it did not queue behind ends', async () => {
+    const store = new InMemorySessionStore();
+    seedConversation(store, 'older', SEED + 1000);
+    const turnHeld = deferred();
+    const holdingOrchestrator: ChatOrchestrator = {
+      processMessage: async () => 'hi',
+      async *processMessageStream(): AsyncGenerator<MessageChunk> {
+        yield {type: 'text', text: 'half '};
+        await turnHeld.until;
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+    };
+
+    const base = await startedEngine({
+      sessionStore: store,
+      history: {enabled: true},
+      orchestrator: holdingOrchestrator,
+    });
+    const {client, opened} = openClient(base);
+    const seen = collector(client);
+    await opened;
+    await askForList(client, seen);
+
+    client.send(JSON.stringify({type: 'user_message', content: 'hello'}));
+    await eventually(() => seen.some(frame => frame.type === 'entry_delta'));
+
+    const answered = await askForList(client, seen);
+    turnHeld.release();
+    await eventually(() => seen.some(frame => frame.type === 'stream_end'));
+
+    expect({
+      answeredWhileTurnOpen: answered.some(frame => frame.type === 'conversation_list'),
+      turnEndedAfterTheAnswer:
+        seen.findIndex(frame => frame.type === 'conversation_list') <
+        seen.findIndex(frame => frame.type === 'stream_end'),
+      answers: seen.filter(frame => frame.type === 'conversation_list').length,
+      turnEnds: seen.filter(frame => frame.type === 'stream_end').length,
+    }).toEqual({answeredWhileTurnOpen: true, turnEndedAfterTheAnswer: true, answers: 1, turnEnds: 1});
+  });
+});