+import type {HalServer, HalServerOptions} from './createServer.js';
+import {validateMessage} from './ws/validation.js';
+import type {ValidationResult} from './ws/validation.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {answeringOrchestrator, deferred} from './wsTestSupport.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {setLogger} from '../shared/logger.js';
+import * as hal from '../index.js';
+import type {ChatOrchestrator, MessageChunk} from '../types/ai.js';
+import type {SessionEntry, UserEntry} from '../types/session.js';
+import type {SessionListOptions, SessionStore} from '../types/sessionStore.js';
+
+// The frames, not the internals, are what a consumer builds on: every test here upgrades a real socket.
+
+// Stamped apart and in the future, so activity order is the opposite of id order and never reads off the wall clock.
+const OLDEST = '2027-01-01T10:00:00.000Z';
+const MIDDLE = '2027-01-01T10:00:01.000Z';
+const NEWEST = '2027-01-01T10:00:02.000Z';
+const THEIRS = '2027-01-01T10:00:03.000Z';
+const ASK = JSON.stringify({type: 'list_conversations'});
+
+interface HistoryFlag {
+  enabled: boolean;
+}
+
+interface WireSummary {
+  sessionId: string;
+  createdAt: unknown;
+  updatedAt: unknown;
+  entryCount: number;
+}
+
+interface Frame {
+  type: string;
+  sessionId?: string;
+  resumed?: boolean;
+  entryCount?: number;
+  code?: string;
+  message?: string;
+  index?: number;
+  delta?: string;
+  entry?: SessionEntry;
+  conversations?: WireSummary[];
+}
+
+interface Observed {
+  client: WebSocket;
+  frames: Frame[];
+  awaitFrame: (frameType: string, minimum?: number) => Promise<void>;
+}
+
+// Three one-entry conversations of one user, named apart from their activity so the order cannot be the ids own.
+const conversationStore = (): InMemorySessionStore => {
+  const store = new InMemorySessionStore();
+  const stamped: Array<[sessionId: string, sentAt: string]> = [
+    ['older', OLDEST],
+    ['middle', MIDDLE],
+    ['newer', NEWEST],
+  ];
+  for (const [sessionId, sentAt] of stamped) {
+    const {entries} = store.create(sessionId, 'u1');
+    entries.push({role: 'user', content: `sent in ${sessionId}`, timestamp: sentAt});
+  }
+  return store;
+};
+
+// A store with only the five required members, so a list that is absent reads as absent rather than as empty.
+const fiveMemberStore = (inner: InMemorySessionStore): SessionStore => ({
+  create: (sessionId, userId, options) => inner.create(sessionId, userId, options),
+  get: sessionId => inner.get(sessionId),
+  delete: sessionId => inner.delete(sessionId),
+  count: () => inner.count(),
+  clear: () => inner.clear(),
+});
+
+// The error this issue puts on the public surface, named through the package root, where a consumer would import it from.
+const exportedStoreCannotList = (message: string): Error => {
+  const surface = hal as {StoreCannotList?: new (thrownMessage: string) => Error};
+  if (surface.StoreCannotList === undefined) return new Error(`StoreCannotList is not exported yet (${message})`);
+  return new surface.StoreCannotList(message);
+};
+
+const engines: HalServer[] = [];
+const clients: WebSocket[] = [];
+const loggedErrors: Array<Record<string, unknown>> = [];
+
+const settle = (ms = 100): Promise<void> => new Promise(resolve => setTimeout(resolve, ms));
+
+// One listener per socket records every frame in order and releases the waits that name it, so no frame is read twice.
+const observed = (client: WebSocket): Observed => {
+  const frames: Frame[] = [];
+  const waiting: Array<{frameType: string; minimum: number; release: () => void}> = [];
+  const reached = (frameType: string, minimum: number) =>
+    frames.filter(frame => frame.type === frameType).length >= minimum;
+  client.on('message', raw => {
+    frames.push(JSON.parse(String(raw)) as Frame);
+    for (const entry of waiting.splice(0)) {
+      if (reached(entry.frameType, entry.minimum)) entry.release();
+      else waiting.push(entry);
+    }
+  });
+  return {
+    client,
+    frames,
+    awaitFrame: (frameType: string, minimum = 1) =>
+      new Promise<void>(resolve => {
+        if (reached(frameType, minimum)) {
+          resolve();
+          return;
+        }
+        waiting.push({frameType, minimum, release: resolve});
+      }),
+  };
+};
+
+// The socket, the store and the history option are what varies between scenarios; everything else stays the engine.
+const wsOptions = (
+  sessionStore: SessionStore,
+  history: HistoryFlag | undefined,
+  orchestrator: ChatOrchestrator = answeringOrchestrator
+): HalServerOptions =>
+  ({
+    app: (() => undefined) as unknown as Express,
+    wsAuth: async () => ({id: 'u1'}),
+    sessionStore,
+    orchestrator,
+    resume: {enabled: true},
+    history,
+  }) as HalServerOptions;
+
+const startWsServer = async (options: HalServerOptions): Promise<string> => {
+  const engine = createServer(options);
+  await engine.start(0);
+  engines.push(engine);
+  const {port} = engine.server.address() as AddressInfo;
+  return `ws://127.0.0.1:${port}/hal/ws`;
+};
+
+const open = (url: string, query = ''): WebSocket => {
+  const client = new WebSocket(`${url}${query}`, [HAL_WS_SUBPROTOCOL, 't']);
+  clients.push(client);
+  return client;
+};
+
+// Opens, then pings once the greeting arrives, so the pong that follows proves every earlier frame was written.
+const openAndSettle = async (url: string, query = ''): Promise<Observed> => {
+  const client = open(url, query);
+  const socket = observed(client);
+  await socket.awaitFrame('connected');
+  client.send(JSON.stringify({type: 'ping', timestamp: 1}));
+  await socket.awaitFrame('pong');
+  return socket;
+};
+
+const answerOf = (frames: Frame[]): {codes: Array<string | undefined>; listed: boolean} => ({
+  codes: frames.filter(frame => frame.type === 'error').map(frame => frame.code),
+  listed: frames.some(frame => frame.type === 'conversation_list'),
+});
+
+beforeAll(() => {
+  setLogger({
+    debug: () => undefined,
+    info: () => undefined,
+    warn: () => undefined,
+    error: (category, message, fields) => void loggedErrors.push({category, message, ...fields}),
+  });
+});
+
+afterAll(() => {
+  setLogger();
+});
+
+afterEach(async () => {
+  for (const client of clients.splice(0)) client.terminate();
+  for (const engine of engines.splice(0)) {
+    // Each socket sees its own close before the server stops, so no close is logged after the logger above is restored.
+    for (let attempt = 0; attempt < 50 && engine.wss.clients.size > 0; attempt++) await settle(10);
+    await engine.stop();
+  }
+});
