+
+  it('hands a client that reconnects with an id taken from the list the conversation it picked', async () => {
+    const store = seeded([['known', 'u1', DAY(1)]]);
+    const base = await started({store, transport: historyOn({resume: {enabled: true}})});
+
+    const first = open(base);
+    const firstFrames = collect(first);
+    await expectFrame(firstFrames, 'connected');
+    first.send(JSON.stringify({type: 'list_conversations'}));
+    await expectFrame(firstFrames, 'conversation_list');
+
+    const list = firstFrames.find(frame => frame.type === 'conversation_list');
+    const picked = (list?.conversations ?? []).find(row => row.entryCount === 1);
+    first.close();
