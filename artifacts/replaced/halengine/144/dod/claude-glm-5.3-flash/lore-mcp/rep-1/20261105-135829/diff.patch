+      listedKnown: true,
+      reconnected: {type: 'connected', sessionId: 'known', resumed: true, entryCount: 1},
+      replay: [{index: 0, entry: {role: 'user', content: `sent at ${DAY(1)}`, timestamp: DAY(1)}}],
+    });
+  });
