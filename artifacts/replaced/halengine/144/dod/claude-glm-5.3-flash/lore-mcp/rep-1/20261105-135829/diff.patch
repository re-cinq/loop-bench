--- a/specs/hal-engine-websocket-protocol/spec.md
+++ b/specs/hal-engine-websocket-protocol/spec.md
@@ -655,3 +655,37 @@ After 5 failed attempts, the client MUST stop reconnecting and report a disconne
 | Message validation       | `src/transport/ws/validation.ts`                  |
 | Message handling         | `src/transport/ws/messageHandler.ts`              |
 | Connection handler       | `src/transport/ws/connectionHandler.ts`           |
+
+## 14. Conversation List
+
+A connected client can ask which conversations its user has, over the same socket it was already authenticated on, so no consumer has to stand up a second, HTTP path to the store's `listFor` (see [the conversation list spec](../hal-engine-conversation-list/spec.md)). The feature is opt-in: `transport.history: {enabled: boolean}` is the deployer's decision to make a user's history reachable from the client, it defaults to off, and enabling it carries the same retention responsibility resume does — the store's `maxAgeMs` and erasure methods bound what is held (re-cinq/HALEngine#41).
+
+### 14.1 list_conversations (client to server)
+
+| Field    | Type   | Required | Description                                                                                  |
+| -------- | ------ | -------- | ---------------------------------------------------------------------------------------------- |
+| `type`   | string | Yes      | `"list_conversations"`                                                                          |
+| `limit`  | number | No       | At most this many summaries, newest first: an integer from 1 to 200                            |
+| `before` | object | No       | Resume after this row: `{updatedAt, sessionId}`, the last row the client saw, both ISO strings |
+
+There is no user id field, and that is the point: the list is always the connection's authenticated user's.
+
+- The frame is accepted by `validateMessage` whether or not `transport.history` is on; validation is static and has no config, and the handler is what refuses it ([validated by: accepts a bare frame and a limit and cursor within their bounds, and names the field it refuses](../../src/transport/conversationList.acceptance.test.ts#L377)).
+- `limit`, when present, MUST be an integer from 1 to 200, and `before`, when present, MUST carry both a `Date.parse`-able `updatedAt` and a `sessionId`; anything else is `INVALID_MESSAGE` with a message naming the offending field, and a cursor with one half alone is refused ([validated by: accepts a bare frame and a limit and cursor within their bounds, and names the field it refuses](../../src/transport/conversationList.acceptance.test.ts#L377)).
+
+### 14.2 conversation_list (server to client)
+
+| Field           | Type                  | Description                                                                                       |
+| --------------- | --------------------- | -------------------------------------------------------------------------------------------------- |
+| `type`          | string                | `"conversation_list"`                                                                               |
+| `conversations` | ConversationSummary[] | Newest activity first; `createdAt` and `updatedAt` are ISO strings, because `Date` does not survive JSON |
+
+Semantics:
+
+- With `transport.history: {enabled: true}`, a `list_conversations` frame is answered with exactly one `conversation_list` carrying the connecting user's own conversations newest first, each time an ISO string, and no `stream_end`: a history request is not a turn, and a list is answered when asked, never pushed ([validated by: answers list_conversations with the connecting user’s own conversations, newest first, and never one a forged userId names](../../src/transport/conversationList.acceptance.test.ts#L169)).
+- A row on the wire is the four summary fields and nothing else — one user's own conversation metadata, never conversation content ([validated by: answers list_conversations with the connecting user’s own conversations, newest first, and never one a forged userId names](../../src/transport/conversationList.acceptance.test.ts#L169)).
+- The user id is taken from the connection and never from the frame: a frame carrying another user's id is answered with the connecting user's own list, and the store's `listFor` is called with the socket's `userId` ([validated by: answers list_conversations with the connecting user’s own conversations, newest first, and never one a forged userId names](../../src/transport/conversationList.acceptance.test.ts#L169)).
+- A `list_conversations` sent while a `user_message` is streaming on the same session is answered before that turn's `stream_end` — it does not queue behind the per-session lock — and the frame's `limit` and `before` reach `listFor` as the frame sent them ([validated by: answers a list asked while a turn is streaming before that turn’s stream_end, passing limit and before to the store](../../src/transport/conversationList.acceptance.test.ts#L286)).
+- With `transport.history` absent, or enabled against a store implementing no `listFor`, the answer is one `error` frame with code `UNSUPPORTED` and no `conversation_list`: silence that looks like data — an empty list a client renders as "no conversations" — is the one failure a history view cannot recover from ([validated by: answers a list it cannot take with one error naming UNSUPPORTED or SERVER_ERROR, never an empty list](../../src/transport/conversationList.acceptance.test.ts#L230)).
+- A `listFor` that rejects is answered with one `error` frame whose code is `SERVER_ERROR` and whose message carries no store detail; the socket stays open, and the failure is logged with the session id and no user content ([validated by: answers a list it cannot take with one error naming UNSUPPORTED or SERVER_ERROR, never an empty list](../../src/transport/conversationList.acceptance.test.ts#L230)).
+- Picking a conversation needs no new transport: a client takes an id from a `conversation_list` and reconnects with `?sessionId=<id>`, which the resume path (§ 2.1) answers with `resumed: true` and that conversation's replay ([validated by: hands a client that reconnects with an id taken from the list the conversation it picked](../../src/transport/conversationList.acceptance.test.ts#L346)).
diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..786ce6c
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,407 @@
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import {createHalEngine} from '../config.js';
+import type {HalEngine, HalEngineConfig} from '../config.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+import {deferred} from './wsTestSupport.js';
+import {setLogger} from '../shared/logger.js';
+import type {Logger} from '../shared/logger.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {SessionStore} from '../types/sessionStore.js';
+import type {SessionEntry} from '../types/session.js';
+import type {OrchestratorHooks} from '../orchestration/chatOrchestrator.js';
+
+// A real engine over a real socket: what answers list_conversations is the contract, and no double can observe it.
+
+interface ConversationRow {
+  sessionId?: string;
+  createdAt?: unknown;
+  updatedAt?: unknown;
+  entryCount?: number;
+}
+
+interface Frame {
+  type: string;
+  code?: string;
+  message?: string;
+  conversations?: ConversationRow[];
+  sessionId?: string;
+  resumed?: boolean;
+  entryCount?: number;
+  index?: number;
+  entry?: SessionEntry;
+}
+
+const quiet: Logger = {
+  debug: () => undefined,
+  info: () => undefined,
+  warn: () => undefined,
+  error: () => undefined,
+};
+
+const engines: HalEngine[] = [];
+const clients: WebSocket[] = [];
+
+// Stamps past the wall clock, so a conversation's activity is its own entry and the order is the fixture's, not the run's.
+const DAY = (day: number): string => `2030-01-0${day}T08:00:00.000Z`;
+
+// What the wire must carry for a time field: parseable, and the round trip through a Date reproduces it exactly.
+const iso = (value: unknown): boolean =>
+  typeof value === 'string' && !Number.isNaN(Date.parse(value)) && new Date(value).toISOString() === value;
+
+// One listener per client, attached before the socket opens, so a test reads the connection's whole frame history.
+const collect = (client: WebSocket): Frame[] => {
+  const seen: Frame[] = [];
+  client.on('message', raw => seen.push(JSON.parse(String(raw)) as Frame));
+  return seen;
+};
+
+const has = (frames: Frame[], type: string): boolean => frames.some(frame => frame.type === type);
+
+const upsertsOf = (frames: Frame[]): Array<{index?: number; entry?: SessionEntry}> =>
+  frames.filter(frame => frame.type === 'entry_upsert').map(({index, entry}) => ({index, entry}));
+
+// Waits for a condition, failing with the detail at hand rather than hanging, so a missing answer is named.
+const eventually = async (check: () => boolean, missing: string, detail: () => string): Promise<void> => {
+  for (let waited = 0; waited < 2000 && !check(); waited += 10) {
+    await new Promise(resolve => setTimeout(resolve, 10));
+  }
+  if (!check()) throw new Error(`${missing}; ${detail()}`);
+};
+
+const expectFrame = (frames: Frame[], type: string): Promise<void> =>
+  eventually(
+    () => has(frames, type),
+    `no ${type} arrived`,
+    () => `frames seen: ${JSON.stringify(frames)}`
+  );
+
+const open = (url: string): WebSocket => {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 't']);
+  clients.push(client);
+  return client;
+};
+
+// `transport.history` is the opt-in this ticket adds; one assertion keeps the suite compiling until it lands.
+const historyOn = (transport: HalEngineConfig['transport'] = {}): HalEngineConfig['transport'] =>
+  ({...transport, history: {enabled: true}}) as HalEngineConfig['transport'];
+
+// Each conversation holds one user entry, so a row's recency, count and owner are all the fixture's.
+const seeded = (conversations: Array<[string, string, string]>): InMemorySessionStore => {
+  const store = new InMemorySessionStore();
+  for (const [id, user, sentAt] of conversations) {
+    const entry: SessionEntry = {role: 'user', content: `sent at ${sentAt}`, timestamp: sentAt};
+    store.create(id, user).entries.push(entry);
+  }
+  return store;
+};
+
+// The real store answers; a thin delegate records the calls, which is how the asking user is asserted.
+const recording = (inner: InMemorySessionStore, calls: Array<[unknown, unknown]>): SessionStore => ({
+  get: sessionId => inner.get(sessionId),
+  create: (sessionId, userId, options) => inner.create(sessionId, userId, options),
+  delete: sessionId => inner.delete(sessionId),
+  count: () => inner.count(),
+  clear: () => inner.clear(),
+  listFor: (userId, options) => {
+    calls.push([userId, options]);
+    return inner.listFor(userId, options);
+  },
+});
+
+// A store that rejects carries what a database failure would: detail neither the frame nor a user-content log may show.
+const failing = (inner: InMemorySessionStore): SessionStore => ({
+  ...recording(inner, []),
+  listFor: () => Promise.reject(new Error('list failed for u1: the database is down, last entry "my booking 4711"')),
+});
+
+const withoutListFor = (inner: InMemorySessionStore): SessionStore => ({
+  ...recording(inner, []),
+  listFor: undefined,
+});
+
+interface StartOptions {
+  store: SessionStore;
+  transport?: HalEngineConfig['transport'];
+  hooks?: OrchestratorHooks;
+  logger?: Logger;
+}
+
+// The public factory on an ephemeral port, so the config threading this ticket adds is part of what a test sees.
+const started = async (options: StartOptions): Promise<string> => {
+  const engine = createHalEngine({
+    provider: {type: 'mock'},
+    prompt: {identity: 'test'},
+    auth: {ws: async () => ({id: 'u1'})},
+    session: options.store,
+    logger: options.logger ?? quiet,
+    ...(options.hooks ? {orchestrator: {hooks: options.hooks}} : {}),
+    transport: {port: 0, ...options.transport},
+  });
+  await engine.start(0);
+  engines.push(engine);
+  const {port} = engine.server.address() as AddressInfo;
+  return `ws://127.0.0.1:${port}/hal/ws`;
+};
+
+beforeAll(() => {
+  setLogger(quiet);
+});
+
+afterAll(() => {
+  setLogger();
+});
+
+afterEach(async () => {
+  for (const client of clients.splice(0)) client.terminate();
+  for (const engine of engines.splice(0)) {
+    await eventually(
+      () => engine.wss.clients.size === 0,
+      'a socket outlived its test',
+      () => `${engine.wss.clients.size} still open`
+    );
+    await engine.stop();
+  }
+});
+
+describe('serving the conversation list over the websocket', () => {
+  it('answers list_conversations with the connecting user’s own conversations, newest first, and never one a forged userId names', async () => {
+    const calls: Array<[unknown, unknown]> = [];
+    const store = recording(
+      seeded([
+        ['c-old', 'u1', DAY(1)],
+        ['c-mid', 'u1', DAY(2)],
+        ['c-new', 'u1', DAY(3)],
+        ['c-theirs', 'u2', DAY(4)],
+      ]),
+      calls
+    );
+    const base = await started({store, transport: historyOn()});
+
+    const client = open(base);
+    const frames = collect(client);
+    await expectFrame(frames, 'connected');
+    client.send(JSON.stringify({type: 'list_conversations', userId: 'u2'}));
+    await expectFrame(frames, 'conversation_list');
+    client.send(JSON.stringify({type: 'ping', timestamp: 1}));
+    await expectFrame(frames, 'pong');
+
+    const list = frames.find(frame => frame.type === 'conversation_list');
+    expect({
+      answered: frames.map(frame => frame.type),
+      listed: (list?.conversations ?? []).map(row => ({
+        fields: Object.keys(row).sort().join('|'),
+        sessionId: row.sessionId,
+        entryCount: row.entryCount,
+        createdAtIso: iso(row.createdAt),
+        updatedAtIso: iso(row.updatedAt),
+      })),
+      askedFor: calls.map(([userId]) => userId),
+    }).toEqual({
+      answered: ['connected', 'conversation_list', 'pong'],
+      listed: [
+        {
+          fields: 'createdAt|entryCount|sessionId|updatedAt',
+          sessionId: 'c-new',
+          entryCount: 1,
+          createdAtIso: true,
+          updatedAtIso: true,
+        },
+        {
+          fields: 'createdAt|entryCount|sessionId|updatedAt',
+          sessionId: 'c-mid',
+          entryCount: 1,
+          createdAtIso: true,
+          updatedAtIso: true,
+        },
+        {
+          fields: 'createdAt|entryCount|sessionId|updatedAt',
+          sessionId: 'c-old',
+          entryCount: 1,
+          createdAtIso: true,
+          updatedAtIso: true,
+        },
+      ],
+      askedFor: ['u1'],
+    });
+  });
+
+  it('answers a list it cannot take with one error naming UNSUPPORTED or SERVER_ERROR, never an empty list', async () => {
+    const plain = seeded([
+      ['c-old', 'u1', DAY(1)],
+      ['c-mid', 'u1', DAY(2)],
+    ]);
+    const cases: Array<{name: string; store: SessionStore; history: boolean}> = [
+      {name: 'off', store: plain, history: false},
+      {name: 'noListFor', store: withoutListFor(plain), history: true},
+      {name: 'failing', store: failing(plain), history: true},
+    ];
+    const captured: Record<string, {frames: Frame[]; sessionId: string; logs: string[]}> = {};
+
+    for (const {name, store, history} of cases) {
+      const logs: string[] = [];
+      const capture: Logger = {
+        ...quiet,
+        error: (_category, message, fields) => void logs.push(JSON.stringify([message, fields])),
+      };
+      const base = await started({store, transport: history ? historyOn() : undefined, logger: capture});
+      const client = open(base);
+      const frames = collect(client);
+      await expectFrame(frames, 'connected');
+      const sessionId = frames.find(frame => frame.type === 'connected')?.sessionId ?? '';
+      client.send(JSON.stringify({type: 'list_conversations'}));
+      await expectFrame(frames, 'error');
+      client.send(JSON.stringify({type: 'ping', timestamp: 1}));
+      await expectFrame(frames, 'pong');
+      captured[name] = {frames, sessionId, logs};
+    }
+
+    const observed = (name: string) => {
+      const {frames} = captured[name];
+      return {
+        code: frames.find(frame => frame.type === 'error')?.code,
+        errors: frames.filter(frame => frame.type === 'error').length,
+        lists: frames.filter(frame => frame.type === 'conversation_list').length,
+        emptyListed: JSON.stringify(frames).includes('"conversations":[]'),
+        storeDetail: JSON.stringify(frames).includes('the database is down'),
+        socketOpen: frames.at(-1)?.type === 'pong',
+      };
+    };
+    expect({
+      off: observed('off'),
+      noListFor: observed('noListFor'),
+      failing: observed('failing'),
+      failureLogged: captured.failing.logs.some(line => line.includes(captured.failing.sessionId)),
+      contentLogged: captured.failing.logs.filter(line => line.includes('my booking 4711')),
+    }).toEqual({
+      off: {code: 'UNSUPPORTED', errors: 1, lists: 0, emptyListed: false, storeDetail: false, socketOpen: true},
+      noListFor: {code: 'UNSUPPORTED', errors: 1, lists: 0, emptyListed: false, storeDetail: false, socketOpen: true},
+      failing: {code: 'SERVER_ERROR', errors: 1, lists: 0, emptyListed: false, storeDetail: false, socketOpen: true},
+      failureLogged: true,
+      contentLogged: [],
+    });
+  });
+
+  it('answers a list asked while a turn is streaming before that turn’s stream_end, passing limit and before to the store', async () => {
+    const calls: Array<[unknown, unknown]> = [];
+    const store = recording(
+      seeded([
+        ['c-old', 'u1', DAY(1)],
+        ['c-mid', 'u1', DAY(2)],
+        ['c-new', 'u1', DAY(3)],
+      ]),
+      calls
+    );
+    const turn = deferred();
+    const inside = deferred();
+    const base = await started({
+      store,
+      transport: historyOn(),
+      hooks: {
+        beforeUserInput: async (_session, userMessage) => {
+          inside.release();
+          await turn.until;
