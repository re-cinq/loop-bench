+    });
+
+    const client = open(base);
+    const frames = collect(client);
+    await expectFrame(frames, 'connected');
+    client.send(JSON.stringify({type: 'user_message', content: 'hello'}));
+    await inside.until;
+    try {
+      client.send(
+        JSON.stringify({
+          type: 'list_conversations',
+          limit: 2,
+          before: {updatedAt: DAY(2), sessionId: 'c-mid'},
