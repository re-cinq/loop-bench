+describe('validating the list_conversations frame', () => {
+  it('accepts a bare frame and a limit and cursor within their bounds, and names the field it refuses', () => {
+    const cursor = {updatedAt: DAY(2), sessionId: 'c-mid'};
+    const cases: Array<[string, Record<string, unknown>]> = [
+      ['limit 0', {limit: 0}],
+      ['limit 201', {limit: 201}],
+      ['limit 1.5', {limit: 1.5}],
+      ['limit "10"', {limit: '10'}],
+      ['before "not a date"', {before: 'not a date'}],
+      ['before a timestamp alone', {before: {updatedAt: DAY(2)}}],
+      ['before a session id alone', {before: {sessionId: 'c-mid'}}],
+    ];
+    const refused: Record<string, string> = {};
+    for (const [name, extra] of cases) {
+      const result = validateMessage({type: 'list_conversations', ...extra});
+      refused[name] = result.valid ? 'accepted' : result.error;
+    }
+    const naming = Object.fromEntries(
+      cases.map(([name]) => [name, expect.stringContaining(name.startsWith('limit') ? 'limit' : 'before')])
+    );
+
+    expect({
+      bare: validateMessage({type: 'list_conversations'}),
+      paged: validateMessage({type: 'list_conversations', limit: 25, before: cursor}),
+      refused,
+    }).toEqual({
+      bare: {valid: true, data: {type: 'list_conversations'}},
+      paged: {valid: true, data: {type: 'list_conversations', limit: 25, before: cursor}},
+      refused: naming,
+    });
+  });
