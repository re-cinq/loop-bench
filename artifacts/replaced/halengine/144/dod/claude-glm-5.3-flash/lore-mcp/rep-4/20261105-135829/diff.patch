diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..968aa2a
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,346 @@
+// #144 — the conversation list a client asks for over its own socket: real upgrades, a real store, and the frames in order.
+
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import type {Express} from 'express';
+import {createServer} from './createServer.js';
+import type {HalServerOptions} from './createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+import {answeringOrchestrator, deferred} from './wsTestSupport.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import * as sessionStoreTypes from '../types/sessionStore.js';
+import type {ChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import type {MessageChunk} from '../types/ai.js';
+import type {SessionEntry} from '../types/session.js';
+import {setLogger} from '../shared/logger.js';
+
+// The list is a protocol answer, so every socket suite here reads frames off a real connection, never off a double.
+
+interface Frame {
+  type: string;
+  code?: string;
+  message?: string;
+  sessionId?: string;
+  resumed?: boolean;
+  entryCount?: number;
+  conversations?: Array<{sessionId: string; createdAt: string; updatedAt: string; entryCount: number}>;
+}
+
+interface TransportHistoryOptions {
+  enabled: boolean;
+}
+
+type StartOptions = Partial<HalServerOptions> &
+  Pick<HalServerOptions, 'sessionStore'> & {history?: TransportHistoryOptions};
+
+const servers: Array<ReturnType<typeof createServer>> = [];
+const clients: WebSocket[] = [];
+const errorLines: Array<Record<string, unknown>> = [];
+
+const eventually = async (check: () => boolean): Promise<void> => {
+  for (let attempt = 0; attempt < 50 && !check(); attempt++) await new Promise(resolve => setTimeout(resolve, 10));
+};
+
+const stamp = (now: number, offsetMs: number): string => new Date(now + offsetMs).toISOString();
+
+const seeded = (store: InMemorySessionStore, sessionId: string, at: string, entries: number): void => {
+  const session = store.create(sessionId, 'u1');
+  for (let n = 0; n < entries; n++) {
+    const entry: SessionEntry = {role: 'user', content: `message ${n}`, timestamp: at};
+    session.entries.push(entry);
+  }
+};
+
+const startEngine = async (options: StartOptions): Promise<string> => {
+  const hal = createServer({
+    app: (() => undefined) as unknown as Express,
+    wsAuth: async () => ({id: 'u1'}),
+    orchestrator: answeringOrchestrator,
+    ...options,
+  } as HalServerOptions);
+  await hal.start(0);
+  servers.push(hal);
+  const {port} = hal.server.address() as AddressInfo;
+  return `ws://127.0.0.1:${port}/hal/ws`;
+};
+
+const open = (base: string, query = ''): WebSocket => {
+  const client = new WebSocket(`${base}${query}`, [HAL_WS_SUBPROTOCOL, 't']);
+  clients.push(client);
+  return client;
+};
+
+const send = (client: WebSocket, frame: Record<string, unknown>): void => {
+  client.send(JSON.stringify(frame));
+};
+
+const collect = (
+  client: WebSocket
+): {frames: Frame[]; waitUntil: (check: (frames: Frame[]) => boolean) => Promise<void>} => {
+  const frames: Frame[] = [];
+  client.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  return {
+    frames,
+    waitUntil: async check => {
+      await eventually(() => check(frames));
+      await new Promise(resolve => setTimeout(resolve, 20));
+    },
+  };
+};
+
+// Every frame a list request draws after the handshake, so an extra stream_end or a second list fails the count.
+const answersTo = async (
+  base: string,
+  frame: Record<string, unknown> = {type: 'list_conversations'}
+): Promise<Frame[]> => {
+  const client = open(base);
+  const inbox = collect(client);
+  await inbox.waitUntil(seen => seen.some(received => received.type === 'connected'));
+  send(client, frame);
+  await inbox.waitUntil(seen =>
+    seen.some(received => received.type === 'conversation_list' || received.type === 'error')
+  );
+  return inbox.frames;
+};
+
+const onlyAnswers = (frames: Frame[]): string[] =>
+  frames.filter(frame => frame.type !== 'connected').map(frame => frame.type);
+
+const outcomeOf = (payload: unknown): {valid: boolean; error?: string; data?: unknown} => {
+  const result = validateMessage(payload);
+  return result.valid ? {valid: true, data: result.data} : {valid: false, error: result.error};
+};
+
+class RecordingStore extends InMemorySessionStore {
+  readonly asked: Array<{userId: string | number; options?: sessionStoreTypes.SessionListOptions}> = [];
+  listFor(userId: string | number, options?: sessionStoreTypes.SessionListOptions): sessionStoreTypes.SessionSummary[] {
+    this.asked.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+class RejectingListStore extends InMemorySessionStore {
+  async listFor(): Promise<sessionStoreTypes.SessionSummary[]> {
+    throw new Error('MongoServerSelectionError: connection <monitor> to ds00217.mlab.com:34567 closed');
+  }
+}
+
+describe('the conversation list over the websocket', () => {
+  beforeAll(() => {
+    setLogger({
+      debug: () => undefined,
+      info: () => undefined,
+      warn: () => undefined,
+      error: (category, message, fields) => void errorLines.push({category, message, ...fields}),
+    });
+  });
+
+  afterAll(() => setLogger());
+
+  beforeEach(() => {
+    errorLines.length = 0;
+  });
+
+  afterEach(async () => {
+    for (const client of clients.splice(0)) client.terminate();
+    for (const hal of servers.splice(0)) {
+      const {wss} = hal;
+      await eventually(() => wss.clients.size === 0);
+      await hal.stop();
+    }
+  });
+
+  describe('validation', () => {
+    it('accepts a list_conversations frame and refuses a bad limit or cursor naming the field', () => {
+      const cursor = {updatedAt: '2026-01-02T00:00:00.000Z', sessionId: 's1'};
+      const asks = {type: 'list_conversations'};
+
+      expect(outcomeOf(asks)).toEqual({valid: true, data: {type: 'list_conversations'}});
+      expect(outcomeOf({...asks, limit: 1}).valid).toBe(true);
+      expect(outcomeOf({...asks, limit: 200}).valid).toBe(true);
+      expect(outcomeOf({...asks, before: cursor}).valid).toBe(true);
+      expect(outcomeOf({...asks, limit: 0}).error).toContain('limit');
+      expect(outcomeOf({...asks, limit: 201}).error).toContain('limit');
+      expect(outcomeOf({...asks, limit: 1.5}).error).toContain('limit');
+      expect(outcomeOf({...asks, limit: '10'}).error).toContain('limit');
+      expect(outcomeOf({...asks, before: 'not a date'}).error).toContain('before');
+      expect(outcomeOf({...asks, before: cursor.updatedAt}).error).toContain('sessionId');
+      expect(outcomeOf({...asks, before: {sessionId: cursor.sessionId}}).error).toContain('updatedAt');
+    });
+  });
+
+  it("answers the user's newest conversations first, as ISO rows, and its picked id rejoins on ?sessionId=", async () => {
+    const now = Date.now();
+    const store = new InMemorySessionStore();
+    seeded(store, 's-oldest', stamp(now, -120_000), 1);
+    seeded(store, 's-middle', stamp(now, -60_000), 3);
+    const base = await startEngine({sessionStore: store, resume: {enabled: true}, history: {enabled: true}});
+
+    const sidebar = open(base);
+    const inbox = collect(sidebar);
+    await inbox.waitUntil(frames => frames.some(frame => frame.type === 'connected'));
+    const ownId = inbox.frames.find(frame => frame.type === 'connected')?.sessionId;
+
+    send(sidebar, {type: 'list_conversations'});
+    await inbox.waitUntil(frames => frames.some(frame => frame.type === 'conversation_list' || frame.type === 'error'));
+
+    const lists = inbox.frames.filter(frame => frame.type === 'conversation_list');
+    expect(lists).toHaveLength(1);
+    const rows = lists[0]?.conversations ?? [];
+    expect(rows.map(row => [row.sessionId, row.entryCount])).toEqual([
+      [ownId, 0],
+      ['s-middle', 3],
+      ['s-oldest', 1],
+    ]);
+    for (const row of rows) {
+      expect(new Date(row.createdAt).toISOString()).toBe(row.createdAt);
+      expect(new Date(row.updatedAt).toISOString()).toBe(row.updatedAt);
+    }
+    expect(inbox.frames.some(frame => frame.type === 'stream_end')).toBe(false);
+
+    sidebar.close();
+    await once(sidebar, 'close');
+
+    const reopened = open(base, '?sessionId=s-oldest');
+    const replay = collect(reopened);
+    await replay.waitUntil(frames => frames.some(frame => frame.type === 'entry_upsert'));
+    expect(replay.frames.find(frame => frame.type === 'connected')).toMatchObject({
+      sessionId: 's-oldest',
+      resumed: true,
+      entryCount: 1,
+    });
+    expect(replay.frames.filter(frame => frame.type === 'entry_upsert')).toHaveLength(1);
+  });
+
