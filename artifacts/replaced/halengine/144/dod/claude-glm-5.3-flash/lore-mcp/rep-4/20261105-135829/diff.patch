+  it("answers a history request made mid-turn before that turn's stream_end, without waiting on the lock", async () => {
+    const gate = deferred();
+    const heldTurn: ChatOrchestrator = {
+      processMessage: async () => 'held',
+      async *processMessageStream(): AsyncGenerator<MessageChunk> {
+        yield {type: 'text', text: 'held half'};
+        await gate.until;
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+    };
+    const base = await startEngine({
+      sessionStore: new InMemorySessionStore(),
+      orchestrator: heldTurn,
+      history: {enabled: true},
+    });
+
+    const client = open(base);
+    const inbox = collect(client);
+    await inbox.waitUntil(frames => frames.some(frame => frame.type === 'connected'));
+
+    send(client, {type: 'user_message', content: 'start a turn'});
+    await inbox.waitUntil(frames => frames.some(frame => frame.type === 'entry_delta'));
+
+    send(client, {type: 'list_conversations'});
+    await inbox.waitUntil(frames => frames.some(frame => frame.type === 'conversation_list' || frame.type === 'error'));
+
+    // The turn is still parked in the lock, so a list answered here is one that did not queue behind it.
+    expect(inbox.frames.some(frame => frame.type === 'stream_end')).toBe(false);
+    expect(inbox.frames.filter(frame => frame.type === 'conversation_list')).toHaveLength(1);
+
+    gate.release();
+    await inbox.waitUntil(frames => frames.some(frame => frame.type === 'stream_end'));
+    const types = inbox.frames.map(frame => frame.type);
+    expect(types.indexOf('conversation_list')).toBeLessThan(types.lastIndexOf('stream_end'));
+  });
