new file mode 100644
index 0000000..61991a6
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,408 @@
+import {WebSocket} from 'ws';
+import {validateMessage} from './ws/validation.js';
+import type {HalServerOptions} from './createServer.js';
+import {answeringOrchestrator, connectClient, deferred, startEngineWith, stopEngines} from './wsTestSupport.js';
+import type {SessionResumeOptions} from './ws/sessionResume.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {captureErrors} from '../shared/logCaptureTestSupport.js';
+import type {ChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import type {MessageChunk} from '../types/ai.js';
+import type {IncomingMessage} from '../types/messages.js';
+import type {SessionEntry} from '../types/session.js';
+import type {SessionListOptions, SessionStore, SessionSummary} from '../types/sessionStore.js';
+
+// The conversation list over the wire: a frame in, the engine's answer out, over a real upgrade, which no double can stand in for.
+
+interface Row {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+
+interface Frame {
+  type: string;
+  sessionId?: string;
+  resumed?: boolean;
+  entryCount?: number;
+  code?: string;
+  message?: string;
+  conversations?: Row[];
+  index?: number;
+  entry?: SessionEntry;
+}
+
+const LIST = JSON.stringify({type: 'list_conversations'});
+const T1 = '2026-09-30T08:00:01.000Z';
+const T2 = '2026-09-30T08:00:02.000Z';
+const T3 = '2026-09-30T08:00:03.000Z';
+
+// Both times must already be ISO strings on the wire, so a round-trip through JSON still reads as the moment it was.
+const iso = (value: unknown): boolean => typeof value === 'string' && new Date(value).toISOString() === value;
+
+const settle = (): Promise<void> => new Promise(resolve => setTimeout(resolve, 50));
+
+const plant = (
+  store: InMemorySessionStore,
+  sessionId: string,
+  userId: string,
+  sentAt: string,
+  content: string
+): void => {
+  const {entries} = store.create(sessionId, userId);
+  entries.push({role: 'user', content, timestamp: sentAt});
+};
+
+// A store with only the required members, so a suite can leave an optional one out or add one of its own.
+const requiredOnly = (inner: InMemorySessionStore): SessionStore => ({
+  create: (sessionId, userId, options) => inner.create(sessionId, userId, options),
+  get: sessionId => inner.get(sessionId),
+  delete: sessionId => inner.delete(sessionId),
+  count: () => inner.count(),
+  clear: () => inner.clear(),
+});
+
+// The real store beside a record of what listFor was asked: the answer still comes from the real listing, not from the record.
+const recording = (
+  inner: InMemorySessionStore
+): {store: SessionStore; asked: Array<{userId: string | number; options: SessionListOptions | undefined}>} => {
+  const asked: Array<{userId: string | number; options: SessionListOptions | undefined}> = [];
+  const store: SessionStore = {
+    ...requiredOnly(inner),
+    listFor: (userId, options) => {
+      asked.push({userId, options});
+      return inner.listFor(userId, options);
+    },
+  };
+  return {store, asked};
+};
+
+const failingList = (inner: InMemorySessionStore, reason: string): SessionStore => ({
+  ...requiredOnly(inner),
+  async listFor(): Promise<SessionSummary[]> {
+    throw new Error(reason);
+  },
+});
+
+type StartOptions = {history?: {enabled: boolean}; resume?: SessionResumeOptions};
+
+// `history` is this ticket's option; the cast keeps the file compiling until the option lands on HalServerOptions.
+const start = async (
+  store: SessionStore,
+  {history, resume}: StartOptions = {},
+  orchestrator: ChatOrchestrator = answeringOrchestrator
+): Promise<string> => {
+  const {url} = await startEngineWith({
+    sessionStore: store,
+    orchestrator,
+    resume,
+    history,
+  } as Partial<HalServerOptions> & Pick<HalServerOptions, 'sessionStore'>);
+  return url;
+};
+
+const connect = async (base: string, query = ''): Promise<{client: WebSocket; frames: Frame[]}> => {
+  const client = connectClient(`${base}${query}`);
+  const frames: Frame[] = [];
+  client.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  await new Promise<void>((resolve, reject) => {
+    client.once('open', () => resolve());
+    client.once('error', (error: Error) => reject(error));
+  });
+  return {client, frames};
+};
+
+// Resolves once the condition holds, or after the deadline; the boolean says which, so an assertion shows the miss.
+const eventually = async (check: () => boolean, deadlineMs = 2000): Promise<boolean> => {
+  for (let waited = 0; waited < deadlineMs && !check(); waited += 10)
+    await new Promise(resolve => setTimeout(resolve, 10));
+  return check();
+};
+
+// The first frame of the type sent after this call, or a rejection naming what did arrive instead.
+const nextOfType = (frames: Frame[], type: string, deadlineMs = 2000): Promise<Frame> =>
+  new Promise((resolve, reject) => {
+    const seenFrom = frames.length;
+    let deadline: ReturnType<typeof setTimeout> | undefined;
+    const poll = setInterval(() => {
+      const found = frames.slice(seenFrom).find(frame => frame.type === type);
+      if (found === undefined) return;
+      clearInterval(poll);
+      if (deadline !== undefined) clearTimeout(deadline);
+      resolve(found);
+    }, 5);
+    deadline = setTimeout(() => {
+      clearInterval(poll);
+      reject(
+        new Error(
+          `no ${type} frame arrived; saw: ${
+            frames
+              .slice(seenFrom)
+              .map(frame => frame.type)
+              .join(', ') || 'nothing'
+          }`
+        )
+      );
+    }, deadlineMs);
+  });
+
+const connected = (frames: Frame[]): string => frames.find(frame => frame.type === 'connected')?.sessionId ?? '';
+
+describe('the conversation list over the websocket', () => {
+  // Before captureErrors, so the teardown drains while its silenced logger still holds the close logs.
+  afterEach(async () => {
+    await stopEngines();
+    await new Promise(resolve => setTimeout(resolve, 50));
+  });
+
+  const errorLog = captureErrors();
+
+  it('answers a history request with the conversations its store holds, newest first, as ISO strings', async () => {
+    const inner = new InMemorySessionStore();
+    plant(inner, 'p1', 'u1', T1, 'oldest note');
+    plant(inner, 'p2', 'u1', T2, 'middle note');
+    plant(inner, 'p3', 'u1', T3, 'newest note');
+    const {asked, store} = recording(inner);
+    const base = await start(store, {history: {enabled: true}});
+    const {client, frames} = await connect(base);
+
+    client.send(LIST);
+    const listed = await nextOfType(frames, 'conversation_list');
+    const own = connected(frames);
+    const rows = listed.conversations ?? [];
+    expect({
+      listed: frames.filter(frame => frame.type === 'conversation_list').length,
+      order: rows.map(row => row.sessionId),
+      ownRow: {sessionId: rows[0]?.sessionId, entryCount: rows[0]?.entryCount},
+      isoCreated: rows.every(row => iso(row.createdAt)),
+      isoUpdated: rows.every(row => iso(row.updatedAt)),
+      planted: rows.slice(1).map(row => [row.sessionId, row.updatedAt, row.entryCount]),
+    }).toEqual({
+      listed: 1,
+      order: [own, 'p3', 'p2', 'p1'],
+      ownRow: {sessionId: own, entryCount: 0},
+      isoCreated: true,
+      isoUpdated: true,
+      planted: [
+        ['p3', T3, 1],
+        ['p2', T2, 1],
+        ['p1', T1, 1],
+      ],
+    });
+
+    await settle();
+    client.send(JSON.stringify({type: 'list_conversations', limit: 1, before: {updatedAt: T3, sessionId: 'p3'}}));
+    const page = await nextOfType(frames, 'conversation_list');
+    expect({
+      asked: asked.map(call => ({userId: call.userId, options: call.options})),
+      page: (page.conversations ?? []).map(row => row.sessionId),
+      ended: frames.some(frame => frame.type === 'stream_end'),
+    }).toEqual({
+      asked: [
+        {userId: 'u1', options: {limit: undefined, before: undefined}},
+        {userId: 'u1', options: {limit: 1, before: {updatedAt: T3, sessionId: 'p3'}}},
+      ],
+      page: ['p2'],
+      ended: false,
+    });
+  });
+
+  it('answers a frame naming another user with the list of the user the connection authenticated', async () => {
+    const inner = new InMemorySessionStore();
+    plant(inner, 'a1', 'u1', T2, 'mine, newer');
