+    };
+    const base = await start(new InMemorySessionStore(), {history: {enabled: true}}, orchestrator);
+    const {client, frames} = await connect(base);
+
+    client.send(JSON.stringify({type: 'user_message', content: 'hello'}));
+    const streaming = await eventually(() => frames.some(frame => frame.type === 'entry_delta'));
+    client.send(LIST);
