+    const base = await startEngine({store, history: HISTORY_ON, resume: {enabled: true}});
+
+    const conversation = await firstTurn(base);
+    const {frames} = await answerTo(base, {type: 'list_conversations'});
+
+    expect(listRows(frames).map(row => row.sessionId)).toContain(conversation);
+
+    const {connected, frames: replay} = await answerTo(`${base}?sessionId=${conversation}`, {
+      type: 'ping',
+      timestamp: 1,
+    });
+    expect({
+      resumed: connected?.resumed,
+      entryCount: connected?.entryCount,
+      replay: replay.map(frame => frame.type),
+    }).toEqual({
+      resumed: true,
+      entryCount: 2,
+      replay: ['entry_upsert', 'entry_upsert'],
+    });
+  });
