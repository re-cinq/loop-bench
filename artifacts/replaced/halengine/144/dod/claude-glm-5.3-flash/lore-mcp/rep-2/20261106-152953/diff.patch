+  it('answers a list_conversations sent while a turn streams before that turn ends, without waiting on the lock', async () => {
+    const gate = deferred();
+    const inner = new InMemorySessionStore();
+    const {store} = storeOver(inner, (userId, options) => inner.listFor(userId, options as SessionListOptions));
+    const base = await startEngine({store, history: HISTORY_ON, orchestrator: gatedOrchestrator(gate.until)});
+
+    const client = open(base);
+    const frames: Frame[] = [];
+    const ended = new Promise<void>(resolve => {
+      client.on('message', raw => {
+        const frame = JSON.parse(String(raw)) as Frame;
+        frames.push(frame);
+        if (frame.type === 'connected') client.send(JSON.stringify({type: 'user_message', content: 'hello'}));
+        if (frame.type === 'entry_delta') client.send(JSON.stringify({type: 'list_conversations'}));
+        if (frame.type === 'stream_end') resolve();
+      });
+    });
+
+    // The answer must arrive while the turn is still held: none within the window means it queued on the lock.
+    const deadline = Date.now() + 1_000;
+    let answered = false;
+    while (!answered && Date.now() < deadline) {
+      answered = frames.some(frame => frame.type === 'conversation_list');
+      if (!answered) await new Promise(resolve => setTimeout(resolve, 10));
+    }
+    const answeredWhileStreaming = answered;
+    gate.release();
+    await ended;
+    client.close();
+
+    expect({answeredWhileStreaming, order: frames.map(frame => frame.type)}).toEqual({
+      answeredWhileStreaming: true,
+      order: [
+        'connected',
+        'entry_upsert',
+        'entry_upsert',
+        'entry_delta',
+        'conversation_list',
+        'entry_commit',
+        'stream_end',
+      ],
+    });
+  });
+
