@@ -0,0 +1,440 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import type {Express} from 'express';
+import {createServer} from '../createServer.js';
+import type {HalServerOptions} from '../createServer.js';
+import {validateMessage} from './validation.js';
+import type {ValidationResult} from './validation.js';
+import {HAL_WS_SUBPROTOCOL} from './subprotocol.js';
+import {answeringOrchestrator, deferred} from '../wsTestSupport.js';
+import type {SessionResumeOptions} from './sessionResume.js';
+import {InMemorySessionStore} from '../../infrastructure/stores/inMemorySessionStore.js';
+import type {SessionListOptions, SessionStore, SessionSummary} from '../../types/sessionStore.js';
+import type {ChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import type {MessageChunk} from '../../types/ai.js';
+import {setLogger} from '../../shared/logger.js';
+
+// A user's conversation list, delivered over the same socket that authenticates them
+// (re-cinq/HALEngine#144): real upgrades over a real socket, and the frames are the contract.
+
+interface WireSummary {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+
+interface Frame {
+  type: string;
+  code?: string;
+  message?: string;
+  conversations?: WireSummary[];
+  sessionId?: string;
+  entryCount?: number;
+  resumed?: boolean;
+}
+
+interface RecordedCall {
+  userId: string | number;
+  options: unknown;
+}
+
+const HISTORY_ON = {enabled: true} as const;
+const NEWEST_AT = '2026-01-03T10:00:00.000Z';
+const MIDDLE_AT = '2026-01-02T10:00:00.000Z';
+const OLDEST_AT = '2026-01-01T10:00:00.000Z';
+
+// `ConversationSummary` and the cursor are wired with their two times as ISO strings, not Dates.
+const summary = (sessionId: string, updatedAt: string, entryCount: number): SessionSummary => ({
+  sessionId,
+  createdAt: new Date(Date.parse(updatedAt) - 60_000),
+  updatedAt: new Date(Date.parse(updatedAt)),
+  entryCount,
+});
+
+const threeConversations = (): SessionSummary[] => [
+  summary('newest', NEWEST_AT, 7),
+  summary('middle', MIDDLE_AT, 3),
+  summary('oldest', OLDEST_AT, 1),
+];
+
+// A consumer's store over the real in-memory one, recording what the transport asks of it, so the
+// recorded argument is asserted and not only the frame that came back.
+const storeOver = (
+  inner: InMemorySessionStore,
+  list: (userId: string | number, options: unknown) => SessionSummary[] | Promise<SessionSummary[]>
+): {store: SessionStore; calls: RecordedCall[]} => {
+  const calls: RecordedCall[] = [];
+  const store: SessionStore = {
+    create: (sessionId, userId, options) => inner.create(sessionId, userId, options),
+    get: sessionId => inner.get(sessionId),
+    delete: sessionId => inner.delete(sessionId),
+    count: () => inner.count(),
+    clear: () => inner.clear(),
+    listFor: (userId, options) => {
+      calls.push({userId, options});
+      return list(userId, options);
+    },
+  };
+  return {store, calls};
+};
+
+// A store written against the five required members, as one predating conversation lists is.
+const withoutAList = (): SessionStore => {
+  const inner = new InMemorySessionStore();
+  return {
+    create: (sessionId, userId, options) => inner.create(sessionId, userId, options),
+    get: sessionId => inner.get(sessionId),
+    delete: sessionId => inner.delete(sessionId),
+    count: () => inner.count(),
+    clear: () => inner.clear(),
+  };
+};
+
+// `StoreCannotList` is public surface this issue adds, so it is read at runtime: its absence fails
+// this case by name rather than breaking the file's imports before the build adds it.
+const cannotListError = async (): Promise<Error> => {
+  const candidates = ['../../types/sessionStore.js', '../../types/session.js', '../../types/messages.js'] as const;
+  for (const source of candidates) {
+    const exported = (await import(source)) as unknown as {StoreCannotList?: new (message?: string) => Error};
+    if (exported.StoreCannotList) return new exported.StoreCannotList('this store cannot list conversations');
+  }
+  throw new Error(
+    'StoreCannotList is not exported yet, so a store that cannot list cannot be told from one that failed'
+  );
+};
+
+// A turn held open until the test releases it, so a list request can arrive mid-turn.
+const gatedOrchestrator = (until: Promise<void>): ChatOrchestrator => ({
+  processMessage: async () => 'half',
+  async *processMessageStream(): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'half'};
+    await until;
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+});
+
+type EngineOptions = HalServerOptions & {history?: {enabled: boolean}};
+
+const servers: Array<ReturnType<typeof createServer>> = [];
+const clients: WebSocket[] = [];
+const errorLines: Array<Record<string, unknown>> = [];
+
+const eventually = async (check: () => boolean): Promise<void> => {
+  for (let attempt = 0; attempt < 50 && !check(); attempt++) await new Promise(resolve => setTimeout(resolve, 10));
+};
+
+// Error lines are kept while the noisy levels are silenced: one test reads what the engine logged.
+beforeAll(() => {
+  setLogger({
+    debug: () => undefined,
+    info: () => undefined,
+    warn: () => undefined,
+    error: (category, message, fields) => void errorLines.push({category, message, ...fields}),
+  });
+});
+
+afterAll(() => {
+  setLogger();
+});
+
+afterEach(async () => {
+  errorLines.length = 0;
+  for (const client of clients.splice(0)) client.terminate();
+  for (const hal of servers.splice(0)) {
+    const {wss} = hal;
+    await eventually(() => wss.clients.size === 0);
+    await hal.stop();
+  }
+});
+
+const startEngine = async (options: {
+  store: SessionStore;
+  history?: {enabled: boolean};
+  resume?: SessionResumeOptions;
+  orchestrator?: ChatOrchestrator;
+}): Promise<string> => {
+  const engineOptions: EngineOptions = {
+    app: (() => undefined) as unknown as Express,
+    wsAuth: async () => ({id: 'u1'}),
+    sessionStore: options.store,
+    orchestrator: options.orchestrator ?? answeringOrchestrator,
+    resume: options.resume,
+    history: options.history,
+  };
+  const hal = createServer(engineOptions);
+  await hal.start(0);
+  servers.push(hal);
+  const {port} = hal.server.address() as AddressInfo;
+  return `ws://127.0.0.1:${port}/hal/ws`;
+};
+
+const open = (base: string): WebSocket => {
+  const client = new WebSocket(base, [HAL_WS_SUBPROTOCOL, 't']);
+  clients.push(client);
+  return client;
+};
+
+// Sends one frame on a fresh connection and collects exactly what the server writes in answer: a
+// ping sent once the first answer frame arrives is a barrier, so nothing after the pong belongs
+// to the answer and nothing the server wrote before it is missed.
+const answerTo = async (
+  base: string,
+  request: Record<string, unknown>
+): Promise<{client: WebSocket; connected?: Frame; frames: Frame[]; sessionId: string}> => {
+  const client = open(base);
+  const frames: Frame[] = [];
+  let connected: Frame | undefined;
+  let sessionId = '';
+  let phase: 'opening' | 'asking' | 'answering' = 'opening';
+  await new Promise<void>(resolve => {
+    client.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as Frame;
+      if (frame.type === 'pong') {
+        resolve();
+        return;
+      }
+      if (frame.type === 'connected') {
+        connected = frame;
+        sessionId = frame.sessionId ?? '';
+        phase = 'asking';
+        client.send(JSON.stringify(request));
+        return;
+      }
+      if (phase === 'opening') return;
+      frames.push(frame);
+      if (phase === 'asking' && (frame.type === 'conversation_list' || frame.type === 'error')) {
+        phase = 'answering';
+        client.send(JSON.stringify({type: 'ping', timestamp: 1}));
+      }
+    });
+  });
+  return {client, connected, frames, sessionId};
+};
+
+// One turn on a fresh conversation, returning the id its connected frame announced.
+const firstTurn = async (base: string): Promise<string> => {
+  const client = open(base);
+  let sessionId = '';
+  await new Promise<void>(resolve => {
+    client.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as Frame;
+      if (frame.type === 'connected') {
+        sessionId = frame.sessionId ?? '';
+        client.send(JSON.stringify({type: 'user_message', content: 'hello'}));
+      }
+      if (frame.type === 'stream_end') resolve();
+    });
+  });
+  client.close();
+  await once(client, 'close');
+  return sessionId;
+};
+
+const listRows = (frames: Frame[]): WireSummary[] =>
+  frames.find(frame => frame.type === 'conversation_list')?.conversations ?? [];
+
+describe('the conversation list over the websocket protocol', () => {
+  it('answers list_conversations with one conversation_list of the newest-first summaries as ISO strings, handing limit and before to the store as the frame sent them', async () => {
+    const {store, calls} = storeOver(new InMemorySessionStore(), () => threeConversations());
+    const base = await startEngine({store, history: HISTORY_ON});
+
+    await answerTo(base, {type: 'list_conversations'});
+    await answerTo(base, {type: 'list_conversations', limit: 2});
+    const {frames} = await answerTo(base, {
+      type: 'list_conversations',
+      limit: 2,
+      before: {updatedAt: NEWEST_AT, sessionId: 'newest'},
+    });
+
+    expect(frames).toEqual([
+      {
+        type: 'conversation_list',
+        conversations: [
+          {sessionId: 'newest', createdAt: '2026-01-03T09:59:00.000Z', updatedAt: NEWEST_AT, entryCount: 7},
+          {sessionId: 'middle', createdAt: '2026-01-02T09:59:00.000Z', updatedAt: MIDDLE_AT, entryCount: 3},
+          {sessionId: 'oldest', createdAt: '2026-01-01T09:59:00.000Z', updatedAt: OLDEST_AT, entryCount: 1},
+        ],
+      },
+    ]);
+    // `options ?? {}` reads an omitted argument and `{limit: undefined, before: undefined}` as the same call.
+    expect(calls.map(call => ({userId: call.userId, options: call.options ?? {}}))).toEqual([
+      {userId: 'u1', options: {}},
+      {userId: 'u1', options: {limit: 2}},
+      {userId: 'u1', options: {limit: 2, before: {updatedAt: NEWEST_AT, sessionId: 'newest'}}},
+    ]);
+  });
+
+  it('answers with the list of the user the connection authenticated, never one a frame names', async () => {
+    const inner = new InMemorySessionStore();
+    inner.create('u1-first', 'u1');
+    inner.create('u1-second', 'u1');
+    inner.create('u2-only', 'u2');
+    const {store, calls} = storeOver(inner, (userId, options) => inner.listFor(userId, options as SessionListOptions));
+    const base = await startEngine({store, history: HISTORY_ON});
+
+    const {frames, sessionId} = await answerTo(base, {type: 'list_conversations', userId: 'u2'});
+    const listed = listRows(frames).map(row => row.sessionId);
+
+    expect({listed, askedFor: calls.map(call => call.userId)}).toEqual({
+      listed: expect.arrayContaining([sessionId, 'u1-first', 'u1-second']),
+      askedFor: ['u1'],
+    });
+    expect(listed).not.toContain('u2-only');
+  });
+
+  it('validates the frame whether or not the feature is on, refusing a bad limit or a half cursor by name', () => {
+    const valid = (extra: Record<string, unknown>, data: Record<string, unknown>): ValidationResult =>
+      validateMessage({type: 'list_conversations', ...extra});
+    const cursor = {updatedAt: NEWEST_AT, sessionId: 'newest'};
+
+    expect(valid({}, {})).toEqual({valid: true, data: {type: 'list_conversations'}});
+    expect(valid({limit: 10, before: cursor, userId: 'someone-else'}, {})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations', limit: 10, before: cursor},
+    });
+
+    const refusals: Array<[Record<string, unknown>, RegExp]> = [
+      [{limit: 0}, /limit/],
+      [{limit: 201}, /limit/],
+      [{limit: 1.5}, /limit/],
+      [{limit: '10'}, /limit/],
+      [{before: 'not a date'}, /before/],
+      [{before: {updatedAt: NEWEST_AT}}, /before/],
+      [{before: {sessionId: 'newest'}}, /before/],
+    ];
+    for (const [asked, field] of refusals) {
+      const result = validateMessage({type: 'list_conversations', ...asked});
+      expect({asked, valid: result.valid, error: result.valid ? '' : result.error}).toEqual({
+        asked,
+        valid: false,
+        error: expect.stringMatching(field),
+      });
+    }
+  });
