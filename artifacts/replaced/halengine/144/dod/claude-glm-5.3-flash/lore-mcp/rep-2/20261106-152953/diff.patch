+  it('answers a failing store with SERVER_ERROR, keeps the socket open and leaks nothing of the store', async () => {
+    const inner = new InMemorySessionStore();
+    const {store} = storeOver(inner, () => Promise.reject(new Error('mongo primary is down at db.internal:27017')));
+    const base = await startEngine({store, history: HISTORY_ON});
+
+    const {client, frames, sessionId} = await answerTo(base, {type: 'list_conversations'});
+    const nextPong = new Promise<void>(resolve => {
+      client.on('message', raw => {
+        if ((JSON.parse(String(raw)) as Frame).type === 'pong') resolve();
+      });
+    });
+    client.send(JSON.stringify({type: 'ping', timestamp: 2}));
+    await nextPong;
+
+    const logged = errorLines.some(
+      line => line.sessionId === sessionId && !/mongo|db\.internal/i.test(JSON.stringify(line))
+    );
+
+    expect({
