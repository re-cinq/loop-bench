@@ -0,0 +1,440 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import type {Express} from 'express';
+import {createServer} from './createServer.js';
+import type {HalServer} from './createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+import {answeringOrchestrator, deferred} from './wsTestSupport.js';
+import type {SessionResumeOptions} from './ws/sessionResume.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {ChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import type {MessageChunk} from '../types/ai.js';
+import type {SessionListOptions, SessionStore, SessionSummary} from '../types/sessionStore.js';
+import {setLogger} from '../shared/logger.js';
+
+// HALEngine#144: a client asks for its own conversation list over the socket it is already authenticated on.
+// Real upgrades over a real socket, as for resume: what a client is sent is the contract, and no double can observe it.
+
+interface WireFrame {
+  type: string;
+  sessionId?: string;
+  resumed?: boolean;
+  entryCount?: number;
+  code?: string;
+  message?: string;
+  timestamp?: number;
+  conversations?: unknown;
+  entry?: unknown;
+}
+
+interface Row {
+  sessionId: string;
+  createdAt: unknown;
+  updatedAt: unknown;
+  entryCount: number;
+}
+
+const USER = 'u1';
+const OTHER = 'u2';
+const UNSUPPORTED = 'UNSUPPORTED';
+
+const sleep = (ms: number): Promise<void> => new Promise(resolve => setTimeout(resolve, ms));
+
+// Bounded waits, so an absent frame names itself instead of hanging the run out to the suite's timeout.
+const eventually = async (check: () => boolean): Promise<boolean> => {
+  for (let attempt = 0; attempt < 300 && !check(); attempt++) await sleep(5);
+  return check();
+};
+
+const servers: HalServer[] = [];
+const clients: WebSocket[] = [];
+const logged: Array<{level: string; category: string; message: string; data?: Record<string, unknown>}> = [];
+
+const loggedLines = (): string[] => logged.map(line => JSON.stringify({...line}));
+
+// warn and error are recorded; info and debug are silenced, for these tests read frames, not connection chatter.
+beforeAll(() => {
+  setLogger({
+    debug: () => undefined,
+    info: () => undefined,
+    warn: (category, message, fields) => void logged.push({level: 'warn', category, message, data: fields}),
+    error: (category, message, fields) => void logged.push({level: 'error', category, message, data: fields}),
+  });
+});
+
+afterAll(() => setLogger());
+
+beforeEach(() => {
+  logged.length = 0;
+});
+
+afterEach(async () => {
+  for (const client of clients.splice(0)) client.terminate();
+  for (const hal of servers.splice(0)) {
+    const {wss} = hal;
+    await eventually(() => wss.clients.size === 0);
+    await hal.stop();
+  }
+});
+
+interface EngineOptions {
+  sessionStore: SessionStore;
+  history?: {enabled: boolean};
+  resume?: SessionResumeOptions;
+  orchestrator?: ChatOrchestrator;
+}
+
+const startEngine = async (options: EngineOptions): Promise<string> => {
+  // Held in a variable, not a call-site literal, so the new `history` field rides through before the option type has it.
+  const halOptions = {
+    app: (() => undefined) as unknown as Express,
+    wsAuth: async () => ({id: USER}),
+    sessionStore: options.sessionStore,
+    orchestrator: options.orchestrator ?? answeringOrchestrator,
+    resume: options.resume,
+    history: options.history,
+  };
+  const hal = createServer(halOptions);
+  await hal.start(0);
+  servers.push(hal);
+  const {port} = hal.server.address() as AddressInfo;
+  return `ws://127.0.0.1:${port}/hal/ws`;
+};
+
+const isoAt = (msFromNow: number): string => new Date(Date.now() + msFromNow).toISOString();
+
+// A conversation in the store, one entry deep, its activity stamped in the future so the order ignores the clock.
+const plant = (
+  store: InMemorySessionStore,
+  sessionId: string,
+  userId: string,
+  activityIso: string,
+  content: string
+): void => {
+  const session = store.create(sessionId, userId);
+  session.entries.push({role: 'user', content, timestamp: activityIso});
+};
+
+const recordingList = (): {
+  store: InMemorySessionStore;
+  calls: Array<{userId: string | number; options?: SessionListOptions}>;
+} => {
+  const inner = new InMemorySessionStore();
+  const calls: Array<{userId: string | number; options?: SessionListOptions}> = [];
+  const listed = inner.listFor.bind(inner);
+  const store = Object.assign(inner, {
+    listFor: (userId: string | number, options?: SessionListOptions): SessionSummary[] => {
+      calls.push({userId, options});
+      return listed(userId, options);
+    },
+  });
+  return {store, calls};
+};
+
+// A store written against the five original members: the interface keeps listFor optional beside it.
+const storeWithoutList = (): SessionStore => {
+  const inner = new InMemorySessionStore();
+  return {
+    create: (sessionId, userId, options) => inner.create(sessionId, userId, options),
+    get: sessionId => inner.get(sessionId),
+    delete: sessionId => inner.delete(sessionId),
+    count: () => inner.count(),
+    clear: () => inner.clear(),
+  };
+};
+
+const storeWhoseList = (listFor: () => Promise<SessionSummary[]>): InMemorySessionStore =>
+  Object.assign(new InMemorySessionStore(), {listFor});
+
+const listen = (client: WebSocket): WireFrame[] => {
+  const seen: WireFrame[] = [];
+  client.on('message', raw => seen.push(JSON.parse(String(raw)) as WireFrame));
+  return seen;
+};
+
+const frameOf = (seen: WireFrame[], type: string): WireFrame | undefined => seen.find(frame => frame.type === type);
+
+const awaitFrame = async (seen: WireFrame[], type: string): Promise<WireFrame> => {
+  if (!(await eventually(() => frameOf(seen, type) !== undefined))) {
+    throw new Error(
+      `no ${type} frame arrived; the frames seen were: ${seen.map(frame => frame.type).join(', ') || 'none'}`
+    );
+  }
+  return frameOf(seen, type) as WireFrame;
+};
+
+const connect = async (url: string): Promise<{client: WebSocket; seen: WireFrame[]}> => {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 't']);
+  clients.push(client);
+  const seen = listen(client);
+  await once(client, 'open');
+  await awaitFrame(seen, 'connected');
+  return {client, seen};
+};
+
+const announcedId = (seen: WireFrame[]): string => frameOf(seen, 'connected')?.sessionId ?? '';
+
+describe('the conversation list over the websocket', () => {
+  describe('a list_conversations frame', () => {
+    it('answers with the conversations of the user the connection authenticated, newest first, as ISO strings', async () => {
+      const stamps = {newest: isoAt(9_000), middle: isoAt(6_000), oldest: isoAt(3_000), other: isoAt(60_000)};
+      const {store, calls} = recordingList();
+      plant(store, 'c-oldest', USER, stamps.oldest, 'oldest planted');
+      plant(store, 'c-middle', USER, stamps.middle, 'middle planted');
+      plant(store, 'c-newest', USER, stamps.newest, 'newest planted');
+      plant(store, 'c-other', OTHER, stamps.other, 'another user conversation');
+
+      const url = await startEngine({sessionStore: store, history: {enabled: true}});
+      const {client, seen} = await connect(url);
+      const own = announcedId(seen);
+
+      // The one frame this issue must leave alone: a fresh connected carries exactly the four fields it shipped with.
+      expect(Object.keys(frameOf(seen, 'connected') as WireFrame).sort()).toEqual([
+        'examplePrompts',
+        'message',
+        'sessionId',
+        'type',
+      ]);
+
+      // The frame names another user; the connection is what decides whose list is answered.
+      client.send(JSON.stringify({type: 'list_conversations', userId: OTHER}));
+      const list = await awaitFrame(seen, 'conversation_list');
+      await sleep(250);
+
+      const rows = list.conversations as Row[];
+      expect(seen.filter(frame => frame.type === 'conversation_list')).toHaveLength(1);
+      expect(seen.some(frame => frame.type === 'stream_end')).toBe(false);
+      expect(seen.some(frame => frame.type === 'error')).toBe(false);
+      expect(rows.map(row => row.sessionId)).toEqual(['c-newest', 'c-middle', 'c-oldest', own]);
+      expect(rows.map(row => row.entryCount)).toEqual([1, 1, 1, 0]);
+      for (const row of rows) {
+        // A summary on the wire is the four fields, its two times ISO strings: a Date does not survive JSON.
+        expect(Object.keys(row).sort()).toEqual(['createdAt', 'entryCount', 'sessionId', 'updatedAt']);
+        expect(typeof row.createdAt).toBe('string');
+        expect(Number.isNaN(Date.parse(String(row.createdAt)))).toBe(false);
+        expect(typeof row.updatedAt).toBe('string');
+        expect(Number.isNaN(Date.parse(String(row.updatedAt)))).toBe(false);
+      }
+      expect(rows.map(row => String(row.updatedAt))).toEqual([
+        stamps.newest,
+        stamps.middle,
+        stamps.oldest,
+        expect.any(String),
+      ]);
+      // Recorded on the store call, not read off the frames: the user id came from the connection, never the frame.
+      expect(calls).toHaveLength(1);
+      expect(calls[0].userId).toBe(USER);
+    });
+
+    it('passes the frame paging options to listFor as the frame sent them, undefined included', async () => {
+      const {store, calls} = recordingList();
+      const url = await startEngine({sessionStore: store, history: {enabled: true}});
+      const {client, seen} = await connect(url);
+      const own = announcedId(seen);
+
+      client.send(JSON.stringify({type: 'list_conversations'}));
+      const first = await awaitFrame(seen, 'conversation_list');
+      const rows = first.conversations as Row[];
+      expect(rows).toHaveLength(1);
+      expect(rows.at(-1)?.sessionId).toBe(own);
+
+      // The cursor a client holds is a row the list itself handed over, its times ISO strings from the wire.
+      const cursor = {updatedAt: String(rows.at(-1)?.updatedAt), sessionId: own};
+      client.send(JSON.stringify({type: 'list_conversations', limit: 2, before: cursor}));
+      await eventually(() => seen.filter(frame => frame.type === 'conversation_list').length === 2);
+
+      expect(calls).toHaveLength(2);
+      expect(calls.map(call => call.userId)).toEqual([USER, USER]);
+      // Both keys, possibly undefined, rather than the argument omitted: the same call either way.
+      expect(calls[0].options).toStrictEqual({limit: undefined, before: undefined});
+      expect(calls[1].options).toStrictEqual({limit: 2, before: cursor});
+    });
+  });
+
+  describe('the frame shape', () => {
+    it('accepts a bare list_conversations and forwards no user id, whether history is on or not', () => {
+      // Validation is static and has no config to ask: the handler, not the validator, refuses it with history off.
+      expect(validateMessage({type: 'list_conversations'})).toEqual({valid: true, data: {type: 'list_conversations'}});
+      expect(validateMessage({type: 'list_conversations', userId: OTHER})).toEqual({
+        valid: true,
+        data: {type: 'list_conversations'},
+      });
+    });
+
+    it.each<[string, unknown, string]>([
+      ['a limit of 0', {type: 'list_conversations', limit: 0}, 'limit'],
+      ['a limit of 201', {type: 'list_conversations', limit: 201}, 'limit'],
+      ['a fractional limit', {type: 'list_conversations', limit: 1.5}, 'limit'],
+      ['a limit sent as a string', {type: 'list_conversations', limit: '10'}, 'limit'],
+      ['a before that is a bare timestamp', {type: 'list_conversations', before: 'not a date'}, 'before'],
+      ['a before without its sessionId half', {type: 'list_conversations', before: {updatedAt: isoAt(0)}}, 'before'],
+      ['a before without its updatedAt half', {type: 'list_conversations', before: {sessionId: 'c1'}}, 'before'],
+      [
+        'a before with an unusable moment',
+        {type: 'list_conversations', before: {updatedAt: 'not a date', sessionId: 'c1'}},
+        'before',
+      ],
+    ])('rejects %s, naming the field', (_label, frame, field) => {
+      const result = validateMessage(frame);
+      expect(result.valid).toBe(false);
+      if (!result.valid) expect(result.error).toContain(field);
+    });
+
+    it('accepts the limit bounds and a whole before cursor', () => {
+      expect(validateMessage({type: 'list_conversations', limit: 1}).valid).toBe(true);
+      expect(
+        validateMessage({type: 'list_conversations', limit: 200, before: {updatedAt: isoAt(0), sessionId: 'c1'}}).valid
+      ).toBe(true);
+    });
+  });
+
+  describe('when the frame cannot be answered', () => {
+    it('answers UNSUPPORTED and no list when history is off or the store cannot list, and warns when history is on without resume', async () => {
+      // The flag absent is a deployment decision, not an omission to fill with an empty list.
+      const offUrl = await startEngine({sessionStore: new InMemorySessionStore()});
+      const off = await connect(offUrl);
+      off.client.send(JSON.stringify({type: 'list_conversations'}));
+      const offError = await awaitFrame(off.seen, 'error');
+
+      // A store written before lists existed is a misconfiguration to report, not a user with no conversations.
+      const bareUrl = await startEngine({sessionStore: storeWithoutList(), history: {enabled: true}});
+      const bare = await connect(bareUrl);
+      bare.client.send(JSON.stringify({type: 'list_conversations'}));
+      const bareError = await awaitFrame(bare.seen, 'error');
+      await sleep(250);
+
+      for (const {client, seen} of [off, bare]) {
+        expect(seen.filter(frame => frame.type === 'conversation_list')).toHaveLength(0);
+        expect(seen.map(frame => frame.type)).toEqual(['connected', 'error']);
+        expect(client.readyState).toBe(WebSocket.OPEN);
+      }
+      expect(offError.code).toBe(UNSUPPORTED);
+      expect(bareError.code).toBe(UNSUPPORTED);
+
+      // history without resume lists rows no client can open: a deployment slip the engine names at startup.
+      expect(logged.some(line => line.level === 'warn' && line.message.includes('history'))).toBe(true);
+    });
+
+    it('answers a rejecting store with SERVER_ERROR, the socket open and no store detail anywhere, and one that cannot list with UNSUPPORTED', async () => {
+      const detail = 'replica set unreachable on mongodb://cluster-a.internal:27017';
+      const content = 'holiday photos in Kyoto';
+      const store = storeWhoseList(async () => {
+        throw new Error(`list failed: ${detail}`);
+      });
+      plant(store, 'c-private', USER, isoAt(5_000), content);
+
+      const url = await startEngine({sessionStore: store, history: {enabled: true}});
+      const {client, seen} = await connect(url);
+      const own = announcedId(seen);
+
+      client.send(JSON.stringify({type: 'list_conversations'}));
+      const failure = await awaitFrame(seen, 'error');
+      client.send(JSON.stringify({type: 'ping', timestamp: 4321}));
+      const pong = await awaitFrame(seen, 'pong');
+      await sleep(250);
+
+      expect(seen.filter(frame => frame.type === 'error')).toHaveLength(1);
+      expect(failure.code).toBe('SERVER_ERROR');
+      expect(String(failure.message)).not.toContain(detail);
+      expect(pong.timestamp).toBe(4321);
+      expect(client.readyState).toBe(WebSocket.OPEN);
+
+      const lines = loggedLines();
+      expect(lines.some(line => line.includes(own))).toBe(true);
+      expect(lines.some(line => line.includes('cluster-a') || line.includes('replica set'))).toBe(false);
+      expect(lines.some(line => line.includes(content))).toBe(false);
+
+      // The permanent misconfiguration reads as one (issue amendment 3), not as a database that failed.
+      const {StoreCannotList} = (await import('../types/session.js')) as unknown as {
+        StoreCannotList?: new (message: string) => Error;
+      };
+      if (StoreCannotList === undefined) {
+        throw new Error('types/session.js exports no StoreCannotList for a store that cannot list to throw');
+      }
+      const unable = storeWhoseList(async () => {
+        throw new StoreCannotList('the collection implements no find');
+      });
+      const unableUrl = await startEngine({sessionStore: unable, history: {enabled: true}});
+      const other = await connect(unableUrl);
+      other.client.send(JSON.stringify({type: 'list_conversations'}));
+      const refused = await awaitFrame(other.seen, 'error');
+      await sleep(250);
+
+      expect(other.seen.filter(frame => frame.type === 'conversation_list')).toHaveLength(0);
+      expect(other.seen.filter(frame => frame.type === 'error')).toHaveLength(1);
+      expect(refused.code).toBe(UNSUPPORTED);
+    });
+  });
+
+  describe('beside a streaming turn', () => {
+    it('answers a list request while the turn is still streaming, before its stream_end', async () => {
+      const gate = deferred();
+      const slowStream: ChatOrchestrator = {
+        processMessage: async () => '',
+        async *processMessageStream(): AsyncGenerator<MessageChunk> {
+          yield {type: 'text', text: 'the first half of an answer'};
+          await gate.until;
+          yield {type: 'text', text: ', and its second half'};
+          yield {type: 'stop', stopReason: 'end_turn'};
+        },
+      };
+      const url = await startEngine({
+        sessionStore: new InMemorySessionStore(),
+        history: {enabled: true},
+        orchestrator: slowStream,
+      });
+      const {client, seen} = await connect(url);
+
+      client.send(JSON.stringify({type: 'user_message', content: 'a question with a long answer'}));
+      await awaitFrame(seen, 'entry_delta');
+
+      client.send(JSON.stringify({type: 'list_conversations'}));
+      const list = await awaitFrame(seen, 'conversation_list');
+
+      // A history request is not a turn: it must not queue behind the answer in flight.
+      expect(seen.some(frame => frame.type === 'stream_end')).toBe(false);
+
+      gate.release();
