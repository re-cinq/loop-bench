+    const {base} = await startEngine(store, {history: {enabled: true}, resume: {enabled: true}});
+
+    // A fresh connect, a look at the list, a row opened: the whole journey a history sidebar makes.
+    const client = open(base);
+    let ownId = '';
+    const listed: Frame[] = [];
+    await new Promise<void>(resolve => {
+      client.on('message', raw => {
+        const frame = JSON.parse(String(raw)) as Frame;
+        listed.push(frame);
+        if (frame.type === 'connected') {
+          ownId = frame.sessionId ?? '';
+          client.send(JSON.stringify({type: 'list_conversations'}));
+        }
+        if (frame.type === 'conversation_list' || frame.type === 'error') resolve();
+      });
+    });
+    const rows = listed.find(frame => frame.type === 'conversation_list')?.conversations ?? [];
+    client.close();
+    await once(client, 'close');
+
+    const again = await settle(`${base}?sessionId=earlier`);
+    const replay = again
+      .filter(frame => frame.type === 'entry_upsert')
+      .map(frame => ({index: frame.index, content: frame.entry?.content}));
