+  it('answers a listFor that rejects with one SERVER_ERROR naming no store detail, keeps the socket open, and logs the failure with the session id', async () => {
+    // A database detail, not a message for a client: the kind of string that names a host and a query.
+    const DETAIL = 'ECONNRESET reading history for u1 at 10.1.2.3:27017';
+    const store: SessionStore = {
+      ...delegatingTo(new InMemorySessionStore()),
+      listFor: async () => {
+        throw new Error(DETAIL);
+      },
+    };
+    const {base} = await startEngine(store, {history: {enabled: true}});
+
+    // The ping after the error frame is answered only by a socket still open, which is the barrier.
+    const frames = await exchange(base, [{type: 'list_conversations'}], ANSWER);
+    const logged = errors.find(line => line.sessionId === frames[0].sessionId);
