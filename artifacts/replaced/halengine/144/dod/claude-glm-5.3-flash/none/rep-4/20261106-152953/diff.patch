+  it('answers list_conversations sent during a streaming turn before that turn ends in stream_end', async () => {
+    const gate = deferred();
+    const {base} = await startEngine(new InMemorySessionStore(), {
+      history: {enabled: true},
+      orchestrator: heldAnswer(gate.until),
+    });
+
+    // An error frees the hold too: without the feature the turn still completes, and the assertion
+    // below reads the missing list rather than the run hanging on a gate nothing released.
+    const seen: Frame[] = [];
+    let asked = false;
+    const client = open(base);
+    await new Promise<void>(resolve => {
+      client.on('message', raw => {
+        const frame = JSON.parse(String(raw)) as Frame;
+        seen.push(frame);
+        if (frame.type === 'connected') client.send(JSON.stringify({type: 'user_message', content: 'hello'}));
+        if (frame.type === 'entry_upsert' && !asked) {
+          // Asked once, at the first entry: a repeat would answer twice and read as a broken handler.
+          asked = true;
+          client.send(JSON.stringify({type: 'list_conversations'}));
+        }
+        if (frame.type === 'conversation_list' || frame.type === 'error') gate.release();
+        if (frame.type === 'stream_end') client.send(JSON.stringify({type: 'ping', timestamp: 2}));
+        if (frame.type === 'pong') resolve();
+      });
+    });
+
+    const order = seen.map(frame => frame.type);
+    expect({
+      asked: order.includes('conversation_list'),
+      once: order.filter(type => type === 'conversation_list').length,
+      answered: order.indexOf('conversation_list') < order.indexOf('stream_end'),
+    }).toEqual({
+      asked: true,
+      once: 1,
+      answered: true,
+    });
+  });
