+      ownEntries: rows.find(row => row.sessionId === ownId)?.entryCount,
+      picked: rows.some(row => row.sessionId === 'earlier'),
+      resumed: again[0]?.resumed,
+      entryCount: again[0]?.entryCount,
+      replay,
+    }).toEqual({
+      listed: [ownId, 'earlier'],
+      ownEntries: 0,
+      picked: true,
+      resumed: true,
