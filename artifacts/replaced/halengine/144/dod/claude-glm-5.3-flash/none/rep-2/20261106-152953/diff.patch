@@ -0,0 +1,342 @@
+import {once} from 'node:events';
+import {WebSocket} from 'ws';
+import {validateMessage} from './ws/validation.js';
+import {connectClient, deferred, startEngineWith, stopEngines} from './wsTestSupport.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {MongoSessionStore} from '../infrastructure/stores/mongo/mongoSessionStore.js';
+import {fakeCollection} from '../infrastructure/stores/mongo/mongoTestSupport.js';
+import {setLogger} from '../shared/logger.js';
+import type {ChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import type {MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import type {SessionListOptions, SessionStore, SessionSummary} from '../types/sessionStore.js';
+
+// A user's conversation list, asked for and answered over the socket the user is already authenticated on.
+
+type Frame = Record<string, unknown>;
+
+interface Row {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+
+const SEED = Date.now();
+// Future-dated entries, so each seeded conversation's activity is distinct and newer than the moment it was created at.
+const AT = (offsetMs: number): string => new Date(SEED + offsetMs).toISOString();
+
+const types = (frames: Frame[]): string[] => frames.map(frame => String(frame.type));
+
+const frameOf = (frames: Frame[], type: string): Frame => {
+  const found = frames.filter(frame => frame.type === type);
+  if (found.length !== 1) throw new Error(`expected exactly one ${type} frame, saw ${found.length}`);
+  return found[0]!;
+};
+
+const rowsOf = (frames: Frame[]): Row[] =>
+  (frameOf(frames, 'conversation_list') as {conversations: Row[]}).conversations;
+
+const until = async (what: string, frames: Frame[], check: () => boolean): Promise<void> => {
+  for (let attempt = 0; attempt < 250 && !check(); attempt++) await new Promise(resolve => setTimeout(resolve, 10));
+  if (!check()) throw new Error(`timed out waiting to ${what}; frames seen: ${JSON.stringify(types(frames))}`);
+};
+
+// What the wire list must equal: the store's own answer, with both times carried as ISO strings.
+const wireRows = (store: InMemorySessionStore, userId: string): Row[] =>
+  store.listFor(userId).map(summary => ({
+    sessionId: summary.sessionId,
+    createdAt: summary.createdAt.toISOString(),
+    updatedAt: summary.updatedAt.toISOString(),
+    entryCount: summary.entryCount,
+  }));
+
+const seed = (store: InMemorySessionStore, userId: string, ids: string[]): void => {
+  for (const [position, id] of ids.entries()) {
+    const session = store.create(id, userId);
+    session.entries.push({
+      role: 'user',
+      content: 'planted-conversation-text-9f3a',
+      timestamp: AT((position + 1) * 1000),
+    });
+  }
+};
+
+// Wraps the real store's listFor so the recorded argument can be asserted on; the answer still comes from the store.
+const recorded = (
+  store: InMemorySessionStore
+): {store: InMemorySessionStore; calls: Array<Record<string, unknown>>} => {
+  const calls: Array<Record<string, unknown>> = [];
+  const listFor = store.listFor.bind(store);
+  store.listFor = (userId: string | number, options?: SessionListOptions): SessionSummary[] => {
+    calls.push({userId, options});
+    return listFor(userId, options);
+  };
+  return {store, calls};
+};
+
+// The interface as it shipped before listFor existed: a conforming store that cannot answer a list.
+const storeWithoutListFor: SessionStore = {
+  create: (sessionId, userId): ChatSession => ({sessionId, userId, entries: []}),
+  get: () => undefined,
+  delete: () => false,
+  count: () => 0,
+  clear: () => undefined,
+};
+
+// A turn parked mid-answer, so a frame sent while it runs can be told from one that queued behind it.
+const heldTurn = (gate: {until: Promise<void>}): ChatOrchestrator => ({
+  processMessage: async () => 'hi',
+  async *processMessageStream(): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'half'};
+    await gate.until;
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+});
+
+describe('a user conversation list over the websocket', () => {
+  // One logger for the whole file: a close arriving after a test is done must not log through the console.
+  const errorLines: Array<Record<string, unknown>> = [];
+
+  beforeAll(() => {
+    setLogger({
+      debug: () => undefined,
+      info: () => undefined,
+      warn: () => undefined,
+      error: (category, message, fields) => void errorLines.push({category, message, ...fields}),
+    });
+  });
+
+  beforeEach(() => {
+    errorLines.length = 0;
+  });
+
+  afterAll(() => setLogger());
+
+  // Settled after the stop, so a close lands here rather than logging after the tests are done.
+  afterEach(async () => {
+    await stopEngines();
+    for (let attempt = 0; attempt < 50; attempt++) await new Promise(resolve => setTimeout(resolve, 10));
+  });
+
+  const connect = async (url: string): Promise<{client: WebSocket; frames: Frame[]}> => {
+    const client = connectClient(url);
+    const frames: Frame[] = [];
+    client.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+    await once(client, 'open');
+    return {client, frames};
+  };
+
+  const ask = (client: WebSocket, frame: Frame): void => client.send(JSON.stringify(frame));
+
+  it("answers a list_conversations frame with the connecting user's conversations, newest first, times as ISO strings", async () => {
+    const store = new InMemorySessionStore();
+    seed(store, 'u1', ['hist-1', 'hist-2', 'hist-3']);
+    const expected = wireRows(store, 'u1');
+    const {store: asked, calls} = recorded(store);
+    const {url} = await startEngineWith({sessionStore: asked, history: {enabled: true}});
+    const {client, frames} = await connect(url);
+
+    ask(client, {type: 'list_conversations'});
+    await until('read the conversation_list', frames, () => frames.some(frame => frame.type === 'conversation_list'));
+
+    expect({
+      askedOf: calls,
+      seen: types(frames),
+      conversations: rowsOf(frames),
+    }).toEqual({
+      askedOf: [{userId: 'u1', options: {}}],
+      seen: ['connected', 'conversation_list'],
+      conversations: expected,
+    });
+  });
+
+  it('hands the store the limit and the before cursor the frame sent, and answers the page older than it', async () => {
+    const store = new InMemorySessionStore();
+    seed(store, 'u1', ['hist-1', 'hist-2', 'hist-3']);
+    const {store: asked, calls} = recorded(store);
+    const cursor = {updatedAt: AT(2000), sessionId: 'hist-2'};
+    const {url} = await startEngineWith({sessionStore: asked, history: {enabled: true}});
+    const {client, frames} = await connect(url);
+
+    ask(client, {type: 'list_conversations', limit: 2, before: cursor});
+    await until('read the conversation_list', frames, () => frames.some(frame => frame.type === 'conversation_list'));
+
+    expect({
+      askedOf: calls,
+      page: rowsOf(frames).map(row => row.sessionId),
+    }).toEqual({
+      askedOf: [{userId: 'u1', options: {limit: 2, before: cursor}}],
+      page: ['hist-1'],
+    });
+  });
+
+  it("answers a frame naming another user with the connection's own list, asking the store for the socket's user", async () => {
+    const store = new InMemorySessionStore();
+    seed(store, 'u1', ['hist-1', 'hist-2', 'hist-3']);
+    seed(store, 'u2', ['theirs']);
+    const expected = wireRows(store, 'u1');
+    const {store: asked, calls} = recorded(store);
+    const {url} = await startEngineWith({sessionStore: asked, history: {enabled: true}});
+    const {client, frames} = await connect(url);
+
+    ask(client, {type: 'list_conversations', userId: 'u2'});
+    await until('read the conversation_list', frames, () => frames.some(frame => frame.type === 'conversation_list'));
+
+    expect({
+      askedOf: calls,
+      conversations: rowsOf(frames),
+    }).toEqual({
+      askedOf: [{userId: 'u1', options: {}}],
+      conversations: expected,
+    });
+  });
+
+  it('answers UNSUPPORTED, and never a list, when the feature is off or the store cannot answer one', async () => {
+    const seeded = new InMemorySessionStore();
+    seed(seeded, 'u1', ['hist-1']);
+    const {url} = await startEngineWith({sessionStore: seeded});
+    const off = await connect(url);
+    ask(off.client, {type: 'list_conversations'});
+    await until('read the refusal', off.frames, () => off.frames.some(frame => frame.type === 'error'));
+
+    const {url: unlistableUrl} = await startEngineWith({sessionStore: storeWithoutListFor, history: {enabled: true}});
+    const unlistable = await connect(unlistableUrl);
+    ask(unlistable.client, {type: 'list_conversations'});
+    await until('read the second refusal', unlistable.frames, () =>
+      unlistable.frames.some(frame => frame.type === 'error')
+    );
+
+    expect({
+      featureOff: {seen: types(off.frames), code: off.frames.at(-1)?.code},
+      storeCannot: {seen: types(unlistable.frames), code: unlistable.frames.at(-1)?.code},
+    }).toEqual({
+      featureOff: {seen: ['connected', 'error'], code: 'UNSUPPORTED'},
+      storeCannot: {seen: ['connected', 'error'], code: 'UNSUPPORTED'},
+    });
+  });
+
+  it('answers UNSUPPORTED when the store refuses to list, as one built on a collection without find does', async () => {
+    const {url} = await startEngineWith({
+      sessionStore: new MongoSessionStore({collection: fakeCollection()}),
+      history: {enabled: true},
+    });
+    const {client, frames} = await connect(url);
+
+    ask(client, {type: 'list_conversations'});
+    await until('read the refusal', frames, () => frames.some(frame => frame.type === 'error'));
+
+    expect({seen: types(frames), code: frames.at(-1)?.code}).toEqual({
+      seen: ['connected', 'error'],
+      code: 'UNSUPPORTED',
+    });
+  });
+
+  it('answers SERVER_ERROR without store detail, keeps the socket open and logs the session id, when the store fails', async () => {
+    const store = new InMemorySessionStore();
+    seed(store, 'u1', ['hist-1']);
+    store.listFor = () => Promise.reject(new Error('history collection tenant-secret-9f3a unreachable'));
+
+    const {url} = await startEngineWith({sessionStore: store, history: {enabled: true}});
+    const {client, frames} = await connect(url);
+    const sessionId = String((frames[0] as {sessionId?: string})?.sessionId);
+
+    ask(client, {type: 'list_conversations'});
+    await until('read the error', frames, () => frames.some(frame => frame.type === 'error'));
+    const failure = frameOf(frames, 'error') as {code: string; message: string};
+
+    ask(client, {type: 'ping', timestamp: 4242});
+    await until('read the pong', frames, () => frames.some(frame => frame.type === 'pong'));
+
+    expect({
+      seen: types(frames),
+      code: failure.code,
+      leaksStoreDetail: failure.message.includes('tenant-secret-9f3a'),
+      loggedSessionId: errorLines.some(line => JSON.stringify(line).includes(sessionId)),
+      userContentInLog: errorLines.filter(line => JSON.stringify(line).includes('planted-conversation-text-9f3a'))
+        .length,
+      pong: (frameOf(frames, 'pong') as {timestamp?: number}).timestamp,
+    }).toEqual({
+      seen: ['connected', 'error', 'pong'],
+      code: 'SERVER_ERROR',
+      leaksStoreDetail: false,
+      loggedSessionId: true,
+      userContentInLog: 0,
+      pong: 4242,
+    });
+  });
+
+  it('answers a list request while a turn is streaming, without waiting on the turn', async () => {
+    const store = new InMemorySessionStore();
+    seed(store, 'u1', ['hist-1']);
+    const gate = deferred();
+    const {url} = await startEngineWith({
+      sessionStore: store,
+      history: {enabled: true},
+      orchestrator: heldTurn(gate),
+    });
+    const {client, frames} = await connect(url);
+
+    try {
+      ask(client, {type: 'user_message', content: 'hello'});
+      await until('the answer to start', frames, () => frames.some(frame => frame.type === 'entry_delta'));
+
+      ask(client, {type: 'list_conversations'});
+      await until('read the list mid-turn', frames, () => frames.some(frame => frame.type === 'conversation_list'));
+
+      gate.release();
+      await until('the turn to end', frames, () => frames.some(frame => frame.type === 'stream_end'));
+
+      expect(types(frames)).toEqual([
+        'connected',
+        'entry_upsert',
+        'entry_upsert',
+        'entry_delta',
+        'conversation_list',
+        'entry_commit',
+        'stream_end',
+      ]);
+    } finally {
+      gate.release();
+    }
+  });
+});
+
+describe('the list_conversations frame at the validator', () => {
+  const CURSOR = {updatedAt: '2026-03-01T00:00:00.000Z', sessionId: 'hist-1'};
+
+  it('accepts the frame with its paging fields, and refuses a limit or before that breaks the rules, naming the field', () => {
+    expect(validateMessage({type: 'list_conversations'})).toEqual({valid: true, data: {type: 'list_conversations'}});
+    expect(validateMessage({type: 'list_conversations', limit: 1, before: CURSOR})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations', limit: 1, before: CURSOR},
+    });
+    expect(validateMessage({type: 'list_conversations', limit: 200})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations', limit: 200},
+    });
+
+    const refused: Array<[string, unknown, string]> = [
+      ['a limit of 0', {type: 'list_conversations', limit: 0}, 'limit'],
+      ['a limit of 201', {type: 'list_conversations', limit: 201}, 'limit'],
+      ['a fractional limit', {type: 'list_conversations', limit: 1.5}, 'limit'],
+      ['a limit that is a string', {type: 'list_conversations', limit: '10'}, 'limit'],
+      ['a before that is no date', {type: 'list_conversations', before: 'not a date'}, 'before'],
+      ['a before with no moment', {type: 'list_conversations', before: {sessionId: 'hist-1'}}, 'before'],
+      [
+        'a before with no session id',
+        {type: 'list_conversations', before: {updatedAt: '2026-03-01T00:00:00.000Z'}},
+        'before',
+      ],
+    ];
+
+    for (const [name, frame, field] of refused) {
+      const result = validateMessage(frame);
+      expect({case: name, verdict: result.valid, says: result.valid ? '' : result.error}).toEqual({
+        case: name,
+        verdict: false,
+        says: expect.stringContaining(field),
+      });
+    }
+  });
+});