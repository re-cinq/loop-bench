@@ -0,0 +1,438 @@
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import type {Express} from 'express';
+import {createServer} from './createServer.js';
+import type {HalServer} from './createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+import type {SessionResumeOptions} from './ws/sessionResume.js';
+import {answeringOrchestrator, deferred} from './wsTestSupport.js';
+import type {ChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import type {MessageChunk} from '../types/ai.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {fiveMemberStore} from '../infrastructure/stores/sessionStoreTestSupport.js';
+import {setLogger} from '../shared/logger.js';
+import type {SessionListOptions, SessionStore, SessionSummary} from '../types/sessionStore.js';
+
+// Real upgrades over a real socket: what a client is sent is the contract, and no double can observe it.
+
+type CannotList = new (message: string) => Error;
+// A consumer marks a store that cannot list with the engine's own class, so the handler can tell that
+// refusal from a store that failed. Looked up at run time: the class does not exist until the build adds it.
+const cannotListOf = async (): Promise<CannotList> => {
+  const storePort = (await import('../types/sessionStore.js')) as unknown as {StoreCannotList: CannotList};
+  return storePort.StoreCannotList;
+};
+
+// Far past any run, so the seeds' activity is theirs alone and no wall clock takes part in the order.
+const OLDEST = '3000-01-01T00:00:00.000Z';
+const MIDDLE = '3000-01-02T00:00:00.000Z';
+const NEWEST = '3000-01-03T00:00:00.000Z';
+const SUMMARY_FIELDS = ['createdAt', 'entryCount', 'sessionId', 'updatedAt'];
+const USER_CONTENT = 'a phrase no log may carry';
+const STORE_FAILURE = 'listFor failed: mongodb://db-1.internal:27017 timed out';
+
+interface Row {
+  sessionId?: string;
+  createdAt?: unknown;
+  updatedAt?: unknown;
+  entryCount?: unknown;
+}
+
+interface Wire {
+  type: string;
+  code?: string;
+  message?: string;
+  sessionId?: string;
+  resumed?: boolean;
+  index?: number;
+  entry?: {role?: string; content?: string};
+  conversations?: Row[];
+}
+
+interface LoggedLine {
+  severity: string;
+  message: string;
+  fields?: Record<string, unknown>;
+}
+
+const logged: LoggedLine[] = [];
+
+beforeEach(() => {
+  logged.length = 0;
+  setLogger({
+    debug: (_category, message) => void logged.push({severity: 'debug', message}),
+    info: (_category, message) => void logged.push({severity: 'info', message}),
+    warn: (_category, message) => void logged.push({severity: 'warn', message}),
+    error: (_category, message, fields) => void logged.push({severity: 'error', message, fields}),
+  });
+});
+
+const servers: HalServer[] = [];
+const clients: WebSocket[] = [];
+
+const eventually = async (check: () => boolean): Promise<void> => {
+  for (let attempt = 0; attempt < 50 && !check(); attempt++) await new Promise(resolve => setTimeout(resolve, 10));
+};
+
+afterEach(async () => {
+  for (const client of clients.splice(0)) client.terminate();
+  for (const hal of servers.splice(0)) {
+    await eventually(() => hal.wss.clients.size === 0);
+    await hal.stop();
+  }
+  setLogger();
+});
+
+class RecordingStore extends InMemorySessionStore {
+  readonly listed: Array<{userId: string | number; options: SessionListOptions}> = [];
+
+  override listFor(userId: string | number, options?: SessionListOptions): SessionSummary[] {
+    // The window as the store saw it: an omitted argument and one of undefined fields are the same call.
+    this.listed.push({userId, options: options ?? {limit: undefined, before: undefined}});
+    return super.listFor(userId, options);
+  }
+}
+
+class RefusingStore extends InMemorySessionStore {
+  readonly refusal: Error;
+
+  constructor(refusal: Error) {
+    super();
+    this.refusal = refusal;
+  }
+
+  override listFor(): SessionSummary[] {
+    throw this.refusal;
+  }
+}
+
+class FailingStore extends InMemorySessionStore {
+  override listFor(): Promise<SessionSummary[]> {
+    return Promise.reject(new Error(STORE_FAILURE));
+  }
+}
+
+// Entries stamped in the far future make each conversation's activity its own, whatever the wall clock.
+const seed = (
+  store: InMemorySessionStore,
+  sessionId: string,
+  userId: string,
+  entryCount: number,
+  activeAt: string
+): void => {
+  const {entries} = store.create(sessionId, userId);
+  for (let entry = 0; entry < entryCount; entry++) {
+    entries.push({role: 'user', content: `${sessionId} entry ${entry}`, timestamp: activeAt});
+  }
+};
+
+const startEngine = async (
+  store: SessionStore,
+  transport: {history?: {enabled: boolean}; resume?: SessionResumeOptions} = {},
+  orchestrator: ChatOrchestrator = answeringOrchestrator
+): Promise<string> => {
+  const hal = createServer({
+    app: (() => undefined) as unknown as Express,
+    wsAuth: async () => ({id: 'u1'}),
+    sessionStore: store,
+    orchestrator,
+    ...transport,
+  });
+  await hal.start(0);
+  servers.push(hal);
+  const {port} = hal.server.address() as AddressInfo;
+  return `ws://127.0.0.1:${port}/hal/ws`;
+};
+
+const open = (url: string): WebSocket => {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 't']);
+  clients.push(client);
+  return client;
+};
+
+// Records every frame the client is sent, and resolves once the next frame of one of the types arrives.
+const wire = (client: WebSocket): {seen: Wire[]; once: (...types: string[]) => Promise<void>} => {
+  const seen: Wire[] = [];
+  client.on('message', raw => void seen.push(JSON.parse(String(raw)) as Wire));
+  const once = (...types: string[]): Promise<void> =>
+    new Promise(resolve => {
+      const arrival = (raw: Buffer): void => {
+        if (!types.includes((JSON.parse(String(raw)) as Wire).type)) return;
+        client.off('message', arrival);
+        resolve();
+      };
+      client.on('message', arrival);
+    });
+  return {seen, once};
+};
+
+const pause = (ms: number): Promise<void> => new Promise(resolve => setTimeout(resolve, ms));
+const settle = async (): Promise<void> => pause(50);
+// Bounds a wait for an answer the engine owes, so a missing one reads as the frames that did arrive.
+const answerWithin = (wait: Promise<void>): Promise<void> => Promise.race([wait, pause(1500)]);
+
+const iso = (value: unknown): boolean => typeof value === 'string' && new Date(value).toISOString() === value;
+
+describe('the conversation list over the websocket', () => {
+  it('accepts a list_conversations frame with no user id and refuses an unreadable window naming the field', () => {
+    const verdictOf = (payload: Record<string, unknown>): unknown => {
+      const result = validateMessage({type: 'list_conversations', ...payload});
+      return result.valid ? result.data : result.error;
+    };
+
+    expect({
+      bare: verdictOf({}),
+      completeWindow: verdictOf({limit: 200, before: {updatedAt: NEWEST, sessionId: 's1'}}),
+      anotherUsersIdDropped: verdictOf({userId: 'u2'}),
+      limitZero: verdictOf({limit: 0}),
+      limitAbove: verdictOf({limit: 201}),
+      limitFractional: verdictOf({limit: 1.5}),
+      limitAsText: verdictOf({limit: '10'}),
+      beforeUnreadable: verdictOf({before: 'not a date'}),
+      beforeWithoutId: verdictOf({before: {updatedAt: NEWEST}}),
+      beforeWithoutTime: verdictOf({before: {sessionId: 's1'}}),
+    }).toEqual({
+      bare: {type: 'list_conversations'},
+      completeWindow: {type: 'list_conversations', limit: 200, before: {updatedAt: NEWEST, sessionId: 's1'}},
+      anotherUsersIdDropped: {type: 'list_conversations'},
+      limitZero: expect.stringContaining('limit'),
+      limitAbove: expect.stringContaining('limit'),
+      limitFractional: expect.stringContaining('limit'),
+      limitAsText: expect.stringContaining('limit'),
+      beforeUnreadable: expect.stringContaining('before'),
+      beforeWithoutId: expect.stringContaining('before'),
+      beforeWithoutTime: expect.stringContaining('before'),
+    });
+  });
+
+  it('answers one conversation_list of the connections own conversations and passes its window through to the store', async () => {
+    const store = new RecordingStore();
+    seed(store, 's1', 'u1', 1, OLDEST);
+    seed(store, 's2', 'u1', 2, MIDDLE);
+    seed(store, 's3', 'u1', 3, NEWEST);
+    const base = await startEngine(store, {history: {enabled: true}});
+    const client = open(base);
+    const {seen, once} = wire(client);
+    await once('connected');
+    const liveId = seen[0]?.sessionId ?? '';
+
+    client.send(JSON.stringify({type: 'list_conversations'}));
+    await answerWithin(once('conversation_list'));
+    const firstPage = seen[1]?.conversations ?? [];
+
+    const resumeFrom = firstPage[1];
+    client.send(
+      JSON.stringify({
+        type: 'list_conversations',
+        limit: 2,
+        before: {updatedAt: resumeFrom?.updatedAt, sessionId: resumeFrom?.sessionId},
+      })
+    );
+    await answerWithin(once('conversation_list'));
+    await settle();
+    const secondPage = seen.at(-1)?.conversations ?? [];
+
+    expect({
+      answered: seen.map(frame => frame.type),
+      rows: firstPage.map(row => [row.sessionId, row.entryCount, Object.keys(row).sort(), row.updatedAt]),
+      isoTimes: firstPage.every(row => iso(row.createdAt) && iso(row.updatedAt)),
+      olderPage: secondPage.map(row => row.sessionId),
+      calls: store.listed,
+    }).toEqual({
+      answered: ['connected', 'conversation_list', 'conversation_list'],
+      rows: [
+        [liveId, 0, SUMMARY_FIELDS, expect.any(String)],
+        ['s3', 3, SUMMARY_FIELDS, NEWEST],
+        ['s2', 2, SUMMARY_FIELDS, MIDDLE],
+        ['s1', 1, SUMMARY_FIELDS, OLDEST],
+      ],
+      isoTimes: true,
+      olderPage: ['s2', 's1'],
+      calls: [
+        {userId: 'u1', options: {limit: undefined, before: undefined}},
+        {userId: 'u1', options: {limit: 2, before: {updatedAt: NEWEST, sessionId: 's3'}}},
+      ],
+    });
+  });
+
+  it('answers with the connecting users own list when the frame names another user', async () => {
+    const store = new RecordingStore();
+    seed(store, 's1', 'u1', 1, OLDEST);
+    seed(store, 's2', 'u1', 2, MIDDLE);
+    seed(store, 'rival', 'u2', 4, NEWEST);
+    const base = await startEngine(store, {history: {enabled: true}, resume: {enabled: true, latest: true}});
+    const client = open(base);
+    const {seen, once} = wire(client);
+    await once('connected');
+    client.send(JSON.stringify({type: 'list_conversations', userId: 'u2'}));
+    await answerWithin(once('conversation_list'));
+    await settle();
+
+    expect({
+      rows: (seen.at(-1)?.conversations ?? []).map(row => row.sessionId),
+      askedAbout: store.listed.map(call => call.userId),
+    }).toEqual({
+      rows: ['s2', 's1'],
+      askedAbout: ['u1'],
+    });
+  });
+
+  it('refuses a list_conversations frame with UNSUPPORTED and no list while the feature is off', async () => {
+    const store = new RecordingStore();
+    seed(store, 's1', 'u1', 1, OLDEST);
+    const base = await startEngine(store);
+    const client = open(base);
+    const {seen, once} = wire(client);
+    await once('connected');
+    client.send(JSON.stringify({type: 'list_conversations'}));
+    await once('error');
+    await settle();
+
+    expect({
+      answered: seen.map(frame => frame.type),
+      code: seen.find(frame => frame.type === 'error')?.code,
+      asked: store.listed.length,
+    }).toEqual({
+      answered: ['connected', 'error'],
+      code: 'UNSUPPORTED',
+      asked: 0,
+    });
+  });
+
+  const answerOf = async (store: SessionStore): Promise<{answered: string[]; code: string | undefined}> => {
+    const base = await startEngine(store, {history: {enabled: true}});
+    const client = open(base);
+    const {seen, once} = wire(client);
+    await once('connected');
+    client.send(JSON.stringify({type: 'list_conversations'}));
+    await once('error');
+    await settle();
+    return {answered: seen.map(frame => frame.type), code: seen.find(frame => frame.type === 'error')?.code};
+  };
+
+  it('answers UNSUPPORTED when the store cannot list, rather than an empty list', async () => {
+    const StoreCannotList = await cannotListOf();
+    const refusing = new RefusingStore(new StoreCannotList('this store cannot list conversations'));
+
+    expect({
+      withoutMember: await answerOf(fiveMemberStore),
