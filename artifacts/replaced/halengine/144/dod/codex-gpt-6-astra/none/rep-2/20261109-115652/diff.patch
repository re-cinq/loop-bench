+// spec: specs/hal-engine-conversation-list/spec.md#38
+it('distinguishes disabled or unavailable history from store failures without closing or leaking', async () => {
+  const inner = new InMemorySessionStore();
+  const mongoClient = new MongoClient('mongodb://127.0.0.1:27017');
+  await mongoClient.close();
+  const collection = mongoClient.db('history').collection<MongoSessionDocument>('sessions');
+  const legacyCollection: CollectionLike<MongoSessionDocument> = {
+    findOne: collection.findOne.bind(collection),
+    updateOne: collection.updateOne.bind(collection),
+    deleteOne: collection.deleteOne.bind(collection),
+    deleteMany: collection.deleteMany.bind(collection),
+    countDocuments: collection.countDocuments.bind(collection),
+  };
+  const unavailable = new MongoSessionStore({collection: legacyCollection});
+  const failed = new MongoSessionStore({collection});
+  const cases = [
+    {name: 'default off', store: inner, history: undefined, code: 'UNSUPPORTED'},
+    {name: 'explicit off', store: inner, history: {enabled: false}, code: 'UNSUPPORTED'},
+    {name: 'no listFor', store: requiredMembers(inner), history: {enabled: true}, code: 'UNSUPPORTED'},
+    {
+      name: 'no find',
+      store: {...requiredMembers(inner), listFor: unavailable.listFor.bind(unavailable)},
+      history: {enabled: true},
+      code: 'UNSUPPORTED',
+    },
+    {
+      name: 'closed database',
+      store: {...requiredMembers(inner), listFor: failed.listFor.bind(failed)},
+      history: {enabled: true},
+      code: 'SERVER_ERROR',
+    },
+  ];
+  const outcomes: unknown[] = [];
+  let failedSession: string | undefined;
+  for (const scenario of cases) {
+    const client = await connect(await start(scenario.store, scenario.history));
+    const replies = await client.request({type: 'list_conversations'});
+    if (scenario.code === 'SERVER_ERROR') failedSession = client.frames[0].sessionId;
+    outcomes.push({name: scenario.name, replies, open: client.socket.readyState});
+  }
+  expect(outcomes).toEqual(
+    cases.map(({name, code}) => ({
+      name,
+      replies: [{type: 'error', code, message: expect.any(String)}],
+      open: WebSocket.OPEN,
+    }))
+  );
+  const failure = (outcomes.at(-1) as {replies: Frame[]}).replies[0];
+  expect(failure.message).not.toMatch(/Mongo|closed|127\.0\.0\.1|find|collection/i);
+  expect(logs.some(line => line.level === 'error' && line.fields?.sessionId === failedSession)).toBe(true);
+  expect(JSON.stringify(logs)).not.toContain('acceptance-credential');
+  const cannotList = Reflect.get(publicApi, 'StoreCannotList') as new (...args: never[]) => Error;
+  expect(typeof cannotList).toBe('function');
+  await expect(unavailable.listFor('owner')).rejects.toBeInstanceOf(cannotList);
+  const warningOffset = logs.length;
+  const withoutResume = await connect(await start(inner, {enabled: true}, undefined, false));
+  expect(Object.keys(withoutResume.frames[0]).sort()).toEqual(['examplePrompts', 'message', 'sessionId', 'type']);
+  expect(
+    logs
+      .slice(warningOffset)
+      .some(
+        line => line.level === 'warn' && /history/i.test(JSON.stringify(line)) && /resume/i.test(JSON.stringify(line))
+      )
+  ).toBe(true);
+});
