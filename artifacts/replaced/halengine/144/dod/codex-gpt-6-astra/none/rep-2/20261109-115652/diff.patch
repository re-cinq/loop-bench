+// spec: specs/hal-engine-conversation-list/spec.md#39
+it('answers a history request while a real user turn still holds the session lock', async () => {
+  let release!: () => void;
+  const held = new Promise<void>(resolve => {
+    release = resolve;
+  });
+  let entered = false;
+  const base = await start(
+    new InMemorySessionStore(),
+    {enabled: true},
+    {
+      hooks: {
+        beforeModelResponse: async () => {
+          entered = true;
+          await held;
+          throw new Error('Consumer veto after the history observation');
+        },
+      },
+    }
+  );
+  const client = await connect(base);
+  try {
+    client.socket.send(JSON.stringify({type: 'user_message', content: 'private user content'}));
+    await until(() => entered && client.frames.some(frame => frame.type === 'entry_upsert'));
+    const replies = await client.request({type: 'list_conversations'});
+    expect(replies).toEqual([
+      {
+        type: 'conversation_list',
+        conversations: [
+          expect.objectContaining({
+            sessionId: client.frames[0].sessionId,
+            entryCount: 1,
+          }),
+        ],
+      },
+    ]);
+    expect(client.frames.some(frame => frame.type === 'stream_end')).toBe(false);
+  } finally {
+    release();
+    await until(() => client.frames.some(frame => frame.type === 'stream_end'));
+  }
+  expect(client.frames.findIndex(frame => frame.type === 'conversation_list')).toBeLessThan(
+    client.frames.findIndex(frame => frame.type === 'stream_end')
+  );
+  client.socket.close();
+  await once(client.socket, 'close');
+});