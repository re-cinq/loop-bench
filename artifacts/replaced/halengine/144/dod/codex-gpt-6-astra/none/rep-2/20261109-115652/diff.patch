+
+## 14. Conversation history (#144)
+
+### Client frame
+
+| Field              | Type    | Required      | Description                                                                  |
+| ------------------ | ------- | ------------- | ---------------------------------------------------------------------------- |
+| `type`             | string  | Yes           | `list_conversations`                                                         |
+| `limit`            | integer | No            | From 1 through 200                                                           |
+| `before`           | object  | No            | Composite cursor with `updatedAt` and `sessionId`                            |
+| `before.updatedAt` | string  | With `before` | A date accepted by `Date.parse`, carried as an ISO string by a paging client |
+| `before.sessionId` | string  | With `before` | Tie-breaking session identifier from the last row                            |
+
+- Validation accepts `list_conversations` independently of configuration, strips undeclared fields including `userId`, accepts only integer limits 1–200 and complete string-valued cursors with a parseable date, and refuses malformed fields with an error naming the field while preserving existing message literals ([validated by: validates history limits and complete wire cursors without changing existing frames](../../src/transport/conversationList.acceptance.test.ts#L96)).
+
+### Server frame
+
+| Field                        | Type                  | Description                 |
+| ---------------------------- | --------------------- | --------------------------- |
+| `type`                       | string                | `conversation_list`         |
+| `conversations`              | ConversationSummary[] | The requested page          |
+| `conversations[].sessionId`  | string                | Identifier usable by resume |
+| `conversations[].createdAt`  | string                | ISO creation time           |
+| `conversations[].updatedAt`  | string                | ISO activity time           |
+| `conversations[].entryCount` | number                | Number of stored entries    |
+
+The authorization, opt-in, paging, errors and concurrency contract is specified in [Conversation List](../hal-engine-conversation-list/spec.md#websocket-delivery-144).
diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..4521c2d
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,321 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {MongoClient} from 'mongodb';
+import {WebSocket} from 'ws';
+import {createHalEngine} from '../config.js';
+import * as publicApi from '../index.js';
+import type {HalEngineConfig} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {MongoSessionStore} from '../infrastructure/stores/mongo/mongoSessionStore.js';
+import type {CollectionLike} from '../infrastructure/stores/mongo/mongoDriverTypes.js';
+import type {MongoSessionDocument} from '../infrastructure/stores/mongo/mongoSessionDocument.js';
+import type {SessionStore, SessionListOptions} from '../types/sessionStore.js';
+import type {IncomingMessage, OutgoingMessage} from '../types/messages.js';
+import {setLogger} from '../shared/logger.js';
+import {validateMessage} from './ws/validation.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+
+type Row = {sessionId: string; createdAt: string; updatedAt: string; entryCount: number};
+type Frame = {type: string; conversations?: Row[]; sessionId?: string; [key: string]: unknown};
+const engines: Array<ReturnType<typeof createHalEngine>> = [];
+const sockets: WebSocket[] = [];
+const logs: Array<{level: string; fields?: Record<string, unknown>; message: string}> = [];
+
+beforeEach(() => {
+  logs.length = 0;
+  const record = (level: string) => (_category: string, message: string, fields?: Record<string, unknown>) => {
+    logs.push({level, message, fields});
+  };
+  setLogger({debug: record('debug'), info: record('info'), warn: record('warn'), error: record('error')});
+});
+
+afterEach(async () => {
+  for (const socket of sockets.splice(0)) socket.terminate();
+  for (const engine of engines.splice(0)) {
+    await until(() => engine.wss.clients.size === 0);
+    await engine.stop();
+  }
+  setLogger();
+});
+
+async function until(check: () => boolean): Promise<void> {
+  const deadline = Date.now() + 2000;
+  while (!check() && Date.now() < deadline) await new Promise(resolve => setTimeout(resolve, 5));
+  expect(check()).toBe(true);
+}
+
+async function start(
+  store: SessionStore,
+  history?: {enabled: boolean},
+  hooks?: HalEngineConfig['orchestrator'],
+  resumeEnabled = true
+) {
+  const transport = {port: 0, resume: resumeEnabled ? {enabled: true} : undefined, history};
+  const engine = createHalEngine({
+    provider: {type: 'bedrock', region: 'eu-west-1', modelId: 'unused', maxTokens: 1},
+    prompt: {identity: 'Conversation history acceptance'},
+    auth: {ws: () => ({id: 'owner'})},
+    session: store,
+    transport,
+    orchestrator: hooks,
+  });
+  engines.push(engine);
+  await engine.start();
+  return `ws://127.0.0.1:${(engine.server.address() as AddressInfo).port}/hal/ws`;
+}
+
+async function connect(url: string) {
+  const socket = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'acceptance-credential']);
+  sockets.push(socket);
+  const frames: Frame[] = [];
+  socket.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  await until(() => frames.some(frame => frame.type === 'connected'));
+  async function request(payload: unknown): Promise<Frame[]> {
+    const offset = frames.length;
+    socket.send(JSON.stringify(payload));
+    await until(() => frames.length > offset);
+    const timestamp = Date.now();
+    socket.send(JSON.stringify({type: 'ping', timestamp}));
+    await until(() => frames.some(frame => frame.type === 'pong' && frame.timestamp === timestamp));
+    return frames.slice(offset).filter(frame => frame.type !== 'pong');
+  }
+  return {socket, frames, request};
+}
+
+function requiredMembers(inner: InMemorySessionStore): SessionStore {
+  return {
+    create: (id, user, options) => inner.create(id, user, options),
+    get: id => inner.get(id),
+    delete: id => inner.delete(id),
+    count: () => inner.count(),
+    clear: () => inner.clear(),
+  };
+}
+
+// spec: specs/hal-engine-websocket-protocol/spec.md#214
+it('validates history limits and complete wire cursors without changing existing frames', () => {
+  const before = {updatedAt: '2026-10-01T00:00:00.000Z', sessionId: 'conversation'};
+  for (const fields of [{}, {limit: 1}, {limit: 200, before}]) {
+    expect(validateMessage({type: 'list_conversations', ...fields, userId: 'stranger'})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations', ...fields},
+    });
+  }
+  for (const limit of [0, 201, 1.5, '10', null]) {
+    expect(validateMessage({type: 'list_conversations', limit})).toEqual({
+      valid: false,
+      error: expect.stringMatching(/limit/i),
+    });
+  }
+  for (const cursor of [
+    'not a date',
+    before.updatedAt,
+    {},
+    {updatedAt: before.updatedAt},
+    {sessionId: 'c'},
+    {updatedAt: 'not a date', sessionId: 'c'},
+    {updatedAt: 123, sessionId: 'c'},
+    {updatedAt: before.updatedAt, sessionId: 1},
+    null,
+  ]) {
+    expect(validateMessage({type: 'list_conversations', before: cursor})).toEqual({
+      valid: false,
+      error: expect.stringMatching(/before/i),
+    });
+  }
+  const incoming: IncomingMessage[] = [
+    {type: 'user_message', content: 'hello'},
+    {type: 'ping', timestamp: 1},
+  ];
+  for (const data of incoming) expect(validateMessage(data)).toEqual({valid: true, data});
+  const outgoing: OutgoingMessage[] = [
+    {type: 'connected', sessionId: 'c', message: 'hi', examplePrompts: []},
+    {type: 'entry_upsert', index: 0, entry: {role: 'user', content: 'hi', timestamp: before.updatedAt}},
+    {type: 'entry_delta', index: 1, delta: 'hi'},
+    {type: 'entry_commit', index: 1},
+    {type: 'entry_skip', index: 2},
+    {type: 'error', code: 'SERVER_ERROR', message: 'failed'},
+    {type: 'pong', timestamp: 1},
+    {type: 'stream_end'},
+  ];
+  expect(JSON.parse(JSON.stringify(outgoing))).toEqual(outgoing);
+});
+
+// spec: specs/hal-engine-conversation-list/spec.md#37
+it('lists only the socket owner on request and pages resumable metadata without dropping ties', async () => {
+  const inner = new InMemorySessionStore();
+  const activity = new Date(Date.now() + 60_000).toISOString();
+  for (const [id, user] of [
+    ['a', 'owner'],
+    ['b', 'owner'],
+    ['c', 'owner'],
+    ['private', 'stranger'],
+  ]) {
+    inner.create(id, user, {authHeaders: {authorization: 'secret'}}).entries.push({
+      role: 'user',
+      content: `private content ${id}`,
+      timestamp: activity,
+    });
+  }
+  const calls: Array<{user: string | number; options?: SessionListOptions}> = [];
+  const store: SessionStore = {
+    ...requiredMembers(inner),
+    listFor: (user, options) => {
+      calls.push({user, options});
+      return inner.listFor(user, options);
+    },
+  };
