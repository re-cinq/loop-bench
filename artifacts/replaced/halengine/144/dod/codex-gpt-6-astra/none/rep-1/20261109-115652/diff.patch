diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..f231e3b
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,232 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import {MongoClient} from 'mongodb';
+import {createHalEngine} from '../config.js';
+import type {HalEngineConfig} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {MongoSessionStore} from '../infrastructure/stores/mongo/mongoSessionStore.js';
+import type {MongoSessionDocument} from '../infrastructure/stores/mongo/mongoSessionDocument.js';
+import type {SessionStore, SessionListOptions} from '../types/sessionStore.js';
+import {captureErrors} from '../shared/logCaptureTestSupport.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+
+type Frame = Record<string, unknown> & {type: string};
+const engines: ReturnType<typeof createHalEngine>[] = [];
+const sockets: WebSocket[] = [];
+const at = '2099-01-01T00:00:00.000Z';
+
+const requiredMembers = (store: InMemorySessionStore): SessionStore => ({
+  create: store.create.bind(store),
+  get: store.get.bind(store),
+  delete: store.delete.bind(store),
+  count: store.count.bind(store),
+  clear: store.clear.bind(store),
+});
+
+async function start(session: SessionStore, history?: {enabled: boolean}, hooks?: HalEngineConfig['orchestrator']) {
+  const transport = {history, resume: {enabled: true}};
+  const engine = createHalEngine({
+    session,
+    transport,
+    provider: {type: 'mock'},
+    prompt: {identity: 'Conversation list acceptance'},
+    auth: {ws: async () => ({id: 'owner'})},
+    orchestrator: hooks,
+  });
+  engines.push(engine);
+  await engine.start(0);
+  const {port} = engine.server.address() as AddressInfo;
+  return `ws://127.0.0.1:${port}/hal/ws`;
+}
+
+async function connect(url: string) {
+  const socket = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'credential']);
+  sockets.push(socket);
+  const frames: Frame[] = [];
+  socket.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  await once(socket, 'message');
+  return {socket, frames};
+}
+
+async function until(check: () => boolean) {
+  for (let n = 0; n < 200 && !check(); n++) await new Promise(resolve => setTimeout(resolve, 5));
+  expect(check()).toBe(true);
+}
+
+async function request(client: Awaited<ReturnType<typeof connect>>, payload: object) {
+  const offset = client.frames.length;
+  client.socket.send(JSON.stringify(payload));
+  await until(() => client.frames.slice(offset).some(frame => ['error', 'conversation_list'].includes(frame.type)));
+  client.socket.send(JSON.stringify({type: 'ping', timestamp: offset}));
+  await until(() => client.frames.slice(offset).some(frame => frame.type === 'pong'));
+  return client.frames.slice(offset).filter(frame => frame.type !== 'pong');
+}
+
+afterEach(async () => {
+  for (const socket of sockets.splice(0)) socket.terminate();
+  for (const engine of engines.splice(0)) {
+    await until(() => engine.wss.clients.size === 0);
+    await engine.stop();
+  }
+});
+
+const errors = captureErrors();
+
+// spec: specs/hal-engine-conversation-list/spec.md#37
+it('validates list requests and composite cursors without accepting malformed paging fields', () => {
+  for (const fields of [{}, {limit: 1}, {limit: 200}, {before: {updatedAt: at, sessionId: 'b'}}]) {
+    const frame = {type: 'list_conversations', ...fields};
+    expect(validateMessage({...frame, userId: 'stranger'})).toEqual({valid: true, data: frame});
+  }
+  for (const [field, values] of Object.entries({
+    limit: [0, 201, 1.5, '10', null],
+    before: ['not a date', at, null, {}, {updatedAt: at}, {sessionId: 'b'}, {updatedAt: 'bad', sessionId: 'b'}],
+  })) {
+    for (const value of values) {
+      expect(validateMessage({type: 'list_conversations', [field]: value})).toEqual({
+        valid: false,
+        error: expect.stringMatching(new RegExp(field, 'i')),
+      });
+    }
+  }
+});
+
+// spec: specs/hal-engine-conversation-list/spec.md#38
+it('lists only the socket owner with ISO metadata, pages ties and resumes a listed conversation', async () => {
+  const inner = new InMemorySessionStore();
+  for (const id of ['a', 'b']) {
+    inner.create(id, 'owner', {authHeaders: {authorization: 'private'}}).entries.push({
+      role: 'user',
+      content: `private ${id}`,
+      timestamp: at,
+    });
+  }
+  inner.create('stranger-session', 'stranger');
+  const calls: Array<[string | number, SessionListOptions | undefined]> = [];
+  const store: SessionStore = {
+    ...requiredMembers(inner),
+    listFor: (userId, options) => {
+      calls.push([userId, options]);
+      return inner.listFor(userId, options);
+    },
+  };
+  const base = await start(store, {enabled: true});
+  const client = await connect(base);
+  expect(client.frames.map(frame => frame.type)).toEqual(['connected']);
+  const expected = JSON.parse(JSON.stringify(inner.listFor('owner'))) as Array<Record<string, unknown>>;
+  const result = await request(client, {type: 'list_conversations', userId: 'stranger'});
+  expect(result).toEqual([{type: 'conversation_list', conversations: expected}]);
+  expect(expected).toHaveLength(3);
+  expect(calls).toEqual([['owner', {limit: undefined, before: undefined}]]);
+  for (const row of expected) {
+    expect(Object.keys(row).sort()).toEqual(['createdAt', 'entryCount', 'sessionId', 'updatedAt']);
+    for (const key of ['createdAt', 'updatedAt']) expect(new Date(String(row[key])).toISOString()).toBe(row[key]);
+  }
+  expect(expected.map(row => row.sessionId)).toEqual(['b', 'a', client.frames[0].sessionId]);
+  expect(await request(client, {type: 'list_conversations', limit: 1})).toEqual([
+    {type: 'conversation_list', conversations: [expected[0]]},
+  ]);
+  const before = {updatedAt: at, sessionId: 'b'};
+  expect(await request(client, {type: 'list_conversations', limit: 1, before})).toEqual([
+    {type: 'conversation_list', conversations: [expected[1]]},
+  ]);
+  expect(calls.slice(1)).toEqual([
+    ['owner', {limit: 1, before: undefined}],
+    ['owner', {limit: 1, before}],
+  ]);
+  const resumed = await connect(`${base}?sessionId=${String(expected[0].sessionId)}`);
+  resumed.socket.send(JSON.stringify({type: 'ping', timestamp: 1}));
+  await until(() => resumed.frames.some(frame => frame.type === 'pong'));
+  expect(resumed.frames[0]).toMatchObject({resumed: true, sessionId: 'b', entryCount: 1});
+  expect(resumed.frames.slice(1)).toEqual([
+    {type: 'entry_upsert', index: 0, entry: {role: 'user', content: 'private b', timestamp: at}},
+    {type: 'pong', timestamp: 1},
+  ]);
+});
+
+// spec: specs/hal-engine-conversation-list/spec.md#39
+it('answers UNSUPPORTED when history is off or the store cannot list', async () => {
+  const inner = new InMemorySessionStore();
+  const driver = new MongoClient('mongodb://127.0.0.1:27017');
+  const collection = driver.db('acceptance').collection<MongoSessionDocument>('sessions');
+  const legacyCollection = {
+    findOne: collection.findOne.bind(collection),
+    updateOne: collection.updateOne.bind(collection),
