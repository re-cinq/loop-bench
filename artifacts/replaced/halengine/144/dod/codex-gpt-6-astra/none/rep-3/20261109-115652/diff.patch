+  // @spec specs/hal-engine-conversation-list/spec.md#39
+  it('reports unsupported history and store failures as errors without closing the socket or exposing details', async () => {
+    const inner = new InMemorySessionStore();
+    inner.create('prior', 'owner', {authHeaders: {cookie: 'secret'}}).entries.push({
+      role: 'user',
+      content: 'content-private',
+      timestamp: new Date().toISOString(),
+    });
+    const {store, calls} = recordedStore(inner);
+    const {listFor: _listFor, ...withoutList} = store;
+    const mongo = new MongoClient('mongodb://127.0.0.1:1', {serverSelectionTimeoutMS: 50});
+    const collection = mongo.db('history').collection<MongoSessionDocument>('conversations');
+    const legacyCollection: CollectionLike<MongoSessionDocument> = {
+      findOne: filter => collection.findOne(filter),
+      updateOne: (filter, update, options) => collection.updateOne(filter, update, options),
+      deleteOne: filter => collection.deleteOne(filter),
+      deleteMany: filter => collection.deleteMany(filter),
+      countDocuments: filter => collection.countDocuments(filter),
+    };
+    const cannotList = new MongoSessionStore({collection: legacyCollection});
+    const unavailable = new MongoSessionStore({collection});
+    await mongo.close();
+    const databaseFailure = await unavailable.listFor('owner').catch((error: unknown) => error);
+    expect(databaseFailure).toBeInstanceOf(Error);
+    const cases = [
+      {name: 'absent', history: undefined, store, code: 'UNSUPPORTED'},
+      {name: 'disabled', history: {enabled: false}, store, code: 'UNSUPPORTED'},
+      {name: 'no listFor', history: {enabled: true}, store: withoutList, code: 'UNSUPPORTED'},
+      {
+        name: 'no find',
+        history: {enabled: true},
+        store: {...withoutList, listFor: cannotList.listFor.bind(cannotList)},
+        code: 'UNSUPPORTED',
+      },
+      {
+        name: 'closed database',
+        history: {enabled: true},
+        store: {...withoutList, listFor: unavailable.listFor.bind(unavailable)},
+        code: 'SERVER_ERROR',
+      },
+    ];
+    const outcomes = [];
+    let failedSessionId: string | undefined;
+    for (const scenario of cases) {
+      const client = await connect(await start(scenario.store, scenario.history));
+      const frames = await client.ask({type: 'list_conversations'});
+      outcomes.push({name: scenario.name, frames, open: client.socket.readyState === WebSocket.OPEN});
+      if (scenario.code === 'SERVER_ERROR') failedSessionId = client.frames[0].sessionId;
+    }
+    expect(outcomes).toEqual(
+      cases.map(({name, code}) => ({
+        name,
+        frames: [{type: 'error', code, message: expect.any(String)}],
+        open: true,
+      }))
+    );
+    expect(calls).toEqual([]);
+    expect(logs.filter(line => line.level === 'error')).toEqual(
+      expect.arrayContaining([expect.objectContaining({fields: expect.objectContaining({sessionId: failedSessionId})})])
+    );
+    expect(JSON.stringify(outcomes)).not.toContain((databaseFailure as Error).message);
+    expect(JSON.stringify({outcomes, logs})).not.toMatch(/secret|content-/);
+  });
