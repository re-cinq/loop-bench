+  // @spec specs/hal-engine-conversation-list/spec.md#40
+  it('answers history while a turn holds the session lock and emits no history stream_end', async () => {
+    let release!: () => void;
+    let entered!: () => void;
+    const held = new Promise<void>(resolve => {
+      release = resolve;
+    });
+    const running = new Promise<void>(resolve => {
+      entered = resolve;
+    });
+    const base = await start(
+      new InMemorySessionStore(),
+      {enabled: true},
+      {
+        beforeModelResponse: async () => {
+          entered();
+          await held;
+          throw new Error('The acceptance policy declines external model access');
+        },
+      }
+    );
+    const client = await connect(base);
+    try {
+      client.socket.send(JSON.stringify({type: 'user_message', content: 'hold this turn'}));
+      await running;
+      await until(() => client.frames.some(frame => frame.type === 'entry_upsert'));
+      const response = await client.ask({type: 'list_conversations'});
+      expect(response).toEqual([
+        {
+          type: 'conversation_list',
+          conversations: [
+            expect.objectContaining({
+              sessionId: client.frames[0].sessionId,
+              entryCount: 1,
+            }),
+          ],
+        },
+      ]);
+      expect(client.frames.some(frame => frame.type === 'entry_upsert')).toBe(true);
+      expect(client.frames.some(frame => frame.type === 'stream_end')).toBe(false);
+    } finally {
+      release();
+      await until(() => client.frames.some(frame => frame.type === 'stream_end'));
+    }
+    expect(client.frames.filter(frame => frame.type === 'stream_end')).toHaveLength(1);
+  });
