diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..a1ab323
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,348 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {MongoClient} from 'mongodb';
+import {WebSocket} from 'ws';
+import {createHalEngine} from '../config.js';
+import type {HalEngineConfig, HalEngine} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {MongoSessionStore} from '../infrastructure/stores/mongo/mongoSessionStore.js';
+import type {CollectionLike} from '../infrastructure/stores/mongo/mongoDriverTypes.js';
+import type {MongoSessionDocument} from '../infrastructure/stores/mongo/mongoSessionDocument.js';
+import type {SessionStore, SessionListOptions} from '../types/sessionStore.js';
+import type {IncomingMessage, OutgoingMessage} from '../types/messages.js';
+import {setLogger} from '../shared/logger.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+
+interface Summary {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+interface Frame {
+  type: string;
+  sessionId?: string;
+  conversations?: Summary[];
+  code?: string;
+  message?: string;
+  timestamp?: number;
+}
+const engines: HalEngine[] = [];
+const sockets: WebSocket[] = [];
+const logs: Array<{level: string; message: string; fields?: Record<string, unknown>}> = [];
+beforeEach(() => {
+  logs.length = 0;
+  const record = (level: string) => (_category: string, message: string, fields?: Record<string, unknown>) => {
+    logs.push({level, message, fields});
+  };
+  setLogger({debug: record('debug'), info: record('info'), warn: record('warn'), error: record('error')});
+});
+afterEach(async () => {
+  for (const socket of sockets.splice(0)) socket.terminate();
+  for (const engine of engines.splice(0)) {
+    await until(() => engine.wss.clients.size === 0);
+    await engine.stop();
+  }
+  setLogger();
+});
+
+// Configured through the public factory; the real Bedrock provider is never asked to make a network request.
+async function start(
+  store: SessionStore,
+  history?: {enabled: boolean},
+  hooks?: NonNullable<HalEngineConfig['orchestrator']>['hooks'],
+  resume = true
+) {
+  const transport = {port: 0, resume: {enabled: resume}, history};
+  const engine = createHalEngine({
+    provider: {type: 'bedrock', modelId: 'unused', region: 'eu-west-1', maxTokens: 16},
+    prompt: {identity: 'History acceptance'},
+    auth: {ws: async () => ({id: 'owner'})},
+    session: store,
+    transport,
+    orchestrator: {hooks},
+  });
+  engines.push(engine);
+  await engine.start();
+  return `ws://127.0.0.1:${(engine.server.address() as AddressInfo).port}/hal/ws`;
+}
+
+async function until(check: () => boolean): Promise<void> {
+  const deadline = Date.now() + 1500;
+  while (!check() && Date.now() < deadline) await new Promise(resolve => setTimeout(resolve, 5));
+}
+
+async function connect(url: string) {
+  const socket = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'acceptance-token']);
+  sockets.push(socket);
+  const frames: Frame[] = [];
+  socket.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  await once(socket, 'open');
+  await until(() => frames.some(frame => frame.type === 'connected'));
+  expect(frames[0]?.type).toBe('connected');
+  let timestamp = 0;
+  const settle = async () => {
+    const stamp = ++timestamp;
+    socket.send(JSON.stringify({type: 'ping', timestamp: stamp}));
+    await until(() => frames.some(frame => frame.type === 'pong' && frame.timestamp === stamp));
+    expect(frames).toContainEqual({type: 'pong', timestamp: stamp});
+  };
+  const ask = async (payload: unknown) => {
+    const offset = frames.length;
+    socket.send(JSON.stringify(payload));
+    await until(() => frames.slice(offset).some(frame => ['conversation_list', 'error'].includes(frame.type)));
+    await settle();
+    return frames.slice(offset).filter(frame => frame.type !== 'pong');
+  };
+  await settle();
+  return {socket, frames, ask, settle};
+}
+
+// This adapter delegates every operation to a real store and records the actual list arguments.
+function recordedStore(inner: InMemorySessionStore) {
+  const calls: Array<{userId: string | number; options?: SessionListOptions}> = [];
+  const store: SessionStore = {
+    create: inner.create.bind(inner),
+    get: inner.get.bind(inner),
+    delete: inner.delete.bind(inner),
+    count: inner.count.bind(inner),
+    clear: inner.clear.bind(inner),
+    listFor: (userId, options) => {
+      calls.push({userId, options});
+      return inner.listFor(userId, options);
+    },
+  };
+  return {store, calls};
+}
+
+const legacyFrames: Array<IncomingMessage | OutgoingMessage> = [
+  {type: 'user_message', content: 'hello'},
+  {type: 'ping', timestamp: 1},
+  {type: 'connected', sessionId: 's', message: 'hi', examplePrompts: []},
+  {type: 'entry_upsert', index: 0, entry: {role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}},
+  {type: 'entry_delta', index: 1, delta: 'hello'},
+  {type: 'entry_commit', index: 1},
+  {type: 'entry_skip', index: 2},
+  {type: 'error', code: 'SERVER_ERROR', message: 'failed'},
+  {type: 'pong', timestamp: 1},
+  {type: 'stream_end'},
+];
+
+describe('conversation history over the authenticated socket', () => {
+  // @spec specs/hal-engine-conversation-list/spec.md#37
+  it('accepts bounded list requests and composite cursors while rejecting malformed fields', async () => {
+    const before = {updatedAt: '2026-10-01T00:00:00.000Z', sessionId: 'older'};
+    const valid = [
+      {type: 'list_conversations'},
+      {type: 'list_conversations', limit: 1},
+      {type: 'list_conversations', limit: 200, before},
+    ];
+    const invalid = [
+      ...[0, 201, 1.5, '10', null].map(limit => ({field: 'limit', payload: {limit}})),
+      ...[
+        'not a date',
+        null,
+        {},
+        {updatedAt: before.updatedAt},
+        {sessionId: 'older'},
+        {updatedAt: 'not a date', sessionId: 'older'},
+        {updatedAt: before.updatedAt, sessionId: 42},
+      ].map(cursor => ({field: 'before', payload: {before: cursor}})),
+    ];
+    const client = await connect(await start(new InMemorySessionStore()));
+    const errors = [];
+    for (const {payload, field} of invalid) {
+      const request = {type: 'list_conversations', ...payload};
+      errors.push({field, validation: validateMessage(request), frames: await client.ask(request)});
+    }
