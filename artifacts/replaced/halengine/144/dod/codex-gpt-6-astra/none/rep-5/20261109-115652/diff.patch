+// spec: specs/hal-engine-conversation-list/spec.md#41
+it('answers history while a real user turn holds the session lock', async () => {
+  let entered = false;
+  let release!: () => void;
+  const gate = new Promise<void>(resolve => {
+    release = resolve;
+  });
+  const client = await connect(
+    await start(
+      new InMemorySessionStore(),
+      {enabled: true},
+      {
+        beforeModelResponse: async () => {
+          entered = true;
+          await gate;
+          throw new Error('Consumer stopped this turn before contacting the model');
+        },
+      }
+    )
+  );
+  try {
+    client.socket.send(JSON.stringify({type: 'user_message', content: 'hold this turn'}));
+    await until(() => entered);
+    expect(client.frames.some(frame => frame.type === 'stream_end')).toBe(false);
+    const response = await request(client, {type: 'list_conversations'});
+    expect(response).toEqual([
+      {
+        type: 'conversation_list',
+        conversations: [
+          expect.objectContaining({
+            sessionId: client.frames[0].sessionId,
+            entryCount: 1,
+          }),
+        ],
+      },
+    ]);
+    expect(client.frames.some(frame => frame.type === 'stream_end')).toBe(false);
+  } finally {
+    release();
+    await until(() => client.frames.some(frame => frame.type === 'stream_end'));
+  }
