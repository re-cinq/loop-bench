+// spec: specs/hal-engine-conversation-list/spec.md#40
+it('distinguishes a store failure from an unsupported collection without leaking details or closing the socket', async () => {
+  const mongo = new MongoClient('mongodb://127.0.0.1:1/private-store', {serverSelectionTimeoutMS: 50});
+  await mongo.close();
+  const collection = mongo.db().collection<MongoSessionDocument>('private-conversations');
+  const originalCollection = {
+    findOne: collection.findOne.bind(collection),
+    updateOne: collection.updateOne.bind(collection),
+    deleteOne: collection.deleteOne.bind(collection),
+    deleteMany: collection.deleteMany.bind(collection),
+    countDocuments: collection.countDocuments.bind(collection),
+  } as CollectionLike<MongoSessionDocument>;
+  for (const [source, code] of [
+    [collection, 'SERVER_ERROR'],
+    [originalCollection, 'UNSUPPORTED'],
+  ] as const) {
+    const mongoStore = new MongoSessionStore({collection: source as CollectionLike<MongoSessionDocument>});
+    if (code === 'UNSUPPORTED') {
+      const StoreCannotList = Reflect.get(publicApi, 'StoreCannotList');
+      expect(StoreCannotList).toEqual(expect.any(Function));
+      await expect(mongoStore.listFor('owner')).rejects.toBeInstanceOf(StoreCannotList);
+    }
+    const store = {...originalStore(new InMemorySessionStore()), listFor: mongoStore.listFor.bind(mongoStore)};
+    const client = await connect(await start(store, {enabled: true}));
+    const response = await request(client, {type: 'list_conversations'});
+    expect(response).toEqual([{type: 'error', code, message: expect.any(String)}]);
+    expect(JSON.stringify(response)).not.toMatch(/private-store|private-conversations|Mongo|127\.0\.0\.1/);
+    expect(client.socket.readyState).toBe(WebSocket.OPEN);
+    if (code === 'SERVER_ERROR') {
+      expect(errors).toEqual(
+        expect.arrayContaining([expect.objectContaining({sessionId: client.frames[0].sessionId})])
+      );
+      expect(JSON.stringify(errors)).not.toMatch(/private-store|private-conversations|credential/);
+    }
+  }
+});
