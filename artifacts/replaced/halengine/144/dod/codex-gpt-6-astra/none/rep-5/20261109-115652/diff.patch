+## 14. Conversation list response and authorisation
+
+`conversation_list` answers a request, never arrives unsolicited, and carries one authenticated user's own metadata without conversation content or credentials ([validated by: lists only the authenticated users metadata, pages ties and resumes a listed conversation](../../src/transport/conversationList.acceptance.test.ts#L143)).
+
+| Field                        | Type                  | Description                                       |
+| ---------------------------- | --------------------- | ------------------------------------------------- |
+| `type`                       | string                | `"conversation_list"`                             |
+| `conversations`              | ConversationSummary[] | Ordered summaries                                 |
+| `conversations[].sessionId`  | string                | Conversation id used with the existing resume URL |
+| `conversations[].createdAt`  | string                | ISO creation time                                 |
+| `conversations[].updatedAt`  | string                | ISO activity time                                 |
+| `conversations[].entryCount` | number                | Number of stored entries                          |
+
+**GDPR.** The user id comes from the authenticated connection, never the frame ([validated by: lists only the authenticated users metadata, pages ties and resumes a listed conversation](../../src/transport/conversationList.acceptance.test.ts#L143)).
+
+`transport.history` is the deployer's independent decision to make a user's history reachable from a client; enabling resume alone does not enable this disclosure ([validated by: refuses disabled history and stores without listing with UNSUPPORTED and no list](../../src/transport/conversationList.acceptance.test.ts#L186)).
+
+Retention remains the consumer's decision under #41; opening a listed row requires resume to be enabled too.
diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..071582f
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,276 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {MongoClient} from 'mongodb';
+import {WebSocket} from 'ws';
+import {createHalEngine} from '../config.js';
+import * as publicApi from '../index.js';
+import type {IncomingMessage, OutgoingMessage} from '../types/messages.js';
+import type {HalEngineConfig} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {MongoSessionStore} from '../infrastructure/stores/mongo/mongoSessionStore.js';
+import type {CollectionLike} from '../infrastructure/stores/mongo/mongoDriverTypes.js';
+import type {MongoSessionDocument} from '../infrastructure/stores/mongo/mongoSessionDocument.js';
+import type {SessionListOptions, SessionStore} from '../types/sessionStore.js';
+import {captureErrors} from '../shared/logCaptureTestSupport.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+
+type Row = {sessionId: string; createdAt: string; updatedAt: string; entryCount: number};
+type Frame = {type: string; conversations?: Row[]; [key: string]: unknown};
+const engines: ReturnType<typeof createHalEngine>[] = [];
+const sockets: WebSocket[] = [];
+const errors = captureErrors();
+
+// Records calls without replacing the real store's query or its results.
+class RecordedStore extends InMemorySessionStore {
+  readonly calls: Array<{userId: string | number; options?: SessionListOptions}> = [];
+  override listFor(userId: string | number, options?: SessionListOptions) {
+    this.calls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+// A capability-limited view of a real store, with every exposed operation delegated unchanged.
+function originalStore(store: InMemorySessionStore): SessionStore {
+  return {
+    create: store.create.bind(store),
+    get: store.get.bind(store),
+    delete: store.delete.bind(store),
+    count: store.count.bind(store),
+    clear: store.clear.bind(store),
+  };
+}
+
+async function start(
+  store: SessionStore,
+  history?: {enabled: boolean},
+  hooks?: NonNullable<HalEngineConfig['orchestrator']>['hooks']
+) {
+  const transport = {resume: {enabled: true}, history};
+  const engine = createHalEngine({
+    provider: {type: 'bedrock', region: 'eu-central-1', modelId: 'unused', maxTokens: 1},
+    prompt: {identity: 'History acceptance'},
+    session: store,
+    transport,
+    auth: {ws: async () => ({id: 'owner'})},
+    orchestrator: {hooks},
+  });
+  engines.push(engine);
+  await engine.start(0);
+  return `ws://127.0.0.1:${(engine.server.address() as AddressInfo).port}/hal/ws`;
+}
+
+async function connect(url: string) {
+  const socket = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'credential']);
+  sockets.push(socket);
+  const frames: Frame[] = [];
+  socket.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  await until(() => frames.some(frame => frame.type === 'connected'));
+  return {socket, frames};
+}
+
+async function until(check: () => boolean) {
+  const deadline = Date.now() + 2000;
+  while (!check() && Date.now() < deadline) await new Promise(resolve => setTimeout(resolve, 5));
+  expect(check()).toBe(true);
+}
+
+async function request(client: Awaited<ReturnType<typeof connect>>, payload: object) {
+  const offset = client.frames.length;
+  client.socket.send(JSON.stringify(payload));
+  await until(() => client.frames.slice(offset).some(frame => ['conversation_list', 'error'].includes(frame.type)));
+  client.socket.send(JSON.stringify({type: 'ping', timestamp: offset}));
+  await until(() => client.frames.slice(offset).some(frame => frame.type === 'pong' && frame.timestamp === offset));
+  return client.frames.slice(offset).filter(frame => frame.type !== 'pong');
+}
+
+afterEach(async () => {
+  await Promise.all(
+    sockets.splice(0).map(async socket => {
+      if (socket.readyState === WebSocket.CLOSED) return;
+      const closed = once(socket, 'close');
+      socket.terminate();
+      await closed;
+    })
+  );
+  await Promise.all(engines.splice(0).map(engine => engine.stop()));
+});
+
+// spec: specs/hal-engine-conversation-list/spec.md#37
+it('validates list requests and composite cursors without accepting an identity from the frame', () => {
+  const legacy: Array<IncomingMessage | OutgoingMessage> = [
+    {type: 'user_message', content: 'hello'},
+    {type: 'ping', timestamp: 1},
+    {type: 'connected', sessionId: 'a', message: 'hello', examplePrompts: []},
+    {type: 'entry_upsert', index: 0, entry: {role: 'user', content: 'hello', timestamp: '2026-10-01T00:00:00.000Z'}},
+    {type: 'entry_delta', index: 1, delta: 'hello'},
+    {type: 'entry_commit', index: 1},
+    {type: 'entry_skip', index: 2},
+    {type: 'error', code: 'SERVER_ERROR', message: 'failed'},
+    {type: 'pong', timestamp: 1},
+    {type: 'stream_end'},
+  ];
+  expect(JSON.parse(JSON.stringify(legacy))).toEqual(legacy);
+  const before = {updatedAt: '2026-10-01T00:00:00.000Z', sessionId: 'conversation'};
+  for (const fields of [{}, {limit: 1}, {limit: 200, before}, {before}]) {
+    expect(validateMessage({type: 'list_conversations', ...fields, userId: 'someone-else'})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations', ...fields},
+    });
+  }
+  for (const [field, values] of Object.entries({
+    limit: [0, 201, 1.5, '10', null],
+    before: [
+      'not a date',
+      before.updatedAt,
+      null,
+      {},
+      {updatedAt: before.updatedAt},
+      {sessionId: 'x'},
+      {...before, updatedAt: 'not a date'},
+      {...before, sessionId: 1},
+    ],
+  })) {
+    for (const value of values)
+      expect(validateMessage({type: 'list_conversations', [field]: value})).toEqual({
+        valid: false,
+        error: expect.stringMatching(new RegExp(field, 'i')),
+      });
+  }
+});
+
+// spec: specs/hal-engine-conversation-list/spec.md#38
+it('lists only the authenticated users metadata, pages ties and resumes a listed conversation', async () => {
+  const store = new RecordedStore();
+  const timestamp = new Date(Date.now() + 10000).toISOString();
+  for (const id of ['a', 'b']) {
+    store.create(id, 'owner', {authHeaders: {Authorization: 'private-credential'}}).entries.push({
+      role: 'user',
+      content: 'private conversation content',
+      timestamp,
+    });
+  }
+  store.create('foreign', 'someone-else');
+  const base = await start(store, {enabled: true});
+  const client = await connect(base);
+  expect(client.frames.map(frame => frame.type)).toEqual(['connected']);
+  const expected = JSON.parse(JSON.stringify(InMemorySessionStore.prototype.listFor.call(store, 'owner'))) as Row[];
