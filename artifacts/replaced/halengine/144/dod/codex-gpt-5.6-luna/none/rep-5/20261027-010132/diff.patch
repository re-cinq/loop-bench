+import {WebSocket} from 'ws';
+import type {AddressInfo} from 'node:net';
+import type {Express} from 'express';
+import {createServer} from '../createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './subprotocol.js';
+import {InMemorySessionStore} from '../../infrastructure/stores/inMemorySessionStore.js';
+import type {SessionListOptions, SessionSummary} from '../../types/sessionStore.js';
+import type {HalServer} from '../createServer.js';
+import {validateMessage} from './validation.js';
+import {answeringOrchestrator} from '../wsTestSupport.js';
+
+interface WireFrame {
+  type: string;
+  code?: string;
+  conversations?: Array<Record<string, unknown>>;
+}
+
+class RecordingSessionStore extends InMemorySessionStore {
+  lastListCall: {userId: string | number; options?: SessionListOptions} | undefined;
+
+  override listFor(userId: string | number, options?: SessionListOptions): SessionSummary[] {
+    this.lastListCall = {userId, options};
+    return super.listFor(userId, options);
+  }
+}
+
+const servers: HalServer[] = [];
+const clients: WebSocket[] = [];
+
+afterEach(async () => {
+  for (const client of clients.splice(0)) {
+    if (client.readyState === WebSocket.OPEN) {
+      await new Promise<void>(resolve => {
+        client.once('close', () => resolve());
+        client.close();
+      });
+    } else {
+      client.terminate();
+    }
+  }
+  for (const server of servers.splice(0)) await server.stop();
+});
+
+const start = async (store: RecordingSessionStore, history?: {enabled: boolean}) => {
+  const server = createServer({
+    app: (() => undefined) as unknown as Express,
+    wsAuth: async () => ({id: 'u1'}),
+    sessionStore: store,
+    orchestrator: answeringOrchestrator,
+    ...(history === undefined ? {} : ({history} as unknown as Record<string, unknown>)),
+  } as Parameters<typeof createServer>[0]);
+  await server.start(0);
+  servers.push(server);
+  const {port} = server.server.address() as AddressInfo;
+  return `ws://127.0.0.1:${port}/hal/ws`;
+};
+
+const request = (url: string, frame: Record<string, unknown>): Promise<WireFrame[]> => {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'token']);
+  clients.push(client);
+  return new Promise((resolve, reject) => {
+    const frames: WireFrame[] = [];
+    client.once('error', reject);
+    client.on('message', raw => {
+      const received = JSON.parse(String(raw)) as WireFrame;
+      frames.push(received);
+      if (received.type === 'connected') {
+        client.send(JSON.stringify(frame));
+        client.send(JSON.stringify({type: 'ping', timestamp: 1}));
+      }
+      if (received.type === 'pong') resolve(frames);
+    });
+  });
+};
+
+describe('conversation list over the WebSocket protocol', () => {
+  it('accepts a list frame and names every invalid limit or cursor field', () => {
+    expect(validateMessage({type: 'list_conversations'})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations'},
+    });
+
+    for (const [frame, field] of [
+      [{type: 'list_conversations', limit: 0}, 'limit'],
+      [{type: 'list_conversations', limit: 201}, 'limit'],
+      [{type: 'list_conversations', limit: 1.5}, 'limit'],
+      [{type: 'list_conversations', limit: '10'}, 'limit'],
+      [{type: 'list_conversations', before: 'not a date'}, 'before'],
+    ] as const) {
+      const result = validateMessage(frame);
+      expect(result.valid).toBe(false);
+      if (!result.valid) expect(result.error).toContain(field);
+    }
+  });
+
+  it('delivers the authenticated user’s summaries and forwards the paging cursor', async () => {
+    const store = new RecordingSessionStore();
+    store.create('u1-old', 'u1');
+    store.create('u1-new', 'u1');
+    store.create('u1-third', 'u1');
+    store.create('u2-private', 'u2');
+    const url = await start(store, {enabled: true});
+
+    const firstFrames = await request(url, {type: 'list_conversations', userId: 'u2'});
+    const first = firstFrames.find(frame => frame.type === 'conversation_list');
+
+    expect(firstFrames.map(frame => frame.type)).toEqual(['connected', 'conversation_list', 'pong']);
+    expect(first?.conversations).toHaveLength(3);
+    expect(
+      first?.conversations?.every(
+        row => Object.keys(row).sort().join(',') === 'createdAt,entryCount,sessionId,updatedAt'
+      )
+    ).toBe(true);
+    expect(
+      first?.conversations?.every(
+        row => typeof row.createdAt === 'string' && !Number.isNaN(Date.parse(row.createdAt as string))
+      )
+    ).toBe(true);
+    expect(
+      first?.conversations?.every(
+        row => typeof row.updatedAt === 'string' && !Number.isNaN(Date.parse(row.updatedAt as string))
+      )
+    ).toBe(true);
+    expect(first?.conversations?.map(row => row.sessionId).sort()).toEqual(['u1-new', 'u1-old', 'u1-third']);
+    expect(store.lastListCall?.userId).toBe('u1');
+
+    const cursor = first?.conversations?.[0];
+    await request(url, {
+      type: 'list_conversations',
+      limit: 1,
+      before: {updatedAt: cursor?.updatedAt, sessionId: cursor?.sessionId},
+    });
+
+    expect(store.lastListCall).toEqual({
+      userId: 'u1',
+      options: {limit: 1, before: {updatedAt: cursor?.updatedAt, sessionId: cursor?.sessionId}},
+    });
+  });
+
+  it('refuses the list when history is not enabled without sending an empty list', async () => {
+    const store = new RecordingSessionStore();
+    store.create('u1-existing', 'u1');
+    const frames = await request(await start(store), {type: 'list_conversations'});
+
+    expect(frames.filter(frame => frame.type === 'error')).toHaveLength(1);
+    expect(frames.find(frame => frame.type === 'error')?.code).toBe('UNSUPPORTED');
+    expect(frames.some(frame => frame.type === 'conversation_list')).toBe(false);
+  });
+});