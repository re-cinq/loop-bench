+import {validateMessage} from './validation.js';
+
+// @spec specs/hal-engine-websocket-protocol/spec.md#216
+it('preserves valid list cursors, strips unknown fields, and rejects malformed cursors', () => {
+  const cursors = [
+    {sessionId: 's1', updatedAt: '2026-01-01T00:00:00.000Z'},
+    {sessionId: 's'.repeat(128), updatedAt: 0},
+  ];
+  const invalid = [
+    null,
+    'cursor',
+    [],
+    {},
+    {sessionId: '', updatedAt: 0},
+    {sessionId: 's'.repeat(129), updatedAt: 0},
+    {sessionId: 1, updatedAt: 0},
+    {sessionId: 's1', updatedAt: 'not-a-date'},
+    {sessionId: 's1', updatedAt: true},
+    {sessionId: 's1', updatedAt: Infinity},
+    {sessionId: 's1', updatedAt: 8640000000000001},
+  ];
+  expect({
+    accepted: cursors.map(before =>
+      validateMessage({type: 'list_sessions', limit: 10, before: {...before, extra: true}, userId: 'other'})
+    ),
+    rejected: invalid.map(before => validateMessage({type: 'list_sessions', before})),
+  }).toEqual({
+    accepted: cursors.map(before => ({valid: true, data: {type: 'list_sessions', limit: 10, before}})),
+    rejected: invalid.map(() => ({
+      valid: false,
+      error: 'list_sessions before must have a sessionId of 1–128 characters and a valid updatedAt date',
+    })),
+  });
+});
