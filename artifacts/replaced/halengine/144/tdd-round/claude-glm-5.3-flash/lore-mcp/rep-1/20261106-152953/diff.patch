 export function sendJson(ws: WebSocket, message: OutgoingMessage): void {
   ws.send(JSON.stringify(message));
 }
 
+// A Date does not survive JSON.stringify as a Date, so the two times go on the wire as ISO strings.
+export function sendSessionList(ws: WebSocket, summaries: SessionSummary[]): void {
+  const sessions = summaries.map((summary): SessionSummaryFrame => ({
+    sessionId: summary.sessionId,
+    createdAt: new Date(summary.createdAt).toISOString(),
+    updatedAt: new Date(summary.updatedAt).toISOString(),
+    entryCount: summary.entryCount,
+  }));
+  sendJson(ws, {type: 'session_list', sessions});
+}
+
 export function sendUpsert(ws: WebSocket, index: number, entry: SessionEntry): void {
   sendJson(ws, {type: 'entry_upsert', index, entry});
 }
