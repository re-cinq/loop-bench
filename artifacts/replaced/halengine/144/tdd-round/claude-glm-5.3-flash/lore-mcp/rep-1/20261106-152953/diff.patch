+
+// Off the turn lock, like the ping beside it: a list is not a turn, and it mutates nothing.
+async function answerSessionList(
+  ws: WebSocket,
+  session: ChatSession,
+  frame: ListSessionsMessage,
+  sessionStore: SessionStore | undefined
+): Promise<void> {
+  try {
+    // The connection's own user, never one the frame names; a store without the member answers an empty list.
+    const summaries = await sessionStore?.listFor?.(session.userId, {limit: frame.limit, before: frame.before});
+    sendSessionList(ws, summaries ?? []);
+  } catch (error) {
+    const message = error instanceof Error ? error.message : 'Unknown error';
+    log.error('ws', 'conversation list failed', {sessionId: session.sessionId, userId: session.userId, error: message});
+    sendError(ws, ErrorCodes.SERVER_ERROR, 'Could not list conversations');
+  }
 }
 
