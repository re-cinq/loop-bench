+import type {WebSocket} from 'ws';
+import {createMessageHandler} from './ws/messageHandler.js';
+import {captureErrors} from '../shared/logCaptureTestSupport.js';
+import type {ChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import type {ChatSession} from '../types/session.js';
+import type {OutgoingMessage} from '../types/messages.js';
+import type {SessionListOptions, SessionStore, SessionSummary} from '../types/sessionStore.js';
+
+// The handler's side of the conversation list: the session's own user, dates on the wire as ISO strings,
+// an empty list where a store cannot list, and a server error where a store that can fails.
+
+// Only the member the handler reads, so a store can omit listFor, record its call, or reject.
+const store = (listFor?: SessionStore['listFor']): SessionStore => ({listFor}) as unknown as SessionStore;
+
+const answer = async (raw: unknown, sessionStore?: SessionStore): Promise<{sent: OutgoingMessage[]}> => {
+  const sent: OutgoingMessage[] = [];
+  const ws = {send: (frame: string) => sent.push(JSON.parse(frame) as OutgoingMessage)} as unknown as WebSocket;
+  const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+
+  await createMessageHandler({} as ChatOrchestrator, sessionStore)(ws, session, raw);
+  return {sent};
+};
+
+describe('the conversation list handler', () => {
+  const errors = captureErrors();
+
+  it('answers list_sessions for the session user with ISO dates, an empty list without listFor, and SERVER_ERROR with a ws log when listFor throws', async () => {
+    const summaries: SessionSummary[] = [
+      {
+        sessionId: 's2',
+        createdAt: new Date('2026-01-01T00:00:00.000Z'),
+        updatedAt: new Date('2026-01-01T00:02:00.000Z'),
+        entryCount: 4,
+      },
+    ];
+    const seen: Array<{userId: string | number; options?: SessionListOptions}> = [];
+    const before = {updatedAt: '2026-01-01T00:05:00.000Z', sessionId: 's3'};
+
+    const listed = await answer(
+      {type: 'list_sessions', limit: 10, before, userId: 'u2'},
+      store((userId, options) => {
+        seen.push({userId, options});
+        return summaries;
+      })
+    );
+    const unimplemented = await answer({type: 'list_sessions'}, store());
+    const failed = await answer(
+      {type: 'list_sessions'},
+      store(() => Promise.reject(new Error('database offline')))
+    );
+
+    expect({
+      answered: listed.sent,
+      calledWith: seen,
+      empty: unimplemented.sent,
+      failedFrame: failed.sent,
+      logged: errors,
+    }).toEqual({
+      answered: [
+        {
+          type: 'session_list',
+          sessions: [
+            {
+              sessionId: 's2',
+              createdAt: '2026-01-01T00:00:00.000Z',
+              updatedAt: '2026-01-01T00:02:00.000Z',
+              entryCount: 4,
+            },
+          ],
+        },
+      ],
+      calledWith: [{userId: 'u1', options: {limit: 10, before}}],
+      empty: [{type: 'session_list', sessions: []}],
+      failedFrame: [{type: 'error', code: 'SERVER_ERROR', message: expect.any(String)}],
+      logged: [expect.objectContaining({category: 'ws', userId: 'u1', error: 'database offline'})],
+    });
+  });
+});
