+
+function validateListSessionsMessage(message: Record<string, unknown>): ValidationResult {
+  const frame: ListSessionsMessage = {type: 'list_sessions'};
+
+  if (message.limit !== undefined) {
+    if (typeof message.limit !== 'number' || !Number.isInteger(message.limit) || message.limit < 0) {
+      return {valid: false, error: 'list_sessions limit must be a non-negative integer'};
+    }
+    frame.limit = message.limit;
+  }
+
+  if (message.before !== undefined) {
+    const cursor = validatedCursor(message.before);
+    if (typeof cursor === 'string') return {valid: false, error: cursor};
+    frame.before = cursor;
+  }
+
+  return {valid: true, data: frame};
+}
+
+// Only what the store pages on comes back, so a client cannot smuggle a field into the listFor call.
+function validatedCursor(value: unknown): SessionCursor | string {
+  if (typeof value !== 'object' || value === null) {
+    return 'list_sessions before must be a {updatedAt, sessionId} cursor';
+  }
+
+  const cursor = value as Record<string, unknown>;
+  const sessionId = cursor.sessionId;
+  if (typeof sessionId !== 'string' || sessionId.length < 1 || sessionId.length > MAX_CURSOR_SESSION_ID_LENGTH) {
+    return 'list_sessions before must carry a sessionId of 1 to 128 characters';
+  }
+
+  const updatedAt = cursor.updatedAt;
+  if (!carriesAMoment(updatedAt)) return 'list_sessions before must carry an updatedAt that parses as a timestamp';
+
+  return {updatedAt: updatedAt as string | number, sessionId};
+}
+
+function carriesAMoment(value: unknown): boolean {
+  if (typeof value === 'number') return Number.isFinite(value);
+  return typeof value === 'string' && Number.isFinite(Date.parse(value));
+}
