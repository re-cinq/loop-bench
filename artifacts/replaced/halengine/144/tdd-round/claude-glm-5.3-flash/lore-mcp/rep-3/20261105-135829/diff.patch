+// The user id comes from the session, which the upgrade authenticated, never from the frame.
+async function answerListSessions(
+  ws: WebSocket,
+  session: ChatSession,
+  sessionStore: SessionStore | undefined,
+  message: ListSessionsMessage
+): Promise<void> {
+  if (!sessionStore?.listFor) {
+    sendJson(ws, {type: 'session_list', sessions: []});
+    return;
+  }
+  try {
+    const summaries = await sessionStore.listFor(session.userId, {limit: message.limit, before: message.before});
+    sendJson(ws, {type: 'session_list', sessions: summaries.map(toSummaryFrame)});
+  } catch (error) {
+    // The store's message stays in the log: an error frame a client reads carries none of it.
+    log.error('ws', 'listing conversations failed', {
+      sessionId: session.sessionId,
+      userId: session.userId,
+      error: messageOf(error),
+    });
+    sendError(ws, ErrorCodes.SERVER_ERROR, 'Failed to list conversations');
+  }
+}
