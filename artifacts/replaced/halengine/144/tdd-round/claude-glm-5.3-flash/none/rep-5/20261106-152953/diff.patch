+// Additive protocol: these literals stood before the list frames; ts-jest cannot see types, CI's tsc holds them.
+
+const incoming: readonly IncomingMessage[] = [
+  {type: 'user_message', content: 'hello'},
+  {type: 'ping', timestamp: 1},
+];
+
+const outgoing: readonly OutgoingMessage[] = [
+  {type: 'connected', sessionId: 's1', message: 'Connected to HAL Engine', examplePrompts: []},
+  {
+    type: 'entry_upsert',
+    index: 0,
+    entry: {role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'},
+  },
+  {type: 'entry_delta', index: 0, delta: 'a'},
+  {type: 'entry_commit', index: 0},
+  {type: 'entry_skip', index: 0},
+  {type: 'error', code: ErrorCodes.SERVER_ERROR, message: 'failed'},
+  {type: 'pong', timestamp: 1},
+  {type: 'stream_end'},
+];
+
+describe('the wire frame literals', () => {
+  it('still compiles every message literal that was valid before the list frames', () => {
+    // @ts-expect-error the pin has teeth: a frame missing a required field does not compile.
+    const broken: OutgoingMessage = {type: 'connected', sessionId: 's1', examplePrompts: []};
+
+    expect({
+      frameTypes: [...incoming, ...outgoing].map(frame => frame.type),
+      brokenType: broken.type,
+    }).toEqual({
+      frameTypes: [
+        'user_message',
+        'ping',
+        'connected',
+        'entry_upsert',
+        'entry_delta',
+        'entry_commit',
+        'entry_skip',
+        'error',
+        'pong',
+        'stream_end',
+      ],
+      brokenType: 'connected',
+    });
+  });
+});
