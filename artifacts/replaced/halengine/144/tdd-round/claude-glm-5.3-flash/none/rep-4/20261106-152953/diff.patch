+/** A suite's own servers and clients, tracked so its teardown drains each server's sockets before it stops the server. */
+export function socketSandbox(): {
+  servers: Array<HalServer>;
+  clients: WebSocket[];
+  eventually: (check: () => boolean) => Promise<void>;
+  drain: () => Promise<void>;
+} {
+  const servers: Array<HalServer> = [];
+  const clients: WebSocket[] = [];
+  const eventually = async (check: () => boolean): Promise<void> => {
+    for (let attempt = 0; attempt < 50 && !check(); attempt++) await new Promise(resolve => setTimeout(resolve, 10));
+  };
+  // Each server sees its sockets close before it stops, so no close lands after the suite restored its logger.
+  const drain = async (): Promise<void> => {
+    for (const client of clients.splice(0)) client.terminate();
+    for (const hal of servers.splice(0)) {
+      const {wss} = hal;
+      await eventually(() => wss.clients.size === 0);
+      await hal.stop();
+    }
+  };
+  return {servers, clients, eventually, drain};
+}
