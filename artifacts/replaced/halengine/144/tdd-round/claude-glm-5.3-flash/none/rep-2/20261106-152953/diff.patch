diff --git a/src/transport/ws/validation.ts b/src/transport/ws/validation.ts
index 6e67a6a..f50d9fe 100644
--- a/src/transport/ws/validation.ts
+++ b/src/transport/ws/validation.ts
@@ -1,6 +1,8 @@
-import type {IncomingMessage} from '../../types/messages.js';
+import type {IncomingMessage, ListSessionsMessage} from '../../types/messages.js';
+import type {SessionCursor} from '../../types/sessionStore.js';
 
 const MAX_CONTENT_LENGTH = 10000;
+const MAX_CURSOR_SESSION_ID_LENGTH = 128;
 
 interface ValidationSuccess {
   valid: true;
@@ -30,6 +32,8 @@ export function validateMessage(payload: unknown): ValidationResult {
       return validateUserMessage(message);
     case 'ping':
       return validatePingMessage(message);
+    case 'list_sessions':
+      return validateListSessionsMessage(message);
     default:
       return {valid: false, error: `Unknown message type: ${message.type}`};
   }
@@ -72,3 +76,44 @@ function validatePingMessage(message: Record<string, unknown>): ValidationResult
     },
   };
 }
+
+function validateListSessionsMessage(message: Record<string, unknown>): ValidationResult {
+  const limit = message.limit;
+  if (limit !== undefined) {
+    if (typeof limit !== 'number' || !Number.isInteger(limit) || limit < 0) {
+      return {valid: false, error: 'list_sessions limit must be a non-negative integer'};
+    }
+  }
+
+  const before = message.before;
+  if (before !== undefined) {
+    const error = cursorError(before);
+    if (error !== undefined) return {valid: false, error};
+  }
+
+  const data: ListSessionsMessage = {type: 'list_sessions'};
+  if (limit !== undefined) data.limit = limit;
+  if (before !== undefined) data.before = before as SessionCursor;
+  return {valid: true, data};
+}
+
+// What a store's `before` could not resume from: the field naming itself, so a client can correct the one half that is wrong.
+function cursorError(cursor: unknown): string | undefined {
+  if (typeof cursor !== 'object' || cursor === null) {
+    return 'list_sessions before must be an object with updatedAt and sessionId';
+  }
+
+  const record = cursor as Record<string, unknown>;
+  const sessionId = record.sessionId;
+  if (typeof sessionId !== 'string' || sessionId.length < 1 || sessionId.length > MAX_CURSOR_SESSION_ID_LENGTH) {
+    return 'list_sessions before sessionId must be a string of 1 to 128 characters';
+  }
+
+  const updatedAt = record.updatedAt;
+  const moment =
+    typeof updatedAt === 'number' ? updatedAt : typeof updatedAt === 'string' ? Date.parse(updatedAt) : NaN;
+  if (!Number.isFinite(moment)) {
+    return 'list_sessions before updatedAt must be a parseable date';
+  }
+  return undefined;
+}
