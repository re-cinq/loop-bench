+import type {WebSocket} from 'ws';
+import {createMessageHandler} from './messageHandler.js';
+import {answeringOrchestrator, recordingListFor, storedSummary} from '../wsTestSupport.js';
+import {captureErrors} from '../../shared/logCaptureTestSupport.js';
+import type {ChatSession} from '../../types/session.js';
+import type {OutgoingMessage} from '../../types/messages.js';
+import type {SessionListOptions, SessionStore, SessionSummary} from '../../types/sessionStore.js';
+
+// A list is answered off the turn lock, from the connection's own user: what the frame carries is paging, never an identity.
+
+const socket = () => {
+  const frames: OutgoingMessage[] = [];
+  const ws = {send: (raw: string) => void frames.push(JSON.parse(raw) as OutgoingMessage)} as unknown as WebSocket;
+  return {ws, frames};
+};
+
+const sessionFor = (userId: string | number): ChatSession => ({sessionId: 's1', userId, entries: []});
+
+describe('the handler behind a list_sessions frame', () => {
+  const errors = captureErrors();
+
+  it('forwards the paging the frame named to the store for the session user, and answers rows serialised for the wire', async () => {
+    const {ws, frames} = socket();
+    const seen: Array<{userId: string | number; options?: SessionListOptions}> = [];
+    const summaries: SessionSummary[] = [storedSummary];
+    const handle = createMessageHandler(answeringOrchestrator, {
+      listFor: recordingListFor(summaries, seen),
+    } as SessionStore);
+
+    await handle(ws, sessionFor('u1'), {
+      type: 'list_sessions',
+      limit: 10,
+      before: {updatedAt: '2026-01-01T00:05:00.000Z', sessionId: 's3'},
+      userId: 'u2',
+    });
+
+    expect({seen, frames}).toEqual({
+      seen: [{userId: 'u1', options: {limit: 10, before: {updatedAt: '2026-01-01T00:05:00.000Z', sessionId: 's3'}}}],
+      frames: [
+        {
+          type: 'session_list',
+          sessions: [
+            {
+              sessionId: 's2',
+              createdAt: '2026-01-01T00:00:00.000Z',
+              updatedAt: '2026-01-01T00:02:00.000Z',
+              entryCount: 4,
+            },
+          ],
+        },
+      ],
+    });
+  });
+
+  it('answers SERVER_ERROR from the ws log when the store fails to list, and no session_list', async () => {
+    const {ws, frames} = socket();
+    const failing = {listFor: () => Promise.reject(new Error('database offline'))} as unknown as SessionStore;
+    const handle = createMessageHandler(answeringOrchestrator, failing);
+
+    await handle(ws, sessionFor('u1'), {type: 'list_sessions'});
+
+    expect({errors, frames}).toEqual({
+      errors: [{category: 'ws', message: expect.any(String), userId: 'u1', error: 'database offline'}],
+      frames: [{type: 'error', code: 'SERVER_ERROR', message: expect.any(String)}],
+    });
+  });
+});
