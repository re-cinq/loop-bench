index 0000000..5b02994
--- /dev/null
+++ b/scripts/warmMongoBinary.mjs
@@ -0,0 +1,26 @@
+import {MongoBinary} from 'mongodb-memory-server-core';
+
+// Six suites ask for the same mongod on a cold cache, and jest forks them into workers that would
+// each start a download: the losers die unlocking a lock another process now holds. One lookup here,
+// in the parent before any worker forks, leaves the binary on disk for them to find.
+
+let inFlight;
+
+/** The one cold `MongoBinary.getPath` per process, shared by every caller; a failed one is dropped so the next caller retries. */
+export function warmMongoBinary(locate = () => MongoBinary.getPath()) {
+  inFlight ??= Promise.resolve()
+    .then(locate)
+    .finally(() => {
+      inFlight = undefined;
+    });
+  return inFlight;
+}
+
+/** Jest globalSetup. Best effort: a download this cannot finish is one the suites start themselves. */
+export default async function globalSetup() {
+  try {
+    await warmMongoBinary();
+  } catch (error) {
+    process.stderr.write(`warmMongoBinary: ${error instanceof Error ? error.message : String(error)}\n`);
+  }
+}
