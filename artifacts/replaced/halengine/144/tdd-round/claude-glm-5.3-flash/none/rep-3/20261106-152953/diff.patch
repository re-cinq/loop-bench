+function validateListSessionsMessage(message: Record<string, unknown>): ValidationResult {
+  const page = readLimit(message.limit);
+  if ('error' in page) return {valid: false, error: page.error};
+  const cursor = readCursor(message.before);
+  if ('error' in cursor) return {valid: false, error: cursor.error};
+
+  const frame: ListSessionsMessage = {type: 'list_sessions'};
+  if (page.limit !== undefined) frame.limit = page.limit;
+  if (cursor.cursor !== undefined) frame.before = cursor.cursor;
+  return {valid: true, data: frame};
+}
+
+type LimitRead = {error: string} | {limit: number | undefined};
+type CursorRead = {error: string} | {cursor: SessionCursor | undefined};
+
+function readLimit(limit: unknown): LimitRead {
+  if (limit === undefined) return {limit: undefined};
+  if (typeof limit !== 'number' || !Number.isInteger(limit) || limit < 0) {
+    return {error: 'list_sessions limit must be a non-negative integer'};
+  }
+  return {limit};
+}
+
+function readCursor(before: unknown): CursorRead {
+  if (before === undefined) return {cursor: undefined};
+  if (typeof before !== 'object' || before === null) {
+    return {error: 'list_sessions before must be an object with updatedAt and sessionId'};
+  }
+
+  const cursor = before as Record<string, unknown>;
+  const updatedAt = cursor.updatedAt;
+  if (!isReadableTime(updatedAt)) {
+    return {error: 'list_sessions before updatedAt must be a string or number that parses as a date'};
+  }
+
+  const sessionId = cursor.sessionId;
+  if (typeof sessionId !== 'string' || sessionId.length === 0 || sessionId.length > MAX_CURSOR_SESSION_ID_LENGTH) {
+    return {error: 'list_sessions before sessionId must be a string of 1 to 128 characters'};
+  }
+
+  return {cursor: {updatedAt, sessionId}};
+}
+
+// A string or an epoch number, so a cursor that went through JSON still pages; a Date never arrives on the wire.
+function isReadableTime(updatedAt: unknown): updatedAt is string | number {
+  if (typeof updatedAt !== 'string' && typeof updatedAt !== 'number') return false;
+  return Number.isFinite(new Date(updatedAt).getTime());
+}
