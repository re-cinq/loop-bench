+++ b/scripts/warmMongoBinary.test.ts
@@ -0,0 +1,44 @@
+import {warmMongoBinary} from './warmMongoBinary.mjs';
+
+// Six workers racing one cold mongod download die unlocking each other's lock, so the parent looks it up once.
+
+const deferred = <T>() => {
+  let release!: (value: T) => void;
+  const pending = new Promise<T>(resolve => {
+    release = resolve;
+  });
+  return {pending, release};
+};
+
+describe('the binary warmup jest runs before its workers fork', () => {
+  it('joins the lookup already in flight rather than starting a second one', async () => {
+    let lookups = 0;
+    const first = deferred<string>();
+    const locate = () => {
+      lookups += 1;
+      return first.pending;
+    };
+
+    const racing = Promise.all([warmMongoBinary(locate), warmMongoBinary(locate)]);
+    first.release('/binaries/mongod-7.0.14');
+
+    const paths = await racing;
+
+    expect({lookups, paths}).toEqual({
+      lookups: 1,
+      paths: ['/binaries/mongod-7.0.14', '/binaries/mongod-7.0.14'],
+    });
+  });
+
+  it('drops a lookup that failed, so the next caller retries instead of inheriting it', async () => {
+    let calls = 0;
+    const locate = () => {
+      calls += 1;
+      return calls === 1 ? Promise.reject(new Error('fastdl unreachable')) : Promise.resolve('/binaries/mongod-7.0.14');
+    };
+
+    const retried = await warmMongoBinary(locate).catch(() => warmMongoBinary(locate));
+
+    expect({calls, retried}).toEqual({calls: 2, retried: '/binaries/mongod-7.0.14'});
+  });
+});
