+
+// A list_sessions frame asks for the connection's own conversations: the validator keeps the paging the frame names and nothing else.
+
+describe('a list_sessions frame', () => {
+  const cursor = {updatedAt: '2026-01-01T00:05:00.000Z', sessionId: 's3'};
+  const invalid = (error: string) => ({valid: false, error});
+
+  it('answers a valid frame with the limit and cursor it names and nothing else it carries', () => {
+    const bare = validateMessage({type: 'list_sessions'});
+    const paged = validateMessage({type: 'list_sessions', limit: 10, before: cursor, userId: 'u2'});
+    const epoch = validateMessage({type: 'list_sessions', before: {updatedAt: 1767225600000, sessionId: 's3'}});
+
+    expect({bare, paged, epoch}).toEqual({
+      bare: {valid: true, data: {type: 'list_sessions'}},
+      paged: {valid: true, data: {type: 'list_sessions', limit: 10, before: cursor}},
+      epoch: {valid: true, data: {type: 'list_sessions', before: {updatedAt: 1767225600000, sessionId: 's3'}}},
+    });
+  });
+
+  it('rejects a limit that is not a non-negative integer, naming the field', () => {
+    const rejected = ['ten', -1, 1.5, Number.NaN].map(limit => validateMessage({type: 'list_sessions', limit}));
+
+    expect(rejected).toEqual(
+      Array.from({length: 4}, () => invalid('list_sessions limit must be a non-negative integer'))
+    );
+  });
+
+  it('rejects a cursor it cannot page by, naming the field it fails on', () => {
+    const unreadable = [
+      'not-an-object',
+      {updatedAt: '2026-01-01T00:00:00.000Z'},
+      {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: ''},
+      {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: 'a'.repeat(129)},
+      {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: 7},
+      {sessionId: 's1'},
+      {updatedAt: 'not-a-date', sessionId: 's1'},
+      {updatedAt: true, sessionId: 's1'},
+      {updatedAt: Number.NaN, sessionId: 's1'},
+    ].map(before => validateMessage({type: 'list_sessions', before}));
+
+    expect(unreadable).toEqual([
+      invalid('list_sessions before must be an object with updatedAt and sessionId'),
+      invalid('list_sessions before sessionId must be a string of 1 to 128 characters'),
+      invalid('list_sessions before sessionId must be a string of 1 to 128 characters'),
+      invalid('list_sessions before sessionId must be a string of 1 to 128 characters'),
+      invalid('list_sessions before sessionId must be a string of 1 to 128 characters'),
+      invalid('list_sessions before updatedAt must be a string or number that parses as a date'),
+      invalid('list_sessions before updatedAt must be a string or number that parses as a date'),
+      invalid('list_sessions before updatedAt must be a string or number that parses as a date'),
+      invalid('list_sessions before updatedAt must be a string or number that parses as a date'),
+    ]);
+  });
+});
