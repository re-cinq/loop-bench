+  if (!isValidOptionalLimit(message.limit)) {
+    return {valid: false, error: 'list_sessions limit must be a non-negative integer'};
+  }
+
+  const cursor = parseOptionalBefore(message.before);
+  if (cursor === null) {
+    return {valid: false, error: 'list_sessions before must have a valid updatedAt and sessionId'};
+  }
+
+  return {
+    valid: true,
+    data: {
+      type: 'list_sessions',
+      ...(message.limit !== undefined ? {limit: message.limit} : {}),
+      ...(cursor !== undefined ? {before: cursor} : {}),
+    },
+  };
