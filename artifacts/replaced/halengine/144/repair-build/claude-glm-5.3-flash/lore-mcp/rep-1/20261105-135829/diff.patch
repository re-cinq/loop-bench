+  if (!isValidSessionId(candidate.sessionId) || !isValidCursorTimestamp(candidate.updatedAt)) {
+    return null;
+  }
+
+  return {
+    updatedAt: candidate.updatedAt,
+    sessionId: candidate.sessionId,
+  };
