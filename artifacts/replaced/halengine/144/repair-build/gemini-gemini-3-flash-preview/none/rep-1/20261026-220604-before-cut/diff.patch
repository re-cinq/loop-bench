+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import type {Express} from 'express';
+import {createServer} from './createServer.js';
+import {
+  answeringOrchestrator,
+  eventually,
+  registerServer,
+  connectAndSettle as askAfterConnect,
+  stopEngines,
+} from './wsTestSupport.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {SessionCursor, SessionListOptions, SessionStore, SessionSummary} from '../types/sessionStore.js';
+import {setLogger} from '../shared/logger.js';
+
+// Real upgrades over a real socket: what the list_sessions frame answers is the contract, and no double can observe it.
+
+interface Frame {
+  type: string;
+  sessionId?: string;
+  conversations?: Array<{sessionId: string; createdAt: string; updatedAt: string; entryCount: number}>;
+  code?: string;
+  message?: string;
+}
+
+const logLines: Array<{level: string; category: string; message: string; fields?: Record<string, unknown>}> = [];
+
+beforeEach(() => {
+  logLines.length = 0;
+  const record = (level: string) => (category: string, message: string, fields?: Record<string, unknown>) =>
+    void logLines.push({level, category, message, fields});
+  setLogger({debug: record('debug'), info: record('info'), warn: record('warn'), error: record('error')});
+});
+
+afterEach(async () => {
+  await stopEngines();
+  setLogger();
+});
+
+const startEngine = async (store: SessionStore, userId: string | number = 'u1', history = {enabled: true}) => {
+  const hal = createServer({
+    app: (() => undefined) as unknown as Express,
+    wsAuth: async () => ({id: userId}),
+    sessionStore: store,
+    orchestrator: answeringOrchestrator,
+    history,
+    resume: {enabled: true},
+  });
+  await hal.start(0);
+  registerServer(hal);
+  const {port} = hal.server.address() as AddressInfo;
+  return `ws://127.0.0.1:${port}/hal/ws`;
+};
+
+// A store with only the five required members, so listFor can be omitted, recorded or made to throw.
+const delegatingTo = (inner: InMemorySessionStore): SessionStore => ({
+  create: (sessionId, userId, options) => inner.create(sessionId, userId, options),
+  get: sessionId => inner.get(sessionId),
+  delete: sessionId => inner.delete(sessionId),
+  count: () => inner.count(),
+  clear: () => inner.clear(),
+});
+
+describe('listing conversations over the WebSocket protocol', () => {
+  it('answers list_conversations for the authenticated user with ISO dates, forwarding limit and before while ignoring any client userId', async () => {
+    const inner = new InMemorySessionStore();
+    const seen: Array<{userId: string | number; options?: SessionListOptions}> = [];
+    const summaries: SessionSummary[] = [
+      {
+        sessionId: 's2',
+        createdAt: new Date('2026-01-01T00:00:00.000Z'),
+        updatedAt: new Date('2026-01-01T00:02:00.000Z'),
+        entryCount: 4,
+      },
+    ];
+    const store: SessionStore = {
+      ...delegatingTo(inner),
+      listFor: (userId, options) => {
+        seen.push({userId, options});
+        return summaries;
+      },
+    };
+    const url = await startEngine(store, 'u1');
+    const before: SessionCursor = {updatedAt: '2026-01-01T00:05:00.000Z', sessionId: 's3'};
+
+    const frames = await askAfterConnect(url, {type: 'list_conversations', limit: 10, before, userId: 'u2'});
+
+    expect({seen, frames}).toEqual({
+      seen: [{userId: 'u1', options: {limit: 10, before}}],
+      frames: expect.arrayContaining([
+        {
+          type: 'conversation_list',
+          conversations: [
+            {
+              sessionId: 's2',
+              createdAt: '2026-01-01T00:00:00.000Z',
+              updatedAt: '2026-01-01T00:02:00.000Z',
+              entryCount: 4,
+            },
+          ],
+        },
+      ]),
+    });
+  });
+
+  it('answers UNSUPPORTED when the feature is off or the store has no listFor, and SERVER_ERROR with a ws error log when listFor throws', async () => {
+    const inner = new InMemorySessionStore();
+    const featureOff = await startEngine(delegatingTo(inner), 'u1', {enabled: false});
+    const unimplemented = await startEngine(delegatingTo(inner));
+    const failingList = await startEngine({
+      ...delegatingTo(inner),
+      listFor: () => Promise.reject(new Error('database offline')),
+    });
+
+    const off = await askAfterConnect(featureOff, {type: 'list_conversations'});
+    const missing = await askAfterConnect(unimplemented, {type: 'list_conversations'});
+    const failed = await askAfterConnect(failingList, {type: 'list_conversations'});
+
+    expect({
+      off: off.filter(f => f.type === 'error').map(f => f.code),
+      missing: missing.filter(f => f.type === 'error').map(f => f.code),
+      failed: failed.filter(f => f.type === 'error').map(frame => ({type: frame.type, code: frame.code})),
+      logged: logLines.filter(line => line.level === 'error' && line.category === 'ws'),
+    }).toEqual({
+      off: ['UNSUPPORTED'],
+      missing: ['UNSUPPORTED'],
+      failed: [{type: 'error', code: 'SERVER_ERROR'}],
+      logged: [
+        {
+          level: 'error',
+          category: 'ws',
+          message: expect.any(String),
+          fields: expect.objectContaining({userId: 'u1', error: 'database offline'}),
+        },
+      ],
+    });
+  });
+
+  it('accepts a bare list_conversations frame and rejects a malformed limit or before with INVALID_MESSAGE without calling listFor', async () => {
+    const inner = new InMemorySessionStore();
+    let calls = 0;
+    const store: SessionStore = {
+      ...delegatingTo(inner),
+      listFor: () => {
+        calls += 1;
+        return [];
+      },
+    };
+    const url = await startEngine(store);
+    const badFrames = [
+      {type: 'list_conversations', limit: 'ten'},
+      {type: 'list_conversations', limit: 0},
+      {type: 'list_conversations', limit: 201},
+      {type: 'list_conversations', limit: 1.5},
+      {type: 'list_conversations', before: 'not-an-object'},
+      {type: 'list_conversations', before: {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: ''}},
+      {type: 'list_conversations', before: {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: 'a'.repeat(129)}},
+      {type: 'list_conversations', before: {updatedAt: 'not-a-date', sessionId: 's1'}},
+      {type: 'list_conversations', before: {updatedAt: true, sessionId: 's1'}},
+    ];
+
+    const codes: Array<string | undefined> = [];
+    for (const bad of badFrames) {
+      const frames = await askAfterConnect(url, bad);
+      codes.push(frames.find(f => f.type === 'error')?.code);
+    }
+    const accepted = await askAfterConnect(url, {type: 'list_conversations'});
+
+    expect({
+      codes,
+      accepted: accepted.filter(f => f.type !== 'connected' && f.type !== 'pong'),
+      calls,
+    }).toEqual({
+      codes: Array(badFrames.length).fill('INVALID_MESSAGE'),
+      accepted: [{type: 'conversation_list', conversations: []}],
+      calls: 1,
+    });
+  });
+
+  it('answers UNSUPPORTED when the store throws StoreCannotList', async () => {
+    const {StoreCannotList} = await import('../types/sessionStore.js');
+    const store = {
+      ...delegatingTo(new InMemorySessionStore()),
+      listFor: () => Promise.reject(new StoreCannotList('cannot list this collection')),
+    };
+    const url = await startEngine(store);
+
+    const frames = await askAfterConnect(url, {type: 'list_conversations'});
+
+    expect(frames.filter(f => f.type === 'error').map(f => ({code: f.code, message: f.message}))).toEqual([
+      {code: 'UNSUPPORTED', message: 'cannot list this collection'},
+    ]);
+  });
+
+  it('allows a client to reconnect with an id from a conversation_list and resume that session', async () => {
+    const inner = new InMemorySessionStore();
+    const store: SessionStore = {
+      ...delegatingTo(inner),
+      listFor: userId => inner.listFor!(userId),
+    };
+    const url = await startEngine(store, 'u1', {enabled: true});
+    const framesOnFirst = await askAfterConnect(url, {type: 'user_message', content: 'hello'});
+    const sessionId = (framesOnFirst[0] as any).sessionId!;
+
+    const frames = await askAfterConnect(url, {type: 'list_conversations'});
+    const list = frames.find(f => f.type === 'conversation_list')!;
+    const idFromList = list.conversations!.find(c => c.sessionId === sessionId)?.sessionId;
+
+    expect(idFromList).toBe(sessionId);
+
+    // Reconnect with the id from the list.
+    // We need to use connectAndSettle directly to check for resumed: true and the replay.
+    const resumedFrames = await askAfterConnect(`${url}?sessionId=${idFromList}`);
+
+    expect(resumedFrames[0]).toMatchObject({
+      type: 'connected',
+      sessionId: idFromList,
+      resumed: true,
+    });
+    expect(resumedFrames.some(f => f.type === 'entry_upsert' && f.entry.content === 'hello')).toBe(true);
+  });
+});
