+import {describe, expect, it} from '@jest/globals';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('beforeSession failure', () => {
+  it('passes the original session and error to onError specs/hal-engine-config-hooks/spec.md#6', async () => {
+    const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+    const error = new Error('setup failed');
+    let received: [ChatSession, Error] | undefined;
+    const provider: AIProvider = {
+      async *sendMessage() {},
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), undefined, {
+      hooks: {
+        beforeSession: async () => {
+          throw error;
+        },
+        onError: async (s, e) => {
+          received = [s, e];
+        },
+      },
+    });
+
+    const rejection: unknown = await orchestrator.processMessage(session).then(
+      () => undefined,
+      (reason: unknown) => reason
+    );
+    expect({rejectedWithOriginal: rejection === error, received}).toEqual({
+      rejectedWithOriginal: true,
+      received: [session, error],
+    });
+  });
+});
