+import {expect, it} from '@jest/globals';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+// @spec specs/hal-engine-config-hooks/spec.md#8
+it('releases a partial allocation when beforeSession rejects', async () => {
+  const session: ChatSession = {sessionId: 'partial', userId: 'user', entries: []};
+  const allocations = new Set<ChatSession>();
+  const failure = new Error('allocation failed');
+  const orchestrator = createChatOrchestrator(
+    createMockProvider(),
+    new PromptBuilder({baseSystemPrompt: 'HAL'}),
+    undefined,
+    {
+      hooks: {
+        beforeSession: async current => {
+          allocations.add(current);
+          throw failure;
+        },
+        afterSession: async current => {
+          allocations.delete(current);
+        },
+      },
+    }
+  );
+
+  await expect(orchestrator.processMessage(session)).rejects.toBe(failure);
+  expect(allocations.size).toBe(0);
+});
