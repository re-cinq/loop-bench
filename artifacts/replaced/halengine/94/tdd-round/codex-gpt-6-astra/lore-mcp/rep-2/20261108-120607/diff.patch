+import {expect, it} from '@jest/globals';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+it('releases a resource after beforeSession fails (specs/hal-engine-config-hooks/spec.md#7)', async () => {
+  const session: ChatSession = {sessionId: 'failed-start', userId: 'user', entries: []};
+  const resources = new Set<ChatSession>();
+  const failure = new Error('initialization failed');
+  const errors: {session: ChatSession; error: Error}[] = [];
+  const orchestrator = createChatOrchestrator(createMockProvider(), new PromptBuilder({identity: 'HAL'}), undefined, {
+    hooks: {
+      beforeSession: async current => {
+        resources.add(current);
+        throw failure;
+      },
+      onError: async (current, error) => {
+        errors.push({session: current, error});
+      },
+      afterSession: async current => {
+        resources.delete(current);
+      },
+    },
+  });
+
+  const rejection: unknown = await orchestrator.processMessage(session).catch((error: unknown) => error);
+
+  expect({
+    released: resources.size === 0,
+    reported: errors[0]?.error === failure,
+    session: errors[0]?.session === session,
+    rejected: rejection === failure,
+  }).toEqual({released: true, reported: true, session: true, rejected: true});
+});
