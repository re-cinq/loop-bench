+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+// One expect per test needs the rejection as a value rather than a matcher.
+const outcomeOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved without throwing').catch((error: Error) => error.message);
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's-acceptance',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// Answers normally and counts the asks: a fix that swallowed the failure would run the turn.
+const turnCounter = (): {provider: AIProvider; turns: () => number} => {
+  let asked = 0;
+
+  return {
+    turns: () => asked,
+    provider: {
+      async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        asked++;
+        yield {type: 'text', text: 'the turn ran'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    },
+  };
+};
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+// Only beforeSession throws; the hooks under observation record what they were handed.
+const hooksWithThrowingBeforeSession = (
+  hooks: Pick<OrchestratorHooks, 'onError' | 'afterSession'>
+): OrchestratorHooks => ({
+  ...hooks,
+  beforeSession: async () => {
+    throw new Error('beforeSession failed');
+  },
+});
+
+describe('ChatOrchestrator acceptance: a beforeSession that throws', () => {
+  it('hands a throwing beforeSession to onError and still rejects the caller with the same error', async () => {
+    let received: {sessionId: string; message: string} | undefined;
+    const {provider} = turnCounter();
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {
+      hooks: hooksWithThrowingBeforeSession({
+        onError: async (session, error) => {
+          received = {sessionId: session.sessionId, message: error.message};
+        },
+      }),
+    });
+    const outcome = await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({outcome, received}).toEqual({
+      outcome: 'beforeSession failed',
+      received: {sessionId: 's-acceptance', message: 'beforeSession failed'},
+    });
+  });
+
+  it('runs onError then afterSession for a throwing beforeSession, with a turn that never started', async () => {
+    const order: string[] = [];
+    let entriesAtCleanup = 0;
+    const {provider, turns} = turnCounter();
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {
+      hooks: hooksWithThrowingBeforeSession({
+        onError: async () => void order.push('onError'),
+        afterSession: async session => {
+          order.push('afterSession');
+          entriesAtCleanup = session.entries.length;
+        },
+      }),
+    });
+    const outcome = await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({outcome, order, entriesAtCleanup, providerTurns: turns()}).toEqual({
+      outcome: 'beforeSession failed',
+      order: ['onError', 'afterSession'],
+      entriesAtCleanup: 1,
+      providerTurns: 0,
+    });
+  });
+});