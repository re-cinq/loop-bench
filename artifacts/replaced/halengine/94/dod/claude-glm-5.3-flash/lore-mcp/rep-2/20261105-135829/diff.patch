+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+// One expect per test needs the rejection as a value rather than a matcher.
+const outcomeOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved without throwing').catch((error: Error) => error.message);
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// The turn must die in beforeSession: a provider call here means the throw found another way out.
+const unreachableProvider = (): AIProvider => ({
+  async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    throw new Error('provider reached despite beforeSession throwing');
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator hooks when beforeSession throws', () => {
+  it('runs onError and afterSession in order, then still rejects with the thrown error', async () => {
+    const callOrder: string[] = [];
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw new Error('before session failed');
+      },
+      onError: async () => void callOrder.push('onError'),
+      afterSession: async () => void callOrder.push('afterSession'),
+    };
+
+    const orchestrator = createChatOrchestrator(unreachableProvider(), promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({outcome, callOrder}).toEqual({
+      outcome: 'before session failed',
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+    });
+  });
+
+  it('hands onError the session and the error beforeSession threw', async () => {
+    const session = createSession('hello');
+    const thrown = new Error('before session failed');
+    let onErrorSession: ChatSession | undefined;
+    let onErrorError: Error | undefined;
+    let afterSessionSession: ChatSession | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw thrown;
+      },
+      onError: async (hookedSession, error) => {
+        onErrorSession = hookedSession;
+        onErrorError = error;
+      },
+      afterSession: async hookedSession => {
+        afterSessionSession = hookedSession;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(unreachableProvider(), promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(session));
+
+    expect({outcome, onErrorSession, onErrorError, afterSessionSession}).toEqual({
+      outcome: 'before session failed',
+      onErrorSession: session,
+      onErrorError: thrown,
+      afterSessionSession: session,
+    });
+  });
+});