+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+// One expect per test needs the rejection as a value rather than a matcher.
+const outcomeOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved without throwing').catch((error: Error) => error.message);
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// Records whether the turn reached the model at all: after a failed beforeSession it must not.
+const recordingProvider = (state: {called: boolean}): AIProvider => ({
+  async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    state.called = true;
+    yield {type: 'text', text: 'unreachable'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('beforeSession throwing', () => {
+  it('fires onError with the session and the thrown error, and still rejects', async () => {
+    const failure = new Error('before session failed');
+    const session = createSession('hello');
+    let receivedSession: ChatSession | undefined;
+    let receivedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw failure;
+      },
+      onError: async (seen, error) => {
+        receivedSession = seen;
+        receivedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(recordingProvider({called: false}), promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(session));
+
+    expect({
+      outcome,
+      onErrorGotSameSession: receivedSession === session,
+      onErrorGotErrorMessage: receivedError?.message,
+    }).toEqual({
+      outcome: 'before session failed',
+      onErrorGotSameSession: true,
+      onErrorGotErrorMessage: 'before session failed',
+    });
+  });
+
+  it('runs onError then afterSession on a session that never reached the provider', async () => {
+    const callOrder: string[] = [];
+    const providerState = {called: false};
+    const session = createSession('hello');
+    let providerCalledAtAfterSession = false;
+    let entriesAtAfterSession: string[] = [];
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw new Error('before session failed');
+      },
+      beforeUserInput: async (_session, userMessage) => {
+        callOrder.push('beforeUserInput');
+        return userMessage;
+      },
+      afterUserInput: async () => void callOrder.push('afterUserInput'),
+      beforeModelResponse: async (_session, systemPrompt) => {
+        callOrder.push('beforeModelResponse');
+        return systemPrompt;
+      },
+      afterModelResponse: async () => void callOrder.push('afterModelResponse'),
+      onError: async () => void callOrder.push('onError'),
+      afterSession: async () => {
+        callOrder.push('afterSession');
+        providerCalledAtAfterSession = providerState.called;
+        entriesAtAfterSession = session.entries.map(entry => entry.content);
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(recordingProvider(providerState), promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(session));
+
+    expect({outcome, callOrder, providerCalledAtAfterSession, entriesAtAfterSession}).toEqual({
+      outcome: 'before session failed',
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+      providerCalledAtAfterSession: false,
+      entriesAtAfterSession: ['hello'],
+    });
+  });
+});