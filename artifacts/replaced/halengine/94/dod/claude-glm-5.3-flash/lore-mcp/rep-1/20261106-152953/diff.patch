+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+// One expect per test needs the rejection as a value rather than a matcher.
+const outcomeOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved without throwing').catch((error: Error) => error.message);
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// Never reached on either path under test: beforeSession throws before the provider is consulted.
+function createUnreachedProvider(message: string): AIProvider {
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      throw new Error(`provider reached when it should not be: ${message}`);
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator when beforeSession throws', () => {
+  it('runs onError with the session and the thrown error, and still rejects the caller', async () => {
+    const failure = new Error('beforeSession failed');
+    const session = createSession('hello');
+    let receivedSession: ChatSession | undefined;
+    let receivedError: Error | undefined;
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw failure;
+      },
+      onError: async (hookedSession, error) => {
+        receivedSession = hookedSession;
+        receivedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createUnreachedProvider('onError'), promptBuilder, undefined, {
+      hooks,
+    });
+    const outcome = await outcomeOf(orchestrator.processMessage(session));
+
+    expect({outcome, sameSession: receivedSession === session, sameError: receivedError === failure}).toEqual({
+      outcome: 'beforeSession failed',
+      sameSession: true,
+      sameError: true,
+    });
+  });
+
+  it('runs afterSession after onError', async () => {
+    const callOrder: string[] = [];
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw new Error('beforeSession failed');
+      },
+      onError: async () => {
+        callOrder.push('onError');
+      },
+      afterSession: async () => {
+        callOrder.push('afterSession');
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createUnreachedProvider('afterSession'), promptBuilder, undefined, {
+      hooks,
+    });
+    const outcome = await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({outcome, callOrder}).toEqual({
+      outcome: 'beforeSession failed',
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+    });
+  });
+});