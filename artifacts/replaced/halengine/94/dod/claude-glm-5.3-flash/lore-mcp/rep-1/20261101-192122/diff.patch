+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+// One expect per test needs the rejection as a value rather than a matcher.
+const outcomeOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved without throwing').catch((error: Error) => error.message);
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// Records that the turn reached the provider at all; the hook under test must throw before it does.
+function createRecordingProvider(calls: string[]): AIProvider {
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      calls.push('provider');
+      yield {type: 'text', text: 'unreachable'};
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator beforeSession failure', () => {
+  it('runs onError and afterSession when beforeSession throws', async () => {
+    const callOrder: string[] = [];
+    const providerCalls: string[] = [];
+    const failure = new Error('beforeSession blew up');
+    const session = createSession('hello');
+    let receivedSession: ChatSession | undefined;
+    let receivedError: Error | undefined;
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw failure;
+      },
+      onError: async (hookedSession, error) => {
+        callOrder.push('onError');
+        receivedSession = hookedSession;
+        receivedError = error;
+      },
+      afterSession: async () => {
+        callOrder.push('afterSession');
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createRecordingProvider(providerCalls), promptBuilder, undefined, {
+      hooks,
+    });
+    const outcome = await outcomeOf(orchestrator.processMessage(session));
+
+    expect({
+      outcome,
+      callOrder,
+      onErrorGotTheSession: receivedSession === session,
+      onErrorGotTheThrow: receivedError === failure,
+      reachedTheProvider: providerCalls.length > 0,
+      committedAnEntry: session.entries.length !== 1,
+    }).toEqual({
+      outcome: 'beforeSession blew up',
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+      onErrorGotTheSession: true,
+      onErrorGotTheThrow: true,
+      reachedTheProvider: false,
+      committedAnEntry: false,
+    });
+  });
+});