@@ -0,0 +1,117 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import type {SessionStore} from '../types/sessionStore.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const FAILURE = 'beforeSession refused the session';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// Counting calls rather than recording them: the error path under test must make none.
+const countingProvider = (): {provider: AIProvider; callCount: () => number} => {
+  let calls = 0;
+
+  return {
+    callCount: () => calls,
+    provider: {
+      async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        calls++;
+        yield {type: 'text', text: 'ok'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    },
+  };
+};
+
+const recordingStore = (): {store: SessionStore; saved: string[]} => {
+  const saved: string[] = [];
+
+  const store: SessionStore = {
+    create: async (sessionId, userId) => ({sessionId, userId, entries: []}),
+    get: async () => undefined,
+    delete: async () => true,
+    count: async () => 0,
+    clear: async () => undefined,
+    save: async session => {
+      saved.push(session.sessionId);
+    },
+  };
+
+  return {store, saved};
+};
+
+// One expect per test needs the rejection as a value rather than a matcher.
+const outcomeOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved without throwing').catch((error: Error) => error.message);
+
+describe('ChatOrchestrator beforeSession error path', () => {
+  it('calls onError with the session and the error beforeSession threw, and still rejects the caller', async () => {
+    const thrown = new Error(FAILURE);
+    let receivedSessionId: string | undefined;
+    let receivedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw thrown;
+      },
+      onError: async (session, error) => {
+        receivedSessionId = session.sessionId;
+        receivedError = error;
+      },
+    };
+
+    const {provider} = countingProvider();
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({outcome, receivedSessionId, receivedError}).toEqual({
+      outcome: FAILURE,
+      receivedSessionId: 's1',
+      receivedError: thrown,
+    });
+  });
+
+  it('runs afterSession after onError over a turn that never started when beforeSession throws', async () => {
+    const callOrder: string[] = [];
+    let entriesAtAfterSession = -1;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw new Error(FAILURE);
+      },
+      onError: async () => void callOrder.push('onError'),
+      afterSession: async session => {
+        callOrder.push('afterSession');
+        entriesAtAfterSession = session.entries.length;
+      },
+    };
+
+    const {provider, callCount} = countingProvider();
+    const {store, saved} = recordingStore();
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks, sessionStore: store});
+    const outcome = await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({outcome, callOrder, entriesAtAfterSession, providerCalls: callCount(), saved}).toEqual({
+      outcome: FAILURE,
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+      entriesAtAfterSession: 1,
+      providerCalls: 0,
+      saved: ['s1'],
+    });
+  });
+});