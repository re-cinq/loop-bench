@@ -0,0 +1,81 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+// One expect per test needs the rejection as a value rather than a matcher.
+const outcomeOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved without throwing').catch((error: Error) => error.message);
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// Reached only if the orchestrator calls the provider after beforeSession failed, which the guarantee forbids.
+function createUnreachableProvider(): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw new Error('the provider must never be reached');
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator beforeSession failure path', () => {
+  it('runs onError and afterSession when beforeSession throws, and still rejects the caller', async () => {
+    const thrown = new Error('beforeSession failed');
+    const session = createSession('hello');
+    const callOrder: string[] = [];
+    let onErrorError: Error | undefined;
+    let onErrorSessionId: string | number | undefined;
+    let afterSessionSession: ChatSession | undefined;
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw thrown;
+      },
+      onError: async (hookedSession, error) => {
+        callOrder.push('onError');
+        onErrorError = error;
+        onErrorSessionId = hookedSession.sessionId;
+      },
+      afterSession: async hookedSession => {
+        callOrder.push('afterSession');
+        afterSessionSession = hookedSession;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createUnreachableProvider(), promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(session));
+
+    expect({
+      outcome,
+      callOrder,
+      onErrorGotThrownError: onErrorError === thrown,
+      onErrorSessionId,
+      afterSessionGotTheTurnSession: afterSessionSession === session,
+      afterSessionEntryContents: afterSessionSession?.entries.map(entry => entry.content),
+    }).toEqual({
+      outcome: 'beforeSession failed',
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+      onErrorGotThrownError: true,
+      onErrorSessionId: 's1',
+      afterSessionGotTheTurnSession: true,
+      afterSessionEntryContents: ['hello'],
+    });
+  });
+});