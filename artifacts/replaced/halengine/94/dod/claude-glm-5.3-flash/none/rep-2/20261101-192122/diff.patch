@@ -0,0 +1,105 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Acceptance tests for re-cinq/HALEngine#94: a throw from beforeSession must take the normal error path.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+// One expect per test needs the rejection as a value rather than a matcher.
+const rejectionOf = (call: Promise<unknown>): Promise<unknown> =>
+  call.then(
+    () => undefined,
+    (error: unknown) => error
+  );
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator hooks on a failed beforeSession', () => {
+  it('a throwing beforeSession runs onError then afterSession and still rejects with the thrown error', async () => {
+    const thrown = new Error('beforeSession failed');
+    const callOrder: string[] = [];
+    let sessionSeenByOnError: ChatSession | undefined;
+    let errorSeenByOnError: unknown;
+    const session = createSession('hello');
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw thrown;
+      },
+      onError: async (hookSession, error) => {
+        callOrder.push('onError');
+        sessionSeenByOnError = hookSession;
+        errorSeenByOnError = error;
+      },
+      afterSession: async () => void callOrder.push('afterSession'),
+    };
+
+    const orchestrator = createChatOrchestrator(providerThatRecords(), promptBuilder, undefined, {hooks});
+    const rejection = await rejectionOf(orchestrator.processMessage(session));
+
+    expect({
+      order: callOrder,
+      callerReceivesTheThrownError: rejection === thrown,
+      onErrorReceivesTheSession: sessionSeenByOnError === session,
+      onErrorReceivesTheError: errorSeenByOnError === thrown,
+    }).toEqual({
+      order: ['beforeSession', 'onError', 'afterSession'],
+      callerReceivesTheThrownError: true,
+      onErrorReceivesTheSession: true,
+      onErrorReceivesTheError: true,
+    });
+  });
+
+  it('hands afterSession a session the turn never touched', async () => {
+    const thrown = new Error('beforeSession failed');
+    let entriesSeenByAfterSession: unknown[] = [];
+    let providerWasCalled = false;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw thrown;
+      },
+      afterSession: async hookSession => {
+        entriesSeenByAfterSession = hookSession.entries;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      providerThatRecords(() => (providerWasCalled = true)),
+      promptBuilder,
+      undefined,
+      {
+        hooks,
+      }
+    );
+    await rejectionOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({providerWasCalled, entriesSeenByAfterSession}).toEqual({
+      providerWasCalled: false,
+      entriesSeenByAfterSession: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+    });
+  });
+});
+
+// The turn must never reach the provider on this path, so the provider exists only to record that it did.
+function providerThatRecords(onCall?: () => void): AIProvider {
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      onCall?.();
+      yield {type: 'text', text: 'the turn ran'};
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}