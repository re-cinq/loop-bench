@@ -0,0 +1,91 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+// One expect per test needs the rejection as a value rather than a matcher.
+const outcomeOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved without throwing').catch((error: Error) => error.message);
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+// The throw must land before the turn starts, so the provider records whether it was ever asked for anything.
+const untouchedProvider = (): {provider: AIProvider; wasCalled: () => boolean} => {
+  let called = false;
+
+  return {
+    wasCalled: () => called,
+    provider: {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        called = true;
+        yield {type: 'text', text: 'the turn never reached the provider'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    },
+  };
+};
+
+describe('a beforeSession that throws', () => {
+  it('runs onError with the session and the thrown error when beforeSession throws', async () => {
+    const session = createSession('hello');
+    const failure = new Error('before session failed');
+    let receivedSession: ChatSession | undefined;
+    let receivedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw failure;
+      },
+      onError: async (seenSession, error) => {
+        receivedSession = seenSession;
+        receivedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(untouchedProvider().provider, promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(session));
+
+    expect({outcome, receivedSession, receivedError}).toEqual({
+      outcome: 'before session failed',
+      receivedSession: session,
+      receivedError: failure,
+    });
+  });
+
+  it('still rejects the caller and runs afterSession when beforeSession throws', async () => {
+    const {provider, wasCalled} = untouchedProvider();
+    let afterSessionCalled = false;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw new Error('before session failed');
+      },
+      onError: async () => {},
+      afterSession: async () => {
+        afterSessionCalled = true;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({outcome, afterSessionCalled, providerWasCalled: wasCalled()}).toEqual({
+      outcome: 'before session failed',
+      afterSessionCalled: true,
+      providerWasCalled: false,
+    });
+  });
+});