@@ -0,0 +1,112 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed so a rerun cannot read the clock; nothing asserts on it.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+// One expect per test needs the rejection as a value rather than a matcher.
+const outcomeOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved without throwing').catch((error: Error) => error.message);
+
+const sessionFor = (content: string): ChatSession => ({
+  sessionId: 'hook-failure-s1',
+  userId: 'hook-failure-u1',
+  entries: [{role: 'user', content, timestamp: SENT_AT}],
+});
+
+// Counts sendMessage invocations, so a test can show the model was never reached.
+const countingProvider = (): {provider: AIProvider; calls: () => number} => {
+  let sent = 0;
+
+  return {
+    calls: () => sent,
+    provider: {
+      async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        sent++;
+        yield {type: 'text', text: 'unreachable'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    },
+  };
+};
+
+describe('beforeSession failure (issue #94)', () => {
+  it('routes a beforeSession throw through onError and afterSession and still rejects', async () => {
+    const thrown = new Error('span allocation failed');
+    const session = sessionFor('hello');
+    const order: string[] = [];
+    let onErrorSession: ChatSession | undefined;
+    let onErrorError: unknown;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        order.push('beforeSession');
+        throw thrown;
+      },
+      onError: async (hookSession, error) => {
+        order.push('onError');
+        onErrorSession = hookSession;
+        onErrorError = error;
+      },
+      afterSession: async () => {
+        order.push('afterSession');
+      },
+    };
+
+    const {provider} = countingProvider();
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(session));
+
+    expect({
+      outcome,
+      order,
+      sawSameSession: onErrorSession === session,
+      sawSameError: onErrorError === thrown,
+    }).toEqual({
+      outcome: 'span allocation failed',
+      order: ['beforeSession', 'onError', 'afterSession'],
+      sawSameSession: true,
+      sawSameError: true,
+    });
+  });
+
+  it('hands afterSession a session the failed turn never started', async () => {
+    const session = sessionFor('hello');
+    const {provider, calls} = countingProvider();
+    let afterSessionCalls = 0;
+    let entriesSeenInHook = -1;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw new Error('span allocation failed');
+      },
+      afterSession: async hookSession => {
+        afterSessionCalls++;
+        entriesSeenInHook = hookSession.entries.length;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(session));
+
+    expect({
+      outcome,
+      afterSessionCalls,
+      entriesSeenInHook,
+      entriesAfterTurn: session.entries.length,
+      providerCalls: calls(),
+    }).toEqual({
+      outcome: 'span allocation failed',
+      afterSessionCalls: 1,
+      entriesSeenInHook: 1,
+      entriesAfterTurn: 1,
+      providerCalls: 0,
+    });
+  });
+});