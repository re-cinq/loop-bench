+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+// One expect per test needs the rejection as a value rather than a matcher.
+const outcomeOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved without throwing').catch((error: Error) => error.message);
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// A provider the turn must never reach when beforeSession throws; reaching it fails the test loudly.
+function createUnusedProvider(): AIProvider {
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw new Error('the turn reached the provider after beforeSession threw');
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator hooks — a beforeSession that throws', () => {
+  it('fires onError with the session and the error, and the rejection still reaches the caller', async () => {
+    let receivedSessionId: string | number | undefined;
+    let receivedErrorMessage = 'onError was never called';
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw new Error('beforeSession failed');
+      },
+      onError: async (session, error) => {
+        receivedSessionId = session.sessionId;
+        receivedErrorMessage = error.message;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createUnusedProvider(), promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({outcome, receivedErrorMessage, receivedSessionId}).toEqual({
+      outcome: 'beforeSession failed',
+      receivedErrorMessage: 'beforeSession failed',
+      receivedSessionId: 's1',
+    });
+  });
+
+  it('runs afterSession after a failed beforeSession, for a session none of the turn has touched', async () => {
+    const fired: string[] = [];
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        fired.push('beforeSession');
+        throw new Error('beforeSession failed');
+      },
+      beforeUserInput: async (_session, userMessage) => {
+        fired.push('beforeUserInput');
+        return userMessage;
+      },
+      afterUserInput: async () => void fired.push('afterUserInput'),
+      beforeModelResponse: async (_session, systemPrompt) => {
+        fired.push('beforeModelResponse');
+        return systemPrompt;
+      },
+      afterModelResponse: async () => void fired.push('afterModelResponse'),
+      onError: async () => void fired.push('onError'),
+      afterSession: async () => void fired.push('afterSession'),
+    };
+
+    const orchestrator = createChatOrchestrator(createUnusedProvider(), promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({outcome, fired}).toEqual({
+      outcome: 'beforeSession failed',
+      fired: ['beforeSession', 'onError', 'afterSession'],
+    });
+  });
+});