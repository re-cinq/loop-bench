+import {createHalEngine} from '../config.js';
+import type {WsAuthenticator} from '../types/auth.js';
+import type {ChatSession} from '../types/session.js';
+
+// One expect per test needs the rejection as a value rather than a matcher.
+const outcomeOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved without throwing').catch((error: Error) => error.message);
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const base = {
+  provider: {type: 'mock' as const},
+  prompt: {identity: 'test'},
+  auth: {ws: (async () => null) as unknown as WsAuthenticator},
+};
+
+const sessionFor = (content: string): ChatSession => ({
+  sessionId: 's-hook-failure',
+  userId: 'u1',
+  entries: [{role: 'user', content, timestamp: SENT_AT}],
+});
+
+// Hooks go in through the config, the seam the spec calls supported, so the test runs the path a deployer runs.
+describe('a beforeSession that throws', () => {
+  it('still rejects the caller, and onError and afterSession both fire for it', async () => {
+    const failure = new Error('session setup failed');
+    const order: string[] = [];
+    let seenByOnError: {session: ChatSession; error: Error} | undefined;
+    let entryRolesAtAfterSession: string[] | undefined;
+
+    const session = sessionFor('hello');
+    const engine = createHalEngine({
+      ...base,
+      orchestrator: {
+        hooks: {
+          beforeSession: async () => {
+            order.push('beforeSession');
+            throw failure;
+          },
+          onError: async (hookedSession, error) => {
+            order.push('onError');
+            seenByOnError = {session: hookedSession, error};
+          },
+          afterSession: async hookedSession => {
+            order.push('afterSession');
+            entryRolesAtAfterSession = hookedSession.entries.map(entry => entry.role);
+          },
+        },
+      },
+    });
+
+    const outcome = await outcomeOf(engine.orchestrator.processMessage(session));
+
+    expect({outcome, order, seenByOnError, entryRolesAtAfterSession}).toEqual({
+      outcome: 'session setup failed',
+      order: ['beforeSession', 'onError', 'afterSession'],
+      seenByOnError: {session, error: failure},
+      entryRolesAtAfterSession: ['user'],
+    });
+  });
+});