+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+// One expect per test needs the rejection as a value rather than a matcher.
+const outcomeOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved without throwing').catch((error: Error) => error.message);
+
+const createSession = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+});
+
+// Never reached on this path: a turn that produced a model reply would prove the throw was swallowed.
+const answeringProvider = (): AIProvider => ({
+  async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'model reply'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+// specs/hal-engine-config-hooks/spec.md: a throw from beforeSession takes the same catch/finally path
+// as any other failure in the turn, so onError and afterSession both run and the rejection is unchanged.
+describe('ChatOrchestrator beforeSession error path', () => {
+  it('runs onError and still rejects with the same error when beforeSession throws', async () => {
+    const thrown = new Error('beforeSession failed');
+    let seenSessionId: string | number | undefined;
+    let seenError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw thrown;
+      },
+      onError: async (session, error) => {
+        seenSessionId = session.sessionId;
+        seenError = error;
+      },
+    };
+
+    const outcome = await outcomeOf(
+      createChatOrchestrator(answeringProvider(), promptBuilder, undefined, {hooks}).processMessage(createSession())
+    );
+
+    expect({
+      outcome,
+      onErrorSessionId: seenSessionId,
+      onErrorErrorMessage: seenError?.message,
+      onErrorSawSameInstance: seenError === thrown,
+    }).toEqual({
+      outcome: 'beforeSession failed',
+      onErrorSessionId: 's1',
+      onErrorErrorMessage: 'beforeSession failed',
+      onErrorSawSameInstance: true,
+    });
+  });
+
+  it('runs afterSession after onError when beforeSession throws', async () => {
+    const order: string[] = [];
+    let afterSessionSessionId: string | number | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw new Error('beforeSession failed');
+      },
+      onError: async () => {
+        order.push('onError');
+      },
+      afterSession: async session => {
+        order.push('afterSession');
+        afterSessionSessionId = session.sessionId;
+      },
+    };
+
+    const outcome = await outcomeOf(
+      createChatOrchestrator(answeringProvider(), promptBuilder, undefined, {hooks}).processMessage(createSession())
+    );
+
+    expect({outcome, order, afterSessionSessionId}).toEqual({
+      outcome: 'beforeSession failed',
+      order: ['onError', 'afterSession'],
+      afterSessionSessionId: 's1',
+    });
+  });
+});