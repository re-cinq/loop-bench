+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+// One expect per test needs the rejection as a value rather than a matcher.
+const outcomeOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved without throwing').catch((error: Error) => error.message);
+
+function createSession(): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+  };
+}
+
+// The turn must die in beforeSession, so a provider that runs is itself the failure under test.
+function createUnreachableProvider(): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      throw new Error('provider reached a turn that should have failed in beforeSession');
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('a beforeSession that throws', () => {
+  it('hands the thrown Error to onError with the session, and the same rejection still reaches the caller', async () => {
+    const thrown = new Error('beforeSession blew up');
+    const session = createSession();
+    let receivedSession: ChatSession | undefined;
+    let receivedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw thrown;
+      },
+      onError: async (hookSession, error) => {
+        receivedSession = hookSession;
+        receivedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createUnreachableProvider(), promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(session));
+
+    expect({outcome, sameSession: receivedSession === session, receivedError}).toEqual({
+      outcome: 'beforeSession blew up',
+      sameSession: true,
+      receivedError: thrown,
+    });
+  });
+
+  it('runs onError then afterSession, the same order as any other failed turn', async () => {
+    const callOrder: string[] = [];
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw new Error('beforeSession blew up');
+      },
+      onError: async () => {
+        callOrder.push('onError');
+      },
+      afterSession: async () => {
+        callOrder.push('afterSession');
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createUnreachableProvider(), promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(createSession()));
+
+    expect({outcome, callOrder}).toEqual({
+      outcome: 'beforeSession blew up',
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+    });
+  });
+});