+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const BOOM = new Error('beforeSession exploded');
+
+// One expect per test needs the rejection as a value rather than a matcher.
+const outcomeOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved without throwing').catch((error: Error) => error.message);
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// The turn must never reach a provider: the throw happens before any round is due.
+function createSilentProvider(): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw new Error('the provider was called on a turn whose beforeSession threw');
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator beforeSession failure', () => {
+  it('runs onError and afterSession for a throwing beforeSession and still rejects to the caller', async () => {
+    const session = createSession('hello');
+    const callOrder: string[] = [];
+    let receivedByOnError: {session: ChatSession; error: Error} | undefined;
+    let receivedByAfterSession: ChatSession | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw BOOM;
+      },
+      onError: async (hookedSession, error) => {
+        callOrder.push('onError');
+        receivedByOnError = {session: hookedSession, error};
+      },
+      afterSession: async hookedSession => {
+        callOrder.push('afterSession');
+        receivedByAfterSession = hookedSession;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createSilentProvider(), promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(session));
+
+    expect({
+      outcome,
+      callOrder,
+      onErrorGotSameSession: receivedByOnError?.session === session,
+      onErrorGotSameError: receivedByOnError?.error === BOOM,
+      afterSessionGotSameSession: receivedByAfterSession === session,
+    }).toEqual({
+      outcome: 'beforeSession exploded',
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+      onErrorGotSameSession: true,
+      onErrorGotSameError: true,
+      afterSessionGotSameSession: true,
+    });
+  });
+
+  it('hands afterSession a session the failed turn never touched', async () => {
+    const session = createSession('hello');
+    let entryCountAtAfterSession: number | undefined;
+    let anythingLeftStreaming: boolean | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw BOOM;
+      },
+      onError: async () => {},
+      afterSession: async hookedSession => {
+        entryCountAtAfterSession = hookedSession.entries.length;
+        anythingLeftStreaming = hookedSession.entries.some(entry => 'isStreaming' in entry && entry.isStreaming);
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createSilentProvider(), promptBuilder, undefined, {hooks});
+    await outcomeOf(orchestrator.processMessage(session));
+
+    expect({entryCountAtAfterSession, anythingLeftStreaming}).toEqual({
+      entryCountAtAfterSession: 1,
+      anythingLeftStreaming: false,
+    });
+  });
+});