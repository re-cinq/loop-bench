@@ -0,0 +1,64 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createBedrockProvider} from '../providers/bedrock/bedrockProvider.js';
+import type {ChatSession} from '../types/session.js';
+
+// @spec specs/hal-engine-config-hooks/spec.md#7
+it('reports and cleans up a failed beforeSession before rejecting with the original error', async () => {
+  const session: ChatSession = {
+    sessionId: 'failed-initialization',
+    userId: 'user',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const failure = new Error('session initialization failed');
+  const resources = new Set<ChatSession>();
+  const events: string[] = [];
+  let errorSession: ChatSession | undefined;
+  let reportedError: Error | undefined;
+  let cleanupSession: ChatSession | undefined;
+  const hooks: OrchestratorHooks = {
+    beforeSession: async current => {
+      resources.add(current);
+      events.push('beforeSession');
+      await Promise.resolve();
+      throw failure;
+    },
+    beforeUserInput: async (_current, message) => {
+      events.push('beforeUserInput');
+      return message;
+    },
+    onError: async (current, error) => {
+      await Promise.resolve();
+      errorSession = current;
+      reportedError = error;
+      events.push('onError');
+    },
+    afterSession: async current => {
+      await Promise.resolve();
+      cleanupSession = current;
+      resources.delete(current);
+      events.push('afterSession');
+    },
+  };
+  // The real provider is never reached when session initialization fails.
+  const provider = createBedrockProvider({type: 'bedrock', modelId: 'unused', region: 'eu-west-1', maxTokens: 1});
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Assistant'}), undefined, {hooks});
+  const outcome: unknown = await orchestrator.processMessage(session).catch((error: unknown) => error);
+
+  expect({
+    originalRejection: outcome === failure,
+    errorSession: errorSession === session,
+    originalReportedError: reportedError === failure,
+    cleanupSession: cleanupSession === session,
+    remainingResources: resources.size,
+    events,
+  }).toEqual({
+    originalRejection: true,
+    errorSession: true,
+    originalReportedError: true,
+    cleanupSession: true,
+    remainingResources: 0,
+    events: ['beforeSession', 'onError', 'afterSession'],
+  });
+});