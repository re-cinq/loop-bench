@@ -0,0 +1,69 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createBedrockProvider} from '../providers/bedrock/bedrockProvider.js';
+import type {ChatSession} from '../types/session.js';
+
+// @spec specs/hal-engine-config-hooks/spec.md#7
+it('reports and cleans up a failed beforeSession before rejecting with the original error', async () => {
+  const session: ChatSession = {
+    sessionId: 'failed-start',
+    userId: 'deployer',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const failure = new Error('session initialization failed');
+  const events: string[] = [];
+  const allocations = new Set<ChatSession>();
+  let errorSession: ChatSession | undefined;
+  let reportedError: Error | undefined;
+  let cleanupSession: ChatSession | undefined;
+  const provider = createBedrockProvider({
+    type: 'bedrock',
+    region: 'eu-west-1',
+    modelId: 'anthropic.claude-3-haiku-20240307-v1:0',
+    maxTokens: 16,
+  });
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Test assistant'}), undefined, {
+    hooks: {
+      beforeSession: async current => {
+        events.push('beforeSession');
+        allocations.add(current);
+        throw failure;
+      },
+      beforeUserInput: async (_current, message) => {
+        events.push('beforeUserInput');
+        return message;
+      },
+      onError: async (current, error) => {
+        await Promise.resolve();
+        events.push('onError');
+        errorSession = current;
+        reportedError = error;
+      },
+      afterSession: async current => {
+        await Promise.resolve();
+        events.push('afterSession');
+        cleanupSession = current;
+        allocations.delete(current);
+      },
+    },
+  });
+
+  const rejectedWith = await orchestrator.processMessage(session).catch((error: unknown) => error);
+  events.push('caller');
+
+  expect({
+    originalRejection: rejectedWith === failure,
+    errorSession: errorSession === session,
+    originalReportedError: reportedError === failure,
+    cleanupSession: cleanupSession === session,
+    remainingAllocations: allocations.size,
+    events,
+  }).toEqual({
+    originalRejection: true,
+    errorSession: true,
+    originalReportedError: true,
+    cleanupSession: true,
+    remainingAllocations: 0,
+    events: ['beforeSession', 'onError', 'afterSession', 'caller'],
+  });
+});