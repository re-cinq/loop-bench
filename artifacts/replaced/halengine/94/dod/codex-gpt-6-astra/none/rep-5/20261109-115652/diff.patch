+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createBedrockProvider} from '../providers/bedrock/index.js';
+import type {ChatSession} from '../types/session.js';
+
+// @spec specs/hal-engine-config-hooks/spec.md#7
+it('reports and cleans up a beforeSession failure before rejecting with the original error', async () => {
+  const session: ChatSession = {
+    sessionId: 'failed-start',
+    userId: 'user-1',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const failure = new Error('session initialization failed');
+  const events: string[] = [];
+  const resources = new Set<ChatSession>();
+  let errorArgumentsMatch = false;
+  let cleanupSessionMatches = false;
+  // The real provider is constructed but the failed hook must prevent reaching it.
+  const provider = createBedrockProvider({
+    type: 'bedrock',
+    modelId: 'anthropic.claude-3-haiku-20240307-v1:0',
+    region: 'us-east-1',
+    maxTokens: 32,
+  });
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), undefined, {
+    hooks: {
+      beforeSession: async current => {
+        resources.add(current);
+        events.push('beforeSession');
+        throw failure;
+      },
+      beforeUserInput: async (_current, message) => {
+        events.push('beforeUserInput');
+        return message;
+      },
+      onError: async (current, error) => {
+        await Promise.resolve();
+        errorArgumentsMatch = current === session && error === failure;
+        events.push('onError');
+      },
+      afterSession: async current => {
+        await Promise.resolve();
+        cleanupSessionMatches = current === session;
+        resources.delete(current);
+        events.push('afterSession');
+      },
+    },
+  });
+
+  const rejectedWithOriginal = await orchestrator.processMessage(session).then(
+    () => false,
+    (error: unknown) => {
+      events.push('rejected');
+      return error === failure;
+    }
+  );
+
+  expect({events, rejectedWithOriginal, errorArgumentsMatch, cleanupSessionMatches, resources: resources.size}).toEqual(
+    {
+      events: ['beforeSession', 'onError', 'afterSession', 'rejected'],
+      rejectedWithOriginal: true,
+      errorArgumentsMatch: true,
+      cleanupSessionMatches: true,
+      resources: 0,
+    }
+  );
+});