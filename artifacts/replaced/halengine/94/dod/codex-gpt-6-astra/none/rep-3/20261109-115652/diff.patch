@@ -0,0 +1,68 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createBedrockProvider} from '../providers/bedrock/index.js';
+import type {ChatSession} from '../types/session.js';
+
+// @spec specs/hal-engine-config-hooks/spec.md#7
+it('reports a beforeSession failure and finishes cleanup before rejecting with the original error', async () => {
+  const session: ChatSession = {
+    sessionId: 'failed-setup',
+    userId: 'user',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const failure = new Error('session setup failed after allocation');
+  const allocated = new Set<ChatSession>();
+  const events: string[] = [];
+  let reportedSession: ChatSession | undefined;
+  let reportedError: Error | undefined;
+  let cleanedSession: ChatSession | undefined;
+  const orchestrator = createChatOrchestrator(
+    createBedrockProvider({type: 'bedrock', modelId: 'unused', region: 'us-east-1', maxTokens: 1}),
+    new PromptBuilder({identity: 'You are a test assistant.'}),
+    undefined,
+    {
+      hooks: {
+        beforeSession: async current => {
+          allocated.add(current);
+          events.push('beforeSession');
+          throw failure;
+        },
+        beforeUserInput: async (_current, message) => {
+          events.push('beforeUserInput');
+          return message;
+        },
+        onError: async (current, error) => {
+          await Promise.resolve();
+          reportedSession = current;
+          reportedError = error;
+          events.push('onError');
+        },
+        afterSession: async current => {
+          await Promise.resolve();
+          cleanedSession = current;
+          allocated.delete(current);
+          events.push('afterSession');
+        },
+      },
+    }
+  );
+
+  const rejection: unknown = await orchestrator.processMessage(session).catch((error: unknown) => error);
+  events.push('caller');
+
+  expect({
+    originalRejection: rejection === failure,
+    originalErrorReported: reportedError === failure,
+    originalSessionReported: reportedSession === session,
+    originalSessionCleaned: cleanedSession === session,
+    allocationsRemaining: allocated.size,
+    events,
+  }).toEqual({
+    originalRejection: true,
+    originalErrorReported: true,
+    originalSessionReported: true,
+    originalSessionCleaned: true,
+    allocationsRemaining: 0,
+    events: ['beforeSession', 'onError', 'afterSession', 'caller'],
+  });
+});