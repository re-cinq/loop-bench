+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {createBedrockProvider} from '../providers/bedrock/index.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+// @spec specs/hal-engine-config-hooks/spec.md#8
+it('reports and cleans up a failed beforeSession before rejecting with the original error', async () => {
+  const session: ChatSession = {
+    sessionId: 'failed-start',
+    userId: 'user',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const failure = new Error('session initialization failed');
+  const events: string[] = [];
+  const errors: unknown[][] = [];
+  const cleaned: ChatSession[] = [];
+  const hooks: OrchestratorHooks = {
+    beforeSession: async () => {
+      events.push('beforeSession');
+      throw failure;
+    },
+    beforeUserInput: async (_session, message) => {
+      events.push('beforeUserInput');
+      return message;
+    },
+    afterUserInput: async () => {
+      events.push('afterUserInput');
+    },
+    beforeModelResponse: async (_session, prompt) => {
+      events.push('beforeModelResponse');
+      return prompt;
+    },
+    afterModelResponse: async () => {
+      events.push('afterModelResponse');
+    },
+    onError: async (...args) => {
+      events.push('onError');
+      errors.push(args);
+    },
+    afterSession: async received => {
+      events.push('afterSession');
+      cleaned.push(received);
+    },
+  };
+  const provider = createBedrockProvider({type: 'bedrock', modelId: 'unused', region: 'us-east-1', maxTokens: 1});
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Assistant'}), undefined, {hooks});
+
+  const rejection: unknown = await orchestrator.processMessage(session).catch((error: unknown) => error);
+
+  expect({
+    originalRejection: rejection === failure,
+    events,
+    errorArgumentCount: errors[0]?.length,
+    errorSession: errors[0]?.[0] === session,
+    originalError: errors[0]?.[1] === failure,
+    cleanupSession: cleaned[0] === session,
+  }).toEqual({
+    originalRejection: true,
+    events: ['beforeSession', 'onError', 'afterSession'],
+    errorArgumentCount: 2,
+    errorSession: true,
+    originalError: true,
+    cleanupSession: true,
+  });
+});