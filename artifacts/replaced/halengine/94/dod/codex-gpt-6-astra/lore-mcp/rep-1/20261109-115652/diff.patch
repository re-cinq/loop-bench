@@ -0,0 +1,74 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createBedrockProvider} from '../providers/bedrock/index.js';
+import type {ChatSession} from '../types/session.js';
+
+// @spec specs/hal-engine-config-hooks/spec.md#7
+it('reports and cleans up a failed beforeSession before rejecting with the original error', async () => {
+  const session: ChatSession = {
+    sessionId: 'failed-start',
+    userId: 'user',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const failure = new Error('session initialization failed');
+  const resources = new Set<ChatSession>();
+  const events: string[] = [];
+  let errorArguments: unknown[] = [];
+  let cleanupArguments: unknown[] = [];
+  const orchestrator = createChatOrchestrator(
+    createBedrockProvider({type: 'bedrock', modelId: 'unused', region: 'eu-west-1', maxTokens: 1}),
+    new PromptBuilder({identity: 'You are an assistant.'}),
+    undefined,
+    {
+      hooks: {
+        beforeSession: async currentSession => {
+          resources.add(currentSession);
+          events.push('beforeSession');
+          await Promise.resolve();
+          throw failure;
+        },
+        beforeUserInput: async (_session, message) => {
+          events.push('beforeUserInput');
+          return message;
+        },
+        beforeModelResponse: async (_session, prompt) => {
+          events.push('beforeModelResponse');
+          return prompt;
+        },
+        afterModelResponse: async () => {
+          events.push('afterModelResponse');
+        },
+        onError: async (...args) => {
+          await Promise.resolve();
+          errorArguments = args;
+          events.push('onError');
+        },
+        afterSession: async (...args) => {
+          await Promise.resolve();
+          cleanupArguments = args;
+          resources.delete(args[0]);
+          events.push('afterSession');
+        },
+      },
+    }
+  );
+
+  const rejection: unknown = await orchestrator.processMessage(session).catch((error: unknown) => {
+    events.push('caller rejection');
+    return error;
+  });
+
+  expect({
+    events,
+    originalRejection: rejection === failure,
+    errorArguments: errorArguments.length === 2 && errorArguments[0] === session && errorArguments[1] === failure,
+    cleanupArguments: cleanupArguments.length === 1 && cleanupArguments[0] === session,
+    resourcesRemaining: resources.size,
+  }).toEqual({
+    events: ['beforeSession', 'onError', 'afterSession', 'caller rejection'],
+    originalRejection: true,
+    errorArguments: true,
+    cleanupArguments: true,
+    resourcesRemaining: 0,
+  });
+});