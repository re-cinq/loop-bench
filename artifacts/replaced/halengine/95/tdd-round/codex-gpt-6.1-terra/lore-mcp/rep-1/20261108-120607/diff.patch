@@ -343,3 +344,14 @@ async function saveSession(store: SessionStore | undefined, session: ChatSession
     log.error('orchestrator', 'session save failed', {sessionId: session.sessionId, error: message});
   }
 }
+
+function errorForHook(error: unknown): Error {
+  if (error instanceof Error) return error;
+  let message: string;
+  try {
+    message = String(error);
+  } catch {
+    message = 'Unknown rejection';
+  }
+  return new Error(message, {cause: error});
+}
