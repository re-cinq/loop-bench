+import {observeRejection} from './onErrorTestHelper.js';
+
+it('preserves non-Error rejection causes and caller values (specs/hal-engine-config-hooks/spec.md#8)', async () => {
+  const values: unknown[] = ['string boom', {code: 503}, undefined];
+  const results = [];
+  for (const reason of values) {
+    const {outcome, seen} = await observeRejection(reason);
+    results.push({outcome, count: seen.length, isError: seen[0] instanceof Error, cause: seen[0]?.cause === reason});
+  }
+  expect(results).toEqual(
+    values.map(() => ({outcome: {rejected: true, original: true}, count: 1, isError: true, cause: true}))
+  );
+});
