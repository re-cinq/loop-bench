+import {observeRejection} from './onErrorTestHelper.js';
+
+it('reports a rejection whose string conversion throws (specs/hal-engine-config-hooks/spec.md#8)', async () => {
+  const reason = {
+    toString() {
+      throw new Error('conversion failed');
+    },
+  };
+  const {outcome, seen} = await observeRejection(reason);
+  expect({
+    outcome: outcome.rejected && outcome.original,
+    count: seen.length,
+    isError: seen[0] instanceof Error,
+    cause: seen[0]?.cause,
+    message: seen[0]?.message,
+  }).toEqual({
+    outcome: true,
+    count: 1,
+    isError: true,
+    cause: reason,
+    message: expect.any(String),
+  });
+});
