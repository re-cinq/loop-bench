@@ -0,0 +1,77 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+const rejectingProvider = (reason: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw reason;
+  },
+  async generateStructured<T>(): Promise<T> {
+    throw reason;
+  },
+});
+
+// @spec specs/hal-engine-config-hooks/spec.md#8
+it('preserves a rejected string as the onError cause and caller rejection', async () => {
+  const errors: Error[] = [];
+  const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+  const orchestrator = createChatOrchestrator(
+    rejectingProvider('string boom'),
+    new PromptBuilder({identity: 'Test assistant'}),
+    undefined,
+    {
+      hooks: {
+        beforeSession: async () => Promise.reject('string boom'),
+        onError: async (_session, error) => void errors.push(error),
+      },
+    }
+  );
+
+  const outcome = await orchestrator.processMessage(session).then(
+    value => ({resolved: value}),
+    (reason: unknown) => ({rejected: reason})
+  );
+
+  expect({
+    outcome,
+    errors: errors.map(error => ({
+      isError: error instanceof Error,
+      message: error.message,
+      cause: error.cause,
+    })),
+  }).toEqual({
+    outcome: {rejected: 'string boom'},
+    errors: [{isError: true, message: 'string boom', cause: 'string boom'}],
+  });
+});
+
+it('preserves a null-prototype rejection as the onError cause and caller rejection', async () => {
+  const reason = {__proto__: null, code: 503};
+  const errors: Error[] = [];
+  const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+  const orchestrator = createChatOrchestrator(
+    rejectingProvider(reason),
+    new PromptBuilder({identity: 'Test assistant'}),
+    undefined,
+    {hooks: {onError: async (_session, error) => void errors.push(error)}}
+  );
+
+  const outcome = await orchestrator.processMessage(session).then(
+    () => false,
+    (rejection: unknown) => rejection === reason
+  );
+
+  expect({
+    originalRejection: outcome,
+    errors: errors.map(error => ({
+      isError: error instanceof Error,
+      hasMessage: error.message.length > 0,
+      originalCause: error.cause === reason,
+    })),
+  }).toEqual({
+    originalRejection: true,
+    errors: [{isError: true, hasMessage: true, originalCause: true}],
+  });
+});
