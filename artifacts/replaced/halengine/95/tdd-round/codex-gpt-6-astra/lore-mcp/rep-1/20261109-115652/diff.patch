@@ -0,0 +1,25 @@
+import {normalizeHookError} from './hookError.js';
+
+// @spec specs/hal-engine-config-hooks/spec.md#9
+it('preserves Errors and wraps string, object and undefined rejections with their cause', () => {
+  const original = new Error('provider failed');
+  const reasons: unknown[] = ['string boom', {code: 503}, undefined];
+  const wrapped = reasons.map(reason => {
+    const error = normalizeHookError(reason);
+    return {
+      isError: error instanceof Error,
+      message: error.message,
+      hasCause: Object.hasOwn(error, 'cause'),
+      sameCause: error.cause === reason,
+    };
+  });
+
+  expect({sameError: normalizeHookError(original) === original, wrapped}).toEqual({
+    sameError: true,
+    wrapped: [
+      {isError: true, message: 'string boom', hasCause: true, sameCause: true},
+      {isError: true, message: 'Non-Error rejection', hasCause: true, sameCause: true},
+      {isError: true, message: 'Non-Error rejection', hasCause: true, sameCause: true},
+    ],
+  });
+});
diff --git a/src/orchestration/hookError.ts b/src/orchestration/hookError.ts
new file mode 100644
index 0000000..587333b
--- /dev/null
+++ b/src/orchestration/hookError.ts
@@ -0,0 +1,4 @@
+export function normalizeHookError(reason: unknown): Error {
+  if (reason instanceof Error) return reason;
+  return new Error(typeof reason === 'string' ? reason : 'Non-Error rejection', {cause: reason});
+}
