+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const rejectingWith = (reason: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield -- Rejection occurs before the first chunk.
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw reason;
+  },
+  async generateStructured<T>(): Promise<T> {
+    throw new Error('Not used in this turn');
+  },
+});
+
+// @spec specs/hal-engine-config-hooks/spec.md#8
+it('reports every provider rejection once with its original cause and preserves the caller rejection', async () => {
+  const reasons: unknown[] = ['string boom', {code: 503}, undefined, new Error('provider failed')];
+  for (const reason of reasons) {
+    const session: ChatSession = {sessionId: 'session', userId: 'user', entries: []};
+    const errors: Error[] = [];
+    const order: string[] = [];
+    const orchestrator = createChatOrchestrator(
+      rejectingWith(reason),
+      new PromptBuilder({identity: 'Test assistant'}),
+      undefined,
+      {
+        hooks: {
+          onError: async (receivedSession, error) => {
+            if (receivedSession === session) order.push('onError');
+            errors.push(error);
+          },
+          afterSession: async () => {
+            order.push('afterSession');
+          },
+        },
+      }
+    );
+    const outcome = await orchestrator.processMessage(session).then(
+      () => ({rejected: false, reason: undefined}),
+      (caught: unknown) => ({rejected: true, reason: caught})
+    );
+
+    expect({
+      rejected: outcome.rejected,
+      sameRejection: outcome.reason === reason,
+      order,
+      count: errors.length,
+      isError: errors[0] instanceof Error,
+      original: reason instanceof Error ? errors[0] === reason : errors[0]?.cause === reason,
+      hasCause: reason instanceof Error || Object.hasOwn(errors[0] ?? {}, 'cause'),
+    }).toEqual({
+      rejected: true,
+      sameRejection: true,
+      order: ['onError', 'afterSession'],
+      count: 1,
+      isError: true,
+      original: true,
+      hasCause: true,
+    });
+  }
+});
