+describe('toRejectionError', () => {
+  // The catch hands onError this: the thrown value when it already is one, else a wrapper with the original as cause.
+  it('wraps a string, object, or undefined rejection with a readable message and the original as cause, and passes an Error through unchanged', () => {
+    const thrown = {code: 503, detail: 'upstream down'};
+    const original = new AIError('rate limited', 'RATE_LIMITED');
+
+    expect(toRejectionError(original)).toBe(original);
+
+    const asString = toRejectionError('string boom');
+    expect(asString.message).toBe('string boom');
+    expect(asString.cause).toBe('string boom');
+
+    const asObject = toRejectionError(thrown);
+    expect(asObject.message.length).toBeGreaterThan(0);
+    expect(asObject.cause).toBe(thrown);
+
+    const asUndefined = toRejectionError(undefined);
+    expect(asUndefined.message.length).toBeGreaterThan(0);
+    expect(asUndefined.cause).toBe(undefined);
+  });
+});
diff --git a/src/orchestration/orchestratorHelpers.ts b/src/orchestration/orchestratorHelpers.ts
index 717eb9a..14d30af 100644
--- a/src/orchestration/orchestratorHelpers.ts
+++ b/src/orchestration/orchestratorHelpers.ts
@@ -40,3 +40,19 @@ export function extractStopReason(chunk: MessageChunk): string | null {
 export function extractUsage(chunk: MessageChunk): UsageMetadata | undefined {
   return chunk.type === 'stop' ? chunk.usage : undefined;
 }
+
+// A hook is typed against Error, so a rejection that is not one is wrapped, keeping the thrown value as cause.
+export function toRejectionError(reason: unknown): Error {
+  if (reason instanceof Error) return reason;
+  return new Error(readableRejection(reason), {cause: reason});
+}
+
+// JSON.stringify has no answer for undefined and throws on a circular reason, and the catch must not throw its own.
+function readableRejection(reason: unknown): string {
+  if (typeof reason === 'string') return reason;
+  try {
+    return JSON.stringify(reason) ?? String(reason);
+  } catch {
+    return String(reason);
+  }
+}