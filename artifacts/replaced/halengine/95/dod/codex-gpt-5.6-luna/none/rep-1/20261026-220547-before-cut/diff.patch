diff --git a/src/orchestration/onErrorRejection.acceptance.test.ts b/src/orchestration/onErrorRejection.acceptance.test.ts
new file mode 100644
index 0000000..c8662bf
--- /dev/null
+++ b/src/orchestration/onErrorRejection.acceptance.test.ts
@@ -0,0 +1,102 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const RESOLVED = Symbol('resolved');
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+const existingError = new Error('provider failed');
+
+const nonErrorCases: Array<[string, unknown]> = [
+  ['a string', 'provider failed'],
+  ['a plain object', {code: 'PROVIDER_FAILED'}],
+  ['undefined', undefined],
+];
+
+async function captureOnErrorArg(rejection: unknown): Promise<Error | undefined> {
+  let received: Error | undefined;
+  const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {
+    hooks: {
+      onError: async (_s, e) => {
+        received = e;
+      },
+    },
+  });
+  await orchestrator.processMessage(createSession()).catch(() => {});
+  return received;
+}
+
+async function countOnErrorCalls(rejection: unknown): Promise<number> {
+  let calls = 0;
+  const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {
+    hooks: {
+      onError: async () => {
+        calls += 1;
+      },
+    },
+  });
+  await orchestrator.processMessage(createSession()).catch(() => {});
+  return calls;
+}
+
+async function captureCallerRejection(rejection: unknown): Promise<unknown> {
+  const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {
+    hooks: {onError: async () => {}},
+  });
+  return orchestrator.processMessage(createSession()).then(
+    () => RESOLVED,
+    e => e
+  );
+}
+
+function createSession(): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+  };
+}
+
+function rejectingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+describe('calls onError for every rejection and preserves the caller rejection', () => {
+  it.each(nonErrorCases)('onError is called once for non-Error %s', async (_label, rejection) => {
+    expect(await countOnErrorCalls(rejection)).toBe(1);
+  });
+
+  it.each(nonErrorCases)('non-Error %s is wrapped in an Error for onError', async (_label, rejection) => {
+    expect(await captureOnErrorArg(rejection)).toBeInstanceOf(Error);
+  });
+
+  it.each(nonErrorCases)('non-Error %s becomes the cause on the wrapped Error', async (_label, rejection) => {
+    expect((await captureOnErrorArg(rejection))?.cause).toBe(rejection);
+  });
+
+  it.each(nonErrorCases)('caller still receives original non-Error %s unchanged', async (_label, rejection) => {
+    expect(await captureCallerRejection(rejection)).toBe(rejection);
+  });
+
+  it('onError is called once for an existing Error', async () => {
+    expect(await countOnErrorCalls(existingError)).toBe(1);
+  });
+
+  it('existing Error is passed to onError as the same instance', async () => {
+    expect(await captureOnErrorArg(existingError)).toBe(existingError);
+  });
+
+  it('caller receives existing Error instance unchanged', async () => {
+    expect(await captureCallerRejection(existingError)).toBe(existingError);
+  });
+});