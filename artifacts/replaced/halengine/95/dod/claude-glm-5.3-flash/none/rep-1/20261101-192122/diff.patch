@@ -0,0 +1,91 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// Rejects before its first chunk, the way a provider wrapping a failing SDK call does.
+const rejectingProvider = (rejection: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+// The rejection itself as a value, not a matcher on it: a non-Error rejection has no `.message`.
+const outcomeOf = (call: Promise<unknown>): Promise<unknown> =>
+  call.then(
+    () => 'resolved without throwing',
+    (caught: unknown) => caught
+  );
+
+describe('ChatOrchestrator onError for every rejection', () => {
+  it('reports a rejection that is not an Error to onError wrapped in one, with the original as its cause, and still rejects the caller with the original value', async () => {
+    const rejections: unknown[] = ['provider exploded', {reason: 'provider exploded'}, undefined];
+
+    for (const rejection of rejections) {
+      let onErrorCalls = 0;
+      let receivedError: Error | undefined;
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          onErrorCalls += 1;
+          receivedError = error;
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+      const callerOutcome = await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+      expect({
+        rejection,
+        onErrorCalls,
+        isAnError: receivedError instanceof Error,
+        causeIsOriginal: receivedError?.cause === rejection,
+        callerGetsOriginal: callerOutcome === rejection,
+      }).toEqual({
+        rejection,
+        onErrorCalls: 1,
+        isAnError: true,
+        causeIsOriginal: true,
+        callerGetsOriginal: true,
+      });
+    }
+  });
+
+  it('hands a rejection that is already an Error to onError as the same instance and still rejects the caller with it', async () => {
+    const thrown = new Error('provider exploded');
+    let onErrorCalls = 0;
+    let receivedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCalls += 1;
+        receivedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(rejectingProvider(thrown), promptBuilder, undefined, {hooks});
+    const callerOutcome = await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({
+      onErrorCalls,
+      isSameInstance: receivedError === thrown,
+      callerGetsOriginal: callerOutcome === thrown,
+    }).toEqual({onErrorCalls: 1, isSameInstance: true, callerGetsOriginal: true});
+  });
+});