--- /dev/null
+++ b/src/orchestration/chatOrchestrator.acceptance.test.ts
@@ -0,0 +1,147 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+// A rejection reason is a value here, not a message, so the helper keeps it whole rather than reducing it to one.
+const rejectionOf = async (call: Promise<unknown>): Promise<{rejected: boolean; reason: unknown}> => {
+  try {
+    await call;
+    return {rejected: false, reason: undefined};
+  } catch (reason) {
+    return {rejected: true, reason};
+  }
+};
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// Failures in the wild are not always Errors: a provider can reject with anything at all.
+function rejectingProvider(reason: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw reason;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const recordingOnError = (): {
+  hooks: OrchestratorHooks;
+  reported: () => {count: number; error: Error | undefined};
+} => {
+  let count = 0;
+  let error: Error | undefined;
+  return {
+    hooks: {
+      onError: async (_session, seen) => {
+        count++;
+        error = seen;
+      },
+    },
+    reported: () => ({count, error}),
+  };
+};
+
+describe('ChatOrchestrator onError for a rejection that is not an Error', () => {
+  it('calls onError once with an Error whose cause is the string the provider rejected with, and still rejects the caller with that string', async () => {
+    const {hooks, reported} = recordingOnError();
+    const orchestrator = createChatOrchestrator(
+      rejectingProvider('socket reset mid-stream'),
+      promptBuilder,
+      undefined,
+      {hooks}
+    );
+
+    const rejection = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+    const {count, error} = reported();
+
+    expect({
+      onErrorCalls: count,
+      isError: error instanceof Error,
+      cause: error instanceof Error ? error.cause : 'onError was never called',
+      rejected: rejection.rejected,
+      callerReason: rejection.reason,
+    }).toEqual({
+      onErrorCalls: 1,
+      isError: true,
+      cause: 'socket reset mid-stream',
+      rejected: true,
+      callerReason: 'socket reset mid-stream',
+    });
+  });
+
+  it('wraps a plain-object rejection the same way, and the caller still receives the original object', async () => {
+    const reason = {code: 'E_CONN_RESET', detail: 'socket closed mid-stream'};
+    const {hooks, reported} = recordingOnError();
+    const orchestrator = createChatOrchestrator(rejectingProvider(reason), promptBuilder, undefined, {hooks});
+
+    const rejection = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+    const {count, error} = reported();
+
+    expect({
+      onErrorCalls: count,
+      isError: error instanceof Error,
+      causeIsTheOriginal: error instanceof Error && Object.is(error.cause, reason),
+      rejected: rejection.rejected,
+      callerGotTheOriginal: Object.is(rejection.reason, reason),
+    }).toEqual({
+      onErrorCalls: 1,
+      isError: true,
+      causeIsTheOriginal: true,
+      rejected: true,
+      callerGotTheOriginal: true,
+    });
+  });
+
+  it('calls onError for a rejection with undefined and still rejects the caller with undefined', async () => {
+    const {hooks, reported} = recordingOnError();
+    const orchestrator = createChatOrchestrator(rejectingProvider(undefined), promptBuilder, undefined, {hooks});
+
+    const rejection = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+    const {count, error} = reported();
+
+    expect({onErrorCalls: count, isError: error instanceof Error, rejected: rejection.rejected}).toEqual({
+      onErrorCalls: 1,
+      isError: true,
+      rejected: true,
+    });
+  });
+
+  // Green before the change by design: this pins the invariant the fix must not break, which no existing
+  // test holds it to (they compare `error.message`, which a wrapper could copy).
+  it('hands an Error rejection to onError as the same instance, not a wrapper', async () => {
+    const original = new Error('rate limited');
+    const {hooks, reported} = recordingOnError();
+    const orchestrator = createChatOrchestrator(rejectingProvider(original), promptBuilder, undefined, {hooks});
+
+    const rejection = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+    const {count, error} = reported();
+
+    expect({
+      onErrorCalls: count,
+      onErrorGotTheSameInstance: Object.is(error, original),
+      rejected: rejection.rejected,
+      callerGotTheSameInstance: Object.is(rejection.reason, original),
+    }).toEqual({
+      onErrorCalls: 1,
+      onErrorGotTheSameInstance: true,
+      rejected: true,
+      callerGotTheSameInstance: true,
+    });
+  });
+});