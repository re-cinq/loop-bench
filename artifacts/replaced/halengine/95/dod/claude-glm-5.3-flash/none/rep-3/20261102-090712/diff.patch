+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import {AIError} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Acceptance tests for re-cinq/HALEngine#95: the orchestrator's catch must call onError for a rejection that is not an Error.
+
+// A rejection may be any value, so the caller's outcome carries it as data rather than through a matcher.
+type CallerOutcome = {rejected: boolean; value: unknown};
+
+const outcomeOf = (call: Promise<unknown>): Promise<CallerOutcome> =>
+  call.then(
+    (value): CallerOutcome => ({rejected: false, value}),
+    (reason): CallerOutcome => ({rejected: true, value: reason})
+  );
+
+function createRejectionProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+// One turn against a provider rejecting with `rejection`, returning what onError saw and what the caller got.
+const turnRejectedWith = async (
+  rejection: unknown
+): Promise<{callCount: number; error: Error | undefined; cause: unknown; caller: CallerOutcome}> => {
+  let callCount = 0;
+  let error: Error | undefined;
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, received) => {
+      callCount += 1;
+      error = received;
+    },
+  };
+
+  const orchestrator = createChatOrchestrator(createRejectionProvider(rejection), promptBuilder, undefined, {hooks});
+  const caller = await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+  return {callCount, error, cause: error?.cause, caller};
+};
+
+describe('onError for a rejection that is not an Error', () => {
+  it('calls onError once with an Error whose cause is the thrown string, and the caller still receives that string', async () => {
+    const rejection = 'provider socket closed';
+    const turn = await turnRejectedWith(rejection);
+
+    expect({
+      callCount: turn.callCount,
+      isError: turn.error instanceof Error,
+      causeIsTheOriginalValue: turn.cause === rejection,
+      callerRejected: turn.caller.rejected,
+      callerReceivedTheOriginalValue: turn.caller.value === rejection,
+    }).toEqual({
+      callCount: 1,
+      isError: true,
+      causeIsTheOriginalValue: true,
+      callerRejected: true,
+      callerReceivedTheOriginalValue: true,
+    });
+  });
+
+  it('does the same for a rejection with a plain object', async () => {
+    const rejection = {code: 'E_STREAM', retryable: false};
+    const turn = await turnRejectedWith(rejection);
+
+    expect({
+      callCount: turn.callCount,
+      isError: turn.error instanceof Error,
+      causeIsTheOriginalValue: turn.cause === rejection,
+      callerRejected: turn.caller.rejected,
+      callerReceivedTheOriginalValue: turn.caller.value === rejection,
+    }).toEqual({
+      callCount: 1,
+      isError: true,
+      causeIsTheOriginalValue: true,
+      callerRejected: true,
+      callerReceivedTheOriginalValue: true,
+    });
+  });
+
+  it('does the same for a rejection with undefined', async () => {
+    const rejection = undefined;
+    const turn = await turnRejectedWith(rejection);
+
+    expect({
+      callCount: turn.callCount,
+      isError: turn.error instanceof Error,
+      callerRejected: turn.caller.rejected,
+      callerReceivedTheOriginalValue: turn.caller.value === rejection,
+    }).toEqual({
+      callCount: 1,
+      isError: true,
+      callerRejected: true,
+      callerReceivedTheOriginalValue: true,
+    });
+  });
+
+  it('hands a rejection that is already an Error to onError as that same instance, not a wrapper', async () => {
+    const rejection = new AIError('rate limited', 'RATE_LIMITED');
+    const turn = await turnRejectedWith(rejection);
+
+    expect({
+      onErrorSawTheSameInstance: turn.error === rejection,
+      callerReceivedTheSameInstance: turn.caller.value === rejection,
+    }).toEqual({onErrorSawTheSameInstance: true, callerReceivedTheSameInstance: true});
+  });
+});