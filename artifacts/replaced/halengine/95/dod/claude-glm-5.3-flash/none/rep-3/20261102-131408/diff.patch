+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// Rejects the turn with `rejection` exactly as given, the way a library that rejects with its own shape would.
+function createRejectingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+// Hands the caller's rejection back as a value instead of failing the test, so one expect can hold it.
+async function rejectionOf(processMessage: Promise<string>): Promise<unknown> {
+  let caught: unknown;
+  await processMessage.catch((error: unknown) => {
+    caught = error;
+  });
+  return caught;
+}
+
+describe('onError reports every rejection', () => {
+  it('reports a string rejection to onError once as an Error carrying the string as its cause, and rejects the caller with the string', async () => {
+    let onErrorCalls = 0;
+    let seenError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCalls++;
+        seenError = error;
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      createRejectingProvider('provider exploded'),
+      promptBuilder,
+      undefined,
+      {hooks}
+    );
+
+    const callerRejection = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({
+      onErrorCalls,
+      onErrorSawAnError: seenError instanceof Error,
+      cause: seenError?.cause,
+      callerRejection,
+    }).toEqual({
+      onErrorCalls: 1,
+      onErrorSawAnError: true,
+      cause: 'provider exploded',
+      callerRejection: 'provider exploded',
+    });
+  });
+
+  it('reports a plain-object rejection the same way: onError once, an Error carrying the object as its cause, the caller receiving the object', async () => {
+    let onErrorCalls = 0;
+    let seenError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCalls++;
+        seenError = error;
+      },
+    };
+    const rejection = {code: 503, detail: 'backend quota'};
+    const orchestrator = createChatOrchestrator(createRejectingProvider(rejection), promptBuilder, undefined, {hooks});
+
+    const callerRejection = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({
+      onErrorCalls,
+      onErrorSawAnError: seenError instanceof Error,
+      causeIsTheRejectionItself: seenError?.cause === rejection,
+      callerGotTheRejectionItself: callerRejection === rejection,
+    }).toEqual({
+      onErrorCalls: 1,
+      onErrorSawAnError: true,
+      causeIsTheRejectionItself: true,
+      callerGotTheRejectionItself: true,
+    });
+  });
+
+  it('reports an undefined rejection the same way: onError once, an Error whose cause is undefined, the caller still rejected with undefined', async () => {
+    let onErrorCalls = 0;
+    let seenError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCalls++;
+        seenError = error;
+      },
+    };
+    const orchestrator = createChatOrchestrator(createRejectingProvider(undefined), promptBuilder, undefined, {hooks});
+
+    const callerRejection = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({
+      onErrorCalls,
+      onErrorSawAnError: seenError instanceof Error,
+      callerRejectedWithUndefined: callerRejection === undefined,
+    }).toEqual({onErrorCalls: 1, onErrorSawAnError: true, callerRejectedWithUndefined: true});
+  });
+
+  it('passes a rejection that is already an Error to onError and the caller as the same instance, not a wrapper', async () => {
+    let onErrorCalls = 0;
+    let seenError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCalls++;
+        seenError = error;
+      },
+    };
+    const rejection = new Error('already an Error');
+    const orchestrator = createChatOrchestrator(createRejectingProvider(rejection), promptBuilder, undefined, {hooks});
+
+    const callerRejection = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({
+      onErrorCalls,
+      onErrorSawTheRejectionItself: seenError === rejection,
+      callerGotTheRejectionItself: callerRejection === rejection,
+    }).toEqual({onErrorCalls: 1, onErrorSawTheRejectionItself: true, callerGotTheRejectionItself: true});
+  });
+});