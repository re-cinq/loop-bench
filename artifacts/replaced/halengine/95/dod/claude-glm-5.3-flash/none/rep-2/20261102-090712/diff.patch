@@ -0,0 +1,94 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import {AIError} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function createRejectionProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+// The rejection as a value rather than a matcher, so the caller's share of the contract can be held to identity.
+const rejectionOf = (call: Promise<unknown>): Promise<unknown> =>
+  call.then(
+    () => 'resolved without throwing',
+    (rejection: unknown) => rejection
+  );
+
+interface ObservedTurn {
+  onErrorCalls: number;
+  received: Error | undefined;
+  callerRejection: unknown;
+}
+
+// One turn against a provider that rejects, with onError recording what it was handed.
+async function runTurn(rejection: unknown): Promise<ObservedTurn> {
+  let onErrorCalls = 0;
+  let received: Error | undefined;
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => {
+      onErrorCalls += 1;
+      received = error;
+    },
+  };
+  const orchestrator = createChatOrchestrator(createRejectionProvider(rejection), promptBuilder, undefined, {hooks});
+  const callerRejection = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+  return {onErrorCalls, received, callerRejection};
+}
+
+describe('onError for every rejection', () => {
+  it('calls onError for a rejection that is not an Error, wrapping it with the original as cause, and still rejects the caller with the original value', async () => {
+    const observedFor = async (rejection: unknown) => {
+      const {onErrorCalls, received, callerRejection} = await runTurn(rejection);
+      return {
+        onErrorCalls,
+        isError: received instanceof Error,
+        causeIsOriginal: received?.cause === rejection,
+        callerGotOriginal: callerRejection === rejection,
+      };
+    };
+
+    expect({
+      string: await observedFor('provider said no'),
+      object: await observedFor({code: 'ECONNRESET'}),
+      undefined: await observedFor(undefined),
+    }).toEqual({
+      string: {onErrorCalls: 1, isError: true, causeIsOriginal: true, callerGotOriginal: true},
+      object: {onErrorCalls: 1, isError: true, causeIsOriginal: true, callerGotOriginal: true},
+      undefined: {onErrorCalls: 1, isError: true, causeIsOriginal: true, callerGotOriginal: true},
+    });
+  });
+
+  it('passes an Error rejection to onError as the same instance, not a wrapper', async () => {
+    const original = new AIError('rate limited', 'RATE_LIMITED');
+    const {onErrorCalls, received, callerRejection} = await runTurn(original);
+
+    expect({
+      onErrorCalls,
+      sameInstance: received === original,
+      callerGotSameInstance: callerRejection === original,
+    }).toEqual({onErrorCalls: 1, sameInstance: true, callerGotSameInstance: true});
+  });
+});