@@ -0,0 +1,111 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+// A rejection need not be an Error, so the caller's outcome is captured as a value rather than through a matcher.
+const rejectionOf = (call: Promise<unknown>): Promise<unknown> =>
+  call.then(
+    () => 'resolved without throwing',
+    (reason: unknown) => reason
+  );
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// Rejects with the raw value before yielding, exactly as a provider rejecting with its own shape would.
+const createRejectionProvider = (thrownByProvider: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw thrownByProvider;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('onError for a rejection that is not an Error', () => {
+  // Counts the calls and keeps the last error, so "once" and "an Error" are asserted from what actually arrived.
+  const recordingOnError = (): {
+    hooks: OrchestratorHooks;
+    observed: () => {calls: number; isError: boolean; cause: unknown};
+  } => {
+    let calls = 0;
+    let received: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        calls += 1;
+        received = error;
+      },
+    };
+    return {
+      hooks,
+      observed: () => ({calls, isError: received instanceof Error, cause: received?.cause}),
+    };
+  };
+
+  it('hands onError a string rejection wrapped as cause and still rejects the caller with the string', async () => {
+    const {hooks, observed} = recordingOnError();
+    const orchestrator = createChatOrchestrator(
+      createRejectionProvider('provider exploded'),
+      promptBuilder,
+      undefined,
+      {hooks}
+    );
+
+    const rejection = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({calls: observed().calls, isError: observed().isError, cause: observed().cause, rejection}).toEqual({
+      calls: 1,
+      isError: true,
+      cause: 'provider exploded',
+      rejection: 'provider exploded',
+    });
+  });
+
+  it('hands onError a plain-object rejection wrapped as cause and still rejects the caller with that object', async () => {
+    const providerFailure = {code: 'E9001', detail: 'context length exceeded'};
+    const {hooks, observed} = recordingOnError();
+    const orchestrator = createChatOrchestrator(createRejectionProvider(providerFailure), promptBuilder, undefined, {
+      hooks,
+    });
+
+    const rejection = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({
+      calls: observed().calls,
+      isError: observed().isError,
+      causeIsOriginal: observed().cause === providerFailure,
+      callerGotOriginal: rejection === providerFailure,
+    }).toEqual({
+      calls: 1,
+      isError: true,
+      causeIsOriginal: true,
+      callerGotOriginal: true,
+    });
+  });
+
+  it('calls onError for an undefined rejection and still rejects the caller with undefined', async () => {
+    const {hooks, observed} = recordingOnError();
+    const orchestrator = createChatOrchestrator(createRejectionProvider(undefined), promptBuilder, undefined, {hooks});
+
+    const rejection = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({calls: observed().calls, isError: observed().isError, callerRejection: rejection}).toEqual({
+      calls: 1,
+      isError: true,
+      callerRejection: undefined,
+    });
+  });
+});