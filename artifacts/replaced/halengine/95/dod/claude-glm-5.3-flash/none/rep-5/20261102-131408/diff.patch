+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// Rejects the stream with a value that need not be an Error: a library a provider wraps is free to reject with its own shape.
+function createRejectingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+// The rejection as a value rather than through a matcher, so identity survives: the caller must catch exactly what was thrown.
+const rejectionOf = (turn: Promise<unknown>): Promise<unknown> =>
+  turn.then(
+    () => 'resolved without throwing',
+    (value: unknown) => value
+  );
+
+const recordOnError = (): {hooks: OrchestratorHooks; errors: Error[]} => {
+  const errors: Error[] = [];
+  const hooks: OrchestratorHooks = {onError: async (_session, error) => void errors.push(error)};
+  return {hooks, errors};
+};
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator onError for a rejection that is not an Error', () => {
+  it('calls onError once with an Error whose cause is the thrown string, and still rejects the caller with that string', async () => {
+    const rejection = 'provider socket reset';
+    const {hooks, errors} = recordOnError();
+    const orchestrator = createChatOrchestrator(createRejectingProvider(rejection), promptBuilder, undefined, {hooks});
+
+    const callerRejection = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({
+      callerCaughtOriginal: callerRejection === rejection,
+      calls: errors.map(error => ({isError: error instanceof Error, causeIsOriginal: error.cause === rejection})),
+    }).toEqual({
+      callerCaughtOriginal: true,
+      calls: [{isError: true, causeIsOriginal: true}],
+    });
+  });
+
+  it('wraps a rejection with a plain object the same way, preserving it as the cause for onError', async () => {
+    const rejection = {code: 503, detail: 'upstream unavailable'};
+    const {hooks, errors} = recordOnError();
+    const orchestrator = createChatOrchestrator(createRejectingProvider(rejection), promptBuilder, undefined, {hooks});
+
+    const callerRejection = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({
+      callerCaughtOriginal: callerRejection === rejection,
+      calls: errors.map(error => ({isError: error instanceof Error, causeIsOriginal: error.cause === rejection})),
+    }).toEqual({
+      callerCaughtOriginal: true,
+      calls: [{isError: true, causeIsOriginal: true}],
+    });
+  });
+
+  it('wraps a rejection with undefined the same way, and still rejects the caller with undefined', async () => {
+    const {hooks, errors} = recordOnError();
+    const orchestrator = createChatOrchestrator(createRejectingProvider(undefined), promptBuilder, undefined, {hooks});
+
+    const callerRejection = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({
+      callerCaughtOriginal: callerRejection === undefined,
+      calls: errors.map(error => ({isError: error instanceof Error, causeIsOriginal: error.cause === undefined})),
+    }).toEqual({
+      callerCaughtOriginal: true,
+      calls: [{isError: true, causeIsOriginal: true}],
+    });
+  });
+});