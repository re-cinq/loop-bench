+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import {AIError} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// The rejection as a value, so a rejection carrying undefined stays distinguishable from a resolve.
+const outcomeOf = async (call: Promise<unknown>): Promise<{rejected: boolean; value: unknown}> => {
+  try {
+    return {rejected: false, value: await call};
+  } catch (value) {
+    return {rejected: true, value};
+  }
+};
+
+const rejectingProvider = (value: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield -- the generator's whole job is to reject the stream consuming it
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw value;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator onError for every rejection', () => {
+  it('reports a string rejection to onError once, wrapped with the string as its cause, while the caller still receives the string', async () => {
+    const session = createSession('hello');
+    const reports: {session: ChatSession; error: Error}[] = [];
+    const hooks: OrchestratorHooks = {
+      onError: async (hookedSession, error) => {
+        reports.push({session: hookedSession, error});
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      rejectingProvider('provider socket dropped'),
+      promptBuilder,
+      undefined,
+      {hooks}
+    );
+    const outcome = await outcomeOf(orchestrator.processMessage(session));
+
+    expect({
+      outcome,
+      reports: reports.map(report => ({
+        sameSession: report.session === session,
+        isError: report.error instanceof Error,
+        cause: report.error.cause,
+      })),
+    }).toEqual({
+      outcome: {rejected: true, value: 'provider socket dropped'},
+      reports: [{sameSession: true, isError: true, cause: 'provider socket dropped'}],
+    });
+  });
+
+  it('reports an object and an undefined rejection the same way, each wrapped with the original as its cause', async () => {
+    const rejectionValues: unknown[] = [{code: 503, detail: 'upstream broke'}, undefined];
+    const observed: {outcome: {rejected: boolean; value: unknown}; reports: {isError: boolean; cause: unknown}[]}[] =
+      [];
+
+    for (const value of rejectionValues) {
+      const reports: {isError: boolean; cause: unknown}[] = [];
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          reports.push({isError: error instanceof Error, cause: error.cause});
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(rejectingProvider(value), promptBuilder, undefined, {hooks});
+      observed.push({outcome: await outcomeOf(orchestrator.processMessage(createSession('hello'))), reports});
+    }
+
+    expect(observed).toEqual([
+      {
+        outcome: {rejected: true, value: {code: 503, detail: 'upstream broke'}},
+        reports: [{isError: true, cause: {code: 503, detail: 'upstream broke'}}],
+      },
+      {outcome: {rejected: true, value: undefined}, reports: [{isError: true, cause: undefined}]},
+    ]);
+  });
+
+  it('hands an Error rejection to onError as that same instance, not a wrapper', async () => {
+    const original = new AIError('rate limited', 'RATE_LIMITED');
+    let received: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        received = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(rejectingProvider(original), promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({
+      outcome,
+      hookGotSameInstance: received === original,
+      callerGotSameInstance: outcome.rejected && outcome.value === original,
+    }).toEqual({
+      outcome: {rejected: true, value: original},
+      hookGotSameInstance: true,
+      callerGotSameInstance: true,
+    });
+  });
+});