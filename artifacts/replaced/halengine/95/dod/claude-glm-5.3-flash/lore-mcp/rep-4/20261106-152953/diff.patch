@@ -0,0 +1,130 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import {AIError} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const sessionWith = (content: string): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content, timestamp: SENT_AT}],
+});
+
+// Rejects with whatever the turn hands it, because the failures the wild throws are not all Errors.
+const rejectingWith = (rejection: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+// What onError saw, recorded as values so each test below can assert with a single expect.
+const onErrorSeen = (): {hooks: OrchestratorHooks; saw: () => {count: number; error: unknown}} => {
+  const calls: unknown[] = [];
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => {
+      calls.push(error);
+    },
+  };
+  return {hooks, saw: () => ({count: calls.length, error: calls[0]})};
+};
+
+// The caller's rejection as a value rather than a matcher, with the resolved case spelled out.
+const rejectionOf = (turn: Promise<unknown>): Promise<unknown> =>
+  turn.then(
+    () => 'resolved without rejecting',
+    (reason: unknown) => reason
+  );
+
+describe('onError for every rejection', () => {
+  it('calls onError with an Error whose cause is the string and still rejects the caller with that string', async () => {
+    const {hooks, saw} = onErrorSeen();
+    const orchestrator = createChatOrchestrator(rejectingWith('provider exploded'), promptBuilder, undefined, {
+      hooks,
+    });
+
+    const rejection = await rejectionOf(orchestrator.processMessage(sessionWith('hello')));
+    const seen = saw();
+    const seenError = seen.error;
+
+    expect({
+      onErrorCalls: seen.count,
+      reachedOnErrorAsError: seenError instanceof Error,
+      cause: seenError instanceof Error ? seenError.cause : 'onError never ran',
+      callerRejection: rejection,
+    }).toEqual({
+      onErrorCalls: 1,
+      reachedOnErrorAsError: true,
+      cause: 'provider exploded',
+      callerRejection: 'provider exploded',
+    });
+  });
+
+  it('calls onError with an Error whose cause is the plain object and still rejects the caller with that object', async () => {
+    const {hooks, saw} = onErrorSeen();
+    const original = {code: 429, detail: 'slow down'};
+    const orchestrator = createChatOrchestrator(rejectingWith(original), promptBuilder, undefined, {hooks});
+
+    const rejection = await rejectionOf(orchestrator.processMessage(sessionWith('hello')));
+    const seen = saw();
+    const seenError = seen.error;
+
+    expect({
+      onErrorCalls: seen.count,
+      reachedOnErrorAsError: seenError instanceof Error,
+      causeHoldsTheOriginal: seenError instanceof Error ? seenError.cause === original : false,
+      callerKeepsTheOriginal: rejection === original,
+    }).toEqual({
+      onErrorCalls: 1,
+      reachedOnErrorAsError: true,
+      causeHoldsTheOriginal: true,
+      callerKeepsTheOriginal: true,
+    });
+  });
+
+  it('calls onError with an Error whose cause is undefined and still rejects the caller with undefined', async () => {
+    const {hooks, saw} = onErrorSeen();
+    const orchestrator = createChatOrchestrator(rejectingWith(undefined), promptBuilder, undefined, {hooks});
+
+    const rejection = await rejectionOf(orchestrator.processMessage(sessionWith('hello')));
+    const seen = saw();
+    const seenError = seen.error;
+
+    expect({
+      onErrorCalls: seen.count,
+      reachedOnErrorAsError: seenError instanceof Error,
+      callerRejectedWithUndefined: rejection === undefined,
+    }).toEqual({
+      onErrorCalls: 1,
+      reachedOnErrorAsError: true,
+      callerRejectedWithUndefined: true,
+    });
+  });
+
+  it('hands onError and the caller the same Error instance the provider rejected with, not a wrapper', async () => {
+    const {hooks, saw} = onErrorSeen();
+    const providerError = new AIError('rate limited', 'RATE_LIMITED');
+    const orchestrator = createChatOrchestrator(rejectingWith(providerError), promptBuilder, undefined, {hooks});
+
+    const rejection = await rejectionOf(orchestrator.processMessage(sessionWith('hello')));
+    const seen = saw();
+
+    expect({
+      onErrorCalls: seen.count,
+      onErrorGotTheInstance: seen.error === providerError,
+      callerGotTheInstance: rejection === providerError,
+    }).toEqual({
+      onErrorCalls: 1,
+      onErrorGotTheInstance: true,
+      callerGotTheInstance: true,
+    });
+  });
+});