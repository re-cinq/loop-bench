+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+}
+
+// A provider whose stream dies with whatever the library behind it rejects with: not every failure in the wild is an Error.
+function createRejectingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+// The rejection as a value rather than a matcher, so an `undefined` rejection is assertable; a resolution fails the test instead of masquerading as one.
+async function rejectionOf(call: Promise<unknown>): Promise<unknown> {
+  return call.then(
+    () => {
+      throw new Error('resolved instead of rejecting');
+    },
+    (error: unknown) => error
+  );
+}
+
+// One observation per test: how often onError ran, what it received, and what the caller caught.
+async function observedRejectionOf(rejection: unknown): Promise<{
+  onErrorCalls: number;
+  isError: boolean;
+  cause: unknown;
+  causeIsRejection: boolean;
+  hookSawRejection: boolean;
+  callerReceivedRejection: boolean;
+}> {
+  const seen: unknown[] = [];
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => {
+      seen.push(error);
+    },
+  };
+
+  const orchestrator = createChatOrchestrator(createRejectingProvider(rejection), promptBuilder, undefined, {hooks});
+  const callerReceived = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+  const reported = seen[0];
+
+  return {
+    onErrorCalls: seen.length,
+    isError: reported instanceof Error,
+    cause: reported instanceof Error ? reported.cause : undefined,
+    causeIsRejection: reported instanceof Error && reported.cause === rejection,
+    hookSawRejection: reported === rejection,
+    callerReceivedRejection: callerReceived === rejection,
+  };
+}
+
+describe('ChatOrchestrator onError with a rejection that is not an Error', () => {
+  it('calls onError once for a string rejection, wrapping it as the cause and rethrowing the string unchanged', async () => {
+    const observed = await observedRejectionOf('upstream exploded');
+
+    expect(observed).toEqual({
+      onErrorCalls: 1,
+      isError: true,
+      cause: 'upstream exploded',
+      causeIsRejection: true,
+      hookSawRejection: false,
+      callerReceivedRejection: true,
+    });
+  });
+
+  it('calls onError once for a plain-object rejection, keeping that object as the cause and rethrowing it unchanged', async () => {
+    const rejection = {code: 'UPSTREAM_503', detail: 'provider exploded'};
+    const observed = await observedRejectionOf(rejection);
+
+    expect(observed).toEqual({
+      onErrorCalls: 1,
+      isError: true,
+      cause: {code: 'UPSTREAM_503', detail: 'provider exploded'},
+      causeIsRejection: true,
+      hookSawRejection: false,
+      callerReceivedRejection: true,
+    });
+  });
+
+  it('calls onError for an undefined rejection and still rejects the caller with undefined', async () => {
+    const observed = await observedRejectionOf(undefined);
+
+    expect(observed).toEqual({
+      onErrorCalls: 1,
+      isError: true,
+      cause: undefined,
+      causeIsRejection: true,
+      hookSawRejection: false,
+      callerReceivedRejection: true,
+    });
+  });
+
+  it('reaches onError as the same Error instance, not a wrapper, and still rejects the caller with that instance', async () => {
+    const rejection = new Error('rate limited');
+    const observed = await observedRejectionOf(rejection);
+
+    expect(observed).toEqual({
+      onErrorCalls: 1,
+      isError: true,
+      causeIsRejection: false,
+      hookSawRejection: true,
+      callerReceivedRejection: true,
+    });
+  });
+});