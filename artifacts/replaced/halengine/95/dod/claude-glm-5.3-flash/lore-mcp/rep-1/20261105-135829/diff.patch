@@ -0,0 +1,108 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import {AIError} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// The provider rejects with `rejection` verbatim, Error or not.
+function createRejectionProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+// A rejection that is not an Error carries no message, so each test needs the rejection as a value.
+const rejectionOf = async (call: Promise<unknown>): Promise<unknown> => {
+  try {
+    await call;
+  } catch (error) {
+    return error;
+  }
+  return 'resolved without rejecting';
+};
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const countingOnError = (): {hooks: OrchestratorHooks; calls: () => number; received: () => unknown} => {
+  let count = 0;
+  let error: unknown;
+  return {
+    hooks: {
+      onError: async (_session, err) => {
+        count++;
+        error = err;
+      },
+    },
+    calls: () => count,
+    received: () => error,
+  };
+};
+
+describe('ChatOrchestrator onError for a rejection that is not an Error', () => {
+  it('calls onError once with an Error whose cause is the string the provider rejected with, and still rejects the caller with that string', async () => {
+    const rejection = 'provider gave up';
+    const {hooks, calls, received} = countingOnError();
+
+    const orchestrator = createChatOrchestrator(createRejectionProvider(rejection), promptBuilder, undefined, {hooks});
+    const outcome = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+
+    expect(calls()).toBe(1);
+    expect(received()).toBeInstanceOf(Error);
+    expect((received() as Error).cause).toBe(rejection);
+    expect(outcome).toBe(rejection);
+  });
+
+  it('calls onError once with an Error whose cause is the object the provider rejected with, and still rejects the caller with that object', async () => {
+    const rejection = {code: 'UPSTREAM_500', detail: 'a rejection shape the library owns'};
+    const {hooks, calls, received} = countingOnError();
+
+    const orchestrator = createChatOrchestrator(createRejectionProvider(rejection), promptBuilder, undefined, {hooks});
+    const outcome = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+
+    expect(calls()).toBe(1);
+    expect(received()).toBeInstanceOf(Error);
+    expect((received() as Error).cause).toBe(rejection);
+    expect(outcome).toBe(rejection);
+  });
+
+  it('calls onError once when the provider rejects with undefined, and still rejects the caller with undefined', async () => {
+    const {hooks, calls, received} = countingOnError();
+
+    const orchestrator = createChatOrchestrator(createRejectionProvider(undefined), promptBuilder, undefined, {hooks});
+    const outcome = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+
+    expect(calls()).toBe(1);
+    expect(received()).toBeInstanceOf(Error);
+    expect(outcome).toBe(undefined);
+  });
+
+  it('passes a rejection that is already an Error to onError as the same instance, not a wrapper', async () => {
+    const rejection = new AIError('rate limited', 'RATE_LIMITED');
+    const {hooks, calls, received} = countingOnError();
+
+    const orchestrator = createChatOrchestrator(createRejectionProvider(rejection), promptBuilder, undefined, {hooks});
+    const outcome = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+
+    expect(calls()).toBe(1);
+    expect(received()).toBe(rejection);
+    expect(outcome).toBe(rejection);
+  });
+});