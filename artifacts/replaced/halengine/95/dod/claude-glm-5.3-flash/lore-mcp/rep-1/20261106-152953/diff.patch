@@ -0,0 +1,96 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import {AIError} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant for the onError seam.'});
+
+const aSession = (content: string): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content, timestamp: SENT_AT}],
+});
+
+// Rejects with whatever the row hands it, so a value that is not an Error can reach the orchestrator's catch.
+const rejectingWith = (rejection: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+// Distinguishes a turn that resolved from one that rejected with undefined.
+const RESOLVED = 'resolved without rejecting';
+
+// One real turn per row; the row records what onError saw and what the caller caught as booleans,
+// so identity — the same instance, not merely an equal one — is what the single expect compares.
+const REJECTION_ROWS: {label: string; rejection: unknown}[] = [
+  {label: 'string', rejection: 'the provider gave up'},
+  {label: 'object', rejection: {code: 'E_STREAM_CLOSED', attempt: 2}},
+  {label: 'undefined', rejection: undefined},
+  {label: 'error', rejection: new AIError('rate limited', 'RATE_LIMITED')},
+];
+
+describe('onError for a rejection that is not an Error', () => {
+  it('calls onError for every rejection, wrapping a non-Error as the cause, and still rejects the caller with the original value', async () => {
+    const observed: Record<string, Record<string, unknown>> = {};
+
+    for (const {label, rejection} of REJECTION_ROWS) {
+      const onErrorCalls: Error[] = [];
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => void onErrorCalls.push(error),
+      };
+
+      const orchestrator = createChatOrchestrator(rejectingWith(rejection), promptBuilder, undefined, {hooks});
+      const caught = await orchestrator.processMessage(aSession('hello')).then(
+        () => RESOLVED,
+        (errorValue: unknown) => errorValue
+      );
+      const seen = onErrorCalls[0];
+
+      observed[label] =
+        rejection instanceof Error
+          ? {
+              onErrorCallCount: onErrorCalls.length,
+              onErrorSawTheThrownInstance: seen === rejection,
+              callerGotTheOriginalRejection: caught === rejection,
+            }
+          : {
+              onErrorCallCount: onErrorCalls.length,
+              onErrorSawAnError: seen instanceof Error,
+              causeIsTheOriginalRejection: seen?.cause === rejection,
+              callerGotTheOriginalRejection: caught === rejection,
+            };
+    }
+
+    expect(observed).toEqual({
+      string: {
+        onErrorCallCount: 1,
+        onErrorSawAnError: true,
+        causeIsTheOriginalRejection: true,
+        callerGotTheOriginalRejection: true,
+      },
+      object: {
+        onErrorCallCount: 1,
+        onErrorSawAnError: true,
+        causeIsTheOriginalRejection: true,
+        callerGotTheOriginalRejection: true,
+      },
+      undefined: {
+        onErrorCallCount: 1,
+        onErrorSawAnError: true,
+        causeIsTheOriginalRejection: true,
+        callerGotTheOriginalRejection: true,
+      },
+      error: {onErrorCallCount: 1, onErrorSawTheThrownInstance: true, callerGotTheOriginalRejection: true},
+    });
+  });
+});