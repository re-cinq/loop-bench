@@ -0,0 +1,123 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import {AIError} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+}
+
+// The rejection value is whatever the provider throws, Error or not; that is the whole point.
+const rejectingProvider = (rejection: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+const recordingOnError = (): {hooks: OrchestratorHooks; reported: () => Error[]} => {
+  const errors: Error[] = [];
+  return {
+    hooks: {
+      onError: async (_session, error) => {
+        errors.push(error);
+      },
+    },
+    reported: () => errors,
+  };
+};
+
+// The caller boundary keeps the raw rejection as a value, not just its message.
+const rejectionOf = (call: Promise<unknown>): Promise<unknown> =>
+  call.then(
+    () => 'resolved without rejecting',
+    (error: unknown) => error
+  );
+
+describe('ChatOrchestrator onError for rejections that are not Errors', () => {
+  it('calls onError once when the provider rejects with a string, wrapping it as the cause', async () => {
+    const rejection = 'provider socket closed mid-stream';
+    const {hooks, reported} = recordingOnError();
+    const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+
+    const callerReceived = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({
+      onErrorCalls: reported().length,
+      reportedIsError: reported()[0] instanceof Error,
+      reportedCause: reported()[0]?.cause,
+      callerReceived,
+    }).toEqual({
+      onErrorCalls: 1,
+      reportedIsError: true,
+      reportedCause: rejection,
+      callerReceived: rejection,
+    });
+  });
+
+  it('calls onError for a plain object and an undefined rejection too, wrapping either as the cause', async () => {
+    const rejection = {code: 'QUOTA', detail: 'monthly limit reached'};
+    const cases: {label: string; thrown: unknown}[] = [
+      {label: 'object', thrown: rejection},
+      {label: 'undefined', thrown: undefined},
+    ];
+
+    const observed: Record<string, unknown> = {};
+    for (const {label, thrown} of cases) {
+      const {hooks, reported} = recordingOnError();
+      const orchestrator = createChatOrchestrator(rejectingProvider(thrown), promptBuilder, undefined, {hooks});
+      const callerReceived = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+
+      observed[label] = {
+        onErrorCalls: reported().length,
+        reportedIsError: reported()[0] instanceof Error,
+        reportedCauseIsOriginal: Object.is(reported()[0]?.cause, thrown),
+        callerReceivedIsOriginal: Object.is(callerReceived, thrown),
+      };
+    }
+
+    expect(observed).toEqual({
+      object: {
+        onErrorCalls: 1,
+        reportedIsError: true,
+        reportedCauseIsOriginal: true,
+        callerReceivedIsOriginal: true,
+      },
+      undefined: {
+        onErrorCalls: 1,
+        reportedIsError: true,
+        reportedCauseIsOriginal: true,
+        callerReceivedIsOriginal: true,
+      },
+    });
+  });
+
+  it('hands an Error rejection to onError and the caller as the same instance, not a wrapper', async () => {
+    const rejection = new AIError('rate limited', 'RATE_LIMITED');
+    const {hooks, reported} = recordingOnError();
+    const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+
+    const callerReceived = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({
+      onErrorCalls: reported().length,
+      reportedIsSameInstance: Object.is(reported()[0], rejection),
+      callerReceivedIsSameInstance: Object.is(callerReceived, rejection),
+    }).toEqual({
+      onErrorCalls: 1,
+      reportedIsSameInstance: true,
+      callerReceivedIsSameInstance: true,
+    });
+  });
+});