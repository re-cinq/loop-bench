@@ -0,0 +1,86 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// A provider whose stream rejects with whatever it holds, the way a library rejecting with its own shape does.
+const rejectingProvider = (rejection: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+// The rejection as a value rather than a matcher: a string or undefined cannot survive `rejects.toThrow`.
+const rejectionOf = (turn: Promise<unknown>): Promise<unknown> =>
+  turn.then(
+    () => 'resolved without rejecting',
+    (reason: unknown) => reason
+  );
+
+// One real turn whose only hook is an onError recording everything it is handed.
+async function turnOutcome(rejection: unknown): Promise<{handedToOnError: unknown[]; callerReceived: unknown}> {
+  const handedToOnError: unknown[] = [];
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => {
+      handedToOnError.push(error);
+    },
+  };
+  const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+  return {handedToOnError, callerReceived: await rejectionOf(orchestrator.processMessage(createSession('hello')))};
+}
+
+describe('ChatOrchestrator onError reporting', () => {
+  it('reports a rejection that is not an Error to onError — a string, a plain object, undefined — as an Error whose cause is the original, while the caller still receives the original rejection', async () => {
+    const observed: Record<string, unknown> = {};
+
+    for (const [kind, rejection] of [
+      ['string', 'disk on fire'],
+      ['object', {code: 503, reason: 'provider down'}],
+      ['undefined', undefined],
+    ] as const) {
+      const {handedToOnError, callerReceived} = await turnOutcome(rejection);
+      const reported = handedToOnError[0];
+      observed[kind] = {
+        onErrorCalls: handedToOnError.length,
+        reportedAnError: reported instanceof Error,
+        causeIsOriginal: Object.is((reported as Error | undefined)?.cause, rejection),
+        callerReceivedOriginal: Object.is(callerReceived, rejection),
+      };
+    }
+
+    expect(observed).toEqual({
+      string: {onErrorCalls: 1, reportedAnError: true, causeIsOriginal: true, callerReceivedOriginal: true},
+      object: {onErrorCalls: 1, reportedAnError: true, causeIsOriginal: true, callerReceivedOriginal: true},
+      undefined: {onErrorCalls: 1, reportedAnError: true, causeIsOriginal: true, callerReceivedOriginal: true},
+    });
+  });
+
+  it('passes a rejection that is already an Error to onError as the same instance, not a wrapper, and rejects the caller with it unchanged', async () => {
+    const rejection = new Error('boom');
+    const {handedToOnError, callerReceived} = await turnOutcome(rejection);
+
+    expect({
+      onErrorCalls: handedToOnError.length,
+      onErrorGotSameInstance: Object.is(handedToOnError[0], rejection),
+      callerGotSameInstance: Object.is(callerReceived, rejection),
+    }).toEqual({onErrorCalls: 1, onErrorGotSameInstance: true, callerGotSameInstance: true});
+  });
+});