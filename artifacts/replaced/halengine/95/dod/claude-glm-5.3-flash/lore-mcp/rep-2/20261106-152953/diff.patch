@@ -0,0 +1,87 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// Rejects with a value of the caller's choosing, so the orchestrator meets a rejection it does not control.
+function createRejectionProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+// What onError saw and what the caller was rejected with, from one turn.
+const turnOutcome = async (rejection: unknown): Promise<{onErrorCalls: unknown[]; callerRejectedWith: unknown}> => {
+  const onErrorCalls: unknown[] = [];
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => {
+      onErrorCalls.push(error);
+    },
+  };
+
+  const orchestrator = createChatOrchestrator(createRejectionProvider(rejection), promptBuilder, undefined, {hooks});
+  const callerRejectedWith = await orchestrator.processMessage(createSession('hello')).then(
+    () => 'resolved without throwing',
+    (error: unknown) => error
+  );
+
+  return {onErrorCalls, callerRejectedWith};
+};
+
+describe('ChatOrchestrator onError on a rejection that is not an Error', () => {
+  it('reports every non-Error rejection to onError as an Error carrying it as cause', async () => {
+    const rejections: unknown[] = ['provider socket reset', {code: 'E_PROVIDER', fatal: true}, undefined];
+    const observed = [];
+
+    for (const rejection of rejections) {
+      const {onErrorCalls, callerRejectedWith} = await turnOutcome(rejection);
+      const [reported] = onErrorCalls;
+      observed.push({
+        onErrorCallCount: onErrorCalls.length,
+        reportedIsError: reported instanceof Error,
+        reportedCauseIsRejection: (reported as Error | undefined)?.cause === rejection,
+        callerRejectedWithIsRejection: callerRejectedWith === rejection,
+      });
+    }
+
+    const expectedOfEveryShape = {
+      onErrorCallCount: 1,
+      reportedIsError: true,
+      reportedCauseIsRejection: true,
+      callerRejectedWithIsRejection: true,
+    };
+
+    expect(observed).toEqual(rejections.map(() => expectedOfEveryShape));
+  });
+
+  it('hands an Error rejection to onError as that same instance and rejects the caller with it', async () => {
+    const original = new Error('rate limited');
+    const {onErrorCalls, callerRejectedWith} = await turnOutcome(original);
+
+    expect({
+      onErrorCallCount: onErrorCalls.length,
+      onErrorSawOriginal: onErrorCalls[0] === original,
+      callerRejectedWithIsOriginal: callerRejectedWith === original,
+    }).toEqual({onErrorCallCount: 1, onErrorSawOriginal: true, callerRejectedWithIsOriginal: true});
+  });
+});