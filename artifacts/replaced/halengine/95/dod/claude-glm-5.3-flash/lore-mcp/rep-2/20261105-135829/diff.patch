@@ -0,0 +1,84 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// Rejects with the value itself rather than an Error: exactly the rejection this suite is about.
+function createRejectionProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+// The rejection as a value: a non-Error rejection has no .message to read it back through.
+const rejectionToTheCaller = async (call: Promise<unknown>): Promise<unknown> =>
+  call.then(
+    () => 'resolved without throwing',
+    error => error
+  );
+
+// One failing turn: what onError received and what the caller was rejected with.
+const runTurn = async (
+  rejection: unknown
+): Promise<{onErrorCalls: number; received: unknown; rejectionToCaller: unknown}> => {
+  const received: unknown[] = [];
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => {
+      received.push(error);
+    },
+  };
+
+  const orchestrator = createChatOrchestrator(createRejectionProvider(rejection), promptBuilder, undefined, {hooks});
+  const rejectionToCaller = await rejectionToTheCaller(orchestrator.processMessage(createSession('hello')));
+
+  return {onErrorCalls: received.length, received: received[0], rejectionToCaller};
+};
+
+describe('ChatOrchestrator onError', () => {
+  it('calls onError with an Error wrapping a rejection that is not an Error, and still rejects the caller with the original', async () => {
+    for (const rejection of ['no such session', {code: 'ECONNRESET', attempt: 2}, undefined]) {
+      const outcome = await runTurn(rejection);
+
+      expect({
+        case: String(rejection),
+        onErrorCalls: outcome.onErrorCalls,
+        isError: outcome.received instanceof Error,
+      }).toEqual({
+        case: String(rejection),
+        onErrorCalls: 1,
+        isError: true,
+      });
+      expect((outcome.received as Error).cause).toBe(rejection);
+      expect(outcome.rejectionToCaller).toBe(rejection);
+    }
+  });
+
+  it('hands onError the rejection itself when it is already an Error, not a wrapper', async () => {
+    const original = new Error('provider exploded');
+    const outcome = await runTurn(original);
+
+    expect({onErrorCalls: outcome.onErrorCalls}).toEqual({onErrorCalls: 1});
+    expect(outcome.received).toBe(original);
+    expect(outcome.rejectionToCaller).toBe(original);
+  });
+});