+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+// The rejection as a value rather than a matcher, so a rejection that is not an Error can be compared by identity.
+const rejectionOf = (call: Promise<unknown>): Promise<unknown> =>
+  call.then(
+    () => 'resolved without throwing',
+    (error: unknown) => error
+  );
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// eslint-disable-next-line require-yield
+function rejectingProvider(thrown: unknown): AIProvider {
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw thrown;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+// One turn per rejection shape, reduced to booleans so a matrix of shapes fits one comparison.
+async function observeRejection(thrown: unknown): Promise<{
+  hookReceived: unknown;
+  onErrorCalls: number;
+  hookReceivedIsError: boolean;
+  causeIsThrown: boolean;
+  callerGotThrown: boolean;
+}> {
+  const received: unknown[] = [];
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => {
+      received.push(error);
+    },
+  };
+
+  const orchestrator = createChatOrchestrator(rejectingProvider(thrown), promptBuilder, undefined, {hooks});
+  const callerReceived = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+  const hookReceived = received[0];
+
+  return {
+    hookReceived,
+    onErrorCalls: received.length,
+    hookReceivedIsError: hookReceived instanceof Error,
+    causeIsThrown: Object.is(hookReceived instanceof Error ? hookReceived.cause : undefined, thrown),
+    callerGotThrown: Object.is(callerReceived, thrown),
+  };
+}
+
+// The received value is asserted by identity with toBe below, so the matrix compares only the four facts.
+const shapeOf = (observed: Awaited<ReturnType<typeof observeRejection>>) => ({
+  onErrorCalls: observed.onErrorCalls,
+  hookReceivedIsError: observed.hookReceivedIsError,
+  causeIsThrown: observed.causeIsThrown,
+  callerGotThrown: observed.callerGotThrown,
+});
+
+describe('ChatOrchestrator onError for a rejection that is not an Error', () => {
+  it('calls onError for a rejection that is not an Error, wrapping it with the original as its cause', async () => {
+    const thrownObject = {code: 'E_PROVIDER', retryable: false};
+    const thrownError = new Error('already an Error');
+
+    const [asString, asObject, asUndefined, asError] = await Promise.all([
+      observeRejection('provider gave up'),
+      observeRejection(thrownObject),
+      observeRejection(undefined),
+      observeRejection(thrownError),
+    ]);
+
+    expect({asString: shapeOf(asString), asObject: shapeOf(asObject), asUndefined: shapeOf(asUndefined)}).toEqual({
+      asString: {onErrorCalls: 1, hookReceivedIsError: true, causeIsThrown: true, callerGotThrown: true},
+      asObject: {onErrorCalls: 1, hookReceivedIsError: true, causeIsThrown: true, callerGotThrown: true},
+      asUndefined: {onErrorCalls: 1, hookReceivedIsError: true, causeIsThrown: true, callerGotThrown: true},
+    });
+
+    // An Error rejection reaches the hook as that same instance; the wrapped shapes pin cause identity via Object.is above.
+    expect(asError.onErrorCalls).toBe(1);
+    expect(asError.hookReceived).toBe(thrownError);
+    expect(asError.callerGotThrown).toBe(true);
+  });
+});