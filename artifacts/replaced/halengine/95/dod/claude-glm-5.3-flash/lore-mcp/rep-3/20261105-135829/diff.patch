+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {AIError} from '../types/ai.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// A provider rejecting with an arbitrary value: the shape a wrapper library hands the orchestrator.
+function createRejectingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+// The rejection as a value rather than a matcher, so a non-Error rejection reaches the assertion.
+const rejectionOf = (call: Promise<unknown>): Promise<unknown> =>
+  call.then(
+    () => 'resolved without throwing',
+    reason => reason
+  );
+
+// The onError observations are read only after the caller's promise has settled.
+const turnRejection = async (rejection: unknown) => {
+  const received: Error[] = [];
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => {
+      received.push(error);
+    },
+  };
+  const orchestrator = createChatOrchestrator(createRejectingProvider(rejection), promptBuilder, undefined, {hooks});
+  const callerRejection = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+  return {received, callerRejection};
+};
+
+describe('ChatOrchestrator reports every rejection to onError', () => {
+  it('reports a string rejection to onError once, as an Error whose cause is that string, and still rejects the caller with it', async () => {
+    const thrownString = 'provider socket collapsed';
+    const turn = await turnRejection(thrownString);
+
+    expect({
+      onErrorCalls: turn.received.length,
+      receivedIsError: turn.received[0] instanceof Error,
+      receivedCauseIsTheOriginal: turn.received[0]?.cause === thrownString,
+      callerRejectionIsTheOriginal: turn.callerRejection === thrownString,
+    }).toEqual({
+      onErrorCalls: 1,
+      receivedIsError: true,
+      receivedCauseIsTheOriginal: true,
+      callerRejectionIsTheOriginal: true,
+    });
+  });
+
+  it('reports a plain-object and an undefined rejection to onError the same way, and reaches an Error rejection as the same instance', async () => {
+    const thrownObject = {code: 'E_PROVIDER', detail: 'socket hung up'};
+    const thrownError = new AIError('rate limited', 'RATE_LIMITED');
+
+    const objectTurn = await turnRejection(thrownObject);
+    const undefinedTurn = await turnRejection(undefined);
+    const errorTurn = await turnRejection(thrownError);
+
+    expect({
+      object: {
+        onErrorCalls: objectTurn.received.length,
+        receivedIsError: objectTurn.received[0] instanceof Error,
+        receivedCauseIsTheOriginal: objectTurn.received[0]?.cause === thrownObject,
+        callerRejectionIsTheOriginal: objectTurn.callerRejection === thrownObject,
+      },
+      undefined: {
+        onErrorCalls: undefinedTurn.received.length,
+        receivedIsError: undefinedTurn.received[0] instanceof Error,
+        receivedCauseIsUndefined: undefinedTurn.received[0]?.cause === undefined,
+        callerRejectionIsUndefined: undefinedTurn.callerRejection === undefined,
+      },
+      error: {
+        onErrorCalls: errorTurn.received.length,
+        receivedIsTheSameInstance: errorTurn.received[0] === thrownError,
+        callerRejectionIsTheSameInstance: errorTurn.callerRejection === thrownError,
+      },
+    }).toEqual({
+      object: {
+        onErrorCalls: 1,
+        receivedIsError: true,
+        receivedCauseIsTheOriginal: true,
+        callerRejectionIsTheOriginal: true,
+      },
+      undefined: {
+        onErrorCalls: 1,
+        receivedIsError: true,
+        receivedCauseIsUndefined: true,
+        callerRejectionIsUndefined: true,
+      },
+      error: {onErrorCalls: 1, receivedIsTheSameInstance: true, callerRejectionIsTheSameInstance: true},
+    });
+  });
+});