+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {createBedrockProvider} from '../providers/bedrock/bedrockProvider.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+// spec: specs/hal-engine-config-hooks/spec.md#9
+it('reports every provider rejection once without changing the caller rejection', async () => {
+  const observations = [];
+  const expected = [];
+  const reasons: unknown[] = ['provider unavailable', {code: 'UNAVAILABLE'}, undefined, new Error('provider failed')];
+
+  for (const reason of reasons) {
+    for (const entryPoint of ['processMessage', 'processMessageStream'] as const) {
+      const session: ChatSession = {sessionId: 'rejection-session', userId: 'user', entries: []};
+      const errors: Error[] = [];
+      const sessions: ChatSession[] = [];
+      // Lazy configuration can throw any JS value; the real provider reads it before making a network request.
+      const provider = createBedrockProvider({
+        type: 'bedrock',
+        region: 'us-east-1',
+        maxTokens: 1,
+        get modelId(): string {
+          throw reason;
+        },
+      });
+      const orchestrator = createChatOrchestrator(
+        provider,
+        new PromptBuilder({identity: 'Acceptance test'}),
+        undefined,
+        {
+          hooks: {
+            onError: async (receivedSession, error) => {
+              sessions.push(receivedSession);
+              errors.push(error);
+            },
+          },
+        }
+      );
+      const call =
+        entryPoint === 'processMessage'
+          ? orchestrator.processMessage(session)
+          : orchestrator.processMessageStream(session).next();
+      const outcome = await call.then(
+        () => ({rejected: false, original: false}),
+        (rejection: unknown) => ({rejected: true, original: Object.is(rejection, reason)})
+      );
+      const error = errors[0];
+      observations.push({
+        entryPoint,
+        reason,
+        outcome,
+        calls: errors.length,
+        sameSession: sessions[0] === session,
+        isError: error instanceof Error,
+        preserved:
+          reason instanceof Error
+            ? error === reason
+            : error !== undefined && Object.hasOwn(error, 'cause') && Object.is(error.cause, reason),
+      });
+      expected.push({
+        entryPoint,
+        reason,
+        outcome: {rejected: true, original: true},
+        calls: 1,
+        sameSession: true,
+        isError: true,
+        preserved: true,
+      });
+    }
+  }
+
+  expect(observations).toEqual(expected);
+});