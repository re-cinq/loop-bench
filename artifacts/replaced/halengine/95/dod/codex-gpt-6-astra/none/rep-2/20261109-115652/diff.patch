+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {createBedrockProvider} from '../providers/bedrock/bedrockProvider.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+// @spec specs/hal-engine-config-hooks/spec.md#9
+it('reports every rejection as an Error without changing the caller rejection', async () => {
+  const reasons: unknown[] = ['provider unavailable', {code: 'UNAVAILABLE'}, undefined, new Error('unavailable')];
+  const observations = [];
+  const provider = createBedrockProvider({type: 'bedrock', modelId: 'unused', region: 'eu-west-1', maxTokens: 1});
+
+  for (const reason of reasons) {
+    const received: Error[] = [];
+    const session: ChatSession = {
+      sessionId: 'rejection-session',
+      userId: 'rejection-user',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Assistant'}), undefined, {
+      hooks: {
+        // A real installed hook rejects inside the same try as provider streaming, before any network request.
+        beforeModelResponse: async () => Promise.reject(reason),
+        onError: async (_session, error) => {
+          received.push(error);
+        },
+      },
+    });
+    const outcome = await orchestrator.processMessage(session).then(
+      () => ({rejected: false, reason: undefined}),
+      (error: unknown) => ({rejected: true, reason: error})
+    );
+
+    observations.push({
+      rejected: outcome.rejected,
+      originalRejection: Object.is(outcome.reason, reason),
+      hookCalls: received.length,
+      hookReceivedError: received[0] instanceof Error,
+      preservedReason:
+        reason instanceof Error
+          ? received[0] === reason
+          : received[0] instanceof Error && Object.hasOwn(received[0], 'cause') && Object.is(received[0].cause, reason),
+    });
+  }
+
+  expect(observations).toEqual(
+    reasons.map(() => ({
+      rejected: true,
+      originalRejection: true,
+      hookCalls: 1,
+      hookReceivedError: true,
+      preservedReason: true,
+    }))
+  );
+});