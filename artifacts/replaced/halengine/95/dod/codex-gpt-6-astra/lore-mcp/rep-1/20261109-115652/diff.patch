+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// spec: specs/hal-engine-config-hooks/spec.md#9
+it('reports non-Error provider rejections once with their cause and preserves the caller rejection', async () => {
+  const reasons: unknown[] = ['provider unavailable', {code: 'PROVIDER_UNAVAILABLE'}, undefined];
+  const observations = [];
+
+  for (const reason of reasons) {
+    const provider: AIProvider = {
+      // eslint-disable-next-line require-yield -- the provider fails before it can emit a chunk
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        throw reason;
+      },
+      async generateStructured<T>(): Promise<T> {
+        throw reason;
+      },
+    };
+    const session: ChatSession = {
+      sessionId: 'rejection-session',
+      userId: 'rejection-user',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const errors: Error[] = [];
+    const orchestrator = createChatOrchestrator(
+      provider,
+      new PromptBuilder({identity: 'You are helpful.'}),
+      undefined,
+      {
+        hooks: {
+          onError: async (_session, error) => {
+            errors.push(error);
+          },
+        },
+      }
+    );
+    const outcome = await orchestrator.processMessage(session).then(
+      () => ({rejected: false, unchanged: false}),
+      (error: unknown) => ({rejected: true, unchanged: Object.is(error, reason)})
+    );
+
+    observations.push({
+      outcome,
+      calls: errors.length,
+      isError: errors[0] instanceof Error,
+      preservesCause: errors.length === 1 && Object.is(errors[0].cause, reason),
+    });
+  }
+
+  expect(observations).toEqual(
+    reasons.map(() => ({
+      outcome: {rejected: true, unchanged: true},
+      calls: 1,
+      isError: true,
+      preservesCause: true,
+    }))
+  );
+});