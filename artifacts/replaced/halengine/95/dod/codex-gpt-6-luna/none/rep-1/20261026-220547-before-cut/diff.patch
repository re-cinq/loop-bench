+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const createSession = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const rejectingProvider = (reason: unknown): AIProvider => ({
+  async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    throw reason;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+describe('onError acceptance', () => {
+  // @spec specs/hal-engine-config-hooks/spec.md#9
+  it('calls onError with a caused Error for every non-Error provider rejection and preserves the rejection', async () => {
+    const reasons: unknown[] = ['provider failed', {code: 'E_PROVIDER'}, undefined];
+    const outcomes: unknown[] = [];
+
+    for (const reason of reasons) {
+      let calls = 0;
+      let hookError: Error | undefined;
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          calls++;
+          hookError = error;
+        },
+      };
+      const orchestrator = createChatOrchestrator(
+        rejectingProvider(reason),
+        new PromptBuilder({identity: 'test assistant'}),
+        undefined,
+        {hooks}
+      );
+
+      let callerReason: unknown;
+      try {
+        await orchestrator.processMessage(createSession());
+      } catch (error) {
+        callerReason = error;
+      }
+
+      outcomes.push({
+        calls,
+        hookError: hookError instanceof Error,
+        cause: hookError?.cause,
+        callerReason,
+      });
+    }
+
+    expect(outcomes).toEqual(reasons.map(reason => ({calls: 1, hookError: true, cause: reason, callerReason: reason})));
+  });
+});