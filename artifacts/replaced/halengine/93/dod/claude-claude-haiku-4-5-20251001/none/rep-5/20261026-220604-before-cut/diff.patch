+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {scriptedProvider, registryReturning, TOOL_CALL} from './chatOrchestratorTestSupport.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function captureUsage(initial?: UsageMetadata): {hooks: OrchestratorHooks; get: () => UsageMetadata | undefined} {
+  let captured = initial;
+  return {
+    hooks: {
+      afterModelResponse: async (_s, _t, u) => {
+        captured = u;
+      },
+    },
+    get: () => captured,
+  };
+}
+
+async function runAndCapture(
+  rounds: MessageChunk[][],
+  initialCapture?: UsageMetadata
+): Promise<UsageMetadata | undefined> {
+  const capture = captureUsage(initialCapture);
+  const orch = makeToolOrchestrator(rounds, capture);
+  await orch.processMessage(createSession('ask'));
+  return capture.get();
+}
+
+function makeToolOrchestrator(rounds: MessageChunk[][], capture: {hooks: OrchestratorHooks}) {
+  return createChatOrchestrator(scriptedProvider(rounds), promptBuilder, registryReturning({result: 'found it'}), {
+    hooks: capture.hooks,
+  });
+}
+
+describe('ChatOrchestrator usage accumulation (acceptance)', () => {
+  it('reports accumulated usage across all tool rounds, not just the last', async () => {
+    const round1Usage: UsageMetadata = {inputTokens: 100, outputTokens: 50, totalTokens: 150};
+    const round2Usage: UsageMetadata = {inputTokens: 200, outputTokens: 75, totalTokens: 275};
+    const result = await runAndCapture([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: round1Usage}],
+      [
+        {type: 'text', text: 'the answer'},
+        {type: 'stop', stopReason: 'end_turn', usage: round2Usage},
+      ],
+    ]);
+    expect(result).toEqual({inputTokens: 300, outputTokens: 125, totalTokens: 425});
+  });
+
+  it('preserves the baseline: a turn with no tool calls reports usage as before', async () => {
+    const usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const capture = captureUsage();
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [
+          {type: 'text', text: 'hello world'},
+          {type: 'stop', stopReason: 'end_turn', usage},
+        ],
+      ]),
+      promptBuilder,
+      undefined,
+      {hooks: capture.hooks}
+    );
+
+    await orchestrator.processMessage(createSession('hi'));
+
+    expect(capture.get()).toEqual(usage);
+  });
+
+  it('handles missing usage in intermediate rounds gracefully', async () => {
+    const round2Usage: UsageMetadata = {inputTokens: 200, outputTokens: 75, totalTokens: 275};
+    const result = await runAndCapture([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+      [
+        {type: 'text', text: 'the answer'},
+        {type: 'stop', stopReason: 'end_turn', usage: round2Usage},
+      ],
+    ]);
+    expect(result).toEqual(round2Usage);
+  });
+
+  it('handles multiple rounds where some report usage and some do not', async () => {
+    const round1Usage: UsageMetadata = {inputTokens: 100, outputTokens: 50, totalTokens: 150};
+    const round3Usage: UsageMetadata = {inputTokens: 250, outputTokens: 80, totalTokens: 330};
+    const result = await runAndCapture([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: round1Usage}],
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn', usage: round3Usage},
+      ],
+    ]);
+    expect(result).toEqual({inputTokens: 350, outputTokens: 130, totalTokens: 480});
+  });
+
+  it('reports undefined when no rounds report any usage', async () => {
+    const result = await runAndCapture(
+      [
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+        [
+          {type: 'text', text: 'the answer'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ],
+      ],
+      {inputTokens: 999, outputTokens: 999, totalTokens: 999}
+    );
+    expect(result).toBeUndefined();
+  });
+});
