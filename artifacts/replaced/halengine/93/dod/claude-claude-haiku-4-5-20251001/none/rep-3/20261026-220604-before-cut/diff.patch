@@ -0,0 +1,107 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {scriptedProvider, registryReturning, TOOL_CALL} from './chatOrchestrator.testHelpers.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function runTurn(rounds: MessageChunk[][]): Promise<{usage: UsageMetadata | undefined; called: boolean}> {
+  let usage: UsageMetadata | undefined;
+  let called = false;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, u) => {
+      usage = u;
+      called = true;
+    },
+  };
+  return createChatOrchestrator(scriptedProvider(rounds), promptBuilder, registryReturning({result: 'r'}), {hooks})
+    .processMessage(createSession('ask'))
+    .then(() => ({usage, called}));
+}
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+describe('ChatOrchestrator usage accumulation across tool rounds', () => {
+  it('accumulates usage from every provider call across multiple tool rounds', async () => {
+    const usage1: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const usage2: UsageMetadata = {inputTokens: 20, outputTokens: 10, totalTokens: 30};
+    const usage3: UsageMetadata = {inputTokens: 5, outputTokens: 2, totalTokens: 7};
+
+    const {usage} = await runTurn([
+      [{type: 'text', text: 'first '}, TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usage1}],
+      [{type: 'text', text: 'second '}, TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usage2}],
+      [
+        {type: 'text', text: 'final'},
