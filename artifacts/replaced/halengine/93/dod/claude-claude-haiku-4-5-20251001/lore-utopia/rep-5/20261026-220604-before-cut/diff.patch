@@ -0,0 +1,120 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {scriptedProvider, registryReturning, TOOL_CALL} from './testFixtures.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function captureUsage(): {hooks: OrchestratorHooks; getRecordedUsage: () => UsageMetadata | undefined} {
+  let recorded: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      recorded = usage;
+    },
+  };
+  return {hooks, getRecordedUsage: () => recorded};
+}
+
+describe('afterModelResponse usage accumulation', () => {
+  it('accumulates usage across multiple tool rounds and reports the total', async () => {
+    const usage1: UsageMetadata = {inputTokens: 100, outputTokens: 50, totalTokens: 150};
+    const usage2: UsageMetadata = {inputTokens: 75, outputTokens: 40, totalTokens: 115};
+    const {hooks, getRecordedUsage} = captureUsage();
