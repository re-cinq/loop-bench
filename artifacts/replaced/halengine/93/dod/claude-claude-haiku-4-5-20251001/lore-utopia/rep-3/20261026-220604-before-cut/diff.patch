@@ -0,0 +1,105 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {scriptedProvider, registryReturning, TOOL_CALL, STOP_FOR_TOOL} from './chatOrchestrator.test-helpers.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const FIRST_ROUND_USAGE: UsageMetadata = {inputTokens: 100, outputTokens: 20, totalTokens: 120};
+const MIDDLE_ROUND_USAGE: UsageMetadata = {inputTokens: 150, outputTokens: 25, totalTokens: 175};
+const LAST_ROUND_USAGE: UsageMetadata = {inputTokens: 50, outputTokens: 10, totalTokens: 60};
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+async function runForUsage(rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> {
+  const {hooks, received} = captureUsage();
+  await makeOrchestrator(rounds, hooks).processMessage(createSession('ask'));
+  return received();
+}
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function makeOrchestrator(rounds: MessageChunk[][], hooks: OrchestratorHooks) {
+  return createChatOrchestrator(scriptedProvider(rounds), promptBuilder, registryReturning({result: 'found it'}), {
+    hooks,
+  });
+}
+
+function captureUsage(): {hooks: OrchestratorHooks; received: () => UsageMetadata | undefined} {
+  let captured: UsageMetadata | undefined;
+  return {
+    hooks: {
+      afterModelResponse: async (_session, _text, usage) => {
+        captured = usage;
+      },
+    },
+    received: () => captured,
+  };
+}
+
+describe('ChatOrchestrator usage accumulation (Issue #93)', () => {
+  describe('A turn driven through two tool rounds reports usage covering every provider call', () => {
+    it('accumulates usage across all rounds and passes the total to afterModelResponse', async () => {
+      const result = await runForUsage([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: FIRST_ROUND_USAGE}],
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: MIDDLE_ROUND_USAGE}],
+        [
+          {type: 'text', text: 'final answer'},
+          {type: 'stop', stopReason: 'end_turn', usage: LAST_ROUND_USAGE},
+        ],
+      ]);
+
+      expect(result).toEqual({inputTokens: 300, outputTokens: 55, totalTokens: 355});
+    });
+  });
+
+  describe('A turn with no tool calls reports exactly what it reports today (backward compatibility)', () => {
+    it('passes the single round usage unchanged when there are no tool calls', async () => {
+      const singleUsage: UsageMetadata = {inputTokens: 50, outputTokens: 15, totalTokens: 65};
+
+      const result = await runForUsage([
+        [
+          {type: 'text', text: 'direct answer'},
+          {type: 'stop', stopReason: 'end_turn', usage: singleUsage},
+        ],
+      ]);
+
+      expect(result).toEqual(singleUsage);
+    });
+  });
+
+  describe('A provider that reports no usage on some rounds does not make the total undefined or NaN', () => {
+    it('counts rounds that reported and skips those that did not', async () => {
+      const result = await runForUsage([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: FIRST_ROUND_USAGE}],
+        [TOOL_CALL, STOP_FOR_TOOL],
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn', usage: LAST_ROUND_USAGE},
+        ],
+      ]);
+
+      expect(result).toEqual({inputTokens: 150, outputTokens: 30, totalTokens: 180});
+    });
+
+    it('reports undefined if no rounds reported usage', async () => {
+      const result = await runForUsage([
+        [TOOL_CALL, STOP_FOR_TOOL],
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ],
+      ]);
+
+      expect(result).toBeUndefined();
+    });
+  });
+});
