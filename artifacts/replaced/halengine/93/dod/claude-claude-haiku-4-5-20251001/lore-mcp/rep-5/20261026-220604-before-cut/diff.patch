+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {scriptedProvider, registryReturning, TOOL_CALL} from './chatOrchestrator.test-helpers.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+async function runTwoRoundTurn(
+  round1Usage: UsageMetadata | undefined,
+  round2Usage: UsageMetadata | undefined
+): Promise<UsageMetadata | undefined> {
+  let received: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, u) => {
+      received = u;
+    },
+  };
+  const provider = scriptedProvider([
+    [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: round1Usage}],
+    [
+      {type: 'text', text: 'the answer'},
+      {type: 'stop', stopReason: 'end_turn', usage: round2Usage},
+    ],
+  ]);
+  const orchestrator = createChatOrchestrator(provider, promptBuilder, registryReturning({result: 'found it'}), {
+    hooks,
+  });
+  await orchestrator.processMessage(createSession('ask'));
+  return received;
+}
+
+describe('Acceptance: accumulated usage across tool rounds', () => {
+  it('reports usage covering every provider call when a turn runs multiple tool rounds', async () => {
+    const round1Usage: UsageMetadata = {inputTokens: 100, outputTokens: 50, totalTokens: 150};
+    const round2Usage: UsageMetadata = {inputTokens: 200, outputTokens: 75, totalTokens: 275};
+    expect(await runTwoRoundTurn(round1Usage, round2Usage)).toEqual({
+      inputTokens: 300,
+      outputTokens: 125,
+      totalTokens: 425,
+    });
+  });
+
+  it('reports unmodified usage for a turn with no tool calls', async () => {
+    const usage: UsageMetadata = {inputTokens: 50, outputTokens: 25, totalTokens: 75};
+    let receivedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, u) => {
+        receivedUsage = u;
+      },
+    };
+
+    const provider = scriptedProvider([
+      [
+        {type: 'text', text: 'direct answer'},
+        {type: 'stop', stopReason: 'end_turn', usage},
+      ],
+    ]);
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(receivedUsage).toEqual(usage);
+  });
+
+  it('accumulates usage when some rounds report none', async () => {
+    const round1Usage: UsageMetadata = {inputTokens: 100, outputTokens: 50, totalTokens: 150};
+    // When round 2 reports no usage, accumulated total includes only the rounds that reported
+    expect(await runTwoRoundTurn(round1Usage, undefined)).toEqual(round1Usage);
+  });
+});
