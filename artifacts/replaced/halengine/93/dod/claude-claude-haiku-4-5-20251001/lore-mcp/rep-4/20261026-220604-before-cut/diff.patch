+++ b/src/orchestration/chatOrchestrator-usage-accumulation.acceptance.test.ts
@@ -0,0 +1,132 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import {scriptedProvider} from './chatOrchestratorTestSupport.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+
+const registryReturning = (response: string): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+    result: response,
+  }));
+  return registry;
+};
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function captureUsage(): {hooks: OrchestratorHooks; get: () => UsageMetadata | undefined} {
+  let value: UsageMetadata | undefined;
+  return {
+    hooks: {
+      afterModelResponse: async (_session, _text, usage) => {
+        value = usage;
+      },
+    },
+    get: () => value,
+  };
+}
+
+describe('HALEngine#93: Report usage across every tool round', () => {
+  it('accumulates usage from two tool rounds into a single sum', async () => {
+    const usage1: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const usage2: UsageMetadata = {inputTokens: 3, outputTokens: 2, totalTokens: 5};
+    const {hooks, get} = captureUsage();
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usage1}],
+        [
+          {type: 'text', text: 'answer'},
+          {type: 'stop', stopReason: 'end_turn', usage: usage2},
+        ],
+      ]),
+      promptBuilder,
+      registryReturning('tool result'),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('question'));
+
+    expect(get()).toEqual({inputTokens: 13, outputTokens: 7, totalTokens: 20});
+  });
+
+  it('reports the same usage for a turn with no tool calls as it does today', async () => {
+    const usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const {hooks, get} = captureUsage();
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [
+          {type: 'text', text: 'direct answer'},
+          {type: 'stop', stopReason: 'end_turn', usage},
+        ],
+      ]),
+      promptBuilder,
+      undefined,
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(get()).toEqual(usage);
+  });
+
+  it('handles a middle round with no usage report by summing the rounds that reported', async () => {
+    const usage1: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const usage3: UsageMetadata = {inputTokens: 2, outputTokens: 1, totalTokens: 3};
+    const {hooks, get} = captureUsage();
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usage1}],
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+        [
+          {type: 'text', text: 'answer'},
+          {type: 'stop', stopReason: 'end_turn', usage: usage3},
+        ],
+      ]),
+      promptBuilder,
+      registryReturning('tool result'),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('question'));
+
+    expect(get()).toEqual({inputTokens: 12, outputTokens: 6, totalTokens: 18});
+  });
+
+  it('reports undefined when no round reports usage', async () => {
+    const {hooks, get} = captureUsage();
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+        [
+          {type: 'text', text: 'answer'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ],
+      ]),
+      promptBuilder,
+      registryReturning('tool result'),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('question'));
+
+    expect(get()).toBeUndefined();
+  });
+});
