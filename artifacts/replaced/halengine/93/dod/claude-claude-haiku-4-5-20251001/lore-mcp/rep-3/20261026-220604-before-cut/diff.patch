@@ -0,0 +1,124 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {scriptedProvider, registryReturning, TOOL_CALL} from './chatOrchestratorTestSupport.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function captureUsage(initial?: UsageMetadata): {hooks: OrchestratorHooks; getUsage: () => UsageMetadata | undefined} {
+  let receivedUsage: UsageMetadata | undefined = initial;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      receivedUsage = usage;
+    },
+  };
+  return {hooks, getUsage: () => receivedUsage};
+}
+
+function makeOrchestrator(provider: AIProvider, hooks: OrchestratorHooks) {
+  return createChatOrchestrator(provider, promptBuilder, registryReturning({result: 'ok'}), {hooks});
+}
+
+const USAGE_A: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+const USAGE_B: UsageMetadata = {inputTokens: 20, outputTokens: 10, totalTokens: 30};
+const EXPECTED_AB: UsageMetadata = {inputTokens: 30, outputTokens: 15, totalTokens: 45};
+
+async function runAndExpect(provider: AIProvider, expected: UsageMetadata): Promise<void> {
+  const {hooks, getUsage} = captureUsage();
+  await makeOrchestrator(provider, hooks).processMessage(createSession('ask'));
+  expect(getUsage()).toEqual(expected);
+}
+
+describe('ChatOrchestrator usage accumulation across tool rounds', () => {
+  it('reports accumulated usage from every provider call across two tool rounds', async () => {
+    const provider = scriptedProvider([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: USAGE_A}],
+      [
+        {type: 'text', text: 'final answer'},
+        {type: 'stop', stopReason: 'end_turn', usage: USAGE_B},
+      ],
+    ]);
+
+    await runAndExpect(provider, EXPECTED_AB);
+  });
+
+  it('reports usage across three tool rounds', async () => {
+    const usage1: UsageMetadata = {inputTokens: 5, outputTokens: 3, totalTokens: 8};
+    const usage2: UsageMetadata = {inputTokens: 15, outputTokens: 7, totalTokens: 22};
+    const usage3: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const {hooks, getUsage} = captureUsage();
+    const provider = scriptedProvider([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usage1}],
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usage2}],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn', usage: usage3},
+      ],
+    ]);
+
+    await makeOrchestrator(provider, hooks).processMessage(createSession('ask'));
+
+    expect(getUsage()).toEqual({inputTokens: 30, outputTokens: 15, totalTokens: 45});
+  });
+
+  it('reports correct accumulated usage when some rounds report no usage', async () => {
+    const provider = scriptedProvider([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: USAGE_A}],
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+      [
+        {type: 'text', text: 'final'},
+        {type: 'stop', stopReason: 'end_turn', usage: USAGE_B},
+      ],
+    ]);
+
+    await runAndExpect(provider, EXPECTED_AB);
+  });
+
+  it('reports undefined when no rounds report any usage', async () => {
+    const sentinel: UsageMetadata = {inputTokens: 1, outputTokens: 1, totalTokens: 2};
+    const {hooks, getUsage} = captureUsage(sentinel);
+    const provider = scriptedProvider([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+      [
+        {type: 'text', text: 'answer'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ]);
+
+    await makeOrchestrator(provider, hooks).processMessage(createSession('ask'));
+
+    expect(getUsage()).toBeUndefined();
+  });
+
+  it('reports the same single usage for a turn with no tool calls', async () => {
+    const usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const {hooks, getUsage} = captureUsage();
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [
+          {type: 'text', text: 'answer'},
+          {type: 'stop', stopReason: 'end_turn', usage},
+        ],
+      ]),
+      promptBuilder,
+      undefined,
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(getUsage()).toEqual(usage);
+  });
+});
