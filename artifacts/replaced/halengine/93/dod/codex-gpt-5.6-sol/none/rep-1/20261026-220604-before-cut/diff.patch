+++ b/src/orchestration/usageAcrossRounds.acceptance.test.ts
@@ -0,0 +1,65 @@
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {scriptedProvider} from './chatOrchestrator.test.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const TOOL_CALL: MessageChunk = {
+  type: 'tool_use',
+  toolCall: {id: 'call-1', name: 'lookup', input: {query: 'answer'}},
+};
+
+const session = (id: string): ChatSession => ({
+  sessionId: id,
+  userId: 'user-1',
+  entries: [{role: 'user', content: 'look this up', timestamp: SENT_AT}],
+});
+
+const tools = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'Looks up an answer', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found',
+  }));
+  return registry;
+};
+
+const reportedUsage = async (roundUsage: Array<UsageMetadata | undefined>): Promise<UsageMetadata | undefined> => {
+  let received: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      received = usage;
+    },
+  };
+  const rounds = roundUsage.map((usage, index): MessageChunk[] => [
+    ...(index < roundUsage.length - 1 ? [TOOL_CALL] : [{type: 'text', text: 'done'} as MessageChunk]),
+    {type: 'stop', stopReason: index < roundUsage.length - 1 ? 'tool_use' : 'end_turn', usage},
+  ]);
+  const orchestrator = createChatOrchestrator(
+    scriptedProvider(rounds),
+    new PromptBuilder({identity: 'You are a test assistant.'}),
+    tools(),
+    {hooks}
+  );
+
+  await orchestrator.processMessage(session(`session-${roundUsage.length}`));
+  return received;
+};
+
+it('reports the summed usage of every provider call while preserving absent usage', async () => {
+  const first = {inputTokens: 11, outputTokens: 2, totalTokens: 13};
+  const second = {inputTokens: 17, outputTokens: 3, totalTokens: 20};
+  const third = {inputTokens: 23, outputTokens: 5, totalTokens: 28};
+
+  const everyRound = await reportedUsage([first, second, third]);
+  const someRounds = await reportedUsage([first, undefined, third]);
+  const noRounds = await reportedUsage([undefined, undefined]);
+
+  expect({everyRound, someRounds, noRounds}).toEqual({
+    everyRound: {inputTokens: 51, outputTokens: 10, totalTokens: 61},
+    someRounds: {inputTokens: 34, outputTokens: 7, totalTokens: 41},
+    noRounds: undefined,
+  });
+});