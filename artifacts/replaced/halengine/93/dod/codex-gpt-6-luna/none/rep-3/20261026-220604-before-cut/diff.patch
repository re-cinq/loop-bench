+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+// specs/hal-engine-config-hooks/spec.md#6
+it('reports usage from every provider call across two tool rounds', async () => {
+  const roundUsage: UsageMetadata[] = [
+    {inputTokens: 11, outputTokens: 3, totalTokens: 14},
+    {inputTokens: 17, outputTokens: 5, totalTokens: 22},
+    {inputTokens: 23, outputTokens: 7, totalTokens: 30},
+  ];
+  const rounds: MessageChunk[][] = [
+    [
+      {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {}}},
+      {type: 'stop', stopReason: 'tool_use', usage: roundUsage[0]},
+    ],
+    [
+      {type: 'tool_use', toolCall: {id: 'call-2', name: 'lookup', input: {}}},
+      {type: 'stop', stopReason: 'tool_use', usage: roundUsage[1]},
+    ],
+    [
+      {type: 'text', text: 'done'},
+      {type: 'stop', stopReason: 'end_turn', usage: roundUsage[2]},
+    ],
+  ];
+  let providerCall = 0;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield* rounds[providerCall++];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'Lookup', inputSchema: {type: 'object'}}, async () => 'found');
+
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reported = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Test.'}), registry, {hooks});
+  const session: ChatSession = {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'ask', timestamp: SENT_AT}],
+  };
+
+  await orchestrator.processMessage(session);
+
+  expect(reported).toEqual({inputTokens: 51, outputTokens: 15, totalTokens: 66});
+});