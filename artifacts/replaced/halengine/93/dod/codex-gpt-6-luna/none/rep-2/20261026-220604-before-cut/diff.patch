+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ChatSession} from '../types/session.js';
+
+const promptBuilder = new PromptBuilder({identity: 'Usage acceptance test.'});
+const session: ChatSession = {
+  sessionId: 'usage-session',
+  userId: 'usage-user',
+  entries: [{role: 'user', content: 'look this up', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+function scriptedProvider(rounds: MessageChunk[][]): AIProvider {
+  let round = 0;
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      yield* rounds[round++];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+function lookupRegistry(): ToolRegistry {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Looks something up.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  return registry;
+}
+
+const askForTool: MessageChunk[] = [
+  {type: 'tool_use', toolCall: {id: 'lookup-1', name: 'lookup', input: {}}},
+  {type: 'stop', stopReason: 'tool_use'},
+];
+
+describe('usage reported across provider rounds', () => {
+  it('sums the usage of every round, not only the last', async () => {
+    const first: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const second: UsageMetadata = {inputTokens: 20, outputTokens: 7, totalTokens: 27};
+    const final: UsageMetadata = {inputTokens: 3, outputTokens: 2, totalTokens: 5};
+    let received: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        received = usage;
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        askForTool.map((chunk, index) => (index === 1 ? {...chunk, usage: first} : chunk)),
+        askForTool.map((chunk, index) => (index === 1 ? {...chunk, usage: second} : chunk)),
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn', usage: final},
+        ],
+      ]),
+      promptBuilder,
+      lookupRegistry(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(session);
+
+    expect(received).toEqual({inputTokens: 33, outputTokens: 14, totalTokens: 47});
+  });
+
+  it('counts every reporting round when a round between them reports no usage', async () => {
+    const first: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const final: UsageMetadata = {inputTokens: 1, outputTokens: 2, totalTokens: 3};
+    let received: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        received = usage;
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        askForTool.map((chunk, index) => (index === 1 ? {...chunk, usage: first} : chunk)),
+        askForTool,
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn', usage: final},
+        ],
+      ]),
+      promptBuilder,
+      lookupRegistry(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(session);
+
+    expect(received).toEqual({inputTokens: 11, outputTokens: 7, totalTokens: 18});
+
+    let unreported: UsageMetadata | undefined;
+    const noUsageOrchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ],
+      ]),
+      promptBuilder,
+      undefined,
+      {
+        hooks: {
+          afterModelResponse: async (_session, _text, usage) => {
+            unreported = usage;
+          },
+        },
+      }
+    );
+
+    await noUsageOrchestrator.processMessage(session);
+
+    expect(unreported).toBeUndefined();
+  });
+});