@@ -0,0 +1,101 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolResponse} from './tools/registry.js';
+
+// Known and different per round, so a sum across the turn can never be confused with the last round's carry-forward.
+const ROUND_ONE: UsageMetadata = {inputTokens: 120, outputTokens: 15, totalTokens: 135};
+const ROUND_TWO: UsageMetadata = {inputTokens: 340, outputTokens: 45, totalTokens: 385};
+const FINAL_ROUND: UsageMetadata = {inputTokens: 60, outputTokens: 9, totalTokens: 69};
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+const STOP_FOR_TOOL = (usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason: 'tool_use', usage});
+const STOP_DONE = (usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason: 'end_turn', usage});
+
+// One scripted round per sendMessage call, so each provider call in the turn reports exactly the usage written for it.
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryReturning = (response: ToolResponse): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => response
+  );
+  return registry;
+};
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const createSession = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'ask', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+// What a deployer's billing hook would see: the usage argument as afterModelResponse hands it over.
+const usageSeenByAfterModelResponse = async (provider: AIProvider): Promise<UsageMetadata | undefined> => {
+  let seen: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _responseText, reported) => {
+      seen = reported;
+    },
+  };
+
+  const orchestrator = createChatOrchestrator(provider, promptBuilder, registryReturning({result: 'found it'}), {
+    hooks,
+  });
+  await orchestrator.processMessage(createSession());
+
+  return seen;
+};
+
+describe('ChatOrchestrator turn usage reported to afterModelResponse', () => {
+  it('reports usage covering every provider call in a turn driven through two tool rounds', async () => {
+    const provider = scriptedProvider([
+      [TOOL_CALL, STOP_FOR_TOOL(ROUND_ONE)],
+      [TOOL_CALL, STOP_FOR_TOOL(ROUND_TWO)],
+      [{type: 'text', text: 'the answer'}, STOP_DONE(FINAL_ROUND)],
+    ]);
+
+    const seen = await usageSeenByAfterModelResponse(provider);
+
+    expect(seen).toEqual({inputTokens: 520, outputTokens: 69, totalTokens: 589});
+  });
+
+  it('still counts the rounds that reported when a round reports no usage', async () => {
+    const provider = scriptedProvider([
+      [TOOL_CALL, STOP_FOR_TOOL(ROUND_ONE)],
+      [TOOL_CALL, STOP_FOR_TOOL()],
+      [{type: 'text', text: 'the answer'}, STOP_DONE(FINAL_ROUND)],
+    ]);
+
+    const seen = await usageSeenByAfterModelResponse(provider);
+
+    expect(seen).toEqual({inputTokens: 180, outputTokens: 24, totalTokens: 204});
+  });
+
+  it('reports no usage when no provider call in the turn reported one', async () => {
+    const provider = scriptedProvider([
+      [TOOL_CALL, STOP_FOR_TOOL()],
+      [{type: 'text', text: 'the answer'}, STOP_DONE()],
+    ]);
+
+    const seen = await usageSeenByAfterModelResponse(provider);
+
+    expect(seen).toBeUndefined();
+  });
+});