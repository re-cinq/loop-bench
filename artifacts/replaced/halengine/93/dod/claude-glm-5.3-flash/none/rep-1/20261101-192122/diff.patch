+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import {setLogger} from '../shared/logger.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const createSession = (content: string): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content, timestamp: SENT_AT}],
+});
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+// One scripted round per sendMessage call, so each round's stop chunk carries its own known, different usage.
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryReturning = (result: string): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+    result,
+  }));
+  return registry;
+};
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+
+const toolRound = (usage?: UsageMetadata): MessageChunk[] => [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage}];
+
+const textRound = (text: string, usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text},
+  {type: 'stop', stopReason: 'end_turn', usage},
+];
+
+// What the hook received: the turn's total usage, and the per-round breakdown beside it.
+interface Reported {
+  total?: UsageMetadata;
+  rounds?: UsageMetadata[];
+}
+
+const recordingHook = (reports: Reported[]): OrchestratorHooks => ({
+  afterModelResponse: async (_session, _responseText, total?: UsageMetadata, rounds?: UsageMetadata[]) => {
+    reports.push({total, rounds});
+  },
+});
+
+describe('the usage afterModelResponse receives', () => {
+  beforeEach(() => {
+    const quiet = () => undefined;
+    setLogger({debug: quiet, info: quiet, warn: quiet, error: quiet});
+  });
+
+  afterEach(() => setLogger());
+
+  it('reports the usage of every provider call in the turn, summing two tool rounds that reported different counts', async () => {
+    const first = {inputTokens: 100, outputTokens: 10, totalTokens: 110};
+    const second = {inputTokens: 200, outputTokens: 20, totalTokens: 220};
+    const reports: Reported[] = [];
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([toolRound(first), textRound('the answer', second)]),
+      promptBuilder,
+      registryReturning('found it'),
+      {hooks: recordingHook(reports)}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(reports).toEqual([{total: {inputTokens: 300, outputTokens: 30, totalTokens: 330}, rounds: [first, second]}]);
+  });
+
+  it('counts the rounds that reported usage, and reports nothing when no round did', async () => {
+    const only = {inputTokens: 40, outputTokens: 8, totalTokens: 48};
+    const reports: Reported[] = [];
+    const laterRoundSilent = createChatOrchestrator(
+      scriptedProvider([toolRound(only), textRound('done')]),
+      promptBuilder,
+      registryReturning('found it'),
+      {hooks: recordingHook(reports)}
+    );
+    const everyRoundSilent = createChatOrchestrator(
+      scriptedProvider([toolRound(), textRound('done')]),
+      promptBuilder,
+      registryReturning('found it'),
+      {hooks: recordingHook(reports)}
+    );
+
+    await laterRoundSilent.processMessage(createSession('ask'));
+    await everyRoundSilent.processMessage(createSession('ask'));
+
+    expect({laterRoundSilent: reports[0], everyRoundSilent: reports[1]}).toEqual({
+      laterRoundSilent: {total: only, rounds: [only]},
+      everyRoundSilent: {total: undefined, rounds: []},
+    });
+  });
+
+  it('hands a turn with no tool calls exactly the usage it reports today', async () => {
+    const usage = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const reports: Reported[] = [];
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([textRound('hello world', usage)]),
+      promptBuilder,
+      undefined,
+      {
+        hooks: recordingHook(reports),
+      }
+    );
+
+    await orchestrator.processMessage(createSession('hi'));
+
+    expect(reports).toEqual([{total: {inputTokens: 10, outputTokens: 5, totalTokens: 15}, rounds: [usage]}]);
+  });
+});