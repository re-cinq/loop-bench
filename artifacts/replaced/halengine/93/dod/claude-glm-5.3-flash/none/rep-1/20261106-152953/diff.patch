+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolResponse} from './tools/registry.js';
+
+// re-cinq/HALEngine#93: the usage afterModelResponse receives covers every provider call in the turn.
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+}
+
+// One scripted round per sendMessage call, so every round reports a known, different token count.
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryReturning = (response: ToolResponse): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => response
+  );
+  return registry;
+};
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+
+const stopWith = (stopReason: string, usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason, usage});
+
+// Drives the turn to completion and returns exactly what the hook was handed as its usage argument.
+const usageReportedFor = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _responseText, totalUsage) => {
+      reported = totalUsage;
+    },
+  };
+
+  const orchestrator = createChatOrchestrator(
+    scriptedProvider(rounds),
+    promptBuilder,
+    registryReturning({result: 'found it'}),
+    {hooks}
+  );
+  await orchestrator.processMessage(createSession('ask'));
+
+  return reported;
+};
+
+describe('afterModelResponse usage', () => {
+  it('reports the sum of every provider call in a turn driven through two tool rounds', async () => {
+    const reported = await usageReportedFor([
+      [
+        {type: 'text', text: 'first'},
+        TOOL_CALL,
+        stopWith('tool_use', {inputTokens: 100, outputTokens: 10, totalTokens: 110}),
+      ],
+      [
+        {type: 'text', text: 'second'},
+        TOOL_CALL,
+        stopWith('tool_use', {inputTokens: 400, outputTokens: 40, totalTokens: 440}),
+      ],
+      [{type: 'text', text: 'done'}, stopWith('end_turn', {inputTokens: 900, outputTokens: 90, totalTokens: 990})],
+    ]);
+
+    expect(reported).toEqual({inputTokens: 1400, outputTokens: 140, totalTokens: 1540});
+  });
+
+  it('still totals the rounds that reported when a round reports no usage', async () => {
+    const reported = await usageReportedFor([
+      [
+        {type: 'text', text: 'first'},
+        TOOL_CALL,
+        stopWith('tool_use', {inputTokens: 100, outputTokens: 10, totalTokens: 110}),
+      ],
+      [TOOL_CALL, stopWith('tool_use')],
+      [{type: 'text', text: 'done'}, stopWith('end_turn', {inputTokens: 400, outputTokens: 40, totalTokens: 440})],
+    ]);
+
+    expect(reported).toEqual({inputTokens: 500, outputTokens: 50, totalTokens: 550});
+  });
+
+  it('reports a turn with no tool calls exactly as the single provider call reported it', async () => {
+    const reported = await usageReportedFor([
+      [{type: 'text', text: 'done'}, stopWith('end_turn', {inputTokens: 10, outputTokens: 5, totalTokens: 15})],
+    ]);
+
+    expect(reported).toEqual({inputTokens: 10, outputTokens: 5, totalTokens: 15});
+  });
+
+  it('reports nothing when no round in the turn reported usage', async () => {
+    const reported = await usageReportedFor([
+      [TOOL_CALL, stopWith('tool_use')],
+      [{type: 'text', text: 'done'}, stopWith('end_turn')],
+    ]);
+
+    expect(reported).toBeUndefined();
+  });
+});