+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolResponse} from './tools/registry.js';
+
+// Acceptance tests for issue #93: the usage handed to afterModelResponse must cover every provider call of the turn.
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+// One scripted round per sendMessage call, to drive the tool loop round by round.
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryReturning = (response: ToolResponse): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => response
+  );
+  return registry;
+};
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'weather'}}};
+
+const stopRound = (stopReason: 'tool_use' | 'end_turn', usage?: UsageMetadata): MessageChunk => ({
+  type: 'stop',
+  stopReason,
+  usage,
+});
+
+describe('ChatOrchestrator turn usage reported to afterModelResponse', () => {
+  it('reports the usage of every provider call in a turn that ran two tool rounds, not the last round alone', async () => {
+    const firstRoundUsage: UsageMetadata = {inputTokens: 100, outputTokens: 20, totalTokens: 120};
+    const secondRoundUsage: UsageMetadata = {inputTokens: 30, outputTokens: 5, totalTokens: 35};
+    let receivedUsage: UsageMetadata | undefined;
+    let receivedRounds: UsageMetadata[] | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _responseText, usage) => {
+        receivedUsage = usage;
+        receivedRounds = usage?.rounds;
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, stopRound('tool_use', firstRoundUsage)],
+        [{type: 'text', text: 'the answer'}, stopRound('end_turn', secondRoundUsage)],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'found it'}),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('what is the weather?'));
+
+    expect({total: receivedUsage, rounds: receivedRounds}).toEqual({
+      total: {inputTokens: 130, outputTokens: 25, totalTokens: 155},
+      rounds: [firstRoundUsage, secondRoundUsage],
+    });
+  });
+
+  it('counts the rounds that reported usage when a round reports none, and still reports nothing when no round did', async () => {
+    const firstRoundUsage: UsageMetadata = {inputTokens: 50, outputTokens: 10, totalTokens: 60};
+    const lastRoundUsage: UsageMetadata = {inputTokens: 7, outputTokens: 2, totalTokens: 9};
+    const reportedTotals: (UsageMetadata | undefined)[] = [];
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _responseText, usage) => {
+        reportedTotals.push(
+          usage
+            ? {inputTokens: usage.inputTokens, outputTokens: usage.outputTokens, totalTokens: usage.totalTokens}
+            : undefined
+        );
+      },
+    };
+    const middleRoundSilent = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, stopRound('tool_use', firstRoundUsage)],
+        [TOOL_CALL, stopRound('tool_use')],
+        [{type: 'text', text: 'finally done'}, stopRound('end_turn', lastRoundUsage)],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'again'}),
+      {hooks}
+    );
+    const noRoundReports = createChatOrchestrator(
+      scriptedProvider([[{type: 'text', text: 'a plain answer'}, stopRound('end_turn')]]),
+      promptBuilder,
+      undefined,
+      {hooks}
+    );
+
+    await middleRoundSilent.processMessage(createSession('ask across three rounds'));
+    await noRoundReports.processMessage(createSession('ask with no usage'));
+
+    expect({silentMiddleRound: reportedTotals[0], nothingReported: reportedTotals[1]}).toEqual({
+      silentMiddleRound: {inputTokens: 57, outputTokens: 12, totalTokens: 69},
+      nothingReported: undefined,
+    });
+  });
+});