+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolResponse} from './tools/registry.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// One scripted round per sendMessage call; each round's stop chunk carries that call's own known usage.
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryReturning = (response: ToolResponse): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => response
+  );
+  return registry;
+};
+
+const toolCall = (id: string): MessageChunk => ({type: 'tool_use', toolCall: {id, name: 'lookup', input: {q: 'x'}}});
+const stopForTool = (usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason: 'tool_use', usage});
+const stopDone = (usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason: 'end_turn', usage});
+
+// One entry per afterModelResponse invocation, so the array's length is how often the hook fired for the turn.
+const recordingHook = (): {hooks: OrchestratorHooks; received: {text: string; usage?: UsageMetadata}[]} => {
+  const received: {text: string; usage?: UsageMetadata}[] = [];
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, text, usage) => {
+      received.push({text, usage});
+    },
+  };
+  return {hooks, received};
+};
+
+describe('afterModelResponse usage across the turn', () => {
+  it('reports the usage of every provider call in a two-round tool turn, not only the last', async () => {
+    const firstRound = {inputTokens: 100, outputTokens: 10, totalTokens: 110};
+    const lastRound = {inputTokens: 20, outputTokens: 5, totalTokens: 25};
+    const {hooks, received} = recordingHook();
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [{type: 'text', text: 'looking '}, toolCall('call-1'), stopForTool(firstRound)],
+        [{type: 'text', text: 'final answer'}, stopDone(lastRound)],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'found it'}),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(received).toEqual([
+      {text: 'looking final answer', usage: {inputTokens: 120, outputTokens: 15, totalTokens: 135}},
+    ]);
+  });
+
+  it('still counts the rounds that reported usage when a round between them reports none', async () => {
+    const firstRound = {inputTokens: 100, outputTokens: 10, totalTokens: 110};
+    const lastRound = {inputTokens: 20, outputTokens: 5, totalTokens: 25};
+    const {hooks, received} = recordingHook();
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [toolCall('call-1'), stopForTool(firstRound)],
+        [toolCall('call-2'), stopForTool()],
+        [{type: 'text', text: 'done'}, stopDone(lastRound)],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'r'}),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(received).toEqual([{text: 'done', usage: {inputTokens: 120, outputTokens: 15, totalTokens: 135}}]);
+  });
+
+  it('still reports nothing when no round in the turn reported usage', async () => {
+    const {hooks, received} = recordingHook();
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([[{type: 'text', text: 'plain answer'}, stopDone()]]),
+      promptBuilder,
+      undefined,
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(received).toEqual([{text: 'plain answer', usage: undefined}]);
+    expect(received[0]?.usage).toBeUndefined();
+  });
+});