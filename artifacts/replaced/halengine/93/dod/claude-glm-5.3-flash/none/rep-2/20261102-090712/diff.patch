@@ -0,0 +1,110 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolResponse} from './tools/registry.js';
+
+// Acceptance tests for re-cinq/HALEngine#93: the usage afterModelResponse receives must cover every
+// provider call of the turn, not only the last round's. The no-tool path is pinned unedited by
+// 'receives collected response text and usage' in chatOrchestrator.test.ts and is not re-pinned here.
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// One scripted round per sendMessage call, to drive the tool loop round by round.
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryReturning = (response: ToolResponse): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => response
+  );
+  return registry;
+};
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+const STOP_FOR_TOOL: MessageChunk = {type: 'stop', stopReason: 'tool_use'};
+const STOP_DONE: MessageChunk = {type: 'stop', stopReason: 'end_turn'};
+
+// Known and different per round, so a total that only carried one round cannot pass for the sum.
+const ROUND_ONE_USAGE: UsageMetadata = {inputTokens: 120, outputTokens: 35, totalTokens: 155};
+const ROUND_TWO_USAGE: UsageMetadata = {inputTokens: 40, outputTokens: 18, totalTokens: 58};
+
+// Drives a whole turn through the real orchestrator and returns what afterModelResponse was handed.
+const reportedUsage = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let seen: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _responseText, usage) => {
+      seen = usage;
+    },
+  };
+
+  const orchestrator = createChatOrchestrator(
+    scriptedProvider(rounds),
+    promptBuilder,
+    registryReturning({result: 'found it'}),
+    {hooks}
+  );
+  await orchestrator.processMessage(createSession('ask'));
+  return seen;
+};
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports the sum of every round that reported, not the last round alone', async () => {
+    const usage = await reportedUsage([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: ROUND_ONE_USAGE}],
+      [
+        {type: 'text', text: 'the answer'},
+        {type: 'stop', stopReason: 'end_turn', usage: ROUND_TWO_USAGE},
+      ],
+    ]);
+
+    expect(usage).toEqual({inputTokens: 160, outputTokens: 53, totalTokens: 213});
+  });
+
+  it('keeps counting the rounds that reported when a round in between reports none', async () => {
+    const usage = await reportedUsage([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: ROUND_ONE_USAGE}],
+      [TOOL_CALL, STOP_FOR_TOOL],
+      [
+        {type: 'text', text: 'the answer'},
+        {type: 'stop', stopReason: 'end_turn', usage: ROUND_TWO_USAGE},
+      ],
+    ]);
+
+    expect(usage).toEqual({inputTokens: 160, outputTokens: 53, totalTokens: 213});
+  });
+
+  it('still reports nothing when no round in the turn reported usage', async () => {
+    const usage = await reportedUsage([
+      [TOOL_CALL, STOP_FOR_TOOL],
+      [{type: 'text', text: 'the answer'}, STOP_DONE],
+    ]);
+
+    expect(usage).toBeUndefined();
+  });
+});