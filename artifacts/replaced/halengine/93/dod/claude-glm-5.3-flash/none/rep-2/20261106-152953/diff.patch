@@ -0,0 +1,139 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+// Follows the hook's own declaration, so the assertions stay about the delivered value whatever type it carries.
+type HookUsage = Parameters<NonNullable<OrchestratorHooks['afterModelResponse']>>[2];
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const createSession = (content: string): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content, timestamp: SENT_AT}],
+});
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+// One scripted round per sendMessage call, so every round of the turn can report its own usage.
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryAnswering = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => 'found it'
+  );
+  return registry;
+};
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+
+const capturingUsage = (): {hooks: OrchestratorHooks; state: () => {fired: boolean; seen: HookUsage}} => {
+  let fired = false;
+  let seen: HookUsage;
+
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      fired = true;
+      seen = usage;
+    },
+  };
+
+  return {hooks, state: () => ({fired, seen})};
+};
+
+// re-cinq/HALEngine#93: the usage afterModelResponse receives covers every provider call of the turn.
+describe('afterModelResponse turn usage', () => {
+  it('reports a turn total across two tool rounds, not only the last round', async () => {
+    const first = {inputTokens: 100, outputTokens: 40, totalTokens: 140};
+    const second = {inputTokens: 210, outputTokens: 18, totalTokens: 228};
+    const {hooks, state} = capturingUsage();
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: first}],
+        [
+          {type: 'text', text: 'the answer'},
+          {type: 'stop', stopReason: 'end_turn', usage: second},
+        ],
+      ]),
+      promptBuilder,
+      registryAnswering(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(state()).toEqual({
+      fired: true,
+      seen: {inputTokens: 310, outputTokens: 58, totalTokens: 368, rounds: [first, second]},
+    });
+  });
+
+  it('counts only the rounds that reported when a provider omits usage mid-turn', async () => {
+    const first = {inputTokens: 100, outputTokens: 40, totalTokens: 140};
+    const third = {inputTokens: 210, outputTokens: 18, totalTokens: 228};
+    const {hooks, state} = capturingUsage();
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: first}],
+        [
+          {type: 'text', text: 'still working'},
+          {type: 'stop', stopReason: 'tool_use'},
+        ],
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn', usage: third},
+        ],
+      ]),
+      promptBuilder,
+      registryAnswering(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(state()).toEqual({
+      fired: true,
+      seen: {inputTokens: 310, outputTokens: 58, totalTokens: 368, rounds: [first, third]},
+    });
+  });
+
+  it('still reports nothing when no round in the turn reported usage', async () => {
+    const {hooks, state} = capturingUsage();
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ],
+      ]),
+      promptBuilder,
+      registryAnswering(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(state()).toEqual({fired: true, seen: undefined});
+  });
+});