+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolResponse} from './tools/registry.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+describe('usage reported to afterModelResponse', () => {
+  // Drives one turn through the real orchestrator and records the third argument the hook receives.
+  const usageReportedForTurn = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+    let reported: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        reported = usage;
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider(rounds),
+      promptBuilder,
+      registryReturning({result: 'found it'}),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    return reported;
+  };
+
+  it('reports the sum of every provider call in a turn that ran two tool rounds', async () => {
+    const firstRoundUsage = {inputTokens: 10, outputTokens: 4, totalTokens: 14};
+    const lastRoundUsage = {inputTokens: 100, outputTokens: 8, totalTokens: 108};
+
+    const reported = await usageReportedForTurn([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: firstRoundUsage}],
+      [
+        {type: 'text', text: 'the answer'},
+        {type: 'stop', stopReason: 'end_turn', usage: lastRoundUsage},
+      ],
+    ]);
+
+    expect(reported).toEqual({inputTokens: 110, outputTokens: 12, totalTokens: 122});
+  });
+
+  it('counts the rounds that reported usage, and reports nothing when no round did', async () => {
+    const firstRoundUsage = {inputTokens: 7, outputTokens: 2, totalTokens: 9};
+    const lastRoundUsage = {inputTokens: 30, outputTokens: 5, totalTokens: 35};
+
+    const firstAndLastRoundsReport = await usageReportedForTurn([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: firstRoundUsage}],
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn', usage: lastRoundUsage},
+      ],
+    ]);
+    const noRoundReports = await usageReportedForTurn([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ]);
+
+    expect({firstAndLastRoundsReport, noRoundReports}).toEqual({
+      firstAndLastRoundsReport: {inputTokens: 37, outputTokens: 7, totalTokens: 44},
+      noRoundReports: undefined,
+    });
+  });
+});
+
+// One scripted round per sendMessage call, to drive the tool loop round by round.
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryReturning = (response: ToolResponse): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => response
+  );
+  return registry;
+};
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};