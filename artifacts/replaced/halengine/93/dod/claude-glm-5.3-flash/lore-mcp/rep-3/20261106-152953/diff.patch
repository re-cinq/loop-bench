+import {dirname, join} from 'node:path';
+import {fileURLToPath} from 'node:url';
+import ts from 'typescript';
+
+// ts-jest runs without diagnostics, so a wrong type annotation passes the suite silently. This
+// drives the real compiler over a consumer snippet instead, strict, against the real modules.
+const srcRoot = join(dirname(fileURLToPath(import.meta.url)), '..');
+
+const PROBE_FILE = join(srcRoot, '__turn_usage_probe__.ts');
+
+// What a deployer writes: the hook's usage parameter, named and typed by the hook's own signature.
+const PROBE = `
+import type {OrchestratorHooks} from './orchestration/chatOrchestrator.js';
+import type {TurnUsage} from './types/ai.js';
+
+let received: TurnUsage | undefined;
+const hook: NonNullable<OrchestratorHooks['afterModelResponse']> = async (_session, _text, turnUsage) => {
+  received = turnUsage;
+};
+const expectUsage = async (usage: TurnUsage): Promise<void> => {
+  await hook({sessionId: 's', userId: 'u', entries: []}, '', usage);
+};
+void expectUsage;
+void received;
+`;
+
+function probeDiagnostics(): string[] {
+  const options: ts.CompilerOptions = {
+    strict: true,
+    target: ts.ScriptTarget.ES2022,
+    module: ts.ModuleKind.NodeNext,
+    moduleResolution: ts.ModuleResolutionKind.NodeNext,
+    esModuleInterop: true,
+    skipLibCheck: true,
+    noEmit: true,
+  };
+  const host = ts.createCompilerHost(options, /*setParentNodes*/ true);
+  const realGetSourceFile = host.getSourceFile.bind(host);
+  host.getSourceFile = (fileName, languageVersionOrOptions, onError, shouldCreateNewSourceFile) =>
+    fileName === PROBE_FILE
+      ? ts.createSourceFile(fileName, PROBE, languageVersionOrOptions ?? ts.ScriptTarget.ES2022, true)
+      : realGetSourceFile(fileName, languageVersionOrOptions, onError, shouldCreateNewSourceFile);
+
+  const program = ts.createProgram([PROBE_FILE], options, host);
+  const probe = program.getSourceFile(PROBE_FILE);
+  if (!probe) return [`probe file ${PROBE_FILE} was not part of the program`];
+
+  return program.getSemanticDiagnostics(probe).map(d => ts.flattenDiagnosticMessageText(d.messageText, '\n'));
+}
+
+describe('the type of what afterModelResponse receives', () => {
+  it('types the usage afterModelResponse receives as TurnUsage, the turn total', () => {
+    // Nothing here reads source text: the compiler resolves the real modules, so the diagnostic is
+    // the missing export itself, not a string comparison.
+    expect(probeDiagnostics()).toEqual([]);
+  });
+});