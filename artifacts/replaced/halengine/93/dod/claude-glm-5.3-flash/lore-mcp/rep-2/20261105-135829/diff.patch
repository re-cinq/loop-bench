+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolResponse} from './tools/registry.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+// One scripted round per sendMessage call, so each provider call carries exactly the usage this test gave it.
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryReturning = (response: ToolResponse): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => response
+  );
+  return registry;
+};
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+
+const stopWith = (stopReason: string, usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason, usage});
+
+// Runs a whole turn through processMessage and records the usage its afterModelResponse hook was handed.
+const reportedUsage = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reported = usage;
+    },
+  };
+  const session: ChatSession = {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'ask', timestamp: SENT_AT}],
+  };
+
+  const orchestrator = createChatOrchestrator(
+    scriptedProvider(rounds),
+    new PromptBuilder({identity: 'You are a test assistant.'}),
+    registryReturning({result: 'r'}),
+    {hooks}
+  );
+
+  await orchestrator.processMessage(session);
+
+  return reported;
+};
+
+describe('afterModelResponse usage across a turn', () => {
+  it('hands the hook the usage of every provider call in the turn, not only the last round', async () => {
+    const reported = await reportedUsage([
+      [TOOL_CALL, stopWith('tool_use', {inputTokens: 100, outputTokens: 10, totalTokens: 110})],
+      [TOOL_CALL, stopWith('tool_use', {inputTokens: 60, outputTokens: 20, totalTokens: 80})],
+      [{type: 'text', text: 'done'}, stopWith('end_turn', {inputTokens: 30, outputTokens: 40, totalTokens: 70})],
+    ]);
+
+    expect(reported).toEqual({inputTokens: 190, outputTokens: 70, totalTokens: 260});
+  });
+
+  it('still counts the rounds that reported when another round reports none', async () => {
+    const reported = await reportedUsage([
+      [TOOL_CALL, stopWith('tool_use', {inputTokens: 100, outputTokens: 10, totalTokens: 110})],
+      [TOOL_CALL, stopWith('tool_use')],
+      [{type: 'text', text: 'done'}, stopWith('end_turn')],
+    ]);
+
+    expect(reported).toEqual({inputTokens: 100, outputTokens: 10, totalTokens: 110});
+  });
+
+  it('still reports no usage when no round of the turn reports one', async () => {
+    const reported = await reportedUsage([
+      [TOOL_CALL, stopWith('tool_use')],
+      [{type: 'text', text: 'done'}, stopWith('end_turn')],
+    ]);
+
+    expect(reported).toBeUndefined();
+  });
+});