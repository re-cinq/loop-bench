@@ -0,0 +1,133 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolResponse} from './tools/registry.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// One scripted round per sendMessage call, so each round's stop chunk carries that round's own usage.
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryReturning = (response: ToolResponse): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => response
+  );
+  return registry;
+};
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+
+// What the hook received, positionally: the rest parameter reads arguments the signature does not declare yet,
+// so the test compiles against today's type and still observes a wider call.
+const captureHookUsage = (): {hooks: OrchestratorHooks; received: () => {usage: unknown; rounds: unknown}} => {
+  let usage: unknown;
+  let rounds: unknown;
+
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _responseText, ...rest: unknown[]) => {
+      usage = rest[0];
+      rounds = rest[1];
+    },
+  };
+
+  return {hooks, received: () => ({usage, rounds})};
+};
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('afterModelResponse usage across rounds', () => {
+  it('reports usage summed across every provider call of a tool-driven turn, with the per-round breakdown', async () => {
+    const firstRound: UsageMetadata = {inputTokens: 100, outputTokens: 10, totalTokens: 110};
+    const secondRound: UsageMetadata = {inputTokens: 200, outputTokens: 20, totalTokens: 220};
+    const thirdRound: UsageMetadata = {inputTokens: 300, outputTokens: 30, totalTokens: 330};
+    const {hooks, received} = captureHookUsage();
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: firstRound}],
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: secondRound}],
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn', usage: thirdRound},
+        ],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'found it'}),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(received()).toStrictEqual({
+      usage: {inputTokens: 600, outputTokens: 60, totalTokens: 660},
+      rounds: [firstRound, secondRound, thirdRound],
+    });
+  });
+
+  it('counts only the rounds that reported usage, and reports nothing when no round reported', async () => {
+    const reported: UsageMetadata = {inputTokens: 11, outputTokens: 3, totalTokens: 14};
+    const alsoReported: UsageMetadata = {inputTokens: 20, outputTokens: 4, totalTokens: 24};
+    const partial = captureHookUsage();
+    const silent = captureHookUsage();
+
+    const turnThatStoppedReporting = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: reported}],
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: alsoReported}],
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'found it'}),
+      {hooks: partial.hooks}
+    );
+    const turnThatNeverReported = createChatOrchestrator(
+      scriptedProvider([
+        [
+          {type: 'text', text: 'ok'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'found it'}),
+      {hooks: silent.hooks}
+    );
+
+    await turnThatStoppedReporting.processMessage(createSession('ask'));
+    await turnThatNeverReported.processMessage(createSession('ask'));
+
+    expect({partialReport: partial.received(), silentReport: silent.received()}).toStrictEqual({
+      partialReport: {
+        usage: {inputTokens: 31, outputTokens: 7, totalTokens: 38},
+        rounds: [reported, alsoReported, undefined],
+      },
+      silentReport: {usage: undefined, rounds: [undefined]},
+    });
+  });
+});