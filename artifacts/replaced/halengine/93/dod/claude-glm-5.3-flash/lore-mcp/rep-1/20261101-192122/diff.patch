+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// Issue #93: the usage handed to afterModelResponse must cover every provider call in the turn, not the last round alone.
+
+const promptBuilder = new PromptBuilder({identity: 'You are a usage test assistant.'});
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {}}};
+
+const stopWith = (stopReason: string, usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason, usage});
+
+// One scripted round per sendMessage call, each round's stop carrying that round's known usage; an overrun round streams nothing.
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  const queue = [...rounds];
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield* queue.shift() ?? [];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryLookingUp = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  return registry;
+};
+
+const turnReportingTo = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reported = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(scriptedProvider(rounds), promptBuilder, registryLookingUp(), {hooks});
+  const session: ChatSession = {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'ask', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+
+  await orchestrator.processMessage(session);
+
+  return reported;
+};
+
+describe('usage reported to afterModelResponse', () => {
+  it('sums the usage of every provider call in a turn that ran two tool rounds, not the last round alone', async () => {
+    const reported = await turnReportingTo([
+      [
+        {type: 'text', text: 'Looking that up. '},
+        TOOL_CALL,
+        stopWith('tool_use', {inputTokens: 100, outputTokens: 20, totalTokens: 120}),
+      ],
+      [{type: 'text', text: 'Here it is.'}, stopWith('end_turn', {inputTokens: 30, outputTokens: 50, totalTokens: 80})],
+    ]);
+
+    expect(reported).toEqual({inputTokens: 130, outputTokens: 70, totalTokens: 200});
+  });
+
+  it('still counts the rounds that reported usage when one reports none, and reports nothing when no round did', async () => {
+    const roundWithoutUsage = await turnReportingTo([
+      [TOOL_CALL, stopWith('tool_use', {inputTokens: 10, outputTokens: 5, totalTokens: 15})],
+      [{type: 'text', text: 'Still working. '}, TOOL_CALL, stopWith('tool_use')],
+      [{type: 'text', text: 'Here it is.'}, stopWith('end_turn', {inputTokens: 4, outputTokens: 1, totalTokens: 5})],
+    ]);
+    const noRoundReporting = await turnReportingTo([
+      [TOOL_CALL, stopWith('tool_use')],
+      [{type: 'text', text: 'Here it is.'}, stopWith('end_turn')],
+    ]);
+
+    expect({roundWithoutUsage, noRoundReporting}).toEqual({
+      roundWithoutUsage: {inputTokens: 14, outputTokens: 6, totalTokens: 20},
+      noRoundReporting: undefined,
+    });
+  });
+});