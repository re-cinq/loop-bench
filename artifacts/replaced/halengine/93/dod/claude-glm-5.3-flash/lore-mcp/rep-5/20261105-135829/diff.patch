+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolResponse} from './tools/registry.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+// One scripted round per sendMessage call, to drive the tool loop round by round.
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryReturning = (response: ToolResponse): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => response
+  );
+  return registry;
+};
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+const stopWith = (stopReason: string, usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason, usage});
+
+// What every provider call in the turn reported, field by field.
+const summedUsage = (...rounds: UsageMetadata[]): UsageMetadata => ({
+  inputTokens: rounds.reduce((total, round) => total + round.inputTokens, 0),
+  outputTokens: rounds.reduce((total, round) => total + round.outputTokens, 0),
+  totalTokens: rounds.reduce((total, round) => total + round.totalTokens, 0),
+});
+
+describe('afterModelResponse usage across a turn', () => {
+  it('reports the usage of every provider call in a two-round tool turn, not only the last', async () => {
+    const firstRound = {inputTokens: 120, outputTokens: 30, totalTokens: 150};
+    const secondRound = {inputTokens: 40, outputTokens: 80, totalTokens: 120};
+    let reported: (UsageMetadata | undefined)[] = [];
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        reported = [usage];
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [{type: 'text', text: 'checking'}, TOOL_CALL, stopWith('tool_use', firstRound)],
+        [{type: 'text', text: 'the answer'}, stopWith('end_turn', secondRound)],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'found it'}),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(reported).toEqual([summedUsage(firstRound, secondRound)]);
+  });
+
+  it('counts the rounds that reported usage when a round in between reports none', async () => {
+    const firstRound = {inputTokens: 120, outputTokens: 30, totalTokens: 150};
+    const thirdRound = {inputTokens: 25, outputTokens: 15, totalTokens: 40};
+    let reported: (UsageMetadata | undefined)[] = [];
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        reported = [usage];
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, stopWith('tool_use', firstRound)],
+        [TOOL_CALL, stopWith('tool_use')],
+        [{type: 'text', text: 'done'}, stopWith('end_turn', thirdRound)],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'found it'}),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(reported).toEqual([summedUsage(firstRound, thirdRound)]);
+  });
+
+  it('still reports nothing when no round in the turn reported usage', async () => {
+    let reported: (UsageMetadata | undefined)[] = [];
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        reported = [usage];
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, stopWith('tool_use')],
+        [{type: 'text', text: 'done'}, stopWith('end_turn')],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'found it'}),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(reported).toEqual([undefined]);
+  });
+});