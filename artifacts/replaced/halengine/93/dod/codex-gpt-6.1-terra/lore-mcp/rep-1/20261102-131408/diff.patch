+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+
+// specs/hal-engine-config-hooks/spec.md#2
+it('reports usage across every provider call, including when some rounds omit it', async () => {
+  const first = {inputTokens: 11, outputTokens: 3, totalTokens: 14};
+  const last = {inputTokens: 23, outputTokens: 7, totalTokens: 30};
+  const middle = {inputTokens: 5, outputTokens: 2, totalTokens: 7};
+
+  async function run(usages: (UsageMetadata | undefined)[]): Promise<UsageMetadata | undefined> {
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        const current = round++;
+        if (current < 2) {
+          yield {type: 'tool_use', toolCall: {id: `call-${current}`, name: 'lookup', input: {}}};
+        }
+        yield {type: 'stop', stopReason: current < 2 ? 'tool_use' : 'end_turn', usage: usages[current]};
+      },
+      async generateStructured<T>(): Promise<T> {
+        throw new Error('Structured output is not used in this turn');
+      },
+    };
+    const registry = new ToolRegistry();
+    registry.register({name: 'lookup', description: 'lookup', inputSchema: {type: 'object'}}, async () => ({
+      result: 'found',
+    }));
+    let seen: UsageMetadata | undefined;
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'assistant'}), registry, {
+      hooks: {
+        afterModelResponse: async (_session, _text, usage) => {
+          seen = usage;
+        },
+      },
+    });
+    await orchestrator.processMessage({
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'question', timestamp: '2026-01-01T00:00:00.000Z'}],
+    });
+    return seen;
+  }
+
+  expect(
+    await Promise.all([
+      run([first, middle, last]),
+      run([first, undefined, last]),
+      run([undefined, undefined, undefined]),
+    ])
+  ).toEqual([
+    {inputTokens: 39, outputTokens: 12, totalTokens: 51},
+    {inputTokens: 34, outputTokens: 10, totalTokens: 44},
+    undefined,
+  ]);
+});