@@ -0,0 +1,79 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// One provider call: the chunks it yields, in order. A round that asks for a tool ends in a tool_use stop.
+type Round = MessageChunk[];
+
+const toolRound = (usage?: UsageMetadata): Round => [
+  {type: 'tool_use', toolCall: {id: 'c', name: 'lookup', input: {}}},
+  {type: 'stop', stopReason: 'tool_use', usage},
+];
+const finalRound = (usage?: UsageMetadata): Round => [
+  {type: 'text', text: 'done'},
+  {type: 'stop', stopReason: 'end_turn', usage},
+];
+
+// Runs one turn through the real entry point and returns the usage the afterModelResponse hook was handed.
+async function usageHandedToHook(rounds: Round[]): Promise<UsageMetadata | undefined> {
+  const reports: Array<UsageMetadata | undefined> = [];
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => void reports.push(usage),
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Looks something up.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  const orchestrator = createChatOrchestrator(
+    scriptedProvider(rounds),
+    new PromptBuilder({identity: 'Usage test.'}),
+    registry,
+    {hooks}
+  );
+  const session: ChatSession = {sessionId: 's', userId: 'u', entries: [{role: 'user', content: 'go', timestamp: 't'}]};
+
+  await orchestrator.processMessage(session);
+
+  return reports[0];
+}
+
+// Each call to sendMessage plays the next scripted round, so the test controls how many provider calls a turn makes.
+function scriptedProvider(rounds: Round[]): AIProvider {
+  let call = 0;
+  return {
+    async *sendMessage() {
+      const round = rounds[call++];
+      if (!round) throw new Error(`provider called ${call} times, but only ${rounds.length} rounds are scripted`);
+      yield* round;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+describe('usage reported across tool rounds', () => {
+  it('reports the summed usage of every provider call in a turn that ran two tool rounds', async () => {
+    const reported = await usageHandedToHook([
+      toolRound({inputTokens: 10, outputTokens: 5, totalTokens: 15}),
+      toolRound({inputTokens: 20, outputTokens: 7, totalTokens: 27}),
+      finalRound({inputTokens: 30, outputTokens: 9, totalTokens: 39}),
+    ]);
+
+    expect(reported).toEqual({inputTokens: 60, outputTokens: 21, totalTokens: 81});
+  });
+
+  it('still counts the rounds that reported when a middle round reports no usage', async () => {
+    const reported = await usageHandedToHook([
+      toolRound({inputTokens: 10, outputTokens: 5, totalTokens: 15}),
+      toolRound(undefined),
+      finalRound({inputTokens: 30, outputTokens: 9, totalTokens: 39}),
+    ]);
+
+    expect(reported).toEqual({inputTokens: 40, outputTokens: 14, totalTokens: 54});
+  });
+});