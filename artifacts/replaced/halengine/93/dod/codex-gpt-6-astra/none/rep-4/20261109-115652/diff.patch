--- /dev/null
+++ b/src/orchestration/chatOrchestrator.usage.acceptance.test.ts
@@ -0,0 +1,82 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const first: UsageMetadata = {inputTokens: 11, outputTokens: 3, totalTokens: 14};
+const second: UsageMetadata = {inputTokens: 23, outputTokens: 7, totalTokens: 30};
+const final: UsageMetadata = {inputTokens: 41, outputTokens: 13, totalTokens: 54};
+
+async function reportTurn(rounds: (UsageMetadata | undefined)[]) {
+  let providerCalls = 0;
+  const toolInputs: unknown[] = [];
+  const reports: (UsageMetadata | undefined)[] = [];
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const index = providerCalls++;
+      if (index >= rounds.length) throw new Error('Unexpected provider call');
+      if (index < rounds.length - 1) {
+        yield {type: 'tool_use', toolCall: {id: `call-${index}`, name: 'echo', input: {value: index}}};
+        yield {type: 'stop', stopReason: 'tool_use', usage: rounds[index]};
+      } else {
+        yield {type: 'text', text: 'done'};
+        yield {type: 'stop', stopReason: 'end_turn', usage: rounds[index]};
+      }
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('This conversation uses streaming messages only');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {
+      name: 'echo',
+      description: 'Return the supplied value',
+      inputSchema: {type: 'object', properties: {value: {type: 'number'}}, required: ['value']},
+    },
+    async input => {
+      toolInputs.push(input.value);
+      return JSON.stringify(input.value);
+    }
+  );
+  const session: ChatSession = {
+    sessionId: 'usage-turn',
+    userId: 'usage-consumer',
+    entries: [{role: 'user', content: 'Use echo twice, then answer.', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Answer the user.'}), registry, {
+    hooks: {
+      afterModelResponse: async (_session, _text, usage) => {
+        reports.push(usage);
+      },
+    },
+  });
+  const response = await orchestrator.processMessage(session);
+  return {providerCalls, toolInputs, response, reports};
+}
+
+// @spec specs/hal-engine-config-hooks/spec.md#9
+it('reports the sum of every provider call once per turn, preserving absent usage and the no-tool result', async () => {
+  const actual = {
+    complete: await reportTurn([first, second, final]),
+    missingFirst: await reportTurn([undefined, second, final]),
+    missingMiddle: await reportTurn([first, undefined, final]),
+    missingLast: await reportTurn([first, second, undefined]),
+    allMissing: await reportTurn([undefined, undefined, undefined]),
+    noTools: await reportTurn([first]),
+    noToolsMissing: await reportTurn([undefined]),
+  };
+  const toolTurn = {providerCalls: 3, toolInputs: [0, 1], response: 'done'};
+  const directTurn = {providerCalls: 1, toolInputs: [], response: 'done'};
+
+  expect(actual).toEqual({
+    complete: {...toolTurn, reports: [{inputTokens: 75, outputTokens: 23, totalTokens: 98}]},
+    missingFirst: {...toolTurn, reports: [{inputTokens: 64, outputTokens: 20, totalTokens: 84}]},
+    missingMiddle: {...toolTurn, reports: [{inputTokens: 52, outputTokens: 16, totalTokens: 68}]},
+    missingLast: {...toolTurn, reports: [{inputTokens: 34, outputTokens: 10, totalTokens: 44}]},
+    allMissing: {...toolTurn, reports: [undefined]},
+    noTools: {...directTurn, reports: [first]},
+    noToolsMissing: {...directTurn, reports: [undefined]},
+  });
+});