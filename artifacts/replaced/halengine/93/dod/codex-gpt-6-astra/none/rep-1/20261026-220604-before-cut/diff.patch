index 0000000..58b5679
--- /dev/null
+++ b/src/orchestration/usage.acceptance.test.ts
@@ -0,0 +1,89 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const FIRST: UsageMetadata = {inputTokens: 11, outputTokens: 2, totalTokens: 13};
+const SECOND: UsageMetadata = {inputTokens: 23, outputTokens: 5, totalTokens: 28};
+const LAST: UsageMetadata = {inputTokens: 37, outputTokens: 7, totalTokens: 44};
+
+// The ticket's scripted provider supplies protocol values to the real orchestrator and tool registry.
+async function reportTurn(roundUsage: (UsageMetadata | undefined)[]) {
+  let providerCalls = 0;
+  let toolCalls = 0;
+  const reported: (UsageMetadata | undefined)[] = [];
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const round = providerCalls++;
+      if (round >= roundUsage.length) throw new Error('Unexpected provider call');
+      if (round < roundUsage.length - 1) {
+        yield {type: 'tool_use', toolCall: {id: `call-${round}`, name: 'count', input: {}}};
+        yield {type: 'stop', stopReason: 'tool_use', usage: roundUsage[round]};
+        return;
+      }
+      yield {type: 'text', text: 'done'};
+      yield {type: 'stop', stopReason: 'end_turn', usage: roundUsage[round]};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('This turn does not request structured output');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register({name: 'count', description: 'Count calls', inputSchema: {type: 'object'}}, async () => {
+    toolCalls++;
+    return {result: String(toolCalls)};
+  });
+  const orchestrator = createChatOrchestrator(
+    provider,
+    new PromptBuilder({identity: 'Answer the question.'}),
+    registry,
+    {
+      hooks: {
+        afterModelResponse: async (_session, _text, usage) => {
+          reported.push(usage);
+        },
+      },
+    }
+  );
+  const text = await orchestrator.processMessage({
+    sessionId: 'usage-turn',
+    userId: 'customer',
+    entries: [{role: 'user', content: 'Count twice', timestamp: '2026-01-01T00:00:00.000Z'}],
+  });
+  return {providerCalls, toolCalls, text, reported};
+}
+
+// spec: specs/hal-engine-config-hooks/spec.md#9
+it('reports the sum of every provider call after two tool rounds', async () => {
+  expect(await reportTurn([FIRST, SECOND, LAST])).toEqual({
+    providerCalls: 3,
+    toolCalls: 2,
+    text: 'done',
+    reported: [{inputTokens: 71, outputTokens: 14, totalTokens: 85}],
+  });
+});
+
+// spec: specs/hal-engine-config-hooks/spec.md#10
+it('sums reported rounds despite missing usage and preserves an entirely unreported turn', async () => {
+  const results = [];
+  for (const rounds of [
+    [undefined, FIRST, LAST],
+    [FIRST, undefined, LAST],
+    [FIRST, LAST, undefined],
+    [undefined, undefined, undefined],
+  ]) {
+    results.push(await reportTurn(rounds));
+  }
+  const counted = {
+    providerCalls: 3,
+    toolCalls: 2,
+    text: 'done',
+    reported: [{inputTokens: 48, outputTokens: 9, totalTokens: 57}],
+  };
+  expect(results).toEqual([
+    counted,
+    counted,
+    counted,
+    {providerCalls: 3, toolCalls: 2, text: 'done', reported: [undefined]},
+  ]);
+});