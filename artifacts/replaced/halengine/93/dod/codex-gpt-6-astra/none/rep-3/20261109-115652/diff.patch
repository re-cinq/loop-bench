@@ -0,0 +1,93 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const firstUsage: UsageMetadata = {inputTokens: 11, outputTokens: 3, totalTokens: 14};
+const secondUsage: UsageMetadata = {inputTokens: 23, outputTokens: 5, totalTokens: 28};
+const finalUsage: UsageMetadata = {inputTokens: 37, outputTokens: 7, totalTokens: 44};
+
+async function runTurn(roundUsage: (UsageMetadata | undefined)[]) {
+  let providerCalls = 0;
+  const toolInputs: unknown[] = [];
+  const reported: (UsageMetadata | undefined)[] = [];
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const round = providerCalls++;
+      if (round >= roundUsage.length) throw new Error('Unexpected provider call beyond the script');
+      if (round < roundUsage.length - 1) {
+        yield {type: 'tool_use', toolCall: {id: `call-${round}`, name: 'echo', input: {round}}};
+        yield {type: 'stop', stopReason: 'tool_use', usage: roundUsage[round]};
+      } else {
+        yield {type: 'text', text: 'done'};
+        yield {type: 'stop', stopReason: 'end_turn', usage: roundUsage[round]};
+      }
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('This turn uses streaming responses only');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'echo', description: 'Return the supplied input', inputSchema: {type: 'object'}},
+    async input => {
+      toolInputs.push(input);
+      return JSON.stringify(input);
+    }
+  );
+  const orchestrator = createChatOrchestrator(
+    provider,
+    new PromptBuilder({identity: 'Use echo, then answer.'}),
+    registry,
+    {
+      hooks: {
+        afterModelResponse: async (_session, _text, usage) => {
+          reported.push(usage);
+        },
+      },
+    }
+  );
+  const response = await orchestrator.processMessage({
+    sessionId: 'usage-turn',
+    userId: 'usage-user',
+    entries: [{role: 'user', content: 'Echo twice', timestamp: '2026-01-01T00:00:00.000Z'}],
+  });
+  return {response, providerCalls, toolInputs, reported};
+}
+
+// @spec specs/hal-engine-config-hooks/spec.md#8
+it('reports the sum of all three provider calls after two tool rounds', async () => {
+  const result = await runTurn([firstUsage, secondUsage, finalUsage]);
+
+  expect(result).toEqual({
+    response: 'done',
+    providerCalls: 3,
+    toolInputs: [{round: 0}, {round: 1}],
+    reported: [{inputTokens: 71, outputTokens: 15, totalTokens: 86}],
+  });
+});
+
+// @spec specs/hal-engine-config-hooks/spec.md#9
+it('sums reported rounds despite missing usage and preserves absent and single-call usage', async () => {
+  const scenarios = [
+    [undefined, secondUsage, finalUsage],
+    [firstUsage, undefined, finalUsage],
+    [firstUsage, secondUsage, undefined],
+    [undefined, undefined, undefined],
+    [{inputTokens: 0, outputTokens: 0, totalTokens: 0}, undefined, undefined],
+    [firstUsage],
+    [undefined],
+  ];
+  const results = [];
+  for (const usage of scenarios) results.push((await runTurn(usage)).reported);
+
+  expect(results).toEqual([
+    [{inputTokens: 60, outputTokens: 12, totalTokens: 72}],
+    [{inputTokens: 48, outputTokens: 10, totalTokens: 58}],
+    [{inputTokens: 34, outputTokens: 8, totalTokens: 42}],
+    [undefined],
+    [{inputTokens: 0, outputTokens: 0, totalTokens: 0}],
+    [firstUsage],
+    [undefined],
+  ]);
+});