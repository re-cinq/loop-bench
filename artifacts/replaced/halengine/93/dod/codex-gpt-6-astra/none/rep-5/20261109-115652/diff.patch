+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const first: UsageMetadata = {inputTokens: 11, outputTokens: 3, totalTokens: 14};
+const second: UsageMetadata = {inputTokens: 23, outputTokens: 5, totalTokens: 28};
+const final: UsageMetadata = {inputTokens: 37, outputTokens: 7, totalTokens: 44};
+
+// The ticket's scripted provider emits one known usage record per real provider call.
+async function runTurn(usages: (UsageMetadata | undefined)[]) {
+  let providerCalls = 0;
+  const toolInputs: unknown[] = [];
+  const hookCalls: {text: string; usage: UsageMetadata | undefined}[] = [];
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const round = providerCalls++;
+      if (round >= usages.length) throw new Error('Unexpected provider call');
+      const more = round < usages.length - 1;
+      if (more) {
+        yield {type: 'tool_use', toolCall: {id: `call-${round}`, name: 'echo', input: {round}}};
+      } else {
+        yield {type: 'text', text: 'done'};
+      }
+      yield {type: 'stop', stopReason: more ? 'tool_use' : 'end_turn', usage: usages[round]};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured output is not part of this turn');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register({name: 'echo', description: 'Echo the round', inputSchema: {type: 'object'}}, async input => {
+    toolInputs.push(input);
+    return JSON.stringify(input);
+  });
+  const session: ChatSession = {
+    sessionId: 'usage-turn',
+    userId: 'user',
+    entries: [{role: 'user', content: 'Run the tools', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Assistant'}), registry, {
+    hooks: {
+      afterModelResponse: async (_session, text, usage) => {
+        hookCalls.push({text, usage});
+      },
+    },
+  });
+  const response = await orchestrator.processMessage(session);
+  return {response, providerCalls, toolInputs, hookCalls};
+}
+
+// @spec specs/hal-engine-config-hooks/spec.md#9
+it('reports the sum of all three provider calls after two tool rounds', async () => {
+  const result = await runTurn([first, second, final]);
+
+  expect(result).toEqual({
+    response: 'done',
+    providerCalls: 3,
+    toolInputs: [{round: 0}, {round: 1}],
+    hookCalls: [{text: 'done', usage: {inputTokens: 71, outputTokens: 15, totalTokens: 86}}],
+  });
+});
+
+// @spec specs/hal-engine-config-hooks/spec.md#10
+it('sums reported rounds despite missing usage and preserves absent and single-call usage', async () => {
+  const cases = [
+    {rounds: [undefined, first, second], expected: {inputTokens: 34, outputTokens: 8, totalTokens: 42}},
+    {rounds: [first, undefined, second], expected: {inputTokens: 34, outputTokens: 8, totalTokens: 42}},
+    {rounds: [first, second, undefined], expected: {inputTokens: 34, outputTokens: 8, totalTokens: 42}},
+    {rounds: [undefined, undefined, undefined], expected: undefined},
+    {rounds: [first], expected: first},
+    {rounds: [undefined], expected: undefined},
+    {
+      rounds: [{inputTokens: 0, outputTokens: 0, totalTokens: 0}],
+      expected: {inputTokens: 0, outputTokens: 0, totalTokens: 0},
+    },
+  ];
+  const observed = [];
+  for (const {rounds} of cases) observed.push((await runTurn(rounds)).hookCalls);
+
+  expect(observed).toEqual(cases.map(({expected}) => [{text: 'done', usage: expected}]));
+});