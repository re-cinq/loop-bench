+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const first: UsageMetadata = {inputTokens: 11, outputTokens: 3, totalTokens: 14};
+const second: UsageMetadata = {inputTokens: 23, outputTokens: 5, totalTokens: 28};
+const final: UsageMetadata = {inputTokens: 37, outputTokens: 7, totalTokens: 44};
+
+// The ticket requires a scripted provider: each script supplies real protocol chunks to the real tool loop.
+async function reportTurns(turns: (UsageMetadata | undefined)[][]) {
+  const reports: (UsageMetadata | undefined)[] = [];
+  let providerCalls = 0;
+  let toolCalls = 0;
+  const scripts = turns.flatMap(turn =>
+    turn.map((usage, round): MessageChunk[] =>
+      round < turn.length - 1
+        ? [
+            {type: 'tool_use', toolCall: {id: `call-${round}`, name: 'add', input: {left: round, right: 1}}},
+            {type: 'stop', stopReason: 'tool_use', usage},
+          ]
+        : [
+            {type: 'text', text: 'done'},
+            {type: 'stop', stopReason: 'end_turn', usage},
+          ]
+    )
+  );
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const chunks = scripts[providerCalls++];
+      if (!chunks) throw new Error('Provider called beyond the scripted turn');
+      yield* chunks;
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured output is not part of this conversation');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {
+      name: 'add',
+      description: 'Add two numbers',
+      inputSchema: {
+        type: 'object',
+        properties: {left: {type: 'number'}, right: {type: 'number'}},
+        required: ['left', 'right'],
+      },
+    },
+    async input => {
+      toolCalls++;
+      return {result: String(Number(input.left) + Number(input.right))};
+    }
+  );
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Calculate sums.'}), registry, {
+    hooks: {
+      afterModelResponse: async (_session, _text, usage) => {
+        reports.push(usage);
+      },
+    },
+  });
+  for (const [index] of turns.entries()) {
+    await orchestrator.processMessage({
+      sessionId: `session-${index}`,
+      userId: 'usage-customer',
+      entries: [{role: 'user', content: 'Calculate', timestamp: '2026-01-01T00:00:00.000Z'}],
+    });
+  }
+  return {reports, providerCalls, toolCalls};
+}
+
+// @spec specs/hal-engine-config-hooks/spec.md#9
+it('reports the sum of every provider call after two tool rounds', async () => {
+  const result = await reportTurns([[first, second, final]]);
+
+  expect(result).toEqual({
+    reports: [{inputTokens: 71, outputTokens: 15, totalTokens: 86}],
+    providerCalls: 3,
+    toolCalls: 2,
+  });
+});
+
+// @spec specs/hal-engine-config-hooks/spec.md#10
+it('sums reported rounds despite missing usage and reports nothing for an unmetered turn', async () => {
+  const result = await reportTurns([
+    [undefined, first, second],
+    [first, undefined, second],
+    [first, second, undefined],
+    [undefined, undefined, undefined],
+    [final],
+  ]);
+
+  expect(result).toEqual({
+    reports: [
+      {inputTokens: 34, outputTokens: 8, totalTokens: 42},
+      {inputTokens: 34, outputTokens: 8, totalTokens: 42},
+      {inputTokens: 34, outputTokens: 8, totalTokens: 42},
+      undefined,
+      final,
+    ],
+    providerCalls: 13,
+    toolCalls: 8,
+  });
+});