@@ -0,0 +1,99 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+
+const first = {inputTokens: 11, outputTokens: 3, totalTokens: 14};
+const second = {inputTokens: 23, outputTokens: 7, totalTokens: 30};
+const last = {inputTokens: 41, outputTokens: 13, totalTokens: 54};
+
+// The ticket's scripted provider supplies real chunks to the unmodified orchestrator and tool registry.
+async function reportTurn(rounds: (UsageMetadata | undefined)[]) {
+  let calls = 0;
+  const resultsReceived: string[] = [];
+  const reports: (UsageMetadata | undefined)[] = [];
+  const provider: AIProvider = {
+    async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      const round = calls++;
+      if (round >= rounds.length) throw new Error('Unexpected provider call');
+      const content = params.messages.at(-1)?.content;
+      if (Array.isArray(content)) {
+        for (const item of content) {
+          if (item.type === 'tool_result') resultsReceived.push(item.content);
+        }
+      }
+      if (round < rounds.length - 1) {
+        yield {type: 'tool_use', toolCall: {id: `call-${round}`, name: 'double', input: {value: round + 1}}};
+        yield {type: 'stop', stopReason: 'tool_use', usage: rounds[round]};
+      } else {
+        yield {type: 'text', text: 'done'};
+        yield {type: 'stop', stopReason: 'end_turn', usage: rounds[round]};
+      }
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('This script uses streaming responses only');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {
+      name: 'double',
+      description: 'Double a number',
+      inputSchema: {type: 'object', properties: {value: {type: 'number'}}, required: ['value']},
+    },
+    async input => String(Number(input.value) * 2)
+  );
+  const orchestrator = createChatOrchestrator(
+    provider,
+    new PromptBuilder({identity: 'Calculate using tools.'}),
+    registry,
+    {
+      hooks: {
+        afterModelResponse: async (_session, _text, usage) => {
+          reports.push(usage);
+        },
+      },
+    }
+  );
+  const text = await orchestrator.processMessage({
+    sessionId: 'usage-acceptance',
+    userId: 'customer',
+    entries: [{role: 'user', content: 'Double one, then two.', timestamp: '2026-01-01T00:00:00.000Z'}],
+  });
+  return {calls, resultsReceived, reports, text};
+}
+
+describe('Turn usage acceptance', () => {
+  // spec: specs/hal-engine-config-hooks/spec.md#9
+  it('reports the sum of all three provider calls after two tool rounds', async () => {
+    expect(await reportTurn([first, second, last])).toEqual({
+      calls: 3,
+      resultsReceived: ['2', '4'],
+      reports: [{inputTokens: 75, outputTokens: 23, totalTokens: 98}],
+      text: 'done',
+    });
+  });
+
+  // spec: specs/hal-engine-config-hooks/spec.md#10
+  it('sums reported rounds across missing usage and preserves absence when none report', async () => {
+    const scripts = [
+      [undefined, second, last],
+      [first, undefined, last],
+      [first, second, undefined],
+      [undefined, undefined, undefined],
+      [undefined, {inputTokens: 0, outputTokens: 0, totalTokens: 0}, undefined],
+    ];
+    const reports = [];
+    for (const script of scripts) reports.push(await reportTurn(script));
+
+    expect(reports).toEqual(
+      [
+        {inputTokens: 64, outputTokens: 20, totalTokens: 84},
+        {inputTokens: 52, outputTokens: 16, totalTokens: 68},
+        {inputTokens: 34, outputTokens: 10, totalTokens: 44},
+        undefined,
+        {inputTokens: 0, outputTokens: 0, totalTokens: 0},
+      ].map(usage => ({calls: 3, resultsReceived: ['2', '4'], reports: [usage], text: 'done'}))
+    );
+  });
+});