@@ -0,0 +1,90 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const first = {inputTokens: 11, outputTokens: 3, totalTokens: 14};
+const second = {inputTokens: 23, outputTokens: 5, totalTokens: 28};
+const last = {inputTokens: 37, outputTokens: 7, totalTokens: 44};
+
+async function reportTurn(rounds: (UsageMetadata | undefined)[]) {
+  let providerCalls = 0;
+  const executed: number[] = [];
+  const reports: Parameters<NonNullable<OrchestratorHooks['afterModelResponse']>>[2][] = [];
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const round = providerCalls++;
+      if (round >= rounds.length) throw new Error('Unexpected provider call');
+      if (round < rounds.length - 1) {
+        yield {type: 'tool_use', toolCall: {id: `call-${round}`, name: 'square', input: {value: round + 2}}};
+        yield {type: 'stop', stopReason: 'tool_use', usage: rounds[round]};
+      } else {
+        yield {type: 'text', text: 'done'};
+        yield {type: 'stop', stopReason: 'end_turn', usage: rounds[round]};
+      }
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured generation is not part of this turn');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {
+      name: 'square',
+      description: 'Square a number',
+      inputSchema: {type: 'object', properties: {value: {type: 'number'}}, required: ['value']},
+    },
+    async input => {
+      const result = Number(input.value) ** 2;
+      executed.push(result);
+      return String(result);
+    }
+  );
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Calculate.'}), registry, {
+    hooks: {
+      afterModelResponse: async (_session, _text, usage) => {
+        reports.push(usage);
+      },
+    },
+  });
+  const text = await orchestrator.processMessage({
+    sessionId: 'usage-acceptance',
+    userId: 'user',
+    entries: [{role: 'user', content: 'Square 2 and 3.', timestamp: '2026-01-01T00:00:00.000Z'}],
+  });
+  return {providerCalls, executed, text, reports};
+}
+
+// spec: specs/hal-engine-config-hooks/spec.md#8
+it('reports the sum of every provider call after two tool rounds', async () => {
+  expect(await reportTurn([first, second, last])).toEqual({
+    providerCalls: 3,
+    executed: [4, 9],
+    text: 'done',
+    reports: [{inputTokens: 71, outputTokens: 15, totalTokens: 86}],
+  });
+});
+
+// spec: specs/hal-engine-config-hooks/spec.md#9
+it('counts reported rounds when usage is missing and preserves an entirely unreported turn', async () => {
+  const reports = [];
+  for (const rounds of [
+    [undefined, second, last],
+    [first, undefined, last],
+    [first, second, undefined],
+    [undefined, undefined, undefined],
+    [undefined],
+    [first],
+  ]) {
+    reports.push((await reportTurn(rounds)).reports);
+  }
+  expect(reports).toEqual([
+    [{inputTokens: 60, outputTokens: 12, totalTokens: 72}],
+    [{inputTokens: 48, outputTokens: 10, totalTokens: 58}],
+    [{inputTokens: 34, outputTokens: 8, totalTokens: 42}],
+    [undefined],
+    [undefined],
+    [first],
+  ]);
+});