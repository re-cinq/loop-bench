@@ -0,0 +1,47 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+
+// @spec specs/hal-engine-config-hooks/spec.md#10
+it('includes the lookup call usage in the final answer total', async () => {
+  const rounds: MessageChunk[][] = [
+    [
+      {type: 'tool_use', toolCall: {id: 'lookup-1', name: 'lookup', input: {}}},
+      {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 8, outputTokens: 2, totalTokens: 10}},
+    ],
+    [
+      {type: 'text', text: 'Found.'},
+      {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 13, outputTokens: 3, totalTokens: 16}},
+    ],
+  ];
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield* rounds.shift() ?? [];
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured output is outside this contract.');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Look up a value.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  let reported: UsageMetadata | undefined;
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Answer lookups.'}), registry, {
+    hooks: {
+      afterModelResponse: async (_session, _text, usage) => {
+        reported = usage;
+      },
+    },
+  });
+
+  await orchestrator.processMessage({
+    sessionId: 'lookup-session',
+    userId: 'lookup-user',
+    entries: [{role: 'user', content: 'Look it up.', timestamp: '2026-01-01T00:00:00.000Z'}],
+  });
+
+  expect(reported).toEqual({inputTokens: 21, outputTokens: 5, totalTokens: 26});
+});