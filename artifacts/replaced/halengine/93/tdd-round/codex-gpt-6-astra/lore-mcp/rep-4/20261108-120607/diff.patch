+import {sumTurnUsage} from './turnUsage.js';
+import type {UsageMetadata} from '../types/ai.js';
+
+// @spec specs/hal-engine-config-hooks/spec.md#11
+it('sums reported token fields across rounds without inventing missing usage', () => {
+  const rounds: Array<UsageMetadata | undefined> = [
+    undefined,
+    {inputTokens: 11, outputTokens: 2, totalTokens: 13},
+    undefined,
+    {inputTokens: 23, outputTokens: 3, totalTokens: 26},
+    {inputTokens: 37, outputTokens: 5, totalTokens: 42},
+    undefined,
+  ];
+
+  expect({
+    reported: rounds.reduce(sumTurnUsage, undefined),
+    absent: [undefined, undefined].reduce<UsageMetadata | undefined>(sumTurnUsage, undefined),
+  }).toEqual({reported: {inputTokens: 71, outputTokens: 10, totalTokens: 81}, absent: undefined});
+});
diff --git a/src/orchestration/turnUsage.ts b/src/orchestration/turnUsage.ts
new file mode 100644
index 0000000..e9da77f
--- /dev/null
+++ b/src/orchestration/turnUsage.ts
@@ -0,0 +1,14 @@
+import type {UsageMetadata} from '../types/ai.js';
+
+export function sumTurnUsage(
+  total: UsageMetadata | undefined,
+  round: UsageMetadata | undefined
+): UsageMetadata | undefined {
+  if (!round) return total;
+  if (!total) return round;
+  return {
+    inputTokens: total.inputTokens + round.inputTokens,
+    outputTokens: total.outputTokens + round.outputTokens,
+    totalTokens: total.totalTokens + round.totalTokens,
+  };
+}
