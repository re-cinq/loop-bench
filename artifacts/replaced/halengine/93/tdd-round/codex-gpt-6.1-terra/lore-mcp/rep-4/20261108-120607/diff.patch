@@ -0,0 +1,42 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// spec: specs/hal-engine-config-hooks/spec.md#9
+it('adds usage reported before and after a tool call', async () => {
+  const rounds: MessageChunk[][] = [
+    [
+      {type: 'tool_use', toolCall: {id: '1', name: 'lookup', input: {}}},
+      {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 11, outputTokens: 2, totalTokens: 13}},
+    ],
+    [{type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 23, outputTokens: 3, totalTokens: 26}}],
+  ];
+  let round = 0;
+  const provider: AIProvider = {
+    async *sendMessage() {
+      yield* rounds[round++];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'Lookup', inputSchema: {type: 'object'}}, async () => 'found');
+  let reported: UsageMetadata | undefined;
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), registry, {
+    hooks: {
+      afterModelResponse: async (_session, _text, usage) => {
+        reported = usage;
+      },
+    },
+  });
+  const session: ChatSession = {
+    sessionId: 'session',
+    userId: 'user',
+    entries: [{role: 'user', content: 'Hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  await orchestrator.processMessage(session);
+  expect(reported).toEqual({inputTokens: 34, outputTokens: 5, totalTokens: 39});
+});