+
+    await expect(registry.execute('missing_tool', {})).rejects.toThrow('Unknown tool: missing_tool');
+  });
+
+  it('compiles a static tool schema once at register time and reuses it across ten execute calls', async () => {
+    const registry = new ToolRegistry();
+    let schemaReads = 0;
+    const schema: Record<string, unknown> = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    const definition = {
+      name: 'get_weather',
+      description: 'Get weather for a location',
+      get inputSchema(): Record<string, unknown> {
+        schemaReads += 1;
+        return schema;
+      },
+    };
+
+    registry.register(definition, async () => 'sunny');
+    for (let i = 0; i < 10; i++) {
+      await registry.execute('get_weather', {location: 'Berlin'});
+    }
+
+    expect(schemaReads).toBe(1);
+  });
+
+  it('validates a function-valued tool definition against the schema returned for the current call', async () => {
+    const registry = new ToolRegistry();
+    const citySchema = {
+      type: 'object',
+      properties: {city: {type: 'string'}, country: {type: 'string'}},
+      required: ['city'],
+    };
+    const countrySchema = {
+      type: 'object',
+      properties: {city: {type: 'string'}, country: {type: 'string'}},
+      required: ['country'],
+    };
+    let activeSchema = citySchema;
+    registry.register(
+      () => ({
+        name: 'dynamic_lookup',
+        description: 'Tool whose schema changes between calls',
+        inputSchema: activeSchema,
+      }),
+      async () => 'ok'
+    );
+
+    const firstCall = await registry.execute('dynamic_lookup', {city: 'Paris'});
+    activeSchema = countrySchema;
+    const secondCallMissingCountry = await registry.execute('dynamic_lookup', {city: 'Paris'});
+    const thirdCallWithCountry = await registry.execute('dynamic_lookup', {country: 'France'});
+
+    expect({
+      firstResult: firstCall.result,
+      secondMentionsCountry:
+        secondCallMissingCountry.result.includes('country') && /required/i.test(secondCallMissingCountry.result),
+      thirdResult: thirdCallWithCountry.result,
+    }).toEqual({
+      firstResult: 'ok',
+      secondMentionsCountry: true,
+      thirdResult: 'ok',
+    });
+  });
+});
