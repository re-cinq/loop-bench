+
+  it('rejects a wrong-typed field naming the path and expected type without leaking the value in result or logs', async () => {
+    const emitted: Array<{category: string; message: string; fields?: Record<string, unknown>}> = [];
+    const sink = (category: string, message: string, fields?: Record<string, unknown>) => {
+      emitted.push({category, message, fields});
+    };
+    setLogger({debug: sink, info: sink, warn: sink, error: sink} satisfies Logger);
+
+    const registry = new ToolRegistry();
