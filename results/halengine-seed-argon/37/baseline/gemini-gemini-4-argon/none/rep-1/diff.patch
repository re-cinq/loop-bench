+      },
+      required: ['location'],
+    };
+    registry.register({name: 'fetch_forecast', description: 'Forecast', inputSchema: schema}, async input => {
+      invokedWith.push(input);
+      return 'clear';
+    });
+
+    const {result} = await registry.execute('fetch_forecast', {coords: {}});
