@@ -0,0 +1,123 @@
+import {jest} from '@jest/globals';
+import {setLogger} from '../../shared/logger.js';
+import {collectChunks, userMessage} from '../providerTestSupport.js';
+
+interface VertexInitCall {
+  project?: string;
+  location?: string;
+  apiEndpoint?: string;
+  googleAuthOptions?: Record<string, unknown>;
+}
+
+const mockGenerateContentStream = jest.fn<() => Promise<unknown>>();
+const mockVertexAI = jest.fn<(init: VertexInitCall) => unknown>();
+
+jest.unstable_mockModule('../requireOptionalPeer.js', () => ({
+  requireOptionalPeer: () => ({
+    VertexAI: mockVertexAI.mockImplementation(() => ({
+      getGenerativeModel: () => ({
+        generateContentStream: mockGenerateContentStream,
+      }),
+    })),
+  }),
+}));
+
+const {createVertexProvider} = await import('./vertexProvider.js');
+type VertexConfig = import('./vertexProvider.js').VertexConfig;
+
+const singleRegionConfig: VertexConfig = {
+  type: 'vertex',
+  projectId: 'test-project',
+  location: 'europe-west4',
+  modelId: 'gemini-2.5-flash',
+  maxTokens: 1024,
+};
+
+beforeEach(() => {
+  jest.clearAllMocks();
+});
+
+afterEach(() => {
+  setLogger();
+});
+
+describe('createVertexProvider endpoint configuration', () => {
+  it('passes apiEndpoint to VertexAI when set and omits it when absent', () => {
+    const withEndpointConfig = {
+      ...singleRegionConfig,
+      apiEndpoint: 'aiplatform.eu.rep.googleapis.com',
+    };
+
+    createVertexProvider(withEndpointConfig);
+    createVertexProvider(singleRegionConfig);
+
+    const [[withEndpointCall], [withoutEndpointCall]] = mockVertexAI.mock.calls;
+    expect({
+      withEndpoint: withEndpointCall,
+      withoutEndpoint: withoutEndpointCall,
+      hasEndpointOverrideWhenAbsent: Boolean(withoutEndpointCall?.apiEndpoint),
+    }).toEqual({
+      withEndpoint: {
+        project: 'test-project',
+        location: 'europe-west4',
+        apiEndpoint: 'aiplatform.eu.rep.googleapis.com',
+        googleAuthOptions: undefined,
+      },
+      withoutEndpoint: {
+        project: 'test-project',
+        location: 'europe-west4',
+        googleAuthOptions: undefined,
+      },
+      hasEndpointOverrideWhenAbsent: false,
+    });
+  });
+
+  it('routes an EU multi-region config end to end without rewriting location or logging apiEndpoint', async () => {
+    const loggedEntries: {category: string; message: string; meta?: Record<string, unknown>}[] = [];
+    setLogger({
+      debug: () => undefined,
+      info: (category: string, message: string, meta?: Record<string, unknown>) =>
+        void loggedEntries.push({category, message, meta}),
+      warn: () => undefined,
+      error: () => undefined,
+    });
+    mockGenerateContentStream.mockResolvedValue({
+      stream: (async function* () {
+        yield {candidates: [{content: {parts: [{text: 'resident reply'}]}, finishReason: 'STOP'}]};
+      })(),
+    });
+    const euMultiRegionConfig = {
+      ...singleRegionConfig,
+      location: 'eu',
+      apiEndpoint: 'aiplatform.eu.rep.googleapis.com',
+    };
+
+    const provider = createVertexProvider(euMultiRegionConfig);
+    const chunks = await collectChunks(provider.sendMessage(userMessage('resident prompt')));
+
+    const [[sdkInit]] = mockVertexAI.mock.calls;
+    expect({
+      sdkInit,
+      chunks,
+      loggedEntries,
+    }).toEqual({
+      sdkInit: {
+        project: 'test-project',
+        location: 'eu',
+        apiEndpoint: 'aiplatform.eu.rep.googleapis.com',
+        googleAuthOptions: undefined,
+      },
+      chunks: [
+        {type: 'text', text: 'resident reply'},
+        {type: 'stop', stopReason: 'end_turn', usage: undefined},
+      ],
+      loggedEntries: [
+        {
+          category: 'vertex',
+          message: 'sending message',
+          meta: {modelId: 'gemini-2.5-flash', messageCount: 1, hasTools: false},
+        },
+      ],
+    });
+  });
+});
