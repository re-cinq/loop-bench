+      {
+        name: 'search',
+        description: 'searches items',
+        inputSchema: {type: 'object', properties: {query: {type: 'string'}}, required: ['query']},
+      },
+      async input => {
+        receivedInputs.push(input);
+        return 'done';
+      }
+    );
+
+    await registry.execute('search', {query: 'books', unlistedExtra: 42});
+
+    expect(receivedInputs).toEqual([{query: 'books', unlistedExtra: 42}]);
+  });
+
+  it('validates a function-valued definition against the schema current at that call and compiles a static schema once', async () => {
+    const registry = new ToolRegistry();
+    let staticSchemaReads = 0;
+    registry.register(
+      {
+        name: 'cached_static',
+        description: 'static schema tool',
+        inputSchema: {
+          get type() {
+            staticSchemaReads++;
+            return 'object';
+          },
+          properties: {id: {type: 'string'}},
+          required: ['id'],
+        },
+      },
+      async () => 'ok'
+    );
+    const readsAfterRegister = staticSchemaReads;
+    for (let i = 0; i < 10; i++) {
+      await registry.execute('cached_static', {id: 'abc'});
+    }
+    const extraStaticReads = staticSchemaReads - readsAfterRegister;
+
+    let requiredProp = 'firstKey';
+    registry.register(
+      () => ({
+        name: 'switching_tool',
+        description: 'dynamic schema tool',
+        inputSchema: {
+          type: 'object',
+          properties: {[requiredProp]: {type: 'string'}},
+          required: [requiredProp],
+        },
+      }),
+      async () => 'dynamic-ok'
+    );
+    const firstCall = await registry.execute('switching_tool', {firstKey: 'present'});
+    requiredProp = 'secondKey';
+    const secondCall = await registry.execute('switching_tool', {firstKey: 'present'});
+
+    expect({
+      extraStaticReads,
+      firstResult: firstCall.result,
+      secondResult: secondCall.result,
+    }).toEqual({
+      extraStaticReads: 0,
+      firstResult: 'dynamic-ok',
+      secondResult: "input: missing required property 'secondKey'",
+    });
+  });
+
+  it('still throws Unknown tool: <name> for an unregistered name', async () => {
+    const registry = new ToolRegistry();
+    await expect(registry.execute('missing_tool', {})).rejects.toThrow('Unknown tool: missing_tool');
+  });
+
+  it('returns a rejection ToolResponse naming the missing required property without invoking the executor', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(
+      {
+        name: 'weather',
+        description: 'gets weather',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async () => {
+        calls++;
+        return 'sunny';
+      }
+    );
+
+    const response = await registry.execute('weather', {});
+
+    expect({calls, result: response.result}).toEqual({
+      calls: 0,
+      result: expect.stringMatching(/location.*required|required.*location/i),
+    });
+  });
+
+  it('rejects wrong-typed input naming the field path, constraint, and expected type without logging or returning the offending value', async () => {
+    const logged: string[] = [];
+    setLogger({
+      debug: (_category, _message, fields) => logged.push(JSON.stringify(fields)),
+      info: (_category, _message, fields) => logged.push(JSON.stringify(fields)),
+      warn: (_category, _message, fields) => logged.push(JSON.stringify(fields)),
+      error: (_category, _message, fields) => logged.push(JSON.stringify(fields)),
+    });
+
+    try {
+      const registry = new ToolRegistry();
+      registry.register(
+        {
+          name: 'lookup',
+          description: 'looks up a record',
+          inputSchema: {type: 'object', properties: {count: {type: 'number'}}, required: ['count']},
+        },
+        async () => 'ok'
+      );
+
+      const response = await registry.execute('lookup', {count: 'TOP_SECRET_12345'});
+      const logOutput = logged.join('\n');
+
+      expect({
+        result: response.result,
+        logOutput,
+        leakedInResult: response.result.includes('TOP_SECRET_12345'),
+        leakedInLogs: logOutput.includes('TOP_SECRET_12345'),
+      }).toEqual({
+        result: 'input.count: expected type number',
+        logOutput: expect.stringContaining('input.count: expected type number'),
+        leakedInResult: false,
+        leakedInLogs: false,
+      });
+    } finally {
+      setLogger(undefined);
+    }
+  });
+});
