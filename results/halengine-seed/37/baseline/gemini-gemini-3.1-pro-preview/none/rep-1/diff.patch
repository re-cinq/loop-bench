+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+
+describe('Tool Input Validation', () => {
+  it('validates input against inputSchema, returns ToolResponse on failure, and does not invoke executor', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(
+      {
+        name: 'location_tool',
+        description: 'gets location',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async () => {
+        calls++;
+        return 'success';
+      }
+    );
+
+    const response = await registry.execute('location_tool', {});
+    expect({calls, result: response.result}).toEqual({
+      calls: 0,
+      result: expect.stringMatching(/location/),
+    });
+  });
+
+  it('passes valid input with an unlisted extra property through to the executor unchanged exactly once', async () => {
+    const registry = new ToolRegistry();
+    let executorInput: unknown = null;
+    let calls = 0;
+    registry.register(
+      {
+        name: 'echo_tool',
+        description: 'echos',
+        inputSchema: {type: 'object', properties: {text: {type: 'string'}}, required: ['text']},
+      },
+      async input => {
+        executorInput = input;
+        calls++;
+        return 'success';
+      }
+    );
+
+    await registry.execute('echo_tool', {text: 'hello', extra: 'unlisted'});
+    expect({calls, executorInput}).toEqual({
+      calls: 1,
+      executorInput: {text: 'hello', extra: 'unlisted'},
+    });
+  });
+
+  it('rejects a wrong-typed field with a message naming the field path and expected type, without offending value', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'type_tool',
+        description: 'types',
+        inputSchema: {type: 'object', properties: {count: {type: 'string'}}, required: ['count']},
+      },
+      async () => 'success'
+    );
+
