+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('chatOrchestrator validation loop', () => {
+  it('drives a stub provider through a rejected tool call followed by a corrected retry, and processMessage resolves with rejection visible', async () => {
+    let callCount = 0;
+    let textSeenByProviderOnRoundTwo: string | undefined;
+
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        callCount++;
+        if (callCount === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'call_1', name: 'location_tool', input: {wrongField: 123}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        textSeenByProviderOnRoundTwo = firstToolResultText(params);
+        yield {type: 'text', text: 'got it'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'location_tool',
+        description: 'gets location',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async () => 'success'
+    );
+
+    const orchestrator = createChatOrchestrator(
+      provider,
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      registry
+    );
+
+    const response = await orchestrator.processMessage(createSession('hello'));
+    expect({
+      response,
+      callCount,
+      textSeenByProviderOnRoundTwo,
+    }).toEqual({
+      response: expect.any(String),
+      callCount: 2,
+      textSeenByProviderOnRoundTwo: expect.stringMatching(/location/),
+    });
+  });
+});
+
+function firstToolResultText(params: SendMessageParams): string | undefined {
+  const {messages} = params;
+  const lastMessage = messages[messages.length - 1];
+  if (!lastMessage || typeof lastMessage.content === 'string') return undefined;
+  const [firstBlock] = lastMessage.content;
+  if (!firstBlock || firstBlock.type !== 'tool_result') return undefined;
+  return firstBlock.content;
+}
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+}
