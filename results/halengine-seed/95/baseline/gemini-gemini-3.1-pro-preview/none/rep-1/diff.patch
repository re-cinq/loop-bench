@@ -0,0 +1,114 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+interface RejectionOutcome {
+  didThrow: boolean;
+  caughtRejection: unknown;
+  callCount: number;
+  isError: boolean;
+  message: string | undefined;
+  hasStack: boolean;
+  cause: unknown;
+}
+
+describe('ChatOrchestrator onError', () => {
+  it('calls onError once with an Error whose cause is a thrown string, and rejects to the caller unchanged', async () => {
+    const outcome = await runRejectingTurn('string rejection');
+
+    expect(outcome).toEqual({
+      didThrow: true,
+      caughtRejection: 'string rejection',
+      callCount: 1,
+      isError: true,
+      message: 'string rejection',
+      hasStack: true,
+      cause: 'string rejection',
+    });
+  });
+
+  it('calls onError once with an Error whose cause is a thrown plain object, and rejects to the caller unchanged', async () => {
+    const customPayload = {custom: 'error shape'};
+    const outcome = await runRejectingTurn(customPayload);
+
+    expect(outcome).toEqual({
+      didThrow: true,
+      caughtRejection: customPayload,
+      callCount: 1,
+      isError: true,
+      message: '[object Object]',
+      hasStack: true,
+      cause: customPayload,
+    });
+  });
+
+  it('calls onError once with an Error whose cause is thrown undefined, and rejects to the caller unchanged', async () => {
+    const outcome = await runRejectingTurn(undefined);
+
+    expect(outcome).toEqual({
+      didThrow: true,
+      caughtRejection: undefined,
+      callCount: 1,
+      isError: true,
+      message: 'undefined',
+      hasStack: true,
+      cause: undefined,
+    });
+  });
+});
+
+async function runRejectingTurn(reason: unknown): Promise<RejectionOutcome> {
+  let capturedError: Error | undefined;
+  let callCount = 0;
+  const hooks = {
+    onError: async (_session: ChatSession, error: Error) => {
+      capturedError = error;
+      callCount++;
+    },
+  };
+  const orchestrator = createChatOrchestrator(createRejectingProvider(reason), promptBuilder, undefined, {hooks});
+
+  let caughtRejection: unknown;
+  let didThrow = false;
+  try {
+    await orchestrator.processMessage(createSession('hello'));
+  } catch (error) {
+    caughtRejection = error;
+    didThrow = true;
+  }
+
+  return {
+    didThrow,
+    caughtRejection,
+    callCount,
+    isError: capturedError instanceof Error,
+    message: capturedError?.message,
+    hasStack: typeof capturedError?.stack === 'string',
+    cause: capturedError?.cause,
+  };
+}
+
+function createRejectingProvider(reason: unknown): AIProvider {
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield* [] as MessageChunk[];
+      throw reason;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
