+import { initTRPC, TRPCError } from '@trpc/server';
+import { createTRPCClient } from '../../createTRPCClient';
+import { TRPCClientError } from '../../TRPCClientError';
+import { localLink } from '../localLink';
+
+test('localLink runs query and mutation procedures in the same process', async () => {
+  const t = initTRPC.create();
+  let mutationCalls = 0;
+
+  const router = t.router({
+    greeting: t.procedure.query(() => {
+      return 'hello world';
+    }),
+    increment: t.procedure.mutation(() => {
+      mutationCalls++;
+      return mutationCalls;
+    }),
+  });
+
+  const client = createTRPCClient<typeof router>({
+    links: [localLink({ router })],
+  });
+
+  expect(await client.greeting.query()).toBe('hello world');
+  expect(await client.increment.mutate()).toBe(1);
+  expect(await client.increment.mutate()).toBe(2);
+});
+
+test('localLink supports createContext and propagates errors as TRPCClientError', async () => {
+  const t = initTRPC.context<{ user: string | null }>().create();
+
+  const router = t.router({
+    whoami: t.procedure.query(({ ctx }) => {
+      if (!ctx.user) {
+        throw new TRPCError({
+          code: 'UNAUTHORIZED',
+          message: 'Not authenticated',
+        });
+      }
+      return `hello ${ctx.user}`;
+    }),
+  });
+
+  let currentUser: string | null = 'alice';
+  const client = createTRPCClient<typeof router>({
+    links: [
+      localLink({
+        router,
+        createContext: async () => ({ user: currentUser }),
+      }),
+    ],
+  });
+
+  expect(await client.whoami.query()).toBe('hello alice');
+
+  currentUser = null;
+  await expect(client.whoami.query()).rejects.toThrow(TRPCClientError);
+  await expect(client.whoami.query()).rejects.toMatchObject({
+    message: 'Not authenticated',
+  });
+});
+
+test('localLink runs subscription procedures in the same process and cleans up on unsubscribe', async () => {
+  const t = initTRPC.create();
+  let unsubscribed = false;
+
+  const router = t.router({
+    onMessage: t.procedure.subscription(async function* (opts) {
+      opts.signal?.addEventListener('abort', () => {
+        unsubscribed = true;
+      });
+      yield 'msg: first';
+      yield 'msg: second';
+      await new Promise((resolve) => setTimeout(resolve, 10000000)); // hang forever
+    }),
+  });
+
+  const client = createTRPCClient<typeof router>({
+    links: [localLink({ router })],
+  });
+
+  const received: string[] = [];
+  const sub = client.onMessage.subscribe(undefined, {
+    onData(data) {
+      received.push(data);
+    },
+  });
+
+  await new Promise((resolve) => setTimeout(resolve, 50));
+  expect(received).toEqual(['msg: first', 'msg: second']);
+
+  sub.unsubscribe();
+  await new Promise((resolve) => setTimeout(resolve, 10));
+  expect(unsubscribed).toBe(true);
+});
diff --git a/packages/client/src/links/localLink.ts b/packages/client/src/links/localLink.ts
new file mode 100644
index 0000000000..cc63ab35d6
--- /dev/null
+++ b/packages/client/src/links/localLink.ts
@@ -0,0 +1,150 @@
+import {
+  isObservable,
+  observable,
+  observableToAsyncIterable,
+} from '@trpc/server/observable';
+import type {
+  AnyRouter,
+  CreateContextCallback,
+  inferRouterContext,
+} from '@trpc/server/unstable-core-do-not-import';
+import {
+  callProcedure as callTRPCProcedure,
+  getTRPCErrorFromUnknown,
+  isAsyncIterable,
+  isTrackedEnvelope,
+  type ErrorHandlerOptions,
+} from '@trpc/server/unstable-core-do-not-import';
+import { TRPCClientError } from '../TRPCClientError';
+import { getTransformer } from '../unstable-internals';
+import type { TransformerOptions } from '../unstable-internals';
+import type { TRPCLink } from './types';
+
+export type LocalLinkOptions<TRouter extends AnyRouter> = {
+  router: TRouter;
+} & CreateContextCallback<
+  inferRouterContext<TRouter>,
+  () => Promise<inferRouterContext<TRouter>> | inferRouterContext<TRouter>
+> &
+  TransformerOptions<TRouter['_def']['_config']['$types']> & {
+    onError?: (opts: ErrorHandlerOptions<inferRouterContext<TRouter>>) => void;
+  };
+
+export function localLink<TRouter extends AnyRouter>(
+  opts: LocalLinkOptions<TRouter>,
+): TRPCLink<TRouter> {
+  const { router } = opts;
+  const transformer = getTransformer(opts.transformer as any);
+
+  return () => {
+    return ({ op }) => {
+      return observable((observer) => {
+        const { type, path } = op;
+        const input = transformer.input.serialize(op.input);
+
+        let isDone = false;
+        const ac = new AbortController();
+        const signal = ac.signal;
+
+        if (op.signal) {
+          op.signal.addEventListener('abort', () => {
+            ac.abort();
+          });
+        }
+
+        let ctx: inferRouterContext<TRouter> | undefined = undefined;
+
+        void Promise.resolve().then(async () => {
+          try {
+            ctx = await opts.createContext?.();
+            const result = await callTRPCProcedure({
+              router,
+              path,
+              getRawInput: async () => input,
+              ctx,
+              type,
+              signal,
+            });
+
+            if (isDone) return;
+
+            if (type === 'subscription') {
+              const isIterableResult =
+                isAsyncIterable(result) || isObservable(result);
+              if (!isIterableResult) {
+                throw new Error(
+                  `Subscription ${path} did not return an observable or a AsyncGenerator`,
+                );
+              }
+
+              observer.next({
+                result: {
+                  type: 'started',
+                },
+              } as any);
+
+              const iterable = isObservable(result)
+                ? observableToAsyncIterable(result, signal)
+                : result;
+
+              for await (const chunk of iterable as any) {
+                if (isDone) break;
+
+                let resultData: any = {
+                  type: 'data',
+                  data: transformer.output.deserialize(chunk),
+                };
+
+                if (isTrackedEnvelope(chunk)) {
+                  const [id, data] = chunk;
+                  resultData = {
+                    id,
+                    data: {
+                      id,
+                      data: transformer.output.deserialize(data),
+                    },
+                  };
+                }
+
+                observer.next({
+                  result: resultData,
+                } as any);
+              }
+
+              if (isDone) return;
+
+              observer.next({
+                result: {
+                  type: 'stopped',
+                },
+              } as any);
+              observer.complete();
+            } else {
+              observer.next({
+                result: {
+                  data: transformer.output.deserialize(result),
+                },
+              } as any);
+              observer.complete();
+            }
+          } catch (cause: any) {
+            if (isDone) return;
+            opts.onError?.({
+              error: getTRPCErrorFromUnknown(cause),
+              path,
+              type,
+              ctx,
+              input: op.input,
+            });
+            observer.error(TRPCClientError.from(cause, { meta: cause.meta }));
+          }
+        });
+
+        return () => {
+          isDone = true;
+          ac.abort();
+        };
+      });
+    };
+  };
+}
diff --git a/packages/tests/server/localLink.acceptance.test.ts b/packages/tests/server/localLink.acceptance.test.ts
