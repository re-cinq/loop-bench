diff --git a/packages/client/src/links/localLink.test.ts b/packages/client/src/links/localLink.test.ts
new file mode 100644
index 0000000000..620bfb028a
--- /dev/null
+++ b/packages/client/src/links/localLink.test.ts
@@ -0,0 +1,152 @@
+import { initTRPC } from '@trpc/server';
+import superjson from 'superjson';
+import { z } from 'zod';
+import { createTRPCClient } from '../createTRPCClient';
+import { TRPCClientError } from '../TRPCClientError';
+import { localLink } from './localLink';
+
+test('localLink runs query and mutation procedures in the same process as the client', async () => {
+  const createRouter = (opts: { database: string[] }) => {
+    const t = initTRPC.create();
+    return t.router({
+      list: t.procedure.query(() => {
+        return [...opts.database];
+      }),
+      add: t.procedure
+        .input(z.object({ item: z.string() }))
+        .mutation(({ input }) => {
+          opts.database.push(input.item);
+          return opts.database.length;
+        }),
+    });
+  };
+
+  const database: string[] = ['initial'];
+  const router = createRouter({ database });
+
+  const client = createTRPCClient<typeof router>({
+    links: [localLink({ router })],
+  });
+
+  expect(await client.list.query()).toEqual(['initial']);
+  expect(await client.add.mutate({ item: 'second' })).toBe(2);
+  expect(await client.list.query()).toEqual(['initial', 'second']);
+  expect(database).toEqual(['initial', 'second']);
+});
+
+test('localLink with transformer', async () => {
+  const t = initTRPC.create({ transformer: superjson });
+  const router = t.router({
+    date: t.procedure.input(z.date()).query(({ input }) => {
+      return new Date(input.getTime() + 1000);
+    }),
+  });
+
+  const client = createTRPCClient<typeof router>({
+    links: [localLink({ router, transformer: superjson })],
+  });
+
+  const d = new Date('2022-01-01T00:00:00.000Z');
+  const res = await client.date.query(d);
+  expect(res).toEqual(new Date('2022-01-01T00:00:01.000Z'));
+});
+
+test('localLink supports createContext and propagates errors as TRPCClientError', async () => {
+  const t = initTRPC.context<{ user: string | null }>().create();
+  const router = t.router({
+    whoami: t.procedure.query(({ ctx }) => {
+      if (!ctx.user) {
+        throw new Error('Not authenticated');
+      }
+      return `hello ${ctx.user}`;
+    }),
+  });
+
+  let currentUser: string | null = 'alice';
+  const client = createTRPCClient<typeof router>({
+    links: [
+      localLink({
+        router,
+        createContext: async () => ({ user: currentUser }),
+      }),
+    ],
+  });
+
+  expect(await client.whoami.query()).toBe('hello alice');
+
+  currentUser = null;
+  await expect(client.whoami.query()).rejects.toThrow(TRPCClientError);
+  await expect(client.whoami.query()).rejects.toMatchObject({
+    message: 'Not authenticated',
+  });
+});
+
+test('localLink invokes onError', async () => {
+  const t = initTRPC.create();
+  const router = t.router({
+    err: t.procedure.query(() => {
+      throw new Error('Some error');
+    }),
+  });
+
+  const onError = vi.fn();
+  const client = createTRPCClient<typeof router>({
+    links: [localLink({ router, onError })],
+  });
+
+  await expect(client.err.query()).rejects.toThrow();
+  expect(onError).toHaveBeenCalledTimes(1);
+  const errOpts = onError.mock.calls[0][0];
+  expect(errOpts.error.message).toBe('Some error');
+  expect(errOpts.path).toBe('err');
+  expect(errOpts.type).toBe('query');
+});
+
+test('localLink supports subscriptions', async () => {
+  const { EventEmitter, on } = await import('node:events');
+  const ee = new EventEmitter();
+  const t = initTRPC.create();
+
+  const router = t.router({
+    onMessage: t.procedure
+      .input(z.object({ prefix: z.string() }))
+      .subscription(async function* (opts) {
+        for await (const [msg] of on(ee, 'message', {
+          signal: opts.signal,
+        })) {
+          yield `${opts.input.prefix}: ${String(msg)}`;
+        }
+      }),
+  });
+
+  const client = createTRPCClient<typeof router>({
+    links: [localLink({ router })],
+  });
+
+  const received: string[] = [];
+  const sub = client.onMessage.subscribe(
+    { prefix: 'msg' },
+    {
+      onData(data) {
+        received.push(data);
+      },
+    },
+  );
+
+  await vi.waitFor(() => {
+    expect(ee.listenerCount('message')).toBe(1);
+  });
+
+  ee.emit('message', 'first');
+  ee.emit('message', 'second');
+
+  await vi.waitFor(() => {
+    expect(received).toEqual(['msg: first', 'msg: second']);
+  });
+
+  sub.unsubscribe();
+
+  await vi.waitFor(() => {
+    expect(ee.listenerCount('message')).toBe(0);
+  });
+});
diff --git a/packages/client/src/links/localLink.ts b/packages/client/src/links/localLink.ts
new file mode 100644
index 0000000000..2951e2516b
--- /dev/null
+++ b/packages/client/src/links/localLink.ts
@@ -0,0 +1,179 @@
+import { isObservable, observable } from '@trpc/server/observable';
+import {
+  callProcedure,
+  getTRPCErrorFromUnknown,
+  isAsyncIterable,
+  isTrackedEnvelope,
+} from '@trpc/server/unstable-core-do-not-import';
+import type {
+  AnyRouter,
+  CreateContextCallback,
+  ErrorHandlerOptions,
+  inferClientTypes,
+  inferRouterContext,
+} from '@trpc/server/unstable-core-do-not-import';
+import { TRPCClientError } from '../TRPCClientError';
+import { getTransformer, type TransformerOptions } from '../unstable-internals';
+import type { TRPCLink } from './types';
+
+export type LocalLinkOptions<TRouter extends AnyRouter> = {
+  router: TRouter;
+  onError?: (opts: ErrorHandlerOptions<inferRouterContext<TRouter>>) => void;
+} & CreateContextCallback<
+  inferRouterContext<TRouter>,
+  () => inferRouterContext<TRouter> | Promise<inferRouterContext<TRouter>>
+> &
+  TransformerOptions<inferClientTypes<TRouter>>;
+
+export function localLink<TRouter extends AnyRouter>(
+  opts: LocalLinkOptions<TRouter>,
+): TRPCLink<TRouter> {
+  const transformer = getTransformer(opts.transformer);
+  return () =>
+    ({ op }) =>
+      observable((observer) => {
+        let isDone = false;
+        const ac = new AbortController();
+        if (op.signal?.aborted) {
+          ac.abort();
+        } else {
+          op.signal?.addEventListener('abort', () => ac.abort(), {
+            once: true,
+          });
+        }
+
+        async function execute() {
+          let ctx: inferRouterContext<TRouter> | undefined = undefined;
+          try {
+            ctx = await opts.createContext?.();
+            const input = transformer.input.deserialize(
+              transformer.input.serialize(op.input),
+            );
+            const result = await callProcedure({
+              router: opts.router,
+              path: op.path,
+              getRawInput: async () => input,
+              type: op.type,
+              ctx,
+              signal: ac.signal,
+            });
+
+            if (isDone) {
+              return;
+            }
+
+            if (op.type === 'subscription') {
+              if (isObservable(result)) {
+                const sub = result.subscribe({
+                  next(data) {
+                    if (!isDone) {
+                      observer.next({
+                        result: {
+                          type: 'data',
+                          data: transformer.output.deserialize(
+                            transformer.output.serialize(data),
+                          ),
+                        },
+                      });
+                    }
+                  },
+                  error(err) {
+                    if (!isDone) {
+                      const error = getTRPCErrorFromUnknown(err);
+                      opts.onError?.({
+                        error,
+                        type: op.type,
+                        path: op.path,
+                        input: op.input,
+                        ctx,
+                      });
+                      observer.error(TRPCClientError.from(error));
+                    }
+                  },
+                  complete() {
+                    if (!isDone) {
+                      observer.complete();
+                    }
+                  },
+                });
+
+                if (ac.signal.aborted) {
+                  sub.unsubscribe();
+                } else {
+                  ac.signal.addEventListener('abort', () => sub.unsubscribe(), {
+                    once: true,
+                  });
+                }
+              } else if (isAsyncIterable(result)) {
+                // AsyncIterable
+                void (async () => {
+                  try {
+                    for await (const chunk of result) {
+                      if (isDone) break;
+                      let data = chunk;
+                      let id: string | undefined = undefined;
+
+                      if (isTrackedEnvelope(data)) {
+                        id = data[0];
+                        data = data[1];
+                      }
+
+                      observer.next({
+                        result: {
+                          type: 'data',
+                          id,
+                          data: transformer.output.deserialize(
+                            transformer.output.serialize(data),
+                          ),
+                        },
+                      });
+                    }
+                    if (!isDone) observer.complete();
+                  } catch (err) {
+                    if (!isDone) {
+                      const error = getTRPCErrorFromUnknown(err);
+                      opts.onError?.({
+                        error,
+                        type: op.type,
+                        path: op.path,
+                        input: op.input,
+                        ctx,
+                      });
+                      observer.error(TRPCClientError.from(error));
+                    }
+                  }
+                })();
+              } else {
+                throw new Error(
+                  'Subscription procedure did not return an observable or async iterable',
+                );
+              }
+            } else {
+              const data = transformer.output.deserialize(
+                transformer.output.serialize(result),
+              );
+              observer.next({ result: { type: 'data', data } });
+              observer.complete();
+            }
+          } catch (cause) {
+            if (!isDone) {
+              const error = getTRPCErrorFromUnknown(cause);
+              opts.onError?.({
+                error,
+                type: op.type,
+                path: op.path,
+                input: op.input,
+                ctx,
+              });
+              observer.error(TRPCClientError.from(error));
+            }
+          }
+        }
+        void execute();
+
+        return () => {
+          isDone = true;
+          ac.abort();
+        };
+      });
+}
