diff --git a/packages/client/src/links/localLink.test.ts b/packages/client/src/links/localLink.test.ts
new file mode 100644
index 0000000000..2596b0f8b8
--- /dev/null
+++ b/packages/client/src/links/localLink.test.ts
@@ -0,0 +1,261 @@
+import { EventEmitter, on } from 'node:events';
+import { initTRPC, tracked, TRPCError } from '@trpc/server';
+import { observable } from '@trpc/server/observable';
+import type { DataTransformer } from '@trpc/server/unstable-core-do-not-import';
+import { createTRPCClient } from '../createTRPCClient';
+import { TRPCClientError } from '../TRPCClientError';
+import { localLink, type LocalLinkOptions } from './localLink';
+
+describe('localLink options and link creation', () => {
+  test('creates a TRPCLink with router and optional createContext, onError, and transformer options', () => {
+    const t = initTRPC.create();
+    const router = t.router({
+      hello: t.procedure.query(() => 'world'),
+    });
+
+    const onError = vi.fn();
+    const link = localLink({
+      router,
+      onError,
+    });
+
+    expect(typeof link).toBe('function');
+    const opLink = link({});
+    expect(typeof opLink).toBe('function');
+
+    const tWithCtx = initTRPC.context<{ userId: string }>().create();
+    const routerWithCtx = tWithCtx.router({
+      whoami: tWithCtx.procedure.query(({ ctx }) => ctx.userId),
+    });
+
+    expectTypeOf<LocalLinkOptions<typeof router>>().toExtend<{
+      router: typeof router;
+      createContext?: () => unknown;
+    }>();
+
+    expectTypeOf<{
+      router: typeof routerWithCtx;
+      createContext: () => { userId: string };
+    }>().toExtend<LocalLinkOptions<typeof routerWithCtx>>();
+
+    // @ts-expect-error createContext is required when context is defined
+    localLink({ router: routerWithCtx });
+
+    const dummyTransformer: DataTransformer = {
+      serialize: (v) => v,
+      deserialize: (v) => v,
+    };
+    const tWithTransformer = initTRPC.create({
+      transformer: dummyTransformer,
+    });
+    const routerWithTransformer = tWithTransformer.router({
+      ping: tWithTransformer.procedure.query(() => 'pong'),
+    });
+
+    // @ts-expect-error transformer is required when configured on router
+    localLink({ router: routerWithTransformer });
+
+    const linkWithTransformer = localLink({
+      router: routerWithTransformer,
+      transformer: dummyTransformer,
+    });
+    expect(typeof linkWithTransformer).toBe('function');
+  });
+
+  test('executes query and mutation procedures with context, transformer, and error propagation', async () => {
+    const transformer: DataTransformer = {
+      serialize: (v) => JSON.parse(JSON.stringify({ wrapped: v })),
+      deserialize: (v) => (v as { wrapped: unknown }).wrapped,
+    };
+
+    const t = initTRPC.context<{ user: string | null }>().create({
+      transformer,
+    });
+
+    const items: string[] = [];
+    const router = t.router({
+      greet: t.procedure
+        .input((v: unknown) => String(v))
+        .query(({ ctx, input }) => {
+          if (!ctx.user) {
+            throw new TRPCError({
+              code: 'UNAUTHORIZED',
+              message: 'No user in context',
+            });
+          }
+          return `Hello ${input} from ${ctx.user}`;
+        }),
+      addItem: t.procedure
+        .input((v: unknown) => String(v))
+        .mutation(({ input }) => {
+          items.push(input);
+          return [...items];
+        }),
+    });
+
+    let currentUser: string | null = 'bob';
+    const onError = vi.fn();
+
+    const client = createTRPCClient<typeof router>({
+      links: [
+        localLink({
+          router,
+          createContext: async () => ({ user: currentUser }),
+          transformer,
+          onError,
+        }),
+      ],
+    });
+
+    const greeting = await client.greet.query('world');
+    expect(greeting).toBe('Hello world from bob');
+
+    const updatedItems = await client.addItem.mutate('apple');
+    expect(updatedItems).toEqual(['apple']);
+
+    currentUser = null;
+    await expect(client.greet.query('world')).rejects.toThrow(TRPCClientError);
+    await expect(client.greet.query('world')).rejects.toMatchObject({
+      message: 'No user in context',
+      data: {
+        code: 'UNAUTHORIZED',
+        path: 'greet',
+      },
+    });
+    expect(onError).toHaveBeenCalledWith(
+      expect.objectContaining({
+        path: 'greet',
+        type: 'query',
+        input: 'world',
+        ctx: { user: null },
+      }),
+    );
+  });
+
+  test('executes subscription procedures (async iterables, observables, tracked envelopes) and aborts on unsubscribe', async () => {
+    const ee = new EventEmitter();
+    const t = initTRPC.create();
+
+    let obsTeardownCalled = false;
+    const router = t.router({
+      onIter: t.procedure
+        .input((v: unknown) => String(v))
+        .subscription(async function* (opts) {
+          for await (const [msg] of on(ee, 'iter', {
+            signal: opts.signal,
+          })) {
+            yield `${opts.input}:${String(msg)}`;
+          }
+        }),
+      onTracked: t.procedure.subscription(async function* (opts) {
+        for await (const [id, msg] of on(ee, 'tracked', {
+          signal: opts.signal,
+        })) {
+          yield tracked(String(id), String(msg));
+        }
+      }),
+      onObs: t.procedure.subscription(() => {
+        return observable<string>((emit) => {
+          const handler = (msg: string) => emit.next(msg);
+          ee.on('obs', handler);
+          return () => {
+            obsTeardownCalled = true;
+            ee.off('obs', handler);
+          };
+        });
+      }),
+    });
+
+    const client = createTRPCClient<typeof router>({
+      links: [localLink({ router })],
+    });
+
+    // 1. Async iterable subscription
+    const iterReceived: string[] = [];
+    const onStarted = vi.fn();
+    const iterSub = client.onIter.subscribe('prefix', {
+      onStarted,
+      onData(data) {
+        iterReceived.push(data);
+      },
+    });
+
+    await vi.waitFor(() => {
+      expect(ee.listenerCount('iter')).toBe(1);
+    });
+    expect(onStarted).toHaveBeenCalledTimes(1);
+
+    ee.emit('iter', 'one');
+    ee.emit('iter', 'two');
+
+    await vi.waitFor(() => {
+      expect(iterReceived).toEqual(['prefix:one', 'prefix:two']);
+    });
+
+    iterSub.unsubscribe();
+
+    await vi.waitFor(() => {
+      expect(ee.listenerCount('iter')).toBe(0);
+    });
+
+    // 2. Tracked envelope subscription
+    const trackedReceived: Array<{ id: string; data: string }> = [];
+    const trackedSub = client.onTracked.subscribe(undefined, {
+      onData(data) {
+        trackedReceived.push(data);
+      },
+    });
+
+    await vi.waitFor(() => {
+      expect(ee.listenerCount('tracked')).toBe(1);
+    });
+
+    ee.emit('tracked', '1', 'alpha');
+    ee.emit('tracked', '2', 'beta');
+
+    await vi.waitFor(() => {
+      expect(trackedReceived).toEqual([
+        { id: '1', data: 'alpha' },
+        { id: '2', data: 'beta' },
+      ]);
+    });
+
+    trackedSub.unsubscribe();
+
+    await vi.waitFor(() => {
+      expect(ee.listenerCount('tracked')).toBe(0);
+    });
+
+    // 3. Observable subscription
+    const obsReceived: string[] = [];
+    const obsSub = client.onObs.subscribe(undefined, {
+      onData(data) {
+        obsReceived.push(data);
+      },
+    });
+
+    await vi.waitFor(() => {
+      expect(ee.listenerCount('obs')).toBe(1);
+    });
+
+    ee.emit('obs', 'first');
+    await vi.waitFor(() => {
+      expect(obsReceived).toEqual(['first']);
+    });
+
+    obsSub.unsubscribe();
+
+    await vi.waitFor(() => {
+      expect(obsTeardownCalled).toBe(true);
+      expect(ee.listenerCount('obs')).toBe(0);
+    });
+  });
+
+  test('exports localLink from @trpc/client entrypoints', async () => {
+    const clientIndex = await import('../index');
+    const clientLinks = await import('../links');
+
+    expect(clientIndex.localLink).toBe(localLink);
+    expect(clientLinks.localLink).toBe(localLink);
+  });
+});
diff --git a/packages/client/src/links/localLink.ts b/packages/client/src/links/localLink.ts
