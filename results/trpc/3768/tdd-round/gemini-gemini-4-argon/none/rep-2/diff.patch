index 0000000000..cba4aee2e6
--- /dev/null
+++ b/packages/client/src/links/localLink.ts
@@ -0,0 +1,208 @@
+import {
+  isObservable,
+  observable,
+  observableToAsyncIterable,
+} from '@trpc/server/observable';
+import type {
+  AnyRouter,
+  CreateContextCallback,
+  ErrorHandlerOptions,
+  inferClientTypes,
+  inferRouterContext,
+  MaybePromise,
+  TRPCResultMessage,
+} from '@trpc/server/unstable-core-do-not-import';
+import {
+  callProcedure,
+  getErrorShape,
+  getTRPCErrorFromUnknown,
+  isAbortError,
+  isAsyncIterable,
+  isTrackedEnvelope,
+  iteratorResource,
+  TRPCError,
+  Unpromise,
+} from '@trpc/server/unstable-core-do-not-import';
+import { raceAbortSignals } from '../internals/signals';
+import { TRPCClientError } from '../TRPCClientError';
+import { getTransformer, type TransformerOptions } from '../unstable-internals';
+import type { TRPCLink } from './types';
+
+export type LocalLinkOptions<TRouter extends AnyRouter> = {
+  router: TRouter;
+  onError?: (opts: ErrorHandlerOptions<inferRouterContext<TRouter>>) => void;
+} & CreateContextCallback<
+  inferRouterContext<TRouter>,
+  () => MaybePromise<inferRouterContext<TRouter>>
+> &
+  TransformerOptions<inferClientTypes<TRouter>>;
+
+/**
+ * Create a link that calls the router directly in the same process without network transport.
+ */
+export function localLink<TRouter extends AnyRouter>(
+  opts: LocalLinkOptions<TRouter>,
+): TRPCLink<TRouter> {
+  const transformer = getTransformer(opts.transformer);
+  const { router } = opts;
+  const config = router._def._config;
+
+  return () => {
+    return ({ op }) => {
+      return observable((observer) => {
+        const { type, path, input } = op;
+        const ac = new AbortController();
+        const signal = raceAbortSignals(op.signal, ac.signal);
+
+        let ctx: inferRouterContext<TRouter> | undefined = undefined;
+
+        (async () => {
+          ctx = await opts.createContext?.();
+
+          const rawInput =
+            typeof input === 'undefined'
+              ? undefined
+              : config.transformer.input.deserialize(
+                  transformer.input.serialize(input),
+                );
+
+          const res = await callProcedure({
+            router,
+            path,
+            getRawInput: async () => rawInput,
+            ctx,
+            type,
+            signal,
+          });
+
+          if (type !== 'subscription') {
+            const data = transformer.output.deserialize(
+              config.transformer.output.serialize(res),
+            );
+
+            observer.next({
+              result: {
+                type: 'data',
+                data,
+              },
+            });
+            observer.complete();
+            return;
+          }
+
+          if (!isAsyncIterable(res) && !isObservable(res)) {
+            throw new TRPCError({
+              message: `Subscription ${path} did not return an observable or a AsyncGenerator`,
+              code: 'INTERNAL_SERVER_ERROR',
+            });
+          }
+
+          if (signal.aborted) {
+            return;
+          }
+
+          const iterable = isObservable(res)
+            ? observableToAsyncIterable(res, signal)
+            : res;
+
+          observer.next({
+            result: {
+              type: 'started',
+            },
+          });
+
+          await using iterator = iteratorResource(iterable);
+
+          const abortPromise = new Promise<'abort'>((resolve) => {
+            if (signal.aborted) {
+              resolve('abort');
+            } else {
+              signal.addEventListener('abort', () => resolve('abort'), {
+                once: true,
+              });
+            }
+          });
+
+          while (true) {
+            const next = await Unpromise.race([iterator.next(), abortPromise]);
+
+            if (next === 'abort') {
+              await iterator.return?.();
+              break;
+            }
+            if (next.done) {
+              break;
+            }
+
+            let result: TRPCResultMessage<unknown>['result'];
+            if (isTrackedEnvelope(next.value)) {
+              const [id, rawData] = next.value;
+              const data = transformer.output.deserialize(
+                config.transformer.output.serialize(rawData),
+              );
+              result = {
+                type: 'data',
+                id,
+                data: {
+                  id,
+                  data,
+                },
+              };
+            } else {
+              const data = transformer.output.deserialize(
+                config.transformer.output.serialize(next.value),
+              );
+              result = {
+                type: 'data',
+                data,
+              };
+            }
+
+            observer.next({
+              result,
+            });
+          }
+
+          observer.next({
+            result: {
+              type: 'stopped',
+            },
+          });
+          observer.complete();
+        })().catch((cause) => {
+          if (signal.aborted || isAbortError(cause)) {
+            return;
+          }
+          const error = getTRPCErrorFromUnknown(cause);
+          opts.onError?.({
+            error,
+            path,
+            type,
+            ctx,
+            input,
+          });
+          const errorShape = getErrorShape({
+            config,
+            error,
+            type,
+            path,
+            input,
+            ctx,
+          });
+          const transformedError = transformer.output.deserialize(
+            config.transformer.output.serialize(errorShape),
+          );
+          observer.error(
+            TRPCClientError.from({
+              error: transformedError,
+            }),
+          );
+        });
+
+        return () => {
+          ac.abort();
+        };
+      });
+    };
+  };
+}
diff --git a/packages/tests/server/localLink.acceptance.test.ts b/packages/tests/server/localLink.acceptance.test.ts
