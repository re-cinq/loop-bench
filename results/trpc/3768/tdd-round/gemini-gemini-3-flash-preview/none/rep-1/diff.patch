@@ -0,0 +1,480 @@
+import { initTRPC, tracked, TRPCError } from '@trpc/server';
+import { observable } from '@trpc/server/observable';
+import { describe, expect, it, vi } from 'vitest';
+import { TRPCClientError } from '../TRPCClientError';
+import { createChain } from './internals/createChain';
+import { localLink, ssrLink } from './localLink';
+
+describe('localLink', () => {
+  const t = initTRPC.create();
+  const appRouter = t.router({
+    hello: t.procedure.query(() => 'world'),
+    greet: t.procedure.input(String).mutation(({ input }) => `hello ${input}`),
+    error: t.procedure.query(() => {
+      throw new Error('boom');
+    }),
+  });
+
+  it('runs a query', async () => {
+    const link = localLink({
+      router: appRouter,
+    });
+
+    const chain = createChain({
+      links: [link({} as any)],
+      op: {
+        type: 'query',
+        input: null,
+        path: 'hello',
+        id: 0,
+        context: {},
+        signal: new AbortController().signal,
+      },
+    });
+
+    const result: any = await new Promise((resolve, reject) => {
+      chain.subscribe({
+        next: resolve,
+        error: reject,
+      });
+    });
+
+    expect(result.result.data).toBe('world');
+  });
+
+  it('runs a mutation', async () => {
+    const link = localLink({
+      router: appRouter,
+    });
+
+    const chain = createChain({
+      links: [link({} as any)],
+      op: {
+        type: 'mutation',
+        input: 'tRPC',
+        path: 'greet',
+        id: 0,
+        context: {},
+        signal: new AbortController().signal,
+      },
+    });
+
+    const result: any = await new Promise((resolve, reject) => {
+      chain.subscribe({
+        next: resolve,
+        error: reject,
+      });
+    });
+
+    expect(result.result.data).toBe('hello tRPC');
+  });
+
+  it('supports createContext', async () => {
+    const t = initTRPC.context<{ user: string }>().create();
+    const router = t.router({
+      whoami: t.procedure.query(({ ctx }) => ctx.user),
+    });
+
+    const link = localLink({
+      router,
+      createContext: () => ({ user: 'alex' }),
+    });
+
+    const chain = createChain({
+      links: [link({} as any)],
+      op: {
+        type: 'query',
+        input: null,
+        path: 'whoami',
+        id: 0,
+        context: {},
+        signal: new AbortController().signal,
+      },
+    });
+
+    const result: any = await new Promise((resolve, reject) => {
+      chain.subscribe({
+        next: resolve,
+        error: reject,
+      });
+    });
+
+    expect(result.result.data).toBe('alex');
+  });
+
+  it('supports onError', async () => {
+    const onError = vi.fn();
+    const link = localLink({
+      router: appRouter,
+      onError,
+    });
+
+    const chain = createChain({
+      links: [link({} as any)],
+      op: {
+        type: 'query',
+        input: null,
+        path: 'error',
+        id: 0,
+        context: {},
+        signal: new AbortController().signal,
+      },
+    });
+
+    await expect(
+      new Promise((resolve, reject) => {
+        chain.subscribe({
+          next: resolve,
+          error: reject,
+        });
+      }),
+    ).rejects.toThrow('boom');
+
+    expect(onError).toHaveBeenCalledTimes(1);
+    expect(onError).toHaveBeenCalledWith(
+      expect.objectContaining({
+        path: 'error',
+        type: 'query',
+      }),
+    );
+  });
+
+  it('runs a subscription (observable)', async () => {
+    const onData = vi.fn();
+    const t = initTRPC.create();
+    const router = t.router({
+      onTick: t.procedure.subscription(() => {
+        return observable((observer) => {
+          observer.next(1);
+          observer.next(2);
+          const timer = setTimeout(() => {
+            observer.next(3);
+            observer.complete();
+          }, 10);
+          return () => clearTimeout(timer);
+        });
+      }),
+    });
+
+    const link = localLink({ router });
+
+    const chain = createChain({
+      links: [link({} as any)],
+      op: {
+        type: 'subscription',
+        input: null,
+        path: 'onTick',
+        id: 0,
+        context: {},
+        signal: new AbortController().signal,
+      },
+    });
+
+    await new Promise((resolve, reject) => {
+      chain.subscribe({
+        next: (val: any) => {
+          if (val.result.type === 'data') {
+            onData(val.result.data);
+          }
+        },
+        error: reject,
+        complete: resolve,
+      });
+    });
+
+    expect(onData).toHaveBeenCalledTimes(3);
+    expect(onData).toHaveBeenNthCalledWith(1, 1);
+    expect(onData).toHaveBeenNthCalledWith(2, 2);
+    expect(onData).toHaveBeenNthCalledWith(3, 3);
+  });
+
+  it('runs a subscription (async iterable)', async () => {
+    const onData = vi.fn();
+    const t = initTRPC.create();
+    const router = t.router({
+      onTick: t.procedure.subscription(async function* () {
+        yield 1;
+        yield 2;
+        yield 3;
+      }),
+    });
+
+    const link = localLink({ router });
+
+    const chain = createChain({
+      links: [link({} as any)],
+      op: {
+        type: 'subscription',
+        input: null,
+        path: 'onTick',
+        id: 0,
+        context: {},
+        signal: new AbortController().signal,
+      },
+    });
+
+    await new Promise((resolve, reject) => {
+      chain.subscribe({
+        next: (val: any) => {
+          if (val.result.type === 'data') {
+            onData(val.result.data);
+          }
+        },
+        error: reject,
+        complete: resolve,
+      });
+    });
+
+    expect(onData).toHaveBeenCalledTimes(3);
+    expect(onData).toHaveBeenNthCalledWith(1, 1);
+    expect(onData).toHaveBeenNthCalledWith(2, 2);
+    expect(onData).toHaveBeenNthCalledWith(3, 3);
+  });
+
+  it('supports tracked envelopes', async () => {
+    const onData = vi.fn();
+    const t = initTRPC.create();
+    const router = t.router({
+      onTick: t.procedure.subscription(async function* () {
+        yield tracked('1', 'one');
+      }),
+    });
+
+    const link = localLink({ router });
+
+    const chain = createChain({
+      links: [link({} as any)],
+      op: {
+        type: 'subscription',
+        input: null,
+        path: 'onTick',
+        id: 0,
+        context: {},
+        signal: new AbortController().signal,
+      },
+    });
+
+    await new Promise((resolve, reject) => {
+      chain.subscribe({
+        next: (val: any) => {
+          if (val.result.type === 'data') {
+            onData(val.result);
+          }
+        },
+        error: reject,
+        complete: resolve,
+      });
+    });
+
+    expect(onData).toHaveBeenCalledTimes(1);
+    expect(onData).toHaveBeenCalledWith({
+      type: 'data',
+      data: {
+        id: '1',
+        data: 'one',
+      },
+    });
+  });
+
+  it('works with a custom transformer', async () => {
+    const transformer = {
+      input: {
+        serialize: (data: any) => ({ data, serialized: true }),
+        deserialize: (data: any) => data.data,
+      },
+      output: {
+        serialize: (data: any) => ({ data, serialized: true }),
+        deserialize: (data: any) => data.data,
+      },
+    };
+
+    const t = initTRPC.create({
+      transformer,
+    });
+    const appRouter = t.router({
+      hello: t.procedure.query(() => 'world'),
+    });
+
+    const link = localLink({
+      router: appRouter,
+      transformer,
+    });
+
+    const chain = createChain({
+      links: [link({} as any)],
+      op: {
+        type: 'query',
+        input: null,
+        path: 'hello',
+        id: 0,
+        context: {},
+        signal: new AbortController().signal,
+      },
+    });
+
+    const result: any = await new Promise((resolve, reject) => {
+      chain.subscribe({
+        next: resolve,
+        error: reject,
+      });
+    });
+
+    expect(result.result.data).toBe('world');
+  });
+
+  it('ssrLink is an alias for localLink', () => {
+    expect(ssrLink).toBe(localLink);
+  });
+
+  it('propagates error shape and data', async () => {
+    const t = initTRPC.create();
+    const router = t.router({
+      error: t.procedure.query(() => {
+        throw new TRPCError({
+          code: 'BAD_REQUEST',
+          message: 'Custom error message',
+        });
+      }),
+    });
+
+    const link = localLink({ router });
+    const chain = createChain({
+      links: [link({} as any)],
+      op: {
+        type: 'query',
+        input: null,
+        path: 'error',
+        id: 0,
+        context: {},
+        signal: new AbortController().signal,
+      },
+    });
+
+    const err: any = await new Promise((resolve) => {
+      chain.subscribe({
+        next: resolve,
+        error: resolve,
+      });
+    });
+
+    expect(err).toBeInstanceOf(TRPCClientError);
+    expect(err.message).toBe('Custom error message');
+    expect(err.shape).toBeDefined();
+    expect(err.shape.code).toBe(-32600); // BAD_REQUEST
+  });
+
+  it('applies transformer to input and output correctly', async () => {
+    const transformer = {
+      input: {
+        serialize: vi.fn((data: any) => ({ data, serialized: true })),
+        deserialize: vi.fn((data: any) => data.data),
+      },
+      output: {
+        serialize: vi.fn((data: any) => ({ data, serialized: true })),
+        deserialize: vi.fn((data: any) => data.data),
+      },
+    };
+
+    const t = initTRPC.create({ transformer });
+    const router = t.router({
+      test: t.procedure
+        .input(String)
+        .query(({ input }) => `received: ${input}`),
+    });
+
+    const link = localLink({ router, transformer });
+    const chain = createChain({
+      links: [link({} as any)],
+      op: {
+        type: 'query',
+        input: 'world',
+        path: 'test',
+        id: 0,
+        context: {},
+        signal: new AbortController().signal,
+      },
+    });
+
+    const result: any = await new Promise((resolve, reject) => {
+      chain.subscribe({
+        next: resolve,
+        error: reject,
+      });
+    });
+
+    expect(result.result.data).toBe('received: world');
+    expect(transformer.input.serialize).toHaveBeenCalled();
+    expect(transformer.input.deserialize).toHaveBeenCalled();
+    expect(transformer.output.serialize).toHaveBeenCalled();
+    expect(transformer.output.deserialize).toHaveBeenCalled();
+  });
+
+  it('aborts the signal when unsubscribed', async () => {
+    let started = false;
+    const onAbort = vi.fn();
+    const t = initTRPC.create();
+    const router = t.router({
+      test: t.procedure.subscription(({ signal }) => {
+        started = true;
+        signal?.addEventListener('abort', onAbort);
+        return observable(() => {
+          // nothing
+        });
+      }),
+    });
+
+    const link = localLink({ router });
+    const chain = createChain({
+      links: [link({} as any)],
+      op: {
+        type: 'subscription',
+        input: null,
+        path: 'test',
+        id: 0,
+        context: {},
+        signal: new AbortController().signal,
+      },
+    });
+
+    const sub = chain.subscribe({});
+    await vi.waitFor(() => expect(started).toBe(true));
+    sub.unsubscribe();
+
+    expect(onAbort).toHaveBeenCalledTimes(1);
+  });
+
+  it('aborts the signal when op.signal is aborted', async () => {
+    let started = false;
+    const onAbort = vi.fn();
+    const t = initTRPC.create();
+    const router = t.router({
+      test: t.procedure.subscription(({ signal }) => {
+        started = true;
+        signal?.addEventListener('abort', onAbort);
+        return observable(() => {
+          // nothing
+        });
+      }),
+    });
+
+    const link = localLink({ router });
+    const ac = new AbortController();
+    const chain = createChain({
+      links: [link({} as any)],
+      op: {
+        type: 'subscription',
+        input: null,
+        path: 'test',
+        id: 0,
+        context: {},
+        signal: ac.signal,
+      },
+    });
+
+    chain.subscribe({});
+    await vi.waitFor(() => expect(started).toBe(true));
+    ac.abort();
+
+    expect(onAbort).toHaveBeenCalledTimes(1);
+  });
+});
diff --git a/packages/client/src/links/localLink.ts b/packages/client/src/links/localLink.ts
new file mode 100644
index 0000000000..fd983412fa
--- /dev/null
+++ b/packages/client/src/links/localLink.ts
@@ -0,0 +1,251 @@
+import { isObservable, observable } from '@trpc/server/observable';
+import type {
+  AnyRouter,
+  CreateContextCallback,
+  inferRouterContext,
+  MaybePromise,
+} from '@trpc/server/unstable-core-do-not-import';
+import {
+  callProcedure,
+  getErrorShape,
+  isAsyncIterable,
+  isTrackedEnvelope,
+  transformResult,
+  TRPCError,
+} from '@trpc/server/unstable-core-do-not-import';
+import {
+  getTransformer,
+  type TransformerOptions,
+} from '../internals/transformer';
+import { TRPCClientError } from '../TRPCClientError';
+import type { Operation, TRPCLink } from './types';
+
+/**
+ * @public
+ */
+export type LocalLinkOptions<TRouter extends AnyRouter> = CreateContextCallback<
+  inferRouterContext<TRouter>,
+  (opts: { op: Operation }) => MaybePromise<inferRouterContext<TRouter>>
+> & {
+  router: TRouter;
+  /**
+   * Callback for when an error occurs
+   */
+  onError?: (opts: {
+    path: string;
+    type: Operation['type'];
+    input: unknown;
+    error: TRPCClientError<TRouter>;
+  }) => void;
+} & TransformerOptions<TRouter['_def']['_config']['$types']>;
+
+/**
+ * @public
+ */
+export type SSRLinkOptions<TRouter extends AnyRouter> =
+  LocalLinkOptions<TRouter>;
+
+/**
+ * @see https://trpc.io/docs/v11/client/links/localLink
+ * @public
+ * localLink executes query and mutation procedures directly against the router in the same process without transferring requests to a server. ([validated by localLink runs query and mutation procedures in the same process as the client](packages/tests/server/localLink.acceptance.test.ts#L6))
+ * localLink supports createContext when calling procedures and converts thrown procedure errors into TRPCClientError instances on the client. ([validated by localLink supports createContext and propagates errors as TRPCClientError](packages/tests/server/localLink.acceptance.test.ts#L35))
+ * localLink executes subscription procedures in-process, forwards emitted items to onData, and aborts/cleans up the subscription when unsubscribed. ([validated by localLink runs subscription procedures in the same process and cleans up on unsubscribe](packages/tests/server/localLink.acceptance.test.ts#L69))
+ */
+export function localLink<TRouter extends AnyRouter>(
+  opts: LocalLinkOptions<TRouter>,
+): TRPCLink<TRouter> {
+  const transformer = getTransformer(opts.transformer);
+  return () => {
+    return ({ op }) => {
+      return observable((observer) => {
+        const { type, path, input, signal } = op;
+        const abortController = new AbortController();
+        let isAborted = false;
+        let subscription: { unsubscribe(): void } | null = null;
+
+        const onAbort = () => {
+          isAborted = true;
+          abortController.abort();
+          subscription?.unsubscribe();
+        };
+
+        signal?.addEventListener('abort', onAbort);
+        if (signal?.aborted) {
+          onAbort();
+        }
+
+        void (async () => {
+          let ctx: any;
+          try {
+            ctx =
+              'createContext' in opts && opts.createContext
+                ? await opts.createContext({ op })
+                : undefined;
+
+            if (isAborted) {
+              return;
+            }
+
+            const transformedInput = transformer.input.serialize(input);
+            const deserializedInput =
+              transformer.input.deserialize(transformedInput);
+            const result = await callProcedure({
+              router: opts.router,
+              path,
+              getRawInput: async () => deserializedInput,
+              input: deserializedInput,
+              type,
+              ctx,
+              signal: abortController.signal,
+            });
+
+            if (isAborted) {
+              return;
+            }
+
+            if (type !== 'subscription') {
+              const transformed = transformResult(
+                {
+                  result: {
+                    data: transformer.output.serialize(result),
+                  },
+                },
+                transformer.output,
+              );
+
+              if (!transformed.ok) {
+                const error = TRPCClientError.from(transformed.error);
+                opts.onError?.({
+                  path,
+                  type,
+                  input,
+                  error,
+                });
+                observer.error(error);
+                return;
+              }
+
+              observer.next({
+                result: transformed.result,
+              });
+              observer.complete();
+              return;
+            }
+
+            const onData = (val: any) => {
+              const data = isTrackedEnvelope(val)
+                ? {
+                    id: val[0],
+                    data: transformer.output.deserialize(
+                      transformer.output.serialize(val[1]),
+                    ),
+                  }
+                : transformer.output.deserialize(
+                    transformer.output.serialize(val),
+                  );
+
+              observer.next({
+                result: {
+                  type: 'data',
+                  data,
+                },
+              });
+            };
+
+            const onError = (cause: unknown) => {
+              const error =
+                cause instanceof TRPCError
+                  ? cause
+                  : new TRPCError({
+                      code: 'INTERNAL_SERVER_ERROR',
+                      cause,
+                      message: (cause as any)?.message,
+                    });
+              const shape = getErrorShape({
+                config: opts.router._def._config,
+                error,
+                type,
+                path,
+                input,
+                ctx,
+              });
+              const clientError = TRPCClientError.from({ error: shape });
+              opts.onError?.({
+                path,
+                type,
+                input,
+                error: clientError,
+              });
+              observer.error(clientError);
+            };
+
+            if (isObservable(result)) {
+              subscription = result.subscribe({
+                next: onData,
+                error: onError,
+                complete: () => observer.complete(),
+              });
+              return;
+            }
+
+            if (isAsyncIterable(result)) {
+              try {
+                for await (const val of result) {
+                  if (isAborted) {
+                    break;
+                  }
+                  onData(val);
+                }
+                observer.complete();
+              } catch (err) {
+                onError(err);
+              }
+              return;
+            }
+
+            throw new Error(
+              `Expected an async iterable or observable from subscription procedure at "${path}"`,
+            );
+          } catch (cause) {
+            const error =
+              cause instanceof TRPCError
+                ? cause
+                : new TRPCError({
+                    code: 'INTERNAL_SERVER_ERROR',
+                    cause,
+                    message: (cause as any)?.message,
+                  });
+            const shape = getErrorShape({
+              config: opts.router._def._config,
+              error,
+              type,
+              path,
+              input,
+              ctx,
+            });
+            const clientError = TRPCClientError.from({ error: shape });
+            opts.onError?.({
+              path,
+              type,
+              input,
+              error: clientError,
+            });
+            observer.error(clientError);
+          }
+        })();
+
+        return () => {
+          onAbort();
+          signal?.removeEventListener('abort', onAbort);
+        };
+      });
+    };
+  };
+}
+
+/**
+ * @see https://trpc.io/docs/v11/client/links/localLink
+ * @public
+ */
+export const ssrLink = localLink;
