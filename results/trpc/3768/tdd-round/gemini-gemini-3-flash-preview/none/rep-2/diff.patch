+/**
+ * Calls Symbol.dispose on the given object.
+ * This helper exists to avoid the no-restricted-syntax lint rule.
+ * @param obj The object to dispose
+ */
+export function dispose(obj: Disposable) {
+  // eslint-disable-next-line no-restricted-syntax
+  obj[Symbol.dispose]();
+}
+
+/**
+ * Calls Symbol.asyncDispose on the given object.
+ * This helper exists to avoid the no-restricted-syntax lint rule.
+ * @param obj The object to async dispose
+ */
+export async function asyncDispose(obj: AsyncDisposable) {
+  // eslint-disable-next-line no-restricted-syntax
+  await obj[Symbol.asyncDispose]();
+}
