@@ -0,0 +1,126 @@
+import { initTRPC } from '@trpc/server';
+import { describe, expect, it } from 'vitest';
+import { createTRPCClient } from '../createTRPCClient';
+import { localLink } from './localLink';
+
+describe('localLink', () => {
+  it('runs a query', async () => {
+    const t = initTRPC.create();
+    const router = t.router({
+      hello: t.procedure.query(() => 'world'),
+    });
+
+    const client = createTRPCClient<typeof router>({
+      links: [
+        localLink({
+          router,
+        }),
+      ],
+    });
+
+    const res = await client.hello.query();
+    expect(res).toBe('world');
+  });
+
+  it('runs a mutation', async () => {
+    const t = initTRPC.create();
+    const router = t.router({
+      hello: t.procedure
+        .input(String)
+        .mutation(({ input }) => `hello ${input}`),
+    });
+
+    const client = createTRPCClient<typeof router>({
+      links: [
+        localLink({
+          router,
+        }),
+      ],
+    });
+
+    const res = await client.hello.mutate('world');
+    expect(res).toBe('hello world');
+  });
+
+  it('runs a subscription', async () => {
+    const t = initTRPC.create();
+    const router = t.router({
+      onMessage: t.procedure.subscription(async function* () {
+        yield 'one';
+        yield 'two';
+      }),
+    });
+
+    const client = createTRPCClient<typeof router>({
+      links: [
+        localLink({
+          router,
+        }),
+      ],
+    });
+
+    const msgs: string[] = [];
+    await new Promise<void>((resolve) => {
+      client.onMessage.subscribe(undefined, {
+        onData(data) {
+          msgs.push(data);
+          if (msgs.length === 2) {
+            resolve();
+          }
+        },
+      });
+    });
+
+    expect(msgs).toEqual(['one', 'two']);
+  });
+
+  it('supports createContext', async () => {
+    const t = initTRPC.context<{ user: string }>().create();
+    const router = t.router({
+      whoami: t.procedure.query(({ ctx }) => ctx.user),
+    });
+
+    const client = createTRPCClient<typeof router>({
+      links: [
+        localLink({
+          router,
+          createContext: () => ({ user: 'alice' }),
+        }),
+      ],
+    });
+
+    const res = await client.whoami.query();
+    expect(res).toBe('alice');
+  });
+
+  it('calls onError when a procedure throws', async () => {
+    const t = initTRPC.create();
+    const router = t.router({
+      error: t.procedure.query(() => {
+        throw new Error('something went wrong');
+      }),
+    });
+
+    const onError = vi.fn();
+    const client = createTRPCClient<typeof router>({
+      links: [
+        localLink({
+          router,
+          onError,
+        }),
+      ],
+    });
+
+    await expect(client.error.query()).rejects.toThrow('something went wrong');
+    expect(onError).toHaveBeenCalledTimes(1);
+    expect(onError).toHaveBeenCalledWith(
+      expect.objectContaining({
+        error: expect.any(Error),
+        op: expect.objectContaining({
+          path: 'error',
+          type: 'query',
+        }),
+      }),
+    );
+  });
+});
