+import { isObservable, observable } from '@trpc/server/observable';
+import type {
+  AnyRouter,
+  CreateContextCallback,
+  inferClientTypes,
+  inferRouterContext,
+  MaybePromise,
+  TRPCResultMessage,
+} from '@trpc/server/unstable-core-do-not-import';
+import {
+  callProcedure,
+  isAsyncIterable,
+  isTrackedEnvelope,
+  run,
+  transformResult,
+  TRPCError,
+} from '@trpc/server/unstable-core-do-not-import';
+import {
+  getTransformer,
+  type TransformerOptions,
+} from '../internals/transformer';
+import { TRPCClientError } from '../TRPCClientError';
+import type { Operation, TRPCLink } from './types';
+
+type LocalLinkCreateContextFn<TRouter extends AnyRouter> = (opts: {
+  op: Operation;
+}) => MaybePromise<inferRouterContext<TRouter>>;
+
+/**
+ * @public
+ */
+export type LocalLinkOptions<TRouter extends AnyRouter> = {
+  router: TRouter;
+  /**
+   * Called when an error occurs in a procedure
+   */
+  onError?: (opts: { error: TRPCClientError<TRouter>; op: Operation }) => void;
+} & TransformerOptions<inferClientTypes<TRouter>> &
+  CreateContextCallback<
+    inferRouterContext<TRouter>,
+    LocalLinkCreateContextFn<TRouter>
+  >;
+
+/**
+ * @see https://trpc.io/docs/v11/client/links/localLink
+ */
+export function localLink<TRouter extends AnyRouter>(
+  opts: LocalLinkOptions<TRouter>,
+): TRPCLink<TRouter> {
+  const { router } = opts;
+  const transformer = getTransformer(opts.transformer);
+
+  return () => {
+    return ({ op }) => {
+      return observable((observer) => {
+        const { path, input, type } = op;
+        const abortController = new AbortController();
+        const signal = op.signal;
+        if (signal) {
+          signal.addEventListener('abort', () => abortController.abort(), {
+            once: true,
+          });
+        }
+
+        const promise = (async () => {
+          try {
+            const ctx =
+              'createContext' in opts &&
+              typeof opts.createContext === 'function'
+                ? await opts.createContext({
+                    op,
+                  })
+                : (opts as any).createContext;
+
+            const result = await callProcedure({
+              router,
+              path,
+              input: transformer.input.deserialize(
+                transformer.input.serialize(input),
+              ),
+              type,
+              ctx,
+              signal: abortController.signal,
+              getRawInput: async () => input,
+            });
+
+            if (type === 'subscription') {
+              const handleNext = (data: unknown) => {
+                const dataToSerialize = isTrackedEnvelope(data)
+                  ? { id: data[0], data: data[1] }
+                  : data;
+                const serialized =
+                  transformer.output.serialize(dataToSerialize);
+                const envelope: TRPCResultMessage<unknown> = {
+                  id: op.id,
+                  result: isTrackedEnvelope(data)
+                    ? {
+                        type: 'data',
+                        id: data[0],
+                        data: serialized,
+                      }
+                    : {
+                        type: 'data',
+                        data: serialized,
+                      },
+                };
+                const transformed = transformResult(
+                  envelope,
+                  transformer.output,
+                );
+                if (!transformed.ok) {
+                  observer.error(TRPCClientError.from(transformed.error));
+                  return;
+                }
+                observer.next({
+                  result: transformed.result,
+                });
+              };
+
+              const handleError = (err: unknown) => {
+                const error = TRPCClientError.from(err);
+                opts.onError?.({ error, op });
+                observer.error(error);
+              };
+
+              const handleComplete = () => {
+                observer.complete();
+              };
+
+              const isObservableResult = isObservable(result);
+              const isAsyncIterableResult = isAsyncIterable(result);
+
+              if (isObservableResult) {
+                return result.subscribe({
+                  next: handleNext,
+                  error: handleError,
+                  complete: handleComplete,
+                });
+              }
+
+              if (isAsyncIterableResult) {
+                void run(async () => {
+                  try {
+                    for await (const data of result) {
+                      handleNext(data);
+                    }
+                    handleComplete();
+                  } catch (err) {
+                    handleError(err);
+                  }
+                });
+                return () => {
+                  abortController.abort();
+                };
+              }
+
+              throw new TRPCError({
+                message: `Subscription ${path} did not return an observable or a AsyncGenerator`,
+                code: 'INTERNAL_SERVER_ERROR',
+              });
+            }
+
+            const serializedOutput = transformer.output.serialize(result);
+            const envelope: TRPCResultMessage<unknown> = {
+              id: op.id,
+              result: {
+                type: 'data',
+                data: serializedOutput,
+              },
+            };
+            const transformed = transformResult(envelope, transformer.output);
+
+            if (!transformed.ok) {
+              observer.error(TRPCClientError.from(transformed.error));
+              return;
+            }
+
+            observer.next({
+              result: transformed.result,
+            });
+            observer.complete();
+          } catch (cause) {
+            const error = TRPCClientError.from(cause);
+            opts.onError?.({ error, op });
+            observer.error(error);
+          }
+        })();
+
+        return () => {
+          abortController.abort();
+          void promise.then((teardown) => {
+            if (typeof teardown === 'function') {
+              teardown();
+            } else if (teardown && 'unsubscribe' in teardown) {
+              teardown.unsubscribe();
+            }
+          });
+        };
+      });
+    };
+  };
+}
