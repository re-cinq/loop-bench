diff --git a/packages/client/src/links/localLink.test.ts b/packages/client/src/links/localLink.test.ts
new file mode 100644
index 0000000000..4ed0bd8c08
--- /dev/null
+++ b/packages/client/src/links/localLink.test.ts
@@ -0,0 +1,239 @@
+import { EventEmitter } from 'node:events';
+import { initTRPC, tracked } from '@trpc/server';
+import { observable } from '@trpc/server/observable';
+import { describe, expect, it, vi } from 'vitest';
+import { z } from 'zod';
+import { createTRPCClient } from '../createTRPCClient';
+import { TRPCClientError } from '../TRPCClientError';
+import { localLink, ssrLink } from './localLink';
+
+describe('localLink', () => {
+  it('ssrLink should be an alias for localLink', () => {
+    expect(ssrLink).toBe(localLink);
+  });
+
+  it('should be able to run a query', async () => {
+    const t = initTRPC.create();
+    const router = t.router({
+      hello: t.procedure.query(() => 'world'),
+    });
+
+    const client = createTRPCClient<typeof router>({
+      links: [
+        localLink({
+          router,
+        }),
+      ],
+    });
+
+    const res = await client.hello.query();
+    expect(res).toBe('world');
+  });
+
+  it('should be able to run a query with context', async () => {
+    const t = initTRPC.context<{ user: string }>().create();
+    const router = t.router({
+      whoami: t.procedure.query(({ ctx }) => ctx.user),
+    });
+
+    const client = createTRPCClient<typeof router>({
+      links: [
+        localLink({
+          router,
+          createContext: () => ({ user: 'alice' }),
+        }),
+      ],
+    });
+
+    const res = await client.whoami.query();
+    expect(res).toBe('alice');
+  });
+
+  it('should apply transformers', async () => {
+    const transformer = {
+      serialize: (v: any) => v + ' [serialized]',
+      deserialize: (v: any) => v + ' [deserialized]',
+    };
+    const t = initTRPC.create({
+      transformer,
+    });
+    const router = t.router({
+      hello: t.procedure.query(() => 'world'),
+    });
+
+    const client = createTRPCClient<typeof router>({
+      links: [
+        localLink({
+          router,
+          transformer,
+        }),
+      ],
+    });
+
+    const res = await client.hello.query();
+    expect(res).toBe('world [serialized] [deserialized]');
+  });
+
+  it('should apply transformers to input', async () => {
+    const transformer = {
+      serialize: (v: any) => v + ' [serialized]',
+      deserialize: (v: any) => v + ' [deserialized]',
+    };
+    const t = initTRPC.create({
+      transformer,
+    });
+    const router = t.router({
+      hello: t.procedure.input(z.string()).query(({ input }) => input),
+    });
+
+    const client = createTRPCClient<typeof router>({
+      links: [
+        localLink({
+          router,
+          transformer,
+        }),
+      ],
+    });
+
+    const res = await client.hello.query('world');
+    expect(res).toBe(
+      'world [serialized] [deserialized] [serialized] [deserialized]',
+    );
+  });
+
+  it('should propagate errors', async () => {
+    const t = initTRPC.create();
+    const router = t.router({
+      err: t.procedure.query(() => {
+        throw new Error('some error');
+      }),
+    });
+
+    const client = createTRPCClient<typeof router>({
+      links: [localLink({ router })],
+    });
+
+    await expect(client.err.query()).rejects.toThrow(TRPCClientError);
+    await expect(client.err.query()).rejects.toMatchObject({
+      message: 'some error',
+    });
+  });
+
+  it('should call onError', async () => {
+    const t = initTRPC.create();
+    const router = t.router({
+      err: t.procedure.query(() => {
+        throw new Error('some error');
+      }),
+    });
+
+    const onError = vi.fn();
+    const client = createTRPCClient<typeof router>({
+      links: [
+        localLink({
+          router,
+          onError,
+        }),
+      ],
+    });
+
+    await expect(client.err.query()).rejects.toThrow();
+    expect(onError).toHaveBeenCalledTimes(1);
+    expect(onError).toHaveBeenCalledWith(
+      expect.objectContaining({
+        path: 'err',
+        type: 'query',
+        error: expect.any(TRPCClientError),
+      }),
+    );
+  });
+
+  it('should handle subscriptions', async () => {
+    const t = initTRPC.create();
+    const router = t.router({
+      onMessage: t.procedure.subscription(async function* () {
+        yield 'one';
+        yield 'two';
+      }),
+    });
+
+    const client = createTRPCClient<typeof router>({
+      links: [localLink({ router })],
+    });
+
+    const onData = vi.fn();
+    client.onMessage.subscribe(undefined, {
+      onData,
+    });
+
+    await vi.waitFor(() => {
+      expect(onData).toHaveBeenCalledTimes(2);
+    });
+    expect(onData).toHaveBeenNthCalledWith(1, 'one');
+    expect(onData).toHaveBeenNthCalledWith(2, 'two');
+  });
+
+  it('should handle observable subscriptions', async () => {
+    const t = initTRPC.create();
+    const ee = new EventEmitter();
+    const router = t.router({
+      onMessage: t.procedure.subscription(() => {
+        return observable<string>((observer) => {
+          const onMessage = (msg: string) => {
+            observer.next(msg);
+          };
+          ee.on('message', onMessage);
+          return () => {
+            ee.off('message', onMessage);
+          };
+        });
+      }),
+    });
+
+    const client = createTRPCClient<typeof router>({
+      links: [localLink({ router })],
+    });
+
+    const onData = vi.fn();
+    const sub = client.onMessage.subscribe(undefined, {
+      onData,
+    });
+
+    await vi.waitFor(() => {
+      expect(ee.listenerCount('message')).toBe(1);
+    });
+
+    ee.emit('message', 'one');
+    await vi.waitFor(() => {
+      expect(onData).toHaveBeenCalledWith('one');
+    });
+
+    sub.unsubscribe();
+    expect(ee.listenerCount('message')).toBe(0);
+  });
+
+  it('should handle tracked envelopes', async () => {
+    const t = initTRPC.create();
+    const router = t.router({
+      onMessage: t.procedure.subscription(async function* () {
+        yield tracked('1', 'one');
+        yield tracked('2', 'two');
+      }),
+    });
+
+    const client = createTRPCClient<typeof router>({
+      links: [localLink({ router })],
+    });
+
+    const onData = vi.fn();
+    client.onMessage.subscribe(undefined, {
+      onData,
+    });
+
+    await vi.waitFor(() => {
+      expect(onData).toHaveBeenCalledTimes(2);
+    });
+    expect(onData).toHaveBeenNthCalledWith(1, 'one');
+    expect(onData).toHaveBeenNthCalledWith(2, 'two');
+  });
+});
