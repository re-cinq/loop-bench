index 0000000000..3b78c2c1f4
--- /dev/null
+++ b/packages/client/src/links/localLink.ts
@@ -0,0 +1,201 @@
+import { isObservable, observable } from '@trpc/server/observable';
+import type { Unsubscribable } from '@trpc/server/observable';
+import type {
+  AnyRouter,
+  CreateContextCallback,
+  inferRouterContext,
+  MaybePromise,
+} from '@trpc/server/unstable-core-do-not-import';
+import {
+  callProcedure as callTRPCProcedure,
+  isTrackedEnvelope,
+  transformResult,
+} from '@trpc/server/unstable-core-do-not-import';
+import { raceAbortSignals } from '../internals/signals';
+import { getTransformer } from '../internals/transformer';
+import type { TransformerOptions } from '../internals/transformer';
+import { TRPCClientError } from '../TRPCClientError';
+import type { Operation, TRPCLink } from './types';
+
+/**
+ * @public
+ */
+export type LocalLinkOptions<TRouter extends AnyRouter> = {
+  router: TRouter;
+  /**
+   * Optional callback to handle errors
+   */
+  onError?: (opts: {
+    path: string;
+    type: Operation['type'];
+    input: unknown;
+    error: TRPCClientError<TRouter>;
+  }) => void;
+} & CreateContextCallback<
+  inferRouterContext<TRouter>,
+  (opts: { op: Operation }) => MaybePromise<inferRouterContext<TRouter>>
+> &
+  TransformerOptions<TRouter['_def']['_config']['$types']>;
+
+/**
+ * @see https://trpc.io/docs/v11/client/links/localLink
+ * @public
+ */
+export function localLink<TRouter extends AnyRouter>(
+  opts: LocalLinkOptions<TRouter>,
+): TRPCLink<TRouter> {
+  const _transformer = getTransformer(opts.transformer);
+  return () =>
+    ({ op }) =>
+      observable((observer) => {
+        const { type, path, input } = op;
+        let isCancelled = false;
+        let subscription: Unsubscribable | undefined;
+
+        const ac = new AbortController();
+        const signal = raceAbortSignals(op.signal, ac.signal);
+
+        void (async () => {
+          try {
+            const transformedInput = _transformer.input.serialize(input);
+            const deserializedInput =
+              opts.router._def._config.transformer.input.deserialize(
+                transformedInput,
+              );
+
+            const ctx = opts.createContext
+              ? await (opts as any).createContext({ op })
+              : undefined;
+
+            if (isCancelled) {
+              return;
+            }
+
+            const result = await callTRPCProcedure({
+              router: opts.router,
+              path,
+              type,
+              input: deserializedInput,
+              ctx,
+              signal,
+              getRawInput: async () => deserializedInput,
+            });
+
+            if (isCancelled) {
+              return;
+            }
+
+            const onNext = (data: unknown) => {
+              let result = data;
+              let id: string | undefined;
+              if (isTrackedEnvelope(data)) {
+                id = data[0];
+                result = data[1];
+              }
+
+              const serialized =
+                opts.router._def._config.transformer.output.serialize(result);
+
+              const transformed = transformResult(
+                {
+                  result: {
+                    type: 'data',
+                    data: serialized,
+                    ...(id ? { id } : {}),
+                  },
+                },
+                _transformer.output,
+              );
+
+              if (!transformed.ok) {
+                const error = TRPCClientError.from(transformed.error);
+                opts.onError?.({
+                  path,
+                  type,
+                  input,
+                  error,
+                });
+                observer.error(error);
+                return;
+              }
+
+              observer.next({
+                result: transformed.result,
+              });
+            };
+
+            if (type === 'subscription') {
+              if (isObservable(result)) {
+                subscription = result.subscribe({
+                  next: onNext,
+                  error: (cause) => {
+                    const error = TRPCClientError.from(cause);
+                    opts.onError?.({
+                      path,
+                      type,
+                      input,
+                      error,
+                    });
+                    observer.error(error);
+                  },
+                  complete: () => {
+                    observer.complete();
+                  },
+                });
+              } else {
+                try {
+                  for await (const data of result as AsyncIterable<unknown>) {
+                    if (isCancelled) {
+                      break;
+                    }
+                    onNext(data);
+                  }
+                  if (!isCancelled) {
+                    observer.complete();
+                  }
+                } catch (cause) {
+                  if (!isCancelled) {
+                    const error = TRPCClientError.from(cause);
+                    opts.onError?.({
+                      path,
+                      type,
+                      input,
+                      error,
+                    });
+                    observer.error(error);
+                  }
+                }
+              }
+              return;
+            }
+
+            onNext(result);
+            observer.complete();
+          } catch (cause) {
+            if (isCancelled) {
+              return;
+            }
+            const error = TRPCClientError.from(cause);
+            opts.onError?.({
+              path,
+              type,
+              input,
+              error,
+            });
+            observer.error(error);
+          }
+        })();
+
+        return () => {
+          isCancelled = true;
+          ac.abort();
+          subscription?.unsubscribe();
+        };
+      });
+}
+
+/**
+ * @alias localLink
+ * @public
+ */
+export const ssrLink = localLink;
