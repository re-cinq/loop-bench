+import { initTRPC, TRPCError } from '@trpc/server';
+import { z } from 'zod';
+import { createTRPCClient } from '../createTRPCClient';
+import { TRPCClientError } from '../TRPCClientError';
+import { localLink } from './localLink';
+
+test('localLink executes query and mutation with context, transformer, and error handling', async () => {
+  const t = initTRPC.context<{ user: string }>().create({
+    transformer: {
+      serialize: (v: unknown) => v,
+      deserialize: (v: unknown) => v,
+    },
+  });
+
+  const router = t.router({
+    hello: t.procedure
+      .input(z.object({ name: z.string() }))
+      .query(({ ctx, input }) => {
+        return `hello ${input.name} from ${ctx.user}`;
+      }),
+    fail: t.procedure.mutation(() => {
+      throw new TRPCError({
+        code: 'BAD_REQUEST',
+        message: 'mutation failed',
+      });
+    }),
+  });
+
+  const onError = vi.fn();
+  const client = createTRPCClient<typeof router>({
+    links: [
+      localLink({
+        router,
+        createContext: async () => ({ user: 'admin' }),
+        transformer: {
+          serialize: (v: unknown) => v,
+          deserialize: (v: unknown) => v,
+        },
+        onError,
+      }),
+    ],
+  });
+
+  const res = await client.hello.query({ name: 'world' });
+  expect(res).toBe('hello world from admin');
+
+  await expect(client.fail.mutate()).rejects.toThrow(TRPCClientError);
+  await expect(client.fail.mutate()).rejects.toMatchObject({
+    message: 'mutation failed',
+  });
+  expect(onError).toHaveBeenCalled();
+});
diff --git a/packages/client/src/links/localLink.ts b/packages/client/src/links/localLink.ts
new file mode 100644
index 0000000000..160316c952
--- /dev/null
+++ b/packages/client/src/links/localLink.ts
@@ -0,0 +1,162 @@
+import {
+  isObservable,
+  observable,
+  observableToAsyncIterable,
+} from '@trpc/server/observable';
+import type {
+  AnyRouter,
+  CreateContextCallback,
+  ErrorHandlerOptions,
+  inferClientTypes,
+  inferRouterContext,
+  MaybePromise,
+} from '@trpc/server/unstable-core-do-not-import';
+import {
+  callProcedure,
+  getErrorShape,
+  getTRPCErrorFromUnknown,
+  isAsyncIterable,
+  isTrackedEnvelope,
+  run,
+  TRPCError,
+} from '@trpc/server/unstable-core-do-not-import';
+import { raceAbortSignals } from '../internals/signals';
+import {
+  getTransformer,
+  type TransformerOptions,
+} from '../internals/transformer';
+import { TRPCClientError } from '../TRPCClientError';
+import type { TRPCLink } from './types';
+
+export type LocalLinkOptions<TRouter extends AnyRouter> = {
+  router: TRouter;
+  /**
+   * Called when an error occurs in the handler
+   */
+  onError?: (opts: ErrorHandlerOptions<inferRouterContext<TRouter>>) => void;
+} & CreateContextCallback<
+  inferRouterContext<TRouter>,
+  () => MaybePromise<inferRouterContext<TRouter>>
+> &
+  TransformerOptions<inferClientTypes<TRouter>>;
+
+/**
+ * Create a link that runs the router in the same process as the client
+ */
+export function localLink<TRouter extends AnyRouter>(
+  opts: LocalLinkOptions<TRouter>,
+): TRPCLink<TRouter> {
+  const transformer = getTransformer(opts.transformer);
+  return () => {
+    return ({ op }) => {
+      return observable((observer) => {
+        const { type, path, input } = op;
+        const ac = new AbortController();
+        const signal = raceAbortSignals(op.signal, ac.signal);
+
+        let ctx: inferRouterContext<TRouter> | undefined = undefined;
+
+        run(async () => {
+          ctx =
+            (await opts.createContext?.()) ??
+            ({} as inferRouterContext<TRouter>);
+          const rawInput = transformer.input.serialize(input);
+
+          const result = await callProcedure({
+            router: opts.router,
+            path,
+            getRawInput: async () => rawInput,
+            ctx,
+            type,
+            signal,
+          });
+
+          if (type !== 'subscription') {
+            const transformed = transformer.output.deserialize(
+              opts.router._def._config.transformer.output.serialize(result),
+            );
+            observer.next({
+              result: {
+                type: 'data',
+                data: transformed,
+              },
+            });
+            observer.complete();
+          } else {
+            const iterable = isObservable(result)
+              ? observableToAsyncIterable(result, signal)
+              : isAsyncIterable(result)
+                ? result
+                : null;
+
+            if (!iterable) {
+              throw new TRPCError({
+                message: `Subscription ${path} did not return an observable or a AsyncIterable`,
+                code: 'INTERNAL_SERVER_ERROR',
+              });
+            }
+
+            observer.next({
+              result: {
+                type: 'started',
+              },
+            });
+
+            for await (const value of iterable) {
+              if (signal.aborted) {
+                break;
+              }
+              const isTracked = isTrackedEnvelope(value);
+              const data = isTracked ? value[1] : value;
+              const transformed = transformer.output.deserialize(
+                opts.router._def._config.transformer.output.serialize(data),
+              );
+              observer.next({
+                result: {
+                  type: 'data',
+                  data: transformed,
+                  ...(isTracked && { id: value[0] }),
+                },
+              });
+            }
+            observer.next({
+              result: {
+                type: 'stopped',
+              },
+            });
+            observer.complete();
+          }
+        }).catch((cause) => {
+          const error = getTRPCErrorFromUnknown(cause);
+          opts.onError?.({
+            error,
+            type,
+            path,
+            input,
+            ctx,
+          });
+          const errorShape = getErrorShape({
+            config: opts.router._def._config,
+            error,
+            type,
+            path,
+            input,
+            ctx,
+          });
+          const transformedError = transformer.output.deserialize(
+            opts.router._def._config.transformer.output.serialize(errorShape),
+          );
+          observer.error(
+            TRPCClientError.from({
+              error: transformedError,
+            }),
+          );
+        });
+
+        return () => {
+          ac.abort();
+        };
+      });
+    };
+  };
+}
diff --git a/packages/tests/server/localLink.acceptance.test.ts b/packages/tests/server/localLink.acceptance.test.ts
new file mode 100644
index 0000000000..d8d1302a44
--- /dev/null
+++ b/packages/tests/server/localLink.acceptance.test.ts
@@ -0,0 +1,115 @@
+import { EventEmitter, on } from 'node:events';
+import { createTRPCClient, localLink, TRPCClientError } from '@trpc/client';
+import { initTRPC, TRPCError } from '@trpc/server';
+import { z } from 'zod';
+
+test('localLink runs query and mutation procedures in the same process as the client', async () => {
+  const createRouter = (opts: { database: string[] }) => {
+    const t = initTRPC.create();
+    return t.router({
+      list: t.procedure.query(() => {
+        return [...opts.database];
+      }),
+      add: t.procedure
+        .input(z.object({ item: z.string() }))
+        .mutation(({ input }) => {
+          opts.database.push(input.item);
+          return opts.database.length;
+        }),
+    });
+  };
+
+  const database: string[] = ['initial'];
+  const router = createRouter({ database });
+
+  const client = createTRPCClient<typeof router>({
+    links: [localLink({ router })],
+  });
+
+  expect(await client.list.query()).toEqual(['initial']);
+  expect(await client.add.mutate({ item: 'second' })).toBe(2);
+  expect(await client.list.query()).toEqual(['initial', 'second']);
+  expect(database).toEqual(['initial', 'second']);
+});
+
+test('localLink supports createContext and propagates errors as TRPCClientError', async () => {
+  const t = initTRPC.context<{ user: string | null }>().create();
+
+  const router = t.router({
+    whoami: t.procedure.query(({ ctx }) => {
+      if (!ctx.user) {
+        throw new TRPCError({
+          code: 'UNAUTHORIZED',
+          message: 'Not authenticated',
+        });
+      }
+      return `hello ${ctx.user}`;
+    }),
+  });
+
+  let currentUser: string | null = 'alice';
+  const client = createTRPCClient<typeof router>({
+    links: [
+      localLink({
+        router,
+        createContext: async () => ({ user: currentUser }),
+      }),
+    ],
+  });
+
+  expect(await client.whoami.query()).toBe('hello alice');
+
+  currentUser = null;
+  await expect(client.whoami.query()).rejects.toThrow(TRPCClientError);
+  await expect(client.whoami.query()).rejects.toMatchObject({
+    message: 'Not authenticated',
+  });
+});
+
+test('localLink runs subscription procedures in the same process and cleans up on unsubscribe', async () => {
+  const ee = new EventEmitter();
+  const t = initTRPC.create();
+
+  const router = t.router({
+    onMessage: t.procedure
+      .input(z.object({ prefix: z.string() }))
+      .subscription(async function* (opts) {
+        for await (const [msg] of on(ee, 'message', {
+          signal: opts.signal,
+        })) {
+          yield `${opts.input.prefix}: ${String(msg)}`;
+        }
+      }),
+  });
+
+  const client = createTRPCClient<typeof router>({
+    links: [localLink({ router })],
+  });
+
+  const received: string[] = [];
+  const sub = client.onMessage.subscribe(
+    { prefix: 'msg' },
+    {
+      onData(data) {
+        received.push(data);
+      },
+    },
+  );
+
+  await vi.waitFor(() => {
+    expect(ee.listenerCount('message')).toBe(1);
+  });
+
+  ee.emit('message', 'first');
+  ee.emit('message', 'second');
+
+  await vi.waitFor(() => {
+    expect(received).toEqual(['msg: first', 'msg: second']);
+  });
+
+  sub.unsubscribe();
+
+  await vi.waitFor(() => {
+    expect(ee.listenerCount('message')).toBe(0);
+  });
+});