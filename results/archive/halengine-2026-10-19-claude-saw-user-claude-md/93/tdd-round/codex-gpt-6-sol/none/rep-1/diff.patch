+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks, TurnUsage} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+
+// Validates specs/hal-engine-config-hooks/spec.md#7, "Usage reported to afterModelResponse".
+it('exposes the hook usage as a turn total type', async () => {
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield {type: 'text', text: 'answer'};
+      yield {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 7, outputTokens: 2, totalTokens: 9}};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  let received: TurnUsage | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, turnUsage: TurnUsage | undefined) => {
+      received = turnUsage;
+    },
+  };
+
+  await createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), undefined, {hooks}).processMessage({
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'ask', timestamp: '2026-01-01T00:00:00.000Z'}],
+  });
+
+  expect(received).toEqual({inputTokens: 7, outputTokens: 2, totalTokens: 9});
+});