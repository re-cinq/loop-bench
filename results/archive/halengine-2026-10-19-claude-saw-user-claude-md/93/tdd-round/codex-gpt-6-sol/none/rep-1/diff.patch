+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+
+// Validates specs/hal-engine-config-hooks/spec.md#7, "Usage reported to afterModelResponse".
+it('sums usage from a tool call and its answering provider call', async () => {
+  let providerCall = 0;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      if (providerCall++ === 0) {
+        yield {type: 'tool_use', toolCall: {id: 'lookup-1', name: 'lookup', input: {}}};
+        yield {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 12, outputTokens: 3, totalTokens: 15}};
+        return;
+      }
+      yield {type: 'text', text: 'answer'};
+      yield {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 20, outputTokens: 5, totalTokens: 25}};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const tools = new ToolRegistry();
+  tools.register({name: 'lookup', description: 'lookup', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found',
+  }));
+  const reports: Array<UsageMetadata | undefined> = [];
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reports.push(usage);
+    },
+  };
+  await createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), tools, {hooks}).processMessage({
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'ask', timestamp: '2026-01-01T00:00:00.000Z'}],
+  });
+
+  expect(reports).toEqual([{inputTokens: 32, outputTokens: 8, totalTokens: 40}]);
+});
