@@ -0,0 +1,133 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {registryReturning, TOOL_CALL, STOP_FOR_TOOL} from './testHelpers.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const multiRoundProviderWithUsage = (rounds: {chunks: MessageChunk[]; usage?: UsageMetadata}[]): AIProvider => {
+  let roundIndex = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const round = rounds[roundIndex++];
+      if (!round) return;
+      for (let i = 0; i < round.chunks.length; i++) {
+        const chunk = round.chunks[i];
+        const isLast = i === round.chunks.length - 1;
+        if (isLast && chunk.type === 'stop' && round.usage) {
+          yield {type: 'stop', stopReason: chunk.stopReason, usage: round.usage};
+          continue;
+        }
+        yield chunk;
+      }
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const promptBuilder = new PromptBuilder({identity: 'Test assistant'});
+
+const runMultiRound = async (
+  rounds: {chunks: MessageChunk[]; usage?: UsageMetadata}[]
+): Promise<UsageMetadata | undefined> => {
+  const {hooks, get} = captureUsage();
+  const orchestrator = createChatOrchestrator(
+    multiRoundProviderWithUsage(rounds),
+    promptBuilder,
+    registryReturning({result: 'tool result'}),
+    {hooks}
+  );
+  await orchestrator.processMessage(createSession('ask'));
+  return get();
+};
+
+const captureUsage = (): {hooks: OrchestratorHooks; get: () => UsageMetadata | undefined} => {
+  let received: UsageMetadata | undefined;
+  return {
+    hooks: {
+      afterModelResponse: async (_s, _t, u) => {
+        received = u;
+      },
+    },
+    get: () => received,
+  };
+};
+
+const textProvider = (text: string, usage?: UsageMetadata): AIProvider => ({
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text};
+    yield usage ? {type: 'stop', stopReason: 'end_turn', usage} : {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+describe('Report usage across every tool round, not just the last', () => {
+  it('accumulates usage from multiple tool rounds into a single total', async () => {
+    const usage = await runMultiRound([
+      {chunks: [TOOL_CALL, STOP_FOR_TOOL], usage: {inputTokens: 100, outputTokens: 50, totalTokens: 150}},
+      {
+        chunks: [
+          {type: 'text', text: 'answer'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ],
+        usage: {inputTokens: 50, outputTokens: 75, totalTokens: 125},
+      },
+    ]);
+
+    expect(usage).toEqual({inputTokens: 150, outputTokens: 125, totalTokens: 275});
+  });
+
+  it('turn with no tool calls reports the same usage as before', async () => {
+    const usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const {hooks, get} = captureUsage();
+
+    const orchestrator = createChatOrchestrator(textProvider('direct answer', usage), promptBuilder, undefined, {
+      hooks,
+    });
+    await orchestrator.processMessage(createSession('hi'));
+
+    expect(get()).toEqual(usage);
+  });
+
+  it('accumulates reported usage when some rounds report none', async () => {
+    const usage = await runMultiRound([
+      {chunks: [TOOL_CALL, STOP_FOR_TOOL], usage: {inputTokens: 100, outputTokens: 50, totalTokens: 150}},
+      {chunks: [TOOL_CALL, STOP_FOR_TOOL]},
+      {
+        chunks: [
+          {type: 'text', text: 'final'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ],
+        usage: {inputTokens: 30, outputTokens: 20, totalTokens: 50},
+      },
+    ]);
+
+    expect(usage).toEqual({inputTokens: 130, outputTokens: 70, totalTokens: 200});
+  });
+
+  it('turn with no usage reported on any round passes undefined to hook', async () => {
+    const {hooks, get} = captureUsage();
+
+    const orchestrator = createChatOrchestrator(textProvider('answer with no usage'), promptBuilder, undefined, {
+      hooks,
+    });
+    await orchestrator.processMessage(createSession('hi'));
+
+    expect(get()).toBeUndefined();
+  });
+});
