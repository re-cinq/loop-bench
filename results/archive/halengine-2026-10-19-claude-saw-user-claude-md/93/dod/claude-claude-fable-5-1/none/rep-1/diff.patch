+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import {scriptedProvider} from './chatOrchestratorTestSupport.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const createSession = (content: string): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content, timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const lookupRegistry = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => 'r');
+  return registry;
+};
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+const DONE: MessageChunk = {type: 'text', text: 'done'};
+const stopForTool = (usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason: 'tool_use', usage});
+const stopDone = (usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason: 'end_turn', usage});
+
+async function usageReportedFor(rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> {
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reported = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(scriptedProvider(rounds), promptBuilder, lookupRegistry(), {hooks});
+
+  await orchestrator.processMessage(createSession('ask'));
+
+  return reported;
+}
+
+describe('afterModelResponse usage for a turn that ran tools', () => {
+  it('reports 33 input, 13 output and 46 total tokens when three provider calls report 10/5/15, 20/7/27 and 3/1/4', async () => {
+    const reported = await usageReportedFor([
+      [TOOL_CALL, stopForTool({inputTokens: 10, outputTokens: 5, totalTokens: 15})],
+      [TOOL_CALL, stopForTool({inputTokens: 20, outputTokens: 7, totalTokens: 27})],
+      [DONE, stopDone({inputTokens: 3, outputTokens: 1, totalTokens: 4})],
+    ]);
+
+    expect(reported).toMatchObject({inputTokens: 33, outputTokens: 13, totalTokens: 46});
+  });
+
+  it('reports 15/5/20 when the middle of three calls reports no usage, and nothing when no call reports any', async () => {
+    const [partial, silent] = await Promise.all([
+      usageReportedFor([
+        [TOOL_CALL, stopForTool({inputTokens: 11, outputTokens: 3, totalTokens: 14})],
+        [TOOL_CALL, stopForTool()],
+        [DONE, stopDone({inputTokens: 4, outputTokens: 2, totalTokens: 6})],
+      ]),
+      usageReportedFor([
+        [TOOL_CALL, stopForTool()],
+        [DONE, stopDone()],
+      ]),
+    ]);
+
+    expect({partial, silent}).toMatchObject({
+      partial: {inputTokens: 15, outputTokens: 5, totalTokens: 20},
+      silent: undefined,
+    });
+  });
+});
