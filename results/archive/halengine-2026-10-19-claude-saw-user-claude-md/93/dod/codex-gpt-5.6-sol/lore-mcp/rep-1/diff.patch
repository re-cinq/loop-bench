+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const session = (): ChatSession => ({
+  sessionId: 'usage-acceptance',
+  userId: 'user-1',
+  entries: [{role: 'user', content: 'look this up twice', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const toolCall = (id: string): MessageChunk => ({
+  type: 'tool_use',
+  toolCall: {id, name: 'lookup', input: {query: id}},
+});
+
+const providerFor = (usages: Array<UsageMetadata | undefined>): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const usage = usages[round];
+      if (round < 2) yield toolCall(`call-${round + 1}`);
+      yield {type: 'stop', stopReason: round++ < 2 ? 'tool_use' : 'end_turn', usage};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registry = (): ToolRegistry => {
+  const tools = new ToolRegistry();
+  tools.register(
+    {name: 'lookup', description: 'Looks up a value.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  return tools;
+};
+
+describe('afterModelResponse turn usage', () => {
+  it('sums every reported provider round and reports nothing only when every round omits usage', async () => {
+    const reports: Array<UsageMetadata | undefined> = [];
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, turnUsage) => void reports.push(turnUsage),
+    };
+
+    await createChatOrchestrator(
+      providerFor([
+        {inputTokens: 2, outputTokens: 3, totalTokens: 5},
+        undefined,
+        {inputTokens: 7, outputTokens: 11, totalTokens: 18},
+      ]),
+      promptBuilder,
+      registry(),
+      {hooks}
+    ).processMessage(session());
+    await createChatOrchestrator(providerFor([undefined, undefined, undefined]), promptBuilder, registry(), {
+      hooks,
+    }).processMessage(session());
+
+    expect(reports).toEqual([{inputTokens: 9, outputTokens: 14, totalTokens: 23}, undefined]);
+  });
+});
