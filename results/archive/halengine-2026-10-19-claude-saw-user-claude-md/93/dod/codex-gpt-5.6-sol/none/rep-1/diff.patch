diff --git a/src/orchestration/chatOrchestratorUsage.acceptance.test.ts b/src/orchestration/chatOrchestratorUsage.acceptance.test.ts
new file mode 100644
index 0000000..adf5e70
--- /dev/null
+++ b/src/orchestration/chatOrchestratorUsage.acceptance.test.ts
@@ -0,0 +1,83 @@
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const session = (): ChatSession => ({
+  sessionId: 'usage-acceptance',
+  userId: 'user-1',
+  entries: [{role: 'user', content: 'look this up', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const toolRegistry = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks up a value', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  return registry;
+};
+
+const scriptedProvider = (usages: Array<UsageMetadata | undefined>): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const usage = usages[round];
+      if (round++ < usages.length - 1) {
+        yield {type: 'tool_use', toolCall: {id: `call-${round}`, name: 'lookup', input: {}}};
+        yield {type: 'stop', stopReason: 'tool_use', usage};
+        return;
+      }
+      yield {type: 'text', text: 'done'};
+      yield {type: 'stop', stopReason: 'end_turn', usage};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const reportedUsage = async (usages: Array<UsageMetadata | undefined>): Promise<UsageMetadata | undefined> => {
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reported = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(scriptedProvider(usages), promptBuilder, toolRegistry(), {hooks});
+
+  await orchestrator.processMessage(session());
+
+  return reported;
+};
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports the sum of every provider call in a turn with two tool rounds', async () => {
+    const usage = await reportedUsage([
+      {inputTokens: 10, outputTokens: 2, totalTokens: 12},
+      {inputTokens: 20, outputTokens: 3, totalTokens: 23},
+      {inputTokens: 30, outputTokens: 4, totalTokens: 34},
+    ]);
+
+    expect(usage).toEqual({inputTokens: 60, outputTokens: 9, totalTokens: 69});
+  });
+
+  it('sums the rounds that report usage and reports nothing when none do', async () => {
+    const someUsage = await reportedUsage([
+      {inputTokens: 8, outputTokens: 1, totalTokens: 9},
+      undefined,
+      {inputTokens: 13, outputTokens: 2, totalTokens: 15},
+    ]);
+    const noUsage = await reportedUsage([undefined, undefined]);
+
+    expect({someUsage, noUsage}).toEqual({
+      someUsage: {inputTokens: 21, outputTokens: 3, totalTokens: 24},
+      noUsage: undefined,
+    });
+  });
+});
