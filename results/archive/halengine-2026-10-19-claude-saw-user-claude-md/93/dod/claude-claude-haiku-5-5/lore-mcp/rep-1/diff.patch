@@ -0,0 +1,87 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'Usage test.'});
+
+const usage = (inputTokens: number, outputTokens: number): UsageMetadata => ({
+  inputTokens,
+  outputTokens,
+  totalTokens: inputTokens + outputTokens,
+});
+
+const toolRound = (reported?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id: 'call', name: 'lookup', input: {}}},
+  {type: 'stop', stopReason: 'tool_use', usage: reported},
+];
+
+const finalRound = (reported?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'done'},
+  {type: 'stop', stopReason: 'end_turn', usage: reported},
+];
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let call = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield* rounds[call++] ?? [];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const lookupRegistry = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => 'r');
+  return registry;
+};
+
+// Runs one turn over the scripted rounds and returns what afterModelResponse was handed.
+const turnUsageOf = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, turnUsage) => {
+      reported = turnUsage;
+    },
+  };
+  const session: ChatSession = {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'ask', timestamp: SENT_AT}],
+  };
+
+  await createChatOrchestrator(scriptedProvider(rounds), promptBuilder, lookupRegistry(), {hooks}).processMessage(
+    session
+  );
+  return reported;
+};
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('returns the summed usage of three provider calls across two tool rounds', async () => {
+    const reported = await turnUsageOf([
+      toolRound(usage(100, 20)),
+      toolRound(usage(300, 40)),
+      finalRound(usage(500, 60)),
+    ]);
+
+    expect(reported).toEqual({inputTokens: 900, outputTokens: 120, totalTokens: 1020});
+  });
+
+  it('skips a round that reports no usage, and reports nothing when no round reports any', async () => {
+    const withSilentRound = await turnUsageOf([toolRound(usage(100, 20)), toolRound(), finalRound(usage(50, 5))]);
+    const allSilent = await turnUsageOf([toolRound(), finalRound()]);
+
+    expect({withSilentRound, allSilent}).toEqual({
+      withSilentRound: {inputTokens: 150, outputTokens: 25, totalTokens: 175},
+      allSilent: undefined,
+    });
+  });
+});