 export function extractUsage(chunk: MessageChunk): UsageMetadata | undefined {
   return chunk.type === 'stop' ? chunk.usage : undefined;
 }
+
+export function accumulateUsage(
+  accumulated: UsageMetadata | undefined,
+  incoming: UsageMetadata | undefined
+): UsageMetadata | undefined {
+  if (!accumulated) return incoming;
+  if (!incoming) return accumulated;
+  return {
+    inputTokens: accumulated.inputTokens + incoming.inputTokens,
+    outputTokens: accumulated.outputTokens + incoming.outputTokens,
+    totalTokens: accumulated.totalTokens + incoming.totalTokens,
+  };
+}