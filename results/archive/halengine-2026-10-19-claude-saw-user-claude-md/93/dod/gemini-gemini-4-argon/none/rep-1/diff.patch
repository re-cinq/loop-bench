@@ -0,0 +1,112 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolResponse} from './tools/registry.js';
+import {scriptedProvider} from './chatOrchestrator.test-helpers.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+const STOP_DONE: MessageChunk = {type: 'stop', stopReason: 'end_turn'};
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function registryReturning(response: ToolResponse): ToolRegistry {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => response
+  );
+  return registry;
+}
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('sums usage across every provider call when a turn runs two tool rounds', async () => {
+    const round1: UsageMetadata = {inputTokens: 100, outputTokens: 20, totalTokens: 120};
+    const round2: UsageMetadata = {inputTokens: 250, outputTokens: 35, totalTokens: 285};
+    const round3: UsageMetadata = {inputTokens: 400, outputTokens: 50, totalTokens: 450};
+    let reportedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        reportedUsage = usage;
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: round1}],
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: round2}],
+        [
+          {type: 'text', text: 'final answer'},
+          {type: 'stop', stopReason: 'end_turn', usage: round3},
+        ],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'found'}),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(reportedUsage).toEqual({inputTokens: 750, outputTokens: 105, totalTokens: 855});
+  });
+
+  it('sums the rounds that reported usage when another round in the turn omits it, and reports undefined when no round reported', async () => {
+    const round1: UsageMetadata = {inputTokens: 80, outputTokens: 15, totalTokens: 95};
+    const round3: UsageMetadata = {inputTokens: 120, outputTokens: 25, totalTokens: 145};
+    let partialTurnUsage: UsageMetadata | undefined;
+    let emptyTurnUsage: UsageMetadata | undefined = {inputTokens: -1, outputTokens: -1, totalTokens: -1};
+
+    await createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: round1}],
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn', usage: round3},
+        ],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'found'}),
+      {
+        hooks: {
+          afterModelResponse: async (_session, _text, usage) => {
+            partialTurnUsage = usage;
+          },
+        },
+      }
+    ).processMessage(createSession('ask'));
+
+    await createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+        [{type: 'text', text: 'done'}, STOP_DONE],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'found'}),
+      {
+        hooks: {
+          afterModelResponse: async (_session, _text, usage) => {
+            emptyTurnUsage = usage;
+          },
+        },
+      }
+    ).processMessage(createSession('ask'));
+
+    expect({partialTurnUsage, emptyTurnUsage}).toEqual({
+      partialTurnUsage: {inputTokens: 200, outputTokens: 40, totalTokens: 240},
+      emptyTurnUsage: undefined,
+    });
+  });
+});
