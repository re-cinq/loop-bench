@@ -0,0 +1,66 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const REQUEST_LOOKUP: MessageChunk = {type: 'tool_use', toolCall: {id: 'tc-1', name: 'lookup', input: {}}};
+
+const turnUsage = async (roundUsages: Array<UsageMetadata | undefined>): Promise<UsageMetadata | undefined> => {
+  let callIndex = 0;
+  let reportedUsage: UsageMetadata | undefined;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const index = callIndex++;
+      const usage = roundUsages[index];
+      const isFinalRound = index === roundUsages.length - 1;
+      yield isFinalRound ? {type: 'text', text: 'complete'} : REQUEST_LOOKUP;
+      yield {type: 'stop', stopReason: isFinalRound ? 'end_turn' : 'tool_use', usage};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'Lookup tool', inputSchema: {type: 'object'}}, async () => 'ok');
+  const session: ChatSession = {
+    sessionId: 'usage-session',
+    userId: 'usage-user',
+    entries: [{role: 'user', content: 'run', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Usage test.'}), registry, {
+    hooks: {
+      afterModelResponse: async (_session, _text, totalUsage) => {
+        reportedUsage = totalUsage;
+      },
+    },
+  });
+  await orchestrator.processMessage(session);
+  return reportedUsage;
+};
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('sums the usage of every round across two tool rounds, not only the last', async () => {
+    const reported = await turnUsage([
+      {inputTokens: 10, outputTokens: 4, totalTokens: 14},
+      {inputTokens: 25, outputTokens: 6, totalTokens: 31},
+      {inputTokens: 40, outputTokens: 12, totalTokens: 52},
+    ]);
+
+    expect(reported).toEqual({inputTokens: 75, outputTokens: 22, totalTokens: 97});
+  });
+
+  it('counts every reporting round when a round between them reports none, and reports undefined when no round reports usage', async () => {
+    const withUnreportedMiddleRound = await turnUsage([
+      {inputTokens: 10, outputTokens: 4, totalTokens: 14},
+      undefined,
+      {inputTokens: 40, outputTokens: 12, totalTokens: 52},
+    ]);
+    const withNoReportedUsage = await turnUsage([undefined, undefined]);
+
+    expect({withUnreportedMiddleRound, withNoReportedUsage}).toEqual({
+      withUnreportedMiddleRound: {inputTokens: 50, outputTokens: 16, totalTokens: 66},
+      withNoReportedUsage: undefined,
+    });
+  });
+});
