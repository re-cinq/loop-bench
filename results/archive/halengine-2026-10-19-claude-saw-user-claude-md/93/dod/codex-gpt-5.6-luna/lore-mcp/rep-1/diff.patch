@@ -0,0 +1,99 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// spec: specs/hal-engine-config-hooks#9
+
+const promptBuilder = new PromptBuilder({identity: 'Acceptance test assistant.'});
+const session = (): ChatSession => ({
+  sessionId: 'usage-acceptance',
+  userId: 'user-1',
+  entries: [{role: 'user', content: 'find the answer', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const toolCall = (id: string): MessageChunk => ({
+  type: 'tool_use',
+  toolCall: {id, name: 'lookup', input: {}},
+});
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let call = 0;
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      yield* rounds[call++] ?? [];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const usage = (inputTokens: number, outputTokens: number): UsageMetadata => ({
+  inputTokens,
+  outputTokens,
+  totalTokens: inputTokens + outputTokens,
+});
+
+const registry = (): ToolRegistry => {
+  const tools = new ToolRegistry();
+  tools.register(
+    {name: 'lookup', description: 'Looks something up.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  return tools;
+};
+
+describe('afterModelResponse usage reporting', () => {
+  const round1: MessageChunk[] = [toolCall('call-1'), {type: 'stop', stopReason: 'tool_use', usage: usage(10, 1)}];
+  const answerRound: MessageChunk[] = [
+    {type: 'text', text: 'answer'},
+    {type: 'stop', stopReason: 'end_turn', usage: usage(30, 3)},
+  ];
+
+  it('reports usage from every provider call across two tool rounds', async () => {
+    let receivedUsage: UsageMetadata | undefined;
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        round1,
+        [toolCall('call-2'), {type: 'stop', stopReason: 'tool_use', usage: usage(20, 2)}],
+        answerRound,
+      ]),
+      promptBuilder,
+      registry(),
+      {hooks: {afterModelResponse: async (_session, _text, currentUsage) => void (receivedUsage = currentUsage)}}
+    );
+
+    await orchestrator.processMessage(session());
+
+    expect(receivedUsage).toEqual(usage(60, 6));
+  });
+
+  it('sums reported rounds while leaving a turn with no reported usage undefined', async () => {
+    let partialUsage: UsageMetadata | undefined;
+    const partial = createChatOrchestrator(
+      scriptedProvider([round1, [toolCall('call-2'), {type: 'stop', stopReason: 'tool_use'}], answerRound]),
+      promptBuilder,
+      registry(),
+      {hooks: {afterModelResponse: async (_session, _text, currentUsage) => void (partialUsage = currentUsage)}}
+    );
+    await partial.processMessage(session());
+
+    let noUsage: UsageMetadata | undefined = usage(1, 1);
+    const absent = createChatOrchestrator(
+      scriptedProvider([
+        [
+          {type: 'text', text: 'answer'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ],
+      ]),
+      promptBuilder,
+      undefined,
+      {hooks: {afterModelResponse: async (_session, _text, currentUsage) => void (noUsage = currentUsage)}}
+    );
+    await absent.processMessage(session());
+
+    expect({partialUsage, noUsage}).toEqual({partialUsage: usage(40, 4), noUsage: undefined});
+  });
+});