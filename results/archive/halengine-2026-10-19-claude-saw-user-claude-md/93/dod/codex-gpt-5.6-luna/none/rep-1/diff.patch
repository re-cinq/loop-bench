+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {scriptedProvider, registryReturning} from './orchestratorTestSupport.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+
+async function usageFrom(rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> {
+  let received: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      received = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(
+    scriptedProvider(rounds),
+    promptBuilder,
+    registryReturning({result: 'found it'}),
+    {hooks}
+  );
+
+  await orchestrator.processMessage(createSession());
+  return received;
+}
+
+function createSession(): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'ask', timestamp: SENT_AT}],
+  };
+}
+
+describe('afterModelResponse usage across provider rounds', () => {
+  it('reports the sum of usage from every provider call in a tool turn', async () => {
+    const firstRound: UsageMetadata = {inputTokens: 10, outputTokens: 2, totalTokens: 12};
+    const secondRound: UsageMetadata = {inputTokens: 20, outputTokens: 3, totalTokens: 23};
+
+    await expect(
+      usageFrom([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: firstRound}],
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn', usage: secondRound},
+        ],
+      ])
+    ).resolves.toEqual({inputTokens: 30, outputTokens: 5, totalTokens: 35});
+  });
+
+  it('counts reported rounds without producing undefined or NaN when usage is missing', async () => {
+    const firstRound: UsageMetadata = {inputTokens: 7, outputTokens: 1, totalTokens: 8};
+    const thirdRound: UsageMetadata = {inputTokens: 13, outputTokens: 4, totalTokens: 17};
+
+    await expect(
+      usageFrom([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: firstRound}],
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn', usage: thirdRound},
+        ],
+      ])
+    ).resolves.toEqual({inputTokens: 20, outputTokens: 5, totalTokens: 25});
+  });
+
+  it('reports undefined when no round reports usage', async () => {
+    await expect(
+      usageFrom([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ],
+      ])
+    ).resolves.toBeUndefined();
+  });
+});