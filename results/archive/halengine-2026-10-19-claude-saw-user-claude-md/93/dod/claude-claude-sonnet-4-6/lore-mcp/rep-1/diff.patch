+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import {scriptedProvider} from './scriptedProviderTestSupport.js';
+
+// specs/hal-engine-config-hooks/spec.md#usage-accumulation
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {sessionId: 's1', userId: 'u1', entries: [{role: 'user', content, timestamp: SENT_AT}]};
+}
+
+const registryWithLookup = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found',
+  }));
+  return registry;
+};
+
+const promptBuilder = new PromptBuilder({identity: 'Test.'});
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {}}};
+const STOP_FOR_TOOL: MessageChunk = {type: 'stop', stopReason: 'tool_use'};
+
+describe('afterModelResponse usage accumulation across tool rounds', () => {
+  it('two-round turn reports sum of both rounds usage to afterModelResponse', async () => {
+    const round1Usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const round2Usage: UsageMetadata = {inputTokens: 20, outputTokens: 8, totalTokens: 28};
+    let reportedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        reportedUsage = usage;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: round1Usage}],
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn', usage: round2Usage},
+        ],
+      ]),
+      promptBuilder,
+      registryWithLookup(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(reportedUsage).toEqual({inputTokens: 30, outputTokens: 13, totalTokens: 43});
+  });
+
+  it('a round with no usage does not drop reported rounds from the total', async () => {
+    const round1Usage: UsageMetadata = {inputTokens: 3, outputTokens: 1, totalTokens: 4};
+    const round3Usage: UsageMetadata = {inputTokens: 7, outputTokens: 2, totalTokens: 9};
+    let reportedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        reportedUsage = usage;
+      },
+    };
+
+    const toolCall2: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-2', name: 'lookup', input: {}}};
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: round1Usage}],
+        [toolCall2, STOP_FOR_TOOL],
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn', usage: round3Usage},
+        ],
+      ]),
+      promptBuilder,
+      registryWithLookup(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(reportedUsage).toEqual({inputTokens: 10, outputTokens: 3, totalTokens: 13});
+  });
+});
