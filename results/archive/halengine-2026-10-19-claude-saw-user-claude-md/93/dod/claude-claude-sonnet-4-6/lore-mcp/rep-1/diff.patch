+describe('accumulateUsage', () => {
+  it('sums token counts when both total and round have usage', () => {
+    const total: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const round: UsageMetadata = {inputTokens: 20, outputTokens: 8, totalTokens: 28};
+    expect(accumulateUsage(total, round)).toEqual({inputTokens: 30, outputTokens: 13, totalTokens: 43});
