@@ -40,3 +40,17 @@ export function extractStopReason(chunk: MessageChunk): string | null {
 export function extractUsage(chunk: MessageChunk): UsageMetadata | undefined {
   return chunk.type === 'stop' ? chunk.usage : undefined;
 }
+
+export function accumulateUsage(
+  total: UsageMetadata | undefined,
+  round: UsageMetadata | undefined
+): UsageMetadata | undefined {
+  if (total === undefined && round === undefined) return undefined;
+  if (round === undefined) return total;
+  if (total === undefined) return round;
+  return {
+    inputTokens: total.inputTokens + round.inputTokens,
+    outputTokens: total.outputTokens + round.outputTokens,
+    totalTokens: total.totalTokens + round.totalTokens,
+  };
+}
