+
+  it('returns the accumulator when the next value is absent', () => {
+    expect(accumulateUsage(a, undefined)).toEqual(a);
+  });
+
+  it('returns the field-wise sum of two defined values', () => {
+    expect(accumulateUsage(a, b)).toEqual({inputTokens: 34, outputTokens: 7, totalTokens: 41});
+  });
+
+  it('does not mutate the accumulator input', () => {
+    const aCopy = {...a};
+    accumulateUsage(a, b);
+    expect(a).toEqual(aCopy);
+  });
+
+  it('does not mutate the next-value input', () => {
+    const bCopy = {...b};
+    accumulateUsage(a, b);
+    expect(b).toEqual(bCopy);
+  });
+});
+
 describe('shouldContinueToolLoop', () => {
