+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+// Spec: specs/hal-engine-config-hooks/spec.md#9
+it('reports the sum of every provider call once per turn, preserving missing usage and direct answers', async () => {
+  const first = {inputTokens: 11, outputTokens: 2, totalTokens: 13};
+  const second = {inputTokens: 23, outputTokens: 5, totalTokens: 28};
+  const third = {inputTokens: 37, outputTokens: 7, totalTokens: 44};
+  const cases: {name: string; rounds: (UsageMetadata | undefined)[]; expected?: UsageMetadata}[] = [
+    {
+      name: 'two tool rounds',
+      rounds: [first, second, third],
+      expected: {inputTokens: 71, outputTokens: 14, totalTokens: 85},
+    },
+    {
+      name: 'missing middle',
+      rounds: [first, undefined, third],
+      expected: {inputTokens: 48, outputTokens: 9, totalTokens: 57},
+    },
+    {
+      name: 'missing first',
+      rounds: [undefined, second, third],
+      expected: {inputTokens: 60, outputTokens: 12, totalTokens: 72},
+    },
+    {
+      name: 'missing last',
+      rounds: [first, second, undefined],
+      expected: {inputTokens: 34, outputTokens: 7, totalTokens: 41},
+    },
+    {name: 'all missing', rounds: [undefined, undefined, undefined]},
+    {name: 'direct answer', rounds: [first], expected: first},
+    {name: 'direct answer without usage', rounds: [undefined]},
+  ];
+  const observed = [];
+  for (const scenario of cases) {
+    let providerCalls = 0;
+    let toolCalls = 0;
+    const reports: (UsageMetadata | undefined)[] = [];
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        const round = providerCalls++;
+        if (round >= scenario.rounds.length) throw new Error('Unexpected provider call');
+        const needsTool = round < scenario.rounds.length - 1;
+        if (needsTool) {
+          yield {type: 'tool_use', toolCall: {id: `lookup-${round}`, name: 'lookup', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use', usage: scenario.rounds[round]};
+          return;
+        }
+        yield {type: 'text', text: 'done'};
+        yield {type: 'stop', stopReason: 'end_turn', usage: scenario.rounds[round]};
+      },
+      async generateStructured<T>(): Promise<T> {
+        throw new Error('Structured output is not part of this conversation');
+      },
+    };
+    const registry = new ToolRegistry();
+    registry.register(
+      {name: 'lookup', description: 'Return a known value', inputSchema: {type: 'object'}},
+      async () => {
+        toolCalls++;
+        return {result: 'found'};
+      }
+    );
+    const orchestrator = createChatOrchestrator(
+      provider,
+      new PromptBuilder({identity: 'Answer questions.'}),
+      registry,
+      {
+        hooks: {
+          afterModelResponse: async (_session, _text, usage) => {
+            reports.push(usage);
+          },
+        },
+      }
+    );
+    const session: ChatSession = {
+      sessionId: scenario.name,
+      userId: 'customer',
+      entries: [{role: 'user', content: 'Look this up', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const text = await orchestrator.processMessage(session);
+    observed.push({name: scenario.name, text, providerCalls, toolCalls, reports});
+  }
+
+  expect(observed).toEqual(
+    cases.map(scenario => ({
+      name: scenario.name,
+      text: 'done',
+      providerCalls: scenario.rounds.length,
+      toolCalls: scenario.rounds.length - 1,
+      reports: [scenario.expected],
+    }))
+  );
+});
