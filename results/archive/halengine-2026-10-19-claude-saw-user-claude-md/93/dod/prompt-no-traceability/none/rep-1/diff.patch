 export function extractUsage(chunk: MessageChunk): UsageMetadata | undefined {
   return chunk.type === 'stop' ? chunk.usage : undefined;
 }
+
+export function computeTurnUsage(roundUsages: (UsageMetadata | undefined)[]): TurnUsage | undefined {
+  const reported = roundUsages.filter((u): u is UsageMetadata => u !== undefined);
+  if (reported.length === 0) return undefined;
+  if (reported.length === 1) return reported[0];
+  return {
+    inputTokens: reported.reduce((sum, u) => sum + u.inputTokens, 0),
+    outputTokens: reported.reduce((sum, u) => sum + u.outputTokens, 0),
+    totalTokens: reported.reduce((sum, u) => sum + u.totalTokens, 0),
+    rounds: reported,
+  };
+}
