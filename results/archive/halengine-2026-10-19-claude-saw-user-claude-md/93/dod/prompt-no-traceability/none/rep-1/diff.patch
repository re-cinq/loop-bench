diff --git a/src/orchestration/usage.acceptance.test.ts b/src/orchestration/usage.acceptance.test.ts
new file mode 100644
index 0000000..f2338b1
--- /dev/null
+++ b/src/orchestration/usage.acceptance.test.ts
@@ -0,0 +1,92 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {MessageChunk, TurnUsage, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import {scriptedProvider} from './testHelpers.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const registryReturning = (result: string): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+    result,
+  }));
+  return registry;
+};
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+const STOP_FOR_TOOL = (usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason: 'tool_use', usage});
+const STOP_DONE = (usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason: 'end_turn', usage});
+
+async function runWithUsageCapture(rounds: MessageChunk[][]): Promise<TurnUsage | undefined> {
+  let captured: TurnUsage | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      captured = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(scriptedProvider(rounds), promptBuilder, registryReturning('found it'), {
+    hooks,
+  });
+  await orchestrator.processMessage(createSession('ask'));
+  return captured;
+}
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+describe('ChatOrchestrator usage reporting', () => {
+  it('reports usage covering every provider call in a turn with multiple tool rounds', async () => {
+    const usage = await runWithUsageCapture([
+      [TOOL_CALL, STOP_FOR_TOOL({inputTokens: 10, outputTokens: 5, totalTokens: 15})],
+      [TOOL_CALL, STOP_FOR_TOOL({inputTokens: 20, outputTokens: 10, totalTokens: 30})],
+      [{type: 'text', text: 'done'}, STOP_DONE({inputTokens: 5, outputTokens: 5, totalTokens: 10})],
+    ]);
+
+    expect(usage).toMatchObject({
+      inputTokens: 35,
+      outputTokens: 20,
+      totalTokens: 55,
+      rounds: [
+        {inputTokens: 10, outputTokens: 5, totalTokens: 15},
+        {inputTokens: 20, outputTokens: 10, totalTokens: 30},
+        {inputTokens: 5, outputTokens: 5, totalTokens: 10},
+      ],
+    });
+  });
+
+  it('keeps counting rounds that reported usage even if some rounds report none', async () => {
+    const usage = await runWithUsageCapture([
+      [TOOL_CALL, STOP_FOR_TOOL({inputTokens: 10, outputTokens: 5, totalTokens: 15})],
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+      [{type: 'text', text: 'done'}, STOP_DONE({inputTokens: 20, outputTokens: 10, totalTokens: 30})],
+    ]);
+
+    expect(usage).toMatchObject({
+      inputTokens: 30,
+      outputTokens: 15,
+      totalTokens: 45,
+    });
+  });
+
+  it('reports undefined if no rounds reported usage at all', async () => {
+    const usage = await runWithUsageCapture([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ]);
+
+    expect(usage).toBeUndefined();
+  });
+});
