@@ -0,0 +1,94 @@
+import type {ChatSession} from '../types/session.js';
+import type {UsageMetadata} from '../types/ai.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {scriptedProvider, registryReturning, TOOL_CALL} from './orchestratorTestSupport.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function captureUsage(): {get: () => UsageMetadata | undefined; hooks: OrchestratorHooks} {
+  let captured: UsageMetadata | undefined;
+  return {
+    get: () => captured,
+    hooks: {
+      afterModelResponse: async (_session, _text, usage) => {
+        captured = usage;
+      },
+    },
+  };
+}
+
+const ROUND_1 = {
+  type: 'stop' as const,
+  stopReason: 'tool_use' as const,
+  usage: {inputTokens: 10, outputTokens: 5, totalTokens: 15},
+};
+
+describe('afterModelResponse hook usage reporting', () => {
+  const promptBuilder = new PromptBuilder({identity: 'test system prompt'});
+
+  it('A turn driven through two tool rounds reports usage covering every provider call in that turn', async () => {
+    const {get, hooks} = captureUsage();
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, ROUND_1],
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 20, outputTokens: 8, totalTokens: 28}}],
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 40, outputTokens: 2, totalTokens: 42}},
+        ],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'r'}),
+      {hooks}
+    );
+    await orchestrator.processMessage(createSession('ask'));
+    expect(get()).toEqual({inputTokens: 70, outputTokens: 15, totalTokens: 85});
+  });
+
+  it('A provider that reports no usage on some rounds does not make the total undefined or NaN: the rounds that reported are still counted', async () => {
+    const {get, hooks} = captureUsage();
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, ROUND_1],
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 20, outputTokens: 2, totalTokens: 22}},
+        ],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'r'}),
+      {hooks}
+    );
+    await orchestrator.processMessage(createSession('ask'));
+    expect(get()).toEqual({inputTokens: 30, outputTokens: 7, totalTokens: 37});
+  });
+
+  it('a turn where nothing reported still reports nothing', async () => {
+    const {get, hooks} = captureUsage();
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'r'}),
+      {hooks}
+    );
+    await orchestrator.processMessage(createSession('ask'));
+    expect(get()).toBeUndefined();
+  });
+});
