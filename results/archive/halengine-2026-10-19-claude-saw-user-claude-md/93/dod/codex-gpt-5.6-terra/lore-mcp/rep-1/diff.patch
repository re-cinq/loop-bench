index 717eb9a..47d19ce 100644
--- a/src/orchestration/orchestratorHelpers.ts
+++ b/src/orchestration/orchestratorHelpers.ts
@@ -40,3 +40,16 @@ export function extractStopReason(chunk: MessageChunk): string | null {
 export function extractUsage(chunk: MessageChunk): UsageMetadata | undefined {
   return chunk.type === 'stop' ? chunk.usage : undefined;
 }
+
+export function accumulateUsage(
+  accumulated: UsageMetadata | undefined,
+  next: UsageMetadata | undefined
+): UsageMetadata | undefined {
+  if (accumulated === undefined) return next;
+  if (next === undefined) return accumulated;
+  return {
+    inputTokens: accumulated.inputTokens + next.inputTokens,
+    outputTokens: accumulated.outputTokens + next.outputTokens,
+    totalTokens: accumulated.totalTokens + next.totalTokens,
+  };
+}
