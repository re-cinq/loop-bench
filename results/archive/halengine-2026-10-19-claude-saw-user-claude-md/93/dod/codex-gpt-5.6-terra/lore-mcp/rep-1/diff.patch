@@ -0,0 +1,103 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const TOOL_CALL = (id: string): MessageChunk => ({
+  type: 'tool_use',
+  toolCall: {id, name: 'lookup', input: {}},
+});
+
+const scriptProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield* rounds[round++] ?? [];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const toolRegistry = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Looks up a value.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  return registry;
+};
+
+const session = (): ChatSession => ({
+  sessionId: 'session',
+  userId: 'user',
+  entries: [{role: 'user', content: 'look it up', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const FIRST_TOOL_ROUND: MessageChunk[] = [
+  TOOL_CALL('first'),
+  {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 11, outputTokens: 2, totalTokens: 13}},
+];
+
+const reportUsage = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reported = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(
+    scriptProvider(rounds),
+    new PromptBuilder({identity: 'Usage acceptance test.'}),
+    toolRegistry(),
+    {hooks}
+  );
+
+  await orchestrator.processMessage(session());
+  return reported;
+};
+
+describe('afterModelResponse tool-round usage', () => {
+  it('reports the summed usage of every provider call across two tool rounds', async () => {
+    const reported = await reportUsage([
+      FIRST_TOOL_ROUND,
+      [
+        TOOL_CALL('second'),
+        {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 17, outputTokens: 5, totalTokens: 22}},
+      ],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 23, outputTokens: 7, totalTokens: 30}},
+      ],
+    ]);
+
+    expect(reported).toEqual({inputTokens: 51, outputTokens: 14, totalTokens: 65});
+  });
+
+  it('counts reported rounds while leaving a turn with no reported usage undefined', async () => {
+    const partiallyReported = await reportUsage([
+      FIRST_TOOL_ROUND,
+      [TOOL_CALL('second'), {type: 'stop', stopReason: 'tool_use'}],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 23, outputTokens: 7, totalTokens: 30}},
+      ],
+    ]);
+    const noneReported = await reportUsage([
+      [TOOL_CALL('third'), {type: 'stop', stopReason: 'tool_use'}],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ]);
+
+    expect({partiallyReported, noneReported}).toEqual({
+      partiallyReported: {inputTokens: 34, outputTokens: 9, totalTokens: 43},
+      noneReported: undefined,
+    });
+  });
+});