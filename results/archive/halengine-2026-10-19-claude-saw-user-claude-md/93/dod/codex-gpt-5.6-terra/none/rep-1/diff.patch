@@ -0,0 +1,105 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const session = (): ChatSession => ({
+  sessionId: 'usage-session',
+  userId: 'usage-user',
+  entries: [{role: 'user', content: 'Find the answer.', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const tools = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Looks up a fact.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  return registry;
+};
+
+const toolCall = (id: string): MessageChunk => ({
+  type: 'tool_use',
+  toolCall: {id, name: 'lookup', input: {}},
+});
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let nextRound = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[nextRound++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const usageFrom = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let received: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      received = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(
+    scriptedProvider(rounds),
+    new PromptBuilder({identity: 'Usage test assistant.'}),
+    tools(),
+    {hooks}
+  );
+
+  await orchestrator.processMessage(session());
+  return received;
+};
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports the summed usage of every provider call in a turn with two tool rounds', async () => {
+    const reported = await usageFrom([
+      [
+        toolCall('first'),
+        {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 3, outputTokens: 5, totalTokens: 8}},
+      ],
+      [
+        toolCall('second'),
+        {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 7, outputTokens: 11, totalTokens: 18}},
+      ],
+      [
+        {type: 'text', text: 'Done.'},
+        {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 13, outputTokens: 17, totalTokens: 30}},
+      ],
+    ]);
+
+    expect(reported).toEqual({inputTokens: 23, outputTokens: 33, totalTokens: 56});
+  });
+
+  it('counts reported rounds while preserving no-usage turns as undefined', async () => {
+    const [partiallyReported, unreported] = await Promise.all([
+      usageFrom([
+        [
+          toolCall('first'),
+          {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 2, outputTokens: 3, totalTokens: 5}},
+        ],
+        [toolCall('second'), {type: 'stop', stopReason: 'tool_use'}],
+        [
+          {type: 'text', text: 'Done.'},
+          {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 7, outputTokens: 11, totalTokens: 18}},
+        ],
+      ]),
+      usageFrom([
+        [
+          {type: 'text', text: 'No usage.'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ],
+      ]),
+    ]);
+
+    expect({partiallyReported, unreported}).toEqual({
+      partiallyReported: {inputTokens: 9, outputTokens: 14, totalTokens: 23},
+      unreported: undefined,
+    });
+  });
+});
