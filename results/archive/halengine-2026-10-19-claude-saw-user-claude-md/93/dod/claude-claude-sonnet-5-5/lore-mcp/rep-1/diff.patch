 export function extractUsage(chunk: MessageChunk): UsageMetadata | undefined {
   return chunk.type === 'stop' ? chunk.usage : undefined;
 }
+
+export function accumulateUsage(
+  total: UsageMetadata | undefined,
+  round: UsageMetadata | undefined
+): UsageMetadata | undefined {
+  if (!round) return total;
+  if (!total) return round;
+  return {
+    inputTokens: total.inputTokens + round.inputTokens,
+    outputTokens: total.outputTokens + round.outputTokens,
+    totalTokens: total.totalTokens + round.totalTokens,
+  };
+}
diff --git a/src/orchestration/usageAcrossRounds.acceptance.test.ts b/src/orchestration/usageAcrossRounds.acceptance.test.ts
new file mode 100644
index 0000000..8f410a4
--- /dev/null
+++ b/src/orchestration/usageAcrossRounds.acceptance.test.ts
@@ -0,0 +1,86 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const usageOf = (inputTokens: number, outputTokens: number): UsageMetadata => ({
+  inputTokens,
+  outputTokens,
+  totalTokens: inputTokens + outputTokens,
+});
+
+const toolRound = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}},
+  {type: 'stop', stopReason: 'tool_use', usage},
+];
+
+const finalRound = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'done'},
+  {type: 'stop', stopReason: 'end_turn', usage},
+];
+
+// Replays one scripted round per provider call.
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let call = 0;
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      yield* rounds[call++];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registry = (): ToolRegistry => {
+  const tools = new ToolRegistry();
+  tools.register(
+    {name: 'lookup', description: 'look something up', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  return tools;
+};
+
+const usageHandedToHook = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reported = usage;
+    },
+  };
+  const session: ChatSession = {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'ask', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+
+  await createChatOrchestrator(scriptedProvider(rounds), promptBuilder, registry(), {hooks}).processMessage(session);
+
+  return reported;
+};
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('hands the hook the sum of three provider calls reporting 10+2, 20+5 and 40+7 tokens', async () => {
+    const reported = await usageHandedToHook([
+      toolRound(usageOf(10, 2)),
+      toolRound(usageOf(20, 5)),
+      finalRound(usageOf(40, 7)),
+    ]);
+
+    expect(reported).toEqual({inputTokens: 70, outputTokens: 14, totalTokens: 84});
+  });
+
+  it('sums only the rounds that reported when the middle round reports none', async () => {
+    const reported = await usageHandedToHook([
+      toolRound(usageOf(10, 2)),
+      toolRound(undefined),
+      finalRound(usageOf(40, 7)),
+    ]);
+
+    expect(reported).toEqual({inputTokens: 50, outputTokens: 9, totalTokens: 59});
+  });
+});