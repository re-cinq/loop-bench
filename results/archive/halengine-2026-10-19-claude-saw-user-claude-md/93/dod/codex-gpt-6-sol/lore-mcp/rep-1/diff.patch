@@ -0,0 +1,85 @@
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const session = (): ChatSession => ({
+  sessionId: 'usage-acceptance',
+  userId: 'user',
+  entries: [{role: 'user', content: 'Look this up', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const providerFor = (rounds: MessageChunk[][]): AIProvider => {
+  let nextRound = 0;
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const chunks = rounds[nextRound++];
+      if (!chunks) throw new Error(`Unexpected provider call ${nextRound}`);
+      for (const chunk of chunks) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+function toolRound(usage?: UsageMetadata): MessageChunk[] {
+  return [
+    {type: 'tool_use', toolCall: {id: 'lookup-call', name: 'lookup', input: {key: 'answer'}}},
+    {type: 'stop', stopReason: 'tool_use', usage},
+  ];
+}
+
+function finalRound(usage?: UsageMetadata): MessageChunk[] {
+  return [
+    {type: 'text', text: 'Found it'},
+    {type: 'stop', stopReason: 'end_turn', usage},
+  ];
+}
+
+async function reportedUsage(rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'Looks up a value', inputSchema: {type: 'object'}}, async () => '42');
+  let seen: UsageMetadata | undefined;
+  const orchestrator = createChatOrchestrator(providerFor(rounds), promptBuilder, registry, {
+    hooks: {
+      afterModelResponse: async (_session, _text, usage) => {
+        seen = usage;
+      },
+    },
+  });
+
+  await orchestrator.processMessage(session());
+  return seen;
+}
+
+describe('afterModelResponse turn usage', () => {
+  // specs/hal-engine-config-hooks/spec.md#9
+  it('sums the usage of every provider call across two tool rounds', async () => {
+    const reported = await reportedUsage([
+      toolRound({inputTokens: 11, outputTokens: 2, totalTokens: 13}),
+      toolRound({inputTokens: 23, outputTokens: 5, totalTokens: 28}),
+      finalRound({inputTokens: 7, outputTokens: 3, totalTokens: 10}),
+    ]);
+
+    expect(reported).toEqual({inputTokens: 41, outputTokens: 10, totalTokens: 51});
+  });
+
+  // specs/hal-engine-config-hooks/spec.md#10
+  it('sums reported rounds across a missing round and leaves an entirely unreported turn undefined', async () => {
+    const partial = await reportedUsage([
+      toolRound({inputTokens: 11, outputTokens: 2, totalTokens: 13}),
+      toolRound(),
+      finalRound({inputTokens: 7, outputTokens: 3, totalTokens: 10}),
+    ]);
+    const absent = await reportedUsage([toolRound(), toolRound(), finalRound()]);
+
+    expect({partial, absent}).toEqual({
+      partial: {inputTokens: 18, outputTokens: 5, totalTokens: 23},
+      absent: undefined,
+    });
+  });
+});
