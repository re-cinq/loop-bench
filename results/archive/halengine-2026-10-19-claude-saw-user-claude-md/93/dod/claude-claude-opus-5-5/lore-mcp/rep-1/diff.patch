@@ -0,0 +1,72 @@
+import {createChatOrchestrator, scriptedProvider} from './chatOrchestrator.js';
+import type {MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+
+const lookupRegistry = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+    result: 'r',
+  }));
+  return registry;
+};
+
+// Two tool rounds, so three provider calls; a round given no usage reports none, as some providers do.
+const twoToolRoundTurn = (
+  first: UsageMetadata | undefined,
+  second: UsageMetadata | undefined,
+  last: UsageMetadata | undefined
+): MessageChunk[][] => [
+  [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: first}],
+  [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: second}],
+  [
+    {type: 'text', text: 'done'},
+    {type: 'stop', stopReason: 'end_turn', usage: last},
+  ],
+];
+
+const usageReportedFor = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let reported: UsageMetadata | undefined;
+  const orchestrator = createChatOrchestrator(scriptedProvider(rounds), promptBuilder, lookupRegistry(), {
+    hooks: {
+      afterModelResponse: async (_session, _text, usage) => {
+        reported = usage;
+      },
+    },
+  });
+  const session: ChatSession = {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'ask', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+
+  await orchestrator.processMessage(session);
+  return reported;
+};
+
+const QUESTION_ROUND: UsageMetadata = {inputTokens: 1200, outputTokens: 40, totalTokens: 1240};
+const FIRST_RESULT_ROUND: UsageMetadata = {inputTokens: 1800, outputTokens: 35, totalTokens: 1835};
+const ANSWER_ROUND: UsageMetadata = {inputTokens: 2300, outputTokens: 210, totalTokens: 2510};
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports 5300 input, 285 output and 5585 total tokens for a turn whose three provider calls reported 1240, 1835 and 2510', async () => {
+    const reported = await usageReportedFor(twoToolRoundTurn(QUESTION_ROUND, FIRST_RESULT_ROUND, ANSWER_ROUND));
+
+    expect(reported).toEqual({inputTokens: 5300, outputTokens: 285, totalTokens: 5585});
+  });
+
+  it('counts the 1240 and 2510 rounds that reported when the middle round reports none, and reports nothing when no round did', async () => {
+    const partly = await usageReportedFor(twoToolRoundTurn(QUESTION_ROUND, undefined, ANSWER_ROUND));
+    const never = await usageReportedFor(twoToolRoundTurn(undefined, undefined, undefined));
+
+    expect({partly, never}).toEqual({
+      partly: {inputTokens: 3500, outputTokens: 250, totalTokens: 3750},
+      never: undefined,
+    });
+  });
+});