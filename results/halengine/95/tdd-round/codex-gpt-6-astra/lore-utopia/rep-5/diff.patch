+import {createChatOrchestrator} from './orchestration/chatOrchestrator.js';
+import {PromptBuilder} from './infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from './providers/mock/index.js';
+import type {ChatSession} from './types/session.js';
+
+describe('onError cause [spec: specs/hal-engine-config-hooks/spec.md#8]', () => {
+  it('preserves a thrown string as the hook error cause and caller rejection', async () => {
+    const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+    const errors: Error[] = [];
+    const orchestrator = createChatOrchestrator(
+      createMockProvider(),
+      new PromptBuilder({identity: 'Test assistant'}),
+      undefined,
+      {
+        hooks: {
+          beforeSession: async () => {
+            throw 'session failed';
+          },
+          onError: async (_session, error) => {
+            errors.push(error);
+          },
+        },
+      }
+    );
+
+    const outcome = await orchestrator.processMessage(session).then(
+      value => ({rejected: false, value}),
+      (value: unknown) => ({rejected: true, value})
+    );
+
+    expect({outcome, count: errors.length, isError: errors[0] instanceof Error, cause: errors[0]?.cause}).toEqual({
+      outcome: {rejected: true, value: 'session failed'},
+      count: 1,
+      isError: true,
+      cause: 'session failed',
+    });
+  });
+});
