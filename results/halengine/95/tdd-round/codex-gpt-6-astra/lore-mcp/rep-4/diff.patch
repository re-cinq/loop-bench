+function rejectionError(reason: unknown): Error {
+  if (reason instanceof Error) return reason;
+  try {
+    return new Error(String(reason), {cause: reason});
+  } catch (error) {
+    log.error('orchestrator', 'rejection conversion failed', {
+      errorType: error instanceof Error ? error.name : typeof error,
+    });
+    return new Error('Non-Error rejection', {cause: reason});
+  }
+}
