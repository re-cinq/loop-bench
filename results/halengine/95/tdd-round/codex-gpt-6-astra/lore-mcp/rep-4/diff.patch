@@ -0,0 +1,23 @@
+import {createChatOrchestrator} from './orchestration/chatOrchestrator.js';
+import {createMockProvider} from './providers/mock/index.js';
+import {PromptBuilder} from './infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from './types/session.js';
+
+export async function rejectedTurn(reason: unknown): Promise<{failures: Error[]; rejection: unknown}> {
+  const failures: Error[] = [];
+  const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+  const orchestrator = createChatOrchestrator(
+    createMockProvider(),
+    new PromptBuilder({identity: 'Test assistant'}),
+    undefined,
+    {
+      hooks: {
+        beforeUserInput: () => Promise.reject(reason),
+        onError: async (_session, error) => void failures.push(error),
+      },
+    }
+  );
+
+  const rejection: unknown = await orchestrator.processMessage(session).catch((error: unknown) => error);
+  return {failures, rejection};
+}