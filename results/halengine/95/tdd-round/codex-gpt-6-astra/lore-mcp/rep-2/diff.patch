+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// spec: specs/hal-engine-config-hooks/spec.md#9
+it('preserves a rejected string as the onError cause and caller rejection', async () => {
+  const failures: Error[] = [];
+  const callOrder: string[] = [];
+  const provider: AIProvider = {
+    sendMessage() {
+      throw new Error('beforeSession must reject before the provider is called');
+    },
+    async generateStructured() {
+      throw new Error('beforeSession must reject before the provider is called');
+    },
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Assistant'}), undefined, {
+    hooks: {
+      beforeSession: async () => {
+        throw 'string boom';
+      },
+      onError: async (_session, error) => {
+        failures.push(error);
+        callOrder.push('onError');
+      },
+      afterSession: async () => {
+        callOrder.push('afterSession');
+      },
+    },
+  });
+  const rejection: unknown = await orchestrator
+    .processMessage({sessionId: 's1', userId: 'u1', entries: []})
+    .catch((error: unknown) => error);
+
+  expect({
+    count: failures.length,
+    isError: failures[0] instanceof Error,
+    message: failures[0]?.message,
+    cause: failures[0]?.cause,
+    rejection,
+    callOrder,
+  }).toEqual({
+    count: 1,
+    isError: true,
+    message: 'string boom',
+    cause: 'string boom',
+    rejection: 'string boom',
+    callOrder: ['onError', 'afterSession'],
+  });
+});
