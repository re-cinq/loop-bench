+it('calls onError for a rejection that cannot be stringified', async () => {
+  const reason = Object.create(null) as Record<string, unknown>;
+  reason.self = reason;
+
+  const {caught, calls} = await rejectThroughOnError(reason);
+
+  expect({
+    caughtIsReason: caught === reason,
+    callCount: calls.length,
+    hookErrorIsError: calls[0] instanceof Error,
+    causeIsReason: calls[0]?.cause === reason,
+    messageIsReadable: Boolean(calls[0]?.message),
+  }).toEqual({
+    caughtIsReason: true,
+    callCount: 1,
+    hookErrorIsError: true,
+    causeIsReason: true,
+    messageIsReadable: true,
+  });
+});