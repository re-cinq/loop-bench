+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+const unusedProvider: AIProvider = {
+  async *sendMessage() {
+    yield {type: 'text', text: 'unused'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    throw new Error('Provider must not run before beforeUserInput');
+  },
+};
+
+it('reports a thrown string with its cause while preserving the rejection (spec: specs/hal-engine-config-hooks/spec.md#9)', async () => {
+  const errors: Error[] = [];
+  const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+  const orchestrator = createChatOrchestrator(
+    unusedProvider,
+    new PromptBuilder({identity: 'Test assistant'}),
+    undefined,
+    {
+      hooks: {
+        beforeUserInput: async () => {
+          throw 'string boom';
+        },
+        onError: async (_session, error) => {
+          errors.push(error);
+        },
+      },
+    }
+  );
+
+  const outcome = await orchestrator.processMessage(session).then(
+    () => ({rejected: false, reason: undefined}),
+    (reason: unknown) => ({rejected: true, reason})
+  );
+
+  expect({
+    outcome,
+    count: errors.length,
+    isError: errors[0] instanceof Error,
+    message: errors[0]?.message,
+    cause: errors[0]?.cause,
+  }).toEqual({
+    outcome: {rejected: true, reason: 'string boom'},
+    count: 1,
+    isError: true,
+    message: 'string boom',
+    cause: 'string boom',
+  });
+});
+
+it('reports object rejections without string conversion while preserving their cause (spec: specs/hal-engine-config-hooks/spec.md#9)', async () => {
+  const reason: unknown = Object.create(null);
+  const errors: Error[] = [];
+  const orchestrator = createChatOrchestrator(
+    unusedProvider,
+    new PromptBuilder({identity: 'Test assistant'}),
+    undefined,
+    {
+      hooks: {
+        beforeUserInput: async () => {
+          throw reason;
+        },
+        onError: async (_session, error) => {
+          errors.push(error);
+        },
+      },
+    }
+  );
+  const outcome = await orchestrator.processMessage({sessionId: 's1', userId: 'u1', entries: []}).then(
+    () => ({rejected: false, reason: undefined}),
+    (reason: unknown) => ({rejected: true, reason})
+  );
+  const reported = errors[0];
+  expect({
+    rejected: outcome.rejected,
+    originalRejection: outcome.reason === reason,
+    count: errors.length,
+    isError: reported instanceof Error,
+    originalCause: reported?.cause === reason,
+    readableMessage: Boolean(reported?.message),
+  }).toEqual({
+    rejected: true,
+    originalRejection: true,
+    count: 1,
+    isError: true,
+    originalCause: true,
+    readableMessage: true,
+  });
+});
