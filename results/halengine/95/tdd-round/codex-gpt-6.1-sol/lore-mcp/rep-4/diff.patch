@@ -0,0 +1,84 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+const rejectingProvider = (reason: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield -- the provider rejects before emitting a chunk
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw reason;
+  },
+  async generateStructured<T>(): Promise<T> {
+    throw reason;
+  },
+});
+
+async function observeRejection(reason: unknown, beforeSession?: () => Promise<void>) {
+  const received: Error[] = [];
+  const order: string[] = [];
+  const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+  const orchestrator = createChatOrchestrator(
+    rejectingProvider(reason),
+    new PromptBuilder({identity: 'Test assistant'}),
+    undefined,
+    {
+      hooks: {
+        beforeSession,
+        onError: async (_session, error) => {
+          received.push(error);
+          order.push('onError');
+        },
+        afterSession: async () => {
+          order.push('afterSession');
+        },
+      },
+    }
+  );
+  const rejection = await orchestrator.processMessage(session).then(
+    () => ({rejected: false, reason: undefined}),
+    (error: unknown) => ({rejected: true, reason: error})
+  );
+  return {received, order, rejection};
+}
+
+it('preserves string, object and undefined rejections as the onError cause (specs/hal-engine-config-hooks/spec.md#8)', async () => {
+  const reasons: unknown[] = ['string boom', {code: 503}, undefined];
+  const outcomes = [];
+  for (const reason of reasons) {
+    const {received, order, rejection} = await observeRejection(reason, async () => {
+      throw reason;
+    });
+    outcomes.push({
+      count: received.length,
+      isError: received[0] instanceof Error,
+      hasCause: Object.hasOwn(received[0] ?? {}, 'cause'),
+      causeMatches: received[0]?.cause === reason,
+      message: received[0]?.message,
+      callerMatches: rejection.rejected && rejection.reason === reason,
+      order,
+    });
+  }
+  expect(outcomes).toEqual(
+    reasons.map(reason => ({
+      count: 1,
+      isError: true,
+      hasCause: true,
+      causeMatches: true,
+      message: String(reason),
+      callerMatches: true,
+      order: ['onError', 'afterSession'],
+    }))
+  );
+});
+
+it('preserves a rejection with no string conversion as the onError cause (specs/hal-engine-config-hooks/spec.md#8)', async () => {
+  const reason: unknown = Object.create(null);
+  const {received, rejection} = await observeRejection(reason);
+  expect({
+    count: received.length,
+    isError: received[0] instanceof Error,
+    causeMatches: received[0]?.cause === reason,
+    hasMessage: Boolean(received[0]?.message),
+    callerMatches: rejection.rejected && rejection.reason === reason,
+  }).toEqual({count: 1, isError: true, causeMatches: true, hasMessage: true, callerMatches: true});
+});
