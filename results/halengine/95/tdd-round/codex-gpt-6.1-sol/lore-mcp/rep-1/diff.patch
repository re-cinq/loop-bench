+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('[spec: specs/hal-engine-config-hooks/spec.md#8]', () => {
+  it('reports an unprintable rejection with its cause and preserves the caller rejection', async () => {
+    const reason = {
+      toString: () => {
+        throw new Error('cannot stringify');
+      },
+    };
+    const provider: AIProvider = {
+      // eslint-disable-next-line require-yield
+      async *sendMessage() {
+        throw reason;
+      },
+      async generateStructured<T>(): Promise<T> {
+        throw reason;
+      },
+    };
+    const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+    const errors: Error[] = [];
+    const calls: string[] = [];
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Test assistant'}), undefined, {
+      hooks: {
+        onError: async (_session, error) => {
+          errors.push(error);
+          calls.push('onError');
+        },
+        afterSession: async () => {
+          calls.push('afterSession');
+        },
+      },
+    });
+    const rejection: unknown = await orchestrator.processMessage(session).catch((error: unknown) => error);
+
+    const [error] = errors;
+    const message = error?.message;
+    expect({
+      errorCount: errors.length,
+      isError: error instanceof Error,
+      hasMessage: typeof message === 'string' && message.length > 0,
+      causeIsOriginal: error?.cause === reason,
+      rejectionIsOriginal: rejection === reason,
+      calls,
+    }).toEqual({
+      errorCount: 1,
+      isError: true,
+      hasMessage: true,
+      causeIsOriginal: true,
+      rejectionIsOriginal: true,
+      calls: ['onError', 'afterSession'],
+    });
+  });
+});