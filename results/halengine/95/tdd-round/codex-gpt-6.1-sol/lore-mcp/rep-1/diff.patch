+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('[spec: specs/hal-engine-config-hooks/spec.md#8]', () => {
+  it('reports a thrown string with its cause and preserves the caller rejection', async () => {
+    const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+    const errors: Error[] = [];
+    const orchestrator = createChatOrchestrator(
+      {
+        // eslint-disable-next-line require-yield
+        async *sendMessage() {
+          throw new Error('Provider must not be called');
+        },
+        async generateStructured<T>(): Promise<T> {
+          throw new Error('Provider must not be called');
+        },
+      } satisfies AIProvider,
+      new PromptBuilder({identity: 'Test assistant'}),
+      undefined,
+      {
+        hooks: {
+          beforeSession: async () => {
+            throw 'hook failure';
+          },
+          onError: async (_session, error) => {
+            errors.push(error);
+          },
+        },
+      }
+    );
+    const rejection: unknown = await orchestrator.processMessage(session).catch((error: unknown) => error);
+
+    expect({
+      errors: errors.map(error => ({isError: error instanceof Error, message: error.message, cause: error.cause})),
+      rejection,
+    }).toEqual({
+      errors: [{isError: true, message: 'hook failure', cause: 'hook failure'}],
+      rejection: 'hook failure',
+    });
+  });
+});
