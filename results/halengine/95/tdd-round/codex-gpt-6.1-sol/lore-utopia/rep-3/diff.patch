+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+// spec: specs/hal-engine-config-hooks/spec.md#8
+it('reports an undefined rejection with its cause while preserving the caller rejection', async () => {
+  const errors: Error[] = [];
+  const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+  const orchestrator = createChatOrchestrator(
+    {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        throw new Error('Unexpected structured output request');
+      },
+    } satisfies AIProvider,
+    new PromptBuilder({identity: 'Test assistant'}),
+    undefined,
+    {
+      hooks: {
+        beforeSession: () => Promise.reject(undefined),
+        onError: async (_session, error) => {
+          errors.push(error);
+        },
+      },
+    }
+  );
+
+  const outcome = await orchestrator.processMessage(session).then(
+    () => ({rejected: false, reason: 'resolved'}),
+    (reason: unknown) => ({rejected: true, reason})
+  );
+
+  expect({
+    outcome,
+    count: errors.length,
+    isError: errors[0] instanceof Error,
+    message: errors[0]?.message,
+    hasCause: Object.hasOwn(errors[0] ?? {}, 'cause'),
+    cause: errors[0]?.cause,
+  }).toEqual({
+    outcome: {rejected: true, reason: undefined},
+    count: 1,
+    isError: true,
+    message: 'undefined',
+    hasCause: true,
+    cause: undefined,
+  });
+});