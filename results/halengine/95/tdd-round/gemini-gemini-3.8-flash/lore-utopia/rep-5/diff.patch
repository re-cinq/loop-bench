+describe('toError', () => {
+  it('coerces non-Error rejections to an Error with the original value as cause while preserving Error instances', () => {
+    const existing = new Error('already an error');
+    const obj = {code: 503, detail: 'upstream down'};
+    const strErr = toError('string boom');
+    const objErr = toError(obj);
+    const undefErr = toError(undefined);
+
+    expect({
+      sameInstance: toError(existing) === existing,
+      strMessage: strErr.message,
+      strCause: strErr.cause,
+      objMessage: objErr.message,
+      objCause: objErr.cause,
+      undefMessage: undefErr.message,
+      undefCause: undefErr.cause,
+    }).toEqual({
+      sameInstance: true,
+      strMessage: 'string boom',
+      strCause: 'string boom',
+      objMessage: JSON.stringify(obj),
+      objCause: obj,
+      undefMessage: 'undefined',
+      undefCause: undefined,
+    });
+  });
+});
diff --git a/src/orchestration/orchestratorHelpers.ts b/src/orchestration/orchestratorHelpers.ts
index 717eb9a..e1e77f9 100644
--- a/src/orchestration/orchestratorHelpers.ts
+++ b/src/orchestration/orchestratorHelpers.ts
@@ -40,3 +40,24 @@ export function extractStopReason(chunk: MessageChunk): string | null {
 export function extractUsage(chunk: MessageChunk): UsageMetadata | undefined {
   return chunk.type === 'stop' ? chunk.usage : undefined;
 }
+
+export function toError(rejection: unknown): Error {
+  if (rejection instanceof Error) return rejection;
+  const message =
+    typeof rejection === 'string'
+      ? rejection
+      : typeof rejection === 'object' && rejection !== null
+        ? safeJsonStringify(rejection)
+        : String(rejection);
+  return new Error(message, {cause: rejection});
+}
+
+function safeJsonStringify(value: object): string {
+  try {
+    const json = JSON.stringify(value);
+    if (json !== undefined) return json;
+  } catch {
+    // Cyclic or unstringifiable objects fall back to String(value).
+  }
+  return String(value);
+}