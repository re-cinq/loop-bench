+// The hook is typed against Error, so a rejection that is not one is wrapped with the original kept as `cause`.
+function asError(error: unknown): Error {
+  if (error instanceof Error) return error;
+  return new Error(readableMessage(error), {cause: error});
+}
+
+// A string stands alone; every other shape gets the best rendering JSON or String can give.
+function readableMessage(error: unknown): string {
+  if (typeof error === 'string') return error;
+  return stringifyOrNull(error) ?? String(error);
+}
+
+// JSON.stringify names an object's shape; null means it refused the value and String must render it instead.
+function stringifyOrNull(value: unknown): string | null {
+  try {
+    return JSON.stringify(value);
+  } catch {
+    return null;
+  }
+}
