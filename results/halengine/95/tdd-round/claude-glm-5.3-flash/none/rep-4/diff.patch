@@ -0,0 +1,15 @@
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+
+// Shared by the orchestrator suites pinning the onError seam against arbitrary rejections.
+/** An AIProvider whose stream rejects with whatever the test hands it, Error or not. */
+export function rejectingWith(reason: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw reason;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
