+// Preserves an Error instance verbatim and wraps anything else with the raw value as its cause.
+function toError(reason: unknown): Error {
+  if (reason instanceof Error) return reason;
+  return new Error(describeRejection(reason), {cause: reason});
+}
+
+function describeRejection(reason: unknown): string {
+  if (typeof reason === 'string') return reason;
+  return serializedOrNull(reason) ?? describeByType(reason);
+}
+
+function serializedOrNull(reason: unknown): string | null {
+  try {
+    return JSON.stringify(reason) ?? null;
+  } catch {
+    return null;
+  }
+}
+
+function describeByType(reason: unknown): string {
+  if (typeof reason === 'object') return '[object Object]';
+  return String(reason);
+}
