@@ -0,0 +1,97 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const promptBuilder = new PromptBuilder({identity: 'Test assistant.'});
+
+describe('ChatOrchestrator onError coercion', () => {
+  it('wraps non-Error rejections with cause and passes Errors through', async () => {
+    const plainPayload = {code: 502, reason: 'bad gateway'};
+    const circularPayload: Record<string, unknown> = {label: 'loop'};
+    circularPayload.self = circularPayload;
+    const barePayload: Record<string, unknown> = Object.create(null);
+    barePayload.self = barePayload;
+    const domainError = new Error('already an error');
+
+    const observed = await Promise.all([
+      observeRejection('string failure'),
+      observeRejection(plainPayload),
+      observeRejection(undefined),
+      observeRejection(circularPayload),
+      observeRejection(barePayload),
+      observeRejection(domainError),
+    ]);
+
+    expect(observed).toEqual([
+      wrappedExpectation('string failure'),
+      wrappedExpectation('{"code":502,"reason":"bad gateway"}'),
+      wrappedExpectation('undefined'),
+      wrappedExpectation('[object Object]'),
+      wrappedExpectation('[object Object]'),
+      {
+        rethrowsOriginal: true,
+        isError: true,
+        sameInstance: true,
+        message: 'already an error',
+        preservesCause: false,
+      },
+    ]);
+  });
+});
+
+function wrappedExpectation(message: string) {
+  return {
+    rethrowsOriginal: true,
+    isError: true,
+    sameInstance: false,
+    message,
+    preservesCause: true,
+  };
+}
+
+async function observeRejection(reason: unknown) {
+  let reported: Error | undefined;
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => {
+      reported = error;
+    },
+  };
+  const session: ChatSession = {
+    sessionId: 's-coercion',
+    userId: 'u-1',
+    entries: [{role: 'user', content: 'ping', timestamp: SENT_AT}],
+  };
+  const orchestrator = createChatOrchestrator(failingProvider(reason), promptBuilder, undefined, {hooks});
+  const outcome = await orchestrator.processMessage(session).then(
+    () => ({rejected: false, thrown: Symbol('resolved') as unknown}),
+    (thrown: unknown) => ({rejected: true, thrown})
+  );
+
+  return {
+    rethrowsOriginal: outcome.rejected && Object.is(outcome.thrown, reason),
+    isError: reported instanceof Error,
+    sameInstance: Object.is(reported, reason),
+    message: reported?.message,
+    preservesCause: hasMatchingCause(reported, reason),
+  };
+}
+
+function hasMatchingCause(reported: Error | undefined, reason: unknown): boolean {
+  if (!reported || !('cause' in reported)) return false;
+  return Object.is(reported.cause, reason);
+}
+
+function failingProvider(reason: unknown): AIProvider {
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield* [] as MessageChunk[];
+      throw reason;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}