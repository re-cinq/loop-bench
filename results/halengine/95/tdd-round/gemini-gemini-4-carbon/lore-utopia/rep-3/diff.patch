@@ -0,0 +1,116 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {UNSERIALISABLE} from '../shared/logger.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const promptBuilder = new PromptBuilder({identity: 'Test assistant.'});
+
+const throwingProvider = (thrown: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw thrown;
+  },
+  async generateStructured<T>(): Promise<T> {
+    throw new Error('unused');
+  },
+});
+
+const captureRejection = (call: Promise<unknown>): Promise<unknown> =>
+  call.then(() => Symbol('resolved')).catch((caught: unknown) => caught);
+
+const runFailingTurn = async (thrown: unknown) => {
+  const seen: Error[] = [];
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => {
+      seen.push(error);
+    },
+  };
+  const session: ChatSession = {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hi', timestamp: SENT_AT}],
+  };
+  const orchestrator = createChatOrchestrator(throwingProvider(thrown), promptBuilder, undefined, {hooks});
+  const propagated = await captureRejection(orchestrator.processMessage(session));
+  return {seen, propagated};
+};
+
+describe('onError coercion of arbitrary rejections', () => {
+  it('wraps non-Error rejections with cause and passes Error instances through', async () => {
+    const wrappedCases: {kind: string; thrown: unknown; expectedMessage: string}[] = [
+      {kind: 'string', thrown: 'plain string boom', expectedMessage: 'plain string boom'},
+      {kind: 'object', thrown: {code: 'WEIRD'}, expectedMessage: '{"code":"WEIRD"}'},
+      {kind: 'undefined', thrown: undefined, expectedMessage: 'undefined'},
+      {kind: 'bigint', thrown: BigInt(7), expectedMessage: '7'},
+    ];
+
+    const wrapped = [];
+    for (const {kind, thrown, expectedMessage} of wrappedCases) {
+      const {seen, propagated} = await runFailingTurn(thrown);
+      const reported = seen[0];
+      wrapped.push({
+        kind,
+        calls: seen.length,
+        isError: reported instanceof Error,
+        messageMatches: reported?.message === expectedMessage,
+        sameInstance: Object.is(reported, thrown),
+        hasCauseKey: reported instanceof Error && 'cause' in reported,
+        causeMatches: Object.is(reported?.cause, thrown),
+        propagatedMatches: Object.is(propagated, thrown),
+      });
+    }
+
+    const originalError = new Error('existing instance');
+    const {seen: passthroughSeen, propagated: passthroughPropagated} = await runFailingTurn(originalError);
+
+    expect({
+      wrapped,
+      passthrough: {
+        calls: passthroughSeen.length,
+        sameInstance: Object.is(passthroughSeen[0], originalError),
+        propagatedMatches: Object.is(passthroughPropagated, originalError),
+      },
+    }).toEqual({
+      wrapped: wrappedCases.map(({kind}) => ({
+        kind,
+        calls: 1,
+        isError: true,
+        messageMatches: true,
+        sameInstance: false,
+        hasCauseKey: true,
+        causeMatches: true,
+        propagatedMatches: true,
+      })),
+      passthrough: {
+        calls: 1,
+        sameInstance: true,
+        propagatedMatches: true,
+      },
+    });
+  });
+
+  it('still calls onError with cause and rethrows the original value when String coercion itself throws', async () => {
+    const cyclic = Object.create(null) as Record<string, unknown>;
+    cyclic.self = cyclic;
+
+    const {seen, propagated} = await runFailingTurn(cyclic);
+    const reported = seen[0];
+
+    expect({
+      calls: seen.length,
+      isError: reported instanceof Error,
+      message: reported?.message,
+      causeMatches: Object.is(reported?.cause, cyclic),
+      propagatedMatches: Object.is(propagated, cyclic),
+    }).toEqual({
+      calls: 1,
+      isError: true,
+      message: UNSERIALISABLE,
+      causeMatches: true,
+      propagatedMatches: true,
+    });
+  });
+});