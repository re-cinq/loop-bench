+// Preserves a thrown string verbatim and serialises objects so onError receives a readable message.
+function describeRejection(error: unknown): string {
+  if (typeof error === 'string') return error;
+  return serializedOrNull(error) ?? stringOrNull(error) ?? UNSERIALISABLE;
+}
+
+function serializedOrNull(value: unknown): string | null {
+  try {
+    return JSON.stringify(value) ?? null;
+  } catch {
+    return null;
+  }
+}
+
+function stringOrNull(value: unknown): string | null {
+  try {
+    return String(value);
+  } catch {
+    return null;
+  }
+}
