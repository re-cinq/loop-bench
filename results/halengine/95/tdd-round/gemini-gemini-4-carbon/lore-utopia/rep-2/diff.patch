+// Preserves a thrown string verbatim and renders objects as JSON when possible so `error.message` stays readable.
+function describeRejection(error: unknown): string {
+  if (typeof error === 'string') return error;
+  return serializedOrNull(error) ?? String(error);
+}
+
+function serializedOrNull(value: unknown): string | null {
+  try {
+    return JSON.stringify(value) ?? null;
+  } catch {
+    return null;
+  }
