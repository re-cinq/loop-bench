+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function createThrowingProvider(throws: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw throws;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('onError with non-Error rejections', () => {
+  it('wraps string rejection in an Error when calling onError', async () => {
+    const callOrder: string[] = [];
+    let receivedError: Error | undefined;
+    let thrownRejection: unknown;
+
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        callOrder.push('onError');
+        receivedError = error;
+      },
+      afterSession: async () => {
+        callOrder.push('afterSession');
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createThrowingProvider('string boom'), promptBuilder, undefined, {
+      hooks,
+    });
+
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (error) {
+      thrownRejection = error;
+    }
+
+    expect({
+      callOrder,
+      isError: receivedError instanceof Error,
+      receivedMessage: receivedError?.message,
+      thrownRejection,
+    }).toEqual({
+      callOrder: ['onError', 'afterSession'],
+      isError: true,
+      receivedMessage: 'string boom',
+      thrownRejection: 'string boom',
+    });
+  });
+});
