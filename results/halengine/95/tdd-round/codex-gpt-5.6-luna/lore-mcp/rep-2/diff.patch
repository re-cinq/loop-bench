+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {rejectingProvider} from './rejectingProvider.test-helper.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const session: ChatSession = {
+  sessionId: 'test-session',
+  userId: 'user-1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+describe('ChatOrchestrator non-Error rejection causes', () => {
+  it('wraps a string for onError while rethrowing the original rejection', async () => {
+    const reason = 'string boom';
+    let receivedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        receivedError = error;
+      },
+    };
+    const orchestrator = createChatOrchestrator(rejectingProvider(reason), promptBuilder, undefined, {hooks});
+
+    const thrown = await orchestrator.processMessage(session).catch(error => error);
+
+    expect({thrown, receivedError, cause: receivedError?.cause}).toEqual({
+      thrown: reason,
+      receivedError: expect.any(Error),
+      cause: reason,
+    });
+  });
+
+  it('passes an existing Error through to onError unchanged', async () => {
+    const reason = new Error('already an error');
+    let receivedError: Error | undefined;
+    const orchestrator = createChatOrchestrator(rejectingProvider(reason), promptBuilder, undefined, {
+      hooks: {
+        onError: async (_session, error) => {
+          receivedError = error;
+        },
+      },
+    });
+
+    await orchestrator.processMessage(session).catch(() => undefined);
+
+    expect(receivedError).toBe(reason);
+  });
+
+  it('passes undefined as the cause when wrapping an undefined rejection', async () => {
+    let receivedError: Error | undefined;
+    const orchestrator = createChatOrchestrator(rejectingProvider(undefined), promptBuilder, undefined, {
+      hooks: {
+        onError: async (_session, error) => {
+          receivedError = error;
+        },
+      },
+    });
+
+    await orchestrator.processMessage(session).catch(() => undefined);
+
+    expect({receivedError, cause: receivedError?.cause}).toEqual({
+      receivedError: expect.any(Error),
+      cause: undefined,
+    });
+  });
+});
