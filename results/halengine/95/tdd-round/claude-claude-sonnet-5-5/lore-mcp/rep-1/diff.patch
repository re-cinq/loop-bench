+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const session: ChatSession = {
+  sessionId: 'cause-session',
+  userId: 'user-2',
+  entries: [{role: 'user', content: 'hi', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+const failing = (reason: unknown): AIProvider => ({
+  sendMessage: () => ({
+    next: () => Promise.reject(reason),
+    return: () => Promise.resolve({done: true as const, value: undefined}),
+    throw: () => Promise.reject(reason),
+    [Symbol.asyncIterator]() {
+      return this;
+    },
+    [Symbol.asyncDispose]: () => Promise.resolve(),
+  }),
+  generateStructured: <T>() => Promise.resolve({} as T),
+});
+
+const observe = async (reason: unknown) => {
+  const seen: Error[] = [];
+  const orchestrator = createChatOrchestrator(failing(reason), new PromptBuilder({identity: 'cause'}), undefined, {
+    hooks: {
+      onError: async (_session, error) => {
+        seen.push(error);
+      },
+    },
+  });
+  const thrown = await orchestrator.processMessage(session).then(
+    () => 'resolved' as unknown,
+    (caught: unknown) => caught
+  );
+  return {seen, thrown};
+};
+
+describe('ChatOrchestrator onError cause preservation', () => {
+  it('wraps a plain object rejection in an Error whose cause is that object', async () => {
+    const reason = {code: 503};
+    const {seen, thrown} = await observe(reason);
+
+    expect({count: seen.length, cause: seen[0]?.cause, thrown}).toEqual({count: 1, cause: reason, thrown: reason});
+  });
+
+  it('wraps an undefined rejection in an Error whose cause is undefined and rethrows undefined', async () => {
+    const {seen, thrown} = await observe(undefined);
+
+    expect({
+      count: seen.length,
+      isError: seen[0] instanceof Error,
+      hasCause: seen[0] && 'cause' in seen[0],
+      thrown,
+    }).toEqual({count: 1, isError: true, hasCause: true, thrown: undefined});
+  });
+
+  it('passes an Error rejection to onError as the same instance', async () => {
+    const reason = new Error('fail');
+    const {seen} = await observe(reason);
+
+    expect(seen[0]).toBe(reason);
+  });
+});
