 }
+
+// A hook typed against Error must see every rejection; the raw value stays reachable as `cause`.
+function asError(thrown: unknown): Error {
+  if (thrown instanceof Error) return thrown;
+  const message = typeof thrown === 'string' ? thrown : describeThrown(thrown);
+  return new Error(message, {cause: thrown});
+}
+
+function describeThrown(thrown: unknown): string {
+  const serialised = probeSerialise(thrown);
+  return serialised.ok ? serialised.value : `${Object.prototype.toString.call(thrown)} (${serialised.reason})`;
+}
+
+// A probe, not control flow: it reports what happened rather than branching on a swallowed error.
+function probeSerialise(thrown: unknown): {ok: true; value: string} | {ok: false; reason: string} {
+  try {
+    return {ok: true, value: JSON.stringify(thrown) ?? String(thrown)};
+  } catch (error) {
+    return {ok: false, reason: error instanceof Error ? error.message : typeof error};
+  }
+}
