+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const session: ChatSession = {
+  sessionId: 'cause-session',
+  userId: 'user-1',
+  entries: [{role: 'user', content: 'hi', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+const failingStream = (reason: unknown): AsyncGenerator<MessageChunk> =>
+  ({
+    next: () => Promise.reject(reason),
+    [Symbol.asyncIterator]() {
+      return this;
+    },
+  }) as unknown as AsyncGenerator<MessageChunk>;
+
+const observe = async (reason: unknown) => {
+  const seen: Error[] = [];
+  const provider = {
+    sendMessage: () => failingStream(reason),
+    generateStructured: async () => ({}),
+  } as unknown as AIProvider;
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), undefined, {
+    hooks: {
+      onError: async (_session, error) => {
+        seen.push(error);
+      },
+    },
+  });
+  const caught = await orchestrator.processMessage(session).catch((e: unknown) => e);
+  return {seen, caught};
+};
+
+describe('ChatOrchestrator onError wrapping', () => {
+  it('wraps a string rejection with the string as cause', async () => {
+    const {seen} = await observe('string boom');
+
+    expect(seen.map(e => [e instanceof Error, e.cause])).toEqual([[true, 'string boom']]);
+  });
+
+  it('wraps a plain object rejection with the object as cause', async () => {
+    const reason = {code: 503};
+
+    const {seen} = await observe(reason);
+
+    expect(seen.map(e => e.cause)).toEqual([reason]);
+  });
+
+  it('wraps an undefined rejection with undefined as cause', async () => {
+    const {seen} = await observe(undefined);
+
+    expect(seen.map(e => [e instanceof Error, e.cause])).toEqual([[true, undefined]]);
+  });
+
+  it('still rejects the caller with the original non-Error value', async () => {
+    const {caught} = await observe('string boom');
+
+    expect(caught).toBe('string boom');
+  });
+
+  it('passes an Error rejection to onError as the same instance', async () => {
+    const original = new Error('real');
+
+    const {seen} = await observe(original);
+
+    expect(seen[0]).toBe(original);
+  });
+});
