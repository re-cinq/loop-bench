@@ -0,0 +1,81 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const sessionWith = (content: string): ChatSession => ({
+  sessionId: 'test-session',
+  userId: 'user-1',
+  entries: [{role: 'user', content, timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const rejectingWith = (reason: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw reason;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+const turnOutcome = async (reason: unknown) => {
+  const callOrder: string[] = [];
+  let seenError: Error | undefined;
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => {
+      callOrder.push('onError');
+      seenError = error;
+    },
+    afterSession: async () => {
+      callOrder.push('afterSession');
+    },
+  };
+
+  const orchestrator = createChatOrchestrator(rejectingWith(reason), promptBuilder, undefined, {hooks});
+  const outcome = await orchestrator.processMessage(sessionWith('hello')).then(
+    value => ({rejected: false, reason: value as unknown}),
+    (thrown: unknown) => ({rejected: true, reason: thrown})
+  );
+
+  return {
+    outcome,
+    callOrder,
+    isError: seenError instanceof Error,
+    message: seenError?.message,
+  };
+};
+
+describe('ChatOrchestrator onError on non-Error rejections', () => {
+  it('calls onError with an Error carrying the thrown string and runs afterSession while rethrowing', async () => {
+    const result = await turnOutcome('string boom');
+
+    expect(result).toEqual({
+      outcome: {rejected: true, reason: 'string boom'},
+      callOrder: ['onError', 'afterSession'],
+      isError: true,
+      message: 'string boom',
+    });
+  });
+
+  it('calls onError with an Error carrying a readable message when the stream rejects with a plain object', async () => {
+    const reason = {code: 503, detail: 'upstream down'};
+
+    const result = await turnOutcome(reason);
+
+    expect({
+      outcome: result.outcome,
+      callOrder: result.callOrder,
+      isError: result.isError,
+      hasMessage: typeof result.message === 'string' && result.message.length > 0,
+    }).toEqual({
+      outcome: {rejected: true, reason},
+      callOrder: ['onError', 'afterSession'],
+      isError: true,
+      hasMessage: true,
+    });
+  });
+});