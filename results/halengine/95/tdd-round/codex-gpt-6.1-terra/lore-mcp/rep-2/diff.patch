+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// specs/hal-engine-config-hooks/spec.md#8
+it('preserves rejection values as causes and rethrows them unchanged', async () => {
+  const reasons: unknown[] = ['string boom', {code: 503}, undefined];
+  const results = [];
+  for (const reason of reasons) {
+    const provider: AIProvider = {
+      // eslint-disable-next-line require-yield
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        throw reason;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const seen: Error[] = [];
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), undefined, {
+      hooks: {onError: async (_session, error) => void seen.push(error)},
+    });
+    const outcome = await orchestrator.processMessage(session).then(
+      () => ({rejected: false, reason: undefined}),
+      (error: unknown) => ({rejected: true, reason: error})
+    );
+    results.push({
+      count: seen.length,
+      isError: seen[0] instanceof Error,
+      hasCause: seen[0] !== undefined && Object.hasOwn(seen[0], 'cause'),
+      causeIsOriginal: seen[0]?.cause === reason,
+      rejected: outcome.rejected,
+      sameReason: outcome.reason === reason,
+    });
+  }
+  expect(results).toEqual(
+    reasons.map(() => ({
+      count: 1,
+      isError: true,
+      hasCause: true,
+      causeIsOriginal: true,
+      rejected: true,
+      sameReason: true,
+    }))
+  );
+});
