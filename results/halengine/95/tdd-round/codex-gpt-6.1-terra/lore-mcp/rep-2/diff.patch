+import {execFileSync} from 'node:child_process';
+import {mkdtempSync, mkdirSync, realpathSync, rmSync, writeFileSync} from 'node:fs';
+import {tmpdir} from 'node:os';
+import {join, resolve} from 'node:path';
+
+export function listFixture(source: string, assertions: object[]): unknown {
+  const root = realpathSync(mkdtempSync(join(tmpdir(), 'lore-list-')));
+  try {
+    const bin = join(root, 'bin');
+    mkdirSync(bin);
+    const file = join(root, 'sample.test.ts');
+    writeFileSync(file, source);
+    const report = JSON.stringify({testResults: [{name: file, assertionResults: assertions}]});
+    writeFileSync(
+      join(bin, 'npx'),
+      `#!/bin/sh\nfor arg in "$@"; do\n  case "$arg" in --outputFile=*) printf '%s' '${report}' > "${'$'}{arg#--outputFile=}";; esac\ndone\n`,
+      {mode: 0o755}
+    );
+    const output = execFileSync('node', [resolve('scripts/lore-list-tests.mjs')], {
+      cwd: root,
+      env: {...process.env, PATH: `${bin}:${process.env.PATH ?? ''}`},
+      encoding: 'utf8',
+    });
+    return JSON.parse(output);
+  } finally {
+    rmSync(root, {recursive: true, force: true});
+  }
+}
