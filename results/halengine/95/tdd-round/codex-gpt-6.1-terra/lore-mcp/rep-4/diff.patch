@@ -0,0 +1,41 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('onError rejection causes', () => {
+  it('preserves non-Error rejection causes and the original caller value specs/hal-engine-config-hooks/spec.md#8', async () => {
+    for (const reason of ['string boom', {code: 503}, undefined]) {
+      const provider: AIProvider = {
+        // eslint-disable-next-line require-yield
+        async *sendMessage(): AsyncGenerator<MessageChunk> {
+          throw reason;
+        },
+        async generateStructured<T>(): Promise<T> {
+          return {} as T;
+        },
+      };
+      const seen: Error[] = [];
+      const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), undefined, {
+        hooks: {
+          onError: async (_session, error) => {
+            seen.push(error);
+          },
+        },
+      });
+      const session: ChatSession = {sessionId: 'test', userId: 'user', entries: []};
+      const outcome = await orchestrator.processMessage(session).then(
+        () => ({rejected: false, reason: null}),
+        (error: unknown) => ({rejected: true, reason: error})
+      );
+      expect({
+        rejected: outcome.rejected,
+        sameReason: outcome.reason === reason,
+        count: seen.length,
+        isError: seen[0] instanceof Error,
+        sameCause: seen[0]?.cause === reason,
+        hasCause: Object.hasOwn(seen[0] ?? {}, 'cause'),
+      }).toEqual({rejected: true, sameReason: true, count: 1, isError: true, sameCause: true, hasCause: true});
+    }
+  });
+});
