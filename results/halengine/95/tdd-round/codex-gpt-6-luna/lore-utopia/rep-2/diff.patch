+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createOnErrorTestSession, createRejectingProvider} from './onErrorTestHelpers.js';
+
+// @spec specs/hal-engine-config-hooks/spec.md#8
+describe('ChatOrchestrator onError for Error rejections', () => {
+  it('passes the original Error to onError and rethrows the same instance', async () => {
+    const reason = new Error('provider failed');
+    const provider = createRejectingProvider(reason);
+    const session = createOnErrorTestSession();
+    let receivedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        receivedError = error;
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      provider,
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      undefined,
+      {hooks}
+    );
+
+    const thrown = await orchestrator.processMessage(session).then(
+      () => undefined,
+      error => error
+    );
+
+    expect({receivedError, thrown}).toEqual({receivedError: reason, thrown: reason});
+  });
+});
