+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createOnErrorTestSession, createRejectingProvider} from './onErrorTestHelpers.js';
+
+// @spec specs/hal-engine-config-hooks/spec.md#8
+describe('ChatOrchestrator onError for undefined rejection', () => {
+  it('wraps undefined for onError and rethrows the original value', async () => {
+    const provider = createRejectingProvider(undefined);
+    const session = createOnErrorTestSession();
+    const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+    let receivedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        receivedError = error;
+      },
+    };
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+
+    const thrown = await orchestrator.processMessage(session).then(
+      () => 'resolved',
+      reason => reason
+    );
+
+    expect({
+      thrown,
+      receivedError: receivedError instanceof Error,
+      message: receivedError?.message,
+      hasCause: receivedError !== undefined && Object.hasOwn(receivedError, 'cause'),
+      cause: receivedError?.cause,
+    }).toEqual({
+      thrown: undefined,
+      receivedError: true,
+      message: 'undefined',
+      hasCause: true,
+      cause: undefined,
+    });
+  });
+});