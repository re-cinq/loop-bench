+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {providerRejecting, testSession} from './onErrorTestFixtures.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+it('calls onError with an Error whose cause is undefined and rethrows undefined', async () => {
+  const provider = providerRejecting(undefined);
+  let receivedError: Error | undefined;
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => {
+      receivedError = error;
+    },
+  };
+  const session = testSession();
+
+  const outcome = await createChatOrchestrator(provider, promptBuilder, undefined, {hooks})
+    .processMessage(session)
+    .then(
+      () => ({rejected: false, reason: 'resolved'}),
+      (reason: unknown) => ({rejected: true, reason})
+    );
+
+  expect({
+    isError: receivedError instanceof Error,
+    hasCause: Object.hasOwn(receivedError!, 'cause'),
+    cause: receivedError?.cause,
+    outcome,
+  }).toEqual({
+    isError: true,
+    hasCause: true,
+    cause: undefined,
+    outcome: {rejected: true, reason: undefined},
+  });
+});
