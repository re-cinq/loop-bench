+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {providerRejecting, testSession} from './onErrorTestFixtures.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+it('calls onError when a non-Error rejection cannot be converted to a string', async () => {
+  const reason = {
+    toString(): never {
+      throw new Error('cannot stringify rejection');
+    },
+  };
+  const provider = providerRejecting(reason);
+  let receivedError: Error | undefined;
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => {
+      receivedError = error;
+    },
+  };
+  const session = testSession();
+
+  const outcome = await createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), undefined, {hooks})
+    .processMessage(session)
+    .then(
+      () => ({rejected: false, reason: undefined as unknown}),
+      (thrown: unknown) => ({rejected: true, reason: thrown})
+    );
+
+  expect({
+    outcome,
+    receivedError: receivedError && {message: receivedError.message, cause: receivedError.cause},
+  }).toEqual({
+    outcome: {rejected: true, reason},
+    receivedError: {message: 'Non-Error rejection', cause: reason},
+  });
+});