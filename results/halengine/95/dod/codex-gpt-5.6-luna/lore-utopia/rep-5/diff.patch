+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+  };
+}
+
+function createRejectingProvider(value: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      throw value;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+async function rejectionOf(call: Promise<unknown>): Promise<unknown> {
+  try {
+    await call;
+    return 'resolved without throwing';
+  } catch (error) {
+    return error;
+  }
+}
+
+describe('onError for non-Error provider rejections', () => {
+  it('wraps a non-Error rejection in an Error whose cause is the original and still rejects the caller with the original', async () => {
+    const cases: {label: string; value: unknown}[] = [
+      {label: 'string', value: 'plain string boom'},
+      {label: 'object', value: {code: 'WEIRD', detail: 'no stack here'}},
+      {label: 'undefined', value: undefined},
+    ];
+
+    const results = [];
+    for (const {label, value} of cases) {
+      const received: unknown[] = [];
+      const orchestrator = createChatOrchestrator(createRejectingProvider(value), promptBuilder, undefined, {
+        hooks: {
+          onError: async (_session, error) => {
+            received.push(error);
+          },
+        },
+      });
+
+      const rejection = await rejectionOf(orchestrator.processMessage(createSession()));
+      const passed = received[0];
+      results.push({
+        label,
+        onErrorCallCount: received.length,
+        isError: passed instanceof Error,
+        causeIsOriginal: passed instanceof Error && 'cause' in passed && passed.cause === value,
+        callerReceivedOriginal: rejection === value,
+      });
+    }
+
+    expect(results).toEqual([
+      {label: 'string', onErrorCallCount: 1, isError: true, causeIsOriginal: true, callerReceivedOriginal: true},
+      {label: 'object', onErrorCallCount: 1, isError: true, causeIsOriginal: true, callerReceivedOriginal: true},
+      {label: 'undefined', onErrorCallCount: 1, isError: true, causeIsOriginal: true, callerReceivedOriginal: true},
+    ]);
+  });
+});