+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+const session: ChatSession = {
+  sessionId: 'acceptance-session',
+  userId: 'acceptance-user',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+function rejectingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+describe('non-Error provider rejections', () => {
+  it.each([
+    ['a thrown string', 'provider failed'],
+    ['a plain object', {code: 'PROVIDER_FAILED'}],
+    ['undefined', undefined],
+  ])('calls onError once for %s with a caused Error and preserves the rejection', async (_label, rejection) => {
+    let onErrorCalls = 0;
+    let receivedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCalls += 1;
+        receivedError = error;
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      rejectingProvider(rejection),
+      new PromptBuilder({identity: 'Acceptance test assistant'}),
+      undefined,
+      {hooks}
+    );
+
+    let callerRejection: unknown;
+    try {
+      await orchestrator.processMessage({...session, entries: [...session.entries]});
+    } catch (error) {
+      callerRejection = error;
+    }
+
+    expect({
+      onErrorCalls,
+      isError: receivedError instanceof Error,
+      cause: receivedError?.cause,
+      callerRejection,
+    }).toEqual({
+      onErrorCalls: 1,
+      isError: true,
+      cause: rejection,
+      callerRejection: rejection,
+    });
+  });
+});