+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const session = (): ChatSession => ({
+  sessionId: 'acceptance-session',
+  userId: 'acceptance-user',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const providerRejectingWith = (value: unknown): AIProvider => ({
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw value;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+const rejectionOf = (call: Promise<unknown>): Promise<unknown> => call.catch(error => error);
+
+describe('onError for non-Error rejections', () => {
+  it('wraps string, object, and undefined rejections for onError without changing the caller rejection', async () => {
+    const rejectedValues: unknown[] = ['provider failed', {code: 'PROVIDER_FAILED'}, undefined];
+    const results = [];
+
+    for (const rejectedValue of rejectedValues) {
+      const receivedErrors: Error[] = [];
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          receivedErrors.push(error);
+        },
+      };
+      const orchestrator = createChatOrchestrator(providerRejectingWith(rejectedValue), promptBuilder, undefined, {
+        hooks,
+      });
+
+      const callerRejection = await rejectionOf(orchestrator.processMessage(session()));
+      const [receivedError] = receivedErrors;
+      results.push({
+        onErrorCallCount: receivedErrors.length,
+        receivedErrorIsError: receivedError instanceof Error,
+        causeIsOriginal: receivedError?.cause === rejectedValue,
+        callerReceivedOriginal: callerRejection === rejectedValue,
+      });
+    }
+
+    expect(results).toEqual([
+      {onErrorCallCount: 1, receivedErrorIsError: true, causeIsOriginal: true, callerReceivedOriginal: true},
+      {onErrorCallCount: 1, receivedErrorIsError: true, causeIsOriginal: true, callerReceivedOriginal: true},
+      {onErrorCallCount: 1, receivedErrorIsError: true, causeIsOriginal: true, callerReceivedOriginal: true},
+    ]);
+  });
+});