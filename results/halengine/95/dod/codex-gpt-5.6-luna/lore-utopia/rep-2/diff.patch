+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+}
+
+function rejectingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+describe('onError for non-Error provider rejections', () => {
+  it.each([
+    ['a string', 'provider failed'],
+    ['a plain object', {code: 'PROVIDER_FAILED'}],
+    ['undefined', undefined],
+    ['an Error', new Error('already an Error')],
+  ])('calls onError for %s while preserving the caller rejection', async (_label, rejection) => {
+    const receivedErrors: Error[] = [];
+    const hooks = {
+      onError: async (_session: ChatSession, error: Error) => {
+        receivedErrors.push(error);
+      },
+    };
+    const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+
+    let callerRejection: unknown;
+    try {
+      await orchestrator.processMessage(createSession());
+    } catch (error) {
+      callerRejection = error;
+    }
+
+    expect({
+      callerRejection,
+      hookCallCount: receivedErrors.length,
+      hookError: receivedErrors[0],
+      hookCause: receivedErrors[0]?.cause,
+    }).toEqual({
+      callerRejection: rejection,
+      hookCallCount: 1,
+      hookError: expect.any(Error),
+      hookCause: rejection instanceof Error ? undefined : rejection,
+    });
+
+    if (rejection instanceof Error) expect(receivedErrors[0]).toBe(rejection);
+  });
+});