+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const session: ChatSession = {
+  sessionId: 'acceptance-session',
+  userId: 'acceptance-user',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+const rejectingProvider = (rejection: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+describe('onError for non-Error rejections', () => {
+  it('calls onError with a wrapped Error and preserves the original rejection at the caller boundary', async () => {
+    for (const rejection of ['provider failed', {code: 'PROVIDER_FAILED'}, undefined]) {
+      let onErrorCalls = 0;
+      let received: Error | undefined;
+      const hooks = {
+        onError: async (_session: ChatSession, error: Error) => {
+          onErrorCalls += 1;
+          received = error;
+        },
+      };
+      const orchestrator = createChatOrchestrator(
+        rejectingProvider(rejection),
+        new PromptBuilder({identity: 'acceptance assistant'}),
+        undefined,
+        {hooks}
+      );
+
+      let callerRejection: unknown;
+      try {
+        await orchestrator.processMessage(session);
+      } catch (error) {
+        callerRejection = error;
+      }
+
+      expect(onErrorCalls).toBe(1);
+      expect(received).toBeInstanceOf(Error);
+      expect(received?.cause).toBe(rejection);
+      expect(callerRejection).toBe(rejection);
+    }
+  });
+});