+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(): ChatSession {
+  return {
+    sessionId: 'on-error-acceptance',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+  };
+}
+
+function rejectingProvider(rejection: unknown): AIProvider {
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+it('calls onError with an Error for every non-Error rejection while preserving the caller rejection', async () => {
+  const rejections: unknown[] = ['provider failed', {code: 'PROVIDER_FAILED'}, undefined];
+  const observed = [] as Array<{count: number; hookError: Error | undefined; callerRejection: unknown}>;
+
+  for (const rejection of rejections) {
+    let count = 0;
+    let hookError: Error | undefined;
+    let callerRejection: unknown = Symbol('not rejected');
+    const orchestrator = createChatOrchestrator(
+      rejectingProvider(rejection),
+      new PromptBuilder({identity: 'acceptance test'}),
+      undefined,
+      {
+        hooks: {
+          onError: async (_session, error) => {
+            count += 1;
+            hookError = error;
+          },
+        },
+      }
+    );
+
+    try {
+      await orchestrator.processMessage(createSession());
+    } catch (error) {
+      callerRejection = error;
+    }
+
+    observed.push({count, hookError, callerRejection});
+  }
+
+  expect(observed).toHaveLength(rejections.length);
+  for (const [index, rejection] of rejections.entries()) {
+    const result = observed[index];
+    expect(result.count).toBe(1);
+    expect(result.hookError).toBeInstanceOf(Error);
+    expect(result.hookError).toHaveProperty('cause', rejection);
+    expect(result.callerRejection).toBe(rejection);
+  }
+});