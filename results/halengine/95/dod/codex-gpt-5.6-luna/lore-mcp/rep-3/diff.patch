+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+  };
+}
+
+function createRejectingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const rejectionOf = (call: Promise<unknown>): Promise<unknown> =>
+  call.then(() => 'resolved without throwing').catch((error: unknown) => error);
+
+// Spec: specs/hal-engine-config-hooks/spec.md#10
+describe('ChatOrchestrator onError acceptance', () => {
+  it('wraps every non-Error rejection for onError while preserving the caller rejection', async () => {
+    const rejections: unknown[] = ['provider failed', {code: 'RATE_LIMITED'}, undefined];
+    const observations = [] as Array<{
+      onErrorCallCount: number;
+      receivedErrorIsError: boolean;
+      receivedCause: unknown;
+      callerRejection: unknown;
+    }>;
+
+    for (const rejection of rejections) {
+      let onErrorCallCount = 0;
+      let receivedError: unknown;
+      const orchestrator = createChatOrchestrator(createRejectingProvider(rejection), promptBuilder, undefined, {
+        hooks: {
+          onError: async (_session, error) => {
+            onErrorCallCount += 1;
+            receivedError = error;
+          },
+        },
+      });
+
+      observations.push({
+        onErrorCallCount,
+        receivedErrorIsError: receivedError instanceof Error,
+        receivedCause: receivedError instanceof Error ? receivedError.cause : 'not an Error',
+        callerRejection: await rejectionOf(orchestrator.processMessage(createSession())),
+      });
+    }
+
+    expect(observations).toEqual([
+      {
+        onErrorCallCount: 1,
+        receivedErrorIsError: true,
+        receivedCause: rejections[0],
+        callerRejection: rejections[0],
+      },
+      {
+        onErrorCallCount: 1,
+        receivedErrorIsError: true,
+        receivedCause: rejections[1],
+        callerRejection: rejections[1],
+      },
+      {
+        onErrorCallCount: 1,
+        receivedErrorIsError: true,
+        receivedCause: rejections[2],
+        callerRejection: rejections[2],
+      },
+    ]);
+  });
+});