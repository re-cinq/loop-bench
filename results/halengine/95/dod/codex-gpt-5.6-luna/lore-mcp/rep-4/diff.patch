+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const session: ChatSession = {
+  sessionId: 'acceptance-session',
+  userId: 'acceptance-user',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function rejectingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+describe('onError for non-Error provider rejections', () => {
+  it('calls onError with a caused Error while preserving the original caller rejection', async () => {
+    const rejections: unknown[] = ['provider failed', {code: 'PROVIDER_FAILED'}, undefined];
+
+    for (const rejection of rejections) {
+      const receivedErrors: Error[] = [];
+      const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {
+        hooks: {
+          onError: async (_session, error) => {
+            receivedErrors.push(error);
+          },
+        },
+      });
+
+      let callerRejection: unknown;
+      try {
+        await orchestrator.processMessage(session);
+      } catch (error) {
+        callerRejection = error;
+      }
+
+      expect(receivedErrors).toHaveLength(1);
+      expect(receivedErrors[0]).toBeInstanceOf(Error);
+      expect(receivedErrors[0]?.cause).toBe(rejection);
+      expect(callerRejection).toBe(rejection);
+    }
+  });
+});