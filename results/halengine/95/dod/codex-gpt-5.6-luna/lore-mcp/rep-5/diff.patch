+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const session: ChatSession = {
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+function rejectingProvider(rejection: unknown): AIProvider {
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+async function rejectionOf(call: Promise<unknown>): Promise<unknown> {
+  try {
+    await call;
+    return 'resolved without throwing';
+  } catch (error) {
+    return error;
+  }
+}
+
+// spec: specs/hal-engine-config-hooks/spec.md#9
+it('calls onError with wrapped non-Error rejections while rethrowing the original value', async () => {
+  const rejections: unknown[] = ['provider failed', {code: 'PROVIDER_FAILED'}, undefined];
+
+  for (const rejection of rejections) {
+    const received: Error[] = [];
+    const orchestrator = createChatOrchestrator(
+      rejectingProvider(rejection),
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      undefined,
+      {hooks: {onError: async (_session, error) => void received.push(error)}}
+    );
+
+    const callerRejection = await rejectionOf(orchestrator.processMessage(session));
+
+    expect({
+      onErrorCallCount: received.length,
+      onErrorReceivedError: received[0] instanceof Error,
+      onErrorCauseIsOriginal: received[0]?.cause === rejection,
+      callerReceivedOriginal: callerRejection === rejection,
+    }).toEqual({
+      onErrorCallCount: 1,
+      onErrorReceivedError: true,
+      onErrorCauseIsOriginal: true,
+      callerReceivedOriginal: true,
+    });
+  }
+});