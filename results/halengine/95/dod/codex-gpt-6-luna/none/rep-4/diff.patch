+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// @spec specs/hal-engine-config-hooks/spec.md#1
+describe('onError for non-Error provider rejections', () => {
+  it('reports a wrapped Error with the original cause and preserves each rejection for the caller', async () => {
+    const rejections: unknown[] = ['provider failed', {code: 'BROKEN'}, undefined];
+
+    for (const rejection of rejections) {
+      let onErrorCalls = 0;
+      let hookError: Error | undefined;
+      const provider: AIProvider = {
+        // eslint-disable-next-line require-yield
+        async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+          throw rejection;
+        },
+        async generateStructured<T>(): Promise<T> {
+          return {} as T;
+        },
+      };
+      const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), undefined, {
+        hooks: {
+          onError: async (_session, error) => {
+            onErrorCalls += 1;
+            hookError = error;
+          },
+        },
+      });
+      const session: ChatSession = {
+        sessionId: 's1',
+        userId: 'u1',
+        entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+      };
+
+      let callerRejection: unknown;
+      try {
+        await orchestrator.processMessage(session);
+      } catch (error) {
+        callerRejection = error;
+      }
+
+      expect(onErrorCalls).toBe(1);
+      expect(hookError).toBeInstanceOf(Error);
+      expect(hookError?.cause).toBe(rejection);
+      expect(callerRejection).toBe(rejection);
+    }
+  });
+});