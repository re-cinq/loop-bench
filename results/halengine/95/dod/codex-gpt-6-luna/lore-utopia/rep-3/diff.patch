+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+
+// spec: specs/hal-engine-config-hooks/spec.md#8
+it('calls onError for every non-Error rejection and preserves the caller rejection', async () => {
+  const rejectedValues: unknown[] = ['provider failed', {code: 'E_PROVIDER'}, undefined];
+
+  for (const rejectedValue of rejectedValues) {
+    let observedError: Error | undefined;
+    let onErrorCalls = 0;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCalls += 1;
+        observedError = error;
+      },
+    };
+    const provider: AIProvider = {
+      async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        throw rejectedValue;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const session: ChatSession = {
+      sessionId: 'acceptance-session',
+      userId: 'acceptance-user',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const orchestrator = createChatOrchestrator(
+      provider,
+      new PromptBuilder({identity: 'Acceptance test assistant'}),
+      undefined,
+      {hooks}
+    );
+
+    let callerReceived: unknown = Symbol('not rejected');
+    try {
+      await orchestrator.processMessage(session);
+    } catch (error) {
+      callerReceived = error;
+    }
+
+    expect({
+      onErrorCalls,
+      observedErrorIsError: observedError instanceof Error,
+      observedCause: observedError?.cause,
+      callerReceived,
+    }).toEqual({
+      onErrorCalls: 1,
+      observedErrorIsError: true,
+      observedCause: rejectedValue,
+      callerReceived: rejectedValue,
+    });
+  }
+});