+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createRejectingProvider(reason: unknown): AIProvider {
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      throw reason;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+describe('non-Error provider rejections', () => {
+  it('calls onError with a caused Error and preserves the original rejection for the caller', async () => {
+    const reasons: unknown[] = ['provider failed', {code: 'PROVIDER_FAILED'}, undefined];
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+    };
+
+    for (const reason of reasons) {
+      const receivedErrors: Error[] = [];
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          receivedErrors.push(error);
+        },
+      };
+      const orchestrator = createChatOrchestrator(
+        createRejectingProvider(reason),
+        new PromptBuilder({identity: 'You are a test assistant.'}),
+        undefined,
+        {hooks}
+      );
+
+      let callerReason: unknown;
+      try {
+        await orchestrator.processMessage(session);
+      } catch (error) {
+        callerReason = error;
+      }
+
+      expect(receivedErrors).toHaveLength(1);
+      expect(receivedErrors[0]).toBeInstanceOf(Error);
+      expect(receivedErrors[0].cause).toBe(reason);
+      expect(callerReason).toBe(reason);
+    }
+
+    const existingError = new Error('already an Error');
+    let receivedError: Error | undefined;
+    const orchestrator = createChatOrchestrator(
+      createRejectingProvider(existingError),
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      undefined,
+      {hooks: {onError: async (_session, error) => (receivedError = error)}}
+    );
+    let callerError: unknown;
+    try {
+      await orchestrator.processMessage(session);
+    } catch (error) {
+      callerError = error;
+    }
+
+    expect(receivedError).toBe(existingError);
+    expect(callerError).toBe(existingError);
+  });
+});