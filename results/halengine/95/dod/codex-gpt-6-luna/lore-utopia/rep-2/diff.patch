+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+  };
+}
+
+function rejectingProvider(rejection: unknown): AIProvider {
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+describe('ChatOrchestrator non-Error rejections', () => {
+  it('calls onError with an Error whose cause is the original rejection and rethrows it unchanged', async () => {
+    const outcomes: Array<{
+      onErrorCalls: number;
+      hookedErrorIsError: boolean;
+      causeMatches: boolean;
+      callerValueMatches: boolean;
+    }> = [];
+
+    for (const rejection of ['provider failure', {code: 'PROVIDER_FAILURE'}, undefined]) {
+      let onErrorCalls = 0;
+      let hookedError: Error | undefined;
+      const onError: NonNullable<OrchestratorHooks['onError']> = async (_session, error) => {
+        onErrorCalls += 1;
+        hookedError = error;
+      };
+      const orchestrator = createChatOrchestrator(
+        rejectingProvider(rejection),
+        new PromptBuilder({identity: 'You are a test assistant.'}),
+        undefined,
+        {hooks: {onError}}
+      );
+
+      let received: unknown;
+      try {
+        await orchestrator.processMessage(createSession());
+      } catch (error) {
+        received = error;
+      }
+
+      outcomes.push({
+        onErrorCalls,
+        hookedErrorIsError: hookedError instanceof Error,
+        causeMatches: hookedError?.cause === rejection,
+        callerValueMatches: received === rejection,
+      });
+    }
+
+    expect(outcomes).toEqual([
+      {onErrorCalls: 1, hookedErrorIsError: true, causeMatches: true, callerValueMatches: true},
+      {onErrorCalls: 1, hookedErrorIsError: true, causeMatches: true, callerValueMatches: true},
+      {onErrorCalls: 1, hookedErrorIsError: true, causeMatches: true, callerValueMatches: true},
+    ]);
+  });
+});