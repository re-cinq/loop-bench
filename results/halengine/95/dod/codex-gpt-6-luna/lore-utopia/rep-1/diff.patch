+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const rejectedValues = ['provider failed', {code: 'PROVIDER_FAILED'}, undefined];
+
+const rejectingProvider = (rejection: unknown): AIProvider => ({
+  async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+const session: ChatSession = {
+  sessionId: 'acceptance-session',
+  userId: 'acceptance-user',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+describe('non-Error provider rejections', () => {
+  // @spec specs/hal-engine-config-hooks/spec.md#9
+  it('calls onError for non-Error provider rejections and preserves each value', async () => {
+    for (const rejection of rejectedValues) {
+      const errors: Error[] = [];
+      const orchestrator = createChatOrchestrator(
+        rejectingProvider(rejection),
+        new PromptBuilder({identity: 'test'}),
+        undefined,
+        {hooks: {onError: async (_session, error) => void errors.push(error)}}
+      );
+
+      await expect(orchestrator.processMessage(session)).rejects.toBe(rejection);
+
+      expect(errors).toHaveLength(1);
+      expect(errors[0]).toBeInstanceOf(Error);
+      expect(errors[0].cause).toBe(rejection);
+    }
+  });
+});