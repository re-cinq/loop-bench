+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// spec: specs/hal-engine-config-hooks/spec.md#9
+const session: ChatSession = {
+  sessionId: 'acceptance-session',
+  userId: 'acceptance-user',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+const providerRejecting = (rejection: unknown): AIProvider => ({
+  async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+describe('onError for non-Error rejections', () => {
+  it('calls onError for non-Error provider rejections and preserves original caller values', async () => {
+    const rejections: unknown[] = [
+      'provider rejected',
+      {code: 'PROVIDER_FAILURE'},
+      undefined,
+      new Error('existing error'),
+    ];
+
+    for (const rejection of rejections) {
+      let callCount = 0;
+      let receivedError: Error | undefined;
+      const orchestrator = createChatOrchestrator(
+        providerRejecting(rejection),
+        new PromptBuilder({identity: 'test'}),
+        undefined,
+        {
+          hooks: {
+            onError: async (_session, error) => {
+              callCount += 1;
+              receivedError = error;
+            },
+          },
+        }
+      );
+
+      const callerRejection = await orchestrator.processMessage(session).catch(reason => reason);
+
+      expect(callCount).toBe(1);
+      expect(receivedError).toBeInstanceOf(Error);
+      if (rejection instanceof Error) {
+        expect(receivedError).toBe(rejection);
+      } else {
+        expect(receivedError?.cause).toBe(rejection);
+      }
+      expect(callerRejection).toBe(rejection);
+    }
+  });
+});