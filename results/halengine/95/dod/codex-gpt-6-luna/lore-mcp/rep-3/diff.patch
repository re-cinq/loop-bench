+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const session: ChatSession = {
+  sessionId: 'acceptance-session',
+  userId: 'acceptance-user',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function rejectingProvider(rejection: unknown): AIProvider {
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+describe('chat orchestrator acceptance', () => {
+  it.each([
+    ['a string', 'provider failed'],
+    ['a plain object', {code: 'PROVIDER_FAILED'}],
+    ['undefined', undefined],
+  ])('calls onError for %s and rethrows the original rejection unchanged', async (_description, rejection) => {
+    let hookCalls = 0;
+    let hookError: Error | undefined;
+    const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {
+      hooks: {
+        onError: async (_session, error) => {
+          hookCalls += 1;
+          hookError = error;
+        },
+      },
+    });
+
+    let callerRejection: unknown;
+    try {
+      await orchestrator.processMessage(session);
+    } catch (error) {
+      callerRejection = error;
+    }
+
+    expect({hookCalls, hookError: hookError instanceof Error, cause: hookError?.cause, callerRejection}).toEqual({
+      hookCalls: 1,
+      hookError: true,
+      cause: rejection,
+      callerRejection: rejection,
+    });
+  });
+});