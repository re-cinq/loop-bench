+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+const session: ChatSession = {
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('onError for non-Error rejections', () => {
+  it('calls the hook with an Error caused by the rejection and preserves the original rejection', async () => {
+    for (const rejection of ['provider failed', {code: 'FAILED'}, undefined]) {
+      let hookCalls = 0;
+      let hookError: Error | undefined;
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          hookCalls += 1;
+          hookError = error;
+        },
+      };
+      const provider: AIProvider = {
+        async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+          throw rejection;
+        },
+        async generateStructured<T>(): Promise<T> {
+          return {} as T;
+        },
+      };
+      let callerRejection: unknown;
+
+      try {
+        await createChatOrchestrator(provider, promptBuilder, undefined, {hooks}).processMessage(session);
+      } catch (error) {
+        callerRejection = error;
+      }
+
+      expect({hookCalls, hookError: hookError instanceof Error, cause: hookError?.cause, callerRejection}).toEqual({
+        hookCalls: 1,
+        hookError: true,
+        cause: rejection,
+        callerRejection: rejection,
+      });
+    }
+  });
+});