+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+const session: ChatSession = {
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+describe('non-Error provider rejections', () => {
+  it('calls onError with an Error caused by the rejection and rethrows the original value', async () => {
+    const rejectedValues: unknown[] = ['provider failed', {code: 'PROVIDER_FAILURE'}, undefined];
+
+    for (const rejectedValue of rejectedValues) {
+      const onErrorValues: Error[] = [];
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          onErrorValues.push(error);
+        },
+      };
+      const provider: AIProvider = {
+        // eslint-disable-next-line require-yield
+        async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+          throw rejectedValue;
+        },
+        async generateStructured<T>(): Promise<T> {
+          return {} as T;
+        },
+      };
+      const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), undefined, {hooks});
+      let callerValue: unknown;
+
+      try {
+        await orchestrator.processMessage(session);
+      } catch (error) {
+        callerValue = error;
+      }
+
+      expect(onErrorValues).toHaveLength(1);
+      expect(onErrorValues[0]).toBeInstanceOf(Error);
+      expect(onErrorValues[0].cause).toBe(rejectedValue);
+      expect(callerValue).toBe(rejectedValue);
+    }
+  });
+});