+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const session: ChatSession = {
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+function rejectingProvider(reason: unknown): AIProvider {
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      throw reason;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+describe('onError for non-Error provider rejections', () => {
+  // @spec specs/hal-engine-config-hooks/spec.md#9
+  it.each([
+    ['a string', 'provider failed'],
+    ['a plain object', {code: 'PROVIDER_FAILED'}],
+    ['undefined', undefined],
+  ])('calls onError with a cause-wrapped Error and preserves %s for the caller', async (_label, reason) => {
+    const hookErrors: Error[] = [];
+    const hooks = {
+      onError: async (_session: ChatSession, error: Error) => {
+        hookErrors.push(error);
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      rejectingProvider(reason),
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      undefined,
+      {hooks}
+    );
+
+    let callerReason: unknown;
+    try {
+      await orchestrator.processMessage(session);
+    } catch (error) {
+      callerReason = error;
+    }
+
+    expect(hookErrors).toHaveLength(1);
+    expect(hookErrors[0]).toBeInstanceOf(Error);
+    expect(hookErrors[0].cause).toBe(reason);
+    expect(callerReason).toBe(reason);
+  });
+});