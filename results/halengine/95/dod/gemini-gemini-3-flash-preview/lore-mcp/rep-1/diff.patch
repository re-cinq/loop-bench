+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const outcomeOf = async (call: Promise<unknown>): Promise<unknown> => {
+  try {
+    const result = await call;
+    // If it's a generator, we need to consume it to trigger the provider's throw
+    if (result && typeof result === 'object' && Symbol.asyncIterator in result) {
+      const gen = result as AsyncGenerator;
+      // eslint-disable-next-line @typescript-eslint/no-unused-vars
+      for await (const _ of gen) {
+        // consume
+      }
+    }
+    return 'resolved without throwing';
+  } catch (error) {
+    return error;
+  }
+};
+
+describe('onError rejection acceptance tests', () => {
+  it('rejects with a string calls onError with a wrapped Error', async () => {
+    let capturedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        capturedError = error;
+      },
+    };
+
+    const provider: AIProvider = {
+      // eslint-disable-next-line require-yield
+      async *sendMessage() {
+        throw 'string boom';
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+    expect(outcome).toBe('string boom');
+    expect(capturedError).toBeInstanceOf(Error);
+    expect(capturedError?.cause).toBe('string boom');
+  });
+
+  it('rejects with a plain object calls onError with a wrapped Error', async () => {
+    const errorObj = {reason: 'object boom'};
+    let capturedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        capturedError = error;
+      },
+    };
+
+    const provider: AIProvider = {
+      // eslint-disable-next-line require-yield
+      async *sendMessage() {
+        throw errorObj;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+    expect(outcome).toBe(errorObj);
+    expect(capturedError).toBeInstanceOf(Error);
+    expect(capturedError?.cause).toBe(errorObj);
+  });
+
+  it('rejects with undefined calls onError with a wrapped Error', async () => {
+    let capturedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        capturedError = error;
+      },
+    };
+
+    const provider: AIProvider = {
+      // eslint-disable-next-line require-yield
+      async *sendMessage() {
+        throw undefined;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+    expect(outcome).toBeUndefined();
+    expect(capturedError).toBeInstanceOf(Error);
+    expect(capturedError?.cause).toBeUndefined();
+  });
+
+  it('rejects with an Error instance calls onError with the same instance', async () => {
+    const errorInst = new Error('instance boom');
+    let capturedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        capturedError = error;
+      },
+    };
+
+    const provider: AIProvider = {
+      // eslint-disable-next-line require-yield
+      async *sendMessage() {
+        throw errorInst;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+    expect(outcome).toBe(errorInst);
+    expect(capturedError).toBe(errorInst);
+  });
+});