+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {AIError} from '../types/ai.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+const session: ChatSession = {
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: new Date().toISOString()}],
+};
+
+function createRejectingProvider(reason: unknown): AIProvider {
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw reason;
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw reason;
+    },
+  };
+}
+
+describe('onError acceptance tests', () => {
+  it('calls onError for string rejection', async () => {
+    let capturedError: Error | undefined;
+    const hooks = {
+      onError: async (_session: ChatSession, error: Error) => {
+        capturedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createRejectingProvider('string boom'), promptBuilder, undefined, {
+      hooks,
+    });
+
+    let thrown: unknown;
+    try {
+      await orchestrator.processMessage(session);
+    } catch (e) {
+      thrown = e;
+    }
+
+    // This should FAIL now because onError is gated by instanceof Error
+    expect(capturedError).toBeDefined();
+    expect(capturedError).toBeInstanceOf(Error);
+    expect(capturedError?.cause).toBe('string boom');
+    expect(thrown).toBe('string boom');
+  });
+
+  it('calls onError for object rejection', async () => {
+    const reason = {foo: 'bar'};
+    let capturedError: Error | undefined;
+    const hooks = {
+      onError: async (_session: ChatSession, error: Error) => {
+        capturedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createRejectingProvider(reason), promptBuilder, undefined, {hooks});
+
+    let thrown: unknown;
+    try {
+      await orchestrator.processMessage(session);
+    } catch (e) {
+      thrown = e;
+    }
+
+    expect(capturedError).toBeDefined();
+    expect(capturedError).toBeInstanceOf(Error);
+    expect(capturedError?.cause).toBe(reason);
+    expect(thrown).toBe(reason);
+  });
+
+  it('calls onError for undefined rejection', async () => {
+    let capturedError: Error | undefined;
+    const hooks = {
+      onError: async (_session: ChatSession, error: Error) => {
+        capturedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createRejectingProvider(undefined), promptBuilder, undefined, {hooks});
+
+    let thrown: unknown;
+    let threw = false;
+    try {
+      await orchestrator.processMessage(session);
+    } catch (e) {
+      thrown = e;
+      threw = true;
+    }
+
+    expect(threw).toBe(true);
+    expect(thrown).toBeUndefined();
+    expect(capturedError).toBeDefined();
+    expect(capturedError).toBeInstanceOf(Error);
+    expect(capturedError?.cause).toBeUndefined();
+  });
+
+  it('passes Error instances unchanged', async () => {
+    const error = new AIError('ai boom', 'SERVICE_ERROR');
+    let capturedError: Error | undefined;
+    const hooks = {
+      onError: async (_session: ChatSession, error: Error) => {
+        capturedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createRejectingProvider(error), promptBuilder, undefined, {hooks});
+
+    let thrown: unknown;
+    try {
+      await orchestrator.processMessage(session);
+    } catch (e) {
+      thrown = e;
+    }
+
+    expect(capturedError).toBe(error);
+    expect(thrown).toBe(error);
+  });
+});