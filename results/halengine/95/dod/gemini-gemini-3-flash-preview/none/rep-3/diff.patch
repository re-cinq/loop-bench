+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('onError acceptance tests', () => {
+  it('calls onError for string rejection', async () => {
+    let capturedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        capturedError = error;
+      },
+    };
+
+    const provider: AIProvider = {
+      async *sendMessage() {
+        throw 'string rejection';
+      },
+      async generateStructured<T>() {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+
+    let thrownValue: any;
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (e) {
+      thrownValue = e;
+    }
+
+    expect(thrownValue).toBe('string rejection');
+    expect(capturedError).toBeInstanceOf(Error);
+    expect(capturedError?.message).toBe('string rejection');
+    expect((capturedError as any).cause).toBe('string rejection');
+  });
+
+  it('calls onError for object rejection', async () => {
+    const rejection = {foo: 'bar'};
+    let capturedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        capturedError = error;
+      },
+    };
+
+    const provider: AIProvider = {
+      async *sendMessage() {
+        throw rejection;
+      },
+      async generateStructured<T>() {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+
+    let thrownValue: any;
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (e) {
+      thrownValue = e;
+    }
+
+    expect(thrownValue).toBe(rejection);
+    expect(capturedError).toBeInstanceOf(Error);
+    expect((capturedError as any).cause).toBe(rejection);
+  });
+
+  it('calls onError for undefined rejection', async () => {
+    let capturedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        capturedError = error;
+      },
+    };
+
+    const provider: AIProvider = {
+      async *sendMessage() {
+        throw undefined;
+      },
+      async generateStructured<T>() {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+
+    let thrownValue: any;
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (e) {
+      thrownValue = e;
+    }
+
+    expect(thrownValue).toBe(undefined);
+    expect(capturedError).toBeInstanceOf(Error);
+    expect((capturedError as any).cause).toBe(undefined);
+  });
+
+  it('calls onError for Error rejection as same instance', async () => {
+    const error = new Error('standard error');
+    let capturedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, e) => {
+        capturedError = e;
+      },
+    };
+
+    const provider: AIProvider = {
+      async *sendMessage() {
+        throw error;
+      },
+      async generateStructured<T>() {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+
+    let thrownValue: any;
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (e) {
+      thrownValue = e;
+    }
+
+    expect(thrownValue).toBe(error);
+    expect(capturedError).toBe(error);
+  });
+});