+import {jest} from '@jest/globals';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {SessionStore} from '../types/sessionStore.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+  };
+}
+
+const mockSessionStore: SessionStore = {
+  create: jest.fn<SessionStore['create']>(),
+  get: jest.fn<SessionStore['get']>(),
+  delete: jest.fn<SessionStore['delete']>(),
+  count: jest.fn<SessionStore['count']>(),
+  clear: jest.fn<SessionStore['clear']>(),
+  save: jest.fn<SessionStore['save']>(),
+};
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('chatOrchestrator acceptance tests', () => {
+  it('calls onError for a string rejection', async () => {
+    const errorValue = 'something went wrong';
+    const provider: AIProvider = {
+      // eslint-disable-next-line require-yield
+      async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        throw errorValue;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    let capturedError: Error | undefined;
+    const hooks = {
+      onError: async (_session: ChatSession, error: Error) => {
+        capturedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {
+      hooks,
+      sessionStore: mockSessionStore,
+    });
+
+    let thrownValue: unknown;
+    try {
+      await orchestrator.processMessage(createSession());
+    } catch (e) {
+      thrownValue = e;
+    }
+
+    expect(thrownValue).toBe(errorValue);
+    expect(capturedError).toBeInstanceOf(Error);
+    expect(capturedError?.cause).toBe(errorValue);
+  });
+
+  it('calls onError for a plain object rejection', async () => {
+    const errorValue = {message: 'failed', code: 500};
+    const provider: AIProvider = {
+      // eslint-disable-next-line require-yield
+      async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        throw errorValue;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    let capturedError: Error | undefined;
+    const hooks = {
+      onError: async (_session: ChatSession, error: Error) => {
+        capturedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {
+      hooks,
+      sessionStore: mockSessionStore,
+    });
+
+    let thrownValue: unknown;
+    try {
+      await orchestrator.processMessage(createSession());
+    } catch (e) {
+      thrownValue = e;
+    }
+
+    expect(thrownValue).toBe(errorValue);
+    expect(capturedError).toBeInstanceOf(Error);
+    expect(capturedError?.cause).toBe(errorValue);
+  });
+
+  it('calls onError for an undefined rejection', async () => {
+    const errorValue = undefined;
+    const provider: AIProvider = {
+      // eslint-disable-next-line require-yield
+      async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        throw errorValue;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    let capturedError: Error | undefined;
+    const hooks = {
+      onError: async (_session: ChatSession, error: Error) => {
+        capturedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {
+      hooks,
+      sessionStore: mockSessionStore,
+    });
+
+    let thrownValue: unknown;
+    try {
+      await orchestrator.processMessage(createSession());
+    } catch (e) {
+      thrownValue = e;
+    }
+
+    expect(thrownValue).toBe(errorValue);
+    expect(capturedError).toBeInstanceOf(Error);
+    expect(capturedError?.cause).toBe(errorValue);
+  });
+
+  it('calls onError for an Error instance rejection', async () => {
+    const errorValue = new Error('real error');
+    const provider: AIProvider = {
+      // eslint-disable-next-line require-yield
+      async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        throw errorValue;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    let capturedError: Error | undefined;
+    const hooks = {
+      onError: async (_session: ChatSession, error: Error) => {
+        capturedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {
+      hooks,
+      sessionStore: mockSessionStore,
+    });
+
+    let thrownValue: unknown;
+    try {
+      await orchestrator.processMessage(createSession());
+    } catch (e) {
+      thrownValue = e;
+    }
+
+    expect(thrownValue).toBe(errorValue);
+    expect(capturedError).toBe(errorValue); // Should be the same instance
+  });
+});