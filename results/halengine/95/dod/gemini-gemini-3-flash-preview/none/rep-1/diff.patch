+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function createRejectingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator onError acceptance', () => {
+  // specs/hal-engine-config-hooks/spec.md#1
+  it('calls onError with a wrapped Error when provider rejects with a string', async () => {
+    let receivedError: Error | undefined;
+    const hooks = {
+      onError: async (_session: ChatSession, error: Error) => {
+        receivedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createRejectingProvider('string boom'), promptBuilder, undefined, {
+      hooks,
+    });
+
+    let caught: unknown;
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (e) {
+      caught = e;
+    }
+
+    // The caller still receives the original rejection unchanged
+    expect(caught).toBe('string boom');
+
+    // onError is called with an Error whose cause is that string
+    expect(receivedError).toBeInstanceOf(Error);
+    expect(receivedError?.cause).toBe('string boom');
+  });
+
+  // specs/hal-engine-config-hooks/spec.md#2
+  it('calls onError with a wrapped Error when provider rejects with a plain object', async () => {
+    const errorObj = {code: 'BUSY', msg: 'system overloaded'};
+    let receivedError: Error | undefined;
+    const hooks = {
+      onError: async (_session: ChatSession, error: Error) => {
+        receivedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createRejectingProvider(errorObj), promptBuilder, undefined, {hooks});
+
+    let caught: unknown;
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (e) {
+      caught = e;
+    }
+
+    expect(caught).toBe(errorObj);
+    expect(receivedError).toBeInstanceOf(Error);
+    expect(receivedError?.cause).toBe(errorObj);
+  });
+
+  // specs/hal-engine-config-hooks/spec.md#3
+  it('calls onError with a wrapped Error when provider rejects with undefined', async () => {
+    let receivedError: Error | undefined;
+    const hooks = {
+      onError: async (_session: ChatSession, error: Error) => {
+        receivedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createRejectingProvider(undefined), promptBuilder, undefined, {hooks});
+
+    let caught: unknown;
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (e) {
+      caught = e;
+    }
+
+    expect(caught).toBe(undefined);
+    expect(receivedError).toBeInstanceOf(Error);
+    expect(receivedError?.cause).toBe(undefined);
+  });
+
+  // specs/hal-engine-config-hooks/spec.md#4
+  it('calls onError with the same instance when provider rejects with an Error', async () => {
+    const originalError = new Error('original boom');
+    let receivedError: Error | undefined;
+    const hooks = {
+      onError: async (_session: ChatSession, error: Error) => {
+        receivedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createRejectingProvider(originalError), promptBuilder, undefined, {
+      hooks,
+    });
+
+    let caught: unknown;
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (e) {
+      caught = e;
+    }
+
+    expect(caught).toBe(originalError);
+    expect(receivedError).toBe(originalError);
+  });
+});