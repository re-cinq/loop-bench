+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: new Date().toISOString()}],
+  };
+}
+
+function createRejectingProvider(reason: any): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw reason;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+describe('onError acceptance tests', () => {
+  it('calls onError for string rejection', async () => {
+    // specs/hal-engine-config-hooks/spec.md#1
+    const reason = 'string boom';
+    let reportedError: any;
+    const hooks = {
+      onError: async (_session: ChatSession, error: Error) => {
+        reportedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createRejectingProvider(reason), promptBuilder, undefined, {hooks});
+
+    let caught: any;
+    try {
+      await orchestrator.processMessage(createSession());
+    } catch (e) {
+      caught = e;
+    }
+
+    expect(caught).toBe(reason);
+    expect(reportedError).toBeInstanceOf(Error);
+    expect(reportedError.message).toBe('Rejection that is not an Error');
+    expect(reportedError.cause).toBe(reason);
+  });
+
+  it('calls onError for object rejection', async () => {
+    // specs/hal-engine-config-hooks/spec.md#2
+    const reason = {error: 'object boom'};
+    let reportedError: any;
+    const hooks = {
+      onError: async (_session: ChatSession, error: Error) => {
+        reportedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createRejectingProvider(reason), promptBuilder, undefined, {hooks});
+
+    let caught: any;
+    try {
+      await orchestrator.processMessage(createSession());
+    } catch (e) {
+      caught = e;
+    }
+
+    expect(caught).toBe(reason);
+    expect(reportedError).toBeInstanceOf(Error);
+    expect(reportedError.message).toBe('Rejection that is not an Error');
+    expect(reportedError.cause).toBe(reason);
+  });
+
+  it('calls onError for undefined rejection', async () => {
+    // specs/hal-engine-config-hooks/spec.md#3
+    const reason = undefined;
+    let reportedError: any;
+    const hooks = {
+      onError: async (_session: ChatSession, error: Error) => {
+        reportedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createRejectingProvider(reason), promptBuilder, undefined, {hooks});
+
+    let caught: any;
+    try {
+      await orchestrator.processMessage(createSession());
+    } catch (e) {
+      caught = e;
+    }
+
+    expect(caught).toBe(reason);
+    expect(reportedError).toBeInstanceOf(Error);
+    expect(reportedError.message).toBe('Rejection that is not an Error');
+    expect(reportedError.cause).toBe(reason);
+  });
+
+  it('calls onError for null rejection', async () => {
+    // specs/hal-engine-config-hooks/spec.md#4
+    const reason = null;
+    let reportedError: any;
+    const hooks = {
+      onError: async (_session: ChatSession, error: Error) => {
+        reportedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createRejectingProvider(reason), promptBuilder, undefined, {hooks});
+
+    let caught: any;
+    try {
+      await orchestrator.processMessage(createSession());
+    } catch (e) {
+      caught = e;
+    }
+
+    expect(caught).toBe(reason);
+    expect(reportedError).toBeInstanceOf(Error);
+    expect(reportedError.message).toBe('Rejection that is not an Error');
+    expect(reportedError.cause).toBe(reason);
+  });
+
+  it('passes through Error rejection', async () => {
+    // specs/hal-engine-config-hooks/spec.md#5
+    const reason = new Error('error boom');
+    let reportedError: any;
+    const hooks = {
+      onError: async (_session: ChatSession, error: Error) => {
+        reportedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createRejectingProvider(reason), promptBuilder, undefined, {hooks});
+
+    let caught: any;
+    try {
+      await orchestrator.processMessage(createSession());
+    } catch (e) {
+      caught = e;
+    }
+
+    expect(caught).toBe(reason);
+    expect(reportedError).toBe(reason);
+  });
+});