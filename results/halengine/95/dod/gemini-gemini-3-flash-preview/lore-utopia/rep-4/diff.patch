+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function createRejectingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('onError for non-Error rejections', () => {
+  // specs/hal-engine-config-hooks/spec.md#9
+  it('calls onError for string rejection', async () => {
+    let callCount = 0;
+    let capturedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        callCount++;
+        capturedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createRejectingProvider('string boom'), promptBuilder, undefined, {
+      hooks,
+    });
+
+    let outcome: unknown;
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (e) {
+      outcome = e;
+    }
+
+    expect(outcome).toBe('string boom');
+    expect(callCount).toBe(1);
+    expect(capturedError).toBeInstanceOf(Error);
+    expect(capturedError?.message).toBe('string boom');
+    expect(capturedError?.cause).toBe('string boom');
+  });
+
+  // specs/hal-engine-config-hooks/spec.md#9
+  it('calls onError for object rejection', async () => {
+    const rejection = {reason: 'object boom'};
+    let callCount = 0;
+    let capturedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        callCount++;
+        capturedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createRejectingProvider(rejection), promptBuilder, undefined, {hooks});
+
+    let outcome: unknown;
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (e) {
+      outcome = e;
+    }
+
+    expect(outcome).toBe(rejection);
+    expect(callCount).toBe(1);
+    expect(capturedError).toBeInstanceOf(Error);
+    expect(capturedError?.cause).toBe(rejection);
+  });
+
+  // specs/hal-engine-config-hooks/spec.md#9
+  it('calls onError for undefined rejection', async () => {
+    let callCount = 0;
+    let capturedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        callCount++;
+        capturedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createRejectingProvider(undefined), promptBuilder, undefined, {hooks});
+
+    let outcome: unknown;
+    let thrown = false;
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (e) {
+      outcome = e;
+      thrown = true;
+    }
+
+    expect(thrown).toBe(true);
+    expect(outcome).toBeUndefined();
+    expect(callCount).toBe(1);
+    expect(capturedError).toBeInstanceOf(Error);
+    expect(capturedError?.cause).toBeUndefined();
+  });
+
+  // specs/hal-engine-config-hooks/spec.md#9
+  it('calls onError for null rejection', async () => {
+    let callCount = 0;
+    let capturedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        callCount++;
+        capturedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createRejectingProvider(null), promptBuilder, undefined, {hooks});
+
+    let outcome: unknown;
+    let thrown = false;
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (e) {
+      outcome = e;
+      thrown = true;
+    }
+
+    expect(thrown).toBe(true);
+    expect(outcome).toBeNull();
+    expect(callCount).toBe(1);
+    expect(capturedError).toBeInstanceOf(Error);
+    expect(capturedError?.cause).toBeNull();
+  });
+
+  // specs/hal-engine-config-hooks/spec.md#9
+  it('passes Error instance directly to onError', async () => {
+    const error = new Error('actual error');
+    let callCount = 0;
+    let capturedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, e) => {
+        callCount++;
+        capturedError = e;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createRejectingProvider(error), promptBuilder, undefined, {hooks});
+
+    let outcome: unknown;
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (e) {
+      outcome = e;
+    }
+
+    expect(outcome).toBe(error);
+    expect(callCount).toBe(1);
+    expect(capturedError).toBe(error);
+  });
+});