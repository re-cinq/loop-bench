+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function createRejectingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('onError acceptance tests', () => {
+  // specs/hal-engine-config-hooks/spec.md#1
+  it('calls onError with a wrapped Error when a provider rejects with a string', async () => {
+    let capturedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        capturedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createRejectingProvider('string boom'), promptBuilder, undefined, {
+      hooks,
+    });
+
+    let thrownValue: unknown;
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (e) {
+      thrownValue = e;
+    }
+
+    expect(thrownValue).toBe('string boom');
+    expect(capturedError).toBeInstanceOf(Error);
+    expect(capturedError?.message).toBe('string boom');
+    expect(capturedError?.cause).toBe('string boom');
+  });
+
+  // specs/hal-engine-config-hooks/spec.md#2
+  it('calls onError with a wrapped Error when a provider rejects with a plain object', async () => {
+    const rejection = {foo: 'bar'};
+    let capturedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        capturedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createRejectingProvider(rejection), promptBuilder, undefined, {hooks});
+
+    let thrownValue: unknown;
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (e) {
+      thrownValue = e;
+    }
+
+    expect(thrownValue).toBe(rejection);
+    expect(capturedError).toBeInstanceOf(Error);
+    expect(capturedError?.cause).toBe(rejection);
+  });
+
+  // specs/hal-engine-config-hooks/spec.md#3
+  it('calls onError with a wrapped Error when a provider rejects with undefined', async () => {
+    let capturedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        capturedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createRejectingProvider(undefined), promptBuilder, undefined, {hooks});
+
+    let thrownValue: unknown;
+    let thrown = false;
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (e) {
+      thrownValue = e;
+      thrown = true;
+    }
+
+    expect(thrown).toBe(true);
+    expect(thrownValue).toBe(undefined);
+    expect(capturedError).toBeInstanceOf(Error);
+    expect(capturedError?.cause).toBe(undefined);
+  });
+
+  // specs/hal-engine-config-hooks/spec.md#4
+  it('calls onError with the original Error when a provider rejects with an Error', async () => {
+    const rejection = new Error('error boom');
+    let capturedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        capturedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createRejectingProvider(rejection), promptBuilder, undefined, {hooks});
+
+    let thrownValue: unknown;
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (e) {
+      thrownValue = e;
+    }
+
+    expect(thrownValue).toBe(rejection);
+    expect(capturedError).toBe(rejection);
+  });
+});