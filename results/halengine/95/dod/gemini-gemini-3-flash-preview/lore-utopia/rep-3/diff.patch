+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function createThrowingProvider(value: any): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw value;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+/**
+ * @spec specs/hal-engine-config-hooks/spec.md
+ */
+describe('onError Acceptance Tests', () => {
+  it('rejection with string calls onError with wrapped Error', async () => {
+    let receivedError: any;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        receivedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createThrowingProvider('string boom'), promptBuilder, undefined, {
+      hooks,
+    });
+
+    let callerError: any;
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (e) {
+      callerError = e;
+    }
+
+    expect(callerError).toBe('string boom');
+    expect(receivedError).toBeInstanceOf(Error);
+    expect(receivedError.message).toBe('string boom');
+    expect(receivedError.cause).toBe('string boom');
+  });
+
+  it('rejection with plain object calls onError with wrapped Error', async () => {
+    const errorObj = {code: 'OBJ_BOOM', detail: 'something went wrong'};
+    let receivedError: any;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        receivedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createThrowingProvider(errorObj), promptBuilder, undefined, {hooks});
+
+    let callerError: any;
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (e) {
+      callerError = e;
+    }
+
+    expect(callerError).toBe(errorObj);
+    expect(receivedError).toBeInstanceOf(Error);
+    expect(receivedError.cause).toBe(errorObj);
+  });
+
+  it('rejection with undefined calls onError with wrapped Error', async () => {
+    let receivedError: any;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        receivedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createThrowingProvider(undefined), promptBuilder, undefined, {hooks});
+
+    let callerError: any;
+    let threw = false;
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (e) {
+      callerError = e;
+      threw = true;
+    }
+
+    expect(threw).toBe(true);
+    expect(callerError).toBe(undefined);
+    expect(receivedError).toBeInstanceOf(Error);
+    expect(receivedError.cause).toBe(undefined);
+  });
+
+  it('rejection with Error reaches onError as same instance', async () => {
+    const originalError = new Error('error boom');
+    let receivedError: any;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        receivedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createThrowingProvider(originalError), promptBuilder, undefined, {
+      hooks,
+    });
+
+    let callerError: any;
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (e) {
+      callerError = e;
+    }
+
+    expect(callerError).toBe(originalError);
+    expect(receivedError).toBe(originalError);
+  });
+});