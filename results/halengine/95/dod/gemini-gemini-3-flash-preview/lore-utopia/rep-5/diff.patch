+import {expect, it, describe} from '@jest/globals';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+}
+
+function createRejectingProvider(value: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw value;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const rejectionOf = (promise: Promise<unknown>): Promise<unknown> => promise.catch(e => e);
+
+describe('onError (acceptance)', () => {
+  it('wraps a non-Error rejection in an Error whose cause is the original and still rejects the caller with the original', async () => {
+    const cases = [
+      {name: 'string', value: 'string boom'},
+      {name: 'object', value: {message: 'object boom', code: 500}},
+      {name: 'undefined', value: undefined},
+    ];
+
+    for (const {name, value} of cases) {
+      let receivedError: Error | undefined;
+      let onErrorCallCount = 0;
+
+      const hooks = {
+        onError: async (_session: ChatSession, error: Error) => {
+          onErrorCallCount++;
+          receivedError = error;
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(createRejectingProvider(value), promptBuilder, undefined, {hooks});
+      const rejection = await rejectionOf(orchestrator.processMessage(createSession(`test ${name}`)));
+
+      expect({
+        name,
+        onErrorCallCount,
+        isError: receivedError instanceof Error,
+        cause: receivedError?.cause,
+        rejection,
+      }).toEqual({
+        name,
+        onErrorCallCount: 1,
+        isError: true,
+        cause: value,
+        rejection: value,
+      });
+    }
+  });
+
+  it('does not wrap a rejection that is already an Error', async () => {
+    const originalError = new Error('already an error');
+    let receivedError: Error | undefined;
+
+    const hooks = {
+      onError: async (_session: ChatSession, error: Error) => {
+        receivedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createRejectingProvider(originalError), promptBuilder, undefined, {
+      hooks,
+    });
+    await rejectionOf(orchestrator.processMessage(createSession('test Error')));
+
+    expect(receivedError).toBe(originalError);
+  });
+});