+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {createOpenAIProvider} from '../providers/openai/openaiProvider.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+// spec: specs/hal-engine-config-hooks/spec.md#9
+it('reports every rejection as an Error while preserving the caller rejection', async () => {
+  const rejections: unknown[] = [
+    'provider unavailable',
+    {code: 'UNAVAILABLE'},
+    undefined,
+    new Error('already an Error'),
+  ];
+  const observations = [];
+
+  for (const rejection of rejections) {
+    for (const entryPoint of ['processMessage', 'processMessageStream'] as const) {
+      const session: ChatSession = {
+        sessionId: 'rejection-session',
+        userId: 'user',
+        entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+      };
+      const errors: Error[] = [];
+      const sessions: ChatSession[] = [];
+      const orchestrator = createChatOrchestrator(
+        createOpenAIProvider({type: 'openai', apiKey: 'unused', model: 'unused'}),
+        new PromptBuilder({identity: 'You are helpful.'}),
+        undefined,
+        {
+          hooks: {
+            // A real installed hook rejects inside the same try/catch as provider iteration, before any network work.
+            beforeModelResponse: () => Promise.reject(rejection),
+            onError: async (receivedSession, error) => {
+              sessions.push(receivedSession);
+              errors.push(error);
+            },
+          },
+        }
+      );
+      const call = async () => {
+        if (entryPoint === 'processMessage') return orchestrator.processMessage(session);
+        for await (const chunk of orchestrator.processMessageStream(session)) void chunk;
+        return undefined;
+      };
+      const outcome = await call().then(
+        () => ({rejected: false, value: undefined}),
+        (value: unknown) => ({rejected: true, value})
+      );
+      const error = errors[0];
+      observations.push({
+        entryPoint,
+        rejected: outcome.rejected,
+        originalRejection: Object.is(outcome.value, rejection),
+        hookCalls: errors.length,
+        sameSession: sessions[0] === session,
+        errorInstance: error instanceof Error,
+        preserved: rejection instanceof Error ? error === rejection : Object.is(error?.cause, rejection),
+        causePresent: rejection instanceof Error || Object.hasOwn(error ?? {}, 'cause'),
+      });
+    }
+  }
+
+  expect(observations).toEqual(
+    rejections.flatMap(() =>
+      ['processMessage', 'processMessageStream'].map(entryPoint => ({
+        entryPoint,
+        rejected: true,
+        originalRejection: true,
+        hookCalls: 1,
+        sameSession: true,
+        errorInstance: true,
+        preserved: true,
+        causePresent: true,
+      }))
+    )
+  );
+});