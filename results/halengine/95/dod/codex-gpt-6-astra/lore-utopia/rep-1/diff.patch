+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// @spec specs/hal-engine-config-hooks/spec.md#9
+it('reports every non-Error rejection once with its cause and preserves the caller rejection', async () => {
+  const rejections: unknown[] = [
+    'provider rejected',
+    {code: 'PROVIDER_REJECTED'},
+    undefined,
+    new Error('provider error'),
+  ];
+  const observations = [];
+
+  for (const rejection of rejections) {
+    const provider: AIProvider = {
+      // eslint-disable-next-line require-yield -- rejection occurs before the provider can emit a chunk
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        throw rejection;
+      },
+      async generateStructured<T>(): Promise<T> {
+        throw rejection;
+      },
+    };
+    const session: ChatSession = {
+      sessionId: 'non-error-rejection',
+      userId: 'user',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const errors: Error[] = [];
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Assistant'}), undefined, {
+      hooks: {
+        onError: async (_session, error) => {
+          errors.push(error);
+        },
+      },
+    });
+    const outcome = await orchestrator.processMessage(session).then(
+      () => ({rejected: false, unchanged: false}),
+      (error: unknown) => ({rejected: true, unchanged: Object.is(error, rejection)})
+    );
+    observations.push({
+      rejection,
+      ...outcome,
+      hookCalls: errors.length,
+      hookReceivedError: errors[0] instanceof Error,
+      hookValuePreserved:
+        errors.length === 1 &&
+        (rejection instanceof Error ? errors[0] === rejection : Object.is(errors[0].cause, rejection)),
+    });
+  }
+
+  expect(observations).toEqual(
+    rejections.map(rejection => ({
+      rejection,
+      rejected: true,
+      unchanged: true,
+      hookCalls: 1,
+      hookReceivedError: true,
+      hookValuePreserved: true,
+    }))
+  );
+});