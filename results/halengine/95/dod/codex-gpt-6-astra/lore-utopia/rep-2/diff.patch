@@ -0,0 +1,71 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// spec: specs/hal-engine-config-hooks/spec.md#9
+it('reports non-Error provider rejections once with their cause and preserves the caller rejection', async () => {
+  const rejections: unknown[] = [
+    'provider unavailable',
+    {code: 'PROVIDER_UNAVAILABLE'},
+    undefined,
+    new Error('failed'),
+  ];
+  const observations = [];
+
+  for (const rejection of rejections) {
+    const provider: AIProvider = {
+      // eslint-disable-next-line require-yield -- A rejected stream has no chunks to yield.
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        throw rejection;
+      },
+      async generateStructured<T>(): Promise<T> {
+        throw rejection;
+      },
+    };
+    const session: ChatSession = {
+      sessionId: 'rejected-turn',
+      userId: 'user',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const errors: Error[] = [];
+    const orchestrator = createChatOrchestrator(
+      provider,
+      new PromptBuilder({identity: 'You are helpful.'}),
+      undefined,
+      {
+        hooks: {
+          onError: async (_session, error) => {
+            errors.push(error);
+          },
+        },
+      }
+    );
+    const outcome = await orchestrator.processMessage(session).then(
+      () => ({rejected: false, value: undefined}),
+      (value: unknown) => ({rejected: true, value})
+    );
+    observations.push({
+      rejection,
+      rejected: outcome.rejected,
+      callerReceivedOriginal: Object.is(outcome.value, rejection),
+      hookCalls: errors.length,
+      hookReceivedError: errors[0] instanceof Error,
+      hookPreservedOriginal:
+        rejection instanceof Error ? errors[0] === rejection : Object.is(errors[0]?.cause, rejection),
+      hookHasCause: rejection instanceof Error || Object.hasOwn(errors[0] ?? {}, 'cause'),
+    });
+  }
+
+  expect(observations).toEqual(
+    rejections.map(rejection => ({
+      rejection,
+      rejected: true,
+      callerReceivedOriginal: true,
+      hookCalls: 1,
+      hookReceivedError: true,
+      hookPreservedOriginal: true,
+      hookHasCause: true,
+    }))
+  );
+});