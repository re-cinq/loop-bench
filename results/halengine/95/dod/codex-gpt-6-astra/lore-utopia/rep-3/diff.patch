+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/index.js';
+import type {ChatSession} from '../types/session.js';
+
+// @spec specs/hal-engine-config-hooks/spec.md#9
+it('reports every rejection once as an Error while preserving the original caller rejection', async () => {
+  const reasons: unknown[] = ['provider unavailable', {code: 'UNAVAILABLE'}, undefined, new Error('already an Error')];
+  const observations = [];
+
+  for (const reason of reasons) {
+    for (const entryPoint of ['processMessage', 'processMessageStream'] as const) {
+      const reported: Error[] = [];
+      const session: ChatSession = {
+        sessionId: 'rejection-session',
+        userId: 'rejection-user',
+        entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+      };
+      const orchestrator = createChatOrchestrator(
+        createMockProvider(),
+        new PromptBuilder({identity: 'You are a test assistant.'}),
+        undefined,
+        {
+          hooks: {
+            afterModelResponse: async () => {
+              throw reason;
+            },
+            onError: async (_session, error) => {
+              reported.push(error);
+            },
+          },
+        }
+      );
+      let rejected = false;
+      let originalPreserved = false;
+      try {
+        if (entryPoint === 'processMessage') {
+          await orchestrator.processMessage(session);
+        } else {
+          for await (const chunk of orchestrator.processMessageStream(session)) {
+            void chunk;
+          }
+        }
+      } catch (error) {
+        rejected = true;
+        originalPreserved = Object.is(error, reason);
+      }
+      observations.push({
+        entryPoint,
+        rejected,
+        originalPreserved,
+        calls: reported.length,
+        isError: reported[0] instanceof Error,
+        reasonPreserved:
+          reason instanceof Error
+            ? reported[0] === reason
+            : reported[0] instanceof Error &&
+              Object.hasOwn(reported[0], 'cause') &&
+              Object.is(reported[0].cause, reason),
+      });
+    }
+  }
+
+  expect(observations).toEqual(
+    reasons.flatMap(() =>
+      ['processMessage', 'processMessageStream'].map(entryPoint => ({
+        entryPoint,
+        rejected: true,
+        originalPreserved: true,
+        calls: 1,
+        isError: true,
+        reasonPreserved: true,
+      }))
+    )
+  );
+});