@@ -0,0 +1,50 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import type {ChatSession} from '../types/session.js';
+
+// spec: specs/hal-engine-config-hooks/spec.md#10
+it('reports non-Error stream rejections once with their cause and preserves the caller rejection', async () => {
+  const reasons: unknown[] = ['provider unavailable', {code: 'UNAVAILABLE'}, undefined, new Error('already an Error')];
+  const observations = [];
+
+  for (const reason of reasons) {
+    const errors: Error[] = [];
+    const session: ChatSession = {
+      sessionId: 'rejection-session',
+      userId: 'rejection-user',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const orchestrator = createChatOrchestrator(
+      createMockProvider(),
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      undefined,
+      {hooks: {onError: async (_session, error) => void errors.push(error)}}
+    );
+    const stream = orchestrator.processMessageStream(session);
+    await stream.next();
+    const outcome = await stream.throw(reason).then(
+      () => ({status: 'fulfilled', reason: undefined}),
+      (rejection: unknown) => ({status: 'rejected', reason: rejection})
+    );
+
+    observations.push({
+      calls: errors.length,
+      receivesError: errors[0] instanceof Error,
+      preservesCauseOrInstance:
+        reason instanceof Error ? errors[0] === reason : errors.length === 1 && Object.is(errors[0].cause, reason),
+      status: outcome.status,
+      preservesCallerRejection: Object.is(outcome.reason, reason),
+    });
+  }
+
+  expect(observations).toEqual(
+    reasons.map(() => ({
+      calls: 1,
+      receivesError: true,
+      preservesCauseOrInstance: true,
+      status: 'rejected',
+      preservesCallerRejection: true,
+    }))
+  );
+});