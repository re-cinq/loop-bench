+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+// Spec: specs/hal-engine-config-hooks/spec.md#9
+it('reports every rejection once as an Error while preserving the original rejection', async () => {
+  const rejections = ['provider unavailable', {code: 'UNAVAILABLE'}, undefined, new Error('already an Error')];
+  const outcomes = [];
+
+  for (const rejection of rejections) {
+    const session: ChatSession = {
+      sessionId: 'rejection-session',
+      userId: 'user',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const calls: {session: ChatSession; error: Error}[] = [];
+    const orchestrator = createChatOrchestrator(
+      createMockProvider(),
+      new PromptBuilder({identity: 'You are helpful.'}),
+      undefined,
+      {
+        hooks: {
+          onError: async (hookSession, error) => {
+            calls.push({session: hookSession, error});
+          },
+        },
+      }
+    );
+    const stream = orchestrator.processMessageStream(session);
+    const first = await stream.next();
+    const outcome = await stream.throw(rejection).then(
+      () => ({rejected: false, original: false}),
+      (reason: unknown) => ({rejected: true, original: Object.is(reason, rejection)})
+    );
+    const reported = calls[0]?.error;
+
+    outcomes.push({
+      started: first.done === false,
+      ...outcome,
+      calls: calls.length,
+      sameSession: calls[0]?.session === session,
+      isError: reported instanceof Error,
+      preservesValue:
+        rejection instanceof Error
+          ? reported === rejection
+          : reported instanceof Error && Object.hasOwn(reported, 'cause') && Object.is(reported.cause, rejection),
+    });
+  }
+
+  expect(outcomes).toEqual(
+    rejections.map(() => ({
+      started: true,
+      rejected: true,
+      original: true,
+      calls: 1,
+      sameSession: true,
+      isError: true,
+      preservesValue: true,
+    }))
+  );
+});