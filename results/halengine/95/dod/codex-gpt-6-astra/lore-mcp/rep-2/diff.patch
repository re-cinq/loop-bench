+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createOpenAIProvider} from '../providers/openai/index.js';
+import type {ChatSession} from '../types/session.js';
+
+// @spec specs/hal-engine-config-hooks/spec.md#9
+it('reports every rejection as an Error while preserving the original caller rejection', async () => {
+  const reasons: unknown[] = ['provider unavailable', {code: 'UNAVAILABLE'}, undefined, new Error('already an Error')];
+  const observations = [];
+
+  for (const reason of reasons) {
+    const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+    const errors: Error[] = [];
+    const sessions: ChatSession[] = [];
+    const orchestrator = createChatOrchestrator(
+      createOpenAIProvider({type: 'openai', apiKey: 'unused', model: 'unused'}),
+      new PromptBuilder({identity: 'Acceptance test assistant'}),
+      undefined,
+      {
+        hooks: {
+          beforeModelResponse: async () => {
+            // Exercise the shared catch through a real lifecycle callback, before any network access.
+            throw reason;
+          },
+          onError: async (receivedSession, error) => {
+            sessions.push(receivedSession);
+            errors.push(error);
+          },
+        },
+      }
+    );
+    const outcome = await orchestrator.processMessage(session).then(
+      () => ({rejected: false, value: undefined}),
+      (value: unknown) => ({rejected: true, value})
+    );
+    const error = errors[0];
+    observations.push({
+      rejected: outcome.rejected,
+      originalRejection: Object.is(outcome.value, reason),
+      hookCalls: errors.length,
+      sameSession: sessions[0] === session,
+      receivesError: error instanceof Error,
+      preservesReason:
+        reason instanceof Error
+          ? error === reason
+          : error instanceof Error && Object.hasOwn(error, 'cause') && Object.is(error.cause, reason),
+    });
+  }
+
+  expect(observations).toEqual(
+    reasons.map(() => ({
+      rejected: true,
+      originalRejection: true,
+      hookCalls: 1,
+      sameSession: true,
+      receivesError: true,
+      preservesReason: true,
+    }))
+  );
+});