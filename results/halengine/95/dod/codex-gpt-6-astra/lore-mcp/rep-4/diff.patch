+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {createBedrockProvider} from '../providers/bedrock/bedrockProvider.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+// spec: specs/hal-engine-config-hooks/spec.md#9
+it('reports every provider rejection once without changing the caller rejection', async () => {
+  const failures = [
+    'provider unavailable',
+    {code: 'PROVIDER_UNAVAILABLE'},
+    undefined,
+    new Error('provider unavailable'),
+  ];
+  const observations = [];
+
+  for (const failure of failures) {
+    for (const api of ['processMessage', 'processMessageStream'] as const) {
+      const session: ChatSession = {
+        sessionId: 'rejection-session',
+        userId: 'rejection-user',
+        entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+      };
+      const reported: {session: ChatSession; error: Error}[] = [];
+      const provider = createBedrockProvider({
+        type: 'bedrock',
+        region: 'eu-west-1',
+        maxTokens: 1,
+        // Fail inside the real provider while resolving configuration, before it can make a network request.
+        get modelId(): string {
+          throw failure;
+        },
+      });
+      const orchestrator = createChatOrchestrator(
+        provider,
+        new PromptBuilder({identity: 'Test assistant'}),
+        undefined,
+        {
+          hooks: {
+            onError: async (hookSession, error) => {
+              reported.push({session: hookSession, error});
+            },
+          },
+        }
+      );
+      let rejected = false;
+      let callerValue: unknown;
+      try {
+        if (api === 'processMessage') {
+          await orchestrator.processMessage(session);
+        } else {
+          for await (const chunk of orchestrator.processMessageStream(session)) {
+            void chunk;
+          }
+        }
+      } catch (error) {
+        rejected = true;
+        callerValue = error;
+      }
+      const hookError = reported[0]?.error;
+      observations.push({
+        api,
+        kind: failure instanceof Error ? 'Error' : typeof failure,
+        rejected,
+        callerUnchanged: Object.is(callerValue, failure),
+        hookCalls: reported.length,
+        hookSessionUnchanged: reported[0]?.session === session,
+        hookReceivesError: hookError instanceof Error,
+        originalPreserved:
+          failure instanceof Error
+            ? hookError === failure
+            : hookError !== undefined && Object.hasOwn(hookError, 'cause') && Object.is(hookError.cause, failure),
+      });
+    }
+  }
+
+  expect(observations).toEqual(
+    ['string', 'object', 'undefined', 'Error'].flatMap(kind =>
+      ['processMessage', 'processMessageStream'].map(api => ({
+        api,
+        kind,
+        rejected: true,
+        callerUnchanged: true,
+        hookCalls: 1,
+        hookSessionUnchanged: true,
+        hookReceivesError: true,
+        originalPreserved: true,
+      }))
+    )
+  );
+});