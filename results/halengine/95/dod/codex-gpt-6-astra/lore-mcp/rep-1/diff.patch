+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import type {ChatSession} from '../types/session.js';
+
+// Spec: specs/hal-engine-config-hooks/spec.md#9
+it('notifies onError once for every rejection while preserving the caller rejection', async () => {
+  const reasons: unknown[] = ['provider unavailable', {code: 'UNAVAILABLE'}, undefined, new Error('unavailable')];
+  const observations = [];
+
+  for (const reason of reasons) {
+    const session: ChatSession = {
+      sessionId: 'rejection-session',
+      userId: 'rejection-user',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const notifications: {session: ChatSession; error: Error}[] = [];
+    const orchestrator = createChatOrchestrator(
+      createMockProvider(),
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      undefined,
+      {
+        hooks: {
+          afterModelResponse: async () => {
+            throw reason;
+          },
+          onError: async (failedSession, error) => {
+            notifications.push({session: failedSession, error});
+          },
+        },
+      }
+    );
+    const outcome = await orchestrator.processMessage(session).then(
+      value => ({status: 'fulfilled', value}),
+      (value: unknown) => ({status: 'rejected', value})
+    );
+    const notification = notifications[0];
+    const error = notification?.error;
+    observations.push({
+      reason,
+      status: outcome.status,
+      callerReceivedOriginal: Object.is(outcome.value, reason),
+      notificationCount: notifications.length,
+      sameSession: notification?.session === session,
+      receivedError: error instanceof Error,
+      preservedReason:
+        reason instanceof Error
+          ? error === reason
+          : Object.hasOwn(error ?? {}, 'cause') && Object.is(error?.cause, reason),
+    });
+  }
+
+  expect(observations).toEqual(
+    reasons.map(reason => ({
+      reason,
+      status: 'rejected',
+      callerReceivedOriginal: true,
+      notificationCount: 1,
+      sameSession: true,
+      receivedError: true,
+      preservedReason: true,
+    }))
+  );
+});