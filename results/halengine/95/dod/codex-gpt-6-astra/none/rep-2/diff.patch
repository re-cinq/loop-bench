+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createOpenAIProvider} from '../providers/openai/index.js';
+import type {ChatSession} from '../types/session.js';
+
+// specs/hal-engine-config-hooks/spec.md#9
+it('reports every rejection once as an Error while preserving the caller rejection', async () => {
+  const originalError = new Error('existing error');
+  const rejections: unknown[] = ['provider unavailable', {code: 'UNAVAILABLE'}, undefined, originalError];
+  const results = [];
+
+  for (const rejection of rejections) {
+    const session: ChatSession = {
+      sessionId: 'rejection-session',
+      userId: 'user',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const notifications: {session: ChatSession; error: Error}[] = [];
+    const orchestrator = createChatOrchestrator(
+      createOpenAIProvider({type: 'openai', apiKey: 'unused', model: 'unused'}),
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      undefined,
+      {
+        hooks: {
+          beforeModelResponse: async () => Promise.reject(rejection),
+          onError: async (hookSession, error) => {
+            notifications.push({session: hookSession, error});
+          },
+        },
+      }
+    );
+    const outcome = await orchestrator.processMessage(session).then(
+      value => ({status: 'fulfilled', value}),
+      (value: unknown) => ({status: 'rejected', value})
+    );
+    const notification = notifications[0];
+    results.push({
+      status: outcome.status,
+      callerReceivedOriginal: Object.is(outcome.value, rejection),
+      notificationCount: notifications.length,
+      sameSession: notification?.session === session,
+      isError: notification?.error instanceof Error,
+      preservesOriginal:
+        rejection instanceof Error
+          ? notification?.error === rejection
+          : notification !== undefined &&
+            Object.hasOwn(notification.error, 'cause') &&
+            Object.is(notification.error.cause, rejection),
+    });
+  }
+
+  expect(results).toEqual(
+    rejections.map(() => ({
+      status: 'rejected',
+      callerReceivedOriginal: true,
+      notificationCount: 1,
+      sameSession: true,
+      isError: true,
+      preservesOriginal: true,
+    }))
+  );
+});