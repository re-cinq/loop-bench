+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import type {ChatSession} from '../types/session.js';
+
+// @spec specs/hal-engine-config-hooks/spec.md#9
+it('reports every rejection once without changing the caller rejection', async () => {
+  const failures: unknown[] = ['provider unavailable', {code: 'UNAVAILABLE'}, undefined, new Error('unavailable')];
+  const observations = [];
+
+  for (const failure of failures) {
+    const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+    const reported: Error[] = [];
+    const orchestrator = createChatOrchestrator(
+      createMockProvider(),
+      new PromptBuilder({identity: 'You are helpful.'}),
+      undefined,
+      {
+        hooks: {
+          beforeModelResponse: async () => Promise.reject(failure),
+          onError: async (_session, error) => {
+            reported.push(error);
+          },
+        },
+      }
+    );
+
+    for (const call of [
+      () => orchestrator.processMessage(session),
+      () => orchestrator.processMessageStream(session).next(),
+    ]) {
+      reported.length = 0;
+      const outcome = await call().then(
+        () => ({rejected: false, unchanged: false}),
+        (reason: unknown) => ({rejected: true, unchanged: Object.is(reason, failure)})
+      );
+      const error = reported[0];
+      observations.push({
+        ...outcome,
+        calls: reported.length,
+        isError: error instanceof Error,
+        preservesOriginal:
+          failure instanceof Error
+            ? error === failure
+            : error instanceof Error && Object.hasOwn(error, 'cause') && Object.is(error.cause, failure),
+      });
+    }
+  }
+
+  expect(observations).toEqual(
+    Array.from({length: failures.length * 2}, () => ({
+      rejected: true,
+      unchanged: true,
+      calls: 1,
+      isError: true,
+      preservesOriginal: true,
+    }))
+  );
+});