+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {createOpenAIProvider} from '../providers/openai/openaiProvider.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+// @spec specs/hal-engine-config-hooks/spec.md#9
+it('reports every rejection once as an Error while preserving the original caller rejection', async () => {
+  const reasons: unknown[] = ['provider unavailable', {code: 'UNAVAILABLE'}, undefined, new Error('unavailable')];
+  const observations = [];
+
+  for (const reason of reasons) {
+    for (const mode of ['buffered', 'streaming']) {
+      const errors: Error[] = [];
+      const session: ChatSession = {
+        sessionId: 'rejection-session',
+        userId: 'rejection-user',
+        entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+      };
+      const orchestrator = createChatOrchestrator(
+        createOpenAIProvider({type: 'openai', apiKey: 'unused', model: 'unused'}),
+        new PromptBuilder({identity: 'You are a test assistant.'}),
+        undefined,
+        {
+          hooks: {
+            beforeModelResponse: async () => {
+              throw reason;
+            },
+            onError: async (_session, error) => {
+              errors.push(error);
+            },
+          },
+        }
+      );
+
+      let rejected = false;
+      let received: unknown;
+      try {
+        if (mode === 'buffered') {
+          await orchestrator.processMessage(session);
+        } else {
+          for await (const chunk of orchestrator.processMessageStream(session)) {
+            void chunk;
+          }
+        }
+      } catch (error) {
+        rejected = true;
+        received = error;
+      }
+
+      observations.push({
+        mode,
+        reason,
+        rejected,
+        callerReceivedOriginal: Object.is(received, reason),
+        hookCalls: errors.length,
+        hookReceivedError: errors[0] instanceof Error,
+        hookPreservedOriginal:
+          reason instanceof Error
+            ? errors[0] === reason
+            : errors[0] instanceof Error && Object.hasOwn(errors[0], 'cause') && Object.is(errors[0].cause, reason),
+      });
+    }
+  }
+
+  expect(observations).toEqual(
+    reasons.flatMap(reason =>
+      ['buffered', 'streaming'].map(mode => ({
+        mode,
+        reason,
+        rejected: true,
+        callerReceivedOriginal: true,
+        hookCalls: 1,
+        hookReceivedError: true,
+        hookPreservedOriginal: true,
+      }))
+    )
+  );
+});