+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createVertexProvider} from '../providers/vertex/vertexProvider.js';
+import type {ChatSession} from '../types/session.js';
+
+// spec: specs/hal-engine-config-hooks/spec.md#9
+it('reports every rejection as an Error without changing the caller rejection', async () => {
+  const provider = createVertexProvider({
+    type: 'vertex',
+    projectId: 'acceptance',
+    location: 'us-central1',
+    modelId: 'gemini-2.0-flash',
+  });
+  const reasons = ['rejected string', {code: 'REJECTED'}, undefined, new Error('original error')];
+  const observations = [];
+
+  for (const reason of reasons) {
+    for (const method of ['processMessage', 'processMessageStream'] as const) {
+      const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+      const received: Error[] = [];
+      const orchestrator = createChatOrchestrator(
+        provider,
+        new PromptBuilder({identity: 'Test assistant'}),
+        undefined,
+        {
+          hooks: {
+            // Reject before network access through the real lifecycle extension point, inside the provider's shared catch.
+            beforeModelResponse: async () => {
+              throw reason;
+            },
+            onError: async (_session, error) => {
+              received.push(error);
+            },
+          },
+        }
+      );
+      const call =
+        method === 'processMessage'
+          ? orchestrator.processMessage(session)
+          : orchestrator.processMessageStream(session).next();
+      const outcome = await call.then(
+        () => ({rejected: false, unchanged: false}),
+        (error: unknown) => ({rejected: true, unchanged: Object.is(error, reason)})
+      );
+      observations.push({
+        reason,
+        method,
+        ...outcome,
+        calls: received.length,
+        isError: received[0] instanceof Error,
+        preserved:
+          reason instanceof Error
+            ? received[0] === reason
+            : received[0] !== undefined && Object.hasOwn(received[0], 'cause') && Object.is(received[0].cause, reason),
+      });
+    }
+  }
+
+  expect(observations).toEqual(
+    reasons.flatMap(reason =>
+      ['processMessage', 'processMessageStream'].map(method => ({
+        reason,
+        method,
+        rejected: true,
+        unchanged: true,
+        calls: 1,
+        isError: true,
+        preserved: true,
+      }))
+    )
+  );
+});