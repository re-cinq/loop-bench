@@ -0,0 +1,106 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function createRejectingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+async function rejectionOf(call: Promise<unknown>): Promise<unknown> {
+  let threw = false;
+  let thrownValue: unknown;
+  try {
+    await call;
+  } catch (error) {
+    threw = true;
+    thrownValue = error;
+  }
+  if (!threw) {
+    throw new Error('expected promise to reject, but it resolved');
+  }
+  return thrownValue;
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator acceptance: non-Error rejections', () => {
+  it('wraps a non-Error rejection in an Error whose cause is the original and still rejects the caller with the original', async () => {
+    const testCases: Array<{name: string; rejection: unknown}> = [
+      {name: 'string', rejection: 'provider failed'},
+      {name: 'object', rejection: {code: 'UNAVAILABLE', detail: 'temporary'}},
+      {name: 'undefined', rejection: undefined},
+    ];
+
+    const results = [];
+
+    for (const {name, rejection} of testCases) {
+      let callCount = 0;
+      let passedError: unknown;
+
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          callCount += 1;
+          passedError = error;
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(createRejectingProvider(rejection), promptBuilder, undefined, {
+        hooks,
+      });
+
+      const callerRejection = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+
+      results.push({
+        case: name,
+        onErrorCallCount: callCount,
+        isError: passedError instanceof Error,
+        causeIsOriginal: passedError instanceof Error && 'cause' in passedError && passedError.cause === rejection,
+        callerReceivedOriginal: callerRejection === rejection,
+      });
+    }
+
+    expect(results).toEqual([
+      {
+        case: 'string',
+        onErrorCallCount: 1,
+        isError: true,
+        causeIsOriginal: true,
+        callerReceivedOriginal: true,
+      },
+      {
+        case: 'object',
+        onErrorCallCount: 1,
+        isError: true,
+        causeIsOriginal: true,
+        callerReceivedOriginal: true,
+      },
+      {
+        case: 'undefined',
+        onErrorCallCount: 1,
+        isError: true,
+        causeIsOriginal: true,
+        callerReceivedOriginal: true,
+      },
+    ]);
+  });
+});