@@ -0,0 +1,105 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function createRejectingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+async function rejectionOf(promise: Promise<unknown>): Promise<unknown> {
+  try {
+    await promise;
+    return 'resolved without throwing';
+  } catch (error: unknown) {
+    return error;
+  }
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator onError', () => {
+  it('wraps a non-Error rejection in an Error whose cause is the original and still rejects the caller with the original', async () => {
+    const cases: Array<{name: string; rejection: unknown}> = [
+      {name: 'string', rejection: 'provider failed without Error'},
+      {name: 'object', rejection: {code: 'PROVIDER_CRASH', status: 500}},
+      {name: 'undefined', rejection: undefined},
+    ];
+
+    const results = [];
+
+    for (const testCase of cases) {
+      let receivedError: unknown = null;
+      let onErrorCalls = 0;
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          onErrorCalls += 1;
+          receivedError = error;
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(
+        createRejectingProvider(testCase.rejection),
+        promptBuilder,
+        undefined,
+        {hooks}
+      );
+
+      const callerRejection = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+
+      results.push({
+        case: testCase.name,
+        onErrorCalls,
+        isError: receivedError instanceof Error,
+        causeMatches:
+          receivedError instanceof Error &&
+          'cause' in receivedError &&
+          (receivedError as Error & {cause?: unknown}).cause === testCase.rejection,
+        callerReceivedOriginal: callerRejection === testCase.rejection,
+      });
+    }
+
+    expect(results).toEqual([
+      {
+        case: 'string',
+        onErrorCalls: 1,
+        isError: true,
+        causeMatches: true,
+        callerReceivedOriginal: true,
+      },
+      {
+        case: 'object',
+        onErrorCalls: 1,
+        isError: true,
+        causeMatches: true,
+        callerReceivedOriginal: true,
+      },
+      {
+        case: 'undefined',
+        onErrorCalls: 1,
+        isError: true,
+        causeMatches: true,
+        callerReceivedOriginal: true,
+      },
+    ]);
+  });
+});