@@ -0,0 +1,92 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function createRejectingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator onError', () => {
+  it('wraps a non-Error rejection in an Error whose cause is the original and still rejects the caller with the original', async () => {
+    const cases: unknown[] = ['provider failed with string', {code: 'PROVIDER_ERROR', status: 500}, undefined];
+    const results = [];
+
+    for (const rejection of cases) {
+      let onErrorCalls = 0;
+      let receivedError: unknown;
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          onErrorCalls += 1;
+          receivedError = error;
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(createRejectingProvider(rejection), promptBuilder, undefined, {
+        hooks,
+      });
+
+      let callerThrew = false;
+      let callerRejection: unknown;
+      try {
+        await orchestrator.processMessage(createSession('hello'));
+      } catch (error) {
+        callerThrew = true;
+        callerRejection = error;
+      }
+
+      results.push({
+        onErrorCalls,
+        receivedIsError: receivedError instanceof Error,
+        receivedCause: receivedError instanceof Error ? receivedError.cause : undefined,
+        callerThrew,
+        callerRejection,
+      });
+    }
+
+    expect(results).toEqual([
+      {
+        onErrorCalls: 1,
+        receivedIsError: true,
+        receivedCause: 'provider failed with string',
+        callerThrew: true,
+        callerRejection: 'provider failed with string',
+      },
+      {
+        onErrorCalls: 1,
+        receivedIsError: true,
+        receivedCause: {code: 'PROVIDER_ERROR', status: 500},
+        callerThrew: true,
+        callerRejection: {code: 'PROVIDER_ERROR', status: 500},
+      },
+      {
+        onErrorCalls: 1,
+        receivedIsError: true,
+        receivedCause: undefined,
+        callerThrew: true,
+        callerRejection: undefined,
+      },
+    ]);
+  });
+});