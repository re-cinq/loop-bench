+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed timestamp so the test remains deterministic.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const rejectionOf = (promise: Promise<unknown>): Promise<unknown> =>
+  promise.then(
+    () => new Error('expected promise to reject'),
+    error => error
+  );
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function createRejectingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('onError', () => {
+  it('wraps a non-Error rejection in an Error whose cause is the original and still rejects the caller with the original', async () => {
+    const cases = [
+      {name: 'string', value: 'provider rejected with string'},
+      {name: 'object', value: {status: 500, detail: 'custom failure'}},
+      {name: 'undefined', value: undefined},
+    ];
+
+    const results = [];
+    for (const testCase of cases) {
+      let receivedError: unknown;
+      let onErrorCalls = 0;
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          onErrorCalls += 1;
+          receivedError = error;
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(createRejectingProvider(testCase.value), promptBuilder, undefined, {
+        hooks,
+      });
+
+      const callerRejection = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+
+      results.push({
+        case: testCase.name,
+        onErrorCalls,
+        isError: receivedError instanceof Error,
+        causeIsOriginal:
+          receivedError instanceof Error && 'cause' in receivedError && receivedError.cause === testCase.value,
+        callerReceivedOriginal: callerRejection === testCase.value,
+      });
+    }
+
+    expect(results).toEqual([
+      {case: 'string', onErrorCalls: 1, isError: true, causeIsOriginal: true, callerReceivedOriginal: true},
+      {case: 'object', onErrorCalls: 1, isError: true, causeIsOriginal: true, callerReceivedOriginal: true},
+      {case: 'undefined', onErrorCalls: 1, isError: true, causeIsOriginal: true, callerReceivedOriginal: true},
+    ]);
+  });
+});