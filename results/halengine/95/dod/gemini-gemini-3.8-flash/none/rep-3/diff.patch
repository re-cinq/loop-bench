+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+}
+
+function rejectingProvider(rejection: unknown): AIProvider {
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield* [];
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+interface RejectionObservation {
+  calls: number;
+  isError: boolean;
+  cause: unknown;
+  rejected: unknown;
+}
+
+async function observeRejection(rejection: unknown): Promise<RejectionObservation> {
+  let calls = 0;
+  let receivedError: Error | undefined;
+
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => {
+      calls++;
+      receivedError = error;
+    },
+  };
+
+  const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+
+  let rejected: unknown;
+  try {
+    await orchestrator.processMessage(createSession('hello'));
+  } catch (error) {
+    rejected = error;
+  }
+
+  return {
+    calls,
+    isError: receivedError instanceof Error,
+    cause: receivedError instanceof Error ? receivedError.cause : 'no error received',
+    rejected,
+  };
+}
+
+describe('ChatOrchestrator non-Error rejections', () => {
+  it('calls onError with a wrapped Error when a rejection is not an Error and propagates the raw value unchanged', async () => {
+    const stringRejection = 'string failure';
+    const objectRejection = {status: 500, detail: 'custom error'};
+    const undefinedRejection = undefined;
+
+    const stringResult = await observeRejection(stringRejection);
+    const objectResult = await observeRejection(objectRejection);
+    const undefinedResult = await observeRejection(undefinedRejection);
+
+    expect({stringResult, objectResult, undefinedResult}).toEqual({
+      stringResult: {
+        calls: 1,
+        isError: true,
+        cause: stringRejection,
+        rejected: stringRejection,
+      },
+      objectResult: {
+        calls: 1,
+        isError: true,
+        cause: objectRejection,
+        rejected: objectRejection,
+      },
+      undefinedResult: {
+        calls: 1,
+        isError: true,
+        cause: undefinedRejection,
+        rejected: undefinedRejection,
+      },
+    });
+  });
+});