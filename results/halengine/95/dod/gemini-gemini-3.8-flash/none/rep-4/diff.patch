@@ -0,0 +1,101 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed timestamp so the test does not depend on the system clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function createFailingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield -- generator throws before yielding
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator non-Error rejection handling', () => {
+  it('wraps a non-Error rejection in an Error preserving its cause and still rejects to the caller', async () => {
+    const cases: Array<{label: string; rejection: unknown}> = [
+      {label: 'string', rejection: 'provider failed'},
+      {label: 'plain object', rejection: {status: 500, detail: 'upstream error'}},
+      {label: 'undefined', rejection: undefined},
+    ];
+
+    const results = [];
+    for (const {label, rejection} of cases) {
+      let onErrorCalls = 0;
+      let receivedError: unknown;
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          onErrorCalls += 1;
+          receivedError = error;
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(createFailingProvider(rejection), promptBuilder, undefined, {
+        hooks,
+      });
+
+      let threw = false;
+      let callerRejection: unknown;
+      try {
+        await orchestrator.processMessage(createSession('hello'));
+      } catch (error) {
+        threw = true;
+        callerRejection = error;
+      }
+
+      results.push({
+        label,
+        onErrorCalls,
+        isErrorInstance: receivedError instanceof Error,
+        cause: receivedError instanceof Error ? receivedError.cause : undefined,
+        threw,
+        callerRejection,
+      });
+    }
+
+    expect(results).toEqual([
+      {
+        label: 'string',
+        onErrorCalls: 1,
+        isErrorInstance: true,
+        cause: 'provider failed',
+        threw: true,
+        callerRejection: 'provider failed',
+      },
+      {
+        label: 'plain object',
+        onErrorCalls: 1,
+        isErrorInstance: true,
+        cause: {status: 500, detail: 'upstream error'},
+        threw: true,
+        callerRejection: {status: 500, detail: 'upstream error'},
+      },
+      {
+        label: 'undefined',
+        onErrorCalls: 1,
+        isErrorInstance: true,
+        cause: undefined,
+        threw: true,
+        callerRejection: undefined,
+      },
+    ]);
+  });
+});