+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed timestamp avoids non-deterministic Date calls in tests.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function createThrowingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+async function outcomeOf(call: Promise<unknown>): Promise<{threw: boolean; value: unknown}> {
+  try {
+    const value = await call;
+    return {threw: false, value};
+  } catch (rejection: unknown) {
+    return {threw: true, value: rejection};
+  }
+}
+
+describe('non-Error rejection handling in orchestrator', () => {
+  it('calls onError with an Error wrapping a string rejection as cause, and re-throws the string', async () => {
+    const onErrorCalls: Array<{isError: boolean; cause: unknown}> = [];
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCalls.push({isError: error instanceof Error, cause: error.cause});
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createThrowingProvider('string failure'), promptBuilder, undefined, {
+      hooks,
+    });
+    const callerOutcome = await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({callerOutcome, onErrorCalls}).toEqual({
+      callerOutcome: {threw: true, value: 'string failure'},
+      onErrorCalls: [{isError: true, cause: 'string failure'}],
+    });
+  });
+
+  it('calls onError with an Error wrapping a plain object rejection as cause, and re-throws the object', async () => {
+    const rejectionObject = {status: 502, code: 'BAD_GATEWAY'};
+    const onErrorCalls: Array<{isError: boolean; cause: unknown}> = [];
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCalls.push({isError: error instanceof Error, cause: error.cause});
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createThrowingProvider(rejectionObject), promptBuilder, undefined, {
+      hooks,
+    });
+    const callerOutcome = await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({callerOutcome, onErrorCalls}).toEqual({
+      callerOutcome: {threw: true, value: rejectionObject},
+      onErrorCalls: [{isError: true, cause: rejectionObject}],
+    });
+  });
+
+  it('calls onError with an Error wrapping an undefined rejection as cause, and re-throws undefined', async () => {
+    const onErrorCalls: Array<{isError: boolean; cause: unknown}> = [];
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCalls.push({isError: error instanceof Error, cause: error.cause});
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createThrowingProvider(undefined), promptBuilder, undefined, {
+      hooks,
+    });
+    const callerOutcome = await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({callerOutcome, onErrorCalls}).toEqual({
+      callerOutcome: {threw: true, value: undefined},
+      onErrorCalls: [{isError: true, cause: undefined}],
+    });
+  });
+});