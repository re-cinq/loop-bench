@@ -0,0 +1,100 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator onError', () => {
+  it('wraps non-Error rejections in an Error preserving cause for onError and propagates unchanged', async () => {
+    const cases: Array<{label: string; rejection: unknown}> = [
+      {label: 'string', rejection: 'provider failed'},
+      {label: 'plain object', rejection: {code: 'PROVIDER_DOWN', status: 503}},
+      {label: 'undefined', rejection: undefined},
+    ];
+
+    const results = [];
+
+    for (const {label, rejection} of cases) {
+      let callCount = 0;
+      let receivedSession: ChatSession | undefined;
+      let receivedError: Error | undefined;
+
+      const hooks: OrchestratorHooks = {
+        onError: async (session, error) => {
+          callCount += 1;
+          receivedSession = session;
+          receivedError = error;
+        },
+      };
+
+      const provider: AIProvider = {
+        // eslint-disable-next-line require-yield
+        async *sendMessage(): AsyncGenerator<MessageChunk> {
+          throw rejection;
+        },
+        async generateStructured<T>(): Promise<T> {
+          return {} as T;
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+
+      let callerOutcome: unknown;
+      try {
+        await orchestrator.processMessage(createSession('hello'));
+        callerOutcome = 'resolved without throwing';
+      } catch (error: unknown) {
+        callerOutcome = error;
+      }
+
+      results.push({
+        label,
+        callCount,
+        hasSession: receivedSession?.sessionId === 's1',
+        isError: receivedError instanceof Error,
+        cause: receivedError?.cause,
+        callerOutcome,
+      });
+    }
+
+    expect(results).toEqual([
+      {
+        label: 'string',
+        callCount: 1,
+        hasSession: true,
+        isError: true,
+        cause: 'provider failed',
+        callerOutcome: 'provider failed',
+      },
+      {
+        label: 'plain object',
+        callCount: 1,
+        hasSession: true,
+        isError: true,
+        cause: {code: 'PROVIDER_DOWN', status: 503},
+        callerOutcome: {code: 'PROVIDER_DOWN', status: 503},
+      },
+      {
+        label: 'undefined',
+        callCount: 1,
+        hasSession: true,
+        isError: true,
+        cause: undefined,
+        callerOutcome: undefined,
+      },
+    ]);
+  });
+});