@@ -0,0 +1,91 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const promptBuilder = new PromptBuilder({identity: 'Test assistant'});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's-acceptance',
+    userId: 'u-acceptance',
+    entries: [{role: 'user', content, timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+}
+
+function createRejectingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+describe('ChatOrchestrator non-Error rejection handling', () => {
+  it('wraps non-Error rejections in an Error with cause and still rejects original to caller', async () => {
+    const plainObject = {status: 503, reason: 'temporary outage'};
+    const cases: Array<{name: string; rejection: unknown}> = [
+      {name: 'string', rejection: 'provider failed string'},
+      {name: 'plain object', rejection: plainObject},
+      {name: 'undefined', rejection: undefined},
+    ];
+
+    const observed = await Promise.all(
+      cases.map(async ({rejection}) => {
+        let onErrorCalls = 0;
+        let receivedError: Error | undefined;
+
+        const hooks: OrchestratorHooks = {
+          onError: async (_session, error) => {
+            onErrorCalls += 1;
+            receivedError = error;
+          },
+        };
+
+        const orchestrator = createChatOrchestrator(createRejectingProvider(rejection), promptBuilder, undefined, {
+          hooks,
+        });
+
+        let callerRejection: unknown;
+        try {
+          await orchestrator.processMessage(createSession('hi'));
+        } catch (error) {
+          callerRejection = error;
+        }
+
+        return {
+          onErrorCalls,
+          isErrorInstance: receivedError instanceof Error,
+          cause: receivedError?.cause,
+          callerRejection,
+        };
+      })
+    );
+
+    expect(observed).toEqual([
+      {
+        onErrorCalls: 1,
+        isErrorInstance: true,
+        cause: 'provider failed string',
+        callerRejection: 'provider failed string',
+      },
+      {
+        onErrorCalls: 1,
+        isErrorInstance: true,
+        cause: plainObject,
+        callerRejection: plainObject,
+      },
+      {
+        onErrorCalls: 1,
+        isErrorInstance: true,
+        cause: undefined,
+        callerRejection: undefined,
+      },
+    ]);
+  });
+});