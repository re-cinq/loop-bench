+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import type {ChatSession} from '../types/session.js';
+
+// specs/hal-engine-config-hooks/spec.md#10
+it('reports every rejection to onError without changing what the caller receives', async () => {
+  const originalError = new Error('already an Error');
+  const values: unknown[] = ['provider failure', {code: 'FAIL'}, undefined, originalError];
+  const results = [];
+
+  for (const value of values) {
+    const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+    const received: Error[] = [];
+    const orchestrator = createChatOrchestrator(
+      createMockProvider(),
+      new PromptBuilder({identity: 'assistant'}),
+      undefined,
+      {
+        hooks: {
+          beforeModelResponse: async () => Promise.reject(value),
+          onError: async (_session, error) => void received.push(error),
+        },
+      }
+    );
+    const outcome = await orchestrator.processMessage(session).then(
+      () => ({rejected: false, value: undefined}),
+      (error: unknown) => ({rejected: true, value: error})
+    );
+    results.push({
+      rejected: outcome.rejected,
+      original: Object.is(outcome.value, value),
+      calls: received.length,
+      error: received[0] instanceof Error,
+      preservesValue: value instanceof Error ? received[0] === value : Object.is(received[0]?.cause, value),
+    });
+  }
+
+  expect(results).toEqual(
+    values.map(() => ({rejected: true, original: true, calls: 1, error: true, preservesValue: true}))
+  );
+});