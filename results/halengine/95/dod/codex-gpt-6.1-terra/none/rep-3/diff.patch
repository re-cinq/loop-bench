+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import type {ChatSession} from '../types/session.js';
+
+// specs/hal-engine-config-hooks/spec.md#14
+it('reports every rejection to onError while preserving the caller rejection', async () => {
+  const originalError = new Error('already an Error');
+  const values: unknown[] = ['provider failure', {code: 'failure'}, undefined, originalError];
+  const results = await Promise.all(
+    values.map(async value => {
+      const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+      const reported: Error[] = [];
+      const orchestrator = createChatOrchestrator(
+        createMockProvider(),
+        new PromptBuilder({identity: 'assistant'}),
+        undefined,
+        {
+          hooks: {
+            beforeModelResponse: async () => Promise.reject(value),
+            onError: async (_session, error) => {
+              reported.push(error);
+            },
+          },
+        }
+      );
+      const outcome = await orchestrator.processMessage(session).then(
+        () => ({rejected: false, value: undefined}),
+        (error: unknown) => ({rejected: true, value: error})
+      );
+      return {
+        rejected: outcome.rejected,
+        originalRejection: Object.is(outcome.value, value),
+        calls: reported.length,
+        errorInstance: reported[0] instanceof Error,
+        preservesValue:
+          value instanceof Error
+            ? reported[0] === value
+            : reported[0] !== undefined && Object.hasOwn(reported[0], 'cause') && Object.is(reported[0].cause, value),
+      };
+    })
+  );
+
+  expect(results).toEqual(
+    values.map(() => ({rejected: true, originalRejection: true, calls: 1, errorInstance: true, preservesValue: true}))
+  );
+});