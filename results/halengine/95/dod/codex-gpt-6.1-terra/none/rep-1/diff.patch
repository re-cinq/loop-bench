+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createBedrockProvider} from '../providers/bedrock/bedrockProvider.js';
+import type {ChatSession} from '../types/session.js';
+
+// specs/hal-engine-config-hooks/spec.md#10
+it('reports every rejection to onError while preserving the caller rejection', async () => {
+  const object = {reason: 'unavailable'};
+  const originalError = new Error('unavailable');
+  const values: unknown[] = ['unavailable', object, undefined, originalError];
+  const results = [];
+
+  for (const value of values) {
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const received: Error[] = [];
+    const orchestrator = createChatOrchestrator(
+      createBedrockProvider({type: 'bedrock', modelId: 'unused', region: 'eu-central-1', maxTokens: 1}),
+      new PromptBuilder({identity: 'test'}),
+      undefined,
+      {
+        hooks: {
+          beforeModelResponse: async () => {
+            throw value;
+          },
+          onError: async (_session, error) => {
+            received.push(error);
+          },
+        },
+      }
+    );
+    const outcome = await orchestrator.processMessage(session).then(
+      () => ({rejected: false, value: undefined}),
+      (error: unknown) => ({rejected: true, value: error})
+    );
+    results.push({
+      rejected: outcome.rejected,
+      original: Object.is(outcome.value, value),
+      calls: received.length,
+      isError: received[0] instanceof Error,
+      preserved: value instanceof Error ? received[0] === value : Object.is(received[0]?.cause, value),
+    });
+  }
+
+  expect(results).toEqual(
+    values.map(() => ({rejected: true, original: true, calls: 1, isError: true, preserved: true}))
+  );
+});