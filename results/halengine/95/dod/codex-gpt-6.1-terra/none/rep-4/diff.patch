+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+// specs/hal-engine-config-hooks/spec.md#11
+it('reports every rejection to onError while preserving the caller rejection', async () => {
+  const originalError = new Error('already an Error');
+  const values: unknown[] = ['provider failure', {code: 'failure'}, undefined, originalError];
+  const observations = [];
+
+  for (const value of values) {
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const received: Error[] = [];
+    const orchestrator = createChatOrchestrator(
+      createMockProvider(),
+      new PromptBuilder({identity: 'test'}),
+      undefined,
+      {
+        hooks: {
+          beforeModelResponse: async () => {
+            throw value;
+          },
+          onError: async (_session, error) => void received.push(error),
+        },
+      }
+    );
+    const outcome = await orchestrator.processMessage(session).then(
+      () => ({rejected: false, value: undefined}),
+      (error: unknown) => ({rejected: true, value: error})
+    );
+    observations.push({
+      rejectedUnchanged: outcome.rejected && Object.is(outcome.value, value),
+      calledOnce: received.length === 1,
+      isError: received[0] instanceof Error,
+      preservesValue:
+        value instanceof Error
+          ? received[0] === value
+          : received[0] instanceof Error && 'cause' in received[0] && Object.is(received[0].cause, value),
+    });
+  }
+
+  expect(observations).toEqual(
+    values.map(() => ({rejectedUnchanged: true, calledOnce: true, isError: true, preservesValue: true}))
+  );
+});