+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// specs/hal-engine-config-hooks/spec.md#10
+it('reports every provider rejection to onError without changing what the caller receives', async () => {
+  const originalError = new Error('already an Error');
+  const values: unknown[] = ['provider failed', {code: 'provider_failed'}, undefined, originalError];
+  const observations = [];
+
+  for (const value of values) {
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        yield* [];
+        throw value;
+      },
+      async generateStructured<T>(): Promise<T> {
+        throw new Error('Unexpected structured generation');
+      },
+    };
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const received: Error[] = [];
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'assistant'}), undefined, {
+      hooks: {onError: async (_session, error) => void received.push(error)},
+    });
+    const outcome = await orchestrator.processMessage(session).then(
+      () => ({rejected: false, value: undefined}),
+      (error: unknown) => ({rejected: true, value: error})
+    );
+    observations.push({
+      rejectedUnchanged: outcome.rejected && Object.is(outcome.value, value),
+      hookCalls: received.length,
+      hookReceivedError: received[0] instanceof Error,
+      originalPreserved:
+        value instanceof Error
+          ? received[0] === value
+          : received[0] !== undefined && 'cause' in received[0] && Object.is(received[0].cause, value),
+    });
+  }
+
+  expect(observations).toEqual(
+    values.map(() => ({
+      rejectedUnchanged: true,
+      hookCalls: 1,
+      hookReceivedError: true,
+      originalPreserved: true,
+    }))
+  );
+});