+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// specs/hal-engine-config-hooks/spec.md#1
+it('reports every provider rejection to onError while preserving the caller rejection', async () => {
+  const object = {reason: 'provider failed'};
+  const existingError = new Error('provider failed');
+  for (const rejection of ['provider failed', object, undefined, existingError]) {
+    const provider: AIProvider = {
+      // eslint-disable-next-line require-yield
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        throw rejection;
+      },
+      async generateStructured<T>(): Promise<T> {
+        throw new Error('Unexpected structured generation');
+      },
+    };
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const reported: Array<{session: ChatSession; error: Error}> = [];
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Test assistant'}), undefined, {
+      hooks: {onError: async (seenSession, error) => void reported.push({session: seenSession, error})},
+    });
+    const outcome = await orchestrator.processMessage(session).then(
+      value => ({status: 'resolved' as const, value}),
+      value => ({status: 'rejected' as const, value})
+    );
+
+    expect(outcome.status).toBe('rejected');
+    expect(outcome.value).toBe(rejection);
+    expect(reported).toHaveLength(1);
+    expect(reported[0].session).toBe(session);
+    expect(reported[0].error).toBeInstanceOf(Error);
+    if (rejection instanceof Error) {
+      expect(reported[0].error).toBe(rejection);
+    } else {
+      expect((reported[0].error as Error & {cause?: unknown}).cause).toBe(rejection);
+    }
+  }
+});