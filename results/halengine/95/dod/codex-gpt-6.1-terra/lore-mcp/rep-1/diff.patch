+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createVertexProvider} from '../providers/vertex/vertexProvider.js';
+import type {ChatSession} from '../types/session.js';
+
+// specs/hal-engine-config-hooks/spec.md#12
+it('reports every rejection to onError while preserving the caller value', async () => {
+  const values: unknown[] = ['provider failed', {code: 'failure'}, undefined, new Error('failure')];
+  const results = [];
+
+  for (const value of values) {
+    const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+    const errors: Error[] = [];
+    const orchestrator = createChatOrchestrator(
+      createVertexProvider({type: 'vertex', projectId: 'test', location: 'us-central1', modelId: 'test'}),
+      new PromptBuilder({identity: 'test'}),
+      undefined,
+      {
+        hooks: {
+          beforeModelResponse: async () => {
+            throw value;
+          },
+          onError: async (_session, error) => {
+            errors.push(error);
+          },
+        },
+      }
+    );
+    const outcome = await orchestrator.processMessage(session).then(
+      () => ({rejected: false, value: undefined}),
+      (reason: unknown) => ({rejected: true, value: reason})
+    );
+    results.push({
+      rejectedUnchanged: outcome.rejected && Object.is(outcome.value, value),
+      calls: errors.length,
+      isError: errors[0] instanceof Error,
+      preservesValue: value instanceof Error ? errors[0] === value : Object.is(errors[0]?.cause, value),
+    });
+  }
+
+  expect(results).toEqual(values.map(() => ({rejectedUnchanged: true, calls: 1, isError: true, preservesValue: true})));
+});