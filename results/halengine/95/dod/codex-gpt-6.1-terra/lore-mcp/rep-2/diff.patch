+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import type {ChatSession} from '../types/session.js';
+
+// specs/hal-engine-config-hooks/spec.md#9
+it('reports every rejection to onError while preserving the caller rejection', async () => {
+  const originalError = new Error('already an Error');
+  const values: unknown[] = ['provider failed', {reason: 'provider failed'}, undefined, originalError];
+
+  for (const value of values) {
+    const received: Error[] = [];
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const orchestrator = createChatOrchestrator(
+      createMockProvider(),
+      new PromptBuilder({identity: 'Test assistant'}),
+      undefined,
+      {
+        hooks: {
+          beforeModelResponse: async () => Promise.reject(value),
+          onError: async (_session, error) => void received.push(error),
+        },
+      }
+    );
+
+    const outcome = await orchestrator.processMessage(session).then(
+      () => ({rejected: false, value: undefined}),
+      (error: unknown) => ({rejected: true, value: error})
+    );
+
+    expect(outcome.rejected).toBe(true);
+    expect(outcome.value).toBe(value);
+    expect(received).toHaveLength(1);
+    expect(received[0]).toBeInstanceOf(Error);
+    if (value instanceof Error) expect(received[0]).toBe(value);
+    else expect(received[0].cause).toBe(value);
+  }
+});