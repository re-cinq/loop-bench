+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createBedrockProvider} from '../providers/bedrock/bedrockProvider.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('orchestrator rejection reporting', () => {
+  // specs/hal-engine-config-hooks/spec.md#14
+  it('reports every rejection as an Error and preserves the caller rejection', async () => {
+    const object = {reason: 'provider failure'};
+    const existingError = new Error('already an Error');
+    const values: unknown[] = ['provider failure', object, undefined, existingError];
+    const provider = createBedrockProvider({type: 'bedrock', modelId: 'unused', region: 'eu-central-1', maxTokens: 10});
+    const builder = new PromptBuilder({identity: 'Assistant'});
+
+    const results = await Promise.all(
+      values.map(async value => {
+        const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+        const reported: Error[] = [];
+        const orchestrator = createChatOrchestrator(provider, builder, undefined, {
+          hooks: {
+            beforeModelResponse: async () => {
+              throw value;
+            },
+            onError: async (_session, error) => {
+              reported.push(error);
+            },
+          },
+        });
+        const outcome = await orchestrator.processMessage(session).then(
+          () => ({rejected: false, value: undefined}),
+          (error: unknown) => ({rejected: true, value: error})
+        );
+        return {
+          rejected: outcome.rejected,
+          original: Object.is(outcome.value, value),
+          calls: reported.length,
+          isError: reported[0] instanceof Error,
+          preservesValue: value instanceof Error ? reported[0] === value : Object.is(reported[0]?.cause, value),
+        };
+      })
+    );
+
+    expect(results).toEqual(
+      values.map(() => ({
+        rejected: true,
+        original: true,
+        calls: 1,
+        isError: true,
+        preservesValue: true,
+      }))
+    );
+  });
+});