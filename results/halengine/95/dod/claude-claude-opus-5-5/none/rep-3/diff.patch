+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// re-cinq/HALEngine#95: onError fires for every rejection, not only an Error.
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const createSession = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const rejectingProvider = (value: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw value;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+describe('onError for a rejection that is not an Error', () => {
+  const plainObject = {code: 'E_UPSTREAM', detail: 'quota'};
+
+  it.each([
+    ['a string', 'provider said no'],
+    ['a plain object', plainObject],
+    ['undefined', undefined],
+  ])(
+    'calls onError once with an Error whose cause is %s, and still rejects with the original value',
+    async (_label, rejection) => {
+      const seen: {isError: boolean; hasCause: boolean; cause: unknown}[] = [];
+      const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {
+        hooks: {
+          onError: async (_session, error) => {
+            seen.push({isError: error instanceof Error, hasCause: Object.hasOwn(error, 'cause'), cause: error.cause});
+          },
+        },
+      });
+
+      const received = await orchestrator.processMessage(createSession()).then(
+        () => ({resolved: true, value: undefined as unknown}),
+        (value: unknown) => ({resolved: false, value})
+      );
+
+      expect({seen, received}).toEqual({
+        seen: [{isError: true, hasCause: true, cause: rejection}],
+        received: {resolved: false, value: rejection},
+      });
+      expect(received.value).toBe(rejection);
+    }
+  );
+});