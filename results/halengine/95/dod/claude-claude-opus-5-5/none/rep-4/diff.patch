+// Acceptance for re-cinq/HALEngine#95; validates specs/hal-engine-config-hooks/spec.md#8.
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const session = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+});
+
+// Typed unknown: a library that rejects with its own shape hands the orchestrator exactly this.
+function rejectingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+// What onError saw and what the caller received, for one rejection value.
+async function observe(rejection: unknown) {
+  const seen: {isError: boolean; hasCause: boolean; cause: unknown}[] = [];
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) =>
+      void seen.push({isError: error instanceof Error, hasCause: 'cause' in error, cause: error.cause}),
+  };
+  const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+  const received: unknown = await orchestrator.processMessage(session()).then(
+    () => 'resolved without throwing',
+    (error: unknown) => error
+  );
+
+  return {onError: seen, receivedIsOriginal: received === rejection};
+}
+
+describe('onError for a rejection that is not an Error', () => {
+  it('calls onError once with an Error wrapping a string, object or undefined rejection as its cause, and rethrows the original', async () => {
+    const plainObject = {code: 'E_PROVIDER', detail: 'rejected with its own shape'};
+
+    const observed = {
+      string: await observe('provider exploded'),
+      plainObject: await observe(plainObject),
+      undefined: await observe(undefined),
+    };
+
+    expect(observed).toEqual({
+      string: {onError: [{isError: true, hasCause: true, cause: 'provider exploded'}], receivedIsOriginal: true},
+      plainObject: {onError: [{isError: true, hasCause: true, cause: plainObject}], receivedIsOriginal: true},
+      undefined: {onError: [{isError: true, hasCause: true, cause: undefined}], receivedIsOriginal: true},
+    });
+  });
+});