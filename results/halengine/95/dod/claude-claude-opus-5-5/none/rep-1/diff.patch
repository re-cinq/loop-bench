+// Acceptance tests for re-cinq/HALEngine#95: specs/hal-engine-config-hooks/spec.md § Error reporting.
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+  };
+}
+
+// A provider that rejects with whatever value it is given, Error or not.
+function rejectingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+type Observed = {calls: number; isError: boolean[]; causes: unknown[]; callerReceived: unknown; rejected: boolean};
+
+async function observe(rejection: unknown): Promise<Observed> {
+  const received: unknown[] = [];
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => void received.push(error),
+  };
+  const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+
+  let rejected = false;
+  let callerReceived: unknown = 'resolved without throwing';
+  try {
+    await orchestrator.processMessage(createSession());
+  } catch (thrown) {
+    rejected = true;
+    callerReceived = thrown;
+  }
+
+  return {
+    calls: received.length,
+    isError: received.map(error => error instanceof Error),
+    causes: received.map(error => (error as {cause?: unknown}).cause),
+    callerReceived,
+    rejected,
+  };
+}
+
+describe('onError for a rejection that is not an Error', () => {
+  it('calls onError once with an Error caused by a rejected string, and rethrows the string unchanged', async () => {
+    expect(await observe('provider exploded')).toEqual({
+      calls: 1,
+      isError: [true],
+      causes: ['provider exploded'],
+      callerReceived: 'provider exploded',
+      rejected: true,
+    });
+  });
+
+  it('calls onError once with an Error caused by a rejected plain object, and rethrows the same object', async () => {
+    const rejection = {code: 'E_UPSTREAM', status: 503};
+    const observed = await observe(rejection);
+
+    expect({
+      ...observed,
+      causeIsSame: observed.causes[0] === rejection,
+      callerIsSame: observed.callerReceived === rejection,
+    }).toEqual({
+      calls: 1,
+      isError: [true],
+      causes: [rejection],
+      callerReceived: rejection,
+      rejected: true,
+      causeIsSame: true,
+      callerIsSame: true,
+    });
+  });
+
+  it('calls onError once with an Error caused by a rejected undefined, and rethrows undefined', async () => {
+    expect(await observe(undefined)).toEqual({
+      calls: 1,
+      isError: [true],
+      causes: [undefined],
+      callerReceived: undefined,
+      rejected: true,
+    });
+  });
+});