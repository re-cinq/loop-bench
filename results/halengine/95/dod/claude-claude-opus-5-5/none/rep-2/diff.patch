@@ -0,0 +1,67 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Validates specs/hal-engine-config-hooks/spec.md — onError fires for every rejection (re-cinq/HALEngine#95).
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const session = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+function rejectingProvider(value: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw value;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+// Settles the call either way, so the rejected value itself is what the test compares.
+const settle = (call: Promise<unknown>): Promise<{rejected: boolean; value: unknown}> =>
+  call.then(
+    value => ({rejected: false, value}),
+    (value: unknown) => ({rejected: true, value})
+  );
+
+describe('ChatOrchestrator onError for a rejection that is not an Error', () => {
+  it.each([
+    ['a string', 'provider said no'],
+    ['a plain object', {code: 'E_UPSTREAM', status: 503}],
+    ['undefined', undefined],
+  ])(
+    'calls onError once with an Error whose cause is %s, and the caller still receives the original rejection',
+    async (_label, rejection) => {
+      const received: unknown[] = [];
+      const hooks: OrchestratorHooks = {onError: async (_session, error) => void received.push(error)};
+
+      const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+      const outcome = await settle(orchestrator.processMessage(session()));
+
+      expect({
+        rejected: outcome.rejected,
+        sameRejection: Object.is(outcome.value, rejection),
+        onErrorCalls: received.length,
+        isError: received[0] instanceof Error,
+        causeIsOriginal: received[0] instanceof Error && Object.is(received[0].cause, rejection),
+        hasCause: received[0] instanceof Error && 'cause' in received[0],
+      }).toEqual({
+        rejected: true,
+        sameRejection: true,
+        onErrorCalls: 1,
+        isError: true,
+        causeIsOriginal: true,
+        hasCause: true,
+      });
+    }
+  );
+});