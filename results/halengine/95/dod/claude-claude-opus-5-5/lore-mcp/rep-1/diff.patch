+// Validates specs/hal-engine-config-hooks/spec.md#8 (HALEngine#95).
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(): ChatSession {
+  return {sessionId: 's1', userId: 'u1', entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}]};
+}
+
+// A provider that rejects with a value of its own shape, the way some libraries do.
+function rejectingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const settle = (call: Promise<unknown>): Promise<{rejected: boolean; value: unknown}> =>
+  call.then(
+    value => ({rejected: false, value}),
+    (value: unknown) => ({rejected: true, value})
+  );
+
+describe('onError for a rejection that is not an Error', () => {
+  const plainObject = {code: 'UPSTREAM_DOWN', status: 503};
+
+  it.each([
+    ['a string', 'provider exploded'],
+    ['a plain object', plainObject],
+    ['undefined', undefined],
+  ])(
+    'calls onError once with an Error whose cause is %s, and the caller still receives the original rejection',
+    async (_label, rejection) => {
+      const received: unknown[] = [];
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => void received.push(error),
+      };
+
+      const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+      const outcome = await settle(orchestrator.processMessage(createSession()));
+
+      expect({
+        outcome,
+        onErrorCalls: received.length,
+        isError: received[0] instanceof Error,
+        cause: (received[0] as Error | undefined)?.cause,
+      }).toEqual({
+        outcome: {rejected: true, value: rejection},
+        onErrorCalls: 1,
+        isError: true,
+        cause: rejection,
+      });
+      // toEqual is structural; the caller must get the very value thrown, not a copy.
+      expect(outcome.value).toBe(rejection);
+    }
+  );
+});