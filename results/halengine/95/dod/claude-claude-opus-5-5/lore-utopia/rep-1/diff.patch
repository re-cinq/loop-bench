+// Acceptance tests for re-cinq/HALEngine#95; validates specs/hal-engine-config-hooks/spec.md#onError-every-rejection.
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const NOT_REJECTED = Symbol('resolved without rejecting');
+
+const session = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+});
+
+// A provider whose stream rejects with an arbitrary value, the way a third-party library might.
+const rejectingProvider = (value: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw value;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('onError for a rejection that is not an Error (specs/hal-engine-config-hooks/spec.md)', () => {
+  it.each([
+    ['a string', 'provider exploded'],
+    ['a plain object', {code: 'E_UPSTREAM', detail: 'rate limited'}],
+    ['undefined', undefined],
+  ])(
+    'calls onError once with an Error whose cause is %s, and the caller still receives the original rejection',
+    async (_label, rejection) => {
+      const received: Error[] = [];
+      const hooks: OrchestratorHooks = {onError: async (_session, error) => void received.push(error)};
+      const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+
+      const callerSaw = await orchestrator.processMessage(session()).then(
+        () => NOT_REJECTED,
+        (error: unknown) => error
+      );
+
+      expect({
+        callerSaw,
+        onErrorCalls: received.length,
+        isError: received[0] instanceof Error,
+        carriesCause: received[0] !== undefined && 'cause' in received[0],
+        cause: received[0]?.cause,
+      }).toEqual({callerSaw: rejection, onErrorCalls: 1, isError: true, carriesCause: true, cause: rejection});
+      expect(callerSaw).toBe(rejection);
+    }
+  );
+});