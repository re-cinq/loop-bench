+// Validates specs/hal-engine-config-hooks/spec.md#onerror-for-every-rejection (HALEngine#95).
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const RESOLVED = Symbol('resolved without throwing');
+
+function rejectingProvider(value: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw value;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const session = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+describe('onError for a rejection that is not an Error', () => {
+  it.each([
+    ['a string', 'provider exploded'],
+    ['a plain object', {code: 'E_PROVIDER', retryable: false}],
+    ['undefined', undefined],
+  ])(
+    'calls onError once with an Error whose cause is %s, and still rejects with the original value',
+    async (_label, rejection) => {
+      const seen: unknown[] = [];
+      const orchestrator = createChatOrchestrator(
+        rejectingProvider(rejection),
+        new PromptBuilder({identity: 'You are a test assistant.'}),
+        undefined,
+        {hooks: {onError: async (_session, error) => void seen.push(error)}}
+      );
+
+      const received = await orchestrator.processMessage(session()).then(
+        () => RESOLVED,
+        (error: unknown) => error
+      );
+
+      expect({
+        onErrorCalls: seen.length,
+        isError: seen[0] instanceof Error,
+        cause: (seen[0] as Error | undefined)?.cause,
+        hasCause: seen[0] instanceof Error && 'cause' in seen[0],
+        callerReceivedOriginal: received === rejection,
+      }).toEqual({
+        onErrorCalls: 1,
+        isError: true,
+        cause: rejection,
+        hasCause: true,
+        callerReceivedOriginal: true,
+      });
+    }
+  );
+});