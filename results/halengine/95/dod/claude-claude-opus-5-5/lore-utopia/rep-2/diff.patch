+// Acceptance test for re-cinq/HALEngine#95 (specs/hal-engine-config-hooks/spec.md, Error reporting).
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const createSession = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+});
+
+// A provider that rejects with an arbitrary value, the way a library with its own rejection shape would.
+const rejectingProvider = (rejection: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+const PLAIN_OBJECT = {code: 'UPSTREAM_DOWN', retryable: false};
+
+describe('onError for a rejection that is not an Error (specs/hal-engine-config-hooks/spec.md, Error reporting)', () => {
+  it.each([
+    ['a string', 'provider exploded'],
+    ['a plain object', PLAIN_OBJECT],
+    ['undefined', undefined],
+  ])(
+    'calls onError once with an Error whose cause is %s, and the caller still receives the original rejection',
+    async (_label, rejection) => {
+      const received: unknown[] = [];
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => void received.push(error),
+      };
+
+      const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+      const caught = await orchestrator.processMessage(createSession()).then(
+        () => ({rejected: false, value: undefined as unknown}),
+        (value: unknown) => ({rejected: true, value})
+      );
+
+      expect({
+        onErrorCalls: received.length,
+        isError: received[0] instanceof Error,
+        causeIsOriginal: received[0] instanceof Error && received[0].cause === rejection,
+        callerRejected: caught.rejected,
+        callerReceivedOriginal: caught.value === rejection,
+      }).toEqual({
+        onErrorCalls: 1,
+        isError: true,
+        causeIsOriginal: true,
+        callerRejected: true,
+        callerReceivedOriginal: true,
+      });
+    }
+  );
+});