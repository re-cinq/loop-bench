@@ -0,0 +1,75 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Acceptance for re-cinq/HALEngine#95; validates specs/hal-engine-config-hooks/spec.md#8, #9 and #10.
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const createSession = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+});
+
+// A provider whose stream rejects with an arbitrary value, the way a library with its own rejection shape would.
+const rejectingProvider = (value: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw value;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+// What onError received and what the caller saw, for a provider that rejects with the given value.
+const observe = async (rejection: unknown) => {
+  const received: unknown[] = [];
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => {
+      received.push(error);
+    },
+  };
+
+  const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+  const callerSaw = await orchestrator.processMessage(createSession()).then(
+    () => ({rejected: false, value: undefined as unknown}),
+    (value: unknown) => ({rejected: true, value})
+  );
+
+  const [hookError] = received;
+  return {
+    onErrorCalls: received.length,
+    isError: hookError instanceof Error,
+    causeIsOriginal: hookError instanceof Error && Object.is(hookError.cause, rejection),
+    callerRejected: callerSaw.rejected,
+    callerValueIsOriginal: Object.is(callerSaw.value, rejection),
+  };
+};
+
+const WRAPPED_AND_UNCHANGED = {
+  onErrorCalls: 1,
+  isError: true,
+  causeIsOriginal: true,
+  callerRejected: true,
+  callerValueIsOriginal: true,
+};
+
+describe('onError for a rejection that is not an Error (specs/hal-engine-config-hooks/spec.md#8)', () => {
+  it('calls onError once with an Error whose cause is the rejected string, and rejects the caller with the string', async () => {
+    expect(await observe('provider exploded')).toEqual(WRAPPED_AND_UNCHANGED);
+  });
+
+  it('calls onError once with an Error whose cause is the rejected plain object, and rejects the caller with it', async () => {
+    expect(await observe({code: 'E_UPSTREAM', detail: 'bad gateway'})).toEqual(WRAPPED_AND_UNCHANGED);
+  });
+
+  it('calls onError once with an Error whose cause is undefined, and rejects the caller with undefined', async () => {
+    expect(await observe(undefined)).toEqual(WRAPPED_AND_UNCHANGED);
+  });
+});