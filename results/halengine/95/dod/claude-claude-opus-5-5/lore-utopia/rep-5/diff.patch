@@ -0,0 +1,65 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const session = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+});
+
+// A provider whose stream rejects with an arbitrary value, the way a library with its own error shape would.
+const rejectingProvider = (rejection: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const settle = (call: Promise<unknown>): Promise<{rejected: boolean; value: unknown}> =>
+  call.then(
+    value => ({rejected: false, value}),
+    (value: unknown) => ({rejected: true, value})
+  );
+
+describe('specs/hal-engine-config-hooks/spec.md#8 onError for a rejection that is not an Error', () => {
+  it.each([
+    ['a string', 'provider exploded'],
+    ['a plain object', {code: 'E_UPSTREAM', status: 503}],
+    ['undefined', undefined],
+  ])(
+    'calls onError once with an Error whose cause is %s, and the caller still receives the original rejection',
+    async (_label, rejection) => {
+      const seen: {isError: boolean; hasCause: boolean; cause: unknown}[] = [];
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          // hasCause separates `cause: undefined` from no cause at all, which a plain read cannot.
+          seen.push({
+            isError: error instanceof Error,
+            hasCause: Object.prototype.hasOwnProperty.call(error, 'cause'),
+            cause: (error as {cause?: unknown}).cause,
+          });
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+      const outcome = await settle(orchestrator.processMessage(session()));
+
+      expect({outcome, seen}).toEqual({
+        outcome: {rejected: true, value: rejection},
+        seen: [{isError: true, hasCause: true, cause: rejection}],
+      });
+      // toEqual is structural; the caller must get the very value the provider threw, not a copy or a wrapper.
+      expect(outcome.value).toBe(rejection);
+    }
+  );
+});