+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+// specs/hal-engine-config-hooks/spec.md#9
+it('reports every rejection as an Error while preserving the original caller rejection', async () => {
+  const originalObject = {code: 'upstream_failure'};
+  const originalError = new Error('already an Error');
+  const reasons: unknown[] = ['upstream rejected', originalObject, undefined, originalError];
+  const observations = [];
+
+  for (const reason of reasons) {
+    const errors: Error[] = [];
+    const session: ChatSession = {
+      sessionId: 'rejection-session',
+      userId: 'user',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const orchestrator = createChatOrchestrator(
+      createMockProvider(),
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      undefined,
+      {
+        hooks: {
+          afterModelResponse: async () => {
+            throw reason;
+          },
+          onError: async (_session, error) => {
+            errors.push(error);
+          },
+        },
+      }
+    );
+    const outcome = await orchestrator.processMessage(session).then(
+      () => ({rejected: false, value: undefined}),
+      (value: unknown) => ({rejected: true, value})
+    );
+    const reported = errors[0];
+    observations.push({
+      rejected: outcome.rejected,
+      originalRejection: Object.is(outcome.value, reason),
+      calls: errors.length,
+      reportedError: reported instanceof Error,
+      preservedReason:
+        reason instanceof Error
+          ? reported === reason
+          : reported instanceof Error && Object.hasOwn(reported, 'cause') && Object.is(reported.cause, reason),
+    });
+  }
+
+  expect(observations).toEqual(
+    reasons.map(() => ({
+      rejected: true,
+      originalRejection: true,
+      calls: 1,
+      reportedError: true,
+      preservedReason: true,
+    }))
+  );
+});