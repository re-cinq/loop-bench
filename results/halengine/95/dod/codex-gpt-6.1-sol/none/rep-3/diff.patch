+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+// Spec: specs/hal-engine-config-hooks/spec.md#10
+it('reports non-Error rejections once with their original cause and preserves caller rejection identity', async () => {
+  const observations = [];
+  for (const rejection of ['provider unavailable', {code: 'UNAVAILABLE'}, undefined]) {
+    for (const entryPoint of ['processMessage', 'processMessageStream'] as const) {
+      const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+      const reported: {session: ChatSession; error: Error}[] = [];
+      const orchestrator = createChatOrchestrator(
+        createMockProvider(),
+        new PromptBuilder({identity: 'Acceptance test assistant'}),
+        undefined,
+        {
+          hooks: {
+            beforeModelResponse: async () => {
+              throw rejection;
+            },
+            onError: async (session, error) => {
+              reported.push({session, error});
+            },
+          },
+        }
+      );
+      const consume = async () => {
+        if (entryPoint === 'processMessage') return orchestrator.processMessage(session);
+        for await (const chunk of orchestrator.processMessageStream(session)) {
+          void chunk;
+        }
+      };
+      const outcome = await consume().then(
+        () => ({rejected: false, value: undefined}),
+        (value: unknown) => ({rejected: true, value})
+      );
+      observations.push({
+        entryPoint,
+        rejection,
+        rejected: outcome.rejected,
+        callerReceivedOriginal: Object.is(outcome.value, rejection),
+        hookCalls: reported.length,
+        hookReceivedSession: reported[0]?.session === session,
+        hookReceivedError: reported[0]?.error instanceof Error,
+        hookPreservedCause:
+          reported.length === 1 &&
+          Object.hasOwn(reported[0].error, 'cause') &&
+          Object.is(reported[0].error.cause, rejection),
+      });
+    }
+  }
+
+  expect(observations).toEqual(
+    ['provider unavailable', {code: 'UNAVAILABLE'}, undefined].flatMap(rejection =>
+      ['processMessage', 'processMessageStream'].map(entryPoint => ({
+        entryPoint,
+        rejection,
+        rejected: true,
+        callerReceivedOriginal: true,
+        hookCalls: 1,
+        hookReceivedSession: true,
+        hookReceivedError: true,
+        hookPreservedCause: true,
+      }))
+    )
+  );
+});