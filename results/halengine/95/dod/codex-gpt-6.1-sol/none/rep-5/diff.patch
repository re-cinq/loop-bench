+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {createMockProvider} from '../providers/mock/index.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+// Spec: specs/hal-engine-config-hooks/spec.md#9
+it('reports every rejection once as an Error while preserving the caller rejection', async () => {
+  const failures: unknown[] = ['provider unavailable', {code: 'UNAVAILABLE'}, undefined, new Error('unavailable')];
+  const observations = [];
+
+  for (const rejection of failures) {
+    for (const streaming of [false, true]) {
+      const session: ChatSession = {
+        sessionId: 'rejection-session',
+        userId: 'user',
+        entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+      };
+      const reported: Error[] = [];
+      const orchestrator = createChatOrchestrator(
+        createMockProvider(),
+        new PromptBuilder({identity: 'You are a test assistant.'}),
+        undefined,
+        {
+          hooks: {
+            afterModelResponse: () => Promise.reject(rejection),
+            onError: async (_session, error) => {
+              reported.push(error);
+            },
+          },
+        }
+      );
+      let rejected = false;
+      let received: unknown;
+      try {
+        if (streaming) {
+          for await (const chunk of orchestrator.processMessageStream(session)) {
+            void chunk;
+          }
+        } else {
+          await orchestrator.processMessage(session);
+        }
+      } catch (error) {
+        rejected = true;
+        received = error;
+      }
+
+      observations.push({
+        rejected,
+        callerReceivesOriginal: Object.is(received, rejection),
+        hookCalls: reported.length,
+        hookReceivesError: reported[0] instanceof Error,
+        hookPreservesOriginal:
+          rejection instanceof Error
+            ? reported[0] === rejection
+            : reported.length === 1 && Object.is(reported[0].cause, rejection),
+      });
+    }
+  }
+
+  expect(observations).toEqual(
+    Array.from({length: failures.length * 2}, () => ({
+      rejected: true,
+      callerReceivesOriginal: true,
+      hookCalls: 1,
+      hookReceivesError: true,
+      hookPreservesOriginal: true,
+    }))
+  );
+});