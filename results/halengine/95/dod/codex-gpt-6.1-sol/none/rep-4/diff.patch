+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {createVertexProvider} from '../providers/vertex/vertexProvider.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+// specs/hal-engine-config-hooks/spec.md#10
+it('reports every non-Error rejection once with its cause while preserving the caller rejection', async () => {
+  const rejections = ['provider unavailable', {code: 'UNAVAILABLE'}, undefined];
+  const observations = [];
+  const provider = createVertexProvider({
+    type: 'vertex',
+    projectId: 'acceptance',
+    location: 'europe-west1',
+    modelId: 'gemini-2.0-flash',
+  });
+
+  for (const rejection of rejections) {
+    const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+    const errors: Error[] = [];
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Assistant'}), undefined, {
+      hooks: {
+        beforeModelResponse: async () => {
+          throw rejection;
+        },
+        onError: async (_session, error) => {
+          errors.push(error);
+        },
+      },
+    });
+    const outcome = await orchestrator.processMessage(session).then(
+      () => ({rejected: false, value: undefined}),
+      (value: unknown) => ({rejected: true, value})
+    );
+    observations.push({
+      rejected: outcome.rejected,
+      originalRejection: Object.is(outcome.value, rejection),
+      hookCalls: errors.length,
+      wrapped: errors[0] instanceof Error,
+      originalCause: errors.length === 1 && Object.is(errors[0].cause, rejection),
+    });
+  }
+
+  expect(observations).toEqual(
+    rejections.map(() => ({
+      rejected: true,
+      originalRejection: true,
+      hookCalls: 1,
+      wrapped: true,
+      originalCause: true,
+    }))
+  );
+});