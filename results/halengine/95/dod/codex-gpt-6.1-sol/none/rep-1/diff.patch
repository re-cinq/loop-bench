+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+// specs/hal-engine-config-hooks/spec.md#10
+it('reports every rejection as an Error while preserving the original caller rejection', async () => {
+  const existingError = new Error('already an Error');
+  const rejections: unknown[] = ['provider unavailable', {code: 'UNAVAILABLE'}, undefined, existingError];
+  const observations = [];
+
+  for (const rejection of rejections) {
+    const session: ChatSession = {
+      sessionId: 'rejected-turn',
+      userId: 'user',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const errors: Error[] = [];
+    const sessions: ChatSession[] = [];
+    const orchestrator = createChatOrchestrator(
+      createMockProvider(),
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      undefined,
+      {
+        hooks: {
+          beforeModelResponse: async () => {
+            throw rejection;
+          },
+          onError: async (receivedSession, error) => {
+            sessions.push(receivedSession);
+            errors.push(error);
+          },
+        },
+      }
+    );
+    const outcome = await orchestrator.processMessage(session).then(
+      () => ({rejected: false, value: undefined}),
+      (value: unknown) => ({rejected: true, value})
+    );
+    observations.push({
+      rejected: outcome.rejected,
+      callerReceivedOriginal: Object.is(outcome.value, rejection),
+      hookCalls: errors.length,
+      hookReceivedSession: sessions[0] === session,
+      hookReceivedError: errors[0] instanceof Error,
+      originalPreserved: rejection instanceof Error ? errors[0] === rejection : Object.is(errors[0]?.cause, rejection),
+    });
+  }
+
+  expect(observations).toEqual(
+    rejections.map(() => ({
+      rejected: true,
+      callerReceivedOriginal: true,
+      hookCalls: 1,
+      hookReceivedSession: true,
+      hookReceivedError: true,
+      originalPreserved: true,
+    }))
+  );
+});