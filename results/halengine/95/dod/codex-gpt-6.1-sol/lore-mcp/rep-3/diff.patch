+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {createBedrockProvider} from '../providers/bedrock/bedrockProvider.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+// specs/hal-engine-config-hooks/spec.md#10
+it('reports every rejection as an Error while preserving the original caller rejection', async () => {
+  const provider = createBedrockProvider({type: 'bedrock', modelId: 'unused', region: 'eu-west-1', maxTokens: 1});
+  const reasons: unknown[] = ['provider failed', {code: 'LIBRARY_FAILURE'}, undefined, new Error('already an Error')];
+  const observations = [];
+
+  for (const reason of reasons) {
+    const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+    const received: {session: ChatSession; error: Error}[] = [];
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Acceptance test'}), undefined, {
+      hooks: {
+        beforeModelResponse: async () => {
+          throw reason;
+        },
+        onError: async (hookSession, error) => {
+          received.push({session: hookSession, error});
+        },
+      },
+    });
+    const outcome = await orchestrator.processMessage(session).then(
+      () => ({rejected: false, reason: undefined}),
+      (rejection: unknown) => ({rejected: true, reason: rejection})
+    );
+    observations.push({
+      rejected: outcome.rejected,
+      originalRejection: Object.is(outcome.reason, reason),
+      hookCalls: received.length,
+      sameSession: received[0]?.session === session,
+      hookError: received[0]?.error instanceof Error,
+      preservedReason:
+        reason instanceof Error
+          ? received[0]?.error === reason
+          : received[0]?.error instanceof Error && Object.is(received[0].error.cause, reason),
+    });
+  }
+
+  expect(observations).toEqual(
+    reasons.map(() => ({
+      rejected: true,
+      originalRejection: true,
+      hookCalls: 1,
+      sameSession: true,
+      hookError: true,
+      preservedReason: true,
+    }))
+  );
+});