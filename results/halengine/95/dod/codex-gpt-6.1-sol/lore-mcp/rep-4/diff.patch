+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {createBedrockProvider} from '../providers/bedrock/bedrockProvider.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+// @spec specs/hal-engine-config-hooks/spec.md#9
+it('reports every rejection once as an Error while preserving the original caller rejection', async () => {
+  const provider = createBedrockProvider({type: 'bedrock', modelId: 'unused', region: 'eu-west-1', maxTokens: 1});
+  const values: unknown[] = ['provider unavailable', {code: 'unavailable'}, undefined, new Error('existing error')];
+  const observations = [];
+
+  for (const entryPoint of ['processMessage', 'processMessageStream'] as const) {
+    for (const value of values) {
+      const session: ChatSession = {
+        sessionId: 'rejection-session',
+        userId: 'user',
+        entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+      };
+      const errors: Error[] = [];
+      const sessions: ChatSession[] = [];
+      const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Assistant'}), undefined, {
+        hooks: {
+          beforeModelResponse: async () => {
+            throw value;
+          },
+          onError: async (hookSession, error) => {
+            sessions.push(hookSession);
+            errors.push(error);
+          },
+        },
+      });
+      let rejected = false;
+      let rejection: unknown;
+      try {
+        if (entryPoint === 'processMessage') {
+          await orchestrator.processMessage(session);
+        } else {
+          for await (const chunk of orchestrator.processMessageStream(session)) {
+            void chunk;
+          }
+        }
+      } catch (error) {
+        rejected = true;
+        rejection = error;
+      }
+      const reported = errors[0];
+      observations.push({
+        entryPoint,
+        value,
+        rejected,
+        originalRejection: Object.is(rejection, value),
+        hookCalls: errors.length,
+        sameSession: sessions[0] === session,
+        reportedError: reported instanceof Error,
+        preservedValue:
+          value instanceof Error
+            ? reported === value
+            : reported !== undefined && Object.hasOwn(reported, 'cause') && Object.is(reported.cause, value),
+      });
+    }
+  }
+
+  expect(observations).toEqual(
+    ['processMessage', 'processMessageStream'].flatMap(entryPoint =>
+      values.map(value => ({
+        entryPoint,
+        value,
+        rejected: true,
+        originalRejection: true,
+        hookCalls: 1,
+        sameSession: true,
+        reportedError: true,
+        preservedValue: true,
+      }))
+    )
+  );
+});