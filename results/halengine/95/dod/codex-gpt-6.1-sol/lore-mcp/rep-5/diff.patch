+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+// Spec: specs/hal-engine-config-hooks/spec.md#9
+it('reports every non-Error rejection once with its original cause and preserves the caller rejection', async () => {
+  const rejections = ['upstream failed', {code: 'UPSTREAM_FAILED'}, undefined, new Error('already an Error')];
+  const observations = [];
+
+  for (const rejection of rejections) {
+    for (const entryPoint of ['processMessage', 'processMessageStream'] as const) {
+      const session: ChatSession = {
+        sessionId: 'rejection-session',
+        userId: 'rejection-user',
+        entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+      };
+      const reported: Error[] = [];
+      const orchestrator = createChatOrchestrator(
+        createMockProvider(),
+        new PromptBuilder({identity: 'You are a test assistant.'}),
+        undefined,
+        {
+          hooks: {
+            afterModelResponse: async () => {
+              throw rejection;
+            },
+            onError: async (_session, error) => {
+              reported.push(error);
+            },
+          },
+        }
+      );
+      let rejected = false;
+      let callerValue: unknown;
+      try {
+        if (entryPoint === 'processMessage') {
+          await orchestrator.processMessage(session);
+        } else {
+          for await (const chunk of orchestrator.processMessageStream(session)) {
+            void chunk;
+          }
+        }
+      } catch (error) {
+        rejected = true;
+        callerValue = error;
+      }
+      observations.push({
+        entryPoint,
+        rejected,
+        callerReceivedOriginal: Object.is(callerValue, rejection),
+        hookCalls: reported.length,
+        hookReceivedError: reported[0] instanceof Error,
+        hookReceivedOriginalCause:
+          rejection instanceof Error
+            ? reported[0] === rejection
+            : reported.length === 1 && Object.hasOwn(reported[0], 'cause') && Object.is(reported[0].cause, rejection),
+      });
+    }
+  }
+
+  expect(observations).toEqual(
+    rejections.flatMap(() =>
+      ['processMessage', 'processMessageStream'].map(entryPoint => ({
+        entryPoint,
+        rejected: true,
+        callerReceivedOriginal: true,
+        hookCalls: 1,
+        hookReceivedError: true,
+        hookReceivedOriginalCause: true,
+      }))
+    )
+  );
+});