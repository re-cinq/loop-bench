+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {createMockProvider} from '../providers/mock/index.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+// Spec: specs/hal-engine-config-hooks/spec.md#9
+it('reports every rejection once as an Error while preserving the caller rejection', async () => {
+  const reasons: unknown[] = ['provider unavailable', {code: 'UNAVAILABLE'}, undefined, new Error('unavailable')];
+  const observations = [];
+
+  for (const reason of reasons) {
+    for (const mode of ['message', 'stream']) {
+      const session: ChatSession = {
+        sessionId: 'rejection-session',
+        userId: 'rejection-user',
+        entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+      };
+      const errors: {session: ChatSession; error: Error}[] = [];
+      const orchestrator = createChatOrchestrator(
+        createMockProvider(),
+        new PromptBuilder({identity: 'You are helpful.'}),
+        undefined,
+        {
+          hooks: {
+            afterModelResponse: async () => {
+              throw reason;
+            },
+            onError: async (hookSession, error) => {
+              errors.push({session: hookSession, error});
+            },
+          },
+        }
+      );
+      let rejected = false;
+      let received: unknown;
+      try {
+        if (mode === 'message') {
+          await orchestrator.processMessage(session);
+        } else {
+          for await (const chunk of orchestrator.processMessageStream(session)) {
+            void chunk;
+          }
+        }
+      } catch (error) {
+        rejected = true;
+        received = error;
+      }
+      const reported = errors[0];
+      observations.push({
+        mode,
+        reason,
+        rejected,
+        callerKeptOriginal: Object.is(received, reason),
+        hookCalls: errors.length,
+        hookKeptSession: reported?.session === session,
+        hookReceivedError: reported?.error instanceof Error,
+        hookPreservedReason:
+          reason instanceof Error ? reported?.error === reason : Object.is(reported?.error.cause, reason),
+      });
+    }
+  }
+
+  expect(observations).toEqual(
+    reasons.flatMap(reason =>
+      ['message', 'stream'].map(mode => ({
+        mode,
+        reason,
+        rejected: true,
+        callerKeptOriginal: true,
+        hookCalls: 1,
+        hookKeptSession: true,
+        hookReceivedError: true,
+        hookPreservedReason: true,
+      }))
+    )
+  );
+});