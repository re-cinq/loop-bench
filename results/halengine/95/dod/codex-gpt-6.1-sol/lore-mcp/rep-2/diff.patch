+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {createOpenAIProvider} from '../providers/openai/index.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+// specs/hal-engine-config-hooks/spec.md#9
+it('reports every rejection as an Error while preserving the caller rejection', async () => {
+  const originalError = new Error('already an Error');
+  const rejections: unknown[] = ['provider failed', {code: 'FAILED'}, undefined, originalError];
+  const observed = [];
+  const expected = [];
+
+  for (const entryPoint of ['processMessage', 'processMessageStream'] as const) {
+    for (const rejection of rejections) {
+      const session: ChatSession = {
+        sessionId: 'rejection-session',
+        userId: 'rejection-user',
+        entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+      };
+      const errors: Error[] = [];
+      const orchestrator = createChatOrchestrator(
+        createOpenAIProvider({type: 'openai', apiKey: 'unused', model: 'unused'}),
+        new PromptBuilder({identity: 'Test assistant'}),
+        undefined,
+        {
+          hooks: {
+            beforeModelResponse: () => Promise.reject(rejection),
+            onError: async (_session, error) => {
+              errors.push(error);
+            },
+          },
+        }
+      );
+      let outcome: unknown = Symbol('did not reject');
+      try {
+        if (entryPoint === 'processMessage') {
+          await orchestrator.processMessage(session);
+        } else {
+          for await (const chunk of orchestrator.processMessageStream(session)) {
+            outcome = chunk;
+          }
+        }
+      } catch (error) {
+        outcome = error;
+      }
+      observed.push({
+        entryPoint,
+        rejection,
+        calls: errors.length,
+        receivedError: errors[0] instanceof Error,
+        preserved:
+          rejection instanceof Error
+            ? errors[0] === rejection
+            : errors.length === 1 && Object.hasOwn(errors[0], 'cause') && Object.is(errors[0].cause, rejection),
+        callerUnchanged: Object.is(outcome, rejection),
+      });
+      expected.push({entryPoint, rejection, calls: 1, receivedError: true, preserved: true, callerUnchanged: true});
+    }
+  }
+
+  expect(observed).toEqual(expected);
+});