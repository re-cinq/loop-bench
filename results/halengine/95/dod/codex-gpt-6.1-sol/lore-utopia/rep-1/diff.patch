+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {createMockProvider} from '../providers/mock/index.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+// specs/hal-engine-config-hooks/spec.md#9
+it('reports every rejection as an Error while preserving the caller rejection', async () => {
+  const originalError = new Error('existing Error');
+  const rejections: unknown[] = ['provider unavailable', {code: 'UNAVAILABLE'}, undefined, originalError];
+  const observations = [];
+
+  for (const rejection of rejections) {
+    for (const entryPoint of ['processMessage', 'processMessageStream'] as const) {
+      const session: ChatSession = {
+        sessionId: 'rejected-turn',
+        userId: 'user',
+        entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+      };
+      const calls: {session: ChatSession; error: Error}[] = [];
+      const orchestrator = createChatOrchestrator(
+        createMockProvider(),
+        new PromptBuilder({identity: 'You are a test assistant.'}),
+        undefined,
+        {
+          hooks: {
+            afterModelResponse: async () => {
+              throw rejection;
+            },
+            onError: async (hookSession, error) => {
+              calls.push({session: hookSession, error});
+            },
+          },
+        }
+      );
+      let rejected = false;
+      let received: unknown;
+      try {
+        if (entryPoint === 'processMessage') {
+          await orchestrator.processMessage(session);
+        } else {
+          for await (const chunk of orchestrator.processMessageStream(session)) {
+            void chunk;
+          }
+        }
+      } catch (error) {
+        rejected = true;
+        received = error;
+      }
+      const reported = calls[0]?.error;
+      observations.push({
+        entryPoint,
+        rejection,
+        rejected,
+        callerPreserved: Object.is(received, rejection),
+        hookCalls: calls.length,
+        sessionPreserved: calls[0]?.session === session,
+        reportedError: reported instanceof Error,
+        originalPreserved: rejection instanceof Error ? reported === rejection : Object.is(reported?.cause, rejection),
+      });
+    }
+  }
+
+  expect(observations).toEqual(
+    rejections.flatMap(rejection =>
+      ['processMessage', 'processMessageStream'].map(entryPoint => ({
+        entryPoint,
+        rejection,
+        rejected: true,
+        callerPreserved: true,
+        hookCalls: 1,
+        sessionPreserved: true,
+        reportedError: true,
+        originalPreserved: true,
+      }))
+    )
+  );
+});