+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createOpenAIProvider} from '../providers/openai/index.js';
+import type {ChatSession} from '../types/session.js';
+
+// specs/hal-engine-config-hooks/spec.md#12
+it('reports non-Error rejections once with their original cause and preserves caller rejection identity', async () => {
+  const reasons: unknown[] = ['provider unavailable', {code: 'unavailable'}, undefined];
+  const observations = [];
+
+  for (const reason of reasons) {
+    for (const entryPoint of ['processMessage', 'processMessageStream'] as const) {
+      const session: ChatSession = {
+        sessionId: 'rejected-turn',
+        userId: 'deployer',
+        entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+      };
+      const errors: Error[] = [];
+      const sessions: ChatSession[] = [];
+      const orchestrator = createChatOrchestrator(
+        createOpenAIProvider({type: 'openai', apiKey: 'unused', model: 'unused'}),
+        new PromptBuilder({identity: 'Acceptance test assistant'}),
+        undefined,
+        {
+          hooks: {
+            beforeModelResponse: async () => Promise.reject(reason),
+            onError: async (failedSession, error) => {
+              sessions.push(failedSession);
+              errors.push(error);
+            },
+          },
+        }
+      );
+      let rejected = false;
+      let received: unknown;
+      try {
+        if (entryPoint === 'processMessage') {
+          await orchestrator.processMessage(session);
+        } else {
+          for await (const chunk of orchestrator.processMessageStream(session)) {
+            void chunk;
+          }
+        }
+      } catch (error) {
+        rejected = true;
+        received = error;
+      }
+      observations.push({
+        entryPoint,
+        reason,
+        rejected,
+        originalRejection: Object.is(received, reason),
+        calls: errors.length,
+        sameSession: sessions.length === 1 && sessions[0] === session,
+        wrapped: errors[0] instanceof Error,
+        originalCause: errors.length === 1 && Object.is(errors[0].cause, reason),
+      });
+    }
+  }
+
+  expect(observations).toEqual(
+    reasons.flatMap(reason =>
+      ['processMessage', 'processMessageStream'].map(entryPoint => ({
+        entryPoint,
+        reason,
+        rejected: true,
+        originalRejection: true,
+        calls: 1,
+        sameSession: true,
+        wrapped: true,
+        originalCause: true,
+      }))
+    )
+  );
+});