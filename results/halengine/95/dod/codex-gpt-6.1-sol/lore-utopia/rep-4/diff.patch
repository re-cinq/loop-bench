+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+// spec: specs/hal-engine-config-hooks/spec.md#9
+it('reports every rejection as an Error while preserving the original caller rejection', async () => {
+  const results = [];
+  const originalError = new Error('already an Error');
+  const rejections: unknown[] = ['provider unavailable', {code: 'unavailable'}, undefined, originalError];
+
+  for (const rejection of rejections) {
+    for (const entryPoint of ['processMessage', 'processMessageStream'] as const) {
+      const received: Error[] = [];
+      const session: ChatSession = {
+        sessionId: 'rejection-session',
+        userId: 'user',
+        entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+      };
+      const orchestrator = createChatOrchestrator(
+        createMockProvider(),
+        new PromptBuilder({identity: 'Assistant'}),
+        undefined,
+        {
+          hooks: {
+            afterModelResponse: async () => {
+              throw rejection;
+            },
+            onError: async (_session, error) => {
+              received.push(error);
+            },
+          },
+        }
+      );
+      let rejected = false;
+      let callerRejection: unknown;
+      try {
+        if (entryPoint === 'processMessage') {
+          await orchestrator.processMessage(session);
+        } else {
+          for await (const chunk of orchestrator.processMessageStream(session)) {
+            void chunk;
+          }
+        }
+      } catch (error) {
+        rejected = true;
+        callerRejection = error;
+      }
+      results.push({
+        entryPoint,
+        rejection,
+        rejected,
+        callerPreserved: Object.is(callerRejection, rejection),
+        hookCalls: received.length,
+        hookReceivesError: received[0] instanceof Error,
+        originalPreserved:
+          rejection instanceof Error
+            ? received[0] === rejection
+            : received[0] !== undefined &&
+              Object.hasOwn(received[0], 'cause') &&
+              Object.is(received[0].cause, rejection),
+      });
+    }
+  }
+
+  expect(results).toEqual(
+    rejections.flatMap(rejection =>
+      ['processMessage', 'processMessageStream'].map(entryPoint => ({
+        entryPoint,
+        rejection,
+        rejected: true,
+        callerPreserved: true,
+        hookCalls: 1,
+        hookReceivesError: true,
+        originalPreserved: true,
+      }))
+    )
+  );
+});