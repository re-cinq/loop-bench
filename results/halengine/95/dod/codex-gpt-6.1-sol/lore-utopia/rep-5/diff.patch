+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import type {ChatSession} from '../types/session.js';
+
+// Spec: specs/hal-engine-config-hooks/spec.md#9
+it('reports every non-Error rejection with its original cause while preserving the caller rejection', async () => {
+  const results: unknown[] = [];
+  for (const rejection of ['provider unavailable', {code: 'UNAVAILABLE'}, undefined]) {
+    for (const mode of ['message', 'stream']) {
+      const errors: Error[] = [];
+      const session: ChatSession = {
+        sessionId: 'rejected-turn',
+        userId: 'user',
+        entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+      };
+      const orchestrator = createChatOrchestrator(
+        createMockProvider(),
+        new PromptBuilder({identity: 'You are helpful.'}),
+        undefined,
+        {
+          hooks: {
+            beforeModelResponse: async () => Promise.reject(rejection),
+            onError: async (_session, error) => {
+              errors.push(error);
+            },
+          },
+        }
+      );
+      const call = async () => {
+        if (mode === 'message') return orchestrator.processMessage(session);
+        for await (const chunk of orchestrator.processMessageStream(session)) {
+          void chunk;
+        }
+      };
+      const outcome = await call().then(
+        () => ({rejected: false, value: undefined}),
+        (value: unknown) => ({rejected: true, value})
+      );
+      results.push({
+        mode,
+        rejection,
+        rejected: outcome.rejected,
+        originalRejection: Object.is(outcome.value, rejection),
+        calls: errors.length,
+        wrapped: errors[0] instanceof Error,
+        originalCause: errors.length === 1 && Object.is(errors[0].cause, rejection),
+      });
+    }
+  }
+  expect(results).toEqual(
+    ['provider unavailable', {code: 'UNAVAILABLE'}, undefined].flatMap(rejection =>
+      ['message', 'stream'].map(mode => ({
+        mode,
+        rejection,
+        rejected: true,
+        originalRejection: true,
+        calls: 1,
+        wrapped: true,
+        originalCause: true,
+      }))
+    )
+  );
+});