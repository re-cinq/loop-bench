+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {createBedrockProvider} from '../providers/bedrock/bedrockProvider.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+// spec: specs/hal-engine-config-hooks/spec.md#9
+it('reports every rejection once as an Error while preserving the caller rejection', async () => {
+  const provider = createBedrockProvider({
+    type: 'bedrock',
+    modelId: 'acceptance-test',
+    region: 'eu-central-1',
+    maxTokens: 1,
+  });
+  const originalError = new Error('already an Error');
+  const rejections: unknown[] = ['provider unavailable', {code: 'UNAVAILABLE'}, undefined, originalError];
+  const observations = [];
+
+  for (const rejection of rejections) {
+    for (const entryPoint of ['processMessage', 'processMessageStream'] as const) {
+      const session: ChatSession = {
+        sessionId: 'rejection-session',
+        userId: 'rejection-user',
+        entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+      };
+      const calls: {session: ChatSession; error: Error}[] = [];
+      const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Assistant'}), undefined, {
+        hooks: {
+          beforeModelResponse: async () => {
+            throw rejection;
+          },
+          onError: async (hookSession, error) => {
+            calls.push({session: hookSession, error});
+          },
+        },
+      });
+      let rejected = false;
+      let received: unknown;
+      try {
+        if (entryPoint === 'processMessage') {
+          await orchestrator.processMessage(session);
+        } else {
+          for await (const chunk of orchestrator.processMessageStream(session)) {
+            void chunk;
+          }
+        }
+      } catch (error) {
+        rejected = true;
+        received = error;
+      }
+      const reported = calls[0]?.error;
+      observations.push({
+        entryPoint,
+        rejection,
+        rejected,
+        callerValueUnchanged: Object.is(received, rejection),
+        hookCalls: calls.length,
+        sameSession: calls[0]?.session === session,
+        reportsError: reported instanceof Error,
+        preservesOriginal: rejection instanceof Error ? reported === rejection : Object.is(reported?.cause, rejection),
+      });
+    }
+  }
+
+  expect(observations).toEqual(
+    rejections.flatMap(rejection =>
+      ['processMessage', 'processMessageStream'].map(entryPoint => ({
+        entryPoint,
+        rejection,
+        rejected: true,
+        callerValueUnchanged: true,
+        hookCalls: 1,
+        sameSession: true,
+        reportsError: true,
+        preservesOriginal: true,
+      }))
+    )
+  );
+});