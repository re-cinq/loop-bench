+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const UNTHROWN = Symbol('unthrown');
+
+const caughtFrom = (turn: Promise<unknown>): Promise<unknown> =>
+  turn.then(() => UNTHROWN).catch((reason: unknown) => reason);
+
+const rejectingProvider = (rejection: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield -- throws before yielding to simulate an immediate provider rejection
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+describe('ChatOrchestrator onError non-Error rejections', () => {
+  // specs/hal-engine-config-hooks/spec.md#8
+  it('wraps a non-Error rejection in an Error whose cause is the original and still rejects the caller with the original', async () => {
+    const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+    const plainObject = {code: 'PROVIDER_FAILURE', retryable: false};
+    const rejections: unknown[] = ['provider string failure', plainObject, undefined];
+
+    const outcomes = [];
+    for (const rejection of rejections) {
+      const reported: Error[] = [];
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          reported.push(error);
+        },
+      };
+      const session: ChatSession = {
+        sessionId: 's1',
+        userId: 'u1',
+        entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+      };
+      const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+      const callerReceived = await caughtFrom(orchestrator.processMessage(session));
+      const [firstError] = reported;
+
+      outcomes.push({
+        onErrorCalls: reported.length,
+        wrappedInError: firstError instanceof Error,
+        causePreserved: firstError instanceof Error && firstError.cause === rejection,
+        callerReceivedOriginal: callerReceived === rejection,
+      });
+    }
+
+    expect(outcomes).toEqual([
+      {onErrorCalls: 1, wrappedInError: true, causePreserved: true, callerReceivedOriginal: true},
+      {onErrorCalls: 1, wrappedInError: true, causePreserved: true, callerReceivedOriginal: true},
+      {onErrorCalls: 1, wrappedInError: true, causePreserved: true, callerReceivedOriginal: true},
+    ]);
+  });
+});