@@ -0,0 +1,84 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const createSession = (content: string): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content, timestamp: SENT_AT}],
+});
+
+const createRejectingProvider = (value: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield -- rejects before yielding any chunk
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw value;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+const rejectionOf = (call: Promise<unknown>): Promise<unknown> =>
+  call.then(() => Symbol('resolved without throwing')).catch((reason: unknown) => reason);
+
+describe('ChatOrchestrator hooks: onError non-Error rejections (specs/hal-engine-config-hooks/spec.md#8)', () => {
+  it('wraps a non-Error rejection in an Error whose cause is the original and still rejects the caller with the original', async () => {
+    const plainObject = {code: 'UPSTREAM_503', retryable: true};
+    const cases: Array<{label: string; value: unknown}> = [
+      {label: 'string', value: 'upstream string failure'},
+      {label: 'object', value: plainObject},
+      {label: 'undefined', value: undefined},
+    ];
+
+    const observed = await Promise.all(
+      cases.map(async ({label, value}) => {
+        const received: unknown[] = [];
+        const hooks: OrchestratorHooks = {
+          onError: async (_session, error) => {
+            received.push(error);
+          },
+        };
+        const orchestrator = createChatOrchestrator(createRejectingProvider(value), promptBuilder, undefined, {hooks});
+        const callerRejection = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+        const [hookError] = received;
+
+        return {
+          label,
+          onErrorCalls: received.length,
+          isErrorInstance: hookError instanceof Error,
+          causeIsOriginal: hookError instanceof Error && hookError.cause === value,
+          callerReceivedOriginal: callerRejection === value,
+        };
+      })
+    );
+
+    expect(observed).toEqual([
+      {
+        label: 'string',
+        onErrorCalls: 1,
+        isErrorInstance: true,
+        causeIsOriginal: true,
+        callerReceivedOriginal: true,
+      },
+      {
+        label: 'object',
+        onErrorCalls: 1,
+        isErrorInstance: true,
+        causeIsOriginal: true,
+        callerReceivedOriginal: true,
+      },
+      {
+        label: 'undefined',
+        onErrorCalls: 1,
+        isErrorInstance: true,
+        causeIsOriginal: true,
+        callerReceivedOriginal: true,
+      },
+    ]);
+  });
+});