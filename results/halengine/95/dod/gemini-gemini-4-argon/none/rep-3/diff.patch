+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const sessionWith = (content: string): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content, timestamp: SENT_AT}],
+});
+
+const throwingProvider = (thrown: unknown): AIProvider => ({
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    yield* [] as MessageChunk[];
+    throw thrown;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const runFailingTurn = async (thrown: unknown) => {
+  const seen: Error[] = [];
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => {
+      seen.push(error);
+    },
+  };
+  const orchestrator = createChatOrchestrator(throwingProvider(thrown), promptBuilder, undefined, {hooks});
+  const rejected = await orchestrator.processMessage(sessionWith('hello')).then(
+    () => undefined,
+    (reason: unknown) => reason
+  );
+  return {seen, rejected};
+};
+
+describe('ChatOrchestrator onError for non-Error rejections', () => {
+  it('wraps a non-Error rejection in an Error with cause for onError while rethrowing the original value unchanged', async () => {
+    const plainObject = {code: 'UPSTREAM_ABORT', retryable: false};
+    const stringTurn = await runFailingTurn('provider rejected with a string');
+    const objectTurn = await runFailingTurn(plainObject);
+    const undefinedTurn = await runFailingTurn(undefined);
+    const originalError = new Error('real error instance');
+    const errorTurn = await runFailingTurn(originalError);
+
+    expect({
+      stringCalled: stringTurn.seen.length,
+      stringIsError: stringTurn.seen[0] instanceof Error,
+      stringCause: stringTurn.seen[0]?.cause,
+      stringRejected: stringTurn.rejected,
+      objectCalled: objectTurn.seen.length,
+      objectIsError: objectTurn.seen[0] instanceof Error,
+      objectCause: objectTurn.seen[0]?.cause,
+      objectRejected: objectTurn.rejected,
+      undefinedCalled: undefinedTurn.seen.length,
+      undefinedIsError: undefinedTurn.seen[0] instanceof Error,
+      undefinedHasCause: undefinedTurn.seen[0] !== undefined && 'cause' in undefinedTurn.seen[0],
+      undefinedCause: undefinedTurn.seen[0]?.cause,
+      undefinedRejected: undefinedTurn.rejected,
+      errorSameInstance: errorTurn.seen[0] === originalError,
+    }).toEqual({
+      stringCalled: 1,
+      stringIsError: true,
+      stringCause: 'provider rejected with a string',
+      stringRejected: 'provider rejected with a string',
+      objectCalled: 1,
+      objectIsError: true,
+      objectCause: plainObject,
+      objectRejected: plainObject,
+      undefinedCalled: 1,
+      undefinedIsError: true,
+      undefinedHasCause: true,
+      undefinedCause: undefined,
+      undefinedRejected: undefined,
+      errorSameInstance: true,
+    });
+  });
+});