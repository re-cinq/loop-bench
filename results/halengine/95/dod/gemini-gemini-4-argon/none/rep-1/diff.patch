@@ -0,0 +1,75 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const sessionWith = (content: string): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content, timestamp: SENT_AT}],
+});
+
+const throwingProvider = (thrown: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield -- generator throws before yielding to exercise rejection handling
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw thrown;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+const rejectionOf = (call: Promise<unknown>): Promise<{rejected: boolean; value: unknown}> =>
+  call.then(
+    (value: unknown) => ({rejected: false, value}),
+    (value: unknown) => ({rejected: true, value})
+  );
+
+describe('ChatOrchestrator onError for non-Error rejections', () => {
+  it('calls onError with an Error preserving cause and propagates the original rejection for a string, plain object, or undefined', async () => {
+    const seen: Error[] = [];
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        seen.push(error);
+      },
+    };
+    const thrownObject = {code: 'VENDOR_FAULT', detail: 'bad gateway'};
+
+    const stringOutcome = await rejectionOf(
+      createChatOrchestrator(throwingProvider('vendor string rejection'), promptBuilder, undefined, {
+        hooks,
+      }).processMessage(sessionWith('hello'))
+    );
+    const objectOutcome = await rejectionOf(
+      createChatOrchestrator(throwingProvider(thrownObject), promptBuilder, undefined, {
+        hooks,
+      }).processMessage(sessionWith('hello'))
+    );
+    const undefinedOutcome = await rejectionOf(
+      createChatOrchestrator(throwingProvider(undefined), promptBuilder, undefined, {
+        hooks,
+      }).processMessage(sessionWith('hello'))
+    );
+
+    expect({
+      callCount: seen.length,
+      allErrors: seen.every(err => err instanceof Error),
+      causes: seen.map(err => err.cause),
+      outcomes: [stringOutcome, objectOutcome, undefinedOutcome],
+    }).toEqual({
+      callCount: 3,
+      allErrors: true,
+      causes: ['vendor string rejection', thrownObject, undefined],
+      outcomes: [
+        {rejected: true, value: 'vendor string rejection'},
+        {rejected: true, value: thrownObject},
+        {rejected: true, value: undefined},
+      ],
+    });
+  });
+});