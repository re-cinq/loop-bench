@@ -0,0 +1,83 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+interface RejectionObservation {
+  onErrorCount: number;
+  receivedErrorInstance: boolean;
+  receivedCause: unknown;
+  callerRejection: unknown;
+}
+
+const observeRejection = async (rejection: unknown): Promise<RejectionObservation> => {
+  const receivedErrors: Error[] = [];
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => {
+      receivedErrors.push(error);
+    },
+  };
+  const provider: AIProvider = {
+    // eslint-disable-next-line require-yield -- provider rejects before yielding any chunk
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const session: ChatSession = {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+  };
+  const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+  const callerRejection = await orchestrator
+    .processMessage(session)
+    .then(() => Symbol('resolved'))
+    .catch((caught: unknown) => caught);
+
+  return {
+    onErrorCount: receivedErrors.length,
+    receivedErrorInstance: receivedErrors[0] instanceof Error,
+    receivedCause: receivedErrors[0]?.cause,
+    callerRejection,
+  };
+};
+
+describe('ChatOrchestrator non-Error rejections', () => {
+  it('wraps a non-Error rejection in an Error with cause for onError and rethrows the original rejection unchanged', async () => {
+    const plainObject = {code: 503, detail: 'upstream unavailable'};
+
+    const [fromString, fromObject, fromUndefined] = await Promise.all([
+      observeRejection('string rejection'),
+      observeRejection(plainObject),
+      observeRejection(undefined),
+    ]);
+
+    expect({fromString, fromObject, fromUndefined}).toEqual({
+      fromString: {
+        onErrorCount: 1,
+        receivedErrorInstance: true,
+        receivedCause: 'string rejection',
+        callerRejection: 'string rejection',
+      },
+      fromObject: {
+        onErrorCount: 1,
+        receivedErrorInstance: true,
+        receivedCause: plainObject,
+        callerRejection: plainObject,
+      },
+      fromUndefined: {
+        onErrorCount: 1,
+        receivedErrorInstance: true,
+        receivedCause: undefined,
+        callerRejection: undefined,
+      },
+    });
+  });
+});