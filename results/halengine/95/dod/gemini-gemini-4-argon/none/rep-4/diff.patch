+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const createSession = (content: string): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content, timestamp: SENT_AT}],
+});
+
+const rejectingProvider = (rejection: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield -- generator throws before yielding to simulate immediate provider rejection
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+const runRejectionTurn = async (rejection: unknown) => {
+  const receivedErrors: Error[] = [];
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => {
+      receivedErrors.push(error);
+    },
+  };
+  const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+  let caught: unknown = Symbol('did-not-throw');
+  try {
+    await orchestrator.processMessage(createSession('hello'));
+  } catch (error) {
+    caught = error;
+  }
+  const [firstError] = receivedErrors;
+  return {
+    calls: receivedErrors.length,
+    isErrorInstance: firstError instanceof Error,
+    cause: firstError?.cause,
+    caughtSame: Object.is(caught, rejection),
+  };
+};
+
+describe('ChatOrchestrator non-Error rejections', () => {
+  it('calls onError once with a wrapping Error carrying the cause when a provider rejects with a string, while rethrowing the original string', async () => {
+    const outcome = await runRejectionTurn('vendor string failure');
+
+    expect(outcome).toEqual({
+      calls: 1,
+      isErrorInstance: true,
+      cause: 'vendor string failure',
+      caughtSame: true,
+    });
+  });
+
+  it('calls onError once with a wrapping Error carrying the cause when a provider rejects with a plain object or undefined, while rethrowing the original value', async () => {
+    const plainObject = {code: 'UPSTREAM_DOWN', status: 503};
+    const fromObject = await runRejectionTurn(plainObject);
+    const fromUndefined = await runRejectionTurn(undefined);
+
+    expect({fromObject, fromUndefined}).toEqual({
+      fromObject: {
+        calls: 1,
+        isErrorInstance: true,
+        cause: plainObject,
+        caughtSame: true,
+      },
+      fromUndefined: {
+        calls: 1,
+        isErrorInstance: true,
+        cause: undefined,
+        caughtSame: true,
+      },
+    });
+  });
+});