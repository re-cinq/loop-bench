+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function createThrowingProvider(rejection: unknown): AIProvider {
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator onError with non-Error rejections', () => {
+  it('calls onError with an Error wrapping a string rejection, while caller receives the original string', async () => {
+    let onErrorCalled = false;
+    let onErrorReceived: Error | undefined;
+    const callerOutcome: {error: unknown} = {error: undefined};
+
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCalled = true;
+        onErrorReceived = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createThrowingProvider('rejection string'), promptBuilder, undefined, {
+      hooks,
+    });
+
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (error) {
+      callerOutcome.error = error;
+    }
+
+    expect({
+      onErrorCalled,
+      onErrorIsError: onErrorReceived instanceof Error,
+      onErrorCause: onErrorReceived?.cause,
+      callerReceivesOriginal: callerOutcome.error,
+    }).toEqual({
+      onErrorCalled: true,
+      onErrorIsError: true,
+      onErrorCause: 'rejection string',
+      callerReceivesOriginal: 'rejection string',
+    });
+  });
+
+  it('calls onError with an Error wrapping a plain object rejection, while caller receives the original object', async () => {
+    const rejectionObject = {type: 'custom_error', message: 'something went wrong'};
+    let onErrorCalled = false;
+    let onErrorReceived: Error | undefined;
+    const callerOutcome: {error: unknown} = {error: undefined};
+
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCalled = true;
+        onErrorReceived = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createThrowingProvider(rejectionObject), promptBuilder, undefined, {
+      hooks,
+    });
+
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (error) {
+      callerOutcome.error = error;
+    }
+
+    expect({
+      onErrorCalled,
+      onErrorIsError: onErrorReceived instanceof Error,
+      onErrorCause: onErrorReceived?.cause,
+      callerReceivesOriginal: callerOutcome.error,
+    }).toEqual({
+      onErrorCalled: true,
+      onErrorIsError: true,
+      onErrorCause: rejectionObject,
+      callerReceivesOriginal: rejectionObject,
+    });
+  });
+
+  it('calls onError with an Error wrapping an undefined rejection, while caller receives undefined', async () => {
+    let onErrorCalled = false;
+    let onErrorReceived: Error | undefined;
+    const callerOutcome: {error: unknown; errorCaught: boolean} = {error: undefined, errorCaught: false};
+
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCalled = true;
+        onErrorReceived = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createThrowingProvider(undefined), promptBuilder, undefined, {hooks});
+
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (error) {
+      callerOutcome.errorCaught = true;
+      callerOutcome.error = error;
+    }
+
+    expect({
+      onErrorCalled,
+      onErrorIsError: onErrorReceived instanceof Error,
+      onErrorCause: onErrorReceived?.cause,
+      callerErrorCaught: callerOutcome.errorCaught,
+      callerReceivesOriginal: callerOutcome.error,
+    }).toEqual({
+      onErrorCalled: true,
+      onErrorIsError: true,
+      onErrorCause: undefined,
+      callerErrorCaught: true,
+      callerReceivesOriginal: undefined,
+    });
+  });
+});