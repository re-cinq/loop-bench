+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function createProviderThrowingNonError(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator onError with non-Error rejections', () => {
+  describe('string rejection', () => {
+    it('calls onError with an Error whose cause is the string, and caller receives the original string', async () => {
+      const rejectionString = 'something went wrong';
+      let onErrorWasCalled = false;
+      let onErrorReceivedError: Error | undefined;
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          onErrorWasCalled = true;
+          onErrorReceivedError = error;
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(
+        createProviderThrowingNonError(rejectionString),
+        promptBuilder,
+        undefined,
+        {hooks}
+      );
+
+      let callerReceivedRejection: unknown;
+      try {
+        await orchestrator.processMessage(createSession('hello'));
+      } catch (error) {
+        callerReceivedRejection = error;
+      }
+
+      expect({
+        onErrorWasCalled,
+        onErrorReceivedIsError: onErrorReceivedError instanceof Error,
+        onErrorReceivedCause: onErrorReceivedError?.cause,
+        callerReceivedRejection,
+      }).toEqual({
+        onErrorWasCalled: true,
+        onErrorReceivedIsError: true,
+        onErrorReceivedCause: rejectionString,
+        callerReceivedRejection: rejectionString,
+      });
+    });
+  });
+
+  describe('plain object rejection', () => {
+    it('calls onError with an Error whose cause is the object, and caller receives the original object', async () => {
+      const rejectionObject = {code: 'CUSTOM_ERROR', message: 'something happened'};
+      let onErrorWasCalled = false;
+      let onErrorReceivedError: Error | undefined;
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          onErrorWasCalled = true;
+          onErrorReceivedError = error;
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(
+        createProviderThrowingNonError(rejectionObject),
+        promptBuilder,
+        undefined,
+        {hooks}
+      );
+
+      let callerReceivedRejection: unknown;
+      try {
+        await orchestrator.processMessage(createSession('hello'));
+      } catch (error) {
+        callerReceivedRejection = error;
+      }
+
+      expect({
+        onErrorWasCalled,
+        onErrorReceivedIsError: onErrorReceivedError instanceof Error,
+        onErrorReceivedCause: onErrorReceivedError?.cause,
+        callerReceivedRejection,
+      }).toEqual({
+        onErrorWasCalled: true,
+        onErrorReceivedIsError: true,
+        onErrorReceivedCause: rejectionObject,
+        callerReceivedRejection: rejectionObject,
+      });
+    });
+  });
+
+  describe('undefined rejection', () => {
+    it('calls onError with an Error whose cause is undefined, and caller receives the original undefined rejection', async () => {
+      let onErrorWasCalled = false;
+      let onErrorReceivedError: Error | undefined;
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          onErrorWasCalled = true;
+          onErrorReceivedError = error;
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(createProviderThrowingNonError(undefined), promptBuilder, undefined, {
+        hooks,
+      });
+
+      let callerReceivedRejection: unknown;
+      let wasThrown = false;
+      try {
+        await orchestrator.processMessage(createSession('hello'));
+      } catch (error) {
+        wasThrown = true;
+        callerReceivedRejection = error;
+      }
+
+      expect({
+        onErrorWasCalled,
+        onErrorReceivedIsError: onErrorReceivedError instanceof Error,
+        onErrorReceivedCause: onErrorReceivedError?.cause,
+        callerThrew: wasThrown,
+        callerReceivedRejection,
+      }).toEqual({
+        onErrorWasCalled: true,
+        onErrorReceivedIsError: true,
+        onErrorReceivedCause: undefined,
+        callerThrew: true,
+        callerReceivedRejection: undefined,
+      });
+    });
+  });
+
+  describe('Error rejection', () => {
+    it('passes the Error instance as-is to onError, not wrapped, and caller receives the same instance', async () => {
+      const originalError = new Error('already an error');
+      let onErrorWasCalled = false;
+      let onErrorReceivedError: Error | undefined;
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          onErrorWasCalled = true;
+          onErrorReceivedError = error;
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(
+        createProviderThrowingNonError(originalError),
+        promptBuilder,
+        undefined,
+        {hooks}
+      );
+
+      let callerReceivedRejection: unknown;
+      try {
+        await orchestrator.processMessage(createSession('hello'));
+      } catch (error) {
+        callerReceivedRejection = error;
+      }
+
+      expect({
+        onErrorWasCalled,
+        onErrorReceivedSameInstance: onErrorReceivedError === originalError,
+        onErrorReceivedHasCause: 'cause' in (onErrorReceivedError ?? {}),
+        callerReceivedSameInstance: callerReceivedRejection === originalError,
+      }).toEqual({
+        onErrorWasCalled: true,
+        onErrorReceivedSameInstance: true,
+        onErrorReceivedHasCause: false,
+        callerReceivedSameInstance: true,
+      });
+    });
+  });
+});