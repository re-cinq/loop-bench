+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function createProviderThrowingNonError(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator — onError with non-Error rejections', () => {
+  it('calls onError with an Error whose cause is a string rejection, and caller receives original string', async () => {
+    const rejectionString = 'test rejection string';
+    let receivedError: Error | undefined;
+    let callerRejection: unknown;
+
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        receivedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      createProviderThrowingNonError(rejectionString),
+      promptBuilder,
+      undefined,
+      {hooks}
+    );
+
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (error) {
+      callerRejection = error;
+    }
+
+    expect({
+      receivedErrorIsError: receivedError instanceof Error,
+      receivedErrorCause: receivedError?.cause,
+      callerRejection,
+    }).toEqual({
+      receivedErrorIsError: true,
+      receivedErrorCause: rejectionString,
+      callerRejection: rejectionString,
+    });
+  });
+
+  it('calls onError with an Error whose cause is a plain object rejection, and caller receives original object', async () => {
+    const rejectionObject = {code: 'TEST_ERROR', details: 'something went wrong'};
+    let receivedError: Error | undefined;
+    let callerRejection: unknown;
+
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        receivedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      createProviderThrowingNonError(rejectionObject),
+      promptBuilder,
+      undefined,
+      {hooks}
+    );
+
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (error) {
+      callerRejection = error;
+    }
+
+    expect({
+      receivedErrorIsError: receivedError instanceof Error,
+      receivedErrorCause: receivedError?.cause,
+      callerRejectionSame: callerRejection === rejectionObject,
+    }).toEqual({
+      receivedErrorIsError: true,
+      receivedErrorCause: rejectionObject,
+      callerRejectionSame: true,
+    });
+  });
+
+  it('calls onError with an Error whose cause is undefined rejection, and caller receives undefined', async () => {
+    let receivedError: Error | undefined;
+    let callerRejection: unknown = 'initial';
+    let rejectionCaught = false;
+
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        receivedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createProviderThrowingNonError(undefined), promptBuilder, undefined, {
+      hooks,
+    });
+
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (error) {
+      rejectionCaught = true;
+      callerRejection = error;
+    }
+
+    expect({
+      receivedErrorIsError: receivedError instanceof Error,
+      receivedErrorCause: receivedError?.cause,
+      rejectionCaught,
+      callerRejection,
+    }).toEqual({
+      receivedErrorIsError: true,
+      receivedErrorCause: undefined,
+      rejectionCaught: true,
+      callerRejection: undefined,
+    });
+  });
+
+  it('passes an Error rejection unchanged to onError, not wrapped', async () => {
+    const originalError = new Error('original error');
+    let receivedError: Error | undefined;
+
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        receivedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      createProviderThrowingNonError(originalError),
+      promptBuilder,
+      undefined,
+      {hooks}
+    );
+
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch {
+      // Catch and ignore the rejection
+    }
+
+    expect({
+      sameInstance: receivedError === originalError,
+      hasCause: 'cause' in (receivedError || {}),
+    }).toEqual({
+      sameInstance: true,
+      hasCause: false,
+    });
+  });
+});