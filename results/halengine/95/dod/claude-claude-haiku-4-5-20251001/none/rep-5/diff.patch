+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function createRejectingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('onError with non-Error rejections', () => {
+  describe('string rejection', () => {
+    it('calls onError with an Error wrapper whose cause is the string, and caller receives original string', async () => {
+      let onErrorWasCalledWith: Error | undefined;
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          onErrorWasCalledWith = error;
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(
+        createRejectingProvider('rejected with string'),
+        promptBuilder,
+        undefined,
+        {hooks}
+      );
+
+      let callerReceivedRejection: unknown;
+      try {
+        await orchestrator.processMessage(createSession('hello'));
+      } catch (error) {
+        callerReceivedRejection = error;
+      }
+
+      expect({
+        onErrorWasCalledWith: onErrorWasCalledWith instanceof Error ? {
+          isError: true,
+          message: onErrorWasCalledWith.message,
+          cause: onErrorWasCalledWith.cause,
+        } : null,
+        callerReceived: callerReceivedRejection,
+      }).toEqual({
+        onErrorWasCalledWith: {
+          isError: true,
+          message: expect.any(String),
+          cause: 'rejected with string',
+        },
+        callerReceived: 'rejected with string',
+      });
+    });
+  });
+
+  describe('plain object rejection', () => {
+    it('calls onError with an Error wrapper whose cause is the object, and caller receives original object', async () => {
+      const rejectedObject = {errorCode: 'CUSTOM', message: 'Custom error'};
+      let onErrorWasCalledWith: Error | undefined;
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          onErrorWasCalledWith = error;
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(
+        createRejectingProvider(rejectedObject),
+        promptBuilder,
+        undefined,
+        {hooks}
+      );
+
+      let callerReceivedRejection: unknown;
+      try {
+        await orchestrator.processMessage(createSession('hello'));
+      } catch (error) {
+        callerReceivedRejection = error;
+      }
+
+      expect({
+        onErrorWasCalledWith: onErrorWasCalledWith instanceof Error ? {
+          isError: true,
+          cause: onErrorWasCalledWith.cause,
+        } : null,
+        callerReceived: callerReceivedRejection,
+      }).toEqual({
+        onErrorWasCalledWith: {
+          isError: true,
+          cause: rejectedObject,
+        },
+        callerReceived: rejectedObject,
+      });
+    });
+  });
+
+  describe('undefined rejection', () => {
+    it('calls onError with an Error wrapper whose cause is undefined, and caller receives original undefined', async () => {
+      let onErrorWasCalledWith: Error | undefined;
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          onErrorWasCalledWith = error;
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(
+        createRejectingProvider(undefined),
+        promptBuilder,
+        undefined,
+        {hooks}
+      );
+
+      let callerReceivedRejection: unknown;
+      let callerThrewSomething = false;
+      try {
+        await orchestrator.processMessage(createSession('hello'));
+      } catch (error) {
+        callerReceivedRejection = error;
+        callerThrewSomething = true;
+      }
+
+      expect({
+        onErrorCalled: onErrorWasCalledWith instanceof Error,
+        onErrorCause: onErrorWasCalledWith?.cause,
+        callerThrewSomething,
+        callerRejection: callerReceivedRejection,
+      }).toEqual({
+        onErrorCalled: true,
+        onErrorCause: undefined,
+        callerThrewSomething: true,
+        callerRejection: undefined,
+      });
+    });
+  });
+
+  describe('Error rejection', () => {
+    it('calls onError with the same Error instance, not a wrapper', async () => {
+      const originalError = new Error('original error');
+      let onErrorWasCalledWith: Error | undefined;
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          onErrorWasCalledWith = error;
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(
+        createRejectingProvider(originalError),
+        promptBuilder,
+        undefined,
+        {hooks}
+      );
+
+      let callerReceivedRejection: unknown;
+      try {
+        await orchestrator.processMessage(createSession('hello'));
+      } catch (error) {
+        callerReceivedRejection = error;
+      }
+
+      expect({
+        onErrorReceivedSameInstance: onErrorWasCalledWith === originalError,
+        callerReceivedSameInstance: callerReceivedRejection === originalError,
+      }).toEqual({
+        onErrorReceivedSameInstance: true,
+        callerReceivedSameInstance: true,
+      });
+    });
+  });
+});