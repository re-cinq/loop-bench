+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const outcomeOf = (call: Promise<unknown>): Promise<unknown> =>
+  call.then(() => 'resolved without throwing').catch((error: unknown) => error);
+
+// eslint-disable-next-line require-yield
+function createNonErrorProvider(rejection: unknown): AIProvider {
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+describe('ChatOrchestrator.onError with non-Error rejections', () => {
+  it('calls onError with an Error wrapping a string rejection, and the caller receives the original string', async () => {
+    const originalRejection = 'rejection as string';
+    let receivedError: Error | undefined;
+
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        receivedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createNonErrorProvider(originalRejection), promptBuilder, undefined, {
+      hooks,
+    });
+    const callerOutcome = await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({
+      onErrorCalled: receivedError !== undefined,
+      onErrorIsErrorInstance: receivedError instanceof Error,
+      onErrorCause: (receivedError as any)?.cause,
+      callerReceivesOriginal: callerOutcome === originalRejection,
+    }).toEqual({
+      onErrorCalled: true,
+      onErrorIsErrorInstance: true,
+      onErrorCause: originalRejection,
+      callerReceivesOriginal: true,
+    });
+  });
+
+  it('calls onError with an Error wrapping a plain object rejection, and the caller receives the original object', async () => {
+    const originalRejection = {status: 500, message: 'Internal Server Error'};
+    let receivedError: Error | undefined;
+
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        receivedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createNonErrorProvider(originalRejection), promptBuilder, undefined, {
+      hooks,
+    });
+    const callerOutcome = await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({
+      onErrorCalled: receivedError !== undefined,
+      onErrorIsErrorInstance: receivedError instanceof Error,
+      onErrorCause: (receivedError as any)?.cause,
+      callerReceivesOriginal: callerOutcome === originalRejection,
+    }).toEqual({
+      onErrorCalled: true,
+      onErrorIsErrorInstance: true,
+      onErrorCause: originalRejection,
+      callerReceivesOriginal: true,
+    });
+  });
+
+  it('calls onError with an Error wrapping an undefined rejection, and the caller receives the original undefined', async () => {
+    const originalRejection = undefined;
+    let receivedError: Error | undefined;
+
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        receivedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createNonErrorProvider(originalRejection), promptBuilder, undefined, {
+      hooks,
+    });
+    const callerOutcome = await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({
+      onErrorCalled: receivedError !== undefined,
+      onErrorIsErrorInstance: receivedError instanceof Error,
+      onErrorCause: (receivedError as any)?.cause,
+      callerReceivesOriginal: callerOutcome === originalRejection,
+    }).toEqual({
+      onErrorCalled: true,
+      onErrorIsErrorInstance: true,
+      onErrorCause: originalRejection,
+      callerReceivesOriginal: true,
+    });
+  });
+
+  it('passes an Error rejection as the same instance to onError, not wrapped', async () => {
+    const originalError = new Error('original error');
+    let receivedError: Error | undefined;
+
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        receivedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createNonErrorProvider(originalError), promptBuilder, undefined, {
+      hooks,
+    });
+    await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+    expect(receivedError).toBe(originalError);
+  });
+});