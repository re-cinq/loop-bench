+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function createProviderRejectingWith(reason: unknown): AIProvider {
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      throw reason;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator onError for non-Error rejections', () => {
+  it('calls onError with Error wrapper when provider rejects with string', async () => {
+    const rejectionString = 'rejection with string';
+    let errorReceived: Error | undefined;
+    let callCount = 0;
+
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        callCount++;
+        errorReceived = error;
+      },
+      afterSession: async () => {},
+    };
+
+    const orchestrator = createChatOrchestrator(
+      createProviderRejectingWith(rejectionString),
+      promptBuilder,
+      undefined,
+      {hooks}
+    );
+
+    let caughtReason: unknown;
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (e) {
+      caughtReason = e;
+    }
+
+    expect(callCount).toBe(1);
+    expect(errorReceived).toBeInstanceOf(Error);
+    expect(errorReceived?.cause).toBe(rejectionString);
+    expect(caughtReason).toBe(rejectionString);
+  });
+
+  it('calls onError with Error wrapper when provider rejects with plain object', async () => {
+    const rejectionObject = {code: 'CUSTOM_ERROR', details: 'something went wrong'};
+    let errorReceived: Error | undefined;
+    let callCount = 0;
+
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        callCount++;
+        errorReceived = error;
+      },
+      afterSession: async () => {},
+    };
+
+    const orchestrator = createChatOrchestrator(
+      createProviderRejectingWith(rejectionObject),
+      promptBuilder,
+      undefined,
+      {hooks}
+    );
+
+    let caughtReason: unknown;
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (e) {
+      caughtReason = e;
+    }
+
+    expect(callCount).toBe(1);
+    expect(errorReceived).toBeInstanceOf(Error);
+    expect(errorReceived?.cause).toBe(rejectionObject);
+    expect(caughtReason).toBe(rejectionObject);
+  });
+
+  it('calls onError with Error wrapper when provider rejects with undefined', async () => {
+    let errorReceived: Error | undefined;
+    let callCount = 0;
+
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        callCount++;
+        errorReceived = error;
+      },
+      afterSession: async () => {},
+    };
+
+    const orchestrator = createChatOrchestrator(
+      createProviderRejectingWith(undefined),
+      promptBuilder,
+      undefined,
+      {hooks}
+    );
+
+    let caughtReason: unknown;
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (e) {
+      caughtReason = e;
+    }
+
+    expect(callCount).toBe(1);
+    expect(errorReceived).toBeInstanceOf(Error);
+    expect(errorReceived?.cause).toBeUndefined();
+    expect(caughtReason).toBeUndefined();
+  });
+
+  it('passes Error instance unchanged to onError when provider rejects with Error', async () => {
+    const rejectionError = new Error('original error message');
+    let errorReceived: Error | undefined;
+
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        errorReceived = error;
+      },
+      afterSession: async () => {},
+    };
+
+    const orchestrator = createChatOrchestrator(
+      createProviderRejectingWith(rejectionError),
+      promptBuilder,
+      undefined,
+      {hooks}
+    );
+
+    let caughtReason: unknown;
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (e) {
+      caughtReason = e;
+    }
+
+    expect(errorReceived).toBe(rejectionError);
+    expect(caughtReason).toBe(rejectionError);
+  });
+});