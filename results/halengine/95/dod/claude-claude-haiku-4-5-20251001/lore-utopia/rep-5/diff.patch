+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function createProviderThrowingValue(rejectionValue: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejectionValue;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const outcomeOf = (call: Promise<unknown>): Promise<{outcome: string; error?: unknown}> =>
+  call.then(() => ({outcome: 'resolved without throwing'})).catch((error: unknown) => ({outcome: 'rejected', error}));
+
+describe('ChatOrchestrator onError hook - non-Error rejections', () => {
+  it('calls onError for a string rejection with an Error whose cause is the string, and caller receives the original string', async () => {
+    const rejectionValue = 'string rejection from provider';
+    let onErrorCalled = false;
+    let receivedError: Error | undefined;
+
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCalled = true;
+        receivedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createProviderThrowingValue(rejectionValue), promptBuilder, undefined, {
+      hooks,
+    });
+    const {outcome, error} = await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({
+      onErrorCalled,
+      receivedErrorIsError: receivedError instanceof Error,
+      receivedErrorMessage: receivedError?.message,
+      receivedErrorCause: receivedError?.cause,
+      callerReceivesOriginalRejection: error === rejectionValue,
+      callerRejectionOutcome: outcome,
+    }).toEqual({
+      onErrorCalled: true,
+      receivedErrorIsError: true,
+      receivedErrorMessage: expect.any(String),
+      receivedErrorCause: rejectionValue,
+      callerReceivesOriginalRejection: true,
+      callerRejectionOutcome: 'rejected',
+    });
+  });
+
+  it('calls onError for a plain object rejection with an Error whose cause is the object, and caller receives the original object', async () => {
+    const rejectionValue = {code: 'CUSTOM_ERROR', message: 'something went wrong'};
+    let onErrorCalled = false;
+    let receivedError: Error | undefined;
+
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCalled = true;
+        receivedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createProviderThrowingValue(rejectionValue), promptBuilder, undefined, {
+      hooks,
+    });
+    const {outcome, error} = await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({
+      onErrorCalled,
+      receivedErrorIsError: receivedError instanceof Error,
+      receivedErrorCause: receivedError?.cause,
+      callerReceivesOriginalRejection: error === rejectionValue,
+      callerRejectionOutcome: outcome,
+    }).toEqual({
+      onErrorCalled: true,
+      receivedErrorIsError: true,
+      receivedErrorCause: rejectionValue,
+      callerReceivesOriginalRejection: true,
+      callerRejectionOutcome: 'rejected',
+    });
+  });
+
+  it('calls onError for an undefined rejection with an Error whose cause is undefined, and caller receives undefined', async () => {
+    const rejectionValue = undefined;
+    let onErrorCalled = false;
+    let receivedError: Error | undefined;
+
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCalled = true;
+        receivedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createProviderThrowingValue(rejectionValue), promptBuilder, undefined, {
+      hooks,
+    });
+    const {outcome, error} = await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({
+      onErrorCalled,
+      receivedErrorIsError: receivedError instanceof Error,
+      receivedErrorCause: receivedError?.cause,
+      callerReceivesOriginalRejection: error === rejectionValue,
+      callerRejectionOutcome: outcome,
+    }).toEqual({
+      onErrorCalled: true,
+      receivedErrorIsError: true,
+      receivedErrorCause: rejectionValue,
+      callerReceivesOriginalRejection: true,
+      callerRejectionOutcome: 'rejected',
+    });
+  });
+
+  it('calls onError with the same Error instance when rejection is already an Error (not wrapped)', async () => {
+    const rejectionError = new Error('original error');
+    let onErrorCalled = false;
+    let receivedError: Error | undefined;
+
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCalled = true;
+        receivedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createProviderThrowingValue(rejectionError), promptBuilder, undefined, {
+      hooks,
+    });
+    const {outcome, error} = await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({
+      onErrorCalled,
+      receivedErrorIsSameInstance: receivedError === rejectionError,
+      callerReceivesOriginalRejection: error === rejectionError,
+      callerRejectionOutcome: outcome,
+    }).toEqual({
+      onErrorCalled: true,
+      receivedErrorIsSameInstance: true,
+      callerReceivesOriginalRejection: true,
+      callerRejectionOutcome: 'rejected',
+    });
+  });
+});