+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function createRejectingProvider(rejection: unknown): AIProvider {
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('onError for non-Error rejections', () => {
+  it('calls onError with an Error wrapping the string, and caller receives the string unchanged', async () => {
+    const rejection = 'string rejection';
+    let onErrorCalled = false;
+    let onErrorReceivedError: Error | undefined;
+    let callerRejection: unknown;
+
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCalled = true;
+        onErrorReceivedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createRejectingProvider(rejection), promptBuilder, undefined, {hooks});
+
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (error) {
+      callerRejection = error;
+    }
+
+    expect({onErrorCalled, callerRejection}).toEqual({
+      onErrorCalled: true,
+      callerRejection: rejection,
+    });
+    expect(onErrorReceivedError).toBeInstanceOf(Error);
+    expect(onErrorReceivedError?.cause).toBe(rejection);
+  });
+
+  it('calls onError with an Error wrapping a plain object, and caller receives the object unchanged', async () => {
+    const rejection = {code: 'CUSTOM', message: 'Custom error object'};
+    let onErrorCalled = false;
+    let onErrorReceivedError: Error | undefined;
+    let callerRejection: unknown;
+
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCalled = true;
+        onErrorReceivedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createRejectingProvider(rejection), promptBuilder, undefined, {hooks});
+
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (error) {
+      callerRejection = error;
+    }
+
+    expect({onErrorCalled, callerRejection}).toEqual({
+      onErrorCalled: true,
+      callerRejection: rejection,
+    });
+    expect(onErrorReceivedError).toBeInstanceOf(Error);
+    expect(onErrorReceivedError?.cause).toBe(rejection);
+  });
+
+  it('calls onError with an Error wrapping undefined, and caller receives undefined unchanged', async () => {
+    const rejection = undefined;
+    let onErrorCalled = false;
+    let onErrorReceivedError: Error | undefined;
+    let callerRejection: unknown;
+    let callerThrew = false;
+
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCalled = true;
+        onErrorReceivedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createRejectingProvider(rejection), promptBuilder, undefined, {hooks});
+
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (error) {
+      callerThrew = true;
+      callerRejection = error;
+    }
+
+    expect({onErrorCalled, callerThrew, callerRejection}).toEqual({
+      onErrorCalled: true,
+      callerThrew: true,
+      callerRejection: undefined,
+    });
+    expect(onErrorReceivedError).toBeInstanceOf(Error);
+    expect(onErrorReceivedError?.cause).toBe(rejection);
+  });
+
+  it('calls onError with the original Error instance (no wrapping) for actual Error rejections', async () => {
+    const rejection = new Error('original error');
+    let onErrorCalled = false;
+    let onErrorReceivedError: Error | undefined;
+    let callerRejection: unknown;
+
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCalled = true;
+        onErrorReceivedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createRejectingProvider(rejection), promptBuilder, undefined, {hooks});
+
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (error) {
+      callerRejection = error;
+    }
+
+    expect({onErrorCalled, callerRejection}).toEqual({
+      onErrorCalled: true,
+      callerRejection: rejection,
+    });
+    expect(onErrorReceivedError).toBe(rejection);
+    expect(onErrorReceivedError?.cause).toBeUndefined();
+  });
+});