+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function createProviderThrowingNonError(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('onError hook for non-Error rejections', () => {
+  describe('string rejection', () => {
+    it('calls onError with an Error whose cause is the string, and propagates the string to caller', async () => {
+      let receivedError: Error | undefined;
+      const stringRejection = 'something went wrong';
+
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          receivedError = error;
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(
+        createProviderThrowingNonError(stringRejection),
+        promptBuilder,
+        undefined,
+        {hooks}
+      );
+
+      let callerRejection: unknown;
+      try {
+        await orchestrator.processMessage(createSession('hello'));
+      } catch (error) {
+        callerRejection = error;
+      }
+
+      expect(receivedError).toBeDefined();
+      expect(receivedError).toBeInstanceOf(Error);
+      expect(receivedError?.cause).toBe(stringRejection);
+      expect(callerRejection).toBe(stringRejection);
+    });
+  });
+
+  describe('plain object rejection', () => {
+    it('calls onError with an Error whose cause is the object, and propagates the object to caller', async () => {
+      let receivedError: Error | undefined;
+      const objectRejection = {errorCode: 'CUSTOM_ERROR', details: 'something failed'};
+
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          receivedError = error;
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(
+        createProviderThrowingNonError(objectRejection),
+        promptBuilder,
+        undefined,
+        {hooks}
+      );
+
+      let callerRejection: unknown;
+      try {
+        await orchestrator.processMessage(createSession('hello'));
+      } catch (error) {
+        callerRejection = error;
+      }
+
+      expect(receivedError).toBeDefined();
+      expect(receivedError).toBeInstanceOf(Error);
+      expect(receivedError?.cause).toBe(objectRejection);
+      expect(callerRejection).toBe(objectRejection);
+    });
+  });
+
+  describe('undefined rejection', () => {
+    it('calls onError with an Error whose cause is undefined, and propagates undefined to caller', async () => {
+      let receivedError: Error | undefined;
+
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          receivedError = error;
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(
+        createProviderThrowingNonError(undefined),
+        promptBuilder,
+        undefined,
+        {hooks}
+      );
+
+      let callerRejection: unknown;
+      try {
+        await orchestrator.processMessage(createSession('hello'));
+      } catch (error) {
+        callerRejection = error;
+      }
+
+      expect(receivedError).toBeDefined();
+      expect(receivedError).toBeInstanceOf(Error);
+      expect(receivedError?.cause).toBeUndefined();
+      expect(callerRejection).toBeUndefined();
+    });
+  });
+
+  describe('Error rejection', () => {
+    it('passes the Error instance directly to onError without wrapping', async () => {
+      let receivedError: Error | undefined;
+      const originalError = new Error('original error');
+
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          receivedError = error;
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(
+        createProviderThrowingNonError(originalError),
+        promptBuilder,
+        undefined,
+        {hooks}
+      );
+
+      try {
+        await orchestrator.processMessage(createSession('hello'));
+      } catch {
+        // ignore
+      }
+
+      expect(receivedError).toBe(originalError);
+    });
+  });
+});