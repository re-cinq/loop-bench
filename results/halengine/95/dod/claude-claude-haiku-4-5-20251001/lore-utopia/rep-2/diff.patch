+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createProviderThatThrows(rejection: unknown): AIProvider {
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+describe('ChatOrchestrator onError acceptance tests', () => {
+  describe('string rejection', () => {
+    it('calls onError with an Error wrapping the string, preserving it as cause', async () => {
+      const rejectionString = 'string error';
+      let receivedError: Error | undefined;
+
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          receivedError = error;
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(
+        createProviderThatThrows(rejectionString),
+        promptBuilder,
+        undefined,
+        {hooks}
+      );
+
+      try {
+        await orchestrator.processMessage(createSession('hello'));
+      } catch (e) {
+        // Expected to propagate the original string
+      }
+
+      expect(receivedError).toBeDefined();
+      expect(receivedError).toBeInstanceOf(Error);
+      expect(receivedError?.cause).toBe(rejectionString);
+    });
+
+    it('caller still receives the original string rejection, not the wrapper', async () => {
+      const rejectionString = 'string error';
+      const hooks: OrchestratorHooks = {
+        onError: async () => {},
+      };
+
+      const orchestrator = createChatOrchestrator(
+        createProviderThatThrows(rejectionString),
+        promptBuilder,
+        undefined,
+        {hooks}
+      );
+
+      await expect(orchestrator.processMessage(createSession('hello'))).rejects.toBe(rejectionString);
+    });
+  });
+
+  describe('plain object rejection', () => {
+    it('calls onError with an Error wrapping the object, preserving it as cause', async () => {
+      const rejectionObject = {code: 'ERR_CUSTOM', details: 'something failed'};
+      let receivedError: Error | undefined;
+
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          receivedError = error;
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(
+        createProviderThatThrows(rejectionObject),
+        promptBuilder,
+        undefined,
+        {hooks}
+      );
+
+      try {
+        await orchestrator.processMessage(createSession('hello'));
+      } catch (e) {
+        // Expected to propagate the original object
+      }
+
+      expect(receivedError).toBeDefined();
+      expect(receivedError).toBeInstanceOf(Error);
+      expect(receivedError?.cause).toBe(rejectionObject);
+    });
+
+    it('caller still receives the original object rejection, not the wrapper', async () => {
+      const rejectionObject = {code: 'ERR_CUSTOM', details: 'something failed'};
+      const hooks: OrchestratorHooks = {
+        onError: async () => {},
+      };
+
+      const orchestrator = createChatOrchestrator(
+        createProviderThatThrows(rejectionObject),
+        promptBuilder,
+        undefined,
+        {hooks}
+      );
+
+      await expect(orchestrator.processMessage(createSession('hello'))).rejects.toBe(rejectionObject);
+    });
+  });
+
+  describe('undefined rejection', () => {
+    it('calls onError with an Error wrapping undefined, preserving it as cause', async () => {
+      let receivedError: Error | undefined;
+
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          receivedError = error;
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(
+        createProviderThatThrows(undefined),
+        promptBuilder,
+        undefined,
+        {hooks}
+      );
+
+      try {
+        await orchestrator.processMessage(createSession('hello'));
+      } catch (e) {
+        // Expected to propagate the original undefined
+      }
+
+      expect(receivedError).toBeDefined();
+      expect(receivedError).toBeInstanceOf(Error);
+      expect(receivedError?.cause).toBeUndefined();
+    });
+
+    it('caller still receives undefined rejection, not the wrapper', async () => {
+      const hooks: OrchestratorHooks = {
+        onError: async () => {},
+      };
+
+      const orchestrator = createChatOrchestrator(
+        createProviderThatThrows(undefined),
+        promptBuilder,
+        undefined,
+        {hooks}
+      );
+
+      let thrownValue: unknown;
+      try {
+        await orchestrator.processMessage(createSession('hello'));
+      } catch (e) {
+        thrownValue = e;
+      }
+
+      expect(thrownValue).toBeUndefined();
+    });
+  });
+
+  describe('Error rejection', () => {
+    it('passes the Error instance to onError without wrapping', async () => {
+      const originalError = new Error('original error message');
+      let receivedError: Error | undefined;
+
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          receivedError = error;
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(
+        createProviderThatThrows(originalError),
+        promptBuilder,
+        undefined,
+        {hooks}
+      );
+
+      try {
+        await orchestrator.processMessage(createSession('hello'));
+      } catch (e) {
+        // Expected
+      }
+
+      expect(receivedError).toBe(originalError);
+    });
+
+    it('caller still receives the original Error, not a wrapper', async () => {
+      const originalError = new Error('original error message');
+      const hooks: OrchestratorHooks = {
+        onError: async () => {},
+      };
+
+      const orchestrator = createChatOrchestrator(
+        createProviderThatThrows(originalError),
+        promptBuilder,
+        undefined,
+        {hooks}
+      );
+
+      await expect(orchestrator.processMessage(createSession('hello'))).rejects.toBe(originalError);
+    });
+  });
+
+  describe('onError called exactly once', () => {
+    it('calls onError once for a string rejection', async () => {
+      let callCount = 0;
+
+      const hooks: OrchestratorHooks = {
+        onError: async () => {
+          callCount++;
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(
+        createProviderThatThrows('error string'),
+        promptBuilder,
+        undefined,
+        {hooks}
+      );
+
+      try {
+        await orchestrator.processMessage(createSession('hello'));
+      } catch (e) {
+        // Expected
+      }
+
+      expect(callCount).toBe(1);
+    });
+  });
+});