+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function createThrowingProvider(rejection: unknown): AIProvider {
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator onError for non-Error rejections', () => {
+  it('calls onError with Error wrapping a string rejection, preserving the string as cause', async () => {
+    let receivedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        receivedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      createThrowingProvider('rejection is a string'),
+      promptBuilder,
+      undefined,
+      {hooks}
+    );
+
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (caught) {
+      // expect the caller to receive the original rejection
+      expect(caught).toBe('rejection is a string');
+    }
+
+    // onError should have received an Error with the string as cause
+    expect(receivedError).toBeInstanceOf(Error);
+    expect(receivedError?.cause).toBe('rejection is a string');
+  });
+
+  it('calls onError with Error wrapping a plain object rejection, preserving the object as cause', async () => {
+    let receivedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        receivedError = error;
+      },
+    };
+
+    const plainObject = {code: 'CUSTOM_ERROR', details: {reason: 'test'}};
+    const orchestrator = createChatOrchestrator(createThrowingProvider(plainObject), promptBuilder, undefined, {hooks});
+
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (caught) {
+      // expect the caller to receive the original rejection
+      expect(caught).toBe(plainObject);
+    }
+
+    // onError should have received an Error with the object as cause
+    expect(receivedError).toBeInstanceOf(Error);
+    expect(receivedError?.cause).toBe(plainObject);
+  });
+
+  it('calls onError with Error wrapping an undefined rejection, preserving undefined as cause', async () => {
+    let receivedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        receivedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createThrowingProvider(undefined), promptBuilder, undefined, {hooks});
+
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (caught) {
+      // expect the caller to receive the original rejection
+      expect(caught).toBeUndefined();
+    }
+
+    // onError should have received an Error with undefined as cause
+    expect(receivedError).toBeInstanceOf(Error);
+    expect(receivedError?.cause).toBeUndefined();
+  });
+
+  it('calls onError with the same Error instance for Error rejections, not wrapped', async () => {
+    let receivedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        receivedError = error;
+      },
+    };
+
+    const originalError = new Error('original error');
+    const orchestrator = createChatOrchestrator(createThrowingProvider(originalError), promptBuilder, undefined, {
+      hooks,
+    });
+
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (caught) {
+      // expect the caller to receive the original error
+      expect(caught).toBe(originalError);
+    }
+
+    // onError should have received the exact same Error instance, not wrapped
+    expect(receivedError).toBe(originalError);
+  });
+});