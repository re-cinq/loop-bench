+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const session = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const rejectingProvider = (rejection: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+const observe = async (rejection: unknown) => {
+  const seen: Error[] = [];
+  const hooks: OrchestratorHooks = {onError: async (_s, error) => void seen.push(error)};
+  const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+
+  let caught: unknown = 'did not reject';
+  try {
+    await orchestrator.processMessage(session());
+  } catch (error) {
+    caught = error;
+  }
+
+  return {
+    calls: seen.length,
+    isError: seen[0] instanceof Error,
+    cause: (seen[0] as Error | undefined)?.cause,
+    caught,
+  };
+};
+
+describe('onError for every rejection', () => {
+  // specs/hal-engine-config-hooks/spec.md#onerror-every-rejection
+  const object = {code: 'E_LIB'};
+  it.each([
+    ['a string', 'boom'],
+    ['a plain object', object],
+    ['undefined', undefined],
+  ])('calls onError once with an Error whose cause is %s, and rejects with the original', async (_name, rejection) => {
+    expect(await observe(rejection)).toEqual({calls: 1, isError: true, cause: rejection, caught: rejection});
+  });
+});