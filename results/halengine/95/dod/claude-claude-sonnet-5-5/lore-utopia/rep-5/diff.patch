+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function session(): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hi', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+}
+
+function rejectingProvider(reason: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw reason;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+async function run(reason: unknown) {
+  const seen: unknown[] = [];
+  const orchestrator = createChatOrchestrator(rejectingProvider(reason), promptBuilder, undefined, {
+    hooks: {
+      onError: async (_s, error) => {
+        seen.push(error);
+      },
+    },
+  });
+  let thrown: unknown = 'did not throw';
+  try {
+    await orchestrator.processMessage(session());
+  } catch (e) {
+    thrown = e;
+  }
+  return {seen, thrown};
+}
+
+describe('onError for rejections that are not an Error (HALEngine#95)', () => {
+  it.each([
+    ['a string', 'plain string'],
+    ['a plain object', {code: 42}],
+    ['undefined', undefined],
+  ])('calls onError once with an Error causing %s and rethrows the original', async (_label, reason) => {
+    const {seen, thrown} = await run(reason);
+    expect(seen).toHaveLength(1);
+    expect(seen[0]).toBeInstanceOf(Error);
+    expect((seen[0] as Error).cause).toBe(reason);
+    expect(thrown).toBe(reason);
+  });
+});