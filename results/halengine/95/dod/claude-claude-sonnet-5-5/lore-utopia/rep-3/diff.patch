+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const session = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const rejectingProvider = (rejection: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+const plainObject = {code: 'E_CUSTOM', detail: 'library-specific shape'};
+
+describe('onError for a rejection that is not an Error', () => {
+  it.each([
+    ['a string', 'provider exploded'],
+    ['a plain object', plainObject],
+    ['undefined', undefined],
+  ])(
+    'calls onError once with an Error whose cause is %s, and the caller receives the original rejection',
+    async (_label, rejection) => {
+      const seen: unknown[] = [];
+      const hooks: OrchestratorHooks = {
+        onError: async (_s, error) => void seen.push(error),
+      };
+      const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+
+      let caught: unknown = 'did not reject';
+      try {
+        await orchestrator.processMessage(session());
+      } catch (error) {
+        caught = error;
+      }
+
+      const [reported] = seen;
+      expect({
+        calls: seen.length,
+        isError: reported instanceof Error,
+        causeIsRejection: (reported as Error | undefined)?.cause === rejection,
+        callerGotOriginal: caught === rejection,
+      }).toEqual({calls: 1, isError: true, causeIsRejection: true, callerGotOriginal: true});
+    }
+  );
+});