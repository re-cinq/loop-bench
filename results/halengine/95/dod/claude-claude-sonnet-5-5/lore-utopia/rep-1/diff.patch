+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const session = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+function rejectingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+async function observe(rejection: unknown) {
+  const seen: Error[] = [];
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => {
+      seen.push(error);
+    },
+  };
+  const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+  let caught: unknown = 'did not reject';
+  try {
+    await orchestrator.processMessage(session());
+  } catch (error) {
+    caught = error;
+  }
+  return {caught, seen};
+}
+
+describe('onError for every rejection', () => {
+  it.each([
+    ['a string', 'plain string'],
+    ['a plain object', {code: 42}],
+    ['undefined', undefined],
+  ])('wraps %s in an Error with the original as cause, and rethrows it unchanged', async (_label, rejection) => {
+    const {caught, seen} = await observe(rejection);
+
+    expect({
+      caught,
+      calls: seen.length,
+      isError: seen[0] instanceof Error,
+      cause: (seen[0] as Error | undefined)?.cause,
+    }).toEqual({caught: rejection, calls: 1, isError: true, cause: rejection});
+  });
+});