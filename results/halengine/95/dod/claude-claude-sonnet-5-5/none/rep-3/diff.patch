+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// spec: specs/hal-engine-config-hooks/spec.md#onerror-every-rejection
+
+const run = async (rejection: unknown) => {
+  const provider: AIProvider = {
+    // eslint-disable-next-line require-yield
+    async *sendMessage() {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const seen: unknown[] = [];
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'x'}), new ToolRegistry(), {
+    hooks: {
+      onError: async (_session, error) => {
+        seen.push(error);
+      },
+    },
+  });
+  const session: ChatSession = {sessionId: 's', userId: 'u', entries: [{role: 'user', content: 'go', timestamp: 't'}]};
+  let thrown: unknown = 'did not throw';
+  try {
+    for await (const _chunk of orchestrator.processMessageStream(session)) void _chunk;
+  } catch (error) {
+    thrown = error;
+  }
+  return {seen, thrown};
+};
+
+describe('onError receives every rejection', () => {
+  it.each([
+    ['a string', 'boom'],
+    ['a plain object', {code: 42}],
+    ['undefined', undefined],
+  ])('wraps %s in an Error with the original as cause and rethrows the original', async (_label, rejection) => {
+    const {seen, thrown} = await run(rejection);
+    expect(seen).toHaveLength(1);
+    expect(seen[0]).toBeInstanceOf(Error);
+    expect((seen[0] as Error).cause).toBe(rejection);
+    expect(thrown).toBe(rejection);
+  });
+});