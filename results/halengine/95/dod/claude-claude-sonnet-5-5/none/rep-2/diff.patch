+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const session: ChatSession = {
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+};
+
+function rejectingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      // eslint-disable-next-line @typescript-eslint/only-throw-error
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+const objectRejection = {code: 'E_VENDOR', detail: 'library-specific shape'};
+
+describe('onError for a rejection that is not an Error', () => {
+  it.each([
+    ['a string', 'plain string failure'],
+    ['a plain object', objectRejection],
+    ['undefined', undefined],
+  ])(
+    'calls onError once with an Error caused by %s, and the caller receives the original',
+    async (_label, rejection) => {
+      const seen: unknown[] = [];
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          seen.push(error);
+        },
+      };
+      const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+
+      const caught = await orchestrator.processMessage(session).then(
+        () => 'resolved without throwing' as unknown,
+        (error: unknown) => error
+      );
+
+      expect({
+        onErrorCalls: seen.length,
+        isError: seen[0] instanceof Error,
+        cause: (seen[0] as Error | undefined)?.cause,
+        caught,
+      }).toEqual({onErrorCalls: 1, isError: true, cause: rejection, caught: rejection});
+    }
+  );
+});