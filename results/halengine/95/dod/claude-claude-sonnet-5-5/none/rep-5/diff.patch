+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const session = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+function rejectingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+// Observes both sides of the seam: what onError received and what the caller received.
+async function run(rejection: unknown) {
+  const received: Error[] = [];
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => {
+      received.push(error);
+    },
+  };
+  const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+  const caught = await orchestrator.processMessage(session()).then(
+    () => ({resolved: true as const}),
+    (error: unknown) => ({resolved: false as const, error})
+  );
+  return {received, caught};
+}
+
+describe('onError receives every rejection', () => {
+  it.each([
+    ['a string', 'plain string'],
+    ['a plain object', {code: 42}],
+    ['undefined', undefined],
+  ])('wraps %s in an Error with the original as cause and rethrows the original', async (_label, rejection) => {
+    const {received, caught} = await run(rejection);
+
+    expect({
+      onErrorCalls: received.length,
+      isError: received[0] instanceof Error,
+      cause: received[0]?.cause,
+      caught,
+    }).toEqual({
+      onErrorCalls: 1,
+      isError: true,
+      cause: rejection,
+      caught: {resolved: false, error: rejection},
+    });
+  });
+});