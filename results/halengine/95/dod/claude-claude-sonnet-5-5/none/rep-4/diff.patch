+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// spec: specs/hal-engine-config-hooks/spec.md#measured-semantics
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const session = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const rejectingProvider = (rejection: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+const plainObject = {code: 'LIB_FAILURE', detail: 'not an Error'};
+
+describe('onError for a rejection that is not an Error', () => {
+  it.each([
+    ['a string', 'plain string failure'],
+    ['a plain object', plainObject],
+    ['undefined', undefined],
+  ])('calls onError once with an Error caused by %s, and the caller gets the original', async (_label, rejection) => {
+    const received: unknown[] = [];
+    const hooks: OrchestratorHooks = {onError: async (_s, error) => void received.push(error)};
+    const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+
+    const caught = await orchestrator.processMessage(session()).then(
+      () => ({resolved: true as const}),
+      (thrown: unknown) => ({thrown})
+    );
+
+    const first = received[0] as Error | undefined;
+    expect({
+      calls: received.length,
+      isError: first instanceof Error,
+      cause: first instanceof Error ? first.cause : 'no Error received',
+      caught,
+    }).toEqual({calls: 1, isError: true, cause: rejection, caught: {thrown: rejection}});
+  });
+});