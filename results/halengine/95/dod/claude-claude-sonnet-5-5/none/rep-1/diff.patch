+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function rejectingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+async function run(rejection: unknown) {
+  const received: Error[] = [];
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => {
+      received.push(error);
+    },
+  };
+  const session: ChatSession = {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+  };
+  const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+  let caught: unknown = 'did not reject';
+  try {
+    await orchestrator.processMessage(session);
+  } catch (error) {
+    caught = error;
+  }
+  return {caught, received};
+}
+
+describe('onError for rejections that are not an Error', () => {
+  it.each([
+    ['a string', 'plain string'],
+    ['a plain object', {code: 42}],
+    ['undefined', undefined],
+  ])('calls onError once with an Error caused by %s, and rethrows the original', async (_label, rejection) => {
+    const {caught, received} = await run(rejection);
+
+    expect({
+      calls: received.length,
+      isError: received[0] instanceof Error,
+      cause: received[0]?.cause,
+      caught,
+    }).toEqual({calls: 1, isError: true, cause: rejection, caught: rejection});
+  });
+});