+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const createSession = (content: string): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content, timestamp: SENT_AT}],
+});
+
+// A provider whose stream rejects with an arbitrary thrown value, not necessarily an Error.
+const rejectingProvider = (rejection: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+// A rejection of undefined must stay distinguishable from a clean resolution.
+const settle = async (call: Promise<unknown>): Promise<{resolved: boolean; value: unknown}> => {
+  try {
+    return {resolved: true, value: await call};
+  } catch (caught) {
+    return {resolved: false, value: caught};
+  }
+};
+
+const cases: [string, unknown][] = [
+  ['a string', 'provider exploded'],
+  ['a plain object', {code: 'E_PROVIDER', retryable: false}],
+  ['undefined', undefined],
+];
+
+describe('ChatOrchestrator onError for a rejection that is not an Error', () => {
+  it.each(cases)(
+    'wraps a rejection that is %s in an Error for onError, keeping the original as cause, and still rejects the caller with it',
+    async (_label: string, rejection: unknown) => {
+      const seen: unknown[] = [];
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          seen.push(error);
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+      const outcome = await settle(orchestrator.processMessage(createSession('hello')));
+
+      expect(seen).toHaveLength(1);
+      expect(seen[0]).toBeInstanceOf(Error);
+      expect((seen[0] as Error).cause).toBe(rejection);
+      expect(outcome.resolved).toBe(false);
+      expect(outcome.value).toBe(rejection);
+    }
+  );
+
+  it('hands a rejection that is already an Error to onError as the same instance, not a wrapper', async () => {
+    const original = new Error('boom');
+    const seen: unknown[] = [];
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        seen.push(error);
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(rejectingProvider(original), promptBuilder, undefined, {hooks});
+    const outcome = await settle(orchestrator.processMessage(createSession('hello')));
+
+    expect(seen).toHaveLength(1);
+    expect(seen[0]).toBe(original);
+    expect(outcome.resolved).toBe(false);
+    expect(outcome.value).toBe(original);
+  });
+});