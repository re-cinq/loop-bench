@@ -0,0 +1,127 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// The rejection under test is a value the provider boundary never types as an Error, which is the point.
+function createRejectionProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+// One expect per test needs the rejection as a value rather than a matcher, and undefined needs telling apart from a resolve.
+const rejectionOf = (turn: Promise<unknown>): Promise<{callerReceived: unknown}> =>
+  turn.then(
+    () => ({callerReceived: 'resolved without rejecting'}),
+    (thrown: unknown) => ({callerReceived: thrown})
+  );
+
+describe('ChatOrchestrator onError on a rejection that is not an Error', () => {
+  it('calls onError once with an Error whose cause is the rejected string, and still rejects the caller with that string', async () => {
+    const rejection = 'provider socket closed mid-stream';
+    const session = createSession('hello');
+    const seen: {session: ChatSession; error: unknown}[] = [];
+    const hooks: OrchestratorHooks = {
+      onError: async (reportedSession, error) => {
+        seen.push({session: reportedSession, error});
+      },
+    };
+    const orchestrator = createChatOrchestrator(createRejectionProvider(rejection), promptBuilder, undefined, {
+      hooks,
+    });
+
+    const callerReceived = await rejectionOf(orchestrator.processMessage(session));
+    const reported = seen[0];
+    const wrapper = reported?.error instanceof Error ? reported.error : undefined;
+
+    expect({
+      onErrorCalls: seen.length,
+      reportedAnErrorInstance: wrapper !== undefined,
+      causeIsTheRejectedString: wrapper?.cause === rejection,
+      causeIsDeclared: wrapper !== undefined && 'cause' in wrapper,
+      reportedSessionIsTheSession: reported?.session === session,
+      callerRejectionIsTheString: callerReceived.callerReceived === rejection,
+    }).toEqual({
+      onErrorCalls: 1,
+      reportedAnErrorInstance: true,
+      causeIsTheRejectedString: true,
+      causeIsDeclared: true,
+      reportedSessionIsTheSession: true,
+      callerRejectionIsTheString: true,
+    });
+  });
+
+  it('wraps a rejection with a plain object and with undefined the same way, and still rejects the caller with the original value', async () => {
+    const rejections: {name: string; rejection: unknown}[] = [
+      {name: 'plainObject', rejection: {code: 'ECONNRESET', detail: 'connection terminated'}},
+      {name: 'undefined', rejection: undefined},
+    ];
+
+    const observed: Record<string, unknown> = {};
+    for (const {name, rejection} of rejections) {
+      const session = createSession('hello');
+      const seen: {session: ChatSession; error: unknown}[] = [];
+      const hooks: OrchestratorHooks = {
+        onError: async (reportedSession, error) => {
+          seen.push({session: reportedSession, error});
+        },
+      };
+      const orchestrator = createChatOrchestrator(createRejectionProvider(rejection), promptBuilder, undefined, {
+        hooks,
+      });
+
+      const callerReceived = await rejectionOf(orchestrator.processMessage(session));
+      const reported = seen[0];
+      const wrapper = reported?.error instanceof Error ? reported.error : undefined;
+
+      observed[name] = {
+        onErrorCalls: seen.length,
+        reportedAnErrorInstance: wrapper !== undefined,
+        causeIsOriginalValue: wrapper?.cause === rejection,
+        causeIsDeclared: wrapper !== undefined && 'cause' in wrapper,
+        reportedSessionIsTheSession: reported?.session === session,
+        callerRejectionIsOriginalValue: callerReceived.callerReceived === rejection,
+      };
+    }
+
+    expect(observed).toEqual({
+      plainObject: {
+        onErrorCalls: 1,
+        reportedAnErrorInstance: true,
+        causeIsOriginalValue: true,
+        causeIsDeclared: true,
+        reportedSessionIsTheSession: true,
+        callerRejectionIsOriginalValue: true,
+      },
+      undefined: {
+        onErrorCalls: 1,
+        reportedAnErrorInstance: true,
+        causeIsOriginalValue: true,
+        causeIsDeclared: true,
+        reportedSessionIsTheSession: true,
+        callerRejectionIsOriginalValue: true,
+      },
+    });
+  });
+});