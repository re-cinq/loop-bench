+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+// The rejection as a value rather than a matcher, so a rejection that is not an Error arrives intact.
+const rejectionOf = (call: Promise<unknown>): Promise<unknown> =>
+  call.then(
+    () => 'resolved without throwing',
+    (reason: unknown) => reason
+  );
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// A provider whose stream rejects with whatever it is handed, Error or not — the shapes libraries actually throw.
+function createRejectingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield -- the generator exists to reject, never to stream
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+// The hook is typed against Error, yet the whole point of this seam is that the value it receives may not have been one.
+const causeOf = (value: unknown): unknown => (value instanceof Error ? value.cause : `not an Error (${typeof value})`);
+
+describe('ChatOrchestrator onError for a rejection that is not an Error', () => {
+  it('calls onError once for a string rejection, with an Error whose cause is that string, and rejects the caller with it', async () => {
+    const received: unknown[] = [];
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => void received.push(error),
+    };
+    const orchestrator = createChatOrchestrator(
+      createRejectingProvider('provider exploded'),
+      promptBuilder,
+      undefined,
+      {hooks}
+    );
+
+    const callerRejection = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({
+      onErrorCalls: received.length,
+      hookReceivedAnError: received[0] instanceof Error,
+      hookReceivedCause: causeOf(received[0]),
+      callerRejection,
+    }).toEqual({
+      onErrorCalls: 1,
+      hookReceivedAnError: true,
+      hookReceivedCause: 'provider exploded',
+      callerRejection: 'provider exploded',
+    });
+  });
+
+  it('treats a plain object and undefined the same way: each reaches onError once as its cause, unchanged to the caller', async () => {
+    const rejectionShapes: unknown[] = [{code: 'E_ROW_NOT_FOUND'}, undefined];
+    const observed: {
+      onErrorCalls: number;
+      hookReceivedTheOriginalAsCause: boolean;
+      callerReceivedTheOriginal: boolean;
+    }[] = [];
+
+    for (const rejection of rejectionShapes) {
+      const received: unknown[] = [];
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => void received.push(error),
+      };
+      const orchestrator = createChatOrchestrator(createRejectingProvider(rejection), promptBuilder, undefined, {
+        hooks,
+      });
+
+      const callerRejection = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+
+      observed.push({
+        onErrorCalls: received.length,
+        hookReceivedTheOriginalAsCause: causeOf(received[0]) === rejection,
+        callerReceivedTheOriginal: callerRejection === rejection,
+      });
+    }
+
+    expect(observed).toEqual([
+      {onErrorCalls: 1, hookReceivedTheOriginalAsCause: true, callerReceivedTheOriginal: true},
+      {onErrorCalls: 1, hookReceivedTheOriginalAsCause: true, callerReceivedTheOriginal: true},
+    ]);
+  });
+});