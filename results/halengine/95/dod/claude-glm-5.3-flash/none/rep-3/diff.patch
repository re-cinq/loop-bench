@@ -0,0 +1,93 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import {AIError} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// A provider whose stream rejects with the given value itself, so the catch sees the raw shape a library would hand it.
+const rejectingProvider = (rejection: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+// The rejection as a value rather than a matcher, so identity can be asserted on what the caller received.
+const rejectionOf = (call: Promise<unknown>): Promise<unknown> =>
+  call.then(
+    () => {
+      throw new Error('the turn resolved instead of rejecting');
+    },
+    (reason: unknown) => reason
+  );
+
+// Records every error onError was handed, in order, without asserting from inside the hook.
+const captureOnError = (): {hooks: OrchestratorHooks; delivered: () => Error[]} => {
+  const received: Error[] = [];
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => {
+      received.push(error);
+    },
+  };
+  return {hooks, delivered: () => received};
+};
+
+describe('onError for a rejection that is not an Error', () => {
+  it('calls onError once with an Error carrying the rejected value as its cause, and still rejects the caller with that value', async () => {
+    for (const rejection of ['backend said no', {code: 503, detail: 'upstream degraded'}, undefined]) {
+      const {hooks, delivered} = captureOnError();
+      const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+
+      const outcome = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+      const error = delivered()[0];
+
+      expect({
+        onErrorCalls: delivered().length,
+        hookReceivedAnError: error instanceof Error,
+        causeIsOriginal: Object.is(error?.cause, rejection),
+        callerReceivedOriginal: Object.is(outcome, rejection),
+      }).toEqual({
+        onErrorCalls: 1,
+        hookReceivedAnError: true,
+        causeIsOriginal: true,
+        callerReceivedOriginal: true,
+      });
+    }
+  });
+
+  it('hands a rejection that is already an Error to onError as the same instance and still rejects the caller with it', async () => {
+    const original = new AIError('rate limited', 'RATE_LIMITED');
+    const {hooks, delivered} = captureOnError();
+    const orchestrator = createChatOrchestrator(rejectingProvider(original), promptBuilder, undefined, {hooks});
+
+    const outcome = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+    const error = delivered()[0];
+
+    expect({
+      onErrorCalls: delivered().length,
+      hookReceivedSameInstance: Object.is(error, original),
+      callerReceivedSameInstance: Object.is(outcome, original),
+    }).toEqual({
+      onErrorCalls: 1,
+      hookReceivedSameInstance: true,
+      callerReceivedSameInstance: true,
+    });
+  });
+});