@@ -0,0 +1,80 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import {AIError} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const createSession = (content: string): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content, timestamp: SENT_AT}],
+});
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+// Rejects with the value itself, so the shape under test is the caller's, not the provider's.
+const rejectingProvider = (rejection: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+// The rejection as a value: a rejection carrying undefined must stay distinguishable from a resolution.
+const rejectionOf = (call: Promise<unknown>): Promise<unknown> =>
+  call.then(
+    () => 'resolved without throwing',
+    error => error
+  );
+
+const hooksRecordingOnError = (): {hooks: OrchestratorHooks; received: unknown[]} => {
+  const received: unknown[] = [];
+  return {received, hooks: {onError: async (_session, error) => void received.push(error)}};
+};
+
+describe('ChatOrchestrator onError', () => {
+  it('calls onError with an Error whose cause is the rejection, for a string, an object and undefined', async () => {
+    const rejections: unknown[] = ['provider gave up', {code: 'E_PROVIDER', retryable: false}, undefined];
+
+    for (const rejection of rejections) {
+      const {hooks, received} = hooksRecordingOnError();
+      const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+
+      const callerReceived = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+      const [delivered] = received;
+
+      expect({
+        onErrorCalls: received.length,
+        deliveredIsError: delivered instanceof Error,
+        causeIsTheRejection: delivered instanceof Error ? delivered.cause === rejection : undefined,
+        callerReceivedIsTheRejection: callerReceived === rejection,
+      }).toEqual({
+        onErrorCalls: 1,
+        deliveredIsError: true,
+        causeIsTheRejection: true,
+        callerReceivedIsTheRejection: true,
+      });
+    }
+  });
+
+  it('passes a rejection that is already an Error to onError as the same instance', async () => {
+    const rejection = new AIError('rate limited', 'RATE_LIMITED');
+    const {hooks, received} = hooksRecordingOnError();
+    const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+
+    const callerReceived = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({
+      onErrorCalls: received.length,
+      onErrorGotTheInstance: received[0] === rejection,
+      callerReceivedIsTheRejection: callerReceived === rejection,
+    }).toEqual({onErrorCalls: 1, onErrorGotTheInstance: true, callerReceivedIsTheRejection: true});
+  });
+});