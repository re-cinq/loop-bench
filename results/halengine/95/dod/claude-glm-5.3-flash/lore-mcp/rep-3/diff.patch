@@ -0,0 +1,112 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// Rejects with exactly the value handed to it, Error or not: the shape of a library that rejects with its own value.
+function createThrowingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+// The rejection as a value rather than a matcher, so a rejection that is not an Error can be compared.
+const rejectionOf = (call: Promise<unknown>): Promise<unknown> =>
+  call.then(
+    () => 'resolved without rejecting',
+    (error: unknown) => error
+  );
+
+describe('ChatOrchestrator onError for a rejection that is not an Error', () => {
+  it('calls onError once with an Error whose cause is the thrown string, and rejects the caller with the string itself', async () => {
+    const rejection = 'provider socket reset';
+    const received: Error[] = [];
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        received.push(error);
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createThrowingProvider(rejection), promptBuilder, undefined, {hooks});
+    const outcome = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({
+      outcome,
+      onErrorCallCount: received.length,
+      hookReceivesAnError: received[0] instanceof Error,
+      hookReceivesOriginalAsCause: received[0]?.cause === rejection,
+    }).toEqual({
+      outcome: rejection,
+      onErrorCallCount: 1,
+      hookReceivesAnError: true,
+      hookReceivesOriginalAsCause: true,
+    });
+  });
+
+  it('calls onError with a wrapping Error for a plain-object rejection and for an undefined rejection', async () => {
+    const rejection = {code: 'ECONNRESET', detail: 'socket hung up'};
+    const recordingHooks = (): {errors: Error[]; hooks: OrchestratorHooks} => {
+      const errors: Error[] = [];
+      return {errors, hooks: {onError: async (_session, error) => void errors.push(error)}};
+    };
+    const withObject = recordingHooks();
+    const withUndefined = recordingHooks();
+
+    const objectOutcome = await rejectionOf(
+      createChatOrchestrator(createThrowingProvider(rejection), promptBuilder, undefined, {
+        hooks: withObject.hooks,
+      }).processMessage(createSession('hello'))
+    );
+    const undefinedOutcome = await rejectionOf(
+      createChatOrchestrator(createThrowingProvider(undefined), promptBuilder, undefined, {
+        hooks: withUndefined.hooks,
+      }).processMessage(createSession('hello'))
+    );
+
+    expect({
+      object: {
+        callerGetsSameReference: objectOutcome === rejection,
+        onErrorCallCount: withObject.errors.length,
+        hookReceivesAnError: withObject.errors[0] instanceof Error,
+        hookReceivesOriginalAsCause: withObject.errors[0]?.cause === rejection,
+      },
+      undefined: {
+        callerReceivesUndefined: undefinedOutcome === undefined,
+        onErrorCallCount: withUndefined.errors.length,
+        hookReceivesAnError: withUndefined.errors[0] instanceof Error,
+      },
+    }).toEqual({
+      object: {
+        callerGetsSameReference: true,
+        onErrorCallCount: 1,
+        hookReceivesAnError: true,
+        hookReceivesOriginalAsCause: true,
+      },
+      undefined: {
+        callerReceivesUndefined: true,
+        onErrorCallCount: 1,
+        hookReceivesAnError: true,
+      },
+    });
+  });
+});