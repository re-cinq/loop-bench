+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+// Rejects the turn with the value it is handed, the way a thrown literal or a library's own error shape would.
+const rejectingProvider = (rejection: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// One expect per test needs the rejection as a value rather than a matcher, whatever its type.
+const rejectionOf = async (call: Promise<unknown>): Promise<unknown> => {
+  try {
+    await call;
+    return 'resolved without rejecting';
+  } catch (error) {
+    return error;
+  }
+};
+
+interface TurnObservation {
+  onErrorCalls: number;
+  passedToOnError: unknown;
+  callerReceived: unknown;
+}
+
+// One full turn per rejection shape, through the same processMessage path a caller uses.
+const observeTurn = async (rejection: unknown): Promise<TurnObservation> => {
+  let onErrorCalls = 0;
+  let passedToOnError: unknown;
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => {
+      onErrorCalls += 1;
+      passedToOnError = error;
+    },
+  };
+
+  const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+  const callerReceived = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+
+  return {onErrorCalls, passedToOnError, callerReceived};
+};
+
+interface ObservedBehaviour {
+  onErrorCalls: number;
+  isError: boolean;
+  causeIsOriginal: boolean;
+  callerReceivedOriginal: boolean;
+}
+
+const observed = (turn: TurnObservation, rejection: unknown): ObservedBehaviour => ({
+  onErrorCalls: turn.onErrorCalls,
+  isError: turn.passedToOnError instanceof Error,
+  causeIsOriginal: turn.passedToOnError instanceof Error && turn.passedToOnError.cause === rejection,
+  callerReceivedOriginal: turn.callerReceived === rejection,
+});
+
+describe('ChatOrchestrator onError for a rejection that is not an Error', () => {
+  it('calls onError once for a string rejection, with an Error whose cause is that string', async () => {
+    const rejection = 'provider socket closed';
+
+    expect(observed(await observeTurn(rejection), rejection)).toEqual({
+      onErrorCalls: 1,
+      isError: true,
+      causeIsOriginal: true,
+      callerReceivedOriginal: true,
+    });
+  });
+
+  it('gives a plain object and an undefined rejection the same treatment', async () => {
+    const rejections: unknown[] = [{code: 'ECONNRESET', status: 503}, undefined];
+    const turns: ObservedBehaviour[] = [];
+    for (const rejection of rejections) {
+      turns.push(observed(await observeTurn(rejection), rejection));
+    }
+
+    const delivered: ObservedBehaviour = {
+      onErrorCalls: 1,
+      isError: true,
+      causeIsOriginal: true,
+      callerReceivedOriginal: true,
+    };
+
+    expect(turns).toEqual([delivered, delivered]);
+  });
+});