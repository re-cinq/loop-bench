@@ -0,0 +1,101 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// A provider whose stream rejects with any value at all: the shapes a real
+// integration throws are not all Errors, and the orchestrator answers for each.
+const rejectingProvider = (rejection: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+interface ObservedTurn {
+  calls: number;
+  received: Error | undefined;
+  rejection: unknown;
+}
+
+// One turn through the real entry point, with onError watched and the caller's
+// outcome captured whatever it turned out to be.
+const observedTurn = async (provider: AIProvider): Promise<ObservedTurn> => {
+  const turn: ObservedTurn = {calls: 0, received: undefined, rejection: undefined};
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => {
+      turn.calls += 1;
+      turn.received = error;
+    },
+  };
+
+  const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+  try {
+    turn.rejection = await orchestrator.processMessage(createSession('hello'));
+  } catch (error) {
+    turn.rejection = error;
+  }
+  return turn;
+};
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('onError for every rejection', () => {
+  it('calls onError for a rejection that is a string, wrapping it as the cause, and still rejects the caller with that string', async () => {
+    const thrown = 'provider exploded';
+    const turn = await observedTurn(rejectingProvider(thrown));
+
+    expect({
+      calls: turn.calls,
+      receivedAnError: turn.received instanceof Error,
+      causeIsTheOriginal: turn.received?.cause === thrown,
+      callerReceivesTheOriginal: turn.rejection === thrown,
+    }).toEqual({
+      calls: 1,
+      receivedAnError: true,
+      causeIsTheOriginal: true,
+      callerReceivesTheOriginal: true,
+    });
+  });
+
+  it('calls onError the same way for rejections that are a plain object and undefined', async () => {
+    const thrown = {code: 'PROVIDER_HALTED'};
+    const objectTurn = await observedTurn(rejectingProvider(thrown));
+    const undefinedTurn = await observedTurn(rejectingProvider(undefined));
+
+    expect({
+      objectCalls: objectTurn.calls,
+      objectReceivedAnError: objectTurn.received instanceof Error,
+      objectCauseIsTheOriginal: objectTurn.received?.cause === thrown,
+      objectCallerReceivesTheOriginal: objectTurn.rejection === thrown,
+      undefinedCalls: undefinedTurn.calls,
+      undefinedReceivedAnError: undefinedTurn.received instanceof Error,
+      undefinedCauseIsUndefined: undefinedTurn.received?.cause === undefined,
+      undefinedCallerReceivesUndefined: undefinedTurn.rejection === undefined,
+    }).toEqual({
+      objectCalls: 1,
+      objectReceivedAnError: true,
+      objectCauseIsTheOriginal: true,
+      objectCallerReceivesTheOriginal: true,
+      undefinedCalls: 1,
+      undefinedReceivedAnError: true,
+      undefinedCauseIsUndefined: true,
+      undefinedCallerReceivesUndefined: true,
+    });
+  });
+});