@@ -0,0 +1,108 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const createSession = (content: string): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content, timestamp: SENT_AT}],
+});
+
+// Rejects with the raw value: the shapes a provider, or a library underneath one, really throws.
+const rejectingProvider = (rejection: unknown): AIProvider => ({
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+// The rejection as a value rather than a matcher, so identity can be asserted on it.
+const rejectionOf = (call: Promise<unknown>): Promise<unknown> =>
+  call.then(
+    () => 'resolved instead of rejecting',
+    (error: unknown) => error
+  );
+
+interface OnErrorObservation {
+  calls: number;
+  error: Error | undefined;
+}
+
+const observingOnError = (): {hooks: OrchestratorHooks; observed: () => OnErrorObservation} => {
+  const seen: OnErrorObservation = {calls: 0, error: undefined};
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => {
+      seen.calls += 1;
+      seen.error = error;
+    },
+  };
+  return {hooks, observed: () => seen};
+};
+
+describe('ChatOrchestrator calls onError for a rejection that is not an Error', () => {
+  it('calls onError once with an Error whose cause is the string, and still rejects the caller with the string', async () => {
+    const {hooks, observed} = observingOnError();
+    const orchestrator = createChatOrchestrator(rejectingProvider('the provider fell over'), promptBuilder, undefined, {
+      hooks,
+    });
+
+    const rejection = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+    const delivered = observed();
+
+    expect({
+      rejection,
+      onErrorCalls: delivered.calls,
+      wrappedTheString: delivered.error instanceof Error && delivered.error.cause === 'the provider fell over',
+    }).toEqual({
+      rejection: 'the provider fell over',
+      onErrorCalls: 1,
+      wrappedTheString: true,
+    });
+  });
+
+  it('calls onError once with an Error whose cause is the same object, and still rejects the caller with the same object', async () => {
+    const {hooks, observed} = observingOnError();
+    const original = {code: 'E_CONN_RESET', attempts: 3};
+    const orchestrator = createChatOrchestrator(rejectingProvider(original), promptBuilder, undefined, {hooks});
+
+    const rejection = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+    const delivered = observed();
+
+    expect({
+      rejectionIsTheSameObject: rejection === original,
+      onErrorCalls: delivered.calls,
+      causeIsTheSameObject: delivered.error instanceof Error && delivered.error.cause === original,
+    }).toEqual({
+      rejectionIsTheSameObject: true,
+      onErrorCalls: 1,
+      causeIsTheSameObject: true,
+    });
+  });
+
+  it('calls onError once with an Error when the rejection is undefined, and still rejects the caller with undefined', async () => {
+    const {hooks, observed} = observingOnError();
+    const orchestrator = createChatOrchestrator(rejectingProvider(undefined), promptBuilder, undefined, {hooks});
+
+    const rejection = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+    const delivered = observed();
+
+    expect({
+      rejection,
+      onErrorCalls: delivered.calls,
+      deliveredAnError: delivered.error instanceof Error,
+    }).toEqual({
+      rejection: undefined,
+      onErrorCalls: 1,
+      deliveredAnError: true,
+    });
+  });
+});