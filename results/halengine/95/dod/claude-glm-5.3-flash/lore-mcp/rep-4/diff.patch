@@ -0,0 +1,77 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+// Rejects with the value it is handed, Error or not - the shape a library that rejects with its own shape hands back.
+const createRejectingProvider = (rejection: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+// A rejection carrying `undefined` must stay distinguishable from a resolution.
+const RESOLVED = Symbol('resolved without throwing');
+
+const rejectionOf = async (call: Promise<unknown>): Promise<unknown> => {
+  try {
+    await call;
+    return RESOLVED;
+  } catch (error) {
+    return error;
+  }
+};
+
+describe('ChatOrchestrator onError for a rejection that is not an Error', () => {
+  it('calls onError once with an Error whose cause is the rejection value, and rejects the caller with that value unchanged, when the provider rejects with a string, a plain object, or undefined', async () => {
+    const rejections: {label: string; value: unknown}[] = [
+      {label: 'string', value: 'provider exploded'},
+      {label: 'plain object', value: {code: 'E_PROVIDER', detail: 'provider exploded'}},
+      {label: 'undefined', value: undefined},
+    ];
+
+    const observed: Record<string, unknown> = {};
+    for (const {label, value} of rejections) {
+      const calls: Error[] = [];
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          calls.push(error);
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(createRejectingProvider(value), promptBuilder, undefined, {hooks});
+      const received = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+
+      observed[label] = {
+        onErrorCalls: calls.map(error => ({
+          instanceOfError: error instanceof Error,
+          causeIsOriginal: error.cause === value,
+        })),
+        callerReceivedOriginal: received === value,
+      };
+    }
+
+    expect(observed).toEqual({
+      string: {onErrorCalls: [{instanceOfError: true, causeIsOriginal: true}], callerReceivedOriginal: true},
+      'plain object': {onErrorCalls: [{instanceOfError: true, causeIsOriginal: true}], callerReceivedOriginal: true},
+      undefined: {onErrorCalls: [{instanceOfError: true, causeIsOriginal: true}], callerReceivedOriginal: true},
+    });
+  });
+});