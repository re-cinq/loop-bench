+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// A provider whose call rejects with exactly the value it was given, not an Error.
+function createRejectingProvider(reason: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      throw reason;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+// Keeps the rejection as a value, so the caller's outcome can be compared whole.
+type Settled = {status: 'resolved'; value: unknown} | {status: 'rejected'; reason: unknown};
+const settle = (call: Promise<unknown>): Promise<Settled> =>
+  call.then(
+    value => ({status: 'resolved', value}),
+    reason => ({status: 'rejected', reason})
+  );
+
+// Runs one turn whose provider rejects with `reason`, recording every onError call.
+async function runRejecting(reason: unknown) {
+  const onErrorCalls: unknown[] = [];
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => {
+      onErrorCalls.push(error);
+    },
+  };
+
+  const orchestrator = createChatOrchestrator(createRejectingProvider(reason), promptBuilder, undefined, {hooks});
+  const caller = await settle(orchestrator.processMessage(createSession('hello')));
+
+  return {
+    caller,
+    onErrorCount: onErrorCalls.length,
+    onErrorIsError: onErrorCalls.every(error => error instanceof Error),
+    onErrorCauses: onErrorCalls.map(error => (error as Error).cause),
+  };
+}
+
+describe('ChatOrchestrator onError for a rejection that is not an Error', () => {
+  it('calls onError once with an Error whose cause is a rejected string, and the caller still gets that string', async () => {
+    const outcome = await runRejecting('boom');
+
+    expect(outcome).toStrictEqual({
+      caller: {status: 'rejected', reason: 'boom'},
+      onErrorCount: 1,
+      onErrorIsError: true,
+      onErrorCauses: ['boom'],
+    });
+  });
+
+  it('calls onError once with an Error wrapping a rejected plain object or undefined, and the caller gets each unchanged', async () => {
+    const rejection = {code: 'E_PROVIDER'};
+
+    const objectOutcome = await runRejecting(rejection);
+    const undefinedOutcome = await runRejecting(undefined);
+
+    expect({object: objectOutcome, undefined: undefinedOutcome}).toStrictEqual({
+      object: {
+        caller: {status: 'rejected', reason: rejection},
+        onErrorCount: 1,
+        onErrorIsError: true,
+        onErrorCauses: [rejection],
+      },
+      undefined: {
+        caller: {status: 'rejected', reason: undefined},
+        onErrorCount: 1,
+        onErrorIsError: true,
+        onErrorCauses: [undefined],
+      },
+    });
+  });
+});