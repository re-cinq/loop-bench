+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+// Distinguishes "the caller was never rejected" from a rejection whose value is undefined.
+const NOT_THROWN = Symbol('not thrown');
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+  };
+}
+
+// A provider whose call rejects with the given value, which need not be an Error.
+function rejectingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+describe('onError for a rejection that is not an Error', () => {
+  it.each([
+    ['a string', 'provider exploded'],
+    ['a plain object', {code: 'RATE_LIMITED', retryAfter: 30}],
+    ['undefined', undefined],
+  ])(
+    'calls onError once with an Error whose cause is %s, and still rejects the caller with that same value',
+    async (_label: string, rejection: unknown) => {
+      const received: unknown[] = [];
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          received.push(error);
+        },
+      };
+      const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+
+      let caught: unknown = NOT_THROWN;
+      try {
+        await orchestrator.processMessage(createSession());
+      } catch (error) {
+        caught = error;
+      }
+
+      expect(caught).toBe(rejection);
+      expect(received).toHaveLength(1);
+      expect(received[0]).toBeInstanceOf(Error);
+      expect((received[0] as Error).cause).toBe(rejection);
+    }
+  );
+});