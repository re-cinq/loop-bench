+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// A provider whose stream rejects with exactly the value it is given, as a library with its own rejection shape would.
+function createRejectingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('onError for a rejection that is not an Error', () => {
+  it.each([
+    ['a string', 'upstream timed out'],
+    ['a plain object', {code: 'E_UPSTREAM', status: 503}],
+    ['undefined', undefined],
+  ])(
+    'calls onError once with an Error whose cause is %s, and rejects the caller with the original value',
+    async (_label, rejection) => {
+      const onErrorCalls: Error[] = [];
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          onErrorCalls.push(error);
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(createRejectingProvider(rejection), promptBuilder, undefined, {
+        hooks,
+      });
+      const outcome = await orchestrator.processMessage(createSession('hello')).then(
+        () => ({settled: 'resolved' as const}),
+        (thrown: unknown) => ({settled: 'rejected' as const, thrown})
+      );
+
+      expect(onErrorCalls).toHaveLength(1);
+      expect(onErrorCalls[0]).toBeInstanceOf(Error);
+      expect(onErrorCalls[0].cause).toBe(rejection);
+      expect(outcome.settled).toBe('rejected');
+      expect(outcome.settled === 'rejected' && outcome.thrown).toBe(rejection);
+    }
+  );
+});