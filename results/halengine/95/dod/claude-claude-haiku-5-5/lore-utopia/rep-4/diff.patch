+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+  };
+}
+
+// Rejects with the value as given, so the test controls exactly what the provider threw.
+function createRejectingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+describe('onError for a rejection that is not an Error', () => {
+  it.each([
+    ['a string', 'provider overloaded'],
+    ['a plain object', {code: 'E_UPSTREAM', status: 503}],
+    ['undefined', undefined],
+  ])(
+    'calls onError once with an Error wrapping %s, and still rejects the caller with the original',
+    async (_label, rejection) => {
+      const onErrorCalls: Error[] = [];
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          onErrorCalls.push(error);
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(createRejectingProvider(rejection), promptBuilder, undefined, {
+        hooks,
+      });
+      const outcome = await orchestrator.processMessage(createSession()).then(
+        () => 'resolved without throwing',
+        (error: unknown) => ({rejectedWith: error})
+      );
+
+      expect(outcome).toEqual({rejectedWith: rejection});
+      expect(onErrorCalls).toHaveLength(1);
+      expect(onErrorCalls[0]).toBeInstanceOf(Error);
+      expect(onErrorCalls[0].cause).toBe(rejection);
+    }
+  );
+});