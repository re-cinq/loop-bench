+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// The provider rejects with exactly the value given, which need not be an Error.
+function createRejectingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+// The caller's rejection is wrapped so a turn that resolves reads as undefined rather than throwing the test off.
+async function runTurnRejectedWith(rejection: unknown) {
+  const onErrorCalls: unknown[] = [];
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => void onErrorCalls.push(error),
+  };
+
+  const orchestrator = createChatOrchestrator(createRejectingProvider(rejection), promptBuilder, undefined, {hooks});
+  const caller = await orchestrator.processMessage(createSession('hello')).then(
+    () => undefined,
+    (error: unknown) => ({error})
+  );
+
+  return {caller, onErrorCalls};
+}
+
+describe('ChatOrchestrator onError for a rejection that is not an Error', () => {
+  it('calls onError once with an Error whose cause is a thrown string, and the caller still gets the string', async () => {
+    const {caller, onErrorCalls} = await runTurnRejectedWith('provider boom');
+
+    expect(onErrorCalls).toHaveLength(1);
+    expect(onErrorCalls[0]).toBeInstanceOf(Error);
+    expect((onErrorCalls[0] as Error).cause).toBe('provider boom');
+    expect(caller).toEqual({error: 'provider boom'});
+  });
+
+  it('calls onError once with an Error whose cause is a plain object, and the caller still gets that same object', async () => {
+    const rejection = {code: 'E_UPSTREAM', status: 503};
+    const {caller, onErrorCalls} = await runTurnRejectedWith(rejection);
+
+    expect(onErrorCalls).toHaveLength(1);
+    expect(onErrorCalls[0]).toBeInstanceOf(Error);
+    expect((onErrorCalls[0] as Error).cause).toBe(rejection);
+    expect((caller as {error: unknown}).error).toBe(rejection);
+  });
+
+  it('calls onError once with an Error when the rejection is undefined, and the caller still gets undefined', async () => {
+    const {caller, onErrorCalls} = await runTurnRejectedWith(undefined);
+
+    expect(onErrorCalls).toHaveLength(1);
+    expect(onErrorCalls[0]).toBeInstanceOf(Error);
+    expect(caller).toEqual({error: undefined});
+  });
+});