+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// A provider that rejects with whatever value it is given, the way a library with its own error shape does.
+function createRejectingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+// The caller's view of the rejection, kept as data because the rejected value may itself be undefined.
+async function rejectionOf(call: Promise<unknown>): Promise<{rejected: boolean; value: unknown}> {
+  try {
+    await call;
+  } catch (value) {
+    return {rejected: true, value};
+  }
+  return {rejected: false, value: undefined};
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const nonErrorRejections: Array<[string, unknown]> = [
+  ['a string', 'upstream provider unavailable'],
+  ['a plain object', {code: 'E_UPSTREAM', status: 503}],
+  ['undefined', undefined],
+];
+
+describe('onError for a rejection that is not an Error', () => {
+  it.each(nonErrorRejections)(
+    'calls onError once with an Error whose cause is %s, and still rejects the caller with the original value',
+    async (_label, rejection) => {
+      const seen: Array<{session: ChatSession; error: Error}> = [];
+      const hooks: OrchestratorHooks = {
+        onError: async (session, error) => {
+          seen.push({session, error});
+        },
+      };
+
+      const session = createSession('hello');
+      const orchestrator = createChatOrchestrator(createRejectingProvider(rejection), promptBuilder, undefined, {
+        hooks,
+      });
+      const caller = await rejectionOf(orchestrator.processMessage(session));
+
+      expect(seen).toHaveLength(1);
+      expect(seen[0].session).toBe(session);
+      expect(seen[0].error).toBeInstanceOf(Error);
+      expect(seen[0].error.cause).toBe(rejection);
+      expect(caller.rejected).toBe(true);
+      expect(caller.value).toBe(rejection);
+    }
+  );
+});