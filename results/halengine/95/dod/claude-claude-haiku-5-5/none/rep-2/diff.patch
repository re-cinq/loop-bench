@@ -0,0 +1,95 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// A provider that rejects with an arbitrary value, which is what a library with its own rejection shape does.
+function createRejectingProvider(reason: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      throw reason;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+// The caller-side outcome as a value, so the rejection's own shape is kept intact.
+async function settle(call: Promise<unknown>): Promise<{rejected: boolean; reason: unknown}> {
+  try {
+    await call;
+    return {rejected: false, reason: undefined};
+  } catch (reason) {
+    return {rejected: true, reason};
+  }
+}
+
+describe('ChatOrchestrator onError for a rejection that is not an Error', () => {
+  it('calls onError once with an Error whose cause is a thrown string, and the caller still gets the string', async () => {
+    const received: Error[] = [];
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        received.push(error);
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createRejectingProvider('provider refused'), promptBuilder, undefined, {
+      hooks,
+    });
+    const outcome = await settle(orchestrator.processMessage(createSession('hello')));
+
+    expect({
+      caller: outcome,
+      onErrorCalls: received.length,
+      isError: received[0] instanceof Error,
+      cause: received[0]?.cause,
+    }).toEqual({
+      caller: {rejected: true, reason: 'provider refused'},
+      onErrorCalls: 1,
+      isError: true,
+      cause: 'provider refused',
+    });
+  });
+
+  it.each([
+    ['a plain object', {code: 'E_PROVIDER', retryable: false}],
+    ['undefined', undefined],
+  ])('calls onError once with an Error whose cause is %s, and the caller still gets it', async (_label, reason) => {
+    const received: Error[] = [];
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        received.push(error);
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createRejectingProvider(reason), promptBuilder, undefined, {hooks});
+    const outcome = await settle(orchestrator.processMessage(createSession('hello')));
+
+    expect({
+      caller: outcome,
+      onErrorCalls: received.length,
+      isError: received[0] instanceof Error,
+      cause: received[0]?.cause,
+    }).toEqual({
+      caller: {rejected: true, reason},
+      onErrorCalls: 1,
+      isError: true,
+      cause: reason,
+    });
+  });
+});