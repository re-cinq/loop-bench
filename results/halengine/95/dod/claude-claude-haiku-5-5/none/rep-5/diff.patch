+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// A provider whose stream rejects with exactly the value given, whatever its type.
+function rejectingProvider(thrown: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw thrown;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+// Runs one turn and reports what the caller received alongside every value onError was given.
+async function runTurn(thrown: unknown): Promise<{rejection: unknown; resolved: boolean; hookErrors: Error[]}> {
+  const hookErrors: Error[] = [];
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => {
+      hookErrors.push(error);
+    },
+  };
+
+  const orchestrator = createChatOrchestrator(rejectingProvider(thrown), promptBuilder, undefined, {hooks});
+  const outcome = await orchestrator.processMessage(createSession('hello')).then(
+    () => ({resolved: true, rejection: undefined}),
+    (rejection: unknown) => ({resolved: false, rejection})
+  );
+
+  return {...outcome, hookErrors};
+}
+
+describe('ChatOrchestrator onError for non-Error rejections', () => {
+  it('wraps a thrown string in an Error whose cause is that string, and still rejects the caller with it', async () => {
+    const outcome = await runTurn('provider exploded');
+
+    expect({
+      resolved: outcome.resolved,
+      rejection: outcome.rejection,
+      hookCalls: outcome.hookErrors.length,
+      isError: outcome.hookErrors[0] instanceof Error,
+      cause: outcome.hookErrors[0]?.cause,
+    }).toEqual({
+      resolved: false,
+      rejection: 'provider exploded',
+      hookCalls: 1,
+      isError: true,
+      cause: 'provider exploded',
+    });
+  });
+
+  it('calls onError once for a plain-object rejection and for an undefined rejection, each wrapped with the original as cause', async () => {
+    const shape = {code: 'UPSTREAM_503', retryable: true};
+
+    const objectOutcome = await runTurn(shape);
+    const undefinedOutcome = await runTurn(undefined);
+
+    expect({
+      objectHookCalls: objectOutcome.hookErrors.length,
+      objectIsError: objectOutcome.hookErrors[0] instanceof Error,
+      objectCause: objectOutcome.hookErrors[0]?.cause,
+      objectRejection: objectOutcome.rejection,
+      undefinedHookCalls: undefinedOutcome.hookErrors.length,
+      undefinedIsError: undefinedOutcome.hookErrors[0] instanceof Error,
+      undefinedCause: undefinedOutcome.hookErrors[0]?.cause,
+      undefinedRejected: !undefinedOutcome.resolved,
+    }).toEqual({
+      objectHookCalls: 1,
+      objectIsError: true,
+      objectCause: shape,
+      objectRejection: shape,
+      undefinedHookCalls: 1,
+      undefinedIsError: true,
+      undefinedCause: undefined,
+      undefinedRejected: true,
+    });
+  });
+});