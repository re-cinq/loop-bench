+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// A provider whose stream rejects with exactly the value it is given, as a library with its own error shape does.
+function rejectingWith(thrown: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw thrown;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+// What the caller sees: the rejection value itself, or a marker when the call resolved instead.
+const callerSees = (call: Promise<unknown>): Promise<{rejected: boolean; value: unknown}> =>
+  call.then(
+    () => ({rejected: false, value: undefined}),
+    (value: unknown) => ({rejected: true, value})
+  );
+
+// Every onError call, in order, so the test can count them and inspect what each one received.
+function recordOnError(): {hooks: OrchestratorHooks; received: unknown[]} {
+  const received: unknown[] = [];
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => {
+      received.push(error);
+    },
+  };
+  return {hooks, received};
+}
+
+describe('onError for a rejection that is not an Error', () => {
+  it('calls onError once with an Error whose cause is a rejected string, and the caller still gets the string', async () => {
+    const {hooks, received} = recordOnError();
+    const orchestrator = createChatOrchestrator(rejectingWith('upstream timed out'), promptBuilder, undefined, {hooks});
+
+    const caller = await callerSees(orchestrator.processMessage(createSession('hello')));
+    const first = received[0];
+
+    expect({
+      caller,
+      onErrorCalls: received.length,
+      isError: first instanceof Error,
+      cause: first instanceof Error ? first.cause : undefined,
+    }).toEqual({
+      caller: {rejected: true, value: 'upstream timed out'},
+      onErrorCalls: 1,
+      isError: true,
+      cause: 'upstream timed out',
+    });
+  });
+
+  it('calls onError once with an Error whose cause is a rejected plain object or undefined, and the caller still gets that value', async () => {
+    const payload = {code: 'E_UPSTREAM', retryable: true};
+    const observed = [];
+
+    for (const thrown of [payload, undefined]) {
+      const {hooks, received} = recordOnError();
+      const orchestrator = createChatOrchestrator(rejectingWith(thrown), promptBuilder, undefined, {hooks});
+
+      const caller = await callerSees(orchestrator.processMessage(createSession('hello')));
+      const first = received[0];
+      observed.push({
+        caller,
+        onErrorCalls: received.length,
+        isError: first instanceof Error,
+        cause: first instanceof Error ? first.cause : undefined,
+      });
+    }
+
+    expect(observed).toEqual([
+      {caller: {rejected: true, value: payload}, onErrorCalls: 1, isError: true, cause: payload},
+      {caller: {rejected: true, value: undefined}, onErrorCalls: 1, isError: true, cause: undefined},
+    ]);
+  });
+});