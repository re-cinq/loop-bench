+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// A provider that rejects with whatever value it is given, not necessarily an Error.
+function createRejectingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+// Separates a resolved call from a rejected one even when the rejection value is undefined.
+const settle = (call: Promise<unknown>): Promise<{resolved: unknown} | {rejected: unknown}> =>
+  call.then(
+    resolved => ({resolved}),
+    (rejected: unknown) => ({rejected})
+  );
+
+describe('onError for a rejection that is not an Error', () => {
+  it('calls onError once with an Error whose cause is a thrown string, and rejects the caller with that string', async () => {
+    const onErrorArgs: unknown[] = [];
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorArgs.push(error);
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      createRejectingProvider('provider exploded'),
+      promptBuilder,
+      undefined,
+      {
+        hooks,
+      }
+    );
+    const outcome = await settle(orchestrator.processMessage(createSession('hello')));
+
+    expect(onErrorArgs).toHaveLength(1);
+    expect(onErrorArgs[0]).toBeInstanceOf(Error);
+    expect((onErrorArgs[0] as Error).cause).toBe('provider exploded');
+    expect(outcome).toStrictEqual({rejected: 'provider exploded'});
+  });
+
+  it.each([
+    ['a plain object', {code: 'RATE_LIMITED', retryAfter: 30}],
+    ['undefined', undefined],
+  ])(
+    'calls onError once with an Error wrapping %s, and rejects the caller with the original value',
+    async (_label, rejection) => {
+      const onErrorArgs: unknown[] = [];
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          onErrorArgs.push(error);
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(createRejectingProvider(rejection), promptBuilder, undefined, {
+        hooks,
+      });
+      const outcome = await settle(orchestrator.processMessage(createSession('hello')));
+
+      expect(onErrorArgs).toHaveLength(1);
+      expect(onErrorArgs[0]).toBeInstanceOf(Error);
+      expect(outcome).toStrictEqual({rejected: rejection});
+    }
+  );
+});