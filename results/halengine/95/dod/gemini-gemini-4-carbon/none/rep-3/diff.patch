+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+interface ObservedError {
+  sessionId: string;
+  isError: boolean;
+  hasCause: boolean;
+  cause: unknown;
+  sameCause: boolean;
+}
+
+const rejectingTurn = async (thrown: unknown) => {
+  const seen: ObservedError[] = [];
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield* [] as MessageChunk[];
+      throw thrown;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const session: ChatSession = {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Acceptance test.'}), undefined, {
+    hooks: {
+      onError: async (hookSession, error) => {
+        seen.push({
+          sessionId: hookSession.sessionId,
+          isError: error instanceof Error,
+          hasCause: 'cause' in error,
+          cause: error.cause,
+          sameCause: Object.is(error.cause, thrown),
+        });
+      },
+    },
+  });
+  const settled = await orchestrator.processMessage(session).then(
+    reply => ({outcome: 'resolved' as const, reply, sameRejection: false}),
+    (reason: unknown) => ({outcome: 'rejected' as const, reason, sameRejection: Object.is(reason, thrown)})
+  );
+  return {seen, settled};
+};
+
+describe('onError for rejections that are not an Error', () => {
+  it('wraps a string rejection in an Error with cause for onError and rethrows the string', async () => {
+    const turn = await rejectingTurn('upstream gateway timeout');
+
+    expect(turn).toEqual({
+      seen: [
+        {
+          sessionId: 's1',
+          isError: true,
+          hasCause: true,
+          cause: 'upstream gateway timeout',
+          sameCause: true,
+        },
+      ],
+      settled: {
+        outcome: 'rejected',
+        reason: 'upstream gateway timeout',
+        sameRejection: true,
+      },
+    });
+  });
+
+  it('wraps object and undefined rejections with cause for onError and rethrows each as-is', async () => {
+    const vendorPayload = {code: 'UPSTREAM_502', status: 502};
+
+    const payloadTurn = await rejectingTurn(vendorPayload);
+    const undefinedTurn = await rejectingTurn(undefined);
+
+    expect({payloadTurn, undefinedTurn}).toEqual({
+      payloadTurn: {
+        seen: [
+          {
+            sessionId: 's1',
+            isError: true,
+            hasCause: true,
+            cause: vendorPayload,
+            sameCause: true,
+          },
+        ],
+        settled: {
+          outcome: 'rejected',
+          reason: vendorPayload,
+          sameRejection: true,
+        },
+      },
+      undefinedTurn: {
+        seen: [
+          {
+            sessionId: 's1',
+            isError: true,
+            hasCause: true,
+            cause: undefined,
+            sameCause: true,
+          },
+        ],
+        settled: {
+          outcome: 'rejected',
+          reason: undefined,
+          sameRejection: true,
+        },
+      },
+    });
+  });
+});