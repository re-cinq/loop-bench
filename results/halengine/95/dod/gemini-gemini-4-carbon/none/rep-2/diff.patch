@@ -0,0 +1,108 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const FIXED_TIMESTAMP = '2026-01-01T00:00:00.000Z';
+const EMPTY_CHUNKS: readonly MessageChunk[] = [];
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+interface ForwardedError {
+  sessionId: string;
+  isError: boolean;
+  hasCause: boolean;
+  cause: unknown;
+}
+
+interface RejectionOutcome {
+  callerThrew: boolean;
+  callerReason: unknown;
+  onErrorCalls: ForwardedError[];
+}
+
+describe('ChatOrchestrator onError for non-Error rejections', () => {
+  it('wraps a rejected string in an Error with cause for onError while rethrowing the string unchanged', async () => {
+    const outcome = await observeNonErrorRejection('provider gateway timeout');
+
+    expect(outcome).toEqual({
+      callerThrew: true,
+      callerReason: 'provider gateway timeout',
+      onErrorCalls: [{sessionId: 's-non-error', isError: true, hasCause: true, cause: 'provider gateway timeout'}],
+    });
+  });
+
+  it('wraps a rejected plain object in an Error with cause for onError while rethrowing the object unchanged', async () => {
+    const upstreamFailure = {code: 'UPSTREAM_502', status: 502};
+    const outcome = await observeNonErrorRejection(upstreamFailure);
+    const [firstCall] = outcome.onErrorCalls;
+
+    expect({
+      callerThrew: outcome.callerThrew,
+      sameCallerObject: Object.is(outcome.callerReason, upstreamFailure),
+      callCount: outcome.onErrorCalls.length,
+      sessionId: firstCall?.sessionId,
+      firstIsError: firstCall?.isError,
+      firstHasCause: firstCall?.hasCause,
+      sameCauseObject: Object.is(firstCall?.cause, upstreamFailure),
+    }).toEqual({
+      callerThrew: true,
+      sameCallerObject: true,
+      callCount: 1,
+      sessionId: 's-non-error',
+      firstIsError: true,
+      firstHasCause: true,
+      sameCauseObject: true,
+    });
+  });
+
+  it('wraps a rejected undefined in an Error with cause for onError while rethrowing undefined unchanged', async () => {
+    const outcome = await observeNonErrorRejection(undefined);
+
+    expect(outcome).toEqual({
+      callerThrew: true,
+      callerReason: undefined,
+      onErrorCalls: [{sessionId: 's-non-error', isError: true, hasCause: true, cause: undefined}],
+    });
+  });
+});
+
+async function observeNonErrorRejection(rejection: unknown): Promise<RejectionOutcome> {
+  const onErrorCalls: ForwardedError[] = [];
+  const hooks: OrchestratorHooks = {
+    onError: async (session, error) => {
+      onErrorCalls.push({
+        sessionId: session.sessionId,
+        isError: error instanceof Error,
+        hasCause: 'cause' in error,
+        cause: error.cause,
+      });
+    },
+  };
+  const orchestrator = createChatOrchestrator(createRejectingProvider(rejection), promptBuilder, undefined, {hooks});
+
+  return orchestrator.processMessage(createUserSession()).then(
+    () => ({callerThrew: false, callerReason: undefined, onErrorCalls}),
+    (caught: unknown) => ({callerThrew: true, callerReason: caught, onErrorCalls})
+  );
+}
+
+function createRejectingProvider(rejection: unknown): AIProvider {
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield* EMPTY_CHUNKS;
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('generateStructured unused');
+    },
+  };
+}
+
+function createUserSession(): ChatSession {
+  return {
+    sessionId: 's-non-error',
+    userId: 'u-non-error',
+    entries: [{role: 'user', content: 'hello', timestamp: FIXED_TIMESTAMP}],
+  };
+}