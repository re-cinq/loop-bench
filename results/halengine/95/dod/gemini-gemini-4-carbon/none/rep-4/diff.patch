+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+interface RejectionObservation {
+  onErrorCalls: number;
+  sessionIdSeen: string | undefined;
+  receivedIsError: boolean;
+  hasCauseProperty: boolean;
+  causeIsOriginal: boolean;
+  receivedCause: unknown;
+  rejectedToCaller: boolean;
+  callerReceivedSame: boolean;
+}
+
+const observeRejection = async (thrown: unknown): Promise<RejectionObservation> => {
+  const seen: Array<{session: ChatSession; error: Error}> = [];
+  const hooks: OrchestratorHooks = {
+    onError: async (currentSession, error) => {
+      seen.push({session: currentSession, error});
+    },
+  };
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield* [];
+      throw thrown;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+  const session: ChatSession = {
+    sessionId: 's-non-error',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+  };
+  const outcome = await orchestrator.processMessage(session).then(
+    () => ({rejected: false, caught: undefined as unknown}),
+    (caught: unknown) => ({rejected: true, caught})
+  );
+  const first = seen[0];
+  const receivedSession = first?.session;
+  const receivedError = first?.error;
+
+  return {
+    onErrorCalls: seen.length,
+    sessionIdSeen: receivedSession?.sessionId,
+    receivedIsError: receivedError instanceof Error,
+    hasCauseProperty: receivedError instanceof Error && 'cause' in receivedError,
+    causeIsOriginal: receivedError instanceof Error && Object.is(receivedError.cause, thrown),
+    receivedCause: receivedError?.cause,
+    rejectedToCaller: outcome.rejected,
+    callerReceivedSame: Object.is(outcome.caught, thrown),
+  };
+};
+
+const expectedObservation = (thrown: unknown): RejectionObservation => ({
+  onErrorCalls: 1,
+  sessionIdSeen: 's-non-error',
+  receivedIsError: true,
+  hasCauseProperty: true,
+  causeIsOriginal: true,
+  receivedCause: thrown,
+  rejectedToCaller: true,
+  callerReceivedSame: true,
+});
+
+describe('ChatOrchestrator onError for non-Error rejections', () => {
+  it('wraps a string rejection in an Error with cause for onError and rethrows the string unchanged', async () => {
+    expect(await observeRejection('upstream rate limit')).toEqual(expectedObservation('upstream rate limit'));
+  });
+
+  it('wraps a plain-object rejection in an Error with cause for onError and rethrows the object unchanged', async () => {
+    const rejectionPayload = {code: 503, detail: 'upstream unavailable'};
+
+    expect(await observeRejection(rejectionPayload)).toEqual(expectedObservation(rejectionPayload));
+  });
+
+  it('wraps an undefined rejection in an Error with cause for onError and rethrows undefined unchanged', async () => {
+    expect(await observeRejection(undefined)).toEqual(expectedObservation(undefined));
+  });
+});