@@ -0,0 +1,97 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+interface ObservedOnErrorCall {
+  sessionId: string;
+  isErrorInstance: boolean;
+  hasCauseProperty: boolean;
+  cause: unknown;
+  preservesCauseIdentity: boolean;
+}
+
+interface TurnRejectionOutcome {
+  onErrorCalls: ObservedOnErrorCall[];
+  settlement: PromiseSettledResult<string>;
+  preservesRejectedIdentity: boolean;
+}
+
+describe('ChatOrchestrator non-Error rejections', () => {
+  it('wraps string, plain-object, and undefined rejections for onError and rethrows each unchanged', async () => {
+    const upstreamFailure = {code: 'UPSTREAM_503', detail: 'bad gateway'};
+
+    const outcomes = {
+      string: await runTurnRejectingWith('upstream gateway timeout'),
+      plainObject: await runTurnRejectingWith(upstreamFailure),
+      undefinedValue: await runTurnRejectingWith(undefined),
+    };
+
+    expect(outcomes).toEqual({
+      string: expectedWrappedRejection('upstream gateway timeout'),
+      plainObject: expectedWrappedRejection(upstreamFailure),
+      undefinedValue: expectedWrappedRejection(undefined),
+    });
+  });
+});
+
+async function runTurnRejectingWith(rejection: unknown): Promise<TurnRejectionOutcome> {
+  const onErrorCalls: ObservedOnErrorCall[] = [];
+  const hooks: OrchestratorHooks = {
+    onError: async (session, error) => {
+      const isErrorInstance = error instanceof Error;
+      onErrorCalls.push({
+        sessionId: session.sessionId,
+        isErrorInstance,
+        hasCauseProperty: isErrorInstance && 'cause' in error,
+        cause: isErrorInstance ? error.cause : undefined,
+        preservesCauseIdentity: isErrorInstance && Object.is(error.cause, rejection),
+      });
+    },
+  };
+  const session: ChatSession = {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+  };
+  const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+  const [settlement] = await Promise.allSettled([orchestrator.processMessage(session)]);
+
+  return {
+    onErrorCalls,
+    settlement,
+    preservesRejectedIdentity: settlement.status === 'rejected' && Object.is(settlement.reason, rejection),
+  };
+}
+
+function expectedWrappedRejection(rejection: unknown): TurnRejectionOutcome {
+  return {
+    onErrorCalls: [
+      {
+        sessionId: 's1',
+        isErrorInstance: true,
+        hasCauseProperty: true,
+        cause: rejection,
+        preservesCauseIdentity: true,
+      },
+    ],
+    settlement: {status: 'rejected', reason: rejection},
+    preservesRejectedIdentity: true,
+  };
+}
+
+function rejectingProvider(rejection: unknown): AIProvider {
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield* [];
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}