@@ -0,0 +1,86 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+type TurnOutcome = {rejected: false} | {rejected: true; thrown: unknown};
+
+interface ObservedRejection {
+  onErrorCalls: number;
+  sameSession: boolean;
+  isError: boolean;
+  hasCause: boolean;
+  sameCause: boolean;
+  rejected: boolean;
+  sameRejection: boolean;
+}
+
+const rejectingProvider = (rejection: unknown): AIProvider => ({
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    const noChunks: MessageChunk[] = [];
+    yield* noChunks;
+    throw rejection;
+  },
+  async generateStructured(): Promise<never> {
+    throw new Error('generateStructured is unused in streaming turns');
+  },
+});
+
+const observeRejection = async (rejection: unknown): Promise<ObservedRejection> => {
+  const seen: {session: ChatSession; error: Error}[] = [];
+  const hooks: OrchestratorHooks = {
+    onError: async (hookSession, error) => {
+      seen.push({session: hookSession, error});
+    },
+  };
+  const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+  const session: ChatSession = {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+  };
+  const outcome: TurnOutcome = await orchestrator.processMessage(session).then(
+    (): TurnOutcome => ({rejected: false}),
+    (thrown: unknown): TurnOutcome => ({rejected: true, thrown})
+  );
+  const [first] = seen;
+  const receivedError = first?.error;
+
+  return {
+    onErrorCalls: seen.length,
+    sameSession: first !== undefined && first.session === session,
+    isError: receivedError instanceof Error,
+    hasCause: receivedError instanceof Error && Object.hasOwn(receivedError, 'cause'),
+    sameCause: receivedError instanceof Error && Object.is(receivedError.cause, rejection),
+    rejected: outcome.rejected,
+    sameRejection: outcome.rejected && Object.is(outcome.thrown, rejection),
+  };
+};
+
+const EXPECTED: ObservedRejection = {
+  onErrorCalls: 1,
+  sameSession: true,
+  isError: true,
+  hasCause: true,
+  sameCause: true,
+  rejected: true,
+  sameRejection: true,
+};
+
+describe('ChatOrchestrator onError non-Error rejections', () => {
+  it('wraps non-Error rejections in an Error with cause for onError and rethrows each unchanged', async () => {
+    const stringCase = await observeRejection('upstream gateway timeout');
+    const objectCase = await observeRejection({code: 503, detail: 'upstream unavailable'});
+    const undefinedCase = await observeRejection(undefined);
+
+    expect({stringCase, objectCase, undefinedCase}).toEqual({
+      stringCase: EXPECTED,
+      objectCase: EXPECTED,
+      undefinedCase: EXPECTED,
+    });
+  });
+});