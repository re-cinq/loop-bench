+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {AIError} from '../types/ai.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const providerRejectingWith = (thrown: unknown): AIProvider => ({
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    yield* [];
+    throw thrown;
+  },
+  generateStructured<T>(): Promise<T> {
+    return Promise.reject(new AIError('unused in stream test', 'UNIMPLEMENTED'));
+  },
+});
+
+const summarizeHookCall = (
+  session: ChatSession,
+  recorded: {session: ChatSession; error: unknown} | undefined,
+  thrown: unknown
+) => {
+  if (recorded === undefined) return null;
+  if (!(recorded.error instanceof Error)) {
+    return {
+      sameSession: recorded.session === session,
+      errorInstance: false,
+      hasCause: false,
+      causeMatches: false,
+      sameErrorIdentity: Object.is(recorded.error, thrown),
+    };
+  }
+  return {
+    sameSession: recorded.session === session,
+    errorInstance: true,
+    hasCause: 'cause' in recorded.error,
+    causeMatches: Object.is(recorded.error.cause, thrown),
+    sameErrorIdentity: Object.is(recorded.error, thrown),
+  };
+};
+
+const promptBuilder = new PromptBuilder({identity: 'Acceptance test assistant.'});
+
+type CallerOutcome = {kind: 'resolved'; text: string} | {kind: 'rejected'; caught: unknown};
+
+const runRejectingTurn = async (thrown: unknown) => {
+  const session: ChatSession = {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const recordedCalls: Array<{session: ChatSession; error: unknown}> = [];
+  const hooks: OrchestratorHooks = {
+    onError: async (hookSession, hookError) => {
+      recordedCalls.push({session: hookSession, error: hookError});
+    },
+  };
+  const orchestrator = createChatOrchestrator(providerRejectingWith(thrown), promptBuilder, undefined, {hooks});
+  const outcome: CallerOutcome = await orchestrator.processMessage(session).then(
+    (text): CallerOutcome => ({kind: 'resolved', text}),
+    (caught: unknown): CallerOutcome => ({kind: 'rejected', caught})
+  );
+
+  return {
+    hookCallCount: recordedCalls.length,
+    firstHookCall: summarizeHookCall(session, recordedCalls[0], thrown),
+    callerOutcome:
+      outcome.kind === 'rejected'
+        ? {kind: 'rejected', matchesThrown: Object.is(outcome.caught, thrown)}
+        : {kind: 'resolved', matchesThrown: false},
+  };
+};
+
+describe('ChatOrchestrator onError hook for every rejection', () => {
+  it('wraps non-Error rejections with cause for onError and preserves caller rejection', async () => {
+    const plainReason = {code: 'UPSTREAM_FAILURE', retryable: false};
+    const existingError = new AIError('rate limited', 'RATE_LIMITED');
+    const expectedWrappedTurn = {
+      hookCallCount: 1,
+      firstHookCall: {
+        sameSession: true,
+        errorInstance: true,
+        hasCause: true,
+        causeMatches: true,
+        sameErrorIdentity: false,
+      },
+      callerOutcome: {kind: 'rejected', matchesThrown: true},
+    };
+
+    const [stringTurn, objectTurn, voidTurn, errorTurn] = await Promise.all([
+      runRejectingTurn('provider stream failed'),
+      runRejectingTurn(plainReason),
+      runRejectingTurn(undefined),
+      runRejectingTurn(existingError),
+    ]);
+
+    expect({stringTurn, objectTurn, voidTurn, errorTurn}).toEqual({
+      stringTurn: expectedWrappedTurn,
+      objectTurn: expectedWrappedTurn,
+      voidTurn: expectedWrappedTurn,
+      errorTurn: {
+        hookCallCount: 1,
+        firstHookCall: {
+          sameSession: true,
+          errorInstance: true,
+          hasCause: false,
+          causeMatches: false,
+          sameErrorIdentity: true,
+        },
+        callerOutcome: {kind: 'rejected', matchesThrown: true},
+      },
+    });
+  });
+});