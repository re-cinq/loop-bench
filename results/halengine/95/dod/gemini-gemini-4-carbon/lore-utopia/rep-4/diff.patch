@@ -0,0 +1,105 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+interface TurnSettlement {
+  rejected: boolean;
+  value: unknown;
+}
+
+const promptBuilder = new PromptBuilder({identity: 'Acceptance test assistant.'});
+
+const rejectingProvider = (reason: unknown): AIProvider => ({
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    yield* [];
+    throw reason;
+  },
+  async generateStructured<T>(): Promise<T> {
+    throw reason;
+  },
+});
+
+const settleTurn = (turn: Promise<string>): Promise<TurnSettlement> =>
+  turn.then(
+    reply => ({rejected: false, value: reply}),
+    (thrown: unknown) => ({rejected: true, value: thrown})
+  );
+
+const hasMatchingCause = (received: Error | undefined, expectedCause: unknown): boolean => {
+  if (!(received instanceof Error)) return false;
+  return Object.hasOwn(received, 'cause') && Object.is(received.cause, expectedCause);
+};
+
+const observeRejection = async (reason: unknown) => {
+  const recorded: Array<{session: ChatSession; error: Error}> = [];
+  const session: ChatSession = {
+    sessionId: 'session-rejection',
+    userId: 'user-1',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const orchestrator = createChatOrchestrator(rejectingProvider(reason), promptBuilder, undefined, {
+    hooks: {
+      onError: async (hookSession, hookError) => {
+        recorded.push({session: hookSession, error: hookError});
+      },
+    },
+  });
+  const settled = await settleTurn(orchestrator.processMessage(session));
+  const [first] = recorded;
+
+  return {
+    onErrorCalls: recorded.length,
+    receivedSession: first?.session === session,
+    receivedErrorInstance: first?.error instanceof Error,
+    sameAsThrown: Object.is(first?.error, reason),
+    causeMatchesThrown: hasMatchingCause(first?.error, reason),
+    callerRejectedUnchanged: settled.rejected && Object.is(settled.value, reason),
+  };
+};
+
+describe('onError on non-Error rejections', () => {
+  it('wraps a non-Error rejection in an Error with cause while keeping Error instances and caller rejections unchanged', async () => {
+    const stringRejection = 'upstream provider rejected';
+    const objectRejection = {code: 503, detail: 'service unavailable'};
+    const existingError = new Error('already an Error');
+
+    const [fromString, fromObject, fromUndefined, fromError] = await Promise.all([
+      observeRejection(stringRejection),
+      observeRejection(objectRejection),
+      observeRejection(undefined),
+      observeRejection(existingError),
+    ]);
+
+    const expectedWrapped = {
+      onErrorCalls: 1,
+      receivedSession: true,
+      receivedErrorInstance: true,
+      sameAsThrown: false,
+      causeMatchesThrown: true,
+      callerRejectedUnchanged: true,
+    };
+
+    expect({
+      string: fromString,
+      plainObject: fromObject,
+      undefinedValue: fromUndefined,
+      errorInstance: {
+        onErrorCalls: fromError.onErrorCalls,
+        receivedSession: fromError.receivedSession,
+        sameAsThrown: fromError.sameAsThrown,
+        callerRejectedUnchanged: fromError.callerRejectedUnchanged,
+      },
+    }).toEqual({
+      string: expectedWrapped,
+      plainObject: expectedWrapped,
+      undefinedValue: expectedWrapped,
+      errorInstance: {
+        onErrorCalls: 1,
+        receivedSession: true,
+        sameAsThrown: true,
+        callerRejectedUnchanged: true,
+      },
+    });
+  });
+});