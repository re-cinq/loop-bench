@@ -0,0 +1,104 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+interface RejectionObservation {
+  hookCalls: number;
+  hookSessionId: string | undefined;
+  isErrorInstance: boolean;
+  sameErrorInstance: boolean;
+  hasOwnCause: boolean;
+  causeMatchesOriginal: boolean;
+  callerReceivedOriginal: boolean;
+}
+
+interface RecordedCall {
+  sessionId: string;
+  error: Error;
+}
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const RESOLVE_SENTINEL = Symbol('resolved');
+
+const observeRejection = async (reason: unknown): Promise<RejectionObservation> => {
+  const recordedCalls: RecordedCall[] = [];
+  const hooks: OrchestratorHooks = {
+    onError: async (session, error) => {
+      recordedCalls.push({sessionId: session.sessionId, error});
+    },
+  };
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      await Promise.reject(reason);
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const session: ChatSession = {
+    sessionId: 'session-rejection',
+    userId: 'user-1',
+    entries: [{role: 'user', content: 'ping', timestamp: SENT_AT}],
+  };
+  const orchestrator = createChatOrchestrator(
+    provider,
+    new PromptBuilder({identity: 'Acceptance assistant.'}),
+    undefined,
+    {hooks}
+  );
+  const turn = orchestrator.processMessage(session);
+  const callerOutcome = await turn.then(
+    () => RESOLVE_SENTINEL,
+    (caught: unknown) => caught
+  );
+  const [firstCall] = recordedCalls;
+
+  return {
+    hookCalls: recordedCalls.length,
+    hookSessionId: firstCall?.sessionId,
+    isErrorInstance: firstCall ? firstCall.error instanceof Error : false,
+    sameErrorInstance: firstCall ? Object.is(firstCall.error, reason) : false,
+    hasOwnCause: firstCall ? 'cause' in firstCall.error : false,
+    causeMatchesOriginal: firstCall ? Object.is(firstCall.error.cause, reason) : false,
+    callerReceivedOriginal: Object.is(callerOutcome, reason),
+  };
+};
+
+describe('ChatOrchestrator onError for non-Error rejections', () => {
+  it('wraps non-Error rejections with cause, keeps Error instances, and rethrows originals', async () => {
+    const plainObjectRejection = {code: 503, detail: 'gateway unavailable'};
+    const existingError = new Error('upstream boom');
+    const expectedWrapped: RejectionObservation = {
+      hookCalls: 1,
+      hookSessionId: 'session-rejection',
+      isErrorInstance: true,
+      sameErrorInstance: false,
+      hasOwnCause: true,
+      causeMatchesOriginal: true,
+      callerReceivedOriginal: true,
+    };
+
+    const stringOutcome = await observeRejection('upstream rate limit');
+    const objectOutcome = await observeRejection(plainObjectRejection);
+    const undefinedOutcome = await observeRejection(undefined);
+    const errorOutcome = await observeRejection(existingError);
+
+    expect({stringOutcome, objectOutcome, undefinedOutcome, errorOutcome}).toEqual({
+      stringOutcome: expectedWrapped,
+      objectOutcome: expectedWrapped,
+      undefinedOutcome: expectedWrapped,
+      errorOutcome: {
+        hookCalls: 1,
+        hookSessionId: 'session-rejection',
+        isErrorInstance: true,
+        sameErrorInstance: true,
+        hasOwnCause: false,
+        causeMatchesOriginal: false,
+        callerReceivedOriginal: true,
+      },
+    });
+  });
+});