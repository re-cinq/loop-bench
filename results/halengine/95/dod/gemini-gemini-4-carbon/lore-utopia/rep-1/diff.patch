+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const NOT_REJECTED = Symbol('resolved');
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const promptBuilder = new PromptBuilder({identity: 'Acceptance assistant.'});
+
+describe('chatOrchestrator non-Error rejections', () => {
+  it('wraps a non-Error rejection in an Error whose cause is the original and still rejects the caller with the original', async () => {
+    const plainRejection = {code: 503, detail: 'upstream unavailable'};
+    const stringTurn = await runNonErrorTurn('provider down');
+    const objectTurn = await runNonErrorTurn(plainRejection);
+    const undefinedTurn = await runNonErrorTurn(undefined);
+
+    expect({stringTurn, objectTurn, undefinedTurn}).toEqual({
+      stringTurn: {
+        onErrorCalls: 1,
+        sessionMatches: true,
+        wrappedAsError: true,
+        preservesCause: true,
+        callerRejectionUnchanged: true,
+      },
+      objectTurn: {
+        onErrorCalls: 1,
+        sessionMatches: true,
+        wrappedAsError: true,
+        preservesCause: true,
+        callerRejectionUnchanged: true,
+      },
+      undefinedTurn: {
+        onErrorCalls: 1,
+        sessionMatches: true,
+        wrappedAsError: true,
+        preservesCause: true,
+        callerRejectionUnchanged: true,
+      },
+    });
+  });
+});
+
+async function runNonErrorTurn(thrown: unknown) {
+  const seen: Array<{session: ChatSession; error: Error}> = [];
+  const session: ChatSession = {
+    sessionId: 's-non-error',
+    userId: 'u-non-error',
+    entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+  };
+  const orchestrator = createChatOrchestrator(rejectingProvider(thrown), promptBuilder, undefined, {
+    hooks: {
+      onError: async (hookSession, error) => {
+        seen.push({session: hookSession, error});
+      },
+    },
+  });
+  const rejection = await caughtRejection(orchestrator.processMessage(session));
+  const [first] = seen;
+
+  return {
+    onErrorCalls: seen.length,
+    sessionMatches: first?.session === session,
+    wrappedAsError: first?.error instanceof Error,
+    preservesCause: hasMatchingCause(first?.error, thrown),
+    callerRejectionUnchanged: Object.is(rejection, thrown),
+  };
+}
+
+function rejectingProvider(thrown: unknown): AIProvider {
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield* [];
+      throw thrown;
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('unused in streaming turn');
+    },
+  };
+}
+
+function caughtRejection(promise: Promise<unknown>): Promise<unknown> {
+  return promise.then(
+    () => NOT_REJECTED,
+    (reason: unknown) => reason
+  );
+}
+
+function hasMatchingCause(candidate: unknown, expected: unknown): boolean {
+  if (!(candidate instanceof Error)) return false;
+
+  return 'cause' in candidate && Object.is(candidate.cause, expected);
+}