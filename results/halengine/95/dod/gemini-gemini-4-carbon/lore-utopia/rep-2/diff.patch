@@ -0,0 +1,115 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {captureErrors} from '../shared/logCaptureTestSupport.js';
+import {AIError} from '../types/ai.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const TURN_RESOLVED = Symbol('turn-resolved');
+const PROMPT_BUILDER = new PromptBuilder({identity: 'Acceptance test assistant.'});
+
+const rejectingProvider = (thrown: unknown, prefix: MessageChunk[] = []): AIProvider => ({
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    yield* prefix;
+    throw thrown;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+interface TurnRejectionSummary {
+  hookCalls: number;
+  hookSessionMatches: boolean;
+  hookErrorIsErrorInstance: boolean;
+  hookErrorHasCauseProperty: boolean;
+  hookErrorCauseMatchesThrown: boolean;
+  hookErrorMatchesThrownInstance: boolean;
+  callerReceivedThrown: boolean;
+}
+
+const inspectRejectedTurn = async (thrown: unknown): Promise<TurnRejectionSummary> => {
+  const recordedHookCalls: Array<{session: ChatSession; error: Error}> = [];
+  const hooks: OrchestratorHooks = {
+    onError: async (session, error) => {
+      recordedHookCalls.push({session, error});
+    },
+  };
+  const session: ChatSession = {
+    sessionId: 's-accept',
+    userId: 'u-accept',
+    entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+  };
+  const orchestrator = createChatOrchestrator(rejectingProvider(thrown), PROMPT_BUILDER, undefined, {hooks});
+  const turnPromise = orchestrator.processMessage(session);
+  const callerRejection = await turnPromise.then(
+    () => TURN_RESOLVED,
+    (caught: unknown) => caught
+  );
+
+  if (recordedHookCalls.length !== 1) {
+    return {
+      hookCalls: recordedHookCalls.length,
+      hookSessionMatches: false,
+      hookErrorIsErrorInstance: false,
+      hookErrorHasCauseProperty: false,
+      hookErrorCauseMatchesThrown: false,
+      hookErrorMatchesThrownInstance: false,
+      callerReceivedThrown: Object.is(callerRejection, thrown),
+    };
+  }
+
+  const [firstHookCall] = recordedHookCalls;
+  return {
+    hookCalls: 1,
+    hookSessionMatches: Object.is(firstHookCall.session, session),
+    hookErrorIsErrorInstance: firstHookCall.error instanceof Error,
+    hookErrorHasCauseProperty: 'cause' in firstHookCall.error,
+    hookErrorCauseMatchesThrown: Object.is(firstHookCall.error.cause, thrown),
+    hookErrorMatchesThrownInstance: Object.is(firstHookCall.error, thrown),
+    callerReceivedThrown: Object.is(callerRejection, thrown),
+  };
+};
+
+describe('onError for arbitrary rejections', () => {
+  captureErrors();
+
+  it('calls onError with a cause-carrying Error for string, object, and undefined rejections', async () => {
+    const plainObjectRejection = {code: 'UPSTREAM_DOWN', status: 502};
+    const existingError = new AIError('rate limited', 'RATE_LIMITED');
+
+    const [stringTurn, objectTurn, voidTurn, errorTurn] = await Promise.all([
+      inspectRejectedTurn('upstream gateway timeout'),
+      inspectRejectedTurn(plainObjectRejection),
+      inspectRejectedTurn(undefined),
+      inspectRejectedTurn(existingError),
+    ]);
+
+    const wrappedExpected: TurnRejectionSummary = {
+      hookCalls: 1,
+      hookSessionMatches: true,
+      hookErrorIsErrorInstance: true,
+      hookErrorHasCauseProperty: true,
+      hookErrorCauseMatchesThrown: true,
+      hookErrorMatchesThrownInstance: false,
+      callerReceivedThrown: true,
+    };
+
+    expect({stringTurn, objectTurn, voidTurn, errorTurn}).toEqual({
+      stringTurn: wrappedExpected,
+      objectTurn: wrappedExpected,
+      voidTurn: wrappedExpected,
+      errorTurn: {
+        hookCalls: 1,
+        hookSessionMatches: true,
+        hookErrorIsErrorInstance: true,
+        hookErrorHasCauseProperty: false,
+        hookErrorCauseMatchesThrown: false,
+        hookErrorMatchesThrownInstance: true,
+        callerReceivedThrown: true,
+      },
+    });
+  });
+});