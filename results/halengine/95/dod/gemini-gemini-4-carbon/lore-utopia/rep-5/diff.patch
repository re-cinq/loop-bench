@@ -0,0 +1,75 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('ChatOrchestrator onError non-Error rejections', () => {
+  it('wraps non-Error rejections with cause and rethrows the original value', async () => {
+    const plainObject = {code: 503, detail: 'service unavailable'};
+    const outcomes = await Promise.all([
+      observeRejection('string', 'upstream timeout'),
+      observeRejection('plain object', plainObject),
+      observeRejection('undefined', undefined),
+    ]);
+    const expectedFor = (label: string) => ({
+      label,
+      onErrorCallCount: 1,
+      receivedSameSession: true,
+      receivedErrorInstance: true,
+      preservesCauseProperty: true,
+      causeIsOriginal: true,
+      callerReceivedOriginal: true,
+    });
+
+    expect(outcomes).toEqual([expectedFor('string'), expectedFor('plain object'), expectedFor('undefined')]);
+  });
+});
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const RESOLVED_SENTINEL = Symbol('resolved');
+const promptBuilder = new PromptBuilder({identity: 'Acceptance test assistant.'});
+
+async function observeRejection(label: string, rejection: unknown) {
+  const seenCalls: Array<{session: ChatSession; error: Error}> = [];
+  const hooks: OrchestratorHooks = {
+    onError: async (seenSession, seenError) => {
+      seenCalls.push({session: seenSession, error: seenError});
+    },
+  };
+  const session: ChatSession = {
+    sessionId: `session-${label}`,
+    userId: 'user-1',
+    entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+  };
+  const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+  const callerOutcome = await orchestrator
+    .processMessage(session)
+    .then(() => RESOLVED_SENTINEL)
+    .catch((caught: unknown) => caught);
+
+  const [recorded] = seenCalls;
+  const seenError = recorded?.error;
+
+  return {
+    label,
+    onErrorCallCount: seenCalls.length,
+    receivedSameSession: recorded?.session === session,
+    receivedErrorInstance: seenError instanceof Error,
+    preservesCauseProperty: seenError ? 'cause' in seenError : false,
+    causeIsOriginal: Object.is(seenError?.cause, rejection),
+    callerReceivedOriginal: Object.is(callerOutcome, rejection),
+  };
+}
+
+function rejectingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield -- provider rejects before yielding any chunk
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}