+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function throwingProvider(value: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw value;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('onError for non-Error rejections', () => {
+  it('calls onError with an Error whose cause is the string when the provider rejects with a string', async () => {
+    const thrownString = 'boom from string';
+    let onErrorArg: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorArg = error;
+      },
+    };
+    const orchestrator = createChatOrchestrator(throwingProvider(thrownString), promptBuilder, undefined, {hooks});
+    const rejection = await orchestrator.processMessage(createSession('hi')).catch((e: unknown) => e);
+
+    expect({onErrorCalled: onErrorArg instanceof Error, cause: onErrorArg?.cause, callerGot: rejection}).toEqual({
+      onErrorCalled: true,
+      cause: thrownString,
+      callerGot: thrownString,
+    });
+  });
+
+  it('calls onError with an Error whose cause is the object when the provider rejects with a plain object', async () => {
+    const thrownObject = {code: 'ERR_CUSTOM'};
+    const capturedErrors: Error[] = [];
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, hookError) => {
+        capturedErrors.push(hookError);
+      },
+    };
+    const orchestrator = createChatOrchestrator(throwingProvider(thrownObject), promptBuilder, undefined, {hooks});
+    const rejection = await orchestrator.processMessage(createSession('hi')).catch((e: unknown) => e);
+
+    expect({
+      onErrorCalled: capturedErrors.length === 1,
+      cause: capturedErrors[0]?.cause,
+      callerGot: rejection,
+    }).toEqual({
+      onErrorCalled: true,
+      cause: thrownObject,
+      callerGot: thrownObject,
+    });
+  });
+
+  it('calls onError with an Error whose cause is undefined when the provider rejects with undefined', async () => {
+    let onErrorCalled = false;
+    const hooks: OrchestratorHooks = {
+      onError: async () => {
+        onErrorCalled = true;
+      },
+    };
+    const orchestrator = createChatOrchestrator(throwingProvider(undefined), promptBuilder, undefined, {hooks});
+    const rejection = await orchestrator.processMessage(createSession('hi')).catch((e: unknown) => e);
+
+    expect({onErrorCalled, callerGot: rejection}).toEqual({onErrorCalled: true, callerGot: undefined});
+  });
+});