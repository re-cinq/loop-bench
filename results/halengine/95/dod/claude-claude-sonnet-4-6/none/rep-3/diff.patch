+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function session(): ChatSession {
+  return {sessionId: 's1', userId: 'u1', entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}]};
+}
+
+function throwingProvider(value: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      throw value;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'test'});
+
+const rejectionOf = (p: Promise<unknown>): Promise<unknown> => p.then(() => null).catch((e: unknown) => e);
+
+describe('onError called for non-Error rejections', () => {
+  it('calls onError when the provider rejects with a string, passing an Error whose cause is that string, and re-throws the original string', async () => {
+    const caught: Error[] = [];
+    const hooks: OrchestratorHooks = {
+      onError: async (_s, error) => {
+        caught.push(error);
+      },
+    };
+    const orchestrator = createChatOrchestrator(throwingProvider('something went wrong'), promptBuilder, undefined, {
+      hooks,
+    });
+    const rejection = await rejectionOf(orchestrator.processMessage(session()));
+
+    expect(caught).toHaveLength(1);
+    expect(caught[0]).toBeInstanceOf(Error);
+    expect(caught[0].cause).toBe('something went wrong');
+    expect(rejection).toBe('something went wrong');
+  });
+
+  it('calls onError when the provider rejects with a plain object, passing an Error whose cause is that object, and re-throws the original object', async () => {
+    const original = {code: 'UPSTREAM_FAILURE'};
+    const caught: Error[] = [];
+    const hooks: OrchestratorHooks = {
+      onError: async (_s, error) => {
+        caught.push(error);
+      },
+    };
+    const orchestrator = createChatOrchestrator(throwingProvider(original), promptBuilder, undefined, {hooks});
+    const rejection = await rejectionOf(orchestrator.processMessage(session()));
+
+    expect(caught).toHaveLength(1);
+    expect(caught[0]).toBeInstanceOf(Error);
+    expect(caught[0].cause).toBe(original);
+    expect(rejection).toBe(original);
+  });
+
+  it('calls onError when the provider rejects with undefined, passing an Error whose cause is undefined, and re-throws undefined', async () => {
+    const caught: Error[] = [];
+    const hooks: OrchestratorHooks = {
+      onError: async (_s, error) => {
+        caught.push(error);
+      },
+    };
+    const orchestrator = createChatOrchestrator(throwingProvider(undefined), promptBuilder, undefined, {hooks});
+    const rejection = await rejectionOf(orchestrator.processMessage(session()));
+
+    expect(caught).toHaveLength(1);
+    expect(caught[0]).toBeInstanceOf(Error);
+    expect(caught[0].cause).toBeUndefined();
+    expect(rejection).toBeUndefined();
+  });
+});