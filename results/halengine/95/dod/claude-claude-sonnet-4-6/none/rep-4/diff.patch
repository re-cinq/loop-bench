+// spec: specs/hal-engine-config-hooks/spec.md — replaces the recorded-flaw line
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// Returns the rejection reason as a value regardless of its type.
+const rejectionOf = async (call: Promise<unknown>): Promise<unknown> => {
+  try {
+    await call;
+    return 'resolved without rejecting';
+  } catch (reason: unknown) {
+    return reason;
+  }
+};
+
+function throwingProvider(value: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw value;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('onError for non-Error rejections (HALEngine#95)', () => {
+  it('calls onError with a wrapped Error when the provider rejects with a string, and re-throws the original string', async () => {
+    let onErrorCallCount = 0;
+    let onErrorArg: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCallCount++;
+        onErrorArg = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(throwingProvider('provider down'), promptBuilder, undefined, {hooks});
+    const callerRejection = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+
+    expect(onErrorCallCount).toBe(1);
+    expect(onErrorArg).toBeInstanceOf(Error);
+    expect((onErrorArg as Error & {cause: unknown}).cause).toBe('provider down');
+    expect(callerRejection).toBe('provider down');
+  });
+
+  it('calls onError with a wrapped Error when the provider rejects with a plain object, and re-throws the original object', async () => {
+    const rawRejection = {code: 'RATE_LIMIT', retryAfter: 60};
+    let onErrorCallCount = 0;
+    let onErrorArg: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCallCount++;
+        onErrorArg = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(throwingProvider(rawRejection), promptBuilder, undefined, {hooks});
+    const callerRejection = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+
+    expect(onErrorCallCount).toBe(1);
+    expect(onErrorArg).toBeInstanceOf(Error);
+    expect((onErrorArg as Error & {cause: unknown}).cause).toBe(rawRejection);
+    expect(callerRejection).toBe(rawRejection);
+  });
+
+  it('calls onError with a wrapped Error when the provider rejects with undefined, and re-throws undefined', async () => {
+    let onErrorCallCount = 0;
+    let onErrorArg: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCallCount++;
+        onErrorArg = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(throwingProvider(undefined), promptBuilder, undefined, {hooks});
+    const callerRejection = await rejectionOf(orchestrator.processMessage(createSession('hello')));
+
+    expect(onErrorCallCount).toBe(1);
+    expect(onErrorArg).toBeInstanceOf(Error);
+    expect(callerRejection).toBeUndefined();
+  });
+});