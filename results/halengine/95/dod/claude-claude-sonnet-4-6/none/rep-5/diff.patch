+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+}
+
+function createRejectionProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('onError for non-Error rejections', () => {
+  it('calls onError with wrapped Error when provider rejects with a string', async () => {
+    let onErrorCallCount = 0;
+    let hookError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCallCount++;
+        hookError = error;
+      },
+    };
+    const rejection = 'provider-string-rejection';
+    const orchestrator = createChatOrchestrator(createRejectionProvider(rejection), promptBuilder, undefined, {hooks});
+    let caughtRejection: unknown = 'NOT_CAUGHT';
+    await orchestrator.processMessage(createSession('hello')).catch((e: unknown) => {
+      caughtRejection = e;
+    });
+    expect({
+      onErrorCallCount,
+      hookErrorIsError: hookError instanceof Error,
+      hookErrorCause: hookError?.cause,
+      caughtRejection,
+    }).toEqual({
+      onErrorCallCount: 1,
+      hookErrorIsError: true,
+      hookErrorCause: rejection,
+      caughtRejection: rejection,
+    });
+  });
+
+  it('calls onError with wrapped Error when provider rejects with a plain object', async () => {
+    let onErrorCallCount = 0;
+    let hookError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCallCount++;
+        hookError = error;
+      },
+    };
+    const rejection = {code: 'PROVIDER_FAIL'};
+    const orchestrator = createChatOrchestrator(createRejectionProvider(rejection), promptBuilder, undefined, {hooks});
+    let caughtRejection: unknown = 'NOT_CAUGHT';
+    await orchestrator.processMessage(createSession('hello')).catch((e: unknown) => {
+      caughtRejection = e;
+    });
+    expect({
+      onErrorCallCount,
+      hookErrorIsError: hookError instanceof Error,
+      hookErrorCause: hookError?.cause,
+      caughtRejection,
+    }).toEqual({
+      onErrorCallCount: 1,
+      hookErrorIsError: true,
+      hookErrorCause: rejection,
+      caughtRejection: rejection,
+    });
+  });
+
+  it('calls onError with wrapped Error when provider rejects with undefined', async () => {
+    let onErrorCallCount = 0;
+    let hookError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCallCount++;
+        hookError = error;
+      },
+    };
+    const orchestrator = createChatOrchestrator(createRejectionProvider(undefined), promptBuilder, undefined, {hooks});
+    let caughtRejection: unknown = 'NOT_CAUGHT';
+    await orchestrator.processMessage(createSession('hello')).catch((e: unknown) => {
+      caughtRejection = e;
+    });
+    expect({
+      onErrorCallCount,
+      hookErrorIsError: hookError instanceof Error,
+      caughtRejection,
+    }).toEqual({
+      onErrorCallCount: 1,
+      hookErrorIsError: true,
+      caughtRejection: undefined,
+    });
+  });
+});