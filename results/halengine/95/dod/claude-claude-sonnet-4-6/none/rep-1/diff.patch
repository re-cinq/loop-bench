+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// spec: specs/hal-engine-config-hooks/spec.md
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+  };
+}
+
+function createThrowingProvider(value: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      // eslint-disable-next-line @typescript-eslint/no-throw-literal
+      throw value;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('#95 onError for non-Error rejections', () => {
+  it.each<[string, unknown]>([
+    ['string', 'boom string'],
+    ['plain object', {code: 'ERR_CUSTOM', msg: 'oops'}],
+    ['undefined', undefined],
+  ])(
+    'calls onError with a wrapping Error whose cause is the original %s rejection, and the caller receives the original value',
+    async (_label, rejection) => {
+      let capturedError: Error | undefined;
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          capturedError = error;
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(createThrowingProvider(rejection), promptBuilder, undefined, {hooks});
+
+      let callerError: unknown = Symbol('not set');
+      try {
+        await orchestrator.processMessage(createSession());
+      } catch (e) {
+        callerError = e;
+      }
+
+      // onError must have been called
+      expect(capturedError).toBeDefined();
+      // onError receives an Error instance (wrapping the original)
+      expect(capturedError).toBeInstanceOf(Error);
+      // the cause is the original non-Error rejection
+      expect((capturedError as Error & {cause: unknown}).cause).toBe(rejection);
+      // the caller receives the original rejection value, not the wrapper
+      expect(callerError).toBe(rejection);
+    }
+  );
+});