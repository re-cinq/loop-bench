+/**
+ * Acceptance tests for HALEngine#95: onError must fire for every rejection,
+ * not only those where the thrown value is already an Error.
+ *
+ * specs/hal-engine-config-hooks/spec.md — "non-Error rejection reaches onError"
+ */
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+  };
+}
+
+// Captures the raw rejection value so we can assert it is the ORIGINAL (not wrapped).
+const rawRejectionOf = (call: Promise<unknown>): Promise<unknown> => call.then(() => null).catch((e: unknown) => e);
+
+function createThrowingProvider(value: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      // eslint-disable-next-line @typescript-eslint/no-throw-literal
+      throw value;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('onError for non-Error rejections', () => {
+  it('calls onError with a wrapped Error when the provider rejects with a string, re-throwing the original string', async () => {
+    // spec: specs/hal-engine-config-hooks#non-error-rejection
+    const thrownString = 'something went wrong';
+    let capturedError: Error | undefined;
+    let onErrorCallCount = 0;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCallCount++;
+        capturedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createThrowingProvider(thrownString), promptBuilder, undefined, {
+      hooks,
+    });
+    const rejection = await rawRejectionOf(orchestrator.processMessage(createSession()));
+
+    expect(onErrorCallCount).toBe(1);
+    expect(capturedError).toBeInstanceOf(Error);
+    expect(capturedError?.cause).toBe(thrownString);
+    expect(rejection).toBe(thrownString);
+  });
+
+  it('calls onError with a wrapped Error when the provider rejects with a plain object, re-throwing the original object', async () => {
+    // spec: specs/hal-engine-config-hooks#non-error-rejection
+    const thrownObject = {code: 'UPSTREAM_FAILURE', retryable: false};
+    let capturedError: Error | undefined;
+    let onErrorCallCount = 0;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCallCount++;
+        capturedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createThrowingProvider(thrownObject), promptBuilder, undefined, {
+      hooks,
+    });
+    const rejection = await rawRejectionOf(orchestrator.processMessage(createSession()));
+
+    expect(onErrorCallCount).toBe(1);
+    expect(capturedError).toBeInstanceOf(Error);
+    expect(capturedError?.cause).toBe(thrownObject);
+    expect(rejection).toBe(thrownObject);
+  });
+
+  it('calls onError with a wrapped Error when the provider rejects with undefined, re-throwing undefined', async () => {
+    // spec: specs/hal-engine-config-hooks#non-error-rejection
+    let capturedError: Error | undefined;
+    let onErrorCallCount = 0;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCallCount++;
+        capturedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createThrowingProvider(undefined), promptBuilder, undefined, {hooks});
+    const rejection = await rawRejectionOf(orchestrator.processMessage(createSession()));
+
+    expect(onErrorCallCount).toBe(1);
+    expect(capturedError).toBeInstanceOf(Error);
+    expect(capturedError?.cause).toBeUndefined();
+    expect(rejection).toBeUndefined();
+  });
+});