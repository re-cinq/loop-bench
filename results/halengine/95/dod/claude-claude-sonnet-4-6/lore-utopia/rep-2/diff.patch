+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function throwingProvider(value: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw value;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const captureRejection = (call: Promise<unknown>): Promise<unknown> =>
+  call.then(() => undefined).catch((e: unknown) => e);
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('onError for non-Error rejections', () => {
+  it('calls onError with wrapped Error when provider rejects with a string, and re-throws the original string', async () => {
+    let onErrorCallCount = 0;
+    let onErrorArg: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCallCount++;
+        onErrorArg = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(throwingProvider('provider failed'), promptBuilder, undefined, {hooks});
+    const rejection = await captureRejection(orchestrator.processMessage(createSession('hello')));
+
+    expect(onErrorCallCount).toBe(1);
+    expect(onErrorArg).toBeInstanceOf(Error);
+    expect((onErrorArg as Error).cause).toBe('provider failed');
+    expect(rejection).toBe('provider failed');
+  });
+
+  it('calls onError with wrapped Error when provider rejects with a plain object, and re-throws the original object', async () => {
+    const rejectedObject = {code: 42, reason: 'rate limited'};
+    let onErrorArg: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorArg = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(throwingProvider(rejectedObject), promptBuilder, undefined, {hooks});
+    const rejection = await captureRejection(orchestrator.processMessage(createSession('hello')));
+
+    expect(onErrorArg).toBeInstanceOf(Error);
+    expect((onErrorArg as Error).cause).toBe(rejectedObject);
+    expect(rejection).toBe(rejectedObject);
+  });
+
+  it('calls onError with wrapped Error when provider rejects with undefined, and re-throws undefined', async () => {
+    let onErrorCalled = false;
+    let onErrorArg: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCalled = true;
+        onErrorArg = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(throwingProvider(undefined), promptBuilder, undefined, {hooks});
+    const rejection = await captureRejection(orchestrator.processMessage(createSession('hello')));
+
+    expect(onErrorCalled).toBe(true);
+    expect(onErrorArg).toBeInstanceOf(Error);
+    expect((onErrorArg as Error).cause).toBeUndefined();
+    expect(rejection).toBeUndefined();
+  });
+});