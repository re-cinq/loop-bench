@@ -0,0 +1,106 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function throwingProvider(value: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw value;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('onError for non-Error rejections', () => {
+  it('calls onError once with an Error wrapping the string as cause, re-throws the original string', async () => {
+    let onErrorCallCount = 0;
+    let onErrorIsError = false;
+    let onErrorCause: unknown;
+    let callerRejection: unknown;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCallCount++;
+        onErrorIsError = error instanceof Error;
+        onErrorCause = error.cause;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(throwingProvider('provider failure'), promptBuilder, undefined, {
+      hooks,
+    });
+    await orchestrator.processMessage(createSession('hello')).catch(err => {
+      callerRejection = err;
+    });
+
+    expect({onErrorCallCount, onErrorIsError, onErrorCause, callerRejection}).toEqual({
+      onErrorCallCount: 1,
+      onErrorIsError: true,
+      onErrorCause: 'provider failure',
+      callerRejection: 'provider failure',
+    });
+  });
+
+  it('calls onError once with an Error wrapping the plain object as cause, re-throws it unchanged', async () => {
+    const rejection = {code: 42, message: 'library error shape'};
+    let onErrorIsError = false;
+    let onErrorCause: unknown;
+    let callerRejection: unknown;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorIsError = error instanceof Error;
+        onErrorCause = error.cause;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(throwingProvider(rejection), promptBuilder, undefined, {hooks});
+    await orchestrator.processMessage(createSession('hello')).catch(err => {
+      callerRejection = err;
+    });
+
+    expect({onErrorIsError, onErrorCause, callerRejection}).toEqual({
+      onErrorIsError: true,
+      onErrorCause: rejection,
+      callerRejection: rejection,
+    });
+  });
+
+  it('calls onError once with an Error wrapping undefined as cause, re-throws undefined', async () => {
+    let onErrorIsError = false;
+    let onErrorCause: unknown;
+    let promiseRejectedWithUndefined = false;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorIsError = error instanceof Error;
+        onErrorCause = error.cause;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(throwingProvider(undefined), promptBuilder, undefined, {hooks});
+    await orchestrator.processMessage(createSession('hello')).catch(err => {
+      promiseRejectedWithUndefined = err === undefined;
+    });
+
+    expect({onErrorIsError, onErrorCause, promiseRejectedWithUndefined}).toEqual({
+      onErrorIsError: true,
+      onErrorCause: undefined,
+      promiseRejectedWithUndefined: true,
+    });
+  });
+});