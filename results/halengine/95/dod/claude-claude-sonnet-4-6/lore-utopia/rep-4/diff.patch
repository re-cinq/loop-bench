@@ -0,0 +1,132 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function createThrowingProvider(thrown: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw thrown;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('onError for non-Error rejections', () => {
+  it('calls onError with an Error whose cause is the string when the provider rejects with a string', async () => {
+    let onErrorCalled = false;
+    let onErrorArg: Error | undefined;
+    let callerRejected = false;
+    let callerRejection: unknown;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCalled = true;
+        onErrorArg = error;
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      createThrowingProvider('something went wrong'),
+      promptBuilder,
+      undefined,
+      {hooks}
+    );
+    await orchestrator.processMessage(createSession('hello')).catch(e => {
+      callerRejected = true;
+      callerRejection = e;
+    });
+    expect({
+      onErrorCalled,
+      isError: onErrorArg instanceof Error,
+      cause: (onErrorArg as Error | undefined)?.cause,
+      callerRejected,
+      callerRejection,
+    }).toEqual({
+      onErrorCalled: true,
+      isError: true,
+      cause: 'something went wrong',
+      callerRejected: true,
+      callerRejection: 'something went wrong',
+    });
+  });
+
+  it('calls onError with an Error whose cause is the plain object when the provider rejects with a plain object', async () => {
+    const thrownObject = {code: 'NOT_FOUND'};
+    let onErrorCalled = false;
+    let onErrorArg: Error | undefined;
+    let callerRejected = false;
+    let callerRejection: unknown;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCalled = true;
+        onErrorArg = error;
+      },
+    };
+    const orchestrator = createChatOrchestrator(createThrowingProvider(thrownObject), promptBuilder, undefined, {
+      hooks,
+    });
+    await orchestrator.processMessage(createSession('hello')).catch(e => {
+      callerRejected = true;
+      callerRejection = e;
+    });
+    expect({
+      onErrorCalled,
+      isError: onErrorArg instanceof Error,
+      cause: (onErrorArg as Error | undefined)?.cause,
+      callerRejected,
+      callerRejection,
+    }).toEqual({
+      onErrorCalled: true,
+      isError: true,
+      cause: thrownObject,
+      callerRejected: true,
+      callerRejection: thrownObject,
+    });
+  });
+
+  it('calls onError with an Error whose cause is undefined when the provider rejects with undefined', async () => {
+    let onErrorCalled = false;
+    let onErrorArg: Error | undefined;
+    let callerRejected = false;
+    let callerRejection: unknown = Symbol('not set');
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCalled = true;
+        onErrorArg = error;
+      },
+    };
+    const orchestrator = createChatOrchestrator(createThrowingProvider(undefined), promptBuilder, undefined, {hooks});
+    await orchestrator.processMessage(createSession('hello')).catch(e => {
+      callerRejected = true;
+      callerRejection = e;
+    });
+    expect({
+      onErrorCalled,
+      isError: onErrorArg instanceof Error,
+      cause: (onErrorArg as Error | undefined)?.cause,
+      callerRejected,
+      callerRejection,
+    }).toEqual({
+      onErrorCalled: true,
+      isError: true,
+      cause: undefined,
+      callerRejected: true,
+      callerRejection: undefined,
+    });
+  });
+});