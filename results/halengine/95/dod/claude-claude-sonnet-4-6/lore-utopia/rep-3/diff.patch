+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+const session: ChatSession = {
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hi', timestamp: SENT_AT}],
+};
+
+function rejectingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      // eslint-disable-next-line @typescript-eslint/only-throw-error -- test fixture: rejects with arbitrary value to verify onError handles non-Error rejections
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const rawRejectionOf = (p: Promise<unknown>): Promise<unknown> => p.then(() => undefined).catch((e: unknown) => e);
+
+const assertWrapsAndRethrows = async (rejection: unknown): Promise<void> => {
+  const received: Error[] = [];
+  const hooks: OrchestratorHooks = {onError: async (_s, e) => void received.push(e)};
+  const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+  const actual = await rawRejectionOf(orchestrator.processMessage(session));
+  expect({count: received.length, isError: received[0] instanceof Error, cause: received[0]?.cause, actual}).toEqual({
+    count: 1,
+    isError: true,
+    cause: rejection,
+    actual: rejection,
+  });
+};
+
+describe('onError for non-Error rejections', () => {
+  it('calls onError with an Error whose cause is the string when the provider rejects with a string, and rethrows unchanged', () =>
+    assertWrapsAndRethrows('provider failure string'));
+
+  it('calls onError with an Error whose cause is the object when the provider rejects with a plain object, and rethrows unchanged', () =>
+    assertWrapsAndRethrows({code: 'PROVIDER_ERR'}));
+
+  it('calls onError with an Error whose cause is undefined when the provider rejects with undefined, and rethrows unchanged', () =>
+    assertWrapsAndRethrows(undefined));
+});