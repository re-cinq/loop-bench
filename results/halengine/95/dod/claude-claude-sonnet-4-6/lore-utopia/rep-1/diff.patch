+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// eslint-disable-next-line require-yield
+function throwingProvider(thrown: unknown): AIProvider {
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw thrown;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('onError receives every rejection, not only Error instances', () => {
+  it('calls onError with a wrapped Error whose cause is the string, and re-throws the original string to the caller', async () => {
+    let onErrorCallCount = 0;
+    let onErrorArg: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCallCount++;
+        onErrorArg = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(throwingProvider('provider failure'), promptBuilder, undefined, {
+      hooks,
+    });
+
+    await expect(orchestrator.processMessage(createSession('hello'))).rejects.toBe('provider failure');
+
+    expect(onErrorCallCount).toBe(1);
+    expect(onErrorArg).toBeInstanceOf(Error);
+    expect(onErrorArg).toHaveProperty('cause', 'provider failure');
+  });
+
+  it('calls onError with a wrapped Error whose cause is the object, and re-throws the original object to the caller', async () => {
+    const thrownObject = {code: 'ERR_SDK', status: 503};
+    let onErrorCallCount = 0;
+    let onErrorArg: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCallCount++;
+        onErrorArg = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(throwingProvider(thrownObject), promptBuilder, undefined, {hooks});
+
+    await expect(orchestrator.processMessage(createSession('hello'))).rejects.toBe(thrownObject);
+
+    expect(onErrorCallCount).toBe(1);
+    expect(onErrorArg).toBeInstanceOf(Error);
+    expect(onErrorArg).toHaveProperty('cause', thrownObject);
+  });
+
+  it('calls onError with a wrapped Error whose cause is undefined, and re-throws undefined to the caller', async () => {
+    let onErrorCallCount = 0;
+    let onErrorArg: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCallCount++;
+        onErrorArg = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(throwingProvider(undefined), promptBuilder, undefined, {hooks});
+
+    await expect(orchestrator.processMessage(createSession('hello'))).rejects.toBeUndefined();
+
+    expect(onErrorCallCount).toBe(1);
+    expect(onErrorArg).toBeInstanceOf(Error);
+    expect(onErrorArg).toHaveProperty('cause', undefined);
+  });
+});