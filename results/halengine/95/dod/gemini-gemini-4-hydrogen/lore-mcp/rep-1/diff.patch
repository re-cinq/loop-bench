+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const FIXED_TIMESTAMP = '2026-01-01T00:00:00.000Z';
+
+const rejectingProvider = (rejection: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield -- provider rejects before yielding any chunk
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+const captureRejection = (call: Promise<unknown>): Promise<{rejected: boolean; value: unknown}> =>
+  call.then(
+    () => ({rejected: false, value: undefined}),
+    (thrown: unknown) => ({rejected: true, value: thrown})
+  );
+
+describe('ChatOrchestrator onError non-Error rejections', () => {
+  it('calls onError once with an Error wrapping non-Error rejections as cause and rethrows original', async () => {
+    const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+    const plainObject = {code: 'UPSTREAM_FAIL', status: 502};
+    const cases = ['upstream failure', plainObject, undefined];
+    const results = [];
+
+    for (const rejection of cases) {
+      const observed: Error[] = [];
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          observed.push(error);
+        },
+      };
+      const session: ChatSession = {
+        sessionId: 's-non-error',
+        userId: 'u-non-error',
+        entries: [{role: 'user', content: 'hello', timestamp: FIXED_TIMESTAMP}],
+      };
+
+      const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+      const callerOutcome = await captureRejection(orchestrator.processMessage(session));
+      const firstError = observed[0];
+
+      results.push({
+        onErrorCount: observed.length,
+        isError: firstError instanceof Error,
+        causeIsOriginal: firstError instanceof Error && 'cause' in firstError && firstError.cause === rejection,
+        callerRejected: callerOutcome.rejected,
+        callerReceivedOriginal: callerOutcome.value === rejection,
+      });
+    }
+
+    expect(results).toEqual([
+      {onErrorCount: 1, isError: true, causeIsOriginal: true, callerRejected: true, callerReceivedOriginal: true},
+      {onErrorCount: 1, isError: true, causeIsOriginal: true, callerRejected: true, callerReceivedOriginal: true},
+      {onErrorCount: 1, isError: true, causeIsOriginal: true, callerRejected: true, callerReceivedOriginal: true},
+    ]);
+  });
+});