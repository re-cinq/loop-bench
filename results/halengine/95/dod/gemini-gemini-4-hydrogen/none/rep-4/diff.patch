@@ -0,0 +1,93 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('onError rejection wrapping', () => {
+  it('calls onError with an Error wrapping a thrown string and rethrows the string', async () => {
+    const {receivedErrors, callerOutcome} = await runRejection('provider string failure');
+
+    expect({
+      callCount: receivedErrors.length,
+      isError: receivedErrors[0] instanceof Error,
+      cause: receivedErrors[0]?.cause,
+      callerOutcome,
+    }).toEqual({
+      callCount: 1,
+      isError: true,
+      cause: 'provider string failure',
+      callerOutcome: {rejected: true, value: 'provider string failure'},
+    });
+  });
+
+  it('calls onError with an Error wrapping a thrown object and rethrows the object', async () => {
+    const thrown = {code: 'UPSTREAM_DOWN', status: 503};
+    const {receivedErrors, callerOutcome} = await runRejection(thrown);
+
+    expect({
+      callCount: receivedErrors.length,
+      isError: receivedErrors[0] instanceof Error,
+      sameCause: receivedErrors[0]?.cause === thrown,
+      callerRejected: callerOutcome.rejected,
+      sameCallerValue: callerOutcome.value === thrown,
+    }).toEqual({
+      callCount: 1,
+      isError: true,
+      sameCause: true,
+      callerRejected: true,
+      sameCallerValue: true,
+    });
+  });
+
+  it('calls onError with an Error wrapping undefined and rethrows undefined', async () => {
+    const {receivedErrors, callerOutcome} = await runRejection(undefined);
+
+    expect({
+      callCount: receivedErrors.length,
+      isError: receivedErrors[0] instanceof Error,
+      cause: receivedErrors[0]?.cause,
+      callerOutcome,
+    }).toEqual({
+      callCount: 1,
+      isError: true,
+      cause: undefined,
+      callerOutcome: {rejected: true, value: undefined},
+    });
+  });
+});
+
+async function runRejection(thrown: unknown): Promise<{
+  receivedErrors: Error[];
+  callerOutcome: {rejected: boolean; value: unknown};
+}> {
+  const provider: AIProvider = {
+    // eslint-disable-next-line require-yield -- rejects before yielding any chunk
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw thrown;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+  const receivedErrors: Error[] = [];
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => {
+      receivedErrors.push(error);
+    },
+  };
+  const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+  const session: ChatSession = {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+
+  const callerOutcome = await orchestrator.processMessage(session).then(
+    value => ({rejected: false, value}),
+    (reason: unknown) => ({rejected: true, value: reason})
+  );
+
+  return {receivedErrors, callerOutcome};
+}