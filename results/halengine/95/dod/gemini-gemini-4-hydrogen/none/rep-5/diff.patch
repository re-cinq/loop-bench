@@ -0,0 +1,67 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const RESOLVED_WITHOUT_ERROR = Symbol('resolved-without-error');
+
+describe('ChatOrchestrator onError for non-Error rejections', () => {
+  it('calls onError once with an Error wrapping a string rejection in cause and rethrows the string unchanged', async () => {
+    expect(await runRejection('rate limited')).toEqual({
+      callCount: 1,
+      isError: true,
+      hasCause: true,
+      cause: 'rate limited',
+      sameRejection: true,
+    });
+  });
+
+  it('calls onError once with an Error wrapping a plain object or undefined rejection in cause and rethrows each unchanged', async () => {
+    const providerPayload = {code: 503, detail: 'unavailable'};
+
+    expect([await runRejection(providerPayload), await runRejection(undefined)]).toEqual([
+      {callCount: 1, isError: true, hasCause: true, cause: providerPayload, sameRejection: true},
+      {callCount: 1, isError: true, hasCause: true, cause: undefined, sameRejection: true},
+    ]);
+  });
+});
+
+async function runRejection(thrown: unknown) {
+  const seenErrors: Error[] = [];
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      await Promise.reject(thrown);
+      yield {type: 'text', text: 'unreachable'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Test assistant.'}), undefined, {
+    hooks: {
+      onError: async (_session, error) => {
+        seenErrors.push(error);
+      },
+    },
+  });
+  const session: ChatSession = {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+  };
+
+  const caught = await orchestrator.processMessage(session).then(
+    () => RESOLVED_WITHOUT_ERROR,
+    (rejection: unknown) => rejection
+  );
+  const firstError = seenErrors[0];
+
+  return {
+    callCount: seenErrors.length,
+    isError: firstError instanceof Error,
+    hasCause: firstError !== undefined && 'cause' in firstError,
+    cause: firstError?.cause,
+    sameRejection: Object.is(caught, thrown),
+  };
+}