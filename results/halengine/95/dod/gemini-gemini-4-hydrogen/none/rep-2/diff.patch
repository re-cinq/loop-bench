@@ -0,0 +1,90 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+type TurnOutcome = {rejected: true; value: unknown} | {rejected: false; reply: string};
+
+const runRejectingTurn = async (rejection: unknown) => {
+  const received: Error[] = [];
+  const provider: AIProvider = {
+    // eslint-disable-next-line require-yield -- rejects before emitting chunks to simulate a failing provider
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => {
+      received.push(error);
+    },
+  };
+  const session: ChatSession = {
+    sessionId: 'accept-95',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Test.'}), undefined, {hooks});
+
+  let outcome: TurnOutcome;
+  try {
+    const reply = await orchestrator.processMessage(session);
+    outcome = {rejected: false, reply};
+  } catch (caught) {
+    outcome = {rejected: true, value: caught};
+  }
+
+  return {received, outcome};
+};
+
+const summarizeHooks = (received: Error[]) =>
+  received.map(error => ({
+    isError: error instanceof Error,
+    hasCause: 'cause' in error,
+    cause: error.cause,
+  }));
+
+describe('onError acceptance criteria for rejections that are not Error instances', () => {
+  it('calls onError once with an Error wrapping a string rejection as cause while rethrowing the original string', async () => {
+    const rejection = 'upstream timeout';
+
+    const {received, outcome} = await runRejectingTurn(rejection);
+
+    expect({recorded: summarizeHooks(received), outcome}).toEqual({
+      recorded: [{isError: true, hasCause: true, cause: rejection}],
+      outcome: {rejected: true, value: rejection},
+    });
+  });
+
+  it('calls onError once with an Error wrapping a plain object rejection as cause while rethrowing the original object', async () => {
+    const rejection = {code: 'ECONNRESET', retryable: true};
+
+    const {received, outcome} = await runRejectingTurn(rejection);
+
+    expect({
+      recorded: summarizeHooks(received),
+      sameCauseRef: received[0]?.cause === rejection,
+      sameOutcomeRef: outcome.rejected && outcome.value === rejection,
+      outcome,
+    }).toEqual({
+      recorded: [{isError: true, hasCause: true, cause: rejection}],
+      sameCauseRef: true,
+      sameOutcomeRef: true,
+      outcome: {rejected: true, value: rejection},
+    });
+  });
+
+  it('calls onError once with an Error wrapping an undefined rejection as cause while rethrowing undefined', async () => {
+    const {received, outcome} = await runRejectingTurn(undefined);
+
+    expect({recorded: summarizeHooks(received), outcome}).toEqual({
+      recorded: [{isError: true, hasCause: true, cause: undefined}],
+      outcome: {rejected: true, value: undefined},
+    });
+  });
+});