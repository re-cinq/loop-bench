+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+interface RejectionReport {
+  calls: number;
+  passedError: boolean;
+  hasCause: boolean;
+  cause: unknown;
+  callerThrew: boolean;
+  callerReason: unknown;
+}
+
+describe('ChatOrchestrator onError for rejections that are not Errors', () => {
+  it('calls onError once with an Error wrapping a string rejection as cause and rethrows the string', async () => {
+    const {calls, passedError, hasCause, cause, callerThrew, callerReason} =
+      await observeRejectedTurn('upstream rate limit');
+
+    expect({calls, passedError, hasCause, cause, callerThrew, callerReason}).toEqual({
+      calls: 1,
+      passedError: true,
+      hasCause: true,
+      cause: 'upstream rate limit',
+      callerThrew: true,
+      callerReason: 'upstream rate limit',
+    });
+  });
+
+  it('calls onError once with an Error wrapping a plain object rejection as cause and rethrows the object', async () => {
+    const payload = {code: 'UPSTREAM_TIMEOUT', status: 504};
+    const report = await observeRejectedTurn(payload);
+
+    expect({
+      calls: report.calls,
+      passedError: report.passedError,
+      causeMatchesPayload: report.hasCause && Object.is(report.cause, payload),
+      callerMatchesPayload: report.callerThrew && Object.is(report.callerReason, payload),
+    }).toEqual({
+      calls: 1,
+      passedError: true,
+      causeMatchesPayload: true,
+      callerMatchesPayload: true,
+    });
+  });
+
+  it('calls onError once with an Error wrapping an undefined rejection as cause and rethrows undefined', async () => {
+    const report = await observeRejectedTurn(undefined);
+
+    expect({
+      calls: report.calls,
+      passedError: report.passedError,
+      hasCause: report.hasCause,
+      causeIsUndefined: report.hasCause && report.cause === undefined,
+      callerThrewUndefined: report.callerThrew && report.callerReason === undefined,
+    }).toEqual({
+      calls: 1,
+      passedError: true,
+      hasCause: true,
+      causeIsUndefined: true,
+      callerThrewUndefined: true,
+    });
+  });
+});
+
+async function observeRejectedTurn(rejectedValue: unknown): Promise<RejectionReport> {
+  const receivedErrors: Error[] = [];
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => {
+      receivedErrors.push(error);
+    },
+  };
+
+  const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+  const orchestrator = createChatOrchestrator(rejectingProvider(rejectedValue), promptBuilder, undefined, {hooks});
+  const callerOutcome = await orchestrator.processMessage(createSession()).then(
+    () => ({threw: false as const, reason: undefined as unknown}),
+    (reason: unknown) => ({threw: true as const, reason})
+  );
+
+  const [firstError] = receivedErrors;
+
+  if (!(firstError instanceof Error)) {
+    return {
+      calls: receivedErrors.length,
+      passedError: false,
+      hasCause: false,
+      cause: undefined,
+      callerThrew: callerOutcome.threw,
+      callerReason: callerOutcome.reason,
+    };
+  }
+
+  return {
+    calls: receivedErrors.length,
+    passedError: true,
+    hasCause: 'cause' in firstError,
+    cause: firstError.cause,
+    callerThrew: callerOutcome.threw,
+    callerReason: callerOutcome.reason,
+  };
+}
+
+function rejectingProvider(reason: unknown): AIProvider {
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      await Promise.reject(reason);
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+function createSession(): ChatSession {
+  const sentAt = '2026-01-01T00:00:00.000Z';
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: sentAt}],
+  };
+}