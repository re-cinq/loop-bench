@@ -0,0 +1,97 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const runTurnWithRejection = async (thrownValue: unknown) => {
+  const hookErrors: Error[] = [];
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => {
+      hookErrors.push(error);
+    },
+  };
+  const provider: AIProvider = {
+    // eslint-disable-next-line require-yield -- rejects before emitting a chunk
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw thrownValue;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Acceptance test.'}), undefined, {
+    hooks,
+  });
+  const session: ChatSession = {
+    sessionId: 'acceptance-session',
+    userId: 'acceptance-user',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+
+  const callerOutcome = await orchestrator.processMessage(session).then(
+    () => ({rejected: false as const}),
+    (reason: unknown) => ({rejected: true as const, reason})
+  );
+
+  return {hookErrors, callerOutcome};
+};
+
+describe('onError for non-Error rejections', () => {
+  it('calls onError once with an Error whose cause is the thrown string and preserves the string rejection', async () => {
+    const rawRejection = 'provider string rejection';
+
+    const {hookErrors, callerOutcome} = await runTurnWithRejection(rawRejection);
+    const reported: Error | undefined = hookErrors[0];
+
+    expect({
+      hookCallCount: hookErrors.length,
+      isErrorInstance: reported instanceof Error,
+      reportedCause: reported?.cause,
+      callerOutcome,
+    }).toEqual({
+      hookCallCount: 1,
+      isErrorInstance: true,
+      reportedCause: rawRejection,
+      callerOutcome: {rejected: true, reason: rawRejection},
+    });
+  });
+
+  it('calls onError once with an Error whose cause is the thrown plain object and preserves the object rejection', async () => {
+    const rawRejection = {code: 'UPSTREAM_502', detail: 'bad gateway'};
+
+    const {hookErrors, callerOutcome} = await runTurnWithRejection(rawRejection);
+    const reported: Error | undefined = hookErrors[0];
+
+    expect({
+      hookCallCount: hookErrors.length,
+      isErrorInstance: reported instanceof Error,
+      sameCauseReference: reported?.cause === rawRejection,
+      sameCallerReference: callerOutcome.rejected && callerOutcome.reason === rawRejection,
+    }).toEqual({
+      hookCallCount: 1,
+      isErrorInstance: true,
+      sameCauseReference: true,
+      sameCallerReference: true,
+    });
+  });
+
+  it('calls onError once with an Error whose cause is undefined and preserves the undefined rejection', async () => {
+    const {hookErrors, callerOutcome} = await runTurnWithRejection(undefined);
+    const reported: Error | undefined = hookErrors[0];
+
+    expect({
+      hookCallCount: hookErrors.length,
+      isErrorInstance: reported instanceof Error,
+      hasCauseProperty: reported !== undefined && 'cause' in reported,
+      reportedCause: reported?.cause,
+      callerOutcome,
+    }).toEqual({
+      hookCallCount: 1,
+      isErrorInstance: true,
+      hasCauseProperty: true,
+      reportedCause: undefined,
+      callerOutcome: {rejected: true, reason: undefined},
+    });
+  });
+});