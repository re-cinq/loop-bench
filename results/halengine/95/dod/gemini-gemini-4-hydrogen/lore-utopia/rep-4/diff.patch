@@ -0,0 +1,66 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('ChatOrchestrator onError for thrown values that are not Error instances', () => {
+  it('calls onError once with an Error cause for string, object, and undefined rejections', async () => {
+    const objectRejection = {code: 'ECONNRESET', retryable: true};
+    const cases: unknown[] = ['upstream timeout', objectRejection, undefined];
+    const outcomes = [];
+
+    for (const rejection of cases) {
+      outcomes.push(await runRejectedTurn(rejection));
+    }
+
+    expect(outcomes).toEqual(
+      cases.map(() => ({
+        onErrorCalls: 1,
+        isError: true,
+        causeIsOriginal: true,
+        callerReceivedOriginal: true,
+      }))
+    );
+  });
+});
+
+async function runRejectedTurn(rejection: unknown) {
+  const receivedErrors: Error[] = [];
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => {
+      receivedErrors.push(error);
+    },
+  };
+  const provider: AIProvider = {
+    // eslint-disable-next-line require-yield -- rejects before emitting any chunk
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const session: ChatSession = {
+    sessionId: 'acceptance-session',
+    userId: 'acceptance-user',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Acceptance test.'}), undefined, {
+    hooks,
+  });
+
+  const resolvedSentinel = Symbol('resolved');
+  const callerThrown: unknown = await orchestrator.processMessage(session).then(
+    () => resolvedSentinel,
+    (thrown: unknown) => thrown
+  );
+
+  const firstError = receivedErrors[0];
+  return {
+    onErrorCalls: receivedErrors.length,
+    isError: firstError instanceof Error,
+    causeIsOriginal: firstError instanceof Error && firstError.cause === rejection,
+    callerReceivedOriginal: callerThrown === rejection,
+  };
+}