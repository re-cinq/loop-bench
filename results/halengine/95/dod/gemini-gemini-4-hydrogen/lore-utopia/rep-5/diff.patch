@@ -0,0 +1,77 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('ChatOrchestrator onError for arbitrary rejections', () => {
+  it('calls onError once with an Error wrapping the rejection as cause and rethrows the original value', async () => {
+    const plainObject = {code: 'E_DOWNSTREAM', status: 503};
+    const cases = [
+      {label: 'string', thrownReason: 'provider rejected with string'},
+      {label: 'plainObject', thrownReason: plainObject},
+      {label: 'undefined', thrownReason: undefined},
+    ];
+
+    const observations = await Promise.all(
+      cases.map(async entry => {
+        const observation = await runRejectingTurn(entry.thrownReason);
+        return {label: entry.label, ...observation};
+      })
+    );
+
+    const expected = cases.map(entry => ({
+      label: entry.label,
+      onErrorCallCount: 1,
+      receivedAnError: true,
+      causeIsOriginal: true,
+      callerReceivedOriginal: true,
+    }));
+
+    expect(observations).toEqual(expected);
+  });
+});
+
+async function runRejectingTurn(thrownReason: unknown) {
+  const recordedErrors: Error[] = [];
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => {
+      recordedErrors.push(error);
+    },
+  };
+  const provider: AIProvider = {
+    // eslint-disable-next-line require-yield -- provider rejects before yielding any chunk
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw thrownReason;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const sentAt = '2026-01-01T00:00:00.000Z';
+  const session: ChatSession = {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: sentAt}],
+  };
+  const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+  const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+
+  const resolvedSentinel = Symbol('resolved');
+  const callerRejection = await orchestrator.processMessage(session).then(
+    () => resolvedSentinel,
+    (reason: unknown) => reason
+  );
+
+  const firstError = recordedErrors[0];
+  const receivedAnError = firstError instanceof Error;
+  const causeIsOriginal =
+    firstError instanceof Error ? 'cause' in firstError && firstError.cause === thrownReason : false;
+
+  return {
+    onErrorCallCount: recordedErrors.length,
+    receivedAnError,
+    causeIsOriginal,
+    callerReceivedOriginal: callerRejection === thrownReason,
+  };
+}