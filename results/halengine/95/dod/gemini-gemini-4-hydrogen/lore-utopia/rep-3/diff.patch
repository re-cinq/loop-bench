@@ -0,0 +1,99 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed timestamp so tests remain deterministic across runs.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const FULFILLED_SENTINEL = Symbol('resolved-without-rejection');
+
+const createSession = (): ChatSession => ({
+  sessionId: 'session-1',
+  userId: 'user-1',
+  entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+});
+
+const createRejectingProvider = (reason: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield -- rejects before yielding to model a pre-stream failure
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw reason;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+const rejectionOf = (call: Promise<unknown>): Promise<unknown> =>
+  call.then(
+    () => FULFILLED_SENTINEL,
+    (reason: unknown) => reason
+  );
+
+describe('ChatOrchestrator onError for non-Error rejections', () => {
+  it('calls onError once with an Error whose cause is the rejection and rethrows the original value', async () => {
+    const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+    const plainObject = {code: 'UPSTREAM_FAIL', status: 502};
+    const cases: Array<{label: string; thrown: unknown}> = [
+      {label: 'string', thrown: 'provider failed with a string'},
+      {label: 'plain-object', thrown: plainObject},
+      {label: 'undefined', thrown: undefined},
+    ];
+    const outcomes: Array<{
+      label: string;
+      onErrorCalls: number;
+      passedIsError: boolean;
+      passedCause: unknown;
+      callerRejection: unknown;
+    }> = [];
+
+    for (const rejectionCase of cases) {
+      const received: Error[] = [];
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          received.push(error);
+        },
+      };
+      const orchestrator = createChatOrchestrator(
+        createRejectingProvider(rejectionCase.thrown),
+        promptBuilder,
+        undefined,
+        {hooks}
+      );
+      const callerRejection = await rejectionOf(orchestrator.processMessage(createSession()));
+      const firstError = received[0];
+
+      outcomes.push({
+        label: rejectionCase.label,
+        onErrorCalls: received.length,
+        passedIsError: firstError instanceof Error,
+        passedCause: firstError instanceof Error ? firstError.cause : undefined,
+        callerRejection,
+      });
+    }
+
+    expect(outcomes).toEqual([
+      {
+        label: 'string',
+        onErrorCalls: 1,
+        passedIsError: true,
+        passedCause: 'provider failed with a string',
+        callerRejection: 'provider failed with a string',
+      },
+      {
+        label: 'plain-object',
+        onErrorCalls: 1,
+        passedIsError: true,
+        passedCause: plainObject,
+        callerRejection: plainObject,
+      },
+      {
+        label: 'undefined',
+        onErrorCalls: 1,
+        passedIsError: true,
+        passedCause: undefined,
+        callerRejection: undefined,
+      },
+    ]);
+  });
+});