+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator onError for rejections that are not Error instances', () => {
+  it('calls onError with an Error cause wrapper for string, object, and undefined rejections', async () => {
+    const plainRejection = {code: 'PROVIDER_FAILED', retryable: false};
+    const rejectedValues: unknown[] = ['provider rejected with string', plainRejection, undefined];
+    const outcomes = [];
+
+    for (const rejectedValue of rejectedValues) {
+      const receivedErrors: Error[] = [];
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          receivedErrors.push(error);
+        },
+      };
+      const orchestrator = createChatOrchestrator(rejectingProvider(rejectedValue), promptBuilder, undefined, {hooks});
+      const callerRejection = await rawRejectionOf(orchestrator.processMessage(userSession('hello')));
+      const recordedError = receivedErrors[0];
+      outcomes.push({
+        onErrorCalls: receivedErrors.length,
+        passedErrorInstance: recordedError instanceof Error,
+        causePreserved: recordedError instanceof Error && recordedError.cause === rejectedValue,
+        callerGotOriginal: callerRejection === rejectedValue,
+      });
+    }
+
+    expect(outcomes).toEqual([
+      {onErrorCalls: 1, passedErrorInstance: true, causePreserved: true, callerGotOriginal: true},
+      {onErrorCalls: 1, passedErrorInstance: true, causePreserved: true, callerGotOriginal: true},
+      {onErrorCalls: 1, passedErrorInstance: true, causePreserved: true, callerGotOriginal: true},
+    ]);
+  });
+});
+
+function rejectingProvider(rejectedValue: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield -- provider rejects before yielding any chunk
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejectedValue;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+function userSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function rawRejectionOf(promise: Promise<unknown>): Promise<unknown> {
+  return promise.then(
+    () => Symbol('unexpectedly-resolved'),
+    (thrown: unknown) => thrown
+  );
+}