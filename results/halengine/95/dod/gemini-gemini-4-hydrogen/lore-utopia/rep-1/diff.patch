+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const FIXED_TIMESTAMP = '2026-01-01T00:00:00.000Z';
+const RESOLVED_MARKER = Symbol('resolved-without-rejection');
+
+const rejectionCases: Array<{rejectionKind: string; thrownValue: unknown}> = [
+  {rejectionKind: 'string', thrownValue: 'upstream string rejection'},
+  {rejectionKind: 'plain object', thrownValue: {code: 'E_UPSTREAM', detail: 'custom shape'}},
+  {rejectionKind: 'undefined', thrownValue: undefined},
+];
+
+describe('ChatOrchestrator onError for primitive and object rejections', () => {
+  it('wraps non-Error rejections with cause for onError and rethrows the original value', async () => {
+    const observations = await Promise.all(
+      rejectionCases.map(async ({rejectionKind, thrownValue}) => ({
+        rejectionKind,
+        ...(await runTurnWithRejection(thrownValue)),
+      }))
+    );
+
+    expect(observations).toEqual(
+      rejectionCases.map(({rejectionKind}) => ({
+        rejectionKind,
+        onErrorCallCount: 1,
+        passedIsError: true,
+        causeMatchesOriginal: true,
+        callerMatchesOriginal: true,
+      }))
+    );
+  });
+});
+
+async function runTurnWithRejection(thrownValue: unknown) {
+  const capturedErrors: Error[] = [];
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => {
+      capturedErrors.push(error);
+    },
+  };
+  const session: ChatSession = {
+    sessionId: 'acceptance-s1',
+    userId: 'acceptance-u1',
+    entries: [{role: 'user', content: 'hello', timestamp: FIXED_TIMESTAMP}],
+  };
+  const orchestrator = createChatOrchestrator(
+    providerRejectingWith(thrownValue),
+    new PromptBuilder({identity: 'Acceptance test assistant.'}),
+    undefined,
+    {hooks}
+  );
+
+  const callerRejection = await captureRejection(orchestrator.processMessage(session));
+  const firstError = capturedErrors[0];
+
+  return {
+    onErrorCallCount: capturedErrors.length,
+    passedIsError: firstError instanceof Error,
+    causeMatchesOriginal: firstError instanceof Error ? firstError.cause === thrownValue : false,
+    callerMatchesOriginal: callerRejection === thrownValue,
+  };
+}
+
+function providerRejectingWith(thrownValue: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield -- provider rejects before yielding any chunk
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw thrownValue;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+function captureRejection(promise: Promise<unknown>): Promise<unknown> {
+  return promise.then(
+    () => RESOLVED_MARKER,
+    (rejection: unknown) => rejection
+  );
+}