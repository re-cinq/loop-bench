+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const session = (): ChatSession => ({
+  sessionId: 'non-error-rejection',
+  userId: 'user',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+function rejectingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+describe('non-Error provider rejections', () => {
+  it('calls onError once with a wrapping Error and rethrows each original value unchanged', async () => {
+    const rejections: unknown[] = ['provider failed', {code: 'PROVIDER_FAILURE'}, undefined];
+
+    for (const rejection of rejections) {
+      const hookErrors: Error[] = [];
+      const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {
+        hooks: {
+          onError: async (_session, error) => {
+            hookErrors.push(error);
+          },
+        },
+      });
+
+      let callerRejection: unknown = Symbol('resolved');
+      try {
+        await orchestrator.processMessage(session());
+      } catch (error) {
+        callerRejection = error;
+      }
+
+      expect({
+        hookCallCount: hookErrors.length,
+        hookReceivedError: hookErrors[0] instanceof Error,
+        causeIsOriginal: Object.is(hookErrors[0]?.cause, rejection),
+        callerReceivedOriginal: Object.is(callerRejection, rejection),
+      }).toEqual({
+        hookCallCount: 1,
+        hookReceivedError: true,
+        causeIsOriginal: true,
+        callerReceivedOriginal: true,
+      });
+    }
+  });
+});