+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const providerRejectingWith = (rejection: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+const session = (): ChatSession => ({
+  sessionId: 'session',
+  userId: 'user',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+describe('non-Error provider rejections', () => {
+  it('calls onError with a caused Error and rethrows each original rejection unchanged', async () => {
+    const rejections: unknown[] = ['provider failed', {code: 'PROVIDER_FAILED'}, undefined];
+    const observations = [];
+
+    for (const rejection of rejections) {
+      let hookCalls = 0;
+      let hookError: Error | undefined;
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          hookCalls++;
+          hookError = error;
+        },
+      };
+      const orchestrator = createChatOrchestrator(
+        providerRejectingWith(rejection),
+        new PromptBuilder({identity: 'Acceptance test assistant.'}),
+        undefined,
+        {hooks}
+      );
+      const callerRejection = await orchestrator.processMessage(session()).then(
+        () => Symbol('resolved'),
+        error => error
+      );
+
+      observations.push({
+        hookCalls,
+        hookReceivedError: hookError instanceof Error,
+        hookCauseIsOriginal: hookError instanceof Error && hookError.cause === rejection,
+        callerReceivedOriginal: callerRejection === rejection,
+      });
+    }
+
+    expect(observations).toEqual(
+      rejections.map(() => ({
+        hookCalls: 1,
+        hookReceivedError: true,
+        hookCauseIsOriginal: true,
+        callerReceivedOriginal: true,
+      }))
+    );
+  });
+});