+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const session = (): ChatSession => ({
+  sessionId: 'non-error-rejection',
+  userId: 'acceptance-test',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const rejectingProvider = (rejection: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield -- a provider may reject before producing its first chunk
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(): Promise<T> {
+    throw rejection;
+  },
+});
+
+describe('ChatOrchestrator non-Error rejections', () => {
+  it('normalizes non-Error hook values while preserving every original rejection', async () => {
+    const exercise = async (rejection: unknown) => {
+      const received: Error[] = [];
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          received.push(error);
+        },
+      };
+      const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+      const callerRejection = await orchestrator.processMessage(session()).then(
+        () => Symbol('resolved'),
+        (error: unknown) => error
+      );
+
+      return {received, callerRejection};
+    };
+    const rawRejections: unknown[] = ['provider rejected', {code: 'PROVIDER_REJECTION'}, undefined];
+    const nonErrorResults = await Promise.all(rawRejections.map(exercise));
+    const originalError = new Error('provider failed');
+    const errorResult = await exercise(originalError);
+
+    expect({
+      nonErrorResults: nonErrorResults.map(({received, callerRejection}, index) => ({
+        hookCalls: received.length,
+        hookReceivedError: received[0] instanceof Error,
+        hookPreservedCause: received.length === 1 && Object.is(received[0].cause, rawRejections[index]),
+        callerReceivedOriginal: Object.is(callerRejection, rawRejections[index]),
+      })),
+      errorHookReceivedOriginal: Object.is(errorResult.received[0], originalError),
+      errorCallerReceivedOriginal: Object.is(errorResult.callerRejection, originalError),
+    }).toEqual({
+      nonErrorResults: rawRejections.map(() => ({
+        hookCalls: 1,
+        hookReceivedError: true,
+        hookPreservedCause: true,
+        callerReceivedOriginal: true,
+      })),
+      errorHookReceivedOriginal: true,
+      errorCallerReceivedOriginal: true,
+    });
+  });
+});