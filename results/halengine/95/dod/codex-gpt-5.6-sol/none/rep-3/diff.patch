+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const session = (): ChatSession => ({
+  sessionId: 'non-error-rejection',
+  userId: 'acceptance-test',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const rejectingProvider = (rejection: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+it('calls onError with wrapped non-Error rejections and rethrows each original value', async () => {
+  const rejections: unknown[] = ['provider failed', {code: 'PROVIDER_FAILED'}, undefined];
+  const observations: Array<{
+    hookCalls: number;
+    hookError?: Error;
+    callerRejected: boolean;
+    callerRejection?: unknown;
+  }> = [];
+
+  for (const rejection of rejections) {
+    const observation: {
+      hookCalls: number;
+      hookError?: Error;
+      callerRejected: boolean;
+      callerRejection?: unknown;
+    } = {hookCalls: 0, callerRejected: false};
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        observation.hookCalls += 1;
+        observation.hookError = error;
+      },
+    };
+    const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+
+    try {
+      await orchestrator.processMessage(session());
+    } catch (error) {
+      observation.callerRejected = true;
+      observation.callerRejection = error;
+    }
+    observations.push(observation);
+  }
+
+  observations.forEach((observation, index) => {
+    expect(observation.hookCalls).toBe(1);
+    expect(observation.hookError).toBeInstanceOf(Error);
+    expect(observation.hookError?.cause).toBe(rejections[index]);
+    expect(observation.callerRejected).toBe(true);
+    expect(observation.callerRejection).toBe(rejections[index]);
+  });
+});