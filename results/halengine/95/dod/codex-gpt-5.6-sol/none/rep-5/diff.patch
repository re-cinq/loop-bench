+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const session = (): ChatSession => ({
+  sessionId: 'non-error-rejection',
+  userId: 'acceptance-test',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const providerRejectingWith = (reason: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw reason;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+// specs/hal-engine-config-hooks/spec.md#9
+it('reports every non-Error rejection to onError without changing the caller rejection', async () => {
+  const reasons: unknown[] = ['provider failed', {code: 'PROVIDER_FAILED'}, undefined];
+  const observations: Array<{
+    hookCalls: number;
+    hookErrorIsError: boolean;
+    hookErrorCause: unknown;
+    callerReason: unknown;
+  }> = [];
+
+  for (const reason of reasons) {
+    const hookErrors: Error[] = [];
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        hookErrors.push(error);
+      },
+    };
+    const orchestrator = createChatOrchestrator(providerRejectingWith(reason), promptBuilder, undefined, {hooks});
+    const outcome = await orchestrator.processMessage(session()).then(
+      value => ({status: 'fulfilled' as const, value}),
+      rejectedReason => ({status: 'rejected' as const, reason: rejectedReason as unknown})
+    );
+
+    observations.push({
+      hookCalls: hookErrors.length,
+      hookErrorIsError: hookErrors[0] instanceof Error,
+      hookErrorCause: hookErrors[0]?.cause,
+      callerReason: outcome.status === 'rejected' ? outcome.reason : outcome.value,
+    });
+  }
+
+  expect(observations).toEqual(
+    reasons.map(reason => ({
+      hookCalls: 1,
+      hookErrorIsError: true,
+      hookErrorCause: reason,
+      callerReason: reason,
+    }))
+  );
+});