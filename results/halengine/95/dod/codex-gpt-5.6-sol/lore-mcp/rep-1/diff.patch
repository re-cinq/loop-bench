+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+
+const rejectionProvider = (rejection: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+const session = (): ChatSession => ({
+  sessionId: 'non-error-rejection',
+  userId: 'acceptance-test',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+describe('non-Error provider rejections', () => {
+  it('calls onError with a cause-preserving Error and rethrows the original rejection', async () => {
+    const plainObject = {reason: 'provider stopped'};
+    const existingError = new Error('provider failed');
+    const rejections: unknown[] = ['provider stopped', plainObject, undefined, existingError];
+    const observations: Array<{
+      rejection: unknown;
+      hookCalls: number;
+      hookReceivedError: boolean;
+      hookReceivedOriginalError: boolean;
+      cause: unknown;
+      callerReceivedOriginal: boolean;
+    }> = [];
+
+    for (const rejection of rejections) {
+      const hookErrors: Error[] = [];
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => void hookErrors.push(error),
+      };
+      const orchestrator = createChatOrchestrator(
+        rejectionProvider(rejection),
+        new PromptBuilder({identity: 'A test assistant.'}),
+        undefined,
+        {hooks}
+      );
+
+      let callerRejection: unknown;
+      try {
+        await orchestrator.processMessage(session());
+      } catch (error) {
+        callerRejection = error;
+      }
+
+      observations.push({
+        rejection,
+        hookCalls: hookErrors.length,
+        hookReceivedError: hookErrors[0] instanceof Error,
+        hookReceivedOriginalError: hookErrors[0] === rejection,
+        cause: hookErrors[0]?.cause,
+        callerReceivedOriginal: callerRejection === rejection,
+      });
+    }
+
+    expect(observations).toEqual([
+      {
+        rejection: 'provider stopped',
+        hookCalls: 1,
+        hookReceivedError: true,
+        hookReceivedOriginalError: false,
+        cause: 'provider stopped',
+        callerReceivedOriginal: true,
+      },
+      {
+        rejection: plainObject,
+        hookCalls: 1,
+        hookReceivedError: true,
+        hookReceivedOriginalError: false,
+        cause: plainObject,
+        callerReceivedOriginal: true,
+      },
+      {
+        rejection: undefined,
+        hookCalls: 1,
+        hookReceivedError: true,
+        hookReceivedOriginalError: false,
+        cause: undefined,
+        callerReceivedOriginal: true,
+      },
+      {
+        rejection: existingError,
+        hookCalls: 1,
+        hookReceivedError: true,
+        hookReceivedOriginalError: true,
+        cause: undefined,
+        callerReceivedOriginal: true,
+      },
+    ]);
+  });
+});