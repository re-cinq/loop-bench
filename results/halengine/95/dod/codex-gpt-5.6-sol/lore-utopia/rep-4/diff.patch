+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+
+const REJECTIONS: unknown[] = ['provider failed', {code: 'PROVIDER_FAILED'}, undefined];
+
+const rejectingProvider = (rejection: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(): Promise<T> {
+    throw rejection;
+  },
+});
+
+const session = (): ChatSession => ({
+  sessionId: 'acceptance-session',
+  userId: 'acceptance-user',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+it('reports every non-Error rejection through onError without changing the caller rejection', async () => {
+  const observations = [];
+
+  for (const rejection of REJECTIONS) {
+    const hookErrors: Error[] = [];
+    const orchestrator = createChatOrchestrator(
+      rejectingProvider(rejection),
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      undefined,
+      {hooks: {onError: async (_session, error) => void hookErrors.push(error)}}
+    );
+
+    let callerRejected = false;
+    let callerRejection: unknown;
+    try {
+      await orchestrator.processMessage(session());
+    } catch (error) {
+      callerRejected = true;
+      callerRejection = error;
+    }
+
+    observations.push({
+      hookCallCount: hookErrors.length,
+      hookReceivedError: hookErrors[0] instanceof Error,
+      hookErrorCauseIsOriginal: hookErrors.length === 1 && Object.is(hookErrors[0].cause, rejection),
+      callerRejected,
+      callerReceivedOriginal: Object.is(callerRejection, rejection),
+    });
+  }
+
+  expect(observations).toEqual(
+    REJECTIONS.map(() => ({
+      hookCallCount: 1,
+      hookReceivedError: true,
+      hookErrorCauseIsOriginal: true,
+      callerRejected: true,
+      callerReceivedOriginal: true,
+    }))
+  );
+});