+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, StructuredOutputParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const REJECTIONS: [string, unknown][] = [
+  ['a string', 'provider failed'],
+  ['a plain object', {code: 'PROVIDER_FAILED'}],
+  ['undefined', undefined],
+];
+
+class RejectingProvider implements AIProvider {
+  constructor(private readonly rejection: unknown) {}
+
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw this.rejection;
+  }
+
+  async generateStructured<T>(_params: StructuredOutputParams<T>): Promise<T> {
+    throw new Error('Structured output is not part of this provider scenario');
+  }
+}
+
+const session = (): ChatSession => ({
+  sessionId: 'non-error-rejection',
+  userId: 'acceptance-test',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+describe('provider rejections that are not Error instances', () => {
+  it.each(REJECTIONS)('reports %s to onError without changing the caller rejection', async (_label, rejection) => {
+    const hookErrors: Error[] = [];
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => void hookErrors.push(error),
+    };
+    const orchestrator = createChatOrchestrator(
+      new RejectingProvider(rejection),
+      new PromptBuilder({identity: 'Acceptance test assistant'}),
+      undefined,
+      {hooks}
+    );
+
+    const outcome = await orchestrator.processMessage(session()).then(
+      () => ({status: 'fulfilled' as const, reason: undefined}),
+      (reason: unknown) => ({status: 'rejected' as const, reason})
+    );
+    const hookError = hookErrors[0];
+
+    expect({
+      hookCallCount: hookErrors.length,
+      hookReceivedError: hookError instanceof Error,
+      hookCauseIsOriginal: hookError !== undefined && hookError.cause === rejection,
+      callerRejected: outcome.status === 'rejected',
+      callerReasonIsOriginal: outcome.reason === rejection,
+    }).toEqual({
+      hookCallCount: 1,
+      hookReceivedError: true,
+      hookCauseIsOriginal: true,
+      callerRejected: true,
+      callerReasonIsOriginal: true,
+    });
+  });
+});