+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+
+const REJECTIONS = ['provider failed', {code: 'PROVIDER_FAILED'}, undefined] as const;
+
+const rejectingProvider = (reason: unknown): AIProvider => ({
+  // The generator is the provider boundary exercised by the orchestrator.
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw reason;
+  },
+  async generateStructured<T>(): Promise<T> {
+    throw new Error('generateStructured is not used by chat orchestration');
+  },
+});
+
+describe('ChatOrchestrator non-Error rejections', () => {
+  it('calls onError once with a wrapping Error and rethrows each original provider rejection', async () => {
+    const observations = [];
+
+    for (const reason of REJECTIONS) {
+      const hookErrors: Error[] = [];
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          hookErrors.push(error);
+        },
+      };
+      const session: ChatSession = {
+        sessionId: 'acceptance-session',
+        userId: 'acceptance-user',
+        entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+      };
+      const orchestrator = createChatOrchestrator(
+        rejectingProvider(reason),
+        new PromptBuilder({identity: 'Acceptance test assistant'}),
+        undefined,
+        {hooks}
+      );
+      const rejection = await orchestrator.processMessage(session).then(
+        () => ({rejected: false, reason: undefined}),
+        (caught: unknown) => ({rejected: true, reason: caught})
+      );
+
+      observations.push({
+        hookCallCount: hookErrors.length,
+        hookReceivedError: hookErrors[0] instanceof Error,
+        hookErrorCause: hookErrors[0]?.cause,
+        rejected: rejection.rejected,
+        callerReceivedOriginal: rejection.reason === reason,
+      });
+    }
+
+    expect(observations).toEqual(
+      REJECTIONS.map(reason => ({
+        hookCallCount: 1,
+        hookReceivedError: true,
+        hookErrorCause: reason,
+        rejected: true,
+        callerReceivedOriginal: true,
+      }))
+    );
+  });
+});