+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+const session: ChatSession = {
+  sessionId: 'non-error-rejection',
+  userId: 'acceptance-test',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+const providerRejectingWith = (reason: unknown): AIProvider => ({
+  // A provider may reject with any JavaScript value, regardless of its TypeScript declaration.
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw reason;
+  },
+  async generateStructured<T>(): Promise<T> {
+    throw new Error('generateStructured is not used by processMessage');
+  },
+});
+
+describe('ChatOrchestrator non-Error rejections', () => {
+  it('calls onError with a cause-preserving Error and rethrows each original provider rejection', async () => {
+    // specs/hal-engine-config-hooks/spec.md#9
+    const reasons: unknown[] = ['provider failed', {code: 'PROVIDER_FAILED'}, undefined];
+    const observations: Array<{hookErrors: Error[]; callerReason?: unknown}> = [];
+
+    for (const reason of reasons) {
+      const observation: {hookErrors: Error[]; callerReason?: unknown} = {hookErrors: []};
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          observation.hookErrors.push(error);
+        },
+      };
+      const orchestrator = createChatOrchestrator(providerRejectingWith(reason), promptBuilder, undefined, {hooks});
+
+      try {
+        await orchestrator.processMessage({...session, entries: [...session.entries]});
+      } catch (error) {
+        observation.callerReason = error;
+      }
+
+      observations.push(observation);
+    }
+
+    expect(observations).toEqual(
+      reasons.map(reason => ({
+        hookErrors: [expect.objectContaining({cause: reason})],
+        callerReason: reason,
+      }))
+    );
+  });
+});