+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const session = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+function rejectingProvider(reason: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield -- this provider rejects before producing a chunk
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw reason;
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw reason;
+    },
+  };
+}
+
+describe('onError for non-Error provider rejections', () => {
+  // specs/hal-engine-config-hooks/spec.md#9
+  it('calls onError once with a caused Error and rethrows each original rejection', async () => {
+    for (const reason of ['provider failed', {code: 'PROVIDER_FAILED'}, undefined, new Error('provider failed')]) {
+      const receivedErrors: Error[] = [];
+      const orchestrator = createChatOrchestrator(
+        rejectingProvider(reason),
+        new PromptBuilder({identity: 'You are a test assistant.'}),
+        undefined,
+        {hooks: {onError: async (_session, error) => void receivedErrors.push(error)}}
+      );
+
+      const outcome = await orchestrator.processMessage(session()).then(
+        value => ({status: 'resolved' as const, value}),
+        rejection => ({status: 'rejected' as const, rejection: rejection as unknown})
+      );
+
+      expect(receivedErrors).toHaveLength(1);
+      expect(receivedErrors[0]).toBeInstanceOf(Error);
+      if (reason instanceof Error) expect(receivedErrors[0]).toBe(reason);
+      else expect(receivedErrors[0].cause).toBe(reason);
+      expect(outcome.status).toBe('rejected');
+      if (outcome.status === 'rejected') expect(outcome.rejection).toBe(reason);
+    }
+  });
+});