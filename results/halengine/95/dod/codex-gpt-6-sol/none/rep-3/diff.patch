+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// specs/hal-engine-config-hooks/spec.md#9
+test('reports every provider rejection to onError without changing the caller rejection', async () => {
+  const failures = [
+    {name: 'string', value: 'provider failed'},
+    {name: 'plain object', value: {code: 'PROVIDER_FAILED'}},
+    {name: 'undefined', value: undefined},
+    {name: 'Error', value: new Error('provider failed')},
+  ];
+  const results = [];
+
+  for (const failure of failures) {
+    const hookErrors: Error[] = [];
+    const provider: AIProvider = {
+      // eslint-disable-next-line require-yield
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        throw failure.value;
+      },
+      async generateStructured<T>(): Promise<T> {
+        throw failure.value;
+      },
+    };
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const orchestrator = createChatOrchestrator(
+      provider,
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      undefined,
+      {hooks: {onError: async (_session, error) => void hookErrors.push(error)}}
+    );
+
+    let rejected = false;
+    let callerRejection: unknown;
+    try {
+      await orchestrator.processMessage(session);
+    } catch (error) {
+      rejected = true;
+      callerRejection = error;
+    }
+
+    results.push({
+      name: failure.name,
+      hookCalls: hookErrors.length,
+      hookReceivedError: hookErrors[0] instanceof Error,
+      hookReceivedOriginal: hookErrors.length === 1 && hookErrors[0] === failure.value,
+      hookCauseIsOriginal: hookErrors.length === 1 && hookErrors[0].cause === failure.value,
+      callerReceivedOriginal: rejected && callerRejection === failure.value,
+    });
+  }
+
+  expect(results).toEqual([
+    {
+      name: 'string',
+      hookCalls: 1,
+      hookReceivedError: true,
+      hookReceivedOriginal: false,
+      hookCauseIsOriginal: true,
+      callerReceivedOriginal: true,
+    },
+    {
+      name: 'plain object',
+      hookCalls: 1,
+      hookReceivedError: true,
+      hookReceivedOriginal: false,
+      hookCauseIsOriginal: true,
+      callerReceivedOriginal: true,
+    },
+    {
+      name: 'undefined',
+      hookCalls: 1,
+      hookReceivedError: true,
+      hookReceivedOriginal: false,
+      hookCauseIsOriginal: true,
+      callerReceivedOriginal: true,
+    },
+    {
+      name: 'Error',
+      hookCalls: 1,
+      hookReceivedError: true,
+      hookReceivedOriginal: true,
+      hookCauseIsOriginal: false,
+      callerReceivedOriginal: true,
+    },
+  ]);
+});