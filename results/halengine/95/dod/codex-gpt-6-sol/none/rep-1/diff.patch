+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// specs/hal-engine-config-hooks/spec.md#9
+it('reports every provider rejection to onError without changing the caller rejection', async () => {
+  const rejections = [
+    {name: 'string', value: 'provider failed'},
+    {name: 'plain object', value: {code: 'PROVIDER_FAILED'}},
+    {name: 'undefined', value: undefined},
+    {name: 'Error', value: new Error('provider failed')},
+  ];
+
+  const observations = await Promise.all(
+    rejections.map(async ({name, value}) => {
+      const provider: AIProvider = {
+        async *sendMessage() {
+          yield* [];
+          throw value;
+        },
+        async generateStructured<T>(): Promise<T> {
+          throw value;
+        },
+      };
+      const session: ChatSession = {
+        sessionId: 'acceptance-session',
+        userId: 'acceptance-user',
+        entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+      };
+      const hookErrors: Error[] = [];
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          hookErrors.push(error);
+        },
+      };
+      const orchestrator = createChatOrchestrator(
+        provider,
+        new PromptBuilder({identity: 'Test assistant'}),
+        undefined,
+        {hooks}
+      );
+      const caller = await orchestrator.processMessage(session).then(
+        () => ({rejected: false, reason: undefined}),
+        (reason: unknown) => ({rejected: true, reason})
+      );
+
+      return {
+        name,
+        hookCalls: hookErrors.length,
+        hookReceivedError: hookErrors[0] instanceof Error,
+        hookPreservedValue: value instanceof Error ? hookErrors[0] === value : Object.is(hookErrors[0]?.cause, value),
+        callerReceivedOriginal: caller.rejected && Object.is(caller.reason, value),
+      };
+    })
+  );
+
+  expect(observations).toEqual(
+    rejections.map(({name}) => ({
+      name,
+      hookCalls: 1,
+      hookReceivedError: true,
+      hookPreservedValue: true,
+      callerReceivedOriginal: true,
+    }))
+  );
+});