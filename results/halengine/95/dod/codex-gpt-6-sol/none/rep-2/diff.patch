+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function session(): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+}
+
+describe('ChatOrchestrator provider rejection', () => {
+  it('reports every provider rejection and preserves the caller value', async () => {
+    const rejections: unknown[] = [
+      'provider failure',
+      {code: 'provider_failure'},
+      undefined,
+      new Error('provider failure'),
+    ];
+    const outcomes = [];
+
+    for (const rejection of rejections) {
+      const provider: AIProvider = {
+        ...createMockProvider(),
+        // eslint-disable-next-line require-yield -- This provider rejects before producing a chunk.
+        async *sendMessage(): AsyncGenerator<MessageChunk> {
+          throw rejection;
+        },
+      };
+      const hookErrors: Error[] = [];
+      const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {
+        hooks: {
+          onError: async (_session, error) => {
+            hookErrors.push(error);
+          },
+        },
+      });
+      const caller = await orchestrator.processMessage(session()).then(
+        value => ({rejected: false, value}),
+        value => ({rejected: true, value})
+      );
+
+      outcomes.push({
+        hookCalls: hookErrors.length,
+        hookReceivedError: hookErrors[0] instanceof Error,
+        causeIsOriginal: hookErrors.length === 1 && Object.is(hookErrors[0].cause, rejection),
+        hookReceivedOriginal: hookErrors.length === 1 && Object.is(hookErrors[0], rejection),
+        callerReceivedOriginal: caller.rejected && Object.is(caller.value, rejection),
+      });
+    }
+
+    expect(outcomes).toEqual(
+      rejections.map(rejection => ({
+        hookCalls: 1,
+        hookReceivedError: true,
+        causeIsOriginal: !(rejection instanceof Error),
+        hookReceivedOriginal: rejection instanceof Error,
+        callerReceivedOriginal: true,
+      }))
+    );
+  });
+});