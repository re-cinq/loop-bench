+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const session = (): ChatSession => ({
+  sessionId: 'rejected-provider',
+  userId: 'user',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+it('calls onError once for every provider rejection while preserving the caller value', async () => {
+  const cases: {name: string; reason: unknown}[] = [
+    {name: 'string', reason: 'provider rejected'},
+    {name: 'plain object', reason: {code: 'PROVIDER_FAILURE'}},
+    {name: 'undefined', reason: undefined},
+    {name: 'Error', reason: new Error('provider rejected')},
+  ];
+  const results = [];
+
+  for (const {name, reason} of cases) {
+    const errors: Error[] = [];
+    const provider: AIProvider = {
+      // eslint-disable-next-line require-yield -- this provider fails before emitting a chunk
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        throw reason;
+      },
+      async generateStructured<T>(): Promise<T> {
+        throw reason;
+      },
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Test assistant'}), undefined, {
+      hooks: {onError: async (_session, error) => void errors.push(error)},
+    });
+    const outcome = await orchestrator.processMessage(session()).then(
+      () => ({rejected: false, reason: undefined}),
+      rejectedReason => ({rejected: true, reason: rejectedReason})
+    );
+
+    results.push({
+      name,
+      rejected: outcome.rejected,
+      originalReason: Object.is(outcome.reason, reason),
+      onErrorCalls: errors.length,
+      hookReceivedError: errors[0] instanceof Error,
+      hookReceivedOriginal: reason instanceof Error && errors[0] === reason,
+      causeIsOriginal: !(reason instanceof Error) && errors[0] instanceof Error && Object.is(errors[0].cause, reason),
+    });
+  }
+
+  expect(results).toEqual([
+    {
+      name: 'string',
+      rejected: true,
+      originalReason: true,
+      onErrorCalls: 1,
+      hookReceivedError: true,
+      hookReceivedOriginal: false,
+      causeIsOriginal: true,
+    },
+    {
+      name: 'plain object',
+      rejected: true,
+      originalReason: true,
+      onErrorCalls: 1,
+      hookReceivedError: true,
+      hookReceivedOriginal: false,
+      causeIsOriginal: true,
+    },
+    {
+      name: 'undefined',
+      rejected: true,
+      originalReason: true,
+      onErrorCalls: 1,
+      hookReceivedError: true,
+      hookReceivedOriginal: false,
+      causeIsOriginal: true,
+    },
+    {
+      name: 'Error',
+      rejected: true,
+      originalReason: true,
+      onErrorCalls: 1,
+      hookReceivedError: true,
+      hookReceivedOriginal: true,
+      causeIsOriginal: false,
+    },
+  ]);
+});