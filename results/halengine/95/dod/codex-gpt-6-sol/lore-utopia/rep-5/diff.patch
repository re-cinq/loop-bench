+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+
+// specs/hal-engine-config-hooks/spec.md#9
+it('calls onError with a caused Error for every non-Error provider rejection and rethrows the original value', async () => {
+  const rejections: {name: string; value: unknown}[] = [
+    {name: 'string', value: 'provider failed'},
+    {name: 'plain object', value: {code: 'PROVIDER_FAILED'}},
+    {name: 'undefined', value: undefined},
+    {name: 'Error', value: new Error('provider failed')},
+  ];
+  const observations = [];
+
+  for (const rejection of rejections) {
+    const session: ChatSession = {
+      sessionId: rejection.name,
+      userId: 'user',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const provider: AIProvider = {
+      ...createMockProvider(),
+      // eslint-disable-next-line require-yield -- A provider can reject before its first chunk.
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        throw rejection.value;
+      },
+    };
+    const hookErrors: Error[] = [];
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Test assistant'}), undefined, {
+      hooks: {onError: async (_session, error) => void hookErrors.push(error)},
+    });
+    const outcome = await orchestrator.processMessage(session).then(
+      () => ({rejected: false, value: undefined as unknown}),
+      (value: unknown) => ({rejected: true, value})
+    );
+
+    observations.push({
+      name: rejection.name,
+      hookCalls: hookErrors.length,
+      hookReceivedError: hookErrors[0] instanceof Error,
+      hookPreservedValue:
+        hookErrors.length === 1 &&
+        (rejection.value instanceof Error
+          ? hookErrors[0] === rejection.value
+          : Object.is(hookErrors[0].cause, rejection.value)),
+      callerReceivedOriginal: outcome.rejected && Object.is(outcome.value, rejection.value),
+    });
+  }
+
+  expect(observations).toEqual(
+    rejections.map(({name}) => ({
+      name,
+      hookCalls: 1,
+      hookReceivedError: true,
+      hookPreservedValue: true,
+      callerReceivedOriginal: true,
+    }))
+  );
+});