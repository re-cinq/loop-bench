+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator onError', () => {
+  // specs/hal-engine-config-hooks/spec.md#9
+  it('reports every provider rejection to onError without changing the caller value', async () => {
+    const reasons: unknown[] = [
+      'provider rejected',
+      {code: 'provider_rejected'},
+      undefined,
+      new Error('already an Error'),
+    ];
+    const observations = [];
+
+    for (const reason of reasons) {
+      const provider: AIProvider = {
+        async *sendMessage(): AsyncGenerator<MessageChunk> {
+          yield {type: 'text', text: ''};
+          throw reason;
+        },
+        generateStructured<T>(): Promise<T> {
+          return Promise.reject(reason);
+        },
+      };
+      const receivedErrors: Error[] = [];
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          receivedErrors.push(error);
+        },
+      };
+      const session: ChatSession = {
+        sessionId: 's1',
+        userId: 'u1',
+        entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+      };
+      const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+      const outcome = await orchestrator.processMessage(session).then(
+        () => ({rejected: false, value: null}),
+        (value: unknown) => ({rejected: true, value})
+      );
+
+      observations.push({
+        hookCalls: receivedErrors.length,
+        hookReceivedError: receivedErrors[0] instanceof Error,
+        hookPreservesReason:
+          receivedErrors[0] instanceof Error &&
+          (reason instanceof Error ? receivedErrors[0] === reason : receivedErrors[0].cause === reason),
+        callerRejected: outcome.rejected,
+        callerReceivedOriginal: outcome.value === reason,
+      });
+    }
+
+    expect(observations).toEqual(
+      reasons.map(() => ({
+        hookCalls: 1,
+        hookReceivedError: true,
+        hookPreservesReason: true,
+        callerRejected: true,
+        callerReceivedOriginal: true,
+      }))
+    );
+  });
+});