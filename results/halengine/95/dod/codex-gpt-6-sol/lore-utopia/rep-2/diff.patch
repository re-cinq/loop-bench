+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+// specs/hal-engine-config-hooks/spec.md#9
+it('calls onError for non-Error provider rejections and preserves caller rejection', async () => {
+  const rejectedValues: unknown[] = ['provider failure', {code: 'PROVIDER_FAILURE'}, undefined];
+  const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+  const outcomes = [];
+
+  for (const rejectedValue of rejectedValues) {
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const provider: AIProvider = {
+      // eslint-disable-next-line require-yield -- a provider can reject before producing a chunk
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        throw rejectedValue;
+      },
+      async generateStructured<T>(): Promise<T> {
+        throw rejectedValue;
+      },
+    };
+    const hookErrors: Error[] = [];
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {
+      hooks: {
+        onError: async (_session, error) => {
+          hookErrors.push(error);
+        },
+      },
+    });
+
+    const caller = await orchestrator.processMessage(session).then(
+      () => ({rejected: false, reason: undefined}),
+      (reason: unknown) => ({rejected: true, reason})
+    );
+
+    outcomes.push({
+      hookCalls: hookErrors.length,
+      hookReceivedError: hookErrors[0] instanceof Error,
+      hasCause: hookErrors[0] !== undefined && Object.hasOwn(hookErrors[0], 'cause'),
+      causeIsOriginal: hookErrors[0] !== undefined && Object.is(hookErrors[0].cause, rejectedValue),
+      callerReceivedOriginal: caller.rejected && Object.is(caller.reason, rejectedValue),
+    });
+  }
+
+  expect(outcomes).toEqual(
+    rejectedValues.map(() => ({
+      hookCalls: 1,
+      hookReceivedError: true,
+      hasCause: true,
+      causeIsOriginal: true,
+      callerReceivedOriginal: true,
+    }))
+  );
+});