+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const session = (): ChatSession => ({
+  sessionId: 'rejection-test',
+  userId: 'user',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const rejectingProvider = (rejection: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield -- the provider rejects before yielding a chunk
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(): Promise<T> {
+    throw rejection;
+  },
+});
+
+describe('ChatOrchestrator rejection hook', () => {
+  // specs/hal-engine-config-hooks/spec.md#12
+  it('calls onError once for every provider rejection, preserving its cause and the caller rejection', async () => {
+    const cases = [
+      {name: 'string', rejection: 'provider failed'},
+      {name: 'plain object', rejection: {code: 'PROVIDER_FAILURE'}},
+      {name: 'undefined', rejection: undefined},
+      {name: 'Error', rejection: new Error('provider failed')},
+    ];
+
+    const results = await Promise.all(
+      cases.map(async ({name, rejection}) => {
+        const hookErrors: Error[] = [];
+        const hooks: OrchestratorHooks = {
+          onError: async (_session, error) => {
+            hookErrors.push(error);
+          },
+        };
+        const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+        const callerRejection = await orchestrator.processMessage(session()).then(
+          () => Symbol('resolved'),
+          (error: unknown) => error
+        );
+
+        return {
+          name,
+          hookCalls: hookErrors.length,
+          hookReceivedError: hookErrors[0] instanceof Error,
+          hookReceivedOriginalError: rejection instanceof Error ? hookErrors[0] === rejection : undefined,
+          causeIsOriginal:
+            rejection instanceof Error
+              ? undefined
+              : hookErrors.length === 1 && Object.is(hookErrors[0].cause, rejection),
+          callerReceivedOriginal: Object.is(callerRejection, rejection),
+        };
+      })
+    );
+
+    expect(results).toEqual(
+      cases.map(({name, rejection}) => ({
+        name,
+        hookCalls: 1,
+        hookReceivedError: true,
+        hookReceivedOriginalError: rejection instanceof Error ? true : undefined,
+        causeIsOriginal: rejection instanceof Error ? undefined : true,
+        callerReceivedOriginal: true,
+      }))
+    );
+  });
+});