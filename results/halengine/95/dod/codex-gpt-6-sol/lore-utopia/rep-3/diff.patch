+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+function rejectingProvider(value: unknown): AIProvider {
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield* [];
+      throw value;
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('generateStructured should not be called');
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('onError rejection contract', () => {
+  it('calls onError once with an Error caused by each non-Error rejection and rethrows the original value', async () => {
+    const values: {name: string; value: unknown}[] = [
+      {name: 'string', value: 'provider failed'},
+      {name: 'plain object', value: {code: 'PROVIDER_FAILED'}},
+      {name: 'undefined', value: undefined},
+      {name: 'Error', value: new Error('provider failed')},
+    ];
+    const observations = [];
+
+    for (const {name, value} of values) {
+      const session: ChatSession = {
+        sessionId: 's1',
+        userId: 'u1',
+        entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+      };
+      const hookErrors: Error[] = [];
+      const hooks: OrchestratorHooks = {onError: async (_session, error) => void hookErrors.push(error)};
+      const orchestrator = createChatOrchestrator(rejectingProvider(value), promptBuilder, undefined, {hooks});
+      let rejected = false;
+      let callerValue: unknown;
+
+      try {
+        await orchestrator.processMessage(session);
+      } catch (error) {
+        rejected = true;
+        callerValue = error;
+      }
+
+      const hookError = hookErrors[0];
+      observations.push({
+        name,
+        rejected,
+        callerReceivedOriginal: Object.is(callerValue, value),
+        hookCalls: hookErrors.length,
+        hookReceivedError: hookError instanceof Error,
+        hookPreservedOriginal: value instanceof Error ? hookError === value : Object.is(hookError?.cause, value),
+      });
+    }
+
+    expect(observations).toEqual(
+      values.map(({name}) => ({
+        name,
+        rejected: true,
+        callerReceivedOriginal: true,
+        hookCalls: 1,
+        hookReceivedError: true,
+        hookPreservedOriginal: true,
+      }))
+    );
+  });
+});