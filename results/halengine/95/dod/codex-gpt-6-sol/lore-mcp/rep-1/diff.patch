+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+
+const promptBuilder = new PromptBuilder({identity: 'Acceptance test assistant.'});
+
+// specs/hal-engine-config-hooks/spec.md#9
+it('calls onError once with the original cause and preserves each non-Error provider rejection', async () => {
+  const failures: unknown[] = ['provider rejected', {code: 'PROVIDER_FAILURE'}, undefined, new Error('provider error')];
+  const results = [];
+
+  for (const rejection of failures) {
+    const provider: AIProvider = {
+      ...createMockProvider(),
+      // eslint-disable-next-line require-yield -- rejection occurs while consuming the provider stream
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        throw rejection;
+      },
+    };
+    const session: ChatSession = {
+      sessionId: 'acceptance-session',
+      userId: 'acceptance-user',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const observedErrors: Error[] = [];
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {
+      hooks: {onError: async (_session, error) => void observedErrors.push(error)},
+    });
+    const caller = await orchestrator.processMessage(session).then(
+      value => ({rejected: false, value}),
+      value => ({rejected: true, value})
+    );
+
+    results.push({
+      hookCalls: observedErrors.length,
+      hookReceivedError: observedErrors[0] instanceof Error,
+      causeIsOriginal: rejection instanceof Error ? true : observedErrors[0]?.cause === rejection,
+      existingErrorIsOriginal: rejection instanceof Error ? observedErrors[0] === rejection : true,
+      callerRejected: caller.rejected,
+      callerReceivedOriginal: caller.value === rejection,
+    });
+  }
+
+  expect(results).toEqual(
+    failures.map(() => ({
+      hookCalls: 1,
+      hookReceivedError: true,
+      causeIsOriginal: true,
+      existingErrorIsOriginal: true,
+      callerRejected: true,
+      callerReceivedOriginal: true,
+    }))
+  );
+});