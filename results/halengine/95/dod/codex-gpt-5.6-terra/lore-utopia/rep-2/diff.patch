+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const session = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const rejectingProvider = (rejection: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+it('reports every rejection to onError without changing what the caller receives', async () => {
+  const thrownError = new Error('provider error');
+  const rejections: unknown[] = ['provider rejected a string', {code: 'UPSTREAM_DOWN'}, undefined, thrownError];
+
+  for (const rejection of rejections) {
+    const observedByHook: Error[] = [];
+    const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {
+      hooks: {
+        onError: async (_session, error) => void observedByHook.push(error),
+      },
+    });
+
+    let observedByCaller: unknown = Symbol('unrejected');
+    try {
+      await orchestrator.processMessage(session());
+    } catch (error) {
+      observedByCaller = error;
+    }
+
+    expect(observedByHook).toHaveLength(1);
+    expect(observedByHook[0]).toBeInstanceOf(Error);
+    expect(observedByCaller).toBe(rejection);
+
+    if (rejection instanceof Error) {
+      expect(observedByHook[0]).toBe(rejection);
+    } else {
+      expect(observedByHook[0].cause).toBe(rejection);
+    }
+  }
+});