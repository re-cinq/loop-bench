+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const session = (): ChatSession => ({
+  sessionId: 'rejected-value',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const providerRejectingWith = (rejection: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+const rejectionOutcome = async (call: Promise<unknown>): Promise<{rejected: boolean; reason: unknown}> =>
+  call.then(
+    () => ({rejected: false, reason: undefined}),
+    reason => ({rejected: true, reason})
+  );
+
+describe('non-Error provider rejections', () => {
+  it('calls onError once with an Error retaining each rejection as its cause and rethrows the original value', async () => {
+    const objectRejection = {kind: 'provider_failure'};
+    const cases = [
+      {label: 'string', rejection: 'provider failed'},
+      {label: 'plain object', rejection: objectRejection},
+      {label: 'undefined', rejection: undefined},
+    ];
+    const results = [];
+
+    for (const testCase of cases) {
+      const received: Error[] = [];
+      const orchestrator = createChatOrchestrator(providerRejectingWith(testCase.rejection), promptBuilder, undefined, {
+        hooks: {onError: async (_session, error) => void received.push(error)},
+      });
+      const caller = await rejectionOutcome(orchestrator.processMessage(session()));
+      const hookError = received[0];
+
+      results.push({
+        label: testCase.label,
+        hookCalls: received.length,
+        hookReceivedError: hookError instanceof Error,
+        hookCauseIsOriginal: hookError?.cause === testCase.rejection,
+        callerReceivedOriginal: caller.rejected && caller.reason === testCase.rejection,
+      });
+    }
+
+    expect(results).toEqual([
+      {
+        label: 'string',
+        hookCalls: 1,
+        hookReceivedError: true,
+        hookCauseIsOriginal: true,
+        callerReceivedOriginal: true,
+      },
+      {
+        label: 'plain object',
+        hookCalls: 1,
+        hookReceivedError: true,
+        hookCauseIsOriginal: true,
+        callerReceivedOriginal: true,
+      },
+      {
+        label: 'undefined',
+        hookCalls: 1,
+        hookReceivedError: true,
+        hookCauseIsOriginal: true,
+        callerReceivedOriginal: true,
+      },
+    ]);
+  });
+});