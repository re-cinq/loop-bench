+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams, StructuredOutputParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const createSession = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const providerRejecting = (rejection: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(_params: StructuredOutputParams<T>): Promise<T> {
+    return {} as T;
+  },
+});
+
+describe('ChatOrchestrator non-Error rejection handling', () => {
+  it('calls onError once with an Error caused by a non-Error rejection while preserving the caller rejection', async () => {
+    const errorRejection = new Error('provider error');
+    const rejections = ['provider rejected', {code: 'UNAVAILABLE'}, undefined, errorRejection];
+    const observed: {callerRejection: unknown; received: Error[]}[] = [];
+
+    for (const rejection of rejections) {
+      const received: Error[] = [];
+      const orchestrator = createChatOrchestrator(providerRejecting(rejection), promptBuilder, undefined, {
+        hooks: {
+          onError: async (_session, error) => {
+            received.push(error);
+          },
+        },
+      });
+
+      const callerRejection = await orchestrator.processMessage(createSession()).catch(error => error);
+
+      observed.push({
+        callerRejection: rejection,
+        received,
+      });
+    }
+
+    expect(observed).toEqual(
+      rejections.map(rejection => ({
+        callerRejection: rejection,
+        received: [rejection instanceof Error ? rejection : expect.objectContaining({cause: rejection})],
+      }))
+    );
+    expect(observed.flatMap(({received}) => received).every(error => error instanceof Error)).toBe(true);
+    expect(observed[3].received[0]).toBe(errorRejection);
+  });
+});