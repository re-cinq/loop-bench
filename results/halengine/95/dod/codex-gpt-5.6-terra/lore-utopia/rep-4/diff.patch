@@ -0,0 +1,80 @@
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const createSession = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const rejectingProvider = (rejection: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+const rejectionOf = async (call: Promise<unknown>): Promise<unknown> => {
+  try {
+    await call;
+    return 'resolved without rejecting';
+  } catch (rejection) {
+    return rejection;
+  }
+};
+
+describe('non-Error provider rejections', () => {
+  it('calls onError once with an Error caused by each rejection while the caller receives the original value', async () => {
+    const cases: {label: string; rejection: unknown}[] = [
+      {label: 'string', rejection: 'provider failed'},
+      {label: 'plain object', rejection: {code: 'PROVIDER_FAILURE'}},
+      {label: 'undefined', rejection: undefined},
+    ];
+    const outcomes = [];
+
+    for (const {label, rejection} of cases) {
+      const received: Error[] = [];
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          received.push(error);
+        },
+      };
+      const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+      const callerRejection = await rejectionOf(orchestrator.processMessage(createSession()));
+
+      outcomes.push({
+        label,
+        onErrorCalls: received.length,
+        hookReceivedError: received[0] instanceof Error,
+        causeIsOriginal: Object.hasOwn(received[0] ?? {}, 'cause') && received[0]?.cause === rejection,
+        callerReceivedOriginal: callerRejection === rejection,
+      });
+    }
+
+    expect(outcomes).toEqual([
+      {label: 'string', onErrorCalls: 1, hookReceivedError: true, causeIsOriginal: true, callerReceivedOriginal: true},
+      {
+        label: 'plain object',
+        onErrorCalls: 1,
+        hookReceivedError: true,
+        causeIsOriginal: true,
+        callerReceivedOriginal: true,
+      },
+      {
+        label: 'undefined',
+        onErrorCalls: 1,
+        hookReceivedError: true,
+        causeIsOriginal: true,
+        callerReceivedOriginal: true,
+      },
+    ]);
+  });
+});