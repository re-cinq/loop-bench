+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const session = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const providerRejecting = (value: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw value;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+const rejectionOf = (call: Promise<unknown>): Promise<unknown> => call.then(() => 'resolved').catch(error => error);
+
+describe('non-Error rejection acceptance', () => {
+  it('calls onError once with an Error caused by each non-Error rejection and rethrows the original value', async () => {
+    const object = {code: 'REJECTED'};
+    const cases = [
+      {label: 'string', value: 'provider failed'},
+      {label: 'plain object', value: object},
+      {label: 'undefined', value: undefined},
+    ];
+    const outcomes = [];
+
+    for (const {label, value} of cases) {
+      const received: Error[] = [];
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => void received.push(error),
+      };
+      const orchestrator = createChatOrchestrator(providerRejecting(value), promptBuilder, undefined, {hooks});
+      const rejection = await rejectionOf(orchestrator.processMessage(session()));
+
+      outcomes.push({
+        label,
+        onErrorCallCount: received.length,
+        receivedError: received[0] instanceof Error,
+        originalIsCause: received[0]?.cause === value,
+        callerReceivedOriginal: rejection === value,
+      });
+    }
+
+    expect(outcomes).toEqual([
+      {label: 'string', onErrorCallCount: 1, receivedError: true, originalIsCause: true, callerReceivedOriginal: true},
+      {
+        label: 'plain object',
+        onErrorCallCount: 1,
+        receivedError: true,
+        originalIsCause: true,
+        callerReceivedOriginal: true,
+      },
+      {
+        label: 'undefined',
+        onErrorCallCount: 1,
+        receivedError: true,
+        originalIsCause: true,
+        callerReceivedOriginal: true,
+      },
+    ]);
+  });
+});