+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+
+const session: ChatSession = {
+  sessionId: 'session-1',
+  userId: 'user-1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+const rejectingProvider = (reason: unknown): AIProvider => ({
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw reason;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return Promise.reject(reason);
+  },
+});
+
+describe('non-Error provider rejections', () => {
+  it('calls onError once with an Error that preserves each original rejection as its cause', async () => {
+    const reasons: unknown[] = ['provider rejected', {provider: 'unavailable'}, undefined];
+
+    for (const reason of reasons) {
+      let calls = 0;
+      let hookError: Error | undefined;
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          calls++;
+          hookError = error;
+        },
+      };
+      const orchestrator = createChatOrchestrator(
+        rejectingProvider(reason),
+        new PromptBuilder({identity: 'You are a test assistant.'}),
+        undefined,
+        {hooks}
+      );
+      let propagated = false;
+      let callerRejection: unknown;
+
+      try {
+        await orchestrator.processMessage(session);
+      } catch (error) {
+        propagated = true;
+        callerRejection = error;
+      }
+
+      expect(propagated).toBe(true);
+      expect(callerRejection).toBe(reason);
+      expect(calls).toBe(1);
+      expect(hookError).toBeInstanceOf(Error);
+      expect(hookError?.cause).toBe(reason);
+    }
+  });
+});