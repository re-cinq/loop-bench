+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SESSION: ChatSession = {
+  sessionId: 'acceptance-session',
+  userId: 'acceptance-user',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const rejectingProvider = (rejection: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+describe('ChatOrchestrator non-Error rejection handling', () => {
+  it('reports string, object, and undefined rejections to onError without changing the caller value or existing Errors', async () => {
+    const existingError = new Error('already an Error');
+    const rejections: unknown[] = ['provider failed', {provider: 'unavailable'}, undefined, existingError];
+    const observations: Array<{
+      callerIsOriginal: boolean;
+      hookCalls: number;
+      hookIsError: boolean;
+      hookCauseIsOriginal: boolean;
+      hookIsOriginalError: boolean;
+    }> = [];
+
+    for (const rejection of rejections) {
+      const received: Error[] = [];
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => void received.push(error),
+      };
+      const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+      const callerValue = await orchestrator
+        .processMessage({...SESSION, entries: [...SESSION.entries]})
+        .catch(error => error);
+      const hookError = received[0];
+
+      observations.push({
+        callerIsOriginal: callerValue === rejection,
+        hookCalls: received.length,
+        hookIsError: hookError instanceof Error,
+        hookCauseIsOriginal: hookError?.cause === rejection,
+        hookIsOriginalError: hookError === rejection,
+      });
+    }
+
+    expect(observations).toEqual([
+      {callerIsOriginal: true, hookCalls: 1, hookIsError: true, hookCauseIsOriginal: true, hookIsOriginalError: false},
+      {callerIsOriginal: true, hookCalls: 1, hookIsError: true, hookCauseIsOriginal: true, hookIsOriginalError: false},
+      {callerIsOriginal: true, hookCalls: 1, hookIsError: true, hookCauseIsOriginal: true, hookIsOriginalError: false},
+      {callerIsOriginal: true, hookCalls: 1, hookIsError: true, hookCauseIsOriginal: false, hookIsOriginalError: true},
+    ]);
+  });
+});