+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const session = (): ChatSession => ({
+  sessionId: 'acceptance-session',
+  userId: 'acceptance-user',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const rejectingProvider = (rejection: unknown): AIProvider => ({
+  // The provider has no chunks to yield: its rejection is the observed boundary.
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+describe('non-Error provider rejections', () => {
+  it('calls onError with an Error retaining each rejection as cause and rethrows the original value', async () => {
+    const rejections: unknown[] = ['provider string failure', {code: 'PROVIDER_FAILURE'}, undefined];
+
+    for (const rejection of rejections) {
+      let hookCalls = 0;
+      let hookError: Error | undefined;
+      const orchestrator = createChatOrchestrator(
+        rejectingProvider(rejection),
+        new PromptBuilder({identity: 'You are an acceptance-test assistant.'}),
+        undefined,
+        {
+          hooks: {
+            onError: async (_session, error) => {
+              hookCalls++;
+              hookError = error;
+            },
+          },
+        }
+      );
+
+      let callerRejection: unknown = Symbol('processMessage resolved');
+      try {
+        await orchestrator.processMessage(session());
+      } catch (error) {
+        callerRejection = error;
+      }
+
+      expect({
+        hookCalls,
+        hookIsError: hookError instanceof Error,
+        hookCause: hookError?.cause,
+        callerRejection,
+      }).toEqual({
+        hookCalls: 1,
+        hookIsError: true,
+        hookCause: rejection,
+        callerRejection: rejection,
+      });
+    }
+  });
+});