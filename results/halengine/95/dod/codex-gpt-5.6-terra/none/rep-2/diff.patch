+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+
+const SENT_AT = '2026-10-31T00:00:00.000Z';
+const promptBuilder = new PromptBuilder({identity: 'Acceptance-test assistant.'});
+
+function session(): ChatSession {
+  return {
+    sessionId: 'acceptance-session',
+    userId: 'acceptance-user',
+    entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+  };
+}
+
+function rejectingProvider(rejection: unknown): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+async function rejectedValue(call: Promise<unknown>): Promise<{rejected: boolean; value: unknown}> {
+  try {
+    await call;
+    return {rejected: false, value: undefined};
+  } catch (value) {
+    return {rejected: true, value};
+  }
+}
+
+describe('non-Error rejections', () => {
+  it.each([
+    ['a string', 'provider unavailable'],
+    ['a plain object', {code: 'UPSTREAM_FAILURE'}],
+    ['undefined', undefined],
+  ])('calls onError once for %s while preserving the caller rejection', async (_kind, rejection) => {
+    let received: Error | undefined;
+    let onErrorCalls = 0;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        onErrorCalls++;
+        received = error;
+      },
+    };
+    const orchestrator = createChatOrchestrator(rejectingProvider(rejection), promptBuilder, undefined, {hooks});
+
+    const outcome = await rejectedValue(orchestrator.processMessage(session()));
+
+    expect({onErrorCalls, outcome}).toEqual({onErrorCalls: 1, outcome: {rejected: true, value: rejection}});
+    expect(received).toBeInstanceOf(Error);
+    expect(received?.cause).toBe(rejection);
+  });
+});