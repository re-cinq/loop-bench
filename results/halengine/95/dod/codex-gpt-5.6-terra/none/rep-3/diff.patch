+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const session = (): ChatSession => ({
+  sessionId: 'error-session',
+  userId: 'error-user',
+  entries: [{role: 'user', content: 'trigger the provider', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const rejectingProvider = (rejection: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+describe('ChatOrchestrator onError rejection normalization', () => {
+  it('calls onError once for every rejection, preserving its cause and the caller rejection', async () => {
+    const objectRejection = {provider: 'upstream', code: 'UNAVAILABLE'};
+    const errorRejection = new Error('already normalized');
+    const cases = [
+      {name: 'string', rejection: 'upstream unavailable'},
+      {name: 'object', rejection: objectRejection},
+      {name: 'undefined', rejection: undefined},
+      {name: 'Error', rejection: errorRejection},
+    ];
+    const observations = [];
+
+    for (const {name, rejection} of cases) {
+      const received: Error[] = [];
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          received.push(error);
+        },
+      };
+      const orchestrator = createChatOrchestrator(
+        rejectingProvider(rejection),
+        new PromptBuilder({identity: 'You are a test assistant.'}),
+        undefined,
+        {hooks}
+      );
+      let callerRejection: unknown;
+
+      try {
+        await orchestrator.processMessage(session());
+      } catch (error) {
+        callerRejection = error;
+      }
+
+      observations.push({
+        name,
+        callerReceivedOriginal: callerRejection === rejection,
+        hookCalls: received.length,
+        hookReceivedOriginal: received[0] === rejection,
+        hookReceivedError: received[0] instanceof Error,
+        hookCause: received[0]?.cause,
+      });
+    }
+
+    expect(observations).toEqual([
+      {
+        name: 'string',
+        callerReceivedOriginal: true,
+        hookCalls: 1,
+        hookReceivedOriginal: false,
+        hookReceivedError: true,
+        hookCause: 'upstream unavailable',
+      },
+      {
+        name: 'object',
+        callerReceivedOriginal: true,
+        hookCalls: 1,
+        hookReceivedOriginal: false,
+        hookReceivedError: true,
+        hookCause: objectRejection,
+      },
+      {
+        name: 'undefined',
+        callerReceivedOriginal: true,
+        hookCalls: 1,
+        hookReceivedOriginal: false,
+        hookReceivedError: true,
+        hookCause: undefined,
+      },
+      {
+        name: 'Error',
+        callerReceivedOriginal: true,
+        hookCalls: 1,
+        hookReceivedOriginal: true,
+        hookReceivedError: true,
+        hookCause: undefined,
+      },
+    ]);
+  });
+});