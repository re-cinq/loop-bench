+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const createSession = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+});
+
+const providerRejecting = (rejection: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+describe('non-Error rejection handling', () => {
+  it('calls onError with an Error preserving each non-Error cause while rethrowing the original rejection', async () => {
+    const rejections: unknown[] = ['provider rejected', {code: 'PROVIDER_DOWN'}, undefined];
+    const outcomes = await Promise.all(
+      rejections.map(async rejection => {
+        const hookErrors: Error[] = [];
+        const orchestrator = createChatOrchestrator(providerRejecting(rejection), promptBuilder, undefined, {
+          hooks: {
+            onError: async (_session, error) => void hookErrors.push(error),
+          },
+        });
+        const callerRejection = await orchestrator.processMessage(createSession()).then(
+          () => 'resolved unexpectedly',
+          error => error
+        );
+
+        return {
+          callerRejection,
+          hookCalls: hookErrors.length,
+          hookErrorIsError: hookErrors[0] instanceof Error,
+          hookCause: hookErrors[0]?.cause,
+        };
+      })
+    );
+
+    expect(outcomes).toEqual(
+      rejections.map(rejection => ({
+        callerRejection: rejection,
+        hookCalls: 1,
+        hookErrorIsError: true,
+        hookCause: rejection,
+      }))
+    );
+  });
+});