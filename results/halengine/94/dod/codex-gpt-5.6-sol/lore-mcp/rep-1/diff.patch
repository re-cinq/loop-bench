+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/index.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+
+const session: ChatSession = {
+  sessionId: 'session-before-hook-failure',
+  userId: 'user-1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+describe('beforeSession failure lifecycle', () => {
+  it('rejects unchanged after onError and afterSession receive the failed session', async () => {
+    const failure = new Error('beforeSession failed');
+    const calls: Array<{hook: string; session: ChatSession; error?: Error}> = [];
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw failure;
+      },
+      onError: async (receivedSession, error) => {
+        calls.push({hook: 'onError', session: receivedSession, error});
+      },
+      afterSession: async receivedSession => {
+        calls.push({hook: 'afterSession', session: receivedSession});
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      createMockProvider(),
+      new PromptBuilder({identity: 'Acceptance test assistant'}),
+      undefined,
+      {hooks}
+    );
+
+    const rejection = await orchestrator.processMessage(session).catch(error => error);
+
+    expect({rejection, calls}).toEqual({
+      rejection: failure,
+      calls: [
+        {hook: 'onError', session, error: failure},
+        {hook: 'afterSession', session},
+      ],
+    });
+  });
+});