+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+
+// specs/hal-engine-config-hooks/spec.md#7
+it('reports and cleans up a beforeSession failure before rejecting with the same error', async () => {
+  const session: ChatSession = {
+    sessionId: 'session-1',
+    userId: 'user-1',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const failure = new Error('beforeSession failed');
+  const calls: Array<{hook: string; session: ChatSession; error?: Error}> = [];
+  const hooks: OrchestratorHooks = {
+    beforeSession: async receivedSession => {
+      calls.push({hook: 'beforeSession', session: receivedSession});
+      throw failure;
+    },
+    onError: async (receivedSession, error) => {
+      calls.push({hook: 'onError', session: receivedSession, error});
+    },
+    afterSession: async receivedSession => {
+      calls.push({hook: 'afterSession', session: receivedSession});
+    },
+  };
+  const orchestrator = createChatOrchestrator(
+    createMockProvider(),
+    new PromptBuilder({identity: 'Test assistant'}),
+    undefined,
+    {hooks}
+  );
+
+  const rejection = await orchestrator.processMessage(session).then(
+    () => undefined,
+    (error: Error) => error
+  );
+
+  expect({rejection, calls}).toEqual({
+    rejection: failure,
+    calls: [
+      {hook: 'beforeSession', session},
+      {hook: 'onError', session, error: failure},
+      {hook: 'afterSession', session},
+    ],
+  });
+});