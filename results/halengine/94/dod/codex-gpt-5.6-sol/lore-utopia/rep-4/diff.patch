+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/index.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+
+const session: ChatSession = {
+  sessionId: 'before-session-failure',
+  userId: 'acceptance-user',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+it('reports and cleans up a partially started session before rejecting with the beforeSession error', async () => {
+  const failure = new Error('beforeSession failed');
+  const events: string[] = [];
+  let onErrorArguments: unknown[] = [];
+  let rejectedWith: unknown;
+  const hooks: OrchestratorHooks = {
+    beforeSession: async receivedSession => {
+      events.push(`started:${receivedSession.sessionId}`);
+      throw failure;
+    },
+    onError: async (...arguments_) => {
+      onErrorArguments = arguments_;
+      events.push('onError');
+    },
+    afterSession: async receivedSession => {
+      events.push(`afterSession:${receivedSession.sessionId}`);
+    },
+  };
+  const orchestrator = createChatOrchestrator(
+    createMockProvider(),
+    new PromptBuilder({identity: 'Acceptance test assistant'}),
+    undefined,
+    {hooks}
+  );
+
+  try {
+    await orchestrator.processMessage(session);
+  } catch (error) {
+    rejectedWith = error;
+  }
+
+  expect({events, onErrorArguments, rejectedWith}).toEqual({
+    events: ['started:before-session-failure', 'onError', 'afterSession:before-session-failure'],
+    onErrorArguments: [session, failure],
+    rejectedWith: failure,
+  });
+});