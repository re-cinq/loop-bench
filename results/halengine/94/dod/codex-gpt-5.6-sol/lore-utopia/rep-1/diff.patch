+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+
+const session: ChatSession = {
+  sessionId: 'before-session-failure',
+  userId: 'acceptance-test',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+it('reports and cleans up a beforeSession failure before rejecting with the same error', async () => {
+  const failure = new Error('beforeSession failed');
+  const events: Array<{hook: string; session: ChatSession; error?: Error}> = [];
+  const hooks: OrchestratorHooks = {
+    beforeSession: async () => {
+      throw failure;
+    },
+    onError: async (receivedSession, error) => {
+      events.push({hook: 'onError', session: receivedSession, error});
+    },
+    afterSession: async receivedSession => {
+      events.push({hook: 'afterSession', session: receivedSession});
+    },
+  };
+  const orchestrator = createChatOrchestrator(
+    createMockProvider(),
+    new PromptBuilder({identity: 'Acceptance test assistant'}),
+    undefined,
+    {hooks}
+  );
+
+  const rejection = await orchestrator.processMessage(session).catch((error: Error) => error);
+
+  expect({rejection, events}).toEqual({
+    rejection: failure,
+    events: [
+      {hook: 'onError', session, error: failure},
+      {hook: 'afterSession', session},
+    ],
+  });
+});