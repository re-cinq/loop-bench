@@ -0,0 +1,51 @@
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const session: ChatSession = {
+  sessionId: 'failed-before-session',
+  userId: 'user-1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+it('reports and cleans up a beforeSession failure before rejecting with it', async () => {
+  const failure = new Error('beforeSession failed');
+  const calls: Array<{hook: string; session: ChatSession; error?: Error}> = [];
+  const orchestrator = createChatOrchestrator(createMockProvider(), promptBuilder, undefined, {
+    hooks: {
+      beforeSession: async receivedSession => {
+        calls.push({hook: 'beforeSession', session: receivedSession});
+        throw failure;
+      },
+      beforeUserInput: async (receivedSession, message) => {
+        calls.push({hook: 'beforeUserInput', session: receivedSession});
+        return message;
+      },
+      onError: async (receivedSession, error) => {
+        calls.push({hook: 'onError', session: receivedSession, error});
+      },
+      afterSession: async receivedSession => {
+        calls.push({hook: 'afterSession', session: receivedSession});
+      },
+    },
+  });
+
+  let rejection: unknown;
+  try {
+    await orchestrator.processMessage(session);
+  } catch (error) {
+    rejection = error;
+  }
+
+  expect({rejection, calls}).toEqual({
+    rejection: failure,
+    calls: [
+      {hook: 'beforeSession', session},
+      {hook: 'onError', session, error: failure},
+      {hook: 'afterSession', session},
+    ],
+  });
+});