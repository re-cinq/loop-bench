+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+
+const session: ChatSession = {
+  sessionId: 'before-session-failure',
+  userId: 'user-1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+it('reports and cleans up a beforeSession failure before rejecting with the original error', async () => {
+  const failure = new Error('beforeSession failed');
+  const calls: Array<{hook: string; session: ChatSession; error?: Error}> = [];
+  const orchestrator = createChatOrchestrator(
+    createMockProvider(),
+    new PromptBuilder({identity: 'Test assistant'}),
+    undefined,
+    {
+      hooks: {
+        beforeSession: async () => {
+          throw failure;
+        },
+        onError: async (receivedSession, error) => {
+          calls.push({hook: 'onError', session: receivedSession, error});
+        },
+        afterSession: async receivedSession => {
+          calls.push({hook: 'afterSession', session: receivedSession});
+        },
+      },
+    }
+  );
+
+  const rejection = await orchestrator.processMessage(session).catch((error: unknown) => error);
+
+  expect({rejection, calls}).toEqual({
+    rejection: failure,
+    calls: [
+      {hook: 'onError', session, error: failure},
+      {hook: 'afterSession', session},
+    ],
+  });
+});