+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+
+const session: ChatSession = {
+  sessionId: 'before-session-failure',
+  userId: 'acceptance-test',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+it('reports and cleans up a beforeSession failure before rejecting it unchanged', async () => {
+  const failure = new Error('beforeSession failed');
+  const lifecycle: Array<{hook: string; session: ChatSession; error?: Error}> = [];
+  const orchestrator = createChatOrchestrator(
+    createMockProvider(),
+    new PromptBuilder({identity: 'Acceptance test assistant'}),
+    undefined,
+    {
+      hooks: {
+        beforeSession: async () => {
+          throw failure;
+        },
+        onError: async (hookSession, error) => {
+          lifecycle.push({hook: 'onError', session: hookSession, error});
+        },
+        afterSession: async hookSession => {
+          lifecycle.push({hook: 'afterSession', session: hookSession});
+        },
+      },
+    }
+  );
+
+  const rejection = await orchestrator.processMessage(session).catch(error => error as unknown);
+
+  expect({rejection, lifecycle}).toEqual({
+    rejection: failure,
+    lifecycle: [
+      {hook: 'onError', session, error: failure},
+      {hook: 'afterSession', session},
+    ],
+  });
+});