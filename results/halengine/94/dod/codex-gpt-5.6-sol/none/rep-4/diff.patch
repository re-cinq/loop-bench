+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+
+const session: ChatSession = {
+  sessionId: 'before-session-failure',
+  userId: 'acceptance-test',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+it('rejects unchanged and runs error and cleanup hooks when beforeSession throws', async () => {
+  const failure = new Error('beforeSession failed');
+  const calls: Array<{hook: string; sameSession: boolean; sameError?: boolean}> = [];
+  const orchestrator = createChatOrchestrator(
+    createMockProvider(),
+    new PromptBuilder({identity: 'Acceptance test assistant'}),
+    undefined,
+    {
+      hooks: {
+        beforeSession: async () => {
+          throw failure;
+        },
+        onError: async (receivedSession, receivedError) => {
+          calls.push({
+            hook: 'onError',
+            sameSession: receivedSession === session,
+            sameError: receivedError === failure,
+          });
+        },
+        afterSession: async receivedSession => {
+          calls.push({hook: 'afterSession', sameSession: receivedSession === session});
+        },
+      },
+    }
+  );
+
+  const outcome = await orchestrator.processMessage(session).catch((error: unknown) => error);
+
+  expect({sameRejection: outcome === failure, calls}).toEqual({
+    sameRejection: true,
+    calls: [
+      {hook: 'onError', sameSession: true, sameError: true},
+      {hook: 'afterSession', sameSession: true},
+    ],
+  });
+});