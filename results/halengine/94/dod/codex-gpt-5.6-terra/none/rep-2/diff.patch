@@ -0,0 +1,55 @@
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/index.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+
+// spec: specs/hal-engine-config-hooks/spec.md#7
+describe('a beforeSession failure', () => {
+  it('reports and cleans up a rejected beforeSession before preserving its original rejection', async () => {
+    const failure = new Error('before session failed');
+    const phases: string[] = [];
+    let reportedSession: ChatSession | undefined;
+    let reportedError: Error | undefined;
+    let cleanedSession: ChatSession | undefined;
+    const session: ChatSession = {
+      sessionId: 'failed-before-session',
+      userId: 'user-1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-10-31T00:00:00.000Z'}],
+    };
+    const orchestrator = createChatOrchestrator(
+      createMockProvider(),
+      new PromptBuilder({identity: 'test assistant'}),
+      undefined,
+      {
+        hooks: {
+          beforeSession: async () => {
+            phases.push('beforeSession');
+            throw failure;
+          },
+          beforeUserInput: async (_session, message) => {
+            phases.push('beforeUserInput');
+            return message;
+          },
+          onError: async (hookSession, error) => {
+            phases.push('onError');
+            reportedSession = hookSession;
+            reportedError = error;
+          },
+          afterSession: async hookSession => {
+            phases.push('afterSession');
+            cleanedSession = hookSession;
+          },
+        },
+      }
+    );
+
+    await expect(orchestrator.processMessage(session)).rejects.toBe(failure);
+
+    expect({phases, reportedSession, reportedError, cleanedSession}).toEqual({
+      phases: ['beforeSession', 'onError', 'afterSession'],
+      reportedSession: session,
+      reportedError: failure,
+      cleanedSession: session,
+    });
+  });
+});