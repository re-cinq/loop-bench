+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+
+const session: ChatSession = {
+  sessionId: 'before-session-failure',
+  userId: 'user-1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-10-31T00:00:00.000Z'}],
+};
+
+describe('a beforeSession failure', () => {
+  it('reports the original error and always cleans up after the failed hook', async () => {
+    const failure = new Error('before session failed');
+    const calls: string[] = [];
+    let errorHookArguments: [ChatSession, Error] | undefined;
+    let cleanupSession: ChatSession | undefined;
+    const orchestrator = createChatOrchestrator(
+      createMockProvider(),
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      undefined,
+      {
+        hooks: {
+          beforeSession: async () => {
+            calls.push('beforeSession');
+            throw failure;
+          },
+          onError: async (receivedSession, receivedError) => {
+            calls.push('onError');
+            errorHookArguments = [receivedSession, receivedError];
+          },
+          afterSession: async receivedSession => {
+            calls.push('afterSession');
+            cleanupSession = receivedSession;
+          },
+        },
+      }
+    );
+
+    await expect(orchestrator.processMessage(session)).rejects.toBe(failure);
+
+    expect({calls, errorHookArguments, cleanupSession}).toEqual({
+      calls: ['beforeSession', 'onError', 'afterSession'],
+      errorHookArguments: [session, failure],
+      cleanupSession: session,
+    });
+  });
+});