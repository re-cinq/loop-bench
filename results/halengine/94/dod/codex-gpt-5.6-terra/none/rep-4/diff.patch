+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+
+const session: ChatSession = {
+  sessionId: 'before-session-failure',
+  userId: 'user-1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-10-31T00:00:00.000Z'}],
+};
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('beforeSession failure lifecycle', () => {
+  it('rejects unchanged and runs onError before afterSession when beforeSession throws', async () => {
+    const failure = new Error('beforeSession failed');
+    const callOrder: string[] = [];
+    let onErrorSession: ChatSession | undefined;
+    let onErrorFailure: Error | undefined;
+    let afterSessionEntryRoles: string[] | undefined;
+    const orchestrator = createChatOrchestrator(createMockProvider(), promptBuilder, undefined, {
+      hooks: {
+        beforeSession: async () => {
+          callOrder.push('beforeSession');
+          throw failure;
+        },
+        onError: async (receivedSession, receivedFailure) => {
+          callOrder.push('onError');
+          onErrorSession = receivedSession;
+          onErrorFailure = receivedFailure;
+        },
+        afterSession: async receivedSession => {
+          callOrder.push('afterSession');
+          afterSessionEntryRoles = receivedSession.entries.map(entry => entry.role);
+        },
+      },
+    });
+
+    const callerFailure = await orchestrator.processMessage(session).catch(error => error);
+
+    expect({
+      callerReceivedOriginalFailure: callerFailure === failure,
+      callOrder,
+      onErrorReceivedSession: onErrorSession === session,
+      onErrorReceivedOriginalFailure: onErrorFailure === failure,
+      afterSessionEntryRoles,
+    }).toEqual({
+      callerReceivedOriginalFailure: true,
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+      onErrorReceivedSession: true,
+      onErrorReceivedOriginalFailure: true,
+      afterSessionEntryRoles: ['user'],
+    });
+  });
+});