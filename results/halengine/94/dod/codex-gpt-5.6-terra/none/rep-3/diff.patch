+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/index.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+
+const session: ChatSession = {
+  sessionId: 'before-session-failure',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+it('reports and cleans up a beforeSession failure before rejecting the same error', async () => {
+  const failure = new Error('beforeSession failed');
+  const calls: string[] = [];
+  let reportedSession: ChatSession | undefined;
+  let reportedError: Error | undefined;
+  const orchestrator = createChatOrchestrator(createMockProvider(), new PromptBuilder({identity: 'test'}), undefined, {
+    hooks: {
+      beforeSession: async () => {
+        calls.push('beforeSession');
+        throw failure;
+      },
+      beforeUserInput: async (_session, userMessage) => {
+        calls.push('beforeUserInput');
+        return userMessage;
+      },
+      afterUserInput: async () => void calls.push('afterUserInput'),
+      beforeModelResponse: async (_session, systemPrompt) => {
+        calls.push('beforeModelResponse');
+        return systemPrompt;
+      },
+      afterModelResponse: async () => void calls.push('afterModelResponse'),
+      onError: async (hookSession, error) => {
+        calls.push('onError');
+        reportedSession = hookSession;
+        reportedError = error;
+      },
+      afterSession: async () => void calls.push('afterSession'),
+    },
+  });
+
+  const rejection = await orchestrator.processMessage(session).catch(error => error);
+
+  expect({
+    calls,
+    preservedError: rejection === failure,
+    reportedError: reportedError === failure,
+    reportedSession: reportedSession === session,
+  }).toEqual({
+    calls: ['beforeSession', 'onError', 'afterSession'],
+    preservedError: true,
+    reportedError: true,
+    reportedSession: true,
+  });
+});