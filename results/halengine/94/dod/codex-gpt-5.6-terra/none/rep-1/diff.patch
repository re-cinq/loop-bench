+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+
+describe('beforeSession failure lifecycle', () => {
+  it('notifies onError and runs afterSession when beforeSession throws', async () => {
+    const failure = new Error('beforeSession failed');
+    const session = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user' as const, content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const calls: string[] = [];
+    let onErrorArgumentsAreOriginal = false;
+    let afterSessionSawOriginalSession = false;
+    const orchestrator = createChatOrchestrator(
+      undefined as never,
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      undefined,
+      {
+        hooks: {
+          beforeSession: async () => {
+            calls.push('beforeSession');
+            throw failure;
+          },
+          onError: async (receivedSession, receivedError) => {
+            calls.push('onError');
+            onErrorArgumentsAreOriginal = receivedSession === session && receivedError === failure;
+          },
+          afterSession: async receivedSession => {
+            calls.push('afterSession');
+            afterSessionSawOriginalSession = receivedSession === session;
+          },
+        },
+      }
+    );
+
+    const callerErrorIsOriginal = await orchestrator.processMessage(session).then(
+      () => false,
+      error => error === failure
+    );
+
+    expect({callerErrorIsOriginal, onErrorArgumentsAreOriginal, afterSessionSawOriginalSession, calls}).toEqual({
+      callerErrorIsOriginal: true,
+      onErrorArgumentsAreOriginal: true,
+      afterSessionSawOriginalSession: true,
+      calls: ['beforeSession', 'onError', 'afterSession'],
+    });
+  });
+});