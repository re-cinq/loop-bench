+import {createMockProvider} from '../providers/mock/index.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {ChatSession} from '../types/session.js';
+
+const session: ChatSession = {
+  sessionId: 'before-session-failure',
+  userId: 'user-1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+describe('beforeSession failure lifecycle', () => {
+  it('rejects unchanged while reporting and cleaning up a failed beforeSession', async () => {
+    const failure = new Error('beforeSession failed');
+    const calls: {hook: string; session: ChatSession; error?: Error}[] = [];
+    const hooks: OrchestratorHooks = {
+      beforeSession: async receivedSession => {
+        calls.push({hook: 'beforeSession', session: receivedSession});
+        throw failure;
+      },
+      onError: async (receivedSession, receivedError) => {
+        calls.push({hook: 'onError', session: receivedSession, error: receivedError});
+      },
+      afterSession: async receivedSession => {
+        calls.push({hook: 'afterSession', session: receivedSession});
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      createMockProvider(),
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      undefined,
+      {hooks}
+    );
+
+    await expect(orchestrator.processMessage(session)).rejects.toBe(failure);
+
+    expect(calls).toEqual([
+      {hook: 'beforeSession', session},
+      {hook: 'onError', session, error: failure},
+      {hook: 'afterSession', session},
+    ]);
+  });
+});