+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {createMockProvider} from '../providers/mock/index.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+const session: ChatSession = {
+  sessionId: 'failed-before-session',
+  userId: 'deployer',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-10-31T00:00:00.000Z'}],
+};
+
+it('reports and cleans up a beforeSession failure before rejecting the caller', async () => {
+  const failure = new Error('allocation failed');
+  const calls: string[] = [];
+  let rejection: unknown;
+  let reportedSession: ChatSession | undefined;
+  let reportedError: Error | undefined;
+  let cleanedSession: ChatSession | undefined;
+  const orchestrator = createChatOrchestrator(
+    createMockProvider(),
+    new PromptBuilder({identity: 'test assistant'}),
+    undefined,
+    {
+      hooks: {
+        beforeSession: async () => {
+          calls.push('beforeSession');
+          throw failure;
+        },
+        onError: async (actualSession, error) => {
+          calls.push('onError');
+          reportedSession = actualSession;
+          reportedError = error;
+        },
+        afterSession: async actualSession => {
+          calls.push('afterSession');
+          cleanedSession = actualSession;
+        },
+      },
+    }
+  );
+
+  try {
+    await orchestrator.processMessage(session);
+  } catch (error) {
+    rejection = error;
+  }
+
+  expect({
+    rejectionIsOriginalFailure: rejection === failure,
+    onErrorReceivesFailureContext: reportedSession === session && reportedError === failure,
+    afterSessionReceivesFailedSession: cleanedSession === session,
+    calls,
+  }).toEqual({
+    rejectionIsOriginalFailure: true,
+    onErrorReceivesFailureContext: true,
+    afterSessionReceivesFailedSession: true,
+    calls: ['beforeSession', 'onError', 'afterSession'],
+  });
+});