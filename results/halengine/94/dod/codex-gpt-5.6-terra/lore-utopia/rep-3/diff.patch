@@ -0,0 +1,52 @@
+import {createHalEngine} from '../config.js';
+import type {ChatSession} from '../types/session.js';
+
+const session: ChatSession = {
+  sessionId: 'before-session-failure',
+  userId: 'user-1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-10-31T00:00:00.000Z'}],
+};
+
+describe('a beforeSession failure', () => {
+  it('notifies onError then afterSession, leaves later phases unstarted, and rejects with the same error', async () => {
+    const failure = new Error('beforeSession failed');
+    const calls: string[] = [];
+    let onErrorSession: ChatSession | undefined;
+    let onErrorFailure: Error | undefined;
+    let laterPhaseStarted = false;
+    const engine = createHalEngine({
+      provider: {type: 'mock'},
+      prompt: {identity: 'Acceptance test assistant'},
+      auth: {ws: async () => null},
+      orchestrator: {
+        hooks: {
+          beforeSession: async () => {
+            calls.push('beforeSession');
+            throw failure;
+          },
+          onError: async (receivedSession, receivedFailure) => {
+            calls.push('onError');
+            onErrorSession = receivedSession;
+            onErrorFailure = receivedFailure;
+          },
+          afterSession: async () => {
+            calls.push('afterSession');
+          },
+          beforeUserInput: async (_receivedSession, message) => {
+            laterPhaseStarted = true;
+            return message;
+          },
+        },
+      },
+    });
+
+    await expect(engine.orchestrator.processMessage(session)).rejects.toBe(failure);
+
+    expect({calls, onErrorSession, onErrorFailure, laterPhaseStarted}).toEqual({
+      calls: ['beforeSession', 'onError', 'afterSession'],
+      onErrorSession: session,
+      onErrorFailure: failure,
+      laterPhaseStarted: false,
+    });
+  });
+});