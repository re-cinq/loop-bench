+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {ChatSession} from '../types/session.js';
+
+const session: ChatSession = {
+  sessionId: 'before-session-failure',
+  userId: 'deployer',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+describe('beforeSession failure lifecycle', () => {
+  it('reports and cleans up a beforeSession failure before rejecting the same error', async () => {
+    const failure = new Error('beforeSession allocation failed');
+    const calls: string[] = [];
+    let reportedSession: ChatSession | undefined;
+    let reportedError: Error | undefined;
+    let rejection: unknown;
+
+    const orchestrator = createChatOrchestrator(
+      createMockProvider(),
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      undefined,
+      {
+        hooks: {
+          beforeSession: async () => {
+            calls.push('beforeSession');
+            throw failure;
+          },
+          beforeUserInput: async (_session, message) => {
+            calls.push('beforeUserInput');
+            return message;
+          },
+          onError: async (receivedSession, error) => {
+            calls.push('onError');
+            reportedSession = receivedSession;
+            reportedError = error;
+          },
+          afterSession: async () => {
+            calls.push('afterSession');
+          },
+        },
+      }
+    );
+
+    try {
+      await orchestrator.processMessage(session);
+    } catch (error) {
+      rejection = error;
+    }
+
+    expect({calls, rejection, reportedSession, reportedError}).toEqual({
+      calls: ['beforeSession', 'onError', 'afterSession'],
+      rejection: failure,
+      reportedSession: session,
+      reportedError: failure,
+    });
+  });
+});