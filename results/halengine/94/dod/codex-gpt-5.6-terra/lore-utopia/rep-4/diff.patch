+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const provider: AIProvider = {
+  async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'unused'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+describe('ChatOrchestrator beforeSession failure', () => {
+  it('runs onError then afterSession when beforeSession throws and preserves the rejection', async () => {
+    const callOrder: string[] = [];
+    const beforeSessionFailure = new Error('beforeSession boom');
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    let onErrorSession: ChatSession | undefined;
+    let onErrorFailure: Error | undefined;
+    let afterSessionEntries: ChatSession['entries'] | undefined;
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw beforeSessionFailure;
+      },
+      beforeUserInput: async (_session, message) => {
+        callOrder.push('beforeUserInput');
+        return message;
+      },
+      onError: async (receivedSession, receivedFailure) => {
+        callOrder.push('onError');
+        onErrorSession = receivedSession;
+        onErrorFailure = receivedFailure;
+      },
+      afterSession: async receivedSession => {
+        callOrder.push('afterSession');
+        afterSessionEntries = receivedSession.entries;
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      provider,
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      undefined,
+      {hooks}
+    );
+
+    const callerFailure = await orchestrator.processMessage(session).then(
+      () => undefined,
+      error => error
+    );
+
+    expect({callerFailure, onErrorSession, onErrorFailure, afterSessionEntries, callOrder}).toEqual({
+      callerFailure: beforeSessionFailure,
+      onErrorSession: session,
+      onErrorFailure: beforeSessionFailure,
+      afterSessionEntries: session.entries,
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+    });
+  });
+});