+import {createHalEngine} from '../config.js';
+import type {WsAuthenticator} from '../types/auth.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('beforeSession failure lifecycle', () => {
+  it('reports a failed beforeSession then cleans up before any turn work begins', async () => {
+    const session: ChatSession = {
+      sessionId: 'before-session-failure',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const failure = new Error('allocation failed');
+    const calls: string[] = [];
+    let reported: {session: ChatSession; error: Error} | undefined;
+    let entriesAtCleanup: string[] = [];
+    const engine = createHalEngine({
+      provider: {type: 'mock'},
+      prompt: {identity: 'test'},
+      auth: {ws: (async () => null) as WsAuthenticator},
+      orchestrator: {
+        hooks: {
+          beforeSession: async () => {
+            calls.push('beforeSession');
+            throw failure;
+          },
+          onError: async (receivedSession, error) => {
+            calls.push('onError');
+            reported = {session: receivedSession, error};
+          },
+          afterSession: async receivedSession => {
+            calls.push('afterSession');
+            entriesAtCleanup = receivedSession.entries.map(entry => entry.role);
+          },
+        },
+      },
+    });
+
+    const outcome = await engine.orchestrator
+      .processMessage(session)
+      .then(() => undefined)
+      .catch(error => error);
+
+    expect({outcome, calls, reported, entriesAtCleanup}).toEqual({
+      outcome: failure,
+      calls: ['beforeSession', 'onError', 'afterSession'],
+      reported: {session, error: failure},
+      entriesAtCleanup: ['user'],
+    });
+  });
+});