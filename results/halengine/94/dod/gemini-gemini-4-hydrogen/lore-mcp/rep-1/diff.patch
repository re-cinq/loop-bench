-- `beforeSession` is awaited before the `try` block opens ([chatOrchestrator.ts#L91](../../src/orchestration/chatOrchestrator.ts#L91)), so a throw there escapes before the `catch`/`finally` exist and skips both `onError` and `afterSession`.
 - The `catch` gates `onError` on `error instanceof Error` ([chatOrchestrator.ts#L150](../../src/orchestration/chatOrchestrator.ts#L150)), so a rejection that is not an `Error` — a thrown string or object — bypasses `onError` entirely while still propagating to the caller.
 - `afterModelResponse` is called once per user message after the round loop exits ([chatOrchestrator.ts#L148](../../src/orchestration/chatOrchestrator.ts#L148)), and is passed the `lastUsage` local — the most recent round's usage, not a sum across tool rounds, so a deployer using the hook for billing or audit under-counts every turn that ran tools.
diff --git a/src/orchestration/chatOrchestrator.acceptance.test.ts b/src/orchestration/chatOrchestrator.acceptance.test.ts
new file mode 100644
index 0000000..36faace
--- /dev/null
+++ b/src/orchestration/chatOrchestrator.acceptance.test.ts
@@ -0,0 +1,67 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {answering, writeSignalPromptBuilder} from '../infrastructure/writeSignalTestSupport.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+describe('beforeSession error lifecycle', () => {
+  it('runs onError then afterSession when beforeSession throws, and still rejects to the caller', async () => {
+    const callOrder: string[] = [];
+    const thrown = new Error('beforeSession boom');
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+    };
+    let onErrorCall: {sameSession: boolean; sameError: boolean} | undefined;
+    let afterSessionMatched = false;
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw thrown;
+      },
+      beforeUserInput: async (_session, userMessage) => {
+        callOrder.push('beforeUserInput');
+        return userMessage;
+      },
+      afterUserInput: async () => {
+        callOrder.push('afterUserInput');
+      },
+      beforeModelResponse: async (_session, systemPrompt) => {
+        callOrder.push('beforeModelResponse');
+        return systemPrompt;
+      },
+      afterModelResponse: async () => {
+        callOrder.push('afterModelResponse');
+      },
+      onError: async (receivedSession, receivedError) => {
+        callOrder.push('onError');
+        onErrorCall = {sameSession: receivedSession === session, sameError: receivedError === thrown};
+      },
+      afterSession: async receivedSession => {
+        callOrder.push('afterSession');
+        afterSessionMatched = receivedSession === session;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(answering('ok'), writeSignalPromptBuilder, undefined, {hooks});
+    const rejection = await orchestrator.processMessage(session).then(
+      () => undefined,
+      (error: unknown) => error
+    );
+
+    expect({
+      rejectedWithSameError: rejection === thrown,
+      callOrder,
+      onErrorCall,
+      afterSessionMatched,
+    }).toEqual({
+      rejectedWithSameError: true,
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+      onErrorCall: {sameSession: true, sameError: true},
+      afterSessionMatched: true,
+    });
+  });
+});