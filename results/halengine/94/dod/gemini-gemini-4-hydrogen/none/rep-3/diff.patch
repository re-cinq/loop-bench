@@ -0,0 +1,110 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {answering, writeSignalPromptBuilder} from '../infrastructure/writeSignalTestSupport.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const FIXED_TIMESTAMP = '2026-01-01T00:00:00.000Z';
+
+const makeSession = (content: string): ChatSession => ({
+  sessionId: 's-before-session-throw',
+  userId: 'u-1',
+  entries: [{role: 'user', content, timestamp: FIXED_TIMESTAMP}],
+});
+
+describe('beforeSession failure lifecycle', () => {
+  it('fires onError with the session and error and still rejects to the caller when beforeSession throws', async () => {
+    const session = makeSession('hello');
+    const thrown = new Error('session init failed');
+    let receivedSession: ChatSession | undefined;
+    let receivedError: Error | undefined;
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw thrown;
+      },
+      onError: async (errSession, error) => {
+        receivedSession = errSession;
+        receivedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(answering('ok'), writeSignalPromptBuilder, undefined, {hooks});
+    const outcome = await orchestrator.processMessage(session).then(
+      () => 'resolved',
+      (error: Error) => error.message
+    );
+
+    expect({
+      outcome,
+      sameSession: receivedSession === session,
+      sameError: receivedError === thrown,
+    }).toEqual({
+      outcome: 'session init failed',
+      sameSession: true,
+      sameError: true,
+    });
+  });
+
+  it('fires afterSession after onError and skips later turn hooks and provider calls when beforeSession throws', async () => {
+    const session = makeSession('hello');
+    const callOrder: string[] = [];
+    let afterSessionTarget: ChatSession | undefined;
+    let providerCalls = 0;
+
+    const baseProvider = answering('ok');
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        providerCalls += 1;
+        yield* baseProvider.sendMessage(params);
+      },
+      generateStructured: baseProvider.generateStructured,
+    };
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw new Error('session init failed');
+      },
+      beforeUserInput: async (_s, message) => {
+        callOrder.push('beforeUserInput');
+        return message;
+      },
+      afterUserInput: async () => {
+        callOrder.push('afterUserInput');
+      },
+      beforeModelResponse: async (_s, prompt) => {
+        callOrder.push('beforeModelResponse');
+        return prompt;
+      },
+      afterModelResponse: async () => {
+        callOrder.push('afterModelResponse');
+      },
+      onError: async () => {
+        callOrder.push('onError');
+      },
+      afterSession: async hookSession => {
+        callOrder.push('afterSession');
+        afterSessionTarget = hookSession;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, writeSignalPromptBuilder, undefined, {hooks});
+    const outcome = await orchestrator.processMessage(session).then(
+      () => 'resolved',
+      (error: Error) => error.message
+    );
+
+    expect({
+      outcome,
+      callOrder,
+      providerCalls,
+      sameSession: afterSessionTarget === session,
+    }).toEqual({
+      outcome: 'session init failed',
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+      providerCalls: 0,
+      sameSession: true,
+    });
+  });
+});