+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {answering, writeSignalPromptBuilder} from '../infrastructure/writeSignalTestSupport.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const sessionWith = (content: string): ChatSession => ({
+  sessionId: 's-before-fail',
+  userId: 'u1',
+  entries: [{role: 'user', content, timestamp: SENT_AT}],
+});
+
+const failureMessageOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved').catch((error: Error) => error.message);
+
+describe('beforeSession failure lifecycle', () => {
+  it('fires onError with session and error and still rejects on throw', async () => {
+    const session = sessionWith('hello');
+    const setupError = new Error('session setup failed');
+    let observedSession: ChatSession | undefined;
+    let observedError: Error | undefined;
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw setupError;
+      },
+      onError: async (currentSession, error) => {
+        observedSession = currentSession;
+        observedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(answering('hi'), writeSignalPromptBuilder, undefined, {hooks});
+    const outcome = await failureMessageOf(orchestrator.processMessage(session));
+
+    expect({
+      outcome,
+      sameSession: observedSession === session,
+      sameError: observedError === setupError,
+    }).toEqual({
+      outcome: 'session setup failed',
+      sameSession: true,
+      sameError: true,
+    });
+  });
+
+  it('runs onError then afterSession and skips turn hooks on throw', async () => {
+    const session = sessionWith('hello');
+    const callOrder: string[] = [];
+    let afterSessionArg: ChatSession | undefined;
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw new Error('session setup failed');
+      },
+      beforeUserInput: async (_s, message) => {
+        callOrder.push('beforeUserInput');
+        return message;
+      },
+      afterUserInput: async () => void callOrder.push('afterUserInput'),
+      beforeModelResponse: async (_s, systemPrompt) => {
+        callOrder.push('beforeModelResponse');
+        return systemPrompt;
+      },
+      afterModelResponse: async () => void callOrder.push('afterModelResponse'),
+      onError: async () => void callOrder.push('onError'),
+      afterSession: async currentSession => {
+        afterSessionArg = currentSession;
+        callOrder.push('afterSession');
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(answering('hi'), writeSignalPromptBuilder, undefined, {hooks});
+    const outcome = await failureMessageOf(orchestrator.processMessage(session));
+
+    expect({
+      outcome,
+      callOrder,
+      sameSessionInAfterSession: afterSessionArg === session,
+    }).toEqual({
+      outcome: 'session setup failed',
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+      sameSessionInAfterSession: true,
+    });
+  });
+});