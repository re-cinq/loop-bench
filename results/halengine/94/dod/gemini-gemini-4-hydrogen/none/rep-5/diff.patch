-- `beforeSession` is awaited before the `try` block opens ([chatOrchestrator.ts#L91](../../src/orchestration/chatOrchestrator.ts#L91)), so a throw there escapes before the `catch`/`finally` exist and skips both `onError` and `afterSession`.
 - The `catch` gates `onError` on `error instanceof Error` ([chatOrchestrator.ts#L150](../../src/orchestration/chatOrchestrator.ts#L150)), so a rejection that is not an `Error` — a thrown string or object — bypasses `onError` entirely while still propagating to the caller.
 - `afterModelResponse` is called once per user message after the round loop exits ([chatOrchestrator.ts#L148](../../src/orchestration/chatOrchestrator.ts#L148)), and is passed the `lastUsage` local — the most recent round's usage, not a sum across tool rounds, so a deployer using the hook for billing or audit under-counts every turn that ran tools.
diff --git a/src/orchestration/beforeSessionThrow.acceptance.test.ts b/src/orchestration/beforeSessionThrow.acceptance.test.ts
new file mode 100644
index 0000000..cace985
--- /dev/null
+++ b/src/orchestration/beforeSessionThrow.acceptance.test.ts
@@ -0,0 +1,128 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// Fixed timestamp keeps session fixtures deterministic across runs.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const buildSession = (): ChatSession => ({
+  sessionId: 's-before-throw',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+});
+
+const rejectionMessage = (call: Promise<unknown>): Promise<string> =>
+  call.then(
+    () => 'resolved without throwing',
+    (error: unknown) => (error instanceof Error ? error.message : String(error))
+  );
+
+describe('beforeSession failure lifecycle', () => {
+  it('runs onError with session and error, then afterSession, and rejects when beforeSession throws', async () => {
+    const callOrder: string[] = [];
+    const thrownError = new Error('session setup failed');
+    let onErrorCount = 0;
+    let onErrorSession: ChatSession | undefined;
+    let onErrorCause: Error | undefined;
+    let afterSessionCount = 0;
+    let afterSessionTarget: ChatSession | undefined;
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        yield {type: 'text', text: 'ok'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw thrownError;
+      },
+      onError: async (receivedSession, receivedError) => {
+        callOrder.push('onError');
+        onErrorCount += 1;
+        onErrorSession = receivedSession;
+        onErrorCause = receivedError;
+      },
+      afterSession: async receivedSession => {
+        callOrder.push('afterSession');
+        afterSessionCount += 1;
+        afterSessionTarget = receivedSession;
+      },
+    };
+    const session = buildSession();
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+
+    const outcome = await rejectionMessage(orchestrator.processMessage(session));
+
+    expect({
+      outcome,
+      callOrder,
+      onErrorCount,
+      sameSessionOnError: onErrorSession === session,
+      sameErrorOnError: onErrorCause === thrownError,
+      afterSessionCount,
+      sameSessionAfterSession: afterSessionTarget === session,
+    }).toEqual({
+      outcome: 'session setup failed',
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+      onErrorCount: 1,
+      sameSessionOnError: true,
+      sameErrorOnError: true,
+      afterSessionCount: 1,
+      sameSessionAfterSession: true,
+    });
+  });
+
+  it('skips user, model, and provider phases when beforeSession throws on stream', async () => {
+    const callOrder: string[] = [];
+    let providerCalls = 0;
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        providerCalls += 1;
+        yield {type: 'text', text: 'ok'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw new Error('auth check failed');
+      },
+      beforeUserInput: async (_session, userMessage) => {
+        callOrder.push('beforeUserInput');
+        return userMessage;
+      },
+      afterUserInput: async () => void callOrder.push('afterUserInput'),
+      beforeModelResponse: async (_session, systemPrompt) => {
+        callOrder.push('beforeModelResponse');
+        return systemPrompt;
+      },
+      afterModelResponse: async () => void callOrder.push('afterModelResponse'),
+      onError: async () => void callOrder.push('onError'),
+      afterSession: async () => void callOrder.push('afterSession'),
+    };
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+    const drainStream = async (): Promise<void> => {
+      for await (const _chunk of orchestrator.processMessageStream(buildSession())) {
+        // Stream consumption drives generator execution to failure.
+      }
+    };
+
+    const outcome = await rejectionMessage(drainStream());
+
+    expect({outcome, callOrder, providerCalls}).toEqual({
+      outcome: 'auth check failed',
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+      providerCalls: 0,
+    });
+  });
+});