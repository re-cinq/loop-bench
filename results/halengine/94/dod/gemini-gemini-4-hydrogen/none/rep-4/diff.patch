+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const makeSession = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+});
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const idleProvider = (onSend?: () => void): AIProvider => ({
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    onSend?.();
+    yield {type: 'text', text: 'ok'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+const runExpectingRejection = (call: Promise<unknown>): Promise<string> =>
+  call.then(
+    () => 'resolved without throwing',
+    (caught: Error) => caught.message
+  );
+
+describe('beforeSession failure handling', () => {
+  it('fires onError with the session and error and still rejects when beforeSession throws', async () => {
+    const thrown = new Error('beforeSession failed');
+    let receivedSession: ChatSession | undefined;
+    let receivedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw thrown;
+      },
+      onError: async (hookSession, hookError) => {
+        receivedSession = hookSession;
+        receivedError = hookError;
+      },
+    };
+
+    const session = makeSession();
+    const orchestrator = createChatOrchestrator(idleProvider(), promptBuilder, undefined, {hooks});
+    const outcome = await runExpectingRejection(orchestrator.processMessage(session));
+
+    expect({outcome, receivedSession, receivedError}).toEqual({
+      outcome: 'beforeSession failed',
+      receivedSession: session,
+      receivedError: thrown,
+    });
+  });
+
+  it('fires afterSession after onError without starting the turn when beforeSession throws', async () => {
+    const hookOrder: string[] = [];
+    let afterSessionSessionId: string | undefined;
+    let providerCalls = 0;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        hookOrder.push('beforeSession');
+        throw new Error('beforeSession failed');
+      },
+      beforeUserInput: async (_s, message) => {
+        hookOrder.push('beforeUserInput');
+        return message;
+      },
+      afterUserInput: async () => {
+        hookOrder.push('afterUserInput');
+      },
+      beforeModelResponse: async (_s, systemPrompt) => {
+        hookOrder.push('beforeModelResponse');
+        return systemPrompt;
+      },
+      afterModelResponse: async () => {
+        hookOrder.push('afterModelResponse');
+      },
+      onError: async () => {
+        hookOrder.push('onError');
+      },
+      afterSession: async hookSession => {
+        hookOrder.push('afterSession');
+        afterSessionSessionId = hookSession.sessionId;
+      },
+    };
+
+    const session = makeSession();
+    const orchestrator = createChatOrchestrator(
+      idleProvider(() => {
+        providerCalls += 1;
+      }),
+      promptBuilder,
+      undefined,
+      {hooks}
+    );
+    const outcome = await runExpectingRejection(orchestrator.processMessage(session));
+
+    expect({outcome, hookOrder, afterSessionSessionId, providerCalls}).toEqual({
+      outcome: 'beforeSession failed',
+      hookOrder: ['beforeSession', 'onError', 'afterSession'],
+      afterSessionSessionId: 's1',
+      providerCalls: 0,
+    });
+  });
+});