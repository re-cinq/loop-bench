+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {answering, writeSignalPromptBuilder} from '../infrastructure/writeSignalTestSupport.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const createTestSession = (): ChatSession => ({
+  sessionId: 'accept-before-session',
+  userId: 'user-accept',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+describe('beforeSession error handling', () => {
+  it('fires onError with the session and error and still rejects when beforeSession throws', async () => {
+    const boom = new Error('span allocation failed');
+    const session = createTestSession();
+    const errorCalls: Array<{session: ChatSession; error: Error}> = [];
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw boom;
+      },
+      onError: async (caughtSession, error) => {
+        errorCalls.push({session: caughtSession, error});
+      },
+    };
+    const orchestrator = createChatOrchestrator(answering('ok'), writeSignalPromptBuilder, undefined, {hooks});
+
+    const thrown = await orchestrator.processMessage(session).catch((caught: unknown) => caught);
+
+    expect({
+      thrown,
+      onErrorCount: errorCalls.length,
+      sameSession: errorCalls[0]?.session === session,
+      sameError: errorCalls[0]?.error === boom,
+    }).toEqual({
+      thrown: boom,
+      onErrorCount: 1,
+      sameSession: true,
+      sameError: true,
+    });
+  });
+
+  it('fires afterSession after onError without running mid-turn hooks or the provider when beforeSession throws', async () => {
+    const session = createTestSession();
+    const hookOrder: string[] = [];
+    const afterSessions: ChatSession[] = [];
+    let providerInvoked = false;
+    const trackingProvider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        providerInvoked = true;
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      generateStructured: async () => ({}) as never,
+    };
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw new Error('rate limit token unavailable');
+      },
+      beforeUserInput: async (_s, message) => {
+        hookOrder.push('beforeUserInput');
+        return message;
+      },
+      afterUserInput: async () => void hookOrder.push('afterUserInput'),
+      beforeModelResponse: async (_s, prompt) => {
+        hookOrder.push('beforeModelResponse');
+        return prompt;
+      },
+      afterModelResponse: async () => void hookOrder.push('afterModelResponse'),
+      onError: async () => void hookOrder.push('onError'),
+      afterSession: async closedSession => {
+        hookOrder.push('afterSession');
+        afterSessions.push(closedSession);
+      },
+    };
+    const orchestrator = createChatOrchestrator(trackingProvider, writeSignalPromptBuilder, undefined, {hooks});
+
+    const outcome = await orchestrator
+      .processMessage(session)
+      .then(() => 'resolved')
+      .catch((error: Error) => error.message);
+
+    expect({
+      outcome,
+      hookOrder,
+      afterSessionCount: afterSessions.length,
+      sameSession: afterSessions[0] === session,
+      providerInvoked,
+    }).toEqual({
+      outcome: 'rate limit token unavailable',
+      hookOrder: ['onError', 'afterSession'],
+      afterSessionCount: 1,
+      sameSession: true,
+      providerInvoked: false,
+    });
+  });
+});