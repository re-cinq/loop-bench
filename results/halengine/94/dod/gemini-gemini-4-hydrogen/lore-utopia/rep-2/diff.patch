@@ -0,0 +1,79 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {answering, writeSignalPromptBuilder} from '../infrastructure/writeSignalTestSupport.js';
+import type {AIProvider} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+describe('ChatOrchestrator beforeSession failure lifecycle', () => {
+  it('runs onError then afterSession when beforeSession throws, and still rejects to the caller', async () => {
+    const thrown = new Error('beforeSession failed');
+    const callOrder: string[] = [];
+    let onErrorSession: ChatSession | undefined;
+    let onErrorError: Error | undefined;
+    let afterSessionArg: ChatSession | undefined;
+
+    const baseProvider = answering('ok');
+    const provider: AIProvider = {
+      ...baseProvider,
+      async *sendMessage(params) {
+        callOrder.push('provider');
+        yield* baseProvider.sendMessage(params);
+      },
+    };
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw thrown;
+      },
+      beforeUserInput: async (_session, userMessage) => {
+        callOrder.push('beforeUserInput');
+        return userMessage;
+      },
+      afterUserInput: async () => {
+        callOrder.push('afterUserInput');
+      },
+      beforeModelResponse: async (_session, systemPrompt) => {
+        callOrder.push('beforeModelResponse');
+        return systemPrompt;
+      },
+      afterModelResponse: async () => {
+        callOrder.push('afterModelResponse');
+      },
+      onError: async (receivedSession, receivedError) => {
+        callOrder.push('onError');
+        onErrorSession = receivedSession;
+        onErrorError = receivedError;
+      },
+      afterSession: async receivedSession => {
+        callOrder.push('afterSession');
+        afterSessionArg = receivedSession;
+      },
+    };
+
+    const session: ChatSession = {
+      sessionId: 's-before-session-throw',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+    };
+    const orchestrator = createChatOrchestrator(provider, writeSignalPromptBuilder, undefined, {hooks});
+
+    const caught: unknown = await orchestrator.processMessage(session).catch((rejection: unknown) => rejection);
+
+    expect({
+      rejectedSameError: caught === thrown,
+      callOrder,
+      onErrorSameSession: onErrorSession === session,
+      onErrorSameError: onErrorError === thrown,
+      afterSessionSameSession: afterSessionArg === session,
+    }).toEqual({
+      rejectedSameError: true,
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+      onErrorSameSession: true,
+      onErrorSameError: true,
+      afterSessionSameSession: true,
+    });
+  });
+});