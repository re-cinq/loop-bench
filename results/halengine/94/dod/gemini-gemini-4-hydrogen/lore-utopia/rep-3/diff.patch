+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {answering, writeSignalPromptBuilder} from '../infrastructure/writeSignalTestSupport.js';
+import type {AIProvider} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+describe('beforeSession failure lifecycle', () => {
+  it('runs onError then afterSession when beforeSession throws, without running the turn, and rejects with the same error', async () => {
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+    };
+    const boom = new Error('beforeSession boom');
+    const callOrder: string[] = [];
+    const onErrorCalls: Array<{session: ChatSession; error: Error}> = [];
+    const afterSessionCalls: ChatSession[] = [];
+    let providerCalls = 0;
+
+    const baseProvider = answering('hi');
+    const provider: AIProvider = {
+      ...baseProvider,
+      async *sendMessage(params) {
+        providerCalls += 1;
+        yield* baseProvider.sendMessage(params);
+      },
+    };
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw boom;
+      },
+      beforeUserInput: async (_s, message) => {
+        callOrder.push('beforeUserInput');
+        return message;
+      },
+      afterUserInput: async () => void callOrder.push('afterUserInput'),
+      beforeModelResponse: async (_s, prompt) => {
+        callOrder.push('beforeModelResponse');
+        return prompt;
+      },
+      afterModelResponse: async () => void callOrder.push('afterModelResponse'),
+      onError: async (receivedSession, receivedError) => {
+        callOrder.push('onError');
+        onErrorCalls.push({session: receivedSession, error: receivedError});
+      },
+      afterSession: async receivedSession => {
+        callOrder.push('afterSession');
+        afterSessionCalls.push(receivedSession);
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, writeSignalPromptBuilder, undefined, {hooks});
+    const caught = await orchestrator.processMessage(session).then(
+      () => undefined,
+      (error: unknown) => error
+    );
+
+    expect({
+      rejectedWithSameError: caught === boom,
+      callOrder,
+      onErrorCount: onErrorCalls.length,
+      onErrorSessionMatches: onErrorCalls[0]?.session === session,
+      onErrorErrorMatches: onErrorCalls[0]?.error === boom,
+      afterSessionCount: afterSessionCalls.length,
+      afterSessionSessionMatches: afterSessionCalls[0] === session,
+      providerCalls,
+    }).toEqual({
+      rejectedWithSameError: true,
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+      onErrorCount: 1,
+      onErrorSessionMatches: true,
+      onErrorErrorMatches: true,
+      afterSessionCount: 1,
+      afterSessionSessionMatches: true,
+      providerCalls: 0,
+    });
+  });
+});