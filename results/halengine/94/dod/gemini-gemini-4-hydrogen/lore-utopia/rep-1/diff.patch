@@ -0,0 +1,89 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+describe('beforeSession error handling', () => {
+  it('runs onError with session and error, then afterSession, and still rejects to the caller when beforeSession throws', async () => {
+    const boom = new Error('beforeSession boom');
+    const callOrder: string[] = [];
+    let onErrorSession: ChatSession | undefined;
+    let onErrorError: Error | undefined;
+    let afterSessionSession: ChatSession | undefined;
+    let providerCalled = false;
+
+    const session: ChatSession = {
+      sessionId: 's-before-session-throw',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+    };
+
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        providerCalled = true;
+        yield {type: 'text', text: 'never'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw boom;
+      },
+      beforeUserInput: async (_s, message) => {
+        callOrder.push('beforeUserInput');
+        return message;
+      },
+      afterUserInput: async () => {
+        callOrder.push('afterUserInput');
+      },
+      beforeModelResponse: async (_s, systemPrompt) => {
+        callOrder.push('beforeModelResponse');
+        return systemPrompt;
+      },
+      afterModelResponse: async () => {
+        callOrder.push('afterModelResponse');
+      },
+      onError: async (receivedSession, receivedError) => {
+        callOrder.push('onError');
+        onErrorSession = receivedSession;
+        onErrorError = receivedError;
+      },
+      afterSession: async receivedSession => {
+        callOrder.push('afterSession');
+        afterSessionSession = receivedSession;
+      },
+    };
+
+    const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+
+    const caughtError = await orchestrator.processMessage(session).then(
+      () => undefined,
+      (thrown: unknown) => thrown
+    );
+
+    expect({
+      rejectedWithSameError: caughtError === boom,
+      onErrorReceivedSameSession: onErrorSession === session,
+      onErrorReceivedSameError: onErrorError === boom,
+      afterSessionReceivedSameSession: afterSessionSession === session,
+      providerCalled,
+      callOrder,
+    }).toEqual({
+      rejectedWithSameError: true,
+      onErrorReceivedSameSession: true,
+      onErrorReceivedSameError: true,
+      afterSessionReceivedSameSession: true,
+      providerCalled: false,
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+    });
+  });
+});