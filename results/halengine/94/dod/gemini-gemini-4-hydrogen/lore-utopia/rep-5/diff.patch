+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {answering, writeSignalPromptBuilder} from '../infrastructure/writeSignalTestSupport.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+describe('ChatOrchestrator beforeSession failure handling', () => {
+  it('runs onError then afterSession and still rejects when beforeSession throws', async () => {
+    const boom = new Error('beforeSession boom');
+    const callOrder: string[] = [];
+    let onErrorSession: ChatSession | undefined;
+    let onErrorError: Error | undefined;
+    let afterSessionArg: ChatSession | undefined;
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw boom;
+      },
+      beforeUserInput: async (_session, userMessage) => {
+        callOrder.push('beforeUserInput');
+        return userMessage;
+      },
+      afterUserInput: async () => {
+        callOrder.push('afterUserInput');
+      },
+      beforeModelResponse: async (_session, systemPrompt) => {
+        callOrder.push('beforeModelResponse');
+        return systemPrompt;
+      },
+      afterModelResponse: async () => {
+        callOrder.push('afterModelResponse');
+      },
+      onError: async (hookSession, error) => {
+        callOrder.push('onError');
+        onErrorSession = hookSession;
+        onErrorError = error;
+      },
+      afterSession: async hookSession => {
+        callOrder.push('afterSession');
+        afterSessionArg = hookSession;
+      },
+    };
+
+    const session: ChatSession = {
+      sessionId: 's-before-throws',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+    };
+    const orchestrator = createChatOrchestrator(answering('ok'), writeSignalPromptBuilder, undefined, {hooks});
+    const rejected = await orchestrator.processMessage(session).catch((error: unknown) => error);
+
+    expect({
+      rejectedIsSameInstance: rejected === boom,
+      rejectedMessage: rejected instanceof Error ? rejected.message : String(rejected),
+      callOrder,
+      onErrorSessionMatches: onErrorSession === session,
+      onErrorErrorMatches: onErrorError === boom,
+      afterSessionMatches: afterSessionArg === session,
+    }).toEqual({
+      rejectedIsSameInstance: true,
+      rejectedMessage: 'beforeSession boom',
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+      onErrorSessionMatches: true,
+      onErrorErrorMatches: true,
+      afterSessionMatches: true,
+    });
+  });
+});