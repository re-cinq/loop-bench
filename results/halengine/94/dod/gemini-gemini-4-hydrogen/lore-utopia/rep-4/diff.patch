@@ -0,0 +1,84 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {writeSignalPromptBuilder} from '../infrastructure/writeSignalTestSupport.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+describe('beforeSession failure lifecycle (acceptance)', () => {
+  it('runs onError then afterSession when beforeSession throws and still rejects', async () => {
+    const boom = new Error('beforeSession boom');
+    const callOrder: string[] = [];
+    let providerCalls = 0;
+    let onErrorArgs: {session: ChatSession; error: Error} | undefined;
+    let afterSessionArg: ChatSession | undefined;
+
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        providerCalls += 1;
+        yield {type: 'text', text: 'unexpected'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw boom;
+      },
+      beforeUserInput: async (_s, message) => {
+        callOrder.push('beforeUserInput');
+        return message;
+      },
+      afterUserInput: async () => {
+        callOrder.push('afterUserInput');
+      },
+      beforeModelResponse: async (_s, systemPrompt) => {
+        callOrder.push('beforeModelResponse');
+        return systemPrompt;
+      },
+      afterModelResponse: async () => {
+        callOrder.push('afterModelResponse');
+      },
+      onError: async (receivedSession, receivedError) => {
+        callOrder.push('onError');
+        onErrorArgs = {session: receivedSession, error: receivedError};
+      },
+      afterSession: async receivedSession => {
+        callOrder.push('afterSession');
+        afterSessionArg = receivedSession;
+      },
+    };
+
+    const session: ChatSession = {
+      sessionId: 's-accept-94',
+      userId: 'u-accept-94',
+      entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+    };
+    const orchestrator = createChatOrchestrator(provider, writeSignalPromptBuilder, undefined, {hooks});
+    const outcome = await orchestrator
+      .processMessage(session)
+      .then(() => 'resolved')
+      .catch((err: unknown) => err);
+
+    expect({
+      outcome,
+      callOrder,
+      providerCalls,
+      onErrorSameSession: onErrorArgs?.session === session,
+      onErrorSameError: onErrorArgs?.error === boom,
+      afterSessionSameSession: afterSessionArg === session,
+    }).toEqual({
+      outcome: boom,
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+      providerCalls: 0,
+      onErrorSameSession: true,
+      onErrorSameError: true,
+      afterSessionSameSession: true,
+    });
+  });
+});