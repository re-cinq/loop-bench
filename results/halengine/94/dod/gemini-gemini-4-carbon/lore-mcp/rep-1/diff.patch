@@ -0,0 +1,50 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {answering, writeSignalPromptBuilder} from '../infrastructure/writeSignalTestSupport.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('ChatOrchestrator beforeSession failure lifecycle', () => {
+  it('runs onError then afterSession when beforeSession throws, and rejects unchanged', async () => {
+    const allocationFailure = new Error('beforeSession allocation failed');
+    const callOrder: string[] = [];
+    const onErrorCalls: Array<{session: ChatSession; error: Error}> = [];
+    const afterSessionCalls: ChatSession[] = [];
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw allocationFailure;
+      },
+      beforeUserInput: async (_session, text) => `${callOrder.push('beforeUserInput')}:${text}`,
+      afterUserInput: async () => {
+        callOrder.push('afterUserInput');
+      },
+      beforeModelResponse: async (_session, prompt) => `${callOrder.push('beforeModelResponse')}:${prompt}`,
+      afterModelResponse: async () => {
+        callOrder.push('afterModelResponse');
+      },
+      onError: async (failedSession, error) => {
+        callOrder.push('onError');
+        onErrorCalls.push({session: failedSession, error});
+      },
+      afterSession: async endedSession => {
+        callOrder.push('afterSession');
+        afterSessionCalls.push(endedSession);
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(answering('ok'), writeSignalPromptBuilder, undefined, {hooks});
+    const session: ChatSession = {
+      sessionId: 's-before-session-throw',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const rejection = await orchestrator.processMessage(session).catch((caught: unknown) => caught);
+
+    expect({rejection, callOrder, onErrorCalls, afterSessionCalls}).toEqual({
+      rejection: allocationFailure,
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+      onErrorCalls: [{session, error: allocationFailure}],
+      afterSessionCalls: [session],
+    });
+  });
+});