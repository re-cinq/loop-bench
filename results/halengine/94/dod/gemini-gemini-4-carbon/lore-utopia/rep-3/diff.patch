@@ -0,0 +1,67 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {answering, writeSignalPromptBuilder} from '../infrastructure/writeSignalTestSupport.js';
+import type {ChatSession, SessionEntry} from '../types/session.js';
+
+type LifecycleEvent =
+  | {hook: 'beforeSession'; sessionId: string}
+  | {hook: 'onError'; session: ChatSession; error: Error}
+  | {hook: 'afterSession'; session: ChatSession; entriesSnapshot: SessionEntry[]}
+  | {hook: 'laterHook'; name: string};
+
+describe('beforeSession hook failure lifecycle', () => {
+  it('fires onError and afterSession in order and still rejects when beforeSession throws', async () => {
+    const thrown = new Error('beforeSession failed');
+    const events: LifecycleEvent[] = [];
+    const recordLaterHook =
+      <T>(name: string, outcome: T) =>
+      async (): Promise<T> => {
+        events.push({hook: 'laterHook', name});
+        return outcome;
+      };
+    const hooks: OrchestratorHooks = {
+      beforeSession: async currentSession => {
+        events.push({hook: 'beforeSession', sessionId: currentSession.sessionId});
+        throw thrown;
+      },
+      onError: async (currentSession, currentError) => {
+        events.push({hook: 'onError', session: currentSession, error: currentError});
+      },
+      afterSession: async currentSession => {
+        events.push({
+          hook: 'afterSession',
+          session: currentSession,
+          entriesSnapshot: [...currentSession.entries],
+        });
+      },
+      beforeUserInput: recordLaterHook('beforeUserInput', 'rewritten'),
+      afterUserInput: recordLaterHook('afterUserInput', undefined),
+      beforeModelResponse: recordLaterHook('beforeModelResponse', 'replaced'),
+      afterModelResponse: recordLaterHook('afterModelResponse', undefined),
+    };
+    const orchestrator = createChatOrchestrator(answering('model reply'), writeSignalPromptBuilder, undefined, {hooks});
+    const session: ChatSession = {
+      sessionId: 's-before-throw',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+
+    const rejection = await orchestrator.processMessage(session).then(
+      () => 'resolved without throwing',
+      (error: unknown) => error
+    );
+
+    expect({rejection, events}).toEqual({
+      rejection: thrown,
+      events: [
+        {hook: 'beforeSession', sessionId: 's-before-throw'},
+        {hook: 'onError', session, error: thrown},
+        {
+          hook: 'afterSession',
+          session,
+          entriesSnapshot: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+        },
+      ],
+    });
+  });
+});