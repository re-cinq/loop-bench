@@ -0,0 +1,86 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const rejectionOf = (turn: Promise<unknown>): Promise<unknown> =>
+  turn.then(
+    () => 'resolved without throwing',
+    (reason: unknown) => reason
+  );
+
+const recordingProvider = (phaseOrder: string[]): AIProvider => ({
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    phaseOrder.push('provider');
+    yield {type: 'text', text: 'ok'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+describe('ChatOrchestrator beforeSession failure lifecycle', () => {
+  it('runs onError then afterSession and still rejects when beforeSession throws', async () => {
+    const failure = new Error('span allocation failed');
+    const phaseOrder: string[] = [];
+    const seenErrors: Array<{session: ChatSession; error: Error}> = [];
+    const closedSessions: ChatSession[] = [];
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        phaseOrder.push('beforeSession');
+        throw failure;
+      },
+      beforeUserInput: async (_session, userMessage) => {
+        phaseOrder.push('beforeUserInput');
+        return userMessage;
+      },
+      afterUserInput: async () => {
+        phaseOrder.push('afterUserInput');
+      },
+      beforeModelResponse: async (_session, systemPrompt) => {
+        phaseOrder.push('beforeModelResponse');
+        return systemPrompt;
+      },
+      afterModelResponse: async () => {
+        phaseOrder.push('afterModelResponse');
+      },
+      onError: async (receivedSession, receivedError) => {
+        phaseOrder.push('onError');
+        seenErrors.push({session: receivedSession, error: receivedError});
+      },
+      afterSession: async receivedSession => {
+        phaseOrder.push('afterSession');
+        closedSessions.push(receivedSession);
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      recordingProvider(phaseOrder),
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      undefined,
+      {hooks}
+    );
+    const session: ChatSession = {
+      sessionId: 's-before-throw',
+      userId: 'u-1',
+      entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+    };
+
+    const rejectedWith = await rejectionOf(orchestrator.processMessage(session));
+
+    expect({
+      rejectedWith,
+      phaseOrder,
+      seenErrors,
+      closedSessions,
+    }).toEqual({
+      rejectedWith: failure,
+      phaseOrder: ['beforeSession', 'onError', 'afterSession'],
+      seenErrors: [{session, error: failure}],
+      closedSessions: [session],
+    });
+  });
+});