@@ -0,0 +1,60 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {answering, writeSignalPromptBuilder} from '../infrastructure/writeSignalTestSupport.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const rejectionOf = (call: Promise<unknown>): Promise<unknown> =>
+  call.then(
+    () => 'resolved without throwing',
+    (caught: unknown) => caught
+  );
+
+describe('ChatOrchestrator beforeSession failure lifecycle', () => {
+  it('fires onError and afterSession in order and still rejects when beforeSession throws', async () => {
+    const failure = new Error('beforeSession allocation failed');
+    const callOrder: string[] = [];
+    const onErrorCalls: Array<{session: ChatSession; error: Error}> = [];
+    const afterSessionCalls: ChatSession[] = [];
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw failure;
+      },
+      beforeUserInput: async (_currentSession, userMessage) => {
+        callOrder.push('beforeUserInput');
+        return userMessage;
+      },
+      onError: async (currentSession, error) => {
+        callOrder.push('onError');
+        onErrorCalls.push({session: currentSession, error});
+      },
+      afterSession: async currentSession => {
+        callOrder.push('afterSession');
+        afterSessionCalls.push(currentSession);
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(answering('unreachable'), writeSignalPromptBuilder, undefined, {hooks});
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+    };
+    const rejected = await rejectionOf(orchestrator.processMessage(session));
+
+    expect({
+      rejected,
+      callOrder,
+      onErrorCalls,
+      afterSessionCalls,
+    }).toEqual({
+      rejected: failure,
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+      onErrorCalls: [{session, error: failure}],
+      afterSessionCalls: [session],
+    });
+  });
+});