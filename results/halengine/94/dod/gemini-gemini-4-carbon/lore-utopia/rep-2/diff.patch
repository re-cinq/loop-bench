@@ -0,0 +1,107 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {ChatOrchestrator, OrchestratorHooks} from './chatOrchestrator.js';
+import {writeSignalPromptBuilder} from '../infrastructure/writeSignalTestSupport.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+interface TurnObservation {
+  rejectedWith: unknown;
+  order: string[];
+  onErrorCall: {sameSession: boolean; error: Error} | undefined;
+  afterSessionSameSession: boolean;
+  providerCalls: number;
+}
+
+const runThrowingBeforeSession = async (
+  failure: Error,
+  consume: (orchestrator: ChatOrchestrator, session: ChatSession) => Promise<void>
+): Promise<TurnObservation> => {
+  const order: string[] = [];
+  let onErrorCall: {sameSession: boolean; error: Error} | undefined;
+  let afterSessionSameSession = false;
+  let providerCalls = 0;
+
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      providerCalls += 1;
+      yield {type: 'text', text: 'unreachable'};
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+
+  const session: ChatSession = {
+    sessionId: 's-before-err',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+  };
+
+  const hooks: OrchestratorHooks = {
+    beforeSession: async () => {
+      order.push('beforeSession');
+      throw failure;
+    },
+    beforeUserInput: async (_session, userMessage) => {
+      order.push('beforeUserInput');
+      return userMessage;
+    },
+    afterUserInput: async () => {
+      order.push('afterUserInput');
+    },
+    beforeModelResponse: async (_session, systemPrompt) => {
+      order.push('beforeModelResponse');
+      return systemPrompt;
+    },
+    afterModelResponse: async () => {
+      order.push('afterModelResponse');
+    },
+    onError: async (currentSession, error) => {
+      order.push('onError');
+      onErrorCall = {sameSession: currentSession === session, error};
+    },
+    afterSession: async currentSession => {
+      order.push('afterSession');
+      afterSessionSameSession = currentSession === session;
+    },
+  };
+
+  const orchestrator = createChatOrchestrator(provider, writeSignalPromptBuilder, undefined, {hooks});
+  let rejectedWith: unknown = 'did-not-reject';
+
+  try {
+    await consume(orchestrator, session);
+  } catch (caught) {
+    rejectedWith = caught;
+  }
+
+  return {rejectedWith, order, onErrorCall, afterSessionSameSession, providerCalls};
+};
+
+describe('ChatOrchestrator when beforeSession throws', () => {
+  it('runs onError and afterSession and still rejects when beforeSession throws', async () => {
+    const failure = new Error('beforeSession failed');
+    const expected: TurnObservation = {
+      rejectedWith: failure,
+      order: ['beforeSession', 'onError', 'afterSession'],
+      onErrorCall: {sameSession: true, error: failure},
+      afterSessionSameSession: true,
+      providerCalls: 0,
+    };
+
+    const viaMessage = await runThrowingBeforeSession(failure, async (orchestrator, session) => {
+      await orchestrator.processMessage(session);
+    });
+    const viaStream = await runThrowingBeforeSession(failure, async (orchestrator, session) => {
+      const chunks: MessageChunk[] = [];
+      for await (const chunk of orchestrator.processMessageStream(session)) {
+        chunks.push(chunk);
+      }
+    });
+
+    expect({viaMessage, viaStream}).toEqual({viaMessage: expected, viaStream: expected});
+  });
+});