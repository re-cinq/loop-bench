+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {answering, writeSignalPromptBuilder} from '../infrastructure/writeSignalTestSupport.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+describe('ChatOrchestrator beforeSession failure lifecycle', () => {
+  it('runs onError then afterSession and rethrows when beforeSession throws', async () => {
+    const session: ChatSession = {
+      sessionId: 's-before-session-throw',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+    };
+    const thrownError = new Error('span allocation failed');
+    const callOrder: string[] = [];
+    const onErrorCalls: Array<[ChatSession, Error]> = [];
+    const afterSessionCalls: ChatSession[] = [];
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw thrownError;
+      },
+      beforeUserInput: async (_currentSession, userMessage) => {
+        callOrder.push('beforeUserInput');
+        return userMessage;
+      },
+      afterUserInput: async () => void callOrder.push('afterUserInput'),
+      beforeModelResponse: async (_currentSession, systemPrompt) => {
+        callOrder.push('beforeModelResponse');
+        return systemPrompt;
+      },
+      afterModelResponse: async () => void callOrder.push('afterModelResponse'),
+      onError: async (errorSession, caughtError) => {
+        callOrder.push('onError');
+        onErrorCalls.push([errorSession, caughtError]);
+      },
+      afterSession: async endedSession => {
+        callOrder.push('afterSession');
+        afterSessionCalls.push(endedSession);
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(answering('unused'), writeSignalPromptBuilder, undefined, {hooks});
+    const turnPromise = orchestrator.processMessage(session);
+    const rejection = await turnPromise.then(() => 'resolved without throwing').catch((caught: unknown) => caught);
+
+    expect({
+      rejection,
+      callOrder,
+      onErrorCalls,
+      afterSessionCalls,
+    }).toEqual({
+      rejection: thrownError,
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+      onErrorCalls: [[session, thrownError]],
+      afterSessionCalls: [session],
+    });
+  });
+});