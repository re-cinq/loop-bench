+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {answering, writeSignalPromptBuilder} from '../infrastructure/writeSignalTestSupport.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+describe('beforeSession failure lifecycle', () => {
+  it('runs onError with the error, runs afterSession, and rejects when beforeSession throws', async () => {
+    const failure = new Error('span allocation failed');
+    const onErrorCalls: {session: ChatSession; error: Error}[] = [];
+    const afterSessionSessions: ChatSession[] = [];
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw failure;
+      },
+      onError: async (currentSession, error) => {
+        onErrorCalls.push({session: currentSession, error});
+      },
+      afterSession: async currentSession => {
+        afterSessionSessions.push(currentSession);
+      },
+    };
+    const orchestrator = createChatOrchestrator(answering('unused'), writeSignalPromptBuilder, undefined, {hooks});
+    const session = sessionFor('s-before-error', 'hello');
+
+    const rejected = await orchestrator.processMessage(session).catch((caught: unknown) => caught);
+
+    expect({onErrorCalls, afterSessionSessions, rejected}).toEqual({
+      onErrorCalls: [{session, error: failure}],
+      afterSessionSessions: [session],
+      rejected: failure,
+    });
+  });
+
+  it('skips the turn and runs onError then afterSession when beforeSession throws on stream', async () => {
+    const failure = new Error('rate limit token unavailable');
+    const events: string[] = [];
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        events.push('provider');
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        events.push('beforeSession');
+        throw failure;
+      },
+      beforeUserInput: async (_session, userMessage) => {
+        events.push('beforeUserInput');
+        return userMessage;
+      },
+      afterUserInput: async () => {
+        events.push('afterUserInput');
+      },
+      beforeModelResponse: async (_session, systemPrompt) => {
+        events.push('beforeModelResponse');
+        return systemPrompt;
+      },
+      afterModelResponse: async () => {
+        events.push('afterModelResponse');
+      },
+      onError: async () => {
+        events.push('onError');
+      },
+      afterSession: async () => {
+        events.push('afterSession');
+      },
+    };
+    const orchestrator = createChatOrchestrator(provider, writeSignalPromptBuilder, undefined, {hooks});
+    const session = sessionFor('s-stream-error', 'hello');
+    const chunks: MessageChunk[] = [];
+    let rejected: unknown;
+
+    try {
+      for await (const chunk of orchestrator.processMessageStream(session)) {
+        chunks.push(chunk);
+      }
+    } catch (caught) {
+      rejected = caught;
+    }
+
+    expect({events, chunks, rejected}).toEqual({
+      events: ['beforeSession', 'onError', 'afterSession'],
+      chunks: [],
+      rejected: failure,
+    });
+  });
+});
+
+function sessionFor(sessionId: string, content: string): ChatSession {
+  return {
+    sessionId,
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}