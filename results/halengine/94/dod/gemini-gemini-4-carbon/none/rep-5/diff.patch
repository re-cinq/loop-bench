@@ -0,0 +1,118 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {writeSignalPromptBuilder} from '../infrastructure/writeSignalTestSupport.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const createSession = (): ChatSession => ({
+  sessionId: 's-before-session-error',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+});
+
+const captureRejection = (promise: Promise<unknown>): Promise<unknown> =>
+  promise.then(
+    () => undefined,
+    (error: unknown) => error
+  );
+
+describe('ChatOrchestrator when beforeSession throws', () => {
+  it('runs onError with the session and error, then afterSession, and still rejects', async () => {
+    const failure = new Error('span allocation failed');
+    const events: Array<{hook: string; session: ChatSession; error?: Error}> = [];
+    const hooks: OrchestratorHooks = {
+      beforeSession: async current => {
+        events.push({hook: 'beforeSession', session: current});
+        throw failure;
+      },
+      onError: async (current, error) => {
+        events.push({hook: 'onError', session: current, error});
+      },
+      afterSession: async current => {
+        events.push({hook: 'afterSession', session: current});
+      },
+    };
+    const orchestrator = createChatOrchestrator(recordingProvider().provider, writeSignalPromptBuilder, undefined, {
+      hooks,
+    });
+    const session = createSession();
+
+    const rejected = await captureRejection(orchestrator.processMessage(session));
+
+    expect({rejected, events}).toEqual({
+      rejected: failure,
+      events: [
+        {hook: 'beforeSession', session},
+        {hook: 'onError', session, error: failure},
+        {hook: 'afterSession', session},
+      ],
+    });
+  });
+
+  it('runs afterSession on processMessageStream with no later hook or provider call', async () => {
+    const failure = new Error('rate-limit token unavailable');
+    const ran: string[] = [];
+    let snapshotAtAfterSession: {ran: string[]; providerCalls: number} | undefined;
+    const {provider, state} = recordingProvider();
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        ran.push('beforeSession');
+        throw failure;
+      },
+      beforeUserInput: async (_current, userMessage) => {
+        ran.push('beforeUserInput');
+        return userMessage;
+      },
+      afterUserInput: async () => void ran.push('afterUserInput'),
+      beforeModelResponse: async (_current, systemPrompt) => {
+        ran.push('beforeModelResponse');
+        return systemPrompt;
+      },
+      afterModelResponse: async () => void ran.push('afterModelResponse'),
+      onError: async () => void ran.push('onError'),
+      afterSession: async () => {
+        snapshotAtAfterSession = {ran: [...ran], providerCalls: state.calls};
+        ran.push('afterSession');
+      },
+    };
+    const orchestrator = createChatOrchestrator(provider, writeSignalPromptBuilder, undefined, {hooks});
+    const session = createSession();
+
+    const outcome = await consumeStream(orchestrator.processMessageStream(session));
+
+    expect({outcome, ran, snapshotAtAfterSession}).toEqual({
+      outcome: {chunks: [], rejected: failure},
+      ran: ['beforeSession', 'onError', 'afterSession'],
+      snapshotAtAfterSession: {ran: ['beforeSession', 'onError'], providerCalls: 0},
+    });
+  });
+});
+
+function recordingProvider(): {provider: AIProvider; state: {calls: number}} {
+  const state = {calls: 0};
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      state.calls += 1;
+      yield {type: 'text', text: 'unreachable'};
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  return {provider, state};
+}
+
+async function consumeStream(
+  stream: AsyncGenerator<MessageChunk>
+): Promise<{chunks: MessageChunk[]; rejected: unknown}> {
+  const chunks: MessageChunk[] = [];
+  try {
+    for await (const chunk of stream) chunks.push(chunk);
+    return {chunks, rejected: undefined};
+  } catch (error) {
+    return {chunks, rejected: error};
+  }
+}