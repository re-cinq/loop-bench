+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {writeSignalPromptBuilder} from '../infrastructure/writeSignalTestSupport.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+interface RecordedHookEvent {
+  hook: string;
+  sameSession: boolean;
+  error?: Error;
+}
+
+describe('ChatOrchestrator when beforeSession throws', () => {
+  it('runs onError with the session and error, then afterSession, skips the rest of the turn, and still rejects', async () => {
+    const failure = new Error('allocation failed');
+    const session = turnSession('hello');
+    const events: RecordedHookEvent[] = [];
+    const hooks: OrchestratorHooks = {
+      beforeSession: async current => {
+        events.push({hook: 'beforeSession', sameSession: current === session});
+        throw failure;
+      },
+      beforeUserInput: async (current, message) => {
+        events.push({hook: 'beforeUserInput', sameSession: current === session});
+        return message;
+      },
+      afterUserInput: async current => void events.push({hook: 'afterUserInput', sameSession: current === session}),
+      beforeModelResponse: async (current, prompt) => {
+        events.push({hook: 'beforeModelResponse', sameSession: current === session});
+        return prompt;
+      },
+      afterModelResponse: async current =>
+        void events.push({hook: 'afterModelResponse', sameSession: current === session}),
+      onError: async (current, error) => void events.push({hook: 'onError', sameSession: current === session, error}),
+      afterSession: async current => void events.push({hook: 'afterSession', sameSession: current === session}),
+    };
+    const providerCalls: string[] = [];
+    const orchestrator = createChatOrchestrator(recordingProvider(providerCalls), writeSignalPromptBuilder, undefined, {
+      hooks,
+    });
+
+    const caught = await orchestrator.processMessage(session).catch((error: unknown) => error);
+
+    expect({caught, providerCalls, events}).toEqual({
+      caught: failure,
+      providerCalls: [],
+      events: [
+        {hook: 'beforeSession', sameSession: true},
+        {hook: 'onError', sameSession: true, error: failure},
+        {hook: 'afterSession', sameSession: true},
+      ],
+    });
+  });
+
+  it('runs afterSession on processMessageStream when beforeSession throws before completing setup', async () => {
+    const failure = new Error('rate limit check failed');
+    const resources = {spanOpened: false, spanClosed: false, tokenAcquired: false, tokenReleased: false};
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        resources.spanOpened = true;
+        throw failure;
+      },
+      afterSession: async () => {
+        if (resources.spanOpened) resources.spanClosed = true;
+        if (resources.tokenAcquired) resources.tokenReleased = true;
+      },
+    };
+    const providerCalls: string[] = [];
+    const orchestrator = createChatOrchestrator(recordingProvider(providerCalls), writeSignalPromptBuilder, undefined, {
+      hooks,
+    });
+    const session = turnSession('stream hello');
+    const chunks: MessageChunk[] = [];
+
+    const caught = await collectChunks(orchestrator.processMessageStream(session), chunks).catch(
+      (error: unknown) => error
+    );
+
+    expect({
+      caught,
+      chunks,
+      providerCalls,
+      spanClosed: resources.spanClosed,
+      tokenReleased: resources.tokenReleased,
+    }).toEqual({
+      caught: failure,
+      chunks: [],
+      providerCalls: [],
+      spanClosed: true,
+      tokenReleased: false,
+    });
+  });
+});
+
+function turnSession(content: string): ChatSession {
+  return {
+    sessionId: 's-before-session-throw',
+    userId: 'u-1',
+    entries: [{role: 'user', content, timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+}
+
+function recordingProvider(calls: string[]): AIProvider {
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      calls.push('sendMessage');
+      yield {type: 'text', text: 'ok'};
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('unused');
+    },
+  };
+}
+
+async function collectChunks(stream: AsyncGenerator<MessageChunk>, chunks: MessageChunk[]): Promise<void> {
+  for await (const chunk of stream) {
+    chunks.push(chunk);
+  }
+}