@@ -0,0 +1,100 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {ChatOrchestrator, OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {AIError} from '../types/ai.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('ChatOrchestrator when beforeSession throws', () => {
+  it('runs onError then afterSession and still rejects when beforeSession throws', async () => {
+    const session: ChatSession = {
+      sessionId: 's-before-session-throw',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const setupFailure = new Error('span allocation failed');
+
+    const viaStream = await observeTurnWhenBeforeSessionThrows(
+      async (orchestrator, targetSession) => {
+        const chunks: MessageChunk[] = [];
+        for await (const chunk of orchestrator.processMessageStream(targetSession)) {
+          chunks.push(chunk);
+        }
+        return chunks;
+      },
+      session,
+      setupFailure
+    );
+    const viaMessage = await observeTurnWhenBeforeSessionThrows(
+      (orchestrator, targetSession) => orchestrator.processMessage(targetSession),
+      session,
+      setupFailure
+    );
+
+    const expected = {
+      rejectedWith: setupFailure,
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+      onErrorReceived: [{session, error: setupFailure}],
+      afterSessionReceived: [session],
+    };
+    expect([viaStream, viaMessage]).toEqual([expected, expected]);
+  });
+});
+
+async function observeTurnWhenBeforeSessionThrows(
+  drive: (orchestrator: ChatOrchestrator, session: ChatSession) => Promise<unknown>,
+  session: ChatSession,
+  setupFailure: Error
+) {
+  const callOrder: string[] = [];
+  const recordStep = (stepName: string) => async () => {
+    callOrder.push(stepName);
+  };
+  const passThroughStep =
+    <T>(stepName: string) =>
+    async (_activeSession: ChatSession, input: T): Promise<T> => {
+      callOrder.push(stepName);
+      return input;
+    };
+
+  const onErrorReceived: Array<{session: ChatSession; error: Error}> = [];
+  const afterSessionReceived: ChatSession[] = [];
+  const hooks: OrchestratorHooks = {
+    beforeSession: async () => {
+      callOrder.push('beforeSession');
+      throw setupFailure;
+    },
+    beforeUserInput: passThroughStep('beforeUserInput'),
+    afterUserInput: recordStep('afterUserInput'),
+    beforeModelResponse: passThroughStep('beforeModelResponse'),
+    afterModelResponse: recordStep('afterModelResponse'),
+    onError: async (failedSession, error) => {
+      callOrder.push('onError');
+      onErrorReceived.push({session: failedSession, error});
+    },
+    afterSession: async endedSession => {
+      callOrder.push('afterSession');
+      afterSessionReceived.push(endedSession);
+    },
+  };
+
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      callOrder.push('provider');
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new AIError('Structured output unused in lifecycle test', 'UNSUPPORTED');
+    },
+  };
+
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Lifecycle test.'}), undefined, {
+    hooks,
+  });
+  const rejectedWith = await drive(orchestrator, session).then(
+    () => undefined,
+    (thrown: unknown) => thrown
+  );
+
+  return {rejectedWith, callOrder, onErrorReceived, afterSessionReceived};
+}