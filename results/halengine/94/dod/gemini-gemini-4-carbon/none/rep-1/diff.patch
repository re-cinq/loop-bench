+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('ChatOrchestrator when beforeSession throws', () => {
+  it('runs onError then afterSession and rethrows when beforeSession throws', async () => {
+    const events: string[] = [];
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        events.push('provider');
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const failure = new Error('span allocation failed');
+    let errorArgs: {session: ChatSession; error: Error} | undefined;
+    let afterSessionArg: ChatSession | undefined;
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        events.push('beforeSession');
+        throw failure;
+      },
+      beforeUserInput: async (_session, userMessage) => {
+        events.push('beforeUserInput');
+        return userMessage;
+      },
+      afterUserInput: async () => {
+        events.push('afterUserInput');
+      },
+      beforeModelResponse: async (_session, systemPrompt) => {
+        events.push('beforeModelResponse');
+        return systemPrompt;
+      },
+      afterModelResponse: async () => {
+        events.push('afterModelResponse');
+      },
+      onError: async (seenSession, seenError) => {
+        events.push('onError');
+        errorArgs = {session: seenSession, error: seenError};
+      },
+      afterSession: async seenSession => {
+        events.push('afterSession');
+        afterSessionArg = seenSession;
+      },
+    };
+
+    const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+    const session: ChatSession = {
+      sessionId: 's-before-session-throw',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+
+    const thrown = await orchestrator.processMessage(session).catch((caught: unknown) => caught);
+
+    expect({events, errorArgs, afterSessionArg, thrown}).toEqual({
+      events: ['beforeSession', 'onError', 'afterSession'],
+      errorArgs: {session, error: failure},
+      afterSessionArg: session,
+      thrown: failure,
+    });
+  });
+});