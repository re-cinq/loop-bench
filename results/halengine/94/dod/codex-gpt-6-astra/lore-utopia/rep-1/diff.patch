@@ -0,0 +1,77 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createBedrockProvider} from '../providers/bedrock/bedrockProvider.js';
+
+// @spec specs/hal-engine-config-hooks/spec.md#7
+it('reports and cleans up a failed beforeSession before rejecting with the original error', async () => {
+  const session: ChatSession = {
+    sessionId: 'failed-start',
+    userId: 'user',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const failure = new Error('session initialization failed');
+  const allocated = new Set<ChatSession>();
+  const events: string[] = [];
+  let errorSession: ChatSession | undefined;
+  let reportedError: Error | undefined;
+  let cleanupSession: ChatSession | undefined;
+  const hooks: OrchestratorHooks = {
+    beforeSession: async current => {
+      events.push('beforeSession');
+      allocated.add(current);
+      throw failure;
+    },
+    beforeUserInput: async (_current, message) => {
+      events.push('beforeUserInput');
+      return message;
+    },
+    beforeModelResponse: async (_current, prompt) => {
+      events.push('beforeModelResponse');
+      return prompt;
+    },
+    afterModelResponse: async () => {
+      events.push('afterModelResponse');
+    },
+    onError: async (current, error) => {
+      await Promise.resolve();
+      errorSession = current;
+      reportedError = error;
+      events.push('onError');
+    },
+    afterSession: async current => {
+      await Promise.resolve();
+      cleanupSession = current;
+      allocated.delete(current);
+      events.push('afterSession');
+    },
+  };
+  const orchestrator = createChatOrchestrator(
+    createBedrockProvider({type: 'bedrock', region: 'us-east-1', modelId: 'unused', maxTokens: 1}),
+    new PromptBuilder({identity: 'You are an assistant.'}),
+    undefined,
+    {hooks}
+  );
+
+  const outcome = await orchestrator.processMessage(session).then(
+    () => ({rejectedWithOriginalError: false}),
+    (error: unknown) => ({rejectedWithOriginalError: error === failure})
+  );
+
+  expect({
+    ...outcome,
+    events,
+    errorSessionIsOriginal: errorSession === session,
+    reportedErrorIsOriginal: reportedError === failure,
+    cleanupSessionIsOriginal: cleanupSession === session,
+    outstandingAllocations: allocated.size,
+  }).toEqual({
+    rejectedWithOriginalError: true,
+    events: ['beforeSession', 'onError', 'afterSession'],
+    errorSessionIsOriginal: true,
+    reportedErrorIsOriginal: true,
+    cleanupSessionIsOriginal: true,
+    outstandingAllocations: 0,
+  });
+});