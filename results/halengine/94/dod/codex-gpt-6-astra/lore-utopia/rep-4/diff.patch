@@ -0,0 +1,68 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {createBedrockProvider} from '../providers/bedrock/index.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+// @spec specs/hal-engine-config-hooks/spec.md#7
+it('reports and cleans up a failed beforeSession before rejecting with the original error', async () => {
+  const session: ChatSession = {
+    sessionId: 'failed-start',
+    userId: 'user',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const failure = new Error('session initialization failed');
+  const allocated = new Set<ChatSession>();
+  const events: string[] = [];
+  let errorArguments: unknown[] = [];
+  let cleanupArguments: unknown[] = [];
+  const hooks: OrchestratorHooks = {
+    beforeSession: async current => {
+      events.push('beforeSession');
+      allocated.add(current);
+      throw failure;
+    },
+    beforeUserInput: async (_current, message) => {
+      events.push('beforeUserInput');
+      return message;
+    },
+    onError: async (...args) => {
+      events.push('onError');
+      errorArguments = args;
+    },
+    afterSession: async (...args) => {
+      events.push('afterSession');
+      cleanupArguments = args;
+      allocated.delete(args[0]);
+    },
+  };
+  const provider = createBedrockProvider({
+    type: 'bedrock',
+    modelId: 'anthropic.claude-3-haiku-20240307-v1:0',
+    region: 'us-east-1',
+    maxTokens: 16,
+  });
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Assistant'}), undefined, {hooks});
+  const outcome: unknown = await orchestrator.processMessage(session).catch((error: unknown) => error);
+  events.push('caller');
+
+  expect({
+    originalRejection: outcome === failure,
+    events,
+    errorArgumentCount: errorArguments.length,
+    errorSessionIdentity: errorArguments[0] === session,
+    errorIdentity: errorArguments[1] === failure,
+    cleanupArgumentCount: cleanupArguments.length,
+    cleanupSessionIdentity: cleanupArguments[0] === session,
+    remainingAllocations: allocated.size,
+  }).toEqual({
+    originalRejection: true,
+    events: ['beforeSession', 'onError', 'afterSession', 'caller'],
+    errorArgumentCount: 2,
+    errorSessionIdentity: true,
+    errorIdentity: true,
+    cleanupArgumentCount: 1,
+    cleanupSessionIdentity: true,
+    remainingAllocations: 0,
+  });
+});