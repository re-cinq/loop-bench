@@ -0,0 +1,79 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createBedrockProvider} from '../providers/bedrock/bedrockProvider.js';
+import type {ChatSession} from '../types/session.js';
+
+// @spec specs/hal-engine-config-hooks/spec.md#8
+it('reports and cleans up a failed beforeSession before rejecting with the original error', async () => {
+  const session: ChatSession = {
+    sessionId: 'failed-start',
+    userId: 'user',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const failure = new Error('session initialization failed');
+  const events: string[] = [];
+  const allocations = new Set<ChatSession>();
+  let errorSession: ChatSession | undefined;
+  let reportedError: Error | undefined;
+  let cleanupSession: ChatSession | undefined;
+  const hooks: OrchestratorHooks = {
+    beforeSession: async current => {
+      events.push('beforeSession');
+      allocations.add(current);
+      throw failure;
+    },
+    beforeUserInput: async (_current, message) => {
+      events.push('beforeUserInput');
+      return message;
+    },
+    beforeModelResponse: async (_current, prompt) => {
+      events.push('beforeModelResponse');
+      return prompt;
+    },
+    onError: async (current, error) => {
+      await Promise.resolve();
+      events.push('onError');
+      errorSession = current;
+      reportedError = error;
+    },
+    afterSession: async current => {
+      await Promise.resolve();
+      events.push('afterSession');
+      cleanupSession = current;
+      allocations.delete(current);
+    },
+  };
+  const orchestrator = createChatOrchestrator(
+    createBedrockProvider({type: 'bedrock', region: 'us-east-1', modelId: 'unused', maxTokens: 1}),
+    new PromptBuilder({identity: 'Assistant'}),
+    undefined,
+    {hooks}
+  );
+
+  const outcome = await orchestrator.processMessage(session).then(
+    () => ({rejected: false, error: undefined}),
+    (error: unknown) => {
+      events.push('rejected');
+      return {rejected: true, error};
+    }
+  );
+
+  expect({
+    rejected: outcome.rejected,
+    originalError: outcome.error === failure,
+    reportedOriginalError: reportedError === failure,
+    reportedOriginalSession: errorSession === session,
+    cleanedOriginalSession: cleanupSession === session,
+    remainingAllocations: allocations.size,
+    events,
+  }).toEqual({
+    rejected: true,
+    originalError: true,
+    reportedOriginalError: true,
+    reportedOriginalSession: true,
+    cleanedOriginalSession: true,
+    remainingAllocations: 0,
+    events: ['beforeSession', 'onError', 'afterSession', 'rejected'],
+  });
+});