-- `beforeSession` is awaited before the `try` block opens ([chatOrchestrator.ts#L91](../../src/orchestration/chatOrchestrator.ts#L91)), so a throw there escapes before the `catch`/`finally` exist and skips both `onError` and `afterSession`.
 - The `catch` gates `onError` on `error instanceof Error` ([chatOrchestrator.ts#L150](../../src/orchestration/chatOrchestrator.ts#L150)), so a rejection that is not an `Error` — a thrown string or object — bypasses `onError` entirely while still propagating to the caller.
 - `afterModelResponse` is called once per user message after the round loop exits ([chatOrchestrator.ts#L148](../../src/orchestration/chatOrchestrator.ts#L148)), and is passed the `lastUsage` local — the most recent round's usage, not a sum across tool rounds, so a deployer using the hook for billing or audit under-counts every turn that ran tools.
diff --git a/src/orchestration/chatOrchestrator.acceptance.test.ts b/src/orchestration/chatOrchestrator.acceptance.test.ts
new file mode 100644
index 0000000..4efde8c
--- /dev/null
+++ b/src/orchestration/chatOrchestrator.acceptance.test.ts
@@ -0,0 +1,79 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {createBedrockProvider} from '../providers/bedrock/index.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+// @spec specs/hal-engine-config-hooks/spec.md#7
+it('reports and cleans up a failed beforeSession before rejecting with the original error', async () => {
+  const session: ChatSession = {
+    sessionId: 'failed-setup',
+    userId: 'user',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const failure = new Error('session setup failed');
+  const order: string[] = [];
+  let reportedSession: ChatSession | undefined;
+  let reportedError: Error | undefined;
+  let cleanedSession: ChatSession | undefined;
+  const resources = new Set<ChatSession>();
+  const hooks: OrchestratorHooks = {
+    beforeSession: async current => {
+      order.push('beforeSession');
+      resources.add(current);
+      await Promise.resolve();
+      throw failure;
+    },
+    beforeUserInput: async (_current, message) => {
+      order.push('beforeUserInput');
+      return message;
+    },
+    afterUserInput: async () => {
+      order.push('afterUserInput');
+    },
+    beforeModelResponse: async (_current, prompt) => {
+      order.push('beforeModelResponse');
+      return prompt;
+    },
+    afterModelResponse: async () => {
+      order.push('afterModelResponse');
+    },
+    onError: async (current, error) => {
+      await Promise.resolve();
+      order.push('onError');
+      reportedSession = current;
+      reportedError = error;
+    },
+    afterSession: async current => {
+      await Promise.resolve();
+      order.push('afterSession');
+      cleanedSession = current;
+      resources.delete(current);
+    },
+  };
+  // The real provider is never reached: setup fails before user input or model processing.
+  const provider = createBedrockProvider({type: 'bedrock', region: 'us-east-1', modelId: 'unused', maxTokens: 1});
+  const orchestrator = createChatOrchestrator(
+    provider,
+    new PromptBuilder({identity: 'You are an assistant.'}),
+    undefined,
+    {
+      hooks,
+    }
+  );
+  const rejection: unknown = await orchestrator.processMessage(session).catch((error: unknown) => error);
+
+  expect({
+    originalError: rejection === failure,
+    order,
+    errorArguments: reportedSession === session && reportedError === failure,
+    cleanupArgument: cleanedSession === session,
+    resourcesRemaining: resources.size,
+  }).toEqual({
+    originalError: true,
+    order: ['beforeSession', 'onError', 'afterSession'],
+    errorArguments: true,
+    cleanupArgument: true,
+    resourcesRemaining: 0,
+  });
+});