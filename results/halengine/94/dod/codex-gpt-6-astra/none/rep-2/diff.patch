@@ -0,0 +1,74 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createBedrockProvider} from '../providers/bedrock/bedrockProvider.js';
+import type {ChatSession} from '../types/session.js';
+
+// spec: specs/hal-engine-config-hooks/spec.md#7
+it('reports and cleans up a failed beforeSession before rejecting with the original error', async () => {
+  const session: ChatSession = {
+    sessionId: 'failed-start',
+    userId: 'user',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const failure = new Error('initialization failed after acquiring a resource');
+  const resources = new Set<ChatSession>();
+  const events: string[] = [];
+  let errorArgs: Parameters<NonNullable<OrchestratorHooks['onError']>> | undefined;
+  let cleanupArgs: Parameters<NonNullable<OrchestratorHooks['afterSession']>> | undefined;
+  const hooks: OrchestratorHooks = {
+    beforeSession: async current => {
+      events.push('beforeSession');
+      resources.add(current);
+      await Promise.resolve();
+      throw failure;
+    },
+    beforeUserInput: async (_current, message) => {
+      events.push('beforeUserInput');
+      return message;
+    },
+    onError: async (...args) => {
+      await Promise.resolve();
+      errorArgs = args;
+      events.push('onError');
+    },
+    afterSession: async (...args) => {
+      await Promise.resolve();
+      cleanupArgs = args;
+      resources.delete(args[0]);
+      events.push('afterSession');
+    },
+  };
+  const provider = createBedrockProvider({
+    type: 'bedrock',
+    modelId: 'unused-before-session-completes',
+    region: 'eu-west-1',
+    maxTokens: 16,
+  });
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Assistant'}), undefined, {hooks});
+
+  const rejection: unknown = await orchestrator.processMessage(session).catch((error: unknown) => {
+    events.push('caller');
+    return error;
+  });
+
+  expect({
+    events,
+    originalRejection: rejection === failure,
+    errorArgumentCount: errorArgs?.length,
+    errorSession: errorArgs?.[0] === session,
+    originalError: errorArgs?.[1] === failure,
+    cleanupArgumentCount: cleanupArgs?.length,
+    cleanupSession: cleanupArgs?.[0] === session,
+    unreleasedResources: resources.size,
+  }).toEqual({
+    events: ['beforeSession', 'onError', 'afterSession', 'caller'],
+    originalRejection: true,
+    errorArgumentCount: 2,
+    errorSession: true,
+    originalError: true,
+    cleanupArgumentCount: 1,
+    cleanupSession: true,
+    unreleasedResources: 0,
+  });
+});