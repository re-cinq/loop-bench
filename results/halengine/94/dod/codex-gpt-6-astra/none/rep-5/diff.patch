@@ -0,0 +1,68 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import type {ChatSession} from '../types/session.js';
+
+// spec: specs/hal-engine-config-hooks/spec.md#7
+it('reports and cleans up a failed beforeSession before rejecting with the original error', async () => {
+  const observations = [];
+  for (const streaming of [false, true]) {
+    const session: ChatSession = {
+      sessionId: 'failed-start',
+      userId: 'user',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const failure = new Error('session initialization failed');
+    const events: string[] = [];
+    const allocated = new Set<ChatSession>();
+    const hooks: OrchestratorHooks = {
+      beforeSession: async current => {
+        allocated.add(current);
+        events.push('beforeSession');
+        throw failure;
+      },
+      beforeUserInput: async (_current, message) => {
+        events.push('beforeUserInput');
+        return message;
+      },
+      onError: async (current, error) => {
+        await Promise.resolve();
+        events.push(
+          current === session && error === failure ? 'onError(session, originalError)' : 'wrong error arguments'
+        );
+      },
+      afterSession: async current => {
+        await Promise.resolve();
+        events.push(current === session ? 'afterSession(session)' : 'wrong cleanup session');
+        allocated.delete(current);
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      createMockProvider(),
+      new PromptBuilder({identity: 'You are an assistant.'}),
+      undefined,
+      {hooks}
+    );
+    let rejection: unknown;
+    try {
+      if (streaming) {
+        for await (const chunk of orchestrator.processMessageStream(session)) events.push(chunk.type);
+      } else {
+        await orchestrator.processMessage(session);
+      }
+    } catch (error) {
+      rejection = error;
+      events.push('caller rejection');
+    }
+    observations.push({events, originalError: rejection === failure, resourcesRemaining: allocated.size});
+  }
+
+  expect(observations).toEqual(
+    [false, true].map(() => ({
+      events: ['beforeSession', 'onError(session, originalError)', 'afterSession(session)', 'caller rejection'],
+      originalError: true,
+      resourcesRemaining: 0,
+    }))
+  );
+});