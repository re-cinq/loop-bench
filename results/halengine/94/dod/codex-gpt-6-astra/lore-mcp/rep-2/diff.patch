+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createBedrockProvider} from '../providers/bedrock/bedrockProvider.js';
+import type {ChatSession} from '../types/session.js';
+
+// @spec specs/hal-engine-config-hooks/spec.md#7
+it('reports and cleans up a failed beforeSession before rejecting with the original error', async () => {
+  const session: ChatSession = {
+    sessionId: 'failed-setup',
+    userId: 'user-1',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const failure = new Error('session setup failed after allocation');
+  const resource = new AbortController();
+  const events: string[] = [];
+  let errorArguments: unknown[] = [];
+  let cleanupArguments: unknown[] = [];
+  const hooks: OrchestratorHooks = {
+    beforeSession: async () => {
+      events.push('beforeSession');
+      await Promise.resolve();
+      throw failure;
+    },
+    beforeUserInput: async (_session, message) => {
+      events.push('beforeUserInput');
+      return message;
+    },
+    afterUserInput: async () => void events.push('afterUserInput'),
+    beforeModelResponse: async (_session, prompt) => {
+      events.push('beforeModelResponse');
+      return prompt;
+    },
+    afterModelResponse: async () => void events.push('afterModelResponse'),
+    onError: async (...args) => {
+      await Promise.resolve();
+      errorArguments = args;
+      events.push('onError');
+    },
+    afterSession: async (...args) => {
+      await Promise.resolve();
+      cleanupArguments = args;
+      resource.abort();
+      events.push('afterSession');
+    },
+  };
+  const provider = createBedrockProvider({
+    type: 'bedrock',
+    modelId: 'anthropic.claude-3-haiku-20240307-v1:0',
+    region: 'us-east-1',
+    maxTokens: 32,
+  });
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Assistant'}), undefined, {hooks});
+  const rejection: unknown = await orchestrator.processMessage(session).then(
+    () => undefined,
+    (error: unknown) => {
+      events.push('rejected');
+      return error;
+    }
+  );
+
+  expect({
+    originalRejection: rejection === failure,
+    events,
+    errorArgumentCount: errorArguments.length,
+    errorSession: errorArguments[0] === session,
+    originalHookError: errorArguments[1] === failure,
+    cleanupArgumentCount: cleanupArguments.length,
+    cleanupSession: cleanupArguments[0] === session,
+    released: resource.signal.aborted,
+  }).toEqual({
+    originalRejection: true,
+    events: ['beforeSession', 'onError', 'afterSession', 'rejected'],
+    errorArgumentCount: 2,
+    errorSession: true,
+    originalHookError: true,
+    cleanupArgumentCount: 1,
+    cleanupSession: true,
+    released: true,
+  });
+});