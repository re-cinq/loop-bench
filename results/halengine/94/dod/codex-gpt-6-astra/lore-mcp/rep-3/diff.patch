+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createBedrockProvider} from '../providers/bedrock/bedrockProvider.js';
+
+// @spec specs/hal-engine-config-hooks/spec.md#8
+it('reports and cleans up a failed beforeSession before rejecting with the original error', async () => {
+  const session: ChatSession = {sessionId: 'failed-start', userId: 'user', entries: []};
+  const failure = new Error('session initialization failed');
+  const allocated = new Set<ChatSession>();
+  const events: string[] = [];
+  const errors: Parameters<NonNullable<OrchestratorHooks['onError']>>[] = [];
+  const cleanups: Parameters<NonNullable<OrchestratorHooks['afterSession']>>[] = [];
+  const hooks: OrchestratorHooks = {
+    beforeSession: async current => {
+      allocated.add(current);
+      events.push('beforeSession');
+      throw failure;
+    },
+    beforeUserInput: async (_current, message) => {
+      events.push('beforeUserInput');
+      return message;
+    },
+    onError: async (...args) => {
+      await Promise.resolve();
+      errors.push(args);
+      events.push('onError');
+    },
+    afterSession: async (...args) => {
+      await Promise.resolve();
+      cleanups.push(args);
+      allocated.delete(args[0]);
+      events.push('afterSession');
+    },
+  };
+  const provider = createBedrockProvider({type: 'bedrock', region: 'us-east-1', modelId: 'unused', maxTokens: 1});
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Assistant'}), undefined, {hooks});
+
+  const rejection: unknown = await orchestrator.processMessage(session).catch((error: unknown) => error);
+
+  expect({
+    originalRejection: rejection === failure,
+    events,
+    errorArguments: errors.map(args => [args.length, args[0] === session, args[1] === failure]),
+    cleanupArguments: cleanups.map(args => [args.length, args[0] === session]),
+    resourcesRemaining: allocated.size,
+    entries: session.entries,
+  }).toEqual({
+    originalRejection: true,
+    events: ['beforeSession', 'onError', 'afterSession'],
+    errorArguments: [[2, true, true]],
+    cleanupArguments: [[1, true]],
+    resourcesRemaining: 0,
+    entries: [],
+  });
+});