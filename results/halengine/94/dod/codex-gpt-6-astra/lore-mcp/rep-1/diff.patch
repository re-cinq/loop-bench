@@ -0,0 +1,70 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createBedrockProvider} from '../providers/bedrock/bedrockProvider.js';
+import type {ChatSession} from '../types/session.js';
+
+// @spec specs/hal-engine-config-hooks/spec.md#7
+it('reports and cleans up a failed beforeSession before rejecting with the original error', async () => {
+  const session: ChatSession = {
+    sessionId: 'failed-start',
+    userId: 'user',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const failure = new Error('initialization failed');
+  const events: string[] = [];
+  const resources = new Set<ChatSession>();
+  let errorSession: ChatSession | undefined;
+  let reportedError: Error | undefined;
+  let cleanupSession: ChatSession | undefined;
+  const orchestrator = createChatOrchestrator(
+    createBedrockProvider({type: 'bedrock', region: 'eu-west-1', modelId: 'unused', maxTokens: 1}),
+    new PromptBuilder({identity: 'You are an assistant.'}),
+    undefined,
+    {
+      hooks: {
+        beforeSession: async current => {
+          events.push('beforeSession');
+          resources.add(current);
+          throw failure;
+        },
+        beforeUserInput: async (_current, message) => {
+          events.push('beforeUserInput');
+          return message;
+        },
+        onError: async (current, error) => {
+          await Promise.resolve();
+          events.push('onError');
+          errorSession = current;
+          reportedError = error;
+        },
+        afterSession: async current => {
+          await Promise.resolve();
+          events.push('afterSession');
+          cleanupSession = current;
+          resources.delete(current);
+        },
+      },
+    }
+  );
+
+  const rejection: unknown = await orchestrator.processMessage(session).catch((error: unknown) => error);
+  events.push('caller');
+
+  expect({
+    events,
+    originalRejection: rejection === failure,
+    originalReportedError: reportedError === failure,
+    sameErrorSession: errorSession === session,
+    sameCleanupSession: cleanupSession === session,
+    remainingResources: resources.size,
+    entries: session.entries,
+  }).toEqual({
+    events: ['beforeSession', 'onError', 'afterSession', 'caller'],
+    originalRejection: true,
+    originalReportedError: true,
+    sameErrorSession: true,
+    sameCleanupSession: true,
+    remainingResources: 0,
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  });
+});