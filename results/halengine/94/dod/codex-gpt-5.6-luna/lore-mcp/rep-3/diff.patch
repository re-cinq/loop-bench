+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {ChatSession} from '../types/session.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+
+const session: ChatSession = {
+  sessionId: 'session-1',
+  userId: 'user-1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+it('runs onError then afterSession when beforeSession throws, and still rejects to the caller', async () => {
+  const callOrder: string[] = [];
+  const beforeSessionError = new Error('beforeSession failed');
+  let receivedError: Error | undefined;
+  let afterSessionId = '';
+  const hooks: OrchestratorHooks = {
+    beforeSession: async () => {
+      callOrder.push('beforeSession');
+      throw beforeSessionError;
+    },
+    onError: async (receivedSession, error) => {
+      callOrder.push('onError');
+      receivedError = error;
+      expect(receivedSession).toBe(session);
+    },
+    afterSession: async receivedSession => {
+      callOrder.push('afterSession');
+      afterSessionId = receivedSession.sessionId;
+    },
+  };
+
+  const orchestrator = createChatOrchestrator(
+    createMockProvider(),
+    new PromptBuilder({identity: 'You are a test assistant.'}),
+    undefined,
+    {hooks}
+  );
+
+  const outcome = await orchestrator.processMessage(session).then(
+    () => 'resolved without throwing',
+    (error: Error) => error.message
+  );
+
+  expect({outcome, receivedError, afterSessionId, callOrder}).toEqual({
+    outcome: 'beforeSession failed',
+    receivedError: beforeSessionError,
+    afterSessionId: 'session-1',
+    callOrder: ['beforeSession', 'onError', 'afterSession'],
+  });
+});