+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// spec: specs/hal-engine-config-hooks/spec.md#1
+it('runs onError then afterSession when beforeSession throws, and still rejects to the caller', async () => {
+  const session: ChatSession = {
+    sessionId: 'acceptance-session',
+    userId: 'acceptance-user',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const failure = new Error('beforeSession boom');
+  const callOrder: string[] = [];
+  let onErrorArgument: Error | undefined;
+
+  const hooks: OrchestratorHooks = {
+    beforeSession: async () => {
+      callOrder.push('beforeSession');
+      throw failure;
+    },
+    onError: async (_session, error) => {
+      callOrder.push('onError');
+      onErrorArgument = error;
+    },
+    afterSession: async () => {
+      callOrder.push('afterSession');
+    },
+  };
+  const provider: AIProvider = {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'acceptance'}), undefined, {
+    hooks,
+  });
+
+  let callerError: unknown;
+  try {
+    await orchestrator.processMessage(session);
+  } catch (error) {
+    callerError = error;
+  }
+
+  expect({callerError, onErrorArgument, callOrder}).toEqual({
+    callerError: failure,
+    onErrorArgument: failure,
+    callOrder: ['beforeSession', 'onError', 'afterSession'],
+  });
+});