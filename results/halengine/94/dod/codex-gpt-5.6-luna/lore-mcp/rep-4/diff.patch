+import {createMockProvider} from '../providers/mock/index.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {ChatSession} from '../types/session.js';
+
+const session: ChatSession = {
+  sessionId: 'acceptance-session',
+  userId: 'acceptance-user',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+describe('beforeSession failure lifecycle', () => {
+  it('rethrows the beforeSession error and runs onError before afterSession', async () => {
+    const error = new Error('beforeSession failed');
+    const events: Array<{hook: 'onError' | 'afterSession'; session: ChatSession; error?: Error}> = [];
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw error;
+      },
+      onError: async (receivedSession, receivedError) => {
+        events.push({hook: 'onError', session: receivedSession, error: receivedError});
+      },
+      afterSession: async receivedSession => {
+        events.push({hook: 'afterSession', session: receivedSession});
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      createMockProvider(),
+      new PromptBuilder({identity: 'Acceptance test assistant.'}),
+      undefined,
+      {hooks}
+    );
+
+    await expect(orchestrator.processMessage(session)).rejects.toBe(error);
+
+    expect(events).toEqual([
+      {hook: 'onError', session, error},
+      {hook: 'afterSession', session},
+    ]);
+  });
+});