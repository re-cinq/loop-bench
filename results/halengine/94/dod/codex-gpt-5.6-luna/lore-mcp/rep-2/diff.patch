@@ -0,0 +1,66 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+const provider: AIProvider = {
+  async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'unreachable'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+it('runs onError then afterSession when beforeSession throws, and still rejects to the caller', async () => {
+  const beforeSessionError = new Error('beforeSession boom');
+  const callOrder: string[] = [];
+  let onErrorError: Error | undefined;
+  let onErrorSession: ChatSession | undefined;
+  let afterSessionSession: ChatSession | undefined;
+  const session: ChatSession = {
+    sessionId: 'before-session-failure',
+    userId: 'user-1',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), undefined, {
+    hooks: {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw beforeSessionError;
+      },
+      beforeUserInput: async (_session, message) => {
+        callOrder.push('beforeUserInput');
+        return message;
+      },
+      beforeModelResponse: async (_session, prompt) => {
+        callOrder.push('beforeModelResponse');
+        return prompt;
+      },
+      onError: async (receivedSession, error) => {
+        callOrder.push('onError');
+        onErrorSession = receivedSession;
+        onErrorError = error;
+      },
+      afterSession: async receivedSession => {
+        callOrder.push('afterSession');
+        afterSessionSession = receivedSession;
+      },
+    },
+  });
+
+  let callerError: unknown;
+  try {
+    await orchestrator.processMessage(session);
+  } catch (error) {
+    callerError = error;
+  }
+
+  expect(callerError).toBe(beforeSessionError);
+  expect(onErrorError).toBe(beforeSessionError);
+  expect(onErrorSession).toBe(session);
+  expect(afterSessionSession).toBe(session);
+  expect(callOrder).toEqual(['beforeSession', 'onError', 'afterSession']);
+});