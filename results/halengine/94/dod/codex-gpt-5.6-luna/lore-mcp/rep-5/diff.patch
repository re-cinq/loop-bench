+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const provider: AIProvider = {
+  async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'unreachable'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+const session: ChatSession = {
+  sessionId: 's-before-session-failure',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+};
+
+describe('beforeSession failure lifecycle', () => {
+  it('calls onError and afterSession, then rejects with the beforeSession error', async () => {
+    const failure = new Error('before session failed');
+    const calls: string[] = [];
+    let receivedSession: ChatSession | undefined;
+    let receivedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        calls.push('beforeSession');
+        throw failure;
+      },
+      onError: async (hookSession, error) => {
+        calls.push('onError');
+        receivedSession = hookSession;
+        receivedError = error;
+      },
+      afterSession: async hookSession => {
+        calls.push('afterSession');
+        expect(hookSession).toBe(session);
+      },
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), undefined, {hooks});
+
+    await expect(orchestrator.processMessage(session)).rejects.toBe(failure);
+
+    expect({calls, receivedSession, receivedError}).toEqual({
+      calls: ['beforeSession', 'onError', 'afterSession'],
+      receivedSession: session,
+      receivedError: failure,
+    });
+  });
+});