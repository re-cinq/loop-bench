+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const session: ChatSession = {
+  sessionId: 'session-1',
+  userId: 'user-1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+let providerCalls = 0;
+
+const provider: AIProvider = {
+  async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    providerCalls += 1;
+    yield {type: 'text', text: 'unused'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+it('runs onError then afterSession when beforeSession throws, and preserves the rejection', async () => {
+  const failure = new Error('before-session failed');
+  const calls: string[] = [];
+  let receivedSession: ChatSession | undefined;
+  let receivedError: Error | undefined;
+  let afterSessionSession: ChatSession | undefined;
+
+  const hooks: OrchestratorHooks = {
+    beforeSession: async () => {
+      calls.push('beforeSession');
+      throw failure;
+    },
+    beforeUserInput: async (_session, message) => {
+      calls.push('beforeUserInput');
+      return message;
+    },
+    onError: async (hookSession, error) => {
+      calls.push('onError');
+      receivedSession = hookSession;
+      receivedError = error;
+    },
+    afterSession: async hookSession => {
+      calls.push('afterSession');
+      afterSessionSession = hookSession;
+    },
+  };
+
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test assistant'}), undefined, {
+    hooks,
+  });
+
+  let rejection: unknown;
+  try {
+    await orchestrator.processMessage(session);
+  } catch (error) {
+    rejection = error;
+  }
+
+  expect({rejection, calls, receivedSession, receivedError, afterSessionSession, providerCalls}).toEqual({
+    rejection: failure,
+    calls: ['beforeSession', 'onError', 'afterSession'],
+    receivedSession: session,
+    receivedError: failure,
+    afterSessionSession: session,
+    providerCalls: 0,
+  });
+});