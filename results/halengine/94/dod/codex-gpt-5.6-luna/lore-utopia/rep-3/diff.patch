+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const session = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+});
+
+const providerThatMustNotRun: AIProvider = {
+  async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    throw new Error('provider should not run after beforeSession fails');
+  },
+  async generateStructured<T>(): Promise<T> {
+    throw new Error('provider should not run after beforeSession fails');
+  },
+};
+
+describe('beforeSession failure acceptance', () => {
+  it('runs onError then afterSession when beforeSession throws, and still rejects to the caller', async () => {
+    const beforeError = new Error('beforeSession failed');
+    const calls: string[] = [];
+    let receivedError: Error | undefined;
+    let receivedErrorSession: ChatSession | undefined;
+    let afterSessionEntryCount = -1;
+    let afterSessionReceivedSession: ChatSession | undefined;
+    const currentSession = session();
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        calls.push('beforeSession');
+        throw beforeError;
+      },
+      onError: async (receivedSession, error) => {
+        calls.push('onError');
+        receivedErrorSession = receivedSession;
+        receivedError = error;
+      },
+      afterSession: async receivedSession => {
+        calls.push('afterSession');
+        afterSessionReceivedSession = receivedSession;
+        afterSessionEntryCount = receivedSession.entries.length;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      providerThatMustNotRun,
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      undefined,
+      {hooks}
+    );
+
+    await expect(orchestrator.processMessage(currentSession)).rejects.toBe(beforeError);
+
+    expect({
+      calls,
+      receivedError,
+      receivedErrorSession,
+      afterSessionReceivedSession,
+      afterSessionEntryCount,
+    }).toEqual({
+      calls: ['beforeSession', 'onError', 'afterSession'],
+      receivedError: beforeError,
+      receivedErrorSession: currentSession,
+      afterSessionReceivedSession: currentSession,
+      afterSessionEntryCount: 1,
+    });
+  });
+});