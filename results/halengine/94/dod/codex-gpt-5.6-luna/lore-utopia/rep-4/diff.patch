+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+const session: ChatSession = {
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+const provider: AIProvider = {
+  async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'unused'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+it('runs error and cleanup hooks when beforeSession throws, then rethrows the same error', async () => {
+  const order: string[] = [];
+  const beforeSessionError = new Error('beforeSession failed');
+  let receivedError: Error | undefined;
+  let receivedSession: ChatSession | undefined;
+  let providerCalled = false;
+
+  const hooks: OrchestratorHooks = {
+    beforeSession: async () => {
+      order.push('beforeSession');
+      throw beforeSessionError;
+    },
+    onError: async (hookSession, error) => {
+      order.push('onError');
+      receivedSession = hookSession;
+      receivedError = error;
+    },
+    afterSession: async hookSession => {
+      order.push('afterSession');
+      receivedSession = hookSession;
+    },
+  };
+
+  const orchestrator = createChatOrchestrator(
+    {
+      ...provider,
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        providerCalled = true;
+        yield* provider.sendMessage(params);
+      },
+    },
+    new PromptBuilder({identity: 'You are a test assistant.'}),
+    undefined,
+    {hooks}
+  );
+
+  await expect(orchestrator.processMessage(session)).rejects.toBe(beforeSessionError);
+  expect({order, receivedError, receivedSession, providerCalled}).toEqual({
+    order: ['beforeSession', 'onError', 'afterSession'],
+    receivedError: beforeSessionError,
+    receivedSession: session,
+    providerCalled: false,
+  });
+});