+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import type {ChatSession} from '../types/session.js';
+
+const session: ChatSession = {
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+// spec: specs/hal-engine-config-hooks/spec.md#1
+it('runs onError and afterSession when beforeSession throws', async () => {
+  const failure = new Error('before session failed');
+  const events: string[] = [];
+  let onErrorSession: ChatSession | undefined;
+  let onErrorFailure: Error | undefined;
+  let afterSessionSession: ChatSession | undefined;
+
+  const orchestrator = createChatOrchestrator(
+    createMockProvider(),
+    new PromptBuilder({identity: 'assistant'}),
+    undefined,
+    {
+      hooks: {
+        beforeSession: async () => {
+          events.push('beforeSession');
+          throw failure;
+        },
+        onError: async (receivedSession, error) => {
+          events.push('onError');
+          onErrorSession = receivedSession;
+          onErrorFailure = error;
+        },
+        afterSession: async receivedSession => {
+          events.push('afterSession');
+          afterSessionSession = receivedSession;
+        },
+      },
+    }
+  );
+
+  await expect(orchestrator.processMessage(session)).rejects.toBe(failure);
+
+  expect({events, onErrorSession, onErrorFailure, afterSessionSession}).toEqual({
+    events: ['beforeSession', 'onError', 'afterSession'],
+    onErrorSession: session,
+    onErrorFailure: failure,
+    afterSessionSession: session,
+  });
+});