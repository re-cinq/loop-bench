+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {ChatSession} from '../types/session.js';
+
+const session: ChatSession = {
+  sessionId: 'acceptance-session',
+  userId: 'acceptance-user',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+it('runs onError and afterSession when beforeSession throws', async () => {
+  const error = new Error('before session failed');
+  const calls: string[] = [];
+  let receivedSession: ChatSession | undefined;
+  let receivedError: Error | undefined;
+
+  const orchestrator = createChatOrchestrator(createMockProvider(), new PromptBuilder({identity: 'test'}), undefined, {
+    hooks: {
+      beforeSession: async () => {
+        calls.push('beforeSession');
+        throw error;
+      },
+      onError: async (hookSession, hookError) => {
+        calls.push('onError');
+        receivedSession = hookSession;
+        receivedError = hookError;
+      },
+      afterSession: async hookSession => {
+        calls.push('afterSession');
+        receivedSession = hookSession;
+      },
+    },
+  });
+
+  await expect(orchestrator.processMessage(session)).rejects.toBe(error);
+
+  expect({calls, receivedSession, receivedError}).toEqual({
+    calls: ['beforeSession', 'onError', 'afterSession'],
+    receivedSession: session,
+    receivedError: error,
+  });
+});