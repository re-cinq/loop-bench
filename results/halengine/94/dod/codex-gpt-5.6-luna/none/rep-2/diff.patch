+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+
+const session: ChatSession = {
+  sessionId: 'before-session-error',
+  userId: 'user-1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+describe('beforeSession failure lifecycle', () => {
+  it('rejects unchanged and runs onError before afterSession when beforeSession throws', async () => {
+    const failure = new Error('beforeSession failed');
+    const events: string[] = [];
+    let receivedSession: ChatSession | undefined;
+    let receivedError: Error | undefined;
+    const orchestrator = createChatOrchestrator(
+      createMockProvider(),
+      new PromptBuilder({identity: 'test'}),
+      undefined,
+      {
+        hooks: {
+          beforeSession: async () => {
+            events.push('beforeSession');
+            throw failure;
+          },
+          onError: async (hookSession, error) => {
+            events.push('onError');
+            receivedSession = hookSession;
+            receivedError = error;
+          },
+          afterSession: async hookSession => {
+            events.push('afterSession');
+            receivedSession = hookSession;
+          },
+        },
+      }
+    );
+
+    let rejection: unknown;
+    try {
+      await orchestrator.processMessage(session);
+    } catch (error) {
+      rejection = error;
+    }
+
+    expect(rejection).toBe(failure);
+    expect(events).toEqual(['beforeSession', 'onError', 'afterSession']);
+    expect(receivedError).toBe(failure);
+    expect(receivedSession).toBe(session);
+  });
+});