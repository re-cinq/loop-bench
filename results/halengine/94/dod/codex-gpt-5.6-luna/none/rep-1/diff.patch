@@ -0,0 +1,59 @@
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const session: ChatSession = {
+  sessionId: 's-before-session-failure',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+function createStubProvider(): AIProvider {
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      yield {type: 'text', text: 'hello'};
+      yield {type: 'stop', stopReason: 'end_turn', usage: undefined};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+// spec: specs/hal-engine-config-hooks#7
+describe('beforeSession failure lifecycle', () => {
+  it('propagates the failure, calls onError, and still calls afterSession', async () => {
+    const failure = new Error('beforeSession failed');
+    const events: Array<{name: string; session?: ChatSession; error?: Error}> = [];
+    const hooks = {
+      beforeSession: async () => {
+        throw failure;
+      },
+      onError: async (receivedSession: ChatSession, error: Error) => {
+        events.push({name: 'onError', session: receivedSession, error});
+      },
+      afterSession: async (receivedSession: ChatSession) => {
+        events.push({name: 'afterSession', session: receivedSession});
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      createStubProvider(),
+      new PromptBuilder({identity: 'test'}),
+      undefined,
+      {hooks}
+    );
+
+    let caughtError: unknown;
+    await orchestrator.processMessage(session).catch((e: unknown) => {
+      caughtError = e;
+    });
+    expect({caughtError, events}).toEqual({
+      caughtError: failure,
+      events: [
+        {name: 'onError', session, error: failure},
+        {name: 'afterSession', session},
+      ],
+    });
+  });
+});
