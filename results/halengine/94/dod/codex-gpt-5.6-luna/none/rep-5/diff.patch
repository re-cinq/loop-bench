@@ -0,0 +1,55 @@
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {ChatSession} from '../types/session.js';
+
+// spec: specs/hal-engine-config-hooks#7
+it('rethrows a beforeSession failure after onError and afterSession run', async () => {
+  const session: ChatSession = {
+    sessionId: 'acceptance-session',
+    userId: 'acceptance-user',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const failure = new Error('beforeSession failed');
+  const order: string[] = [];
+  let onErrorSession: ChatSession | undefined;
+  let onErrorFailure: Error | undefined;
+  let afterSessionSession: ChatSession | undefined;
+  const hooks: OrchestratorHooks = {
+    beforeSession: async () => {
+      order.push('beforeSession');
+      throw failure;
+    },
+    onError: async (receivedSession, receivedFailure) => {
+      order.push('onError');
+      onErrorSession = receivedSession;
+      onErrorFailure = receivedFailure;
+    },
+    afterSession: async receivedSession => {
+      order.push('afterSession');
+      afterSessionSession = receivedSession;
+    },
+  };
+  const orchestrator = createChatOrchestrator(
+    createMockProvider(),
+    new PromptBuilder({identity: 'acceptance test'}),
+    undefined,
+    {hooks}
+  );
+
+  let caught: unknown;
+  try {
+    await orchestrator.processMessage(session);
+  } catch (error) {
+    caught = error;
+  }
+
+  expect(caught).toBe(failure);
+  expect({onErrorSession, onErrorFailure, afterSessionSession, order}).toEqual({
+    onErrorSession: session,
+    onErrorFailure: failure,
+    afterSessionSession: session,
+    order: ['beforeSession', 'onError', 'afterSession'],
+  });
+});