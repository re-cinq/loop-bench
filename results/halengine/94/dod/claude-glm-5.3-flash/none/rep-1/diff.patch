+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {writeSignalPromptBuilder} from '../infrastructure/writeSignalTestSupport.js';
+
+// Fixed, as in the sibling suite: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+// One expect per test needs the rejection as a value rather than a matcher.
+const outcomeOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved without throwing').catch((error: Error) => error.message);
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// Counts the turns that reached the provider: a failed beforeSession must end the turn before the first one.
+const countingProvider = (calls: {reached: number}): AIProvider => ({
+  async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    calls.reached += 1;
+    yield {type: 'text', text: 'unreachable'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+describe('beforeSession failure semantics', () => {
+  it('runs onError then afterSession, and still rejects the caller with the thrown error, when beforeSession throws', async () => {
+    const thrown = new Error('beforeSession failed');
+    const session = createSession('hello');
+    const calls = {reached: 0};
+    const callOrder: string[] = [];
+    let onErrorSession: ChatSession | undefined;
+    let onErrorError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw thrown;
+      },
+      onError: async (seenSession, seenError) => {
+        callOrder.push('onError');
+        onErrorSession = seenSession;
+        onErrorError = seenError;
+      },
+      afterSession: async () => void callOrder.push('afterSession'),
+    };
+
+    const orchestrator = createChatOrchestrator(countingProvider(calls), writeSignalPromptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(session));
+
+    expect({
+      outcome,
+      callOrder,
+      providerCallsByTheTurn: calls.reached,
+      onErrorSawThisSession: onErrorSession === session,
+      onErrorSawThisError: onErrorError === thrown,
+    }).toEqual({
+      outcome: 'beforeSession failed',
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+      providerCallsByTheTurn: 0,
+      onErrorSawThisSession: true,
+      onErrorSawThisError: true,
+    });
+  });
+
+  it('hands afterSession the session exactly as beforeSession left it, the turn never having started', async () => {
+    const session = createSession('hello');
+    const calls = {reached: 0};
+    let seenByAfterSession: {entryRoles: string[]; sessionId: string} | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw new Error('beforeSession failed');
+      },
+      afterSession: async seen => {
+        seenByAfterSession = {entryRoles: seen.entries.map(entry => entry.role), sessionId: seen.sessionId};
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(countingProvider(calls), writeSignalPromptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(session));
+
+    expect({
+      outcome,
+      providerCallsByTheTurn: calls.reached,
+      seenByAfterSession,
+    }).toEqual({
+      outcome: 'beforeSession failed',
+      providerCallsByTheTurn: 0,
+      seenByAfterSession: {entryRoles: ['user'], sessionId: 's1'},
+    });
+  });
+});