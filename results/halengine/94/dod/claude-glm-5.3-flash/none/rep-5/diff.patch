+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// One expect per test needs the rejection as a value rather than a matcher.
+const rejectionMessage = (call: Promise<unknown>): Promise<string> =>
+  call.then(
+    () => 'resolved instead of rejecting',
+    (error: Error) => error.message
+  );
+
+const sessionWithUserEntry = (content: string): ChatSession => ({
+  sessionId: 'acceptance-s1',
+  userId: 'acceptance-u1',
+  entries: [{role: 'user', content, timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+// Streams a reply if it is ever reached; a throwing beforeSession must end the turn before it is.
+const streamingProvider = (): {provider: AIProvider; reached: () => boolean} => {
+  let consulted = false;
+
+  return {
+    reached: () => consulted,
+    provider: {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        consulted = true;
+        yield {type: 'text', text: 'a reply'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    },
+  };
+};
+
+describe('ChatOrchestrator when beforeSession throws', () => {
+  it('runs onError then afterSession and still rejects when beforeSession throws', async () => {
+    const session = sessionWithUserEntry('hello');
+    const failure = new Error('beforeSession failed');
+    const callOrder: string[] = [];
+    let onErrorSession: ChatSession | undefined;
+    let onErrorError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw failure;
+      },
+      onError: async (hookedSession, error) => {
+        callOrder.push('onError');
+        onErrorSession = hookedSession;
+        onErrorError = error;
+      },
+      afterSession: async () => {
+        callOrder.push('afterSession');
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(streamingProvider().provider, promptBuilder, undefined, {hooks});
+    const outcome = await rejectionMessage(orchestrator.processMessage(session));
+
+    expect({
+      outcome,
+      callOrder,
+      onErrorGotSession: onErrorSession === session,
+      onErrorGotError: onErrorError === failure,
+    }).toEqual({
+      outcome: 'beforeSession failed',
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+      onErrorGotSession: true,
+      onErrorGotError: true,
+    });
+  });
+
+  it('hands afterSession a session the turn never started', async () => {
+    const {provider, reached} = streamingProvider();
+    const session = sessionWithUserEntry('hello');
+    let cleanup: {ran: boolean; roles: string[]} = {ran: false, roles: []};
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw new Error('allocation failed');
+      },
+      onError: async () => {},
+      afterSession: async hookedSession => {
+        cleanup = {ran: true, roles: hookedSession.entries.map(entry => entry.role)};
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+    const outcome = await rejectionMessage(orchestrator.processMessage(session));
+
+    expect({outcome, cleanup, providerConsulted: reached()}).toEqual({
+      outcome: 'allocation failed',
+      cleanup: {ran: true, roles: ['user']},
+      providerConsulted: false,
+    });
+  });
+});