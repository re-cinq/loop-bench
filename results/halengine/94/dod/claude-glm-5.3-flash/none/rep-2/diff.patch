+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+// One expect per test needs the rejection as a value rather than a matcher.
+const outcomeOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved without throwing').catch((error: Error) => error.message);
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+}
+
+// Never reached by these tests: beforeSession throws before the first provider call.
+function createUnreachedProvider(onCall?: () => void): AIProvider {
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      onCall?.();
+      yield {type: 'text', text: 'the turn must not reach the provider'};
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+// Acceptance for specs/hal-engine-config-hooks/spec.md: a throw from beforeSession reaches the same catch/finally as any other failure.
+describe('ChatOrchestrator when beforeSession throws', () => {
+  const throwingBeforeSession =
+    (error: Error): NonNullable<OrchestratorHooks['beforeSession']> =>
+    async () => {
+      throw error;
+    };
+
+  it('rejects with the thrown error and hands it to onError like any other failure', async () => {
+    const thrown = new Error('before session failed');
+    let receivedSession: ChatSession | undefined;
+    let receivedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: throwingBeforeSession(thrown),
+      onError: async (session, error) => {
+        receivedSession = session;
+        receivedError = error;
+      },
+    };
+    const session = createSession('hello');
+    const orchestrator = createChatOrchestrator(createUnreachedProvider(), promptBuilder, undefined, {hooks});
+
+    const outcome = await outcomeOf(orchestrator.processMessage(session));
+
+    expect({
+      outcome,
+      onErrorGotTheSameError: receivedError === thrown,
+      onErrorGotTheSession: receivedSession === session,
+    }).toEqual({outcome: 'before session failed', onErrorGotTheSameError: true, onErrorGotTheSession: true});
+  });
+
+  it('still runs afterSession, after onError, though no part of the turn happened', async () => {
+    const callOrder: string[] = [];
+    let reachedProvider = false;
+    let afterSessionSession: ChatSession | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: throwingBeforeSession(new Error('before session failed')),
+      onError: async () => void callOrder.push('onError'),
+      afterSession: async session => {
+        afterSessionSession = session;
+        callOrder.push('afterSession');
+      },
+    };
+    const session = createSession('hello');
+    const orchestrator = createChatOrchestrator(
+      createUnreachedProvider(() => void (reachedProvider = true)),
+      promptBuilder,
+      undefined,
+      {hooks}
+    );
+
+    const outcome = await outcomeOf(orchestrator.processMessage(session));
+
+    expect({
+      outcome,
+      order: callOrder,
+      reachedProvider,
+      afterSessionGotTheSession: afterSessionSession === session,
+      entriesUntouched: session.entries.length === 1,
+    }).toEqual({
+      outcome: 'before session failed',
+      order: ['onError', 'afterSession'],
+      reachedProvider: false,
+      afterSessionGotTheSession: true,
+      entriesUntouched: true,
+    });
+  });
+});