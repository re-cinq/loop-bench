+// HALEngine#94: a throw from beforeSession must reach the same catch and finally as any other failure.
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+// One expect per test needs the rejection as a value rather than a matcher.
+const outcomeOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved without throwing').catch((error: Error) => error.message);
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// Records whether the turn ever reached the model: a failed beforeSession must end it before that.
+const guardedProvider = (calls: string[]): AIProvider => ({
+  async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    calls.push('sendMessage');
+    yield {type: 'text', text: 'the turn reached the provider'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const throwingBeforeSession =
+  (callOrder: string[]): OrchestratorHooks['beforeSession'] =>
+  async () => {
+    callOrder.push('beforeSession');
+    throw new Error('beforeSession failed');
+  };
+
+describe('ChatOrchestrator beforeSession failure (HALEngine#94)', () => {
+  it('runs onError then afterSession when beforeSession throws, and the rejection still reaches the caller', async () => {
+    const callOrder: string[] = [];
+    const providerCalls: string[] = [];
+    let onErrorSessionId: string | undefined;
+    let onErrorMessage: string | undefined;
+    const session = createSession('hello');
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: throwingBeforeSession(callOrder),
+      beforeUserInput: async (_session, msg) => {
+        callOrder.push('beforeUserInput');
+        return msg;
+      },
+      afterUserInput: async () => void callOrder.push('afterUserInput'),
+      beforeModelResponse: async (_session, systemPrompt) => {
+        callOrder.push('beforeModelResponse');
+        return systemPrompt;
+      },
+      afterModelResponse: async () => void callOrder.push('afterModelResponse'),
+      onError: async (hookedSession, error) => {
+        callOrder.push('onError');
+        onErrorSessionId = hookedSession.sessionId;
+        onErrorMessage = error.message;
+      },
+      afterSession: async () => void callOrder.push('afterSession'),
+    };
+
+    const orchestrator = createChatOrchestrator(guardedProvider(providerCalls), promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(session));
+
+    expect({outcome, callOrder, onErrorSessionId, onErrorMessage, providerCalls}).toEqual({
+      outcome: 'beforeSession failed',
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+      onErrorSessionId: 's1',
+      onErrorMessage: 'beforeSession failed',
+      providerCalls: [],
+    });
+  });
+
+  it('gives a stream consumer the same hooks and a session the failed turn never touched', async () => {
+    const callOrder: string[] = [];
+    const providerCalls: string[] = [];
+    const chunks: MessageChunk[] = [];
+    const session = createSession('hello');
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: throwingBeforeSession(callOrder),
+      onError: async () => void callOrder.push('onError'),
+      afterSession: async () => void callOrder.push('afterSession'),
+    };
+
+    const orchestrator = createChatOrchestrator(guardedProvider(providerCalls), promptBuilder, undefined, {hooks});
+
+    const outcome = await outcomeOf(
+      (async () => {
+        for await (const chunk of orchestrator.processMessageStream(session)) chunks.push(chunk);
+      })()
+    );
+
+    // One user entry in, one out: afterSession ran against a turn that never got past its first hook.
+    const entriesAfter = session.entries.length;
+
+    expect({outcome, chunks, callOrder, entriesAfter, providerCalls}).toEqual({
+      outcome: 'beforeSession failed',
+      chunks: [],
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+      entriesAfter: 1,
+      providerCalls: [],
+    });
+  });
+});