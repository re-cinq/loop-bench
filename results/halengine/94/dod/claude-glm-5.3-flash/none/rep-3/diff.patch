@@ -0,0 +1,98 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+// One expect per test needs the rejection as a value rather than a matcher.
+const outcomeOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved without throwing').catch((error: Error) => error.message);
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's-before-session',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// Counts the provider calls a turn reaches: a beforeSession that throws must reach none.
+const countingProvider = (): {provider: AIProvider; counter: {providerCalls: number}} => {
+  const counter = {providerCalls: 0};
+
+  return {
+    counter,
+    provider: {
+      async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        counter.providerCalls += 1;
+        yield {type: 'text', text: 'unreachable'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    },
+  };
+};
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator with a throwing beforeSession', () => {
+  it('runs onError and afterSession when beforeSession throws, in that order, and still rejects with that error', async () => {
+    const failure = new Error('session setup failed');
+    const order: string[] = [];
+    const {provider} = countingProvider();
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw failure;
+      },
+      onError: async () => void order.push('onError'),
+      afterSession: async () => void order.push('afterSession'),
+    };
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+
+    const outcome = await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({outcome, order}).toEqual({outcome: 'session setup failed', order: ['onError', 'afterSession']});
+  });
+
+  it('hands onError the session and error any other failure hands it, after a turn that reached no provider call', async () => {
+    const failure = new Error('span allocation refused');
+    const {provider, counter} = countingProvider();
+    let sessionIdSeenByOnError: string | undefined;
+    let errorMessageSeenByOnError: string | undefined;
+    let entriesSeenByAfterSession = -1;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw failure;
+      },
+      onError: async (session, error) => {
+        sessionIdSeenByOnError = session.sessionId;
+        errorMessageSeenByOnError = error.message;
+      },
+      afterSession: async session => {
+        entriesSeenByAfterSession = session.entries.length;
+      },
+    };
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+
+    const outcome = await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({
+      outcome,
+      sessionIdSeenByOnError,
+      errorMessageSeenByOnError,
+      entriesSeenByAfterSession,
+      providerCalls: counter.providerCalls,
+    }).toEqual({
+      outcome: 'span allocation refused',
+      sessionIdSeenByOnError: 's-before-session',
+      errorMessageSeenByOnError: 'span allocation refused',
+      entriesSeenByAfterSession: 1,
+      providerCalls: 0,
+    });
+  });
+});