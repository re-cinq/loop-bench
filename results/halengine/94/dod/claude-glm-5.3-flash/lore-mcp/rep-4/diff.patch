@@ -0,0 +1,100 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// Counts provider calls rather than recording output, because the assertion is that none happened.
+function countingProvider(): {provider: AIProvider; callCount: () => number} {
+  let calls = 0;
+
+  return {
+    callCount: () => calls,
+    provider: {
+      async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        calls++;
+        yield {type: 'text', text: 'the turn should never have reached the provider'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    },
+  };
+}
+
+describe('ChatOrchestrator failure path', () => {
+  it('runs onError and afterSession when beforeSession throws and still rejects the caller', async () => {
+    const thrown = new Error('beforeSession failed');
+    const callOrder: string[] = [];
+    let onErrorSession: ChatSession | undefined;
+    let onErrorError: Error | undefined;
+    let afterSessionSession: ChatSession | undefined;
+    const {provider, callCount} = countingProvider();
+    const session = createSession('hello');
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw thrown;
+      },
+      beforeUserInput: async (_session, userMessage) => {
+        callOrder.push('beforeUserInput');
+        return userMessage;
+      },
+      afterUserInput: async () => void callOrder.push('afterUserInput'),
+      beforeModelResponse: async (_session, systemPrompt) => {
+        callOrder.push('beforeModelResponse');
+        return systemPrompt;
+      },
+      afterModelResponse: async () => void callOrder.push('afterModelResponse'),
+      onError: async (hookedSession, error) => {
+        callOrder.push('onError');
+        onErrorSession = hookedSession;
+        onErrorError = error;
+      },
+      afterSession: async hookedSession => {
+        callOrder.push('afterSession');
+        afterSessionSession = hookedSession;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+
+    const outcome = await orchestrator.processMessage(session).then(
+      () => 'resolved without throwing',
+      (error: Error) => error.message
+    );
+
+    expect({
+      outcome,
+      callOrder,
+      onErrorGotThrownError: onErrorError === thrown,
+      onErrorGotSession: onErrorSession === session,
+      afterSessionGotSession: afterSessionSession === session,
+      providerCalls: callCount(),
+      sessionEntries: session.entries.length,
+    }).toEqual({
+      outcome: 'beforeSession failed',
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+      onErrorGotThrownError: true,
+      onErrorGotSession: true,
+      afterSessionGotSession: true,
+      providerCalls: 0,
+      sessionEntries: 1,
+    });
+  });
+});