@@ -0,0 +1,111 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+// One expect per test needs the rejection as a value rather than a matcher.
+const outcomeOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved without throwing').catch((error: Error) => error.message);
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const hooksThrowingBeforeSession = (failure: Error): OrchestratorHooks => ({
+  beforeSession: async () => {
+    throw failure;
+  },
+});
+
+// Counts the provider calls the turn reached: a failed beforeSession must never reach one.
+const countingProvider = (calls: {count: number}): AIProvider => ({
+  async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    calls.count += 1;
+    yield {type: 'text', text: 'ok'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+describe('a beforeSession that throws', () => {
+  it('still rejects the caller with the same error', async () => {
+    const failure = new Error('before session failed');
+    const orchestrator = createChatOrchestrator(countingProvider({count: 0}), promptBuilder, undefined, {
+      hooks: hooksThrowingBeforeSession(failure),
+    });
+
+    const outcome = await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+    expect(outcome).toBe('before session failed');
+  });
+
+  it('reaches onError with the session and error any other orchestrator failure carries', async () => {
+    const failure = new Error('before session failed');
+    const session = createSession('hello');
+    let seenSession: ChatSession | undefined;
+    let seenError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      ...hooksThrowingBeforeSession(failure),
+      onError: async (hookSession, error) => {
+        seenSession = hookSession;
+        seenError = error;
+      },
+    };
+    const orchestrator = createChatOrchestrator(countingProvider({count: 0}), promptBuilder, undefined, {hooks});
+
+    const outcome = await outcomeOf(orchestrator.processMessage(session));
+
+    expect({outcome, sameSession: seenSession === session, sameError: seenError === failure}).toEqual({
+      outcome: 'before session failed',
+      sameSession: true,
+      sameError: true,
+    });
+  });
+
+  it('runs afterSession after onError, handing back the session exactly as beforeSession was handed it', async () => {
+    const failure = new Error('before session failed');
+    const session = createSession('hello');
+    const calls = {count: 0};
+    const callOrder: string[] = [];
+    let cleanupSession: ChatSession | undefined;
+    const hooks: OrchestratorHooks = {
+      ...hooksThrowingBeforeSession(failure),
+      onError: async () => {
+        callOrder.push('onError');
+      },
+      afterSession: async hookSession => {
+        callOrder.push('afterSession');
+        cleanupSession = hookSession;
+      },
+    };
+    const orchestrator = createChatOrchestrator(countingProvider(calls), promptBuilder, undefined, {hooks});
+
+    const outcome = await outcomeOf(orchestrator.processMessage(session));
+
+    expect({
+      outcome,
+      callOrder,
+      sameSession: cleanupSession === session,
+      entries: cleanupSession?.entries,
+      providerCalls: calls.count,
+    }).toEqual({
+      outcome: 'before session failed',
+      callOrder: ['onError', 'afterSession'],
+      sameSession: true,
+      entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+      providerCalls: 0,
+    });
+  });
+});