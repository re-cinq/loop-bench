+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+// A rejection read as a value, so the one expect sees the caller's outcome whole.
+const outcomeOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved without throwing').catch((error: Error) => error.message);
+
+const sessionFor = (content: string): ChatSession => ({
+  sessionId: 'hooked-session',
+  userId: 'u1',
+  entries: [{role: 'user', content, timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+describe('ChatOrchestrator beforeSession failure', () => {
+  it('runs onError and afterSession when beforeSession throws, and still rejects the caller', async () => {
+    const callOrder: string[] = [];
+    let providerReached = false;
+    let onErrorError: Error | undefined;
+    let onErrorSession: ChatSession | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw new Error('session setup failed');
+      },
+      onError: async (session, error) => {
+        callOrder.push('onError');
+        onErrorError = error;
+        onErrorSession = session;
+      },
+      afterSession: async () => {
+        callOrder.push('afterSession');
+      },
+    };
+    const provider: AIProvider = {
+      async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        providerReached = true;
+        yield {type: 'text', text: 'unreachable'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(sessionFor('hello')));
+
+    expect({
+      outcome,
+      callOrder,
+      providerReached,
+      onErrorErrorMessage: onErrorError?.message,
+      onErrorSessionId: onErrorSession?.sessionId,
+    }).toEqual({
+      outcome: 'session setup failed',
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+      providerReached: false,
+      onErrorErrorMessage: 'session setup failed',
+      onErrorSessionId: 'hooked-session',
+    });
+  });
+});