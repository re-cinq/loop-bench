+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// The turn must not reach the provider on this path; failing loudly beats a silent pass if that ever changes.
+function createUnreachableProvider(): AIProvider {
+  return {
+    // eslint-disable-next-line require-yield
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      throw new Error('provider reached although beforeSession threw');
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator when beforeSession throws', () => {
+  it('runs onError then afterSession and still rejects the caller when beforeSession throws', async () => {
+    const boom = new Error('beforeSession failed');
+    const callOrder: string[] = [];
+    let onErrorArgs: {session: ChatSession; error: Error} | undefined;
+    let afterSessionSession: ChatSession | undefined;
+    const session = createSession('hello');
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw boom;
+      },
+      onError: async (hookedSession, error) => {
+        callOrder.push('onError');
+        onErrorArgs = {session: hookedSession, error};
+      },
+      afterSession: async hookedSession => {
+        callOrder.push('afterSession');
+        afterSessionSession = hookedSession;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createUnreachableProvider(), promptBuilder, undefined, {hooks});
+
+    // The rejection is taken as a value so the hooks can be asserted in the same expect.
+    const outcome = await orchestrator.processMessage(session).then(
+      () => 'resolved without throwing',
+      (error: Error) => error.message
+    );
+
+    expect({
+      outcome,
+      callOrder,
+      onErrorGotSameSession: onErrorArgs?.session === session,
+      onErrorGotThrownError: onErrorArgs?.error === boom,
+      afterSessionGotSameSession: afterSessionSession === session,
+      entriesSeenByAfterSession: afterSessionSession?.entries.map(entry => entry.role),
+    }).toEqual({
+      outcome: 'beforeSession failed',
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+      onErrorGotSameSession: true,
+      onErrorGotThrownError: true,
+      afterSessionGotSameSession: true,
+      entriesSeenByAfterSession: ['user'],
+    });
+  });
+});