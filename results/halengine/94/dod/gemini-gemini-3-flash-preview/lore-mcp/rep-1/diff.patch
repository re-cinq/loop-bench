@@ -0,0 +1,96 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function createMockProvider(): AIProvider {
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      yield {type: 'text', text: 'hi'};
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator #94 Acceptance Tests', () => {
+  it('onError fires when beforeSession throws', async () => {
+    let errorPassedToHook: Error | undefined;
+    const error = new Error('beforeSession failed');
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw error;
+      },
+      onError: async (_session, err) => {
+        errorPassedToHook = err;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createMockProvider(), promptBuilder, undefined, {hooks});
+
+    // The rejection reaches the caller as a rejection, unchanged from today
+    await expect(orchestrator.processMessage(createSession('hello'))).rejects.toThrow('beforeSession failed');
+
+    // onError fires for that throw
+    expect(errorPassedToHook).toBe(error);
+  });
+
+  it('afterSession fires when beforeSession throws', async () => {
+    let afterSessionCalled = false;
+    const error = new Error('beforeSession failed');
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw error;
+      },
+      afterSession: async () => {
+        afterSessionCalled = true;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createMockProvider(), promptBuilder, undefined, {hooks});
+
+    await expect(orchestrator.processMessage(createSession('hello'))).rejects.toThrow('beforeSession failed');
+
+    // afterSession fires for that throw
+    expect(afterSessionCalled).toBe(true);
+  });
+
+  it('non-throwing beforeSession behaves exactly as today', async () => {
+    let beforeSessionCalled = false;
+    let afterSessionCalled = false;
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        beforeSessionCalled = true;
+      },
+      afterSession: async () => {
+        afterSessionCalled = true;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createMockProvider(), promptBuilder, undefined, {hooks});
+    const response = await orchestrator.processMessage(createSession('hello'));
+
+    expect(response).toBe('hi');
+    expect(beforeSessionCalled).toBe(true);
+    expect(afterSessionCalled).toBe(true);
+  });
+});
