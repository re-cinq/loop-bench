@@ -0,0 +1,90 @@
+import {jest} from '@jest/globals';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+/**
+ * @spec specs/hal-engine-config-hooks/spec.md#1
+ */
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function createMockProvider(): AIProvider {
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield {type: 'text', text: 'hi'};
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('beforeSession error handling', () => {
+  it('onError fires when beforeSession throws', async () => {
+    const error = new Error('beforeSession failed');
+    const onError = jest.fn();
+    const hooks = {
+      beforeSession: async () => {
+        throw error;
+      },
+      onError,
+    };
+
+    const orchestrator = createChatOrchestrator(createMockProvider(), promptBuilder, undefined, {hooks});
+
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (e) {
+      // Expected
+    }
+
+    expect(onError).toHaveBeenCalledWith(expect.anything(), error);
+  });
+
+  it('afterSession fires when beforeSession throws', async () => {
+    const error = new Error('beforeSession failed');
+    const afterSession = jest.fn();
+    const hooks = {
+      beforeSession: async () => {
+        throw error;
+      },
+      afterSession,
+    };
+
+    const orchestrator = createChatOrchestrator(createMockProvider(), promptBuilder, undefined, {hooks});
+
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch (e) {
+      // Expected
+    }
+
+    expect(afterSession).toHaveBeenCalled();
+  });
+
+  it('beforeSession rejection propagates to caller', async () => {
+    const error = new Error('beforeSession failed');
+    const hooks = {
+      beforeSession: async () => {
+        throw error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createMockProvider(), promptBuilder, undefined, {hooks});
+
+    await expect(orchestrator.processMessage(createSession('hello'))).rejects.toThrow('beforeSession failed');
+  });
+});