+import {jest} from '@jest/globals';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed timestamp for tests
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function createMockProvider(): AIProvider {
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      yield {type: 'text', text: 'ok'};
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('beforeSession Error Handling (Acceptance)', () => {
+  it('runs onError and afterSession when beforeSession throws', async () => {
+    // [specs/hal-engine-config-hooks/spec.md#1]
+    const session = createSession('hello');
+    const error = new Error('beforeSession failed');
+
+    const hooks = {
+      beforeSession: jest.fn().mockRejectedValue(error),
+      onError: jest.fn().mockResolvedValue(undefined),
+      afterSession: jest.fn().mockResolvedValue(undefined),
+    };
+
+    const orchestrator = createChatOrchestrator(createMockProvider(), promptBuilder, undefined, {hooks});
+
+    // Act
+    const promise = orchestrator.processMessage(session);
+
+    // Assert
+    await expect(promise).rejects.toThrow('beforeSession failed');
+
+    // These should fire but currently don't because beforeSession is outside the try block
+    expect(hooks.onError).toHaveBeenCalledWith(session, error);
+    expect(hooks.afterSession).toHaveBeenCalledWith(session);
+  });
+
+  it('runs afterSession when beforeSession succeeds', async () => {
+    // [specs/hal-engine-config-hooks/spec.md#2]
+    const session = createSession('hello');
+
+    const hooks = {
+      beforeSession: jest.fn().mockResolvedValue(undefined),
+      afterSession: jest.fn().mockResolvedValue(undefined),
+    };
+
+    const orchestrator = createChatOrchestrator(createMockProvider(), promptBuilder, undefined, {hooks});
+
+    // Act
+    await orchestrator.processMessage(session);
+
+    // Assert
+    expect(hooks.beforeSession).toHaveBeenCalledWith(session);
+    expect(hooks.afterSession).toHaveBeenCalledWith(session);
+  });
+});