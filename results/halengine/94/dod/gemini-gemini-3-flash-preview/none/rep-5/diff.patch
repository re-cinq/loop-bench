@@ -0,0 +1,101 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function createMockProvider(): AIProvider {
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield {type: 'text', text: 'hi'};
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator hooks acceptance', () => {
+  it('onError fires when beforeSession throws', async () => {
+    const error = new Error('beforeSession failed');
+    let capturedError: Error | undefined;
+    let capturedSession: ChatSession | undefined;
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw error;
+      },
+      onError: async (session, err) => {
+        capturedSession = session;
+        capturedError = err;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createMockProvider(), promptBuilder, undefined, {hooks});
+    const session = createSession('hello');
+
+    await expect(orchestrator.processMessage(session)).rejects.toThrow('beforeSession failed');
+
+    expect(capturedSession).toBe(session);
+    expect(capturedError).toBe(error);
+  });
+
+  it('afterSession fires when beforeSession throws', async () => {
+    const error = new Error('beforeSession failed');
+    let afterSessionCalled = false;
+    let capturedSession: ChatSession | undefined;
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw error;
+      },
+      afterSession: async session => {
+        afterSessionCalled = true;
+        capturedSession = session;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createMockProvider(), promptBuilder, undefined, {hooks});
+    const session = createSession('hello');
+
+    await expect(orchestrator.processMessage(session)).rejects.toThrow('beforeSession failed');
+
+    expect(afterSessionCalled).toBe(true);
+    expect(capturedSession).toBe(session);
+  });
+
+  it('no other lifecycle hooks fire if beforeSession throws', async () => {
+    const error = new Error('beforeSession failed');
+    let beforeUserInputCalled = false;
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw error;
+      },
+      beforeUserInput: async (_session, msg) => {
+        beforeUserInputCalled = true;
+        return msg;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createMockProvider(), promptBuilder, undefined, {hooks});
+    const session = createSession('hello');
+
+    await expect(orchestrator.processMessage(session)).rejects.toThrow('beforeSession failed');
+
+    expect(beforeUserInputCalled).toBe(false);
+  });
+});