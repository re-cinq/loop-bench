+import {describe, it, expect} from '@jest/globals';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function createMockProvider(): AIProvider {
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield {type: 'text', text: 'ok'};
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('beforeSession failure (acceptance)', () => {
+  it('onError fires when beforeSession throws', async () => {
+    const callOrder: string[] = [];
+    const errorToThrow = new Error('beforeSession failed');
+    let capturedError: Error | undefined;
+
+    const hooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw errorToThrow;
+      },
+      onError: async (_session: ChatSession, err: Error) => {
+        callOrder.push('onError');
+        capturedError = err;
+      },
+      afterSession: async () => {
+        callOrder.push('afterSession');
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createMockProvider(), promptBuilder, undefined, {hooks});
+
+    await expect(orchestrator.processMessage(createSession('hello'))).rejects.toThrow('beforeSession failed');
+
+    // Currently, this fails because onError is not called when beforeSession throws.
+    expect(callOrder).toContain('onError');
+    expect(capturedError).toBe(errorToThrow);
+  });
+
+  it('afterSession fires when beforeSession throws', async () => {
+    const callOrder: string[] = [];
+    const hooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw new Error('beforeSession failed');
+      },
+      afterSession: async () => {
+        callOrder.push('afterSession');
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createMockProvider(), promptBuilder, undefined, {hooks});
+
+    try {
+      await orchestrator.processMessage(createSession('hello'));
+    } catch {
+      // Expected
+    }
+
+    // Currently, this fails because afterSession is not called when beforeSession throws.
+    expect(callOrder).toContain('afterSession');
+  });
+});