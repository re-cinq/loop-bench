+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function createMockProvider(): AIProvider {
+  return {
+    async *sendMessage() {
+      yield {type: 'text', text: 'response'};
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>() {
+      return {} as T;
+    },
+  };
+}
+
+describe('beforeSession error handling acceptance', () => {
+  const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+  it('runs onError and afterSession when beforeSession throws', async () => {
+    const error = new Error('beforeSession failure');
+    const callOrder: string[] = [];
+    let receivedError: Error | undefined;
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw error;
+      },
+      onError: async (_session, err) => {
+        callOrder.push('onError');
+        receivedError = err;
+      },
+      afterSession: async () => {
+        callOrder.push('afterSession');
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createMockProvider(), promptBuilder, undefined, {hooks});
+    const session = createSession('hello');
+
+    // spec:target/specs/hal-engine-config-hooks/spec.md#6
+    await expect(orchestrator.processMessage(session)).rejects.toThrow('beforeSession failure');
+
+    expect(callOrder).toContain('onError');
+    expect(callOrder).toContain('afterSession');
+    expect(receivedError).toBe(error);
+  });
+});