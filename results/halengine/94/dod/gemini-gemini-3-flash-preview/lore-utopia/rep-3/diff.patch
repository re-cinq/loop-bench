+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('beforeSession error handling acceptance', () => {
+  const promptBuilder = new PromptBuilder({identity: 'test'});
+  const mockProvider: AIProvider = {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      yield {type: 'text', text: 'ok'};
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+
+  const session: ChatSession = {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hi', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+
+  it('reaches the caller as a rejection when beforeSession throws', async () => {
+    const error = new Error('beforeSession failed');
+    const orchestrator = createChatOrchestrator(mockProvider, promptBuilder, undefined, {
+      hooks: {
+        beforeSession: async () => {
+          throw error;
+        },
+      },
+    });
+
+    await expect(orchestrator.processMessage(session)).rejects.toThrow('beforeSession failed');
+  });
+
+  it('fires onError when beforeSession throws', async () => {
+    const calls: string[] = [];
+    const error = new Error('beforeSession failed');
+    const orchestrator = createChatOrchestrator(mockProvider, promptBuilder, undefined, {
+      hooks: {
+        beforeSession: async () => {
+          throw error;
+        },
+        onError: async (_session, err) => {
+          if (err === error) {
+            calls.push('onError');
+          }
+        },
+      },
+    });
+
+    try {
+      await orchestrator.processMessage(session);
+    } catch {
+      // expected
+    }
+
+    expect(calls).toContain('onError');
+  });
+
+  it('fires afterSession when beforeSession throws', async () => {
+    const calls: string[] = [];
+    const error = new Error('beforeSession failed');
+    const orchestrator = createChatOrchestrator(mockProvider, promptBuilder, undefined, {
+      hooks: {
+        beforeSession: async () => {
+          throw error;
+        },
+        afterSession: async () => {
+          calls.push('afterSession');
+        },
+      },
+    });
+
+    try {
+      await orchestrator.processMessage(session);
+    } catch {
+      // expected
+    }
+
+    expect(calls).toContain('afterSession');
+  });
+});