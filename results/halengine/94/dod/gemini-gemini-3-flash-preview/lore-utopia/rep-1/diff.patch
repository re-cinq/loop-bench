@@ -0,0 +1,64 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const createMockProvider = (responseText: string): AIProvider => ({
+  async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: responseText};
+    yield {type: 'stop', stopReason: 'end_turn'} as any;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+function createSession(): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00Z'}],
+  };
+}
+
+describe('ChatOrchestrator hooks (acceptance)', () => {
+  // specs/hal-engine-config-hooks/spec.md
+  it('runs onError when beforeSession throws', async () => {
+    let errorPassedToHook: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw new Error('beforeSession failed');
+      },
+      onError: async (_session, error) => {
+        errorPassedToHook = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createMockProvider('hi'), promptBuilder, undefined, {hooks});
+
+    await expect(orchestrator.processMessage(createSession())).rejects.toThrow('beforeSession failed');
+    expect(errorPassedToHook).toBeDefined();
+    expect(errorPassedToHook?.message).toBe('beforeSession failed');
+  });
+
+  // specs/hal-engine-config-hooks/spec.md
+  it('runs afterSession when beforeSession throws', async () => {
+    let afterSessionCalled = false;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw new Error('beforeSession failed');
+      },
+      afterSession: async _session => {
+        afterSessionCalled = true;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createMockProvider('hi'), promptBuilder, undefined, {hooks});
+
+    await expect(orchestrator.processMessage(createSession())).rejects.toThrow('beforeSession failed');
+    expect(afterSessionCalled).toBe(true);
+  });
+});