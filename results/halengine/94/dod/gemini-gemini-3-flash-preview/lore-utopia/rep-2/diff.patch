+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const promptBuilder = new PromptBuilder({identity: 'Test'});
+
+function createSession(): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: new Date().toISOString()}],
+  };
+}
+
+function createMockProvider(): AIProvider {
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield {type: 'text', text: 'hi'};
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+describe('ChatOrchestrator acceptance: beforeSession error handling', () => {
+  it('runs onError and afterSession when beforeSession throws', async () => {
+    let onErrorCalled = false;
+    let afterSessionCalled = false;
+    const error = new Error('beforeSession failure');
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw error;
+      },
+      onError: async (_session, err) => {
+        if (err === error) onErrorCalled = true;
+      },
+      afterSession: async () => {
+        afterSessionCalled = true;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createMockProvider(), promptBuilder, undefined, {hooks});
+
+    // The error should still propagate to the caller
+    await expect(orchestrator.processMessage(createSession())).rejects.toThrow('beforeSession failure');
+
+    // [specs/hal-engine-config-hooks/spec.md#7]
+    expect(onErrorCalled).toBe(true);
+    expect(afterSessionCalled).toBe(true);
+  });
+
+  it('does not run intermediate hooks when beforeSession throws', async () => {
+    const callOrder: string[] = [];
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw new Error('fail');
+      },
+      beforeUserInput: async (_s, m) => {
+        callOrder.push('beforeUserInput');
+        return m;
+      },
+      afterUserInput: async () => {
+        callOrder.push('afterUserInput');
+      },
+      beforeModelResponse: async (_s, p) => {
+        callOrder.push('beforeModelResponse');
+        return p;
+      },
+      onError: async () => {
+        callOrder.push('onError');
+      },
+      afterSession: async () => {
+        callOrder.push('afterSession');
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createMockProvider(), promptBuilder, undefined, {hooks});
+    try {
+      await orchestrator.processMessage(createSession());
+    } catch {
+      // expected
+    }
+
+    // [specs/hal-engine-config-hooks/spec.md#8]
+    expect(callOrder).toEqual(['beforeSession', 'onError', 'afterSession']);
+  });
+});