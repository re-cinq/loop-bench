+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import type {ChatSession} from '../types/session.js';
+
+// specs/hal-engine-config-hooks/spec.md#7
+it('reports and cleans up a failed beforeSession while preserving its rejection', async () => {
+  const session: ChatSession = {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const failure = new Error('allocation failed');
+  const calls: unknown[][] = [];
+  const orchestrator = createChatOrchestrator(
+    createMockProvider(),
+    new PromptBuilder({identity: 'Assistant'}),
+    undefined,
+    {
+      hooks: {
+        beforeSession: async received => {
+          calls.push(['beforeSession', received]);
+          throw failure;
+        },
+        onError: async (received, error) => void calls.push(['onError', received, error]),
+        afterSession: async received => void calls.push(['afterSession', received]),
+      },
+    }
+  );
+
+  const rejection = await orchestrator.processMessage(session).catch((error: unknown) => error);
+
+  expect({rejection, calls}).toEqual({
+    rejection: failure,
+    calls: [
+      ['beforeSession', session],
+      ['onError', session, failure],
+      ['afterSession', session],
+    ],
+  });
+  expect(rejection).toBe(failure);
+});