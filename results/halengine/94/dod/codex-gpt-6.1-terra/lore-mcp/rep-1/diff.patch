+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/index.js';
+import type {ChatSession} from '../types/session.js';
+
+// specs/hal-engine-config-hooks/spec.md#7
+it('runs error and cleanup hooks when beforeSession throws', async () => {
+  const session: ChatSession = {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const failure = new Error('before session failed');
+  const calls: unknown[][] = [];
+  const orchestrator = createChatOrchestrator(
+    createMockProvider(),
+    new PromptBuilder({identity: 'You are a test assistant.'}),
+    undefined,
+    {
+      hooks: {
+        beforeSession: async received => {
+          calls.push(['beforeSession', received]);
+          throw failure;
+        },
+        beforeUserInput: async (_session, message) => {
+          calls.push(['beforeUserInput']);
+          return message;
+        },
+        onError: async (received, error) => {
+          calls.push(['onError', received, error]);
+        },
+        afterSession: async received => {
+          calls.push(['afterSession', received]);
+        },
+      },
+    }
+  );
+
+  const rejection = await orchestrator.processMessage(session).then(
+    () => undefined,
+    (error: unknown) => error
+  );
+
+  expect({sameError: rejection === failure, calls}).toEqual({
+    sameError: true,
+    calls: [
+      ['beforeSession', session],
+      ['onError', session, failure],
+      ['afterSession', session],
+    ],
+  });
+});