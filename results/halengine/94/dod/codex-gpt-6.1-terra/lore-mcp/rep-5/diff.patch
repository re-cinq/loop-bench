+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('beforeSession failure', () => {
+  // specs/hal-engine-config-hooks/spec.md#11
+  it('reports and cleans up a beforeSession failure while preserving the rejection', async () => {
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const failure = new Error('allocation failed');
+    const events: unknown[] = [];
+    const orchestrator = createChatOrchestrator(
+      createMockProvider(),
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      undefined,
+      {
+        hooks: {
+          beforeSession: async received => {
+            events.push(['beforeSession', received === session]);
+            throw failure;
+          },
+          beforeUserInput: async (_received, message) => {
+            events.push(['beforeUserInput']);
+            return message;
+          },
+          onError: async (received, error) => void events.push(['onError', received === session, error === failure]),
+          afterSession: async received => void events.push(['afterSession', received === session]),
+        },
+      }
+    );
+
+    const rejection = await orchestrator.processMessage(session).then(
+      () => 'resolved',
+      (error: unknown) => error
+    );
+
+    expect({sameRejection: rejection === failure, events}).toEqual({
+      sameRejection: true,
+      events: [
+        ['beforeSession', true],
+        ['onError', true, true],
+        ['afterSession', true],
+      ],
+    });
+  });
+});