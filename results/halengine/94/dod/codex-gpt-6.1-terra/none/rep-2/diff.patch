+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createBedrockProvider} from '../providers/bedrock/bedrockProvider.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('beforeSession failure', () => {
+  // specs/hal-engine-config-hooks/spec.md#11
+  it('reports and cleans up a failed beforeSession while preserving its rejection', async () => {
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const failure = new Error('allocation failed');
+    const calls: unknown[] = [];
+    const orchestrator = createChatOrchestrator(
+      createBedrockProvider({type: 'bedrock', region: 'eu-west-1', modelId: 'unused', maxTokens: 16}),
+      new PromptBuilder({identity: 'Test assistant'}),
+      undefined,
+      {
+        hooks: {
+          beforeSession: async received => {
+            calls.push(['beforeSession', received]);
+            throw failure;
+          },
+          beforeUserInput: async (_session, message) => {
+            calls.push(['beforeUserInput']);
+            return message;
+          },
+          onError: async (received, error) => {
+            calls.push(['onError', received, error]);
+          },
+          afterSession: async received => {
+            calls.push(['afterSession', received]);
+          },
+        },
+      }
+    );
+
+    let rejected: unknown;
+    try {
+      await orchestrator.processMessage(session);
+    } catch (error) {
+      rejected = error;
+    }
+
+    expect({sameError: rejected === failure, calls}).toEqual({
+      sameError: true,
+      calls: [
+        ['beforeSession', session],
+        ['onError', session, failure],
+        ['afterSession', session],
+      ],
+    });
+  });
+});