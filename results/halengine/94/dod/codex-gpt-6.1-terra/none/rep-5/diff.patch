+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('beforeSession failure lifecycle', () => {
+  // specs/hal-engine-config-hooks/spec.md#1
+  it('reports and cleans up a failed beforeSession before rejecting with the same error', async () => {
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const failure = new Error('allocation failed');
+    const events: unknown[][] = [];
+    const orchestrator = createChatOrchestrator(
+      createMockProvider(),
+      new PromptBuilder({identity: 'Test assistant'}),
+      undefined,
+      {
+        hooks: {
+          beforeSession: async current => {
+            events.push(['beforeSession', current]);
+            throw failure;
+          },
+          beforeUserInput: async (current, message) => {
+            events.push(['beforeUserInput', current]);
+            return message;
+          },
+          onError: async (current, error) => void events.push(['onError', current, error]),
+          afterSession: async current => void events.push(['afterSession', current]),
+        },
+      }
+    );
+
+    const rejection = await orchestrator.processMessage(session).then(
+      () => undefined,
+      (error: unknown) => error
+    );
+
+    expect({rejection, events}).toEqual({
+      rejection: failure,
+      events: [
+        ['beforeSession', session],
+        ['onError', session, failure],
+        ['afterSession', session],
+      ],
+    });
+    expect(rejection).toBe(failure);
+  });
+});