+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createBedrockProvider} from '../providers/bedrock/bedrockProvider.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('beforeSession failure', () => {
+  it('specs/hal-engine-config-hooks/spec.md#7 runs error and cleanup hooks and propagates the original error', async () => {
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const error = new Error('allocation failed');
+    const events: unknown[] = [];
+    const orchestrator = createChatOrchestrator(
+      createBedrockProvider({type: 'bedrock', region: 'eu-west-1', modelId: 'model', maxTokens: 16}),
+      new PromptBuilder({identity: 'Assistant'}),
+      undefined,
+      {
+        hooks: {
+          beforeSession: async received => {
+            events.push(['beforeSession', received]);
+            throw error;
+          },
+          beforeUserInput: async (_session, message) => {
+            events.push('beforeUserInput');
+            return message;
+          },
+          onError: async (received, cause) => void events.push(['onError', received, cause]),
+          afterSession: async received => void events.push(['afterSession', received]),
+        },
+      }
+    );
+
+    const rejection = await orchestrator.processMessage(session).catch((cause: unknown) => cause);
+
+    expect({rejection, events}).toEqual({
+      rejection: error,
+      events: [
+        ['beforeSession', session],
+        ['onError', session, error],
+        ['afterSession', session],
+      ],
+    });
+    expect(rejection).toBe(error);
+  });
+});