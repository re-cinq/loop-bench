+// Acceptance test for re-cinq/HALEngine#94, validating specs/hal-engine-config-hooks/spec.md.
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const answeringProvider: AIProvider = {
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'hi'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+describe('beforeSession that throws', () => {
+  it('rejects to the caller and still runs onError with (session, error) and then afterSession', async () => {
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+    };
+    const thrown = new Error('span allocation failed');
+    const calls: string[] = [];
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw thrown;
+      },
+      onError: async (s, error) => {
+        calls.push(`onError(sameSession=${s === session}, sameError=${error === thrown})`);
+      },
+      afterSession: async s => {
+        calls.push(`afterSession(sameSession=${s === session})`);
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(answeringProvider, new PromptBuilder({identity: 'test'}), undefined, {
+      hooks,
+    });
+    const rejection = await orchestrator.processMessage(session).then(
+      () => 'resolved without throwing',
+      (error: unknown) =>
+        error === thrown ? 'rejected with the beforeSession error' : `rejected with ${String(error)}`
+    );
+
+    expect({rejection, calls}).toEqual({
+      rejection: 'rejected with the beforeSession error',
+      calls: ['onError(sameSession=true, sameError=true)', 'afterSession(sameSession=true)'],
+    });
+  });
+});