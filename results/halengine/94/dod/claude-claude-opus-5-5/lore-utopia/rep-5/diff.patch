+// Acceptance test for re-cinq/HALEngine#94 (specs/hal-engine-config-hooks/spec.md, "A failing `beforeSession`").
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {ChatSession} from '../types/session.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+// A provider that answers normally: the only failure in the turn is the one beforeSession raises.
+const answeringProvider: AIProvider = {
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'ok'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+describe('a beforeSession hook that throws', () => {
+  it('still rejects with its error, and fires onError with (session, error) and then afterSession', async () => {
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+    };
+    const allocationFailed = new Error('span allocation failed');
+    const calls: string[] = [];
+    let onErrorArgs: {sameSession: boolean; sameError: boolean} | undefined;
+
+    const orchestrator = createChatOrchestrator(answeringProvider, new PromptBuilder({identity: 'test'}), undefined, {
+      hooks: {
+        beforeSession: async () => {
+          calls.push('beforeSession');
+          throw allocationFailed;
+        },
+        onError: async (hookSession, error) => {
+          calls.push('onError');
+          onErrorArgs = {sameSession: hookSession === session, sameError: error === allocationFailed};
+        },
+        afterSession: async () => void calls.push('afterSession'),
+      },
+    });
+
+    const rejection = await orchestrator.processMessage(session).then(
+      () => 'resolved without throwing',
+      (error: unknown) => (error === allocationFailed ? 'rejected with the beforeSession error' : String(error))
+    );
+
+    expect({rejection, calls, onErrorArgs}).toEqual({
+      rejection: 'rejected with the beforeSession error',
+      calls: ['beforeSession', 'onError', 'afterSession'],
+      onErrorArgs: {sameSession: true, sameError: true},
+    });
+  });
+});