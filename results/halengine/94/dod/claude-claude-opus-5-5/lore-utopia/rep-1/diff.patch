+// Acceptance test for re-cinq/HALEngine#94 — spec: specs/hal-engine-config-hooks/spec.md#beforesession-failure
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const answeringProvider: AIProvider = {
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'ok'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+describe('a beforeSession hook that throws', () => {
+  it('still rejects to the caller, and runs onError with (session, error) and then afterSession', async () => {
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const thrown = new Error('beforeSession failed');
+    const calls: string[] = [];
+    const onErrorArgs: {sameSession: boolean; sameError: boolean}[] = [];
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        calls.push('beforeSession');
+        throw thrown;
+      },
+      onError: async (s, error) => {
+        calls.push('onError');
+        onErrorArgs.push({sameSession: s === session, sameError: error === thrown});
+      },
+      afterSession: async () => void calls.push('afterSession'),
+    };
+
+    const orchestrator = createChatOrchestrator(
+      answeringProvider,
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      undefined,
+      {hooks}
+    );
+    const outcome = await orchestrator.processMessage(session).then(
+      () => 'resolved without throwing',
+      (error: unknown) =>
+        error === thrown ? 'rejected with the beforeSession error' : `rejected with ${String(error)}`
+    );
+
+    expect({outcome, calls, onErrorArgs}).toEqual({
+      outcome: 'rejected with the beforeSession error',
+      calls: ['beforeSession', 'onError', 'afterSession'],
+      onErrorArgs: [{sameSession: true, sameError: true}],
+    });
+  });
+});