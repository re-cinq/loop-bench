@@ -0,0 +1,66 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Validates specs/hal-engine-config-hooks/spec.md: a throwing beforeSession reaches onError and afterSession (HALEngine#94).
+
+const provider: AIProvider = {
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'ok'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+const session = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+describe('beforeSession failure', () => {
+  it('rejects with the beforeSession error after firing onError with it and then afterSession', async () => {
+    const thrown = new Error('span allocation failed');
+    const calls: string[] = [];
+    let onErrorArgs: {session: ChatSession; error: Error} | undefined;
+    const subject = session();
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        calls.push('beforeSession');
+        throw thrown;
+      },
+      beforeUserInput: async (_s, msg) => {
+        calls.push('beforeUserInput');
+        return msg;
+      },
+      onError: async (s, error) => {
+        calls.push('onError');
+        onErrorArgs = {session: s, error};
+      },
+      afterSession: async () => void calls.push('afterSession'),
+    };
+
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), undefined, {hooks});
+    const rejection = await orchestrator.processMessage(subject).then(
+      () => undefined,
+      (error: unknown) => error
+    );
+
+    expect({
+      rejectedWithSameError: rejection === thrown,
+      calls,
+      onErrorGotSession: onErrorArgs?.session === subject,
+      onErrorGotSameError: onErrorArgs?.error === thrown,
+    }).toEqual({
+      rejectedWithSameError: true,
+      calls: ['beforeSession', 'onError', 'afterSession'],
+      onErrorGotSession: true,
+      onErrorGotSameError: true,
+    });
+  });
+});