+// Acceptance tests for re-cinq/HALEngine#94.
+// spec: specs/hal-engine-config-hooks/spec.md#failure-in-beforesession
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const replyingProvider: AIProvider = {
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'hi'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+const createSession = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+describe('beforeSession that throws (HALEngine#94)', () => {
+  it('rejects with the beforeSession error and hands onError that same session and error', async () => {
+    const thrown = new Error('allocation failed');
+    const session = createSession();
+    const seen: {session?: ChatSession; error?: Error} = {};
+
+    const orchestrator = createChatOrchestrator(replyingProvider, promptBuilder, undefined, {
+      hooks: {
+        beforeSession: async () => {
+          throw thrown;
+        },
+        onError: async (s, error) => {
+          seen.session = s;
+          seen.error = error;
+        },
+      },
+    });
+
+    const rejection = await orchestrator.processMessage(session).then(
+      () => undefined,
+      (error: unknown) => error
+    );
+
+    expect({rejection, onErrorSession: seen.session, onErrorError: seen.error}).toEqual({
+      rejection: thrown,
+      onErrorSession: session,
+      onErrorError: thrown,
+    });
+  });
+
+  it('runs onError then afterSession, and no turn hook, when beforeSession throws', async () => {
+    const callOrder: string[] = [];
+
+    const orchestrator = createChatOrchestrator(replyingProvider, promptBuilder, undefined, {
+      hooks: {
+        beforeSession: async () => {
+          callOrder.push('beforeSession');
+          throw new Error('allocation failed');
+        },
+        beforeUserInput: async (_s, msg) => {
+          callOrder.push('beforeUserInput');
+          return msg;
+        },
+        afterUserInput: async () => void callOrder.push('afterUserInput'),
+        beforeModelResponse: async (_s, prompt) => {
+          callOrder.push('beforeModelResponse');
+          return prompt;
+        },
+        afterModelResponse: async () => void callOrder.push('afterModelResponse'),
+        onError: async () => void callOrder.push('onError'),
+        afterSession: async () => void callOrder.push('afterSession'),
+      },
+    });
+
+    const outcome = await orchestrator.processMessage(createSession()).then(
+      () => 'resolved without throwing',
+      (error: Error) => error.message
+    );
+
+    expect({outcome, callOrder}).toEqual({
+      outcome: 'allocation failed',
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+    });
+  });
+});