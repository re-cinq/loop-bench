+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Validates specs/hal-engine-config-hooks/spec.md — "A beforeSession that throws ..." (re-cinq/HALEngine#94).
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const provider: AIProvider = {
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'never reached'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+describe('a beforeSession hook that throws', () => {
+  it('rejects to the caller unchanged, after onError and then afterSession have both run for that throw', async () => {
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+    };
+    const thrown = new Error('span allocation failed');
+    const calls: Array<{hook: string; sameSession: boolean; sameError?: boolean}> = [];
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw thrown;
+      },
+      onError: async (s, error) =>
+        void calls.push({hook: 'onError', sameSession: s === session, sameError: error === thrown}),
+      afterSession: async s => void calls.push({hook: 'afterSession', sameSession: s === session}),
+    };
+
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), undefined, {hooks});
+    const rejection = await orchestrator.processMessage(session).then(
+      () => 'resolved without throwing',
+      (error: unknown) => error
+    );
+
+    expect({rejectedWithTheThrownError: rejection === thrown, calls}).toEqual({
+      rejectedWithTheThrownError: true,
+      calls: [
+        {hook: 'onError', sameSession: true, sameError: true},
+        {hook: 'afterSession', sameSession: true},
+      ],
+    });
+  });
+});