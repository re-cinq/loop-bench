+// Acceptance for re-cinq/HALEngine#94; validates specs/hal-engine-config-hooks/spec.md § When beforeSession throws.
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const session = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+});
+
+const provider: AIProvider = {
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'reply'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('a beforeSession hook that throws', () => {
+  it('reaches onError with the session and the thrown error, then afterSession, and still rejects the caller', async () => {
+    const thrown = new Error('span allocation failed');
+    const calls: Array<{hook: string; session: ChatSession; error?: Error}> = [];
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {
+      hooks: {
+        beforeSession: async () => {
+          throw thrown;
+        },
+        onError: async (s, error) => void calls.push({hook: 'onError', session: s, error}),
+        afterSession: async s => void calls.push({hook: 'afterSession', session: s}),
+      },
+    });
+    const turn = session();
+
+    const rejection = await orchestrator.processMessage(turn).then(
+      () => undefined,
+      (error: unknown) => error
+    );
+
+    expect({rejection, calls}).toEqual({
+      rejection: thrown,
+      calls: [
+        {hook: 'onError', session: turn, error: thrown},
+        {hook: 'afterSession', session: turn},
+      ],
+    });
+  });
+
+  it('lets afterSession release what beforeSession allocated before it threw', async () => {
+    const held = new Set<string>();
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {
+      hooks: {
+        beforeSession: async s => {
+          held.add(s.sessionId);
+          throw new Error('rate-limit token refused');
+        },
+        afterSession: async s => void held.delete(s.sessionId),
+      },
+    });
+
+    const outcome = await orchestrator.processMessage(session()).then(
+      () => 'resolved without throwing',
+      (error: Error) => error.message
+    );
+
+    expect({outcome, stillHeld: [...held]}).toEqual({outcome: 'rate-limit token refused', stillHeld: []});
+  });
+});