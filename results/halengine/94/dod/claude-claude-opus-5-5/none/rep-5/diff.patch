+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Validates specs/hal-engine-config-hooks/spec.md#7 (re-cinq/HALEngine#94).
+
+const provider: AIProvider = {
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'never reached'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+describe('beforeSession failure', () => {
+  it('rejects to the caller and still fires onError with the thrown error, then afterSession', async () => {
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const thrown = new Error('span allocation failed');
+    const calls: string[] = [];
+    let onErrorArgs: {session: ChatSession; error: Error} | undefined;
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        calls.push('beforeSession');
+        throw thrown;
+      },
+      onError: async (s, error) => {
+        calls.push('onError');
+        onErrorArgs = {session: s, error};
+      },
+      afterSession: async () => void calls.push('afterSession'),
+    };
+
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), undefined, {hooks});
+    const rejection = await orchestrator.processMessage(session).then(
+      () => undefined,
+      (error: unknown) => error
+    );
+
+    expect({
+      rejectedWithThrown: rejection === thrown,
+      calls,
+      onErrorGotSession: onErrorArgs?.session === session,
+      onErrorGotThrown: onErrorArgs?.error === thrown,
+    }).toEqual({
+      rejectedWithThrown: true,
+      calls: ['beforeSession', 'onError', 'afterSession'],
+      onErrorGotSession: true,
+      onErrorGotThrown: true,
+    });
+  });
+});