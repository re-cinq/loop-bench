+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Validates specs/hal-engine-config-hooks/spec.md, the beforeSession-throws guarantee (re-cinq/HALEngine#94).
+
+const provider: AIProvider = {
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'never reached'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+describe('ChatOrchestrator when beforeSession throws', () => {
+  it('rejects with the beforeSession error and still fires onError and afterSession for it', async () => {
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const refusal = new Error('session refused');
+    const calls: string[] = [];
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw refusal;
+      },
+      onError: async (s, error) => void calls.push(`onError:${s === session}:${error === refusal}`),
+      afterSession: async s => void calls.push(`afterSession:${s === session}`),
+    };
+
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), undefined, {hooks});
+    const rejection = await orchestrator.processMessage(session).then(
+      () => 'resolved without throwing',
+      (error: unknown) => error
+    );
+
+    expect({rejection, calls}).toEqual({rejection: refusal, calls: ['onError:true:true', 'afterSession:true']});
+  });
+});