+// Acceptance tests for re-cinq/HALEngine#94 — specs/hal-engine-config-hooks/spec.md#7 and #8
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const provider: AIProvider = {
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'ok'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+function createSession(): ChatSession {
+  return {sessionId: 's1', userId: 'u1', entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}]};
+}
+
+// The rejection as a value, so each test asserts the caller's outcome and the hooks in one expect.
+const rejectionOf = (call: Promise<unknown>): Promise<unknown> =>
+  call.then(() => 'resolved without throwing').catch((error: unknown) => error);
+
+describe('a beforeSession hook that throws', () => {
+  it('fires onError with the session and the thrown error, and still rejects the caller with it', async () => {
+    const thrown = new Error('span allocation failed');
+    const session = createSession();
+    const received: {session: ChatSession; error: Error}[] = [];
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw thrown;
+      },
+      onError: async (s, error) => void received.push({session: s, error}),
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+    const rejection = await rejectionOf(orchestrator.processMessage(session));
+
+    expect({rejection, received}).toEqual({rejection: thrown, received: [{session, error: thrown}]});
+  });
+
+  it('fires afterSession after onError, and still rejects the caller with the thrown error', async () => {
+    const thrown = new Error('span allocation failed');
+    const callOrder: string[] = [];
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw thrown;
+      },
+      onError: async () => void callOrder.push('onError'),
+      afterSession: async () => void callOrder.push('afterSession'),
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+    const rejection = await rejectionOf(orchestrator.processMessage(createSession()));
+
+    expect({rejection, callOrder}).toEqual({
+      rejection: thrown,
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+    });
+  });
+});