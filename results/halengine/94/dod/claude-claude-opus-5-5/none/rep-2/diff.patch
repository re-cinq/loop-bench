+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Acceptance for re-cinq/HALEngine#94 (specs/hal-engine-config-hooks/spec.md).
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const provider: AIProvider = {
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'hi'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('a beforeSession hook that throws', () => {
+  it('still rejects to the caller, and runs onError with (session, error) and then afterSession', async () => {
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+    };
+    const thrown = new Error('allocation failed');
+    const calls: string[] = [];
+    let onErrorArgs: [ChatSession, Error] | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        calls.push('beforeSession');
+        throw thrown;
+      },
+      onError: async (s, error) => {
+        calls.push('onError');
+        onErrorArgs = [s, error];
+      },
+      afterSession: async () => void calls.push('afterSession'),
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+    const rejection = await orchestrator.processMessage(session).then(
+      () => undefined,
+      (error: unknown) => error
+    );
+
+    expect({
+      rejection,
+      calls,
+      onErrorSessionIsTheTurnSession: onErrorArgs?.[0] === session,
+      onErrorError: onErrorArgs?.[1],
+    }).toEqual({
+      rejection: thrown,
+      calls: ['beforeSession', 'onError', 'afterSession'],
+      onErrorSessionIsTheTurnSession: true,
+      onErrorError: thrown,
+    });
+  });
+});