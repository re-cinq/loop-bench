+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {answering} from '../infrastructure/writeSignalTestSupport.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const outcomeOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved without throwing').catch((error: Error) => error.message);
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator beforeSession hook failure', () => {
+  it('runs onError then afterSession when it throws, and still rejects to the caller', async () => {
+    const callOrder: string[] = [];
+    let onErrorArgs: {sessionId: string; message: string} | undefined;
+    let afterSessionSessionId: string | undefined;
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw new Error('beforeSession boom');
+      },
+      onError: async (session, error) => {
+        callOrder.push('onError');
+        onErrorArgs = {sessionId: session.sessionId, message: error.message};
+      },
+      afterSession: async session => {
+        callOrder.push('afterSession');
+        afterSessionSessionId = session.sessionId;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(answering('never'), promptBuilder, undefined, {hooks});
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+    };
+
+    const outcome = await outcomeOf(orchestrator.processMessage(session));
+
+    expect({outcome, onErrorArgs, afterSessionSessionId, callOrder}).toEqual({
+      outcome: 'beforeSession boom',
+      onErrorArgs: {sessionId: 's1', message: 'beforeSession boom'},
+      afterSessionSessionId: 's1',
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+    });
+  });
+});