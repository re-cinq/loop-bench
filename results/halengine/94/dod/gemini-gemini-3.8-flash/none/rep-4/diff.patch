+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const outcomeOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved without throwing').catch((error: Error) => error.message);
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const dummyProvider: AIProvider = {
+  async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'response'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+describe('chatOrchestrator beforeSession failure', () => {
+  it('runs onError then afterSession when beforeSession throws and propagates the rejection', async () => {
+    const callOrder: string[] = [];
+    let onErrorSession: ChatSession | undefined;
+    let onErrorError: Error | undefined;
+    let afterSessionSession: ChatSession | undefined;
+
+    const thrown = new Error('beforeSession failure');
+    const session = createSession('hello');
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw thrown;
+      },
+      onError: async (s, error) => {
+        callOrder.push('onError');
+        onErrorSession = s;
+        onErrorError = error;
+      },
+      afterSession: async s => {
+        callOrder.push('afterSession');
+        afterSessionSession = s;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(dummyProvider, promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(session));
+
+    expect({
+      outcome,
+      callOrder,
+      onErrorSession,
+      onErrorError,
+      afterSessionSession,
+    }).toEqual({
+      outcome: 'beforeSession failure',
+      callOrder: ['onError', 'afterSession'],
+      onErrorSession: session,
+      onErrorError: thrown,
+      afterSessionSession: session,
+    });
+  });
+});