+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/index.js';
+import type {ChatSession} from '../types/session.js';
+
+// Fixed timestamp: avoids non-deterministic Date.now() or new Date() in tests.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+describe('ChatOrchestrator hook error handling', () => {
+  it('runs onError and afterSession when beforeSession throws', async () => {
+    const seen: {hook: string; error?: string; sessionId?: string}[] = [];
+    const hooks: OrchestratorHooks = {
+      beforeSession: async session => {
+        seen.push({hook: 'beforeSession', sessionId: session.sessionId});
+        throw new Error('beforeSession failed');
+      },
+      onError: async (session, error) => {
+        seen.push({hook: 'onError', error: error.message, sessionId: session.sessionId});
+      },
+      afterSession: async session => {
+        seen.push({hook: 'afterSession', sessionId: session.sessionId});
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      createMockProvider(),
+      new PromptBuilder({identity: 'test'}),
+      undefined,
+      {hooks}
+    );
+
+    const session: ChatSession = {
+      sessionId: 's-fail',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+    };
+
+    const outcome = await orchestrator
+      .processMessage(session)
+      .then(() => 'resolved without throwing')
+      .catch((err: Error) => err.message);
+
+    expect({outcome, seen}).toEqual({
+      outcome: 'beforeSession failed',
+      seen: [
+        {hook: 'beforeSession', sessionId: 's-fail'},
+        {hook: 'onError', error: 'beforeSession failed', sessionId: 's-fail'},
+        {hook: 'afterSession', sessionId: 's-fail'},
+      ],
+    });
+  });
+});