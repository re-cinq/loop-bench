@@ -0,0 +1,49 @@
+import {createHalEngine} from './config.js';
+import type {ChatSession} from './types/session.js';
+import type {WsAuthenticator} from './types/auth.js';
+
+const base = {
+  provider: {type: 'mock' as const},
+  prompt: {identity: 'test'},
+  auth: {ws: (async () => null) as unknown as WsAuthenticator},
+};
+
+describe('createHalEngine hook failure semantics', () => {
+  it('runs onError and afterSession when beforeSession throws', async () => {
+    const failure = new Error('allocation failed');
+    const events: Array<{hook: string; session: ChatSession; error?: Error}> = [];
+
+    const engine = createHalEngine({
+      ...base,
+      orchestrator: {
+        hooks: {
+          beforeSession: async () => {
+            throw failure;
+          },
+          onError: async (session, error) => {
+            events.push({hook: 'onError', session, error});
+          },
+          afterSession: async session => {
+            events.push({hook: 'afterSession', session});
+          },
+        },
+      },
+    });
+
+    const session: ChatSession = {
+      sessionId: 's-fail',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+
+    const outcome = await engine.orchestrator.processMessage(session).catch((err: Error) => err.message);
+
+    expect({outcome, events}).toEqual({
+      outcome: 'allocation failed',
+      events: [
+        {hook: 'onError', session, error: failure},
+        {hook: 'afterSession', session},
+      ],
+    });
+  });
+});