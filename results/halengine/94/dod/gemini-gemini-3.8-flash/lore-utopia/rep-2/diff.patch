+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const outcomeOf = async (promise: Promise<unknown>): Promise<string> => {
+  try {
+    await promise;
+    return 'resolved without throwing';
+  } catch (error) {
+    return error instanceof Error ? error.message : String(error);
+  }
+};
+
+const createSession = (content: string): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content, timestamp: SENT_AT}],
+});
+
+const createMockProvider = (response: string): AIProvider => ({
+  async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: response};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator hooks', () => {
+  it('runs onError then afterSession when beforeSession throws, and still rejects to the caller', async () => {
+    let receivedSession: ChatSession | undefined;
+    let receivedError: Error | undefined;
+    let afterSessionSession: ChatSession | undefined;
+    const callOrder: string[] = [];
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw new Error('beforeSession boom');
+      },
+      onError: async (session, error) => {
+        callOrder.push('onError');
+        receivedSession = session;
+        receivedError = error;
+      },
+      afterSession: async session => {
+        callOrder.push('afterSession');
+        afterSessionSession = session;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createMockProvider('ok'), promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({
+      outcome,
+      onErrorArgs: {sessionId: receivedSession?.sessionId, message: receivedError?.message},
+      afterSessionSessionId: afterSessionSession?.sessionId,
+      callOrder,
+    }).toEqual({
+      outcome: 'beforeSession boom',
+      onErrorArgs: {sessionId: 's1', message: 'beforeSession boom'},
+      afterSessionSessionId: 's1',
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+    });
+  });
+});