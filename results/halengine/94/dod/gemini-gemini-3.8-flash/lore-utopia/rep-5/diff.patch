@@ -0,0 +1,71 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed timestamp keeps runs deterministic; nothing in the test asserts on clock time.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const outcomeOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved without throwing').catch((error: Error) => error.message);
+
+const unusedProvider: AIProvider = {
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw new Error('provider should not be called when beforeSession throws');
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('beforeSession throws', () => {
+  it('runs onError then afterSession when beforeSession throws, and still rejects to the caller', async () => {
+    const callOrder: string[] = [];
+    let capturedError: Error | undefined;
+    let capturedOnErrorSession: ChatSession | undefined;
+    let capturedAfterSession: ChatSession | undefined;
+
+    const beforeSessionError = new Error('beforeSession boom');
+
+    const session: ChatSession = {
+      sessionId: 's-acceptance',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+    };
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw beforeSessionError;
+      },
+      onError: async (s, error) => {
+        callOrder.push('onError');
+        capturedOnErrorSession = s;
+        capturedError = error;
+      },
+      afterSession: async s => {
+        callOrder.push('afterSession');
+        capturedAfterSession = s;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(unusedProvider, promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(session));
+
+    expect({
+      outcome,
+      callOrder,
+      onErrorMatches: capturedError === beforeSessionError && capturedOnErrorSession === session,
+      afterSessionMatches: capturedAfterSession === session && capturedAfterSession?.entries.length === 1,
+    }).toEqual({
+      outcome: 'beforeSession boom',
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+      onErrorMatches: true,
+      afterSessionMatches: true,
+    });
+  });
+});