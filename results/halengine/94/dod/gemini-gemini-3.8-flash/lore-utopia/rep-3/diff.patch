+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const outcomeOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved without throwing').catch((error: Error) => error.message);
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const provider: AIProvider = {
+  async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'response'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+describe('ChatOrchestrator beforeSession error handling', () => {
+  it('runs onError then afterSession when beforeSession throws, and still rejects to the caller', async () => {
+    const callOrder: string[] = [];
+    let receivedError: Error | undefined;
+    let errorSession: ChatSession | undefined;
+    let afterSessionSession: ChatSession | undefined;
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw new Error('beforeSession boom');
+      },
+      onError: async (session, error) => {
+        callOrder.push('onError');
+        receivedError = error;
+        errorSession = session;
+      },
+      afterSession: async session => {
+        callOrder.push('afterSession');
+        afterSessionSession = session;
+      },
+    };
+
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(session));
+
+    expect({
+      outcome,
+      onError: {
+        message: receivedError?.message,
+        sessionId: errorSession?.sessionId,
+      },
+      afterSession: {
+        sessionId: afterSessionSession?.sessionId,
+        entries: afterSessionSession?.entries,
+      },
+      callOrder,
+    }).toEqual({
+      outcome: 'beforeSession boom',
+      onError: {
+        message: 'beforeSession boom',
+        sessionId: 's1',
+      },
+      afterSession: {
+        sessionId: 's1',
+        entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+      },
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+    });
+  });
+});