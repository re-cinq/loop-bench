+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/index.js';
+import type {ChatSession} from '../types/session.js';
+
+// Fixed timestamp so the test does not tie itself to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const outcomeOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved without throwing').catch((error: Error) => error.message);
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+describe('ChatOrchestrator beforeSession failure handling', () => {
+  it('runs onError then afterSession when beforeSession throws, and still rejects to the caller', async () => {
+    const callOrder: string[] = [];
+    let receivedErrorMessage: string | undefined;
+    let receivedSessionId: string | undefined;
+
+    const thrownError = new Error('beforeSession boom');
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw thrownError;
+      },
+      onError: async (session, error) => {
+        callOrder.push('onError');
+        receivedErrorMessage = error.message;
+        receivedSessionId = session.sessionId;
+      },
+      afterSession: async () => {
+        callOrder.push('afterSession');
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createMockProvider(), promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({
+      outcome,
+      callOrder,
+      receivedErrorMessage,
+      receivedSessionId,
+    }).toEqual({
+      outcome: 'beforeSession boom',
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+      receivedErrorMessage: 'beforeSession boom',
+      receivedSessionId: 's1',
+    });
+  });
+});