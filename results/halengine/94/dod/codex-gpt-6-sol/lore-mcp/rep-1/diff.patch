+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('beforeSession failure', () => {
+  it('calls onError and afterSession after beforeSession throws while preserving the rejection', async () => {
+    const session: ChatSession = {
+      sessionId: 'session-1',
+      userId: 'user-1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const failure = new Error('setup failed');
+    const calls: Array<{hook: string; session: ChatSession; error?: Error}> = [];
+    const hooks: OrchestratorHooks = {
+      beforeSession: async received => {
+        calls.push({hook: 'beforeSession', session: received});
+        throw failure;
+      },
+      beforeUserInput: async (received, message) => {
+        calls.push({hook: 'beforeUserInput', session: received});
+        return message;
+      },
+      onError: async (received, error) => {
+        calls.push({hook: 'onError', session: received, error});
+      },
+      afterSession: async received => {
+        calls.push({hook: 'afterSession', session: received});
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      createMockProvider(),
+      new PromptBuilder({identity: 'Test assistant.'}),
+      undefined,
+      {hooks}
+    );
+
+    const rejection = await orchestrator.processMessage(session).then(
+      () => undefined,
+      (error: unknown) => error
+    );
+
+    expect({
+      rejectionIsOriginal: rejection === failure,
+      onErrorReceivedOriginal: calls[1]?.error === failure,
+      calls,
+    }).toEqual({
+      rejectionIsOriginal: true,
+      onErrorReceivedOriginal: true,
+      calls: [
+        {hook: 'beforeSession', session},
+        {hook: 'onError', session, error: failure},
+        {hook: 'afterSession', session},
+      ],
+    });
+  });
+});