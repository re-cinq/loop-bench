+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('beforeSession failure cleanup', () => {
+  // specs/hal-engine-config-hooks/spec.md#7
+  it('reports a failed beforeSession and runs afterSession before rejecting with the same error', async () => {
+    const session: ChatSession = {
+      sessionId: 'failed-start',
+      userId: 'user',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const failure = new Error('session setup failed');
+    const calls: string[] = [];
+    let errorSession: ChatSession | undefined;
+    let receivedError: Error | undefined;
+    let cleanupSession: ChatSession | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        calls.push('beforeSession');
+        throw failure;
+      },
+      beforeUserInput: async (_session, message) => {
+        calls.push('beforeUserInput');
+        return message;
+      },
+      onError: async (seenSession, error) => {
+        calls.push('onError');
+        errorSession = seenSession;
+        receivedError = error;
+      },
+      afterSession: async seenSession => {
+        calls.push('afterSession');
+        cleanupSession = seenSession;
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      createMockProvider(),
+      new PromptBuilder({identity: 'Test assistant'}),
+      undefined,
+      {hooks}
+    );
+
+    let rejectedWith: unknown;
+    try {
+      await orchestrator.processMessage(session);
+    } catch (error) {
+      rejectedWith = error;
+    }
+
+    expect(calls).toEqual(['beforeSession', 'onError', 'afterSession']);
+    expect(errorSession).toBe(session);
+    expect(receivedError).toBe(failure);
+    expect(cleanupSession).toBe(session);
+    expect(rejectedWith).toBe(failure);
+  });
+});