+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createBedrockProvider} from '../providers/bedrock/bedrockProvider.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+
+describe('ChatOrchestrator beforeSession failure cleanup', () => {
+  it('rejects with the original error after onError and afterSession run for the same unstarted session', async () => {
+    const session: ChatSession = {
+      sessionId: 'failed-start',
+      userId: 'user',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const failure = new Error('beforeSession failed');
+    const calls: string[] = [];
+    let onErrorReceivedSession: ChatSession | undefined;
+    let onErrorReceivedError: Error | undefined;
+    let afterSessionReceivedSession: ChatSession | undefined;
+    let afterSessionEntryCount: number | undefined;
+    const orchestrator = createChatOrchestrator(
+      createBedrockProvider({type: 'bedrock', region: 'eu-west-1', modelId: 'test', maxTokens: 16}),
+      new PromptBuilder({identity: 'Test assistant'}),
+      undefined,
+      {
+        hooks: {
+          beforeSession: async () => {
+            calls.push('beforeSession');
+            throw failure;
+          },
+          beforeUserInput: async (_session, input) => {
+            calls.push('beforeUserInput');
+            return input;
+          },
+          onError: async (receivedSession, error) => {
+            calls.push('onError');
+            onErrorReceivedSession = receivedSession;
+            onErrorReceivedError = error;
+          },
+          afterSession: async receivedSession => {
+            calls.push('afterSession');
+            afterSessionReceivedSession = receivedSession;
+            afterSessionEntryCount = receivedSession.entries.length;
+          },
+        },
+      }
+    );
+
+    const rejection = await orchestrator.processMessage(session).then(
+      () => undefined,
+      (error: unknown) => error
+    );
+
+    expect({
+      originalRejection: rejection === failure,
+      calls,
+      onErrorReceivedSession: onErrorReceivedSession === session,
+      onErrorReceivedError: onErrorReceivedError === failure,
+      afterSessionReceivedSession: afterSessionReceivedSession === session,
+      afterSessionEntryCount,
+    }).toEqual({
+      originalRejection: true,
+      calls: ['beforeSession', 'onError', 'afterSession'],
+      onErrorReceivedSession: true,
+      onErrorReceivedError: true,
+      afterSessionReceivedSession: true,
+      afterSessionEntryCount: 1,
+    });
+  });
+});