+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createBedrockProvider} from '../providers/bedrock/bedrockProvider.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+
+describe('ChatOrchestrator failed beforeSession lifecycle', () => {
+  // specs/hal-engine-config-hooks/spec.md#7
+  it('rejects with the beforeSession error after onError and afterSession receive the session', async () => {
+    const session: ChatSession = {
+      sessionId: 'session-1',
+      userId: 'user-1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const failure = new Error('beforeSession failed');
+    const calls: string[] = [];
+    let onErrorSession: ChatSession | undefined;
+    let onErrorError: Error | undefined;
+    let afterSessionSession: ChatSession | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        calls.push('beforeSession');
+        throw failure;
+      },
+      beforeUserInput: async (_received, message) => {
+        calls.push('beforeUserInput');
+        return message;
+      },
+      onError: async (received, error) => {
+        calls.push('onError');
+        onErrorSession = received;
+        onErrorError = error;
+      },
+      afterSession: async received => {
+        calls.push('afterSession');
+        afterSessionSession = received;
+      },
+    };
+    const provider = createBedrockProvider({type: 'bedrock', modelId: 'unused', region: 'eu-central-1', maxTokens: 1});
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Test assistant'}), undefined, {
+      hooks,
+    });
+
+    const outcome = await orchestrator.processMessage(session).then(
+      () => 'resolved',
+      (error: unknown) => error
+    );
+
+    expect({
+      sameRejection: outcome === failure,
+      calls,
+      onErrorReceivedSession: onErrorSession === session,
+      onErrorReceivedError: onErrorError === failure,
+      afterSessionReceivedSession: afterSessionSession === session,
+    }).toEqual({
+      sameRejection: true,
+      calls: ['beforeSession', 'onError', 'afterSession'],
+      onErrorReceivedSession: true,
+      onErrorReceivedError: true,
+      afterSessionReceivedSession: true,
+    });
+  });
+});