@@ -0,0 +1,67 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('ChatOrchestrator beforeSession failure', () => {
+  // specs/hal-engine-config-hooks/spec.md#7
+  it('rejects with the original error and runs onError before afterSession for a partial session', async () => {
+    const session: ChatSession = {
+      sessionId: 'failed-start',
+      userId: 'user-1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const failure = new Error('beforeSession allocation failed');
+    const calls: string[] = [];
+    let onErrorSession: ChatSession | undefined;
+    let onErrorFailure: Error | undefined;
+    let afterSessionSession: ChatSession | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        calls.push('beforeSession');
+        throw failure;
+      },
+      beforeUserInput: async (_session, message) => {
+        calls.push('beforeUserInput');
+        return message;
+      },
+      onError: async (receivedSession, error) => {
+        calls.push('onError');
+        onErrorSession = receivedSession;
+        onErrorFailure = error;
+      },
+      afterSession: async receivedSession => {
+        calls.push('afterSession');
+        afterSessionSession = receivedSession;
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      createMockProvider(),
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      undefined,
+      {hooks}
+    );
+
+    let rejection: unknown;
+    try {
+      await orchestrator.processMessage(session);
+    } catch (error) {
+      rejection = error;
+    }
+
+    expect({
+      rejectedWithOriginalError: rejection === failure,
+      calls,
+      onErrorReceivedSession: onErrorSession === session,
+      onErrorReceivedError: onErrorFailure === failure,
+      afterSessionReceivedSession: afterSessionSession === session,
+    }).toEqual({
+      rejectedWithOriginalError: true,
+      calls: ['beforeSession', 'onError', 'afterSession'],
+      onErrorReceivedSession: true,
+      onErrorReceivedError: true,
+      afterSessionReceivedSession: true,
+    });
+  });
+});