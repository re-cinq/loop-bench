+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('beforeSession failure cleanup', () => {
+  it('rejects with the original error after onError and afterSession receive the session', async () => {
+    const session: ChatSession = {
+      sessionId: 'failed-start',
+      userId: 'user-1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const failure = new Error('beforeSession failed');
+    const order: string[] = [];
+    let errorSession: ChatSession | undefined;
+    let receivedError: Error | undefined;
+    let cleanupSession: ChatSession | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        order.push('beforeSession');
+        throw failure;
+      },
+      onError: async (hookSession, error) => {
+        order.push('onError');
+        errorSession = hookSession;
+        receivedError = error;
+      },
+      afterSession: async hookSession => {
+        order.push('afterSession');
+        cleanupSession = hookSession;
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      createMockProvider(),
+      new PromptBuilder({identity: 'A test assistant'}),
+      undefined,
+      {hooks}
+    );
+
+    const rejectedWith = await orchestrator.processMessage(session).then(
+      () => undefined,
+      (error: unknown) => error
+    );
+
+    expect(rejectedWith).toBe(failure);
+    expect(order).toEqual(['beforeSession', 'onError', 'afterSession']);
+    expect(errorSession).toBe(session);
+    expect(receivedError).toBe(failure);
+    expect(cleanupSession).toBe(session);
+  });
+});