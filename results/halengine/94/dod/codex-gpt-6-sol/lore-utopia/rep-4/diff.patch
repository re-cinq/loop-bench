+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/index.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('beforeSession failure', () => {
+  // specs/hal-engine-config-hooks/spec.md#7
+  it('rejects with the original error after onError and afterSession receive the session', async () => {
+    const session: ChatSession = {
+      sessionId: 's-before-session-failure',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const failure = new Error('beforeSession failed');
+    const calls: string[] = [];
+    let errorSession: ChatSession | undefined;
+    let reportedError: Error | undefined;
+    let cleanupSession: ChatSession | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        calls.push('beforeSession');
+        throw failure;
+      },
+      beforeUserInput: async (_session, message) => {
+        calls.push('beforeUserInput');
+        return message;
+      },
+      onError: async (receivedSession, error) => {
+        calls.push('onError');
+        errorSession = receivedSession;
+        reportedError = error;
+      },
+      afterSession: async receivedSession => {
+        calls.push('afterSession');
+        cleanupSession = receivedSession;
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      createMockProvider(),
+      new PromptBuilder({identity: 'test'}),
+      undefined,
+      {hooks}
+    );
+
+    const rejection = await orchestrator.processMessage(session).then(
+      () => undefined,
+      (error: unknown) => error
+    );
+
+    expect({
+      rejectionIsOriginal: rejection === failure,
+      errorSessionIsOriginal: errorSession === session,
+      reportedErrorIsOriginal: reportedError === failure,
+      cleanupSessionIsOriginal: cleanupSession === session,
+      calls,
+    }).toEqual({
+      rejectionIsOriginal: true,
+      errorSessionIsOriginal: true,
+      reportedErrorIsOriginal: true,
+      cleanupSessionIsOriginal: true,
+      calls: ['beforeSession', 'onError', 'afterSession'],
+    });
+  });
+});