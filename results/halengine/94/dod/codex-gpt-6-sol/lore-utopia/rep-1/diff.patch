+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createBedrockProvider} from '../providers/bedrock/bedrockProvider.js';
+import type {ChatSession} from '../types/session.js';
+
+// specs/hal-engine-config-hooks/spec.md#7
+it('reports and cleans up a failed beforeSession without starting the turn', async () => {
+  const session: ChatSession = {
+    sessionId: 'failed-start',
+    userId: 'user',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const failure = new Error('session setup failed');
+  const calls: string[] = [];
+  const observed: {onErrorSession?: ChatSession; onErrorFailure?: Error; afterSessionSession?: ChatSession} = {};
+  const orchestrator = createChatOrchestrator(
+    createBedrockProvider({type: 'bedrock', modelId: 'unused', region: 'eu-central-1', maxTokens: 32}),
+    new PromptBuilder({identity: 'Test assistant'}),
+    undefined,
+    {
+      hooks: {
+        beforeSession: async () => {
+          calls.push('beforeSession');
+          throw failure;
+        },
+        beforeUserInput: async (_session, input) => {
+          calls.push('beforeUserInput');
+          return input;
+        },
+        onError: async (receivedSession, receivedFailure) => {
+          calls.push('onError');
+          observed.onErrorSession = receivedSession;
+          observed.onErrorFailure = receivedFailure;
+        },
+        afterSession: async receivedSession => {
+          calls.push('afterSession');
+          observed.afterSessionSession = receivedSession;
+        },
+      },
+    }
+  );
+
+  const outcome = await orchestrator.processMessage(session).then(
+    () => 'resolved',
+    (error: unknown) => error
+  );
+
+  expect({
+    rejectedWithOriginalFailure: outcome === failure,
+    calls,
+    onErrorReceivedSession: observed.onErrorSession === session,
+    onErrorReceivedFailure: observed.onErrorFailure === failure,
+    afterSessionReceivedSession: observed.afterSessionSession === session,
+    entries: session.entries,
+  }).toEqual({
+    rejectedWithOriginalFailure: true,
+    calls: ['beforeSession', 'onError', 'afterSession'],
+    onErrorReceivedSession: true,
+    onErrorReceivedFailure: true,
+    afterSessionReceivedSession: true,
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  });
+});