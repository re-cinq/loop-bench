@@ -0,0 +1,48 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('beforeSession failure', () => {
+  // specs/hal-engine-config-hooks/spec.md#7
+  it('reports the original error and runs afterSession on the partially initialized session', async () => {
+    const session: ChatSession = {
+      sessionId: 'session-1',
+      userId: 'user-1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const failure = new Error('session setup failed');
+    const calls: Array<{hook: string; session: ChatSession; error?: Error}> = [];
+    const orchestrator = createChatOrchestrator(
+      createMockProvider(),
+      new PromptBuilder({identity: 'Test assistant'}),
+      undefined,
+      {
+        hooks: {
+          beforeSession: async receivedSession => {
+            calls.push({hook: 'beforeSession', session: receivedSession});
+            throw failure;
+          },
+          onError: async (receivedSession, error) => {
+            calls.push({hook: 'onError', session: receivedSession, error});
+          },
+          afterSession: async receivedSession => {
+            calls.push({hook: 'afterSession', session: receivedSession});
+          },
+        },
+      }
+    );
+
+    const rejection = await orchestrator.processMessage(session).then(
+      () => undefined,
+      (error: unknown) => error
+    );
+
+    expect(rejection).toBe(failure);
+    expect(calls).toEqual([
+      {hook: 'beforeSession', session},
+      {hook: 'onError', session, error: failure},
+      {hook: 'afterSession', session},
+    ]);
+  });
+});