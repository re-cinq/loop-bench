+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+
+describe('beforeSession failure', () => {
+  // specs/hal-engine-config-hooks/spec.md#7
+  it('rejects with the setup error after onError and afterSession receive the unfinished session', async () => {
+    const failure = new Error('setup failed');
+    const session: ChatSession = {
+      sessionId: 'failed-setup',
+      userId: 'user-1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const calls: string[] = [];
+    let reportedSession: ChatSession | undefined;
+    let reportedError: Error | undefined;
+    let cleanedSession: ChatSession | undefined;
+    let entriesAtCleanup: ChatSession['entries'] | undefined;
+
+    const orchestrator = createChatOrchestrator(
+      createMockProvider(),
+      new PromptBuilder({identity: 'test'}),
+      undefined,
+      {
+        hooks: {
+          beforeSession: async () => {
+            calls.push('beforeSession');
+            throw failure;
+          },
+          beforeUserInput: async (_session, message) => {
+            calls.push('beforeUserInput');
+            return message;
+          },
+          onError: async (receivedSession, error) => {
+            calls.push('onError');
+            reportedSession = receivedSession;
+            reportedError = error;
+          },
+          afterSession: async receivedSession => {
+            calls.push('afterSession');
+            cleanedSession = receivedSession;
+            entriesAtCleanup = receivedSession.entries.map(entry => ({...entry}));
+          },
+        },
+      }
+    );
+
+    const rejection = await orchestrator.processMessage(session).then(
+      () => undefined,
+      error => error
+    );
+
+    expect({
+      sameRejection: rejection === failure,
+      calls,
+      sameError: reportedError === failure,
+      sameErrorSession: reportedSession === session,
+      sameCleanupSession: cleanedSession === session,
+      entriesAtCleanup,
+    }).toEqual({
+      sameRejection: true,
+      calls: ['beforeSession', 'onError', 'afterSession'],
+      sameError: true,
+      sameErrorSession: true,
+      sameCleanupSession: true,
+      entriesAtCleanup: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    });
+  });
+});