@@ -0,0 +1,41 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import type {ChatSession} from '../types/session.js';
+
+// specs/hal-engine-config-hooks/spec.md#7
+it('reports and cleans up when beforeSession throws, then rejects with the original error', async () => {
+  const session: ChatSession = {
+    sessionId: 'before-session-failure',
+    userId: 'user',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const failure = new Error('session setup failed');
+  const events: unknown[][] = [];
+  const orchestrator = createChatOrchestrator(
+    createMockProvider(),
+    new PromptBuilder({identity: 'You are a test assistant.'}),
+    undefined,
+    {
+      hooks: {
+        beforeSession: async received => {
+          events.push(['beforeSession', received === session]);
+          throw failure;
+        },
+        onError: async (received, error) => {
+          events.push(['onError', received === session, error === failure]);
+        },
+        afterSession: async received => {
+          events.push(['afterSession', received === session]);
+        },
+      },
+    }
+  );
+
+  await expect(orchestrator.processMessage(session)).rejects.toBe(failure);
+  expect(events).toEqual([
+    ['beforeSession', true],
+    ['onError', true, true],
+    ['afterSession', true],
+  ]);
+});