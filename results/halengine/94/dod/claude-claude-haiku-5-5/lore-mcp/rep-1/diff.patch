+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const replyingProvider: AIProvider = {
+  async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'hi'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+describe('a beforeSession that throws', () => {
+  it('reaches the caller as the same rejection, and onError receives that error for the same session', async () => {
+    const failure = new Error('span allocation failed');
+    const seen: Array<{session: ChatSession; error: Error}> = [];
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw failure;
+      },
+      onError: async (session, error) => void seen.push({session, error}),
+    };
+    const session = createSession('hello');
+
+    const orchestrator = createChatOrchestrator(replyingProvider, promptBuilder, undefined, {hooks});
+
+    await expect(orchestrator.processMessage(session)).rejects.toBe(failure);
+    expect(seen).toHaveLength(1);
+    expect(seen[0].session).toBe(session);
+    expect(seen[0].error).toBe(failure);
+  });
+
+  it('still runs afterSession, so a deployer can release what beforeSession allocated', async () => {
+    const callOrder: string[] = [];
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw new Error('span allocation failed');
+      },
+      afterSession: async () => void callOrder.push('afterSession'),
+    };
+
+    const orchestrator = createChatOrchestrator(replyingProvider, promptBuilder, undefined, {hooks});
+
+    await expect(orchestrator.processMessage(createSession('hello'))).rejects.toThrow('span allocation failed');
+    expect(callOrder).toEqual(['afterSession']);
+  });
+});