+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+  };
+}
+
+function createProvider(): AIProvider {
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      yield {type: 'text', text: 'reply'};
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+// A beforeSession that allocates nothing and fails: the reporter's span or rate-limit token never got taken.
+const failingBeforeSession =
+  (failure: Error): OrchestratorHooks['beforeSession'] =>
+  async () => {
+    throw failure;
+  };
+
+describe('beforeSession that throws (HALEngine#94)', () => {
+  it('rejects the caller with the beforeSession error and passes that same error and session to onError', async () => {
+    const failure = new Error('span allocation failed');
+    const session = createSession();
+    const onErrorCalls: Array<{session: ChatSession; error: Error}> = [];
+
+    const orchestrator = createChatOrchestrator(createProvider(), promptBuilder, undefined, {
+      hooks: {
+        beforeSession: failingBeforeSession(failure),
+        onError: async (seenSession, error) => {
+          onErrorCalls.push({session: seenSession, error});
+        },
+      },
+    });
+
+    await expect(orchestrator.processMessage(session)).rejects.toBe(failure);
+    expect(onErrorCalls).toHaveLength(1);
+    expect(onErrorCalls[0].session).toBe(session);
+    expect(onErrorCalls[0].error).toBe(failure);
+  });
+
+  it('still runs afterSession, with the session, after a beforeSession throw', async () => {
+    const failure = new Error('rate-limit token unavailable');
+    const session = createSession();
+    const afterSessionCalls: ChatSession[] = [];
+
+    const orchestrator = createChatOrchestrator(createProvider(), promptBuilder, undefined, {
+      hooks: {
+        beforeSession: failingBeforeSession(failure),
+        afterSession: async seenSession => {
+          afterSessionCalls.push(seenSession);
+        },
+      },
+    });
+
+    await expect(orchestrator.processMessage(session)).rejects.toBe(failure);
+    expect(afterSessionCalls).toHaveLength(1);
+    expect(afterSessionCalls[0]).toBe(session);
+  });
+});