+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function createMockProvider(response: string): AIProvider {
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      yield {type: 'text', text: response};
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const refusingSessionHook = (callOrder: string[]): OrchestratorHooks => ({
+  beforeSession: async () => {
+    callOrder.push('beforeSession');
+    throw new Error('session refused');
+  },
+  onError: async () => void callOrder.push('onError'),
+  afterSession: async () => void callOrder.push('afterSession'),
+});
+
+describe('a beforeSession that throws', () => {
+  it('reaches onError with the thrown error, and the caller still gets that rejection', async () => {
+    const seen: Array<{sessionId: string; message: string}> = [];
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw new Error('session refused');
+      },
+      onError: async (session, error) => {
+        seen.push({sessionId: session.sessionId, message: error.message});
+      },
+    };
+    const orchestrator = createChatOrchestrator(createMockProvider('unused'), promptBuilder, undefined, {hooks});
+
+    const outcome = await orchestrator
+      .processMessage(createSession('hello'))
+      .then(() => 'resolved without throwing')
+      .catch((error: Error) => error.message);
+
+    expect(outcome).toBe('session refused');
+    expect(seen).toEqual([{sessionId: 's1', message: 'session refused'}]);
+  });
+
+  it('runs onError and then afterSession, so a deployer can release what beforeSession allocated', async () => {
+    const callOrder: string[] = [];
+    const orchestrator = createChatOrchestrator(createMockProvider('unused'), promptBuilder, undefined, {
+      hooks: refusingSessionHook(callOrder),
+    });
+
+    await orchestrator.processMessage(createSession('hello')).catch(() => undefined);
+
+    expect(callOrder).toEqual(['beforeSession', 'onError', 'afterSession']);
+  });
+});