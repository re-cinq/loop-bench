+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+// One expect per test needs the rejection as a value rather than a matcher.
+const outcomeOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved without throwing').catch((error: Error) => error.message);
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// beforeSession throws before the provider is ever reached, so this provider only has to exist.
+const unreachedProvider: AIProvider = {
+  async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'never sent'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator when beforeSession throws', () => {
+  it('still runs onError with the thrown error, and the caller still gets the rejection', async () => {
+    const thrown = new Error('session allocation failed');
+    let receivedError: Error | undefined;
+    let receivedSession: ChatSession | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw thrown;
+      },
+      onError: async (session, error) => {
+        receivedSession = session;
+        receivedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(unreachedProvider, promptBuilder, undefined, {hooks});
+    const session = createSession('hello');
+    const outcome = await outcomeOf(orchestrator.processMessage(session));
+
+    expect({
+      outcome,
+      errorIsThrown: receivedError === thrown,
+      sessionIsPassed: receivedSession === session,
+    }).toEqual({
+      outcome: 'session allocation failed',
+      errorIsThrown: true,
+      sessionIsPassed: true,
+    });
+  });
+
+  it('still runs afterSession, so a hook that releases what beforeSession allocated is called', async () => {
+    let afterSessionCalled = false;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw new Error('session allocation failed');
+      },
+      onError: async () => {},
+      afterSession: async () => {
+        afterSessionCalled = true;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(unreachedProvider, promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({outcome, afterSessionCalled}).toEqual({
+      outcome: 'session allocation failed',
+      afterSessionCalled: true,
+    });
+  });
+});