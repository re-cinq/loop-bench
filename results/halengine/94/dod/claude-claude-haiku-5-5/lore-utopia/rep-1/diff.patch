+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+// One expect per test needs the rejection as a value rather than a matcher.
+const outcomeOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved without throwing').catch((error: Error) => error.message);
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// beforeSession throws before any provider call, so the provider is never reached.
+const unusedProvider: AIProvider = {
+  async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+// Claim: beforeSession is awaited before the try block opens, so a throw from it skips onError and afterSession.
+describe('ChatOrchestrator when beforeSession throws', () => {
+  it('runs onError with the same session and error, and the caller still gets the rejection', async () => {
+    const thrown = new Error('allocation failed');
+    let received: {session: ChatSession; error: Error} | undefined;
+    const session = createSession('hello');
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw thrown;
+      },
+      onError: async (seenSession, error) => {
+        received = {session: seenSession, error};
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(unusedProvider, promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(session));
+
+    expect({
+      outcome,
+      sameSession: received?.session === session,
+      sameError: received?.error === thrown,
+    }).toEqual({outcome: 'allocation failed', sameSession: true, sameError: true});
+  });
+
+  it('runs afterSession after onError, so a deployer can release what beforeSession allocated', async () => {
+    const callOrder: string[] = [];
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw new Error('allocation failed');
+      },
+      onError: async () => void callOrder.push('onError'),
+      afterSession: async () => void callOrder.push('afterSession'),
+    };
+
+    const orchestrator = createChatOrchestrator(unusedProvider, promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({outcome, callOrder}).toEqual({
+      outcome: 'allocation failed',
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+    });
+  });
+});