+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+// One expect per test needs the rejection as a value rather than a matcher.
+const outcomeOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved without throwing').catch((error: Error) => error.message);
+
+function createSession(): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+  };
+}
+
+const provider: AIProvider = {
+  async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'hi'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const BEFORE_SESSION_ERROR = 'span allocation failed';
+
+describe('a beforeSession that throws', () => {
+  it('reaches onError with the thrown Error for the same session, and the caller still gets that rejection', async () => {
+    const seen: Array<{sameSession: boolean; message: string}> = [];
+    const session = createSession();
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw new Error(BEFORE_SESSION_ERROR);
+      },
+      onError: async (receivedSession, error) => {
+        seen.push({sameSession: receivedSession === session, message: error.message});
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(session));
+
+    expect({outcome, onError: seen}).toEqual({
+      outcome: BEFORE_SESSION_ERROR,
+      onError: [{sameSession: true, message: BEFORE_SESSION_ERROR}],
+    });
+  });
+
+  it('still runs afterSession, so a hook that releases what beforeSession allocated is not skipped', async () => {
+    let afterSessionCalled = false;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw new Error(BEFORE_SESSION_ERROR);
+      },
+      onError: async () => {},
+      afterSession: async () => {
+        afterSessionCalled = true;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(createSession()));
+
+    expect({outcome, afterSessionCalled}).toEqual({outcome: BEFORE_SESSION_ERROR, afterSessionCalled: true});
+  });
+});