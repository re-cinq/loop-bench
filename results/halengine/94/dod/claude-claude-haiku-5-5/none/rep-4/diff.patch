+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+// One expect per test needs the rejection as a value rather than a matcher.
+const outcomeOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved without throwing').catch((error: Error) => error.message);
+
+const createSession = (content: string): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content, timestamp: SENT_AT}],
+});
+
+// beforeSession throws before any provider call, so this provider must never be reached.
+const unreachedProvider: AIProvider = {
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw new Error('provider should not be reached');
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator when beforeSession throws', () => {
+  it('hands the same error and session to onError, and still rejects the caller with it', async () => {
+    const failure = new Error('span allocation failed');
+    const session = createSession('hello');
+    let onErrorSession: ChatSession | undefined;
+    let onErrorError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw failure;
+      },
+      onError: async (receivedSession, error) => {
+        onErrorSession = receivedSession;
+        onErrorError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(unreachedProvider, promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(session));
+
+    expect({
+      outcome,
+      onErrorGotSession: onErrorSession === session,
+      onErrorGotError: onErrorError === failure,
+    }).toEqual({
+      outcome: 'span allocation failed',
+      onErrorGotSession: true,
+      onErrorGotError: true,
+    });
+  });
+
+  it('still runs afterSession, so a hook that released a resource in beforeSession is not skipped', async () => {
+    let afterSessionCalled = false;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw new Error('span allocation failed');
+      },
+      afterSession: async () => {
+        afterSessionCalled = true;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(unreachedProvider, promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({outcome, afterSessionCalled}).toEqual({outcome: 'span allocation failed', afterSessionCalled: true});
+  });
+});