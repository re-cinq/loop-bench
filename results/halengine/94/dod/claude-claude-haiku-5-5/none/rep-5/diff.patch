+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const createSession = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+// Never reached when beforeSession throws: the turn is refused before any provider call.
+const unreachedProvider: AIProvider = {
+  async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'ok'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+describe('beforeSession that throws', () => {
+  it('still runs onError and afterSession, and rejects the caller with the same error', async () => {
+    const callOrder: string[] = [];
+    const onErrorArgs: Array<{session: ChatSession; error: Error}> = [];
+    const session = createSession();
+    const failure = new Error('beforeSession refused the turn');
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw failure;
+      },
+      onError: async (s, error) => {
+        callOrder.push('onError');
+        onErrorArgs.push({session: s, error});
+      },
+      afterSession: async () => {
+        callOrder.push('afterSession');
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(unreachedProvider, promptBuilder, undefined, {hooks});
+    const rejection = await orchestrator.processMessage(session).then(
+      () => undefined,
+      (error: unknown) => error
+    );
+
+    expect({callOrder, rejection, onErrorArgs}).toEqual({
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+      rejection: failure,
+      onErrorArgs: [{session, error: failure}],
+    });
+  });
+});