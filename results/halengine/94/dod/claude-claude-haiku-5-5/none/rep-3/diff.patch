+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+// One expect per test needs the rejection as a value rather than a matcher.
+const outcomeOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved without throwing').catch((error: Error) => error.message);
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// beforeSession throws before any model call, so this provider must never be reached.
+const unreachedProvider: AIProvider = {
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'should not be sent'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator when beforeSession throws', () => {
+  it('reaches onError with the same session and error, and the caller still gets the rejection', async () => {
+    const session = createSession('hello');
+    let receivedSession: ChatSession | undefined;
+    let receivedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw new Error('allocation failed');
+      },
+      onError: async (s, error) => {
+        receivedSession = s;
+        receivedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(unreachedProvider, promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(session));
+
+    expect({
+      outcome,
+      onErrorSawSession: receivedSession === session,
+      onErrorMessage: receivedError?.message,
+    }).toEqual({
+      outcome: 'allocation failed',
+      onErrorSawSession: true,
+      onErrorMessage: 'allocation failed',
+    });
+  });
+
+  it('still runs afterSession, so a hook can release what beforeSession allocated', async () => {
+    let afterSessionCalled = false;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw new Error('allocation failed');
+      },
+      afterSession: async () => {
+        afterSessionCalled = true;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(unreachedProvider, promptBuilder, undefined, {hooks});
+    await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+    expect(afterSessionCalled).toBe(true);
+  });
+});