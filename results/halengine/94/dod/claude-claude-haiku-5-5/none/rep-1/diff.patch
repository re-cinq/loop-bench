+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+// One expect per test needs the rejection as a value rather than a matcher.
+const outcomeOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved without throwing').catch((error: Error) => error.message);
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// beforeSession throws before any provider call, so the provider is never reached.
+const unreachedProvider: AIProvider = {
+  async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'unreachable'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator when beforeSession throws', () => {
+  it('calls onError with the session and the thrown error, and the caller still sees the rejection', async () => {
+    const session = createSession('hello');
+    let receivedSession: ChatSession | undefined;
+    let receivedMessage: string | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw new Error('span allocation failed');
+      },
+      onError: async (s, error) => {
+        receivedSession = s;
+        receivedMessage = error.message;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(unreachedProvider, promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(session));
+
+    expect({
+      outcome,
+      onErrorGotSameSession: receivedSession === session,
+      receivedMessage,
+    }).toEqual({
+      outcome: 'span allocation failed',
+      onErrorGotSameSession: true,
+      receivedMessage: 'span allocation failed',
+    });
+  });
+
+  it('calls afterSession even though beforeSession threw, so a deployer can release what it allocated', async () => {
+    let afterSessionCalled = false;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw new Error('rate-limit token unavailable');
+      },
+      onError: async () => {},
+      afterSession: async () => {
+        afterSessionCalled = true;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(unreachedProvider, promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(createSession('hello')));
+
+    expect({outcome, afterSessionCalled}).toEqual({
+      outcome: 'rate-limit token unavailable',
+      afterSessionCalled: true,
+    });
+  });
+});