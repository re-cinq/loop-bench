@@ -0,0 +1,46 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {answering, writeSignalPromptBuilder} from '../infrastructure/writeSignalTestSupport.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+describe('ChatOrchestrator beforeSession failure lifecycle', () => {
+  it('runs onError then afterSession when beforeSession throws, and still rejects to the caller', async () => {
+    const events: string[] = [];
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+    };
+    const hooks: OrchestratorHooks = {
+      beforeSession: async current => {
+        events.push(`beforeSession:${current.sessionId}`);
+        throw new Error('beforeSession boom');
+      },
+      beforeUserInput: async (_current, msg) => {
+        events.push('beforeUserInput');
+        return msg;
+      },
+      afterUserInput: async () => void events.push('afterUserInput'),
+      beforeModelResponse: async (_current, prompt) => {
+        events.push('beforeModelResponse');
+        return prompt;
+      },
+      afterModelResponse: async () => void events.push('afterModelResponse'),
+      onError: async (current, error) => void events.push(`onError:${current.sessionId}:${error.message}`),
+      afterSession: async current => void events.push(`afterSession:${current.sessionId}`),
+    };
+    const orchestrator = createChatOrchestrator(answering('ok'), writeSignalPromptBuilder, undefined, {hooks});
+
+    const outcome = await orchestrator
+      .processMessage(session)
+      .then(() => 'resolved without throwing')
+      .catch((error: Error) => error.message);
+
+    expect({outcome, events}).toEqual({
+      outcome: 'beforeSession boom',
+      events: ['beforeSession:s1', 'onError:s1:beforeSession boom', 'afterSession:s1'],
+    });
+  });
+});