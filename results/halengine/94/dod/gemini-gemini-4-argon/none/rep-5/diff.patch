+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const sessionWith = (content: string): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content, timestamp: SENT_AT}],
+});
+
+const answeringProvider = (reply: string): AIProvider => ({
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: reply};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('when beforeSession throws', () => {
+  it('runs onError with the session and error, then afterSession, and still rejects', async () => {
+    const events: string[] = [];
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        events.push('beforeSession');
+        throw new Error('allocation failed');
+      },
+      beforeUserInput: async (_session, msg) => {
+        events.push('beforeUserInput');
+        return msg;
+      },
+      afterUserInput: async () => void events.push('afterUserInput'),
+      beforeModelResponse: async (_session, prompt) => {
+        events.push('beforeModelResponse');
+        return prompt;
+      },
+      afterModelResponse: async () => void events.push('afterModelResponse'),
+      onError: async (session, error) => {
+        events.push(`onError:${session.sessionId}:${error.message}`);
+      },
+      afterSession: async session => {
+        events.push(`afterSession:${session.sessionId}:${session.entries.length}`);
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(answeringProvider('never reached'), promptBuilder, undefined, {hooks});
+    const session = sessionWith('hello');
+    const rejection = await orchestrator
+      .processMessage(session)
+      .then(() => 'resolved')
+      .catch((error: Error) => `rejected:${error.message}`);
+
+    expect({rejection, events}).toEqual({
+      rejection: 'rejected:allocation failed',
+      events: ['beforeSession', 'onError:s1:allocation failed', 'afterSession:s1:1'],
+    });
+  });
+});