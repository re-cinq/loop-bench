@@ -0,0 +1,61 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {answering, writeSignalPromptBuilder} from '../infrastructure/writeSignalTestSupport.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const sessionWith = (content: string): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content, timestamp: SENT_AT}],
+});
+
+describe('when beforeSession throws', () => {
+  it('runs onError with the session and error, then afterSession, and still rejects at the caller', async () => {
+    const order: string[] = [];
+    const seen: {onErrorSession?: string; onErrorMessage?: string; afterSessionId?: string} = {};
+    const session = sessionWith('hello');
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        order.push('beforeSession');
+        throw new Error('allocation failed');
+      },
+      beforeUserInput: async (_s, msg) => {
+        order.push('beforeUserInput');
+        return msg;
+      },
+      afterUserInput: async () => void order.push('afterUserInput'),
+      beforeModelResponse: async (_s, prompt) => {
+        order.push('beforeModelResponse');
+        return prompt;
+      },
+      afterModelResponse: async () => void order.push('afterModelResponse'),
+      onError: async (s, error) => {
+        order.push('onError');
+        seen.onErrorSession = s.sessionId;
+        seen.onErrorMessage = error.message;
+      },
+      afterSession: async s => {
+        order.push('afterSession');
+        seen.afterSessionId = s.sessionId;
+      },
+    };
+    const orchestrator = createChatOrchestrator(answering('unreachable'), writeSignalPromptBuilder, undefined, {hooks});
+
+    const outcome = await orchestrator
+      .processMessage(session)
+      .then(() => 'resolved without throwing')
+      .catch((error: Error) => `rejected: ${error.message}`);
+
+    expect({outcome, order, seen}).toEqual({
+      outcome: 'rejected: allocation failed',
+      order: ['beforeSession', 'onError', 'afterSession'],
+      seen: {
+        onErrorSession: 's1',
+        onErrorMessage: 'allocation failed',
+        afterSessionId: 's1',
+      },
+    });
+  });
+});