+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const createSession = (content: string): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content, timestamp: SENT_AT}],
+});
+
+const createRecordingProvider = (): {provider: AIProvider; calls: () => number} => {
+  let count = 0;
+  return {
+    calls: () => count,
+    provider: {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        count++;
+        yield {type: 'text', text: 'ok'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    },
+  };
+};
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator when beforeSession throws', () => {
+  it('runs onError then afterSession and rejects with the thrown error when beforeSession throws', async () => {
+    const callOrder: string[] = [];
+    const thrown = new Error('allocation failed');
+    const session = createSession('hello');
+    let errorSeen: {session: ChatSession; error: Error} | undefined;
+    let afterSeen: {session: ChatSession; entriesCount: number} | undefined;
+    const {provider, calls} = createRecordingProvider();
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw thrown;
+      },
+      beforeUserInput: async (_s, msg) => {
+        callOrder.push('beforeUserInput');
+        return msg;
+      },
+      afterUserInput: async () => {
+        callOrder.push('afterUserInput');
+      },
+      beforeModelResponse: async (_s, prompt) => {
+        callOrder.push('beforeModelResponse');
+        return prompt;
+      },
+      afterModelResponse: async () => {
+        callOrder.push('afterModelResponse');
+      },
+      onError: async (s, error) => {
+        callOrder.push('onError');
+        errorSeen = {session: s, error};
+      },
+      afterSession: async s => {
+        callOrder.push('afterSession');
+        afterSeen = {session: s, entriesCount: s.entries.length};
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+    const outcome = await orchestrator
+      .processMessage(session)
+      .then(() => 'resolved without throwing')
+      .catch((error: unknown) => error);
+
+    expect({
+      outcome,
+      callOrder,
+      errorSeen,
+      afterSeen,
+      providerCalls: calls(),
+    }).toEqual({
+      outcome: thrown,
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+      errorSeen: {session, error: thrown},
+      afterSeen: {session, entriesCount: 1},
+      providerCalls: 0,
+    });
+  });
+});