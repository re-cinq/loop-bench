+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {answering, writeSignalPromptBuilder} from '../infrastructure/writeSignalTestSupport.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+describe('a beforeSession hook that throws', () => {
+  it('runs onError and afterSession and rethrows when beforeSession throws', async () => {
+    const order: string[] = [];
+    const seen: {errorSession?: ChatSession; errorMessage?: string; afterSession?: ChatSession} = {};
+    const session: ChatSession = {
+      sessionId: 's-before-throw',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+    };
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        order.push('beforeSession');
+        throw new Error('rate limit token unavailable');
+      },
+      beforeUserInput: async (_s, msg) => {
+        order.push('beforeUserInput');
+        return msg;
+      },
+      onError: async (s, error) => {
+        order.push('onError');
+        seen.errorSession = s;
+        seen.errorMessage = error.message;
+      },
+      afterSession: async s => {
+        order.push('afterSession');
+        seen.afterSession = s;
+      },
+    };
+    const orchestrator = createChatOrchestrator(answering('hi'), writeSignalPromptBuilder, undefined, {hooks});
+
+    const outcome = await orchestrator
+      .processMessage(session)
+      .then(() => 'resolved')
+      .catch((error: Error) => `rejected: ${error.message}`);
+
+    expect({outcome, order, seen}).toEqual({
+      outcome: 'rejected: rate limit token unavailable',
+      order: ['beforeSession', 'onError', 'afterSession'],
+      seen: {
+        errorSession: session,
+        errorMessage: 'rate limit token unavailable',
+        afterSession: session,
+      },
+    });
+  });
+});