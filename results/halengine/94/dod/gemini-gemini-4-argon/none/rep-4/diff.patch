@@ -0,0 +1,48 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {answering, writeSignalPromptBuilder} from '../infrastructure/writeSignalTestSupport.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('ChatOrchestrator when beforeSession throws', () => {
+  it('runs onError and afterSession in order and still rejects with the thrown error', async () => {
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const allocationFailure = new Error('span allocation failed');
+    const observed: Array<{hook: string; session: ChatSession; error?: Error}> = [];
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw allocationFailure;
+      },
+      beforeUserInput: async (seenSession, message) => {
+        observed.push({hook: 'beforeUserInput', session: seenSession});
+        return message;
+      },
+      afterUserInput: async seenSession => void observed.push({hook: 'afterUserInput', session: seenSession}),
+      beforeModelResponse: async (seenSession, prompt) => {
+        observed.push({hook: 'beforeModelResponse', session: seenSession});
+        return prompt;
+      },
+      afterModelResponse: async seenSession => void observed.push({hook: 'afterModelResponse', session: seenSession}),
+      onError: async (seenSession, seenError) =>
+        void observed.push({hook: 'onError', session: seenSession, error: seenError}),
+      afterSession: async seenSession => void observed.push({hook: 'afterSession', session: seenSession}),
+    };
+    const orchestrator = createChatOrchestrator(answering('ok'), writeSignalPromptBuilder, undefined, {hooks});
+
+    const rejection = await orchestrator
+      .processMessage(session)
+      .then(() => undefined)
+      .catch((error: unknown) => error);
+
+    expect({rejection, observed}).toEqual({
+      rejection: allocationFailure,
+      observed: [
+        {hook: 'onError', session, error: allocationFailure},
+        {hook: 'afterSession', session},
+      ],
+    });
+  });
+});