@@ -0,0 +1,70 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/index.js';
+import type {ChatSession} from '../types/session.js';
+
+// @spec specs/hal-engine-config-hooks/spec.md#7
+it('reports and cleans up a failed beforeSession before rejecting with the original error', async () => {
+  const session: ChatSession = {
+    sessionId: 'setup-failure',
+    userId: 'user',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const failure = new Error('setup failed after allocating a resource');
+  const events: string[] = [];
+  let allocated = false;
+  let reportedSession: ChatSession | undefined;
+  let reportedError: Error | undefined;
+  let cleanedSession: ChatSession | undefined;
+  const orchestrator = createChatOrchestrator(
+    createMockProvider(),
+    new PromptBuilder({identity: 'You are an assistant.'}),
+    undefined,
+    {
+      hooks: {
+        beforeSession: async () => {
+          events.push('beforeSession');
+          allocated = true;
+          throw failure;
+        },
+        beforeUserInput: async (_session, message) => {
+          events.push('beforeUserInput');
+          return message;
+        },
+        onError: async (currentSession, error) => {
+          events.push('onError');
+          reportedSession = currentSession;
+          reportedError = error;
+        },
+        afterSession: async currentSession => {
+          events.push('afterSession');
+          cleanedSession = currentSession;
+          allocated = false;
+        },
+      },
+    }
+  );
+
+  const rejection: unknown = await orchestrator.processMessage(session).then(
+    () => undefined,
+    (error: unknown) => error
+  );
+
+  expect({
+    originalRejection: rejection === failure,
+    originalErrorReported: reportedError === failure,
+    sameSessionReported: reportedSession === session,
+    sameSessionCleaned: cleanedSession === session,
+    allocated,
+    events,
+    entries: session.entries,
+  }).toEqual({
+    originalRejection: true,
+    originalErrorReported: true,
+    sameSessionReported: true,
+    sameSessionCleaned: true,
+    allocated: false,
+    events: ['beforeSession', 'onError', 'afterSession'],
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  });
+});