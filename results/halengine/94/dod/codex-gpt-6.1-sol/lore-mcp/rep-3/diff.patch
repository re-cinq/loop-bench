@@ -0,0 +1,88 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {createMockProvider} from '../providers/mock/index.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+// spec: specs/hal-engine-config-hooks/spec.md#7
+it('reports and cleans up a failed beforeSession before rejecting the caller with the original error', async () => {
+  const observations = [];
+  for (const streaming of [false, true]) {
+    const session: ChatSession = {
+      sessionId: 'failed-start',
+      userId: 'user',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const failure = new Error('session allocation failed');
+    const events: string[] = [];
+    let allocated = false;
+    let reportedSameSession = false;
+    let reportedSameError = false;
+    let cleanedSameSession = false;
+    const orchestrator = createChatOrchestrator(
+      createMockProvider(),
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      undefined,
+      {
+        hooks: {
+          beforeSession: async () => {
+            events.push('beforeSession');
+            allocated = true;
+            throw failure;
+          },
+          beforeUserInput: async (_session, message) => {
+            events.push('beforeUserInput');
+            return message;
+          },
+          beforeModelResponse: async (_session, prompt) => {
+            events.push('beforeModelResponse');
+            return prompt;
+          },
+          onError: async (receivedSession, error) => {
+            events.push('onError');
+            reportedSameSession = receivedSession === session;
+            reportedSameError = error === failure;
+          },
+          afterSession: async receivedSession => {
+            events.push('afterSession');
+            cleanedSameSession = receivedSession === session;
+            allocated = false;
+          },
+        },
+      }
+    );
+    let rejection: unknown;
+    try {
+      if (streaming) {
+        for await (const chunk of orchestrator.processMessageStream(session)) {
+          events.push(`chunk:${chunk.type}`);
+        }
+      } else {
+        await orchestrator.processMessage(session);
+      }
+    } catch (error) {
+      rejection = error;
+      events.push('caller rejected');
+    }
+    observations.push({
+      streaming,
+      events,
+      rejectedSameError: rejection === failure,
+      reportedSameSession,
+      reportedSameError,
+      cleanedSameSession,
+      allocated,
+    });
+  }
+
+  expect(observations).toEqual(
+    [false, true].map(streaming => ({
+      streaming,
+      events: ['beforeSession', 'onError', 'afterSession', 'caller rejected'],
+      rejectedSameError: true,
+      reportedSameSession: true,
+      reportedSameError: true,
+      cleanedSameSession: true,
+      allocated: false,
+    }))
+  );
+});