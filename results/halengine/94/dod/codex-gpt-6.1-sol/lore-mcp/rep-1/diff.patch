+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/index.js';
+import type {ChatSession} from '../types/session.js';
+
+// @spec specs/hal-engine-config-hooks/spec.md#7
+it('reports a beforeSession failure and finishes cleanup before rejecting with the original error', async () => {
+  const session: ChatSession = {
+    sessionId: 'failed-setup',
+    userId: 'user-1',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const failure = new Error('session allocation failed');
+  const events: string[] = [];
+  let errorSession: ChatSession | undefined;
+  let reportedError: Error | undefined;
+  let cleanupSession: ChatSession | undefined;
+  const orchestrator = createChatOrchestrator(
+    createMockProvider(),
+    new PromptBuilder({identity: 'You are an assistant.'}),
+    undefined,
+    {
+      hooks: {
+        beforeSession: async () => {
+          events.push('beforeSession');
+          await Promise.resolve();
+          throw failure;
+        },
+        beforeUserInput: async (_session, message) => {
+          events.push('beforeUserInput');
+          return message;
+        },
+        afterModelResponse: async () => {
+          events.push('afterModelResponse');
+        },
+        onError: async (receivedSession, error) => {
+          await Promise.resolve();
+          errorSession = receivedSession;
+          reportedError = error;
+          events.push('onError');
+        },
+        afterSession: async receivedSession => {
+          await Promise.resolve();
+          cleanupSession = receivedSession;
+          events.push('afterSession');
+        },
+      },
+    }
+  );
+
+  const outcome: unknown = await orchestrator.processMessage(session).catch((error: unknown) => error);
+  events.push('caller');
+
+  expect({
+    originalRejection: outcome === failure,
+    originalReportedError: reportedError === failure,
+    originalErrorSession: errorSession === session,
+    originalCleanupSession: cleanupSession === session,
+    events,
+    entries: session.entries,
+  }).toEqual({
+    originalRejection: true,
+    originalReportedError: true,
+    originalErrorSession: true,
+    originalCleanupSession: true,
+    events: ['beforeSession', 'onError', 'afterSession', 'caller'],
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  });
+});