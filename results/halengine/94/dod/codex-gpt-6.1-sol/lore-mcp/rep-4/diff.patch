@@ -0,0 +1,75 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import type {ChatSession} from '../types/session.js';
+
+// spec: specs/hal-engine-config-hooks/spec.md#7
+it('reports and cleans up a failed beforeSession before rejecting with the original error', async () => {
+  const results = [];
+  for (const method of ['processMessage', 'processMessageStream'] as const) {
+    const session: ChatSession = {
+      sessionId: method,
+      userId: 'deployer',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const failure = new Error('initialization failed after allocating a resource');
+    const calls: string[] = [];
+    let allocated = false;
+    let errorSession: ChatSession | undefined;
+    let reportedError: Error | undefined;
+    let cleanupSession: ChatSession | undefined;
+    const orchestrator = createChatOrchestrator(
+      createMockProvider(),
+      new PromptBuilder({identity: 'Assistant'}),
+      undefined,
+      {
+        hooks: {
+          beforeSession: async () => {
+            calls.push('beforeSession');
+            allocated = true;
+            throw failure;
+          },
+          beforeUserInput: async (_session, message) => {
+            calls.push('beforeUserInput');
+            return message;
+          },
+          onError: async (receivedSession, error) => {
+            calls.push('onError');
+            errorSession = receivedSession;
+            reportedError = error;
+          },
+          afterSession: async receivedSession => {
+            calls.push('afterSession');
+            cleanupSession = receivedSession;
+            allocated = false;
+          },
+        },
+      }
+    );
+    let rejection: unknown;
+    try {
+      if (method === 'processMessage') await orchestrator.processMessage(session);
+      else for await (const chunk of orchestrator.processMessageStream(session)) calls.push(chunk.type);
+    } catch (error) {
+      rejection = error;
+    }
+    results.push({
+      method,
+      calls,
+      originalRejection: rejection === failure,
+      originalErrorArgument: reportedError === failure,
+      originalSessionArguments: errorSession === session && cleanupSession === session,
+      allocated,
+    });
+  }
+  expect(results).toEqual(
+    ['processMessage', 'processMessageStream'].map(method => ({
+      method,
+      calls: ['beforeSession', 'onError', 'afterSession'],
+      originalRejection: true,
+      originalErrorArgument: true,
+      originalSessionArguments: true,
+      allocated: false,
+    }))
+  );
+});