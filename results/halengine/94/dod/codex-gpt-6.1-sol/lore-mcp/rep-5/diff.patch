+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import type {ChatSession} from '../types/session.js';
+
+// @spec specs/hal-engine-config-hooks/spec.md#7
+it('reports a beforeSession failure and cleans up before rejecting with the original error', async () => {
+  const session: ChatSession = {
+    sessionId: 'startup-failure',
+    userId: 'user',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const failure = new Error('session allocation failed');
+  const events: string[] = [];
+  const resources = new Set<ChatSession>();
+  let errorSession: ChatSession | undefined;
+  let reportedError: Error | undefined;
+  let cleanupSession: ChatSession | undefined;
+  const orchestrator = createChatOrchestrator(
+    createMockProvider(),
+    new PromptBuilder({identity: 'You are a test assistant.'}),
+    undefined,
+    {
+      hooks: {
+        beforeSession: async current => {
+          events.push('beforeSession');
+          resources.add(current);
+          throw failure;
+        },
+        beforeUserInput: async (_current, message) => {
+          events.push('beforeUserInput');
+          return message;
+        },
+        onError: async (current, error) => {
+          errorSession = current;
+          reportedError = error;
+          events.push('onError');
+        },
+        afterSession: async current => {
+          cleanupSession = current;
+          resources.delete(current);
+          events.push('afterSession');
+        },
+      },
+    }
+  );
+
+  const rejection: unknown = await orchestrator.processMessage(session).catch((error: unknown) => error);
+  events.push('caller');
+
+  expect({
+    originalRejection: rejection === failure,
+    originalErrorReported: reportedError === failure,
+    errorSessionMatches: errorSession === session,
+    cleanupSessionMatches: cleanupSession === session,
+    resourcesRemaining: resources.size,
+    events,
+    entries: session.entries,
+  }).toEqual({
+    originalRejection: true,
+    originalErrorReported: true,
+    errorSessionMatches: true,
+    cleanupSessionMatches: true,
+    resourcesRemaining: 0,
+    events: ['beforeSession', 'onError', 'afterSession', 'caller'],
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  });
+});