@@ -0,0 +1,62 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import type {ChatSession} from '../types/session.js';
+
+// Spec: specs/hal-engine-config-hooks/spec.md#7
+it('reports a beforeSession failure and cleans up partial setup before rejecting with the original error', async () => {
+  const session: ChatSession = {
+    sessionId: 'failed-start',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const failure = new Error('setup failed after allocating a resource');
+  const events: unknown[][] = [];
+  const resources = new Set<ChatSession>();
+  const orchestrator = createChatOrchestrator(
+    createMockProvider(),
+    new PromptBuilder({identity: 'You are a test assistant.'}),
+    undefined,
+    {
+      hooks: {
+        beforeSession: async current => {
+          resources.add(current);
+          events.push(['beforeSession', current === session]);
+          throw failure;
+        },
+        beforeUserInput: async (current, message) => {
+          events.push(['beforeUserInput', current === session]);
+          return message;
+        },
+        onError: async (current, error) => {
+          events.push(['onError', current === session, error === failure]);
+        },
+        afterSession: async current => {
+          resources.delete(current);
+          events.push(['afterSession', current === session]);
+        },
+      },
+    }
+  );
+
+  const rejection = await orchestrator.processMessage(session).then(
+    () => undefined,
+    (error: unknown) => error
+  );
+
+  expect({
+    sameError: rejection === failure,
+    events,
+    resourcesRemaining: resources.size,
+    entries: session.entries,
+  }).toEqual({
+    sameError: true,
+    events: [
+      ['beforeSession', true],
+      ['onError', true, true],
+      ['afterSession', true],
+    ],
+    resourcesRemaining: 0,
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  });
+});