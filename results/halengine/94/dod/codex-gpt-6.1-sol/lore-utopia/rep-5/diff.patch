@@ -0,0 +1,75 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createBedrockProvider} from '../providers/bedrock/index.js';
+
+// specs/hal-engine-config-hooks/spec.md#7
+it('reports a beforeSession failure and cleans up partial setup before rejecting with the original error', async () => {
+  const session: ChatSession = {
+    sessionId: 'failed-setup',
+    userId: 'deployer',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const failure = new Error('session setup failed after allocating a resource');
+  const resources = new Set<ChatSession>();
+  const events: string[] = [];
+  let errorSession: ChatSession | undefined;
+  let reportedError: Error | undefined;
+  let cleanupSession: ChatSession | undefined;
+  const hooks: OrchestratorHooks = {
+    beforeSession: async current => {
+      events.push('beforeSession');
+      resources.add(current);
+      throw failure;
+    },
+    beforeUserInput: async (_current, message) => {
+      events.push('beforeUserInput');
+      return message;
+    },
+    beforeModelResponse: async (_current, prompt) => {
+      events.push('beforeModelResponse');
+      return prompt;
+    },
+    afterModelResponse: async () => {
+      events.push('afterModelResponse');
+    },
+    onError: async (current, error) => {
+      events.push('onError');
+      errorSession = current;
+      reportedError = error;
+    },
+    afterSession: async current => {
+      events.push('afterSession');
+      cleanupSession = current;
+      resources.delete(current);
+    },
+  };
+  const orchestrator = createChatOrchestrator(
+    createBedrockProvider({type: 'bedrock', region: 'eu-central-1', modelId: 'unused', maxTokens: 1}),
+    new PromptBuilder({identity: 'You are a helpful assistant.'}),
+    undefined,
+    {hooks}
+  );
+
+  const rejection: unknown = await orchestrator.processMessage(session).catch((error: unknown) => error);
+  events.push('caller');
+
+  expect({
+    rejectsWithOriginalError: rejection === failure,
+    reportsOriginalSession: errorSession === session,
+    reportsOriginalError: reportedError === failure,
+    cleansUpOriginalSession: cleanupSession === session,
+    resourcesRemaining: resources.size,
+    events,
+    entries: session.entries,
+  }).toEqual({
+    rejectsWithOriginalError: true,
+    reportsOriginalSession: true,
+    reportsOriginalError: true,
+    cleansUpOriginalSession: true,
+    resourcesRemaining: 0,
+    events: ['beforeSession', 'onError', 'afterSession', 'caller'],
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  });
+});