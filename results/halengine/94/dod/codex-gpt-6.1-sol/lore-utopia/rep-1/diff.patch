@@ -0,0 +1,90 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createBedrockProvider} from '../providers/bedrock/bedrockProvider.js';
+import type {ChatSession} from '../types/session.js';
+
+// @spec specs/hal-engine-config-hooks/spec.md#7
+it('reports and cleans up a failed beforeSession while rejecting with the original error', async () => {
+  const outcomes = [];
+  const provider = createBedrockProvider({
+    type: 'bedrock',
+    modelId: 'unused-before-session',
+    region: 'eu-central-1',
+    maxTokens: 1,
+  });
+
+  for (const entryPoint of ['processMessage', 'processMessageStream'] as const) {
+    const failure = new Error('session allocation failed');
+    const session: ChatSession = {
+      sessionId: 'failed-start',
+      userId: 'user',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const events: string[] = [];
+    let observedSession: ChatSession | undefined;
+    let observedError: Error | undefined;
+    let cleanupSession: ChatSession | undefined;
+    let allocated = false;
+    let rejectedWith: unknown;
+    const chunks = [];
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Assistant'}), undefined, {
+      hooks: {
+        beforeSession: async () => {
+          events.push('beforeSession');
+          allocated = true;
+          throw failure;
+        },
+        beforeUserInput: async (_session, message) => {
+          events.push('beforeUserInput');
+          return message;
+        },
+        onError: async (hookSession, error) => {
+          events.push('onError');
+          observedSession = hookSession;
+          observedError = error;
+        },
+        afterSession: async hookSession => {
+          events.push('afterSession');
+          cleanupSession = hookSession;
+          allocated = false;
+        },
+      },
+    });
+
+    try {
+      if (entryPoint === 'processMessage') {
+        await orchestrator.processMessage(session);
+      } else {
+        for await (const chunk of orchestrator.processMessageStream(session)) chunks.push(chunk);
+      }
+    } catch (error) {
+      rejectedWith = error;
+    }
+
+    outcomes.push({
+      entryPoint,
+      originalRejection: rejectedWith === failure,
+      originalError: observedError === failure,
+      originalSession: observedSession === session,
+      cleanupSession: cleanupSession === session,
+      allocated,
+      events,
+      chunks,
+      entries: session.entries,
+    });
+  }
+
+  expect(outcomes).toEqual(
+    ['processMessage', 'processMessageStream'].map(entryPoint => ({
+      entryPoint,
+      originalRejection: true,
+      originalError: true,
+      originalSession: true,
+      cleanupSession: true,
+      allocated: false,
+      events: ['beforeSession', 'onError', 'afterSession'],
+      chunks: [],
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    }))
+  );
+});