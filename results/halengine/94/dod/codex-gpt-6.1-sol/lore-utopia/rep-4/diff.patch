+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/index.js';
+import type {ChatSession} from '../types/session.js';
+
+// @spec specs/hal-engine-config-hooks/spec.md#7
+it('reports and cleans up a failed beforeSession before rejecting with the original error', async () => {
+  const session: ChatSession = {
+    sessionId: 'failed-start',
+    userId: 'user',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const failure = new Error('session allocation failed');
+  const calls: unknown[][] = [];
+  const orchestrator = createChatOrchestrator(
+    createMockProvider(),
+    new PromptBuilder({identity: 'You are an assistant.'}),
+    undefined,
+    {
+      hooks: {
+        beforeSession: async receivedSession => {
+          calls.push(['beforeSession', receivedSession]);
+          throw failure;
+        },
+        beforeUserInput: async (_session, message) => {
+          calls.push(['beforeUserInput']);
+          return message;
+        },
+        afterModelResponse: async () => {
+          calls.push(['afterModelResponse']);
+        },
+        onError: async (receivedSession, error) => {
+          calls.push(['onError', receivedSession, error]);
+        },
+        afterSession: async receivedSession => {
+          calls.push(['afterSession', receivedSession]);
+        },
+      },
+    }
+  );
+
+  const rejected = await orchestrator.processMessage(session).then(
+    () => undefined,
+    (error: unknown) => error
+  );
+
+  expect(rejected).toBe(failure);
+  expect(calls).toEqual([
+    ['beforeSession', session],
+    ['onError', session, failure],
+    ['afterSession', session],
+  ]);
+});