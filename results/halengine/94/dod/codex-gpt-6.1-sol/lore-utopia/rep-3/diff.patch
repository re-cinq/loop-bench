@@ -0,0 +1,58 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/index.js';
+import type {ChatSession} from '../types/session.js';
+
+// Spec: specs/hal-engine-config-hooks/spec.md#8
+it('reports and cleans up a failed beforeSession before rejecting with the original error', async () => {
+  const session: ChatSession = {
+    sessionId: 'failed-setup',
+    userId: 'deployer',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const failure = new Error('setup failed after allocating a resource');
+  const resources = new Set<ChatSession>();
+  const calls: unknown[][] = [];
+  const orchestrator = createChatOrchestrator(
+    createMockProvider(),
+    new PromptBuilder({identity: 'You are an assistant.'}),
+    undefined,
+    {
+      hooks: {
+        beforeSession: async current => {
+          calls.push(['beforeSession', current === session]);
+          resources.add(current);
+          throw failure;
+        },
+        beforeUserInput: async (current, message) => {
+          calls.push(['beforeUserInput', current === session]);
+          return message;
+        },
+        onError: async (current, error) => {
+          await Promise.resolve();
+          calls.push(['onError', current === session, error === failure]);
+        },
+        afterSession: async current => {
+          await Promise.resolve();
+          resources.delete(current);
+          calls.push(['afterSession', current === session]);
+        },
+      },
+    }
+  );
+
+  const rejection = await orchestrator.processMessage(session).then(
+    () => undefined,
+    (error: unknown) => error
+  );
+
+  expect({originalError: rejection === failure, calls, resourcesLeft: resources.size}).toEqual({
+    originalError: true,
+    calls: [
+      ['beforeSession', true],
+      ['onError', true, true],
+      ['afterSession', true],
+    ],
+    resourcesLeft: 0,
+  });
+});