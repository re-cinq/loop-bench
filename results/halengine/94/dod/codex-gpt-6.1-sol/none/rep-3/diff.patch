+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import type {ChatSession} from '../types/session.js';
+
+// Spec: specs/hal-engine-config-hooks/spec.md#7
+it('reports a beforeSession failure and runs cleanup before rejecting with the original error', async () => {
+  const session: ChatSession = {
+    sessionId: 'failed-start',
+    userId: 'user-1',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const failure = new Error('session allocation failed');
+  const events: unknown[] = [];
+  const orchestrator = createChatOrchestrator(
+    createMockProvider(),
+    new PromptBuilder({identity: 'You are an assistant.'}),
+    undefined,
+    {
+      hooks: {
+        beforeSession: async current => {
+          events.push(['beforeSession', current === session]);
+          throw failure;
+        },
+        beforeUserInput: async (_current, message) => {
+          events.push('beforeUserInput');
+          return message;
+        },
+        afterModelResponse: async () => {
+          events.push('afterModelResponse');
+        },
+        onError: async (...args) => {
+          events.push(['onError', args.length, args[0] === session, args[1] === failure]);
+        },
+        afterSession: async current => {
+          events.push(['afterSession', current === session, current.entries.map(entry => entry.content)]);
+        },
+      },
+    }
+  );
+
+  const rejection = await orchestrator.processMessage(session).then(
+    () => undefined,
+    (error: unknown) => error
+  );
+  events.push('caller rejected');
+
+  expect({originalError: rejection === failure, events}).toEqual({
+    originalError: true,
+    events: [['beforeSession', true], ['onError', 2, true, true], ['afterSession', true, ['hello']], 'caller rejected'],
+  });
+});