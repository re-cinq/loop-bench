@@ -0,0 +1,87 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/index.js';
+
+// Spec: specs/hal-engine-config-hooks/spec.md#7
+it('reports and cleans up a failed beforeSession before rejecting the caller with the original error', async () => {
+  const results = [];
+  for (const mode of ['collected', 'streamed']) {
+    const session: ChatSession = {
+      sessionId: 'failed-start',
+      userId: 'user',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const failure = new Error('initialization failed after acquiring a resource');
+    const events: string[] = [];
+    let resourceHeld = false;
+    let errorSession: ChatSession | undefined;
+    let reportedError: Error | undefined;
+    let cleanupSession: ChatSession | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        events.push('beforeSession');
+        resourceHeld = true;
+        throw failure;
+      },
+      beforeUserInput: async (_session, message) => {
+        events.push('beforeUserInput');
+        return message;
+      },
+      beforeModelResponse: async (_session, prompt) => {
+        events.push('beforeModelResponse');
+        return prompt;
+      },
+      afterModelResponse: async () => {
+        events.push('afterModelResponse');
+      },
+      onError: async (receivedSession, error) => {
+        events.push('onError');
+        errorSession = receivedSession;
+        reportedError = error;
+      },
+      afterSession: async receivedSession => {
+        events.push('afterSession');
+        cleanupSession = receivedSession;
+        resourceHeld = false;
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      createMockProvider(),
+      new PromptBuilder({identity: 'You are an assistant.'}),
+      undefined,
+      {hooks}
+    );
+    let rejection: unknown;
+    const chunks = [];
+    try {
+      if (mode === 'collected') await orchestrator.processMessage(session);
+      else for await (const chunk of orchestrator.processMessageStream(session)) chunks.push(chunk);
+    } catch (error) {
+      events.push('caller rejection');
+      rejection = error;
+    }
+    results.push({
+      mode,
+      originalError: rejection === failure,
+      errorArguments: errorSession === session && reportedError === failure,
+      cleanupArgument: cleanupSession === session,
+      resourceHeld,
+      events,
+      chunks,
+    });
+  }
+
+  expect(results).toEqual(
+    ['collected', 'streamed'].map(mode => ({
+      mode,
+      originalError: true,
+      errorArguments: true,
+      cleanupArgument: true,
+      resourceHeld: false,
+      events: ['beforeSession', 'onError', 'afterSession', 'caller rejection'],
+      chunks: [],
+    }))
+  );
+});