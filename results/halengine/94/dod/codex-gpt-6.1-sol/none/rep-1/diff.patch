@@ -0,0 +1,90 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import type {ChatSession} from '../types/session.js';
+
+// Spec: specs/hal-engine-config-hooks/spec.md#7
+it('reports and cleans up a failed beforeSession before rejecting with the original error', async () => {
+  const outcomes = [];
+  for (const entryPoint of ['processMessage', 'processMessageStream'] as const) {
+    const session: ChatSession = {
+      sessionId: 'failed-start',
+      userId: 'user',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const originalEntries = structuredClone(session.entries);
+    const failure = new Error('session allocation failed');
+    const events: string[] = [];
+    const allocated = new Set<ChatSession>();
+    const orchestrator = createChatOrchestrator(
+      createMockProvider(),
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      undefined,
+      {
+        hooks: {
+          beforeSession: async current => {
+            events.push(current === session ? 'beforeSession' : 'wrong session');
+            allocated.add(current);
+            throw failure;
+          },
+          onError: async (current, error) => {
+            await Promise.resolve();
+            events.push(current === session && error === failure ? 'onError(session, error)' : 'wrong error arguments');
+          },
+          afterSession: async current => {
+            await Promise.resolve();
+            events.push(current === session ? 'afterSession(session)' : 'wrong cleanup arguments');
+            allocated.delete(current);
+          },
+          beforeUserInput: async (_current, message) => {
+            events.push('beforeUserInput');
+            return message;
+          },
+          afterUserInput: async () => {
+            events.push('afterUserInput');
+          },
+          beforeModelResponse: async (_current, prompt) => {
+            events.push('beforeModelResponse');
+            return prompt;
+          },
+          afterModelResponse: async () => {
+            events.push('afterModelResponse');
+          },
+        },
+      }
+    );
+    const chunks = [];
+    let rejection: unknown;
+    try {
+      if (entryPoint === 'processMessage') {
+        await orchestrator.processMessage(session);
+      } else {
+        for await (const chunk of orchestrator.processMessageStream(session)) chunks.push(chunk);
+      }
+    } catch (error) {
+      rejection = error;
+      events.push('caller rejection');
+    }
+    outcomes.push({
+      entryPoint,
+      originalError: rejection === failure,
+      events,
+      released: allocated.size === 0,
+      entries: session.entries,
+      originalEntries,
+      chunks,
+    });
+  }
+
+  expect(outcomes).toEqual(
+    ['processMessage', 'processMessageStream'].map(entryPoint => ({
+      entryPoint,
+      originalError: true,
+      events: ['beforeSession', 'onError(session, error)', 'afterSession(session)', 'caller rejection'],
+      released: true,
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+      originalEntries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+      chunks: [],
+    }))
+  );
+});