+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const session: ChatSession = {
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+const provider: AIProvider = {
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'ok'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+describe('a beforeSession hook that throws', () => {
+  it('still rejects the caller, and runs onError (session, error) then afterSession', async () => {
+    const failure = new Error('allocation failed');
+    const events: Array<string | ChatSession | Error> = [];
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw failure;
+      },
+      onError: async (receivedSession, error) => {
+        events.push('onError', receivedSession, error);
+      },
+      afterSession: async receivedSession => {
+        events.push('afterSession', receivedSession);
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+    const rejection = await orchestrator.processMessage(session).then(
+      () => 'resolved without throwing',
+      (error: unknown) => error
+    );
+
+    expect({rejection, events}).toEqual({
+      rejection: failure,
+      events: ['onError', session, failure, 'afterSession', session],
+    });
+  });
+});