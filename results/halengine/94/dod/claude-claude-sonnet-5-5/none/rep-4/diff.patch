+// Spec: specs/hal-engine-config-hooks/spec.md — a throw from beforeSession reaches onError and afterSession.
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const provider: AIProvider = {
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'hi'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+const session: ChatSession = {
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+const failure = new Error('allocation failed');
+
+async function runWithFailingBeforeSession() {
+  const calls: Array<[string, unknown?]> = [];
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), undefined, {
+    hooks: {
+      beforeSession: async () => {
+        throw failure;
+      },
+      onError: async (s, error) => void calls.push(['onError', [s, error]]),
+      afterSession: async s => void calls.push(['afterSession', s]),
+    },
+  });
+  const outcome = await orchestrator.processMessage(session).then(
+    () => 'resolved',
+    (error: unknown) => error
+  );
+  return {calls, outcome};
+}
+
+describe('a beforeSession hook that throws', () => {
+  it('rejects to the caller with the original error and fires onError with (session, error)', async () => {
+    const {calls, outcome} = await runWithFailingBeforeSession();
+
+    expect({outcome, onError: calls.filter(([name]) => name === 'onError')}).toEqual({
+      outcome: failure,
+      onError: [['onError', [session, failure]]],
+    });
+  });
+
+  it('still fires afterSession with the session', async () => {
+    const {calls} = await runWithFailingBeforeSession();
+
+    expect(calls.filter(([name]) => name === 'afterSession')).toEqual([['afterSession', session]]);
+  });
+});