+import {createHalEngine} from './config.js';
+import type {WsAuthenticator} from './types/auth.js';
+import type {ChatSession} from './types/session.js';
+
+const base = {
+  provider: {type: 'mock' as const},
+  prompt: {identity: 'test'},
+  auth: {ws: (async () => null) as unknown as WsAuthenticator},
+};
+
+const session: ChatSession = {
+  sessionId: 's-before-throws',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hi', timestamp: ''}],
+};
+
+// spec: specs/hal-engine-config-hooks/spec.md#beforesession-failure
+describe('a beforeSession hook that throws', () => {
+  it('still rejects the caller with the thrown error and fires onError with (session, error)', async () => {
+    const boom = new Error('allocation failed');
+    const errors: Array<{session: ChatSession; error: Error}> = [];
+    const engine = createHalEngine({
+      ...base,
+      orchestrator: {
+        hooks: {
+          beforeSession: async () => {
+            throw boom;
+          },
+          onError: async (s, error) => void errors.push({session: s, error}),
+        },
+      },
+    });
+
+    await expect(engine.orchestrator.processMessage(session)).rejects.toBe(boom);
+
+    expect(errors).toEqual([{session, error: boom}]);
+  });
+
+  it('fires afterSession, so what beforeSession allocated can be released', async () => {
+    const after: ChatSession[] = [];
+    const engine = createHalEngine({
+      ...base,
+      orchestrator: {
+        hooks: {
+          beforeSession: async () => {
+            throw new Error('allocation failed');
+          },
+          afterSession: async s => void after.push(s),
+        },
+      },
+    });
+
+    await expect(engine.orchestrator.processMessage(session)).rejects.toThrow('allocation failed');
+
+    expect(after).toEqual([session]);
+  });
+});