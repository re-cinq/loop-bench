+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const session: ChatSession = {
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+const provider: AIProvider = {
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'ok'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+// Specs: specs/hal-engine-config-hooks/spec.md (beforeSession throw guarantee)
+describe('beforeSession that throws (HALEngine#94)', () => {
+  it('rejects to the caller, calls onError with the thrown error and the session, then calls afterSession', async () => {
+    const failure = new Error('allocation failed');
+    const calls: Array<[string, unknown?, unknown?]> = [];
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {
+      hooks: {
+        beforeSession: async () => {
+          throw failure;
+        },
+        onError: async (s, e) => void calls.push(['onError', s, e]),
+        afterSession: async s => void calls.push(['afterSession', s]),
+      },
+    });
+
+    const rejection = await orchestrator.processMessage(session).catch((e: unknown) => e);
+
+    expect({rejection, calls}).toEqual({
+      rejection: failure,
+      calls: [
+        ['onError', session, failure],
+        ['afterSession', session],
+      ],
+    });
+  });
+});