+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const session: ChatSession = {
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+};
+
+const provider: AIProvider = {
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'hi'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+describe('a beforeSession hook that throws', () => {
+  it('reaches the caller as a rejection and still runs onError, then afterSession, with the same error', async () => {
+    const failure = new Error('allocation failed');
+    const calls: string[] = [];
+    let onErrorArgs: {session: ChatSession; error: Error} | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        calls.push('beforeSession');
+        throw failure;
+      },
+      onError: async (s, error) => {
+        calls.push('onError');
+        onErrorArgs = {session: s, error};
+      },
+      afterSession: async () => {
+        calls.push('afterSession');
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      provider,
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      undefined,
+      {hooks}
+    );
+    const rejection = await orchestrator.processMessage(session).then(
+      () => undefined,
+      (error: unknown) => error
+    );
+
+    expect({
+      rejection,
+      calls,
+      onErrorSessionId: onErrorArgs?.session.sessionId,
+      onErrorError: onErrorArgs?.error,
+    }).toEqual({
+      rejection: failure,
+      calls: ['beforeSession', 'onError', 'afterSession'],
+      onErrorSessionId: 's1',
+      onErrorError: failure,
+    });
+  });
+});