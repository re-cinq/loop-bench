+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const provider: AIProvider = {
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'ok'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+const session: ChatSession = {
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+describe('a beforeSession hook that throws', () => {
+  it('still rejects to the caller, and fires onError with that error and afterSession', async () => {
+    const failure = new Error('allocation failed');
+    const calls: Array<[string, unknown?]> = [];
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw failure;
+      },
+      onError: async (_session, error) => void calls.push(['onError', error]),
+      afterSession: async () => void calls.push(['afterSession']),
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), undefined, {hooks});
+
+    const rejection = await orchestrator.processMessage(session).then(
+      () => 'resolved without throwing',
+      (error: unknown) => error
+    );
+
+    expect({rejection, calls}).toEqual({rejection: failure, calls: [['onError', failure], ['afterSession']]});
+  });
+});