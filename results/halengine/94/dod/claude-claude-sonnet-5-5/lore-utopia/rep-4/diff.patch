+import {createHalEngine} from '../config.js';
+import type {ChatSession} from '../types/session.js';
+import type {WsAuthenticator} from '../types/auth.js';
+
+const base = {
+  provider: {type: 'mock' as const},
+  prompt: {identity: 'test'},
+  auth: {ws: (async () => null) as unknown as WsAuthenticator},
+};
+
+describe('a beforeSession hook that throws', () => {
+  it('still rejects to the caller, and runs onError with the error and afterSession', async () => {
+    const boom = new Error('allocation failed');
+    const calls: Array<{hook: string; error?: unknown}> = [];
+    const engine = createHalEngine({
+      ...base,
+      orchestrator: {
+        hooks: {
+          beforeSession: async () => {
+            throw boom;
+          },
+          onError: async (_session, error) => void calls.push({hook: 'onError', error}),
+          afterSession: async () => void calls.push({hook: 'afterSession'}),
+        },
+      },
+    });
+    const session: ChatSession = {
+      sessionId: 's-before-throws',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hi', timestamp: ''}],
+    };
+
+    const outcome = await engine.orchestrator.processMessage(session).then(
+      () => 'resolved' as const,
+      (error: unknown) => error
+    );
+
+    expect({outcome, calls}).toEqual({
+      outcome: boom,
+      calls: [{hook: 'onError', error: boom}, {hook: 'afterSession'}],
+    });
+  });
+});