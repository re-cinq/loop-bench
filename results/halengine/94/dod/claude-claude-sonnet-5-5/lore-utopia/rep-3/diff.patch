+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const provider: AIProvider = {
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'ok'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+const session: ChatSession = {
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+// specs/hal-engine-config-hooks/spec.md: a beforeSession throw reaches onError and afterSession
+describe('beforeSession failure', () => {
+  it('rejects with the original error and still runs onError and afterSession', async () => {
+    const boom = new Error('allocation failed');
+    const calls: string[] = [];
+    const onErrorArgs: unknown[][] = [];
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw boom;
+      },
+      onError: async (...args) => {
+        calls.push('onError');
+        onErrorArgs.push(args);
+      },
+      afterSession: async () => void calls.push('afterSession'),
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), undefined, {hooks});
+
+    const rejection = await orchestrator.processMessage(session).then(
+      () => undefined,
+      (error: unknown) => error
+    );
+
+    expect({rejection, calls, onErrorArgs}).toEqual({
+      rejection: boom,
+      calls: ['onError', 'afterSession'],
+      onErrorArgs: [[session, boom]],
+    });
+  });
+});