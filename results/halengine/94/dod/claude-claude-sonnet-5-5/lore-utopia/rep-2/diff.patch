+import {createHalEngine} from '../config.js';
+import type {ChatSession} from '../types/session.js';
+import type {WsAuthenticator} from '../types/auth.js';
+
+const base = {
+  provider: {type: 'mock' as const},
+  prompt: {identity: 'test'},
+  auth: {ws: (async () => null) as unknown as WsAuthenticator},
+};
+
+const newSession = (): ChatSession => ({
+  sessionId: 's-before-throws',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hi', timestamp: ''}],
+});
+
+describe('a beforeSession hook that throws', () => {
+  it('still rejects to the caller, and fires onError with the session and the thrown Error', async () => {
+    const boom = new Error('beforeSession failed');
+    const errors: Array<{sessionId: string; error: Error}> = [];
+    const engine = createHalEngine({
+      ...base,
+      orchestrator: {
+        hooks: {
+          beforeSession: async () => {
+            throw boom;
+          },
+          onError: async (session, error) => void errors.push({sessionId: session.sessionId, error}),
+        },
+      },
+    });
+
+    await expect(engine.orchestrator.processMessage(newSession())).rejects.toBe(boom);
+
+    expect(errors).toEqual([{sessionId: 's-before-throws', error: boom}]);
+  });
+
+  it('still runs afterSession, so a resource allocated in beforeSession can be released', async () => {
+    const order: string[] = [];
+    const engine = createHalEngine({
+      ...base,
+      orchestrator: {
+        hooks: {
+          beforeSession: async () => {
+            order.push('beforeSession');
+            throw new Error('beforeSession failed');
+          },
+          onError: async () => void order.push('onError'),
+          afterSession: async () => void order.push('afterSession'),
+        },
+      },
+    });
+
+    await expect(engine.orchestrator.processMessage(newSession())).rejects.toThrow('beforeSession failed');
+
+    expect(order).toEqual(['beforeSession', 'onError', 'afterSession']);
+  });
+});