+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const provider: AIProvider = {
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'ok'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+const session = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hi', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+describe('beforeSession failure', () => {
+  it('rejects with the original error and still fires onError and afterSession for it', async () => {
+    const boom = new Error('allocation failed');
+    const calls: string[] = [];
+    const onErrorArgs: unknown[] = [];
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), undefined, {
+      hooks: {
+        beforeSession: async () => {
+          throw boom;
+        },
+        onError: async (s, e) => {
+          calls.push('onError');
+          onErrorArgs.push(s.sessionId, e);
+        },
+        afterSession: async () => void calls.push('afterSession'),
+      },
+    });
+
+    const rejection = await orchestrator.processMessage(session()).then(
+      () => 'resolved',
+      (e: unknown) => e
+    );
+
+    expect({rejection, calls, onErrorArgs}).toEqual({
+      rejection: boom,
+      calls: ['onError', 'afterSession'],
+      onErrorArgs: ['s1', boom],
+    });
+  });
+});