+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const session = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+});
+
+const provider: AIProvider = {
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'hi'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+const run = async (hooks: OrchestratorHooks, target: ChatSession) => {
+  const orchestrator = createChatOrchestrator(
+    provider,
+    new PromptBuilder({identity: 'You are a test assistant.'}),
+    undefined,
+    {hooks}
+  );
+  return orchestrator.processMessage(target).then(
+    () => 'resolved without throwing',
+    (error: Error) => error
+  );
+};
+
+describe('a beforeSession hook that throws', () => {
+  it('reaches onError with (session, error) and still rejects the caller with that same error', async () => {
+    const failure = new Error('no span available');
+    const target = session();
+    const seen: unknown[][] = [];
+
+    const outcome = await run(
+      {
+        beforeSession: async () => {
+          throw failure;
+        },
+        onError: async (...args) => void seen.push(args),
+      },
+      target
+    );
+
+    expect({outcome, seen}).toEqual({outcome: failure, seen: [[target, failure]]});
+  });
+
+  it('still runs afterSession, once, with the session', async () => {
+    const target = session();
+    const closed: ChatSession[] = [];
+
+    await run(
+      {
+        beforeSession: async () => {
+          throw new Error('no span available');
+        },
+        afterSession: async s => void closed.push(s),
+      },
+      target
+    );
+
+    expect(closed).toEqual([target]);
+  });
+});