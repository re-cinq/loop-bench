+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function createMockProvider(response: string): AIProvider {
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      yield {type: 'text', text: response};
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator beforeSession throws', () => {
+  describe('onError fires when beforeSession throws', () => {
+    it('calls onError with the beforeSession error', async () => {
+      const beforeSessionError = new Error('beforeSession failed');
+      let receivedError: Error | undefined;
+
+      const hooks: OrchestratorHooks = {
+        beforeSession: async () => {
+          throw beforeSessionError;
+        },
+        onError: async (_session, error) => {
+          receivedError = error;
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(createMockProvider('ok'), promptBuilder, undefined, {hooks});
+      await expect(orchestrator.processMessage(createSession('hello'))).rejects.toThrow('beforeSession failed');
+
+      expect(receivedError).toBe(beforeSessionError);
+    });
+  });
+
+  describe('afterSession fires when beforeSession throws', () => {
+    it('calls afterSession even when beforeSession throws', async () => {
+      let afterSessionCalled = false;
+
+      const hooks: OrchestratorHooks = {
+        beforeSession: async () => {
+          throw new Error('beforeSession failed');
+        },
+        afterSession: async () => {
+          afterSessionCalled = true;
+        },
+        onError: async () => {},
+      };
+
+      const orchestrator = createChatOrchestrator(createMockProvider('ok'), promptBuilder, undefined, {hooks});
+      await expect(orchestrator.processMessage(createSession('hello'))).rejects.toThrow('beforeSession failed');
+
+      expect(afterSessionCalled).toBe(true);
+    });
+  });
+
+  describe('error propagates after onError and afterSession', () => {
+    it('error thrown from beforeSession still reaches caller as rejection', async () => {
+      const beforeSessionError = new Error('beforeSession failure');
+      let callOrder: string[] = [];
+
+      const hooks: OrchestratorHooks = {
+        beforeSession: async () => {
+          throw beforeSessionError;
+        },
+        onError: async () => {
+          callOrder.push('onError');
+        },
+        afterSession: async () => {
+          callOrder.push('afterSession');
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(createMockProvider('ok'), promptBuilder, undefined, {hooks});
+      await expect(orchestrator.processMessage(createSession('hello'))).rejects.toThrow('beforeSession failure');
+
+      expect(callOrder).toEqual(['onError', 'afterSession']);
+    });
+  });
+
+  describe('non-throwing beforeSession still behaves as before', () => {
+    it('hook fires in correct position when it does not throw', async () => {
+      let callOrder: string[] = [];
+
+      const hooks: OrchestratorHooks = {
+        beforeSession: async () => {
+          callOrder.push('beforeSession');
+        },
+        beforeUserInput: async (_session, msg) => {
+          callOrder.push('beforeUserInput');
+          return msg;
+        },
+        afterSession: async () => {
+          callOrder.push('afterSession');
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(createMockProvider('ok'), promptBuilder, undefined, {hooks});
+      await orchestrator.processMessage(createSession('hello'));
+
+      expect(callOrder).toEqual(['beforeSession', 'beforeUserInput', 'afterSession']);
+    });
+  });
+});