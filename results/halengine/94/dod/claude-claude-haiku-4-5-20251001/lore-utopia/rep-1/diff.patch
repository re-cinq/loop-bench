+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function createMockProvider(response: string): AIProvider {
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      yield {type: 'text', text: response};
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('beforeSession error handling (ticket #94)', () => {
+  describe('beforeSession throws', () => {
+    it('error from beforeSession still reaches the caller as a rejection', async () => {
+      const beforeSessionError = new Error('beforeSession failed');
+      const hooks: OrchestratorHooks = {
+        beforeSession: async () => {
+          throw beforeSessionError;
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(createMockProvider('hello'), promptBuilder, undefined, {hooks});
+
+      await expect(orchestrator.processMessage(createSession('hello'))).rejects.toThrow('beforeSession failed');
+    });
+
+    it('onError fires for beforeSession throw', async () => {
+      let caughtError: Error | undefined;
+      const hooks: OrchestratorHooks = {
+        beforeSession: async () => {
+          throw new Error('beforeSession failed');
+        },
+        onError: async (_session, error) => {
+          caughtError = error;
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(createMockProvider('hello'), promptBuilder, undefined, {hooks});
+
+      await expect(orchestrator.processMessage(createSession('hello'))).rejects.toThrow('beforeSession failed');
+
+      expect(caughtError?.message).toBe('beforeSession failed');
+    });
+
+    it('afterSession fires for beforeSession throw', async () => {
+      let afterSessionCalled = false;
+      const hooks: OrchestratorHooks = {
+        beforeSession: async () => {
+          throw new Error('beforeSession failed');
+        },
+        afterSession: async () => {
+          afterSessionCalled = true;
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(createMockProvider('hello'), promptBuilder, undefined, {hooks});
+
+      await expect(orchestrator.processMessage(createSession('hello'))).rejects.toThrow('beforeSession failed');
+
+      expect(afterSessionCalled).toBe(true);
+    });
+
+    it('both onError and afterSession fire for beforeSession throw', async () => {
+      const callOrder: string[] = [];
+      const hooks: OrchestratorHooks = {
+        beforeSession: async () => {
+          throw new Error('beforeSession failed');
+        },
+        onError: async () => {
+          callOrder.push('onError');
+        },
+        afterSession: async () => {
+          callOrder.push('afterSession');
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(createMockProvider('hello'), promptBuilder, undefined, {hooks});
+
+      await expect(orchestrator.processMessage(createSession('hello'))).rejects.toThrow('beforeSession failed');
+
+      expect(callOrder).toEqual(['onError', 'afterSession']);
+    });
+  });
+
+  describe('beforeSession does not throw', () => {
+    it('non-throwing beforeSession behaves exactly as today', async () => {
+      let beforeSessionCalled = false;
+      const callOrder: string[] = [];
+      const hooks: OrchestratorHooks = {
+        beforeSession: async () => {
+          beforeSessionCalled = true;
+          callOrder.push('beforeSession');
+        },
+        beforeUserInput: async (_session, msg) => {
+          callOrder.push('beforeUserInput');
+          return msg;
+        },
+        afterUserInput: async () => {
+          callOrder.push('afterUserInput');
+        },
+        beforeModelResponse: async (_session, systemPrompt) => {
+          callOrder.push('beforeModelResponse');
+          return systemPrompt;
+        },
+        afterModelResponse: async () => {
+          callOrder.push('afterModelResponse');
+        },
+        afterSession: async () => {
+          callOrder.push('afterSession');
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(createMockProvider('response'), promptBuilder, undefined, {hooks});
+      const result = await orchestrator.processMessage(createSession('hello'));
+
+      expect(beforeSessionCalled).toBe(true);
+      expect(result).toBe('response');
+      expect(callOrder).toEqual([
+        'beforeSession',
+        'beforeUserInput',
+        'afterUserInput',
+        'beforeModelResponse',
+        'afterModelResponse',
+        'afterSession',
+      ]);
+    });
+  });
+});