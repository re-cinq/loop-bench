+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function createMockProvider(response: string): AIProvider {
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      yield {type: 'text', text: response};
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('beforeSession throws (spec: hal-engine-config-hooks#94)', () => {
+  it('calls onError when beforeSession throws', async () => {
+    const beforeSessionError = new Error('beforeSession failed');
+    let onErrorCalled = false;
+    let onErrorReceivedException: Error | undefined;
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw beforeSessionError;
+      },
+      onError: async (_session, error) => {
+        onErrorCalled = true;
+        onErrorReceivedException = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createMockProvider('hi'), promptBuilder, undefined, {hooks});
+
+    await expect(orchestrator.processMessage(createSession('hello'))).rejects.toThrow('beforeSession failed');
+
+    expect(onErrorCalled).toBe(true);
+    expect(onErrorReceivedException?.message).toBe('beforeSession failed');
+  });
+
+  it('calls afterSession when beforeSession throws', async () => {
+    const beforeSessionError = new Error('beforeSession failed');
+    let afterSessionCalled = false;
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw beforeSessionError;
+      },
+      afterSession: async () => {
+        afterSessionCalled = true;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createMockProvider('hi'), promptBuilder, undefined, {hooks});
+
+    await expect(orchestrator.processMessage(createSession('hello'))).rejects.toThrow('beforeSession failed');
+
+    expect(afterSessionCalled).toBe(true);
+  });
+
+  it('throws the beforeSession error to the caller unchanged', async () => {
+    const beforeSessionError = new Error('beforeSession failed');
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw beforeSessionError;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createMockProvider('hi'), promptBuilder, undefined, {hooks});
+
+    await expect(orchestrator.processMessage(createSession('hello'))).rejects.toThrow('beforeSession failed');
+  });
+
+  it('calls onError and afterSession in correct order when beforeSession throws', async () => {
+    const callOrder: string[] = [];
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw new Error('beforeSession failed');
+      },
+      onError: async () => {
+        callOrder.push('onError');
+      },
+      afterSession: async () => {
+        callOrder.push('afterSession');
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createMockProvider('hi'), promptBuilder, undefined, {hooks});
+
+    await expect(orchestrator.processMessage(createSession('hello'))).rejects.toThrow('beforeSession failed');
+
+    expect(callOrder).toEqual(['onError', 'afterSession']);
+  });
+
+  it('non-throwing beforeSession still works as before', async () => {
+    let beforeSessionCalled = false;
+    let afterSessionCalled = false;
+    let responseText = '';
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        beforeSessionCalled = true;
+      },
+      afterSession: async () => {
+        afterSessionCalled = true;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createMockProvider('hello response'), promptBuilder, undefined, {hooks});
+    responseText = await orchestrator.processMessage(createSession('hello'));
+
+    expect(beforeSessionCalled).toBe(true);
+    expect(afterSessionCalled).toBe(true);
+    expect(responseText).toBe('hello response');
+  });
+});