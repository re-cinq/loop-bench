+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+describe('ChatOrchestrator beforeSession failure', () => {
+  it('runs onError and afterSession while preserving the rejection', async () => {
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const failure = new Error('before session failed');
+    const calls: string[] = [];
+    let observedSession: ChatSession | undefined;
+    let observedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        calls.push('beforeSession');
+        throw failure;
+      },
+      onError: async (receivedSession, error) => {
+        calls.push('onError');
+        observedSession = receivedSession;
+        observedError = error;
+      },
+      afterSession: async receivedSession => {
+        calls.push('afterSession');
+        expect(receivedSession).toBe(session);
+      },
+    };
+    const provider: AIProvider = {
+      // eslint-disable-next-line require-yield
+      async *sendMessage() {
+        throw new Error('provider should not run');
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), undefined, {hooks});
+
+    let rejection: unknown;
+    try {
+      await orchestrator.processMessage(session);
+    } catch (error) {
+      rejection = error;
+    }
+
+    expect({rejection, observedSession, observedError, calls}).toEqual({
+      rejection: failure,
+      observedSession: session,
+      observedError: failure,
+      calls: ['beforeSession', 'onError', 'afterSession'],
+    });
+  });
+});