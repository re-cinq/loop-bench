+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const session: ChatSession = {
+  sessionId: 'acceptance-session',
+  userId: 'acceptance-user',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+const provider: AIProvider = {
+  async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'ok'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+it('routes a beforeSession rejection through onError and afterSession, then rejects unchanged', async () => {
+  const failure = new Error('beforeSession failed');
+  const calls: string[] = [];
+  let receivedSession: ChatSession | undefined;
+  let receivedError: Error | undefined;
+  const hooks: OrchestratorHooks = {
+    beforeSession: async () => {
+      calls.push('beforeSession');
+      throw failure;
+    },
+    onError: async (actualSession, error) => {
+      calls.push('onError');
+      receivedSession = actualSession;
+      receivedError = error;
+    },
+    afterSession: async actualSession => {
+      calls.push('afterSession');
+      expect(actualSession).toBe(session);
+    },
+  };
+  const orchestrator = createChatOrchestrator(
+    provider,
+    new PromptBuilder({identity: 'Acceptance test assistant'}),
+    undefined,
+    {hooks}
+  );
+
+  await expect(orchestrator.processMessage(session)).rejects.toBe(failure);
+
+  expect({calls, receivedSession, receivedError}).toEqual({
+    calls: ['beforeSession', 'onError', 'afterSession'],
+    receivedSession: session,
+    receivedError: failure,
+  });
+});