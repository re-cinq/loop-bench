+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const session: ChatSession = {
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+const unusedProvider: AIProvider = {
+  async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+describe('beforeSession failures', () => {
+  it('rejects with the original error and runs onError and afterSession for the session', async () => {
+    const failure = new Error('before session failed');
+    const events: string[] = [];
+    let onErrorArguments: [ChatSession, Error] | undefined;
+    let afterSessionArgument: ChatSession | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw failure;
+      },
+      onError: async (receivedSession, error) => {
+        events.push('onError');
+        onErrorArguments = [receivedSession, error];
+      },
+      afterSession: async receivedSession => {
+        events.push('afterSession');
+        afterSessionArgument = receivedSession;
+      },
+    };
+    const orchestrator = createChatOrchestrator(unusedProvider, new PromptBuilder({identity: 'test'}), undefined, {
+      hooks,
+    });
+
+    let receivedError: unknown;
+    try {
+      await orchestrator.processMessage(session);
+    } catch (error) {
+      receivedError = error;
+    }
+
+    expect({receivedError, events, onErrorArguments, afterSessionArgument}).toEqual({
+      receivedError: failure,
+      events: ['onError', 'afterSession'],
+      onErrorArguments: [session, failure],
+      afterSessionArgument: session,
+    });
+  });
+});