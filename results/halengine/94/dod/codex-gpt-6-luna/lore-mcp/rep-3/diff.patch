+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+describe('beforeSession failure acceptance', () => {
+  it('runs onError and afterSession and rejects with the original error when beforeSession throws', async () => {
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+    };
+    const failure = new Error('before session failed');
+    const calls: Array<{hook: string; session: ChatSession; error?: Error}> = [];
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw failure;
+      },
+      onError: async (receivedSession, error) => {
+        calls.push({hook: 'onError', session: receivedSession, error});
+      },
+      afterSession: async receivedSession => {
+        calls.push({hook: 'afterSession', session: receivedSession});
+      },
+    };
+    const provider: AIProvider = {
+      async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), undefined, {hooks});
+    let receivedError: unknown;
+
+    try {
+      await orchestrator.processMessage(session);
+    } catch (error) {
+      receivedError = error;
+    }
+
+    expect({receivedError, calls}).toEqual({
+      receivedError: failure,
+      calls: [
+        {hook: 'onError', session, error: failure},
+        {hook: 'afterSession', session},
+      ],
+    });
+  });
+});