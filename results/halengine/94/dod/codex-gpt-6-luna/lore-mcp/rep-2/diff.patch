+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// spec: specs/hal-engine-config-hooks/spec.md#7
+describe('a beforeSession failure', () => {
+  it('reaches onError and afterSession before the unchanged rejection returns', async () => {
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const failure = new Error('setup failed');
+    const order: string[] = [];
+    let errorArguments: [ChatSession, Error] | undefined;
+    let afterSessionArgument: ChatSession | undefined;
+    const provider: AIProvider = {
+      async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        yield {type: 'text', text: 'unexpected'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), undefined, {
+      hooks: {
+        beforeSession: async () => {
+          order.push('beforeSession');
+          throw failure;
+        },
+        onError: async (hookSession, error) => {
+          order.push('onError');
+          errorArguments = [hookSession, error];
+        },
+        afterSession: async hookSession => {
+          order.push('afterSession');
+          afterSessionArgument = hookSession;
+        },
+      },
+    });
+
+    const rejection = await orchestrator.processMessage(session).catch(error => error);
+
+    expect({rejection, order, errorArguments, afterSessionArgument}).toEqual({
+      rejection: failure,
+      order: ['beforeSession', 'onError', 'afterSession'],
+      errorArguments: [session, failure],
+      afterSessionArgument: session,
+    });
+  });
+});