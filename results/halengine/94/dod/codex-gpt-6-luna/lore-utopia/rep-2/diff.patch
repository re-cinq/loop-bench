+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+// spec: specs/hal-engine-config-hooks/spec.md#7
+describe('beforeSession failure lifecycle', () => {
+  it('rejects with the original error and runs onError then afterSession', async () => {
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const failure = new Error('beforeSession failed');
+    const calls: Array<{hook: string; session: ChatSession; error?: Error}> = [];
+    const orchestrator = createChatOrchestrator(
+      createMockProvider(),
+      new PromptBuilder({identity: 'test'}),
+      undefined,
+      {
+        hooks: {
+          beforeSession: async () => {
+            throw failure;
+          },
+          onError: async (hookSession, error) => {
+            calls.push({hook: 'onError', session: hookSession, error});
+          },
+          afterSession: async hookSession => {
+            calls.push({hook: 'afterSession', session: hookSession});
+          },
+        },
+      }
+    );
+
+    const rejection = await orchestrator.processMessage(session).then(
+      () => undefined,
+      error => error
+    );
+
+    expect({rejection, calls}).toEqual({
+      rejection: failure,
+      calls: [
+        {hook: 'onError', session, error: failure},
+        {hook: 'afterSession', session},
+      ],
+    });
+  });
+});