+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('beforeSession failure lifecycle', () => {
+  it('rejects unchanged while running onError and afterSession before the turn starts', async () => {
+    const failure = new Error('beforeSession failed');
+    const observed: unknown[] = [];
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw failure;
+      },
+      onError: async (session, error) => {
+        observed.push(['onError', session.sessionId, error]);
+      },
+      afterSession: async session => {
+        observed.push(['afterSession', session.sessionId]);
+      },
+      beforeUserInput: async (_session, message) => {
+        observed.push(['beforeUserInput']);
+        return message;
+      },
+    };
+    const provider: AIProvider = {
+      async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Test.'}), undefined, {hooks});
+
+    await expect(orchestrator.processMessage(session)).rejects.toBe(failure);
+    expect(observed).toEqual([
+      ['onError', 's1', failure],
+      ['afterSession', 's1'],
+    ]);
+  });
+});