+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const provider: AIProvider = {
+  async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+describe('ChatOrchestrator beforeSession failure acceptance', () => {
+  it('rejects unchanged and runs onError then afterSession when beforeSession throws', async () => {
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+    };
+    const error = new Error('beforeSession failed');
+    const calls: string[] = [];
+    let onErrorArgs: [ChatSession, Error] | undefined;
+    let afterSessionArg: ChatSession | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw error;
+      },
+      onError: async (receivedSession, receivedError) => {
+        calls.push('onError');
+        onErrorArgs = [receivedSession, receivedError];
+      },
+      afterSession: async receivedSession => {
+        calls.push('afterSession');
+        afterSessionArg = receivedSession;
+      },
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), undefined, {hooks});
+    let rejection: unknown;
+
+    try {
+      await orchestrator.processMessage(session);
+    } catch (caught) {
+      rejection = caught;
+    }
+
+    expect({rejection, calls, onErrorArgs, afterSessionArg}).toEqual({
+      rejection: error,
+      calls: ['onError', 'afterSession'],
+      onErrorArgs: [session, error],
+      afterSessionArg: session,
+    });
+  });
+});