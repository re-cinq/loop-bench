+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+describe('beforeSession failure lifecycle', () => {
+  it('rejects with the original error and runs onError and afterSession', async () => {
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const failure = new Error('beforeSession failed');
+    const calls: string[] = [];
+    let onErrorArgs: [ChatSession, Error] | undefined;
+    let afterSessionArg: ChatSession | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw failure;
+      },
+      onError: async (receivedSession, error) => {
+        calls.push('onError');
+        onErrorArgs = [receivedSession, error];
+      },
+      afterSession: async receivedSession => {
+        calls.push('afterSession');
+        afterSessionArg = receivedSession;
+      },
+    };
+    const provider: AIProvider = {
+      async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Test assistant'}), undefined, {
+      hooks,
+    });
+
+    await expect(orchestrator.processMessage(session)).rejects.toBe(failure);
+
+    expect({calls, onErrorArgs, afterSessionArg}).toEqual({
+      calls: ['onError', 'afterSession'],
+      onErrorArgs: [session, failure],
+      afterSessionArg: session,
+    });
+  });
+});