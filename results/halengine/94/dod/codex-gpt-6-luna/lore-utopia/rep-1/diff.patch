+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// @spec specs/hal-engine-config-hooks/spec.md#8
+describe('beforeSession failure lifecycle', () => {
+  it('reports the failure and runs afterSession without starting the turn', async () => {
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const failure = new Error('beforeSession failed');
+    const calls: string[] = [];
+    let receivedError: {session: ChatSession; error: Error} | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        calls.push('beforeSession');
+        throw failure;
+      },
+      beforeUserInput: async (_session, message) => {
+        calls.push('beforeUserInput');
+        return message;
+      },
+      onError: async (failedSession, error) => {
+        calls.push('onError');
+        receivedError = {session: failedSession, error};
+      },
+      afterSession: async finishedSession => {
+        calls.push(finishedSession === session ? 'afterSession' : 'afterSession:wrong-session');
+      },
+    };
+    const provider: AIProvider = {
+      async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test assistant'}), undefined, {
+      hooks,
+    });
+    let rejection: unknown;
+
+    try {
+      await orchestrator.processMessage(session);
+    } catch (error) {
+      rejection = error;
+    }
+
+    expect({rejection, receivedError, calls}).toEqual({
+      rejection: failure,
+      receivedError: {session, error: failure},
+      calls: ['beforeSession', 'onError', 'afterSession'],
+    });
+  });
+});