+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+
+const session: ChatSession = {
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+describe('beforeSession failure handling', () => {
+  it('runs onError and afterSession when beforeSession throws, then rethrows the same error', async () => {
+    const failure = new Error('before session failed');
+    const calls: string[] = [];
+    let receivedSession: ChatSession | undefined;
+    let receivedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        calls.push('beforeSession');
+        throw failure;
+      },
+      onError: async (hookSession, error) => {
+        calls.push('onError');
+        receivedSession = hookSession;
+        receivedError = error;
+      },
+      afterSession: async hookSession => {
+        calls.push('afterSession');
+        expect(hookSession).toBe(session);
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      createMockProvider(),
+      new PromptBuilder({identity: 'test assistant'}),
+      undefined,
+      {hooks}
+    );
+    const rejection = await orchestrator.processMessage(session).then(
+      () => undefined,
+      error => error
+    );
+
+    expect({rejection, receivedSession, receivedError, calls}).toEqual({
+      rejection: failure,
+      receivedSession: session,
+      receivedError: failure,
+      calls: ['beforeSession', 'onError', 'afterSession'],
+    });
+  });
+});