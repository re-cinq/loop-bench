+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+describe('beforeSession failure acceptance', () => {
+  it('rejects with the same error and runs onError and afterSession without starting the turn', async () => {
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const failure = new Error('beforeSession failed');
+    const events: string[] = [];
+    let onErrorCapture: {session: ChatSession; error: unknown} | undefined;
+    let afterSessionCapture: {session: ChatSession} | undefined;
+    const provider: AIProvider = {
+      async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), undefined, {
+      hooks: {
+        beforeSession: async () => {
+          events.push('beforeSession');
+          throw failure;
+        },
+        beforeUserInput: async (_session, message) => {
+          events.push('beforeUserInput');
+          return message;
+        },
+        onError: async (receivedSession, error) => {
+          events.push('onError');
+          onErrorCapture = {session: receivedSession, error};
