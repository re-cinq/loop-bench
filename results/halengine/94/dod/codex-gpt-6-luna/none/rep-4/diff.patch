@@ -0,0 +1,54 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const session: ChatSession = {
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+const provider: AIProvider = {
+  async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+describe('beforeSession failure handling', () => {
+  it('preserves the rejection and runs onError and afterSession with the original session', async () => {
+    const failure = new Error('beforeSession failed');
+    const observed: Array<{hook: string; session: ChatSession; error?: Error}> = [];
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'assistant'}), undefined, {
+      hooks: {
+        beforeSession: async () => {
+          throw failure;
+        },
+        onError: async (hookSession, error) => {
+          observed.push({hook: 'onError', session: hookSession, error});
+        },
+        afterSession: async hookSession => {
+          observed.push({hook: 'afterSession', session: hookSession});
+        },
+      },
+    });
+
+    let rejection: unknown;
+    try {
+      await orchestrator.processMessage(session);
+    } catch (error) {
+      rejection = error;
+    }
+
+    expect({rejection, observed}).toEqual({
+      rejection: failure,
+      observed: [
+        {hook: 'onError', session, error: failure},
+        {hook: 'afterSession', session},
+      ],
+    });
+  });
+});