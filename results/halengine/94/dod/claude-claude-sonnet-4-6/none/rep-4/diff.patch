+// spec: specs/hal-engine-config-hooks/spec.md — beforeSession error handling (§Measured semantics, to be replaced by the new guarantee)
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function makeSession(): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+  };
+}
+
+function normalProvider(): AIProvider {
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      yield {type: 'text', text: 'ok'};
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'test'});
+
+const outcomeOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved').catch((e: Error) => e.message);
+
+describe('beforeSession error handling — #94', () => {
+  it('onError fires when beforeSession throws, and the error still reaches the caller', async () => {
+    let onErrorCalled = false;
+    let onErrorArgMessage: string | undefined;
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw new Error('session init failed');
+      },
+      onError: async (_session, error) => {
+        onErrorCalled = true;
+        onErrorArgMessage = error.message;
+      },
+      afterSession: async () => {},
+    };
+
+    const orchestrator = createChatOrchestrator(normalProvider(), promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(makeSession()));
+
+    expect({outcome, onErrorCalled, onErrorArgMessage}).toEqual({
+      outcome: 'session init failed',
+      onErrorCalled: true,
+      onErrorArgMessage: 'session init failed',
+    });
+  });
+
+  it('afterSession fires when beforeSession throws', async () => {
+    let afterSessionCalled = false;
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw new Error('session init failed');
+      },
+      onError: async () => {},
+      afterSession: async () => {
+        afterSessionCalled = true;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(normalProvider(), promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(makeSession()));
+
+    expect({outcome, afterSessionCalled}).toEqual({
+      outcome: 'session init failed',
+      afterSessionCalled: true,
+    });
+  });
+});