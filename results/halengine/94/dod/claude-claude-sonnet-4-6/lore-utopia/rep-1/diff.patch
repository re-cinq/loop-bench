+// spec: specs/hal-engine-config-hooks/spec.md#beforeSession-throw
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+  };
+}
+
+function createMockProvider(): AIProvider {
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      yield {type: 'text', text: 'ok'};
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const beforeSessionError = new Error('beforeSession failed');
+
+function hooksWithThrowingBeforeSession(overrides: Partial<OrchestratorHooks>): OrchestratorHooks {
+  return {
+    beforeSession: async () => {
+      throw beforeSessionError;
+    },
+    ...overrides,
+  };
+}
+
+describe('beforeSession throws', () => {
+  it('onError fires with the error when beforeSession throws', async () => {
+    // spec: specs/hal-engine-config-hooks/spec.md
+    let receivedError: Error | undefined;
+    const hooks = hooksWithThrowingBeforeSession({
+      onError: async (_session, error) => {
+        receivedError = error;
+      },
+    });
+
+    const orchestrator = createChatOrchestrator(createMockProvider(), promptBuilder, undefined, {hooks});
+    await orchestrator.processMessage(createSession()).catch(() => {});
+
+    expect(receivedError).toBe(beforeSessionError);
+  });
+
+  it('afterSession fires when beforeSession throws', async () => {
+    // spec: specs/hal-engine-config-hooks/spec.md
+    let afterSessionCalled = false;
+    const hooks = hooksWithThrowingBeforeSession({
+      afterSession: async () => {
+        afterSessionCalled = true;
+      },
+    });
+
+    const orchestrator = createChatOrchestrator(createMockProvider(), promptBuilder, undefined, {hooks});
+    await orchestrator.processMessage(createSession()).catch(() => {});
+
+    expect(afterSessionCalled).toBe(true);
+  });
+
+  it('the throw still propagates to the caller as a rejection', async () => {
+    const hooks = hooksWithThrowingBeforeSession({});
+
+    const orchestrator = createChatOrchestrator(createMockProvider(), promptBuilder, undefined, {hooks});
+
+    await expect(orchestrator.processMessage(createSession())).rejects.toThrow('beforeSession failed');
+  });
+});