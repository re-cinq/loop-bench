+/**
+ * Acceptance tests for HALEngine#94: onError and afterSession must fire when beforeSession throws.
+ *
+ * spec: specs/hal-engine-config-hooks/spec.md
+ */
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+  };
+}
+
+function createMockProvider(): AIProvider {
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      yield {type: 'text', text: 'ok'};
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const beforeSessionError = new Error('beforeSession failed');
+
+describe('beforeSession throws — HALEngine#94', () => {
+  it('onError fires when beforeSession throws', async () => {
+    // spec: specs/hal-engine-config-hooks/spec.md — beforeSession throw reaches onError
+    let onErrorReceived: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw beforeSessionError;
+      },
+      onError: async (_session, error) => {
+        onErrorReceived = error;
+      },
+      afterSession: async () => {},
+    };
+
+    const orchestrator = createChatOrchestrator(createMockProvider(), promptBuilder, undefined, {hooks});
+    await orchestrator.processMessage(createSession()).catch(() => {});
+
+    expect(onErrorReceived).toBe(beforeSessionError);
+  });
+
+  it('afterSession fires when beforeSession throws', async () => {
+    // spec: specs/hal-engine-config-hooks/spec.md — afterSession always fires
+    let afterSessionCalled = false;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw beforeSessionError;
+      },
+      afterSession: async () => {
+        afterSessionCalled = true;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createMockProvider(), promptBuilder, undefined, {hooks});
+    await orchestrator.processMessage(createSession()).catch(() => {});
+
+    expect(afterSessionCalled).toBe(true);
+  });
+});