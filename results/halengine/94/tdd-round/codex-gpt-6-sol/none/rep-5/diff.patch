+import {describe, expect, it} from '@jest/globals';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+describe('beforeSession failure', () => {
+  it('reports the original error and completes cleanup before rejecting', async () => {
+    const session: ChatSession = {
+      sessionId: 'session-1',
+      userId: 'user-1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const failure = new Error('start failed');
+    const calls: unknown[] = [];
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        calls.push('provider');
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), undefined, {
+      hooks: {
+        beforeSession: async received => {
+          calls.push(['beforeSession', received]);
+          throw failure;
+        },
+        onError: async (received, error) => {
+          calls.push(['onError', received, error]);
+        },
+        afterSession: async received => {
+          calls.push(['afterSession', received]);
+        },
+      },
+    });
+
+    let rejection: unknown;
+    try {
+      await orchestrator.processMessage(session);
+    } catch (error) {
+      rejection = error;
+    }
+
+    expect({rejection, calls}).toEqual({
+      rejection: failure,
+      calls: [
+        ['beforeSession', session],
+        ['onError', session, failure],
+        ['afterSession', session],
+      ],
+    });
+  });
+});
