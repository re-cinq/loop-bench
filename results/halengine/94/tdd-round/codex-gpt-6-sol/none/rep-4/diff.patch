+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+it('aborts before provider interaction and runs error and cleanup hooks after beforeSession fails', async () => {
+  const session: ChatSession = {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const failure = new Error('startup failed');
+  const calls: string[] = [];
+  const provider: AIProvider = {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      calls.push('provider');
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Test'}), undefined, {
+    hooks: {
+      beforeSession: async () => {
+        calls.push('beforeSession');
+        throw failure;
+      },
+      onError: async (receivedSession, error) => {
+        expect({receivedSession, error}).toEqual({receivedSession: session, error: failure});
+        calls.push('onError');
+      },
+      afterSession: async receivedSession => {
+        expect(receivedSession).toBe(session);
+        calls.push('afterSession');
+      },
+    },
+  });
+
+  await expect(orchestrator.processMessage(session)).rejects.toBe(failure);
+  expect(calls).toEqual(['beforeSession', 'onError', 'afterSession']);
+});
