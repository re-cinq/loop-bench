+// spec: specs/hal-engine-config-hooks/spec.md#7
+import {describe, expect, it} from '@jest/globals';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('beforeSession failure cleanup', () => {
+  it('passes the failed session and error to onError before afterSession', async () => {
+    const session: ChatSession = {
+      sessionId: 'failed-before-session',
+      userId: 'user',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const failure = new Error('setup failed');
+    const calls: unknown[][] = [];
+    const provider: AIProvider = {
+      async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        calls.push(['provider']);
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), undefined, {
+      hooks: {
+        beforeSession: async () => {
+          throw failure;
+        },
+        onError: async (receivedSession, error) => {
+          calls.push(['onError', receivedSession, error]);
+        },
+        afterSession: async receivedSession => {
+          calls.push(['afterSession', receivedSession]);
+        },
+      },
+    });
+
+    const rejection = await orchestrator.processMessage(session).then(
+      () => undefined,
+      error => error
+    );
+
+    expect({rejection, calls}).toEqual({
+      rejection: failure,
+      calls: [
+        ['onError', session, failure],
+        ['afterSession', session],
+      ],
+    });
+  });
+});
