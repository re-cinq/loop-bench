+import {describe, expect, it} from '@jest/globals';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('beforeSession failure', () => {
+  it('runs error and cleanup hooks before rejecting after failed beforeSession [specs/hal-engine-config-hooks/spec.md#8]', async () => {
+    const failure = new Error('setup failed');
+    const calls: string[] = [];
+    const session: ChatSession = {
+      sessionId: 'session',
+      userId: 'user',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        calls.push('provider');
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'assistant'}), undefined, {
+      hooks: {
+        beforeSession: async () => {
+          calls.push('beforeSession');
+          throw failure;
+        },
+        onError: async (observedSession, error) => {
+          expect(observedSession).toBe(session);
+          expect(error).toBe(failure);
+          calls.push('onError');
+        },
+        afterSession: async observedSession => {
+          expect(observedSession).toBe(session);
+          calls.push('afterSession');
+        },
+      },
+    });
+
+    await expect(orchestrator.processMessage(session)).rejects.toBe(failure);
+    expect(calls).toEqual(['beforeSession', 'onError', 'afterSession']);
+    expect(session.entries).toHaveLength(1);
+  });
+});
