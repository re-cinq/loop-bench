+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// specs/hal-engine-config-hooks/spec.md#7
+it('runs error and cleanup hooks in order after beforeSession fails', async () => {
+  const failure = new Error('setup failed');
+  const calls: string[] = [];
+  let beforeSessionSession: ChatSession | undefined;
+  let onErrorSession: ChatSession | undefined;
+  let onErrorFailure: Error | undefined;
+  let afterSessionSession: ChatSession | undefined;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      calls.push('provider');
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Test'}), undefined, {
+    hooks: {
+      beforeSession: async received => {
+        beforeSessionSession = received;
+        calls.push('beforeSession');
+        throw failure;
+      },
+      beforeUserInput: async (_received, message) => {
+        calls.push('beforeUserInput');
+        return message;
+      },
+      onError: async (received, error) => {
+        onErrorSession = received;
+        onErrorFailure = error;
+        calls.push('onError');
+      },
+      afterSession: async received => {
+        afterSessionSession = received;
+        calls.push('afterSession');
+      },
+    },
+  });
+
+  const session: ChatSession = {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const rejectedWith = await orchestrator.processMessage(session).then(
+    () => undefined,
+    error => error
+  );
+  expect({rejectedWith, calls, beforeSessionSession, onErrorSession, onErrorFailure, afterSessionSession}).toEqual({
+    rejectedWith: failure,
+    calls: ['beforeSession', 'onError', 'afterSession'],
+    beforeSessionSession: session,
+    onErrorSession: session,
+    onErrorFailure: failure,
+    afterSessionSession: session,
+  });
+});
