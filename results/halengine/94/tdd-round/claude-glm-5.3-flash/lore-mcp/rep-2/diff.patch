@@ -0,0 +1,79 @@
+import {describe, expect, it} from '@jest/globals';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const BEFORE_SESSION_ERROR_MESSAGE = 'Database connection failed in beforeSession';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are HAL.'});
+
+function createThrowingOrchestrator(errorToThrow: Error, hooks: Partial<OrchestratorHooks>) {
+  return createChatOrchestrator(createMockProvider('hello back'), promptBuilder, undefined, {
+    hooks: {
+      ...hooks,
+      beforeSession: async () => {
+        throw errorToThrow;
+      },
+    },
+  });
+}
+
+function createMockProvider(response: string): AIProvider {
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      yield {type: 'text', text: response};
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+describe('beforeSession throwing', () => {
+  it('still rejects the caller when beforeSession throws', async () => {
+    const errorToThrow = new Error(BEFORE_SESSION_ERROR_MESSAGE);
+    const orchestrator = createThrowingOrchestrator(errorToThrow, {});
+
+    await expect(orchestrator.processMessage(createSession('hello'))).rejects.toThrow(errorToThrow);
+  });
+
+  it('hands a beforeSession throw to onError', async () => {
+    const errorToThrow = new Error(BEFORE_SESSION_ERROR_MESSAGE);
+    let receivedError: Error | undefined;
+    const orchestrator = createThrowingOrchestrator(errorToThrow, {
+      onError: async (_session, error) => {
+        receivedError = error;
+      },
+    });
+
+    await orchestrator.processMessage(createSession('hello')).catch(() => undefined);
+
+    expect(receivedError).toBe(errorToThrow);
+  });
+
+  it('runs afterSession after a failed beforeSession', async () => {
+    const errorToThrow = new Error(BEFORE_SESSION_ERROR_MESSAGE);
+    let afterSessionRan = false;
+    const orchestrator = createThrowingOrchestrator(errorToThrow, {
+      afterSession: async () => {
+        afterSessionRan = true;
+      },
+    });
+
+    await orchestrator.processMessage(createSession('hello')).catch(() => undefined);
+
+    expect(afterSessionRan).toBe(true);
+  });
+});
