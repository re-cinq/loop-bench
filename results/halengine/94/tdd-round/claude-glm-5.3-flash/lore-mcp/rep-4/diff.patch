@@ -0,0 +1,80 @@
+import {describe, expect, it} from '@jest/globals';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const THROWING_ERROR = new Error('Database connection failed in beforeSession');
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are HAL.'});
+
+interface ObservedHooks {
+  onErrorArg?: Error;
+  afterSessionRan: boolean;
+}
+
+function createThrowingOrchestrator(observed: ObservedHooks) {
+  return createChatOrchestrator(createMockProvider('hello back'), promptBuilder, undefined, {
+    hooks: {
+      beforeSession: async () => {
+        throw THROWING_ERROR;
+      },
+      onError: async (_session, error) => {
+        observed.onErrorArg = error;
+      },
+      afterSession: async () => {
+        observed.afterSessionRan = true;
+      },
+    },
+  });
+}
+
+function createMockProvider(response: string): AIProvider {
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      yield {type: 'text', text: response};
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+describe('beforeSession throwing', () => {
+  it('propagates a beforeSession throw to the caller as a rejection', async () => {
+    const orchestrator = createThrowingOrchestrator({afterSessionRan: false});
+
+    await expect(orchestrator.processMessage(createSession('hello'))).rejects.toThrow(
+      'Database connection failed in beforeSession'
+    );
+  });
+
+  it('hands onError the error a beforeSession threw', async () => {
+    const observed: ObservedHooks = {afterSessionRan: false};
+    const orchestrator = createThrowingOrchestrator(observed);
+
+    await orchestrator.processMessage(createSession('hello')).catch(() => undefined);
+
+    expect(observed.onErrorArg).toBe(THROWING_ERROR);
+  });
+
+  it('runs afterSession when beforeSession throws', async () => {
+    const observed: ObservedHooks = {afterSessionRan: false};
+    const orchestrator = createThrowingOrchestrator(observed);
+
+    await orchestrator.processMessage(createSession('hello')).catch(() => undefined);
+
+    expect(observed.afterSessionRan).toBe(true);
+  });
+});
