+import {describe, expect, it} from '@jest/globals';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+function createSession(): ChatSession {
+  return {
+    sessionId: 'before-session-hooks',
+    userId: 'user-1',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+}
+
+function createProvider(): AIProvider {
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<never> {
+      yield* [];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({
+  identity: 'You are HAL.',
+  responseGuidelines: 'Be precise.',
+});
+
+describe('beforeSession failure cleanup', () => {
+  it('runs onError and afterSession while propagating the beforeSession error', async () => {
+    const error = new Error('beforeSession failed');
+    const events: string[] = [];
+    let receivedError: Error | undefined;
+    const orchestrator = createChatOrchestrator(createProvider(), promptBuilder, undefined, {
+      hooks: {
+        beforeSession: async () => {
+          events.push('beforeSession');
+          throw error;
+        },
+        onError: async (_session, received) => {
+          events.push('onError');
+          receivedError = received;
+        },
+        afterSession: async () => {
+          events.push('afterSession');
+        },
+      },
+    });
+
+    const rejected = await orchestrator.processMessage(createSession()).catch(received => received);
+
+    expect({rejected, events, receivedError}).toEqual({
+      rejected: error,
+      events: ['beforeSession', 'onError', 'afterSession'],
+      receivedError: error,
+    });
+  });
+});
