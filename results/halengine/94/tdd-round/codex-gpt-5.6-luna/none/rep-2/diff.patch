+import {describe, expect, it} from '@jest/globals';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+function createSession(): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+}
+
+function createProvider(providerCalls: {count: number}): AIProvider {
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      providerCalls.count += 1;
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+describe('beforeSession failure handling', () => {
+  it('runs error hooks before rethrowing without entering provider interaction', async () => {
+    const providerCalls = {count: 0};
+    const failure = new Error('beforeSession failed');
+    const events: string[] = [];
+    const orchestrator = createChatOrchestrator(
+      createProvider(providerCalls),
+      new PromptBuilder({identity: 'HAL'}),
+      undefined,
+      {
+        hooks: {
+          beforeSession: async () => {
+            events.push('beforeSession');
+            throw failure;
+          },
+          onError: async () => {
+            events.push('onError');
+          },
+          afterSession: async () => {
+            events.push('afterSession');
+          },
+        },
+      }
+    );
+
+    let caughtError: unknown;
+    try {
+      await orchestrator.processMessage(createSession());
+    } catch (error) {
+      caughtError = error;
+    }
+
+    expect({caughtError, events, providerCalls: providerCalls.count}).toEqual({
+      caughtError: failure,
+      events: ['beforeSession', 'onError', 'afterSession'],
+      providerCalls: 0,
+    });
+  });
+});
