+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+it('reports a failed start before cleanup [specs/hal-engine-config-hooks/spec.md#7]', async () => {
+  const failure = new Error('allocation failed');
+  const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+  const calls: unknown[] = [];
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      calls.push('provider');
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('unexpected structured generation');
+    },
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Test'}), undefined, {
+    hooks: {
+      beforeSession: async () => {
+        calls.push('beforeSession');
+        throw failure;
+      },
+      onError: async (current, error) => {
+        calls.push(['onError', current === session, error === failure]);
+      },
+      afterSession: async current => {
+        calls.push(['afterSession', current === session]);
+      },
+    },
+  });
+
+  const rejection: unknown = await orchestrator.processMessage(session).catch((error: unknown) => error);
+
+  expect({sameError: rejection === failure, calls}).toEqual({
+    sameError: true,
+    calls: ['beforeSession', ['onError', true, true], ['afterSession', true]],
+  });
+});
