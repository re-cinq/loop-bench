+import {expect, it} from '@jest/globals';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+// spec: specs/hal-engine-config-hooks/spec.md#8
+it('releases a partially allocated resource when beforeSession rejects', async () => {
+  const session: ChatSession = {sessionId: 'failed-start', userId: 'user', entries: []};
+  const resources = new Set<ChatSession>();
+  const failure = new Error('allocation failed');
+  const orchestrator = createChatOrchestrator(createMockProvider(), new PromptBuilder({identity: 'HAL'}), undefined, {
+    hooks: {
+      beforeSession: async current => {
+        resources.add(current);
+        throw failure;
+      },
+      afterSession: async current => {
+        resources.delete(current);
+      },
+    },
+  });
+
+  await expect(orchestrator.processMessage(session)).rejects.toBe(failure);
+  expect(resources.size).toBe(0);
+});
