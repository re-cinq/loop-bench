@@ -0,0 +1,34 @@
+import {createChatOrchestrator} from './orchestration/chatOrchestrator.js';
+import {createMockProvider} from './providers/mock/index.js';
+import {PromptBuilder} from './infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from './types/session.js';
+
+it('releases a partially allocated resource after startup fails (spec: specs/hal-engine-config-hooks/spec.md#8)', async () => {
+  const session: ChatSession = {
+    sessionId: 'startup',
+    userId: 'user',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const resources = new Set<ChatSession>();
+  const failure = new Error('allocation failed');
+  const orchestrator = createChatOrchestrator(
+    createMockProvider(),
+    new PromptBuilder({identity: 'Test assistant'}),
+    undefined,
+    {
+      hooks: {
+        beforeSession: async current => {
+          resources.add(current);
+          throw failure;
+        },
+        afterSession: async current => {
+          resources.delete(current);
+        },
+      },
+    }
+  );
+
+  const rejection: unknown = await orchestrator.processMessage(session).catch((error: unknown) => error);
+
+  expect({rejection, allocated: resources.size}).toEqual({rejection: failure, allocated: 0});
+});
