+import {jest} from '@jest/globals';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {answering, writeSignalPromptBuilder} from '../infrastructure/writeSignalTestSupport.js';
+import type {ChatSession} from '../types/session.js';
+
+// Spec: specs/hal-engine-config-hooks/spec.md#7
+it('cleans up a failed session start before rejecting with the original error', async () => {
+  const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+  const failure = new Error('allocation failed');
+  const calls: unknown[] = [];
+  const provider = answering('unused');
+  const sendMessage = jest.spyOn(provider, 'sendMessage');
+  const orchestrator = createChatOrchestrator(provider, writeSignalPromptBuilder, undefined, {
+    hooks: {
+      beforeSession: async () => {
+        calls.push('beforeSession');
+        throw failure;
+      },
+      beforeUserInput: async (_session, message) => {
+        calls.push('beforeUserInput');
+        return message;
+      },
+      onError: async (current, error) => {
+        calls.push({hook: 'onError', sameSession: current === session, sameError: error === failure});
+      },
+      afterSession: async current => {
+        calls.push({hook: 'afterSession', sameSession: current === session});
+      },
+    },
+  });
+
+  const rejected = await orchestrator.processMessage(session).catch((error: unknown) => error);
+
+  const {calls: providerCalls} = sendMessage.mock;
+  expect({sameError: rejected === failure, calls, providerCalls: providerCalls.length}).toEqual({
+    sameError: true,
+    calls: [
+      'beforeSession',
+      {hook: 'onError', sameSession: true, sameError: true},
+      {hook: 'afterSession', sameSession: true},
+    ],
+    providerCalls: 0,
+  });
+});
