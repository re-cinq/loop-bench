+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// spec: specs/hal-engine-config-hooks/spec.md#8
+it('cleans up a partially initialized turn before rejecting with the startup error', async () => {
+  const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+  const failure = new Error('startup failed');
+  const events: string[] = [];
+  let allocated = false;
+  const provider: AIProvider = {
+    sendMessage() {
+      throw new Error('provider must not run after startup fails');
+    },
+    generateStructured() {
+      throw new Error('structured output must not run after startup fails');
+    },
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), undefined, {
+    hooks: {
+      beforeSession: async () => {
+        allocated = true;
+        throw failure;
+      },
+      onError: async (current, error) => {
+        if (current === session && error === failure) events.push('error');
+      },
+      afterSession: async current => {
+        if (current === session && allocated) events.push('cleanup');
+        allocated = false;
+      },
+    },
+  });
+
+  const rejected = await orchestrator.processMessage(session).catch((error: unknown) => error);
+
+  expect({sameError: rejected === failure, events, allocated}).toEqual({
+    sameError: true,
+    events: ['error', 'cleanup'],
+    allocated: false,
+  });
+});
