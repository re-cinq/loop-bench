@@ -0,0 +1,27 @@
+import {expect, it} from '@jest/globals';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+// @spec specs/hal-engine-config-hooks/spec.md#8
+it('releases a partially initialized resource when beforeSession rejects', async () => {
+  const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+  const resource = {open: false};
+  const failure = new Error('initialization failed');
+  const orchestrator = createChatOrchestrator(createMockProvider(), new PromptBuilder({identity: 'HAL'}), undefined, {
+    hooks: {
+      beforeSession: async () => {
+        resource.open = true;
+        throw failure;
+      },
+      afterSession: async () => {
+        resource.open = false;
+      },
+    },
+  });
+
+  const rejection: unknown = await orchestrator.processMessage(session).catch((error: unknown) => error);
+
+  expect({rejection, resource}).toEqual({rejection: failure, resource: {open: false}});
+});
