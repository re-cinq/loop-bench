+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+it('cleans up a partially initialized turn (specs/hal-engine-config-hooks/spec.md#8)', async () => {
+  const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+  const failure = new Error('allocation failed');
+  const events: string[] = [];
+  let observed: unknown;
+  let sameSession = false;
+  const orchestrator = createChatOrchestrator(
+    createMockProvider(),
+    new PromptBuilder({identity: 'Test assistant'}),
+    undefined,
+    {
+      hooks: {
+        beforeSession: async () => {
+          events.push('allocated');
+          throw failure;
+        },
+        beforeUserInput: async (_session, message) => {
+          events.push('user input');
+          return message;
+        },
+        onError: async (current, error) => {
+          sameSession = current === session;
+          observed = error;
+          events.push('error');
+        },
+        afterSession: async current => {
+          events.push(current === session ? 'cleanup' : 'wrong session');
+        },
+      },
+    }
+  );
+
+  const rejected = await orchestrator.processMessage(session).catch((error: unknown) => error);
+
+  expect({rejected: rejected === failure, observed: observed === failure, sameSession, events}).toEqual({
+    rejected: true,
+    observed: true,
+    sameSession: true,
+    events: ['allocated', 'error', 'cleanup'],
+  });
+});
