@@ -0,0 +1,37 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+it('cleans up a failed session setup before rejecting [specs/hal-engine-config-hooks/spec.md#7]', async () => {
+  const session: ChatSession = {sessionId: 'setup-failure', userId: 'user', entries: []};
+  const failure = new Error('setup failed');
+  const events: string[] = [];
+  const orchestrator = createChatOrchestrator(
+    createMockProvider(),
+    new PromptBuilder({identity: 'Test assistant'}),
+    undefined,
+    {
+      hooks: {
+        beforeSession: async () => {
+          events.push('setup');
+          throw failure;
+        },
+        onError: async (receivedSession, error) => {
+          if (receivedSession === session && error === failure) events.push('error');
+        },
+        afterSession: async receivedSession => {
+          if (receivedSession === session) events.push('cleanup');
+        },
+      },
+    }
+  );
+
+  const rejection: unknown = await orchestrator.processMessage(session).catch((error: unknown) => error);
+
+  expect({sameError: rejection === failure, events, entries: session.entries}).toEqual({
+    sameError: true,
+    events: ['setup', 'error', 'cleanup'],
+    entries: [],
+  });
+});
