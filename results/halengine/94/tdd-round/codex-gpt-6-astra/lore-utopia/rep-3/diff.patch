+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+it('releases a resource acquired before beforeSession fails (spec: specs/hal-engine-config-hooks/spec.md#8)', async () => {
+  const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+  const resources = new Set<ChatSession>();
+  const failure = new Error('initialization failed');
+  const errors: {session: ChatSession; error: Error}[] = [];
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured generation is not part of this turn');
+    },
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'HAL'}), undefined, {
+    hooks: {
+      beforeSession: async current => {
+        resources.add(current);
+        throw failure;
+      },
+      onError: async (current, error) => {
+        errors.push({session: current, error});
+      },
+      afterSession: async current => {
+        resources.delete(current);
+      },
+    },
+  });
+
+  const rejection: unknown = await orchestrator.processMessage(session).catch((error: unknown) => error);
+
+  expect({released: resources.size === 0, errors, originalError: rejection === failure}).toEqual({
+    released: true,
+    errors: [{session, error: failure}],
+    originalError: true,
+  });
+});
