@@ -0,0 +1,42 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+it('releases a partially acquired resource when beforeSession rejects (spec: specs/hal-engine-config-hooks/spec.md#7)', async () => {
+  const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+  const failure = new Error('allocation failed');
+  const resources = new Set<ChatSession>();
+  const events: string[] = [];
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured output is not used by this turn');
+    },
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Test'}), undefined, {
+    hooks: {
+      beforeSession: async current => {
+        resources.add(current);
+        throw failure;
+      },
+      onError: async (current, error) => {
+        if (current === session && error === failure) events.push('onError');
+      },
+      afterSession: async current => {
+        resources.delete(current);
+        events.push('afterSession');
+      },
+    },
+  });
+
+  const rejected = await orchestrator.processMessage(session).catch((error: unknown) => error);
+
+  expect({sameError: rejected === failure, resources: resources.size, events}).toEqual({
+    sameError: true,
+    resources: 0,
+    events: ['onError', 'afterSession'],
+  });
+});
