+
+describe('ChatOrchestrator beforeSession failure', () => {
+  it('aborts before later hooks and provider calls while running onError then afterSession', async () => {
+    const callOrder: string[] = [];
+    const baseHooks = recordingHooks(callOrder, [
+      'beforeUserInput',
+      'afterUserInput',
+      'beforeModelResponse',
+      'afterModelResponse',
+    ]);
+    let reportedError: {sessionId: string; message: string} | undefined;
+    const hooks: OrchestratorHooks = {
+      ...baseHooks,
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw new Error('allocation failed');
+      },
+      onError: async (currentSession, error) => {
+        callOrder.push('onError');
+        reportedError = {sessionId: currentSession.sessionId, message: error.message};
+      },
+      afterSession: async () => {
+        callOrder.push('afterSession');
+      },
+    };
+    const {provider, sent} = capturingProvider();
+    const session = createSession('hello');
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(session));
+
+    expect({outcome, callOrder, sent, reportedError, entryCount: session.entries.length}).toEqual({
+      outcome: 'allocation failed',
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+      sent: {systemPrompt: '', lastUserContent: ''},
+      reportedError: {sessionId: 's1', message: 'allocation failed'},
+      entryCount: 1,
+    });
+  });
+});
