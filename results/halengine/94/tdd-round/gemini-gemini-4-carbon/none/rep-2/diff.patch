+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {recordingSessionStore, writeSignalPromptBuilder} from '../infrastructure/writeSignalTestSupport.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('when beforeSession throws', () => {
+  it('fires onError and afterSession, skips later hooks, and still rejects', async () => {
+    const seen: string[] = [];
+    let providerCalls = 0;
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        providerCalls++;
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        seen.push('beforeSession');
+        throw new Error('span allocation failed');
+      },
+      beforeUserInput: async (_session, userMessage) => {
+        seen.push('beforeUserInput');
+        return userMessage;
+      },
+      afterUserInput: async () => void seen.push('afterUserInput'),
+      beforeModelResponse: async (_session, systemPrompt) => {
+        seen.push('beforeModelResponse');
+        return systemPrompt;
+      },
+      afterModelResponse: async () => void seen.push('afterModelResponse'),
+      onError: async (turnSession, error) => void seen.push(`onError:${turnSession.sessionId}:${error.message}`),
+      afterSession: async turnSession => void seen.push(`afterSession:${turnSession.sessionId}`),
+    };
+    const saved: string[] = [];
+    const sessionStore = recordingSessionStore(turnSession => void saved.push(turnSession.sessionId));
+    const orchestrator = createChatOrchestrator(provider, writeSignalPromptBuilder, undefined, {hooks, sessionStore});
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+
+    const outcome = await orchestrator.processMessage(session).catch((error: Error) => `threw: ${error.message}`);
+
+    expect({outcome, seen, providerCalls, saved}).toEqual({
+      outcome: 'threw: span allocation failed',
+      seen: ['beforeSession', 'onError:s1:span allocation failed', 'afterSession:s1'],
+      providerCalls: 0,
+      saved: ['s1'],
+    });
+  });
+});
