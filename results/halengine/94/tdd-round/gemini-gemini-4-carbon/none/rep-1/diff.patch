+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {recordingSessionStore, writeSignalPromptBuilder} from '../infrastructure/writeSignalTestSupport.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+describe('when beforeSession throws', () => {
+  it('aborts the turn before input or provider steps and still runs onError, afterSession and save', async () => {
+    const callOrder: string[] = [];
+    const thrownError = new Error('span allocation broke');
+    let observedErrorSession: ChatSession | undefined;
+    let observedError: Error | undefined;
+    let cleanupSession: ChatSession | undefined;
+
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw thrownError;
+      },
+      beforeUserInput: async (_current, message) => {
+        callOrder.push('beforeUserInput');
+        return message;
+      },
+      afterUserInput: async () => {
+        callOrder.push('afterUserInput');
+      },
+      beforeModelResponse: async (_current, prompt) => {
+        callOrder.push('beforeModelResponse');
+        return prompt;
+      },
+      afterModelResponse: async () => {
+        callOrder.push('afterModelResponse');
+      },
+      onError: async (current, error) => {
+        callOrder.push('onError');
+        observedErrorSession = current;
+        observedError = error;
+      },
+      afterSession: async current => {
+        callOrder.push('afterSession');
+        cleanupSession = current;
+      },
+    };
+
+    let providerCalls = 0;
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        providerCalls += 1;
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const savedSessionIds: string[] = [];
+    const sessionStore = recordingSessionStore(saved => {
+      callOrder.push('save');
+      savedSessionIds.push(saved.sessionId);
+    });
+    const orchestrator = createChatOrchestrator(provider, writeSignalPromptBuilder, undefined, {hooks, sessionStore});
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+    };
+    const rejection = await orchestrator.processMessage(session).then(
+      () => undefined,
+      (error: unknown) => error
+    );
+
+    expect({
+      rejection,
+      callOrder,
+      providerCalls,
+      observedErrorSession,
+      observedError,
+      cleanupSession,
+      savedSessionIds,
+      entries: session.entries,
+    }).toEqual({
+      rejection: thrownError,
+      callOrder: ['beforeSession', 'onError', 'afterSession', 'save'],
+      providerCalls: 0,
+      observedErrorSession: session,
+      observedError: thrownError,
+      cleanupSession: session,
+      savedSessionIds: ['s1'],
+      entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+    });
+  });
+});
