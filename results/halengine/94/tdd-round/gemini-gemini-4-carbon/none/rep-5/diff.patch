+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {answering, writeSignalPromptBuilder} from '../infrastructure/writeSignalTestSupport.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('beforeSession failure lifecycle', () => {
+  it('runs onError then afterSession and skips the rest of the turn when beforeSession throws', async () => {
+    const callOrder: string[] = [];
+    const session: ChatSession = {
+      sessionId: 's-before',
+      userId: 'u-before',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw new Error('allocation failed');
+      },
+      beforeUserInput: async (_current, message) => {
+        callOrder.push('beforeUserInput');
+        return message;
+      },
+      onError: async (failedSession, error) => {
+        callOrder.push(`onError:${failedSession.sessionId}:${error.message}`);
+      },
+      afterSession: async endedSession => {
+        callOrder.push(`afterSession:${endedSession.sessionId}`);
+      },
+    };
+    const orchestrator = createChatOrchestrator(answering('reply'), writeSignalPromptBuilder, undefined, {hooks});
+
+    const outcome = await orchestrator
+      .processMessage(session)
+      .then(() => 'resolved')
+      .catch((error: Error) => `rejected:${error.message}`);
+
+    expect({outcome, callOrder}).toEqual({
+      outcome: 'rejected:allocation failed',
+      callOrder: ['beforeSession', 'onError:s-before:allocation failed', 'afterSession:s-before'],
+    });
+  });
+});
