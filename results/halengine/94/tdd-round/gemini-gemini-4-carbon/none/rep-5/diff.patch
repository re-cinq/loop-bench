+import {createHalEngine} from './config.js';
+import {recordingSessionStore} from './infrastructure/writeSignalTestSupport.js';
+import type {OrchestratorHooks} from './orchestration/chatOrchestrator.js';
+import type {ChatSession, SessionEntry} from './types/session.js';
+
+const USER_ENTRY: SessionEntry = {
+  role: 'user',
+  content: 'hello',
+  timestamp: '2026-01-01T00:00:00.000Z',
+};
+
+function throwingLifecycleHooks(
+  events: string[],
+  openSpans: string[],
+  onCleanupEntries: (entries: SessionEntry[]) => void
+): OrchestratorHooks {
+  return {
+    beforeSession: async current => {
+      openSpans.push(current.sessionId);
+      events.push('beforeSession');
+      throw new Error('token lease refused');
+    },
+    beforeUserInput: async (_current, message) => {
+      events.push('beforeUserInput');
+      return `rewritten:${message}`;
+    },
+    afterUserInput: async () => void events.push('afterUserInput'),
+    beforeModelResponse: async (_current, systemPrompt) => {
+      events.push('beforeModelResponse');
+      return systemPrompt;
+    },
+    afterModelResponse: async () => void events.push('afterModelResponse'),
+    onError: async (failed, error) => void events.push(`onError:${failed.sessionId}:${error.message}`),
+    afterSession: async ended => {
+      openSpans.pop();
+      onCleanupEntries([...ended.entries]);
+      events.push(`afterSession:${ended.sessionId}`);
+    },
+  };
+}
+
+describe('createHalEngine beforeSession failure lifecycle', () => {
+  it('runs onError, afterSession and session.save without starting the turn when a config-installed beforeSession throws', async () => {
+    const events: string[] = [];
+    const openSpans: string[] = [];
+    let entriesAtCleanup: SessionEntry[] = [];
+    const hooks = throwingLifecycleHooks(events, openSpans, entries => {
+      entriesAtCleanup = entries;
+    });
+    const engine = createHalEngine({
+      provider: {type: 'mock'},
+      prompt: {identity: 'assistant'},
+      session: recordingSessionStore(written => void events.push(`save:${written.sessionId}`)),
+      auth: {ws: async () => null},
+      orchestrator: {hooks},
+    });
+    const session: ChatSession = {sessionId: 's-cfg-throw', userId: 'u1', entries: [{...USER_ENTRY}]};
+
+    const outcome = await engine.orchestrator
+      .processMessage(session)
+      .then(() => 'resolved')
+      .catch((error: Error) => `rejected:${error.message}`);
+
+    expect({outcome, events, openSpans, entriesAtCleanup}).toEqual({
+      outcome: 'rejected:token lease refused',
+      events: [
+        'beforeSession',
+        'onError:s-cfg-throw:token lease refused',
+        'afterSession:s-cfg-throw',
+        'save:s-cfg-throw',
+      ],
+      openSpans: [],
+      entriesAtCleanup: [USER_ENTRY],
+    });
+  });
+});
