+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession, SessionEntry} from '../types/session.js';
+
+describe('ChatOrchestrator when beforeSession throws', () => {
+  it('runs onError then afterSession before rejecting, with later hooks and provider skipped', async () => {
+    const initialEntry: SessionEntry = {role: 'user', content: 'ask', timestamp: '2026-01-01T00:00:00.000Z'};
+    const session: ChatSession = {sessionId: 's-before', userId: 'u-before', entries: [{...initialEntry}]};
+    const failure = new Error('span allocation failed');
+    const fired: string[] = [];
+    let observedFailure: {sameSession: boolean; error: Error} | undefined;
+    let observedEntries: SessionEntry[] | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        fired.push('beforeSession');
+        throw failure;
+      },
+      beforeUserInput: async () => {
+        fired.push('beforeUserInput');
+        return 'rewritten';
+      },
+      afterUserInput: async () => void fired.push('afterUserInput'),
+      beforeModelResponse: async (_session, prompt) => {
+        fired.push('beforeModelResponse');
+        return prompt;
+      },
+      afterModelResponse: async () => void fired.push('afterModelResponse'),
+      onError: async (seenSession, seenError) => {
+        fired.push('onError');
+        observedFailure = {sameSession: seenSession === session, error: seenError};
+      },
+      afterSession: async seenSession => {
+        fired.push('afterSession');
+        observedEntries = seenSession.entries.map(entry => ({...entry}));
+      },
+    };
+
+    let providerCalls = 0;
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        providerCalls += 1;
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const builder = new PromptBuilder({identity: 'Assistant.'});
+    const orchestrator = createChatOrchestrator(provider, builder, undefined, {hooks});
+    const turn = orchestrator.processMessage(session);
+    const rejectedWith = await turn.then(() => undefined).catch((caught: unknown) => caught);
+
+    expect({rejectedWith, fired, providerCalls, observedFailure, observedEntries}).toEqual({
+      rejectedWith: failure,
+      fired: ['beforeSession', 'onError', 'afterSession'],
+      providerCalls: 0,
+      observedFailure: {sameSession: true, error: failure},
+      observedEntries: [initialEntry],
+    });
+  });
+});
