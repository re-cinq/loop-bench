+describe('ChatOrchestrator beforeSession throw', () => {
+  it('aborts before user-input hooks and provider while running onError then afterSession', async () => {
+    const callOrder: string[] = [];
+    const thrown = new Error('beforeSession boom');
+    let seenSession: ChatSession | undefined;
+    let seenError: Error | undefined;
+    const {provider, sent} = capturingProvider();
+    const session = createSession('hello');
+    const hooks: OrchestratorHooks = {
+      ...recordingHooks(callOrder, [
+        'beforeUserInput',
+        'afterUserInput',
+        'beforeModelResponse',
+        'afterModelResponse',
+        'afterSession',
+      ]),
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw thrown;
+      },
+      onError: async (currentSession, error) => {
+        callOrder.push('onError');
+        seenSession = currentSession;
+        seenError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(session));
+
+    expect({
+      outcome,
+      callOrder,
+      sent,
+      entryRoles: session.entries.map(entry => entry.role),
+      sameSession: seenSession === session,
+      sameError: seenError === thrown,
+    }).toEqual({
+      outcome: 'beforeSession boom',
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+      sent: {systemPrompt: '', lastUserContent: ''},
+      entryRoles: ['user'],
+      sameSession: true,
+      sameError: true,
+    });
+  });
+});
