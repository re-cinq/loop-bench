+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+const provider: AIProvider = {
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+const session: ChatSession = {
+  sessionId: 'session',
+  userId: 'user',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+describe('beforeSession failure', () => {
+  // specs/hal-engine-config-hooks/spec.md#6
+  it('reports and cleans up a failed beforeSession before rethrowing', async () => {
+    const calls: string[] = [];
+    const failure = new Error('setup failed');
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), undefined, {
+      hooks: {
+        beforeSession: async () => {
+          calls.push('beforeSession');
+          throw failure;
+        },
+        onError: async (_session, error) => void calls.push(error === failure ? 'onError' : 'wrong error'),
+        afterSession: async () => void calls.push('afterSession'),
+      },
+    });
+
+    const thrown = await orchestrator.processMessage(session).catch(error => error);
+
+    expect({thrown, calls}).toEqual({
+      thrown: failure,
+      calls: ['beforeSession', 'onError', 'afterSession'],
+    });
+  });
+});
