+import {describe, expect, it, jest} from '@jest/globals';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+describe('beforeSession failures', () => {
+  it('propagates the error and runs onError and afterSession', async () => {
+    const failure = new Error('setup failed');
+    const onError = jest.fn(async () => undefined);
+    const afterSession = jest.fn(async () => undefined);
+    const provider: AIProvider = {
+      async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      provider,
+      new PromptBuilder({
+        identity: 'HAL',
+      }),
+      undefined,
+      {
+        hooks: {
+          beforeSession: async () => {
+            throw failure;
+          },
+          onError,
+          afterSession,
+        },
+      }
+    );
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+
+    const result = await Promise.allSettled([orchestrator.processMessage(session)]);
+    expect({
+      result,
+      onError: onError.mock.calls,
+      afterSession: afterSession.mock.calls,
+    }).toEqual({
+      result: [{status: 'rejected', reason: failure}],
+      onError: [[session, failure]],
+      afterSession: [[session]],
+    });
+  });
+});
