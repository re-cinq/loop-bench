+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const session: ChatSession = {
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+it('runs error and cleanup hooks when beforeSession aborts before provider interaction', async () => {
+  const error = new Error('setup failed');
+  const calls: string[] = [];
+  const provider: AIProvider = {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      calls.push('provider');
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), undefined, {
+    hooks: {
+      beforeSession: async () => {
+        calls.push('beforeSession');
+        throw error;
+      },
+      onError: async (_session, caught) => {
+        calls.push(caught === error ? 'onError' : 'wrong error');
+      },
+      afterSession: async () => {
+        calls.push('afterSession');
+      },
+    },
+  });
+
+  await expect(orchestrator.processMessage(session)).rejects.toBe(error);
+  expect(calls).toEqual(['beforeSession', 'onError', 'afterSession']);
+});
