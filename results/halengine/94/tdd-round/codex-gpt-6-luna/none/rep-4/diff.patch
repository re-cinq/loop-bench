+import {describe, expect, it} from '@jest/globals';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const session: ChatSession = {
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+const provider: AIProvider = {
+  async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'hello back'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+const promptBuilder = new PromptBuilder({
+  identity: 'You are HAL.',
+  responseGuidelines: 'Be precise.',
+});
+
+describe('beforeSession failure hooks', () => {
+  it('runs onError before afterSession and propagates the original error', async () => {
+    const error = new Error('before session failed');
+    const calls: string[] = [];
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {
+      hooks: {
+        beforeSession: async () => {
+          throw error;
+        },
+        onError: async (_session, receivedError) => {
+          calls.push(receivedError === error ? 'onError:original' : 'onError:other');
+        },
+        afterSession: async () => {
+          calls.push('afterSession');
+        },
+      },
+    });
+
+    let caughtError: unknown;
+    try {
+      await orchestrator.processMessage(session);
+    } catch (receivedError) {
+      caughtError = receivedError;
+    }
+    expect({caughtError, calls}).toEqual({caughtError: error, calls: ['onError:original', 'afterSession']});
+  });
+});
