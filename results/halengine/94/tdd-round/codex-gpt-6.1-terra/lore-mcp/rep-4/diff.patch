@@ -0,0 +1,31 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('[specs/hal-engine-config-hooks/spec.md#7]', () => {
+  it('passes the session and error to onError when beforeSession fails', async () => {
+    const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+    const failure = new Error('setup failed');
+    let received: unknown[] = [];
+    const orchestrator = createChatOrchestrator({} as AIProvider, new PromptBuilder({identity: 'test'}), undefined, {
+      hooks: {
+        beforeSession: async () => {
+          throw failure;
+        },
+        onError: async (hookSession, error) => {
+          received = [hookSession, error];
+        },
+      },
+    });
+
+    const rejection: unknown = await orchestrator.processMessage(session).then(
+      () => undefined,
+      (error: unknown) => error
+    );
+    expect({sameRejection: rejection === failure, received}).toEqual({
+      sameRejection: true,
+      received: [session, failure],
+    });
+  });
+});
