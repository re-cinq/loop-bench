+import {describe, expect, it} from '@jest/globals';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('beforeSession failure', () => {
+  // specs/hal-engine-config-hooks/spec.md#7
+  it('calls onError with the session and original beforeSession error', async () => {
+    const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+    const error = new Error('beforeSession failed');
+    let received: [ChatSession, Error] | undefined;
+    const orchestrator = createChatOrchestrator({} as AIProvider, new PromptBuilder({identity: 'test'}), undefined, {
+      hooks: {
+        beforeSession: async () => {
+          throw error;
+        },
+        onError: async (actualSession, actualError) => {
+          received = [actualSession, actualError];
+        },
+      },
+    });
+    await orchestrator.processMessage(session).catch(() => undefined);
+    expect(received).toEqual([session, error]);
+  });
+});
