+import {describe, expect, it} from '@jest/globals';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('beforeSession failure [specs/hal-engine-config-hooks/spec.md#9]', () => {
+  it('runs error and cleanup hooks for a failed start', async () => {
+    const error = new Error('start failed');
+    const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+    const calls: unknown[] = [];
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        calls.push('provider');
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), undefined, {
+      hooks: {
+        beforeSession: async () => {
+          throw error;
+        },
+        onError: async (receivedSession, receivedError) => {
+          calls.push(['onError', receivedSession, receivedError]);
+        },
+        afterSession: async receivedSession => {
+          calls.push(['afterSession', receivedSession]);
+        },
+      },
+    });
+    const result = await orchestrator.processMessage(session).catch((caught: unknown) => caught);
+    expect({result, calls}).toEqual({
+      result: error,
+      calls: [
+        ['onError', session, error],
+        ['afterSession', session],
+      ],
+    });
+  });
+});
