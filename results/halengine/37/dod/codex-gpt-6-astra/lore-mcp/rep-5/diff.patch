index 0000000..5c8d387
--- /dev/null
+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,153 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+import {setLogger} from '../../shared/logger.js';
+
+const weather = (inputSchema: Record<string, unknown>): ToolDefinition => ({
+  name: 'weather',
+  description: 'Report weather for a location',
+  inputSchema,
+});
+
+const schema = (): Record<string, unknown> => ({
+  type: 'object',
+  properties: {
+    location: {type: 'string'},
+    units: {type: 'string', enum: ['celsius', 'fahrenheit'], default: 'celsius'},
+  },
+  required: ['location'],
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#1
+it('rejects malformed tool inputs safely and passes accepted inputs unchanged', async () => {
+  const registry = new ToolRegistry();
+  const received: Record<string, unknown>[] = [];
+  const lines: string[] = [];
+  const write = (category: string, message: string, fields?: Record<string, unknown>): void => {
+    lines.push(JSON.stringify({category, message, fields}));
+  };
+  setLogger({debug: write, info: write, warn: write, error: write});
+  try {
+    registry.register(weather(schema()), async input => {
+      received.push(structuredClone(input));
+      return 'forecast';
+    });
+    const missing = await registry.execute('weather', {});
+    const wrongType = await registry.execute('weather', {location: 938174625});
+    const wrongEnum = await registry.execute('weather', {location: 'Private address 741', units: 'private-unit-826'});
+    const rejectedCalls = received.length;
+    const rejectionLogs = [...lines];
+    const valid = {location: 'Berlin', extra: {unchanged: true}};
+    const accepted = await registry.execute('weather', valid);
+    const unknown = await registry.execute('unregistered', {}).catch((error: Error) => error.message);
+
+    expect({
+      missing,
+      wrongType,
+      wrongEnum,
+      rejectedCalls,
+      loggedRequired: rejectionLogs.some(line => /(?=.*location)(?=.*required)/is.test(line)),
+      loggedType: rejectionLogs.some(line => /(?=.*location)(?=.*string)/is.test(line)),
+      loggedEnum: rejectionLogs.some(line => /(?=.*units)(?=.*(?:enum|allowed))/is.test(line)),
+      accepted,
+      received: received.slice(rejectedCalls),
+      valid,
+      unknown,
+      leaked: /938174625|Private address 741|private-unit-826/.test(
+        JSON.stringify({missing, wrongType, wrongEnum, lines})
+      ),
+    }).toEqual({
+      missing: {result: expect.stringMatching(/(?=.*location)(?=.*required)/is)},
+      wrongType: {result: expect.stringMatching(/(?=.*location)(?=.*string)/is)},
+      wrongEnum: {result: expect.stringMatching(/(?=.*units)(?=.*(?:enum|allowed))/is)},
+      rejectedCalls: 0,
+      loggedRequired: true,
+      loggedType: true,
+      loggedEnum: true,
+      accepted: {result: 'forecast'},
+      received: [{location: 'Berlin', extra: {unchanged: true}}],
+      valid: {location: 'Berlin', extra: {unchanged: true}},
+      unknown: 'Unknown tool: unregistered',
+      leaked: false,
+    });
+  } finally {
+    setLogger();
+  }
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#2
+it('compiles static schemas at registration and reuses them for ten executions', async () => {
+  const registry = new ToolRegistry();
+  let registrationError = '';
+  try {
+    registry.register(weather({type: 'not-a-json-schema-type'}), async () => 'forecast');
+  } catch (error) {
+    registrationError = error instanceof Error ? error.message : String(error);
+  }
+  const inputSchema = schema();
+  let reads = 0;
+  Object.defineProperty(inputSchema, 'properties', {
+    enumerable: true,
+    get: () => {
+      reads++;
+      return {location: {type: 'string'}};
+    },
+  });
+  registry.register(weather(inputSchema), async () => 'forecast');
+  const registrationReads = reads;
+  const responses = [];
+  for (let call = 0; call < 10; call++) responses.push(await registry.execute('weather', {location: 'Berlin'}));
+
+  expect({
+    registrationError,
+    compiledAtRegistration: registrationReads > 0,
+    laterReads: reads - registrationReads,
+    responses,
+  }).toEqual({
+    registrationError: expect.stringMatching(/weather/),
+    compiledAtRegistration: true,
+    laterReads: 0,
+    responses: Array.from({length: 10}, () => ({result: 'forecast'})),
+  });
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#3
+it('validates dynamic definitions against the current schema and caches by schema identity', async () => {
+  const registry = new ToolRegistry();
+  const textSchema = schema();
+  let reads = 0;
+  const numericSchema = {
+    type: 'object',
+    get properties() {
+      reads++;
+      return {location: {type: 'number'}};
+    },
+    required: ['location'],
+  };
+  let current: Record<string, unknown> = textSchema;
+  const inputs: Record<string, unknown>[] = [];
+  registry.register(
+    () => weather(current),
+    async input => {
+      inputs.push(structuredClone(input));
+      return 'forecast';
+    }
+  );
+  const first = await registry.execute('weather', {location: 'Berlin'});
+  current = numericSchema;
+  const rejected = await registry.execute('weather', {location: 'Berlin'});
+  const firstCompileReads = reads;
+  const accepted = await registry.execute('weather', {location: 42});
+  const cachedReads = reads - firstCompileReads;
+  current = textSchema;
+  const restored = await registry.execute('weather', {location: 42});
+
+  expect({first, rejected, accepted, restored, inputs, compiled: firstCompileReads > 0, cachedReads}).toEqual({
+    first: {result: 'forecast'},
+    rejected: {result: expect.stringMatching(/(?=.*location)(?=.*number)/is)},
+    accepted: {result: 'forecast'},
+    restored: {result: expect.stringMatching(/(?=.*location)(?=.*string)/is)},
+    inputs: [{location: 'Berlin'}, {location: 42}],
+    compiled: true,
+    cachedReads: 0,
+  });
+});