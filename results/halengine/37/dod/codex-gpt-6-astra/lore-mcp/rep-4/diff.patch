index 0000000..d1220f4
--- /dev/null
+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,150 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+import {setLogger} from '../../shared/logger.js';
+
+function definition(inputSchema: Record<string, unknown>): ToolDefinition {
+  return {name: 'weather', description: 'Weather by location', inputSchema};
+}
+
+function schema(): Record<string, unknown> {
+  return {
+    type: 'object',
+    properties: {
+      location: {type: 'string'},
+      units: {type: 'string', enum: ['metric', 'imperial'], default: 'metric'},
+    },
+    required: ['location'],
+  };
+}
+
+// Schema access is observable without replacing the validator or inspecting its implementation.
+function observedSchema() {
+  let reads = 0;
+  const value = {
+    ...schema(),
+    get required() {
+      reads++;
+      return ['location'];
+    },
+  };
+  return {value, reads: () => reads};
+}
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#1
+it('rejects malformed tool input privately and preserves accepted input', async () => {
+  const registry = new ToolRegistry();
+  const calls: Record<string, unknown>[] = [];
+  const logs: string[] = [];
+  const write = (category: string, message: string, fields?: Record<string, unknown>): void => {
+    logs.push(JSON.stringify({category, message, fields}));
+  };
+  setLogger({debug: write, info: write, warn: write, error: write});
+  try {
+    registry.register(definition(schema()), async input => {
+      calls.push(structuredClone(input));
+      return 'forecast';
+    });
+    const cases = [
+      {input: {}, path: 'location', constraint: /required/i},
+      {input: {location: 987654321}, path: 'location', constraint: /string/i},
+      {input: {location: 'private-address', units: 'private-units'}, path: 'units', constraint: /enum|allowed/i},
+    ];
+    const rejections = [];
+    for (const {input, path, constraint} of cases) {
+      const start = logs.length;
+      const response = await registry.execute('weather', input);
+      rejections.push({
+        resultNamesPath: response.result.includes(path),
+        resultNamesConstraint: constraint.test(response.result),
+        logsNamePath: logs.slice(start).some(line => line.includes(path)),
+        logsNameConstraint: logs.slice(start).some(line => constraint.test(line)),
+        leaksValue: /987654321|private-address|private-units/.test(response.result + logs.slice(start).join('')),
+      });
+    }
+    const rejectedCalls = calls.length;
+    const valid = {location: 'Berlin', extra: {untouched: '001'}};
+    const accepted = await registry.execute('weather', valid);
+    const unknown = await registry.execute('absent', {}).catch((error: Error) => error.message);
+    expect({rejections, rejectedCalls, calls: calls.slice(rejectedCalls), valid, accepted, unknown}).toEqual({
+      rejections: cases.map(() => ({
+        resultNamesPath: true,
+        resultNamesConstraint: true,
+        logsNamePath: true,
+        logsNameConstraint: true,
+        leaksValue: false,
+      })),
+      rejectedCalls: 0,
+      calls: [{location: 'Berlin', extra: {untouched: '001'}}],
+      valid: {location: 'Berlin', extra: {untouched: '001'}},
+      accepted: {result: 'forecast'},
+      unknown: 'Unknown tool: absent',
+    });
+  } finally {
+    setLogger();
+  }
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#2
+it('compiles static schemas at registration and reuses them for ten calls', async () => {
+  const registry = new ToolRegistry();
+  let registrationError = '';
+  try {
+    registry.register(definition({type: 'not-a-json-schema-type'}), async () => 'forecast');
+  } catch (error) {
+    registrationError = error instanceof Error ? error.message : String(error);
+  }
+  const observed = observedSchema();
+  registry.register(definition(observed.value), async () => 'forecast');
+  const registrationReads = observed.reads();
+  const results = [];
+  for (let i = 0; i < 10; i++) {
+    results.push(await registry.execute('weather', {location: 'Berlin'}));
+  }
+  expect({
+    errorNamesTool: registrationError.includes('weather'),
+    compiledAtRegistration: registrationReads > 0,
+    schemaRevisited: observed.reads() !== registrationReads,
+    results,
+  }).toEqual({
+    errorNamesTool: true,
+    compiledAtRegistration: true,
+    schemaRevisited: false,
+    results: Array.from({length: 10}, () => ({result: 'forecast'})),
+  });
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#3
+it('validates the current dynamic schema and caches each resolved schema object', async () => {
+  const registry = new ToolRegistry();
+  const first = observedSchema();
+  const second = {type: 'object', properties: {location: {type: 'number'}}, required: ['location']};
+  let current: Record<string, unknown> = first.value;
+  const calls: Record<string, unknown>[] = [];
+  registry.register(
+    () => definition(current),
+    async input => {
+      calls.push(structuredClone(input));
+      return 'forecast';
+    }
+  );
+  await registry.execute('weather', {location: 'Berlin'});
+  const firstReads = first.reads();
+  current = second;
+  const rejected = await registry.execute('weather', {location: 'private-address'});
+  await registry.execute('weather', {location: 42});
+  current = first.value;
+  await registry.execute('weather', {location: 'Paris'});
+  expect({
+    rejectionNamesPathAndType: /location/.test(rejected.result) && /number/.test(rejected.result),
+    leaksValue: rejected.result.includes('private-address'),
+    compiledFirstSchema: firstReads > 0,
+    firstSchemaRevisited: first.reads() !== firstReads,
+    calls,
+  }).toEqual({
+    rejectionNamesPathAndType: true,
+    leaksValue: false,
+    compiledFirstSchema: true,
+    firstSchemaRevisited: false,
+    calls: [{location: 'Berlin'}, {location: 42}, {location: 'Paris'}],
+  });
+});