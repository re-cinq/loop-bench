@@ -0,0 +1,174 @@
+import {Console} from 'node:console';
+import {Writable} from 'node:stream';
+import type {ToolDefinition} from '../../types/ai.js';
+import {setLogger} from '../../shared/logger.js';
+import {ToolRegistry} from './registry.js';
+
+const weather = (inputSchema: Record<string, unknown>): ToolDefinition => ({
+  name: 'weather',
+  description: 'Weather for a location',
+  inputSchema,
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#1
+it('rejects malformed tool input privately and passes valid input unchanged', async () => {
+  const registry = new ToolRegistry();
+  const calls: unknown[] = [];
+  const lines: string[] = [];
+  const sink = new Writable({
+    write(chunk, _encoding, done) {
+      lines.push(String(chunk));
+      done();
+    },
+  });
+  const logger = new Console(sink);
+  setLogger(logger);
+  try {
+    registry.register(
+      weather({
+        type: 'object',
+        properties: {
+          location: {type: 'string'},
+          unit: {type: 'string', enum: ['C', 'F'], default: 'C'},
+          address: {type: 'object', properties: {city: {type: 'string'}}},
+        },
+        required: ['location'],
+      }),
+      async (input, context) => {
+        calls.push({input: structuredClone(input), context});
+        return 'forecast';
+      }
+    );
+    const cases = [
+      {input: {}, path: /location/i, constraint: /required/i, secret: 'private@example.test'},
+      {input: {location: 987654321}, path: /location/i, constraint: /string/i, secret: '987654321'},
+      {
+        input: {location: 'Berlin', unit: 'private@example.test'},
+        path: /unit/i,
+        constraint: /enum|allowed/i,
+        secret: 'private@example.test',
+      },
+      {
+        input: {location: 'Berlin', address: {city: 987654321}},
+        path: /address.*city/i,
+        constraint: /string/i,
+        secret: '987654321',
+      },
+    ];
+    const rejected = [];
+    for (const entry of cases) {
+      lines.length = 0;
+      const response = await registry.execute('weather', {...entry.input, identity: 'private@example.test'});
+      rejected.push({
+        path: entry.path.test(response.result),
+        constraint: entry.constraint.test(response.result),
+        logPath: entry.path.test(lines.join('')),
+        logConstraint: entry.constraint.test(lines.join('')),
+        private: ![response.result, ...lines].some(
+          text => text.includes(entry.secret) || text.includes('private@example.test')
+        ),
+      });
+    }
+    const invalidCalls = calls.length;
+    calls.length = 0;
+    const input = {location: 'Berlin', extra: {untouched: '007'}};
+    const context = {userId: 'reader', sessionId: 'session'};
+    const valid = await registry.execute('weather', input, context);
+    const unknown = await registry.execute('absent', {}).catch((error: Error) => error.message);
+    expect({rejected, invalidCalls, calls, input, valid, unknown}).toEqual({
+      rejected: cases.map(() => ({path: true, constraint: true, logPath: true, logConstraint: true, private: true})),
+      invalidCalls: 0,
+      calls: [{input: {location: 'Berlin', extra: {untouched: '007'}}, context}],
+      input: {location: 'Berlin', extra: {untouched: '007'}},
+      valid: {result: 'forecast'},
+      unknown: 'Unknown tool: absent',
+    });
+  } finally {
+    setLogger();
+    sink.end();
+  }
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#2
+it('compiles static schemas at registration and reuses them for ten calls', async () => {
+  const registry = new ToolRegistry();
+  let failure = '';
+  try {
+    registry.register(weather({type: 'not-a-json-schema-type'}), async () => 'forecast');
+  } catch (error) {
+    failure = error instanceof Error ? error.message : String(error);
+  }
+  let reads = 0;
+  const schema = {
+    type: 'object',
+    get properties() {
+      reads++;
+      return {location: {type: 'string'}};
+    },
+    required: ['location'],
+  };
+  registry.register(weather(schema), async () => 'forecast');
+  const atRegistration = reads;
+  const results = [];
+  for (let index = 0; index < 10; index++) {
+    results.push(await registry.execute('weather', {location: 'Berlin'}));
+  }
+  expect({
+    namedFailure: failure.includes('weather'),
+    compiledAtRegistration: atRegistration > 0,
+    reads,
+    results,
+  }).toEqual({
+    namedFailure: true,
+    compiledAtRegistration: true,
+    reads: atRegistration,
+    results: Array.from({length: 10}, () => ({result: 'forecast'})),
+  });
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#3
+it('validates each dynamic definition and caches each resolved schema object', async () => {
+  const registry = new ToolRegistry();
+  let reads = 0;
+  const first = {type: 'object', properties: {location: {type: 'string'}}, required: ['location']};
+  const second = {
+    type: 'object',
+    get properties() {
+      reads++;
+      return {location: {type: 'number', enum: [42]}};
+    },
+    required: ['location'],
+  };
+  let current: Record<string, unknown> = first;
+  const inputs: unknown[] = [];
+  registry.register(
+    () => weather(current),
+    async input => {
+      inputs.push(input);
+      return 'forecast';
+    }
+  );
+  await registry.execute('weather', {location: 'Berlin'});
+  current = second;
+  const rejected = await registry.execute('weather', {location: 'Berlin'});
+  const compiled = reads;
+  const accepted = await registry.execute('weather', {location: 42});
+  const cachedReads = reads;
+  current = first;
+  const restored = await registry.execute('weather', {location: 'Berlin'});
+  expect({
+    rejection: /location/i.test(rejected.result) && /number/i.test(rejected.result),
+    compiled: compiled > 0,
+    cachedReads,
+    accepted,
+    restored,
+    inputs,
+  }).toEqual({
+    rejection: true,
+    compiled: true,
+    cachedReads: compiled,
+    accepted: {result: 'forecast'},
+    restored: {result: 'forecast'},
+    inputs: [{location: 'Berlin'}, {location: 42}, {location: 'Berlin'}],
+  });
+});