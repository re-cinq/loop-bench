@@ -0,0 +1,141 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+import {setLogger} from '../../shared/logger.js';
+
+const definition = (inputSchema: Record<string, unknown>): ToolDefinition => ({
+  name: 'weather',
+  description: 'Weather by location',
+  inputSchema,
+});
+
+const weatherSchema = (): Record<string, unknown> => ({
+  type: 'object',
+  required: ['location'],
+  properties: {
+    location: {type: 'string'},
+    unit: {type: 'string', enum: ['C', 'F'], default: 'C'},
+    options: {type: 'object', properties: {days: {type: 'integer'}}},
+  },
+});
+
+it('specs/hal-engine-tool-input-validation/spec.md#1: rejects invalid input safely and preserves accepted input', async () => {
+  const registry = new ToolRegistry();
+  const received: Record<string, unknown>[] = [];
+  const lines: string[] = [];
+  const write = (category: string, message: string, fields?: Record<string, unknown>): void => {
+    lines.push(JSON.stringify({category, message, fields}));
+  };
+  setLogger({debug: write, info: write, warn: write, error: write});
+  registry.register(definition(weatherSchema()), async input => {
+    received.push(structuredClone(input));
+    return 'forecast';
+  });
+
+  try {
+    const cases = [
+      {input: {}, path: /location/i, constraint: /required/i},
+      {input: {location: 49123456789}, path: /location/i, constraint: /string/i},
+      {input: {location: 'private-address', unit: 'private-unit'}, path: /unit/i, constraint: /enum|allowed/i},
+      {
+        input: {location: 'private-address', options: {days: 'private-days'}},
+        path: /options.*days/i,
+        constraint: /integer/i,
+      },
+    ];
+    const rejected = [];
+    for (const entry of cases) {
+      const start = lines.length;
+      const response = await registry.execute('weather', entry.input);
+      rejected.push({response, logs: lines.slice(start).join('\n'), ...entry});
+    }
+    const invalidCalls = received.length;
+    received.length = 0;
+    const valid = {location: 'Berlin', extra: {unchanged: '12'}};
+    const result = await registry.execute('weather', valid);
+    await expect(registry.execute('missing', {})).rejects.toThrow('Unknown tool: missing');
+
+    expect({invalidCalls, received, valid, result}).toEqual({
+      invalidCalls: 0,
+      received: [{location: 'Berlin', extra: {unchanged: '12'}}],
+      valid: {location: 'Berlin', extra: {unchanged: '12'}},
+      result: {result: 'forecast'},
+    });
+    for (const {response, logs, path, constraint} of rejected) {
+      expect(response).toEqual({result: expect.any(String)});
+      expect(response.result).toMatch(path);
+      expect(response.result).toMatch(constraint);
+      expect(logs).toMatch(path);
+      expect(logs).toMatch(constraint);
+      expect(`${response.result}\n${logs}`).not.toMatch(/49123456789|private-address|private-unit|private-days/);
+    }
+  } finally {
+    setLogger();
+  }
+});
+
+it('specs/hal-engine-tool-input-validation/spec.md#2: compiles static schemas at registration and reuses them', async () => {
+  const registry = new ToolRegistry();
+  const received: Record<string, unknown>[] = [];
+  const execute = async (input: Record<string, unknown>): Promise<string> => {
+    received.push(input);
+    return 'forecast';
+  };
+  expect(() => registry.register(definition({type: 'not-a-json-schema-type'}), execute)).toThrow(/weather/);
+
+  let schemaReads = 0;
+  const schema = {
+    ...weatherSchema(),
+    get type(): string {
+      schemaReads++;
+      return 'object';
+    },
+  };
+  registry.register(definition(schema), execute);
+  const readsAtRegistration = schemaReads;
+  expect(readsAtRegistration).toBeGreaterThan(0);
+  for (let call = 0; call < 10; call++) {
+    await expect(registry.execute('weather', {})).resolves.toEqual({result: expect.stringMatching(/location/)});
+  }
+  expect({schemaReads, received}).toEqual({schemaReads: readsAtRegistration, received: []});
+});
+
+it('specs/hal-engine-tool-input-validation/spec.md#3: validates each dynamic schema and reuses its compiled validator', async () => {
+  const registry = new ToolRegistry();
+  const received: Record<string, unknown>[] = [];
+  let reads = 0;
+  const stringSchema = {
+    ...weatherSchema(),
+    get type(): string {
+      reads++;
+      return 'object';
+    },
+  };
+  const numberSchema = {type: 'object', required: ['location'], properties: {location: {type: 'number'}}};
+  let current: Record<string, unknown> = stringSchema;
+  registry.register(
+    () => definition(current),
+    async input => {
+      received.push(input);
+      return 'forecast';
+    }
+  );
+  const first = await registry.execute('weather', {location: 42});
+  const readsAfterFirstCall = reads;
+  current = numberSchema;
+  const second = await registry.execute('weather', {location: 'Berlin'});
+  const acceptedNumber = await registry.execute('weather', {location: 42});
+  current = stringSchema;
+  const third = await registry.execute('weather', {location: 42});
+  const acceptedString = await registry.execute('weather', {location: 'Berlin'});
+
+  expect({first, second, third, acceptedNumber, acceptedString, received}).toEqual({
+    first: {result: expect.stringMatching(/location.*string|string.*location/i)},
+    second: {result: expect.stringMatching(/location.*number|number.*location/i)},
+    third: {result: expect.stringMatching(/location.*string|string.*location/i)},
+    acceptedNumber: {result: 'forecast'},
+    acceptedString: {result: 'forecast'},
+    received: [{location: 42}, {location: 'Berlin'}],
+  });
+  expect(readsAfterFirstCall).toBeGreaterThan(0);
+  expect(reads).toBe(readsAfterFirstCall);
+});