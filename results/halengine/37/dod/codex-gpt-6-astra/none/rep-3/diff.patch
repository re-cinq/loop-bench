@@ -0,0 +1,138 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+import {setLogger} from '../../shared/logger.js';
+
+const weather = (inputSchema: Record<string, unknown>): ToolDefinition => ({
+  name: 'weather',
+  description: 'Describe weather for a location',
+  inputSchema,
+});
+
+const locationSchema = (): Record<string, unknown> => ({
+  type: 'object',
+  properties: {
+    location: {type: 'string'},
+    units: {type: 'string', enum: ['metric', 'imperial'], default: 'metric'},
+  },
+  required: ['location'],
+});
+
+describe('ToolRegistry input validation', () => {
+  // spec: specs/hal-engine-tool-input-validation/spec.md#1
+  it('rejects malformed calls privately and passes valid input unchanged', async () => {
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+    const logs: string[] = [];
+    const write = (category: string, message: string, fields?: Record<string, unknown>): void => {
+      logs.push(JSON.stringify({category, message, fields}));
+    };
+    setLogger({debug: write, info: write, warn: write, error: write});
+    registry.register(weather(locationSchema()), async input => {
+      received.push(structuredClone(input));
+      return JSON.stringify(input);
+    });
+
+    try {
+      const invalid = [
+        {input: {}, field: 'location', constraint: /required/i, secret: 'private-person@example.test'},
+        {input: {location: 83726491}, field: 'location', constraint: /string/i, secret: '83726491'},
+        {
+          input: {location: 'private-person@example.test', units: 'private-units'},
+          field: 'units',
+          constraint: /enum|allowed/i,
+          secret: 'private-units',
+        },
+      ];
+      for (const {input, field, constraint, secret} of invalid) {
+        const start = logs.length;
+        const response = await registry.execute('weather', {...input, identifying: 'private-person@example.test'});
+        expect({response, calls: received.length}).toEqual({
+          response: {result: expect.stringMatching(constraint)},
+          calls: 0,
+        });
+        expect(response.result).toContain(field);
+        const diagnostic = logs.slice(start).join('\n');
+        expect(diagnostic).toContain(field);
+        expect(diagnostic).toMatch(constraint);
+        expect(`${response.result}\n${diagnostic}`).not.toContain(secret);
+        expect(`${response.result}\n${diagnostic}`).not.toContain('private-person@example.test');
+      }
+      const input = {location: 'Berlin', extra: {keep: ['untouched']}};
+      const response = await registry.execute('weather', input);
+      expect({received, input, response}).toEqual({
+        received: [{location: 'Berlin', extra: {keep: ['untouched']}}],
+        input: {location: 'Berlin', extra: {keep: ['untouched']}},
+        response: {result: JSON.stringify(input)},
+      });
+      await expect(registry.execute('unregistered', {})).rejects.toThrow('Unknown tool: unregistered');
+    } finally {
+      setLogger();
+    }
+  });
+
+  // spec: specs/hal-engine-tool-input-validation/spec.md#2
+  it('compiles static schemas at registration and reuses them for ten calls', async () => {
+    const registry = new ToolRegistry();
+    expect(() =>
+      registry.register(weather({type: 'not-a-json-schema-type'}), async input => JSON.stringify(input))
+    ).toThrow(/weather/);
+    let schemaReads = 0;
+    const schema = {
+      ...locationSchema(),
+      get properties() {
+        schemaReads += 1;
+        return {location: {type: 'string'}};
+      },
+    };
+    registry.register(weather(schema), async input => JSON.stringify(input));
+    const readsAtRegistration = schemaReads;
+    expect(readsAtRegistration).toBeGreaterThan(0);
+    const results = [];
+    for (let index = 0; index < 10; index += 1) {
+      results.push(await registry.execute('weather', {location: 'Berlin'}));
+    }
+    expect({schemaReads, results}).toEqual({
+      schemaReads: readsAtRegistration,
+      results: Array.from({length: 10}, () => ({result: '{"location":"Berlin"}'})),
+    });
+  });
+
+  // spec: specs/hal-engine-tool-input-validation/spec.md#3
+  it('uses the current dynamic schema and caches each resolved schema object', async () => {
+    const registry = new ToolRegistry();
+    const calls: Record<string, unknown>[] = [];
+    let current = locationSchema();
+    let schemaReads = 0;
+    const numericSchema = {
+      type: 'object',
+      get properties() {
+        schemaReads += 1;
+        return {location: {type: 'number'}};
+      },
+      required: ['location'],
+    };
+    registry.register(
+      () => weather(current),
+      async input => {
+        calls.push(structuredClone(input));
+        return JSON.stringify(input);
+      }
+    );
+    await registry.execute('weather', {location: 'Berlin'});
+    current = numericSchema;
+    const rejected = await registry.execute('weather', {location: 'Berlin'});
+    expect({rejected, calls}).toEqual({
+      rejected: {result: expect.stringMatching(/number/i)},
+      calls: [{location: 'Berlin'}],
+    });
+    expect(rejected.result).toContain('location');
+    const readsAfterCompilation = schemaReads;
+    expect(readsAfterCompilation).toBeGreaterThan(0);
+    await registry.execute('weather', {location: 52});
+    expect(schemaReads).toBe(readsAfterCompilation);
+    current = locationSchema();
+    const nextRejection = await registry.execute('weather', {location: 52});
+    expect(nextRejection.result).toMatch(/string/i);
+    expect(calls).toEqual([{location: 'Berlin'}, {location: 52}]);
+  });
+});