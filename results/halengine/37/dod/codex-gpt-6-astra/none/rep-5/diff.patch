+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,167 @@
+import {Console} from 'node:console';
+import {Writable} from 'node:stream';
+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const definition = (inputSchema: Record<string, unknown>): ToolDefinition => ({
+  name: 'weather',
+  description: 'Weather at a location',
+  inputSchema,
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#1
+it('rejects malformed tool input privately and passes accepted input through unchanged', async () => {
+  const lines: string[] = [];
+  const output = new Writable({
+    write(chunk: Buffer, _encoding, callback) {
+      lines.push(chunk.toString());
+      callback();
+    },
+  });
+  setLogger(new Console({stdout: output, stderr: output}));
+  try {
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+    registry.register(
+      definition({
+        type: 'object',
+        required: ['location'],
+        properties: {
+          location: {type: 'string'},
+          units: {type: 'string', enum: ['metric', 'imperial']},
+          days: {type: 'number', default: 1},
+        },
+      }),
+      async input => {
+        received.push(structuredClone(input));
+        return JSON.stringify(input);
+      }
+    );
+    const cases = [
+      {input: {}, path: 'location', constraint: /required/i},
+      {input: {location: 86753091234}, path: 'location', constraint: /string/i},
+      {input: {location: 'private-home-42', units: 'private-unit-42'}, path: 'units', constraint: /enum|allowed/i},
+      {input: {location: 'private-home-42', days: 'private-days-42'}, path: 'days', constraint: /number/i},
+    ];
+    const rejected = [];
+    for (const {input, path, constraint} of cases) {
+      const start = lines.length;
+      const response = await registry.execute('weather', input);
+      rejected.push({
+        result: response.result,
+        path,
+        constraint,
+        logs: lines.slice(start).join(''),
+      });
+    }
+    const callsAfterRejections = received.length;
+    const valid = {location: 'Berlin', units: 'metric', extra: {postalCode: '00123'}};
+    const accepted = await registry.execute('weather', valid);
+    const unknown = await registry.execute('missing', {}).catch((error: Error) => error.message);
+    expect({callsAfterRejections, received, accepted, valid, unknown, rejected}).toEqual({
+      callsAfterRejections: 0,
+      received: [{location: 'Berlin', units: 'metric', extra: {postalCode: '00123'}}],
+      accepted: {result: JSON.stringify(valid)},
+      valid: {location: 'Berlin', units: 'metric', extra: {postalCode: '00123'}},
+      unknown: 'Unknown tool: missing',
+      rejected: cases.map(({path, constraint}) => ({
+        result: expect.stringMatching(new RegExp(`(?=.*${path})(?=.*${constraint.source})`, 'i')),
+        path,
+        constraint,
+        logs: expect.stringMatching(new RegExp(`(?=.*${path})(?=.*${constraint.source})`, 'is')),
+      })),
+    });
+    expect(JSON.stringify(rejected)).not.toMatch(/86753091234|private-home-42|private-unit-42|private-days-42/);
+  } finally {
+    setLogger();
+    output.end();
+  }
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#2
+it('compiles static schemas at registration and reuses them across ten executions', async () => {
+  const registry = new ToolRegistry();
+  const received: Record<string, unknown>[] = [];
+  const execute = async (input: Record<string, unknown>) => {
+    received.push(input);
+    return 'forecast';
+  };
+  let registrationError: unknown;
+  try {
+    registry.register(definition({type: 'object', properties: {location: {type: 'not-a-json-schema-type'}}}), execute);
+  } catch (error) {
+    registrationError = error;
+  }
+  let schemaReads = 0;
+  const schema = {
+    type: 'object',
+    required: ['location'],
+    get properties() {
+      schemaReads++;
+      return {location: {type: 'string'}};
+    },
+  };
+  registry.register(definition(schema), execute);
+  const readsAtRegistration = schemaReads;
+  for (let index = 0; index < 10; index++) await registry.execute('weather', {location: 'Berlin'});
+  expect({
+    registrationError,
+    compiledAtRegistration: readsAtRegistration > 0,
+    rereads: schemaReads - readsAtRegistration,
+    calls: received.length,
+  }).toEqual({
+    registrationError: expect.objectContaining({message: expect.stringContaining('weather')}),
+    compiledAtRegistration: true,
+    rereads: 0,
+    calls: 10,
+  });
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#3
+it('validates each dynamic definition and caches only by resolved schema identity', async () => {
+  const registry = new ToolRegistry();
+  const received: Record<string, unknown>[] = [];
+  const reads = [0, 0];
+  const schemas = ['metric', 'imperial'].map((units, index) => ({
+    type: 'object',
+    required: ['units'],
+    get properties() {
+      reads[index]++;
+      return {units: {type: 'string', enum: [units]}};
+    },
+  }));
+  let current = 0;
+  let resolutions = 0;
+  registry.register(
+    () => {
+      resolutions++;
+      return definition(schemas[current]);
+    },
+    async input => {
+      received.push(input);
+      return JSON.stringify(input);
+    }
+  );
+  const beforeCalls = resolutions;
+  await registry.execute('weather', {units: 'metric'});
+  current = 1;
+  const rejected = await registry.execute('weather', {units: 'metric'});
+  await registry.execute('weather', {units: 'imperial'});
+  const beforeReuse = [...reads];
+  current = 0;
+  await registry.execute('weather', {units: 'metric'});
+  expect({
+    received,
+    rejected: rejected.result,
+    resolutions: resolutions - beforeCalls,
+    compiled: reads.map(count => count > 0),
+    rereads: reads.map((count, index) => count - beforeReuse[index]),
+  }).toEqual({
+    received: [{units: 'metric'}, {units: 'imperial'}, {units: 'metric'}],
+    rejected: expect.stringMatching(/(?=.*units)(?=.*enum|.*allowed)/i),
+    resolutions: 4,
+    compiled: [true, true],
+    rereads: [0, 0],
+  });
+});