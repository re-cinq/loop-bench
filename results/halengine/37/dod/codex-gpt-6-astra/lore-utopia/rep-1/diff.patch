index 0000000..bd7e6b6
--- /dev/null
+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,148 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+import {setLogger} from '../../shared/logger.js';
+
+const weatherSchema = {
+  type: 'object',
+  properties: {
+    location: {type: 'string'},
+    units: {type: 'string', enum: ['metric', 'imperial'], default: 'metric'},
+  },
+  required: ['location'],
+};
+
+function definition(inputSchema: Record<string, unknown>): ToolDefinition {
+  return {name: 'weather', description: 'Report the weather', inputSchema};
+}
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#1
+it('rejects malformed input privately and passes accepted input through unchanged', async () => {
+  const registry = new ToolRegistry();
+  const received: Record<string, unknown>[] = [];
+  const logs: string[] = [];
+  const record = (category: string, message: string, fields?: Record<string, unknown>): void => {
+    logs.push(JSON.stringify({category, message, fields}));
+  };
+  setLogger({debug: record, info: record, warn: record, error: record});
+  try {
+    registry.register(definition(weatherSchema), async input => {
+      received.push(structuredClone(input));
+      return JSON.stringify(input);
+    });
+    const missing = await registry.execute('weather', {});
+    const wrongType = await registry.execute('weather', {location: 987654321});
+    const wrongEnum = await registry.execute('weather', {location: 'Private Address 729', units: 'secret-unit-729'});
+    const rejectedCalls = received.length;
+    const rejectionLogs = logs.join('\n');
+    const accepted = {location: 'Berlin', extra: {customer: 'kept'}};
+    const valid = await registry.execute('weather', accepted);
+    const unknown = await registry.execute('absent', {}).catch((error: Error) => error.message);
+
+    expect({missing, wrongType, wrongEnum, rejectedCalls}).toEqual({
+      missing: {result: expect.stringMatching(/(?=[\s\S]*location)(?=[\s\S]*required)/i)},
+      wrongType: {result: expect.stringMatching(/(?=[\s\S]*location)(?=[\s\S]*string)/i)},
+      wrongEnum: {result: expect.stringMatching(/(?=[\s\S]*units)(?=[\s\S]*(?:enum|allowed))/i)},
+      rejectedCalls: 0,
+    });
+    expect(JSON.stringify({missing, wrongType, wrongEnum, rejectionLogs})).not.toMatch(
+      /987654321|Private Address 729|secret-unit-729/
+    );
+    expect(rejectionLogs).toMatch(/location/);
+    expect(rejectionLogs).toMatch(/required/i);
+    expect(rejectionLogs).toMatch(/string/i);
+    expect(rejectionLogs).toMatch(/units/);
+    expect(rejectionLogs).toMatch(/enum|allowed/i);
+    expect({received, valid, accepted, unknown}).toEqual({
+      received: [{location: 'Berlin', extra: {customer: 'kept'}}],
+      valid: {result: JSON.stringify({location: 'Berlin', extra: {customer: 'kept'}})},
+      accepted: {location: 'Berlin', extra: {customer: 'kept'}},
+      unknown: 'Unknown tool: absent',
+    });
+  } finally {
+    setLogger();
+  }
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#2
+it('compiles static schemas at registration and reuses them for ten executions', async () => {
+  const registry = new ToolRegistry();
+  let schemaReads = 0;
+  const schema = {
+    ...weatherSchema,
+    get properties() {
+      schemaReads++;
+      return weatherSchema.properties;
+    },
+  };
+  registry.register(definition(schema), async input => JSON.stringify(input));
+  const readsAtRegistration = schemaReads;
+  for (let call = 0; call < 10; call++) {
+    await registry.execute('weather', {location: 'Berlin'});
+  }
+  let registrationError = '';
+  try {
+    registry.register(
+      definition({type: 'object', properties: {location: {type: 'invalid-json-schema-type'}}}),
+      async input => JSON.stringify(input)
+    );
+  } catch (error) {
+    registrationError = error instanceof Error ? error.message : String(error);
+  }
+  expect({
+    compiledAtRegistration: readsAtRegistration > 0,
+    reused: schemaReads === readsAtRegistration,
+    registrationError,
+  }).toEqual({compiledAtRegistration: true, reused: true, registrationError: expect.stringMatching(/weather/)});
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#3
+it('validates dynamic definitions against the current schema and caches each schema object', async () => {
+  const registry = new ToolRegistry();
+  let schemaReads = 0;
+  const numericSchema = {
+    type: 'object',
+    get properties() {
+      schemaReads++;
+      return {location: {type: 'number'}};
+    },
+    required: ['location'],
+  };
+  let current: Record<string, unknown> = weatherSchema;
+  const received: Record<string, unknown>[] = [];
+  registry.register(
+    () => definition(current),
+    async input => {
+      received.push(structuredClone(input));
+      return JSON.stringify(input);
+    }
+  );
+  const first = await registry.execute('weather', {location: 'Berlin'});
+  current = numericSchema;
+  const rejection = await registry.execute('weather', {location: 'Private Address 729'});
+  const readsAfterFirstUse = schemaReads;
+  const second = await registry.execute('weather', {location: 42});
+  current = weatherSchema;
+  const third = await registry.execute('weather', {location: 'Paris'});
+  current = numericSchema;
+  const fourth = await registry.execute('weather', {location: 43});
+  expect({
+    first,
+    rejection,
+    second,
+    third,
+    fourth,
+    received,
+    compiled: readsAfterFirstUse > 0,
+    cached: schemaReads === readsAfterFirstUse,
+  }).toEqual({
+    first: {result: '{"location":"Berlin"}'},
+    rejection: {result: expect.stringMatching(/(?=[\s\S]*location)(?=[\s\S]*number)/i)},
+    second: {result: '{"location":42}'},
+    third: {result: '{"location":"Paris"}'},
+    fourth: {result: '{"location":43}'},
+    received: [{location: 'Berlin'}, {location: 42}, {location: 'Paris'}, {location: 43}],
+    compiled: true,
+    cached: true,
+  });
+  expect(rejection.result).not.toContain('Private Address 729');
+});