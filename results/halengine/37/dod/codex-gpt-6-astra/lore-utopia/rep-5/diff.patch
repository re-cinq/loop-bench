index 0000000..e8bb737
--- /dev/null
+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,173 @@
+import {Console} from 'node:console';
+import {Writable} from 'node:stream';
+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const definition = (inputSchema: Record<string, unknown>): ToolDefinition => ({
+  name: 'weather',
+  description: 'Report weather at a location',
+  inputSchema,
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#1
+it('rejects malformed calls privately and accepts corrected input unchanged', async () => {
+  let logs = '';
+  const output = new Writable({
+    write(chunk: Buffer, _encoding, done) {
+      logs += chunk.toString();
+      done();
+    },
+  });
+  setLogger(new Console({stdout: output, stderr: output}));
+  try {
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+    registry.register(
+      definition({
+        type: 'object',
+        properties: {
+          location: {type: 'string'},
+          units: {type: 'string', enum: ['C', 'F'], default: 'C'},
+        },
+        required: ['location'],
+      }),
+      async input => {
+        received.push(structuredClone(input));
+        return JSON.stringify(input);
+      }
+    );
+    const missing = await registry.execute('weather', {});
+    const wrongType = await registry.execute('weather', {location: 918273645});
+    const wrongEnum = await registry.execute('weather', {location: 'private-home-827', units: 'private-unit-827'});
+    const rejectedCalls = received.splice(0);
+    const rejectionLogs = logs;
+    const input = {location: 'Berlin', extra: {retained: true}};
+    const accepted = await registry.execute('weather', input);
+    const unknown = await registry.execute('absent', {}).catch((error: Error) => error.message);
+
+    expect({
+      missing: missing.result,
+      wrongType: wrongType.result,
+      wrongEnum: wrongEnum.result,
+      rejectedCalls,
+      received,
+      accepted,
+      input,
+      unknown,
+      leaks: [missing.result, wrongType.result, wrongEnum.result, rejectionLogs].some(text =>
+        /918273645|private-home-827|private-unit-827/.test(text)
+      ),
+      logNamesConstraint:
+        /location/.test(rejectionLogs) && /required/.test(rejectionLogs) && /units/.test(rejectionLogs),
+    }).toEqual({
+      missing: expect.stringMatching(/(?=.*location)(?=.*required)/i),
+      wrongType: expect.stringMatching(/(?=.*location)(?=.*string)/i),
+      wrongEnum: expect.stringMatching(/(?=.*units)(?=.*enum|.*allowed)/i),
+      rejectedCalls: [],
+      received: [{location: 'Berlin', extra: {retained: true}}],
+      accepted: {result: JSON.stringify({location: 'Berlin', extra: {retained: true}})},
+      input: {location: 'Berlin', extra: {retained: true}},
+      unknown: 'Unknown tool: absent',
+      leaks: false,
+      logNamesConstraint: true,
+    });
+  } finally {
+    setLogger();
+    output.end();
+  }
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#2
+it('compiles static schemas at registration and reuses them for ten calls', async () => {
+  const registry = new ToolRegistry();
+  let registrationError = '';
+  try {
+    registry.register(definition({type: 'not-a-json-schema-type'}), async input => JSON.stringify(input));
+  } catch (error) {
+    registrationError = error instanceof Error ? error.message : String(error);
+  }
+  let schemaReads = 0;
+  const schema = {
+    type: 'object',
+    properties: {location: {type: 'string'}},
+    get required() {
+      schemaReads++;
+      return ['location'];
+    },
+  };
+  registry.register(definition(schema), async input => JSON.stringify(input));
+  const readsAtRegistration = schemaReads;
+  const results = [];
+  for (let index = 0; index < 10; index++) {
+    results.push(await registry.execute('weather', {location: 'Berlin'}));
+  }
+
+  expect({
+    registrationError,
+    compiledAtRegistration: readsAtRegistration > 0,
+    rereads: schemaReads - readsAtRegistration,
+    results,
+  }).toEqual({
+    registrationError: expect.stringContaining('weather'),
+    compiledAtRegistration: true,
+    rereads: 0,
+    results: Array.from({length: 10}, () => ({result: '{"location":"Berlin"}'})),
+  });
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#3
+it('validates each dynamic schema and reuses previously resolved schema objects', async () => {
+  const registry = new ToolRegistry();
+  let schemaReads = 0;
+  const firstSchema = {
+    type: 'object',
+    properties: {location: {type: 'string', enum: ['Berlin']}},
+    get required() {
+      schemaReads++;
+      return ['location'];
+    },
+  };
+  const secondSchema = {
+    type: 'object',
+    properties: {location: {type: 'string', enum: ['Paris']}},
+    required: ['location'],
+  };
+  let currentSchema: Record<string, unknown> = firstSchema;
+  const received: Record<string, unknown>[] = [];
+  registry.register(
+    () => definition(currentSchema),
+    async input => {
+      received.push(structuredClone(input));
+      return JSON.stringify(input);
+    }
+  );
+  const first = await registry.execute('weather', {location: 'Berlin'});
+  const readsAfterFirst = schemaReads;
+  currentSchema = secondSchema;
+  const stale = await registry.execute('weather', {location: 'Berlin'});
+  const second = await registry.execute('weather', {location: 'Paris'});
+  currentSchema = firstSchema;
+  const staleAgain = await registry.execute('weather', {location: 'Paris'});
+  const firstAgain = await registry.execute('weather', {location: 'Berlin'});
+
+  expect({
+    first,
+    second,
+    firstAgain,
+    stale: stale.result,
+    staleAgain: staleAgain.result,
+    received,
+    compiled: readsAfterFirst > 0,
+    rereads: schemaReads - readsAfterFirst,
+  }).toEqual({
+    first: {result: '{"location":"Berlin"}'},
+    second: {result: '{"location":"Paris"}'},
+    firstAgain: {result: '{"location":"Berlin"}'},
+    stale: expect.stringMatching(/(?=.*location)(?=.*enum|.*allowed)/i),
+    staleAgain: expect.stringMatching(/(?=.*location)(?=.*enum|.*allowed)/i),
+    received: [{location: 'Berlin'}, {location: 'Paris'}, {location: 'Berlin'}],
+    compiled: true,
+    rereads: 0,
+  });
+});