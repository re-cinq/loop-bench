+import {ToolRegistry} from './registry.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+import type {AIProvider, MessageChunk, SendMessageParams, ToolDefinition} from '../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+
+// The schema every test here validates against: a location the model is required to send as a string.
+const LOCATION_SCHEMA = {type: 'object', properties: {location: {type: 'string'}}, required: ['location']};
+
+const weatherTool = (): ToolDefinition => ({
+  name: 'weather',
+  description: 'current weather for a place',
+  inputSchema: LOCATION_SCHEMA,
+});
+
+// The shipped weather tool's careful executor (example/weather-tool.ts): cast, default, answer anyway.
+const forecastFor = (input: Record<string, unknown>): string =>
+  `22°C and clear in ${(input.location as string) || 'Unknown'}`;
+
+// Collects every line the engine logs while swapped in, so a test can assert what did not reach the log.
+const recordingLogger = (): {lines: string[]; logger: Logger} => {
+  const lines: string[] = [];
+  const collect = (category: string, message: string, fields?: Record<string, unknown>): void => {
+    lines.push(JSON.stringify({category, message, fields}));
+  };
+  return {lines, logger: {debug: collect, info: collect, warn: collect, error: collect}};
+};
+
+// A test reads the outcome as a value: the text the stream resolved to, or the message it rejected with.
+const outcomeOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(value => String(value)).catch((error: Error) => error.message);
+
+const createSession = (content: string): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content, timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+// One scripted round per sendMessage call, recording each request so the test can read what the provider was fed.
+const recordingScriptedProvider = (rounds: MessageChunk[][]): {provider: AIProvider; requests: SendMessageParams[]} => {
+  const requests: SendMessageParams[] = [];
+  let round = 0;
+  const provider: AIProvider = {
+    async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      requests.push(params);
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  return {provider, requests};
+};
+
+const CALL_WEATHER_WITHOUT_LOCATION: MessageChunk = {
+  type: 'tool_use',
+  toolCall: {id: 'call-1', name: 'weather', input: {}},
+};
+const CALL_WEATHER_CORRECTED: MessageChunk = {
+  type: 'tool_use',
+  toolCall: {id: 'call-2', name: 'weather', input: {location: 'Paris', units: 'metric'}},
+};
+const STOP_FOR_TOOL: MessageChunk = {type: 'stop', stopReason: 'tool_use'};
+const STOP_DONE: MessageChunk = {type: 'stop', stopReason: 'end_turn'};
+
+describe('ToolRegistry input validation', () => {
+  it('returns a rejection to the model and never runs the executor when a required property is missing, while an unknown tool name still throws', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(weatherTool(), async input => {
+      executorCalls += 1;
+      return forecastFor(input);
+    });
+
+    const rejection = await registry.execute('weather', {});
+    let unknownToolError = '';
+    try {
+      await registry.execute('horoscope', {});
+    } catch (error) {
+      unknownToolError = error instanceof Error ? error.message : String(error);
+    }
+
+    expect({
+      executorCalls,
+      namesProperty: rejection.result.includes('location'),
+      namesRequired: rejection.result.includes('required'),
+      unknownToolError,
+    }).toEqual({
+      executorCalls: 0,
+      namesProperty: true,
+      namesRequired: true,
+      unknownToolError: 'Unknown tool: horoscope',
+    });
+  });
+
+  it('rejects a wrong-typed field naming the path and expected type, and emits the offending value neither in the result nor the log', async () => {
+    const {lines, logger} = recordingLogger();
+    setLogger(logger);
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(weatherTool(), async input => {
+      executorCalls += 1;
+      return forecastFor(input);
+    });
+
+    const rejection = await registry.execute('weather', {location: 48812});
+    setLogger();
+
+    expect({
+      executorCalls,
+      namesPath: rejection.result.includes('location'),
+      namesExpectedType: rejection.result.includes('string'),
+      valueInResult: rejection.result.includes('48812'),
+      valueInLog: lines.some(line => line.includes('48812')),
+    }).toEqual({
+      executorCalls: 0,
+      namesPath: true,
+      namesExpectedType: true,
+      valueInResult: false,
+      valueInLog: false,
+    });
+  });
+
+  it('throws at registration for a schema no validator can compile, naming the tool', () => {
+    const registry = new ToolRegistry();
+    const brokenSchema = {type: 'object', properties: {location: {type: 'strng'}}};
+    let thrownMessage = '';
+    try {
+      registry.register(
+        {name: 'weather', description: 'current weather for a place', inputSchema: brokenSchema},
+        async () => 'ok'
+      );
+    } catch (error) {
+      thrownMessage = error instanceof Error ? error.message : String(error);
+    }
+
+    expect({rejectedAtRegistration: thrownMessage !== '', messageNamesTool: thrownMessage.includes('weather')}).toEqual(
+      {
+        rejectedAtRegistration: true,
+        messageNamesTool: true,
+      }
+    );
+  });
+
+  it('validates a function-valued definition against the schema current at each call, enum included', async () => {
+    const registry = new ToolRegistry();
+    let inputSchema: Record<string, unknown> = LOCATION_SCHEMA;
+    let executorCalls = 0;
+    registry.register(
+      () => ({name: 'weather', description: 'current weather for a place', inputSchema}),
+      async () => {
+        executorCalls += 1;
+        return 'ok';
+      }
+    );
+
+    const first = await registry.execute('weather', {location: 'Paris'});
+    inputSchema = {
+      type: 'object',
+      properties: {location: {type: 'string', enum: ['Paris', 'Rome']}},
+      required: ['location'],
+    };
+    const second = await registry.execute('weather', {location: 'Madrid'});
+
+    expect({
+      firstRanExecutor: first.result === 'ok',
+      executorCalls,
+      secondNamesProperty: second.result.includes('location'),
+    }).toEqual({
+      firstRanExecutor: true,
+      executorCalls: 1,
+      secondNamesProperty: true,
+    });
+  });
+
+  it('feeds a rejected call back to the model so a corrected retry succeeds, passing accepted input through unchanged', async () => {
+    const registry = new ToolRegistry();
+    const executorInputs: Record<string, unknown>[] = [];
+    registry.register(weatherTool(), async input => {
+      executorInputs.push(input);
+      if (typeof input.location !== 'string') throw new Error('weather needs a location');
+      return forecastFor(input);
+    });
+    const {provider, requests} = recordingScriptedProvider([
+      [CALL_WEATHER_WITHOUT_LOCATION, STOP_FOR_TOOL],
+      [CALL_WEATHER_CORRECTED, STOP_FOR_TOOL],
+      [{type: 'text', text: 'Paris is 22°C and clear.'}, STOP_DONE],
+    ]);
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+
+    const outcome = await outcomeOf(orchestrator.processMessage(createSession('what is the weather in Paris?')));
+
+    let retryResultText = '';
+    const lastMessage = requests[1]?.messages[requests[1].messages.length - 1];
+    if (lastMessage?.role === 'user') {
+      retryResultText = lastMessage.content.map(part => part.content).join(' ');
+    }
+
+    expect({
+      outcome,
+      executorInputs,
+      retryNamedRequiredLocation: retryResultText.includes('location') && /requir/i.test(retryResultText),
+    }).toEqual({
+      outcome: 'Paris is 22°C and clear.',
+      executorInputs: [{location: 'Paris', units: 'metric'}],
+      retryNamedRequiredLocation: true,
+    });
+  });
+});