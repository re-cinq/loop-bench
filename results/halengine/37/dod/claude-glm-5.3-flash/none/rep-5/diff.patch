+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, Message, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {sessionId: 's1', userId: 'u1', entries: [{role: 'user', content, timestamp: SENT_AT}]};
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator tool loop with input validation', () => {
+  it('returns a schema rejection to the model as a tool result it can read and correct on the next round', async () => {
+    let round = 0;
+    let roundTwoMessages: Message[] = [];
+    const executorInputs: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'weather',
+        description: 'get weather',
+        inputSchema: {type: 'object', required: ['location'], properties: {location: {type: 'string'}}},
+      },
+      async input => {
+        executorInputs.push(input);
+        return 'sunny in London';
+      }
+    );
+    // Round 1 calls the tool wrong, round 2 retries after reading the rejection, round 3 answers.
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        round += 1;
+        if (round === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'call-1', name: 'weather', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+        } else if (round === 2) {
+          // Copied: the orchestrator keeps mutating this array, and a later round must not be seen here.
+          roundTwoMessages = [...params.messages];
+          yield {type: 'tool_use', toolCall: {id: 'call-2', name: 'weather', input: {location: 'London'}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+        } else {
+          yield {type: 'text', text: 'it is sunny in London'};
+          yield {type: 'stop', stopReason: 'end_turn'};
+        }
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const text = await createChatOrchestrator(provider, promptBuilder, registry).processMessage(
+      createSession('what is the weather?')
+    );
+
+    expect({
+      text,
+      executorInputs,
+      rejectionReachedProvider: roundTwoMessages.some(message => JSON.stringify(message).includes('location')),
+    }).toEqual({
+      text: 'it is sunny in London',
+      executorInputs: [{location: 'London'}],
+      rejectionReachedProvider: true,
+    });
+  });
+});
