@@ -0,0 +1,164 @@
+import {ToolRegistry} from './registry.js';
+import type {Logger} from '../../shared/logger.js';
+import {setLogger} from '../../shared/logger.js';
+
+const capturingLogger = (lines: string[]): Logger => ({
+  debug: (_category, message, fields) => void lines.push(JSON.stringify({message, fields})),
+  info: (_category, message, fields) => void lines.push(JSON.stringify({message, fields})),
+  warn: (_category, message, fields) => void lines.push(JSON.stringify({message, fields})),
+  error: (_category, message, fields) => void lines.push(JSON.stringify({message, fields})),
+});
+
+afterEach(() => setLogger(undefined));
+
+describe('ToolRegistry input validation', () => {
+  it('returns a rejection naming location as required and never calls the executor when required input is missing', async () => {
+    let executorCalls = 0;
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'weather',
+        description: 'get weather',
+        inputSchema: {type: 'object', required: ['location'], properties: {location: {type: 'string'}}},
+      },
+      async () => {
+        executorCalls += 1;
+        return 'sunny';
+      }
+    );
+
+    const response = await registry.execute('weather', {});
+
+    expect({
+      namesField: /location/.test(response.result),
+      namesRequired: /required/.test(response.result),
+      executorCalls,
+    }).toEqual({namesField: true, namesRequired: true, executorCalls: 0});
+  });
+
+  it('passes valid input with an unlisted extra property through to the executor unchanged, exactly once', async () => {
+    const received: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'echo',
+        description: 'echoes input',
+        inputSchema: {type: 'object', required: ['city'], properties: {city: {type: 'string'}}},
+      },
+      async input => {
+        received.push(input);
+        return 'ok';
+      }
+    );
+
+    const response = await registry.execute('echo', {city: 'NYC', extra: 'noise'});
+
+    expect({result: response.result, received}).toEqual({result: 'ok', received: [{city: 'NYC', extra: 'noise'}]});
+  });
+
+  it('rejects a number where a string is required, naming the field path and expected type but never the value', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'notify',
+        description: 'sends a notification',
+        inputSchema: {type: 'object', required: ['email'], properties: {email: {type: 'string'}}},
+      },
+      async () => 'sent'
+    );
+
+    const response = await registry.execute('notify', {email: 42});
+
+    expect({
+      namesPath: /email/.test(response.result),
+      namesType: /string/.test(response.result),
+      includesValue: /42/.test(response.result),
+    }).toEqual({namesPath: true, namesType: true, includesValue: false});
+  });
+
+  it('keeps an identifying input value out of the rejection text and every log line', async () => {
+    const lines: string[] = [];
+    setLogger(capturingLogger(lines));
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'lookup',
+        description: 'looks up records',
+        inputSchema: {type: 'object', required: ['id'], properties: {id: {type: 'string'}}},
+      },
+      async () => 'found'
+    );
+
+    const response = await registry.execute('lookup', {email: 'alice@example.com'});
+    const seen = [response.result, ...lines].join('\n');
+
+    expect({
+      namesField: /\bid\b/.test(response.result),
+      leaksValue: /alice@example\.com/.test(seen),
+    }).toEqual({namesField: true, leaksValue: false});
+  });
+
+  it('throws at register time for an uncompilable schema, naming the tool', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {name: 'broken', description: 'broken tool', inputSchema: {type: 'not-a-real-type'}},
+        async () => 'x'
+      )
+    ).toThrow(/broken/);
+  });
+
+  it('validates a function-valued definition against the schema current at that call, not a stale cached one', async () => {
+    let requireAlpha = true;
+    const registry = new ToolRegistry();
+    registry.register(
+      () => ({
+        name: 'versioned',
+        description: 'schema changes between calls',
+        inputSchema: requireAlpha
+          ? {type: 'object', required: ['alpha'], properties: {alpha: {type: 'string'}}}
+          : {type: 'object', required: ['beta'], properties: {beta: {type: 'string'}}},
+      }),
+      async () => 'ok'
+    );
+
+    const first = await registry.execute('versioned', {beta: 'x'});
+    requireAlpha = false;
+    const second = await registry.execute('versioned', {alpha: 'x'});
+
+    expect({firstRejects: /alpha/.test(first.result), secondRejects: /beta/.test(second.result)}).toEqual({
+      firstRejects: true,
+      secondRejects: true,
+    });
+  });
+
+  it('compiles a static schema once at register: ten execute calls keep validating against the register-time schema', async () => {
+    let executorCalls = 0;
+    const inputSchema: Record<string, unknown> = {
+      type: 'object',
+      required: ['location'],
+      properties: {location: {type: 'string'}},
+    };
+    const registry = new ToolRegistry();
+    registry.register({name: 'weather', description: 'get weather', inputSchema}, async () => {
+      executorCalls += 1;
+      return 'sunny';
+    });
+
+    for (let call = 0; call < 10; call += 1) await registry.execute('weather', {location: 'London'});
+    inputSchema.required = [];
+    const afterMutation = await registry.execute('weather', {});
+
+    expect({
+      executorCalls,
+      stillRejected: /location/.test(afterMutation.result),
+    }).toEqual({executorCalls: 10, stillRejected: true});
+  });
+
+  it('still throws Unknown tool for an unregistered name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('ghost', {})).rejects.toThrow('Unknown tool: ghost');
+  });
+});