@@ -0,0 +1,86 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {
+  AIProvider,
+  MessageChunk,
+  Message,
+  SendMessageParams,
+  ToolDefinition,
+  ToolResultMessage,
+} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const weatherTool = (): ToolDefinition => ({
+  name: 'get_weather',
+  description: 'weather for a location',
+  inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+});
+
+const createSession = (content: string): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content, timestamp: SENT_AT}],
+});
+
+// One scripted round per sendMessage call, snapshotting the messages each round received.
+const scriptedProvider = (rounds: MessageChunk[][]): {provider: AIProvider; messagesSeenPerRound: Message[][]} => {
+  const messagesSeenPerRound: Message[][] = [];
+  let round = 0;
+  return {
+    messagesSeenPerRound,
+    provider: {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        messagesSeenPerRound.push([...params.messages]);
+        for (const chunk of rounds[round++] ?? []) yield chunk;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    },
+  };
+};
+
+describe('Tool rejection in the orchestrator loop', () => {
+  it('returns a rejected tool call to the provider and resolves on the corrected retry', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(weatherTool(), async () => {
+      executorCalls++;
+      return 'sunny in Berlin';
+    });
+    const {provider, messagesSeenPerRound} = scriptedProvider([
+      [
+        {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Berlin'}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'text', text: 'It is sunny in Berlin'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ]);
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+
+    const text = await orchestrator.processMessage(createSession('weather in Berlin?'));
+
+    const resultsSeenOnSecondRound = messagesSeenPerRound[1]
+      .filter((message): message is ToolResultMessage => message.role === 'user' && Array.isArray(message.content))
+      .flatMap(message => message.content)
+      .map(result => result.content);
+
+    expect({text, executorCalls, resultsSeenOnSecondRound}).toEqual({
+      text: 'It is sunny in Berlin',
+      executorCalls: 1,
+      resultsSeenOnSecondRound: [expect.stringMatching(/required[\s\S]*location|location[\s\S]*required/)],
+    });
+  });
+});
