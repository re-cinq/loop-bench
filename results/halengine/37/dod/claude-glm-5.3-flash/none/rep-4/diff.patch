@@ -0,0 +1,188 @@
+import {jest} from '@jest/globals';
+import Ajv from 'ajv';
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+
+// The weather contract the shipped example declares: `location` required and a string.
+const weatherSchema = {type: 'object', properties: {location: {type: 'string'}}, required: ['location']};
+
+const weatherTool = (): ToolDefinition => ({
+  name: 'get_weather',
+  description: 'weather for a location',
+  inputSchema: weatherSchema,
+});
+
+// A canary value no honest validation message would ever carry; an executor that ran returns it.
+const CARD = '4111111111111111';
+
+const captureLog = (): string[] => {
+  const lines: string[] = [];
+  const logger: Logger = {
+    debug: (category, message, fields) => lines.push(JSON.stringify({category, message, fields})),
+    info: (category, message, fields) => lines.push(JSON.stringify({category, message, fields})),
+    warn: (category, message, fields) => lines.push(JSON.stringify({category, message, fields})),
+    error: (category, message, fields) => lines.push(JSON.stringify({category, message, fields})),
+  };
+  setLogger(logger);
+  return lines;
+};
+
+describe('ToolRegistry input validation', () => {
+  afterEach(() => setLogger());
+
+  it('rejects a call missing a required property and leaves the executor uninvoked', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(weatherTool(), async () => {
+      executorCalls++;
+      return 'sunny, 18 degrees';
+    });
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({result: response.result, executorCalls}).toEqual({
+      result: expect.stringMatching(/required[\s\S]*location|location[\s\S]*required/),
+      executorCalls: 0,
+    });
+  });
+
+  it('passes an unlisted extra property through to the executor unchanged and exactly once', async () => {
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+    registry.register(weatherTool(), async input => {
+      received.push(input);
+      return 'sunny, 18 degrees';
+    });
+
+    await registry.execute('get_weather', {location: 'Berlin', heatwave: 'mild'});
+
+    expect(received).toEqual([{location: 'Berlin', heatwave: 'mild'}]);
+  });
+
+  it('rejects a wrong-typed field naming the path and expected type, carrying no value', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(weatherTool(), async () => {
+      executorCalls++;
+      return 'sunny, 18 degrees';
+    });
+
+    const response = await registry.execute('get_weather', {location: 4242});
+
+    expect({result: response.result, executorCalls, valueInMessage: response.result.includes('4242')}).toEqual({
+      result: expect.stringMatching(/location[\s\S]*string|string[\s\S]*location/),
+      executorCalls: 0,
+      valueInMessage: false,
+    });
+  });
+
+  it('rejects a value violating a declared enum and names the property', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'weather for a location',
+        inputSchema: {type: 'object', properties: {units: {type: 'string', enum: ['celsius', 'fahrenheit']}}},
+      },
+      async () => {
+        executorCalls++;
+        return 'sunny, 18 degrees';
+      }
+    );
+
+    const response = await registry.execute('get_weather', {units: 'kelvin'});
+
+    expect({result: response.result, executorCalls}).toEqual({
+      result: expect.stringContaining('units'),
+      executorCalls: 0,
+    });
+  });
+
+  it('rejects input without naming the offending value in the result or any log line', async () => {
+    const lines = captureLog();
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}, card: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async () => `approved card ${CARD}`
+    );
+
+    const response = await registry.execute('get_weather', {location: 'Berlin', card: Number(CARD)});
+
+    expect({result: response.result, logged: lines.join('\n')}).toEqual({
+      result: expect.not.stringContaining(CARD),
+      logged: expect.not.stringContaining(CARD),
+    });
+  });
+
+  it('compiles a static schema once across ten execute calls', async () => {
+    const registry = new ToolRegistry();
+    const AjvWithPrototype = Ajv as unknown as {prototype: {compile: (schema: unknown) => unknown}};
+    const compileSpy = jest.spyOn(AjvWithPrototype.prototype, 'compile');
+    registry.register(weatherTool(), async () => 'sunny, 18 degrees');
+
+    const compilationsAtRegister = compileSpy.mock.calls.length;
+    for (let round = 0; round < 10; round++) await registry.execute('get_weather', {location: 'Berlin'});
+
+    expect({compilationsAtRegister, totalCompilations: compileSpy.mock.calls.length}).toEqual({
+      compilationsAtRegister: 1,
+      totalCompilations: 1,
+    });
+  });
+
+  it('throws at register naming the tool when the schema cannot compile', () => {
+    const registry = new ToolRegistry();
+    const brokenTool: ToolDefinition = {
+      name: 'broken_tool',
+      description: 'declares a type no JSON Schema validator knows',
+      inputSchema: {type: 'object', properties: {when: {type: 'instant'}}},
+    };
+
+    expect(() => registry.register(brokenTool, async () => 'ok')).toThrow(/broken_tool/);
+  });
+
+  it('validates a function-valued definition against the schema current at each call', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    let wantNumber = false;
+    registry.register(
+      () => ({
+        name: 'shifting_tool',
+        description: 'schema shifts between calls',
+        inputSchema: wantNumber
+          ? {type: 'object', properties: {location: {type: 'number'}}, required: ['location']}
+          : weatherSchema,
+      }),
+      async () => {
+        executorCalls++;
+        return 'sunny, 18 degrees';
+      }
+    );
+
+    const first = await registry.execute('shifting_tool', {location: 'Berlin'});
+    wantNumber = true;
+    const second = await registry.execute('shifting_tool', {location: 'Berlin'});
+
+    expect({first, second, executorCalls}).toEqual({
+      first: {result: 'sunny, 18 degrees'},
+      second: {result: expect.stringContaining('number')},
+      executorCalls: 1,
+    });
+  });
+
+  it('throws an Unknown tool error for an unregistered name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('ghost_tool', {})).rejects.toThrow('Unknown tool: ghost_tool');
+  });
+});