+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,225 @@
+// Acceptance contract for issue #37: ToolRegistry validates input against the registered inputSchema.
+import type {
+  AIProvider,
+  Message,
+  MessageChunk,
+  SendMessageParams,
+  ToolCall,
+  ToolDefinition,
+  ToolResultContent,
+  ToolResponse,
+} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {ToolRegistry} from './registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const locationRequiredSchema: Record<string, unknown> = {
+  type: 'object',
+  properties: {location: {type: 'string'}},
+  required: ['location'],
+};
+
+const promptBuilder = new PromptBuilder({identity: 'You are an acceptance-test assistant.'});
+
+const registryForWeather = (
+  inputSchema: Record<string, unknown>
+): {registry: ToolRegistry; receivedInputs: Record<string, unknown>[]} => {
+  const receivedInputs: Record<string, unknown>[] = [];
+  const registry = new ToolRegistry();
+  registry.register({name: 'get_weather', description: 'weather by location', inputSchema}, async input => {
+    receivedInputs.push(input);
+    return '18C and partly cloudy';
+  });
+  return {registry, receivedInputs};
+};
+
+const captureLogLines = (captured: string[]): Logger => {
+  const record =
+    (severity: string) =>
+    (category: string, message: string, fields?: Record<string, unknown>): void => {
+      captured.push(JSON.stringify({severity, category, message, fields}));
+    };
+  return {debug: record('debug'), info: record('info'), warn: record('warn'), error: record('error')};
+};
+
+const toolResultTexts = (messages: Message[]): string[] => {
+  const parts = messages.flatMap(message => (Array.isArray(message.content) ? message.content : []));
+  return parts.filter((part): part is ToolResultContent => part.type === 'tool_result').map(part => part.content);
+};
+
+describe('ToolRegistry input validation (acceptance)', () => {
+  it('rejects input missing a required property, names the requirement, and never calls the executor', async () => {
+    const weather = registryForWeather(locationRequiredSchema);
+    const rejection = await weather.registry.execute('get_weather', {});
+
+    expect({
+      executorCalls: weather.receivedInputs.length,
+      namesProperty: rejection.result,
+      namesRequirement: rejection.result,
+    }).toEqual({
+      executorCalls: 0,
+      namesProperty: expect.stringContaining('location'),
+      namesRequirement: expect.stringContaining('required'),
+    });
+  });
+
+  it('passes input the schema accepts through to the executor unchanged, extra properties included, exactly once', async () => {
+    const weather = registryForWeather(locationRequiredSchema);
+    const sent = {location: 'Berlin', requestedUnits: 'metric', attempts: 2};
+
+    await weather.registry.execute('get_weather', sent);
+
+    expect({executorCalls: weather.receivedInputs.length, received: weather.receivedInputs[0]}).toEqual({
+      executorCalls: 1,
+      received: {location: 'Berlin', requestedUnits: 'metric', attempts: 2},
+    });
+  });
+
+  it('rejects a wrong-typed field by path and expected type, and carries no field value in the message or the logs', async () => {
+    const weather = registryForWeather(locationRequiredSchema);
+    const identifyingZip = '90210';
+    const rejectedInput = {location: 90210};
+    const capturedLogLines: string[] = [];
+    const registry = weather.registry;
+    setLogger(captureLogLines(capturedLogLines));
+    const rejection: ToolResponse = await registry.execute('get_weather', rejectedInput).finally(() => setLogger());
+
+    expect({
+      executorCalls: weather.receivedInputs.length,
+      namesProperty: rejection.result,
+      namesType: rejection.result,
+      valueInMessage: rejection.result.includes(identifyingZip),
+      logLinesCarryingValue: capturedLogLines.filter(line => line.includes(identifyingZip)).length,
+    }).toEqual({
+      executorCalls: 0,
+      namesProperty: expect.stringContaining('location'),
+      namesType: expect.stringContaining('string'),
+      valueInMessage: false,
+      logLinesCarryingValue: 0,
+    });
+  });
+
+  it('throws at register time for a schema the validator cannot compile, naming the tool', () => {
+    const registry = new ToolRegistry();
+    const brokenSchema = {type: 'object', properties: {location: {type: 'string'}}, required: 'location'};
+    const executor = async (): Promise<string> => 'never runs';
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'weather_with_broken_schema',
+          description: 'weather by location',
+          inputSchema: brokenSchema,
+        } as ToolDefinition,
+        executor
+      )
+    ).toThrow('weather_with_broken_schema');
+  });
+
+  it('validates a function-valued definition against the schema current at each call', async () => {
+    const receivedInputs: Record<string, unknown>[] = [];
+    let currentSchema: Record<string, unknown> = locationRequiredSchema;
+    const registry = new ToolRegistry();
+    registry.register(
+      (): ToolDefinition => ({name: 'get_weather', description: 'weather by location', inputSchema: currentSchema}),
+      async input => {
+        receivedInputs.push(input);
+        return '18C and partly cloudy';
+      }
+    );
+
+    await registry.execute('get_weather', {location: 'Berlin'});
+    currentSchema = {
+      type: 'object',
+      properties: {location: {type: 'string'}, bookingReference: {type: 'string'}},
+      required: ['location', 'bookingReference'],
+    };
+    const secondCall = await registry.execute('get_weather', {location: 'Berlin'});
+
+    expect({executorCalls: receivedInputs.length, secondCallResult: secondCall.result}).toEqual({
+      executorCalls: 1,
+      secondCallResult: expect.stringContaining('bookingReference'),
+    });
+  });
+
+  it('compiles a static tool schema once, at register time', async () => {
+    let schemaReads = 0;
+    const countedSchema = {
+      get type(): string {
+        schemaReads += 1;
+        return 'object';
+      },
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    const weather = registryForWeather(countedSchema);
+    const readsAtRegister = schemaReads;
+    for (let call = 0; call < 10; call++) {
+      await weather.registry.execute('get_weather', {location: 'Berlin'});
+    }
+
+    expect({compiledAtRegister: readsAtRegister > 0, schemaReadsDuringCalls: schemaReads - readsAtRegister}).toEqual({
+      compiledAtRegister: true,
+      schemaReadsDuringCalls: 0,
+    });
+  });
+
+  it('feeds a rejected tool call back to the provider as text the model can correct', async () => {
+    const weather = registryForWeather(locationRequiredSchema);
+    const toolCallsPerRound: ToolCall[] = [
+      {id: 'call-1', name: 'get_weather', input: {}},
+      {id: 'call-2', name: 'get_weather', input: {location: 'Berlin'}},
+    ];
+    const toolResultTextsPerRound: string[][] = [];
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        toolResultTextsPerRound.push(toolResultTexts(params.messages));
+        const toolCall: ToolCall | undefined = toolCallsPerRound[round++];
+        if (!toolCall) {
+          yield {type: 'text', text: 'the weather in Berlin is 18C'};
+          yield {type: 'stop', stopReason: 'end_turn'};
+          return;
+        }
+        yield {type: 'tool_use', toolCall};
+        yield {type: 'stop', stopReason: 'tool_use'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, weather.registry);
+    const session: ChatSession = {
+      sessionId: 'acceptance-session',
+      userId: 'user-1',
+      entries: [{role: 'user', content: 'what is the weather in Berlin?', timestamp: SENT_AT}],
+    };
+    const finalText = await orchestrator.processMessage(session);
+
+    expect({
+      finalText,
+      executorCalls: weather.receivedInputs.length,
+      rejectionVisibleOnRetryRound: (toolResultTextsPerRound[1] ?? []).some(text => text.includes('location')),
+    }).toEqual({
+      finalText: 'the weather in Berlin is 18C',
+      executorCalls: 2,
+      rejectionVisibleOnRetryRound: true,
+    });
+  });
+
+  it('still throws Unknown tool for an unregistered name', async () => {
+    const weather = registryForWeather(locationRequiredSchema);
+    const registry = weather.registry;
+    const outcome = await registry.execute('get_humidity', {}).then(
+      () => 'resolved without throwing',
+      (error: Error) => error.message
+    );
+
+    expect(outcome).toBe('Unknown tool: get_humidity');
+  });
+});