@@ -0,0 +1,157 @@
+import {jest} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const weatherDefinition = (inputSchema: Record<string, unknown>): ToolDefinition => ({
+  name: 'get_weather',
+  description: 'looks up the weather for a location',
+  inputSchema,
+});
+
+const locationString = {
+  type: 'object',
+  properties: {location: {type: 'string'}},
+  required: ['location'],
+};
+
+describe('ToolRegistry input validation', () => {
+  it('rejects a call missing a required property and never invokes the executor', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(weatherDefinition(locationString), async () => {
+      calls += 1;
+      return 'ok';
+    });
+
+    const response = await registry.execute('get_weather', {});
+
+    expect([calls, /location/.test(response.result), /required/i.test(response.result)]).toEqual([0, true, true]);
+  });
+
+  it('rejects a wrong-typed value naming the path and expected type but not the value', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(weatherDefinition(locationString), async () => {
+      calls += 1;
+      return 'ok';
+    });
+
+    const response = await registry.execute('get_weather', {location: 12345});
+
+    expect([
+      calls,
+      /location/.test(response.result),
+      /string/.test(response.result),
+      response.result.includes('12345'),
+    ]).toEqual([0, true, true, false]);
+  });
+
+  it('rejects a value outside a declared enum without invoking the executor', async () => {
+    const schema = {
+      type: 'object',
+      properties: {location: {type: 'string'}, units: {type: 'string', enum: ['celsius', 'fahrenheit']}},
+      required: ['location'],
+    };
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(weatherDefinition(schema), async () => {
+      calls += 1;
+      return 'ok';
+    });
+
+    const response = await registry.execute('get_weather', {location: 'Berlin', units: 'kelvin'});
+
+    expect([calls, /units/.test(response.result), response.result.includes('kelvin')]).toEqual([0, true, false]);
+  });
+
+  it('hands valid input to the executor unchanged, extra properties included, exactly once', async () => {
+    const registry = new ToolRegistry();
+    const seen: Record<string, unknown>[] = [];
+    registry.register(weatherDefinition(locationString), async input => {
+      seen.push(input);
+      return 'ok';
+    });
+
+    await registry.execute('get_weather', {location: 'Berlin', units: 'celsius', timeZone: 'Europe/Berlin'});
+
+    expect(seen).toEqual([{location: 'Berlin', units: 'celsius', timeZone: 'Europe/Berlin'}]);
+  });
+
+  it('throws at registration time for an uncompilable schema, naming the tool', () => {
+    const registry = new ToolRegistry();
+
+    expect(() => registry.register(weatherDefinition({type: 123}), async () => 'ok')).toThrow(/get_weather/);
+  });
+
+  it('validates a function-valued definition against the schema it returns for that call', async () => {
+    const asString = weatherDefinition(locationString);
+    const asNumber = weatherDefinition({
+      type: 'object',
+      properties: {location: {type: 'number'}},
+      required: ['location'],
+    });
+    let executorCalls = 0;
+    const registry = new ToolRegistry();
+    registry.register(
+      () => (executorCalls === 0 ? asString : asNumber),
+      async () => {
+        executorCalls += 1;
+        return 'ok';
+      }
+    );
+
+    const accepted = await registry.execute('get_weather', {location: 'harbour'});
+    const rejected = await registry.execute('get_weather', {location: 'harbour'});
+
+    expect([executorCalls, accepted.result, /location/.test(rejected.result)]).toEqual([1, 'ok', true]);
+  });
+
+  it('compiles a static schema once at registration and reuses it across calls', async () => {
+    let reads = 0;
+    const inputSchema: Record<string, unknown> = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      get required() {
+        reads += 1;
+        return ['location'];
+      },
+    };
+    const registry = new ToolRegistry();
+    registry.register(weatherDefinition(inputSchema), async () => 'ok');
+    const readsAtRegistration = reads;
+
+    for (let round = 0; round < 10; round++) {
+      await registry.execute('get_weather', {location: 'Berlin'});
+    }
+
+    expect([reads > 0, reads]).toEqual([true, readsAtRegistration]);
+  });
+
+  it('still throws Unknown tool for an unregistered name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('ghost_tool', {})).rejects.toThrow('Unknown tool: ghost_tool');
+  });
+
+  it('keeps input values out of the rejection text and the log stream', async () => {
+    const lines: string[] = [];
+    const outSpy = jest.spyOn(console, 'log').mockImplementation((raw: unknown) => void lines.push(String(raw)));
+    const errSpy = jest.spyOn(console, 'error').mockImplementation((raw: unknown) => void lines.push(String(raw)));
+    try {
+      const registry = new ToolRegistry();
+      let calls = 0;
+      registry.register(weatherDefinition(locationString), async () => {
+        calls += 1;
+        return 'ok';
+      });
+
+      const response = await registry.execute('get_weather', {replyTo: 'alice@example.com'});
+
+      const leaked = lines.filter(line => line.includes('alice@example.com'));
+      expect([calls, /location/.test(response.result), leaked]).toEqual([0, true, []]);
+    } finally {
+      outSpy.mockRestore();
+      errSpy.mockRestore();
+    }
+  });
+});