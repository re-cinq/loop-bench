+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// One scripted round per sendMessage call, recording each round's request for the test to read back.
+const scriptedProvider = (seen: SendMessageParams[], rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      seen.push(params);
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const TOOL_USE = (input: Record<string, unknown>): MessageChunk => ({
+  type: 'tool_use',
+  toolCall: {id: 'call-1', name: 'get_weather', input},
+});
+const STOP_FOR_TOOL: MessageChunk = {type: 'stop', stopReason: 'tool_use'};
+const STOP_DONE: MessageChunk = {type: 'stop', stopReason: 'end_turn'};
+
+describe('ChatOrchestrator tool input validation', () => {
+  it('feeds a schema rejection back to the model and completes on the corrected retry', async () => {
+    const seen: SendMessageParams[] = [];
+    const provider = scriptedProvider(seen, [
+      [TOOL_USE({}), STOP_FOR_TOOL],
+      [TOOL_USE({location: 'Berlin'}), STOP_FOR_TOOL],
+      [{type: 'text', text: '18 degrees in Berlin'}, STOP_DONE],
+    ]);
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'looks up the weather',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async () => {
+        executorCalls += 1;
+        return '{"temperatureC": 18}';
+      }
+    );
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+
+    const text = await orchestrator.processMessage(createSession('what is the weather?'));
+
+    const roundTwo = seen[1]?.messages ?? [];
+    const rejection = JSON.stringify(roundTwo[roundTwo.length - 1]?.content);
+    expect([executorCalls, /location/.test(rejection), text]).toEqual([1, true, '18 degrees in Berlin']);
+  });
+});
diff --git a/src/orchestration/tools/registry.acceptance.test.ts b/src/orchestration/tools/registry.acceptance.test.ts
