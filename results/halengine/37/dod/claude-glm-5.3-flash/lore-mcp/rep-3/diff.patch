@@ -0,0 +1,225 @@
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {ToolRegistry} from './registry.js';
+import type {ToolExecutor} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import type {
+  AIProvider,
+  Message,
+  MessageChunk,
+  SendMessageParams,
+  ToolDefinition,
+  ToolResultContent,
+} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+
+// Acceptance contract for issue #37: tool input is validated against the registered inputSchema.
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const createSession = (content: string): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content, timestamp: SENT_AT}],
+});
+
+const recordingExecutor = (result = 'ok'): {calls: Record<string, unknown>[]; executor: ToolExecutor} => {
+  const calls: Record<string, unknown>[] = [];
+  const executor: ToolExecutor = async input => {
+    calls.push(input);
+    return result;
+  };
+  return {calls, executor};
+};
+
+const weatherTool: ToolDefinition = {
+  name: 'get_weather',
+  description: 'Weather lookup used by the input-validation acceptance tests.',
+  inputSchema: {
+    type: 'object',
+    properties: {
+      location: {type: 'string'},
+      units: {type: 'string', enum: ['celsius', 'fahrenheit']},
+    },
+    required: ['location'],
+  },
+};
+
+// The registry hands back `location` as the failing property and states the unmet constraint.
+const namesMissingProperty = (result: string, property: string): boolean =>
+  /(requir|missing)/i.test(result) && result.includes(property);
+
+const toolResultContents = (messages: Message[]): string[] =>
+  messages.flatMap(message =>
+    Array.isArray(message.content)
+      ? message.content
+          .filter((part): part is ToolResultContent => part.type === 'tool_result')
+          .map(part => part.content)
+      : []
+  );
+
+describe('ToolRegistry input validation', () => {
+  it('rejects a call missing a required property before the executor runs', async () => {
+    const registry = new ToolRegistry();
+    const tool = recordingExecutor();
+    registry.register(weatherTool, tool.executor);
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({
+      executorCalls: tool.calls.length,
+      namesProperty: namesMissingProperty(response.result, 'location'),
+    }).toEqual({executorCalls: 0, namesProperty: true});
+  });
+
+  it('passes valid input through to the executor unchanged, extra properties included', async () => {
+    const registry = new ToolRegistry();
+    const tool = recordingExecutor('forecast');
+    registry.register(weatherTool, tool.executor);
+
+    const response = await registry.execute('get_weather', {location: 'Berlin', units: 'celsius', extra: 'x'});
+
+    expect({received: tool.calls, returned: response.result}).toEqual({
+      received: [{location: 'Berlin', units: 'celsius', extra: 'x'}],
+      returned: 'forecast',
+    });
+  });
+
+  it('rejects a wrong-typed value, naming the path and the expected type but not the value', async () => {
+    const registry = new ToolRegistry();
+    const tool = recordingExecutor();
+    registry.register(weatherTool, tool.executor);
+    const logLines: string[] = [];
+    const capture: Logger['info'] = (category, message, fields) =>
+      void logLines.push(`${category} ${message} ${JSON.stringify(fields)}`);
+    setLogger({debug: capture, info: capture, warn: capture, error: capture});
+
+    try {
+      const response = await registry.execute('get_weather', {location: 1234567890});
+      const logged = logLines.join('\n');
+
+      expect({
+        executorCalls: tool.calls.length,
+        namesPath: response.result.includes('location'),
+        namesExpectedType: response.result.includes('string'),
+        valueInReturnedText: response.result.includes('1234567890'),
+        valueInLogLines: logged.includes('1234567890'),
+      }).toEqual({
+        executorCalls: 0,
+        namesPath: true,
+        namesExpectedType: true,
+        valueInReturnedText: false,
+        valueInLogLines: false,
+      });
+    } finally {
+      setLogger();
+    }
+  });
+
+  it('refuses at register time a tool whose schema cannot compile, naming the tool', () => {
+    const registry = new ToolRegistry();
+    const broken: ToolDefinition = {
+      name: 'get_weather',
+      description: 'The location property declares an impossible type.',
+      inputSchema: {type: 'object', properties: {location: {type: 'strng'}}, required: ['location']},
+    };
+    let thrown: unknown;
+    try {
+      registry.register(broken, async () => 'ok');
+    } catch (error) {
+      thrown = error;
+    }
+
+    const message = thrown instanceof Error ? thrown.message : '';
+    expect({threw: thrown !== undefined, namesTool: message.includes('get_weather')}).toEqual({
+      threw: true,
+      namesTool: true,
+    });
+  });
+
+  it('validates a function-valued definition against the schema current at that call', async () => {
+    const registry = new ToolRegistry();
+    const tool = recordingExecutor();
+    const acceptedSchema: Record<string, unknown> = {type: 'object', properties: {note: {type: 'string'}}};
+    const codeRequiredSchema: Record<string, unknown> = {
+      type: 'object',
+      properties: {note: {type: 'string'}, code: {type: 'string'}},
+      required: ['code'],
+    };
+    const schemaByRound = [acceptedSchema, codeRequiredSchema];
+    let currentRound = 0;
+    const definitionSource = (): ToolDefinition => ({
+      ...weatherTool,
+      name: 'ticket_lookup',
+      inputSchema: schemaByRound[currentRound],
+    });
+    registry.register(definitionSource, tool.executor);
+
+    const first = await registry.execute('ticket_lookup', {});
+    currentRound = 1;
+    const second = await registry.execute('ticket_lookup', {});
+
+    expect({
+      firstAccepted: first.result === 'ok',
+      executorCalls: tool.calls.length,
+      secondRejectedNamingCode: namesMissingProperty(second.result, 'code'),
+    }).toEqual({firstAccepted: true, executorCalls: 1, secondRejectedNamingCode: true});
+  });
+
+  it('still throws for a tool name that was never registered', async () => {
+    const registry = new ToolRegistry();
+
+    const error = await registry.execute('no_such_tool', {}).then(
+      () => undefined,
+      (e: unknown) => (e instanceof Error ? e : new Error(String(e)))
+    );
+
+    expect(error?.message).toBe('Unknown tool: no_such_tool');
+  });
+
+  it('feeds a rejected call back to the provider and completes on the corrected retry', async () => {
+    const registry = new ToolRegistry();
+    const tool = recordingExecutor('forecast');
+    registry.register(weatherTool, tool.executor);
+
+    const requests: SendMessageParams[] = [];
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        requests.push(params);
+        const results = toolResultContents(params.messages);
+        const lastResult = results[results.length - 1];
+        // No tool result yet: make the malformed call the schema must reject.
+        if (lastResult === undefined) {
+          yield {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        // The rejection is legible: retry with input that satisfies the schema.
+        if (namesMissingProperty(lastResult, 'location')) {
+          yield {type: 'tool_use', toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Berlin'}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        yield {type: 'text', text: 'Here is the Berlin forecast.'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      provider,
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      registry
+    );
+    const reply = await orchestrator.processMessage(createSession('What is the weather in Berlin?'));
+
+    expect({reply, executorCalls: tool.calls}).toEqual({
+      reply: 'Here is the Berlin forecast.',
+      executorCalls: [{location: 'Berlin'}],
+    });
+  });
+});