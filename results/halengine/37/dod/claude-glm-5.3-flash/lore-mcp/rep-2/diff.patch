@@ -0,0 +1,209 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolExecutor, ToolResponse} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+import type {Logger} from '../../shared/logger.js';
+import {setLogger} from '../../shared/logger.js';
+
+// One term per claim the rejection message owes the caller: the failing property and its constraint.
+const mentions = (text: string, ...terms: string[]): boolean => terms.every(term => text.includes(term));
+
+// A fresh schema object per call: the compile-once test mutates its own instance in place.
+const locationSchema = (): Record<string, unknown> => ({
+  type: 'object',
+  properties: {location: {type: 'string'}},
+  required: ['location'],
+});
+
+const recordingExecutor =
+  (calls: Record<string, unknown>[]): ToolExecutor =>
+  async input => {
+    calls.push(input);
+    return 'forecast';
+  };
+
+describe('ToolRegistry input validation', () => {
+  it('rejects input missing a required property, names it, and never calls the executor', async () => {
+    const calls: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      {name: 'needs_location', description: 'requires a location string', inputSchema: locationSchema()},
+      recordingExecutor(calls)
+    );
+
+    const response: ToolResponse = await registry.execute('needs_location', {});
+
+    expect({
+      namesLocationAsRequired: mentions(response.result, 'location') && /required/i.test(response.result),
+      executorCalls: calls.length,
+    }).toEqual({namesLocationAsRequired: true, executorCalls: 0});
+  });
+
+  it('passes accepted input through to the executor unchanged, extra properties included, exactly once', async () => {
+    const calls: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      {name: 'needs_location', description: 'requires a location string', inputSchema: locationSchema()},
+      recordingExecutor(calls)
+    );
+
+    await registry.execute('needs_location', {location: 'Berlin', units: 'imperial'});
+
+    expect({received: calls, executorCalls: calls.length}).toEqual({
+      received: [{location: 'Berlin', units: 'imperial'}],
+      executorCalls: 1,
+    });
+  });
+
+  it('rejects a wrong-typed field naming the path and expected type but not the value', async () => {
+    const calls: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      {name: 'needs_location', description: 'requires a location string', inputSchema: locationSchema()},
+      recordingExecutor(calls)
+    );
+
+    const response: ToolResponse = await registry.execute('needs_location', {location: 1234567});
+
+    expect({
+      namesPathAndType: mentions(response.result, 'location', 'string'),
+      leaksValue: response.result.includes('1234567'),
+      executorCalls: calls.length,
+    }).toEqual({namesPathAndType: true, leaksValue: false, executorCalls: 0});
+  });
+
+  it('enforces a declared enum constraint and names the property it failed', async () => {
+    const calls: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'weather_units',
+        description: 'units is an enum of celsius and fahrenheit',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}, units: {type: 'string', enum: ['celsius', 'fahrenheit']}},
+          required: ['location'],
+        },
+      },
+      recordingExecutor(calls)
+    );
+
+    const response: ToolResponse = await registry.execute('weather_units', {location: 'Berlin', units: 'kelvin'});
+
+    expect({
+      namesUnits: mentions(response.result, 'units'),
+      executorCalls: calls.length,
+    }).toEqual({namesUnits: true, executorCalls: 0});
+  });
+
+  it('throws at register time for a schema that cannot compile, naming the tool', () => {
+    const registry = new ToolRegistry();
+    const broken: ToolDefinition = {
+      name: 'broken_tool',
+      description: 'declares a property type no JSON Schema allows',
+      inputSchema: {type: 'object', properties: {location: {type: 'strng'}}, required: ['location']},
+    };
+
+    let thrown = '';
+    try {
+      registry.register(broken, async () => 'forecast');
+    } catch (error) {
+      thrown = error instanceof Error ? error.message : '';
+    }
+
+    expect({threw: thrown !== '', namesTool: thrown.includes('broken_tool')}).toEqual({
+      threw: true,
+      namesTool: true,
+    });
+  });
+
+  it('validates a function-valued definition against the schema current at each call', async () => {
+    const calls: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    let schema: Record<string, unknown> = locationSchema();
+    const source = (): ToolDefinition => ({
+      name: 'dynamic_tool',
+      description: 'returns a schema that changes between calls',
+      inputSchema: schema,
+    });
+    registry.register(source, recordingExecutor(calls));
+
+    const first = await registry.execute('dynamic_tool', {});
+    schema = {type: 'object', properties: {location: {type: 'string'}}};
+    const second = await registry.execute('dynamic_tool', {});
+
+    expect({
+      firstCallRejected: calls.length === 0 && mentions(first.result, 'location'),
+      secondCallAccepted: calls.length === 1 && second.result === 'forecast',
+    }).toEqual({firstCallRejected: true, secondCallAccepted: true});
+  });
+
+  it('compiles a static schema once at register and reuses it across ten execute calls', async () => {
+    const calls: Record<string, unknown>[] = [];
+    const schema: Record<string, unknown> = locationSchema();
+    const registry = new ToolRegistry();
+    registry.register(
+      {name: 'static_tool', description: 'schema compiled at register', inputSchema: schema},
+      recordingExecutor(calls)
+    );
+
+    // Recompiling per call would now throw: required must be an array in any compilable JSON Schema.
+    schema.required = 'location';
+
+    const results: string[] = [];
+    for (let i = 0; i < 10; i++) {
+      const response = await registry.execute('static_tool', {location: 'Berlin'});
+      results.push(response.result);
+    }
+
+    expect({
+      executorCalls: calls.length,
+      everyCallExecuted: results.every(result => result === 'forecast'),
+    }).toEqual({executorCalls: 10, everyCallExecuted: true});
+  });
+
+  it('still throws Unknown tool for an unregistered name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('missing_tool', {})).rejects.toThrow('Unknown tool: missing_tool');
+  });
+
+  it('keeps property values out of rejection messages and log lines', async () => {
+    const lines: string[] = [];
+    const record = (_category: string, message: string, fields?: Record<string, unknown>): void => {
+      lines.push(JSON.stringify({message, fields}));
+    };
+    const logger: Logger = {debug: record, info: record, warn: record, error: record};
+    setLogger(logger);
+    try {
+      const calls: Record<string, unknown>[] = [];
+      const registry = new ToolRegistry();
+      registry.register(
+        {
+          name: 'identity_tool',
+          description: 'requires a numeric card number',
+          inputSchema: {
+            type: 'object',
+            properties: {location: {type: 'string'}, card_number: {type: 'number'}},
+            required: ['location', 'card_number'],
+          },
+        },
+        recordingExecutor(calls)
+      );
+
+      const response: ToolResponse = await registry.execute('identity_tool', {
+        location: 'Berlin',
+        card_number: 'ALICE-4242-SECRET',
+      });
+      const logged = lines.join('\n');
+
+      expect({
+        namesFieldAndConstraint: mentions(response.result, 'card_number', 'number'),
+        valueInResult: response.result.includes('ALICE-4242-SECRET'),
+        valueInLogs: logged.includes('ALICE-4242-SECRET'),
+        executorCalls: calls.length,
+      }).toEqual({namesFieldAndConstraint: true, valueInResult: false, valueInLogs: false, executorCalls: 0});
+    } finally {
+      setLogger();
+    }
+  });
+});