+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolExecutor} from './tools/registry.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const REJECTED_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}};
+const CORRECTED_CALL: MessageChunk = {
+  type: 'tool_use',
+  toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Berlin'}},
+};
+const STOP_FOR_TOOL: MessageChunk = {type: 'stop', stopReason: 'tool_use'};
+const STOP_DONE: MessageChunk = {type: 'stop', stopReason: 'end_turn'};
+
+describe('ChatOrchestrator tool loop with input validation', () => {
+  it('returns a rejected tool call to the provider and resolves through the corrected retry', async () => {
+    const executorInputs: Record<string, unknown>[] = [];
+    const executor: ToolExecutor = async input => {
+      executorInputs.push(input);
+      return '18 degrees';
+    };
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'requires a location string',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      executor
+    );
+
+    // One serialised request per round: index 1 is what the provider sees after the rejected call.
+    const roundRequests: string[] = [];
+    const rounds: MessageChunk[][] = [
+      [REJECTED_CALL, STOP_FOR_TOOL],
+      [CORRECTED_CALL, STOP_FOR_TOOL],
+      [{type: 'text', text: 'done'}, STOP_DONE],
+    ];
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        roundRequests.push(JSON.stringify(params.messages));
+        for (const chunk of rounds[round] ?? []) yield chunk;
+        round++;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+    const text = await orchestrator.processMessage(createSession('what is the weather?'));
+
+    expect({
+      resolvesWithFinalText: text,
+      executorCalls: executorInputs.length,
+      rejectionVisibleOnNextRound: (roundRequests[1] ?? '').includes('location'),
+    }).toEqual({resolvesWithFinalText: 'done', executorCalls: 1, rejectionVisibleOnNextRound: true});
+  });
+});
diff --git a/src/orchestration/tools/registry.acceptance.test.ts b/src/orchestration/tools/registry.acceptance.test.ts
