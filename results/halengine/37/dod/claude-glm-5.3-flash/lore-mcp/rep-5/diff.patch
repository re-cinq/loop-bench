+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+
+interface RecordedLine {
+  level: string;
+  category: string;
+  message: string;
+  fields?: Record<string, unknown>;
+}
+
+const weatherSchema = {
+  type: 'object',
+  properties: {location: {type: 'string'}},
+  required: ['location'],
+};
+
+const weatherTool = {
+  name: 'get_weather',
+  description: 'current weather for a location',
+  inputSchema: weatherSchema,
+};
+
+// The executor is recorded by hand rather than jest.fn, so the assertion subject is the calls themselves.
+const recordExecutor = (calls: Record<string, unknown>[], result = '18°C and partly cloudy') => {
+  return async (input: Record<string, unknown>) => {
+    calls.push(input);
+    return result;
+  };
+};
+
+// The logger is process-global, so a recording one observes every line execute wrote.
+const recordingLogger = (lines: RecordedLine[]): Logger => {
+  return {
+    debug: (category, message, fields) => void lines.push({level: 'debug', category, message, fields}),
+    info: (category, message, fields) => void lines.push({level: 'info', category, message, fields}),
+    warn: (category, message, fields) => void lines.push({level: 'warn', category, message, fields}),
+    error: (category, message, fields) => void lines.push({level: 'error', category, message, fields}),
+  };
+};
+
+describe('ToolRegistry input validation', () => {
+  afterEach(() => {
+    setLogger(undefined);
+  });
+
+  it('rejects a call missing a required property before the executor runs', async () => {
+    const registry = new ToolRegistry();
+    const calls: Record<string, unknown>[] = [];
+    registry.register(weatherTool, recordExecutor(calls));
+
+    const response = await registry.execute('get_weather', {});
+
+    expect(calls).toHaveLength(0);
+    expect(response.result).toContain('location');
+    expect(response.result).toContain('required');
+  });
+
+  it('names the failing path and constraint, never the value, in the result and the logs', async () => {
+    const registry = new ToolRegistry();
+    const calls: Record<string, unknown>[] = [];
+    registry.register(weatherTool, recordExecutor(calls));
+    const lines: RecordedLine[] = [];
+    setLogger(recordingLogger(lines));
+
+    const response = await registry.execute('get_weather', {location: 42});
+
+    expect(calls).toHaveLength(0);
+    expect(response.result).toContain('location');
+    expect(response.result).toContain('string');
+    expect(response.result).not.toContain('42');
+    expect(lines.map(line => JSON.stringify(line)).filter(serialised => serialised.includes('42'))).toEqual([]);
+  });
+
+  it('passes schema-valid input through to the executor unchanged, exactly once', async () => {
+    const registry = new ToolRegistry();
+    const calls: Record<string, unknown>[] = [];
+    registry.register(weatherTool, recordExecutor(calls));
+
+    const response = await registry.execute('get_weather', {location: 'Paris', units: 'metric'});
+
+    expect(calls).toEqual([{location: 'Paris', units: 'metric'}]);
+    expect(response).toEqual({result: '18°C and partly cloudy'});
+  });
+
+  it('throws at registration when a static schema cannot compile, naming the tool', () => {
+    const registry = new ToolRegistry();
+
+    const register = () =>
+      registry.register(
+        {
+          name: 'broken_tool',
+          description: 'declares a type no JSON Schema validator knows',
+          inputSchema: {type: 'object', properties: {location: {type: 'strng'}}},
+        },
+        async () => 'ok'
+      );
+
+    expect(register).toThrow(/broken_tool/);
+  });
+
+  it('validates a function-valued definition against the schema current at each call', async () => {
+    const registry = new ToolRegistry();
+    const calls: Record<string, unknown>[] = [];
+    let schema: Record<string, unknown> = weatherSchema;
+    registry.register(
+      () => ({name: 'get_weather', description: 'current weather for a location', inputSchema: schema}),
+      recordExecutor(calls)
+    );
+
+    await registry.execute('get_weather', {location: 'Paris'});
+    schema = {type: 'object', properties: {location: {type: 'number'}}, required: ['location']};
+    const response = await registry.execute('get_weather', {location: 'Paris'});
+
+    expect(calls).toEqual([{location: 'Paris'}]);
+    expect(response.result).toContain('location');
+    expect(response.result).toContain('number');
+  });
+});