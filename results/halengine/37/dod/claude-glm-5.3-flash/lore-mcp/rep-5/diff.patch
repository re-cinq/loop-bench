+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, Message, MessageChunk, SendMessageParams, ToolResultMessage} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const weatherSchema = {
+  type: 'object',
+  properties: {location: {type: 'string'}},
+  required: ['location'],
+};
+
+// One scripted round per sendMessage call; each round snapshots the messages it was handed,
+// because the orchestrator reuses and appends to one array across the whole loop.
+const scriptedProvider = (rounds: MessageChunk[][], sent: Message[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      sent.push([...params.messages]);
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+describe('ChatOrchestrator tool input validation', () => {
+  it('feeds a rejected tool call back to the model as a tool result and completes on the corrected retry', async () => {
+    const registry = new ToolRegistry();
+    const calls: Record<string, unknown>[] = [];
+    registry.register(
+      {name: 'get_weather', description: 'current weather for a location', inputSchema: weatherSchema},
+      async input => {
+        calls.push(input);
+        return '18°C and partly cloudy';
+      }
+    );
+    const sent: Message[][] = [];
+    const provider = scriptedProvider(
+      [
+        [
+          {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}},
+          {type: 'stop', stopReason: 'tool_use'},
+        ],
+        [
+          {type: 'tool_use', toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Paris'}}},
+          {type: 'stop', stopReason: 'tool_use'},
+        ],
+        [
+          {type: 'text', text: 'It is 18°C and partly cloudy in Paris.'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ],
+      ],
+      sent
+    );
+    const orchestrator = createChatOrchestrator(
+      provider,
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      registry
+    );
+
+    const text = await orchestrator.processMessage(createSession('What is the weather in Paris?'));
+
+    expect(calls).toEqual([{location: 'Paris'}]);
+    const rejection = sent[1][sent[1].length - 1] as ToolResultMessage;
+    expect(rejection.role).toBe('user');
+    expect(rejection.content[0].toolUseId).toBe('call-1');
+    expect(rejection.content[0].content).toContain('location');
+    expect(text).toBe('It is 18°C and partly cloudy in Paris.');
+  });
+});
