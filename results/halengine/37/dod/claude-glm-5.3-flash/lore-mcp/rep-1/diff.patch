+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, Message, MessageChunk, SendMessageParams, ToolDefinition} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const WEATHER_TOOL: ToolDefinition = {
+  name: 'get_weather',
+  description: 'looks up the weather for a place',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}},
+    required: ['location'],
+  },
+};
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(content: string): ChatSession {
+  return {sessionId: 's1', userId: 'u1', entries: [{role: 'user', content, timestamp: SENT_AT}]};
+}
+
+// Records the messages each round was sent, then plays the script written for that round.
+function scriptedProvider(rounds: MessageChunk[][]): {provider: AIProvider; messagesByRound: Message[][]} {
+  let round = 0;
+  const messagesByRound: Message[][] = [];
+  return {
+    messagesByRound,
+    provider: {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        messagesByRound.push(params.messages);
+        for (const chunk of rounds[round] ?? []) yield chunk;
+        round += 1;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    },
+  };
+}
+
+describe('ChatOrchestrator tool input validation', () => {
+  it('returns a rejected tool call to the model as a tool result and lets a corrected retry complete', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(WEATHER_TOOL, async () => {
+      executorCalls += 1;
+      return '18 celsius, partly cloudy';
+    });
+
+    const toolCall = (id: string, input: Record<string, unknown>): MessageChunk => ({
+      type: 'tool_use',
+      toolCall: {id, name: WEATHER_TOOL.name, input},
+    });
+    const {provider, messagesByRound} = scriptedProvider([
+      [toolCall('call-1', {}), {type: 'stop', stopReason: 'tool_use'}],
+      [toolCall('call-2', {location: 'Berlin'}), {type: 'stop', stopReason: 'tool_use'}],
+      [
+        {type: 'text', text: 'It is 18 celsius in Berlin.'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ]);
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+
+    const outcome = await orchestrator.processMessage(createSession('weather in berlin')).then(
+      (text: string) => text,
+      (error: Error) => `rejected: ${error.message}`
+    );
+    const retryRound = messagesByRound[1] ?? [];
+    const retryRoundToolResult = JSON.stringify(retryRound[retryRound.length - 1] ?? {});
+
+    expect({outcome, executorCalls, rejectionReachedProvider: retryRoundToolResult.includes('location')}).toEqual({
+      outcome: 'It is 18 celsius in Berlin.',
+      executorCalls: 1,
+      rejectionReachedProvider: true,
+    });
+  });
+});
diff --git a/src/orchestration/tools/registry.acceptance.test.ts b/src/orchestration/tools/registry.acceptance.test.ts
