@@ -0,0 +1,168 @@
+import {jest} from '@jest/globals';
+import Ajv from 'ajv';
+import {ToolRegistry} from './registry.js';
+import type {ToolResponse} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+
+// Every case below registers this tool: location is a required string.
+const LOCATION_TOOL: ToolDefinition = {
+  name: 'get_weather',
+  description: 'looks up the weather for a place',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}},
+    required: ['location'],
+  },
+};
+
+// One expect per test needs the rejection as a value rather than a matcher.
+const outcomeOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved without throwing').catch((error: Error) => error.message);
+
+describe('ToolRegistry input validation', () => {
+  it('rejects input missing a required property with a ToolResponse naming it, and never calls the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(LOCATION_TOOL, async () => {
+      executorCalls += 1;
+      return 'ok';
+    });
+
+    const response = await registry.execute(LOCATION_TOOL.name, {});
+
+    expect({
+      executorCalls,
+      namesProperty: response.result.includes('location'),
+      namesRequired: response.result.includes('required'),
+    }).toEqual({executorCalls: 0, namesProperty: true, namesRequired: true});
+  });
+
+  it('passes schema-valid input through to the executor unchanged, extra keys included, exactly once', async () => {
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+    registry.register(LOCATION_TOOL, async input => {
+      received.push(input);
+      return 'ok';
+    });
+
+    await registry.execute(LOCATION_TOOL.name, {location: 'Berlin', units: 'fahrenheit'});
+
+    expect({executorCalls: received.length, received: received[0]}).toEqual({
+      executorCalls: 1,
+      received: {location: 'Berlin', units: 'fahrenheit'},
+    });
+  });
+
+  it('rejects a wrong-typed value naming the property path and expected type without the offending value', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(LOCATION_TOOL, async () => {
+      executorCalls += 1;
+      return 'ok';
+    });
+
+    const response = await registry.execute(LOCATION_TOOL.name, {location: 31337});
+
+    expect({
+      executorCalls,
+      namesPath: response.result.includes('location'),
+      namesType: response.result.includes('string'),
+      leaksValue: response.result.includes('31337'),
+    }).toEqual({executorCalls: 0, namesPath: true, namesType: true, leaksValue: false});
+  });
+
+  it('throws at registration time for a schema that does not compile, naming the tool', async () => {
+    const registry = new ToolRegistry();
+    const registration = await outcomeOf(
+      Promise.resolve().then(() =>
+        registry.register(
+          {
+            ...LOCATION_TOOL,
+            name: 'broken_tool',
+            inputSchema: {type: 'object', properties: {location: {type: 'not-a-json-schema-type'}}},
+          },
+          async () => 'ok'
+        )
+      )
+    );
+
+    expect({
+      threw: registration !== 'resolved without throwing',
+      namesTool: registration.includes('broken_tool'),
+    }).toEqual({threw: true, namesTool: true});
+  });
+
+  it('validates a function-valued definition against the schema current at each call, not a stale one', async () => {
+    const registry = new ToolRegistry();
+    let requireLocation = true;
+    let executorCalls = 0;
+    registry.register(
+      () => ({
+        name: 'dynamic_tool',
+        description: 'schema depends on configuration read at call time',
+        inputSchema: {
+          type: 'object',
+          properties: requireLocation ? {location: {type: 'string'}} : {},
+          required: requireLocation ? ['location'] : [],
+        },
+      }),
+      async () => {
+        executorCalls += 1;
+        return 'ok';
+      }
+    );
+
+    const strict = await registry.execute('dynamic_tool', {});
+    requireLocation = false;
+    await registry.execute('dynamic_tool', {});
+
+    expect({firstRejected: strict.result.includes('location'), executorCalls}).toEqual({
+      firstRejected: true,
+      executorCalls: 1,
+    });
+  });
+
+  it('compiles a static tool schema once across ten execute calls', async () => {
+    // Reached through an instance so the spy holds whichever ajv major the dependency tree hoists.
+    const compile = jest.spyOn(Object.getPrototypeOf(new Ajv()) as Record<string, unknown>, 'compile');
+    const registry = new ToolRegistry();
+    registry.register(LOCATION_TOOL, async () => 'ok');
+    for (let round = 0; round < 10; round++) {
+      await registry.execute(LOCATION_TOOL.name, {location: 'Berlin'});
+    }
+
+    expect(compile).toHaveBeenCalledTimes(1);
+  });
+
+  it('throws Unknown tool, naming the tool, for an unregistered name', async () => {
+    const registry = new ToolRegistry();
+    const outcome = await outcomeOf(registry.execute('no_such_tool', {}));
+
+    expect(outcome).toEqual('Unknown tool: no_such_tool');
+  });
+
+  it('keeps an identifying input value out of the rejection text and every log line', async () => {
+    const registry = new ToolRegistry();
+    registry.register(LOCATION_TOOL, async () => 'ok');
+    const lines: string[] = [];
+    const record =
+      (level: string): Logger['info'] =>
+      (category, message, fields) => {
+        lines.push(JSON.stringify([level, category, message, fields]));
+      };
+    setLogger({debug: record('DEBUG'), info: record('INFO'), warn: record('WARN'), error: record('ERROR')});
+    let response: ToolResponse = {result: 'execute threw before returning'};
+    try {
+      response = await registry.execute(LOCATION_TOOL.name, {location: 31337});
+    } finally {
+      setLogger();
+    }
+
+    expect({
+      rejected: response.result.includes('location'),
+      leaked: [response.result, ...lines].join('\n').includes('31337'),
+    }).toEqual({rejected: true, leaked: false});
+  });
+});