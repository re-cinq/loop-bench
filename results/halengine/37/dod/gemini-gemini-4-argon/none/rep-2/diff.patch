+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {AIProvider, MessageChunk, SendMessageParams, ToolDefinition} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+import {ToolRegistry} from './registry.js';
+import type {ToolContext} from './registry.js';
+
+const CONTEXT: ToolContext = {
+  userId: 'u1',
+  sessionId: 's1',
+};
+
+const WEATHER_TOOL: ToolDefinition = {
+  name: 'weather',
+  description: 'Fetches current weather for a city',
+  inputSchema: {
+    type: 'object',
+    properties: {
+      location: {type: 'string', enum: ['Paris', 'London']},
+    },
+    required: ['location'],
+  },
+};
+
+interface CapturedLog {
+  level: string;
+  category: string;
+  message: string;
+  fields?: Record<string, unknown>;
+}
+
+const registerThrownMessage = (registry: ToolRegistry, definition: ToolDefinition): string => {
+  try {
+    registry.register(definition, async () => ({result: 'ok'}));
+    return 'did not throw';
+  } catch (error) {
+    return error instanceof Error ? error.message : String(error);
+  }
+};
+
+describe('ToolRegistry inputSchema validation acceptance', () => {
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('rejects input missing a required property with a ToolResponse naming the property and without invoking the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(WEATHER_TOOL, async () => {
+      executorCalls += 1;
+      return {result: '72°F'};
+    });
+
+    const response = await registry.execute('weather', {}, CONTEXT);
+
+    expect({
+      executorCalls,
+      namesProperty: /location/i.test(response.result),
+      namesRequired: /required/i.test(response.result),
+      clientMessages: response.clientMessages,
+      suppressAssistantResponse: response.suppressAssistantResponse,
+    }).toEqual({
+      executorCalls: 0,
+      namesProperty: true,
+      namesRequired: true,
+      clientMessages: undefined,
+      suppressAssistantResponse: undefined,
+    });
+  });
+
+  it('rejects a wrong-typed property naming the field path and expected type without leaking any input value in the result or logs', async () => {
+    const captured: CapturedLog[] = [];
+    setLogger({
+      debug: (category, message, fields) => void captured.push({level: 'DEBUG', category, message, fields}),
+      info: (category, message, fields) => void captured.push({level: 'INFO', category, message, fields}),
+      warn: (category, message, fields) => void captured.push({level: 'WARN', category, message, fields}),
+      error: (category, message, fields) => void captured.push({level: 'ERROR', category, message, fields}),
+    });
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(WEATHER_TOOL, async () => {
+      executorCalls += 1;
+      return {result: '72°F'};
+    });
+
+    const response = await registry.execute('weather', {location: 987654, bearerToken: 'secret-token-xyz'}, CONTEXT);
+    const serializedLogs = JSON.stringify(captured);
+    const warnings = captured.filter(entry => entry.level === 'WARN');
+
+    expect({
+      executorCalls,
+      namesField: /location/i.test(response.result),
+      namesType: /string/i.test(response.result),
+      leaksWrongValueInResult: response.result.includes('987654'),
+      leaksTokenInResult: response.result.includes('secret-token-xyz'),
+      leaksWrongValueInLogs: serializedLogs.includes('987654'),
+      leaksTokenInLogs: serializedLogs.includes('secret-token-xyz'),
+      warnLogged: warnings.map(entry => ({
+        category: entry.category,
+        tool: entry.fields?.tool,
+        hasErrorCount: typeof entry.fields?.errors === 'number' && entry.fields.errors > 0,
+      })),
+    }).toEqual({
+      executorCalls: 0,
+      namesField: true,
+      namesType: true,
+      leaksWrongValueInResult: false,
+      leaksTokenInResult: false,
+      leaksWrongValueInLogs: false,
+      leaksTokenInLogs: false,
+      warnLogged: [{category: 'tool', tool: 'weather', hasErrorCount: true}],
+    });
+  });
+
+  it('throws at register time when a static tool schema cannot be compiled, naming the tool', () => {
+    const registry = new ToolRegistry();
+    const broken: ToolDefinition = {
+      name: 'broken_weather',
+      description: 'Carries an invalid JSON Schema type keyword',
+      inputSchema: {
+        type: 'not-a-json-schema-type',
+      },
+    };
+
+    const thrown = registerThrownMessage(registry, broken);
+
+    expect(thrown).toMatch(/broken_weather/);
+  });
+
+  it('validates a function-valued tool definition against the schema resolved for each call', async () => {
+    const registry = new ToolRegistry();
+    let schemaCalls = 0;
+    let executorCalls = 0;
+    registry.register(
+      () => {
+        schemaCalls += 1;
+        const requiredField = schemaCalls === 1 ? 'city' : 'country';
+        return {
+          name: 'dynamic_lookup',
+          description: 'Resolves its schema per call',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              city: {type: 'string'},
+              country: {type: 'string'},
+            },
+            required: [requiredField],
+          },
+        };
+      },
+      async input => {
+        executorCalls += 1;
+        return {result: `ok:${String(input.city ?? input.country)}`};
+      }
+    );
+
+    const first = await registry.execute('dynamic_lookup', {city: 'Paris'}, CONTEXT);
+    const second = await registry.execute('dynamic_lookup', {city: 'Paris'}, CONTEXT);
+
+    expect({
+      executorCalls,
+      firstResult: first.result,
+      secondNamesCountry: /country/i.test(second.result),
+    }).toEqual({
+      executorCalls: 1,
+      firstResult: 'ok:Paris',
+      secondNamesCountry: true,
+    });
+  });
+
+  it('returns a schema rejection to the model in the orchestrator tool loop and forwards valid input unchanged on retry', async () => {
+    const registry = new ToolRegistry();
+    const receivedInputs: Array<Record<string, unknown>> = [];
+    registry.register(WEATHER_TOOL, async input => {
+      receivedInputs.push(input);
+      return {result: `Sunny in ${String(input.location)}`};
+    });
+    let round = 0;
+    let roundOneToolResult = '';
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        round += 1;
+        if (round === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'call-1', name: 'weather', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        if (round === 2) {
+          const lastMessage = params.messages[params.messages.length - 1];
+          const blocks = Array.isArray(lastMessage.content) ? lastMessage.content : [];
+          const firstBlock = blocks[0];
+          roundOneToolResult = firstBlock?.type === 'tool_result' ? firstBlock.content : '';
+          yield {
+            type: 'tool_use',
+            toolCall: {id: 'call-2', name: 'weather', input: {location: 'Paris', extraNote: 'keep-me'}},
+          };
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        yield {type: 'text', text: 'Forecast: Sunny in Paris'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      provider,
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      registry
+    );
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'Weather in Paris?', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+
+    const reply = await orchestrator.processMessage(session);
+
+    expect({
+      reply,
+      receivedInputs,
+      roundOneRejectionNamesLocation: /location/i.test(roundOneToolResult),
+    }).toEqual({
+      reply: 'Forecast: Sunny in Paris',
+      receivedInputs: [{location: 'Paris', extraNote: 'keep-me'}],
+      roundOneRejectionNamesLocation: true,
+    });
+  });
+});