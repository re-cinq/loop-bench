+import {ToolRegistry} from './registry.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {AIProvider, MessageChunk, SendMessageParams, ToolDefinition, ToolResultMessage} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+
+describe('ToolRegistry input validation acceptance', () => {
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('returns a ToolResponse naming the missing required property and never calls the executor', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Gets weather',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async () => {
+        calls += 1;
+        return 'sunny';
+      }
+    );
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({calls, mentionsLocation: response.result.includes('location')}).toEqual({
+      calls: 0,
+      mentionsLocation: true,
+    });
+  });
+
+  it('rejects a wrong-typed field naming the property and expected type without leaking the offending value into the result or logs', async () => {
+    const logged: string[] = [];
+    const record = (_cat: string, msg: string, fields?: Record<string, unknown>) =>
+      void logged.push(JSON.stringify({msg, fields}));
+    setLogger({debug: record, info: record, warn: record, error: record});
+
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(
+      {
+        name: 'lookup_user',
+        description: 'Looks up user',
+        inputSchema: {
+          type: 'object',
+          properties: {ssn: {type: 'string'}},
+          required: ['ssn'],
+        },
+      },
+      async () => {
+        calls += 1;
+        return 'found';
+      }
+    );
+
+    const secretValue = 987654321;
+    const response = await registry.execute('lookup_user', {ssn: secretValue});
+    const combinedLogs = logged.join(' ');
+
+    expect({
+      calls,
+      namesField: response.result.includes('ssn'),
+      namesType: response.result.includes('string'),
+      leakedInResult: response.result.includes(String(secretValue)),
+      leakedInLogs: combinedLogs.includes(String(secretValue)),
+    }).toEqual({
+      calls: 0,
+      namesField: true,
+      namesType: true,
+      leakedInResult: false,
+      leakedInLogs: false,
+    });
+  });
+
+  it('rejects an uncompilable schema at registration time and names the tool', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_tool',
+          description: 'Has an invalid schema',
+          inputSchema: {type: 'not_a_json_schema_type'},
+        },
+        async () => 'never'
+      )
+    ).toThrow(/broken_tool/);
+  });
+
+  it('validates a function-valued tool definition against the schema current at each call', async () => {
+    const registry = new ToolRegistry();
+    let requiredKey = 'firstKey';
+    const dynamicDefinition = (): ToolDefinition => ({
+      name: 'dynamic_tool',
+      description: 'Changes required property between calls',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          firstKey: {type: 'string'},
+          secondKey: {type: 'string'},
+        },
+        required: [requiredKey],
+      },
+    });
+    let calls = 0;
+    registry.register(dynamicDefinition, async () => {
+      calls += 1;
+      return 'ok';
+    });
+
+    const firstPass = await registry.execute('dynamic_tool', {firstKey: 'valid'});
+    requiredKey = 'secondKey';
+    const secondRejection = await registry.execute('dynamic_tool', {firstKey: 'stale'});
+
+    expect({
+      calls,
+      firstResult: firstPass.result,
+      secondMentionsSecondKey: secondRejection.result.includes('secondKey'),
+    }).toEqual({
+      calls: 1,
+      firstResult: 'ok',
+      secondMentionsSecondKey: true,
+    });
+  });
+
+  it('feeds a schema rejection back to the provider as a tool_result and resolves after a corrected retry', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Gets weather',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async input => `Weather in ${String(input.location)}: 20C`
+    );
+
+    const seenToolResults: string[] = [];
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        const lastMessage = params.messages[params.messages.length - 1];
+        if (lastMessage && Array.isArray(lastMessage.content)) {
+          const toolResultMsg = lastMessage as ToolResultMessage;
+          seenToolResults.push(...toolResultMsg.content.map(entry => entry.content));
+        }
+        round += 1;
+        if (round === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        if (round === 2) {
+          yield {type: 'tool_use', toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Berlin'}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        yield {type: 'text', text: 'Berlin is 20C'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'Weather in Berlin?', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+
+    const reply = await orchestrator.processMessage(session);
+
+    expect({
+      reply,
+      roundOneRejectedLocation: seenToolResults[0]?.includes('location') ?? false,
+      roundTwoSucceeded: seenToolResults[1],
+    }).toEqual({
+      reply: 'Berlin is 20C',
+      roundOneRejectedLocation: true,
+      roundTwoSucceeded: 'Weather in Berlin: 20C',
+    });
+  });
+});