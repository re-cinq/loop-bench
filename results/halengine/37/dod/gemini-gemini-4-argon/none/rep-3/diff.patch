+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+import type {AIProvider, MessageChunk, SendMessageParams, ToolDefinition} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+import {ToolRegistry} from './registry.js';
+
+const WEATHER_TOOL: ToolDefinition = {
+  name: 'get_weather',
+  description: 'Fetches weather for a location',
+  inputSchema: {
+    type: 'object',
+    properties: {
+      location: {type: 'string'},
+    },
+    required: ['location'],
+  },
+};
+
+describe('ToolRegistry input validation acceptance', () => {
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('rejects input that violates a static schema without calling the executor or leaking the offending value to the result or logs', async () => {
+    const loggedLines: string[] = [];
+    const recordLog = (category: string, message: string, fields?: Record<string, unknown>): void => {
+      loggedLines.push(JSON.stringify({category, message, fields}));
+    };
+    const capturingLogger: Logger = {
+      debug: recordLog,
+      info: recordLog,
+      warn: recordLog,
+      error: recordLog,
+    };
+    setLogger(capturingLogger);
+
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(WEATHER_TOOL, async () => {
+      executorCalls += 1;
+
+      return 'ran';
+    });
+
+    const missingResponse = await registry.execute('get_weather', {});
+    const wrongTypeResponse = await registry.execute('get_weather', {location: 987654321});
+    const combinedOutput = [wrongTypeResponse.result, ...loggedLines].join(' ');
+
+    expect({
+      executorCalls,
+      missingResult: missingResponse.result,
+      wrongTypeResult: wrongTypeResponse.result,
+      leakedOffendingValue: combinedOutput.includes('987654321'),
+    }).toEqual({
+      executorCalls: 0,
+      missingResult: expect.stringMatching(/location/i),
+      wrongTypeResult: expect.stringMatching(/location[\s\S]*string|string[\s\S]*location/i),
+      leakedOffendingValue: false,
+    });
+  });
+
+  it('throws at registration time naming the tool when a static inputSchema cannot be compiled', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_tool',
+          description: 'Carries an invalid JSON Schema type',
+          inputSchema: {
+            type: 'not-a-json-schema-type',
+          },
+        },
+        async () => 'ran'
+      )
+    ).toThrow(/broken_tool/);
+  });
+
+  it('validates against the schema returned by a function-valued tool definition on each call rather than a stale cached schema', async () => {
+    const registry = new ToolRegistry();
+    let requiredKey = 'city';
+    let executorCalls = 0;
+
+    registry.register(
+      () => ({
+        name: 'lookup_place',
+        description: 'Looks up a place',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            [requiredKey]: {type: 'string'},
+          },
+          required: [requiredKey],
+        },
+      }),
+      async input => {
+        executorCalls += 1;
+
+        return `found:${String(input.city)}`;
+      }
+    );
+
+    const first = await registry.execute('lookup_place', {city: 'Dublin'});
+    requiredKey = 'country';
+    const second = await registry.execute('lookup_place', {city: 'Dublin'});
+
+    expect({
+      executorCalls,
+      firstResult: first.result,
+      secondResult: second.result,
+    }).toEqual({
+      executorCalls: 1,
+      firstResult: 'found:Dublin',
+      secondResult: expect.stringMatching(/country/),
+    });
+  });
+
+  it('feeds a schema rejection back to the provider as a tool_result and resolves when the model retries with valid input', async () => {
+    const registry = new ToolRegistry();
+    const executorInputs: Array<Record<string, unknown>> = [];
+    registry.register(WEATHER_TOOL, async input => {
+      executorInputs.push(input);
+
+      return `forecast:${String(input.location)}`;
+    });
+
+    let round = 0;
+    let roundTwoToolResult = '';
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        round += 1;
+        if (round === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+
+          return;
+        }
+        if (round === 2) {
+          const {messages} = params;
+          roundTwoToolResult = JSON.stringify(messages[messages.length - 1]);
+          yield {type: 'tool_use', toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Berlin'}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+
+          return;
+        }
+        yield {type: 'text', text: 'Sunny in Berlin'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Test assistant'}), registry);
+    const session: ChatSession = {
+      sessionId: 's-retry',
+      userId: 'u-1',
+      entries: [{role: 'user', content: 'Weather in Berlin?', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+
+    const finalReply = await orchestrator.processMessage(session);
+
+    expect({
+      executorInputs,
+      roundTwoToolResult,
+      finalReply,
+    }).toEqual({
+      executorInputs: [{location: 'Berlin'}],
+      roundTwoToolResult: expect.stringMatching(/location/i),
+      finalReply: 'Sunny in Berlin',
+    });
+  });
+});