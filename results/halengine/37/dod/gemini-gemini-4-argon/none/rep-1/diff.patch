+import {ToolRegistry} from './registry.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {AIProvider, MessageChunk, SendMessageParams, ToolDefinition} from '../../types/ai.js';
+
+const weatherTool: ToolDefinition = {
+  name: 'get_weather',
+  description: 'Get weather for a location',
+  inputSchema: {
+    type: 'object',
+    properties: {
+      location: {type: 'string'},
+      units: {type: 'string', enum: ['celsius', 'fahrenheit']},
+    },
+    required: ['location'],
+  },
+};
+
+describe('ToolRegistry input validation', () => {
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('rejects input missing a required field with a ToolResponse and never invokes the executor', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(weatherTool, async () => {
+      calls += 1;
+      return 'sunny';
+    });
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({called: calls, namesField: response.result.includes('location')}).toEqual({
+      called: 0,
+      namesField: true,
+    });
+  });
+
+  it('rejects a wrong-typed field without echoing the offending value in the response or logs', async () => {
+    const logged: string[] = [];
+    const record = (_c: string, msg: string, fields?: Record<string, unknown>) => {
+      logged.push(`${msg} ${JSON.stringify(fields ?? {})}`);
+    };
+    setLogger({debug: record, info: record, warn: record, error: record});
+
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(weatherTool, async () => {
+      calls += 1;
+      return 'sunny';
+    });
+    const secret = 987654321;
+
+    const response = await registry.execute('get_weather', {location: secret});
+
+    expect({
+      called: calls,
+      namesField: response.result.includes('location'),
+      namesType: response.result.includes('string'),
+      leakedInResult: response.result.includes(String(secret)),
+      leakedInLogs: logged.some(line => line.includes(String(secret))),
+    }).toEqual({
+      called: 0,
+      namesField: true,
+      namesType: true,
+      leakedInResult: false,
+      leakedInLogs: false,
+    });
+  });
+
+  it('throws at registration time for an uncompilable schema and names the tool', () => {
+    const registry = new ToolRegistry();
+    const broken: ToolDefinition = {
+      name: 'broken_tool',
+      description: 'Has an invalid schema',
+      inputSchema: {type: 'not-a-json-schema-type'},
+    };
+
+    expect(() => registry.register(broken, async () => 'ok')).toThrow(/broken_tool/);
+  });
+
+  it('validates a function-valued tool definition against the schema returned on each call', async () => {
+    const registry = new ToolRegistry();
+    let requiredKey = 'first';
+    registry.register(
+      () => ({
+        name: 'dynamic_tool',
+        description: 'Changes schema between calls',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            first: {type: 'string'},
+            second: {type: 'string'},
+          },
+          required: [requiredKey],
+        },
+      }),
+      async () => 'ok'
+    );
+
+    const firstCall = await registry.execute('dynamic_tool', {first: 'a'});
+    requiredKey = 'second';
+    const secondCallMissingSecond = await registry.execute('dynamic_tool', {first: 'a'});
+
+    expect({
+      firstResult: firstCall.result,
+      secondNamesMissing: secondCallMissingSecond.result.includes('second'),
+    }).toEqual({
+      firstResult: 'ok',
+      secondNamesMissing: true,
+    });
+  });
+
+  it('feeds a rejected tool call back to the provider as a tool_result so the next round can recover', async () => {
+    const registry = new ToolRegistry();
+    registry.register(weatherTool, async input => `Forecast for ${String(input.location)}: 20C`);
+    const seenMessages: SendMessageParams['messages'][] = [];
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        seenMessages.push([...params.messages]);
+        round += 1;
+        if (round === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        yield {type: 'tool_use', toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Berlin'}}};
+        if (round === 2) {
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        yield {type: 'text', text: 'Berlin is 20C'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), registry);
+
+    const reply = await orchestrator.processMessage({
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'Weather in Berlin?', timestamp: '2026-01-01T00:00:00.000Z'}],
+    });
+
+    const roundTwoLastMsg = seenMessages[1]?.[seenMessages[1].length - 1];
+    const rejectionText =
+      roundTwoLastMsg && Array.isArray(roundTwoLastMsg.content) && roundTwoLastMsg.content[0]?.type === 'tool_result'
+        ? roundTwoLastMsg.content[0].content
+        : '';
+
+    expect({reply, rejectionMentionsLocation: rejectionText.includes('location')}).toEqual({
+      reply: 'Berlin is 20C',
+      rejectionMentionsLocation: true,
+    });
+  });
+});