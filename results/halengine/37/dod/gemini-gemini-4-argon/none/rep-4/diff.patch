+import {ToolRegistry} from './registry.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {AIProvider, Message, MessageChunk, SendMessageParams, ToolDefinition} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const outcomeOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved').catch((error: Error) => error.message);
+
+describe('ToolRegistry input validation', () => {
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('rejects malformed input with a ToolResponse, never invokes the executor, and never leaks offending values', async () => {
+    const logged: string[] = [];
+    const record = (category: string, message: string, fields?: Record<string, unknown>) => {
+      logged.push(JSON.stringify({category, message, fields}));
+    };
+    setLogger({debug: record, info: record, warn: record, error: record});
+
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Gets weather',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+            units: {type: 'string', enum: ['celsius', 'fahrenheit']},
+          },
+          required: ['location'],
+        },
+      },
+      async () => {
+        calls += 1;
+        return 'sunny';
+      }
+    );
+
+    const missingRequired = await registry.execute('get_weather', {});
+    const secretValue = 987654321;
+    const wrongType = await registry.execute('get_weather', {location: secretValue});
+    const wrongEnum = await registry.execute('get_weather', {location: 'Berlin', units: 'kelvin-secret'});
+
+    expect({
+      calls,
+      mentionsLocation: missingRequired.result.includes('location'),
+      mentionsTypeField: wrongType.result.includes('location'),
+      mentionsExpectedType: wrongType.result.includes('string'),
+      leakedInResult: wrongType.result.includes(String(secretValue)) || wrongEnum.result.includes('kelvin-secret'),
+      leakedInLogs: logged.some(line => line.includes(String(secretValue)) || line.includes('kelvin-secret')),
+    }).toEqual({
+      calls: 0,
+      mentionsLocation: true,
+      mentionsTypeField: true,
+      mentionsExpectedType: true,
+      leakedInResult: false,
+      leakedInLogs: false,
+    });
+  });
+
+  it('passes valid input with extra properties through unchanged and validates against a dynamic schema per call', async () => {
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+    let staticSchemaReads = 0;
+    const staticSchema: Record<string, unknown> = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+    };
+    Object.defineProperty(staticSchema, 'required', {
+      enumerable: true,
+      get() {
+        staticSchemaReads += 1;
+        return ['location'];
+      },
+    });
+
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Gets weather',
+        inputSchema: staticSchema,
+      },
+      async input => {
+        received.push(input);
+        return 'ok';
+      }
+    );
+
+    const validWithExtra = await registry.execute('get_weather', {location: 'Berlin', extra: 42});
+    for (let i = 0; i < 9; i += 1) {
+      await registry.execute('get_weather', {location: 'Berlin'});
+    }
+
+    let requiredKey = 'firstKey';
+    registry.register(
+      (): ToolDefinition => ({
+        name: 'dynamic_tool',
+        description: 'Changes schema between calls',
+        inputSchema: {
+          type: 'object',
+          properties: {[requiredKey]: {type: 'string'}},
+          required: [requiredKey],
+        },
+      }),
+      async () => 'dynamic-ok'
+    );
+
+    const firstDynamic = await registry.execute('dynamic_tool', {firstKey: 'yes'});
+    requiredKey = 'secondKey';
+    const staleDynamic = await registry.execute('dynamic_tool', {firstKey: 'no'});
+    const updatedDynamic = await registry.execute('dynamic_tool', {secondKey: 'yes'});
+
+    expect({
+      validResult: validWithExtra.result,
+      firstReceived: received[0],
+      totalCalls: received.length,
+      staticCompiledOnce: staticSchemaReads === 1,
+      firstDynamic: firstDynamic.result,
+      staleMentionsSecondKey: staleDynamic.result.includes('secondKey'),
+      updatedDynamic: updatedDynamic.result,
+    }).toEqual({
+      validResult: 'ok',
+      firstReceived: {location: 'Berlin', extra: 42},
+      totalCalls: 10,
+      staticCompiledOnce: true,
+      firstDynamic: 'dynamic-ok',
+      staleMentionsSecondKey: true,
+      updatedDynamic: 'dynamic-ok',
+    });
+  });
+
+  it('throws at registration time naming the tool when given an uncompilable schema', () => {
+    const registry = new ToolRegistry();
+    const registerBroken = (): string => {
+      try {
+        registry.register(
+          {
+            name: 'broken_tool',
+            description: 'Has an invalid schema',
+            inputSchema: {type: 'not-a-json-schema-type'},
+          },
+          async () => 'never'
+        );
+        return 'did not throw';
+      } catch (error) {
+        return error instanceof Error ? error.message : String(error);
+      }
+    };
+
+    expect(registerBroken()).toContain('broken_tool');
+  });
+
+  it('feeds a schema rejection back to the provider so a corrected retry resolves processMessage', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Gets weather',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async input => {
+        executorCalls += 1;
+        return `Weather in ${String(input.location)}: 18C`;
+      }
+    );
+
+    const seenMessages: Message[][] = [];
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        seenMessages.push(structuredClone(params.messages));
+        round += 1;
+        if (round === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        if (round === 2) {
+          yield {type: 'tool_use', toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Berlin'}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        yield {type: 'text', text: 'It is 18C in Berlin.'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), registry);
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'Weather in Berlin?', timestamp: SENT_AT}],
+    };
+
+    const reply = await orchestrator.processMessage(session);
+    const roundTwoLastMsg = seenMessages[1]?.[seenMessages[1].length - 1];
+    const firstToolResult =
+      roundTwoLastMsg && Array.isArray(roundTwoLastMsg.content) && roundTwoLastMsg.content[0]?.type === 'tool_result'
+        ? roundTwoLastMsg.content[0].content
+        : '';
+    const unknownOutcome = await outcomeOf(registry.execute('no_such_tool', {}));
+
+    expect({
+      reply,
+      executorCalls,
+      rejectionVisibleToProvider: firstToolResult.includes('location'),
+      unknownOutcome,
+    }).toEqual({
+      reply: 'It is 18C in Berlin.',
+      executorCalls: 1,
+      rejectionVisibleToProvider: true,
+      unknownOutcome: 'Unknown tool: no_such_tool',
+    });
+  });
+});