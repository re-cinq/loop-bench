+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {log, setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+import type {AIProvider, MessageChunk, SendMessageParams, ToolDefinition} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+import {ToolRegistry} from './registry.js';
+
+const WEATHER_TOOL: ToolDefinition = {
+  name: 'get_weather',
+  description: 'Look up weather for a location',
+  inputSchema: {
+    type: 'object',
+    properties: {
+      location: {type: 'string'},
+      units: {type: 'string', enum: ['celsius', 'fahrenheit']},
+    },
+    required: ['location'],
+  },
+};
+
+interface CapturedLog {
+  level: string;
+  category: string;
+  message: string;
+  fields?: Record<string, unknown>;
+}
+
+const captureLogger = (): {entries: CapturedLog[]; restore: () => void} => {
+  const entries: CapturedLog[] = [];
+  const sink: Logger = {
+    debug: (category, message, fields) => entries.push({level: 'debug', category, message, fields}),
+    info: (category, message, fields) => entries.push({level: 'info', category, message, fields}),
+    warn: (category, message, fields) => entries.push({level: 'warn', category, message, fields}),
+    error: (category, message, fields) => entries.push({level: 'error', category, message, fields}),
+  };
+  setLogger(sink);
+  return {entries, restore: () => setLogger(log)};
+};
+
+describe('ToolRegistry input validation', () => {
+  it('rejects a call missing a required field with a ToolResponse and never invokes the executor', async () => {
+    const registry = new ToolRegistry();
+    let invoked = false;
+    registry.register(WEATHER_TOOL, async () => {
+      invoked = true;
+      return 'sunny';
+    });
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({
+      invoked,
+      namesField: response.result.includes('location'),
+    }).toEqual({
+      invoked: false,
+      namesField: true,
+    });
+  });
+
+  it('rejects a wrong-typed field naming the field path and expected type without leaking the value into the result or log', async () => {
+    const registry = new ToolRegistry();
+    let invoked = false;
+    registry.register(WEATHER_TOOL, async () => {
+      invoked = true;
+      return 'sunny';
+    });
+    const secretValue = 987654321;
+    const captured = captureLogger();
+
+    let response;
+    try {
+      response = await registry.execute('get_weather', {location: secretValue});
+    } finally {
+      captured.restore();
+    }
+
+    const serializedLogs = JSON.stringify(captured.entries);
+    const hasWarnLog = captured.entries.some(
+      entry => entry.level === 'warn' && entry.category === 'tool' && JSON.stringify(entry).includes('location')
+    );
+    expect({
+      invoked,
+      namesField: response.result.includes('location'),
+      namesType: response.result.includes('string'),
+      leakedInResult: response.result.includes(String(secretValue)),
+      leakedInLogs: serializedLogs.includes(String(secretValue)),
+      hasWarnLog,
+    }).toEqual({
+      invoked: false,
+      namesField: true,
+      namesType: true,
+      leakedInResult: false,
+      leakedInLogs: false,
+      hasWarnLog: true,
+    });
+  });
+
+  it('throws synchronously at register time naming the tool when a static inputSchema is uncompilable', () => {
+    const registry = new ToolRegistry();
+    const brokenTool: ToolDefinition = {
+      name: 'broken_tool',
+      description: 'Has an invalid schema type',
+      inputSchema: {
+        type: 'not_a_json_schema_type',
+      },
+    };
+
+    expect(() => registry.register(brokenTool, async () => 'ok')).toThrow(/broken_tool/);
+  });
+
+  it('validates each execute call against the schema returned by a function-valued definition at that call', async () => {
+    const registry = new ToolRegistry();
+    let requiredField = 'firstKey';
+    const executedInputs: Record<string, unknown>[] = [];
+    registry.register(
+      () => ({
+        name: 'dynamic_tool',
+        description: 'Changes required field over time',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            firstKey: {type: 'string'},
+            secondKey: {type: 'string'},
+          },
+          required: [requiredField],
+        },
+      }),
+      async input => {
+        executedInputs.push(input);
+        return 'ok';
+      }
+    );
+
+    requiredField = 'secondKey';
+    const rejectedFirstKey = await registry.execute('dynamic_tool', {firstKey: 'alpha'});
+    const acceptedSecondKey = await registry.execute('dynamic_tool', {secondKey: 'beta'});
+
+    expect({
+      executedInputs,
+      rejectedMentionsSecondKey: rejectedFirstKey.result.includes('secondKey'),
+      acceptedResult: acceptedSecondKey.result,
+    }).toEqual({
+      executedInputs: [{secondKey: 'beta'}],
+      rejectedMentionsSecondKey: true,
+      acceptedResult: 'ok',
+    });
+  });
+
+  it('delivers a validation rejection to the model as a tool result so the next round can retry with valid input', async () => {
+    const registry = new ToolRegistry();
+    const executedLocations: string[] = [];
+    registry.register(WEATHER_TOOL, async input => {
+      const location = input.location as string;
+      executedLocations.push(location);
+      return `weather in ${location}`;
+    });
+
+    const rounds: MessageChunk[][] = [
+      [
+        {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Copenhagen'}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'text', text: 'The weather in Copenhagen is ready.'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ];
+    const seenLastMessages: string[] = [];
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        const lastMessage = params.messages[params.messages.length - 1];
+        seenLastMessages.push(JSON.stringify(lastMessage?.content ?? ''));
+        for (const chunk of rounds[round++] ?? []) yield chunk;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const session: ChatSession = {
+      sessionId: 's-validation',
+      userId: 'u-1',
+      entries: [{role: 'user', content: 'Weather please', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const orchestrator = createChatOrchestrator(
+      provider,
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      registry
+    );
+
+    const finalReply = await orchestrator.processMessage(session);
+
+    expect({
+      finalReply,
+      executedLocations,
+      firstResultNamedLocation: seenLastMessages[1]?.includes('location') ?? false,
+      secondResultDelivered: seenLastMessages[2]?.includes('weather in Copenhagen') ?? false,
+    }).toEqual({
+      finalReply: 'The weather in Copenhagen is ready.',
+      executedLocations: ['Copenhagen'],
+      firstResultNamedLocation: true,
+      secondResultDelivered: true,
+    });
+  });
+});