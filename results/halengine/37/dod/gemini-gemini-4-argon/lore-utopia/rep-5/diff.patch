+import {ToolRegistry} from './registry.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {AIProvider, MessageChunk, SendMessageParams, ToolDefinition} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+
+describe('ToolRegistry inputSchema validation acceptance', () => {
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('rejects malformed input without calling the executor or leaking field values', async () => {
+    const loggedLines: string[] = [];
+    const recordLog = (category: string, message: string, fields?: Record<string, unknown>) => {
+      loggedLines.push(JSON.stringify({category, message, fields}));
+    };
+    setLogger({debug: recordLog, info: recordLog, warn: recordLog, error: recordLog});
+
+    const registry = new ToolRegistry();
+    const receivedInputs: Record<string, unknown>[] = [];
+
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Look up weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+            unit: {type: 'string', enum: ['celsius', 'fahrenheit']},
+          },
+          required: ['location'],
+        },
+      },
+      async input => {
+        receivedInputs.push(input);
+        return {result: '72F and sunny'};
+      }
+    );
+
+    const missingLocation = await registry.execute('get_weather', {});
+    const wrongType = await registry.execute('get_weather', {
+      location: 987654321 as unknown as string,
+      unit: 'secret-kelvin-token',
+    });
+    const validWithExtra = await registry.execute('get_weather', {
+      location: 'Amsterdam',
+      unit: 'celsius',
+      extraField: 'preserved',
+    });
+    const combinedLogs = JSON.stringify(loggedLines);
+
+    expect({
+      receivedInputs,
+      missingNamesLocation: missingLocation.result.includes('location'),
+      wrongTypeNamesLocation: wrongType.result.includes('location'),
+      wrongTypeNamesString: wrongType.result.includes('string'),
+      resultLeaksNumber: wrongType.result.includes('987654321'),
+      resultLeaksSecret: wrongType.result.includes('secret-kelvin-token'),
+      logsLeakNumber: combinedLogs.includes('987654321'),
+      logsLeakSecret: combinedLogs.includes('secret-kelvin-token'),
+      validResult: validWithExtra.result,
+    }).toEqual({
+      receivedInputs: [{location: 'Amsterdam', unit: 'celsius', extraField: 'preserved'}],
+      missingNamesLocation: true,
+      wrongTypeNamesLocation: true,
+      wrongTypeNamesString: true,
+      resultLeaksNumber: false,
+      resultLeaksSecret: false,
+      logsLeakNumber: false,
+      logsLeakSecret: false,
+      validResult: '72F and sunny',
+    });
+  });
+
+  it('throws at register time when a static inputSchema is uncompilable, naming the tool', () => {
+    const registry = new ToolRegistry();
+    const invalidSchema = {type: 'not-a-json-schema-type'} as unknown as ToolDefinition['inputSchema'];
+
+    expect(() =>
+      registry.register(
+        {name: 'broken_weather', description: 'Broken schema', inputSchema: invalidSchema},
+        async () => ({result: 'unreachable'})
+      )
+    ).toThrow(/broken_weather/);
+  });
+
+  it('validates a function-valued tool definition against the schema returned for that call', async () => {
+    const registry = new ToolRegistry();
+    const receivedInputs: Record<string, unknown>[] = [];
+    let requiredKey = 'city';
+
+    registry.register(
+      () => ({
+        name: 'scoped_lookup',
+        description: 'Context-sensitive lookup',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            city: {type: 'string'},
+            postalCode: {type: 'string'},
+          },
+          required: [requiredKey],
+        },
+      }),
+      async input => {
+        receivedInputs.push(input);
+        return {result: 'resolved'};
+      }
+    );
+
+    const firstResponse = await registry.execute('scoped_lookup', {city: 'Amsterdam'});
+    requiredKey = 'postalCode';
+    const secondResponse = await registry.execute('scoped_lookup', {city: 'Amsterdam'});
+
+    expect({
+      firstResult: firstResponse.result,
+      secondNamesPostalCode: secondResponse.result.includes('postalCode'),
+      receivedInputs,
+    }).toEqual({
+      firstResult: 'resolved',
+      secondNamesPostalCode: true,
+      receivedInputs: [{city: 'Amsterdam'}],
+    });
+  });
+
+  it('delivers a validation rejection as a tool_result so a corrected retry succeeds', async () => {
+    const registry = new ToolRegistry();
+    const receivedInputs: Record<string, unknown>[] = [];
+
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async input => {
+        receivedInputs.push(input);
+        return {result: `Sunny in ${String(input.location)}`};
+      }
+    );
+
+    const recordedParams: SendMessageParams[] = [];
+    const rounds: MessageChunk[][] = [
+      [
+        {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {
+          type: 'tool_use',
+          toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Amsterdam'}},
+        },
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'text', text: 'It is sunny in Amsterdam.'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ];
+    let roundCursor = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        recordedParams.push({...params, messages: [...params.messages]});
+        const chunks = rounds[roundCursor] ?? [];
+        roundCursor += 1;
+        for (const chunk of chunks) {
+          yield chunk;
+        }
+      },
+      generateStructured: <T>() => Promise.reject<T>(new Error('unused')),
+    };
+
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'You are HAL.'}), registry);
+    const session: ChatSession = {
+      sessionId: 'session-1',
+      userId: 'user-1',
+      entries: [{role: 'user', content: 'Weather in Amsterdam?', timestamp: '2026-01-01T00:00:00Z'}],
+    };
+
+    const reply = await orchestrator.processMessage(session);
+    const secondRoundParams = recordedParams[1];
+    const secondRoundMessages = secondRoundParams ? secondRoundParams.messages : [];
+    const toolResultMessage = secondRoundMessages[secondRoundMessages.length - 1];
+    const contentBlocks = Array.isArray(toolResultMessage?.content) ? toolResultMessage.content : [];
+    const firstBlock = contentBlocks[0];
+    const rejectionText = firstBlock?.type === 'tool_result' ? firstBlock.content : '';
+
+    expect({
+      reply,
+      receivedInputs,
+      rejectionNamesLocation: rejectionText.includes('location'),
+    }).toEqual({
+      reply: 'It is sunny in Amsterdam.',
+      receivedInputs: [{location: 'Amsterdam'}],
+      rejectionNamesLocation: true,
+    });
+  });
+});