+import {ToolRegistry} from './registry.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {AIProvider, Message, MessageChunk, SendMessageParams} from '../../types/ai.js';
+
+describe('ToolRegistry inputSchema validation acceptance', () => {
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('returns a ToolResponse naming the missing required field and does not invoke the executor', async () => {
+    const registry = new ToolRegistry();
+    let invocations = 0;
+    registry.register(
+      {
+        name: 'weather',
+        description: 'gets forecast',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async () => {
+        invocations += 1;
+        return 'sunny';
+      }
+    );
+
+    const response = await registry.execute('weather', {});
+
+    expect({invocations, mentionsLocation: response.result.includes('location')}).toEqual({
+      invocations: 0,
+      mentionsLocation: true,
+    });
+  });
+
+  it('rejects a wrong-typed field naming the property path and expected type without leaking any input value', async () => {
+    const logged: string[] = [];
+    const collect = (category: string, message: string, fields?: Record<string, unknown>) => {
+      logged.push(JSON.stringify({category, message, fields}));
+    };
+    setLogger({debug: collect, info: collect, warn: collect, error: collect});
+
+    const registry = new ToolRegistry();
+    let invocations = 0;
+    registry.register(
+      {
+        name: 'lookup_patient',
+        description: 'looks up record',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            ssn: {type: 'string'},
+            age: {type: 'string'},
+          },
+          required: ['ssn', 'age'],
+        },
+      },
+      async () => {
+        invocations += 1;
+        return 'ok';
+      }
+    );
+
+    const response = await registry.execute('lookup_patient', {ssn: 'SECRET-SSN-999-00-1234', age: 42857});
+    const combinedOutput = [response.result, ...logged].join(' ');
+
+    expect({
+      invocations,
+      namesField: response.result.includes('age'),
+      namesType: response.result.includes('string'),
+      leaksStringSecret: combinedOutput.includes('SECRET-SSN-999-00-1234'),
+      leaksOffendingNumber: combinedOutput.includes('42857'),
+    }).toEqual({
+      invocations: 0,
+      namesField: true,
+      namesType: true,
+      leaksStringSecret: false,
+      leaksOffendingNumber: false,
+    });
+  });
+
+  it('throws synchronously at register time when the inputSchema is uncompilable and names the tool', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_weather',
+          description: 'has invalid schema',
+          inputSchema: {type: 'not-a-json-schema-type'},
+        },
+        async () => 'never'
+      )
+    ).toThrow(/broken_weather/);
+  });
+
+  it('feeds a rejected tool call back to the provider as a tool_result so a corrected retry resolves processMessage', async () => {
+    const registry = new ToolRegistry();
+    const receivedLocations: unknown[] = [];
+    registry.register(
+      {
+        name: 'weather',
+        description: 'gets forecast',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async input => {
+        receivedLocations.push(input.location);
+        return `72F in ${String(input.location)}`;
+      }
+    );
+
+    const seenMessagesByRound: Message[][] = [];
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        seenMessagesByRound.push(structuredClone(params.messages));
+        round += 1;
+        if (round === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'call-1', name: 'weather', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        if (round === 2) {
+          yield {type: 'tool_use', toolCall: {id: 'call-2', name: 'weather', input: {location: 'Amsterdam'}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        yield {type: 'text', text: 'It is 72F in Amsterdam.'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      provider,
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      registry
+    );
+
+    const finalReply = await orchestrator.processMessage({
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'Weather in Amsterdam?', timestamp: '2026-01-01T00:00:00.000Z'}],
+    });
+
+    const roundTwoLastMessage = seenMessagesByRound[1]?.[seenMessagesByRound[1].length - 1];
+    const firstRoundToolResult =
+      roundTwoLastMessage &&
+      Array.isArray(roundTwoLastMessage.content) &&
+      roundTwoLastMessage.content[0]?.type === 'tool_result'
+        ? roundTwoLastMessage.content[0].content
+        : '';
+
+    expect({
+      finalReply,
+      receivedLocations,
+      rejectionMentionsLocation: firstRoundToolResult.includes('location'),
+    }).toEqual({
+      finalReply: 'It is 72F in Amsterdam.',
+      receivedLocations: ['Amsterdam'],
+      rejectionMentionsLocation: true,
+    });
+  });
+});