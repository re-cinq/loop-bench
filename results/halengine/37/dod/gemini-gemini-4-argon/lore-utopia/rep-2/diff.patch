+import {ToolRegistry} from './registry.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, SendMessageParams, ToolDefinition} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+
+const weatherTool: ToolDefinition = {
+  name: 'weather',
+  description: 'gets forecast',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}},
+    required: ['location'],
+  },
+};
+
+describe('ToolRegistry input validation', () => {
+  it('returns a ToolResponse naming the missing required field and does not invoke the executor', async () => {
+    const {registry, getCalls} = createCountingWeatherRegistry();
+
+    const response = await registry.execute('weather', {});
+
+    expect({calls: getCalls(), mentionsLocation: response.result.includes('location')}).toEqual({
+      calls: 0,
+      mentionsLocation: true,
+    });
+  });
+
+  it('rejects a wrong-typed field naming the field path and expected type without the offending value', async () => {
+    const {registry, getCalls} = createCountingWeatherRegistry();
+
+    const response = await registry.execute('weather', {location: 987654321});
+
+    expect({
+      calls: getCalls(),
+      mentionsLocation: response.result.includes('location'),
+      mentionsType: response.result.includes('string'),
+      leaksValue: response.result.includes('987654321'),
+    }).toEqual({
+      calls: 0,
+      mentionsLocation: true,
+      mentionsType: true,
+      leaksValue: false,
+    });
+  });
+
+  it('throws at register time when the inputSchema is uncompilable and names the tool', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken-tool',
+          description: 'invalid schema',
+          inputSchema: {type: 'not-a-json-schema-type'},
+        },
+        async () => 'never'
+      )
+    ).toThrow(/broken-tool/);
+  });
+
+  it('resolves processMessage after a rejected tool call is retried with valid input on the next round', async () => {
+    const registry = new ToolRegistry();
+    registry.register(weatherTool, async input => `forecast for ${String(input.location)}`);
+
+    const seenByProvider: SendMessageParams[] = [];
+    let round = 0;
+    const rounds: MessageChunk[][] = [
+      [
+        {type: 'tool_use', toolCall: {id: 'call-1', name: 'weather', input: {}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'call-2', name: 'weather', input: {location: 'Amsterdam'}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'text', text: 'Forecast is ready'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ];
+
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        seenByProvider.push({
+          ...params,
+          messages: [...params.messages],
+        });
+        for (const chunk of rounds[round++] ?? []) yield chunk;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      provider,
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      registry
+    );
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'weather please', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+
+    const reply = await orchestrator.processMessage(session);
+    const secondRoundMessages = JSON.stringify(seenByProvider[1]?.messages ?? []);
+
+    expect({
+      reply,
+      rejectionReachedProvider: secondRoundMessages.includes('location'),
+    }).toEqual({
+      reply: 'Forecast is ready',
+      rejectionReachedProvider: true,
+    });
+  });
+});
+
+function createCountingWeatherRegistry(): {registry: ToolRegistry; getCalls: () => number} {
+  const registry = new ToolRegistry();
+  let calls = 0;
+  registry.register(weatherTool, async () => {
+    calls += 1;
+    return 'sunny';
+  });
+  return {registry, getCalls: () => calls};
+}