+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+
+describe('ToolRegistry input validation', () => {
+  it('returns a ToolResponse naming the missing required field and does not invoke the executor', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async () => {
+        calls += 1;
+        return 'sunny';
+      }
+    );
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({calls, mentionsLocation: response.result.includes('location')}).toEqual({
+      calls: 0,
+      mentionsLocation: true,
+    });
+  });
+
+  it('rejects a wrong-typed field naming the field path and expected type while omitting the offending value from the result and logs', async () => {
+    const logged: string[] = [];
+    const record = (category: string, message: string, fields?: Record<string, unknown>) => {
+      logged.push(JSON.stringify({category, message, fields}));
+    };
+    const logger: Logger = {debug: record, info: record, warn: record, error: record};
+    setLogger(logger);
+
+    try {
+      const registry = new ToolRegistry();
+      let calls = 0;
+      registry.register(
+        {
+          name: 'lookup_customer',
+          description: 'Lookup customer',
+          inputSchema: {type: 'object', properties: {ssn: {type: 'number'}}, required: ['ssn']},
+        },
+        async () => {
+          calls += 1;
+          return 'ok';
+        }
+      );
+
+      const secret = 'ssn-secret-987-65-4321';
+      const response = await registry.execute('lookup_customer', {ssn: secret});
+      const allLogs = logged.join(' ');
+
+      expect({
+        calls,
+        namesField: response.result.includes('ssn'),
+        namesType: response.result.includes('number'),
+        leakedInResult: response.result.includes(secret),
+        leakedInLogs: allLogs.includes(secret),
+      }).toEqual({
+        calls: 0,
+        namesField: true,
+        namesType: true,
+        leakedInResult: false,
+        leakedInLogs: false,
+      });
+    } finally {
+      setLogger();
+    }
+  });
+
+  it('throws at register time when the inputSchema is uncompilable and names the tool', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_tool',
+          description: 'Broken schema',
+          inputSchema: {type: 'not-a-json-schema-type'},
+        },
+        async () => 'ok'
+      )
+    ).toThrow(/broken_tool/);
+  });
+});