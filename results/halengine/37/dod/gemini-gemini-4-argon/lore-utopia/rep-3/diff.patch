+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+import {setLogger} from '../../shared/logger.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import type {AIProvider, Message, MessageChunk, SendMessageParams} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+
+const weatherTool: ToolDefinition = {
+  name: 'get_weather',
+  description: 'Get the current weather for a location.',
+  inputSchema: {
+    type: 'object',
+    properties: {
+      location: {type: 'string'},
+      units: {type: 'string', enum: ['celsius', 'fahrenheit']},
+    },
+    required: ['location'],
+  },
+};
+
+describe('ToolRegistry input validation', () => {
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('rejects a call missing a required field with a ToolResponse and never invokes the executor', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(weatherTool, async () => {
+      calls += 1;
+      return 'sunny';
+    });
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({calls, mentionsLocation: response.result.includes('location')}).toEqual({
+      calls: 0,
+      mentionsLocation: true,
+    });
+  });
+
+  it('rejects a wrong-typed field without leaking the offending value in the response or logs, and passes valid input with extra properties unchanged', async () => {
+    const logged: string[] = [];
+    const record = (category: string, message: string, fields?: Record<string, unknown>) =>
+      void logged.push(JSON.stringify({category, message, fields}));
+    setLogger({debug: record, info: record, warn: record, error: record});
+
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+    registry.register(weatherTool, async input => {
+      received.push(input);
+      return 'ok';
+    });
+
+    const secretValue = 'secret-ssn-999-00-1234';
+    const rejected = await registry.execute('get_weather', {location: 12345, units: secretValue});
+    const accepted = await registry.execute('get_weather', {location: 'Berlin', extraKey: 'kept'});
+
+    expect({
+      received,
+      acceptedResult: accepted.result,
+      mentionsLocation: rejected.result.includes('location'),
+      mentionsString: rejected.result.includes('string'),
+      leakedNumberInResult: rejected.result.includes('12345'),
+      leakedSecretInResult: rejected.result.includes(secretValue),
+      leakedSecretInLogs: logged.some(line => line.includes(secretValue) || line.includes('12345')),
+    }).toEqual({
+      received: [{location: 'Berlin', extraKey: 'kept'}],
+      acceptedResult: 'ok',
+      mentionsLocation: true,
+      mentionsString: true,
+      leakedNumberInResult: false,
+      leakedSecretInResult: false,
+      leakedSecretInLogs: false,
+    });
+  });
+
+  it('throws at register time naming the tool for an uncompilable static schema and validates function-valued definitions against the current call schema', async () => {
+    const registry = new ToolRegistry();
+    let thrownMessage = '';
+    try {
+      registry.register(
+        {
+          name: 'broken_tool',
+          description: 'Has an invalid schema.',
+          inputSchema: {type: 'not-a-json-schema-type'},
+        },
+        async () => 'never'
+      );
+    } catch (error) {
+      thrownMessage = error instanceof Error ? error.message : String(error);
+    }
+
+    let requiredField = 'first_key';
+    registry.register(
+      () => ({
+        name: 'dynamic_tool',
+        description: 'Changes schema between calls.',
+        inputSchema: {
+          type: 'object',
+          properties: {[requiredField]: {type: 'string'}},
+          required: [requiredField],
+        },
+      }),
+      async () => 'dynamic-ok'
+    );
+
+    const firstCall = await registry.execute('dynamic_tool', {first_key: 'a'});
+    requiredField = 'second_key';
+    const staleCall = await registry.execute('dynamic_tool', {first_key: 'a'});
+    const updatedCall = await registry.execute('dynamic_tool', {second_key: 'b'});
+
+    expect({
+      threwWithName: thrownMessage.includes('broken_tool'),
+      firstResult: firstCall.result,
+      staleMentionsSecond: staleCall.result.includes('second_key'),
+      updatedResult: updatedCall.result,
+    }).toEqual({
+      threwWithName: true,
+      firstResult: 'dynamic-ok',
+      staleMentionsSecond: true,
+      updatedResult: 'dynamic-ok',
+    });
+  });
+
+  it('returns the schema rejection to the model as a tool_result on the next round so the orchestrator loop recovers on retry', async () => {
+    const registry = new ToolRegistry();
+    registry.register(weatherTool, async input => `Forecast for ${String(input.location)}: 18C`);
+
+    const seenMessagesByRound: Message[][] = [];
+    const rounds: MessageChunk[][] = [
+      [
+        {type: 'tool_use', toolCall: {id: 'call-bad', name: 'get_weather', input: {}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'call-good', name: 'get_weather', input: {location: 'Berlin'}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'text', text: 'It is 18C in Berlin.'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ];
+    let roundIndex = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        seenMessagesByRound.push(structuredClone(params.messages));
+        for (const chunk of rounds[roundIndex++] ?? []) yield chunk;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      provider,
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      registry
+    );
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'Weather in Berlin?', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+
+    const reply = await orchestrator.processMessage(session);
+    const secondRoundLastMessage = seenMessagesByRound[1]?.[seenMessagesByRound[1].length - 1];
+    const firstRejectionText =
+      secondRoundLastMessage && Array.isArray(secondRoundLastMessage.content)
+        ? secondRoundLastMessage.content[0]?.type === 'tool_result'
+          ? secondRoundLastMessage.content[0].content
+          : ''
+        : '';
+
+    expect({
+      reply,
+      rejectionReachedModel: firstRejectionText.includes('location'),
+    }).toEqual({
+      reply: 'It is 18C in Berlin.',
+      rejectionReachedModel: true,
+    });
+  });
+});