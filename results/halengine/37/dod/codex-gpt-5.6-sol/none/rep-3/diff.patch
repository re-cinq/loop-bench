+import {ToolRegistry} from './registry.js';
+
+const WEATHER_SCHEMA = {
+  type: 'object',
+  properties: {
+    location: {type: 'string'},
+    units: {type: 'string', enum: ['metric', 'imperial']},
+  },
+  required: ['location'],
+};
+
+describe('ToolRegistry input validation', () => {
+  it('returns actionable, value-safe rejections and passes accepted input through unchanged', async () => {
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+    registry.register({name: 'weather', description: 'Gets weather', inputSchema: WEATHER_SCHEMA}, async input => {
+      received.push(input);
+      return 'forecast';
+    });
+
+    const missing = await registry.execute('weather', {});
+    expect({result: missing.result, received}).toEqual({
+      result: expect.stringMatching(/location.*required|required.*location/i),
+      received: [],
+    });
+
+    const identifyingValue = 'Ada Lovelace at 12 St James Square';
+    const wrongType = await registry.execute('weather', {location: identifyingValue, units: 7});
+    expect({result: wrongType.result, leaksValue: wrongType.result.includes(identifyingValue), received}).toEqual({
+      result: expect.stringMatching(/units.*string|string.*units/i),
+      leaksValue: false,
+      received: [],
+    });
+
+    const wrongEnum = await registry.execute('weather', {location: 'Berlin', units: 'kelvin'});
+    expect({result: wrongEnum.result, leaksValue: wrongEnum.result.includes('kelvin'), received}).toEqual({
+      result: expect.stringMatching(/units.*(enum|allowed)|(?:enum|allowed).*units/i),
+      leaksValue: false,
+      received: [],
+    });
+
+    const accepted = {location: 'Berlin', units: 'metric', requestId: 'r-37'};
+    const response = await registry.execute('weather', accepted);
+    expect({response, received, sameInput: received[0] === accepted}).toEqual({
+      response: {result: 'forecast'},
+      received: [accepted],
+      sameInput: true,
+    });
+
+    await expect(registry.execute('not-registered', {})).rejects.toThrow('Unknown tool: not-registered');
+  });
+
+  it('compiles a static schema at registration and reuses it across executions', async () => {
+    let schemaReads = 0;
+    const trackedSchema: Record<string, unknown> = {
+      get type() {
+        schemaReads += 1;
+        return 'object';
+      },
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    const registry = new ToolRegistry();
+    registry.register({name: 'weather', description: 'Gets weather', inputSchema: trackedSchema}, async () => 'ok');
+
+    expect(schemaReads).toBeGreaterThan(0);
+    const readsAfterRegistration = schemaReads;
+    for (let call = 0; call < 10; call += 1) {
+      await expect(registry.execute('weather', {location: 'Berlin'})).resolves.toEqual({result: 'ok'});
+    }
+    expect(schemaReads).toBe(readsAfterRegistration);
+
+    expect(() =>
+      registry.register(
+        {name: 'broken-weather', description: 'Broken schema', inputSchema: {type: 'not-a-json-schema-type'}},
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken-weather/i);
+  });
+
+  it('validates each function-valued definition against the schema resolved for that call', async () => {
+    let expectsNumber = false;
+    let executions = 0;
+    const registry = new ToolRegistry();
+    registry.register(
+      () => ({
+        name: 'lookup',
+        description: 'Looks up a value',
+        inputSchema: {
+          type: 'object',
+          properties: {query: {type: expectsNumber ? 'number' : 'string'}},
+          required: ['query'],
+        },
+      }),
+      async () => {
+        executions += 1;
+        return 'found';
+      }
+    );
+
+    await expect(registry.execute('lookup', {query: 'first'})).resolves.toEqual({result: 'found'});
+    expectsNumber = true;
+    const staleInput = await registry.execute('lookup', {query: 'second'});
+    expect(staleInput.result).toMatch(/query.*number|number.*query/i);
+    expect(executions).toBe(1);
+    await expect(registry.execute('lookup', {query: 2})).resolves.toEqual({result: 'found'});
+    expect(executions).toBe(2);
+  });
+});