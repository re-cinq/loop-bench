@@ -0,0 +1,192 @@
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+import {ToolRegistry} from './registry.js';
+
+const locationTool = {
+  name: 'weather',
+  description: 'Looks up weather',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}, units: {type: 'string', enum: ['metric', 'imperial']}},
+    required: ['location'],
+  },
+};
+
+const outcomeOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved without throwing').catch((error: Error) => error.message);
+
+describe('ToolRegistry input validation acceptance', () => {
+  it('rejects invalid private input before execution and passes valid extra properties through unchanged', async () => {
+    const lines: string[] = [];
+    const logger: Logger = {
+      debug: (_category, message, fields) => lines.push(JSON.stringify({message, fields})),
+      info: (_category, message, fields) => lines.push(JSON.stringify({message, fields})),
+      warn: (_category, message, fields) => lines.push(JSON.stringify({message, fields})),
+      error: (_category, message, fields) => lines.push(JSON.stringify({message, fields})),
+    };
+    setLogger(logger);
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+    registry.register(locationTool, async input => {
+      received.push(input);
+      return `forecast for ${String(input.location)}`;
+    });
+    const identifyingValue = 'Ada Lovelace at 10 Downing Street';
+
+    try {
+      const missing = await registry.execute('weather', {customer: identifyingValue});
+      const wrongType = await registry.execute('weather', {location: 52, customer: identifyingValue});
+      const valid = {location: 'Berlin', units: 'metric', unlisted: {keep: true}};
+      const accepted = await registry.execute('weather', valid);
+      const rejectionText = `${missing.result}\n${wrongType.result}`;
+
+      expect({
+        executorInputs: received,
+        accepted,
+        requiredNamed: /location.*required|required.*location/i.test(missing.result),
+        typeNamed: /location.*string|string.*location/i.test(wrongType.result),
+        leaksValue: `${rejectionText}\n${lines.join('\n')}`.includes(identifyingValue),
+      }).toEqual({
+        executorInputs: [valid],
+        accepted: {result: 'forecast for Berlin'},
+        requiredNamed: true,
+        typeNamed: true,
+        leaksValue: false,
+      });
+    } finally {
+      setLogger();
+    }
+  });
+
+  it('rejects a broken schema when registering its named tool and preserves the unknown-tool error', async () => {
+    const registry = new ToolRegistry();
+    const unknown = await outcomeOf(registry.execute('absent', {}));
+    let registration = 'did not throw';
+
+    try {
+      registry.register(
+        {name: 'broken-weather', description: 'broken', inputSchema: {type: 'not-a-json-schema-type'}},
+        async () => 'unused'
+      );
+    } catch (error) {
+      registration = error instanceof Error ? error.message : String(error);
+    }
+
+    expect({unknown, registrationNamesTool: registration.includes('broken-weather'), registration}).toEqual({
+      unknown: 'Unknown tool: absent',
+      registrationNamesTool: true,
+      registration: expect.not.stringMatching('did not throw'),
+    });
+  });
+
+  it('keeps using the schema compiled when a static tool was registered', async () => {
+    const schema = {type: 'object', properties: {location: {type: 'string'}}, required: ['location']};
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register({...locationTool, inputSchema: schema}, async () => {
+      calls += 1;
+      return 'ok';
+    });
+
+    const first = await registry.execute('weather', {location: 'Berlin'});
+    schema.properties.location.type = 'number';
+    const remaining = await Promise.all(
+      Array.from({length: 9}, () => registry.execute('weather', {location: 'Berlin'}))
+    );
+    const rejectedAfterMutation = await registry.execute('weather', {location: 52});
+
+    expect({results: [first, ...remaining], calls, rejectedAfterMutation}).toEqual({
+      results: Array.from({length: 10}, () => ({result: 'ok'})),
+      calls: 10,
+      rejectedAfterMutation: {result: expect.stringMatching(/location.*string|string.*location/i)},
+    });
+  });
+
+  it('validates each function-valued definition against the schema resolved for that call', async () => {
+    const registry = new ToolRegistry();
+    let resolution = 0;
+    let calls = 0;
+    registry.register(
+      () => ({
+        name: 'changing',
+        description: 'Changes its accepted input',
+        inputSchema: {
+          type: 'object',
+          properties: {value: {type: resolution++ === 0 ? 'string' : 'number'}},
+          required: ['value'],
+        },
+      }),
+      async () => {
+        calls += 1;
+        return 'accepted';
+      }
+    );
+
+    const accepted = await registry.execute('changing', {value: 42});
+    const rejected = await registry.execute('changing', {value: 42});
+
+    expect({accepted, rejected, calls}).toEqual({
+      accepted: {result: 'accepted'},
+      rejected: {result: expect.stringMatching(/value.*string|string.*value/i)},
+      calls: 1,
+    });
+  });
+
+  it('returns a rejection to the model so it can correct the call within the tool loop', async () => {
+    const seenRequests: SendMessageParams[] = [];
+    const provider: AIProvider = {
+      async *sendMessage(params): AsyncGenerator<MessageChunk> {
+        seenRequests.push(structuredClone(params));
+        if (seenRequests.length === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'bad', name: 'weather', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        if (seenRequests.length === 2) {
+          yield {type: 'tool_use', toolCall: {id: 'fixed', name: 'weather', input: {location: 'Berlin'}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        yield {type: 'text', text: 'forecast delivered'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        throw new Error('not used');
+      },
+    };
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(locationTool, async () => {
+      calls += 1;
+      return 'sunny';
+    });
+    const session: ChatSession = {
+      sessionId: 'validation-session',
+      userId: 'user',
+      entries: [{role: 'user', content: 'weather?', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Test assistant'}), registry);
+
+    const result = await orchestrator.processMessage(session);
+    const retryInput = seenRequests[1]?.messages.at(-1);
+
+    expect({result, calls, retryInput}).toEqual({
+      result: 'forecast delivered',
+      calls: 1,
+      retryInput: {
+        role: 'user',
+        content: [
+          {
+            type: 'tool_result',
+            toolUseId: 'bad',
+            content: expect.stringMatching(/location.*required|required.*location/i),
+          },
+        ],
+      },
+    });
+  });
+});