@@ -0,0 +1,141 @@
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+import type {ToolDefinition} from '../../types/ai.js';
+import {ToolRegistry} from './registry.js';
+
+const definition = (inputSchema: Record<string, unknown>): ToolDefinition => ({
+  name: 'weather',
+  description: 'Returns the weather for a location',
+  inputSchema,
+});
+
+const locationSchema = {
+  type: 'object',
+  properties: {location: {type: 'string'}, units: {type: 'string', enum: ['metric', 'imperial']}},
+  required: ['location'],
+};
+
+const errorMessage = async (run: () => unknown | Promise<unknown>): Promise<string> => {
+  try {
+    await run();
+    return 'did not throw';
+  } catch (error) {
+    return error instanceof Error ? error.message : String(error);
+  }
+};
+
+describe('ToolRegistry input-schema contract', () => {
+  afterEach(() => setLogger());
+
+  it('rejects missing and wrong-typed input without executing or disclosing values', async () => {
+    const lines: string[] = [];
+    const logger: Logger = {
+      debug: (_category, _message, fields) => lines.push(JSON.stringify(fields)),
+      info: (_category, _message, fields) => lines.push(JSON.stringify(fields)),
+      warn: (_category, _message, fields) => lines.push(JSON.stringify(fields)),
+      error: (_category, _message, fields) => lines.push(JSON.stringify(fields)),
+    };
+    setLogger(logger);
+    let executions = 0;
+    const registry = new ToolRegistry();
+    registry.register(definition(locationSchema), async () => {
+      executions += 1;
+      return 'executor ran';
+    });
+
+    const missing = await registry.execute('weather', {});
+    const identifyingValue = 'Ada Lovelace at 12 Example Street';
+    const wrongType = await registry.execute('weather', {location: 42, customer: identifyingValue});
+    const wrongEnum = await registry.execute('weather', {location: 'Berlin', units: 'kelvin'});
+
+    expect({
+      missing: missing.result,
+      wrongType: wrongType.result,
+      wrongEnum: wrongEnum.result,
+      executions,
+      leakedInResult: `${missing.result} ${wrongType.result} ${wrongEnum.result}`.includes(identifyingValue),
+      leakedInLogs: lines.some(line => line.includes(identifyingValue)),
+    }).toEqual({
+      missing: expect.stringMatching(/location.*required|required.*location/i),
+      wrongType: expect.stringMatching(/location.*string|string.*location/i),
+      wrongEnum: expect.stringMatching(/units.*enum|enum.*units/i),
+      executions: 0,
+      leakedInResult: false,
+      leakedInLogs: false,
+    });
+  });
+
+  it('compiles schemas at the correct lifecycle and preserves accepted input', async () => {
+    const invalidRegistry = new ToolRegistry();
+    const invalidRegistration = await errorMessage(() => {
+      invalidRegistry.register(definition({type: 'not-a-json-schema-type'}), async () => 'unused');
+    });
+
+    let schemaReads = 0;
+    const staticSchema = new Proxy(locationSchema, {
+      get(target, property, receiver) {
+        schemaReads += 1;
+        return Reflect.get(target, property, receiver);
+      },
+      ownKeys(target) {
+        schemaReads += 1;
+        return Reflect.ownKeys(target);
+      },
+    });
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+    registry.register(definition(staticSchema), async input => {
+      received.push(input);
+      return 'ok';
+    });
+    const readsAfterRegistration = schemaReads;
+    const input = {location: 'Berlin', units: 'metric'};
+    const results = await Promise.all(Array.from({length: 10}, () => registry.execute('weather', input)));
+
+    expect({
+      invalidRegistration,
+      readsAfterRegistration,
+      schemaReads,
+      results: results.map(result => result.result),
+      received,
+    }).toEqual({
+      invalidRegistration: expect.stringMatching(/weather/i),
+      readsAfterRegistration: expect.any(Number),
+      schemaReads: readsAfterRegistration,
+      results: Array.from({length: 10}, () => 'ok'),
+      received: Array.from({length: 10}, () => input),
+    });
+  });
+
+  it('uses each function-valued definition current at that call and keeps unknown-name errors', async () => {
+    let requireLocation = true;
+    let executions = 0;
+    const registry = new ToolRegistry();
+    registry.register(
+      () =>
+        definition(
+          requireLocation
+            ? locationSchema
+            : {type: 'object', properties: {postalCode: {type: 'string'}}, required: ['postalCode']}
+        ),
+      async () => {
+        executions += 1;
+        return 'ok';
+      }
+    );
+
+    const first = await registry.execute('weather', {location: 'Berlin'});
+    requireLocation = false;
+    const staleInput = await registry.execute('weather', {location: 'Berlin'});
+    const currentInput = await registry.execute('weather', {postalCode: '10115'});
+    const unknown = await errorMessage(() => registry.execute('not-registered', {}));
+
+    expect({first, staleInput, currentInput, executions, unknown}).toEqual({
+      first: {result: 'ok'},
+      staleInput: {result: expect.stringMatching(/postalCode.*required|required.*postalCode/i)},
+      currentInput: {result: 'ok'},
+      executions: 2,
+      unknown: 'Unknown tool: not-registered',
+    });
+  });
+});