@@ -0,0 +1,90 @@
+import {ToolRegistry} from './registry.js';
+
+const weatherDefinition = {
+  name: 'weather',
+  description: 'Looks up weather by location and units',
+  inputSchema: {
+    type: 'object',
+    properties: {
+      location: {type: 'string'},
+      units: {type: 'string', enum: ['metric', 'imperial']},
+    },
+    required: ['location'],
+  },
+};
+
+describe('ToolRegistry input validation', () => {
+  it('validates model input before invoking a tool and preserves valid input', async () => {
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+    registry.register(weatherDefinition, async input => {
+      received.push(input);
+      return 'forecast';
+    });
+
+    const identifyingValue = 'Ada Lovelace at 10 Downing Street';
+    const missing = await registry.execute('weather', {note: identifyingValue});
+    const wrongType = await registry.execute('weather', {location: 52, note: identifyingValue});
+    const wrongEnum = await registry.execute('weather', {
+      location: 'Berlin',
+      units: identifyingValue,
+      note: identifyingValue,
+    });
+
+    expect({
+      results: [missing.result, wrongType.result, wrongEnum.result],
+      executorCallsBeforeValidInput: received.length,
+      leaksRejectedValue: [missing.result, wrongType.result, wrongEnum.result].some(result =>
+        result.includes(identifyingValue)
+      ),
+    }).toEqual({
+      results: [
+        expect.stringMatching(/location.*required|required.*location/i),
+        expect.stringMatching(/location.*string|string.*location/i),
+        expect.stringMatching(/units.*enum|enum.*units|units.*allowed|allowed.*units/i),
+      ],
+      executorCallsBeforeValidInput: 0,
+      leaksRejectedValue: false,
+    });
+
+    const validInput = {location: 'Berlin', units: 'metric', traceId: 'kept-verbatim'};
+    await expect(registry.execute('weather', validInput)).resolves.toEqual({result: 'forecast'});
+    expect(received).toEqual([validInput]);
+    await expect(registry.execute('not-registered', {})).rejects.toThrow('Unknown tool: not-registered');
+  });
+
+  it('compiles static schemas at registration and resolves dynamic schemas per call', async () => {
+    const registry = new ToolRegistry();
+    const brokenDefinition = {
+      name: 'broken-tool',
+      description: 'Has an invalid schema',
+      inputSchema: {type: 'not-a-json-schema-type'},
+    };
+
+    expect(() => registry.register(brokenDefinition, async () => 'never')).toThrow(/broken-tool/i);
+
+    let expectsNumber = false;
+    registry.register(
+      () => ({
+        name: 'dynamic-tool',
+        description: 'Changes its accepted value type per call',
+        inputSchema: {
+          type: 'object',
+          properties: {value: {type: expectsNumber ? 'number' : 'string'}},
+          required: ['value'],
+        },
+      }),
+      async () => 'accepted'
+    );
+
+    await expect(registry.execute('dynamic-tool', {value: 'first'})).resolves.toEqual({result: 'accepted'});
+    expectsNumber = true;
+    const staleSchemaProbe = await registry.execute('dynamic-tool', {value: 'still-a-string'});
+    const currentSchemaProbe = await registry.execute('dynamic-tool', {value: 42});
+
+    expect({staleSchemaProbe, currentSchemaProbe}).toEqual({
+      staleSchemaProbe: {result: expect.stringMatching(/value.*number|number.*value/i)},
+      currentSchemaProbe: {result: 'accepted'},
+    });
+  });
+});