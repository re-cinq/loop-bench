+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,201 @@
+import type {AIProvider, MessageChunk, SendMessageParams, ToolDefinition} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {setLogger} from '../../shared/logger.js';
+import {ToolRegistry} from './registry.js';
+
+const LOCATION_TOOL: ToolDefinition = {
+  name: 'weather',
+  description: 'looks up weather',
+  inputSchema: {
+    type: 'object',
+    properties: {
+      location: {type: 'string'},
+      units: {type: 'string', enum: ['metric', 'imperial']},
+      language: {type: 'string', default: 'en'},
+    },
+    required: ['location'],
+  },
+};
+
+const rejectionDetails = (
+  result: string,
+  value: string
+): {namesPath: boolean; namesConstraint: boolean; hidesValue: boolean} => ({
+  namesPath: result.includes('location'),
+  namesConstraint: /required|string/.test(result),
+  hidesValue: !result.includes(value),
+});
+
+describe('ToolRegistry input validation', () => {
+  afterEach(() => setLogger());
+
+  it('rejects schema violations before execution without disclosing values and preserves unknown-tool errors', async () => {
+    let executions = 0;
+    const lines: string[] = [];
+    setLogger({
+      debug: (_category, _message, fields) => void lines.push(JSON.stringify(fields)),
+      info: (_category, _message, fields) => void lines.push(JSON.stringify(fields)),
+      warn: (_category, _message, fields) => void lines.push(JSON.stringify(fields)),
+      error: (_category, _message, fields) => void lines.push(JSON.stringify(fields)),
+    });
+    const registry = new ToolRegistry();
+    registry.register(LOCATION_TOOL, async () => {
+      executions++;
+      return 'should not run';
+    });
+    const identifyingValue = 'Ada Lovelace at 10 Downing Street';
+    const wrongTypeValue = '8675309';
+
+    const missing = await registry.execute('weather', {});
+    const wrongType = await registry.execute('weather', {location: Number(wrongTypeValue), person: identifyingValue});
+    const wrongEnum = await registry.execute('weather', {
+      location: 'Berlin',
+      units: 'kelvin',
+      person: identifyingValue,
+    });
+    const unknown = await registry.execute('missing', {}).then(
+      () => 'resolved',
+      (error: Error) => error.message
+    );
+
+    expect({
+      missing: rejectionDetails(missing.result, identifyingValue),
+      wrongType: rejectionDetails(wrongType.result, wrongTypeValue),
+      enumRejected: wrongEnum.result.includes('units') && wrongEnum.result.includes('enum'),
+      valueAbsentFromEnum: !wrongEnum.result.includes('kelvin'),
+      valueAbsentFromLogs: !lines.join('\n').includes(identifyingValue),
+      executions,
+      unknown,
+    }).toEqual({
+      missing: {namesPath: true, namesConstraint: true, hidesValue: true},
+      wrongType: {namesPath: true, namesConstraint: true, hidesValue: true},
+      enumRejected: true,
+      valueAbsentFromEnum: true,
+      valueAbsentFromLogs: true,
+      executions: 0,
+      unknown: 'Unknown tool: missing',
+    });
+  });
+
+  it('passes valid input through unchanged and validates each dynamic definition current at that call', async () => {
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+    const validInput = {location: 'Berlin', unexpected: 'kept'};
+    registry.register(LOCATION_TOOL, async input => {
+      received.push(input);
+      return 'forecast';
+    });
+    const validResult = await registry.execute('weather', validInput);
+
+    let definitionCall = 0;
+    const dynamic = new ToolRegistry();
+    dynamic.register(
+      () => ({
+        name: 'dynamic',
+        description: 'changes requirements',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}, units: {type: 'string'}},
+          required: [definitionCall++ === 0 ? 'location' : 'units'],
+        },
+      }),
+      async () => 'ran'
+    );
+    definitionCall = 0;
+    const firstDynamic = await dynamic.execute('dynamic', {location: 'Berlin'});
+    const secondDynamic = await dynamic.execute('dynamic', {location: 'Berlin'});
+
+    expect({validResult, received, sameReference: received[0] === validInput, firstDynamic, secondDynamic}).toEqual({
+      validResult: {result: 'forecast'},
+      received: [validInput],
+      sameReference: true,
+      firstDynamic: {result: 'ran'},
+      secondDynamic: {result: expect.stringContaining('units')},
+    });
+  });
+
+  it('rejects a broken static schema at registration and compiles a valid static schema only there', async () => {
+    const broken = new ToolRegistry();
+    const registrationError = await Promise.resolve()
+      .then(() =>
+        broken.register(
+          {name: 'broken-weather', description: 'broken', inputSchema: {type: 'not-a-json-schema-type'}},
+          async () => 'unused'
+        )
+      )
+      .then(
+        () => 'resolved',
+        (error: Error) => error.message
+      );
+
+    let typeReads = 0;
+    const schema = {
+      get type(): string {
+        typeReads++;
+        return 'object';
+      },
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    const registry = new ToolRegistry();
+    registry.register({name: 'static-weather', description: 'static', inputSchema: schema}, async () => 'ok');
+    const readsAfterRegistration = typeReads;
+    for (let call = 0; call < 10; call++) await registry.execute('static-weather', {location: 'Berlin'});
+
+    expect({registrationError, compiledAtRegistration: readsAfterRegistration > 0, typeReads}).toEqual({
+      registrationError: expect.stringContaining('broken-weather'),
+      compiledAtRegistration: true,
+      typeReads: readsAfterRegistration,
+    });
+  });
+});
+
+it('returns a validation rejection to the model so it can correct the call on the next round', async () => {
+  const observedRequests: SendMessageParams[] = [];
+  let round = 0;
+  const provider: AIProvider = {
+    async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      observedRequests.push(params);
+      if (round++ === 0) {
+        yield {type: 'tool_use', toolCall: {id: 'bad-call', name: 'weather', input: {}}};
+        yield {type: 'stop', stopReason: 'tool_use'};
+      } else if (round === 2) {
+        yield {type: 'tool_use', toolCall: {id: 'good-call', name: 'weather', input: {location: 'Berlin'}}};
+        yield {type: 'stop', stopReason: 'tool_use'};
+      } else {
+        yield {type: 'text', text: 'Forecast ready'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      }
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('not used by this flow');
+    },
+  };
+  const executedInputs: Record<string, unknown>[] = [];
+  const registry = new ToolRegistry();
+  registry.register(LOCATION_TOOL, async input => {
+    executedInputs.push(input);
+    return 'sunny';
+  });
+  const session: ChatSession = {
+    sessionId: 'session-1',
+    userId: 'user-1',
+    entries: [{role: 'user', content: 'weather?', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Test assistant'}), registry);
+
+  const answer = await orchestrator.processMessage(session);
+  const retryMessages = JSON.stringify(observedRequests[1]?.messages);
+
+  expect({
+    answer,
+    retrySawRequiredLocation: retryMessages.includes('location') && retryMessages.includes('required'),
+    executedInputs,
+  }).toEqual({
+    answer: 'Forecast ready',
+    retrySawRequiredLocation: true,
+    executedInputs: [{location: 'Berlin'}],
+  });
+});