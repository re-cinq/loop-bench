+import {ToolRegistry} from './registry.js';
+
+const weatherDefinition = {
+  name: 'weather',
+  description: 'Get the weather for a location',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}, units: {type: 'string', enum: ['metric', 'imperial']}},
+    required: ['location'],
+  },
+};
+
+describe('ToolRegistry input validation', () => {
+  it('returns value-redacted schema errors without invoking the executor', async () => {
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+    registry.register(weatherDefinition, async input => {
+      received.push(input);
+      return 'sunny';
+    });
+
+    const missing = await registry.execute('weather', {});
+    const wrongType = await registry.execute('weather', {location: 8675309, identity: 'alice@example.test'});
+    const wrongEnum = await registry.execute('weather', {location: 'Berlin', units: 'secret-scale'});
+    const validInput = {location: 'Berlin', units: 'metric', detail: 'hourly'};
+    const valid = await registry.execute('weather', validInput);
+
+    expect({
+      missing: missing.result,
+      wrongType: wrongType.result,
+      wrongEnum: wrongEnum.result,
+      valid,
+      received,
+    }).toEqual({
+      missing: expect.stringMatching(/location.*required|required.*location/i),
+      wrongType: expect.stringMatching(/location.*string|string.*location/i),
+      wrongEnum: expect.stringMatching(/units.*allowed|units.*enum|allowed.*units|enum.*units/i),
+      valid: {result: 'sunny'},
+      received: [validInput],
+    });
+    expect(`${missing.result} ${wrongType.result} ${wrongEnum.result}`).not.toMatch(
+      /8675309|alice@example\.test|secret-scale/
+    );
+  });
+
+  it('rejects broken static schemas at registration and validates each dynamic definition as resolved', async () => {
+    const brokenRegistry = new ToolRegistry();
+    expect(() =>
+      brokenRegistry.register(
+        {...weatherDefinition, name: 'broken-weather', inputSchema: {type: 'definitely-not-a-json-schema-type'}},
+        async () => 'unused'
+      )
+    ).toThrow(/broken-weather/);
+
+    const dynamicRegistry = new ToolRegistry();
+    let expectedType = 'string';
+    let executions = 0;
+    dynamicRegistry.register(
+      () => ({
+        ...weatherDefinition,
+        name: 'dynamic-weather',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: expectedType}},
+          required: ['location'],
+        },
+      }),
+      async () => {
+        executions += 1;
+        return 'accepted';
+      }
+    );
+
+    const first = await dynamicRegistry.execute('dynamic-weather', {location: 'Berlin'});
+    expectedType = 'number';
+    const stale = await dynamicRegistry.execute('dynamic-weather', {location: 'Berlin'});
+    const current = await dynamicRegistry.execute('dynamic-weather', {location: 42});
+
+    await expect(dynamicRegistry.execute('not-registered', {})).rejects.toThrow('Unknown tool: not-registered');
+    expect({first, stale: stale.result, current, executions}).toEqual({
+      first: {result: 'accepted'},
+      stale: expect.stringMatching(/location.*number|number.*location/i),
+      current: {result: 'accepted'},
+      executions: 2,
+    });
+  });
+});