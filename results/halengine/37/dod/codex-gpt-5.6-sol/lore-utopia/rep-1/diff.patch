+import type {AIProvider, MessageChunk, SendMessageParams, ToolDefinition} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import type {Logger} from '../../shared/logger.js';
+import {setLogger} from '../../shared/logger.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {ToolRegistry} from './registry.js';
+
+const weatherDefinition = (inputSchema: Record<string, unknown>): ToolDefinition => ({
+  name: 'weather',
+  description: 'Returns the weather for a location',
+  inputSchema,
+});
+
+const locationSchema = {
+  type: 'object',
+  properties: {location: {type: 'string'}},
+  required: ['location'],
+};
+
+test('validates tool input while preserving valid and unknown-tool behavior', async () => {
+  const registry = new ToolRegistry();
+  let calls = 0;
+  const received: Record<string, unknown>[] = [];
+  const logLines: string[] = [];
+  const record = (category: string, message: string, fields?: Record<string, unknown>): void => {
+    logLines.push(JSON.stringify({category, message, fields}));
+  };
+  const logger: Logger = {debug: record, info: record, warn: record, error: record};
+  setLogger(logger);
+  registry.register(weatherDefinition(locationSchema), async value => {
+    calls += 1;
+    received.push(value);
+    return 'executor ran';
+  });
+
+  const validInput = {location: 'Berlin', units: 'metric'};
+  const valid = await registry.execute('weather', validInput);
+  const missing = await registry.execute('weather', {});
+  const identifyingValue = 'Ada-Lovelace-Secret';
+  const wrongType = await registry.execute('weather', {location: 42, identifyingField: identifyingValue});
+  const unknown = registry.execute('missing', {});
+  setLogger();
+
+  await expect(unknown).rejects.toThrow('Unknown tool: missing');
+  expect({valid, received, missing: missing.result, wrongType: wrongType.result, calls}).toEqual({
+    valid: {result: 'executor ran'},
+    received: [validInput],
+    missing: expect.stringMatching(/location.*required|required.*location/i),
+    wrongType: expect.stringMatching(/location.*string|string.*location/i),
+    calls: 1,
+  });
+  const diagnosticText = `${missing.result}\n${wrongType.result}\n${logLines.join('\n')}`;
+  expect(diagnosticText).toMatch(/location.*required|required.*location/i);
+  expect(diagnosticText).toMatch(/location.*string|string.*location/i);
+  expect(diagnosticText).not.toContain(identifyingValue);
+});
+
+test('compiles static schemas at registration and validates dynamic definitions from each call', async () => {
+  const registry = new ToolRegistry();
+  let schemaReads = 0;
+  const observedStaticSchema = new Proxy(locationSchema, {
+    ownKeys(target) {
+      schemaReads += 1;
+      return Reflect.ownKeys(target);
+    },
+  });
+  registry.register(weatherDefinition(observedStaticSchema), async () => 'ok');
+  const readsAfterRegistration = schemaReads;
+
+  await Promise.all(Array.from({length: 10}, () => registry.execute('weather', {location: 'Berlin'})));
+
+  let definitionCall = 0;
+  registry.register(
+    () =>
+      weatherDefinition(
+        definitionCall++ <= 1
+          ? {type: 'object', properties: {location: {type: 'string'}}, required: ['location']}
+          : {type: 'object', properties: {location: {type: 'number'}}, required: ['location']}
+      ),
+    async () => 'ok'
+  );
+  const first = await registry.execute('weather', {location: 'Berlin'});
+  const second = await registry.execute('weather', {location: 'Berlin'});
+
+  expect({readsAfterRegistration, schemaReadsAfterExecutions: schemaReads, first, second}).toEqual({
+    readsAfterRegistration: expect.any(Number),
+    schemaReadsAfterExecutions: readsAfterRegistration,
+    first: {result: 'ok'},
+    second: {result: expect.stringMatching(/location.*number|number.*location/i)},
+  });
+  expect(readsAfterRegistration).toBeGreaterThan(0);
+  expect(() =>
+    registry.register(weatherDefinition({type: 'definitely-not-a-json-schema-type'}), async () => 'never')
+  ).toThrow(/weather/i);
+});
+
+test('returns validation feedback to the model so it can correct a malformed tool call', async () => {
+  const requests: SendMessageParams[] = [];
+  let round = 0;
+  const provider: AIProvider = {
+    async *sendMessage(request): AsyncGenerator<MessageChunk> {
+      requests.push(request);
+      if (round++ === 0) {
+        yield {type: 'tool_use', toolCall: {id: 'call-1', name: 'weather', input: {}}};
+        yield {type: 'stop', stopReason: 'tool_use'};
+        return;
+      }
+      yield {type: 'text', text: 'Please provide a location.'};
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('not used by this conversation');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(weatherDefinition(locationSchema), async () => 'executor must not run');
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Test assistant'}), registry);
+  const session: ChatSession = {
+    sessionId: 'session-1',
+    userId: 'user-1',
+    entries: [{role: 'user', content: 'What is the weather?', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+
+  const result = await orchestrator.processMessage(session);
+
+  expect({result, retryMessages: requests[1]?.messages}).toEqual({
+    result: 'Please provide a location.',
+    retryMessages: expect.arrayContaining([
+      expect.objectContaining({
+        role: 'user',
+        content: [
+          expect.objectContaining({type: 'tool_result', content: expect.stringMatching(/location.*required/i)}),
+        ],
+      }),
+    ]),
+  });
+});