@@ -0,0 +1,190 @@
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+import type {AIProvider, MessageChunk, SendMessageParams, ToolDefinition} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {ToolRegistry} from './registry.js';
+
+const requiredLocation: ToolDefinition = {
+  name: 'weather',
+  description: 'Looks up weather',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}},
+    required: ['location'],
+  },
+};
+
+const quietLogger = (lines: string[]): Logger => {
+  const record = (_category: string, message: string, fields?: Record<string, unknown>) =>
+    void lines.push(JSON.stringify({message, fields}));
+  return {debug: record, info: record, warn: record, error: record};
+};
+
+const session = (): ChatSession => ({
+  sessionId: 'session-1',
+  userId: 'user-1',
+  entries: [{role: 'user', content: 'weather please', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+describe('ToolRegistry input validation acceptance', () => {
+  afterEach(() => setLogger());
+
+  it('validates calls before execution without changing valid input or disclosing values', async () => {
+    const lines: string[] = [];
+    setLogger(quietLogger(lines));
+    const received: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(requiredLocation, async input => {
+      received.push(input);
+      return 'executed';
+    });
+
+    const missing = await registry.execute('weather', {});
+    const identifyingValue = 491234567890;
+    const wrongType = await registry.execute('weather', {location: identifyingValue, units: 'metric'});
+    const valid = {location: 'Berlin', units: 'metric'};
+    const accepted = await registry.execute('weather', valid);
+    let unknown = '';
+    try {
+      await registry.execute('not-registered', {});
+    } catch (error) {
+      unknown = error instanceof Error ? error.message : String(error);
+    }
+
+    expect({
+      missingMentionsRequiredLocation: /location/i.test(missing.result) && /required/i.test(missing.result),
+      wrongTypeMentionsPathAndType: /location/i.test(wrongType.result) && /string/i.test(wrongType.result),
+      secretWasNotReturned: !wrongType.result.includes(String(identifyingValue)),
+      secretWasNotLogged: lines.every(line => !line.includes(String(identifyingValue))),
+      received,
+      accepted,
+      unknown,
+    }).toEqual({
+      missingMentionsRequiredLocation: true,
+      wrongTypeMentionsPathAndType: true,
+      secretWasNotReturned: true,
+      secretWasNotLogged: true,
+      received: [valid],
+      accepted: {result: 'executed'},
+      unknown: 'Unknown tool: not-registered',
+    });
+  });
+
+  it('compiles and checks a static schema at registration only', async () => {
+    const broken = new ToolRegistry();
+    let registrationError = '';
+    try {
+      broken.register(
+        {name: 'broken-weather', description: 'Broken schema', inputSchema: {type: 'not-a-json-schema-type'}},
+        async () => 'never'
+      );
+    } catch (error) {
+      registrationError = error instanceof Error ? error.message : String(error);
+    }
+
+    let schemaReads = 0;
+    const properties = {location: {type: 'string'}};
+    const observedSchema = Object.defineProperty({type: 'object'}, 'properties', {
+      enumerable: true,
+      get: () => {
+        schemaReads += 1;
+        return properties;
+      },
+    });
+    const registry = new ToolRegistry();
+    registry.register(
+      {name: 'static-weather', description: 'Static schema', inputSchema: observedSchema},
+      async () => 'ok'
+    );
+    const readsAfterRegistration = schemaReads;
+
+    for (let call = 0; call < 10; call += 1) {
+      await registry.execute('static-weather', {location: 'Berlin'});
+    }
+
+    expect({
+      invalidSchemaNamedTool: registrationError.includes('broken-weather'),
+      compiledAtRegistration: readsAfterRegistration > 0,
+      schemaWasNotRecompiled: schemaReads === readsAfterRegistration,
+    }).toEqual({invalidSchemaNamedTool: true, compiledAtRegistration: true, schemaWasNotRecompiled: true});
+  });
+
+  it('validates each dynamic definition against its current schema', async () => {
+    let expectedType = 'string';
+    let executions = 0;
+    const registry = new ToolRegistry();
+    registry.register(
+      () => ({
+        name: 'dynamic-weather',
+        description: 'Changes with its environment',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: expectedType}},
+          required: ['location'],
+        },
+      }),
+      async () => {
+        executions += 1;
+        return 'ok';
+      }
+    );
+
+    await registry.execute('dynamic-weather', {location: 'Berlin'});
+    expectedType = 'number';
+    await registry.execute('dynamic-weather', {location: 52});
+    const staleInput = await registry.execute('dynamic-weather', {location: 'Berlin'});
+
+    expect({
+      executions,
+      staleInputNamesExpectedType: /location/i.test(staleInput.result) && /number/i.test(staleInput.result),
+    }).toEqual({
+      executions: 2,
+      staleInputNamesExpectedType: true,
+    });
+  });
+
+  it('returns a schema rejection to the model so it can correct the call', async () => {
+    const requests: SendMessageParams[] = [];
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        requests.push(params);
+        round += 1;
+        if (round === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'bad-call', name: 'weather', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        if (round === 2) {
+          yield {type: 'tool_use', toolCall: {id: 'good-call', name: 'weather', input: {location: 'Berlin'}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        yield {type: 'text', text: 'Forecast ready'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        throw new Error('not used by this conversation');
+      },
+    };
+    let executions = 0;
+    const registry = new ToolRegistry();
+    registry.register(requiredLocation, async () => {
+      executions += 1;
+      return 'sunny';
+    });
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Test assistant'}), registry);
+
+    const reply = await orchestrator.processMessage(session());
+    const retryRequest = requests[1];
+    const rejectionText = JSON.stringify(retryRequest?.messages ?? []);
+
+    expect({
+      reply,
+      executions,
+      rejectionReachedProvider: /location/i.test(rejectionText) && /required/i.test(rejectionText),
+    }).toEqual({reply: 'Forecast ready', executions: 1, rejectionReachedProvider: true});
+  });
+});