+import {jest} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry Input Validation (Acceptance)', () => {
+  it('validates input against inputSchema', async () => {
+    // [validated by: ToolRegistry.execute validates the input object against the tool's inputSchema before calling the executor](specs/hal-engine-tool-input-validation/spec.md)
+    const registry = new ToolRegistry();
+    const executor = jest.fn().mockResolvedValue('success');
+
+    registry.register(
+      {
+        name: 'test_tool',
+        description: 'a test tool',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+          },
+          required: ['location'],
+        },
+      },
+      executor
+    );
+
+    const response = await registry.execute('test_tool', {});
+
+    expect(response.result).toMatch(/location/);
+    expect(response.result).toMatch(/required/);
+    expect(executor).not.toHaveBeenCalled();
+  });
+
+  it('accepts valid input with extra properties', async () => {
+    // [validated by: Validation does not inject additionalProperties: false, meaning extra properties are passed through to the executor](specs/hal-engine-tool-input-validation/spec.md)
+    const registry = new ToolRegistry();
+    const executor = jest.fn().mockResolvedValue('success');
+
+    registry.register(
+      {
+        name: 'test_tool',
+        description: 'a test tool',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+          },
+        },
+      },
+      executor
+    );
+
+    const input = {location: 'London', extra: 'property'};
+    await registry.execute('test_tool', input);
+
+    expect(executor).toHaveBeenCalledWith(input, expect.anything());
+  });
+
+  it('rejection names field path and expected type but redacts value', async () => {
+    // [validated by: Error messages and logs must never contain the actual values from the input](specs/hal-engine-tool-input-validation/spec.md)
+    const registry = new ToolRegistry();
+    const executor = jest.fn().mockResolvedValue('success');
+
+    registry.register(
+      {
+        name: 'test_tool',
+        description: 'a test tool',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            age: {type: 'number'},
+          },
+        },
+      },
+      executor
+    );
+
+    const sensitiveValue = 999;
+    const response = await registry.execute('test_tool', {age: 'not a number'});
+
+    expect(response.result).toMatch(/age/);
+    expect(response.result).toMatch(/number/);
+    expect(response.result).not.toContain('not a number');
+    expect(executor).not.toHaveBeenCalled();
+  });
+
+  it('throws at registration for invalid schema', () => {
+    // [validated by: An invalid schema causes register to throw immediately](specs/hal-engine-tool-input-validation/spec.md)
+    const registry = new ToolRegistry();
+    const invalidSchema = {type: 'invalid_type'};
+
+    expect(() => {
+      registry.register(
+        {
+          name: 'broken_tool',
+          description: 'broken',
+          inputSchema: invalidSchema as any,
+        },
+        async () => 'ok'
+      );
+    }).toThrow(/broken_tool/);
+  });
+
+  it('validates dynamic tools against the current schema', async () => {
+    // [validated by: For tools defined by a function, the schema is resolved and compiled on each call](specs/hal-engine-tool-input-validation/spec.md)
+    const registry = new ToolRegistry();
+    let schema: any = {type: 'object', properties: {a: {type: 'string'}}, required: ['a']};
+
+    registry.register(
+      () => ({
+        name: 'dynamic_tool',
+        description: 'dynamic',
+        inputSchema: schema,
+      }),
+      async () => 'ok'
+    );
+
+    // First call with first schema
+    const res1 = await registry.execute('dynamic_tool', {a: 'val'});
+    expect(res1.result).toBe('ok');
+
+    const res2 = await registry.execute('dynamic_tool', {});
+    expect(res2.result).toMatch(/a/);
+
+    // Update schema
+    schema = {type: 'object', properties: {b: {type: 'string'}}, required: ['b']};
+
+    const res3 = await registry.execute('dynamic_tool', {a: 'val'});
+    expect(res3.result).toMatch(/b/);
+
+    const res4 = await registry.execute('dynamic_tool', {b: 'val'});
+    expect(res4.result).toBe('ok');
+  });
+
+  it('compiles static tools once', async () => {
+    // [validated by: The schema is compiled once at register time](specs/hal-engine-tool-input-validation/spec.md)
