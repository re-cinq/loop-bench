+import {jest} from '@jest/globals';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+import type {AIProvider, Message, MessageChunk, SendMessageParams} from '../types/ai.js';
+
+class QueueProvider implements AIProvider {
+  private batches: MessageChunk[][] = [];
+  public receivedMessages: Message[][] = [];
+
+  enqueueBatch(chunks: MessageChunk[]) {
+    this.batches.push(chunks);
+  }
+
+  async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    this.receivedMessages.push([...params.messages]);
+    const batch = this.batches.shift() ?? [];
+    for (const chunk of batch) {
+      yield chunk;
+    }
+  }
+
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  }
+}
+
+describe('ChatOrchestrator Tool Loop (Acceptance)', () => {
+  it('recovers from a validation error in a subsequent round', async () => {
+    // [validated by: When a tool call is rejected by the registry, the orchestrator receives the error as a tool_result. This allows the AI model to ... attempt to correct the call in a subsequent round](specs/hal-engine-tool-input-validation/spec.md)
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'weather',
+        description: 'get weather',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async input => `SUCCESS: ${input.location}`
+    );
+
+    const provider = new QueueProvider();
+
+    // Round 1: Assistant calls tool with MISSING location
+    provider.enqueueBatch([
+      {
+        type: 'tool_use',
+        toolCall: {id: 'call_1', name: 'weather', input: {}},
+      },
+      {type: 'stop', stopReason: 'tool_use'},
+    ]);
+
+    // Round 2: Assistant retries with CORRECT location
+    provider.enqueueBatch([
+      {
+        type: 'tool_use',
+        toolCall: {id: 'call_2', name: 'weather', input: {location: 'London'}},
+      },
+      {type: 'stop', stopReason: 'tool_use'},
+    ]);
+
+    // Round 3: Assistant summarizes
+    provider.enqueueBatch([
+      {type: 'text', text: 'The weather in London is sunny.'},
+      {type: 'stop', stopReason: 'end_turn'},
+    ]);
+
+    const promptBuilder = new PromptBuilder({identity: 'test'});
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'What is the weather?', timestamp: new Date().toISOString()}],
+    };
+
+    for await (const _chunk of orchestrator.processMessageStream(session)) {
+      // consume the generator
+    }
+
+    // In Round 2, the provider should have received the result of the tool call from Round 1
+    const messagesInRound2 = provider.receivedMessages[1];
+    const toolResultMessage = messagesInRound2.find(m => m.role === 'user' && Array.isArray(m.content)) as any;
+
+    expect(toolResultMessage).toBeDefined();
+    const toolResult = toolResultMessage.content.find((c: any) => c.type === 'tool_result');
+
+    // Before implementation, this will be "SUCCESS: undefined"
+    // After implementation, it should be the validation error matching /location/
+    expect(toolResult.content).toMatch(/location/);
+    expect(toolResult.content).toMatch(/required/);
+
+    // In Round 3, the provider should have received the result of the tool call from Round 2
+    const messagesInRound3 = provider.receivedMessages[2];
+    const secondToolResultMessage = messagesInRound3[messagesInRound3.length - 1] as any;
+    expect(secondToolResultMessage.content[0].content).toBe('SUCCESS: London');
+  });
+});
