+
+  it('still throws for unknown tools', async () => {
+    // [validated by: Calling execute with a name not in the registry still throws an Unknown tool error](specs/hal-engine-tool-input-validation/spec.md)
+    const registry = new ToolRegistry();
+    await expect(registry.execute('missing', {})).rejects.toThrow('Unknown tool: missing');
