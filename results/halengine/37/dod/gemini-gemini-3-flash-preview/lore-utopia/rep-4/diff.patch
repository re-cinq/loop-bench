+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {jest} from '@jest/globals';
+
+const SENT_AT = '2026-11-08T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const scriptedProvider = (
+  rounds: MessageChunk[][],
+  onSendMessage?: (params: SendMessageParams) => void
+): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      onSendMessage?.(params);
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+describe('ChatOrchestrator Tool Loop Recovery (Acceptance)', () => {
+  const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+  it('drives a provider through a rejected tool call followed by a corrected retry ([validated by specs/hal-engine-tool-input-validation/spec.md#L29])', async () => {
+    const registry = new ToolRegistry();
+    const executor = jest.fn().mockResolvedValue('Final Answer');
+
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Get weather',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      executor as any
+    );
+
+    const rounds: MessageChunk[][] = [
+      // Round 0: Model makes a malformed call (missing location)
+      [
+        {type: 'tool_use', toolCall: {id: 'call-1', name: 'weather', input: {}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      // Round 1: Model sees the rejection and corrects it
+      [
+        {type: 'tool_use', toolCall: {id: 'call-2', name: 'weather', input: {location: 'London'}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      // Round 2: Model finishes
+      [
+        {type: 'text', text: 'It is sunny in London.'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ];
+
+    const sentParams: SendMessageParams[] = [];
+    const provider = scriptedProvider(rounds, params => {
+      // Deep clone to capture state at this round
+      sentParams.push(JSON.parse(JSON.stringify(params)));
+    });
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+    const result = await orchestrator.processMessage(createSession('What is the weather?'));
+
+    // Verify the orchestrator resolved successfully
+    expect(result).toBe('It is sunny in London.');
+
+    // Verify the executor was only called once (for the second, valid call)
+    expect(executor).toHaveBeenCalledTimes(1);
+    expect(executor).toHaveBeenCalledWith({location: 'London'}, expect.anything());
+
+    // Verify what was sent to the provider in Round 1 (should contain the rejection)
+    const round1Params = sentParams[1];
+    const lastMessage = round1Params.messages[round1Params.messages.length - 1];
+    expect(lastMessage.role).toBe('user');
+    expect((lastMessage as any).content[0].type).toBe('tool_result');
+    expect((lastMessage as any).content[0].content).toContain('location');
+    expect((lastMessage as any).content[0].content).toContain('required');
+
+    // Verify what was sent to the provider in Round 2 (should contain the success)
+    const round2Params = sentParams[2];
+    const secondLastMessage = round2Params.messages[round2Params.messages.length - 1];
+    expect(secondLastMessage.role).toBe('user');
+    expect((secondLastMessage as any).content[0].type).toBe('tool_result');
+    expect((secondLastMessage as any).content[0].content).toBe('Final Answer');
+  });
+});
