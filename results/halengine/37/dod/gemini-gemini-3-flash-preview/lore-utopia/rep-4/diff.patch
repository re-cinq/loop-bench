+import {ToolRegistry} from './registry.js';
+import {jest} from '@jest/globals';
+
+describe('ToolRegistry Input Validation (Acceptance)', () => {
+  let registry: ToolRegistry;
+
+  beforeEach(() => {
+    registry = new ToolRegistry();
+  });
+
+  it('rejects missing required field ([validated by specs/hal-engine-tool-input-validation/spec.md#L14], [validated by specs/hal-engine-tool-input-validation/spec.md#L17])', async () => {
+    const executor = jest.fn().mockResolvedValue('success');
+    registry.register(
+      {
+        name: 'test_tool',
+        description: 'A test tool',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+          },
+          required: ['location'],
+        },
+      },
+      executor as any
+    );
+
+    const response = await registry.execute('test_tool', {});
+
+    expect(response.result).toContain('location');
+    expect(response.result).toContain('required');
+    expect(executor).not.toHaveBeenCalled();
+  });
+
+  it('passes through extra properties unchanged ([validated by specs/hal-engine-tool-input-validation/spec.md#L15])', async () => {
+    const executor = jest.fn().mockResolvedValue('success');
+    const input = {location: 'London', extra: 'property'};
+    registry.register(
+      {
+        name: 'test_tool',
+        description: 'A test tool',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+          },
+        },
+      },
+      executor as any
+    );
+
+    await registry.execute('test_tool', input);
+
+    expect(executor).toHaveBeenCalledWith(expect.objectContaining(input), undefined);
+    // Use toEqual to ensure no coercion or defaults were added
+    const callInput = executor.mock.calls[0][0];
+    expect(callInput).toEqual(input);
+  });
+
+  it('rejects wrong-typed field and names the field path and expected type ([validated by specs/hal-engine-tool-input-validation/spec.md#L14])', async () => {
+    const executor = jest.fn().mockResolvedValue('success');
+    registry.register(
+      {
+        name: 'test_tool',
+        description: 'A test tool',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            count: {type: 'number'},
+          },
+        },
+      },
+      executor as any
+    );
+
+    const response = await registry.execute('test_tool', {count: 'five'});
+
+    expect(response.result).toContain('count');
+    expect(response.result).toContain('number');
+    expect(executor).not.toHaveBeenCalled();
+  });
+
+  it('throws at registration time for an uncompilable schema ([validated by specs/hal-engine-tool-input-validation/spec.md#L24])', () => {
+    const executor = jest.fn().mockResolvedValue('success');
+    const invalidSchema = {type: 'invalid_type'};
+
+    expect(() => {
+      registry.register(
+        {
+          name: 'bad_tool',
+          description: 'A tool with a bad schema',
+          inputSchema: invalidSchema as any,
+        },
+        executor as any
+      );
+    }).toThrow(/bad_tool/);
+  });
+
+  it('validates against the current schema for function-valued tool definitions ([validated by specs/hal-engine-tool-input-validation/spec.md#L25])', async () => {
+    const executor = jest.fn().mockResolvedValue('success');
+    let requiredField = 'first';
+
+    registry.register(
+      () => ({
+        name: 'dynamic_tool',
+        description: 'A dynamic tool',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            [requiredField]: {type: 'string'},
+          },
+          required: [requiredField],
+        },
+      }),
+      executor as any
+    );
+
+    // First call with 'first' required
+    const res1 = await registry.execute('dynamic_tool', {first: 'val'});
+    expect(res1.result).toBe('success');
+
+    // Change requirement to 'second'
+    requiredField = 'second';
+    const res2 = await registry.execute('dynamic_tool', {first: 'val'});
+    expect(res2.result).toContain('second');
+    expect(res2.result).toContain('required');
+    expect(executor).toHaveBeenCalledTimes(1); // Only the first call should have succeeded
+  });
+
+  it('still throws Unknown tool for unregistered name', async () => {
+    await expect(registry.execute('non_existent', {})).rejects.toThrow('Unknown tool: non_existent');
+  });
+
+  it('redacts input values from rejection messages ([validated by specs/hal-engine-tool-input-validation/spec.md#L18])', async () => {
+    const secretValue = 'SSN-123-456';
+    const executor = jest.fn().mockResolvedValue('success');
+    registry.register(
+      {
+        name: 'secure_tool',
+        description: 'A secure tool',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            id: {type: 'number'},
+          },
+        },
+      },
+      executor as any
+    );
+
+    const response = await registry.execute('secure_tool', {id: secretValue});
+
+    expect(response.result).toContain('id');
+    expect(response.result).not.toContain(secretValue);
+    expect(executor).not.toHaveBeenCalled();
+  });
+});