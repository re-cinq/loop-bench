+import {jest} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry Log Redaction Acceptance', () => {
+  let registry: ToolRegistry;
+
+  beforeEach(() => {
+    registry = new ToolRegistry();
+    jest.spyOn(console, 'log').mockImplementation(() => {});
+    jest.spyOn(console, 'error').mockImplementation(() => {});
+  });
+
+  afterEach(() => {
+    jest.restoreAllMocks();
+  });
+
+  it('redacts input values from log lines on validation failure', async () => {
+    // [specs/hal-engine-tool-input-validation/spec.md#6]
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Get weather',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+          },
+          required: ['location'],
+        },
+      },
+      async () => 'ok'
+    );
+
+    const secretValue = 'SECRET_LOCATION_123';
+    const response = await registry.execute('weather', {location: 123 as any, secret: secretValue});
+
+    expect(response.result).toContain('location');
+    expect(response.result).toContain('string');
+
+    const consoleLog = console.log as jest.Mock;
+    const allLogs = consoleLog.mock.calls.map(call => JSON.stringify(call)).join('\n');
+
+    // The execution log (before validation) might contain input keys but should NOT contain values.
+    // The current registry logs inputKeys: Object.keys(input), which is safe.
+    // The failure log (after validation failure) should name the failing path but NOT the value.
+    expect(allLogs).not.toContain(secretValue);
+    expect(allLogs).not.toContain('123');
+  });
+});