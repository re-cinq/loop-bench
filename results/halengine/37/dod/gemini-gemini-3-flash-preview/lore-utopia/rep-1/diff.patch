+import {jest} from '@jest/globals';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, SendMessageParams, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('ChatOrchestrator Acceptance', () => {
+  const promptBuilder = new PromptBuilder({identity: 'Test assistant'});
+
+  function createSession(content: string): ChatSession {
+    return {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content, timestamp: new Date().toISOString()}],
+    };
+  }
+
+  it('handles malformed tool calls by feeding rejections back to the model', async () => {
+    // [specs/hal-engine-tool-input-validation/spec.md#9]
+    const toolRegistry = new ToolRegistry();
+    const executor = jest.fn().mockResolvedValue('Correctly called!');
+    toolRegistry.register(
+      {
+        name: 'weather',
+        description: 'Get weather',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+          },
+          required: ['location'],
+        },
+      },
+      executor
+    );
+
+    let callCount = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        callCount++;
+        if (callCount === 1) {
+          // First call: model makes a malformed tool call (missing 'location')
+          yield {
+            type: 'tool_use',
+            toolCall: {id: 'call-1', name: 'weather', input: {}},
+          };
+          yield {type: 'stop', stopReason: 'tool_use'};
+        } else if (callCount === 2) {
+          // Second call: model should have received the error and should now correct it
+          const lastMessage = params.messages[params.messages.length - 1];
+          if (lastMessage.role === 'user' && Array.isArray(lastMessage.content)) {
+            const toolResult = lastMessage.content.find(c => c.type === 'tool_result');
+            if (toolResult && toolResult.content.includes('location') && toolResult.content.includes('required')) {
+              yield {type: 'text', text: 'I fixed it! Here is the weather in London.'};
+              yield {
+                type: 'tool_use',
+                toolCall: {id: 'call-2', name: 'weather', input: {location: 'London'}},
+              };
+              yield {type: 'stop', stopReason: 'tool_use'};
+            } else {
+              yield {type: 'text', text: 'Error: I did not see the validation error.'};
+              yield {type: 'stop', stopReason: 'end_turn'};
+            }
+          }
+        } else {
+          // Third call: finalize
+          yield {type: 'text', text: 'All done.'};
+          yield {type: 'stop', stopReason: 'end_turn'};
+        }
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, toolRegistry);
+    const result = await orchestrator.processMessage(createSession('What is the weather?'));
+
+    expect(result).toContain('All done.');
+    expect(executor).toHaveBeenCalledWith({location: 'London'}, expect.anything());
+    expect(executor).toHaveBeenCalledTimes(1); // Should only be called once, after the model corrects its input
+  });
+});
