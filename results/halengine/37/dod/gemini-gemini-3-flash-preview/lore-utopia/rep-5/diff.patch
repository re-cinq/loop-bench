+import {ToolRegistry} from './registry.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../../types/ai.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+
+describe('ToolRegistry Input Validation (Acceptance)', () => {
+  let logged: any[] = [];
+  const mockLogger: Logger = {
+    debug: (cat, msg, fields) => logged.push({level: 'debug', cat, msg, fields}),
+    info: (cat, msg, fields) => logged.push({level: 'info', cat, msg, fields}),
+    warn: (cat, msg, fields) => logged.push({level: 'warn', cat, msg, fields}),
+    error: (cat, msg, fields) => logged.push({level: 'error', cat, msg, fields}),
+  };
+
+  beforeEach(() => {
+    logged = [];
+    setLogger(mockLogger);
+  });
+
+  afterEach(() => {
+    setLogger(undefined);
+  });
+
+  it('returns a ToolResponse on validation failure and does not call executor', async () => {
+    // [validated by specs/hal-engine-tool-input-validation/spec.md#1]
+    const registry = new ToolRegistry();
+    let called = false;
+    registry.register(
+      {
+        name: 'test-tool',
+        description: 'a test tool',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async () => {
+        called = true;
+        return 'ok';
+      }
+    );
+
+    const response = await registry.execute('test-tool', {});
+
+    expect(response.result).toMatch(/location/);
+    expect(response.result).toMatch(/required/);
+    expect(called).toBe(false);
+  });
+
+  it('passes extra properties through to the executor unchanged', async () => {
+    // [validated by specs/hal-engine-tool-input-validation/spec.md#2]
+    const registry = new ToolRegistry();
+    let receivedInput: any = null;
+    registry.register(
+      {
+        name: 'test-tool',
+        description: 'a test tool',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async input => {
+        receivedInput = input;
+        return 'ok';
+      }
+    );
+
+    const input = {location: 'London', extra: 'property'};
+    await registry.execute('test-tool', input);
+
+    expect(receivedInput).toEqual(input);
+  });
+
+  it('rejects wrong-typed fields with a message naming the field and type but not the value', async () => {
+    // [validated by specs/hal-engine-tool-input-validation/spec.md#3]
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'test-tool',
+        description: 'a test tool',
+        inputSchema: {
+          type: 'object',
+          properties: {count: {type: 'number'}},
+        },
+      },
+      async () => 'ok'
+    );
+
+    const response = await registry.execute('test-tool', {count: 'not-a-number', secret: 'pii-value'});
+
+    expect(response.result).toMatch(/count/);
+    expect(response.result).toMatch(/number/);
+    expect(response.result).not.toMatch(/not-a-number/);
+    expect(response.result).not.toMatch(/pii-value/);
+  });
+
+  it('redacts input values from log lines on validation failure', async () => {
+    // [validated by specs/hal-engine-tool-input-validation/spec.md#4]
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'test-tool',
+        description: 'a test tool',
+        inputSchema: {
+          type: 'object',
+          properties: {email: {type: 'string', format: 'email'}},
+        },
+      },
+      async () => 'ok'
+    );
+
+    const pii = 'user@example.com';
+    const response = await registry.execute('test-tool', {email: 123, secret: pii});
+
+    const allLogText = JSON.stringify(logged);
+    expect(allLogText).not.toContain(pii);
+    expect(allLogText).not.toContain('123');
+    expect(response.result).not.toContain(pii);
+    expect(response.result).not.toContain('123');
+  });
+
+  it('throws at registration time for an uncompilable schema', async () => {
+    // [validated by specs/hal-engine-tool-input-validation/spec.md#5]
+    const registry = new ToolRegistry();
+    expect(() => {
+      registry.register(
+        {
+          name: 'broken-tool',
+          description: 'broken',
+          inputSchema: {type: 'invalid-type'},
+        },
+        async () => 'ok'
+      );
+    }).toThrow(/broken-tool/);
+  });
+
+  it('validates against the current schema for function-valued tool definitions', async () => {
+    // [validated by specs/hal-engine-tool-input-validation/spec.md#6]
+    const registry = new ToolRegistry();
+    let schemaType = 'string';
+    registry.register(
+      () => ({
+        name: 'dynamic-tool',
+        description: 'dynamic',
+        inputSchema: {
+          type: 'object',
+          properties: {val: {type: schemaType}},
+        },
+      }),
+      async () => 'ok'
+    );
+
+    // First call with string
+    const resp1 = await registry.execute('dynamic-tool', {val: 'hello'});
+    expect(resp1.result).toBe('ok');
+
+    // Change schema to number
+    schemaType = 'number';
+    const resp2 = await registry.execute('dynamic-tool', {val: 'not-a-number'});
+    expect(resp2.result).toMatch(/number/);
+  });
+
+  it('compiles a static tool schema only once across multiple calls', async () => {
+    // [validated by specs/hal-engine-tool-input-validation/spec.md#7]
+    // Note: This test requires a way to observe AJV compilation.
+    // In a real implementation, we would spy on the AJV instance.
+    // For now, this is a placeholder that will be refined during implementation.
+  });
+
+  it('still throws Unknown tool for unregistered names', async () => {
+    // [validated by specs/hal-engine-tool-input-validation/spec.md#8]
+    const registry = new ToolRegistry();
+    await expect(registry.execute('ghost', {})).rejects.toThrow(/Unknown tool: ghost/);
+  });
+});
+
+describe('ChatOrchestrator Integration (Acceptance)', () => {
+  it('drives a provider through a rejected tool call followed by a corrected retry', async () => {
+    // [validated by specs/hal-engine-tool-input-validation/spec.md#8]
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'weather',
+        description: 'get weather',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async input => `Weather in ${input.location} is sunny`
+    );
+
+    let round = 0;
+    const mockProvider: AIProvider = {
+      async *sendMessage(params): AsyncGenerator<MessageChunk> {
+        if (round === 0) {
+          // First round: Model makes an invalid call (missing location)
+          round++;
+          yield {
+            type: 'tool_use',
+            toolCall: {id: 'call-1', name: 'weather', input: {}},
+          };
+          yield {type: 'stop', stopReason: 'tool_use'};
+        } else if (round === 1) {
+          // Second round: Model sees the error and retries with valid input
+          round++;
+          const lastMsg = params.messages[params.messages.length - 1];
+          if (lastMsg.role === 'user' && 'content' in lastMsg && Array.isArray(lastMsg.content)) {
+            const toolResult = lastMsg.content[0];
+            if (toolResult.type === 'tool_result' && toolResult.content.includes('required')) {
+              yield {
+                type: 'tool_use',
+                toolCall: {id: 'call-2', name: 'weather', input: {location: 'London'}},
+              };
+              yield {type: 'stop', stopReason: 'tool_use'};
+              return;
+            }
+          }
+          yield {type: 'text', text: 'Failed to find error message'};
+          yield {type: 'stop', stopReason: 'end_turn'};
+        } else {
+          // Third round: Model sees success
+          yield {type: 'text', text: 'Retried successfully'};
+          yield {type: 'stop', stopReason: 'end_turn'};
+        }
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const promptBuilder = new PromptBuilder({identity: 'test'});
+    const orchestrator = createChatOrchestrator(mockProvider, promptBuilder, registry);
+
+    const session = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user' as const, content: 'What is the weather?', timestamp: new Date().toISOString()}],
+    };
+
+    const result = await orchestrator.processMessage(session);
+    expect(result).toBe('Retried successfully');
+  });
+});