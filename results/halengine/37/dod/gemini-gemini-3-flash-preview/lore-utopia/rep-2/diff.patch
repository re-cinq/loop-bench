+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('ChatOrchestrator tool loop validation recovery (acceptance)', () => {
+  const promptBuilder = new PromptBuilder({identity: 'Test'});
+  const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+  function createSession(content: string): ChatSession {
+    return {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content, timestamp: SENT_AT}],
+    };
+  }
+
+  it('tool loop handles rejected call and corrected retry', async () => {
+    const registry = new ToolRegistry();
+    let executorCalledWith: any = null;
+
+    registry.register(
+      {
+        name: 'weather',
+        description: 'get weather',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+          },
+          required: ['location'],
+        },
+      },
+      async input => {
+        executorCalledWith = input;
+        return 'The weather is sunny';
+      }
+    );
+
+    // Mock provider that first sends a bad call, then a good one
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        if (round === 0) {
+          round++;
+          // Bad call: missing location
+          yield {
+            type: 'tool_use',
+            toolCall: {id: 'call-1', name: 'weather', input: {}},
+          };
+          yield {type: 'stop', stopReason: 'tool_use'};
+        } else if (round === 1) {
+          round++;
+          // Verify we saw the error in the history
+          const lastMessage = params.messages[params.messages.length - 1];
+          // In the history, it should be a tool_result with the error message
+          const toolResult = lastMessage.content.find(
+            (c: any) => c.type === 'tool_result' && c.toolCallId === 'call-1'
+          );
+
+          if (toolResult && toolResult.content.includes('location')) {
+            // Corrected call
+            yield {
+              type: 'tool_use',
+              toolCall: {id: 'call-2', name: 'weather', input: {location: 'Berlin'}},
+            };
+            yield {type: 'stop', stopReason: 'tool_use'};
+          } else {
+            yield {type: 'text', text: 'Error: validation message not found in history'};
+            yield {type: 'stop', stopReason: 'end_turn'};
+          }
+        } else {
+          yield {type: 'text', text: 'All done!'};
+          yield {type: 'stop', stopReason: 'end_turn'};
+        }
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+    const result = await orchestrator.processMessage(createSession('weather?'));
+
+    expect(executorCalledWith).toEqual({location: 'Berlin'});
+    expect(result).toContain('All done!');
+  });
+});
