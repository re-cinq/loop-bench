+import {ToolRegistry} from './registry.js';
+import type {ToolExecutor} from './registry.js';
+import {log, setLogger} from '../../shared/logger.js';
+
+describe('ToolRegistry Input Validation (acceptance)', () => {
+  const noop: ToolExecutor = async () => 'ok';
+
+  it('validates input against schema and returns ToolResponse on failure', async () => {
+    const registry = new ToolRegistry();
+    let called = false;
+    const executor: ToolExecutor = async () => {
+      called = true;
+      return 'ok';
+    };
+
+    registry.register(
+      {
+        name: 'test_tool',
+        description: 'test',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+          },
+          required: ['location'],
+        },
+      },
+      executor
+    );
+
+    // Call with missing required property
+    const response = await registry.execute('test_tool', {});
+
+    expect(response.result).toMatch(/location/);
+    expect(called).toBe(false);
+  });
+
+  it('passes unlisted extra properties through to the executor', async () => {
+    const registry = new ToolRegistry();
+    let receivedInput: Record<string, unknown> = {};
+    const executor: ToolExecutor = async input => {
+      receivedInput = input;
+      return 'ok';
+    };
+
+    registry.register(
+      {
+        name: 'test_tool',
+        description: 'test',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            known: {type: 'string'},
+          },
+        },
+      },
+      executor
+    );
+
+    const input = {known: 'value', unknown: 'extra'};
+    await registry.execute('test_tool', input);
+
+    // Should be exactly the same object, no extra properties removed, no defaults added
+    expect(receivedInput).toEqual(input);
+  });
+
+  it('rejects wrong-typed fields with descriptive, redacted messages', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'test_tool',
+        description: 'test',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            age: {type: 'number'},
+          },
+        },
+      },
+      noop
+    );
+
+    const sensitiveValue = 'twenty-five';
+    const response = await registry.execute('test_tool', {age: sensitiveValue});
+
+    // Should name the field and the expected type
+    expect(response.result).toMatch(/age/);
+    expect(response.result).toMatch(/number/);
+    // Should NOT contain the value
+    expect(response.result).not.toContain(sensitiveValue);
+  });
+
+  it('throws at registration time for uncompilable schemas', () => {
+    const registry = new ToolRegistry();
+    const invalidSchema = {
+      type: 'object',
+      properties: {
+        foo: {type: 'not-a-valid-type'},
+      },
+    };
+
+    expect(() => {
+      registry.register(
+        {
+          name: 'bad_tool',
+          description: 'test',
+          inputSchema: invalidSchema as any,
+        },
+        noop
+      );
+    }).toThrow(/bad_tool/);
+  });
+
+  it('resolves and validates dynamic schemas per call', async () => {
+    const registry = new ToolRegistry();
+    let schemaType = 'string';
+    const definitionSource = () => ({
+      name: 'dynamic_tool',
+      description: 'test',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          val: {type: schemaType},
+        },
+      },
+    });
+
+    registry.register(definitionSource, noop);
+
+    // First call expects string
+    const res1 = await registry.execute('dynamic_tool', {val: 123});
+    expect(res1.result).toMatch(/string/);
+
+    // Change schema to expect number
+    schemaType = 'number';
+    const res2 = await registry.execute('dynamic_tool', {val: 123});
+    // Now it should pass (or at least not fail due to being a string)
+    expect(res2.result).toBe('ok');
+  });
+
+  it('caches compiled schemas for static tool definitions', async () => {
+    // We use a Proxy to observe accesses to the schema object.
+    // Ajv compilation should happen once.
+    const inputSchema = {
+      type: 'object',
+      properties: {val: {type: 'string'}},
+    };
+
+    let accessCount = 0;
+    const proxySchema = new Proxy(inputSchema, {
+      get(target, prop, receiver) {
+        // Properties Ajv typically reads during compilation
+        if (['type', 'properties', 'required', 'items'].includes(prop as string)) {
