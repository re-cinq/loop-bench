+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const promptBuilder = new PromptBuilder({identity: 'Test'});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+describe('ChatOrchestrator validation loop acceptance', () => {
+  it('ChatOrchestrator handles tool rejection and retry', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'weather',
+        description: 'get weather',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async input => `Weather in ${input.location} is sunny`
+    );
+
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params): AsyncGenerator<MessageChunk> {
+        round++;
+        if (round === 1) {
+          // Model makes a malformed call (missing location)
+          yield {
+            type: 'tool_use',
+            toolCall: {id: 'c1', name: 'weather', input: {}},
+          };
+          yield {type: 'stop', stopReason: 'tool_use'};
+        } else if (round === 2) {
+          // Model should see the rejection and retry
+          const lastMsg = params.messages[params.messages.length - 1];
+          if (lastMsg.role === 'user' && 'content' in lastMsg && Array.isArray(lastMsg.content)) {
+            const result = lastMsg.content[0];
+            if (
+              result.type === 'tool_result' &&
+              result.content.includes('location') &&
+              result.content.includes('required')
+            ) {
+              // Correct retry
+              yield {
+                type: 'tool_use',
+                toolCall: {id: 'c2', name: 'weather', input: {location: 'London'}},
+              };
+              yield {type: 'stop', stopReason: 'tool_use'};
+              return;
+            }
+          }
+          yield {type: 'text', text: 'Failed to see rejection or retry incorrectly'};
+          yield {type: 'stop', stopReason: 'end_turn'};
+        } else {
+          yield {type: 'text', text: 'Success'};
+          yield {type: 'stop', stopReason: 'end_turn'};
+        }
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+    const result = await orchestrator.processMessage(createSession('what is the weather?'));
+
+    expect(result).toBe('Success');
+    expect(round).toBe(3);
+  });
+});
