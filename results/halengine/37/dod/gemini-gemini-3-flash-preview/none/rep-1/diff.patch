+import {ToolRegistry} from './registry.js';
+import type {ToolDefinitionSource} from '../../types/ai.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+
+describe('ToolRegistry validation acceptance', () => {
+  let registry: ToolRegistry;
+  let capturedLogs: any[] = [];
+  const captureLogger: Logger = {
+    debug: (c, m, f) => capturedLogs.push({level: 'DEBUG', c, m, f}),
+    info: (c, m, f) => capturedLogs.push({level: 'INFO', c, m, f}),
+    warn: (c, m, f) => capturedLogs.push({level: 'WARN', c, m, f}),
+    error: (c, m, f) => capturedLogs.push({level: 'ERROR', c, m, f}),
+  };
+
+  beforeEach(() => {
+    registry = new ToolRegistry();
+    capturedLogs = [];
+    setLogger(captureLogger);
+  });
+
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('ToolRegistry.execute validates input before executor', async () => {
+    let callCount = 0;
+    const executor = async () => {
+      callCount++;
+      return 'ok';
+    };
+    registry.register(
+      {
+        name: 'test-tool',
+        description: 'a test tool',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      executor
+    );
+
+    const response = await registry.execute('test-tool', {});
+
+    expect(response.result).toMatch(/location/);
+    expect(response.result).toMatch(/required/);
+    expect(callCount).toBe(0);
+  });
+
+  it('ToolRegistry.execute returns ToolResponse on failure', async () => {
+    registry.register(
+      {
+        name: 'test-tool',
+        description: 'a test tool',
+        inputSchema: {type: 'object', required: ['a']},
+      },
+      async () => 'ok'
+    );
+    const response = await registry.execute('test-tool', {});
+    expect(response).toHaveProperty('result');
+    expect(typeof response.result).toBe('string');
+    // Ensure it's actually an error message, not "ok"
+    expect(response.result).not.toBe('ok');
+  });
+
+  it('ToolRegistry.execute does not call executor on failure', async () => {
+    let callCount = 0;
+    const executor = async () => {
+      callCount++;
+      return 'ok';
+    };
+    registry.register(
+      {
+        name: 'test-tool',
+        description: 'a test tool',
+        inputSchema: {type: 'object', required: ['a']},
+      },
+      executor
+    );
+    await registry.execute('test-tool', {});
+    expect(callCount).toBe(0);
+  });
+
+  it('ToolRegistry.execute passes through extra properties', async () => {
+    let receivedInput: any;
+    const executor = async (input: any) => {
+      receivedInput = input;
+      return 'ok';
+    };
+    registry.register(
+      {
+        name: 'test-tool',
+        description: 'a test tool',
+        inputSchema: {type: 'object', properties: {a: {type: 'string'}}},
+      },
+      executor
+    );
+    const input = {a: 'val', extra: 'prop'};
+    await registry.execute('test-tool', input);
+    expect(receivedInput).toEqual(input);
+  });
+
+  it('ToolRegistry.execute does not modify input', async () => {
+    let receivedInput: any;
+    const executor = async (input: any) => {
+      receivedInput = input;
+      return 'ok';
+    };
+    registry.register(
+      {
