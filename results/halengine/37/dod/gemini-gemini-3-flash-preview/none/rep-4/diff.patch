+import {jest} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+import type {ToolExecutor} from './registry.js';
+
+describe('ToolRegistry validation acceptance', () => {
+  let registry: ToolRegistry;
+  let executor: any;
+
+  beforeEach(() => {
+    registry = new ToolRegistry();
+    executor = jest.fn().mockResolvedValue('success');
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#1
+  it('validates input against schema and returns ToolResponse on failure', async () => {
+    registry.register(
+      {
+        name: 'test-tool',
+        description: 'a test tool',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+          },
+          required: ['location'],
+        },
+      },
+      executor
+    );
+
+    const response = await registry.execute('test-tool', {});
+
+    expect(response.result).toContain('location');
+    expect(response.result).toContain('required');
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#2
+  it('never calls the executor if validation fails', async () => {
+    registry.register(
+      {
+        name: 'test-tool',
+        description: 'a test tool',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            count: {type: 'number'},
+          },
+        },
+      },
+      executor
+    );
+
+    await registry.execute('test-tool', {count: 'not-a-number'});
+
+    expect(executor).not.toHaveBeenCalled();
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#3
+  it('passes unlisted extra properties to the executor unchanged', async () => {
+    registry.register(
+      {
+        name: 'test-tool',
+        description: 'a test tool',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            known: {type: 'string'},
+          },
+        },
+      },
+      executor
+    );
+
+    const input = {known: 'value', extra: 'property'};
+    await registry.execute('test-tool', input);
+
+    expect(executor).toHaveBeenCalledWith(input, expect.anything());
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#4
+  it('rejects wrong-typed fields with path and expected type but NOT the value', async () => {
+    registry.register(
+      {
+        name: 'test-tool',
+        description: 'a test tool',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            token: {type: 'string'},
+          },
+        },
+      },
+      executor
+    );
+
+    const secretValue = 'SECRET_123';
+    const response = await registry.execute('test-tool', {token: 123});
+
+    expect(response.result).toContain('token');
+    expect(response.result).toContain('string');
+    expect(response.result).not.toContain(secretValue);
+    expect(response.result).not.toContain('123');
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#6
+  it('throws at registration time for an uncompilable schema', () => {
+    expect(() => {
+      registry.register(
+        {
+          name: 'bad-tool',
+          description: 'bad schema',
+          inputSchema: {
+            type: 'invalid-type',
+          },
+        },
+        executor
+      );
+    }).toThrow(/bad-tool/);
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#7
+  it('resolves and compiles dynamic schemas per call', async () => {
+    let requiredField = 'first';
+    const definitionSource = () => ({
+      name: 'dynamic-tool',
+      description: 'dynamic',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          first: {type: 'string'},
+          second: {type: 'string'},
+        },
+        required: [requiredField],
+      },
+    });
+
+    registry.register(definitionSource, executor);
+
+    // First call requires 'first'
+    const res1 = await registry.execute('dynamic-tool', {second: 'val'});
+    expect(res1.result).toContain('first');
+    expect(executor).not.toHaveBeenCalled();
+
+    // Change requirement to 'second'
+    requiredField = 'second';
+    const res2 = await registry.execute('dynamic-tool', {first: 'val'});
+    expect(res2.result).toContain('second');
+    expect(executor).not.toHaveBeenCalled();
+
+    // Valid call
+    await registry.execute('dynamic-tool', {second: 'val'});
+    expect(executor).toHaveBeenCalledTimes(1);
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#5
+  it('throws Unknown tool for unregistered name', async () => {
+    await expect(registry.execute('missing', {})).rejects.toThrow('Unknown tool: missing');
+  });
+});