+import {jest} from '@jest/globals';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+describe('ChatOrchestrator validation recovery acceptance', () => {
+  const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+  // specs/hal-engine-tool-input-validation/spec.md#9
+  it('drives a retry loop through a rejected tool call', async () => {
+    const registry = new ToolRegistry();
+    const executor = jest.fn().mockResolvedValue('weather is 20c');
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'get weather',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      executor
+    );
+
+    const provider = scriptedProvider([
+      // Round 1: Model calls tool with missing required 'location'
+      [
+        {
+          type: 'tool_use',
+          toolCall: {id: 'call-1', name: 'get_weather', input: {}},
+        },
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      // Round 2: Model sees rejection and retries with valid input
+      [
+        {
+          type: 'tool_use',
+          toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'London'}},
+        },
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      // Round 3: Model gives final answer
+      [{type: 'text', text: 'The weather in London is 20c'}, {type: 'stop', stopReason: 'end_turn'}],
+    ]);
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+    const result = await orchestrator.processMessage(createSession('what is the weather?'));
+
+    expect(result).toBe('The weather in London is 20c');
+    expect(executor).toHaveBeenCalledTimes(1);
+    expect(executor).toHaveBeenCalledWith({location: 'London'}, expect.anything());
+  });
+});
