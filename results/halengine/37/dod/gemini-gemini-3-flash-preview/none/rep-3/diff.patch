+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+
+const promptBuilder = new PromptBuilder({identity: 'Test Assistant'});
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+describe('ChatOrchestrator Tool Validation (Acceptance)', () => {
+  it('drives provider through a rejected tool call followed by a corrected retry', async () => {
+    const registry = new ToolRegistry();
+    let calledWith: Record<string, unknown> | undefined;
+
+    registry.register(
+      {
+        name: 'search',
+        description: 'search tool',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            query: {type: 'string'},
+          },
+          required: ['query'],
+        },
+      },
+      async input => {
+        calledWith = input;
+        return 'search result';
+      }
+    );
+
+    const provider = scriptedProvider([
+      // Round 1: Model makes a malformed tool call (missing 'query')
+      [
+        {type: 'tool_use', toolCall: {id: 'c1', name: 'search', input: {}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      // Round 2: Model sees the rejection and retries with correct input
+      [
+        {type: 'tool_use', toolCall: {id: 'c2', name: 'search', input: {query: 'correct'}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      // Round 3: Model finishes
+      [
+        {type: 'text', text: 'final answer'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ]);
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+
+    // specs/hal-engine-tool-input-validation/spec.md#11
+    const result = await orchestrator.processMessage({
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'find something', timestamp: new Date().toISOString()}],
+    });
+
+    expect(result).toBe('final answer');
+    expect(calledWith).toEqual({query: 'correct'});
+  });
+});
