+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import {jest} from '@jest/globals';
+
+describe('ToolRegistry Input Validation (Acceptance)', () => {
+  afterEach(() => {
+    setLogger(undefined); // Restore default logger
+  });
+
+  it('rejects missing required fields and does not call the executor', async () => {
+    // specs/hal-engine-tool-input-validation/spec.md#validation-contract
+    const registry = new ToolRegistry();
+    let called = false;
+    registry.register(
+      {
+        name: 'test-tool',
+        description: 'a test tool',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async () => {
+        called = true;
+        return 'ok';
+      }
+    );
+
+    const response = await registry.execute('test-tool', {});
+
+    expect(response.result).toContain('location');
+    expect(response.result).toContain('required');
+    expect(called).toBe(false);
+  });
+
+  it('passes through extra properties unchanged', async () => {
+    // specs/hal-engine-tool-input-validation/spec.md#validation-contract
+    const registry = new ToolRegistry();
+    let receivedInput: any;
+    registry.register(
+      {
+        name: 'test-tool',
+        description: 'a test tool',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async input => {
+        receivedInput = input;
+        return 'ok';
+      }
+    );
+
+    const input = {location: 'London', extra: 'property'};
+    await registry.execute('test-tool', input);
+
+    expect(receivedInput).toEqual(input);
+  });
+
+  it('rejects wrong-typed fields and redacts values in result and logs', async () => {
+    // specs/hal-engine-tool-input-validation/spec.md#validation-contract
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'test-tool',
+        description: 'a test tool',
+        inputSchema: {
+          type: 'object',
+          properties: {count: {type: 'number'}},
+        },
+      },
+      async () => 'ok'
+    );
+
+    const secretValue = 'VERY_SECRET_VALUE';
+    const logs: any[] = [];
+    setLogger({
+      debug: () => {},
+      info: (cat, msg, fields) => logs.push({msg, fields}),
+      warn: (cat, msg, fields) => logs.push({msg, fields}),
+      error: (cat, msg, fields) => logs.push({msg, fields}),
+    });
+
+    const response = await registry.execute('test-tool', {count: secretValue} as any);
+
+    // Assert result redaction
+    expect(response.result).toContain('count');
+    expect(response.result).toContain('number');
+    expect(response.result).not.toContain(secretValue);
+
+    // Assert log redaction
+    const allLogText = JSON.stringify(logs);
+    expect(allLogText).not.toContain(secretValue);
+  });
+
+  it('throws during registration for broken schemas', async () => {
+    // specs/hal-engine-tool-input-validation/spec.md#performance-and-reliability
+    const registry = new ToolRegistry();
+    const brokenSchema = {type: 'invalid-type'} as any;
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken-tool',
+          description: 'broken',
+          inputSchema: brokenSchema,
+        },
+        async () => 'ok'
+      )
+    ).toThrow(/broken-tool/);
+  });
+
+  it('compiles static tool schema once', async () => {
+    // specs/hal-engine-tool-input-validation/spec.md#performance-and-reliability
+    const registry = new ToolRegistry();
+    let accessCount = 0;
+    const schema = {
+      type: 'object',
+      get properties() {
+        accessCount++;
+        return {location: {type: 'string'}};
+      },
+    };
+
+    registry.register(
+      {
+        name: 'static-tool',
+        description: 'd',
+        inputSchema: schema as any,
+      },
+      async () => 'ok'
+    );
+
+    const initialAccessCount = accessCount;
+    expect(initialAccessCount).toBeGreaterThan(0); // Should have compiled at register time
+
+    await registry.execute('static-tool', {location: 'London'});
+    await registry.execute('static-tool', {location: 'Paris'});
+
+    expect(accessCount).toBe(initialAccessCount); // Should not have re-accessed 'properties' during execution
+  });
+
+  it('validates against the current schema for function-valued definitions', async () => {
+    // specs/hal-engine-tool-input-validation/spec.md#performance-and-reliability
+    const registry = new ToolRegistry();
+    let schema: any = {type: 'object', properties: {a: {type: 'string'}}};
+
+    registry.register(
+      () => ({name: 'dynamic', description: 'd', inputSchema: schema}),
+      async () => 'ok'
+    );
+
+    // First call with first schema
+    const res1 = await registry.execute('dynamic', {a: 'hi'});
+    expect(res1.result).toBe('ok');
+
+    // Change schema
+    schema = {type: 'object', properties: {a: {type: 'number'}}};
+    const res2 = await registry.execute('dynamic', {a: 'hi'});
+    expect(res2.result).not.toBe('ok');
+    expect(res2.result).toContain('number');
+  });
+
+  it('throws Unknown tool for unregistered names', async () => {
+    // specs/hal-engine-tool-input-validation/spec.md#validation-contract
+    const registry = new ToolRegistry();
+    await expect(registry.execute('ghost', {})).rejects.toThrow('Unknown tool: ghost');
+  });
+});