+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const capturingScriptedProvider = (rounds: MessageChunk[][]): {provider: AIProvider; history: any[]} => {
+  let round = 0;
+  const history: any[] = [];
+  return {
+    history,
+    provider: {
+      async *sendMessage(params): AsyncGenerator<MessageChunk> {
+        history.push(params.messages);
+        for (const chunk of rounds[round++] ?? []) yield chunk;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    },
+  };
+};
+
+describe('ChatOrchestrator Tool Input Validation (Acceptance)', () => {
+  it('allows model to recover from a rejected tool call', async () => {
+    // specs/hal-engine-tool-input-validation/spec.md#orchestration
+    const registry = new ToolRegistry();
+    let executorCalledCount = 0;
+    registry.register(
+      {
+        name: 'test-tool',
+        description: 'd',
+        inputSchema: {type: 'object', properties: {a: {type: 'number'}}, required: ['a']},
+      },
+      async () => {
+        executorCalledCount++;
+        return 'success';
+      }
+    );
+
+    const TOOL_CALL_INVALID: MessageChunk = {
+      type: 'tool_use',
+      toolCall: {id: 'c1', name: 'test-tool', input: {a: 'not-a-number'}},
+    };
+    const TOOL_CALL_VALID: MessageChunk = {
+      type: 'tool_use',
+      toolCall: {id: 'c2', name: 'test-tool', input: {a: 42}},
+    };
+    const STOP_FOR_TOOL: MessageChunk = {type: 'stop', stopReason: 'tool_use'};
+    const STOP_DONE: MessageChunk = {type: 'stop', stopReason: 'end_turn'};
+
+    const {provider, history} = capturingScriptedProvider([
+      [TOOL_CALL_INVALID, STOP_FOR_TOOL],
+      [TOOL_CALL_VALID, STOP_FOR_TOOL],
+      [{type: 'text', text: 'got it'}, STOP_DONE],
+    ]);
+
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'i'}), registry);
+    const session = createSession('do something');
+
+    const result = await orchestrator.processMessage(session);
+
+    expect(result).toBe('got it');
+    expect(executorCalledCount).toBe(1); // Should only be called once (the valid call)
+
+    // Check round 1 history (after round 0 produced TOOL_CALL_INVALID)
+    // history[0] is round 0 (input: user message)
+    // history[1] is round 1 (input: user message + assistant tool call + user tool result)
+    expect(history).toHaveLength(3);
+
+    const round1Messages = history[1];
+    const lastMessage = round1Messages[round1Messages.length - 1];
+    expect(lastMessage.role).toBe('user');
+    expect(Array.isArray(lastMessage.content)).toBe(true);
+    expect(lastMessage.content[0].type).toBe('tool_result');
+    expect(lastMessage.content[0].content).toContain('number'); // The rejection message
+  });
+});
