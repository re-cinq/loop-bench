+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {MessageChunk} from '../types/ai.js';
+import {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const chunksFrom = async (stream: AsyncGenerator<MessageChunk>): Promise<MessageChunk[]> => {
+  const chunks: MessageChunk[] = [];
+  for await (const chunk of stream) chunks.push(chunk);
+  return chunks;
+};
+
+describe('Tool Loop Rejection (Acceptance)', () => {
+  it('drives a rejected tool call followed by a corrected retry', async () => {
+    // ticket #37 acceptance criterion
+    // specs/hal-engine-tool-input-validation/spec.md#8
+
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'weather',
+        description: 'get weather',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async input => 'Weather in ' + input.location + ' is sunny'
+    );
+
+    const rounds: MessageChunk[][] = [
+      // Round 1: Model makes a malformed call (missing 'location')
+      [
+        {type: 'tool_use', toolCall: {id: 'c1', name: 'weather', input: {}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      // Round 2: Model sees rejection and retries with valid input
+      [
+        {type: 'tool_use', toolCall: {id: 'c2', name: 'weather', input: {location: 'London'}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      // Round 3: Final answer
+      [
+        {type: 'text', text: 'It is sunny in London.'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ];
+
+    let currentRound = 0;
+    const provider = {
+      async *sendMessage(params: any) {
+        // Assert that in Round 2, the model sees the rejection result
+        if (currentRound === 1) {
+          const lastMsg = params.messages[params.messages.length - 1];
+          expect(lastMsg.role).toBe('user');
+          expect(lastMsg.content[0].type).toBe('tool_result');
+          expect(lastMsg.content[0].content).toContain('location');
+          expect(lastMsg.content[0].content).toContain('required');
+        }
+        for (const chunk of rounds[currentRound++] || []) yield chunk;
+      },
+      async generateStructured() {
+        return {};
+      },
+    } as any;
+
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), registry);
+
+    const chunks = await chunksFrom(orchestrator.processMessageStream(createSession('what is the weather?')));
+
+    expect(chunks.filter(c => c.type === 'tool_use')).toHaveLength(2);
+    expect(chunks.find(c => c.type === 'text')).toEqual({type: 'text', text: 'It is sunny in London.'});
+  });
+});
