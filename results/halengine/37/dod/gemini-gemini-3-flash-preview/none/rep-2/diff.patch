+import {ToolRegistry} from './registry.js';
+import {ToolDefinition} from '../../types/ai.js';
+import {jest} from '@jest/globals';
+import {readFileSync} from 'fs';
+import {join} from 'path';
+
+// Load package.json manually to avoid ESM import issues with JSON
+const pkgPath = join(process.cwd(), 'package.json');
+const pkg = JSON.parse(readFileSync(pkgPath, 'utf8'));
+
+describe('Tool Input Validation (Acceptance)', () => {
+  it('rejects missing required property and does not call executor', async () => {
+    // specs/hal-engine-tool-input-validation/spec.md#1
+    // specs/hal-engine-tool-input-validation/spec.md#2
+    // specs/hal-engine-tool-input-validation/spec.md#3
+    const registry = new ToolRegistry();
+    const executor = jest.fn().mockResolvedValue('ok');
+    const definition: ToolDefinition = {
+      name: 'test_tool',
+      description: 'test',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          location: {type: 'string'},
+        },
+        required: ['location'],
+      },
+    };
+    registry.register(definition, executor);
+
+    const response = await registry.execute('test_tool', {});
+
+    expect(response.result).toContain('location');
+    expect(response.result).toContain('required');
+    expect(executor).not.toHaveBeenCalled();
+  });
+
+  it('passes through extra properties unchanged', async () => {
+    // specs/hal-engine-tool-input-validation/spec.md#5
+    const registry = new ToolRegistry();
+    const executor = jest.fn().mockResolvedValue('ok');
+    const definition: ToolDefinition = {
+      name: 'test_tool',
+      description: 'test',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          location: {type: 'string'},
+        },
+      },
+    };
+    registry.register(definition, executor);
+
+    const input = {location: 'London', extra: 'value'};
+    await registry.execute('test_tool', input);
+
+    expect(executor).toHaveBeenCalledWith(input, undefined);
+    // verify toEqual to ensure no defaults/coercion
+    expect(executor.mock.calls[0][0]).toEqual(input);
+  });
+
+  it('rejects wrong-typed field and redacts the value', async () => {
+    // specs/hal-engine-tool-input-validation/spec.md#4
+    // specs/hal-engine-tool-input-validation/spec.md#6
+    const registry = new ToolRegistry();
+    const executor = jest.fn().mockResolvedValue('ok');
+    const definition: ToolDefinition = {
+      name: 'test_tool',
+      description: 'test',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          count: {type: 'number'},
+        },
+      },
+    };
+    registry.register(definition, executor);
+
+    const secretValue = 'SECRET_123';
+    const response = await registry.execute('test_tool', {count: secretValue} as any);
+
+    expect(response.result).toContain('count');
+    expect(response.result).toContain('number');
+    expect(response.result).not.toContain(secretValue);
+  });
+
+  it('throws at registration time for uncompilable schema', async () => {
+    // specs/hal-engine-tool-input-validation/spec.md#7
+    const registry = new ToolRegistry();
+    const brokenDefinition = {
+      name: 'broken_tool',
+      description: 'test',
+      inputSchema: {
+        type: 'invalid_type',
+      },
+    } as any;
+
+    expect(() => registry.register(brokenDefinition, async () => 'ok')).toThrow(/broken_tool/);
+  });
+
+  it('validates against current schema for function-valued definitions', async () => {
+    // specs/hal-engine-tool-input-validation/spec.md#7
+    const registry = new ToolRegistry();
+    const executor = jest.fn().mockResolvedValue('ok');
+    let schemaType = 'string';
+    const source = () => ({
+      name: 'dynamic_tool',
+      description: 'test',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          val: {type: schemaType},
+        },
+      },
+    });
+
+    registry.register(source, executor);
+
+    // First call: string
+    await registry.execute('dynamic_tool', {val: 'str'});
+
+    // Change schema to number
+    schemaType = 'number';
+    const response = await registry.execute('dynamic_tool', {val: 'str'});
+
+    expect(response.result).toContain('number');
+  });
+
+  it('asserts a static tool schema is compiled once across ten execute calls', async () => {
+    // specs/hal-engine-tool-input-validation/spec.md#7
+    const Ajv = (await import('ajv')).default;
+    const compileSpy = jest.spyOn(Ajv.prototype, 'compile');
+
+    const registry = new ToolRegistry();
+    const definition: ToolDefinition = {
+      name: 'static_tool',
+      description: 'test',
+      inputSchema: {type: 'object', properties: {v: {type: 'string'}}},
+    };
+    registry.register(definition, async () => 'ok');
+
+    // It should compile once during registration (or first use)
+    const initialCallCount = compileSpy.mock.calls.length;
+
+    for (let i = 0; i < 10; i++) {
+      await registry.execute('static_tool', {v: 'a'});
+    }
+
+    // Total calls should be initialCallCount (if compiled at registration) or initialCallCount + 1
+    // But definitely not incrementing per execute.
+    expect(compileSpy.mock.calls.length).toBeGreaterThan(0);
+    expect(compileSpy.mock.calls.length).toBeLessThanOrEqual(initialCallCount + 1);
+
+    compileSpy.mockRestore();
+  });
+
+  it('redacts input values from logs and results', async () => {
+    // specs/hal-engine-tool-input-validation/spec.md#6
+    const registry = new ToolRegistry();
+    const definition: ToolDefinition = {
+      name: 'pii_tool',
+      description: 'test',
+      inputSchema: {type: 'object', properties: {secret: {type: 'string'}}, required: ['secret']},
+    };
+    registry.register(definition, async () => 'ok');
+
+    const logs: any[] = [];
+    const mockLogger = {
+      debug: jest.fn(),
+      info: (cat: string, msg: string, data: any) => logs.push({msg, data}),
+      warn: (cat: string, msg: string, data: any) => logs.push({msg, data}),
+      error: jest.fn(),
+    };
+    const {setLogger} = await import('../../shared/logger.js');
+    setLogger(mockLogger as any);
+
+    try {
+      const secretValue = 'MY_PRIVATE_KEY_123';
+      const response = await registry.execute('pii_tool', {secret: 123} as any); // wrong type
+
+      // Assert it was actually rejected (this fails today because it returns 'ok')
+      expect(response.result).toContain('secret');
+
+      // Assert result redacts
+      expect(response.result).not.toContain(secretValue);
+      expect(response.result).not.toContain('123');
+
+      // Assert logs redact
+      const allLogText = JSON.stringify(logs);
+      expect(allLogText).not.toContain(secretValue);
+      expect(allLogText).not.toContain('123');
+    } finally {
+      setLogger(undefined);
+    }
+  });
+
+  it('throws Unknown tool for unregistered names', async () => {
+    // specs/hal-engine-tool-input-validation/spec.md#9
+    const registry = new ToolRegistry();
+    await expect(registry.execute('ghost', {})).rejects.toThrow('Unknown tool: ghost');
+  });
+
+  it('asserts ajv is in dependencies', () => {
+    // ticket #37 acceptance criterion
+    expect(pkg.dependencies).toHaveProperty('ajv');
+  });
+});