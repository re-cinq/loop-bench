@@ -0,0 +1,136 @@
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry Input Validation (Acceptance)', () => {
+  it('validates input against schema and returns ToolResponse on failure ([validated by 1](specs/hal-engine-tool-input-validation/spec.md#L30))', async () => {
+    const registry = new ToolRegistry();
+    let executorCalled = 0;
+
+    registry.register(
+      {
+        name: 'test-tool',
+        description: 'a tool',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+          },
+          required: ['location'],
+        },
+      },
+      async () => {
+        executorCalled++;
+        return 'ok';
+      }
+    );
+
+    // Call with missing required property
+    const response = await registry.execute('test-tool', {});
+
+    expect(response.result).toContain('location');
+    expect(response.result).toContain('required');
+    expect(executorCalled).toBe(0);
+  });
+
+  it('passes through extra properties unchanged ([validated by 6](specs/hal-engine-tool-input-validation/spec.md#L35))', async () => {
+    const registry = new ToolRegistry();
+    let receivedInput: Record<string, unknown> = {};
+
+    registry.register(
+      {
+        name: 'test-tool',
+        description: 'a tool',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+          },
+        },
+      },
+      async input => {
+        receivedInput = input;
+        return 'ok';
+      }
+    );
+
+    const input = {location: 'London', extra: 'property'};
+    await registry.execute('test-tool', input);
+
+    expect(receivedInput).toEqual(input);
+  });
+
+  it('rejects wrong-typed fields without leaking the value ([validated by 2](specs/hal-engine-tool-input-validation/spec.md#L40))', async () => {
+    const registry = new ToolRegistry();
+
+    registry.register(
+      {
+        name: 'test-tool',
+        description: 'a tool',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            count: {type: 'number'},
+          },
+        },
+      },
+      async () => 'ok'
+    );
+
+    const secretValue = '999-secret-value';
+    const response = await registry.execute('test-tool', {count: secretValue} as any);
+
+    expect(response.result).toContain('count');
+    expect(response.result).toContain('number');
+    expect(response.result).not.toContain(secretValue);
+  });
+
+  it('throws at registration time for invalid schemas ([validated by 2](specs/hal-engine-tool-input-validation/spec.md#L45))', () => {
+    const registry = new ToolRegistry();
+
+    expect(() => {
+      registry.register(
+        {
+          name: 'bad-tool',
+          description: 'bad schema',
+          inputSchema: {type: 'invalid-type'},
+        },
+        async () => 'ok'
+      );
+    }).toThrow(/bad-tool/);
+  });
+
+  it('validates function-valued tools against current schema ([validated by 3](specs/hal-engine-tool-input-validation/spec.md#L46))', async () => {
+    const registry = new ToolRegistry();
+    let currentType = 'string';
+
+    registry.register(
+      () => ({
+        name: 'dynamic-tool',
+        description: 'dynamic schema',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            val: {type: currentType},
+          },
+        },
+      }),
+      async () => 'ok'
+    );
+
+    // First call: should accept string
+    const res1 = await registry.execute('dynamic-tool', {val: 'hello'});
+    expect(res1.result).toBe('ok');
+
+    // Change schema
+    currentType = 'number';
+
+    // Second call: should reject string, accept number
+    const res2 = await registry.execute('dynamic-tool', {val: 'hello'});
+    expect(res2.result).not.toBe('ok');
+    expect(res2.result).toContain('number');
+  });
+
+  it('maintains Unknown tool throw ([validated by 3](specs/hal-engine-tool-input-validation/spec.md#L41))', async () => {
+    const registry = new ToolRegistry();
+    await expect(registry.execute('missing', {})).rejects.toThrow('Unknown tool: missing');
+  });
+});