+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+
+describe('ToolRegistry inputSchema validation acceptance', () => {
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('returns a ToolResponse naming the missing required property and does not invoke the executor', async () => {
+    let callCount = 0;
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Look up weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async () => {
+        callCount += 1;
+        return 'forecast';
+      }
+    );
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({
+      callCount,
+      mentionsLocation: response.result.includes('location'),
+      mentionsRequired: /required/i.test(response.result),
+    }).toEqual({
+      callCount: 0,
+      mentionsLocation: true,
+      mentionsRequired: true,
+    });
+  });
+
+  it('rejects wrong-typed or disallowed-enum fields naming path and constraint without leaking values', async () => {
+    const capturedLogs: Array<{category: string; message: string; fields?: Record<string, unknown>}> = [];
+    const record = (category: string, message: string, fields?: Record<string, unknown>) =>
+      void capturedLogs.push({category, message, fields});
+    const logger: Logger = {debug: record, info: record, warn: record, error: record};
+    setLogger(logger);
+
+    let callCount = 0;
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'weather_check',
+        description: 'Check weather with units',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+            units: {type: 'string', enum: ['celsius', 'fahrenheit']},
+          },
+          required: ['location'],
+        },
+      },
+      async () => {
+        callCount += 1;
+        return 'ok';
+      }
+    );
+
+    const wrongTypeResponse = await registry.execute('weather_check', {
+      location: 99887766,
+      secretToken: 'SECRET_PII_12345',
+    });
+    const wrongEnumResponse = await registry.execute('weather_check', {
+      location: 'Berlin',
+      units: 'SECRET_KELVIN_VAL',
+    });
+
+    const serializedLogs = JSON.stringify(capturedLogs);
+    const forbiddenValues = ['99887766', 'SECRET_PII_12345', 'SECRET_KELVIN_VAL'];
+
+    expect({
+      callCount,
+      typeNamesField: wrongTypeResponse.result.includes('location'),
+      typeNamesExpected: /string/i.test(wrongTypeResponse.result),
+      enumNamesField: wrongEnumResponse.result.includes('units'),
+      enumNamesConstraint: /enum|allowed/i.test(wrongEnumResponse.result),
+      leakedInTypeResult: forbiddenValues.some(secret => wrongTypeResponse.result.includes(secret)),
+      leakedInEnumResult: forbiddenValues.some(secret => wrongEnumResponse.result.includes(secret)),
+      leakedInLogs: forbiddenValues.some(secret => serializedLogs.includes(secret)),
+    }).toEqual({
+      callCount: 0,
+      typeNamesField: true,
+      typeNamesExpected: true,
+      enumNamesField: true,
+      enumNamesConstraint: true,
+      leakedInTypeResult: false,
+      leakedInEnumResult: false,
+      leakedInLogs: false,
+    });
+  });
+
+  it('throws synchronously at register time when inputSchema is uncompilable and names the tool', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_tool',
+          description: 'Tool with an uncompilable schema',
+          inputSchema: {type: 'unrecognized_json_type'},
+        },
+        async () => 'ok'
+      )
+    ).toThrow(/broken_tool/);
+  });
+
+  it('validates a function-valued ToolDefinitionSource against the schema current at each execute call', async () => {
+    let requiredField = 'city';
+    const receivedInputs: Array<Record<string, unknown>> = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      () => ({
+        name: 'dynamic_lookup',
+        description: 'Lookup with changing schema',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            city: {type: 'string'},
+            postalCode: {type: 'string'},
+          },
+          required: [requiredField],
+        },
+      }),
+      async input => {
+        receivedInputs.push(input);
+        return 'ok';
+      }
+    );
+
+    const firstResponse = await registry.execute('dynamic_lookup', {city: 'Paris'});
+    requiredField = 'postalCode';
+    const secondResponse = await registry.execute('dynamic_lookup', {city: 'Paris'});
+    const thirdResponse = await registry.execute('dynamic_lookup', {postalCode: '75001'});
+
+    expect({
+      receivedInputs,
+      firstSucceeded: firstResponse.result === 'ok',
+      secondNamesPostalCode: secondResponse.result.includes('postalCode'),
+      thirdSucceeded: thirdResponse.result === 'ok',
+    }).toEqual({
+      receivedInputs: [{city: 'Paris'}, {postalCode: '75001'}],
+      firstSucceeded: true,
+      secondNamesPostalCode: true,
+      thirdSucceeded: true,
+    });
+  });
+});