+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, Message, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+describe('ChatOrchestrator schema rejection retry acceptance', () => {
+  it('resolves after a rejected tool call by returning the validation error to the model and passing the retry unchanged', async () => {
+    const executorInputs: Array<Record<string, unknown>> = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Look up weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+            units: {type: 'string', default: 'celsius'},
+          },
+          required: ['location'],
+        },
+      },
+      async input => {
+        executorInputs.push(input);
+        return 'Sunny, 20C';
+      }
+    );
+
+    const capturedRounds: Message[][] = [];
+    const rounds: MessageChunk[][] = [
+      [
+        {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {
+          type: 'tool_use',
+          toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Berlin', extraTag: 'keep'}},
+        },
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'text', text: 'Forecast ready.'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ];
+    let roundIndex = 0;
+
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        capturedRounds.push(params.messages.map(msg => ({...msg})));
+        for (const chunk of rounds[roundIndex++] ?? []) yield chunk;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+    const session: ChatSession = {
+      sessionId: 's-retry',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'Weather please', timestamp: SENT_AT}],
+    };
+
+    const reply = await orchestrator.processMessage(session);
+    const roundOneText = extractToolResultContent(capturedRounds[1] ?? [], 'call-1');
+
+    expect({
+      reply,
+      executorInputs,
+      mentionsLocation: roundOneText.includes('location'),
+      mentionsRequired: /required/i.test(roundOneText),
+    }).toEqual({
+      reply: 'Forecast ready.',
+      executorInputs: [{location: 'Berlin', extraTag: 'keep'}],
+      mentionsLocation: true,
+      mentionsRequired: true,
+    });
+  });
+});
+
+function extractToolResultContent(messages: Message[], toolUseId: string): string {
+  const last = messages[messages.length - 1];
+  if (!last || last.role !== 'user' || typeof last.content === 'string') return '';
+  const match = last.content.find(entry => entry.type === 'tool_result' && entry.toolUseId === toolUseId);
+  return match?.content ?? '';
+}
