+import {ToolRegistry} from './registry.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+import type {
+  AIProvider,
+  Message,
+  MessageChunk,
+  SendMessageParams,
+  ToolDefinition,
+  ToolResultMessage,
+} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+
+interface RecordedLog {
+  level: string;
+  category: string;
+  message: string;
+  fields?: Record<string, unknown>;
+}
+
+const createCapturingLogger = (entries: RecordedLog[]): Logger => {
+  const push = (level: string) => (category: string, message: string, fields?: Record<string, unknown>) => {
+    entries.push({level, category, message, fields});
+  };
+  return {
+    debug: push('DEBUG'),
+    info: push('INFO'),
+    warn: push('WARN'),
+    error: push('ERROR'),
+  };
+};
+
+describe('ToolRegistry inputSchema validation acceptance', () => {
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('rejects malformed tool input with a ToolResponse naming the failing path and constraint without invoking the executor or leaking values', async () => {
+    const capturedLogs: RecordedLog[] = [];
+    setLogger(createCapturingLogger(capturedLogs));
+
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Look up weather conditions',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+            count: {type: 'number'},
+            units: {type: 'string', enum: ['celsius', 'fahrenheit']},
+          },
+          required: ['location'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'executed';
+      }
+    );
+
+    const missingResponse = await registry.execute('get_weather', {});
+    const typeResponse = await registry.execute('get_weather', {location: 987654});
+    const coercionResponse = await registry.execute('get_weather', {location: 'Berlin', count: '424242'});
+    const enumResponse = await registry.execute('get_weather', {location: 'Berlin', units: 'kelvin-secret'});
+
+    const allOutputs = [
+      missingResponse.result,
+      typeResponse.result,
+      coercionResponse.result,
+      enumResponse.result,
+      JSON.stringify(capturedLogs),
+    ].join('\n');
+
+    const secretTokens = ['987654', '424242', 'kelvin-secret'];
+    const leakedValues = secretTokens.filter(token => allOutputs.includes(token));
+
+    expect({
+      executorCalls,
+      missingNamesLocationAndRequired:
+        /location/i.test(missingResponse.result) && /required/i.test(missingResponse.result),
+      typeNamesLocationAndString: /location/i.test(typeResponse.result) && /string|type/i.test(typeResponse.result),
+      coercionNamesCountAndNumber:
+        /count/i.test(coercionResponse.result) && /number|type/i.test(coercionResponse.result),
+      enumNamesUnitsAndConstraint:
+        /units/i.test(enumResponse.result) && /enum|allowed values/i.test(enumResponse.result),
+      leakedValues,
+    }).toEqual({
+      executorCalls: 0,
+      missingNamesLocationAndRequired: true,
+      typeNamesLocationAndString: true,
+      coercionNamesCountAndNumber: true,
+      enumNamesUnitsAndConstraint: true,
+      leakedValues: [],
+    });
+  });
+
+  it('throws synchronously at register time when a static inputSchema is uncompilable and names the tool', () => {
+    const registry = new ToolRegistry();
+    const brokenDefinition: ToolDefinition = {
+      name: 'broken_schema_tool',
+      description: 'Tool with an uncompilable JSON schema',
+      inputSchema: {
+        type: 'object',
+        required: 'not-an-array' as unknown as string[],
+      },
+    };
+
+    expect(() => registry.register(brokenDefinition, async () => 'ok')).toThrow(/broken_schema_tool/);
+  });
+
+  it('validates a function-valued ToolDefinitionSource against the schema current at each execute call', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    let activeSchema: Record<string, unknown> = {
+      type: 'object',
+      properties: {alpha: {type: 'string'}},
+      required: ['alpha'],
+    };
+
+    registry.register(
+      () => ({
+        name: 'dynamic_tool',
+        description: 'Tool with changing schema',
+        inputSchema: activeSchema,
+      }),
+      async () => {
+        executorCalls += 1;
+        return 'ok';
+      }
+    );
+
+    const firstResponse = await registry.execute('dynamic_tool', {alpha: 'first'});
+
+    activeSchema = {
+      type: 'object',
+      properties: {beta: {type: 'string'}},
+      required: ['beta'],
+    };
+
+    const staleResponse = await registry.execute('dynamic_tool', {alpha: 'stale'});
+    const freshResponse = await registry.execute('dynamic_tool', {beta: 'fresh'});
+
+    expect({
+      firstResult: firstResponse.result,
+      staleNamesBetaAndRequired: /beta/i.test(staleResponse.result) && /required/i.test(staleResponse.result),
+      freshResult: freshResponse.result,
+      executorCalls,
+    }).toEqual({
+      firstResult: 'ok',
+      staleNamesBetaAndRequired: true,
+      freshResult: 'ok',
+      executorCalls: 2,
+    });
+  });
+
+  it('drives a rejected tool call through chatOrchestrator to a corrected retry without stripping extra properties or applying defaults', async () => {
+    const registry = new ToolRegistry();
+    const receivedInputs: Record<string, unknown>[] = [];
+
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Look up weather conditions',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+            units: {type: 'string', default: 'celsius'},
+          },
+          required: ['location'],
+        },
+      },
+      async input => {
+        receivedInputs.push(structuredClone(input));
+        return JSON.stringify({forecast: 'sunny'});
+      }
+    );
+
+    let callRound = 0;
+    let roundOneMessages: Message[] = [];
+
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        const round = callRound;
+        callRound += 1;
+
+        if (round === 0) {
+          yield {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+
+        if (round === 1) {
+          roundOneMessages = structuredClone(params.messages);
+          yield {
+            type: 'tool_use',
+            toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Berlin', extraTag: 'keep-me'}},
+          };
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+
+        yield {type: 'text', text: 'Sunny in Berlin'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        throw new Error('unused in this test');
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), registry);
+    const session: ChatSession = {
+      sessionId: 'sess-1',
+      userId: 'user-1',
+      entries: [{role: 'user', content: 'Weather in Berlin?', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+
+    const reply = await orchestrator.processMessage(session);
+    const toolResultMessage = roundOneMessages.find(
+      (msg): msg is ToolResultMessage =>
+        msg.role === 'user' && Array.isArray(msg.content) && msg.content.some(part => part.type === 'tool_result')
+    );
+    const firstToolResult = toolResultMessage?.content[0]?.content ?? '';
+
+    expect({
+      reply,
+      receivedInputs,
+      rejectionNamesLocationAndRequired: /location/i.test(firstToolResult) && /required/i.test(firstToolResult),
+    }).toEqual({
+      reply: 'Sunny in Berlin',
+      receivedInputs: [{location: 'Berlin', extraTag: 'keep-me'}],
+      rejectionNamesLocationAndRequired: true,
+    });
+  });
+});