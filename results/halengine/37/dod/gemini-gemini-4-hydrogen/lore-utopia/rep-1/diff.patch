@@ -0,0 +1,137 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+import {setLogger} from '../../shared/logger.js';
+
+const weatherTool: ToolDefinition = {
+  name: 'get_weather',
+  description: 'Get the current weather for a location.',
+  inputSchema: {
+    type: 'object',
+    properties: {
+      location: {type: 'string'},
+      units: {type: 'string', enum: ['celsius', 'fahrenheit'], default: 'celsius'},
+      days: {type: 'number'},
+    },
+    required: ['location'],
+  },
+};
+
+describe('ToolRegistry inputSchema validation (acceptance)', () => {
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('rejects missing required, wrong-typed, and disallowed-enum input before calling the executor without leaking offending values', async () => {
+    const capturedLogs: string[] = [];
+    const recordLog = (level: string) => (category: string, message: string, fields?: Record<string, unknown>) =>
+      void capturedLogs.push(JSON.stringify({level, category, message, fields}));
+    setLogger({
+      debug: recordLog('debug'),
+      info: recordLog('info'),
+      warn: recordLog('warn'),
+      error: recordLog('error'),
+    });
+
+    let executorCalls = 0;
+    const registry = new ToolRegistry();
+    registry.register(weatherTool, async () => {
+      executorCalls += 1;
+      return 'ok';
+    });
+
+    const missingRequired = await registry.execute('get_weather', {});
+    const wrongType = await registry.execute('get_weather', {location: 987654321});
+    const unlistedEnum = await registry.execute('get_weather', {location: 'Berlin', units: 'kelvin-secret'});
+    const serializedLogs = capturedLogs.join('\n');
+
+    expect({
+      executorCalls,
+      missingResult: missingRequired.result,
+      wrongTypeResult: wrongType.result,
+      unlistedEnumResult: unlistedEnum.result,
+      leakedNumeric: wrongType.result.includes('987654321') || serializedLogs.includes('987654321'),
+      leakedEnum: unlistedEnum.result.includes('kelvin-secret') || serializedLogs.includes('kelvin-secret'),
+    }).toEqual({
+      executorCalls: 0,
+      missingResult: expect.stringMatching(/(?=.*location)(?=.*required)/i),
+      wrongTypeResult: expect.stringMatching(/(?=.*location)(?=.*string)/i),
+      unlistedEnumResult: expect.stringMatching(/units/i),
+      leakedNumeric: false,
+      leakedEnum: false,
+    });
+  });
+
+  it('passes valid input with unlisted properties and omitted defaulted fields through unmodified while rejecting uncoerced type mismatches', async () => {
+    const receivedInputs: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(weatherTool, async input => {
+      receivedInputs.push({...input});
+      return 'ok';
+    });
+
+    const validResponse = await registry.execute('get_weather', {location: 'Berlin', extraField: 'preserved'});
+    const uncoercedResponse = await registry.execute('get_weather', {location: 'Berlin', days: '3'});
+
+    expect({
+      validResult: validResponse.result,
+      receivedInputs,
+      uncoercedResult: uncoercedResponse.result,
+    }).toEqual({
+      validResult: 'ok',
+      receivedInputs: [{location: 'Berlin', extraField: 'preserved'}],
+      uncoercedResult: expect.stringMatching(/(?=.*days)(?=.*number)/i),
+    });
+  });
+
+  it('throws synchronously at register time for an uncompilable inputSchema and names the tool', () => {
+    const registry = new ToolRegistry();
+    const malformedTool: ToolDefinition = {
+      name: 'broken_tool',
+      description: 'Tool with an uncompilable JSON Schema.',
+      inputSchema: {
+        type: 'bogus',
+        properties: 'must-be-an-object',
+      },
+    };
+
+    expect(() => registry.register(malformedTool, async () => 'ok')).toThrow(/broken_tool/);
+  });
+
+  it('validates a function-valued ToolDefinitionSource against the schema returned on each call', async () => {
+    let requiredField = 'firstField';
+    let executorCalls = 0;
+    const registry = new ToolRegistry();
+    registry.register(
+      () => ({
+        name: 'dynamic_tool',
+        description: 'Tool whose schema changes dynamically.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            firstField: {type: 'string'},
+            secondField: {type: 'string'},
+          },
+          required: [requiredField],
+        },
+      }),
+      async () => {
+        executorCalls += 1;
+        return 'ok';
+      }
+    );
+
+    const firstPass = await registry.execute('dynamic_tool', {firstField: 'alpha'});
+    requiredField = 'secondField';
+    const afterSchemaChange = await registry.execute('dynamic_tool', {firstField: 'alpha'});
+
+    expect({
+      firstResult: firstPass.result,
+      afterChangeResult: afterSchemaChange.result,
+      executorCalls,
+    }).toEqual({
+      firstResult: 'ok',
+      afterChangeResult: expect.stringMatching(/(?=.*secondField)(?=.*required)/i),
+      executorCalls: 1,
+    });
+  });
+});