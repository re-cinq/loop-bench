+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+describe('ChatOrchestrator tool validation retry loop (acceptance)', () => {
+  it('returns schema rejection to the model so it can retry with valid input and resolve', async () => {
+    const executorCalls: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get the current weather for a location.',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async input => {
+        executorCalls.push({...input});
+        return `Sunny in ${String(input.location)}`;
+      }
+    );
+
+    let round = 0;
+    let roundTwoToolResult = '';
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        round += 1;
+        if (round === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        if (round === 2) {
+          const {messages} = params;
+          const lastMessage = messages[messages.length - 1];
+          const firstBlock = Array.isArray(lastMessage.content) ? lastMessage.content[0] : undefined;
+          roundTwoToolResult = firstBlock?.type === 'tool_result' ? firstBlock.content : roundTwoToolResult;
+          yield {type: 'tool_use', toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Berlin'}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        yield {type: 'text', text: 'Weather in Berlin: Sunny'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Test assistant.'}), registry);
+    const session: ChatSession = {
+      sessionId: 's-validation',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'What is the weather in Berlin?', timestamp: SENT_AT}],
+    };
+
+    const reply = await orchestrator.processMessage(session);
+
+    expect({reply, executorCalls, roundTwoToolResult}).toEqual({
+      reply: 'Weather in Berlin: Sunny',
+      executorCalls: [{location: 'Berlin'}],
+      roundTwoToolResult: expect.stringMatching(/(?=.*location)(?=.*required)/i),
+    });
+  });
+});
