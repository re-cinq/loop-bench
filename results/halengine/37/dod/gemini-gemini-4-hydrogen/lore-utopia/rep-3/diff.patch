+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {AIProvider, Message, MessageChunk, SendMessageParams, ToolDefinition} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+import {ToolRegistry} from './registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+describe('ToolRegistry inputSchema validation acceptance', () => {
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('throws at registration when a static inputSchema fails to compile, naming the tool', () => {
+    const registry = new ToolRegistry();
+    const brokenDefinition: ToolDefinition = {
+      name: 'broken_tool',
+      description: 'Tool with an invalid schema',
+      inputSchema: {type: 'not-a-json-schema-type'},
+    };
+
+    expect(() => registry.register(brokenDefinition, async () => 'ok')).toThrow('broken_tool');
+  });
+
+  it('rejects schema-invalid input without calling the executor and without leaking input values', async () => {
+    const recordedLogs: string[] = [];
+    const record = (category: string, message: string, fields?: Record<string, unknown>) => {
+      recordedLogs.push(JSON.stringify({category, message, fields}));
+    };
+    setLogger({debug: record, info: record, warn: record, error: record});
+
+    let executorCalls = 0;
+    const registry = new ToolRegistry();
+    registry.register(weatherDefinition(['celsius', 'fahrenheit']), async () => {
+      executorCalls += 1;
+      return 'sunny';
+    });
+
+    const response = await registry.execute('get_weather', {
+      location: 987654,
+      callerEmail: 'alice@example.com',
+    });
+    const joinedLogs = recordedLogs.join('\n');
+
+    expect({
+      executorCalls,
+      namesFailingPath: response.result.includes('location'),
+      namesExpectedType: /string/i.test(response.result),
+      leakedInResult: response.result.includes('987654') || response.result.includes('alice@example.com'),
+      leakedInLogs: joinedLogs.includes('987654') || joinedLogs.includes('alice@example.com'),
+    }).toEqual({
+      executorCalls: 0,
+      namesFailingPath: true,
+      namesExpectedType: true,
+      leakedInResult: false,
+      leakedInLogs: false,
+    });
+  });
+
+  it('validates dynamic tool definitions against the current schema and passes unlisted properties through unchanged', async () => {
+    let allowedUnits = ['celsius', 'fahrenheit'];
+    const receivedInputs: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      () => weatherDefinition(allowedUnits),
+      async input => {
+        receivedInputs.push(input);
+        return 'ok';
+      }
+    );
+
+    await registry.execute('get_weather', {
+      location: 'Berlin',
+      units: 'celsius',
+      extraTag: 'keep-me',
+    });
+    allowedUnits = ['kelvin'];
+    const secondResponse = await registry.execute('get_weather', {
+      location: 'Berlin',
+      units: 'celsius',
+      extraTag: 'keep-me',
+    });
+
+    expect({
+      receivedInputs,
+      secondNamesUnits: secondResponse.result.includes('units'),
+      secondLeakedValue: secondResponse.result.includes('celsius'),
+    }).toEqual({
+      receivedInputs: [{location: 'Berlin', units: 'celsius', extraTag: 'keep-me'}],
+      secondNamesUnits: true,
+      secondLeakedValue: false,
+    });
+  });
+
+  it('compiles a static tool schema once across repeated executions', async () => {
+    let schemaPropertyReads = 0;
+    let executorCalls = 0;
+    const inputSchema: Record<string, unknown> = {
+      type: 'object',
+      required: ['location'],
+      get properties() {
+        schemaPropertyReads += 1;
+        return {location: {type: 'string'}};
+      },
+    };
+    const registry = new ToolRegistry();
+    registry.register({name: 'get_weather', description: 'Weather lookup', inputSchema}, async () => {
+      executorCalls += 1;
+      return 'ok';
+    });
+    const readsAtRegister = schemaPropertyReads;
+
+    const results: string[] = [];
+    for (let callIndex = 0; callIndex < 10; callIndex += 1) {
+      const response = await registry.execute('get_weather', {});
+      results.push(response.result);
+    }
+
+    expect({
+      compiledAtRegister: readsAtRegister > 0,
+      recompiledOnExecute: schemaPropertyReads > readsAtRegister,
+      executorCalls,
+      allRejectedLocation: results.every(result => result.includes('location')),
+    }).toEqual({
+      compiledAtRegister: true,
+      recompiledOnExecute: false,
+      executorCalls: 0,
+      allRejectedLocation: true,
+    });
+  });
+
+  it('returns a validation rejection to the model so the orchestrator tool loop can retry and resolve', async () => {
+    const executorInputs: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(weatherDefinition(['celsius', 'fahrenheit']), async input => {
+      executorInputs.push(input);
+      return '18C in Berlin';
+    });
+
+    const capturedToolResults: string[] = [];
+    const provider = createRetryingProvider(capturedToolResults);
+    const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+    const session: ChatSession = {
+      sessionId: 's-validation',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'Weather in Berlin?', timestamp: SENT_AT}],
+    };
+
+    const reply = await createChatOrchestrator(provider, promptBuilder, registry).processMessage(session);
+
+    expect({
+      reply,
+      executorInputs,
+      firstRejectionNamesLocation: capturedToolResults[0]?.includes('location') ?? false,
+    }).toEqual({
+      reply: 'Forecast: 18C in Berlin',
+      executorInputs: [{location: 'Berlin'}],
+      firstRejectionNamesLocation: true,
+    });
+  });
+});
+
+function weatherDefinition(allowedUnits: string[]): ToolDefinition {
+  return {
+    name: 'get_weather',
+    description: 'Get current weather for a location',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        location: {type: 'string'},
+        units: {type: 'string', enum: allowedUnits},
+        precision: {type: 'number', default: 2},
+      },
+      required: ['location'],
+    },
+  };
+}
+
+function createRetryingProvider(capturedToolResults: string[]): AIProvider {
+  let turn = 0;
+  return {
+    async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      const currentTurn = turn;
+      turn += 1;
+
+      if (currentTurn === 0) {
+        yield {type: 'tool_use', toolCall: {id: 'tc-1', name: 'get_weather', input: {}}};
+        yield {type: 'stop', stopReason: 'tool_use'};
+        return;
+      }
+
+      if (currentTurn === 1) {
+        capturedToolResults.push(extractLastToolResult(params.messages));
+        yield {type: 'tool_use', toolCall: {id: 'tc-2', name: 'get_weather', input: {location: 'Berlin'}}};
+        yield {type: 'stop', stopReason: 'tool_use'};
+        return;
+      }
+
+      yield {type: 'text', text: 'Forecast: 18C in Berlin'};
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+function extractLastToolResult(messages: Message[]): string {
+  const lastMessage = messages[messages.length - 1];
+  if (!lastMessage || typeof lastMessage.content === 'string') return '';
+  const firstPart = lastMessage.content[0];
+  if (!firstPart || firstPart.type !== 'tool_result') return '';
+  return firstPart.content;
+}