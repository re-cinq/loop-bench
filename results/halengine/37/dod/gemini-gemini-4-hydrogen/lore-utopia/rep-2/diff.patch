+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+import type {AIProvider, Message, MessageChunk, SendMessageParams, ToolDefinition} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+import {ToolRegistry} from './registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+interface CapturedLog {
+  level: string;
+  category: string;
+  message: string;
+  fields?: Record<string, unknown>;
+}
+
+describe('ToolRegistry inputSchema validation (acceptance)', () => {
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('rejects invalid input before calling the executor and keeps valid input unmodified', async () => {
+    const registry = new ToolRegistry();
+    const receivedInputs: Record<string, unknown>[] = [];
+    const weatherTool: ToolDefinition = {
+      name: 'get_weather',
+      description: 'Get current weather',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          location: {type: 'string'},
+          count: {type: 'number'},
+          units: {type: 'string', enum: ['celsius', 'fahrenheit'], default: 'celsius'},
+        },
+        required: ['location'],
+      },
+    };
+    const pingTool: ToolDefinition = {
+      name: 'ping',
+      description: 'Ping with open object schema',
+      inputSchema: {type: 'object'},
+    };
+
+    registry.register(weatherTool, async input => {
+      receivedInputs.push(input);
+      return 'ok';
+    });
+    registry.register(pingTool, async () => 'pong');
+
+    const missing = await registry.execute('get_weather', {});
+    const wrongType = await registry.execute('get_weather', {location: 'Berlin', count: '42'});
+    const outsideEnum = await registry.execute('get_weather', {location: 'Berlin', units: 'kelvin'});
+    const valid = await registry.execute('get_weather', {location: 'Berlin', extra: 'kept'});
+    const pinged = await registry.execute('ping', {anything: 1});
+
+    expect({
+      receivedInputs,
+      missingMentionsField: missing.result.includes('location'),
+      typeMentionsField: wrongType.result.includes('count'),
+      enumMentionsField: outsideEnum.result.includes('units'),
+      validResult: valid.result,
+      pingResult: pinged.result,
+    }).toEqual({
+      receivedInputs: [{location: 'Berlin', extra: 'kept'}],
+      missingMentionsField: true,
+      typeMentionsField: true,
+      enumMentionsField: true,
+      validResult: 'ok',
+      pingResult: 'pong',
+    });
+  });
+
+  it('throws synchronously when registering a static tool with an invalid inputSchema', () => {
+    const registry = new ToolRegistry();
+    const brokenTool: ToolDefinition = {
+      name: 'broken_tool',
+      description: 'Broken schema',
+      inputSchema: {
+        type: 'object',
+        properties: {count: {type: 'not-a-json-schema-type'}},
+      },
+    };
+
+    expect(() => registry.register(brokenTool, async () => 'ok')).toThrow(/broken_tool/);
+  });
+
+  it('validates per call against the schema resolved from a dynamic ToolDefinitionSource', async () => {
+    const registry = new ToolRegistry();
+    const calls: Record<string, unknown>[] = [];
+    let schemaMode: 'alpha' | 'beta' = 'alpha';
+
+    registry.register(
+      () => ({
+        name: 'dynamic_tool',
+        description: 'Dynamic schema tool',
+        inputSchema:
+          schemaMode === 'alpha'
+            ? {type: 'object', properties: {alpha: {type: 'string'}}, required: ['alpha']}
+            : {type: 'object', properties: {beta: {type: 'number'}}, required: ['beta']},
+      }),
+      async input => {
+        calls.push(input);
+        return 'ok';
+      }
+    );
+
+    schemaMode = 'beta';
+    const rejected = await registry.execute('dynamic_tool', {alpha: 'still-old'});
+    const accepted = await registry.execute('dynamic_tool', {beta: 7});
+
+    expect({
+      calls,
+      rejectedMentionsBeta: rejected.result.includes('beta'),
+      acceptedResult: accepted.result,
+    }).toEqual({
+      calls: [{beta: 7}],
+      rejectedMentionsBeta: true,
+      acceptedResult: 'ok',
+    });
+  });
+
+  it('logs a warning on invalid input and omits raw input values from logs and rejection text', async () => {
+    const logs: CapturedLog[] = [];
+    const collect = (level: string) => (category: string, message: string, fields?: Record<string, unknown>) => {
+      logs.push({level, category, message, fields});
+    };
+    const logger: Logger = {
+      debug: collect('DEBUG'),
+      info: collect('INFO'),
+      warn: collect('WARN'),
+      error: collect('ERROR'),
+    };
+    setLogger(logger);
+
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'secret_tool',
+        description: 'Checks secret input handling',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            secretToken: {type: 'string'},
+            count: {type: 'number'},
+          },
+          required: ['secretToken', 'count'],
+        },
+      },
+      async () => 'ok'
+    );
+
+    const rejected = await registry.execute('secret_tool', {
+      secretToken: 's3cr3t-raw-value',
+      count: 'bad-raw-number',
+    });
+
+    const warnLogs = logs.filter(entry => entry.level === 'WARN');
+    const serialized = JSON.stringify(warnLogs);
+
+    expect({
+      warnCount: warnLogs.length > 0,
+      namesTool: serialized.includes('secret_tool'),
+      namesFieldInLog: serialized.includes('count'),
+      namesFieldInResult: rejected.result.includes('count'),
+      leaksSecretInLog: serialized.includes('s3cr3t-raw-value'),
+      leaksRawCountInLog: serialized.includes('bad-raw-number'),
+      leaksSecretInResult: rejected.result.includes('s3cr3t-raw-value'),
+      leaksRawCountInResult: rejected.result.includes('bad-raw-number'),
+    }).toEqual({
+      warnCount: true,
+      namesTool: true,
+      namesFieldInLog: true,
+      namesFieldInResult: true,
+      leaksSecretInLog: false,
+      leaksRawCountInLog: false,
+      leaksSecretInResult: false,
+      leaksRawCountInResult: false,
+    });
+  });
+
+  it('feeds a schema validation rejection back to the model so a corrected follow-up call succeeds', async () => {
+    const registry = new ToolRegistry();
+    const executorInputs: Record<string, unknown>[] = [];
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get current weather',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async input => {
+        executorInputs.push(input);
+        return JSON.stringify({location: input.location, temperature: 18});
+      }
+    );
+
+    let round = 0;
+    let firstToolResult = '';
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        round += 1;
+        if (round === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        if (round === 2) {
+          firstToolResult = extractLastToolResult(params.messages);
+          yield {type: 'tool_use', toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Berlin'}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        yield {type: 'text', text: 'Berlin is 18C'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Test'}), registry);
+    const session: ChatSession = {
+      sessionId: 's-accept',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'Weather in Berlin?', timestamp: SENT_AT}],
+    };
+
+    const reply = await orchestrator.processMessage(session);
+
+    expect({
+      executorInputs,
+      rejectionMentionsLocation: firstToolResult.includes('location'),
+      reply,
+    }).toEqual({
+      executorInputs: [{location: 'Berlin'}],
+      rejectionMentionsLocation: true,
+      reply: 'Berlin is 18C',
+    });
+  });
+});
+
+function extractLastToolResult(messages: Message[]): string {
+  for (let index = messages.length - 1; index >= 0; index -= 1) {
+    const message = messages[index];
+    if (message.role !== 'user' || !Array.isArray(message.content)) continue;
+    return message.content.map(part => part.content).join(' ');
+  }
+  return '';
+}