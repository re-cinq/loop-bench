+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, Message, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const FIXED_TIMESTAMP = '2026-01-01T00:00:00.000Z';
+
+function extractToolResultText(message: Message | undefined, toolUseId: string): string {
+  if (!message || typeof message.content === 'string') return '';
+  const entry = message.content.find(part => part.type === 'tool_result' && part.toolUseId === toolUseId);
+  return entry?.type === 'tool_result' ? entry.content : '';
+}
+
+describe('ChatOrchestrator tool input validation recovery', () => {
+  it('feeds schema rejection back to the provider and resolves after retry', async () => {
+    const observedMessages: Message[][] = [];
+    const rounds: MessageChunk[][] = [
+      [
+        {type: 'tool_use', toolCall: {id: 'call-bad', name: 'lookup', input: {}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'call-good', name: 'lookup', input: {query: 'hal'}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'text', text: 'Found hal'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ];
+
+    let roundIndex = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        observedMessages.push([...params.messages]);
+        for (const chunk of rounds[roundIndex++] ?? []) yield chunk;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const executorInputs: Array<Record<string, unknown>> = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'lookup',
+        description: 'Look up query',
+        inputSchema: {
+          type: 'object',
+          properties: {query: {type: 'string'}},
+          required: ['query'],
+        },
+      },
+      async input => {
+        executorInputs.push(input);
+        return 'matched-hal';
+      }
+    );
+
+    let onErrorCalled = false;
+    const hooks: OrchestratorHooks = {
+      onError: async () => {
+        onErrorCalled = true;
+      },
+    };
+
+    const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry, {hooks});
+    const session: ChatSession = {
+      sessionId: 's-validate',
+      userId: 'u-validate',
+      entries: [{role: 'user', content: 'find hal', timestamp: FIXED_TIMESTAMP}],
+    };
+
+    const reply = await orchestrator.processMessage(session);
+    const roundTwoMessages = observedMessages[1] ?? [];
+    const rejectionText = extractToolResultText(roundTwoMessages[roundTwoMessages.length - 1], 'call-bad');
+
+    expect({
+      reply,
+      onErrorCalled,
+      executorInputs,
+      rejectionMentionsQuery: /query/i.test(rejectionText),
+      rejectionMentionsRequired: /required/i.test(rejectionText),
+    }).toEqual({
+      reply: 'Found hal',
+      onErrorCalled: false,
+      executorInputs: [{query: 'hal'}],
+      rejectionMentionsQuery: true,
+      rejectionMentionsRequired: true,
+    });
+  });
+});
diff --git a/src/orchestration/tools/registry.acceptance.test.ts b/src/orchestration/tools/registry.acceptance.test.ts
