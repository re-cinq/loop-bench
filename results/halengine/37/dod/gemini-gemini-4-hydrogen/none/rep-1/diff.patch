index 0000000..dd80004
--- /dev/null
+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,214 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+import {setLogger} from '../../shared/logger.js';
+
+function registerOutcome(registry: ToolRegistry, definition: ToolDefinition): string {
+  try {
+    registry.register(definition, async () => 'ok');
+    return 'registered';
+  } catch (error) {
+    return error instanceof Error ? error.message : 'threw non-error';
+  }
+}
+
+describe('ToolRegistry input schema validation', () => {
+  afterEach(() => setLogger());
+
+  it('rejects invalid input with path and constraint, calls executor zero times, and leaks no values', async () => {
+    const logEntries: string[] = [];
+    setLogger({
+      debug: (category, message, fields) => void logEntries.push(JSON.stringify({category, message, fields})),
+      info: (category, message, fields) => void logEntries.push(JSON.stringify({category, message, fields})),
+      warn: (category, message, fields) => void logEntries.push(JSON.stringify({category, message, fields})),
+      error: (category, message, fields) => void logEntries.push(JSON.stringify({category, message, fields})),
+    });
+
+    let executorCalls = 0;
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather forecast',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+            unit: {type: 'string', enum: ['celsius', 'fahrenheit']},
+          },
+          required: ['location'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'ok';
+      }
+    );
+
+    const missingResult = await registry.execute('get_weather', {});
+    const wrongTypeResult = await registry.execute('get_weather', {
+      location: 987654321,
+      requesterEmail: 'alice-secret@example.com',
+    });
+    const badEnumResult = await registry.execute('get_weather', {
+      location: 'Berlin',
+      unit: 'kelvin-secret-unit',
+    });
+
+    const combinedResults = [missingResult.result, wrongTypeResult.result, badEnumResult.result].join('|');
+    const emittedLogs = logEntries.join('|');
+    const sensitiveValues = ['987654321', 'alice-secret@example.com', 'kelvin-secret-unit', 'Berlin'];
+
+    expect({
+      executorCalls,
+      missingHasLocation: /location/i.test(missingResult.result),
+      missingHasRequired: /required/i.test(missingResult.result),
+      wrongTypeHasLocation: /location/i.test(wrongTypeResult.result),
+      wrongTypeHasString: /string/i.test(wrongTypeResult.result),
+      badEnumHasUnit: /unit/i.test(badEnumResult.result),
+      badEnumHasConstraint: /enum|allowed/i.test(badEnumResult.result),
+      leakedInResults: sensitiveValues.some(secret => combinedResults.includes(secret)),
+      leakedInLogs: sensitiveValues.some(secret => emittedLogs.includes(secret)),
+    }).toEqual({
+      executorCalls: 0,
+      missingHasLocation: true,
+      missingHasRequired: true,
+      wrongTypeHasLocation: true,
+      wrongTypeHasString: true,
+      badEnumHasUnit: true,
+      badEnumHasConstraint: true,
+      leakedInResults: false,
+      leakedInLogs: false,
+    });
+  });
+
+  it('forwards valid input with extra properties unmodified without defaults or coercion', async () => {
+    const receivedInputs: Array<Record<string, unknown>> = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'lookup_city',
+        description: 'Look up a city',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            city: {type: 'string'},
+            limit: {type: 'number', default: 10},
+          },
+          required: ['city'],
+        },
+      },
+      async input => {
+        receivedInputs.push(input);
+        return 'found';
+      }
+    );
+
+    const validResponse = await registry.execute('lookup_city', {city: '42', extraTag: 'vip'});
+    const wrongTypeResponse = await registry.execute('lookup_city', {city: 42});
+
+    expect({
+      validResult: validResponse.result,
+      receivedInputs,
+      rejectedHasCity: /city/i.test(wrongTypeResponse.result),
+      rejectedHasString: /string/i.test(wrongTypeResponse.result),
+    }).toEqual({
+      validResult: 'found',
+      receivedInputs: [{city: '42', extraTag: 'vip'}],
+      rejectedHasCity: true,
+      rejectedHasString: true,
+    });
+  });
+
+  it('compiles static schemas at registration, rejects broken schemas, and throws on unknown tools', async () => {
+    const registry = new ToolRegistry();
+    const brokenMessage = registerOutcome(registry, {
+      name: 'broken_tool',
+      description: 'Broken schema',
+      inputSchema: {type: 'not_a_valid_json_schema_type'},
+    });
+
+    let propertiesReads = 0;
+    const trackedSchema: Record<string, unknown> = {
+      type: 'object',
+      get properties() {
+        propertiesReads += 1;
+        return {city: {type: 'string'}};
+      },
+      required: ['city'],
+    };
+
+    registry.register({name: 'ping_city', description: 'Ping city', inputSchema: trackedSchema}, async () => 'pong');
+    const readsAtRegister = propertiesReads;
+
+    for (let step = 0; step < 10; step++) {
+      await registry.execute('ping_city', {city: 'London'});
+    }
+    const readsAfterTenExecutes = propertiesReads;
+
+    const unknownError = await registry.execute('missing_tool', {}).then(
+      () => 'resolved',
+      (error: Error) => error.message
+    );
+
+    expect({
+      brokenMentionsTool: brokenMessage.includes('broken_tool'),
+      compiledAtRegister: readsAtRegister > 0,
+      recompiledDuringExecute: readsAfterTenExecutes !== readsAtRegister,
+      unknownError,
+    }).toEqual({
+      brokenMentionsTool: true,
+      compiledAtRegister: true,
+      recompiledDuringExecute: false,
+      unknownError: 'Unknown tool: missing_tool',
+    });
+  });
+
+  it('validates a function-valued tool definition against the schema current at each call', async () => {
+    let activePhase: 'alpha' | 'beta' = 'alpha';
+    const schemaAlpha: Record<string, unknown> = {
+      type: 'object',
+      properties: {alpha: {type: 'string'}},
+      required: ['alpha'],
+    };
+    const schemaBeta: Record<string, unknown> = {
+      type: 'object',
+      properties: {beta: {type: 'string'}},
+      required: ['beta'],
+    };
+    const executedInputs: Array<Record<string, unknown>> = [];
+
+    const registry = new ToolRegistry();
+    registry.register(
+      () => ({
+        name: 'dynamic_action',
+        description: 'Dynamic action',
+        inputSchema: activePhase === 'alpha' ? schemaAlpha : schemaBeta,
+      }),
+      async input => {
+        executedInputs.push(input);
+        return 'ok';
+      }
+    );
+
+    const rejectedAlphaPhase = await registry.execute('dynamic_action', {beta: 'only-beta'});
+    const acceptedAlphaPhase = await registry.execute('dynamic_action', {alpha: 'ok-alpha'});
+
+    activePhase = 'beta';
+    const rejectedBetaPhase = await registry.execute('dynamic_action', {alpha: 'only-alpha'});
+    const acceptedBetaPhase = await registry.execute('dynamic_action', {beta: 'ok-beta'});
+
+    expect({
+      rejectedAlphaMentionsAlpha: /alpha/i.test(rejectedAlphaPhase.result),
+      acceptedAlphaResult: acceptedAlphaPhase.result,
+      rejectedBetaMentionsBeta: /beta/i.test(rejectedBetaPhase.result),
+      acceptedBetaResult: acceptedBetaPhase.result,
+      executedInputs,
+    }).toEqual({
+      rejectedAlphaMentionsAlpha: true,
+      acceptedAlphaResult: 'ok',
+      rejectedBetaMentionsBeta: true,
+      acceptedBetaResult: 'ok',
+      executedInputs: [{alpha: 'ok-alpha'}, {beta: 'ok-beta'}],
+    });
+  });
+});