+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, Message, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function findToolResultContent(messages: Message[], toolUseId: string): string {
+  for (const message of messages) {
+    if (typeof message.content === 'string') continue;
+    for (const block of message.content) {
+      if (block.type === 'tool_result' && block.toolUseId === toolUseId) {
+        return block.content;
+      }
+    }
+  }
+  return '';
+}
+
+describe('ChatOrchestrator tool input validation recovery', () => {
+  it('resolves when a rejected tool call is retried with valid input and exposes the rejection to the provider', async () => {
+    const registry = new ToolRegistry();
+    const executorInputs: Record<string, unknown>[] = [];
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get the current weather for a location.',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async input => {
+        executorInputs.push(input);
+        return '18C';
+      }
+    );
+
+    const capturedRounds: Message[][] = [];
+    const rounds: MessageChunk[][] = [
+      [
+        {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Berlin'}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'text', text: 'Sunny in Berlin'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ];
+    let roundIndex = 0;
+
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        capturedRounds.push([...params.messages]);
+        for (const chunk of rounds[roundIndex++] ?? []) yield chunk;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Test assistant.'}), registry);
+    const session: ChatSession = {
+      sessionId: 's-validation',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'Weather in Berlin?', timestamp: SENT_AT}],
+    };
+
+    const reply = await orchestrator.processMessage(session);
+    const rejectionText = findToolResultContent(capturedRounds[1] ?? [], 'call-1');
+
+    expect({
+      reply,
+      executorInputs,
+      rejectionMentionsLocation: /location/i.test(rejectionText),
+    }).toEqual({
+      reply: 'Sunny in Berlin',
+      executorInputs: [{location: 'Berlin'}],
+      rejectionMentionsLocation: true,
+    });
+  });
+});
