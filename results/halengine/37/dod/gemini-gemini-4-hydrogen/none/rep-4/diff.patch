+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+describe('ToolRegistry inputSchema validation', () => {
+  const logEntries: string[] = [];
+
+  beforeEach(() => {
+    logEntries.length = 0;
+    const capture = (level: string) => (category: string, message: string, fields?: Record<string, unknown>) =>
+      void logEntries.push(JSON.stringify({level, category, message, fields}));
+    setLogger({
+      debug: capture('DEBUG'),
+      info: capture('INFO'),
+      warn: capture('WARN'),
+      error: capture('ERROR'),
+    });
+  });
+
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('returns a ToolResponse naming the failing property and constraint without calling the executor or leaking values', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    const definition: ToolDefinition = {
+      name: 'get_weather',
+      description: 'Get the current weather for a location.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          location: {type: 'string'},
+          units: {type: 'string', enum: ['celsius', 'fahrenheit']},
+        },
+        required: ['location'],
+      },
+    };
+    registry.register(definition, async () => {
+      executorCalls += 1;
+      return 'sunny';
+    });
+
+    const missingReply = await registry.execute('get_weather', {});
+    const typeReply = await registry.execute('get_weather', {location: 987654});
+    const enumReply = await registry.execute('get_weather', {location: 'Berlin', units: 'kelvin-secret'});
+    const combinedLogs = logEntries.join('|');
+
+    expect({
+      executorCalls,
+      missingMentionsLocation: /location/i.test(missingReply.result),
+      missingMentionsRequired: /required/i.test(missingReply.result),
+      typeMentionsLocation: /location/i.test(typeReply.result),
+      typeMentionsString: /string/i.test(typeReply.result),
+      enumMentionsUnits: /units/i.test(enumReply.result),
+      leakedInReplies: typeReply.result.includes('987654') || enumReply.result.includes('kelvin-secret'),
+      leakedInLogs: combinedLogs.includes('987654') || combinedLogs.includes('kelvin-secret'),
+    }).toEqual({
+      executorCalls: 0,
+      missingMentionsLocation: true,
+      missingMentionsRequired: true,
+      typeMentionsLocation: true,
+      typeMentionsString: true,
+      enumMentionsUnits: true,
+      leakedInReplies: false,
+      leakedInLogs: false,
+    });
+  });
+
+  it('passes valid input with extra properties through unmodified without coercing types or applying defaults', async () => {
+    const registry = new ToolRegistry();
+    const receivedInputs: Record<string, unknown>[] = [];
+    registry.register(
+      {
+        name: 'lookup_record',
+        description: 'Lookup a record.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+            count: {type: 'number'},
+            units: {type: 'string', default: 'celsius'},
+          },
+          required: ['location'],
+        },
+      },
+      async input => {
+        receivedInputs.push(input);
+        return 'ok';
+      }
+    );
+
+    const validReply = await registry.execute('lookup_record', {location: 'Berlin', count: 3, extra: 'keep'});
+    const stringCountReply = await registry.execute('lookup_record', {location: 'Berlin', count: '3'});
+
+    expect({
+      validResult: validReply.result,
+      receivedInputs,
+      countMentionsField: /count/i.test(stringCountReply.result),
+      countMentionsNumber: /number/i.test(stringCountReply.result),
+    }).toEqual({
+      validResult: 'ok',
+      receivedInputs: [{location: 'Berlin', count: 3, extra: 'keep'}],
+      countMentionsField: true,
+      countMentionsNumber: true,
+    });
+  });
+
+  it('throws at registration time naming the tool when its inputSchema cannot be compiled', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_tool',
+          description: 'Tool with an uncompilable schema.',
+          inputSchema: {type: 'not-a-json-schema-type'},
+        },
+        async () => 'ok'
+      )
+    ).toThrow(/broken_tool/);
+  });
+
+  it('validates a function-valued tool definition against the schema returned on each call', async () => {
+    const registry = new ToolRegistry();
+    let requiredField = 'alpha';
+    const receivedInputs: Record<string, unknown>[] = [];
+    registry.register(
+      () => ({
+        name: 'dynamic_tool',
+        description: 'Tool whose schema changes between calls.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            alpha: {type: 'string'},
+            beta: {type: 'string'},
+          },
+          required: [requiredField],
+        },
+      }),
+      async input => {
+        receivedInputs.push(input);
+        return 'ok';
+      }
+    );
+
+    const firstReply = await registry.execute('dynamic_tool', {alpha: 'one'});
+    requiredField = 'beta';
+    const secondReply = await registry.execute('dynamic_tool', {alpha: 'one'});
+
+    expect({
+      firstResult: firstReply.result,
+      secondMentionsBeta: /beta/i.test(secondReply.result),
+      receivedInputs,
+    }).toEqual({
+      firstResult: 'ok',
+      secondMentionsBeta: true,
+      receivedInputs: [{alpha: 'one'}],
+    });
+  });
+});