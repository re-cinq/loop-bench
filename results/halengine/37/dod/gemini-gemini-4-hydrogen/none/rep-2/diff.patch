@@ -0,0 +1,194 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+import {setLogger} from '../../shared/logger.js';
+
+const captureRegisterError = (run: () => void): string => {
+  try {
+    run();
+    return 'registered without throwing';
+  } catch (error) {
+    return error instanceof Error ? error.message : String(error);
+  }
+};
+
+describe('ToolRegistry input schema validation acceptance', () => {
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('returns a ToolResponse naming missing required fields without calling the executor, while passing valid input with extra properties unchanged', async () => {
+    const registry = new ToolRegistry();
+    const receivedInputs: Record<string, unknown>[] = [];
+    const definition: ToolDefinition = {
+      name: 'get_weather',
+      description: 'Get weather for a location',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          location: {type: 'string'},
+          units: {type: 'string', enum: ['celsius', 'fahrenheit'], default: 'celsius'},
+        },
+        required: ['location'],
+      },
+    };
+
+    registry.register(definition, async input => {
+      receivedInputs.push(input);
+      return 'ok';
+    });
+
+    const missingOutcome = await registry.execute('get_weather', {});
+    const callsAfterMissing = receivedInputs.length;
+    await registry.execute('get_weather', {location: 'Berlin', extraField: 'keep'});
+
+    expect({
+      callsAfterMissing,
+      namesLocation: /location/i.test(missingOutcome.result),
+      namesRequired: /required/i.test(missingOutcome.result),
+      receivedInputs,
+    }).toEqual({
+      callsAfterMissing: 0,
+      namesLocation: true,
+      namesRequired: true,
+      receivedInputs: [{location: 'Berlin', extraField: 'keep'}],
+    });
+  });
+
+  it('rejects wrong-typed fields and invalid enum values with path and constraint, omitting offending and identifying values from result and logs', async () => {
+    const capturedLogs: string[] = [];
+    const recordLog = (category: string, message: string, fields?: Record<string, unknown>): void => {
+      capturedLogs.push(JSON.stringify({category, message, fields}));
+    };
+    setLogger({debug: recordLog, info: recordLog, warn: recordLog, error: recordLog});
+
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    const definition: ToolDefinition = {
+      name: 'get_weather',
+      description: 'Get weather for a location',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          location: {type: 'string'},
+          units: {type: 'string', enum: ['celsius', 'fahrenheit']},
+          secretToken: {type: 'string'},
+        },
+        required: ['location'],
+      },
+    };
+
+    registry.register(definition, async () => {
+      executorCalls += 1;
+      return 'executed';
+    });
+
+    const typeRejection = await registry.execute('get_weather', {
+      location: 987654321,
+      secretToken: 'SENSITIVE_TOKEN_XYZ',
+    });
+    const enumRejection = await registry.execute('get_weather', {
+      location: 'Berlin',
+      units: 'kelvin_secret',
+      secretToken: 'SENSITIVE_TOKEN_XYZ',
+    });
+
+    const combinedText = [typeRejection.result, enumRejection.result, ...capturedLogs].join(' ');
+    const leakedValues = ['987654321', 'kelvin_secret', 'SENSITIVE_TOKEN_XYZ'].filter(secret =>
+      combinedText.includes(secret)
+    );
+
+    expect({
+      executorCalls,
+      namesLocation: /location/i.test(typeRejection.result),
+      namesStringType: /string/i.test(typeRejection.result),
+      namesUnits: /units/i.test(enumRejection.result),
+      namesEnumConstraint: /enum|allowed/i.test(enumRejection.result),
+      leakedValues,
+    }).toEqual({
+      executorCalls: 0,
+      namesLocation: true,
+      namesStringType: true,
+      namesUnits: true,
+      namesEnumConstraint: true,
+      leakedValues: [],
+    });
+  });
+
+  it('throws at register time naming the tool for an uncompilable schema, and compiles a static schema once across ten execute calls', async () => {
+    const registry = new ToolRegistry();
+    const brokenDefinition: ToolDefinition = {
+      name: 'broken_schema_tool',
+      description: 'Broken schema',
+      inputSchema: {type: 'bogus_schema_type'},
+    };
+    const registerMessage = captureRegisterError(() => registry.register(brokenDefinition, async () => 'ok'));
+
+    let propertyReads = 0;
+    const staticSchema: Record<string, unknown> = {type: 'object', required: ['location']};
+    Object.defineProperty(staticSchema, 'properties', {
+      enumerable: true,
+      get() {
+        propertyReads += 1;
+        return {location: {type: 'string'}};
+      },
+    });
+
+    registry.register(
+      {name: 'weather_once', description: 'Weather lookup', inputSchema: staticSchema},
+      async () => 'ok'
+    );
+    propertyReads = 0;
+
+    for (let count = 0; count < 10; count += 1) {
+      await registry.execute('weather_once', {location: 'Berlin'});
+    }
+    const rejectedOutcome = await registry.execute('weather_once', {});
+
+    expect({
+      threwAtRegister: registerMessage !== 'registered without throwing',
+      namesBrokenTool: registerMessage.includes('broken_schema_tool'),
+      propertyReadsDuringExecute: propertyReads,
+      eleventhCallNamesLocation: /location/i.test(rejectedOutcome.result),
+    }).toEqual({
+      threwAtRegister: true,
+      namesBrokenTool: true,
+      propertyReadsDuringExecute: 0,
+      eleventhCallNamesLocation: true,
+    });
+  });
+
+  it('validates a function-valued tool definition against the schema current at each call without using a stale cached schema', async () => {
+    const registry = new ToolRegistry();
+    const executorInputs: Record<string, unknown>[] = [];
+    let phase = 1;
+
+    registry.register(
+      () => ({
+        name: 'dynamic_tool',
+        description: 'Schema changes between calls',
+        inputSchema:
+          phase === 1
+            ? {type: 'object', properties: {city: {type: 'string'}}, required: ['city']}
+            : {type: 'object', properties: {country: {type: 'string'}}, required: ['country']},
+      }),
+      async input => {
+        executorInputs.push(input);
+        return 'ok';
+      }
+    );
+
+    const firstOutcome = await registry.execute('dynamic_tool', {city: 'Berlin'});
+    phase = 2;
+    const secondOutcome = await registry.execute('dynamic_tool', {city: 'Berlin'});
+
+    expect({
+      firstResult: firstOutcome.result,
+      executorInputs,
+      secondNamesCountry: /country/i.test(secondOutcome.result),
+    }).toEqual({
+      firstResult: 'ok',
+      executorInputs: [{city: 'Berlin'}],
+      secondNamesCountry: true,
+    });
+  });
+});