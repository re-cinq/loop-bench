+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, Message, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const extractToolResult = (messages: Message[], toolUseId: string): string => {
+  for (const msg of messages) {
+    if (msg.role !== 'user' || typeof msg.content === 'string') continue;
+    const match = msg.content.find(part => part.type === 'tool_result' && part.toolUseId === toolUseId);
+    if (match) return match.content;
+  }
+  return '';
+};
+
+describe('ChatOrchestrator tool input validation acceptance', () => {
+  it('returns a schema rejection as a tool_result so the provider can retry and resolve the message', async () => {
+    const registry = new ToolRegistry();
+    const executorInputs: Record<string, unknown>[] = [];
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async input => {
+        executorInputs.push(input);
+        return 'sunny in Berlin';
+      }
+    );
+
+    let round = 0;
+    let secondRoundMessages: Message[] = [];
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        if (round === 0) {
+          round += 1;
+          yield {type: 'tool_use', toolCall: {id: 'call-bad', name: 'get_weather', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        if (round === 1) {
+          round += 1;
+          secondRoundMessages = [...params.messages];
+          yield {type: 'tool_use', toolCall: {id: 'call-good', name: 'get_weather', input: {location: 'Berlin'}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        yield {type: 'text', text: 'Forecast ready'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'What is the weather?', timestamp: SENT_AT}],
+    };
+
+    const reply = await orchestrator.processMessage(session);
+    const firstToolResult = extractToolResult(secondRoundMessages, 'call-bad');
+
+    expect({
+      reply,
+      executorInputs,
+      rejectionNamesLocation: /location/i.test(firstToolResult),
+    }).toEqual({
+      reply: 'Forecast ready',
+      executorInputs: [{location: 'Berlin'}],
+      rejectionNamesLocation: true,
+    });
+  });
+});
diff --git a/src/orchestration/tools/registry.acceptance.test.ts b/src/orchestration/tools/registry.acceptance.test.ts
