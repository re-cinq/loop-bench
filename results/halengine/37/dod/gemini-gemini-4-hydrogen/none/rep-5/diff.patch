+import {ToolRegistry} from './registry.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {AIProvider, Message, MessageChunk, SendMessageParams, ToolDefinition} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const WEATHER_SCHEMA: Record<string, unknown> = {
+  type: 'object',
+  properties: {
+    location: {type: 'string'},
+    units: {type: 'string', enum: ['celsius', 'fahrenheit'], default: 'celsius'},
+    days: {type: 'number'},
+  },
+  required: ['location'],
+};
+
+describe('ToolRegistry input validation', () => {
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('returns a rejection ToolResponse naming missing required fields before running the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register({name: 'get_weather', description: 'weather', inputSchema: WEATHER_SCHEMA}, async () => {
+      executorCalls += 1;
+      return 'ok';
+    });
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({
+      executorCalls,
+      namesLocation: response.result.includes('location'),
+      mentionsRequired: /required/i.test(response.result),
+    }).toEqual({
+      executorCalls: 0,
+      namesLocation: true,
+      mentionsRequired: true,
+    });
+  });
+
+  it('rejects type and enum violations without leaking offending or identifying values in results or logs', async () => {
+    const logLines: string[] = [];
+    const recordLog = (category: string, message: string, fields?: Record<string, unknown>) => {
+      logLines.push(JSON.stringify({category, message, fields}));
+    };
+    setLogger({debug: recordLog, info: recordLog, warn: recordLog, error: recordLog});
+
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register({name: 'get_weather', description: 'weather', inputSchema: WEATHER_SCHEMA}, async () => {
+      executorCalls += 1;
+      return 'ok';
+    });
+
+    const wrongTypeResponse = await registry.execute('get_weather', {
+      location: 987654321,
+      ssn: 'secret-ssn-99',
+    });
+    const badEnumResponse = await registry.execute('get_weather', {
+      location: 'Berlin',
+      units: 'kelvin-secret-42',
+    });
+    const combinedLogs = logLines.join(' | ');
+
+    expect({
+      executorCalls,
+      typeNamesLocation: wrongTypeResponse.result.includes('location'),
+      typeNamesExpectedString: /string/i.test(wrongTypeResponse.result),
+      enumNamesUnits: badEnumResponse.result.includes('units'),
+      leakedNumberInResult: wrongTypeResponse.result.includes('987654321'),
+      leakedSsnInResult: wrongTypeResponse.result.includes('secret-ssn-99'),
+      leakedEnumInResult: badEnumResponse.result.includes('kelvin-secret-42'),
+      leakedNumberInLogs: combinedLogs.includes('987654321'),
+      leakedSsnInLogs: combinedLogs.includes('secret-ssn-99'),
+      leakedEnumInLogs: combinedLogs.includes('kelvin-secret-42'),
+    }).toEqual({
+      executorCalls: 0,
+      typeNamesLocation: true,
+      typeNamesExpectedString: true,
+      enumNamesUnits: true,
+      leakedNumberInResult: false,
+      leakedSsnInResult: false,
+      leakedEnumInResult: false,
+      leakedNumberInLogs: false,
+      leakedSsnInLogs: false,
+      leakedEnumInLogs: false,
+    });
+  });
+
+  it('throws at register time naming the tool when its inputSchema cannot compile', () => {
+    const registry = new ToolRegistry();
+    const brokenDefinition: ToolDefinition = {
+      name: 'broken_weather',
+      description: 'broken schema tool',
+      inputSchema: {type: 'not-a-type', required: 'not-an-array'},
+    };
+
+    expect(() => registry.register(brokenDefinition, async () => 'ok')).toThrow(/broken_weather/);
+  });
+
+  it('re-validates a function-valued tool definition against the current schema on each call', async () => {
+    const registry = new ToolRegistry();
+    let requireCountry = false;
+    let executorCalls = 0;
+
+    registry.register(
+      () => ({
+        name: 'dynamic_weather',
+        description: 'dynamic schema tool',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            city: {type: 'string'},
+            country: {type: 'string'},
+          },
+          required: requireCountry ? ['city', 'country'] : ['city'],
+        },
+      }),
+      async () => {
+        executorCalls += 1;
+        return 'ok';
+      }
+    );
+
+    const firstResponse = await registry.execute('dynamic_weather', {city: 'Berlin'});
+    requireCountry = true;
+    const secondResponse = await registry.execute('dynamic_weather', {city: 'Berlin'});
+
+    expect({
+      firstResult: firstResponse.result,
+      executorCalls,
+      secondNamesCountry: secondResponse.result.includes('country'),
+      secondMentionsRequired: /required/i.test(secondResponse.result),
+    }).toEqual({
+      firstResult: 'ok',
+      executorCalls: 1,
+      secondNamesCountry: true,
+      secondMentionsRequired: true,
+    });
+  });
+
+  it('feeds validation rejections back to the model for retry and passes valid input with extra fields unmodified', async () => {
+    const registry = new ToolRegistry();
+    const receivedInputs: Record<string, unknown>[] = [];
+    registry.register({name: 'get_weather', description: 'weather', inputSchema: WEATHER_SCHEMA}, async input => {
+      receivedInputs.push(input);
+      return '18C in Berlin';
+    });
+
+    const observedToolResults: string[] = [];
+    const provider = createRetryProvider(observedToolResults);
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), registry);
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'Weather in Berlin?', timestamp: SENT_AT}],
+    };
+
+    const reply = await orchestrator.processMessage(session);
+
+    expect({
+      reply,
+      receivedInputs,
+      roundTwoSawDays: observedToolResults[0]?.includes('days') ?? false,
+      roundTwoSawNumber: /number/i.test(observedToolResults[0] ?? ''),
+    }).toEqual({
+      reply: 'Forecast ready',
+      receivedInputs: [{location: 'Berlin', days: 3, extraNote: 'keep-me'}],
+      roundTwoSawDays: true,
+      roundTwoSawNumber: true,
+    });
+  });
+});
+
+function createRetryProvider(observedToolResults: string[]): AIProvider {
+  let round = 0;
+
+  return {
+    async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      round += 1;
+      if (round === 1) {
+        yield {
+          type: 'tool_use',
+          toolCall: {id: 'call-1', name: 'get_weather', input: {location: 'Berlin', days: '3'}},
+        };
+        yield {type: 'stop', stopReason: 'tool_use'};
+        return;
+      }
+
+      const lastToolResult = extractLastToolResult(params.messages);
+      if (round === 2) {
+        observedToolResults.push(lastToolResult);
+        yield {
+          type: 'tool_use',
+          toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Berlin', days: 3, extraNote: 'keep-me'}},
+        };
+        yield {type: 'stop', stopReason: 'tool_use'};
+        return;
+      }
+
+      yield {type: 'text', text: 'Forecast ready'};
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+function extractLastToolResult(messages: Message[]): string {
+  const last = messages[messages.length - 1];
+  if (!last || last.role !== 'user' || typeof last.content === 'string') return '';
+  const first = last.content[0];
+  return first?.type === 'tool_result' ? first.content : '';
+}