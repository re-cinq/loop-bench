+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {AIProvider, Message, MessageChunk, SendMessageParams, ToolResultContent} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+import {ToolRegistry} from './registry.js';
+
+const WEATHER_SCHEMA: Record<string, unknown> = {
+  type: 'object',
+  properties: {
+    location: {type: 'string'},
+    units: {type: 'string', enum: ['celsius', 'fahrenheit'], default: 'celsius'},
+    limit: {type: 'number'},
+  },
+  required: ['location'],
+};
+
+describe('ToolRegistry inputSchema validation', () => {
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('rejects schema-violating input with a ToolResponse without invoking the executor or leaking values', async () => {
+    const logLines: string[] = [];
+    const recordLog = (category: string, message: string, fields?: Record<string, unknown>) =>
+      void logLines.push(JSON.stringify({category, message, fields}));
+    setLogger({debug: recordLog, info: recordLog, warn: recordLog, error: recordLog});
+
+    const receivedInputs: Record<string, unknown>[] = [];
+    const registry = createWeatherRegistry(receivedInputs);
+
+    const emptyInputResult = await registry.execute('getWeather', {});
+    const typeMismatchResult = await registry.execute('getWeather', {location: 8675309});
+    const enumMismatchResult = await registry.execute('getWeather', {
+      location: 'Berlin',
+      units: 'kelvinSecretToken',
+    });
+
+    let thrownMessage = '';
+    try {
+      await registry.execute('otherTool', {});
+    } catch (caught) {
+      thrownMessage = caught instanceof Error ? caught.message : String(caught);
+    }
+
+    const joinedLogs = logLines.join(' | ');
+
+    expect({
+      calls: receivedInputs.length,
+      emptyMentionsLocation: /location/i.test(emptyInputResult.result),
+      emptyMentionsRequired: /required/i.test(emptyInputResult.result),
+      typeMentionsLocation: /location/i.test(typeMismatchResult.result),
+      typeMentionsString: /string/i.test(typeMismatchResult.result),
+      enumMentionsUnits: /units/i.test(enumMismatchResult.result),
+      leakedNumberInResult: typeMismatchResult.result.includes('8675309'),
+      leakedEnumInResult: enumMismatchResult.result.includes('kelvinSecretToken'),
+      leakedNumberInLogs: joinedLogs.includes('8675309'),
+      leakedEnumInLogs: joinedLogs.includes('kelvinSecretToken'),
+      thrownMessage,
+    }).toEqual({
+      calls: 0,
+      emptyMentionsLocation: true,
+      emptyMentionsRequired: true,
+      typeMentionsLocation: true,
+      typeMentionsString: true,
+      enumMentionsUnits: true,
+      leakedNumberInResult: false,
+      leakedEnumInResult: false,
+      leakedNumberInLogs: false,
+      leakedEnumInLogs: false,
+      thrownMessage: 'Unknown tool: otherTool',
+    });
+  });
+
+  it('forwards valid input with extra properties unchanged without defaults or type coercion', async () => {
+    const receivedInputs: Record<string, unknown>[] = [];
+    const registry = createWeatherRegistry(receivedInputs);
+
+    const accepted = await registry.execute('getWeather', {location: 'Berlin', extraTag: 'keepMe'});
+    const stringLimitResult = await registry.execute('getWeather', {location: 'Berlin', limit: '94281'});
+
+    expect({
+      acceptedResult: accepted.result,
+      receivedInputs,
+      rejectedMentionsLimit: /limit/i.test(stringLimitResult.result),
+      rejectedMentionsNumber: /number/i.test(stringLimitResult.result),
+      leakedCoercionCandidate: stringLimitResult.result.includes('94281'),
+    }).toEqual({
+      acceptedResult: 'Sunny in Berlin',
+      receivedInputs: [{location: 'Berlin', extraTag: 'keepMe'}],
+      rejectedMentionsLimit: true,
+      rejectedMentionsNumber: true,
+      leakedCoercionCandidate: false,
+    });
+  });
+
+  it('compiles static schemas once at registration and resolves dynamic schemas per call', async () => {
+    const registry = new ToolRegistry();
+    let registerError = '';
+    try {
+      registry.register({name: 'faultyTool', description: 'Faulty', inputSchema: {type: 'notAType'}}, async () => 'ok');
+    } catch (caught) {
+      registerError = caught instanceof Error ? caught.message : String(caught);
+    }
+
+    let propertyReads = 0;
+    const staticSchema: Record<string, unknown> = {
+      type: 'object',
+      get properties() {
+        propertyReads += 1;
+        return {location: {type: 'string'}};
+      },
+      required: ['location'],
+    };
+    registry.register({name: 'staticTool', description: 'Static', inputSchema: staticSchema}, async () => 'ok');
+    const readsAtRegister = propertyReads;
+
+    for (let i = 0; i < 10; i += 1) {
+      await registry.execute('staticTool', {location: 'Berlin'});
+    }
+    const readsAfterExecute = propertyReads;
+
+    let activeField = 'alpha';
+    registry.register(
+      () => ({
+        name: 'dynamicTool',
+        description: 'Dynamic',
+        inputSchema: {
+          type: 'object',
+          properties: {[activeField]: {type: 'string'}},
+          required: [activeField],
+        },
+      }),
+      async input => JSON.stringify(input)
+    );
+
+    const firstAlpha = await registry.execute('dynamicTool', {alpha: 'one'});
+    const firstBeta = await registry.execute('dynamicTool', {beta: 'two'});
+    activeField = 'beta';
+    const secondBeta = await registry.execute('dynamicTool', {beta: 'two'});
+    const secondAlpha = await registry.execute('dynamicTool', {alpha: 'one'});
+
+    expect({
+      registerNamesTool: registerError.includes('faultyTool'),
+      compiledAtRegister: readsAtRegister >= 1,
+      compiledOnce: readsAfterExecute === readsAtRegister,
+      firstAlpha: firstAlpha.result,
+      firstBetaMentionsAlpha: /alpha/i.test(firstBeta.result),
+      secondBeta: secondBeta.result,
+      secondAlphaMentionsBeta: /beta/i.test(secondAlpha.result),
+    }).toEqual({
+      registerNamesTool: true,
+      compiledAtRegister: true,
+      compiledOnce: true,
+      firstAlpha: '{"alpha":"one"}',
+      firstBetaMentionsAlpha: true,
+      secondBeta: '{"beta":"two"}',
+      secondAlphaMentionsBeta: true,
+    });
+  });
+
+  it('feeds schema validation rejections back into the orchestrator tool loop for retry', async () => {
+    const receivedInputs: Record<string, unknown>[] = [];
+    const registry = createWeatherRegistry(receivedInputs);
+
+    const seenToolResults: string[] = [];
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        round += 1;
+        if (round === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'call-1', name: 'getWeather', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        if (round === 2) {
+          seenToolResults.push(extractLastToolResult(params.messages));
+          yield {type: 'tool_use', toolCall: {id: 'call-2', name: 'getWeather', input: {location: 'Berlin'}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        yield {type: 'text', text: 'Weather in Berlin: Sunny'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const session: ChatSession = {
+      sessionId: 'session-1',
+      userId: 'user-1',
+      entries: [{role: 'user', content: 'Weather?', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), registry);
+    const reply = await orchestrator.processMessage(session);
+
+    expect({
+      reply,
+      receivedInputs,
+      rejectionVisibleToProvider: seenToolResults.some(text => /location/i.test(text) && /required/i.test(text)),
+    }).toEqual({
+      reply: 'Weather in Berlin: Sunny',
+      receivedInputs: [{location: 'Berlin'}],
+      rejectionVisibleToProvider: true,
+    });
+  });
+});
+
+function createWeatherRegistry(receivedInputs: Record<string, unknown>[]): ToolRegistry {
+  const registry = new ToolRegistry();
+  registry.register({name: 'getWeather', description: 'Get weather', inputSchema: WEATHER_SCHEMA}, async input => {
+    receivedInputs.push(input);
+    return `Sunny in ${String(input.location)}`;
+  });
+  return registry;
+}
+
+function extractLastToolResult(messages: Message[]): string {
+  const lastMessage = messages[messages.length - 1];
+  if (!lastMessage || typeof lastMessage.content === 'string') return '';
+
+  const parts = lastMessage.content.filter((part): part is ToolResultContent => part.type === 'tool_result');
+  return parts.map(part => part.content).join(' | ');
+}