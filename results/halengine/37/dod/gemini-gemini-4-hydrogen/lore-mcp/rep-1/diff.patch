+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('ChatOrchestrator tool input validation acceptance', () => {
+  it('returns a validation rejection to the provider so processMessage resolves on a corrected retry', async () => {
+    const registry = new ToolRegistry();
+    let executedCalls = 0;
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async input => {
+        executedCalls += 1;
+        return `sunny in ${String(input.location)}`;
+      }
+    );
+
+    const observedToolResults: string[] = [];
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        const messageParts = params.messages.flatMap(message =>
+          Array.isArray(message.content) ? message.content : []
+        );
+        const toolResults = messageParts.filter(part => part.type === 'tool_result');
+        for (const part of toolResults) {
+          observedToolResults.push(part.content);
+        }
+
+        round += 1;
+        if (round === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        if (round === 2) {
+          yield {type: 'tool_use', toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Berlin'}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        yield {type: 'text', text: 'It is sunny in Berlin.'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+    const session: ChatSession = {
+      sessionId: 's-validation-retry',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'What is the weather?', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+
+    const finalText = await orchestrator.processMessage(session);
+
+    expect({
+      finalText,
+      executedCalls,
+      firstResultMentionsLocation: (observedToolResults[0] ?? '').includes('location'),
+    }).toEqual({
+      finalText: 'It is sunny in Berlin.',
+      executedCalls: 1,
+      firstResultMentionsLocation: true,
+    });
+  });
+});
