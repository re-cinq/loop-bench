+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+describe('ToolRegistry input validation acceptance', () => {
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('returns a ToolResponse naming the missing required field or enum constraint without calling the executor', async () => {
+    const weatherDefinition: ToolDefinition = {
+      name: 'get_weather',
+      description: 'Get current weather for a city',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          location: {type: 'string'},
+          units: {type: 'string', enum: ['celsius', 'fahrenheit']},
+        },
+        required: ['location'],
+      },
+    };
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(weatherDefinition, async () => {
+      executorCalls += 1;
+      return 'forecast';
+    });
+
+    const missingField = await registry.execute('get_weather', {});
+    const enumMismatch = await registry.execute('get_weather', {location: 'Berlin', units: 'kelvin'});
+
+    expect({
+      executorCalls,
+      missingMentionsLocation: missingField.result.includes('location'),
+      missingMentionsRequired: /required/i.test(missingField.result),
+      enumMentionsUnits: enumMismatch.result.includes('units'),
+    }).toEqual({
+      executorCalls: 0,
+      missingMentionsLocation: true,
+      missingMentionsRequired: true,
+      enumMentionsUnits: true,
+    });
+  });
+
+  it('rejects a wrong-typed field naming path and expected type without coercing or leaking values', async () => {
+    const logLines: string[] = [];
+    const capture = (category: string, message: string, fields?: Record<string, unknown>) => {
+      logLines.push(JSON.stringify({category, message, fields}));
+    };
+    const logger: Logger = {debug: capture, info: capture, warn: capture, error: capture};
+    setLogger(logger);
+
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'forecast_days',
+        description: 'Get multi-day forecast',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            days: {type: 'number'},
+            note: {type: 'string'},
+          },
+          required: ['days'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'forecast';
+      }
+    );
+
+    const secretOffendingValue = '90210742';
+    const secretOtherField = 'PII-SECRET-NOTE';
+    const rejection = await registry.execute('forecast_days', {
+      days: secretOffendingValue,
+      note: secretOtherField,
+    });
+    const combinedLogs = logLines.join('\n');
+
+    expect({
+      executorCalls,
+      mentionsFieldPath: rejection.result.includes('days'),
+      mentionsExpectedType: /number/i.test(rejection.result),
+      leakedOffendingToResult: rejection.result.includes(secretOffendingValue),
+      leakedOtherToResult: rejection.result.includes(secretOtherField),
+      leakedOffendingToLogs: combinedLogs.includes(secretOffendingValue),
+      leakedOtherToLogs: combinedLogs.includes(secretOtherField),
+    }).toEqual({
+      executorCalls: 0,
+      mentionsFieldPath: true,
+      mentionsExpectedType: true,
+      leakedOffendingToResult: false,
+      leakedOtherToResult: false,
+      leakedOffendingToLogs: false,
+      leakedOtherToLogs: false,
+    });
+  });
+
+  it('throws at register time for a schema that cannot be compiled and names the tool', () => {
+    const registry = new ToolRegistry();
+    const brokenDefinition: ToolDefinition = {
+      name: 'broken_schema_tool',
+      description: 'Tool with a broken JSON Schema',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          target: {type: 'nonexistent-schema-type'},
+        },
+      },
+    };
+
+    expect(() => {
+      registry.register(brokenDefinition, async () => 'ok');
+    }).toThrow(/broken_schema_tool/);
+  });
+
+  it('validates dynamic tool definitions against the current schema and forwards extra properties unmodified', async () => {
+    const citySchema: Record<string, unknown> = {
+      type: 'object',
+      properties: {
+        city: {type: 'string'},
+        units: {type: 'string', default: 'celsius'},
+      },
+      required: ['city'],
+    };
+    const postalSchema: Record<string, unknown> = {
+      type: 'object',
+      properties: {
+        postalCode: {type: 'string'},
+      },
+      required: ['postalCode'],
+    };
+    let activeSchema = citySchema;
+    const receivedInputs: Record<string, unknown>[] = [];
+
+    const registry = new ToolRegistry();
+    registry.register(
+      () => ({
+        name: 'dynamic_lookup',
+        description: 'Lookup with evolving schema',
+        inputSchema: activeSchema,
+      }),
+      async input => {
+        receivedInputs.push(input);
+        return 'ok';
+      }
+    );
+
+    const firstResponse = await registry.execute('dynamic_lookup', {city: 'Berlin', extraTag: 'keep-me'});
+    activeSchema = postalSchema;
+    const staleCallResponse = await registry.execute('dynamic_lookup', {city: 'Berlin'});
+    const updatedResponse = await registry.execute('dynamic_lookup', {postalCode: '10115', extraTag: 'still-kept'});
+
+    expect({
+      firstResult: firstResponse.result,
+      staleMentionsPostalCode: staleCallResponse.result.includes('postalCode'),
+      updatedResult: updatedResponse.result,
+      receivedInputs,
+    }).toEqual({
+      firstResult: 'ok',
+      staleMentionsPostalCode: true,
+      updatedResult: 'ok',
+      receivedInputs: [
+        {city: 'Berlin', extraTag: 'keep-me'},
+        {postalCode: '10115', extraTag: 'still-kept'},
+      ],
+    });
+  });
+});