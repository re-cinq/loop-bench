+import {setLogger, type Logger} from '../../shared/logger.js';
+import type {ToolDefinition} from '../../types/ai.js';
+import {ToolRegistry, type ToolExecutor} from './registry.js';
+
+const weatherSchema = {
+  type: 'object',
+  properties: {location: {type: 'string'}},
+  required: ['location'],
+};
+
+const weather = (inputSchema: Record<string, unknown> = weatherSchema): ToolDefinition => ({
+  name: 'weather',
+  description: 'Forecast for a location',
+  inputSchema,
+});
+
+const recordingExecutor = () => {
+  const calls: Record<string, unknown>[] = [];
+  const executor: ToolExecutor = async input => {
+    calls.push(input);
+    return 'sunny';
+  };
+  return {calls, executor};
+};
+
+describe('ToolRegistry.execute input validation', () => {
+  it('rejects input missing a required property with a result naming it, and never runs the executor', async () => {
+    const registry = new ToolRegistry();
+    const {calls, executor} = recordingExecutor();
+    registry.register(weather(), executor);
+
+    const response = await registry.execute('weather', {});
+
+    expect(response.result).toContain('location');
+    expect(response.result).toContain('required');
+    expect(calls).toHaveLength(0);
+  });
+
+  it('passes valid input with an unlisted extra property to the executor unchanged, exactly once', async () => {
+    const registry = new ToolRegistry();
+    const {calls, executor} = recordingExecutor();
+    registry.register(weather(), executor);
+    const input = {location: 'Berlin', units: 'metric'};
+
+    const response = await registry.execute('weather', input);
+
+    expect(response.result).toBe('sunny');
+    expect(calls).toHaveLength(1);
+    expect(calls[0]).toEqual({location: 'Berlin', units: 'metric'});
+
+    const rejected = await registry.execute('weather', {units: 'metric'});
+
+    expect(rejected.result).toContain('location');
+    expect(calls).toHaveLength(1);
+  });
+
+  it('rejects a wrong-typed field naming its path and expected type, without echoing the value or logging it', async () => {
+    const lines: string[] = [];
+    const capture = (_c: string, message: string, fields?: Record<string, unknown>) =>
+      void lines.push(JSON.stringify({message, fields}));
+    const logger: Logger = {debug: capture, info: capture, warn: capture, error: capture};
+    setLogger(logger);
+    try {
+      const registry = new ToolRegistry();
+      const {calls, executor} = recordingExecutor();
+      registry.register(weather(), executor);
+
+      const response = await registry.execute('weather', {location: 4929138847});
+
+      expect(response.result).toContain('location');
+      expect(response.result).toContain('string');
+      expect(response.result).not.toContain('4929138847');
+      expect(calls).toHaveLength(0);
+      expect(lines.join('\n')).not.toContain('4929138847');
+    } finally {
+      setLogger();
+    }
+  });
+
+  it('throws at register time for an uncompilable schema, naming the tool', () => {
+    const registry = new ToolRegistry();
+    const {executor} = recordingExecutor();
+
+    expect(() => registry.register(weather({type: 'not-a-json-schema-type'}), executor)).toThrow(/weather/);
+  });
+
+  it('validates a function-valued definition against the schema current at that call', async () => {
+    const registry = new ToolRegistry();
+    const {calls, executor} = recordingExecutor();
+    let schema: Record<string, unknown> = weatherSchema;
+    registry.register(() => weather(schema), executor);
+
+    expect((await registry.execute('weather', {location: 'Berlin'})).result).toBe('sunny');
+
+    schema = {type: 'object', properties: {city: {type: 'string'}}, required: ['city']};
+    const response = await registry.execute('weather', {location: 'Berlin'});
+
+    expect(response.result).toContain('city');
+    expect(calls).toHaveLength(1);
+  });
+});