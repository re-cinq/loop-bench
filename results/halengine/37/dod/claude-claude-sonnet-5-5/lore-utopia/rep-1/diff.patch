+import {jest} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const SPEC = 'specs/hal-engine-tool-input-validation/spec.md';
+
+function weatherDefinition(inputSchema: Record<string, unknown> = locationSchema()): ToolDefinition {
+  return {name: 'weather', description: 'Get the weather', inputSchema} as ToolDefinition;
+}
+
+function locationSchema(): Record<string, unknown> {
+  return {type: 'object', properties: {location: {type: 'string'}}, required: ['location']};
+}
+
+function recordingExecutor() {
+  const calls: Record<string, unknown>[] = [];
+  const execute = async (input: Record<string, unknown>) => {
+    calls.push(input);
+    return 'sunny';
+  };
+  return {calls, execute};
+}
+
+describe(`tool input validation (${SPEC})`, () => {
+  it('rejects input missing a required property without running the executor', async () => {
+    const registry = new ToolRegistry();
+    const {calls, execute} = recordingExecutor();
+    registry.register(weatherDefinition(), execute);
+
+    const response = await registry.execute('weather', {});
+
+    expect({result: response.result.includes('location'), calls: calls.length}).toEqual({result: true, calls: 0});
+  });
+
+  it('rejects a wrong-typed field naming its path and expected type, never its value', async () => {
+    const registry = new ToolRegistry();
+    const {calls, execute} = recordingExecutor();
+    registry.register(weatherDefinition(), execute);
+    const logged: string[] = [];
+    const spy = jest.spyOn(console, 'log').mockImplementation((line: unknown) => void logged.push(String(line)));
+
+    const response = await registry.execute('weather', {location: 918273645});
+    spy.mockRestore();
+
+    expect({
+      namesPathAndType: /location/.test(response.result) && /string/.test(response.result),
+      leaksValue: [response.result, ...logged].some(text => text.includes('918273645')),
+      calls: calls.length,
+    }).toEqual({namesPathAndType: true, leaksValue: false, calls: 0});
+  });
+
+  it('throws at register time for an uncompilable schema, naming the tool', () => {
+    const registry = new ToolRegistry();
+    const {execute} = recordingExecutor();
+
+    expect(() => registry.register(weatherDefinition({type: 'not-a-type'}), execute)).toThrow(/weather/);
+  });
+
+  it('validates a function-valued definition against the schema current at that call', async () => {
+    const registry = new ToolRegistry();
+    const {calls, execute} = recordingExecutor();
+    let schema: Record<string, unknown> = locationSchema();
+    registry.register(() => weatherDefinition(schema), execute);
+
+    await registry.execute('weather', {});
+    schema = {type: 'object', properties: {}};
+    await registry.execute('weather', {});
+
+    expect(calls).toEqual([{}]);
+  });
+});