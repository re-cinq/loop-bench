+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+// specs/hal-engine-tool-input-validation/spec.md#behaviour
+
+const weather = (): ToolDefinition => ({
+  name: 'weather',
+  description: 'forecast',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}},
+    required: ['location'],
+  },
+});
+
+describe('ToolRegistry input validation', () => {
+  it('rejects input missing a required property without running the executor', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(weather(), async () => {
+      calls++;
+      return 'ok';
+    });
+    const response = await registry.execute('weather', {});
+    expect(response.result).toContain('location');
+    expect(calls).toBe(0);
+  });
+
+  it('names the path and expected type of a wrong-typed field but never its value', async () => {
+    const lines: string[] = [];
+    const capture: Logger = {
+      debug: (...a) => void lines.push(JSON.stringify(a)),
+      info: (...a) => void lines.push(JSON.stringify(a)),
+      warn: (...a) => void lines.push(JSON.stringify(a)),
+      error: (...a) => void lines.push(JSON.stringify(a)),
+    };
+    setLogger(capture);
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(weather(), async () => {
+      calls++;
+      return 'ok';
+    });
+    const secret = 918273645;
+    const response = await registry.execute('weather', {location: secret});
+    expect(calls).toBe(0);
+    expect(response.result).toContain('location');
+    expect(response.result).toContain('string');
+    expect(response.result).not.toContain(String(secret));
+    expect(lines.join('\n')).not.toContain(String(secret));
+  });
+
+  it('throws at register time naming the tool when its schema cannot compile', () => {
+    const registry = new ToolRegistry();
+    const broken: ToolDefinition = {...weather(), name: 'broken_tool', inputSchema: {type: 'no-such-type'}};
+    expect(() => registry.register(broken, async () => 'ok')).toThrow(/broken_tool/);
+  });
+
+  it('validates a function-valued definition against the schema current at each call', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    let required = 'a';
+    registry.register(
+      () => ({
+        name: 'dynamic',
+        description: 'd',
+        inputSchema: {type: 'object', properties: {[required]: {type: 'string'}}, required: [required]},
+      }),
+      async () => {
+        calls++;
+        return 'ok';
+      }
+    );
+    expect((await registry.execute('dynamic', {a: 'x'})).result).toBe('ok');
+    required = 'b';
+    const response = await registry.execute('dynamic', {a: 'x'});
+    expect(response.result).toContain('b');
+    expect(calls).toBe(1);
+  });
+});