@@ -0,0 +1,117 @@
+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const weather = (): ToolDefinition => ({
+  name: 'weather',
+  description: 'Forecast',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}, units: {type: 'string', enum: ['c', 'f']}},
+    required: ['location'],
+  },
+});
+
+function counted() {
+  const calls: Array<Record<string, unknown>> = [];
+  return {
+    calls,
+    executor: async (input: Record<string, unknown>) => {
+      calls.push(input);
+      return 'ok';
+    },
+  };
+}
+
+describe('ToolRegistry input validation', () => {
+  it('rejects input missing a required property with a result naming it, without running the executor', async () => {
+    const registry = new ToolRegistry();
+    const {calls, executor} = counted();
+    registry.register(weather(), executor);
+
+    const response = await registry.execute('weather', {});
+
+    expect({result: response.result.includes('location'), calls: calls.length}).toEqual({result: true, calls: 0});
+  });
+
+  it('passes valid input with an unlisted extra property to the executor unchanged, exactly once, and not invalid input', async () => {
+    const registry = new ToolRegistry();
+    const {calls, executor} = counted();
+    registry.register(weather(), executor);
+
+    await registry.execute('weather', {location: 'Berlin', extra: 1});
+    await registry.execute('weather', {location: 7, extra: 1});
+
+    expect(calls).toEqual([{location: 'Berlin', extra: 1}]);
+  });
+
+  it('rejects a wrong-typed field naming its path and expected type, never the offending value', async () => {
+    const registry = new ToolRegistry();
+    const {calls, executor} = counted();
+    registry.register(weather(), executor);
+
+    const {result} = await registry.execute('weather', {location: 918273645});
+
+    expect({
+      names: result.includes('location') && result.includes('string'),
+      leaked: result.includes('918273645'),
+      calls: calls.length,
+    }).toEqual({names: true, leaked: false, calls: 0});
+  });
+
+  it('throws at register time for an uncompilable schema, naming the tool', () => {
+    const registry = new ToolRegistry();
+    const broken: ToolDefinition = {...weather(), name: 'broken_tool', inputSchema: {type: 'no-such-type'}};
+
+    expect(() => registry.register(broken, async () => 'ok')).toThrow(/broken_tool/);
+  });
+
+  it('validates a function-valued definition against the schema current at that call', async () => {
+    const registry = new ToolRegistry();
+    const {calls, executor} = counted();
+    let required = 'location';
+    registry.register(
+      () => ({
+        ...weather(),
+        inputSchema: {type: 'object', properties: {[required]: {type: 'string'}}, required: [required]},
+      }),
+      executor
+    );
+
+    const first = await registry.execute('weather', {location: 'Berlin'});
+    required = 'city';
+    const second = await registry.execute('weather', {location: 'Berlin'});
+
+    expect({first: first.result, secondNamesCity: second.result.includes('city'), calls: calls.length}).toEqual({
+      first: 'ok',
+      secondNamesCity: true,
+      calls: 1,
+    });
+  });
+
+  it('writes no log line containing a rejected payload value', async () => {
+    const lines: string[] = [];
+    const capture: Logger = {
+      debug: (...a) => void lines.push(JSON.stringify(a)),
+      info: (...a) => void lines.push(JSON.stringify(a)),
+      warn: (...a) => void lines.push(JSON.stringify(a)),
+      error: (...a) => void lines.push(JSON.stringify(a)),
+    };
+    setLogger(capture);
+    const registry = new ToolRegistry();
+    registry.register(weather(), async () => 'ok');
+
+    const {result} = await registry.execute('weather', {location: 42, units: 'jane.doe@example.com'});
+
+    expect({
+      lines: lines.join('\n').includes('jane.doe@example.com'),
+      result: result.includes('jane.doe@example.com'),
+      rejected: result !== 'ok',
+    }).toEqual({
+      lines: false,
+      result: false,
+      rejected: true,
+    });
+  });
+});