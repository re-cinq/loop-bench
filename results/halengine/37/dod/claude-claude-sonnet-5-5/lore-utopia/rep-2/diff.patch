@@ -0,0 +1,73 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const SCHEMA = {
+  type: 'object',
+  properties: {location: {type: 'string'}},
+  required: ['location'],
+};
+
+const weather = (inputSchema: Record<string, unknown> = SCHEMA): ToolDefinition => ({
+  name: 'weather',
+  description: 'Forecast for a place',
+  inputSchema,
+});
+
+function recordingExecutor() {
+  const calls: Record<string, unknown>[] = [];
+  return {
+    calls,
+    execute: async (input: Record<string, unknown>) => {
+      calls.push(input);
+      return 'sunny';
+    },
+  };
+}
+
+describe('ToolRegistry.execute input validation', () => {
+  it('returns a rejection naming the missing property and never runs the executor', async () => {
+    const registry = new ToolRegistry();
+    const tool = recordingExecutor();
+    registry.register(weather(), tool.execute);
+
+    const response = await registry.execute('weather', {});
+
+    expect({result: response.result.includes('location'), calls: tool.calls.length}).toEqual({
+      result: true,
+      calls: 0,
+    });
+  });
+
+  it('rejects a wrong-typed field by path and expected type without echoing its value', async () => {
+    const registry = new ToolRegistry();
+    const tool = recordingExecutor();
+    registry.register(weather(), tool.execute);
+
+    const response = await registry.execute('weather', {location: 8675309});
+
+    expect({
+      namesPathAndType: /location/.test(response.result) && /string/.test(response.result),
+      leaksValue: response.result.includes('8675309'),
+      calls: tool.calls.length,
+    }).toEqual({namesPathAndType: true, leaksValue: false, calls: 0});
+  });
+
+  it('throws at register time for an uncompilable schema, naming the tool', () => {
+    const registry = new ToolRegistry();
+
+    expect(() => registry.register(weather({type: 'not-a-type'}), async () => 'x')).toThrow(/weather/);
+  });
+
+  it('validates a function-valued definition against the schema current at that call', async () => {
+    const registry = new ToolRegistry();
+    const tool = recordingExecutor();
+    let schema: Record<string, unknown> = {type: 'object'};
+    registry.register(() => weather(schema), tool.execute);
+
+    await registry.execute('weather', {});
+    schema = SCHEMA;
+    await registry.execute('weather', {});
+
+    expect(tool.calls.length).toBe(1);
+  });
+});