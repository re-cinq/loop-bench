@@ -0,0 +1,75 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolExecutor} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const weather = (inputSchema: Record<string, unknown>): ToolDefinition => ({
+  name: 'weather',
+  description: 'Weather for a location',
+  inputSchema,
+});
+
+const LOCATION_SCHEMA = {
+  type: 'object',
+  properties: {location: {type: 'string'}},
+  required: ['location'],
+};
+
+function countingExecutor(): {executor: ToolExecutor; inputs: Record<string, unknown>[]} {
+  const inputs: Record<string, unknown>[] = [];
+  const executor: ToolExecutor = async input => {
+    inputs.push(input);
+    return 'sunny';
+  };
+  return {executor, inputs};
+}
+
+describe('ToolRegistry.execute input validation', () => {
+  it('returns a rejection naming the missing required field and never runs the executor', async () => {
+    const registry = new ToolRegistry();
+    const {executor, inputs} = countingExecutor();
+    registry.register(weather(LOCATION_SCHEMA), executor);
+
+    const response = await registry.execute('weather', {});
+
+    expect({names: response.result.includes('location'), calls: inputs.length}).toEqual({names: true, calls: 0});
+  });
+
+  it('rejects a wrong-typed field naming its path and expected type, without echoing the value', async () => {
+    const registry = new ToolRegistry();
+    const {executor, inputs} = countingExecutor();
+    registry.register(weather(LOCATION_SCHEMA), executor);
+
+    const response = await registry.execute('weather', {location: 918273645});
+
+    expect({
+      path: response.result.includes('location'),
+      type: response.result.includes('string'),
+      leaksValue: response.result.includes('918273645'),
+      calls: inputs.length,
+    }).toEqual({path: true, type: true, leaksValue: false, calls: 0});
+  });
+
+  it('throws at register time for an uncompilable schema, naming the tool', () => {
+    const registry = new ToolRegistry();
+
+    const attempt = (): void => registry.register(weather({type: 'not-a-json-schema-type'}), async () => 'x');
+
+    expect(attempt).toThrow(/weather/);
+  });
+
+  it('validates a function-valued definition against the schema current at each call', async () => {
+    const registry = new ToolRegistry();
+    const {executor, inputs} = countingExecutor();
+    let schema: Record<string, unknown> = LOCATION_SCHEMA;
+    registry.register(() => weather(schema), executor);
+    await registry.execute('weather', {location: 'Oslo'});
+
+    schema = {type: 'object', properties: {city: {type: 'string'}}, required: ['city']};
+    const response = await registry.execute('weather', {location: 'Oslo'});
+
+    expect({rejectedForCity: response.result.includes('city'), calls: inputs.length}).toEqual({
+      rejectedForCity: true,
+      calls: 1,
+    });
+  });
+});