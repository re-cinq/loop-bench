+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+
+// specs/hal-engine-tool-input-validation/spec.md#1 .. #5
+const schema = {
+  type: 'object',
+  properties: {location: {type: 'string'}},
+  required: ['location'],
+};
+
+function tool(inputSchema: Record<string, unknown> = schema): ToolDefinition {
+  return {name: 'weather', description: 'Weather', inputSchema};
+}
+
+function counting() {
+  const calls: Array<Record<string, unknown>> = [];
+  return {
+    calls,
+    execute: async (input: Record<string, unknown>) => {
+      calls.push(input);
+      return 'ok';
+    },
+  };
+}
+
+describe('ToolRegistry.execute input validation', () => {
+  const lines: string[] = [];
+  const capture: Logger = {
+    debug: (c, m, f) => void lines.push(JSON.stringify([c, m, f])),
+    info: (c, m, f) => void lines.push(JSON.stringify([c, m, f])),
+    warn: (c, m, f) => void lines.push(JSON.stringify([c, m, f])),
+    error: (c, m, f) => void lines.push(JSON.stringify([c, m, f])),
+  };
+  beforeEach(() => {
+    lines.length = 0;
+    setLogger(capture);
+  });
+  afterAll(() => setLogger());
+
+  it('rejects input missing a required property with a result naming it, and never runs the executor', async () => {
+    const registry = new ToolRegistry();
+    const t = counting();
+    registry.register(tool(), t.execute);
+
+    const response = await registry.execute('weather', {});
+
+    expect(response.result).toContain('location');
+    expect(t.calls).toHaveLength(0);
+  });
+
+  it('passes valid input with an unlisted extra property to the executor unchanged, exactly once', async () => {
+    const registry = new ToolRegistry();
+    const t = counting();
+    registry.register(tool(), t.execute);
+
+    const rejected = await registry.execute('weather', {units: 'metric'});
+    const response = await registry.execute('weather', {location: 'Oslo', units: 'metric'});
+
+    expect(rejected.result).toContain('location');
+    expect(response.result).toBe('ok');
+    expect(t.calls).toEqual([{location: 'Oslo', units: 'metric'}]);
+  });
+
+  it('rejects a wrong-typed field naming its path and expected type, and leaks its value nowhere', async () => {
+    const registry = new ToolRegistry();
+    const t = counting();
+    registry.register(tool(), t.execute);
+
+    const response = await registry.execute('weather', {location: 8675309});
+
+    expect(t.calls).toHaveLength(0);
+    expect(response.result).toContain('location');
+    expect(response.result).toContain('string');
+    expect(response.result).not.toContain('8675309');
+    expect(lines.join('\n')).not.toContain('8675309');
+  });
+
+  it('throws at register time for an uncompilable schema, naming the tool', () => {
+    const registry = new ToolRegistry();
+
+    expect(() => registry.register(tool({type: 'not-a-type'}), counting().execute)).toThrow(/weather/);
+  });
+
+  it('validates a function-valued definition against the schema current at that call', async () => {
+    const registry = new ToolRegistry();
+    const t = counting();
+    let current: Record<string, unknown> = schema;
+    registry.register(() => tool(current), t.execute);
+
+    await registry.execute('weather', {location: 'Oslo'});
+    current = {type: 'object', properties: {city: {type: 'string'}}, required: ['city']};
+    const response = await registry.execute('weather', {location: 'Oslo'});
+
+    expect(response.result).toContain('city');
+    expect(t.calls).toHaveLength(1);
+  });
+});