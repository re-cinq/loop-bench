+import {ToolRegistry} from './registry.js';
+import type {ToolExecutor} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+
+// Acceptance for #37: input is validated against inputSchema before the executor runs.
+
+const SCHEMA_REQUIRING = (property: string, type: string) => ({
+  type: 'object' as const,
+  properties: {[property]: {type}},
+  required: [property],
+});
+
+const toolNamed = (name: string, inputSchema: ToolDefinition['inputSchema']): ToolDefinition => ({
+  name,
+  description: `${name} tool`,
+  inputSchema,
+});
+
+const countingExecutor = () => {
+  const calls: Record<string, unknown>[] = [];
+  const executor: ToolExecutor = async input => {
+    calls.push(input);
+    return 'ran';
+  };
+  return {calls, executor};
+};
+
+describe('ToolRegistry input validation', () => {
+  afterEach(() => setLogger());
+
+  it('rejects input missing a required property, naming it, without running the executor', async () => {
+    const registry = new ToolRegistry();
+    const {calls, executor} = countingExecutor();
+    registry.register(toolNamed('weather', SCHEMA_REQUIRING('location', 'string')), executor);
+
+    const response = await registry.execute('weather', {});
+
+    expect({mentionsLocation: response.result.includes('location'), executorCalls: calls.length}).toEqual({
+      mentionsLocation: true,
+      executorCalls: 0,
+    });
+  });
+
+  it('rejects a wrong-typed property naming its path and type, never echoing the value in result or logs', async () => {
+    const lines: string[] = [];
+    const record = (category: string, message: string, fields?: Record<string, unknown>) =>
+      void lines.push(JSON.stringify({category, message, fields}));
+    const capture: Logger = {debug: record, info: record, warn: record, error: record};
+    setLogger(capture);
+    const registry = new ToolRegistry();
+    const {calls, executor} = countingExecutor();
+    registry.register(toolNamed('weather', SCHEMA_REQUIRING('location', 'string')), executor);
+
+    const response = await registry.execute('weather', {location: 918273645});
+
+    expect({
+      namesPathAndType: response.result.includes('location') && response.result.includes('string'),
+      valueInResult: response.result.includes('918273645'),
+      valueInLogs: lines.some(line => line.includes('918273645')),
+      executorCalls: calls.length,
+    }).toEqual({namesPathAndType: true, valueInResult: false, valueInLogs: false, executorCalls: 0});
+  });
+
+  it('throws at register for an uncompilable schema, naming the tool', () => {
+    const registry = new ToolRegistry();
+    const broken = toolNamed('broken-tool', {type: 'object', properties: {a: {type: 'not-a-type'}}});
+
+    expect(() => registry.register(broken, async () => 'ran')).toThrow('broken-tool');
+  });
+
+  it('validates a function-valued definition against the schema current at that call', async () => {
+    const registry = new ToolRegistry();
+    const {calls, executor} = countingExecutor();
+    let required = 'first';
+    registry.register(() => toolNamed('dynamic', SCHEMA_REQUIRING(required, 'string')), executor);
+
+    required = 'second';
+    const response = await registry.execute('dynamic', {first: 'x'});
+
+    expect({mentionsSecond: response.result.includes('second'), executorCalls: calls.length}).toEqual({
+      mentionsSecond: true,
+      executorCalls: 0,
+    });
+  });
+});