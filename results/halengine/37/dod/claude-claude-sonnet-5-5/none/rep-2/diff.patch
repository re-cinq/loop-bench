+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+
+const weather = (schema: ToolDefinition['inputSchema'] = locationSchema()): ToolDefinition => ({
+  name: 'weather',
+  description: 'forecast',
+  inputSchema: schema,
+});
+
+function locationSchema(): ToolDefinition['inputSchema'] {
+  return {type: 'object', properties: {location: {type: 'string'}}, required: ['location']};
+}
+
+function countingExecutor() {
+  const calls: Array<Record<string, unknown>> = [];
+  return {
+    calls,
+    execute: async (input: Record<string, unknown>) => {
+      calls.push(input);
+      return 'ok';
+    },
+  };
+}
+
+describe('ToolRegistry.execute input validation', () => {
+  afterEach(() => setLogger());
+
+  it('returns a rejection naming the missing required property and never runs the executor', async () => {
+    const registry = new ToolRegistry();
+    const tool = countingExecutor();
+    registry.register(weather(), tool.execute);
+
+    const response = await registry.execute('weather', {});
+
+    expect(response.result).toContain('location');
+    expect(response.result).toContain('required');
+    expect(tool.calls).toHaveLength(0);
+  });
+
+  it('rejects a wrong-typed field naming its path and expected type, without echoing the value in text or logs', async () => {
+    const lines: string[] = [];
+    const capture = (category: string, message: string, fields?: Record<string, unknown>) =>
+      void lines.push(JSON.stringify({category, message, fields}));
+    const logger: Logger = {debug: capture, info: capture, warn: capture, error: capture};
+    setLogger(logger);
+    const registry = new ToolRegistry();
+    const tool = countingExecutor();
+    registry.register(weather(), tool.execute);
+
+    const response = await registry.execute('weather', {location: 4815162342});
+
+    expect(response.result).toContain('location');
+    expect(response.result).toContain('string');
+    expect(response.result).not.toContain('4815162342');
+    expect(lines.join('\n')).not.toContain('4815162342');
+    expect(tool.calls).toHaveLength(0);
+  });
+
+  it('throws at registration for an uncompilable schema, naming the tool', () => {
+    const registry = new ToolRegistry();
+    const broken = weather({type: 'object', properties: {location: {type: 'no-such-type'}}} as never);
+
+    expect(() => registry.register(broken, countingExecutor().execute)).toThrow(/weather/);
+  });
+
+  it('validates a function-valued definition against the schema current at each call, passing extra properties through unchanged', async () => {
+    const registry = new ToolRegistry();
+    const tool = countingExecutor();
+    let current: ToolDefinition['inputSchema'] = locationSchema();
+    registry.register(() => weather(current), tool.execute);
+
+    expect((await registry.execute('weather', {city: 'Oslo'})).result).toContain('location');
+    current = {type: 'object', properties: {city: {type: 'string'}}, required: ['city']};
+    await registry.execute('weather', {city: 'Oslo', units: 'metric'});
+
+    expect(tool.calls).toEqual([{city: 'Oslo', units: 'metric'}]);
+  });
+});