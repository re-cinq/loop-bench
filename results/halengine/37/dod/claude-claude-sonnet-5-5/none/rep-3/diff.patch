@@ -0,0 +1,75 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const weather = (schema: Record<string, unknown> = {}): ToolDefinition => ({
+  name: 'weather',
+  description: 'Get the weather',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}},
+    required: ['location'],
+    ...schema,
+  },
+});
+
+function recordingExecutor() {
+  const calls: Record<string, unknown>[] = [];
+  return {
+    calls,
+    execute: async (input: Record<string, unknown>) => {
+      calls.push(input);
+      return 'forecast';
+    },
+  };
+}
+
+describe('ToolRegistry input validation', () => {
+  it('rejects input missing a required property with a result naming it, without running the executor', async () => {
+    const registry = new ToolRegistry();
+    const tool = recordingExecutor();
+    registry.register(weather(), tool.execute);
+
+    const response = await registry.execute('weather', {});
+
+    expect({result: response.result.includes('location'), calls: tool.calls.length}).toEqual({
+      result: true,
+      calls: 0,
+    });
+  });
+
+  it('rejects a wrong-typed field naming its path and expected type but never its value', async () => {
+    const registry = new ToolRegistry();
+    const tool = recordingExecutor();
+    registry.register(weather(), tool.execute);
+
+    const response = await registry.execute('weather', {location: 918273645});
+
+    expect({
+      namesPathAndType: /location/.test(response.result) && /string/.test(response.result),
+      leaksValue: response.result.includes('918273645'),
+      calls: tool.calls.length,
+    }).toEqual({namesPathAndType: true, leaksValue: false, calls: 0});
+  });
+
+  it('throws at register time for an uncompilable schema, naming the tool', () => {
+    const registry = new ToolRegistry();
+    const broken = weather({properties: {location: {type: 'not-a-type'}}});
+
+    expect(() => registry.register(broken, async () => 'x')).toThrow(/weather/);
+  });
+
+  it('validates a function-valued definition against the schema current at that call', async () => {
+    const registry = new ToolRegistry();
+    const tool = recordingExecutor();
+    let required = ['location'];
+    registry.register(() => weather({required}), tool.execute);
+
+    required = ['city'];
+    const response = await registry.execute('weather', {location: 'Berlin'});
+
+    expect({mentionsCity: response.result.includes('city'), calls: tool.calls.length}).toEqual({
+      mentionsCity: true,
+      calls: 0,
+    });
+  });
+});