+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+import {ToolRegistry} from './registry.js';
+import type {ToolExecutor} from './registry.js';
+
+const locationSchema = {
+  type: 'object',
+  properties: {location: {type: 'string'}, unit: {type: 'string', enum: ['c', 'f']}},
+  required: ['location'],
+};
+
+function countingExecutor() {
+  const calls: Array<Record<string, unknown>> = [];
+  const execute: ToolExecutor = async input => {
+    calls.push(input);
+    return 'ran';
+  };
+  return {calls, execute};
+}
+
+describe('ToolRegistry input validation', () => {
+  afterEach(() => setLogger());
+
+  it('rejects input missing a required property without running the executor', async () => {
+    const registry = new ToolRegistry();
+    const {calls, execute} = countingExecutor();
+    registry.register({name: 'weather', description: 'd', inputSchema: locationSchema}, execute);
+
+    const response = await registry.execute('weather', {});
+
+    expect(response.result).toContain('location');
+    expect(response.result).toMatch(/required/i);
+    expect(calls).toHaveLength(0);
+  });
+
+  it('rejects a wrong-typed field naming its path and expected type, never its value or in logs', async () => {
+    const lines: string[] = [];
+    const sink = (_c: string, m: string, f?: Record<string, unknown>) => void lines.push(JSON.stringify({m, f}));
+    const logger: Logger = {debug: sink, info: sink, warn: sink, error: sink};
+    setLogger(logger);
+    const registry = new ToolRegistry();
+    const {calls, execute} = countingExecutor();
+    registry.register({name: 'weather', description: 'd', inputSchema: locationSchema}, execute);
+
+    const response = await registry.execute('weather', {location: 8675309, unit: 'jane.doe@example.com'});
+
+    expect(response.result).toContain('location');
+    expect(response.result).toContain('string');
+    expect(calls).toHaveLength(0);
+    for (const text of [response.result, ...lines]) {
+      expect(text).not.toContain('8675309');
+      expect(text).not.toContain('jane.doe@example.com');
+    }
+  });
+
+  it('passes valid input with an unlisted extra property to the executor unchanged, once', async () => {
+    const registry = new ToolRegistry();
+    const {calls, execute} = countingExecutor();
+    registry.register({name: 'weather', description: 'd', inputSchema: locationSchema}, execute);
+
+    const response = await registry.execute('weather', {location: 'Berlin', extra: 1});
+
+    expect(response.result).toBe('ran');
+    expect(calls).toEqual([{location: 'Berlin', extra: 1}]);
+  });
+
+  it('throws at register time for an uncompilable schema, naming the tool', () => {
+    const registry = new ToolRegistry();
+    const {execute} = countingExecutor();
+
+    expect(() =>
+      registry.register({name: 'broken-tool', description: 'd', inputSchema: {type: 'not-a-type'}}, execute)
+    ).toThrow(/broken-tool/);
+  });
+
+  it('validates a function-valued definition against the schema current at that call', async () => {
+    const registry = new ToolRegistry();
+    const {calls, execute} = countingExecutor();
+    let schema: Record<string, unknown> = {type: 'object', properties: {a: {type: 'string'}}, required: ['a']};
+    registry.register(() => ({name: 'dyn', description: 'd', inputSchema: schema}), execute);
+
+    expect((await registry.execute('dyn', {a: 'x'})).result).toBe('ran');
+    schema = {type: 'object', properties: {b: {type: 'string'}}, required: ['b']};
+    const response = await registry.execute('dyn', {a: 'x'});
+
+    expect(response.result).toContain('b');
+    expect(calls).toHaveLength(1);
+  });
+});