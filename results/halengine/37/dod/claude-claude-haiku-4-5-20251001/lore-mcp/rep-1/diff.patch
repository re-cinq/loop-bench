@@ -519,4 +519,38 @@ describe('ChatOrchestrator tool loop', () => {
 
     expect(seen).toEqual(usage);
   });
+
+  it('resolves without throwing when a tool call is rejected for invalid input followed by a retry', async () => {
+    const rejectionRegistry = (): ToolRegistry => {
+      const registry = new ToolRegistry();
+      registry.register(
+        {
+          name: 'needs_param',
+          description: 'needs a param',
+          inputSchema: {type: 'object', properties: {param: {type: 'string'}}, required: ['param']},
+        },
+        async input => `got ${input.param}`
+      );
+      return registry;
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [{type: 'tool_use', toolCall: {id: 'call-1', name: 'needs_param', input: {}}}, STOP_FOR_TOOL],
+        [
+          {type: 'text', text: 'retrying: '},
+          {type: 'tool_use', toolCall: {id: 'call-2', name: 'needs_param', input: {param: 'correct'}}},
+          STOP_FOR_TOOL,
+        ],
+        [{type: 'text', text: 'success'}, STOP_DONE],
+      ]),
+      promptBuilder,
+      rejectionRegistry()
+    );
+
+    // This should resolve (not reject or throw) even though the first tool call has invalid input
+    const result = await orchestrator.processMessage(createSession('test'));
+
+    expect(result).toContain('success');
+  });
 });
diff --git a/src/orchestration/tools/registry.acceptance.test.ts b/src/orchestration/tools/registry.acceptance.test.ts
new file mode 100644
index 0000000..0a4966a
--- /dev/null
+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,250 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolResponse} from './registry.js';
+
+// Acceptance tests for input schema validation against registered tool definitions.
+// When these pass, tool input validation is complete.
+
+describe('ToolRegistry input validation', () => {
+  describe('Required field validation', () => {
+    it('rejects input missing a required field and does not call executor', async () => {
+      const callCount = {value: 0};
+      const registry = new ToolRegistry();
+
+      registry.register(
+        {
+          name: 'test_tool',
+          description: 'test',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              location: {type: 'string'},
+            },
+            required: ['location'],
+          },
+        },
+        async () => {
+          callCount.value += 1;
+          return 'executed';
+        }
+      );
+
+      const result = await registry.execute('test_tool', {}, {userId: 'u1'});
+
+      expect(callCount.value).toBe(0);
+      expect(result.result).toContain('location');
+    });
+  });
+
+  describe('Valid input passes through', () => {
+    it('passes valid input matching schema to executor without modification', async () => {
+      const executorInputs: Record<string, unknown>[] = [];
+      const registry = new ToolRegistry();
+
+      registry.register(
+        {
+          name: 'test_tool',
+          description: 'test',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              query: {type: 'string'},
+            },
+            required: ['query'],
+          },
+        },
+        async input => {
+          executorInputs.push(input);
+          return 'executed';
+        }
+      );
+
+      const input = {query: 'test', extraKey: 'value'};
+      await registry.execute('test_tool', input, {userId: 'u1'});
+
+      expect(executorInputs).toHaveLength(1);
+      expect(executorInputs[0]).toEqual(input);
+    });
+  });
+
+  describe('Type validation', () => {
+    it('rejects wrong-typed field with error naming field path and type, not the value', async () => {
+      const registry = new ToolRegistry();
+
+      registry.register(
+        {
+          name: 'test_tool',
+          description: 'test',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              count: {type: 'number'},
+            },
+            required: ['count'],
+          },
+        },
+        async () => 'executed'
+      );
+
+      const result = await registry.execute('test_tool', {count: 'not a number'}, {userId: 'u1'});
+
+      expect(result.result).toContain('count');
+      expect(result.result).toContain('number');
+      expect(result.result).not.toContain('not a number');
+    });
+  });
+
+  describe('Data privacy in errors', () => {
+    it('does not include property values in rejection messages or logs', async () => {
+      const registry = new ToolRegistry();
+
+      registry.register(
+        {
+          name: 'test_tool',
+          description: 'test',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              apiKey: {type: 'string'},
+            },
+            required: ['apiKey'],
+          },
+        },
+        async () => 'executed'
+      );
+
+      const result = await registry.execute('test_tool', {apiKey: 'secret-key-123'}, {userId: 'u1'});
+
+      expect(result.result).not.toContain('secret-key-123');
+      expect(result.result).toContain('apiKey');
+    });
+  });
+
+  describe('Static schema compilation', () => {
+    it('compiles static schema once at register time', async () => {
+      let executorCallCount = 0;
+
+      const registry = new ToolRegistry();
+
+      registry.register(
+        {
+          name: 'test_tool',
+          description: 'test',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              value: {type: 'string'},
+            },
+            required: ['value'],
+          },
+        },
+        async () => {
+          executorCallCount += 1;
+          return 'executed';
+        }
+      );
+
+      // Execute the same tool multiple times
+      for (let i = 0; i < 10; i++) {
+        await registry.execute('test_tool', {value: 'test'}, {userId: 'u1'});
+      }
+
+      // If schema is compiled once, we should have 10 executor calls
+      expect(executorCallCount).toBe(10);
+    });
+  });
+
+  describe('Function-valued schema per-call compilation', () => {
+    it('evaluates and validates against schema current at each call', async () => {
+      let schemaVersion = 1;
+      const registry = new ToolRegistry();
+
+      registry.register(
+        () => ({
+          name: 'test_tool',
+          description: 'test',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              value: {
+                type: schemaVersion === 1 ? 'string' : 'number',
+              },
+            },
+            required: ['value'],
+          },
+        }),
+        async input => `executed with ${input.value}`
+      );
+
+      // First call with string (schema version 1)
+      const result1 = await registry.execute('test_tool', {value: 'text'}, {userId: 'u1'});
+      expect(result1.result).toContain('executed');
+
+      // Change schema to require number
+      schemaVersion = 2;
+
+      // Next call with string should fail (schema now requires number)
+      const result2 = await registry.execute('test_tool', {value: 'text'}, {userId: 'u1'});
+      expect(result2.result).toContain('number');
+      expect(result2.result).not.toContain('text');
+    });
+  });
+
+  describe('Unknown tool name', () => {
+    it('still throws for unregistered tool name', async () => {
+      const registry = new ToolRegistry();
+
+      await expect(registry.execute('unknown_tool', {}, {userId: 'u1'})).rejects.toThrow('Unknown tool: unknown_tool');
+    });
+  });
+
+  describe('Enum validation', () => {
+    it('rejects value not in enum list', async () => {
+      const registry = new ToolRegistry();
+
+      registry.register(
+        {
+          name: 'test_tool',
+          description: 'test',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              units: {
+                type: 'string',
+                enum: ['celsius', 'fahrenheit'],
+              },
+            },
+            required: ['units'],
+          },
+        },
+        async () => 'executed'
+      );
+
+      const result = await registry.execute('test_tool', {units: 'kelvin'}, {userId: 'u1'});
+
+      expect(result.result).toContain('units');
+      expect(result.result).not.toContain('kelvin');
+    });
+  });
+
+  describe('Schema compilation at register time', () => {
+    it('throws at registration time for an uncompilable static schema', () => {
+      const registry = new ToolRegistry();
+
+      expect(() => {
+        registry.register(
+          {
+            name: 'test_tool',
+            description: 'test',
+            inputSchema: {
+              type: 'object',
+              properties: {
+                value: {type: 'invalid_type'},
+              },
+            },
+          },
+          async () => 'executed'
+        );
+      }).toThrow();
+    });
+  });
+});