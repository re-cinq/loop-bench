diff --git a/src/orchestration/tools/registry.acceptance.test.ts b/src/orchestration/tools/registry.acceptance.test.ts
new file mode 100644
index 0000000..ac6ee59
--- /dev/null
+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,249 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+describe('ToolRegistry validation', () => {
+  it('rejects input missing a required field and never invokes the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCallCount = 0;
+    registry.register(
+      {
+        name: 'get_location',
+        description: 'Get location',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string', description: 'The location'},
+          },
+          required: ['location'],
+        },
+      },
+      async () => {
+        executorCallCount += 1;
+        return 'result';
+      }
+    );
+
+    const response = await registry.execute('get_location', {}, undefined);
+
+    expect(executorCallCount).toBe(0);
+    expect(response.result).toContain('location');
+    expect(response.result).toContain('required');
+  });
+
+  it('passes valid input with extra unlisted properties through unchanged', async () => {
+    const registry = new ToolRegistry();
+    let capturedInput: Record<string, unknown> | undefined;
+    registry.register(
+      {
+        name: 'test_tool',
+        description: 'Test tool',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            name: {type: 'string'},
+          },
+          required: ['name'],
+        },
+      },
+      async input => {
+        capturedInput = input;
+        return 'result';
+      }
+    );
+
+    const input = {name: 'Alice', extra: 'field', another: 42};
+    await registry.execute('test_tool', input, undefined);
+
+    expect(capturedInput).toEqual(input);
+  });
+
+  it('rejects wrong-typed field and names the field and type in the error', async () => {
+    const registry = new ToolRegistry();
+    let executorCallCount = 0;
+    registry.register(
+      {
+        name: 'string_tool',
+        description: 'Tool requiring a string',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            name: {type: 'string'},
+          },
+          required: ['name'],
+        },
+      },
+      async () => {
+        executorCallCount += 1;
+        return 'result';
+      }
+    );
+
+    const response = await registry.execute('string_tool', {name: 42}, undefined);
+
+    expect(executorCallCount).toBe(0);
+    expect(response.result).toContain('name');
+    expect(response.result).toContain('string');
+    expect(response.result).not.toContain('42');
+  });
+
+  it('throws at register time for an uncompilable schema', () => {
+    const registry = new ToolRegistry();
+    const invalidSchema: ToolDefinition = {
+      name: 'bad_tool',
+      description: 'Tool with invalid schema',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          field: {type: 'invalid_type'},
+        },
+      },
+    };
+
+    expect(() => {
+      registry.register(invalidSchema, async () => 'result');
+    }).toThrow();
+    expect(() => {
+      registry.register(invalidSchema, async () => 'result');
+    }).toThrow(/bad_tool/);
+  });
+
+  it('validates function-valued schemas against the current schema, not a stale cached one', async () => {
+    const registry = new ToolRegistry();
+    let currentRequired = ['field1'];
+    let executorCallCount = 0;
+
+    registry.register(
+      () => {
+        return {
+          name: 'dynamic_tool',
+          description: 'Tool with dynamic schema',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              field1: {type: 'string'},
+              field2: {type: 'string'},
+            },
+            required: currentRequired,
+          },
+        };
+      },
+      async () => {
+        executorCallCount += 1;
+        return 'result';
+      }
+    );
+
+    // First call with only field1
+    await registry.execute('dynamic_tool', {field1: 'value'}, undefined);
+    expect(executorCallCount).toBe(1);
+
+    // Change the schema requirement
+    currentRequired = ['field1', 'field2'];
+
+    // Second call should validate against new schema and fail
+    const response = await registry.execute('dynamic_tool', {field1: 'value'}, undefined);
+    expect(executorCallCount).toBe(1); // Still only 1 call from before
+    expect(response.result).toContain('field2');
+  });
+
+  it('validates static tool schema across ten execute calls consistently', async () => {
+    const registry = new ToolRegistry();
+    let executorCallCount = 0;
+
+    registry.register(
+      {
+        name: 'compiled_tool',
+        description: 'Tool with static schema',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            value: {type: 'string'},
+          },
+          required: ['value'],
+        },
+      },
+      async () => {
+        executorCallCount += 1;
+        return 'result';
+      }
+    );
+
+    // Execute 10 times with valid input
+    for (let i = 0; i < 10; i++) {
+      const response = await registry.execute('compiled_tool', {value: 'test'}, undefined);
+      expect(response.result).toBe('result');
+    }
+
+    // All 10 should have reached the executor
+    expect(executorCallCount).toBe(10);
+
+    // Now test with invalid input - should reject consistently
+    const response = await registry.execute('compiled_tool', {value: 123}, undefined);
+    expect(response.result).toContain('string');
+  });
+
+  it('throws Unknown tool for unregistered tool name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('nonexistent', {}, undefined)).rejects.toThrow('Unknown tool: nonexistent');
+  });
+
+  it('redacts identifying data from rejection messages', async () => {
+    const registry = new ToolRegistry();
+    let executorCallCount = 0;
+    registry.register(
+      {
+        name: 'user_lookup',
+        description: 'Lookup user',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            email: {type: 'string'},
+          },
+          required: ['email'],
+        },
+      },
+      async () => {
+        executorCallCount += 1;
+        return 'result';
+      }
+    );
+
+    // Missing required email field with wrong-typed value provided
+    const response = await registry.execute('user_lookup', {email: 123}, undefined);
+
+    // Should reject with error message
+    expect(executorCallCount).toBe(0);
+    // Error message should name the field but not contain the value
+    expect(response.result).toContain('email');
+    expect(response.result).not.toContain('123');
+  });
+
+  it('rejects enum constraint violation and names the field', async () => {
+    const registry = new ToolRegistry();
+    let executorCallCount = 0;
+    registry.register(
+      {
+        name: 'enum_tool',
+        description: 'Tool with enum',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            status: {type: 'string', enum: ['active', 'inactive']},
+          },
+          required: ['status'],
+        },
+      },
+      async () => {
+        executorCallCount += 1;
+        return 'result';
+      }
+    );
+
+    const response = await registry.execute('enum_tool', {status: 'invalid'}, undefined);
+
+    expect(executorCallCount).toBe(0);
+    expect(response.result).toContain('status');
+    expect(response.result).not.toContain('invalid');
+  });
+});