+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition, ToolCall} from '../../types/ai.js';
+import type {AIProvider, MessageChunk} from '../../types/ai.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+describe('ToolRegistry input validation', () => {
+  describe('missing required field is rejected', () => {
+    it('returns validation error when required field missing', async () => {
+      const registry = new ToolRegistry();
+      let executorCalled = false;
+
+      registry.register(
+        {
+          name: 'weather',
+          description: 'Get weather',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              location: {type: 'string'},
+            },
+            required: ['location'],
+          },
+        },
+        async () => {
+          executorCalled = true;
+          return 'sunny';
+        }
+      );
+
+      const result = await registry.execute('weather', {});
+
+      expect(executorCalled).toBe(false);
+      expect(result.result).toContain('location');
+      expect(result.result).toContain('required');
+    });
+  });
+
+  describe('valid input with extra properties passes through', () => {
+    it('passes through unchanged to executor', async () => {
+      const registry = new ToolRegistry();
+      const capturedInput: Record<string, unknown>[] = [];
+
+      registry.register(
+        {
+          name: 'weather',
+          description: 'Get weather',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              location: {type: 'string'},
+            },
+            required: ['location'],
+          },
+        },
+        async input => {
+          capturedInput.push(input);
+          return 'result';
+        }
+      );
+
+      const input = {location: 'NYC', extraField: 'value', another: 123};
+      const result = await registry.execute('weather', input);
+
+      expect(result.result).toBe('result');
+      expect(capturedInput).toHaveLength(1);
+      expect(capturedInput[0]).toEqual(input);
+    });
+  });
+
+  describe('wrong-typed field is rejected without leaking value', () => {
+    it('rejects number where string required and names field path and type', async () => {
+      const registry = new ToolRegistry();
+      let executorCalled = false;
+
+      registry.register(
+        {
+          name: 'weather',
+          description: 'Get weather',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              location: {type: 'string'},
+            },
+            required: ['location'],
+          },
+        },
+        async () => {
+          executorCalled = true;
+          return 'sunny';
+        }
+      );
+
+      const result = await registry.execute('weather', {location: 42});
+
+      expect(executorCalled).toBe(false);
+      expect(result.result).toContain('location');
+      expect(result.result).toContain('string');
+      expect(result.result).not.toContain('42');
+    });
+  });
+
+  describe('register throws for uncompilable schema', () => {
+    it('throws at registration time when schema is invalid', () => {
+      const registry = new ToolRegistry();
+
+      expect(() => {
+        registry.register(
+          {
+            name: 'broken',
+            description: 'Broken tool',
+            inputSchema: {
+              type: 'object',
+              properties: {
+                field: {type: 'invalid-type'},
+              },
+            },
+          },
+          async () => 'result'
+        );
+      }).toThrow();
+    });
+
+    it('throws include tool name in error message', () => {
+      const registry = new ToolRegistry();
+
+      expect(() => {
+        registry.register(
+          {
+            name: 'mybrokenname',
+            description: 'Broken',
+            inputSchema: {
+              type: 'object',
+              properties: {
+                x: {type: 'invalid'},
+              },
+            },
+          },
+          async () => 'result'
+        );
+      }).toThrow(/mybrokenname/);
+    });
+  });
+
+  describe('function-valued schema validates against current call schema', () => {
+    it('uses current schema from function on each call', async () => {
+      const registry = new ToolRegistry();
+      let schemaVersion = 1;
+
+      registry.register(
+        () => ({
+          name: 'dynamic',
+          description: 'Dynamic schema',
+          inputSchema:
+            schemaVersion === 1
+              ? {
+                  type: 'object',
+                  properties: {field1: {type: 'string'}},
+                  required: ['field1'],
+                }
+              : {
+                  type: 'object',
+                  properties: {field2: {type: 'string'}},
+                  required: ['field2'],
+                },
+        }),
+        async () => 'result'
+      );
+
+      // First call should validate against field1
+      const result1 = await registry.execute('dynamic', {field1: 'value'});
+      expect(result1.result).toBe('result');
+
+      // Change schema version
+      schemaVersion = 2;
+
+      // Second call should validate against field2, not field1
+      const result2 = await registry.execute('dynamic', {field2: 'value'});
+      expect(result2.result).toBe('result');
+
+      // Call with field1 should now fail
+      const result3 = await registry.execute('dynamic', {field1: 'value'});
+      expect(result3.result).not.toBe('result');
+      expect(result3.result).toContain('field2');
+    });
+  });
+
+  describe('static schema compiled once', () => {
+    it('compiles schema once across multiple execute calls', async () => {
+      const registry = new ToolRegistry();
+      let compilationCount = 0;
+
+      // We'll track this indirectly - the important thing is it doesn't throw
+      // on subsequent calls due to re-compilation issues
+      registry.register(
+        {
+          name: 'static',
+          description: 'Static schema tool',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              count: {type: 'number'},
+            },
+            required: ['count'],
+          },
+        },
+        async input => `count: ${input.count}`
+      );
+
+      // Execute many times with valid input
+      for (let i = 0; i < 10; i++) {
+        const result = await registry.execute('static', {count: i});
+        expect(result.result).toBe(`count: ${i}`);
+      }
+
+      // All should succeed
+      expect(true).toBe(true);
+    });
+  });
+
+  describe('unknown tool still throws', () => {
+    it('throws Unknown tool error for unregistered tool', async () => {
+      const registry = new ToolRegistry();
+
+      await expect(registry.execute('nonexistent', {})).rejects.toThrow('Unknown tool: nonexistent');
+    });
+  });
+
+  describe('rejection does not leak property value', () => {
+    it('error message names property but not its identifying value', async () => {
+      const registry = new ToolRegistry();
+
+      registry.register(
+        {
+          name: 'sensitive',
+          description: 'Tool with sensitive input',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              apiKey: {type: 'string'},
+            },
+            required: ['apiKey'],
+          },
+        },
+        async () => 'result'
+      );
+
+      const result = await registry.execute('sensitive', {apiKey: 'secret-key-12345'});
+
+      expect(result.result).toContain('apiKey');
+      expect(result.result).not.toContain('secret-key-12345');
+      expect(result.result).not.toContain('12345');
+    });
+  });
+
+  describe('tool loop with validation and retry', () => {
+    it('returns rejected input to model for retry within tool rounds budget', async () => {
+      const toolRegistry = new ToolRegistry();
+      let callCount = 0;
+
+      toolRegistry.register(
+        {
+          name: 'search',
+          description: 'Search for things',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              query: {type: 'string'},
+            },
+            required: ['query'],
+          },
+        },
+        async () => {
+          callCount++;
+          return 'found result';
+        }
+      );
+
+      // Create a provider that makes an invalid call, then a valid one
+      const rejectedCallChunks: MessageChunk[] = [
+        {
+          type: 'tool_use',
+          toolCall: {
+            id: 'call-1',
+            name: 'search',
+            input: {}, // Missing required 'query'
+          },
+        },
+        {type: 'stop', stopReason: 'tool_use'},
+      ];
+
+      const validCallChunks: MessageChunk[] = [
+        {
+          type: 'tool_use',
+          toolCall: {
+            id: 'call-2',
+            name: 'search',
+            input: {query: 'test'},
+          },
+        },
+        {type: 'stop', stopReason: 'tool_use'},
+      ];
+
+      const finalChunks: MessageChunk[] = [
+        {type: 'text', text: 'Found results for test'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ];
+
+      let round = 0;
+      const provider = {
+        async *sendMessage() {
+          if (round === 0) {
+            round++;
+            for (const chunk of rejectedCallChunks) yield chunk;
+          } else if (round === 1) {
+            round++;
+            for (const chunk of validCallChunks) yield chunk;
+          } else {
+            for (const chunk of finalChunks) yield chunk;
+          }
+        },
+        async generateStructured<T>() {
+          return {} as T;
+        },
+      };
+
+      const promptBuilder = new PromptBuilder({identity: 'Test assistant'});
+      const orchestrator = createChatOrchestrator(provider, promptBuilder, toolRegistry);
+
+      // This should resolve without throwing, with the validation error
+      // visible to the provider on the next round
+      const result = await orchestrator.processMessage(createSession('search for something'));
+
+      expect(result).toBeDefined();
+      expect(callCount).toBe(1); // Only the valid call should execute
+    });
+  });
+});