+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolDefinition} from '../types/ai.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+describe('ChatOrchestrator tool validation acceptance tests', () => {
+  it('rejects invalid tool input and allows retry within tool round budget', async () => {
+    const registry = new ToolRegistry();
+    const toolDefinition: ToolDefinition = {
+      name: 'weather',
+      description: 'Get the weather for a location',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          location: {type: 'string'},
+        },
+        required: ['location'],
+      },
+    };
+
+    let toolExecutorCallCount = 0;
+    registry.register(toolDefinition, async input => {
+      toolExecutorCallCount++;
+      return `Weather for ${input.location as string}: 72°F and sunny`;
+    });
+
+    const callSequence: Array<{type: string; action?: string}> = [];
+
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        const roundNumber = callSequence.filter(c => c.type === 'round').length + 1;
+        callSequence.push({type: 'round'});
+
+        if (roundNumber === 1) {
+          callSequence.push({type: 'first_call_invalid'});
+          yield {
+            type: 'tool_use',
+            toolCall: {id: 'call-1', name: 'weather', input: {}},
+          };
+          yield {type: 'stop', stopReason: 'tool_use'};
+        } else if (roundNumber === 2) {
+          callSequence.push({type: 'second_call_valid'});
+          const lastToolResult = params.messages[params.messages.length - 1];
+          const toolResultContent = Array.isArray(lastToolResult.content) ? lastToolResult.content[0] : null;
+
+          if (
+            toolResultContent &&
+            typeof toolResultContent === 'object' &&
+            'content' in toolResultContent &&
+            typeof toolResultContent.content === 'string'
+          ) {
+            expect(toolResultContent.content).toContain('location');
+            callSequence.push({type: 'rejection_visible_to_provider'});
+          }
+
+          yield {
+            type: 'tool_use',
+            toolCall: {id: 'call-2', name: 'weather', input: {location: 'Seattle'}},
+          };
+          yield {type: 'stop', stopReason: 'tool_use'};
+        } else {
+          callSequence.push({type: 'final_response'});
+          yield {type: 'text', text: 'The weather in Seattle is 72°F and sunny.'};
+          yield {type: 'stop', stopReason: 'end_turn'};
+        }
+      },
+
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+
+    const result = await orchestrator.processMessage(createSession('What is the weather?'));
+
+    expect(result).toBeDefined();
+    expect(result.entries).toBeDefined();
+    expect(toolExecutorCallCount).toBe(1);
+    expect(callSequence).toContainEqual({type: 'rejection_visible_to_provider'});
+  });
+
+  it('rejects invalid input does not call executor', async () => {
+    const registry = new ToolRegistry();
+    const toolDefinition: ToolDefinition = {
+      name: 'search',
+      description: 'Search for information',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          query: {type: 'string'},
+        },
+        required: ['query'],
+      },
+    };
+
+    let executorCalled = false;
+    registry.register(toolDefinition, async () => {
+      executorCalled = true;
+      return 'result';
+    });
+
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        yield {
+          type: 'tool_use',
+          toolCall: {id: 'call-1', name: 'search', input: {query: 123}},
+        };
+        yield {type: 'stop', stopReason: 'tool_use'};
+      },
+
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+
+    const result = await orchestrator.processMessage(createSession('search for foo'));
+
+    expect(result).toBeDefined();
+    expect(executorCalled).toBe(false);
+  });
+});
