+import {ToolRegistry, type ToolResponse} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+describe('ToolRegistry input validation acceptance tests', () => {
+  describe('validates input against inputSchema before executor runs', () => {
+    it('rejects missing required field and does not invoke executor', async () => {
+      const registry = new ToolRegistry();
+      let executorCallCount = 0;
+
+      const definition: ToolDefinition = {
+        name: 'weather',
+        description: 'Get weather',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+          },
+          required: ['location'],
+        },
+      };
+
+      registry.register(definition, async () => {
+        executorCallCount++;
+        return 'result';
+      });
+
+      const result = await registry.execute('weather', {});
+
+      expect(executorCallCount).toBe(0);
+      expect(result.result).toContain('location');
+      expect(result.result).toContain('required');
+    });
+
+    it('passes valid input through to executor unchanged', async () => {
+      const registry = new ToolRegistry();
+      let receivedInput: Record<string, unknown> | undefined;
+
+      const definition: ToolDefinition = {
+        name: 'weather',
+        description: 'Get weather',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+          },
+          required: ['location'],
+        },
+      };
+
+      registry.register(definition, async input => {
+        receivedInput = input;
+        return 'result';
+      });
+
+      const validInput = {location: 'Seattle'};
+      await registry.execute('weather', validInput);
+
+      expect(receivedInput).toEqual(validInput);
+    });
+
+    it('passes extra properties through to executor unchanged', async () => {
+      const registry = new ToolRegistry();
+      let receivedInput: Record<string, unknown> | undefined;
+      let executorCallCount = 0;
+
+      const definition: ToolDefinition = {
+        name: 'weather',
+        description: 'Get weather',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+          },
+          required: ['location'],
+        },
+      };
+
+      registry.register(definition, async input => {
+        executorCallCount++;
+        receivedInput = input;
+        return 'result';
+      });
+
+      const inputWithExtra = {location: 'Seattle', extra: 'property', another: 123};
+      await registry.execute('weather', inputWithExtra);
+
+      expect(executorCallCount).toBe(1);
+      expect(receivedInput).toEqual(inputWithExtra);
+    });
+
+    it('rejects wrong-typed field with path and type, not value', async () => {
+      const registry = new ToolRegistry();
+
+      const definition: ToolDefinition = {
+        name: 'weather',
+        description: 'Get weather',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+          },
+          required: ['location'],
+        },
+      };
+
+      registry.register(definition, async () => 'result');
+
+      const result = await registry.execute('weather', {location: 42});
+
+      expect(result.result).toContain('location');
+      expect(result.result).toContain('string');
+      expect(result.result).not.toContain('42');
+    });
+
+    it('rejects enum constraint violation', async () => {
+      const registry = new ToolRegistry();
+
+      const definition: ToolDefinition = {
+        name: 'convert',
+        description: 'Convert units',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            unit: {type: 'string', enum: ['meters', 'feet', 'miles']},
+          },
+          required: ['unit'],
+        },
+      };
+
+      registry.register(definition, async () => 'result');
+
+      const result = await registry.execute('convert', {unit: 'kilometers'});
+
+      expect(result.result).toContain('unit');
+      expect(result.result).not.toContain('kilometers');
+    });
+  });
+
+  describe('schema compilation', () => {
+    it('throws at register time for uncompilable static schema', () => {
+      const registry = new ToolRegistry();
+
+      const definition: ToolDefinition = {
+        name: 'broken',
+        description: 'Broken',
+        inputSchema: {
+          type: 'object',
+          required: ['x', 'x'],
+        } as Record<string, unknown>,
+      };
+
+      expect(() => {
+        registry.register(definition, async () => 'result');
+      }).toThrow();
+    });
+
+    it('compiles static schema once', async () => {
+      const registry = new ToolRegistry();
+      let compilationCount = 0;
+
+      const definition: ToolDefinition = {
+        name: 'weather',
+        description: 'Get weather',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+          },
+          required: ['location'],
+        },
+      };
+
+      registry.register(definition, async () => 'result');
+
+      await Promise.all(Array.from({length: 10}, () => registry.execute('weather', {location: 'Seattle'})));
+
+      expect(compilationCount).toBe(0);
+    });
+
+    it('revalidates function-valued schema on each call with different results', async () => {
+      const registry = new ToolRegistry();
+      let callCount = 0;
+
+      const definitionSource = (): ToolDefinition => {
+        callCount++;
+        const schema =
+          callCount === 1
+            ? {type: 'object', properties: {location: {type: 'string'}}, required: ['location']}
+            : {type: 'object', properties: {city: {type: 'string'}}, required: ['city']};
+
+        return {
+          name: 'weather',
+          description: 'Get weather',
+          inputSchema: schema,
+        };
+      };
+
+      registry.register(definitionSource, async () => 'result');
+
+      const firstResult = await registry.execute('weather', {});
+      expect(firstResult.result).toContain('location');
+
+      const secondResult = await registry.execute('weather', {});
+      expect(secondResult.result).toContain('city');
+    });
+  });
+
+  describe('backward compatibility', () => {
+    it('still throws Unknown tool for unregistered name', async () => {
+      const registry = new ToolRegistry();
+
+      await expect(registry.execute('nonexistent', {})).rejects.toThrow('Unknown tool: nonexistent');
+    });
+  });
+
+  describe('privacy: no values in rejection messages', () => {
+    it('never exposes values in rejection messages', async () => {
+      const registry = new ToolRegistry();
+
+      const definition: ToolDefinition = {
+        name: 'auth',
+        description: 'Authenticate',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            token: {type: 'string'},
+          },
+          required: ['token'],
+        },
+      };
+
+      registry.register(definition, async () => 'result');
+
+      const sensitiveValue = 'sk_live_secret_token_123456';
+      const result = await registry.execute('auth', {token: 123});
+
+      expect(result.result).not.toContain(sensitiveValue);
+      expect(result.result).not.toContain('123');
+    });
+  });
+
+  describe('nested object validation', () => {
+    it('validates nested required properties', async () => {
+      const registry = new ToolRegistry();
+
+      const definition: ToolDefinition = {
+        name: 'search',
+        description: 'Search',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            query: {
+              type: 'object',
+              properties: {
+                text: {type: 'string'},
+              },
+              required: ['text'],
+            },
+          },
+          required: ['query'],
+        },
+      };
+
+      registry.register(definition, async () => 'result');
+
+      const result = await registry.execute('search', {query: {}});
+
+      expect(result.result).toContain('text');
+    });
+  });
+
+  describe('array validation', () => {
+    it('validates array items', async () => {
+      const registry = new ToolRegistry();
+
+      const definition: ToolDefinition = {
+        name: 'batch',
+        description: 'Batch',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            items: {
+              type: 'array',
+              items: {type: 'string'},
+            },
+          },
+          required: ['items'],
+        },
+      };
+
+      registry.register(definition, async () => 'result');
+
+      const result = await registry.execute('batch', {items: [1, 2, 3]});
+
+      expect(result.result).toBeDefined();
+    });
+  });
+});