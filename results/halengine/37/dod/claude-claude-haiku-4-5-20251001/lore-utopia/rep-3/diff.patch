+import {ToolRegistry} from './registry.js';
+import type {ToolResponse} from './registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+describe('ToolRegistry.execute input validation', () => {
+  describe('missing required fields', () => {
+    it('rejects missing required field and returns ToolResponse with error message naming the field', async () => {
+      const registry = new ToolRegistry();
+      let executorCalled = false;
+
+      registry.register(
+        {
+          name: 'weather',
+          description: 'Get weather',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              location: {type: 'string', description: 'City name'},
+            },
+            required: ['location'],
+          },
+        },
+        async () => {
+          executorCalled = true;
+          return 'ok';
+        }
+      );
+
+      const result = await registry.execute('weather', {});
+
+      expect(result.result).toContain('location');
+      expect(result.result).toContain('required');
+      expect(executorCalled).toBe(false);
+    });
+  });
+
+  describe('extra properties pass through', () => {
+    it('passes input with unlisted extra properties unchanged to executor exactly once', async () => {
+      const registry = new ToolRegistry();
+      let executorCalls = 0;
+      let receivedInput: Record<string, unknown> | null = null;
+
+      registry.register(
+        {
+          name: 'lookup',
+          description: 'Look up data',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              query: {type: 'string'},
+            },
+            required: ['query'],
+          },
+        },
+        async input => {
+          executorCalls++;
+          receivedInput = input;
+          return 'ok';
+        }
+      );
+
+      const input = {query: 'test', extra: 'property', another: 42};
+      await registry.execute('lookup', input);
+
+      expect(executorCalls).toBe(1);
+      expect(receivedInput).toEqual(input);
+    });
+  });
+
+  describe('type validation', () => {
+    it('rejects wrong-typed field with message naming field path and expected type, not the value', async () => {
+      const registry = new ToolRegistry();
+      let executorCalled = false;
+
+      registry.register(
+        {
+          name: 'greet',
+          description: 'Greet someone',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              name: {type: 'string'},
+            },
+            required: ['name'],
+          },
+        },
+        async () => {
+          executorCalled = true;
+          return 'ok';
+        }
+      );
+
+      const result = await registry.execute('greet', {name: 12345});
+
+      expect(result.result).toContain('name');
+      expect(result.result).toContain('string');
+      expect(result.result).not.toContain('12345');
+      expect(executorCalled).toBe(false);
+    });
+  });
+
+  describe('enum validation', () => {
+    it('rejects non-enum value with message naming field and allowed values', async () => {
+      const registry = new ToolRegistry();
+      let executorCalled = false;
+
+      registry.register(
+        {
+          name: 'weather',
+          description: 'Get weather',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              units: {type: 'string', enum: ['celsius', 'fahrenheit']},
+            },
+            required: ['units'],
+          },
+        },
+        async () => {
+          executorCalled = true;
+          return 'ok';
+        }
+      );
+
+      const result = await registry.execute('weather', {units: 'kelvin'});
+
+      expect(result.result).toContain('units');
+      expect(result.result).not.toContain('kelvin');
+      expect(executorCalled).toBe(false);
+    });
+  });
+
+  describe('unknown tool', () => {
+    it('still throws Unknown tool error for unregistered name unchanged', async () => {
+      const registry = new ToolRegistry();
+
+      await expect(registry.execute('nonexistent', {})).rejects.toThrow('Unknown tool: nonexistent');
+    });
+  });
+
+  describe('valid input', () => {
+    it('passes valid input to executor', async () => {
+      const registry = new ToolRegistry();
+      let receivedInput: Record<string, unknown> | null = null;
+      let receivedContext: unknown = null;
+
+      registry.register(
+        {
+          name: 'weather',
+          description: 'Get weather',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              location: {type: 'string'},
+            },
+            required: ['location'],
+          },
+        },
+        async (input, context) => {
+          receivedInput = input;
+          receivedContext = context;
+          return 'success';
+        }
+      );
+
+      const result = await registry.execute('weather', {location: 'Berlin'});
+
+      expect(result.result).toBe('success');
+      expect(receivedInput).toEqual({location: 'Berlin'});
+      expect(receivedContext).toBeUndefined();
+    });
+
+    it('passes valid input with context to executor', async () => {
+      const registry = new ToolRegistry();
+      let receivedContext: unknown = null;
+
+      registry.register(
+        {
+          name: 'weather',
+          description: 'Get weather',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              location: {type: 'string'},
+            },
+            required: ['location'],
+          },
+        },
+        async (input, context) => {
+          receivedContext = context;
+          return 'success';
+        }
+      );
+
+      const context = {userId: 'user123'};
+      await registry.execute('weather', {location: 'Berlin'}, context);
+
+      expect(receivedContext).toEqual(context);
+    });
+  });
+
+  describe('static schema compilation', () => {
+    it('compiles static tool schema once across multiple execute calls', async () => {
+      const registry = new ToolRegistry();
+      let executorCallCount = 0;
+
+      const schema = {
+        type: 'object',
+        properties: {
+          query: {type: 'string'},
+        },
+        required: ['query'],
+      };
+
+      registry.register(
+        {
+          name: 'lookup',
+          description: 'Look it up',
+          inputSchema: schema,
+        },
+        async () => {
+          executorCallCount++;
+          return 'ok';
+        }
+      );
+
+      // Execute the tool 10 times with valid input
+      for (let i = 0; i < 10; i++) {
+        await registry.execute('lookup', {query: 'test'});
+      }
+
+      // All calls should succeed, executor called 10 times
+      expect(executorCallCount).toBe(10);
+    });
+  });
+
+  describe('function-valued schema validation', () => {
+    it('validates against schema current at call time when definition source is a function', async () => {
+      const registry = new ToolRegistry();
+      let executorCalls = 0;
+
+      const schemaProvider = () => {
+        executorCalls++;
+        if (executorCalls === 1) {
+          return {
+            type: 'object',
+            properties: {
+              version: {type: 'string'},
+            },
+            required: ['version'],
+          };
+        } else {
+          return {
+            type: 'object',
+            properties: {
+              id: {type: 'number'},
+            },
+            required: ['id'],
+          };
+        }
+      };
+
+      registry.register(
+        {
+          name: 'dynamic',
+          description: 'Dynamic schema',
+          inputSchema: schemaProvider(),
+        },
+        async () => 'ok'
+      );
+
+      // First call uses schema expecting 'version'
+      const result1 = await registry.execute('dynamic', {version: 'v1'});
+      expect(result1.result).toBeDefined();
+    });
+  });
+
+  describe('identifying data privacy', () => {
+    it('does not include property values in error messages when rejecting invalid input', async () => {
+      const registry = new ToolRegistry();
+
+      registry.register(
+        {
+          name: 'secure_lookup',
+          description: 'Look up secure data',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              email: {type: 'string'},
+              ssn: {type: 'string'},
+            },
+            required: ['email', 'ssn'],
+          },
+        },
+        async () => 'ok'
+      );
+
+      // Missing required fields - message should not contain any values
+      const result = await registry.execute('secure_lookup', {
+        email: 'user@example.com',
+      });
+
+      expect(result.result).not.toContain('user@example.com');
+      expect(result.result).not.toContain('ssn');
+      expect(result.result).toContain('ssn'); // Should mention the field name but not value
+    });
+
+    it('does not include values in rejection when type is wrong', async () => {
+      const registry = new ToolRegistry();
+
+      registry.register(
+        {
+          name: 'secure_tool',
+          description: 'Secure tool',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              userId: {type: 'string'},
+            },
+            required: ['userId'],
+          },
+        },
+        async () => 'ok'
+      );
+
+      const result = await registry.execute('secure_tool', {userId: 12345});
+
+      expect(result.result).not.toContain('12345');
+      expect(result.result).toContain('userId');
+    });
+  });
+
+  describe('schema registration validation', () => {
+    it('throws at registration time for an uncompilable schema, naming the tool', () => {
+      const registry = new ToolRegistry();
+
+      const invalidSchema = {
+        type: 'object',
+        properties: {
+          field: {type: 'invalid-type-that-ajv-rejects'},
+        },
+      };
+
+      let threwError = false;
+      let errorMessage = '';
+
+      try {
+        registry.register(
+          {
+            name: 'broken_tool',
+            description: 'This has a bad schema',
+            inputSchema: invalidSchema,
+          },
+          async () => 'ok'
+        );
+      } catch (error) {
+        threwError = true;
+        errorMessage = (error as Error).message;
+      }
+
+      expect(threwError).toBe(true);
+      expect(errorMessage).toContain('broken_tool');
+    });
+  });
+});