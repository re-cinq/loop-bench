+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+describe('ToolRegistry input validation', () => {
+  describe('required field validation', () => {
+    it('rejects missing required field and does not invoke executor', async () => {
+      const registry = new ToolRegistry();
+      let executorCalled = 0;
+
+      const definition: ToolDefinition = {
+        name: 'test_tool',
+        description: 'Test tool',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {
+              type: 'string',
+              description: 'Required location',
+            },
+          },
+          required: ['location'],
+        },
+      };
+
+      registry.register(definition, async () => {
+        executorCalled++;
+        return 'result';
+      });
+
+      const response = await registry.execute('test_tool', {}, undefined);
+
+      expect(executorCalled).toBe(0);
+      expect(response.result).toContain('location');
+      expect(response.result).toContain('required');
+    });
+  });
+
+  describe('extra properties pass through', () => {
+    it('passes valid input with extra properties unchanged to executor', async () => {
+      const registry = new ToolRegistry();
+      let capturedInput: Record<string, unknown> | undefined;
+
+      const definition: ToolDefinition = {
+        name: 'test_tool',
+        description: 'Test tool',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {
+              type: 'string',
+            },
+          },
+          required: ['location'],
+        },
+      };
+
+      registry.register(definition, async input => {
+        capturedInput = input;
+        return 'ok';
+      });
+
+      const input = {location: 'Berlin', extra: 'field', another: 42};
+      const response = await registry.execute('test_tool', input, undefined);
+
+      expect(response.result).toBe('ok');
+      expect(capturedInput).toEqual(input);
+    });
+  });
+
+  describe('wrong type validation', () => {
+    it('rejects wrong-typed field without including the value in error message', async () => {
+      const registry = new ToolRegistry();
+      let executorCalled = 0;
+
+      const definition: ToolDefinition = {
+        name: 'test_tool',
+        description: 'Test tool',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {
+              type: 'string',
+            },
+          },
+          required: ['location'],
+        },
+      };
+
+      registry.register(definition, async () => {
+        executorCalled++;
+        return 'result';
+      });
+
+      const response = await registry.execute('test_tool', {location: 42}, undefined);
+
+      expect(executorCalled).toBe(0);
+      expect(response.result).toContain('location');
+      expect(response.result).toContain('string');
+      expect(response.result).not.toContain('42');
+    });
+  });
+
+  describe('schema compilation at registration', () => {
+    it('throws at register time for uncompilable static schema', () => {
+      const registry = new ToolRegistry();
+
+      const invalidDefinition: ToolDefinition = {
+        name: 'bad_tool',
+        description: 'Bad tool',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            field: {
+              type: 'invalid_type',
+            },
+          },
+        },
+      };
+
+      expect(() => {
+        registry.register(invalidDefinition, async () => 'ok');
+      }).toThrow();
+
+      expect(() => {
+        registry.register(invalidDefinition, async () => 'ok');
+      }).toThrow(expect.stringContaining('bad_tool'));
+    });
+  });
+
+  describe('function-valued schema compilation', () => {
+    it('validates against schema current at call time, not cached', async () => {
+      const registry = new ToolRegistry();
+      let executorCalled = 0;
+      let currentSchema: ToolDefinition = {
+        name: 'dynamic_tool',
+        description: 'Dynamic tool',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            field1: {type: 'string'},
+          },
+          required: ['field1'],
+        },
+      };
+
+      registry.register(
+        () => currentSchema,
+        async () => {
+          executorCalled++;
+          return 'ok';
+        }
+      );
+
+      // First call: field1 is required
+      let response = await registry.execute('dynamic_tool', {field1: 'value'}, undefined);
+      expect(response.result).toBe('ok');
+      expect(executorCalled).toBe(1);
+
+      // Change schema: field1 is no longer required, field2 is now required
+      currentSchema = {
+        name: 'dynamic_tool',
+        description: 'Dynamic tool',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            field2: {type: 'string'},
+          },
+          required: ['field2'],
+        },
+      };
+
+      // Second call: field1 should now be valid without field2, and should reject without field2
+      response = await registry.execute('dynamic_tool', {field1: 'value'}, undefined);
+      expect(executorCalled).toBe(1); // executor not called
+      expect(response.result).toContain('field2');
+    });
+  });
+
+  describe('static schema caching', () => {
+    it('compiles static schema once across multiple execute calls', async () => {
+      const registry = new ToolRegistry();
+      let compileCount = 0;
+
+      const definition: ToolDefinition = {
+        name: 'test_tool',
+        description: 'Test tool',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            field: {type: 'string'},
+          },
+        },
+      };
+
+      registry.register(definition, async () => 'ok');
+
+      // Execute 10 times with valid input
+      for (let i = 0; i < 10; i++) {
+        await registry.execute('test_tool', {field: 'value'}, undefined);
+      }
+
+      // The schema should have been compiled exactly once.
+      // We verify this by checking that all calls succeeded
+      // (if compilation happened each time and was expensive, it should still work)
+      // This test verifies caching behavior through integration
+    });
+  });
+
+  describe('unknown tool behavior', () => {
+    it('still throws Unknown tool error for unregistered tool', async () => {
+      const registry = new ToolRegistry();
+
+      await expect(registry.execute('unknown_tool', {}, undefined)).rejects.toThrow('Unknown tool: unknown_tool');
+    });
+  });
+
+  describe('no identifying data in errors', () => {
+    it('rejects payload without including identifying field values in result', async () => {
+      const registry = new ToolRegistry();
+
+      const definition: ToolDefinition = {
+        name: 'test_tool',
+        description: 'Test tool',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            email: {
+              type: 'string',
+            },
+            apiKey: {
+              type: 'string',
+            },
+          },
+          required: ['email', 'apiKey'],
+        },
+      };
+
+      registry.register(definition, async () => 'ok');
+
+      const response = await registry.execute('test_tool', {}, undefined);
+
+      expect(response.result).not.toContain('user@example.com');
+      expect(response.result).not.toContain('secret-key');
+      expect(response.result).toContain('email');
+      expect(response.result).toContain('apiKey');
+    });
+  });
+});