+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+describe('ChatOrchestrator tool input validation', () => {
+  it('handles rejected tool call with validation error and allows retry with corrected input', async () => {
+    let callCount = 0;
+    const toolCalls: Array<{input: Record<string, unknown>}> = [];
+
+    // Create a provider that calls a tool twice: first with invalid input, then with valid input
+    const validatingProvider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        callCount++;
+
+        if (callCount === 1) {
+          // First call: tool call with missing required location field
+          toolCalls.push({input: {}});
+          yield {
+            type: 'tool_use',
+            toolCall: {id: 'call-1', name: 'weather', input: {}},
+          };
+          yield {type: 'stop', stopReason: 'tool_use'};
+        } else if (callCount === 2) {
+          // Second call: provider sees rejection from validation, retries with valid input
+          // Check that the rejection is visible in the messages
+          const lastMessage = params.messages[params.messages.length - 1];
+          const content = typeof lastMessage.content === 'string' ? lastMessage.content : '';
+
+          // The rejection should be visible to the provider on the next round
+          // This verifies the validation error was communicated back
+          expect(content).toContain('location');
+
+          // Retry with correct input
+          toolCalls.push({input: {location: 'New York'}});
+          yield {
+            type: 'tool_use',
+            toolCall: {id: 'call-2', name: 'weather', input: {location: 'New York'}},
+          };
+          yield {type: 'stop', stopReason: 'tool_use'};
+        } else if (callCount === 3) {
+          // Third call: final response after successful tool execution
+          yield {type: 'text', text: 'Sunny in New York'};
+          yield {type: 'stop', stopReason: 'end_turn'};
+        }
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    // Create registry with a tool that requires location
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Get weather',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string', description: 'Location to get weather for'},
+          },
+          required: ['location'],
+        },
+      },
+      async input => `Weather for ${input.location as string}`
+    );
+
+    const promptBuilder = new PromptBuilder({identity: 'You are a helpful assistant.'});
+    const orchestrator = createChatOrchestrator(validatingProvider, promptBuilder, registry, {
+      maxToolRounds: 5,
+    });
+
+    // processMessage should resolve, not reject
+    const result = await orchestrator.processMessage(createSession('What is the weather?'));
+
+    // Verify the result contains the final response
+    expect(result).toContain('Sunny in New York');
+
+    // Verify the tool was called twice: once with invalid input (rejected), once with valid input
+    expect(callCount).toBe(3); // First tool call, second tool call, final response
+    expect(toolCalls).toHaveLength(2);
+    expect(toolCalls[0].input).toEqual({});
+    expect(toolCalls[1].input).toEqual({location: 'New York'});
+  });
+});
