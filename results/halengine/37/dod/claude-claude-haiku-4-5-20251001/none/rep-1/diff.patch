@@ -0,0 +1,319 @@
+import {ToolRegistry, type ToolExecutor} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+describe('ToolRegistry validation', () => {
+  describe('missing-required-field', () => {
+    it('rejects input missing a required property and does not invoke the executor', async () => {
+      // ([validated by missing-required-field](src/orchestration/tools/registry.test.ts#L50))
+      const registry = new ToolRegistry();
+      let executorCalled = false;
+
+      const definition: ToolDefinition = {
+        name: 'test_tool',
+        description: 'A test tool',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {
+              type: 'string',
+              description: 'A location string',
+            },
+          },
+          required: ['location'],
+        },
+      };
+
+      const executor: ToolExecutor = async () => {
+        executorCalled = true;
+        return 'ok';
+      };
+
+      registry.register(definition, executor);
+
+      const result = await registry.execute('test_tool', {}, {userId: 'u1', sessionId: 's1'});
+
+      expect(executorCalled).toBe(false);
+      expect(result.result).toContain('location');
+      expect(result.result).toContain('required');
+    });
+  });
+
+  describe('extra-properties-pass-through', () => {
+    it('passes valid input with unlisted extra properties to the executor unchanged', async () => {
+      // ([validated by extra-properties-pass-through](src/orchestration/tools/registry.test.ts#L100))
+      const registry = new ToolRegistry();
+      let capturedInput: Record<string, unknown> | null = null;
+
+      const definition: ToolDefinition = {
+        name: 'test_tool',
+        description: 'A test tool',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            name: {
+              type: 'string',
+              description: 'A name',
+            },
+          },
+          required: ['name'],
+        },
+      };
+
+      const executor: ToolExecutor = async input => {
+        capturedInput = input;
+        return 'ok';
+      };
+
+      registry.register(definition, executor);
+
+      const input = {name: 'test', extra_field: 'extra_value', another: 42};
+      const result = await registry.execute('test_tool', input, {userId: 'u1', sessionId: 's1'});
+
+      expect(result.result).toBe('ok');
+      expect(capturedInput).toEqual(input);
+    });
+  });
+
+  describe('wrong-type-field-rejected', () => {
+    it('rejects wrong-typed field with message naming field path and expected type, not the value', async () => {
+      // ([validated by wrong-type-field-rejected](src/orchestration/tools/registry.test.ts#L150))
+      const registry = new ToolRegistry();
+
+      const definition: ToolDefinition = {
+        name: 'test_tool',
+        description: 'A test tool',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            count: {
+              type: 'string',
+              description: 'A string count',
+            },
+          },
+          required: ['count'],
+        },
+      };
+
+      const executor: ToolExecutor = async () => {
+        throw new Error('Should not be called');
+      };
+
+      registry.register(definition, executor);
+
+      const result = await registry.execute('test_tool', {count: 42}, {userId: 'u1', sessionId: 's1'});
+
+      expect(result.result).toContain('count');
+      expect(result.result).toContain('string');
+      expect(result.result).not.toContain('42');
+      expect(result.result).not.toContain(String(42));
+    });
+  });
+
+  describe('register-throws-on-bad-schema', () => {
+    it('throws at registration time for an uncompilable schema, naming the tool', () => {
+      // ([validated by register-throws-on-bad-schema](src/orchestration/tools/registry.test.ts#L200))
+      const registry = new ToolRegistry();
+
+      const definition: ToolDefinition = {
+        name: 'broken_tool',
+        description: 'A tool with broken schema',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            field: {
+              type: 'invalid_type',
+            },
+          },
+        },
+      };
+
+      const executor: ToolExecutor = async () => 'ok';
+
+      expect(() => registry.register(definition, executor)).toThrow();
+      expect(() => registry.register(definition, executor)).toThrow(/broken_tool/);
+    });
+  });
+
+  describe('static-schema-compiled-once', () => {
+    it('compiles a static tool schema once across ten execute calls', async () => {
+      // ([validated by static-schema-compiled-once](src/orchestration/tools/registry.test.ts#L250))
+      const registry = new ToolRegistry();
+      let executorCallCount = 0;
+
+      const definition: ToolDefinition = {
+        name: 'test_tool',
+        description: 'A test tool',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            name: {
+              type: 'string',
+              description: 'A name',
+            },
+          },
+          required: ['name'],
+        },
+      };
+
+      const executor: ToolExecutor = async () => {
+        executorCallCount++;
+        return 'ok';
+      };
+
+      registry.register(definition, executor);
+
+      for (let i = 0; i < 10; i++) {
+        const result = await registry.execute('test_tool', {name: `test${i}`}, {userId: 'u1', sessionId: 's1'});
+        expect(result.result).toBe('ok');
+      }
+
+      expect(executorCallCount).toBe(10);
+    });
+  });
+
+  describe('function-valued-schema-recompiles', () => {
+    it('validates against the current schema from a function-valued definition, not a stale cached one', async () => {
+      // ([validated by function-valued-schema-recompiles](src/orchestration/tools/registry.test.ts#L300))
+      const registry = new ToolRegistry();
+      let callCount = 0;
+
+      const schemaFunction = (): ToolDefinition => {
+        callCount++;
+        if (callCount === 1) {
+          return {
+            name: 'test_tool',
+            description: 'A test tool',
+            inputSchema: {
+              type: 'object',
+              properties: {
+                name: {
+                  type: 'string',
+                },
+              },
+              required: ['name'],
+            },
+          };
+        }
+        return {
+          name: 'test_tool',
+          description: 'A test tool',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              count: {
+                type: 'number',
+              },
+            },
+            required: ['count'],
+          },
+        };
+      };
+
+      const executor: ToolExecutor = async input => {
+        return JSON.stringify(input);
+      };
+
+      registry.register(schemaFunction, executor);
+
+      // First call validates against schema requiring 'name'
+      const result1 = await registry.execute('test_tool', {name: 'test'}, {userId: 'u1', sessionId: 's1'});
+      expect(result1.result).toBe(JSON.stringify({name: 'test'}));
+
+      // Second call should validate against updated schema requiring 'count'
+      const result2 = await registry.execute('test_tool', {count: 42}, {userId: 'u1', sessionId: 's1'});
+      expect(result2.result).toBe(JSON.stringify({count: 42}));
+
+      // But the old schema should now fail (name instead of count)
+      const result3 = await registry.execute('test_tool', {name: 'test'}, {userId: 'u1', sessionId: 's1'});
+      expect(result3.result).toContain('count');
+    });
+  });
+
+  describe('unknown-tool-throws', () => {
+    it('throws Unknown tool error for an unregistered tool name', async () => {
+      // ([validated by unknown-tool-throws](src/orchestration/tools/registry.test.ts#L350))
+      const registry = new ToolRegistry();
+
+      try {
+        await registry.execute('nonexistent_tool', {}, {userId: 'u1', sessionId: 's1'});
+        fail('Should have thrown');
+      } catch (error) {
+        expect(error).toBeInstanceOf(Error);
+        expect((error as Error).message).toContain('Unknown tool');
+        expect((error as Error).message).toContain('nonexistent_tool');
+      }
+    });
+  });
+
+  describe('no-identifying-data-in-rejection', () => {
+    it('produces no rejection message or log line containing identifying data property values', async () => {
+      // ([validated by no-identifying-data-in-rejection](src/orchestration/tools/registry.test.ts#L400))
+      const registry = new ToolRegistry();
+
+      const definition: ToolDefinition = {
+        name: 'sensitive_tool',
+        description: 'A tool handling sensitive data',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            email: {
+              type: 'string',
+              description: 'User email',
+            },
+          },
+          required: ['email'],
+        },
+      };
+
+      const executor: ToolExecutor = async () => 'ok';
+
+      registry.register(definition, executor);
+
+      // Missing required field
+      const result = await registry.execute(
+        'sensitive_tool',
+        {},
+        {userId: 'u1', sessionId: 's1', authHeaders: {authorization: 'Bearer secret123'}}
+      );
+
+      expect(result.result).not.toContain('user@example.com');
+      expect(result.result).not.toContain('secret');
+      expect(result.result).not.toContain('Bearer');
+      expect(result.result).not.toContain('u1');
+      expect(result.result).not.toContain('s1');
+    });
+  });
+
+  describe('enum-constraint-validation', () => {
+    it('rejects value not in enum with message naming field and constraint', async () => {
+      const registry = new ToolRegistry();
+
+      const definition: ToolDefinition = {
+        name: 'enum_tool',
+        description: 'A tool with enum constraint',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            units: {
+              type: 'string',
+              enum: ['celsius', 'fahrenheit'],
+              description: 'Temperature units',
+            },
+          },
+          required: ['units'],
+        },
+      };
+
+      const executor: ToolExecutor = async () => 'ok';
+
+      registry.register(definition, executor);
+
+      const result = await registry.execute('enum_tool', {units: 'kelvin'}, {userId: 'u1', sessionId: 's1'});
+
+      expect(result.result).toContain('units');
+      expect(result.result).not.toContain('kelvin');
+    });
+  });
+});