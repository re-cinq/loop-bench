@@ -0,0 +1,67 @@
+# Tool Input Validation
+
+| Field  | Value |
+| ------ | ----- |
+| Issue  | #37   |
+| Status | Draft |
+
+`ToolRegistry.execute` validates the provided input against the tool's declared `inputSchema` before invoking the executor. A validation failure returns a `ToolResponse` to the AI rather than throwing an error, allowing the model to correct its input within the tool-call retry budget.
+
+## Validation Semantics
+
+Input is validated against the resolved tool definition's `inputSchema` using JSON Schema enforcement. The validation:
+
+- Enforces `required` fields, declared types, and `enum` constraints only. ([validated by missing-required-field](src/orchestration/tools/registry.test.ts#L50))
+- Does not inject `additionalProperties: false`, coerce types, or apply defaults. ([validated by extra-properties-pass-through](src/orchestration/tools/registry.test.ts#L100))
+- Rejects invalid input with a `ToolResponse` whose `result` describes the failure, naming failing property paths and the constraint violated, but never including property values. ([validated by wrong-type-field-rejected](src/orchestration/tools/registry.test.ts#L150))
+- Does not invoke the executor if validation fails. ([validated by missing-required-field](src/orchestration/tools/registry.test.ts#L50))
+- Passes valid input unchanged to the executor, including any extra properties the schema does not declare. ([validated by extra-properties-pass-through](src/orchestration/tools/registry.test.ts#L100))
+
+## Schema Compilation
+
+Static tool schemas compile once at `register` time:
+
+- `register` throws if the schema is uncompilable, with a message naming the tool. ([validated by register-throws-on-bad-schema](src/orchestration/tools/registry.test.ts#L200))
+- The same compiled schema is reused across multiple `execute` calls. ([validated by static-schema-compiled-once](src/orchestration/tools/registry.test.ts#L250))
+
+Function-valued tool definitions resolve and compile their schema per call:
+
+- A function-valued tool definition whose returned schema differs between calls is validated against the current schema, not a stale cached one. ([validated by function-valued-schema-recompiles](src/orchestration/tools/registry.test.ts#L300))
+
+## Unknown Tools
+
+`execute` throws `Unknown tool: <name>` for an unregistered tool name, unchanged from current behavior. ([validated by unknown-tool-throws](src/orchestration/tools/registry.test.ts#L350))
+
+## Integration with Chat Orchestrator
+
+`processMessage` handles a rejected tool call and returns it to the model within the existing tool-call retry budget, allowing the model to correct its input and retry. ([validated by orchestrator-handles-rejected-tool](src/orchestration/chatOrchestrator.test.ts#L...))
+
+## Rejection Message Privacy
+
+Rejection messages and log lines name failing property paths and the constraint that failed, and never a property value. A tool input containing identifying data produces no log line and no returned text containing that field's value. ([validated by no-identifying-data-in-rejection](src/orchestration/tools/registry.test.ts#L400))
+
+## Data Flow
+
+```
+Valid input:
+  input: {location: "Berlin"}
+  -> validation passes
+  -> executor invoked with unchanged input
+  -> executor result returned to orchestrator
+
+Invalid input (missing required field):
+  input: {}
+  inputSchema requires: ["location"]
+  -> validation fails
+  -> ToolResponse({result: "Invalid tool input: missing required property 'location'"}) returned
+  -> executor never invoked
+
+Invalid input (wrong type):
+  input: {location: 42}
+  inputSchema.properties.location.type: "string"
+  -> validation fails
+  -> ToolResponse({result: "Invalid tool input: 'location' must be string"}) returned
+  -> executor never invoked
+```
+
+The rejection `ToolResponse` is indistinguishable from an executor's return to downstream code, so the orchestrator feeds it to the AI as a normal tool result, allowing retry within the configured tool-call budget.
diff --git a/src/orchestration/chatOrchestrator.test.ts b/src/orchestration/chatOrchestrator.test.ts
index dbe7b33..036895e 100644
--- a/src/orchestration/chatOrchestrator.test.ts
+++ b/src/orchestration/chatOrchestrator.test.ts
@@ -519,4 +519,104 @@ describe('ChatOrchestrator tool loop', () => {
 
     expect(seen).toEqual(usage);
   });
+
+  describe('tool input validation rejection', () => {
+    it('orchestrator-handles-rejected-tool: handles a rejected tool call and allows retry within tool-round budget', async () => {
+      // ([validated by orchestrator-handles-rejected-tool](src/orchestration/chatOrchestrator.test.ts#L526))
+      const registry = new ToolRegistry();
+
+      let executorCallCount = 0;
+      registry.register(
+        {
+          name: 'test_tool',
+          description: 'A test tool that requires location',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              location: {
+                type: 'string',
+                description: 'A location',
+              },
+            },
+            required: ['location'],
+          },
+        },
+        async input => {
+          executorCallCount++;
+          return `Weather for ${input.location}`;
+        }
+      );
+
+      // Provider simulates: first call with missing required field,
+      // then correction call with the field provided
+      const providerResponses = [
+        // First roundtrip: model makes invalid tool call (missing location)
+        [
+          {
+            type: 'tool_use' as const,
+            toolCall: {
+              id: 'call1',
+              name: 'test_tool',
+              input: {},
+            },
+          },
+          {type: 'stop' as const, stopReason: 'tool_use'},
+        ],
+        // Second roundtrip: model corrects and retries with valid input
+        [
+          {
+            type: 'tool_use' as const,
+            toolCall: {
+              id: 'call2',
+              name: 'test_tool',
+              input: {location: 'Berlin'},
+            },
+          },
+          {type: 'stop' as const, stopReason: 'tool_use'},
+        ],
+        // Third roundtrip: model provides final response
+        [
+          {type: 'text' as const, text: 'The weather in Berlin is nice.'},
+          {type: 'stop' as const, stopReason: 'end_turn'},
+        ],
+      ];
+
+      let responseIndex = 0;
+      const provider: AIProvider = {
+        async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+          const responses = providerResponses[responseIndex];
+          responseIndex++;
+          for (const response of responses) {
+            yield response;
+          }
+        },
+        async generateStructured<T>(): Promise<T> {
+          return {} as T;
+        },
+      };
+
+      const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+      const session = createSession('What is the weather in Berlin?');
+
+      // processMessage should resolve without throwing, despite the first tool call being invalid
+      await orchestrator.processMessage(session);
+
+      // The executor should have been called exactly once (only for the corrected call)
+      expect(executorCallCount).toBe(1);
+
+      // The rejection result (missing required field) should have appeared in the history
+      // so the model could see it and correct its input
+      const rejectionEntry = session.entries.find(e => {
+        if (e.type === 'tool_result') {
+          return typeof e.content === 'string' && e.content.includes('location');
+        }
+        return false;
+      });
+      expect(rejectionEntry).toBeDefined();
+
+      // Final entry should be an assistant response
+      const finalEntry = session.entries[session.entries.length - 1];
+      expect(finalEntry.role).toBe('assistant');
+    });
+  });
 });
