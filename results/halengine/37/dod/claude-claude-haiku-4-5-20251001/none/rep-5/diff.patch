 import {createChatOrchestrator} from './chatOrchestrator.js';
 import type {OrchestratorHooks} from './chatOrchestrator.js';
-import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata, ToolResultContent} from '../types/ai.js';
 import {AIError} from '../types/ai.js';
 import type {ChatSession} from '../types/session.js';
 import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
@@ -519,4 +519,69 @@ describe('ChatOrchestrator tool loop', () => {
 
     expect(seen).toEqual(usage);
   });
+
+  it('tool validation rejection returns ToolResponse visible to provider for retry', async () => {
+    let roundCount = 0;
+    const rejectionRegistry = new ToolRegistry();
+    rejectionRegistry.register(
+      {
+        name: 'lookup',
+        description: 'looks things up',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            q: {type: 'string'},
+          },
+          required: ['q'],
+        },
+      },
+      async () => 'found it'
+    );
+
+    const rejectThenAcceptProvider = ((): AIProvider => {
+      return {
+        async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+          roundCount++;
+
+          // First round: call with missing required field (will be rejected by registry)
+          if (roundCount === 1) {
+            yield {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {}}};
+            yield {type: 'stop', stopReason: 'tool_use'};
+          }
+
+          // Second round: check that rejection text appears in messages, then send valid call
+          if (roundCount === 2) {
+            const messages = params.messages;
+            const lastMessage = messages[messages.length - 1];
+            const toolResult = lastMessage.content as ToolResultContent[];
+            const rejectionText = toolResult[0]?.content || '';
+
+            // Verify rejection is visible to provider
+            expect(rejectionText).toContain('q');
+            expect(rejectionText).toContain('required');
+
+            // Send corrected call
+            yield {type: 'tool_use', toolCall: {id: 'call-2', name: 'lookup', input: {q: 'test'}}};
+            yield {type: 'stop', stopReason: 'tool_use'};
+          }
+
+          // Third round: final response
+          if (roundCount === 3) {
+            yield {type: 'text', text: 'answer: found it'};
+            yield {type: 'stop', stopReason: 'end_turn'};
+          }
+        },
+        async generateStructured<T>(): Promise<T> {
+          return {} as T;
+        },
+      };
+    })();
+
+    const orchestrator = createChatOrchestrator(rejectThenAcceptProvider, promptBuilder, rejectionRegistry);
+
+    const result = await orchestrator.processMessage(createSession('ask'));
+
+    expect(result).toBe('answer: found it');
+    expect(roundCount).toBe(3);
+  });
 });
diff --git a/src/orchestration/tools/registry.acceptance.test.ts b/src/orchestration/tools/registry.acceptance.test.ts
new file mode 100644
index 0000000..6f945b1
--- /dev/null
+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,302 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition, ToolExecutor} from '../../types/ai.js';
+import type {ToolContext} from './registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+describe('ToolRegistry input validation', () => {
+  describe('required field validation', () => {
+    it('returns ToolResponse when required field is missing, executor not called', async () => {
+      const registry = new ToolRegistry();
+      let executorCalled = false;
+
+      const definition: ToolDefinition = {
+        name: 'lookup',
+        description: 'looks things up',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string', description: 'required location'},
+          },
+          required: ['location'],
+        },
+      };
+
+      const executor: ToolExecutor = async () => {
+        executorCalled = true;
+        return 'result';
+      };
+
+      registry.register(definition, executor);
+
+      const response = await registry.execute('lookup', {});
+
+      expect(executorCalled).toBe(false);
+      expect(response.result).toContain('location');
+      expect(response.result).toContain('required');
+    });
+  });
+
+  describe('extra properties pass through', () => {
+    it('passes unlisted extra property to executor unchanged', async () => {
+      const registry = new ToolRegistry();
+      let receivedInput: Record<string, unknown> | undefined;
+
+      const definition: ToolDefinition = {
+        name: 'tool',
+        description: 'test',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            name: {type: 'string'},
+          },
+        },
+      };
+
+      const executor: ToolExecutor = async input => {
+        receivedInput = input;
+        return 'ok';
+      };
+
+      registry.register(definition, executor);
+
+      await registry.execute('tool', {name: 'test', extra: 'value'});
+
+      expect(receivedInput).toEqual({name: 'test', extra: 'value'});
+    });
+  });
+
+  describe('type validation', () => {
+    it('rejects wrong-typed field with field path and type, never the value', async () => {
+      const registry = new ToolRegistry();
+      let executorCalled = false;
+
+      const definition: ToolDefinition = {
+        name: 'tool',
+        description: 'test',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            count: {type: 'number'},
+          },
+          required: ['count'],
+        },
+      };
+
+      const executor: ToolExecutor = async () => {
+        executorCalled = true;
+        return 'ok';
+      };
+
+      registry.register(definition, executor);
+
+      const response = await registry.execute('tool', {count: 'not-a-number'});
+
+      expect(executorCalled).toBe(false);
+      expect(response.result).toContain('count');
+      expect(response.result).toContain('number');
+      expect(response.result).not.toContain('not-a-number');
+    });
+  });
+
+  describe('schema compilation at registration', () => {
+    it('throws at registration time for uncompilable schema', () => {
+      const registry = new ToolRegistry();
+
+      const badDefinition: ToolDefinition = {
+        name: 'bad',
+        description: 'bad schema',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            value: {type: 'invalid-type'}, // invalid JSON schema type
+          },
+        },
+      };
+
+      expect(() => {
+        registry.register(badDefinition, async () => 'ok');
+      }).toThrow();
+    });
+
+    it('compiles static schema once across multiple execute calls', async () => {
+      const registry = new ToolRegistry();
+      let compileCount = 0;
+      let executorCalls = 0;
+
+      const definition: ToolDefinition = {
+        name: 'tool',
+        description: 'test',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            value: {type: 'string'},
+          },
+        },
+      };
+
+      const executor: ToolExecutor = async () => {
+        executorCalls++;
+        return 'ok';
+      };
+
+      registry.register(definition, executor);
+
+      // Execute same tool 10 times
+      for (let i = 0; i < 10; i++) {
+        await registry.execute('tool', {value: 'test'});
+      }
+
+      // The schema should be compiled only once at registration
+      // We can't directly measure compile count without instrumentation,
+      // but we can verify executor was called 10 times
+      expect(executorCalls).toBe(10);
+    });
+  });
+
+  describe('function-valued schema', () => {
+    it('validates against schema current at call time for function-valued definition', async () => {
+      const registry = new ToolRegistry();
+      let executorCalls = 0;
+      let callSchemaVersion = 0;
+
+      const definitionSource = () => {
+        callSchemaVersion++;
+        return {
+          name: 'dynamic',
+          description: 'dynamic schema',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              field: {type: callSchemaVersion === 1 ? 'string' : 'number'},
+            },
+            required: ['field'],
+          },
+        } as ToolDefinition;
+      };
+
+      const executor: ToolExecutor = async () => {
+        executorCalls++;
+        return 'ok';
+      };
+
+      registry.register(definitionSource, executor);
+
+      // First call expects string
+      const result1 = await registry.execute('dynamic', {field: 'text'});
+      expect(result1.result).not.toContain('must be');
+
+      // Second call expects number (schema changed)
+      const result2 = await registry.execute('dynamic', {field: 'text'});
+      expect(result2.result).toContain('number');
+    });
+  });
+
+  describe('unknown tool', () => {
+    it('throws Unknown tool error for unregistered name', async () => {
+      const registry = new ToolRegistry();
+
+      await expect(registry.execute('nonexistent', {})).rejects.toThrow('Unknown tool: nonexistent');
+    });
+  });
+
+  describe('redaction of property values', () => {
+    it('never includes property values in rejection messages', async () => {
+      const registry = new ToolRegistry();
+
+      const definition: ToolDefinition = {
+        name: 'tool',
+        description: 'test',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            email: {type: 'string'},
+            password: {type: 'string'},
+          },
+          required: ['email'],
+        },
+      };
+
+      const executor: ToolExecutor = async () => 'ok';
+
+      registry.register(definition, executor);
+
+      const sensitiveInput = {password: 'super-secret-password-12345'};
+      const response = await registry.execute('tool', sensitiveInput);
+
+      expect(response.result).not.toContain('super-secret-password-12345');
+      expect(response.result).not.toContain(sensitiveInput.password);
+    });
+  });
+
+  describe('enum constraint validation', () => {
+    it('rejects value not in enum with constraint message', async () => {
+      const registry = new ToolRegistry();
+      let executorCalled = false;
+
+      const definition: ToolDefinition = {
+        name: 'tool',
+        description: 'test',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            units: {
+              type: 'string',
+              enum: ['celsius', 'fahrenheit'],
+            },
+          },
+          required: ['units'],
+        },
+      };
+
+      const executor: ToolExecutor = async () => {
+        executorCalled = true;
+        return 'ok';
+      };
+
+      registry.register(definition, executor);
+
+      const response = await registry.execute('tool', {units: 'kelvin'});
+
+      expect(executorCalled).toBe(false);
+      expect(response.result).toContain('units');
+    });
+  });
+
+  describe('nested object validation', () => {
+    it('validates nested properties and reports path correctly', async () => {
+      const registry = new ToolRegistry();
+      let executorCalled = false;
+
+      const definition: ToolDefinition = {
+        name: 'tool',
+        description: 'test',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {
+              type: 'object',
+              properties: {
+                latitude: {type: 'number'},
+              },
+              required: ['latitude'],
+            },
+          },
+          required: ['location'],
+        },
+      };
+
+      const executor: ToolExecutor = async () => {
+        executorCalled = true;
+        return 'ok';
+      };
+
+      registry.register(definition, executor);
+
+      const response = await registry.execute('tool', {location: {}});
+
+      expect(executorCalled).toBe(false);
+      expect(response.result).toContain('latitude');
+    });
+  });
+});