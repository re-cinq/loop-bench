+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+it('returns a schema rejection to the provider so a corrected tool call can finish the conversation', async () => {
+  const registry = new ToolRegistry();
+  const received: Record<string, unknown>[] = [];
+  registry.register(
+    {
+      name: 'weather',
+      description: 'Forecast for a location',
+      inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+    },
+    async input => {
+      received.push(input);
+      return 'Sunny in Berlin';
+    }
+  );
+
+  let round = 0;
+  let rejection = '';
+  const provider: AIProvider = {
+    async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      round++;
+      if (round === 1) {
+        yield {type: 'tool_use', toolCall: {id: 'bad', name: 'weather', input: {}}};
+        yield {type: 'stop', stopReason: 'tool_use'};
+      } else if (round === 2) {
+        const last = params.messages[params.messages.length - 1];
+        if (last.role === 'user' && typeof last.content !== 'string') rejection = last.content[0]?.content ?? '';
+        yield {type: 'tool_use', toolCall: {id: 'good', name: 'weather', input: {location: 'Berlin'}}};
+        yield {type: 'stop', stopReason: 'tool_use'};
+      } else {
+        yield {type: 'text', text: 'It is sunny in Berlin.'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      }
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured output is not used by this conversation');
+    },
+  };
+  const session: ChatSession = {
+    sessionId: 'validation-test',
+    userId: 'user',
+    entries: [{role: 'user', content: 'What is the weather?', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+
+  const response = await createChatOrchestrator(
+    provider,
+    new PromptBuilder({identity: 'Weather assistant'}),
+    registry
+  ).processMessage(session);
+
+  expect(response).toBe('It is sunny in Berlin.');
+  expect(rejection).toMatch(/location.*required|required.*location/i);
+  expect(received).toEqual([{location: 'Berlin'}]);
+  expect(round).toBe(3);
+});
diff --git a/src/orchestration/tools/registry.acceptance.test.ts b/src/orchestration/tools/registry.acceptance.test.ts
