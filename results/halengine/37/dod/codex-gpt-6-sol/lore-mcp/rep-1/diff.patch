--- /dev/null
+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,104 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+import {setLogger} from '../../shared/logger.js';
+
+const weatherDefinition: ToolDefinition = {
+  name: 'weather',
+  description: 'Forecast for a location',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}, unit: {enum: ['C', 'F']}},
+    required: ['location'],
+  },
+};
+
+describe('ToolRegistry input validation', () => {
+  it('rejects missing, wrong-typed and disallowed input before execution without revealing values', async () => {
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+    const logs: string[] = [];
+    const record = (category: string, message: string, fields?: Record<string, unknown>): void => {
+      logs.push(JSON.stringify({category, message, fields}));
+    };
+    setLogger({debug: record, info: record, warn: record, error: record});
+    registry.register(weatherDefinition, async input => {
+      received.push(input);
+      return 'forecast';
+    });
+
+    try {
+      await expect(registry.execute('missing-weather', {})).rejects.toThrow('Unknown tool: missing-weather');
+      const missing = await registry.execute('weather', {});
+      const wrongType = await registry.execute('weather', {location: 314159});
+      const secret = 'private-location-97531';
+      const disallowed = await registry.execute('weather', {location: secret, unit: 'kelvin'});
+
+      expect(missing.result).toMatch(/location.*required|required.*location/i);
+      expect(wrongType.result).toMatch(/location.*string|string.*location/i);
+      expect(wrongType.result).not.toContain('314159');
+      expect(disallowed.result).toMatch(/unit.*(enum|allowed|one of)|(enum|allowed|one of).*unit/i);
+      expect(disallowed.result).not.toContain(secret);
+      expect(logs.join('\n')).not.toContain(secret);
+      expect(received).toEqual([]);
+    } finally {
+      setLogger();
+    }
+  });
+
+  it('passes schema-valid input with unlisted properties through unchanged exactly once', async () => {
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+    registry.register(weatherDefinition, async input => {
+      received.push(input);
+      return 'forecast';
+    });
+
+    await registry.execute('weather', {location: 42, extra: 'unlisted'});
+    const valid = {location: 'Berlin', extra: 'unlisted'};
+    const response = await registry.execute('weather', valid);
+
+    expect(response).toEqual({result: 'forecast'});
+    expect(received).toEqual([valid]);
+  });
+
+  it('rejects an invalid static schema at registration and keeps a compiled static schema for later calls', async () => {
+    const registry = new ToolRegistry();
+    expect(() =>
+      registry.register(
+        {name: 'broken-weather', description: 'Broken schema', inputSchema: {type: 'not-a-json-schema-type'}},
+        async () => 'never'
+      )
+    ).toThrow(/broken-weather/);
+
+    const schema = {type: 'object', properties: {location: {type: 'string'}}, required: ['location']};
+    registry.register({name: 'stable-weather', description: 'Stable schema', inputSchema: schema}, async () => 'ok');
+    schema.required.push('newly-added');
+    const responses = await Promise.all(
+      Array.from({length: 10}, () => registry.execute('stable-weather', {location: 'Berlin'}))
+    );
+    expect(responses).toEqual(Array.from({length: 10}, () => ({result: 'ok'})));
+  });
+
+  it('validates each call against the current function-valued definition', async () => {
+    const registry = new ToolRegistry();
+    let currentField = 'location';
+    const received: Record<string, unknown>[] = [];
+    registry.register(
+      () => ({
+        name: 'changing-weather',
+        description: 'Changing schema',
+        inputSchema: {type: 'object', properties: {[currentField]: {type: 'string'}}, required: [currentField]},
+      }),
+      async input => {
+        received.push(input);
+        return 'ok';
+      }
+    );
+
+    expect(await registry.execute('changing-weather', {location: 'Berlin'})).toEqual({result: 'ok'});
+    currentField = 'city';
+    const rejection = await registry.execute('changing-weather', {location: 'Berlin'});
+    expect(rejection.result).toMatch(/city.*required|required.*city/i);
+    expect(received).toEqual([{location: 'Berlin'}]);
+  });
+});