+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+it('returns validation feedback to the provider for a corrected retry', async () => {
+  const registry = new ToolRegistry();
+  const received: Record<string, unknown>[] = [];
+  const feedback: string[] = [];
+  registry.register(
+    {
+      name: 'weather',
+      description: 'Reports weather',
+      inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+    },
+    async input => {
+      received.push(input);
+      return 'Sunny in Berlin';
+    }
+  );
+
+  let round = 0;
+  const provider: AIProvider = {
+    async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      round += 1;
+      if (round === 1) {
+        yield {type: 'tool_use', toolCall: {id: 'missing', name: 'weather', input: {}}};
+        yield {type: 'stop', stopReason: 'tool_use'};
+      } else if (round === 2) {
+        const result = params.messages.findLast(message => message.role === 'user' && Array.isArray(message.content));
+        if (result && Array.isArray(result.content)) feedback.push(result.content[0].content);
+        yield {type: 'tool_use', toolCall: {id: 'corrected', name: 'weather', input: {location: 'Berlin'}}};
+        yield {type: 'stop', stopReason: 'tool_use'};
+      } else {
+        yield {type: 'text', text: 'Sunny in Berlin'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      }
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured output is not used by this conversation');
+    },
+  };
+  const session: ChatSession = {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'Weather?', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Assistant'}), registry);
+
+  const response = await orchestrator.processMessage(session);
+  expect({response, feedback, received, round}).toEqual({
+    response: 'Sunny in Berlin',
+    feedback: [expect.stringMatching(/location.*required|required.*location/i)],
+    received: [{location: 'Berlin'}],
+    round: 3,
+  });
+});
diff --git a/src/orchestration/tools/registry.acceptance.test.ts b/src/orchestration/tools/registry.acceptance.test.ts
