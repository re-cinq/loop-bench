index 0000000..db8fb96
--- /dev/null
+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,105 @@
+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+
+const definition = {
+  name: 'weather',
+  description: 'Reports weather',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}, units: {type: 'string', enum: ['celsius', 'fahrenheit']}},
+    required: ['location'],
+  },
+};
+
+it('rejects malformed input without executing or exposing values', async () => {
+  const registry = new ToolRegistry();
+  const received: Record<string, unknown>[] = [];
+  const lines: string[] = [];
+  const record = (category: string, message: string, fields?: Record<string, unknown>): void => {
+    lines.push(JSON.stringify({category, message, fields}));
+  };
+  const logger: Logger = {debug: record, info: record, warn: record, error: record};
+  registry.register(definition, async input => {
+    received.push(input);
+    return 'forecast';
+  });
+
+  setLogger(logger);
+  try {
+    const missing = await registry.execute('weather', {});
+    const wrongType = await registry.execute('weather', {location: 42, identity: 'private-person-123'});
+    const wrongEnum = await registry.execute('weather', {location: 'Berlin', units: 'kelvin'});
+    expect({missing, wrongType, wrongEnum, received}).toEqual({
+      missing: {result: expect.stringMatching(/location.*required|required.*location/i)},
+      wrongType: {result: expect.stringMatching(/location.*string|string.*location/i)},
+      wrongEnum: {result: expect.stringMatching(/units.*(enum|allowed)|(enum|allowed).*units/i)},
+      received: [],
+    });
+    expect(JSON.stringify({missing, wrongType, wrongEnum, lines})).not.toContain('private-person-123');
+    expect(wrongType.result).not.toContain('42');
+    await expect(registry.execute('unregistered', {})).rejects.toThrow('Unknown tool: unregistered');
+  } finally {
+    setLogger();
+  }
+});
+
+it('passes valid input unchanged after validating against the registered schema', async () => {
+  const registry = new ToolRegistry();
+  const received: Record<string, unknown>[] = [];
+  let schemaReads = 0;
+  const schema = {
+    get type(): string {
+      schemaReads += 1;
+      return 'object';
+    },
+    properties: {location: {type: 'string'}, units: {type: 'string', default: 'celsius'}},
+    required: ['location'],
+  };
+  registry.register({...definition, inputSchema: schema}, async input => {
+    received.push(input);
+    return 'forecast';
+  });
+  const readsAfterRegistration = schemaReads;
+  const input = {location: 'Berlin', extra: {keep: true}};
+  for (let index = 0; index < 10; index += 1) await registry.execute('weather', input);
+
+  expect({received, compiledAtRegistration: readsAfterRegistration > 0, schemaReads}).toEqual({
+    received: Array.from({length: 10}, () => ({location: 'Berlin', extra: {keep: true}})),
+    compiledAtRegistration: true,
+    schemaReads: readsAfterRegistration,
+  });
+});
+
+it('rejects a broken static schema at registration', () => {
+  const registry = new ToolRegistry();
+  expect(() =>
+    registry.register({...definition, inputSchema: {type: 'not-a-json-schema-type'}}, async () => 'forecast')
+  ).toThrow(/weather/);
+});
+
+it('validates each dynamic definition against its current schema', async () => {
+  const registry = new ToolRegistry();
+  let version = 0;
+  const received: Record<string, unknown>[] = [];
+  registry.register(
+    () => ({
+      ...definition,
+      inputSchema: {
+        type: 'object',
+        properties: {location: {type: version++ === 0 ? 'string' : 'number'}},
+        required: ['location'],
+      },
+    }),
+    async input => {
+      received.push(input);
+      return 'forecast';
+    }
+  );
+
+  const response = await registry.execute('weather', {location: 'Berlin'});
+  expect({response, received}).toEqual({
+    response: {result: expect.stringMatching(/location.*number|number.*location/i)},
+    received: [],
+  });
+});