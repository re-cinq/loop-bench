+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+it('returns a rejected tool call to the provider for a corrected retry', async () => {
+  const registry = new ToolRegistry();
+  let executorCalls = 0;
+  registry.register(
+    {
+      name: 'weather',
+      description: 'Get a forecast',
+      inputSchema: {
+        type: 'object',
+        properties: {location: {type: 'string'}},
+        required: ['location'],
+      },
+    },
+    async () => {
+      executorCalls++;
+      return 'sunny in Berlin';
+    }
+  );
+
+  let round = 0;
+  let rejectionSeen = '';
+  const provider: AIProvider = {
+    async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      round++;
+      if (round === 1) {
+        yield {type: 'tool_use', toolCall: {id: 'first', name: 'weather', input: {}}};
+        yield {type: 'stop', stopReason: 'tool_use'};
+      } else if (round === 2) {
+        const result = params.messages.at(-1);
+        if (result?.role === 'user' && Array.isArray(result.content)) {
+          rejectionSeen = result.content[0]?.content ?? '';
+        }
+        yield {type: 'tool_use', toolCall: {id: 'retry', name: 'weather', input: {location: 'Berlin'}}};
+        yield {type: 'stop', stopReason: 'tool_use'};
+      } else {
+        yield {type: 'text', text: 'It is sunny in Berlin.'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      }
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const session: ChatSession = {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'What is the weather?', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Weather assistant'}), registry);
+
+  const answer = await orchestrator.processMessage(session);
+
+  expect({answer, rejectionSeen, executorCalls, round}).toEqual({
+    answer: 'It is sunny in Berlin.',
+    rejectionSeen: expect.stringMatching(/location.*required|required.*location/i),
+    executorCalls: 1,
+    round: 3,
+  });
+});
diff --git a/src/orchestration/tools/registry.acceptance.test.ts b/src/orchestration/tools/registry.acceptance.test.ts
