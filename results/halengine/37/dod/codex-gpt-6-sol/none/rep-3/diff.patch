index 0000000..6a2ba4c
--- /dev/null
+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,159 @@
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry input validation', () => {
+  it('rejects missing required input before execution and passes valid input through unchanged', async () => {
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Get a forecast',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async input => {
+        received.push(input);
+        return 'forecast';
+      }
+    );
+
+    const rejected = await registry.execute('weather', {});
+    const valid = {location: 'Berlin', extra: 'preserved'};
+    const accepted = await registry.execute('weather', valid);
+
+    expect({
+      rejection: rejected.result,
+      received,
+      accepted,
+    }).toEqual({
+      rejection: expect.stringMatching(/location.*required|required.*location/i),
+      received: [valid],
+      accepted: {result: 'forecast'},
+    });
+  });
+
+  it('reports type and enum failures by path and constraint without exposing input values', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Get a forecast',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+            units: {type: 'string', enum: ['metric', 'imperial']},
+          },
+          required: ['location', 'units'],
+        },
+      },
+      async () => {
+        calls++;
+        return 'forecast';
+      }
+    );
+
+    const identifyingValue = 'private-location-48392';
+    const wrongType = await registry.execute('weather', {location: 48392, units: 'metric'});
+    const wrongEnum = await registry.execute('weather', {location: identifyingValue, units: 'secret-units-729'});
+
+    expect({
+      typePath: /location/.test(wrongType.result),
+      expectedType: /string/.test(wrongType.result),
+      typeValueHidden: !wrongType.result.includes('48392'),
+      enumPath: /units/.test(wrongEnum.result),
+      enumConstraint: /enum|allowed|one of/i.test(wrongEnum.result),
+      enumValueHidden: !wrongEnum.result.includes('secret-units-729'),
+      identifyingValueHidden: !wrongEnum.result.includes(identifyingValue),
+      calls,
+    }).toEqual({
+      typePath: true,
+      expectedType: true,
+      typeValueHidden: true,
+      enumPath: true,
+      enumConstraint: true,
+      enumValueHidden: true,
+      identifyingValueHidden: true,
+      calls: 0,
+    });
+  });
+
+  it('rejects a broken static schema at registration and reuses a valid one', async () => {
+    const registry = new ToolRegistry();
+    let errorMessage = '';
+
+    try {
+      registry.register(
+        {name: 'broken-weather', description: 'Broken schema', inputSchema: {type: 'not-a-json-schema-type'}},
+        async () => 'never'
+      );
+    } catch (error) {
+      errorMessage = error instanceof Error ? error.message : String(error);
+    }
+
+    let schemaReads = 0;
+    const staticSchema = {
+      get type() {
+        schemaReads++;
+        return 'object';
+      },
+    };
+    registry.register(
+      {name: 'static-weather', description: 'Static schema', inputSchema: staticSchema},
+      async () => 'ok'
+    );
+    const readsAtRegistration = schemaReads;
+    for (let i = 0; i < 10; i++) await registry.execute('static-weather', {});
+
+    let unknownMessage = '';
+    try {
+      await registry.execute('unregistered-weather', {});
+    } catch (error) {
+      unknownMessage = error instanceof Error ? error.message : String(error);
+    }
+
+    expect({errorMessage, compiledAtRegistration: readsAtRegistration > 0, schemaReads, unknownMessage}).toEqual({
+      errorMessage: expect.stringContaining('broken-weather'),
+      compiledAtRegistration: true,
+      schemaReads: readsAtRegistration,
+      unknownMessage: 'Unknown tool: unregistered-weather',
+    });
+  });
+
+  it('uses the current schema of a function-valued definition on each call', async () => {
+    const registry = new ToolRegistry();
+    let required = 'location';
+    let calls = 0;
+    registry.register(
+      () => ({
+        name: 'weather',
+        description: 'Get a forecast',
+        inputSchema: {
+          type: 'object',
+          properties: {[required]: {type: 'string'}},
+          required: [required],
+        },
+      }),
+      async () => {
+        calls++;
+        return 'forecast';
+      }
+    );
+
+    const first = await registry.execute('weather', {location: 'Berlin'});
+    required = 'postalCode';
+    const stale = await registry.execute('weather', {location: 'Berlin'});
+    const current = await registry.execute('weather', {postalCode: '10115'});
+
+    expect({first, stale: stale.result, current, calls}).toEqual({
+      first: {result: 'forecast'},
+      stale: expect.stringMatching(/postalCode.*required|required.*postalCode/i),
+      current: {result: 'forecast'},
+      calls: 2,
+    });
+  });
+});