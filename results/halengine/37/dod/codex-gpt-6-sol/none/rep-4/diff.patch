--- /dev/null
+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,100 @@
+import {ToolRegistry} from './registry.js';
+
+const weatherSchema = {
+  type: 'object',
+  properties: {location: {type: 'string'}},
+  required: ['location'],
+};
+
+const weatherDefinition = {
+  name: 'weather',
+  description: 'Forecast for a location',
+  inputSchema: weatherSchema,
+};
+
+describe('ToolRegistry input validation', () => {
+  it('rejects missing required input before invoking the executor', async () => {
+    const registry = new ToolRegistry();
+    let executions = 0;
+    const received: Record<string, unknown>[] = [];
+    registry.register(weatherDefinition, async input => {
+      executions++;
+      received.push(input);
+      return 'forecast';
+    });
+
+    const response = await registry.execute('weather', {});
+
+    expect(response.result).toMatch(/location.*required|required.*location/i);
+    expect(executions).toBe(0);
+    const input = {location: 'Berlin', note: 'keep this extra property'};
+    expect(await registry.execute('weather', input)).toEqual({result: 'forecast'});
+    expect({received, executions}).toEqual({received: [input], executions: 1});
+    await expect(registry.execute('unregistered', input)).rejects.toThrow('Unknown tool: unregistered');
+  });
+
+  it('rejects a wrong type without echoing the supplied value', async () => {
+    const registry = new ToolRegistry();
+    let executions = 0;
+    registry.register(weatherDefinition, async () => {
+      executions++;
+      return 'forecast';
+    });
+
+    const response = await registry.execute('weather', {location: 93741268});
+
+    expect(response.result).toMatch(/location/);
+    expect(response.result).toMatch(/string/);
+    expect(response.result).not.toContain('93741268');
+    expect(executions).toBe(0);
+  });
+
+  it('compiles a static schema when registering the tool', async () => {
+    const registry = new ToolRegistry();
+    expect(() =>
+      registry.register(
+        {name: 'broken-weather', description: 'Invalid schema', inputSchema: {type: 'no-such-json-type'}},
+        async () => 'forecast'
+      )
+    ).toThrow(/broken-weather/);
+
+    const mutableSchema: Record<string, unknown> = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    registry.register(
+      {name: 'static-weather', description: 'Static schema', inputSchema: mutableSchema},
+      async () => 'forecast'
+    );
+    mutableSchema.required = ['never-declared'];
+
+    for (let call = 0; call < 10; call++) {
+      await expect(registry.execute('static-weather', {location: 'Berlin'})).resolves.toEqual({result: 'forecast'});
+    }
+  });
+
+  it('validates each call against the current dynamic schema', async () => {
+    const registry = new ToolRegistry();
+    let required = 'location';
+    let executions = 0;
+    registry.register(
+      () => ({
+        name: 'dynamic-weather',
+        description: 'Current requirement',
+        inputSchema: {type: 'object', properties: {[required]: {type: 'string'}}, required: [required]},
+      }),
+      async () => {
+        executions++;
+        return 'forecast';
+      }
+    );
+
+    expect(await registry.execute('dynamic-weather', {location: 'Berlin'})).toEqual({result: 'forecast'});
+    required = 'city';
+    const response = await registry.execute('dynamic-weather', {location: 'Berlin'});
+
+    expect(response.result).toMatch(/city.*required|required.*city/i);
+    expect(executions).toBe(1);
+  });
+});