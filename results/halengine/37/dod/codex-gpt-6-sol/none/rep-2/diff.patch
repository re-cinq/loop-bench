+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+
+it('returns a schema rejection to the model so it can correct the tool call in the next round', async () => {
+  const toolResultsSeen: string[] = [];
+  let round = 0;
+  const provider: AIProvider = {
+    async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      round++;
+      const result = params.messages.at(-1);
+      if (result?.role === 'user' && Array.isArray(result.content)) {
+        toolResultsSeen.push(result.content[0].content);
+      }
+      if (round <= 2) {
+        yield {
+          type: 'tool_use',
+          toolCall: {
+            id: `call-${round}`,
+            name: 'weather',
+            input: round === 1 ? {} : {location: 'Berlin'},
+          },
+        };
+        yield {type: 'stop', stopReason: 'tool_use'};
+      } else {
+        yield {type: 'text', text: 'Forecast ready'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      }
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured output is not used by this provider');
+    },
+  };
+  const registry = new ToolRegistry();
+  const received: Record<string, unknown>[] = [];
+  registry.register(
+    {
+      name: 'weather',
+      description: 'Looks up weather',
+      inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+    },
+    async input => {
+      received.push(input);
+      return 'Sunny';
+    }
+  );
+  const session: ChatSession = {
+    sessionId: 'session-1',
+    userId: 'user-1',
+    entries: [{role: 'user', content: 'What is the weather?', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Weather assistant'}), registry);
+
+  const reply = await orchestrator.processMessage(session);
+
+  expect({reply, round, toolResultsSeen, received}).toEqual({
+    reply: 'Forecast ready',
+    round: 3,
+    toolResultsSeen: [expect.stringMatching(/location.*required|required.*location/i), 'Sunny'],
+    received: [{location: 'Berlin'}],
+  });
+});
