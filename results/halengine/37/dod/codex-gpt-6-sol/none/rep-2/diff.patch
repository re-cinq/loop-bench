@@ -0,0 +1,126 @@
+import type {ToolDefinition} from '../../types/ai.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+import {ToolRegistry} from './registry.js';
+
+const weather: ToolDefinition = {
+  name: 'weather',
+  description: 'Looks up weather',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string', enum: ['Berlin', 'Paris']}},
+    required: ['location'],
+  },
+};
+
+describe('ToolRegistry input validation', () => {
+  it('rejects invalid input without executing or disclosing values, and passes valid input through unchanged', async () => {
+    const lines: string[] = [];
+    const logger: Logger = {
+      debug: (...args) => void lines.push(JSON.stringify(args)),
+      info: (...args) => void lines.push(JSON.stringify(args)),
+      warn: (...args) => void lines.push(JSON.stringify(args)),
+      error: (...args) => void lines.push(JSON.stringify(args)),
+    };
+    const received: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(weather, async input => {
+      received.push(input);
+      return 'forecast';
+    });
+    setLogger(logger);
+    try {
+      const missing = await registry.execute('weather', {});
+      const wrongType = await registry.execute('weather', {location: 42});
+      const identifyingValue = 'private-person@example.invalid';
+      const wrongEnum = await registry.execute('weather', {location: identifyingValue});
+      const valid = {location: 'Berlin', extra: {keep: true}};
+      const accepted = await registry.execute('weather', valid);
+      await expect(registry.execute('absent', {})).rejects.toThrow('Unknown tool: absent');
+
+      expect({
+        missing: missing.result,
+        wrongType: wrongType.result,
+        wrongEnum: wrongEnum.result,
+        calls: received,
+        accepted,
+        disclosed: [missing.result, wrongType.result, wrongEnum.result, ...lines].some(line =>
+          line.includes(identifyingValue)
+        ),
+      }).toEqual({
+        missing: expect.stringMatching(/location.*required|required.*location/i),
+        wrongType: expect.stringMatching(/location.*string|string.*location/i),
+        wrongEnum: expect.stringMatching(/location.*enum|enum.*location|location.*allowed|allowed.*location/i),
+        calls: [valid],
+        accepted: {result: 'forecast'},
+        disclosed: false,
+      });
+    } finally {
+      setLogger();
+    }
+  });
+
+  it('rejects an uncompilable static schema at registration and reuses a compiled static schema', async () => {
+    const registry = new ToolRegistry();
+    let badSchemaError = '';
+    try {
+      registry.register(
+        {name: 'broken-weather', description: 'Broken schema', inputSchema: {type: 'not-a-json-schema-type'}},
+        async () => 'never'
+      );
+    } catch (error) {
+      badSchemaError = error instanceof Error ? error.message : String(error);
+    }
+
+    let schemaReads = 0;
+    const staticTool: ToolDefinition = {
+      name: 'static-weather',
+      description: 'Static schema',
+      get inputSchema() {
+        schemaReads++;
+        return {type: 'object', properties: {location: {type: 'string'}}, required: ['location']};
+      },
+    };
+    registry.register(staticTool, async () => 'ok');
+    const readsAfterRegister = schemaReads;
+    const results = await Promise.all(
+      Array.from({length: 10}, () => registry.execute('static-weather', {location: 'Berlin'}))
+    );
+
+    expect({badSchemaError, readsAfterRegister, schemaReads, results}).toEqual({
+      badSchemaError: expect.stringMatching(/broken-weather/),
+      readsAfterRegister: 1,
+      schemaReads: 1,
+      results: Array.from({length: 10}, () => ({result: 'ok'})),
+    });
+  });
+
+  it('validates each call against a function definition’s current schema', async () => {
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+    let required = 'location';
+    registry.register(
+      () => ({
+        name: 'changing-weather',
+        description: 'Changes required input',
+        inputSchema: {type: 'object', properties: {[required]: {type: 'string'}}, required: [required]},
+      }),
+      async input => {
+        received.push(input);
+        return 'ok';
+      }
+    );
+
+    const first = await registry.execute('changing-weather', {location: 'Berlin'});
+    required = 'station';
+    const second = await registry.execute('changing-weather', {location: 'Berlin'});
+    const third = await registry.execute('changing-weather', {station: 'Central'});
+
+    expect({first, second: second.result, third, received}).toEqual({
+      first: {result: 'ok'},
+      second: expect.stringMatching(/station.*required|required.*station/i),
+      third: {result: 'ok'},
+      received: [{location: 'Berlin'}, {station: 'Central'}],
+    });
+  });
+});