+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+
+const locationDefinition = {
+  name: 'weather',
+  description: 'Reports weather',
+  inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+};
+
+test('rejects missing required input before execution while preserving valid input and unknown names', async () => {
+  const registry = new ToolRegistry();
+  const received: Record<string, unknown>[] = [];
+  registry.register(locationDefinition, async input => {
+    received.push(input);
+    return 'forecast';
+  });
+  const input = {location: 'Berlin', extra: 'kept'};
+
+  expect(await registry.execute('weather', input)).toEqual({result: 'forecast'});
+  expect(received).toEqual([input]);
+  await expect(registry.execute('missing', {})).rejects.toThrow('Unknown tool: missing');
+
+  const rejected = await registry.execute('weather', {});
+  expect(rejected.result).toMatch(/location.*required|required.*location/i);
+  expect(received).toEqual([input]);
+});
+
+test('rejects wrong types and enum values with paths and constraints but without input values in results or logs', async () => {
+  const registry = new ToolRegistry();
+  const calls: Record<string, unknown>[] = [];
+  const lines: string[] = [];
+  setLogger({
+    debug: (...args) => lines.push(JSON.stringify(args)),
+    info: (...args) => lines.push(JSON.stringify(args)),
+    warn: (...args) => lines.push(JSON.stringify(args)),
+    error: (...args) => lines.push(JSON.stringify(args)),
+  });
+  registry.register(
+    {
+      name: 'weather',
+      description: 'Reports weather',
+      inputSchema: {
+        type: 'object',
+        properties: {location: {type: 'string'}, units: {enum: ['metric', 'imperial']}},
+        required: ['location'],
+      },
+    },
+    async input => {
+      calls.push(input);
+      return 'forecast';
+    }
+  );
+
+  try {
+    const wrongType = await registry.execute('weather', {location: 123456789, identifying: 'private-person-123'});
+    const wrongEnum = await registry.execute('weather', {location: 'Berlin', units: 'secret-unit-123'});
+    expect(wrongType.result).toMatch(/location.*string|string.*location/i);
+    expect(wrongEnum.result).toMatch(/units.*enum|units.*allowed|units.*metric/i);
+    expect(lines.join(' ')).toMatch(/location.*(string|type)|(?:string|type).*location/i);
+    expect(JSON.stringify({wrongType, wrongEnum, lines, calls})).not.toMatch(
+      /123456789|private-person-123|secret-unit-123/
+    );
+    expect(calls).toEqual([]);
+  } finally {
+    setLogger();
+  }
+});
+
+test('compiles static schemas at registration and reuses them across ten calls', async () => {
+  const registry = new ToolRegistry();
+  const invalid = {name: 'broken-weather', description: 'Broken', inputSchema: {type: 'unsupported-type'}};
+  expect(() => registry.register(invalid, async () => 'unused')).toThrow(/broken-weather/);
+
+  let schemaReads = 0;
+  const schema = {
+    type: 'object',
+    get properties() {
+      schemaReads++;
+      return {location: {type: 'string'}};
+    },
+    required: ['location'],
+  };
+  registry.register({name: 'weather', description: 'Reports weather', inputSchema: schema}, async () => 'forecast');
+  const readsAtRegistration = schemaReads;
+  expect(readsAtRegistration).toBeGreaterThan(0);
+  for (let index = 0; index < 10; index++) {
+    expect(await registry.execute('weather', {location: 'Berlin'})).toEqual({result: 'forecast'});
+  }
+  expect(schemaReads).toBe(readsAtRegistration);
+});
+
+test('validates each function valued definition against its current schema', async () => {
+  const registry = new ToolRegistry();
+  const calls: Record<string, unknown>[] = [];
+  let requiredField = 'location';
+  registry.register(
+    () => ({
+      name: 'weather',
+      description: 'Reports weather',
+      inputSchema: {type: 'object', properties: {[requiredField]: {type: 'string'}}, required: [requiredField]},
+    }),
+    async input => {
+      calls.push(input);
+      return 'forecast';
+    }
+  );
+  expect(await registry.execute('weather', {location: 'Berlin'})).toEqual({result: 'forecast'});
+  requiredField = 'city';
+  const rejected = await registry.execute('weather', {location: 'Berlin'});
+  expect(rejected.result).toMatch(/city.*required|required.*city/i);
+  expect(calls).toEqual([{location: 'Berlin'}]);
+  expect(await registry.execute('weather', {city: 'Berlin'})).toEqual({result: 'forecast'});
+});
+
+test('returns a rejected tool call to the provider so a corrected retry completes', async () => {
+  const registry = new ToolRegistry();
+  const executed: Record<string, unknown>[] = [];
+  registry.register(locationDefinition, async input => {
+    executed.push(input);
+    return 'sunny';
+  });
+  const seenToolResults: string[] = [];
+  let round = 0;
+  const provider: AIProvider = {
+    async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      const latest = params.messages.at(-1);
+      if (latest?.role === 'user' && typeof latest.content !== 'string') {
+        seenToolResults.push(...latest.content.map(result => result.content));
+      }
+      const input = round++ === 0 ? {} : {location: 'Berlin'};
+      if (round <= 2) {
+        yield {type: 'tool_use', toolCall: {id: `call-${round}`, name: 'weather', input}};
+        yield {type: 'stop', stopReason: 'tool_use'};
+      } else {
+        yield {type: 'text', text: 'The forecast is sunny'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      }
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('structured output is outside this tool call');
+    },
+  };
+  const session: ChatSession = {
+    sessionId: 'session-1',
+    userId: 'user-1',
+    entries: [{role: 'user', content: 'Weather?', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Test assistant'}), registry);
+
+  expect(await orchestrator.processMessage(session)).toBe('The forecast is sunny');
+  expect(seenToolResults[0]).toMatch(/location.*required|required.*location/i);
+  expect(executed).toEqual([{location: 'Berlin'}]);
+});