+import {ToolRegistry} from './registry.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+
+const locationSchema = {
+  type: 'object',
+  properties: {location: {type: 'string'}},
+  required: ['location'],
+};
+
+describe('registered tool input validation', () => {
+  it('returns a required-field result before execution and passes valid extra keys through unchanged', async () => {
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+    registry.register({name: 'weather', description: 'Weather', inputSchema: locationSchema}, async input => {
+      received.push(input);
+      return 'forecast';
+    });
+
+    const rejected = await registry.execute('weather', {});
+    expect(rejected.result).toMatch(/location.*required|required.*location/i);
+    expect(received).toHaveLength(0);
+
+    const input = {location: 'Berlin', extra: 'preserved'};
+    expect(await registry.execute('weather', input)).toEqual({result: 'forecast'});
+    expect(received).toEqual([input]);
+    await expect(registry.execute('missing', {})).rejects.toThrow('Unknown tool: missing');
+  });
+
+  it('rejects a wrong type with the property path and constraint but without the identifying value', async () => {
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+    registry.register({name: 'weather', description: 'Weather', inputSchema: locationSchema}, async input => {
+      received.push(input);
+      return 'forecast';
+    });
+
+    const response = await registry.execute('weather', {location: 8675309});
+    expect(response.result).toMatch(/location/);
+    expect(response.result).toMatch(/string/);
+    expect(response.result).not.toContain('8675309');
+    expect(received).toHaveLength(0);
+  });
+
+  it('rejects an uncompilable static schema at registration with the tool name', () => {
+    const registry = new ToolRegistry();
+    expect(() =>
+      registry.register(
+        {name: 'broken', description: 'Broken', inputSchema: {type: 'object', required: 'location'}},
+        async () => 'never'
+      )
+    ).toThrow(/broken/);
+  });
+
+  it('uses the current schema from a function-valued definition on each call', async () => {
+    const registry = new ToolRegistry();
+    let currentSchema: Record<string, unknown> = {type: 'object', required: ['location']};
+    const received: Record<string, unknown>[] = [];
+    registry.register(
+      () => ({name: 'changing', description: 'Changing', inputSchema: currentSchema}),
+      async input => {
+        received.push(input);
+        return 'accepted';
+      }
+    );
+
+    expect((await registry.execute('changing', {location: 'Berlin'})).result).toBe('accepted');
+    currentSchema = {type: 'object', required: ['unit']};
+    const rejected = await registry.execute('changing', {location: 'Berlin'});
+    expect(rejected.result).toMatch(/unit.*required|required.*unit/i);
+    expect(received).toHaveLength(1);
+    expect((await registry.execute('changing', {unit: 'C'})).result).toBe('accepted');
+  });
+
+  it('returns a rejected tool call to the provider so it can retry within the tool loop', async () => {
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+    registry.register({name: 'weather', description: 'Weather', inputSchema: locationSchema}, async input => {
+      received.push(input);
+      return 'sunny';
+    });
+    const seen: SendMessageParams[] = [];
+    const provider: AIProvider = {
+      async *sendMessage(params): AsyncGenerator<MessageChunk> {
+        seen.push({...params, messages: [...params.messages]});
+        if (seen.length === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'first', name: 'weather', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+        } else if (seen.length === 2) {
+          yield {type: 'tool_use', toolCall: {id: 'second', name: 'weather', input: {location: 'Berlin'}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+        } else {
+          yield {type: 'text', text: 'sunny in Berlin'};
+          yield {type: 'stop', stopReason: 'end_turn'};
+        }
+      },
+      async generateStructured<T>(): Promise<T> {
+        throw new Error('structured output is outside this scenario');
+      },
+    };
+    const session: ChatSession = {
+      sessionId: 'session',
+      userId: 'user',
+      entries: [{role: 'user', content: 'weather?', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Assistant'}), registry);
+
+    expect(await orchestrator.processMessage(session)).toBe('sunny in Berlin');
+    expect(seen).toHaveLength(3);
+    expect(seen[1].messages.at(-1)?.content).toEqual([
+      {
+        type: 'tool_result',
+        toolUseId: 'first',
+        content: expect.stringMatching(/location.*required|required.*location/i),
+      },
+    ]);
+    expect(received).toEqual([{location: 'Berlin'}]);
+  });
+});