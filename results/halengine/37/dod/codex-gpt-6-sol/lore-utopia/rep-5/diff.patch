@@ -0,0 +1,118 @@
+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+
+const locationSchema = {
+  type: 'object',
+  properties: {location: {type: 'string', enum: ['Berlin']}},
+  required: ['location'],
+};
+
+const outcomeOf = async (call: Promise<unknown>): Promise<string> => {
+  try {
+    await call;
+    return 'resolved';
+  } catch (error) {
+    return error instanceof Error ? error.message : String(error);
+  }
+};
+
+it('validates model input before execution and preserves accepted input', async () => {
+  const registry = new ToolRegistry();
+  const received: Record<string, unknown>[] = [];
+  const logged: string[] = [];
+  const logger: Logger = {
+    debug: (_category, message, fields) => void logged.push(JSON.stringify({message, fields})),
+    info: (_category, message, fields) => void logged.push(JSON.stringify({message, fields})),
+    warn: (_category, message, fields) => void logged.push(JSON.stringify({message, fields})),
+    error: (_category, message, fields) => void logged.push(JSON.stringify({message, fields})),
+  };
+  registry.register({name: 'weather', description: 'Weather', inputSchema: locationSchema}, async input => {
+    received.push(input);
+    return 'forecast';
+  });
+
+  setLogger(logger);
+  try {
+    const missing = await registry.execute('weather', {});
+    const wrongType = await registry.execute('weather', {location: 42, identifyingField: 'private-id-123'});
+    const wrongEnum = await registry.execute('weather', {location: 'private-id-123'});
+    const validInput = {location: 'Berlin', extra: {untouched: true}};
+    const valid = await registry.execute('weather', validInput);
+    const unknown = await outcomeOf(registry.execute('unregistered', {}));
+
+    expect({
+      missing: /location.*required|required.*location/i.test(missing.result),
+      wrongType: /location.*string|string.*location/i.test(wrongType.result),
+      wrongEnum: /location.*enum|enum.*location|location.*allowed/i.test(wrongEnum.result),
+      privateValueLeaked: `${wrongType.result} ${wrongEnum.result} ${logged.join(' ')}`.includes('private-id-123'),
+      wrongTypeValueLeaked: wrongType.result.includes('42'),
+      received,
+      valid,
+      unknown,
+    }).toEqual({
+      missing: true,
+      wrongType: true,
+      wrongEnum: true,
+      privateValueLeaked: false,
+      wrongTypeValueLeaked: false,
+      received: [validInput],
+      valid: {result: 'forecast'},
+      unknown: 'Unknown tool: unregistered',
+    });
+  } finally {
+    setLogger();
+  }
+});
+
+it('compiles a static schema at registration and reuses it', async () => {
+  const registry = new ToolRegistry();
+  let invalidSchemaError = '';
+  try {
+    registry.register(
+      {name: 'broken-weather', description: 'Broken', inputSchema: {type: 'not-a-json-schema-type'}},
+      async () => 'unused'
+    );
+  } catch (error) {
+    invalidSchemaError = error instanceof Error ? error.message : String(error);
+  }
+
+  const schema: Record<string, unknown> = {type: 'object', required: ['location']};
+  registry.register({name: 'weather', description: 'Weather', inputSchema: schema}, async () => 'ok');
+  schema.required = ['later'];
+  const results = await Promise.all(Array.from({length: 10}, () => registry.execute('weather', {location: 'Berlin'})));
+
+  expect({invalidSchemaNamesTool: invalidSchemaError.includes('broken-weather'), results}).toEqual({
+    invalidSchemaNamesTool: true,
+    results: Array.from({length: 10}, () => ({result: 'ok'})),
+  });
+});
+
+it('uses the current schema from a function-valued definition', async () => {
+  const registry = new ToolRegistry();
+  let required = 'location';
+  const received: Record<string, unknown>[] = [];
+  registry.register(
+    () => ({
+      name: 'weather',
+      description: 'Weather',
+      inputSchema: {type: 'object', properties: {[required]: {type: 'string'}}, required: [required]},
+    }),
+    async input => {
+      received.push(input);
+      return 'ok';
+    }
+  );
+
+  const first = await registry.execute('weather', {location: 'Berlin'});
+  required = 'city';
+  const stale = await registry.execute('weather', {location: 'Berlin'});
+  const current = await registry.execute('weather', {city: 'Berlin'});
+
+  expect({first, staleMentionsCity: /city.*required|required.*city/i.test(stale.result), current, received}).toEqual({
+    first: {result: 'ok'},
+    staleMentionsCity: true,
+    current: {result: 'ok'},
+    received: [{location: 'Berlin'}, {city: 'Berlin'}],
+  });
+});