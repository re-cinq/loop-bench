+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const session: ChatSession = {
+  sessionId: 'validation-session',
+  userId: 'user',
+  entries: [{role: 'user', content: 'Weather in Berlin?', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+it('lets the model correct a rejected tool call', async () => {
+  const registry = new ToolRegistry();
+  const received: Record<string, unknown>[] = [];
+  registry.register(
+    {
+      name: 'weather',
+      description: 'Weather',
+      inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+    },
+    async input => {
+      received.push(input);
+      return 'Sunny in Berlin';
+    }
+  );
+
+  let round = 0;
+  let rejectionSeenByProvider = '';
+  const provider: AIProvider = {
+    async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      round += 1;
+      if (round === 1) {
+        yield {type: 'tool_use', toolCall: {id: 'first', name: 'weather', input: {}}};
+        yield {type: 'stop', stopReason: 'tool_use'};
+      } else if (round === 2) {
+        const last = params.messages[params.messages.length - 1];
+        const result = typeof last.content === 'string' ? undefined : last.content[0];
+        rejectionSeenByProvider = result && 'content' in result ? result.content : '';
+        yield {type: 'tool_use', toolCall: {id: 'retry', name: 'weather', input: {location: 'Berlin'}}};
+        yield {type: 'stop', stopReason: 'tool_use'};
+      } else {
+        yield {type: 'text', text: 'It is sunny in Berlin.'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      }
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured output is not used in this conversation');
+    },
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Weather assistant'}), registry);
+
+  const answer = await orchestrator.processMessage(session);
+
+  expect({
+    answer,
+    rejectionSeen: /location.*required|required.*location/i.test(rejectionSeenByProvider),
+    received,
+    round,
+  }).toEqual({
+    answer: 'It is sunny in Berlin.',
+    rejectionSeen: true,
+    received: [{location: 'Berlin'}],
+    round: 3,
+  });
+});
