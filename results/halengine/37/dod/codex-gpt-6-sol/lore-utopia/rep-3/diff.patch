@@ -0,0 +1,106 @@
+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+
+const locationSchema = {
+  type: 'object',
+  properties: {location: {type: 'string', enum: ['Paris']}},
+  required: ['location'],
+};
+
+describe('ToolRegistry input validation', () => {
+  it('rejects required, type, and enum violations without exposing values or invoking the executor', async () => {
+    const lines: string[] = [];
+    setLogger({
+      debug: (_category, message, fields) => void lines.push(JSON.stringify({message, fields})),
+      info: (_category, message, fields) => void lines.push(JSON.stringify({message, fields})),
+      warn: (_category, message, fields) => void lines.push(JSON.stringify({message, fields})),
+      error: (_category, message, fields) => void lines.push(JSON.stringify({message, fields})),
+    });
+
+    try {
+      const registry = new ToolRegistry();
+      const inputs: Record<string, unknown>[] = [];
+      registry.register({name: 'weather', description: 'Forecast', inputSchema: locationSchema}, async input => {
+        inputs.push(input);
+        return 'forecast';
+      });
+
+      const missing = await registry.execute('weather', {});
+      const wrongType = await registry.execute('weather', {location: 123456789});
+      const wrongEnum = await registry.execute('weather', {location: 'Private Address 98765'});
+
+      expect(missing.result).toMatch(/location.*required|required.*location/i);
+      expect(wrongType.result).toMatch(/location.*string|string.*location/i);
+      expect(wrongEnum.result).toMatch(/location.*enum|enum.*location/i);
+      expect(JSON.stringify({missing, wrongType, wrongEnum, lines})).not.toMatch(/123456789|Private Address 98765/);
+      expect(inputs).toEqual([]);
+
+      const valid = {location: 'Paris', extra: 'preserve this'};
+      expect(await registry.execute('weather', valid)).toEqual({result: 'forecast'});
+      expect(inputs).toEqual([valid]);
+      await expect(registry.execute('absent', {})).rejects.toThrow('Unknown tool: absent');
+    } finally {
+      setLogger();
+    }
+  });
+
+  it('rejects an uncompilable static schema when the named tool is registered', () => {
+    const registry = new ToolRegistry();
+    expect(() =>
+      registry.register(
+        {name: 'weather', description: 'Forecast', inputSchema: {type: 'not-a-json-schema-type'}},
+        async () => 'forecast'
+      )
+    ).toThrow(/weather/);
+  });
+
+  it('keeps a static schema compiled across ten executions', async () => {
+    const registry = new ToolRegistry();
+    const schema: Record<string, unknown> = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    let calls = 0;
+    registry.register({name: 'weather', description: 'Forecast', inputSchema: schema}, async () => {
+      calls++;
+      return 'forecast';
+    });
+
+    schema.type = 'not-a-json-schema-type';
+    for (let index = 0; index < 10; index++) {
+      expect(await registry.execute('weather', {location: 'Paris'})).toEqual({result: 'forecast'});
+    }
+    const rejected = await registry.execute('weather', {});
+    expect(rejected.result).toMatch(/location.*required|required.*location/i);
+    expect(calls).toBe(10);
+  });
+
+  it('uses each function-valued definition schema at the call where it resolves', async () => {
+    const registry = new ToolRegistry();
+    let requiredField = 'location';
+    const inputs: Record<string, unknown>[] = [];
+    registry.register(
+      () => ({
+        name: 'weather',
+        description: 'Forecast',
+        inputSchema: {
+          type: 'object',
+          properties: {[requiredField]: {type: 'string'}},
+          required: [requiredField],
+        },
+      }),
+      async input => {
+        inputs.push(input);
+        return 'forecast';
+      }
+    );
+
+    expect(await registry.execute('weather', {location: 'Paris'})).toEqual({result: 'forecast'});
+    requiredField = 'station';
+    const rejected = await registry.execute('weather', {location: 'Paris'});
+    expect(rejected.result).toMatch(/station.*required|required.*station/i);
+    expect(await registry.execute('weather', {station: 'North'})).toEqual({result: 'forecast'});
+    expect(inputs).toEqual([{location: 'Paris'}, {station: 'North'}]);
+  });
+});