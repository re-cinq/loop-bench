+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+it('returns a rejected tool call to the provider so a corrected retry completes', async () => {
+  const registry = new ToolRegistry();
+  const executed: Record<string, unknown>[] = [];
+  registry.register(
+    {
+      name: 'weather',
+      description: 'Forecast',
+      inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+    },
+    async input => {
+      executed.push(input);
+      return 'sunny';
+    }
+  );
+
+  const seen: SendMessageParams[] = [];
+  let retryInput: string | undefined;
+  const provider: AIProvider = {
+    async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      seen.push(params);
+      if (seen.length === 1) {
+        yield {type: 'tool_use', toolCall: {id: 'first', name: 'weather', input: {}}};
+        yield {type: 'stop', stopReason: 'tool_use'};
+      } else if (seen.length === 2) {
+        retryInput = JSON.stringify(params.messages.at(-1));
+        yield {type: 'tool_use', toolCall: {id: 'second', name: 'weather', input: {location: 'Paris'}}};
+        yield {type: 'stop', stopReason: 'tool_use'};
+      } else {
+        yield {type: 'text', text: 'The forecast is sunny.'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      }
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured output is not used by the tool loop');
+    },
+  };
+  const session: ChatSession = {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'Weather?', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const orchestrator = createChatOrchestrator(
+    provider,
+    new PromptBuilder({identity: 'You are a test assistant.'}),
+    registry
+  );
+
+  await expect(orchestrator.processMessage(session)).resolves.toBe('The forecast is sunny.');
+  expect(retryInput).toMatch(/"toolUseId":"first"/);
+  expect(retryInput).toMatch(/location.*required|required.*location/i);
+  expect(executed).toEqual([{location: 'Paris'}]);
+  expect(seen).toHaveLength(3);
+});
