+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+import type {AIProvider, MessageChunk, SendMessageParams, ToolDefinition} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+import {ToolRegistry} from './registry.js';
+
+const definition = (inputSchema: Record<string, unknown>): ToolDefinition => ({
+  name: 'weather',
+  description: 'Get the weather',
+  inputSchema,
+});
+
+const locationSchema = {
+  type: 'object',
+  properties: {location: {type: 'string'}},
+  required: ['location'],
+};
+
+describe('ToolRegistry input validation acceptance', () => {
+  it('returns a missing-location error to the model and lets it retry within the tool loop', async () => {
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+    registry.register(definition(locationSchema), async input => {
+      received.push(input);
+      return 'forecast';
+    });
+
+    let round = 0;
+    let rejectionSeenByProvider = '';
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        round++;
+        if (round === 2) {
+          const result = params.messages.at(-1);
+          if (result?.role === 'user' && Array.isArray(result.content)) {
+            rejectionSeenByProvider = result.content[0]?.content ?? '';
+          }
+        }
+        if (round <= 2) {
+          yield {
+            type: 'tool_use',
+            toolCall: {id: `call-${round}`, name: 'weather', input: round === 1 ? {} : {location: 'Berlin'}},
+          };
+          yield {type: 'stop', stopReason: 'tool_use'};
+        } else {
+          yield {type: 'text', text: 'Here is the forecast.'};
+          yield {type: 'stop', stopReason: 'end_turn'};
+        }
+      },
+      async generateStructured<T>(): Promise<T> {
+        throw new Error('Structured output was not requested');
+      },
+    };
+    const session: ChatSession = {
+      sessionId: 'weather-session',
+      userId: 'user-1',
+      entries: [{role: 'user', content: 'Weather in Berlin?', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+
+    const answer = await createChatOrchestrator(
+      provider,
+      new PromptBuilder({identity: 'Weather assistant'}),
+      registry
+    ).processMessage(session);
+
+    expect({answer, round, rejectionSeenByProvider, received}).toEqual({
+      answer: 'Here is the forecast.',
+      round: 3,
+      rejectionSeenByProvider: expect.stringMatching(/location.*required/i),
+      received: [{location: 'Berlin'}],
+    });
+  });
+
+  it('rejects wrong types and enum values with path-only messages and logs', async () => {
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+    registry.register(
+      definition({
+        type: 'object',
+        properties: {
+          request: {
+            type: 'object',
+            properties: {location: {type: 'string'}, units: {type: 'string', enum: ['metric', 'imperial']}},
+            required: ['location', 'units'],
+          },
+        },
+        required: ['request'],
+      }),
+      async input => {
+        received.push(input);
+        return 'forecast';
+      }
+    );
+    const lines: string[] = [];
+    const record = (_category: string, message: string, fields?: Record<string, unknown>): void => {
+      lines.push(JSON.stringify({message, fields}));
+    };
+    const logger: Logger = {debug: record, info: record, warn: record, error: record};
+    const secret = '493928771';
+
+    setLogger(logger);
+    try {
+      const wrongType = await registry.execute('weather', {request: {location: 493928771, units: 'metric'}});
+      const wrongEnum = await registry.execute('weather', {request: {location: 'Berlin', units: secret}});
+      const output = [wrongType.result, wrongEnum.result, ...lines].join('\n');
+
+      expect({wrongType: wrongType.result, wrongEnum: wrongEnum.result, received, output}).toEqual({
+        wrongType: expect.stringMatching(/request.*location.*string/i),
+        wrongEnum: expect.stringMatching(/request.*units.*(enum|allowed)/i),
+        received: [],
+        output: expect.not.stringContaining(secret),
+      });
+      expect(lines.join('\n')).toMatch(/request.*(location|units).*(type|enum|allowed|string)/i);
+    } finally {
+      setLogger();
+    }
+  });
+
+  it('uses one registered static schema across ten calls while passing valid extra keys unchanged', async () => {
+    const registry = new ToolRegistry();
+    const schema = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    const received: Record<string, unknown>[] = [];
+    registry.register(definition(schema), async input => {
+      received.push(input);
+      return 'forecast';
+    });
+    schema.required.push('later-added');
+    const input = {location: 'Berlin', extra: {source: 'user'}};
+
+    for (let i = 0; i < 10; i++) {
+      expect(await registry.execute('weather', input)).toEqual({result: 'forecast'});
+    }
+    const invalid = await registry.execute('weather', {});
+
+    expect({received, invalid: invalid.result}).toEqual({
+      received: Array.from({length: 10}, () => ({location: 'Berlin', extra: {source: 'user'}})),
+      invalid: expect.stringMatching(/location.*required/i),
+    });
+  });
+
+  it('fails registration for an invalid schema and keeps unknown-tool errors as throws', async () => {
+    const registry = new ToolRegistry();
+    await expect(registry.execute('missing', {})).rejects.toThrow('Unknown tool: missing');
+    expect(() =>
+      registry.register(definition({type: 'unrecognized-json-schema-type'}), async () => 'forecast')
+    ).toThrow(/weather/i);
+  });
+
+  it('validates each function-valued definition against the schema returned for that call', async () => {
+    const registry = new ToolRegistry();
+    let currentSchema = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    const received: Record<string, unknown>[] = [];
+    registry.register(
+      () => definition(currentSchema),
+      async input => {
+        received.push(input);
+        return 'forecast';
+      }
+    );
+
+    expect(await registry.execute('weather', {location: 'Berlin'})).toEqual({result: 'forecast'});
+    currentSchema.required.push('later-added');
+    expect(await registry.execute('weather', {location: 'Berlin'})).toEqual({result: 'forecast'});
+    currentSchema = {type: 'object', properties: {location: {type: 'string'}}, required: ['city']};
+    const staleInput = await registry.execute('weather', {location: 'Berlin'});
+    expect(await registry.execute('weather', {city: 'Berlin'})).toEqual({result: 'forecast'});
+
+    expect({staleInput: staleInput.result, received}).toEqual({
+      staleInput: expect.stringMatching(/city.*required/i),
+      received: [{location: 'Berlin'}, {location: 'Berlin'}, {city: 'Berlin'}],
+    });
+  });
+});