@@ -0,0 +1,80 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, Message, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+// Spec: specs/hal-engine-tool-input-validation/spec.md
+
+const session = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'weather?', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+// Collects the tool_result text the provider was shown at the start of each round.
+const toolResultsIn = (messages: Message[]): string[] =>
+  messages.flatMap(m =>
+    Array.isArray(m.content) ? m.content.flatMap(c => (c.type === 'tool_result' ? [c.content] : [])) : []
+  );
+
+// Round 1 calls the tool malformed, round 2 retries it corrected, round 3 answers.
+const retryingProvider = (seen: string[][]): AIProvider => {
+  const rounds: MessageChunk[][] = [
+    [
+      {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}},
+      {type: 'stop', stopReason: 'tool_use'},
+    ],
+    [
+      {type: 'tool_use', toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Berlin'}}},
+      {type: 'stop', stopReason: 'tool_use'},
+    ],
+    [
+      {type: 'text', text: 'Sunny in Berlin.'},
+      {type: 'stop', stopReason: 'end_turn'},
+    ],
+  ];
+  let round = 0;
+
+  return {
+    async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      seen.push(toolResultsIn(params.messages));
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+describe('ChatOrchestrator tool input validation (acceptance)', () => {
+  it('feeds a rejected tool call back to the model, which retries and the message resolves', async () => {
+    const seen: string[][] = [];
+    const calls: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Current weather for a location',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async input => {
+        calls.push(input);
+        return `Forecast for ${String(input.location)}: sunny`;
+      }
+    );
+    const orchestrator = createChatOrchestrator(
+      retryingProvider(seen),
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      registry
+    );
+
+    const outcome = await orchestrator.processMessage(session()).catch((error: Error) => `rejected: ${error.message}`);
+
+    expect({outcome, rejectionSeenInRound2: seen[1], calls}).toEqual({
+      outcome: 'Sunny in Berlin.',
+      rejectionSeenInRound2: [expect.stringMatching(/(?=[\s\S]*location)(?=[\s\S]*required)/i)],
+      calls: [{location: 'Berlin'}],
+    });
+  });
+});
