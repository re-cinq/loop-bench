+import {ToolRegistry} from './registry.js';
+import type {ToolExecutor} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+
+// Spec: specs/hal-engine-tool-input-validation/spec.md
+
+const weatherTool: ToolDefinition = {
+  name: 'get_weather',
+  description: 'Current weather for a location',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}, customerEmail: {type: 'string'}},
+    required: ['location'],
+  },
+};
+
+// A naive executor that echoes what it was handed, so input that reaches it shows up in the result.
+const recordingExecutor = (calls: Record<string, unknown>[]): ToolExecutor => {
+  return async input => {
+    calls.push(input);
+    return `Forecast for ${JSON.stringify(input)}: sunny`;
+  };
+};
+
+// Every line any logger level receives, serialised, so a leaked value is found wherever it sits.
+const capturingLogger = (lines: string[]): Logger => {
+  const capture = (category: string, message: string, fields?: Record<string, unknown>): void =>
+    void lines.push(JSON.stringify({category, message, fields}));
+  return {debug: capture, info: capture, warn: capture, error: capture};
+};
+
+const requiresBoth = /(?=[\s\S]*location)(?=[\s\S]*required)/i;
+
+describe('ToolRegistry input validation (acceptance)', () => {
+  afterEach(() => setLogger());
+
+  it('rejects input missing a required field as a result naming it, without invoking the executor', async () => {
+    const calls: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(weatherTool, recordingExecutor(calls));
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({response, calls}).toEqual({response: {result: expect.stringMatching(requiresBoth)}, calls: []});
+  });
+
+  it('names the failing path and expected type but never a value, in the result or any log line', async () => {
+    const calls: Record<string, unknown>[] = [];
+    const lines: string[] = [];
+    setLogger(capturingLogger(lines));
+    const registry = new ToolRegistry();
+    registry.register(weatherTool, recordingExecutor(calls));
+
+    const response = await registry.execute('get_weather', {location: 4815162342, customerEmail: 'jane@example.com'});
+    const emitted = [response.result, ...lines].join('\n');
+
+    expect({
+      namesPathAndType: /(?=[\s\S]*location)(?=[\s\S]*string)/.test(response.result),
+      leaksOffendingValue: emitted.includes('4815162342'),
+      leaksIdentifyingValue: emitted.includes('jane@example.com'),
+      calls,
+    }).toEqual({namesPathAndType: true, leaksOffendingValue: false, leaksIdentifyingValue: false, calls: []});
+  });
+
+  it('throws at register time for an uncompilable schema, naming the tool', () => {
+    const registry = new ToolRegistry();
+    const broken: ToolDefinition = {
+      name: 'broken_tool',
+      description: 'declares a type no JSON Schema knows',
+      inputSchema: {type: 'object', properties: {location: {type: 'strng'}}},
+    };
+
+    const outcome = ((): string => {
+      try {
+        registry.register(broken, async () => 'never');
+        return 'registered without throwing';
+      } catch (error) {
+        return (error as Error).message;
+      }
+    })();
+
+    expect(outcome).toMatch(/broken_tool/);
+  });
+
+  it('validates a function-valued definition against the schema current at that call, not a stale one', async () => {
+    const calls: Record<string, unknown>[] = [];
+    let requiredField = 'location';
+    const registry = new ToolRegistry();
+    registry.register(
+      () => ({...weatherTool, inputSchema: {...weatherTool.inputSchema, required: [requiredField]}}),
+      recordingExecutor(calls)
+    );
+
+    await registry.execute('get_weather', {location: 'Berlin'});
+    requiredField = 'customerEmail';
+    const response = await registry.execute('get_weather', {location: 'Berlin'});
+
+    expect({response, calls}).toEqual({
+      response: {result: expect.stringMatching(/customerEmail/)},
+      calls: [{location: 'Berlin'}],
+    });
+  });
+});