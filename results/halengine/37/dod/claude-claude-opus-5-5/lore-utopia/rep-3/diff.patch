+import {ToolRegistry} from './registry.js';
+import type {ToolExecutor} from './registry.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+import type {AIProvider, MessageChunk, SendMessageParams, ToolDefinition} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+
+const weatherDefinition: ToolDefinition = {
+  name: 'get_weather',
+  description: 'Current weather for a location',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}, contact_email: {type: 'string'}},
+    required: ['location'],
+  },
+};
+
+// Echoes its input the way example/weather-tool.ts does, so a malformed call that reaches it is visible.
+const countingWeather = (): {calls: Record<string, unknown>[]; execute: ToolExecutor} => {
+  const calls: Record<string, unknown>[] = [];
+  return {
+    calls,
+    execute: async input => {
+      calls.push(input);
+      return `forecast for ${String(input.location ?? 'Unknown')}`;
+    },
+  };
+};
+
+const recordingLogger = (lines: string[]): Logger => {
+  const record = (category: string, message: string, fields?: Record<string, unknown>): void =>
+    void lines.push(JSON.stringify({category, message, fields}));
+  return {debug: record, info: record, warn: record, error: record};
+};
+
+afterEach(() => setLogger());
+
+describe('ToolRegistry.execute validates input against the registered inputSchema', () => {
+  // spec: specs/hal-engine-tool-input-validation/spec.md#1
+  it('returns a result naming the missing required property and never invokes the executor', async () => {
+    const registry = new ToolRegistry();
+    const weather = countingWeather();
+    registry.register(weatherDefinition, weather.execute);
+
+    const response = await registry.execute('get_weather', {});
+
+    expect(response.result).toMatch(/required[\s\S]*location|location[\s\S]*required/);
+    expect(weather.calls).toHaveLength(0);
+  });
+
+  // spec: specs/hal-engine-tool-input-validation/spec.md#2
+  it('rejects a wrong-typed field by path and expected type without echoing any input value to the result or the log', async () => {
+    const lines: string[] = [];
+    setLogger(recordingLogger(lines));
+    const registry = new ToolRegistry();
+    const weather = countingWeather();
+    registry.register(weatherDefinition, weather.execute);
+
+    const response = await registry.execute('get_weather', {location: 4242017, contact_email: 'jane.doe@example.com'});
+
+    expect(response.result).toMatch(/location[\s\S]*string/);
+    expect(weather.calls).toHaveLength(0);
+    for (const text of [response.result, ...lines]) {
+      expect(text).not.toContain('4242017');
+      expect(text).not.toContain('jane.doe@example.com');
+    }
+  });
+
+  // spec: specs/hal-engine-tool-input-validation/spec.md#3
+  it('throws at register time, naming the tool, when the static schema cannot be compiled', () => {
+    const registry = new ToolRegistry();
+    const broken: ToolDefinition = {
+      name: 'broken_tool',
+      description: 'declares a type that does not exist',
+      inputSchema: {type: 'object', properties: {location: {type: 'strng'}}},
+    };
+
+    expect(() => registry.register(broken, async () => 'unreachable')).toThrow(/broken_tool/);
+  });
+
+  // spec: specs/hal-engine-tool-input-validation/spec.md#4
+  it('validates a function-valued definition against the schema current at that call, not a stale one', async () => {
+    const byCity = {type: 'object', properties: {city: {type: 'string'}}, required: ['city']};
+    const byPostcode = {type: 'object', properties: {postcode: {type: 'string'}}, required: ['postcode']};
+    let current: Record<string, unknown> = byCity;
+    const registry = new ToolRegistry();
+    const weather = countingWeather();
+    registry.register(() => ({name: 'locate', description: 'switches schema', inputSchema: current}), weather.execute);
+
+    await registry.execute('locate', {city: 'Berlin'});
+    current = byPostcode;
+    const response = await registry.execute('locate', {city: 'Berlin'});
+
+    expect(response.result).toMatch(/postcode/);
+    expect(weather.calls).toEqual([{city: 'Berlin'}]);
+  });
+});
+
+describe('a rejected tool call reaches the model as a tool result it can correct', () => {
+  // spec: specs/hal-engine-tool-input-validation/spec.md#5
+  it('resolves processMessage and shows the rejection to the provider on the next round, which then retries', async () => {
+    const seenPerRound: string[] = [];
+    const rounds: MessageChunk[][] = [
+      [
+        {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Berlin'}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'text', text: 'sunny in Berlin'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ];
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        // Snapshotted: the orchestrator keeps appending to the same messages array.
+        seenPerRound.push(JSON.stringify(params.messages));
+        for (const chunk of rounds[seenPerRound.length - 1] ?? []) yield chunk;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const registry = new ToolRegistry();
+    const weather = countingWeather();
+    registry.register(weatherDefinition, weather.execute);
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), registry);
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'weather?', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+
+    const reply = await orchestrator.processMessage(session);
+
+    expect(seenPerRound[1]).toMatch(/required[\s\S]*location|location[\s\S]*required/);
+    expect(weather.calls).toEqual([{location: 'Berlin'}]);
+    expect(reply).toContain('sunny in Berlin');
+  });
+});