@@ -0,0 +1,155 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolExecutor} from './registry.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+import type {AIProvider, Message, MessageChunk, SendMessageParams, ToolDefinition} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+
+// Acceptance tests for re-cinq/HALEngine#37 (specs/hal-engine-tool-input-validation/spec.md).
+
+const WEATHER: ToolDefinition = {
+  name: 'get_weather',
+  description: 'Current weather for a location',
+  inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+};
+
+const PROFILE: ToolDefinition = {
+  name: 'update_profile',
+  description: 'Updates a contact profile',
+  inputSchema: {
+    type: 'object',
+    properties: {email: {type: 'string'}, age: {type: 'integer'}},
+    required: ['email', 'age'],
+  },
+};
+
+const recordingExecutor = (): {inputs: Record<string, unknown>[]; execute: ToolExecutor} => {
+  const inputs: Record<string, unknown>[] = [];
+  return {
+    inputs,
+    execute: async input => {
+      inputs.push(input);
+      return `Forecast for ${String(input.location)}: sunny`;
+    },
+  };
+};
+
+const recordingLogger = (lines: string[]): Logger => {
+  const record = (category: string, message: string, fields?: Record<string, unknown>): void =>
+    void lines.push(JSON.stringify({category, message, fields}));
+  return {debug: record, info: record, warn: record, error: record};
+};
+
+afterEach(() => setLogger());
+
+describe('ToolRegistry input validation', () => {
+  it('returns a rejection naming the missing required property and never runs the executor', async () => {
+    const registry = new ToolRegistry();
+    const executor = recordingExecutor();
+    registry.register(WEATHER, executor.execute);
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({
+      executorCalls: executor.inputs.length,
+      namesLocation: response.result.includes('location'),
+      saysRequired: /required/i.test(response.result),
+    }).toEqual({executorCalls: 0, namesLocation: true, saysRequired: true});
+  });
+
+  it('rejects a wrong-typed field by path and expected type without echoing any input value to the result or the log', async () => {
+    const lines: string[] = [];
+    setLogger(recordingLogger(lines));
+    const registry = new ToolRegistry();
+    const executor = recordingExecutor();
+    registry.register(PROFILE, executor.execute);
+    const values = ['jane.doe@example.org', 'forty-two'];
+
+    const response = await registry.execute('update_profile', {email: values[0], age: values[1]});
+    const emitted = [response.result, ...lines];
+
+    expect({
+      executorCalls: executor.inputs.length,
+      namesPath: response.result.includes('age'),
+      namesExpectedType: response.result.includes('integer'),
+      leakedValues: values.filter(value => emitted.some(text => text.includes(value))),
+    }).toEqual({executorCalls: 0, namesPath: true, namesExpectedType: true, leakedValues: []});
+  });
+
+  it('throws at register time for an uncompilable inputSchema, naming the tool', () => {
+    const registry = new ToolRegistry();
+    const broken: ToolDefinition = {
+      name: 'broken_tool',
+      description: 'Declares a type that does not exist',
+      inputSchema: {type: 'object', properties: {location: {type: 'strin'}}},
+    };
+
+    const outcome = (() => {
+      try {
+        registry.register(broken, recordingExecutor().execute);
+        return 'registered without throwing';
+      } catch (error) {
+        return (error as Error).message;
+      }
+    })();
+
+    expect(outcome).toMatch(/broken_tool/);
+  });
+});
+
+describe('ChatOrchestrator with a rejected tool call', () => {
+  it('feeds the rejection back to the provider and resolves after a corrected retry', async () => {
+    const seenByProvider: Message[][] = [];
+    const rounds: MessageChunk[][] = [
+      [
+        {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Berlin'}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'text', text: 'It is sunny in Berlin.'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ];
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        seenByProvider.push(structuredClone(params.messages));
+        for (const chunk of rounds[round++] ?? []) yield chunk;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const registry = new ToolRegistry();
+    const executor = recordingExecutor();
+    registry.register(WEATHER, executor.execute);
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), registry);
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'weather?', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+
+    const text = await orchestrator.processMessage(session).catch((error: Error) => `rejected: ${error.message}`);
+    const firstToolResult = (seenByProvider[1] ?? [])
+      .flatMap(message => (Array.isArray(message.content) ? message.content : []))
+      .find(block => block.type === 'tool_result');
+    const rejection = firstToolResult && 'content' in firstToolResult ? String(firstToolResult.content) : '';
+
+    expect({
+      text,
+      rejectionNamesLocation: rejection.includes('location') && /required/i.test(rejection),
+      executorInputs: executor.inputs,
+    }).toEqual({
+      text: 'It is sunny in Berlin.',
+      rejectionNamesLocation: true,
+      executorInputs: [{location: 'Berlin'}],
+    });
+  });
+});