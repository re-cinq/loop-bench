+import {ToolRegistry} from './registry.js';
+import type {AIProvider, Message, MessageChunk, SendMessageParams, ToolDefinition} from '../../types/ai.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+
+// Acceptance tests for specs/hal-engine-tool-input-validation/spec.md (re-cinq/HALEngine#37).
+
+const weather: ToolDefinition = {
+  name: 'get_weather',
+  description: 'Current weather for a location',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}, email: {type: 'string'}},
+    required: ['location'],
+  },
+};
+
+const recordingExecutor = (calls: Record<string, unknown>[]) => async (input: Record<string, unknown>) => {
+  calls.push(input);
+  return `forecast for ${String(input.location)}`;
+};
+
+describe('ToolRegistry input validation (specs/hal-engine-tool-input-validation#1)', () => {
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('returns a rejection naming the missing required property and never calls the executor', async () => {
+    const calls: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(weather, recordingExecutor(calls));
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({mentionsLocation: /location/.test(response.result), executorCalls: calls.length}).toEqual({
+      mentionsLocation: true,
+      executorCalls: 0,
+    });
+  });
+
+  it('rejects a wrong-typed field by path and expected type without echoing any input value into the result or logs', async () => {
+    const lines: string[] = [];
+    const collect = (category: string, message: string, fields?: Record<string, unknown>) =>
+      void lines.push(JSON.stringify({category, message, fields}));
+    const logger: Logger = {debug: collect, info: collect, warn: collect, error: collect};
+    setLogger(logger);
+    const calls: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(weather, recordingExecutor(calls));
+
+    const response = await registry.execute('get_weather', {location: 90210, email: 'jane.doe@example.com'});
+    const emitted = [response.result, ...lines].join('\n');
+
+    expect({
+      namesPath: /location/.test(response.result),
+      namesExpectedType: /string/.test(response.result),
+      leaksNumber: emitted.includes('90210'),
+      leaksEmail: emitted.includes('jane.doe@example.com'),
+      executorCalls: calls.length,
+    }).toEqual({namesPath: true, namesExpectedType: true, leaksNumber: false, leaksEmail: false, executorCalls: 0});
+  });
+
+  it('throws at register time for an uncompilable schema, naming the tool', () => {
+    const registry = new ToolRegistry();
+    const broken: ToolDefinition = {
+      name: 'broken_tool',
+      description: 'declares a type JSON Schema does not have',
+      inputSchema: {type: 'object', properties: {location: {type: 'strng'}}},
+    };
+
+    expect(() => registry.register(broken, async () => 'never')).toThrow(/broken_tool/);
+  });
+});
+
+describe('Tool loop with a rejected call (specs/hal-engine-tool-input-validation#2)', () => {
+  it('resolves after a rejected call and a corrected retry, showing the rejection to the provider and passing the retry through unchanged', async () => {
+    const seenByProvider: Message[][] = [];
+    const rounds: MessageChunk[][] = [
+      [
+        {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Berlin', units: 'C'}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'text', text: 'Sunny in Berlin'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ];
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        seenByProvider.push(JSON.parse(JSON.stringify(params.messages)) as Message[]);
+        for (const chunk of rounds[round++] ?? []) yield chunk;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const calls: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(weather, recordingExecutor(calls));
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), registry);
+
+    const outcome = await orchestrator
+      .processMessage({sessionId: 's1', userId: 'u1', entries: [{role: 'user', content: 'weather?', timestamp: ''}]})
+      .then(text => ({resolved: text}))
+      .catch((error: Error) => ({rejected: error.message}));
+    const secondRound = JSON.stringify(seenByProvider[1] ?? []);
+
+    expect({
+      outcome,
+      rejectionVisibleOnNextRound: /call-1/.test(secondRound) && /location/.test(secondRound),
+      executorInputs: calls,
+    }).toEqual({
+      outcome: {resolved: 'Sunny in Berlin'},
+      rejectionVisibleOnNextRound: true,
+      executorInputs: [{location: 'Berlin', units: 'C'}],
+    });
+  });
+});