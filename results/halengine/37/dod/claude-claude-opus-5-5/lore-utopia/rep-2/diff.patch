+import {ToolRegistry} from './registry.js';
+import type {ToolExecutor} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+
+// Acceptance tests for re-cinq/HALEngine#37 (specs/hal-engine-tool-input-validation/spec.md).
+
+const WEATHER = {
+  name: 'get_weather',
+  description: 'Current weather for a place',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}, phone: {type: 'string'}},
+    required: ['location'],
+  },
+};
+
+const recordingExecutor = (): {calls: Record<string, unknown>[]; execute: ToolExecutor} => {
+  const calls: Record<string, unknown>[] = [];
+  const execute: ToolExecutor = async input => {
+    calls.push(input);
+    return `forecast for ${String(input.location)}`;
+  };
+  return {calls, execute};
+};
+
+const recordingLogger = (lines: string[]): Logger => {
+  const record = (category: string, message: string, fields?: Record<string, unknown>): void => {
+    lines.push(`${category} ${message} ${JSON.stringify(fields ?? {})}`);
+  };
+  return {debug: record, info: record, warn: record, error: record};
+};
+
+afterEach(() => setLogger());
+
+describe('ToolRegistry.execute input validation', () => {
+  it('returns a rejection naming the missing required property and never invokes the executor', async () => {
+    const registry = new ToolRegistry();
+    const tool = recordingExecutor();
+    registry.register(WEATHER, tool.execute);
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({
+      namesLocation: response.result.includes('location'),
+      saysRequired: /required/i.test(response.result),
+      executorCalls: tool.calls.length,
+    }).toEqual({namesLocation: true, saysRequired: true, executorCalls: 0});
+  });
+
+  it('rejects a wrong-typed field by path and expected type without echoing its value in the result or any log line', async () => {
+    const identifying = 4155550123;
+    const lines: string[] = [];
+    setLogger(recordingLogger(lines));
+    const registry = new ToolRegistry();
+    const tool = recordingExecutor();
+    registry.register(WEATHER, tool.execute);
+
+    const response = await registry.execute('get_weather', {location: 'Berlin', phone: identifying});
+
+    expect({
+      namesPath: response.result.includes('phone'),
+      namesExpectedType: response.result.includes('string'),
+      valueInResult: response.result.includes(String(identifying)),
+      valueInLogs: lines.some(line => line.includes(String(identifying))),
+      executorCalls: tool.calls.length,
+    }).toEqual({namesPath: true, namesExpectedType: true, valueInResult: false, valueInLogs: false, executorCalls: 0});
+  });
+});