+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, Message, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+// Acceptance test for re-cinq/HALEngine#37 (specs/hal-engine-tool-input-validation/spec.md).
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const session: ChatSession = {
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'weather?', timestamp: SENT_AT}],
+};
+
+const toolResultsIn = (messages: Message[]): string[] =>
+  messages.flatMap(m =>
+    typeof m.content === 'string' ? [] : m.content.flatMap(c => (c.type === 'tool_result' ? [c.content] : []))
+  );
+
+describe('ChatOrchestrator with a schema-rejected tool call', () => {
+  it('resolves after a rejected call and a corrected retry, with the rejection visible to the provider', async () => {
+    const rounds: MessageChunk[][] = [
+      [
+        {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Berlin'}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'text', text: 'sunny'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ];
+    const seenToolResults: string[][] = [];
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        seenToolResults.push(toolResultsIn(params.messages));
+        for (const chunk of rounds[round++] ?? []) yield chunk;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const executorInputs: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Current weather for a place',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async input => {
+        executorInputs.push(input);
+        return `forecast for ${String(input.location)}`;
+      }
+    );
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), registry);
+
+    const outcome = await orchestrator
+      .processMessage(session)
+      .then(text => `resolved: ${text}`)
+      .catch((error: Error) => `rejected: ${error.message}`);
+
+    expect({
+      outcome,
+      rejectionSeenOnRound2: (seenToolResults[1] ?? []).some(r => r.includes('location') && /required/i.test(r)),
+      executorInputs,
+    }).toEqual({outcome: 'resolved: sunny', rejectionSeenOnRound2: true, executorInputs: [{location: 'Berlin'}]});
+  });
+});
