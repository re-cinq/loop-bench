+import {ToolRegistry} from './registry.js';
+import type {ToolExecutor} from './registry.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+import type {AIProvider, MessageChunk, SendMessageParams, ToolDefinition} from '../../types/ai.js';
+
+const WEATHER: ToolDefinition = {
+  name: 'get_weather',
+  description: 'Current weather for a location',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}},
+    required: ['location'],
+  },
+};
+
+const countingExecutor = (): {calls: Record<string, unknown>[]; execute: ToolExecutor} => {
+  const calls: Record<string, unknown>[] = [];
+  const execute: ToolExecutor = async input => {
+    calls.push(input);
+    return `sunny in ${String(input.location)}`;
+  };
+  return {calls, execute};
+};
+
+const recordingLogger = (lines: string[]): Logger => {
+  const record = (category: string, message: string, fields?: Record<string, unknown>): void =>
+    void lines.push(JSON.stringify({category, message, fields}));
+  return {debug: record, info: record, warn: record, error: record};
+};
+
+describe('ToolRegistry.execute validates input against the registered inputSchema', () => {
+  afterEach(() => setLogger());
+
+  it('returns a rejection naming the missing required property and never runs the executor', async () => {
+    const registry = new ToolRegistry();
+    const tool = countingExecutor();
+    registry.register(WEATHER, tool.execute);
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({result: response.result, calls: tool.calls.length}).toEqual({
+      result: expect.stringMatching(/location[\s\S]*required|required[\s\S]*location/),
+      calls: 0,
+    });
+  });
+
+  it('rejects a wrong-typed field by path and expected type without echoing the value in the result or the logs', async () => {
+    const lines: string[] = [];
+    setLogger(recordingLogger(lines));
+    const registry = new ToolRegistry();
+    const tool = countingExecutor();
+    registry.register(WEATHER, tool.execute);
+    const identifying = 4155550123;
+
+    const response = await registry.execute('get_weather', {location: identifying});
+
+    expect({
+      namesPathAndType: /location/.test(response.result) && /string/.test(response.result),
+      resultLeaksValue: response.result.includes(String(identifying)),
+      logLeaksValue: lines.some(line => line.includes(String(identifying))),
+      calls: tool.calls.length,
+    }).toEqual({namesPathAndType: true, resultLeaksValue: false, logLeaksValue: false, calls: 0});
+  });
+
+  it('throws at register time for an uncompilable schema, naming the tool', () => {
+    const registry = new ToolRegistry();
+    const broken: ToolDefinition = {
+      name: 'broken_tool',
+      description: 'declares a schema no validator can compile',
+      inputSchema: {type: 'object', properties: {location: {type: 'not-a-json-schema-type'}}},
+    };
+
+    expect(() => registry.register(broken, async () => 'never')).toThrow(/broken_tool/);
+  });
+});
+
+describe('a rejected tool call is returned to the model rather than ending the conversation', () => {
+  it('resolves processMessage after a rejected call and a corrected retry, showing the provider the rejection', async () => {
+    const seen: SendMessageParams[] = [];
+    const rounds: MessageChunk[][] = [
+      [
+        {type: 'tool_use', toolCall: {id: 'bad', name: 'get_weather', input: {}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'good', name: 'get_weather', input: {location: 'Berlin'}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'text', text: 'It is sunny in Berlin.'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ];
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        seen.push(JSON.parse(JSON.stringify(params)) as SendMessageParams);
+        for (const chunk of rounds[round++] ?? []) yield chunk;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const registry = new ToolRegistry();
+    registry.register(WEATHER, async input => `sunny in ${String(input.location)}`);
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), registry);
+
+    const outcome = await orchestrator
+      .processMessage({
+        sessionId: 's1',
+        userId: 'u1',
+        entries: [{role: 'user', content: 'weather?', timestamp: '2026-01-01T00:00:00.000Z'}],
+      })
+      .then(
+        text => ({resolved: text}),
+        (error: Error) => ({rejected: error.message})
+      );
+    const rejectionShownToModel = JSON.stringify(seen[1]?.messages.at(-1) ?? null);
+
+    expect({outcome, rejectionNamesField: /location/.test(rejectionShownToModel)}).toEqual({
+      outcome: {resolved: expect.stringContaining('It is sunny in Berlin.')},
+      rejectionNamesField: true,
+    });
+  });
+});