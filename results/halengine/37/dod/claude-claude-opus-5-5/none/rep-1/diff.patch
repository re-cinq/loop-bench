+import type {ToolDefinition} from '../../types/ai.js';
+import {setLogger} from '../../shared/logger.js';
+import {ToolRegistry} from './registry.js';
+import type {ToolExecutor} from './registry.js';
+
+// Acceptance for re-cinq/HALEngine#37: specs/hal-engine-tool-input-validation/spec.md.
+
+const WEATHER: ToolDefinition = {
+  name: 'get_weather',
+  description: 'Current weather for a location',
+  inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+};
+
+// A real executor that records what reached it, so "never invoked" is a count rather than a spy.
+const recordingExecutor = (): {calls: Record<string, unknown>[]; execute: ToolExecutor} => {
+  const calls: Record<string, unknown>[] = [];
+  const execute: ToolExecutor = async input => {
+    calls.push(input);
+    return 'Sunny, 21C';
+  };
+  return {calls, execute};
+};
+
+// Every line the engine logs, flattened to text, so a leaked value is a substring search.
+const recordLogLines = (): string[] => {
+  const lines: string[] = [];
+  const record = (category: string, message: string, fields?: Record<string, unknown>) =>
+    void lines.push(JSON.stringify({category, message, fields}));
+  setLogger({debug: record, info: record, warn: record, error: record});
+  return lines;
+};
+
+describe('ToolRegistry input validation (acceptance)', () => {
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('returns a rejection naming the missing required location and never runs the executor', async () => {
+    const registry = new ToolRegistry();
+    const executor = recordingExecutor();
+    registry.register(WEATHER, executor.execute);
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({
+      namesLocation: response.result.includes('location'),
+      saysRequired: /required/i.test(response.result),
+      executorCalls: executor.calls.length,
+    }).toEqual({namesLocation: true, saysRequired: true, executorCalls: 0});
+  });
+
+  it('rejects a wrong-typed identifying field by path and expected type without echoing its value anywhere', async () => {
+    const phone = 4155550199;
+    const registry = new ToolRegistry();
+    const executor = recordingExecutor();
+    registry.register(
+      {
+        name: 'call_back',
+        description: 'Schedule a call back',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}, phone: {type: 'string'}},
+          required: ['location', 'phone'],
+        },
+      },
+      executor.execute
+    );
+    const lines = recordLogLines();
+
+    const response = await registry.execute('call_back', {location: 'Berlin', phone});
+
+    expect({
+      namesPhone: response.result.includes('phone'),
+      namesExpectedType: response.result.includes('string'),
+      valueInResult: response.result.includes(String(phone)),
+      valueInLogs: lines.some(line => line.includes(String(phone))),
+      executorCalls: executor.calls.length,
+    }).toEqual({namesPhone: true, namesExpectedType: true, valueInResult: false, valueInLogs: false, executorCalls: 0});
+  });
+
+  it('throws at register time for a schema that cannot compile, naming the tool', () => {
+    const registry = new ToolRegistry();
+    const broken: ToolDefinition = {
+      name: 'broken_tool',
+      description: 'Declares a type no JSON Schema validator knows',
+      inputSchema: {type: 'object', properties: {location: {type: 'not-a-json-schema-type'}}},
+    };
+
+    expect(() => registry.register(broken, recordingExecutor().execute)).toThrow(/broken_tool/);
+  });
+
+  it('validates a function-valued definition against the schema current at that call, not a stale one', async () => {
+    const registry = new ToolRegistry();
+    const executor = recordingExecutor();
+    let requiredField = 'location';
+    registry.register(
+      () => ({
+        name: 'lookup',
+        description: 'Looks something up',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}, query: {type: 'string'}},
+          required: [requiredField],
+        },
+      }),
+      executor.execute
+    );
+
+    await registry.execute('lookup', {location: 'Berlin'});
+    requiredField = 'query';
+    const response = await registry.execute('lookup', {location: 'Berlin'});
+
+    expect({namesQuery: response.result.includes('query'), executorCalls: executor.calls.length}).toEqual({
+      namesQuery: true,
+      executorCalls: 1,
+    });
+  });
+});