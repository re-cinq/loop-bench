+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+// Acceptance for re-cinq/HALEngine#37: specs/hal-engine-tool-input-validation/spec.md.
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const session = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'weather in Berlin?', timestamp: SENT_AT}],
+});
+
+// Plays one scripted round per call and records the tool results each round was sent.
+const scriptedProvider = (rounds: MessageChunk[][]): {provider: AIProvider; toolResultsSeen: string[][]} => {
+  const toolResultsSeen: string[][] = [];
+  let round = 0;
+
+  return {
+    toolResultsSeen,
+    provider: {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        toolResultsSeen.push(
+          params.messages.flatMap(m =>
+            Array.isArray(m.content) ? m.content.flatMap(c => (c.type === 'tool_result' ? [c.content] : [])) : []
+          )
+        );
+        for (const chunk of rounds[round++] ?? []) yield chunk;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    },
+  };
+};
+
+describe('ChatOrchestrator tool loop with a schema-rejected call (acceptance)', () => {
+  it('resolves after a rejected call and its corrected retry, with the rejection visible to the provider', async () => {
+    const executorInputs: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Current weather for a location',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async input => {
+        executorInputs.push(input);
+        return `Sunny in ${String(input.location)}`;
+      }
+    );
+    const {provider, toolResultsSeen} = scriptedProvider([
+      [
+        {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Berlin'}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'text', text: 'It is sunny in Berlin.'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ]);
+    const orchestrator = createChatOrchestrator(
+      provider,
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      registry
+    );
+
+    const text = await orchestrator.processMessage(session()).catch((error: Error) => `rejected: ${error.message}`);
+    const rejectionSeen = toolResultsSeen[1]?.[0] ?? '';
+
+    expect({
+      text,
+      rejectionNamesLocation: rejectionSeen.includes('location'),
+      rejectionSaysRequired: /required/i.test(rejectionSeen),
+      executorInputs,
+    }).toEqual({
+      text: 'It is sunny in Berlin.',
+      rejectionNamesLocation: true,
+      rejectionSaysRequired: true,
+      executorInputs: [{location: 'Berlin'}],
+    });
+  });
+});
