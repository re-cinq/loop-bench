@@ -0,0 +1,107 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolExecutor} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+// A real executor that records what reached it, so "never invoked" is a count rather than a spy.
+const recordingExecutor = (): {calls: Record<string, unknown>[]; execute: ToolExecutor} => {
+  const calls: Record<string, unknown>[] = [];
+  const execute: ToolExecutor = async input => {
+    calls.push(input);
+    return `forecast for ${String(input.location)}`;
+  };
+  return {calls, execute};
+};
+
+// Every line the registry logs, serialised, so a test can search them for a leaked value.
+const recordingLogger = (): {lines: string[]; logger: Logger} => {
+  const lines: string[] = [];
+  const record = (category: string, message: string, fields?: Record<string, unknown>) =>
+    void lines.push(JSON.stringify({category, message, fields}));
+  return {lines, logger: {debug: record, info: record, warn: record, error: record}};
+};
+
+const weather = (properties: Record<string, unknown>, required: string[]): ToolDefinition => ({
+  name: 'get_weather',
+  description: 'Gets the weather',
+  inputSchema: {type: 'object', properties, required},
+});
+
+afterEach(() => setLogger());
+
+describe('ToolRegistry input validation', () => {
+  it('answers input missing a required property with a result naming it, and never runs the executor', async () => {
+    const registry = new ToolRegistry();
+    const tool = recordingExecutor();
+    registry.register(weather({location: {type: 'string'}}, ['location']), tool.execute);
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({
+      namesLocation: response.result.includes('location'),
+      saysRequired: /required/i.test(response.result),
+      executorCalls: tool.calls.length,
+    }).toEqual({namesLocation: true, saysRequired: true, executorCalls: 0});
+  });
+
+  it('rejects a wrong-typed field by path and expected type without echoing its value in the result or the logs', async () => {
+    const identifying = 4155550123;
+    const registry = new ToolRegistry();
+    const tool = recordingExecutor();
+    const logs = recordingLogger();
+    setLogger(logs.logger);
+    registry.register(
+      weather({location: {type: 'string'}, phone: {type: 'string'}}, ['location', 'phone']),
+      tool.execute
+    );
+
+    const response = await registry.execute('get_weather', {location: 'Berlin', phone: identifying});
+
+    expect({
+      namesPath: response.result.includes('phone'),
+      namesExpectedType: response.result.includes('string'),
+      resultLeaksValue: response.result.includes(String(identifying)),
+      logsLeakValue: logs.lines.some(line => line.includes(String(identifying))),
+      executorCalls: tool.calls.length,
+    }).toEqual({
+      namesPath: true,
+      namesExpectedType: true,
+      resultLeaksValue: false,
+      logsLeakValue: false,
+      executorCalls: 0,
+    });
+  });
+
+  it('throws at register time for a schema that cannot compile, naming the tool', () => {
+    const registry = new ToolRegistry();
+    const broken = weather({location: {type: 'strng'}}, ['location']);
+
+    const thrown = (() => {
+      try {
+        registry.register(broken, recordingExecutor().execute);
+        return 'registered without throwing';
+      } catch (error) {
+        return (error as Error).message;
+      }
+    })();
+
+    expect(thrown).toContain('get_weather');
+  });
+
+  it('validates a function-valued definition against the schema current at each call', async () => {
+    const registry = new ToolRegistry();
+    const tool = recordingExecutor();
+    let current = weather({location: {type: 'string'}}, ['location']);
+    registry.register(() => current, tool.execute);
+
+    await registry.execute('get_weather', {location: 'Berlin'});
+    current = weather({city: {type: 'string'}}, ['city']);
+    const second = await registry.execute('get_weather', {location: 'Berlin'});
+
+    expect({executed: tool.calls, secondNamesCity: second.result.includes('city')}).toEqual({
+      executed: [{location: 'Berlin'}],
+      secondNamesCity: true,
+    });
+  });
+});