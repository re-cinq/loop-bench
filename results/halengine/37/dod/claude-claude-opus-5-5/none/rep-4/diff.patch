+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, Message, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const session: ChatSession = {
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'weather please', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+// Round one sends a call missing `location`, round two the corrected call, round three the answer.
+const ROUNDS: MessageChunk[][] = [
+  [
+    {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}},
+    {type: 'stop', stopReason: 'tool_use'},
+  ],
+  [
+    {type: 'tool_use', toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Berlin'}}},
+    {type: 'stop', stopReason: 'tool_use'},
+  ],
+  [
+    {type: 'text', text: 'Sunny in Berlin'},
+    {type: 'stop', stopReason: 'end_turn'},
+  ],
+];
+
+// Records the messages each round was sent, so a test can read what the model saw.
+const scriptedProvider = (): {provider: AIProvider; sent: Message[][]} => {
+  const sent: Message[][] = [];
+  const provider: AIProvider = {
+    async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      sent.push([...params.messages]);
+      for (const chunk of ROUNDS[sent.length - 1] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  return {provider, sent};
+};
+
+const toolResultsIn = (messages: Message[]): string[] =>
+  messages.flatMap(m =>
+    typeof m.content === 'string' ? [] : m.content.flatMap(c => (c.type === 'tool_result' ? [c.content] : []))
+  );
+
+describe('ChatOrchestrator tool loop with input validation', () => {
+  it('resolves after a rejected tool call and shows the rejection to the provider on the next round', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Gets the weather',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async input => `forecast for ${String(input.location)}`
+    );
+    const {provider, sent} = scriptedProvider();
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), registry);
+
+    const outcome = await orchestrator.processMessage(session).catch((error: Error) => `rejected: ${error.message}`);
+    const firstResult = toolResultsIn(sent[1] ?? []).join('\n');
+
+    expect({
+      outcome,
+      rejectionNamesLocation: firstResult.includes('location'),
+      rejectionSaysRequired: /required/i.test(firstResult),
+      rejectionIsNotAForecast: !firstResult.includes('forecast for'),
+    }).toEqual({
+      outcome: 'Sunny in Berlin',
+      rejectionNamesLocation: true,
+      rejectionSaysRequired: true,
+      rejectionIsNotAForecast: true,
+    });
+  });
+});
