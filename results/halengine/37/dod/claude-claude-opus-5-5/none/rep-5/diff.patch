+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {AIProvider, Message, MessageChunk, SendMessageParams, ToolDefinition} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+import {ToolRegistry} from './registry.js';
+import type {ToolExecutor} from './registry.js';
+
+// Acceptance tests for specs/hal-engine-tool-input-validation/spec.md (issue #37).
+
+const WEATHER: ToolDefinition = {
+  name: 'get_weather',
+  description: 'Current weather for a location',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}, email: {type: 'string'}},
+    required: ['location'],
+  },
+};
+
+// A real executor that records what reached it, so "never invoked" is a count rather than a spy.
+const recordingExecutor = (): {calls: Record<string, unknown>[]; execute: ToolExecutor} => {
+  const calls: Record<string, unknown>[] = [];
+  const execute: ToolExecutor = async input => {
+    calls.push(input);
+    return `forecast for ${String(input.location)}`;
+  };
+  return {calls, execute};
+};
+
+const resultTextIn = (messages: Message[]): string =>
+  messages
+    .flatMap(m => (typeof m.content === 'string' ? [] : m.content))
+    .map(block => (block.type === 'tool_result' ? block.content : ''))
+    .join('\n');
+
+describe('ToolRegistry input validation (specs/hal-engine-tool-input-validation/spec.md)', () => {
+  it('returns a missing required property to the caller as a ToolResponse and never runs the executor', async () => {
+    const registry = new ToolRegistry();
+    const tool = recordingExecutor();
+    registry.register(WEATHER, tool.execute);
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({names: response.result.includes('location'), says: /required/i.test(response.result)}).toEqual({
+      names: true,
+      says: true,
+    });
+    expect(tool.calls).toHaveLength(0);
+  });
+
+  it('names the path and expected type of a wrong-typed property without echoing any input value', async () => {
+    const lines: string[] = [];
+    const record = (...args: unknown[]) => void lines.push(JSON.stringify(args));
+    setLogger({debug: record, info: record, warn: record, error: record});
+    const registry = new ToolRegistry();
+    const tool = recordingExecutor();
+    registry.register(WEATHER, tool.execute);
+
+    try {
+      const response = await registry.execute('get_weather', {location: 90210, email: 'jane.doe@example.com'});
+
+      expect({
+        namesPath: response.result.includes('location'),
+        namesType: response.result.includes('string'),
+        echoesValue: response.result.includes('90210') || response.result.includes('jane.doe@example.com'),
+        loggedValue: lines.some(line => line.includes('90210') || line.includes('jane.doe@example.com')),
+        executorCalls: tool.calls.length,
+      }).toEqual({namesPath: true, namesType: true, echoesValue: false, loggedValue: false, executorCalls: 0});
+    } finally {
+      setLogger();
+    }
+  });
+
+  it('throws at register time, naming the tool, for a schema that cannot compile', () => {
+    const registry = new ToolRegistry();
+    const broken: ToolDefinition = {
+      name: 'broken_tool',
+      description: 'declares a type JSON Schema does not have',
+      inputSchema: {type: 'object', properties: {location: {type: 'strng'}}},
+    };
+
+    expect(() => registry.register(broken, recordingExecutor().execute)).toThrow(/broken_tool/);
+  });
+
+  it('validates a function-valued definition against the schema it returns at that call, not a cached one', async () => {
+    let required = 'location';
+    const registry = new ToolRegistry();
+    const tool = recordingExecutor();
+    registry.register(
+      () => ({...WEATHER, inputSchema: {type: 'object', properties: {}, required: [required]}}),
+      tool.execute
+    );
+
+    await registry.execute('get_weather', {location: 'Berlin'});
+    required = 'city';
+    const second = await registry.execute('get_weather', {location: 'Berlin'});
+
+    expect({namesCity: second.result.includes('city'), executorCalls: tool.calls.length}).toEqual({
+      namesCity: true,
+      executorCalls: 1,
+    });
+  });
+
+  it('lets the model read a rejection and retry within the tool loop, passing the corrected input through unchanged', async () => {
+    const seen: Message[][] = [];
+    const call = (id: string, input: Record<string, unknown>): MessageChunk => ({
+      type: 'tool_use',
+      toolCall: {id, name: 'get_weather', input},
+    });
+    const rounds: MessageChunk[][] = [
+      [call('call-1', {}), {type: 'stop', stopReason: 'tool_use'}],
+      [call('call-2', {location: 'Berlin', units: 'metric'}), {type: 'stop', stopReason: 'tool_use'}],
+      [
+        {type: 'text', text: 'Sunny in Berlin'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ];
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        seen.push([...params.messages]);
+        for (const chunk of rounds[round++] ?? []) yield chunk;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const registry = new ToolRegistry();
+    const tool = recordingExecutor();
+    registry.register(WEATHER, tool.execute);
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'weather?', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), registry);
+
+    const text = await orchestrator.processMessage(session);
+
+    expect({
+      text,
+      rejectionVisibleNextRound:
+        /location/.test(resultTextIn(seen[1] ?? [])) && /required/i.test(resultTextIn(seen[1] ?? [])),
+      executorCalls: tool.calls,
+    }).toEqual({
+      text: 'Sunny in Berlin',
+      rejectionVisibleNextRound: true,
+      executorCalls: [{location: 'Berlin', units: 'metric'}],
+    });
+  });
+});