+// Acceptance tests for re-cinq/HALEngine#37 (specs/hal-engine-tool-input-validation/spec.md).
+import {ToolRegistry} from './registry.js';
+import type {ToolExecutor} from './registry.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../../types/ai.js';
+
+const WEATHER = {
+  name: 'get_weather',
+  description: 'Current weather for a location',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}},
+    required: ['location'],
+  },
+};
+
+// Records every call it receives, so a test can count them without a double.
+const recordingExecutor = (): {calls: Record<string, unknown>[]; execute: ToolExecutor} => {
+  const calls: Record<string, unknown>[] = [];
+  return {calls, execute: async input => (calls.push(input), `Forecast for ${String(input.location)}`)};
+};
+
+const capturedLogLines = (): {lines: string[]; logger: Logger} => {
+  const lines: string[] = [];
+  const record = (category: string, message: string, fields?: Record<string, unknown>): void =>
+    void lines.push(JSON.stringify({category, message, fields}));
+  return {lines, logger: {debug: record, info: record, warn: record, error: record}};
+};
+
+afterEach(() => setLogger());
+
+describe('ToolRegistry input validation (specs/hal-engine-tool-input-validation/spec.md)', () => {
+  it('rejects input missing a required property with a result naming it, without invoking the executor', async () => {
+    const registry = new ToolRegistry();
+    const tool = recordingExecutor();
+    registry.register(WEATHER, tool.execute);
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({result: response.result, executorCalls: tool.calls.length}).toEqual({
+      result: expect.stringMatching(/location[\s\S]*required|required[\s\S]*location/),
+      executorCalls: 0,
+    });
+  });
+
+  it('rejects a wrong-typed property naming its path and expected type, never its value in result or logs', async () => {
+    const phoneNumber = 4155550123;
+    const registry = new ToolRegistry();
+    const tool = recordingExecutor();
+    registry.register(WEATHER, tool.execute);
+    const captured = capturedLogLines();
+    setLogger(captured.logger);
+
+    const response = await registry.execute('get_weather', {location: phoneNumber});
+
+    expect({
+      namesPathAndType: /location/.test(response.result) && /string/.test(response.result),
+      leaksValueInResult: response.result.includes(String(phoneNumber)),
+      leaksValueInLogs: captured.lines.some(line => line.includes(String(phoneNumber))),
+      executorCalls: tool.calls.length,
+    }).toEqual({namesPathAndType: true, leaksValueInResult: false, leaksValueInLogs: false, executorCalls: 0});
+  });
+
+  it('throws at register time for an uncompilable schema, naming the tool', () => {
+    const registry = new ToolRegistry();
+    const broken = {...WEATHER, name: 'broken_tool', inputSchema: {type: 'not-a-json-schema-type'}};
+
+    expect(() => registry.register(broken, recordingExecutor().execute)).toThrow(/broken_tool/);
+  });
+});
+
+describe('ChatOrchestrator tool loop with a rejected call (specs/hal-engine-tool-input-validation/spec.md)', () => {
+  it('feeds the rejection to the provider, runs the corrected retry, and resolves processMessage', async () => {
+    const seen: SendMessageParams[] = [];
+    const rounds: MessageChunk[][] = [
+      [
+        {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Paris'}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'text', text: 'Sunny in Paris'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ];
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        seen.push(structuredClone(params));
+        for (const chunk of rounds[seen.length - 1] ?? []) yield chunk;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const registry = new ToolRegistry();
+    const tool = recordingExecutor();
+    registry.register(WEATHER, tool.execute);
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), registry);
+
+    const text = await orchestrator.processMessage({
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'weather?', timestamp: '2026-01-01T00:00:00.000Z'}],
+    });
+
+    expect({
+      text,
+      secondRoundSawRejection: /required/.test(JSON.stringify(seen[1]?.messages ?? [])),
+      executorCalls: tool.calls,
+    }).toEqual({text: 'Sunny in Paris', secondRoundSawRejection: true, executorCalls: [{location: 'Paris'}]});
+  });
+});