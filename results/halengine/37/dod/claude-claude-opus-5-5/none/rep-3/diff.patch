@@ -0,0 +1,153 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolExecutor} from './registry.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {AIProvider, Message, MessageChunk, ToolDefinition, ToolResultContent} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+
+// Acceptance tests for specs/hal-engine-tool-input-validation/spec.md (re-cinq/HALEngine#37).
+
+const weatherTool: ToolDefinition = {
+  name: 'get_weather',
+  description: 'Current weather for a location',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}, email: {type: 'string'}},
+    required: ['location'],
+  },
+};
+
+// Echoes its input the way example/weather-tool.ts does, and counts what reached it.
+const recordingExecutor = (): {execute: ToolExecutor; calls: Record<string, unknown>[]} => {
+  const calls: Record<string, unknown>[] = [];
+  const execute: ToolExecutor = async input => {
+    calls.push(input);
+    return `Forecast for ${String(input.location)}: sunny`;
+  };
+  return {execute, calls};
+};
+
+describe('ToolRegistry input validation', () => {
+  afterEach(() => setLogger());
+
+  it('returns a rejection naming the missing required property and never runs the executor', async () => {
+    const registry = new ToolRegistry();
+    const {execute, calls} = recordingExecutor();
+    registry.register(weatherTool, execute);
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({result: response.result, executorCalls: calls.length}).toEqual({
+      result: expect.stringMatching(/location[\s\S]*required|required[\s\S]*location/),
+      executorCalls: 0,
+    });
+  });
+
+  it('names the failing path and expected type but never the offending value, in the result or the logs', async () => {
+    const lines: string[] = [];
+    const record = (_category: string, message: string, fields?: Record<string, unknown>): void =>
+      void lines.push(`${message} ${JSON.stringify(fields ?? {})}`);
+    setLogger({debug: record, info: record, warn: record, error: record});
+    const registry = new ToolRegistry();
+    const {execute, calls} = recordingExecutor();
+    registry.register(weatherTool, execute);
+
+    const response = await registry.execute('get_weather', {location: 4815162342, email: 'jane.doe@example.com'});
+
+    const leaked = [response.result, ...lines].filter(
+      text => text.includes('4815162342') || text.includes('jane.doe@example.com')
+    );
+    expect({result: response.result, leaked, executorCalls: calls.length}).toEqual({
+      result: expect.stringMatching(/location[\s\S]*string/),
+      leaked: [],
+      executorCalls: 0,
+    });
+  });
+
+  it('throws at register time for an uncompilable schema, naming the tool', () => {
+    const registry = new ToolRegistry();
+    const broken: ToolDefinition = {
+      name: 'broken_tool',
+      description: 'declares a type JSON Schema does not have',
+      inputSchema: {type: 'object', properties: {location: {type: 'not-a-type'}}},
+    };
+
+    expect(() => registry.register(broken, recordingExecutor().execute)).toThrow(/broken_tool/);
+  });
+
+  it('validates a function-valued definition against the schema current at each call, not a stale one', async () => {
+    let requiredField = 'a';
+    const shifting = (): ToolDefinition => ({
+      name: 'shifting',
+      description: 'its schema changes between calls',
+      inputSchema: {
+        type: 'object',
+        properties: {a: {type: 'string'}, b: {type: 'string'}},
+        required: [requiredField],
+      },
+    });
+    const registry = new ToolRegistry();
+    const {execute, calls} = recordingExecutor();
+    registry.register(shifting, execute);
+
+    await registry.execute('shifting', {a: 'x'});
+    requiredField = 'b';
+    const second = await registry.execute('shifting', {a: 'x'});
+
+    expect({second: second.result, executorCalls: calls.length}).toEqual({
+      second: expect.stringMatching(/\bb\b/),
+      executorCalls: 1,
+    });
+  });
+});
+
+describe('ChatOrchestrator with a rejected tool call', () => {
+  it('resolves, shows the rejection to the provider on the next round, and runs the corrected retry', async () => {
+    const seenPerRound: Message[][] = [];
+    const rounds: MessageChunk[][] = [
+      [
+        {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Oslo'}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'text', text: 'It is sunny in Oslo.'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ];
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params): AsyncGenerator<MessageChunk> {
+        seenPerRound.push(JSON.parse(JSON.stringify(params.messages)) as Message[]);
+        for (const chunk of rounds[round++] ?? []) yield chunk;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const registry = new ToolRegistry();
+    const {execute, calls} = recordingExecutor();
+    registry.register(weatherTool, execute);
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), registry);
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'weather?', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+
+    const reply = await orchestrator.processMessage(session);
+
+    const firstToolResult = (seenPerRound[1] ?? [])
+      .flatMap(m => (Array.isArray(m.content) ? m.content : []))
+      .find((c): c is ToolResultContent => c.type === 'tool_result' && c.toolUseId === 'call-1');
+    expect({reply, rejectionSeen: firstToolResult?.content, executorCalls: calls}).toEqual({
+      reply: 'It is sunny in Oslo.',
+      rejectionSeen: expect.stringMatching(/location[\s\S]*required|required[\s\S]*location/),
+      executorCalls: [{location: 'Oslo'}],
+    });
+  });
+});