+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const definition = (inputSchema: Record<string, unknown>): ToolDefinition => ({
+  name: 'weather',
+  description: 'gets the weather',
+  inputSchema,
+});
+
+describe('ToolRegistry input-schema validation', () => {
+  it('returns a rejection for missing and wrong-typed required input without invoking the executor or exposing the value', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(
+      definition({
+        type: 'object',
+        properties: {location: {type: 'string'}},
+        required: ['location'],
+      }),
+      async () => {
+        calls += 1;
+        return 'executor ran';
+      }
+    );
+
+    const missing = await registry.execute('weather', {});
+    const wrongType = await registry.execute('weather', {location: 42});
+
+    expect(missing.result).toMatch(/location.*required/i);
+    expect(wrongType.result).toMatch(/location.*string/i);
+    expect(wrongType.result).not.toContain('42');
+    expect(calls).toBe(0);
+  });
+
+  it('passes valid input and unlisted properties through unchanged exactly once, while preserving unknown-tool errors', async () => {
+    const registry = new ToolRegistry();
+    const input = {location: 'Berlin', identifyingNote: 'private'};
+    const received: Record<string, unknown>[] = [];
+    registry.register(
+      definition({
+        type: 'object',
+        properties: {location: {type: 'string'}},
+        required: ['location'],
+      }),
+      async toolInput => {
+        received.push(toolInput);
+        return 'forecast';
+      }
+    );
+
+    await expect(registry.execute('weather', input)).resolves.toEqual({result: 'forecast'});
+    expect(received).toEqual([input]);
+    await expect(registry.execute('missing', {})).rejects.toThrow('Unknown tool: missing');
+  });
+
+  it('compiles static schemas at registration and validates each function-sourced schema at its current call', async () => {
+    const staticSchema: Record<string, unknown> = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    const registry = new ToolRegistry();
+    registry.register(definition(staticSchema), async () => 'executor ran');
+    staticSchema.required = ['city'];
+
+    for (let attempt = 0; attempt < 10; attempt += 1) {
+      await expect(registry.execute('weather', {location: 'Berlin'})).resolves.toEqual({result: 'executor ran'});
+    }
+    await expect(registry.execute('weather', {})).resolves.toMatchObject({
+      result: expect.stringMatching(/location.*required/i),
+    });
+
+    let call = 0;
+    registry.register(
+      () => ({
+        ...definition({
+          type: 'object',
+          properties: {[call === 0 ? 'location' : 'city']: {type: 'string'}},
+          required: [call === 0 ? 'location' : 'city'],
+        }),
+      }),
+      async () => {
+        call += 1;
+        return 'executor ran';
+      }
+    );
+
+    await expect(registry.execute('weather', {location: 'Berlin'})).resolves.toEqual({result: 'executor ran'});
+    await expect(registry.execute('weather', {location: 'Berlin'})).resolves.toMatchObject({
+      result: expect.stringMatching(/city.*required/i),
+    });
+  });
+
+  it('rejects an uncompilable schema during registration and names the tool', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(definition({type: 'object', required: 'location'}), async () => 'executor ran')
+    ).toThrow(/weather/i);
+  });
+});