@@ -0,0 +1,85 @@
+import {ToolRegistry} from './registry.js';
+
+const definition = (inputSchema: Record<string, unknown>) => ({
+  name: 'weather',
+  description: 'gets a forecast',
+  inputSchema,
+});
+
+const locationSchema = {
+  type: 'object',
+  properties: {location: {type: 'string'}},
+  required: ['location'],
+};
+
+describe('ToolRegistry input validation', () => {
+  it('rejects invalid required and typed tool input without invoking the executor', async () => {
+    const calls: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(definition(locationSchema), async input => {
+      calls.push(input);
+      return 'forecast';
+    });
+
+    const missing = await registry.execute('weather', {});
+    const wrongType = await registry.execute('weather', {location: 42, privateId: 'person-123'});
+
+    expect(missing.result).toMatch(/location.*required/i);
+    expect(wrongType.result).toMatch(/location/i);
+    expect(wrongType.result).toMatch(/string/i);
+    expect(wrongType.result).not.toContain('person-123');
+    expect(calls).toHaveLength(0);
+  });
+
+  it('passes valid tool input and unlisted properties through unchanged', async () => {
+    const received: Record<string, unknown>[] = [];
+    const input = {location: 'Berlin', privateId: 'person-123'};
+    const registry = new ToolRegistry();
+    registry.register(definition(locationSchema), async toolInput => {
+      received.push(toolInput);
+      return 'forecast';
+    });
+
+    await registry.execute('weather', input);
+
+    expect(received).toHaveLength(1);
+    expect(received[0]).toEqual(input);
+  });
+
+  it('compiles static schemas at registration and resolves dynamic schemas per call', async () => {
+    const staticSchema = structuredClone(locationSchema);
+    const staticRegistry = new ToolRegistry();
+    staticRegistry.register(definition(staticSchema), async () => 'forecast');
+    staticSchema.required = ['city'];
+
+    const staticResult = await staticRegistry.execute('weather', {});
+
+    let phase = 0;
+    const dynamicRegistry = new ToolRegistry();
+    dynamicRegistry.register(
+      () =>
+        definition({
+          type: 'object',
+          properties: {[phase === 0 ? 'location' : 'city']: {type: 'string'}},
+          required: [phase === 0 ? 'location' : 'city'],
+        }),
+      async () => 'forecast'
+    );
+
+    const firstDynamicResult = await dynamicRegistry.execute('weather', {});
+    phase = 1;
+    const secondDynamicResult = await dynamicRegistry.execute('weather', {});
+
+    expect(staticResult.result).toMatch(/location.*required/i);
+    expect(firstDynamicResult.result).toMatch(/location.*required/i);
+    expect(secondDynamicResult.result).toMatch(/city.*required/i);
+  });
+
+  it('rejects an uncompilable schema at registration with the tool name', () => {
+    const registry = new ToolRegistry();
+
+    expect(() => registry.register(definition({type: 'not-a-json-schema-type'}), async () => 'should not run')).toThrow(
+      /weather/i
+    );
+  });
+});