+import {ToolRegistry} from './registry.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../../types/ai.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../../types/session.js';
+
+const definition = {
+  name: 'weather',
+  description: 'gets the weather',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}},
+    required: ['location'],
+  },
+};
+
+const session = (content: string): ChatSession => ({
+  sessionId: 'session-1',
+  userId: 'user-1',
+  entries: [{role: 'user', content, timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+describe('ToolRegistry input validation acceptance', () => {
+  it('rejects malformed input before invoking the executor', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(definition, async () => {
+      calls += 1;
+      return 'should not run';
+    });
+
+    const missing = await registry.execute('weather', {});
+    const wrongType = await registry.execute('weather', {location: 12345});
+
+    expect(missing.result).toMatch(/location.*required/i);
+    expect(wrongType.result).toMatch(/location.*string/i);
+    expect(wrongType.result).not.toContain('12345');
+    expect(calls).toBe(0);
+  });
+
+  it('passes valid input through unchanged, including an extra property', async () => {
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+    registry.register(definition, async input => {
+      received.push(input);
+      return 'ok';
+    });
+    const input = {location: 'Berlin', identifyingNote: 'private-value'};
+
+    await expect(registry.execute('weather', input)).resolves.toEqual({result: 'ok'});
+
+    expect(received).toEqual([input]);
+  });
+
+  it('compiles static schemas at registration and validates the current dynamic schema', async () => {
+    const staticRegistry = new ToolRegistry();
+    expect(() =>
+      staticRegistry.register(
+        {name: 'broken-weather', description: 'broken', inputSchema: {type: 'not-a-json-schema-type'}},
+        async () => 'never'
+      )
+    ).toThrow(/broken-weather/);
+
+    const dynamicRegistry = new ToolRegistry();
+    let nextSchema = {type: 'object', properties: {city: {type: 'string'}}, required: ['city']};
+    dynamicRegistry.register(
+      () => ({name: 'dynamic-weather', description: 'dynamic', inputSchema: nextSchema}),
+      async input => JSON.stringify(input)
+    );
+
+    await expect(dynamicRegistry.execute('dynamic-weather', {city: 'Berlin'})).resolves.toEqual({
+      result: JSON.stringify({city: 'Berlin'}),
+    });
+    nextSchema = {type: 'object', properties: {country: {type: 'string'}}, required: ['country']};
+    await expect(dynamicRegistry.execute('dynamic-weather', {country: 'Germany'})).resolves.toEqual({
+      result: JSON.stringify({country: 'Germany'}),
+    });
+  });
+
+  it('feeds a validation rejection into the retry round and preserves the unknown-tool throw', async () => {
+    const registry = new ToolRegistry();
+    registry.register(definition, async input => `forecast for ${String(input.location)}`);
+    const seenRequests: SendMessageParams[] = [];
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        seenRequests.push(params);
+        if (round++ === 0) {
+          yield {type: 'tool_use', toolCall: {id: 'call-1', name: 'weather', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        yield {type: 'text', text: 'done'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      provider,
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      registry
+    );
+
+    await expect(orchestrator.processMessage(session('weather?'))).resolves.toBe('done');
+    expect(JSON.stringify(seenRequests[1].messages)).toMatch(/location.*required/i);
+    await expect(registry.execute('missing-tool', {})).rejects.toThrow('Unknown tool: missing-tool');
+  });
+});