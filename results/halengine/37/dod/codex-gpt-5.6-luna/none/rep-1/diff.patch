+++ b/src/orchestration/tools/registry.test.ts
@@ -0,0 +1,59 @@
+import {ToolRegistry} from './registry.js';
+
+const weatherSchema = {type: 'object', properties: {location: {type: 'string'}}, required: ['location']} as const;
+
+function makeWeatherRegistry(executor: (input: Record<string, unknown>) => Promise<string>): ToolRegistry {
+  const registry = new ToolRegistry();
+  registry.register({name: 'weather', description: 'gets weather', inputSchema: weatherSchema}, executor);
+  return registry;
+}
+
+describe('ToolRegistry validation', () => {
+  it('rejects input missing a required property', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'search',
+        description: 'searches',
+        inputSchema: {type: 'object', properties: {term: {type: 'string'}}, required: ['term']},
+      },
+      async () => 'results'
+    );
+
+    const response = await registry.execute('search', {});
+
+    expect(response.result).toMatch(/term.*required/i);
+  });
+});
+
+describe('ToolRegistry valid input', () => {
+  it('passes valid input with extra properties to the executor unchanged', async () => {
+    let receivedInput: Record<string, unknown> = {};
+    const registry = makeWeatherRegistry(async input => {
+      receivedInput = input;
+      return 'forecast';
+    });
+
+    await registry.execute('weather', {location: 'London', extra: 'ignored'});
+
+    expect(receivedInput).toEqual({location: 'London', extra: 'ignored'});
+  });
+});
+
+describe('ToolRegistry type error', () => {
+  it('rejects wrong-typed field naming the path and expected type', async () => {
+    const registry = makeWeatherRegistry(async () => 'forecast');
+
+    const response = await registry.execute('weather', {location: 42});
+
+    expect(response.result).toMatch(/location.*string/i);
+  });
+});
+
+describe('ToolRegistry unknown tool', () => {
+  it('throws for an unknown tool name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('no-such-tool', {})).rejects.toThrow('Unknown tool: no-such-tool');
+  });
+});
