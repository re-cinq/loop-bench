@@ -0,0 +1,38 @@
+import type {ToolResponse} from './registry.js';
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry input validation', () => {
+  let response: ToolResponse;
+  let executorCalls: number;
+
+  beforeEach(async () => {
+    const registry = new ToolRegistry();
+    executorCalls = 0;
+
+    registry.register(
+      {
+        name: 'weather',
+        description: 'gets the weather',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'forecast';
+      }
+    );
+
+    response = await registry.execute('weather', {});
+  });
+
+  it('rejects missing required tool input before invoking the executor', () => {
+    expect(response.result).toMatch(/location.*required/i);
+  });
+
+  it('does not invoke the executor when required tool input is missing', () => {
+    expect(executorCalls).toBe(0);
+  });
+});
diff --git a/src/orchestration/tools/registry.test.ts b/src/orchestration/tools/registry.test.ts
