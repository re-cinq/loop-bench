+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry input validation', () => {
+  it('rejects missing required tool input before invoking the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+
+    registry.register(
+      {
+        name: 'weather',
+        description: 'gets the weather',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'forecast';
+      }
+    );
+
+    const response = await registry.execute('weather', {});
+
+    expect(response.result).toMatch(/location.*required/i);
+    expect(executorCalls).toBe(0);
+  });
+});