+import {ToolRegistry} from './registry.js';
+
+const weatherDefinition = {
+  name: 'weather',
+  description: 'Gets the weather for a location',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}},
+    required: ['location'],
+  },
+};
+
+describe('ToolRegistry input-schema validation', () => {
+  it('rejects invalid input before execution and preserves valid extra properties', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    let received: Record<string, unknown> | undefined;
+    registry.register(weatherDefinition, async input => {
+      calls += 1;
+      received = input;
+      return 'forecast';
+    });
+
+    const missing = await registry.execute('weather', {});
+    const wrongType = await registry.execute('weather', {location: 42});
+
+    expect(missing.result).toMatch(/location.*required/i);
+    expect(wrongType.result).toMatch(/location.*string/i);
+    expect(wrongType.result).not.toContain('42');
+    expect(calls).toBe(0);
+    const input = {location: 'Berlin', identifyingCode: 'secret-value'};
+
+    await registry.execute('weather', input);
+
+    expect(calls).toBe(1);
+    expect(received).toEqual(input);
+  });
+
+  it('rejects an uncompilable schema while registering the named tool', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken-weather',
+          description: 'Broken weather tool',
+          inputSchema: {type: 'not-a-json-schema-type'},
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken-weather/i);
+  });
+
+  it('validates a function-valued definition against the schema resolved for each call', async () => {
+    const registry = new ToolRegistry();
+    let definitionCalls = 0;
+    let executorCalls = 0;
+    registry.register(
+      () => {
+        definitionCalls += 1;
+        const field = definitionCalls === 1 ? 'location' : 'city';
+        return {
+          name: 'changing-weather',
+          description: 'Weather with a changing schema',
+          inputSchema: {
+            type: 'object',
+            properties: {[field]: {type: 'string'}},
+            required: [field],
+          },
+        };
+      },
+      async () => {
+        executorCalls += 1;
+        return 'forecast';
+      }
+    );
+
+    const first = await registry.execute('changing-weather', {});
+    const second = await registry.execute('changing-weather', {});
+
+    expect(first.result).toMatch(/location.*required/i);
+    expect(second.result).toMatch(/city.*required/i);
+    expect(executorCalls).toBe(0);
+  });
+
+  it('compiles a static schema once across repeated executions', async () => {
+    const registry = new ToolRegistry();
+    let schemaReads = 0;
+    const definition = {
+      name: 'counted-weather',
+      description: 'Weather with a counted schema',
+      get inputSchema() {
+        schemaReads += 1;
+        return weatherDefinition.inputSchema;
+      },
+    };
+
+    registry.register(definition, async () => 'forecast');
+    for (let index = 0; index < 10; index += 1) {
+      await registry.execute('counted-weather', {location: 'Berlin'});
+    }
+
+    expect(schemaReads).toBe(1);
+  });
+});