@@ -0,0 +1,89 @@
+import {ToolRegistry} from './registry.js';
+
+const tool = (name: string, inputSchema: Record<string, unknown>) => ({
+  name,
+  description: `${name} tool`,
+  inputSchema,
+});
+
+describe('ToolRegistry input validation', () => {
+  it('rejects a missing required property before invoking the executor', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+
+    registry.register(
+      tool('weather', {type: 'object', properties: {location: {type: 'string'}}, required: ['location']}),
+      async () => {
+        calls += 1;
+        return 'executed';
+      }
+    );
+
+    const response = await registry.execute('weather', {});
+
+    expect(response.result).toMatch(/location.*required/i);
+    expect(calls).toBe(0);
+  });
+
+  it('rejects a wrong-typed value without exposing it', async () => {
+    const registry = new ToolRegistry();
+
+    registry.register(
+      tool('weather', {type: 'object', properties: {location: {type: 'string'}}, required: ['location']}),
+      async input => {
+        return String(input.location);
+      }
+    );
+
+    const response = await registry.execute('weather', {location: 42});
+
+    expect(response.result).toMatch(/location.*string/i);
+    expect(response.result).not.toContain('42');
+  });
+
+  it('passes valid input and extra properties through unchanged after rejecting invalid input', async () => {
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+
+    registry.register(
+      tool('weather', {type: 'object', properties: {location: {type: 'string'}}, required: ['location']}),
+      async input => {
+        received.push(input);
+        return 'executed';
+      }
+    );
+
+    const rejected = await registry.execute('weather', {});
+    const input = {location: 'Berlin', extra: 'preserve-me'};
+    const accepted = await registry.execute('weather', input);
+
+    expect(rejected.result).toMatch(/location.*required/i);
+    expect(accepted.result).toBe('executed');
+    expect(received).toEqual([input]);
+  });
+
+  it('rejects an uncompilable schema during registration', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(tool('broken-weather', {type: 'not-a-json-schema-type'}), async () => 'never')
+    ).toThrow(/broken-weather/);
+  });
+
+  it('validates function-valued definitions against the schema current at each call', async () => {
+    const registry = new ToolRegistry();
+    let current = 'location';
+
+    registry.register(
+      () => tool('dynamic-weather', {type: 'object', properties: {[current]: {type: 'string'}}, required: [current]}),
+      async () => 'executed'
+    );
+
+    const first = await registry.execute('dynamic-weather', {});
+    current = 'city';
+    const second = await registry.execute('dynamic-weather', {location: 'Berlin'});
+
+    expect(first.result).toMatch(/location.*required/i);
+    expect(second.result).toMatch(/city.*required/i);
+  });
+});