--- /dev/null
+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,96 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition, ToolDefinitionSource} from './registry.js';
+
+const definition = (inputSchema: Record<string, unknown>, name = 'weather'): ToolDefinition => ({
+  name,
+  description: 'test tool',
+  inputSchema,
+});
+
+const requiredLocation = definition({
+  type: 'object',
+  properties: {location: {type: 'string'}},
+  required: ['location'],
+});
+
+describe('ToolRegistry input validation acceptance', () => {
+  it('returns schema failures with the field and expected type without invoking the executor', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(requiredLocation, async () => {
+      calls += 1;
+      return 'executed';
+    });
+
+    const missing = await registry.execute('weather', {});
+    const wrongType = await registry.execute('weather', {location: 42});
+
+    expect(missing.result).toMatch(/location.*required/i);
+    expect(wrongType.result).toMatch(/location.*string/i);
+    expect(wrongType.result).not.toContain('42');
+    expect(calls).toBe(0);
+  });
+
+  it('passes valid extra properties through unchanged exactly once and preserves unknown-tool errors', async () => {
+    const registry = new ToolRegistry();
+    const input = {location: 'Berlin', extra: 'preserved'};
+    const received: Record<string, unknown>[] = [];
+    registry.register(requiredLocation, async value => {
+      received.push(value);
+      return 'ok';
+    });
+
+    await expect(registry.execute('weather', input)).resolves.toEqual({result: 'ok'});
+    await expect(registry.execute('weather', {...input, location: 42})).resolves.toMatchObject({
+      result: expect.stringMatching(/location.*string/i),
+    });
+    expect(received).toEqual([input]);
+    await expect(registry.execute('missing', {})).rejects.toThrow('Unknown tool: missing');
+  });
+
+  it('compiles static schemas once, rejects an uncompilable schema at registration, and validates dynamic schemas per call', async () => {
+    let propertyReads = 0;
+    const staticSchema: Record<string, unknown> = {type: 'object'};
+    Object.defineProperty(staticSchema, 'properties', {
+      enumerable: true,
+      get: () => {
+        propertyReads += 1;
+        if (propertyReads > 1) throw new Error('schema compiled more than once');
+        return {location: {type: 'string'}};
+      },
+    });
+    Object.defineProperty(staticSchema, 'required', {enumerable: true, value: ['location']});
+
+    const registry = new ToolRegistry();
+    registry.register(definition(staticSchema), async () => 'ok');
+    for (let attempt = 0; attempt < 10; attempt += 1) {
+      await expect(registry.execute('weather', {location: 'Berlin'})).resolves.toEqual({result: 'ok'});
+    }
+    expect(propertyReads).toBe(1);
+
+    expect(() =>
+      registry.register(definition({type: 'not-a-json-schema'}, 'broken'), async () => 'unreachable')
+    ).toThrow(/broken/);
+
+    let sourceCalls = 0;
+    const dynamic: ToolDefinitionSource = () => {
+      sourceCalls += 1;
+      return definition(
+        sourceCalls === 1
+          ? {type: 'object', properties: {location: {type: 'string'}}, required: ['location']}
+          : sourceCalls === 2
+            ? {type: 'object', properties: {city: {type: 'string'}}, required: ['city']}
+            : {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+        'dynamic'
+      );
+    };
+    const dynamicRegistry = new ToolRegistry();
+    dynamicRegistry.register(dynamic, async () => 'dynamic ok');
+
+    const first = await dynamicRegistry.execute('dynamic', {location: 'Berlin'});
+    const second = await dynamicRegistry.execute('dynamic', {location: 'Berlin'});
+
+    expect(first.result).toMatch(/city.*required/i);
+    expect(second).toEqual({result: 'dynamic ok'});
+  });
+});