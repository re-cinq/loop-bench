+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,104 @@
+import {ToolRegistry} from './registry.js';
+
+const definition = (inputSchema: Record<string, unknown>) => ({
+  name: 'weather',
+  description: 'Returns weather',
+  inputSchema,
+});
+
+describe('ToolRegistry input validation', () => {
+  it('returns a schema rejection for missing and wrongly typed fields without invoking the executor', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(
+      definition({
+        type: 'object',
+        properties: {location: {type: 'string'}},
+        required: ['location'],
+      }),
+      async () => {
+        calls += 1;
+        return 'executed';
+      }
+    );
+
+    const missing = await registry.execute('weather', {});
+    const wrongType = await registry.execute('weather', {location: 12345});
+
+    expect(missing.result).toMatch(/location.*required/i);
+    expect(wrongType.result).toMatch(/location.*string/i);
+    expect(wrongType.result).not.toContain('12345');
+    expect(calls).toBe(0);
+  });
+
+  it('passes valid input and unlisted properties through unchanged, and still throws for an unknown tool', async () => {
+    const registry = new ToolRegistry();
+    const input = {location: 'Berlin', identifyingValue: 'private-value'};
+    const received: Record<string, unknown>[] = [];
+    registry.register(
+      definition({
+        type: 'object',
+        properties: {location: {type: 'string'}},
+        required: ['location'],
+      }),
+      async receivedInput => {
+        received.push(receivedInput);
+        return 'executed';
+      }
+    );
+
+    const rejected = await registry.execute('weather', {});
+    await expect(registry.execute('weather', input)).resolves.toEqual({result: 'executed'});
+    expect(rejected.result).toMatch(/location.*required/i);
+    expect(received).toEqual([input]);
+    await expect(registry.execute('missing', {})).rejects.toThrow('Unknown tool: missing');
+  });
+
+  it('rejects an uncompilable schema at registration and compiles a static schema before later schema mutation', async () => {
+    const registry = new ToolRegistry();
+    expect(() => registry.register(definition({type: 'not-a-json-schema-type'}), async () => 'executed')).toThrow(
+      /weather/
+    );
+
+    const schema = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    registry.register(definition(schema), async () => 'executed');
+    schema.required = ['city'];
+
+    const results = await Promise.all(Array.from({length: 10}, () => registry.execute('weather', {})));
+
+    expect(results).toHaveLength(10);
+    expect(results.every(result => /location.*required/i.test(result.result))).toBe(true);
+  });
+
+  it('validates a function-valued definition against the schema resolved for each call', async () => {
+    const registry = new ToolRegistry();
+    let resolutions = 0;
+    let calls = 0;
+    registry.register(
+      () => {
+        resolutions += 1;
+        const field = resolutions === 1 ? 'first' : 'second';
+        return definition({
+          type: 'object',
+          properties: {[field]: {type: 'string'}},
+          required: [field],
+        });
+      },
+      async () => {
+        calls += 1;
+        return 'executed';
+      }
+    );
+
+    const first = await registry.execute('weather', {first: 'ok'});
+    const second = await registry.execute('weather', {second: 'ok'});
+
+    expect(first.result).toMatch(/second.*required/i);
+    expect(second).toEqual({result: 'executed'});
+    expect(calls).toBe(1);
+  });
+});