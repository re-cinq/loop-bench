@@ -0,0 +1,104 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const definition = (name: string, inputSchema: Record<string, unknown>): ToolDefinition => ({
+  name,
+  description: `${name} test tool`,
+  inputSchema,
+});
+
+describe('ToolRegistry input validation', () => {
+  it('rejects missing required input and passes valid extra properties through unchanged', async () => {
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+    registry.register(
+      definition('weather', {
+        type: 'object',
+        properties: {location: {type: 'string'}},
+        required: ['location'],
+      }),
+      async input => {
+        received.push(input);
+        return 'forecast';
+      }
+    );
+
+    const rejected = await registry.execute('weather', {});
+    const input = {location: 'Berlin', identifyingNote: 'customer-42'};
+    const accepted = await registry.execute('weather', input);
+
+    expect(rejected.result).toMatch(/location.*required/i);
+    expect(accepted.result).toBe('forecast');
+    expect(received).toEqual([input]);
+  });
+
+  it('rejects a wrong-typed field without leaking its value', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      definition('weather', {
+        type: 'object',
+        properties: {location: {type: 'string'}},
+        required: ['location'],
+      }),
+      async () => 'unreachable'
+    );
+
+    const result = await registry.execute('weather', {location: 90210});
+
+    expect(result.result).toMatch(/location.*string/i);
+    expect(result.result).not.toContain('90210');
+  });
+
+  it('compiles static schemas once and uses the current function-valued schema', async () => {
+    const registry = new ToolRegistry();
+    let schemaReads = 0;
+    const staticDefinition = {
+      name: 'static',
+      description: 'static test tool',
+      get inputSchema(): Record<string, unknown> {
+        schemaReads += 1;
+        return {type: 'object', properties: {value: {type: 'string'}}};
+      },
+    } satisfies ToolDefinition;
+    registry.register(staticDefinition, async () => 'ok');
+
+    for (let index = 0; index < 10; index += 1) {
+      await registry.execute('static', {value: `value-${index}`});
+    }
+
+    let definitionCalls = 0;
+    registry.register(
+      () => {
+        definitionCalls += 1;
+        const field = definitionCalls === 1 ? 'location' : 'city';
+        return definition('dynamic', {
+          type: 'object',
+          properties: {[field]: {type: 'string'}},
+          required: [field],
+        });
+      },
+      async () => 'unreachable'
+    );
+
+    const first = await registry.execute('dynamic', {});
+    const second = await registry.execute('dynamic', {});
+
+    expect(schemaReads).toBe(1);
+    expect(first.result).toMatch(/location.*required/i);
+    expect(second.result).toMatch(/city.*required/i);
+  });
+
+  it('rejects an uncompilable schema at registration', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        definition('broken-weather', {
+          type: 'object',
+          properties: {location: {type: 'not-a-json-schema-type'}},
+        }),
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken-weather/);
+  });
+});