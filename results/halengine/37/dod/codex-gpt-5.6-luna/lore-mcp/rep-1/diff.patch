--- /dev/null
+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,108 @@
+import {ToolRegistry} from './registry.js';
+
+const weatherDefinition = {
+  name: 'weather',
+  description: 'gets a forecast',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}},
+    required: ['location'],
+  },
+};
+
+describe('ToolRegistry input-schema validation', () => {
+  // spec: specs/hal-engine-tool-input-validation#1
+  it('returns a redacted schema failure and never invokes the executor', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(weatherDefinition, async () => {
+      calls += 1;
+      return 'forecast';
+    });
+
+    const missing = await registry.execute('weather', {});
+    const wrongType = await registry.execute('weather', {location: 12345});
+
+    expect({missing, wrongType, calls}).toEqual({
+      missing: {result: expect.stringMatching(/location.*required/i)},
+      wrongType: {result: expect.stringMatching(/location.*string/i)},
+      calls: 0,
+    });
+    expect(`${missing.result} ${wrongType.result}`).not.toContain('12345');
+  });
+
+  // spec: specs/hal-engine-tool-input-validation#2
+  it('passes valid input and an unlisted property through unchanged exactly once', async () => {
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+    registry.register(weatherDefinition, async input => {
+      received.push(input);
+      return 'forecast';
+    });
+
+    const result = await registry.execute('weather', {location: 'Berlin', identifyingCode: 'secret'});
+    const rejected = await registry.execute('weather', {identifyingCode: 'secret'});
+
+    expect({result, received, rejected: rejected.result}).toEqual({
+      result: {result: 'forecast'},
+      received: [{location: 'Berlin', identifyingCode: 'secret'}],
+      rejected: expect.stringMatching(/location.*required/i),
+    });
+  });
+
+  // spec: specs/hal-engine-tool-input-validation#3
+  it('compiles static schemas at registration and rejects every malformed call', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(weatherDefinition, async () => {
+      calls += 1;
+      return 'forecast';
+    });
+
+    const results = await Promise.all(Array.from({length: 10}, () => registry.execute('weather', {})));
+
+    expect(results.every(result => /location.*required/i.test(result.result))).toBe(true);
+    expect(calls).toBe(0);
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken-weather',
+          description: 'broken',
+          inputSchema: {type: 'object', required: 'location'},
+        },
+        async () => 'never'
+      )
+    ).toThrow(/broken-weather/);
+  });
+
+  // spec: specs/hal-engine-tool-input-validation#4
+  it('validates a function-valued definition against the schema resolved for that call', async () => {
+    const registry = new ToolRegistry();
+    let definitionCall = 0;
+    registry.register(
+      () => {
+        definitionCall += 1;
+        const field = definitionCall % 2 === 1 ? 'location' : 'city';
+        return {
+          name: 'dynamic-weather',
+          description: 'gets a forecast',
+          inputSchema: {
+            type: 'object',
+            properties: {[field]: {type: 'string'}},
+            required: [field],
+          },
+        };
+      },
+      async () => 'forecast'
+    );
+
+    const first = await registry.execute('dynamic-weather', {city: 'Berlin'});
+    const second = await registry.execute('dynamic-weather', {location: 'Berlin'});
+
+    expect({first: first.result, second: second.result}).toEqual({
+      first: expect.stringMatching(/location.*required/i),
+      second: expect.stringMatching(/city.*required/i),
+    });
+  });
+});