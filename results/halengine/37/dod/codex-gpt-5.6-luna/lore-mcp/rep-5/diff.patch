@@ -0,0 +1,162 @@
+import {setLogger} from '../../shared/logger.js';
+import {ToolRegistry} from './registry.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+
+const definition = (name: string, required: string) => ({
+  name,
+  description: 'test tool',
+  inputSchema: {
+    type: 'object',
+    properties: {[required]: {type: 'string'}},
+    required: [required],
+  },
+});
+
+const session: ChatSession = {
+  sessionId: 'session-1',
+  userId: 'user-1',
+  entries: [{role: 'user', content: 'find it', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+describe('ToolRegistry input validation acceptance', () => {
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('rejects missing and mistyped fields before execution without logging or returning their values', async () => {
+    const lines: string[] = [];
+    setLogger({
+      debug: (_category, message, fields) => lines.push(`${message} ${JSON.stringify(fields)}`),
+      info: (_category, message, fields) => lines.push(`${message} ${JSON.stringify(fields)}`),
+      warn: (_category, message, fields) => lines.push(`${message} ${JSON.stringify(fields)}`),
+      error: (_category, message, fields) => lines.push(`${message} ${JSON.stringify(fields)}`),
+    });
+    let calls = 0;
+    const registry = new ToolRegistry();
+    registry.register(definition('weather', 'location'), async () => {
+      calls += 1;
+      return 'secret-value';
+    });
+
+    const missing = await registry.execute('weather', {});
+    const mistyped = await registry.execute('weather', {location: 42});
+
+    expect({
+      missing: missing.result,
+      mistyped: mistyped.result,
+      calls,
+      leaked: [...lines, missing.result, mistyped.result].some(line => line.includes('secret-value')),
+    }).toEqual({
+      missing: expect.stringMatching(/location.*required/i),
+      mistyped: expect.stringMatching(/location.*string/i),
+      calls: 0,
+      leaked: false,
+    });
+  });
+
+  it('compiles a static schema once and passes valid extra properties through exactly once', async () => {
+    let schemaReads = 0;
+    const inputSchema: Record<string, unknown> = {
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    Object.defineProperty(inputSchema, 'type', {
+      get: () => {
+        schemaReads += 1;
+        return 'object';
+      },
+    });
+    const received: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register({name: 'weather', description: 'test tool', inputSchema}, async input => {
+      received.push(input);
+      return 'ok';
+    });
+    const afterRegister = schemaReads;
+    await Promise.all(Array.from({length: 10}, () => registry.execute('weather', {location: 'Berlin', extra: 7})));
+
+    const unknown = registry.execute('missing', {}).catch((error: Error) => error.message);
+
+    expect({
+      compiledOnce: afterRegister > 0 && schemaReads === afterRegister,
+      received,
+      unknown: await unknown,
+    }).toEqual({
+      compiledOnce: true,
+      received: Array.from({length: 10}, () => ({location: 'Berlin', extra: 7})),
+      unknown: 'Unknown tool: missing',
+    });
+  });
+
+  it('validates a function-valued definition against the schema resolved for that call', async () => {
+    let resolutions = 0;
+    let calls = 0;
+    const registry = new ToolRegistry();
+    registry.register(
+      () => {
+        const required = resolutions++ % 2 === 0 ? 'location' : 'city';
+        return definition('dynamic', required);
+      },
+      async () => {
+        calls += 1;
+        return 'executed';
+      }
+    );
+
+    const first = await registry.execute('dynamic', {city: 'Paris'});
+    const second = await registry.execute('dynamic', {city: 'Paris'});
+
+    expect({first: first.result, second: second.result, calls}).toEqual({
+      first: 'executed',
+      second: expect.stringMatching(/location.*required/i),
+      calls: 1,
+    });
+  });
+
+  it('fails fast when registration cannot compile a tool schema and names the tool', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {name: 'broken-weather', description: 'test tool', inputSchema: {type: 'not-a-json-schema-type'}},
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken-weather/);
+  });
+
+  it('returns a rejected call to the provider so a corrected retry can complete the tool loop', async () => {
+    const sent: SendMessageParams[] = [];
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        sent.push(params);
+        if (sent.length === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'call-1', name: 'weather', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        yield {type: 'text', text: 'corrected forecast'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const registry = new ToolRegistry();
+    registry.register(definition('weather', 'location'), async () => 'unreachable');
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), registry);
+
+    const result = await orchestrator.processMessage({...session, entries: [...session.entries]});
+    const retryToolResult = sent[1]?.messages.at(-1);
+
+    expect({result, retryToolResult}).toEqual({
+      result: 'corrected forecast',
+      retryToolResult: expect.objectContaining({
+        role: 'user',
+        content: [expect.objectContaining({content: expect.stringMatching(/location.*required/i)})],
+      }),
+    });
+  });
+});