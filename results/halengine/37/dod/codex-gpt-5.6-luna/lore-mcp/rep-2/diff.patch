--- /dev/null
+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,116 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const definition = (inputSchema: Record<string, unknown>): ToolDefinition => ({
+  name: 'weather',
+  description: 'Gets the weather',
+  inputSchema,
+});
+
+describe('ToolRegistry input validation', () => {
+  it('returns a required-field rejection without invoking the executor, then preserves valid extra input', async () => {
+    let calls = 0;
+    let received: Record<string, unknown> | undefined;
+    const registry = new ToolRegistry();
+
+    registry.register(
+      definition({
+        type: 'object',
+        properties: {location: {type: 'string'}},
+        required: ['location'],
+      }),
+      async input => {
+        calls += 1;
+        received = input;
+        return 'forecast';
+      }
+    );
+
+    const rejected = await registry.execute('weather', {});
+    expect(rejected.result).toMatch(/location.*required/i);
+    expect(calls).toBe(0);
+
+    const input = {location: 'Berlin', identifyingExtra: 'do-not-drop'};
+    await expect(registry.execute('weather', input)).resolves.toEqual({result: 'forecast'});
+    expect(calls).toBe(1);
+    expect(received).toEqual(input);
+  });
+
+  it('rejects a wrong-typed field with its path and expected type, without exposing the value', async () => {
+    let calls = 0;
+    const registry = new ToolRegistry();
+
+    registry.register(
+      definition({
+        type: 'object',
+        properties: {location: {type: 'string'}},
+        required: ['location'],
+      }),
+      async () => {
+        calls += 1;
+        return 'forecast';
+      }
+    );
+
+    const rejected = await registry.execute('weather', {location: 42});
+    expect(rejected.result).toMatch(/location.*string/i);
+    expect(rejected.result).not.toContain('42');
+    expect(calls).toBe(0);
+  });
+
+  it('validates a function-valued definition against the schema resolved for that call', async () => {
+    let schemaVersion = 1;
+    let calls = 0;
+    const registry = new ToolRegistry();
+
+    registry.register(
+      () =>
+        definition({
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: [schemaVersion === 1 ? 'location' : 'city'],
+        }),
+      async () => {
+        calls += 1;
+        return 'forecast';
+      }
+    );
+
+    const rejected = await registry.execute('weather', {city: 'Berlin'});
+    expect(rejected.result).toMatch(/location.*required/i);
+    expect(calls).toBe(0);
+    schemaVersion = 2;
+    await expect(registry.execute('weather', {city: 'Berlin'})).resolves.toEqual({result: 'forecast'});
+    expect(calls).toBe(1);
+  });
+
+  it('throws with the tool name when a static schema cannot be compiled at registration', () => {
+    const registry = new ToolRegistry();
+
+    expect(() => registry.register(definition({type: 'not-a-json-schema-type'}), async () => 'forecast')).toThrow(
+      /weather/
+    );
+  });
+
+  it('compiles a static schema once across repeated executions', async () => {
+    let propertyReads = 0;
+    const inputSchema = {
+      type: 'object',
+      get properties() {
+        propertyReads += 1;
+        return {location: {type: 'string'}};
+      },
+    };
+    const registry = new ToolRegistry();
+
+    registry.register(definition(inputSchema), async () => 'forecast');
+    expect(propertyReads).toBeGreaterThan(0);
+    const readsAfterRegistration = propertyReads;
+
+    for (let i = 0; i < 10; i += 1) {
+      await expect(registry.execute('weather', {location: 'Berlin'})).resolves.toEqual({result: 'forecast'});
+    }
+
+    expect(propertyReads).toBe(readsAfterRegistration);
+  });
+});