@@ -0,0 +1,99 @@
+import {ToolRegistry} from './registry.js';
+
+const definition = (name: string, inputSchema: Record<string, unknown>) => ({
+  name,
+  description: `Acceptance test tool ${name}`,
+  inputSchema,
+});
+
+describe('ToolRegistry input validation', () => {
+  it('rejects schema-invalid input without invoking the executor or exposing the offending value', async () => {
+    let calls = 0;
+    const registry = new ToolRegistry();
+    registry.register(
+      definition('weather', {
+        type: 'object',
+        properties: {location: {type: 'string'}},
+        required: ['location'],
+      }),
+      async () => {
+        calls += 1;
+        return 'executed';
+      }
+    );
+
+    const missing = await registry.execute('weather', {});
+    const wrongType = await registry.execute('weather', {location: 987654321});
+
+    expect({missing, wrongType, calls}).toEqual({
+      missing: {result: expect.stringContaining('location')},
+      wrongType: {result: expect.stringContaining('location')},
+      calls: 0,
+    });
+    expect(wrongType.result).toMatch(/string/);
+    expect(wrongType.result).not.toContain('987654321');
+  });
+
+  it('validates known fields and forwards valid input with an extra property unchanged exactly once', async () => {
+    let calls = 0;
+    let received: Record<string, unknown> | undefined;
+    const registry = new ToolRegistry();
+    registry.register(
+      definition('weather', {
+        type: 'object',
+        properties: {location: {type: 'string'}},
+        required: ['location'],
+      }),
+      async input => {
+        calls += 1;
+        received = input;
+        return 'forecast';
+      }
+    );
+
+    const invalid = await registry.execute('weather', {location: 987654321, identifyingNote: 'private-value'});
+    const input = {location: 'Berlin', identifyingNote: 'private-value'};
+    const result = await registry.execute('weather', input);
+
+    expect({invalid, result, calls, received}).toEqual({
+      invalid: {result: expect.stringContaining('location')},
+      result: {result: 'forecast'},
+      calls: 1,
+      received: input,
+    });
+  });
+
+  it('compiles static schemas at registration and resolves function-valued schemas for each execution', async () => {
+    const registry = new ToolRegistry();
+    expect(() =>
+      registry.register(definition('broken-weather', {type: 'not-a-json-schema-type'}), async () => 'never')
+    ).toThrow(/broken-weather/);
+
+    let resolveCount = 0;
+    let calls = 0;
+    registry.register(
+      () => {
+        resolveCount += 1;
+        return definition(
+          'changing-weather',
+          resolveCount % 2 === 0
+            ? {type: 'object', properties: {city: {type: 'string'}}, required: ['city']}
+            : {type: 'object', properties: {location: {type: 'string'}}, required: ['location']}
+        );
+      },
+      async () => {
+        calls += 1;
+        return 'executed';
+      }
+    );
+
+    const first = await registry.execute('changing-weather', {city: 'Paris'});
+    const second = await registry.execute('changing-weather', {location: 'Berlin'});
+
+    expect({first, second, calls}).toEqual({
+      first: {result: expect.stringContaining('location')},
+      second: {result: expect.stringContaining('city')},
+      calls: 0,
+    });
+  });
+});