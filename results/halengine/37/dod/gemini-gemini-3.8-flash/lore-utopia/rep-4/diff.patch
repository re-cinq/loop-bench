+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry input validation acceptance', () => {
+  it('returns a ToolResponse naming the missing required field and does not invoke the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCallCount = 0;
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Get weather forecast for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string', description: 'City name'},
+          },
+          required: ['location'],
+        },
+      },
+      async () => {
+        executorCallCount += 1;
+        return 'Sunny, 21C';
+      }
+    );
+
+    const response = await registry.execute('weather', {});
+
+    expect({
+      executorCallCount,
+      hasLocationInResult: response.result.toLowerCase().includes('location'),
+    }).toEqual({
+      executorCallCount: 0,
+      hasLocationInResult: true,
+    });
+  });
+
+  it('rejects a call whose field type is wrong, naming the field path and expected type but not the value', async () => {
+    const registry = new ToolRegistry();
+    let executorCallCount = 0;
+    registry.register(
+      {
+        name: 'lookup_user',
+        description: 'Find user by numeric ID',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            id: {type: 'number', description: 'User ID'},
+          },
+          required: ['id'],
+        },
+      },
+      async () => {
+        executorCallCount += 1;
+        return 'user-found';
+      }
+    );
+
+    const sensitiveStringValue = 'secret-taxpayer-identifier-98765';
+    const response = await registry.execute('lookup_user', {id: sensitiveStringValue});
+
+    expect({
+      executorCallCount,
+      namesFieldPath: response.result.includes('id'),
+      namesExpectedType: response.result.toLowerCase().includes('number'),
+      leaksOffendingValue: response.result.includes(sensitiveStringValue),
+    }).toEqual({
+      executorCallCount: 0,
+      namesFieldPath: true,
+      namesExpectedType: true,
+      leaksOffendingValue: false,
+    });
+  });
+
+  it('throws at register time when the inputSchema is uncompilable and the message names the tool', () => {
+    const registry = new ToolRegistry();
+    const brokenSchema = {
+      type: 'object',
+      properties: {
+        field: {type: 'invalid_json_schema_type'},
+      },
+    };
+
+    let thrownMessage: string | null = null;
+    try {
+      registry.register(
+        {
+          name: 'broken_tool',
+          description: 'A tool with invalid schema',
+          inputSchema: brokenSchema,
+        },
+        async () => 'ok'
+      );
+    } catch (error) {
+      thrownMessage = (error as Error).message;
+    }
+
+    expect({
+      didThrow: thrownMessage !== null,
+      messageNamesTool: thrownMessage?.includes('broken_tool') ?? false,
+    }).toEqual({
+      didThrow: true,
+      messageNamesTool: true,
+    });
+  });
+});