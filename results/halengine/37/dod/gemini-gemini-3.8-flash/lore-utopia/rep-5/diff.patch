+import {describe, it, expect} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry inputSchema validation acceptance', () => {
+  it('returns a ToolResponse naming the missing required field and does not invoke the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalled = false;
+
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Gets weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+          },
+          required: ['location'],
+        },
+      },
+      async () => {
+        executorCalled = true;
+        return 'sunny';
+      }
+    );
+
+    const response = await registry.execute('weather', {});
+
+    expect({executorCalled, mentionsLocation: response.result.includes('location')}).toEqual({
+      executorCalled: false,
+      mentionsLocation: true,
+    });
+  });
+
+  it('rejects a call whose field type is wrong, naming the field path and expected type but not the value', async () => {
+    const registry = new ToolRegistry();
+    let executorCalled = false;
+
+    registry.register(
+      {
+        name: 'lookup_user',
+        description: 'Looks up a user by id',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            userId: {type: 'string'},
+          },
+          required: ['userId'],
+        },
+      },
+      async () => {
+        executorCalled = true;
+        return 'user-found';
+      }
+    );
+
+    const sensitiveValue = 987654321;
+    const response = await registry.execute('lookup_user', {userId: sensitiveValue});
+
+    expect({
+      executorCalled,
+      namesField: response.result.includes('userId'),
+      namesType: response.result.includes('string'),
+      redactsValue: !response.result.includes(String(sensitiveValue)),
+    }).toEqual({
+      executorCalled: false,
+      namesField: true,
+      namesType: true,
+      redactsValue: true,
+    });
+  });
+
+  it('throws at register time when the inputSchema is uncompilable and the message names the tool', () => {
+    const registry = new ToolRegistry();
+
+    expect(() => {
+      registry.register(
+        {
+          name: 'broken_tool',
+          description: 'A tool with an invalid schema',
+          inputSchema: {
+            type: 'not-a-valid-json-schema-type',
+          },
+        },
+        async () => 'ok'
+      );
+    }).toThrow(/broken_tool/);
+  });
+});