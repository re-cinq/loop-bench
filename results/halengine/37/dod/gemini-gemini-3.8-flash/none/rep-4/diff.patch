@@ -0,0 +1,89 @@
+import {ToolRegistry, type ToolExecutor} from './registry.js';
+
+describe('ToolRegistry input validation', () => {
+  it('returns a rejection describing missing required input without invoking the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalled = false;
+    const execute: ToolExecutor = async () => {
+      executorCalled = true;
+      return 'ok';
+    };
+
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather forecast',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+          },
+          required: ['location'],
+        },
+      },
+      execute
+    );
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({executorCalled, result: response.result}).toEqual({
+      executorCalled: false,
+      result: expect.stringMatching(/location/i),
+    });
+  });
+
+  it('redacts offending property values from validation failure messages', async () => {
+    const registry = new ToolRegistry();
+    let executorCalled = false;
+    const execute: ToolExecutor = async () => {
+      executorCalled = true;
+      return 'ok';
+    };
+
+    registry.register(
+      {
+        name: 'user_profile',
+        description: 'Update profile',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            apiKey: {type: 'string'},
+          },
+          required: ['apiKey'],
+        },
+      },
+      execute
+    );
+
+    const sensitiveValue = 987654321;
+    const response = await registry.execute('user_profile', {apiKey: sensitiveValue});
+
+    expect({
+      executorCalled,
+      hasKeyName: response.result.includes('apiKey'),
+      leaksValue: response.result.includes(String(sensitiveValue)),
+    }).toEqual({
+      executorCalled: false,
+      hasKeyName: true,
+      leaksValue: false,
+    });
+  });
+
+  it('throws at registration time for an uncompilable inputSchema naming the tool', () => {
+    const registry = new ToolRegistry();
+    const execute: ToolExecutor = async () => 'ok';
+
+    expect(() => {
+      registry.register(
+        {
+          name: 'invalid_tool',
+          description: 'A tool with broken schema',
+          inputSchema: {
+            type: 'not-a-valid-schema-type',
+          },
+        },
+        execute
+      );
+    }).toThrow(/invalid_tool/);
+  });
+});