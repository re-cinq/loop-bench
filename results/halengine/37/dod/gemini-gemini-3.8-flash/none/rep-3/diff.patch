+import type {ToolDefinition} from '../../types/ai.js';
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry input validation acceptance', () => {
+  it('returns a rejection ToolResponse describing the missing required property without invoking the executor', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    const executor = async (input: Record<string, unknown>) => {
+      calls += 1;
+      return JSON.stringify({forecast: 'sunny', location: input.location});
+    };
+
+    const toolDef: ToolDefinition = {
+      name: 'get_weather',
+      description: 'Get weather forecast for a location',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          location: {type: 'string'},
+        },
+        required: ['location'],
+      },
+    };
+
+    registry.register(toolDef, executor);
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({response, calls}).toMatchObject({
+      response: {
+        result: expect.stringMatching(/location.*required|required.*location/i),
+      },
+      calls: 0,
+    });
+  });
+
+  it('rejects wrong-typed input with a message naming the field and expected type without leaking the offending value', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    const executor = async (input: Record<string, unknown>) => {
+      calls += 1;
+      return JSON.stringify({forecast: 'sunny', location: input.location});
+    };
+
+    const toolDef: ToolDefinition = {
+      name: 'get_weather',
+      description: 'Get weather forecast for a location',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          location: {type: 'string'},
+        },
+        required: ['location'],
+      },
+    };
+
+    registry.register(toolDef, executor);
+
+    const secretLocationId = 987654321;
+    const response = await registry.execute('get_weather', {location: secretLocationId});
+
+    expect({
+      calls,
+      mentionsField: response.result.toLowerCase().includes('location'),
+      mentionsExpectedType: response.result.toLowerCase().includes('string'),
+      leaksOffendingValue: response.result.includes(String(secretLocationId)),
+    }).toEqual({
+      calls: 0,
+      mentionsField: true,
+      mentionsExpectedType: true,
+      leaksOffendingValue: false,
+    });
+  });
+});