+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+// Acceptance tests for issue #37: validating tool input against inputSchema.
+
+describe('ToolRegistry input validation', () => {
+  it('rejects schema-invalid input with a ToolResponse describing the failure without invoking the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Get weather forecast for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string', description: 'City name'},
+          },
+          required: ['location'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'weather-report';
+      }
+    );
+
+    const response = await registry.execute('weather', {});
+
+    expect({executorCalls, result: response.result}).toEqual({
+      executorCalls: 0,
+      result: expect.stringMatching(/location/),
+    });
+  });
+
+  it('rejects wrong-typed input with an error naming the property without exposing values', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Get weather forecast for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string', description: 'City name'},
+          },
+          required: ['location'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'weather-report';
+      }
+    );
+
+    const response = await registry.execute('weather', {
+      location: 12345,
+      sensitiveSecret: 'confidential-token-value',
+    });
+
+    expect({
+      executorCalls,
+      mentionsLocation: response.result.includes('location'),
+      leaksValue: response.result.includes('12345') || response.result.includes('confidential-token-value'),
+    }).toEqual({
+      executorCalls: 0,
+      mentionsLocation: true,
+      leaksValue: false,
+    });
+  });
+
+  it('throws at registration time when a static tool declares an uncompilable inputSchema', () => {
+    const registry = new ToolRegistry();
+    const brokenDefinition = {
+      name: 'brokenTool',
+      description: 'A tool with an invalid schema',
+      inputSchema: {
+        type: 'invalid-schema-type',
+      } as unknown as ToolDefinition['inputSchema'],
+    };
+
+    expect(() => {
+      registry.register(brokenDefinition, async () => 'result');
+    }).toThrow(/brokenTool/);
+  });
+});