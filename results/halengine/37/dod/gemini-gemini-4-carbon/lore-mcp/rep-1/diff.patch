+import {ToolRegistry} from './registry.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+import type {
+  AIProvider,
+  MessageChunk,
+  SendMessageParams,
+  ToolCallContent,
+  ToolDefinition,
+  ToolResultContent,
+} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+
+const weatherDefinition: ToolDefinition = {
+  name: 'get_weather',
+  description: 'Look up weather for a location',
+  inputSchema: {
+    type: 'object',
+    properties: {
+      location: {type: 'string'},
+      units: {type: 'string', enum: ['celsius', 'fahrenheit']},
+    },
+    required: ['location'],
+  },
+};
+
+describe('ToolRegistry inputSchema validation', () => {
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('rejects input that violates required, type, or enum constraints without calling the executor or leaking values', async () => {
+    const logged: string[] = [];
+    setLogger(createRecordingLogger(logged));
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(weatherDefinition, async () => {
+      executorCalls += 1;
+      return 'executed';
+    });
+
+    const missing = await registry.execute('get_weather', {});
+    const wrongType = await registry.execute('get_weather', {
+      location: 987654321,
+      patientId: 'SSN-999-00-1234',
+    });
+    const wrongEnum = await registry.execute('get_weather', {
+      location: 'Berlin',
+      units: 'SECRET-UNIT',
+    });
+    const sensitiveTokens = ['987654321', 'SSN-999-00-1234', 'SECRET-UNIT'];
+
+    expect({
+      executorCalls,
+      missingNamesLocation: /location/.test(missing.result) && /required/i.test(missing.result),
+      wrongTypeNamesFieldAndType: /location/.test(wrongType.result) && /string/i.test(wrongType.result),
+      wrongEnumNamesField: /units/.test(wrongEnum.result),
+      leakedInResults: containsAny([missing.result, wrongType.result, wrongEnum.result], sensitiveTokens),
+      leakedInLogs: containsAny(logged, sensitiveTokens),
+    }).toEqual({
+      executorCalls: 0,
+      missingNamesLocation: true,
+      wrongTypeNamesFieldAndType: true,
+      wrongEnumNamesField: true,
+      leakedInResults: false,
+      leakedInLogs: false,
+    });
+  });
+
+  it('throws at registration time naming the tool when a static inputSchema cannot be compiled', () => {
+    const registry = new ToolRegistry();
+    const brokenDefinition: ToolDefinition = {
+      name: 'broken_tool',
+      description: 'Declares an invalid JSON Schema type',
+      inputSchema: {type: 'not-a-json-schema-type'},
+    };
+
+    expect(() => registry.register(brokenDefinition, async () => 'ok')).toThrow(/broken_tool/);
+  });
+
+  it('validates against the schema a function-valued definition returns on each call and forwards extra properties unchanged', async () => {
+    const registry = new ToolRegistry();
+    let activeField = 'query';
+    const receivedInputs: Array<Record<string, unknown>> = [];
+    registry.register(
+      () => ({
+        name: 'search_docs',
+        description: 'Search documentation',
+        inputSchema: {
+          type: 'object',
+          properties: {[activeField]: {type: 'string'}},
+          required: [activeField],
+        },
+      }),
+      async input => {
+        receivedInputs.push(input);
+        return 'matched';
+      }
+    );
+
+    const rejectedFirst = await registry.execute('search_docs', {topic: 'mars'});
+    await registry.execute('search_docs', {query: 'mars', traceId: 'req-7'});
+    activeField = 'topic';
+    const rejectedAfterFlip = await registry.execute('search_docs', {query: 'mars'});
+    await registry.execute('search_docs', {topic: 'mars'});
+
+    expect({
+      receivedInputs,
+      firstRejectedQuery: /query/.test(rejectedFirst.result),
+      secondRejectedTopic: /topic/.test(rejectedAfterFlip.result),
+    }).toEqual({
+      receivedInputs: [{query: 'mars', traceId: 'req-7'}, {topic: 'mars'}],
+      firstRejectedQuery: true,
+      secondRejectedTopic: true,
+    });
+  });
+
+  it('feeds a schema rejection back through the orchestrator tool loop so the model can correct its call on the next round', async () => {
+    const registry = new ToolRegistry();
+    const executedInputs: Array<Record<string, unknown>> = [];
+    registry.register(weatherDefinition, async input => {
+      executedInputs.push(input);
+      return `18C in ${String(input.location)}`;
+    });
+    const seenRounds: SendMessageParams[] = [];
+    const provider = createScriptedProvider(
+      [
+        [
+          {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}},
+          {type: 'stop', stopReason: 'tool_use'},
+        ],
+        [
+          {type: 'tool_use', toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Berlin'}}},
+          {type: 'stop', stopReason: 'tool_use'},
+        ],
+        [
+          {type: 'text', text: 'Berlin is 18C.'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ],
+      ],
+      seenRounds
+    );
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Assistant'}), registry);
+    const session: ChatSession = {
+      sessionId: 'session-retry',
+      userId: 'user-1',
+      entries: [{role: 'user', content: 'Weather in Berlin?', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+
+    const reply = await orchestrator.processMessage(session);
+
+    expect({
+      reply,
+      executedInputs,
+      roundTwoSawLocationRejection: /location/.test(firstToolResultContent(seenRounds[1])),
+    }).toEqual({
+      reply: 'Berlin is 18C.',
+      executedInputs: [{location: 'Berlin'}],
+      roundTwoSawLocationRejection: true,
+    });
+  });
+});
+
+function createRecordingLogger(lines: string[]): Logger {
+  const record = (category: string, message: string, fields?: Record<string, unknown>) => {
+    lines.push(JSON.stringify({category, message, fields}));
+  };
+  return {
+    debug: record,
+    info: record,
+    warn: record,
+    error: record,
+  };
+}
+
+function containsAny(haystacks: string[], needles: string[]): boolean {
+  return haystacks.some(text => needles.some(needle => text.includes(needle)));
+}
+
+function createScriptedProvider(rounds: MessageChunk[][], seenMessages: SendMessageParams[]): AIProvider {
+  let turn = 0;
+  return {
+    async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      seenMessages.push(params);
+      const chunks = rounds[turn] ?? [];
+      turn += 1;
+      for (const chunk of chunks) {
+        yield chunk;
+      }
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('generateStructured unused');
+    },
+  };
+}
+
+function firstToolResultContent(params: SendMessageParams | undefined): string {
+  const blocks: Array<ToolCallContent | ToolResultContent> = (params?.messages ?? []).flatMap(msg =>
+    typeof msg.content === 'string' ? [] : [...msg.content]
+  );
+  const toolResult = blocks.find((block): block is ToolResultContent => block.type === 'tool_result');
+  return toolResult?.content ?? '';
+}