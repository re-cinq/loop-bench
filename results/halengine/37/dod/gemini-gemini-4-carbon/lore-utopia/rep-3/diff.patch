+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+import type {AIProvider, Message, MessageChunk, SendMessageParams, ToolDefinition} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+import {ToolRegistry} from './registry.js';
+
+const recordingLogger = (lines: string[]): Logger => {
+  const record = (category: string, message: string, fields?: Record<string, unknown>) => {
+    lines.push(JSON.stringify({category, message, fields}));
+  };
+  return {debug: record, info: record, warn: record, error: record};
+};
+
+const asyncOutcome = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved without throwing').catch((error: Error) => error.message);
+
+describe('ToolRegistry inputSchema validation acceptance', () => {
+  let logged: string[];
+
+  beforeEach(() => {
+    logged = [];
+    setLogger(recordingLogger(logged));
+  });
+
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('validates input against inputSchema in execute without invoking the executor or logging rejected values, while forwarding valid input unchanged', async () => {
+    const receivedInputs: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Look up weather for a city',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+            units: {type: 'string', enum: ['celsius', 'fahrenheit'], default: 'celsius'},
+          },
+          required: ['location'],
+        },
+      },
+      async input => {
+        receivedInputs.push(input);
+        return '18C';
+      }
+    );
+
+    const missingRequired = await registry.execute('get_weather', {});
+    const wrongType = await registry.execute('get_weather', {location: 987654321});
+    const enumRejected = await registry.execute('get_weather', {
+      location: 'Berlin',
+      units: 'kelvin-secret-77',
+      callerEmail: 'alice@private.example',
+    });
+    const combinedOutput = [missingRequired.result, wrongType.result, enumRejected.result, ...logged].join(' | ');
+    const validCall = await registry.execute('get_weather', {location: 'Berlin', traceTag: 'keep-extra'});
+    const absentToolError = await asyncOutcome(registry.execute('unregistered_tool', {}));
+
+    expect({
+      missingNamesLocation: /location/.test(missingRequired.result),
+      missingStatesRequired: /required/i.test(missingRequired.result),
+      wrongTypeNamesLocation: /location/.test(wrongType.result),
+      wrongTypeNamesExpectedType: /string/i.test(wrongType.result),
+      enumNamesUnits: /units/.test(enumRejected.result),
+      enumNamesConstraint: /enum|allowed|one of|celsius/i.test(enumRejected.result),
+      leakedNumberValue: combinedOutput.includes('987654321'),
+      leakedEnumValue: combinedOutput.includes('kelvin-secret-77'),
+      leakedIdentifyingValue: combinedOutput.includes('alice@private.example'),
+      executorReceived: receivedInputs,
+      validResult: validCall,
+      absentToolError,
+    }).toEqual({
+      missingNamesLocation: true,
+      missingStatesRequired: true,
+      wrongTypeNamesLocation: true,
+      wrongTypeNamesExpectedType: true,
+      enumNamesUnits: true,
+      enumNamesConstraint: true,
+      leakedNumberValue: false,
+      leakedEnumValue: false,
+      leakedIdentifyingValue: false,
+      executorReceived: [{location: 'Berlin', traceTag: 'keep-extra'}],
+      validResult: {result: '18C'},
+      absentToolError: 'Unknown tool: unregistered_tool',
+    });
+  });
+
+  it('throws at register time when a static tool declares an uncompilable inputSchema, naming the tool', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_weather',
+          description: 'Carries an invalid JSON Schema keyword value',
+          inputSchema: {type: 'not-a-json-schema-type', required: 'not-an-array'},
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow('broken_weather');
+  });
+
+  it('validates a function-valued tool definition against the schema returned on each call rather than a stale cached schema', async () => {
+    const citySchema: Record<string, unknown> = {
+      type: 'object',
+      properties: {city: {type: 'string'}},
+      required: ['city'],
+    };
+    const postalSchema: Record<string, unknown> = {
+      type: 'object',
+      properties: {postalCode: {type: 'string'}},
+      required: ['postalCode'],
+    };
+    let activeSchema = citySchema;
+    const executedInputs: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      (): ToolDefinition => ({
+        name: 'locate_office',
+        description: 'Resolves an office by the active key',
+        inputSchema: activeSchema,
+      }),
+      async input => {
+        executedInputs.push(input);
+        return 'found';
+      }
+    );
+
+    const firstRejected = await registry.execute('locate_office', {postalCode: '10115'});
+    activeSchema = postalSchema;
+    const staleRejected = await registry.execute('locate_office', {city: 'Berlin'});
+    const currentAccepted = await registry.execute('locate_office', {postalCode: '10115'});
+
+    expect({
+      firstNamesCity: /city/.test(firstRejected.result),
+      secondNamesPostalCode: /postalCode/.test(staleRejected.result),
+      acceptedResult: currentAccepted,
+      executedInputs,
+    }).toEqual({
+      firstNamesCity: true,
+      secondNamesPostalCode: true,
+      acceptedResult: {result: 'found'},
+      executedInputs: [{postalCode: '10115'}],
+    });
+  });
+
+  it('feeds a schema rejection back through the orchestrator tool loop as a tool_result so the model can retry and resolve', async () => {
+    const executedCities: unknown[] = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'lookup_forecast',
+        description: 'Look up weather forecast by city',
+        inputSchema: {
+          type: 'object',
+          properties: {city: {type: 'string'}},
+          required: ['city'],
+        },
+      },
+      async input => {
+        executedCities.push(input.city);
+        return `18C in ${String(input.city)}`;
+      }
+    );
+
+    const seenToolResults: string[] = [];
+    const promptBuilder = new PromptBuilder({identity: 'You are a weather assistant.'});
+    const orchestrator = createChatOrchestrator(retryingProvider(seenToolResults), promptBuilder, registry);
+    const session: ChatSession = {
+      sessionId: 's-validation',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'Weather in Berlin?', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+
+    const reply = await orchestrator.processMessage(session);
+    const [firstToolResult = ''] = seenToolResults;
+
+    expect({
+      reply,
+      rejectionNamedCity: /city/.test(firstToolResult),
+      rejectionStatedRequired: /required/i.test(firstToolResult),
+      executedCities,
+    }).toEqual({
+      reply: 'It is 18C in Berlin.',
+      rejectionNamedCity: true,
+      rejectionStatedRequired: true,
+      executedCities: ['Berlin'],
+    });
+  });
+});
+
+function retryingProvider(seenToolResults: string[]): AIProvider {
+  let round = 0;
+  return {
+    async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      const currentRound = round;
+      round += 1;
+      if (currentRound === 0) {
+        yield {type: 'tool_use', toolCall: {id: 'call-bad', name: 'lookup_forecast', input: {}}};
+        yield {type: 'stop', stopReason: 'tool_use'};
+        return;
+      }
+      if (currentRound === 1) {
+        seenToolResults.push(extractToolResult(params.messages, 'call-bad'));
+        yield {type: 'tool_use', toolCall: {id: 'call-good', name: 'lookup_forecast', input: {city: 'Berlin'}}};
+        yield {type: 'stop', stopReason: 'tool_use'};
+        return;
+      }
+      yield {type: 'text', text: 'It is 18C in Berlin.'};
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+function extractToolResult(messages: Message[], toolUseId: string): string {
+  const parts = messages.flatMap(msg => (Array.isArray(msg.content) ? msg.content : []));
+  const match = parts.find(part => part.type === 'tool_result' && part.toolUseId === toolUseId);
+  return match?.type === 'tool_result' ? match.content : '';
+}