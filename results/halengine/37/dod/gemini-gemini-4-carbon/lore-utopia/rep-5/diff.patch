+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+import type {AIProvider, Message, MessageChunk, SendMessageParams, ToolResultContent} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry inputSchema validation', () => {
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('rejects an uncompilable static inputSchema at registration, naming the tool', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_weather',
+          description: 'broken schema tool',
+          inputSchema: {type: 'not-a-json-schema-type'},
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken_weather/);
+  });
+
+  it('returns a validation result without running the tool or leaking values', async () => {
+    const loggedEntries: {message: string; fields?: Record<string, unknown>}[] = [];
+    const recordLog = (_category: string, message: string, fields?: Record<string, unknown>) => {
+      loggedEntries.push({message, fields});
+    };
+    const silentLogger: Logger = {
+      debug: recordLog,
+      info: recordLog,
+      warn: recordLog,
+      error: recordLog,
+    };
+    setLogger(silentLogger);
+
+    let executorCalls = 0;
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'lookup_account',
+        description: 'looks up an account by string identifier',
+        inputSchema: {
+          type: 'object',
+          properties: {account: {type: 'string'}},
+          required: ['account'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'executed';
+      }
+    );
+
+    const response = await registry.execute('lookup_account', {account: 987654321});
+    const resultText = response.result.toLowerCase();
+    const serializedLogs = JSON.stringify(loggedEntries);
+
+    expect({
+      executorCalls,
+      namesField: response.result.includes('account'),
+      namesExpectedType: resultText.includes('string'),
+      leaksValueInResult: response.result.includes('987654321'),
+      leaksValueInLogs: serializedLogs.includes('987654321'),
+    }).toEqual({
+      executorCalls: 0,
+      namesField: true,
+      namesExpectedType: true,
+      leaksValueInResult: false,
+      leaksValueInLogs: false,
+    });
+  });
+
+  it('validates dynamic schemas per call and forwards extra keys unchanged', async () => {
+    let allowedUnits = ['celsius', 'fahrenheit'];
+    const receivedInputs: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      () => ({
+        name: 'convert_temp',
+        description: 'converts temperature',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            units: {type: 'string', enum: allowedUnits},
+            note: {type: 'string', default: 'none'},
+          },
+          required: ['units'],
+        },
+      }),
+      async input => {
+        receivedInputs.push(input);
+        return 'converted';
+      }
+    );
+
+    const firstResponse = await registry.execute('convert_temp', {units: 'fahrenheit', traceId: 'req-42'});
+    allowedUnits = ['celsius'];
+    const secondResponse = await registry.execute('convert_temp', {units: 'fahrenheit'});
+
+    expect({
+      firstResult: firstResponse.result,
+      receivedInputs,
+      secondNamesField: secondResponse.result.includes('units'),
+    }).toEqual({
+      firstResult: 'converted',
+      receivedInputs: [{units: 'fahrenheit', traceId: 'req-42'}],
+      secondNamesField: true,
+    });
+  });
+
+  it('feeds a rejected tool call back to the model so a retry can succeed', async () => {
+    const executedLocations: unknown[] = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'fetches weather for a city',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async input => {
+        executedLocations.push(input.location);
+        return `Sunny in ${String(input.location)}`;
+      }
+    );
+
+    let firstToolResult = '';
+    const provider = createRetryProvider(messages => {
+      firstToolResult = findToolResult(messages, 'call-invalid');
+    });
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'assistant'}), registry);
+    const session: ChatSession = {
+      sessionId: 'session-validation',
+      userId: 'user-1',
+      entries: [{role: 'user', content: 'Weather in Berlin?', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+
+    const reply = await orchestrator.processMessage(session);
+
+    expect({
+      reply,
+      executedLocations,
+      rejectionNamedLocation: firstToolResult.includes('location'),
+    }).toEqual({
+      reply: 'Weather in Berlin: Sunny',
+      executedLocations: ['Berlin'],
+      rejectionNamedLocation: true,
+    });
+  });
+});
+
+function createRetryProvider(onSecondRound: (messages: Message[]) => void): AIProvider {
+  const rounds: MessageChunk[][] = [
+    [
+      {type: 'tool_use', toolCall: {id: 'call-invalid', name: 'get_weather', input: {}}},
+      {type: 'stop', stopReason: 'tool_use'},
+    ],
+    [
+      {type: 'tool_use', toolCall: {id: 'call-valid', name: 'get_weather', input: {location: 'Berlin'}}},
+      {type: 'stop', stopReason: 'tool_use'},
+    ],
+    [
+      {type: 'text', text: 'Weather in Berlin: Sunny'},
+      {type: 'stop', stopReason: 'end_turn'},
+    ],
+  ];
+  let roundIndex = 0;
+
+  return {
+    async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      const currentRound = roundIndex;
+      roundIndex += 1;
+      if (currentRound === 1) onSecondRound(params.messages);
+      for (const chunk of rounds[currentRound] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('unused');
+    },
+  };
+}
+
+function findToolResult(messages: Message[], toolUseId: string): string {
+  const blocks = messages.flatMap(message => (Array.isArray(message.content) ? message.content : []));
+  const match = blocks.find(
+    (block): block is ToolResultContent => block.type === 'tool_result' && block.toolUseId === toolUseId
+  );
+  return match?.content ?? '';
+}