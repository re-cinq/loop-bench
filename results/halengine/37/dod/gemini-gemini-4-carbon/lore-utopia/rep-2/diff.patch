+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {AIProvider, Message, MessageChunk, SendMessageParams} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry inputSchema validation', () => {
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('throws at registration time naming the tool when a static inputSchema cannot be compiled', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_weather',
+          description: 'Forecast lookup with an invalid schema type',
+          inputSchema: {type: 'not-a-json-schema-type'},
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow('broken_weather');
+  });
+
+  it('rejects a wrong-typed field naming the path and expected type without calling the executor or leaking input values', async () => {
+    const logged: string[] = [];
+    const collect = (category: string, message: string, fields?: Record<string, unknown>) => {
+      logged.push(JSON.stringify({category, message, fields}));
+    };
+    setLogger({debug: collect, info: collect, warn: collect, error: collect});
+
+    let calls = 0;
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'lookup_customer',
+        description: 'Looks up a customer record',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            customerId: {type: 'string'},
+            email: {type: 'string'},
+          },
+          required: ['customerId', 'email'],
+        },
+      },
+      async () => {
+        calls += 1;
+        return 'executed';
+      }
+    );
+
+    const response = await registry.execute('lookup_customer', {
+      customerId: 987654321,
+      email: 'alice@example.com',
+    });
+    const logOutput = logged.join(' ');
+
+    expect({
+      calls,
+      namesField: response.result.includes('customerId'),
+      namesExpectedType: response.result.includes('string'),
+      leaksOffendingValue: response.result.includes('987654321') || logOutput.includes('987654321'),
+      leaksIdentifyingValue: response.result.includes('alice@example.com') || logOutput.includes('alice@example.com'),
+    }).toEqual({
+      calls: 0,
+      namesField: true,
+      namesExpectedType: true,
+      leaksOffendingValue: false,
+      leaksIdentifyingValue: false,
+    });
+  });
+
+  it('validates a function-valued tool definition against the schema returned on each call', async () => {
+    let allowedUnits = ['celsius', 'fahrenheit'];
+    let calls = 0;
+    const registry = new ToolRegistry();
+    registry.register(
+      () => ({
+        name: 'set_units',
+        description: 'Sets display temperature units',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            units: {type: 'string', enum: allowedUnits},
+          },
+          required: ['units'],
+        },
+      }),
+      async input => {
+        calls += 1;
+        return `applied:${String(input.units)}`;
+      }
+    );
+
+    const first = await registry.execute('set_units', {units: 'celsius'});
+    allowedUnits = ['kelvin'];
+    const second = await registry.execute('set_units', {units: 'celsius'});
+
+    expect({
+      calls,
+      firstResult: first.result,
+      secondNamesField: second.result.includes('units'),
+    }).toEqual({
+      calls: 1,
+      firstResult: 'applied:celsius',
+      secondNamesField: true,
+    });
+  });
+
+  it('returns a missing-required-field rejection to the model so a retry with extra properties succeeds', async () => {
+    const receivedInputs: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Fetches current weather for a city',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+          },
+          required: ['location'],
+        },
+      },
+      async input => {
+        receivedInputs.push(input);
+        return JSON.stringify({forecast: 'sunny'});
+      }
+    );
+
+    const seenToolResults: string[][] = [];
+    const rounds: MessageChunk[][] = [
+      [
+        {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {
+          type: 'tool_use',
+          toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Berlin', traceId: 'req-42'}},
+        },
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'text', text: 'Sunny in Berlin'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ];
+    let turn = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        seenToolResults.push(extractToolResults(params.messages));
+        for (const chunk of rounds[turn++] ?? []) yield chunk;
+      },
+      async generateStructured<T>(): Promise<T> {
+        throw new Error('generateStructured is not used in tool-loop streaming');
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Weather assistant'}), registry);
+    const session: ChatSession = {
+      sessionId: 'session-retry',
+      userId: 'user-1',
+      entries: [{role: 'user', content: 'Weather in Berlin?', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+
+    const reply = await orchestrator.processMessage(session);
+    const firstRoundResults = seenToolResults[1] ?? [];
+    const firstRejection = firstRoundResults[0] ?? '';
+
+    expect({
+      reply,
+      rejectionNamesRequiredField: firstRejection.includes('location'),
+      receivedInputs,
+    }).toEqual({
+      reply: 'Sunny in Berlin',
+      rejectionNamesRequiredField: true,
+      receivedInputs: [{location: 'Berlin', traceId: 'req-42'}],
+    });
+  });
+});
+
+function extractToolResults(messages: Message[]): string[] {
+  return messages.flatMap(message => {
+    if (typeof message.content === 'string') return [];
+    return message.content.flatMap(part => (part.type === 'tool_result' ? [part.content] : []));
+  });
+}