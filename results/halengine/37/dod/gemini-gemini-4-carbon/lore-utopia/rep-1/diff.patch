+import type {AIProvider, Message, MessageChunk, SendMessageParams} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry inputSchema validation acceptance', () => {
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('rejects wrong-typed input without running executor or leaking values', async () => {
+    const loggedRecords: string[] = [];
+    const pushLog = (category: string, message: string, fields?: Record<string, unknown>) => {
+      loggedRecords.push(JSON.stringify({category, message, fields}));
+    };
+    setLogger({debug: pushLog, info: pushLog, warn: pushLog, error: pushLog});
+
+    let executorCalls = 0;
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'lookupCustomer',
+        description: 'looks up customer details',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+            customerEmail: {type: 'string'},
+          },
+          required: ['location'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'customer record';
+      }
+    );
+
+    const {result} = await registry.execute('lookupCustomer', {
+      location: 987654,
+      customerEmail: 'alice-private@example.org',
+    });
+    const observedText = [result, ...loggedRecords].join(' ');
+
+    expect({
+      executorCalls,
+      mentionsField: result.includes('location'),
+      mentionsExpectedType: /string/i.test(result),
+      leaksOffendingValue: observedText.includes('987654'),
+      leaksCustomerEmail: observedText.includes('alice-private@example.org'),
+    }).toEqual({
+      executorCalls: 0,
+      mentionsField: true,
+      mentionsExpectedType: true,
+      leaksOffendingValue: false,
+      leaksCustomerEmail: false,
+    });
+  });
+
+  it('throws naming the tool when registering an uncompilable static schema', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'brokenForecast',
+          description: 'carries an invalid JSON Schema type',
+          inputSchema: {
+            type: 'object',
+            properties: {location: {type: 'invalid-json-schema-type'}},
+          },
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow(/brokenForecast/);
+  });
+
+  it('validates against dynamic schemas while preserving extra input keys', async () => {
+    let allowedUnits = ['celsius', 'fahrenheit'];
+    const receivedInputs: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      () => ({
+        name: 'weather',
+        description: 'forecasts weather by unit',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            units: {type: 'string', enum: allowedUnits},
+            format: {type: 'string', default: 'compact'},
+          },
+          required: ['units'],
+        },
+      }),
+      async input => {
+        receivedInputs.push(input);
+        return '20 degrees';
+      }
+    );
+
+    const {result: acceptedResult} = await registry.execute('weather', {units: 'fahrenheit', traceId: 'req-7'});
+    allowedUnits = ['celsius'];
+    const {result: rejectedResult} = await registry.execute('weather', {units: 'fahrenheit', traceId: 'req-8'});
+
+    expect({
+      receivedInputs,
+      acceptedResult,
+      rejectedMentionsUnits: rejectedResult.includes('units'),
+    }).toEqual({
+      receivedInputs: [{units: 'fahrenheit', traceId: 'req-7'}],
+      acceptedResult: '20 degrees',
+      rejectedMentionsUnits: true,
+    });
+  });
+
+  it('returns missing-required rejections in the tool loop so retries resolve', async () => {
+    const executedInputs: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'weather',
+        description: 'forecasts city weather',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async input => {
+        executedInputs.push(input);
+        return `Sunny in ${String(input.location)}`;
+      }
+    );
+
+    const scriptedRounds: MessageChunk[][] = [
+      [
+        {type: 'tool_use', toolCall: {id: 'call-1', name: 'weather', input: {}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'call-2', name: 'weather', input: {location: 'Amsterdam'}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'text', text: 'Forecast: Sunny in Amsterdam'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ];
+    const toolResults: string[] = [];
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        const priorResult = latestToolResultText(params.messages);
+        if (priorResult) toolResults.push(priorResult);
+        for (const chunk of scriptedRounds[round++] ?? []) yield chunk;
+      },
+      generateStructured<T>(): Promise<T> {
+        return Promise.reject(new Error('generateStructured unused'));
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'assistant'}), registry);
+    const session: ChatSession = {
+      sessionId: 's-retry',
+      userId: 'u-1',
+      entries: [{role: 'user', content: 'Weather please', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+
+    const reply = await orchestrator.processMessage(session);
+    const [firstToolResult = '', secondToolResult = ''] = toolResults;
+
+    expect({
+      reply,
+      executedInputs,
+      firstMentionsLocation: firstToolResult.includes('location'),
+      secondToolResult,
+    }).toEqual({
+      reply: 'Forecast: Sunny in Amsterdam',
+      executedInputs: [{location: 'Amsterdam'}],
+      firstMentionsLocation: true,
+      secondToolResult: 'Sunny in Amsterdam',
+    });
+  });
+});
+
+function latestToolResultText(messages: Message[]): string {
+  const last = messages[messages.length - 1];
+  if (!last || typeof last.content === 'string') return '';
+  const [first] = last.content;
+  if (!first || first.type !== 'tool_result') return '';
+  return first.content;
+}