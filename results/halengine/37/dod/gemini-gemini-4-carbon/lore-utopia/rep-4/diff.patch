+import {ToolRegistry} from './registry.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+
+describe('ToolRegistry inputSchema validation', () => {
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('enforces required and enum schemas and passes unlisted keys through unchanged', async () => {
+    const receivedInputs: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Looks up weather for a city',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+            units: {type: 'string', enum: ['celsius', 'fahrenheit'], default: 'celsius'},
+          },
+          required: ['location'],
+        },
+      },
+      async input => {
+        receivedInputs.push(input);
+        return String(input.location);
+      }
+    );
+
+    const {result: emptyResult} = await registry.execute('weather', {});
+    const {result: enumResult} = await registry.execute('weather', {location: 'Berlin', units: 'kelvin'});
+    const accepted = await registry.execute('weather', {location: 'Berlin', traceId: 'req-7'});
+
+    expect({
+      receivedInputs,
+      namesLocation: emptyResult.includes('location'),
+      statesRequired: /required/i.test(emptyResult),
+      namesUnits: enumResult.includes('units'),
+      accepted,
+    }).toEqual({
+      receivedInputs: [{location: 'Berlin', traceId: 'req-7'}],
+      namesLocation: true,
+      statesRequired: true,
+      namesUnits: true,
+      accepted: {result: 'Berlin'},
+    });
+  });
+
+  it('rejects a wrong-typed field without leaking input values in results or logs', async () => {
+    const loggedLines: string[] = [];
+    const collect = (category: string, message: string, fields?: Record<string, unknown>) =>
+      void loggedLines.push(JSON.stringify({category, message, fields}));
+    setLogger({debug: collect, info: collect, warn: collect, error: collect});
+
+    let executorCalls = 0;
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'lookupContact',
+        description: 'Looks up a contact record',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            email: {type: 'string'},
+            postcode: {type: 'string'},
+          },
+          required: ['email', 'postcode'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'found';
+      }
+    );
+
+    const {result: rejectionText} = await registry.execute('lookupContact', {
+      email: 'alice.private@example.org',
+      postcode: 987654321,
+    });
+    const combinedLogs = loggedLines.join(' ');
+
+    expect({
+      executorCalls,
+      namesFieldPath: rejectionText.includes('postcode'),
+      namesExpectedType: /string/i.test(rejectionText),
+      logsNameFieldPath: combinedLogs.includes('postcode'),
+      resultHasOffendingValue: rejectionText.includes('987654321'),
+      resultHasIdentifier: rejectionText.includes('alice.private@example.org'),
+      logsHaveOffendingValue: combinedLogs.includes('987654321'),
+      logsHaveIdentifier: combinedLogs.includes('alice.private@example.org'),
+    }).toEqual({
+      executorCalls: 0,
+      namesFieldPath: true,
+      namesExpectedType: true,
+      logsNameFieldPath: true,
+      resultHasOffendingValue: false,
+      resultHasIdentifier: false,
+      logsHaveOffendingValue: false,
+      logsHaveIdentifier: false,
+    });
+  });
+
+  it('throws naming the tool at registration time when a static schema is invalid', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'brokenWeather',
+          description: 'Declares an invalid JSON Schema',
+          inputSchema: {
+            type: 'object',
+            properties: {location: {type: 'not-a-json-schema-type'}},
+            required: 'location',
+          },
+        },
+        async () => 'executed'
+      )
+    ).toThrow('brokenWeather');
+  });
+
+  it('validates a function-valued tool against the schema returned on each call', async () => {
+    let activeField = 'city';
+    const receivedInputs: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      () => ({
+        name: 'dynamicLookup',
+        description: 'Resolves its required field dynamically per call',
+        inputSchema: {
+          type: 'object',
+          properties: {[activeField]: {type: 'string'}},
+          required: [activeField],
+        },
+      }),
+      async input => {
+        receivedInputs.push(input);
+        return 'ok';
+      }
+    );
+
+    const firstCall = await registry.execute('dynamicLookup', {city: 'Berlin'});
+    activeField = 'country';
+    const {result: secondResult} = await registry.execute('dynamicLookup', {city: 'Berlin'});
+
+    expect({
+      firstCall,
+      receivedInputs,
+      namesUpdatedField: secondResult.includes('country'),
+    }).toEqual({
+      firstCall: {result: 'ok'},
+      receivedInputs: [{city: 'Berlin'}],
+      namesUpdatedField: true,
+    });
+  });
+
+  it('returns a validation rejection to the provider so a retry resolves the turn', async () => {
+    const receivedInputs: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Looks up weather for a city',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async input => {
+        receivedInputs.push(input);
+        return `18C in ${String(input.location)}`;
+      }
+    );
+
+    const rounds: MessageChunk[][] = [
+      [
+        {type: 'tool_use', toolCall: {id: 'call-1', name: 'weather', input: {}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'call-2', name: 'weather', input: {location: 'Berlin'}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'text', text: 'It is 18C in Berlin.'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ];
+    let currentRound = 0;
+    const seenToolResults: string[] = [];
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        collectToolResultTexts(params.messages, seenToolResults);
+        for (const chunk of rounds[currentRound++] ?? []) yield chunk;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Test assistant.'}), registry);
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'Weather in Berlin?', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+
+    const reply = await orchestrator.processMessage(session);
+    const [firstToolResult = '', secondToolResult = ''] = seenToolResults;
+
+    expect({
+      reply,
+      receivedInputs,
+      roundCount: seenToolResults.length,
+      firstResultNamesLocation: firstToolResult.includes('location'),
+      secondToolResult,
+    }).toEqual({
+      reply: 'It is 18C in Berlin.',
+      receivedInputs: [{location: 'Berlin'}],
+      roundCount: 2,
+      firstResultNamesLocation: true,
+      secondToolResult: '18C in Berlin',
+    });
+  });
+});
+
+function collectToolResultTexts(messages: SendMessageParams['messages'], into: string[]): void {
+  const lastMessage = messages[messages.length - 1];
+  if (!lastMessage || typeof lastMessage.content === 'string') return;
+  for (const block of lastMessage.content) {
+    if (block.type === 'tool_result') into.push(block.content);
+  }
+}