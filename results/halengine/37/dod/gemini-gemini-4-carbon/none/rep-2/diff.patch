+import {ToolRegistry} from './registry.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {AIProvider, Message, MessageChunk, SendMessageParams} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+
+describe('ToolRegistry inputSchema validation', () => {
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('rejects input violating required or enum without calling the executor, while passing valid extra keys through unchanged', async () => {
+    const registry = new ToolRegistry();
+    const receivedInputs: Array<Record<string, unknown>> = [];
+
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Look up weather for a city',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+            units: {type: 'string', enum: ['celsius', 'fahrenheit'], default: 'celsius'},
+          },
+          required: ['location'],
+        },
+      },
+      async input => {
+        receivedInputs.push(input);
+        return `weather:${String(input.location)}`;
+      }
+    );
+
+    const missingRequired = await registry.execute('get_weather', {});
+    const wrongEnum = await registry.execute('get_weather', {location: 'Berlin', units: 'kelvin'});
+    const validCall = await registry.execute('get_weather', {location: 'Berlin', requestTag: 'keep-me'});
+
+    expect({
+      missingNamesLocation: /location/.test(missingRequired.result),
+      wrongEnumNamesUnits: /units/.test(wrongEnum.result),
+      validResult: validCall.result,
+      receivedInputs,
+    }).toEqual({
+      missingNamesLocation: true,
+      wrongEnumNamesUnits: true,
+      validResult: 'weather:Berlin',
+      receivedInputs: [{location: 'Berlin', requestTag: 'keep-me'}],
+    });
+  });
+
+  it('names the failing field and expected type on a type mismatch without exposing input values in the result or logs', async () => {
+    const loggedEntries: unknown[] = [];
+    setLogger(recordingLogger(loggedEntries));
+
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'lookup_member',
+        description: 'Look up a workspace member',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            email: {type: 'string'},
+            seatCount: {type: 'string'},
+          },
+          required: ['email', 'seatCount'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'member-found';
+      }
+    );
+
+    const response = await registry.execute('lookup_member', {
+      email: 'alice@private.example',
+      seatCount: 739182,
+    });
+    const combinedOutput = [response.result, JSON.stringify(loggedEntries)].join(' ');
+
+    expect({
+      executorCalls,
+      namesField: /seatCount/.test(response.result),
+      namesExpectedType: /string/i.test(response.result),
+      leakedEmail: combinedOutput.includes('alice@private.example'),
+      leakedOffendingValue: combinedOutput.includes('739182'),
+    }).toEqual({
+      executorCalls: 0,
+      namesField: true,
+      namesExpectedType: true,
+      leakedEmail: false,
+      leakedOffendingValue: false,
+    });
+  });
+
+  it('throws at registration time naming the tool when a static inputSchema cannot be compiled', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_weather',
+          description: 'Carries an invalid JSON Schema type keyword',
+          inputSchema: {type: 'not-a-json-schema-type'},
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken_weather/);
+  });
+
+  it('validates a function-valued tool definition against the schema returned for each call rather than a stale one', async () => {
+    const registry = new ToolRegistry();
+    let requiredField = 'city';
+    let executorCalls = 0;
+
+    registry.register(
+      () => ({
+        name: 'locate_office',
+        description: 'Resolve office coordinates',
+        inputSchema: {
+          type: 'object',
+          properties: {[requiredField]: {type: 'string'}},
+          required: [requiredField],
+        },
+      }),
+      async () => {
+        executorCalls += 1;
+        return 'located';
+      }
+    );
+
+    const firstCall = await registry.execute('locate_office', {city: 'Amsterdam'});
+    requiredField = 'postalCode';
+    const secondCall = await registry.execute('locate_office', {city: 'Amsterdam'});
+
+    expect({
+      firstResult: firstCall.result,
+      secondNamesPostalCode: /postalCode/.test(secondCall.result),
+      executorCalls,
+    }).toEqual({
+      firstResult: 'located',
+      secondNamesPostalCode: true,
+      executorCalls: 1,
+    });
+  });
+
+  it('returns a validation failure as a tool_result so the next orchestrator round can correct the call and resolve', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Look up weather for a city',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async input => {
+        executorCalls += 1;
+        return `Sunny in ${String(input.location)}`;
+      }
+    );
+
+    const capturedRequests: SendMessageParams[] = [];
+    const provider = scriptedProvider(
+      [
+        [
+          {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}},
+          {type: 'stop', stopReason: 'tool_use'},
+        ],
+        [
+          {type: 'tool_use', toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Berlin'}}},
+          {type: 'stop', stopReason: 'tool_use'},
+        ],
+        [
+          {type: 'text', text: 'It is Sunny in Berlin.'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ],
+      ],
+      capturedRequests
+    );
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'weather assistant'}), registry);
+    const session: ChatSession = {
+      sessionId: 's-validation-retry',
+      userId: 'u-1',
+      entries: [{role: 'user', content: 'Weather in Berlin?', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+
+    const reply = await orchestrator.processMessage(session);
+    const secondRoundMessages = capturedRequests[1]?.messages ?? [];
+    const firstRoundToolResult = firstToolResultText(secondRoundMessages);
+
+    expect({
+      reply,
+      executorCalls,
+      rejectionSeenByModel: /location/.test(firstRoundToolResult),
+    }).toEqual({
+      reply: 'It is Sunny in Berlin.',
+      executorCalls: 1,
+      rejectionSeenByModel: true,
+    });
+  });
+});
+
+function recordingLogger(sink: unknown[]) {
+  const record =
+    (level: string) =>
+    (category: string, message: string, fields?: Record<string, unknown>): void => {
+      sink.push({level, category, message, fields});
+    };
+  return {
+    debug: record('DEBUG'),
+    info: record('INFO'),
+    warn: record('WARN'),
+    error: record('ERROR'),
+  };
+}
+
+function scriptedProvider(rounds: MessageChunk[][], captured: SendMessageParams[]): AIProvider {
+  let roundIndex = 0;
+  return {
+    async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      captured.push({...params, messages: [...params.messages]});
+      const chunks = rounds[roundIndex] ?? [{type: 'stop', stopReason: 'end_turn'}];
+      roundIndex += 1;
+      for (const chunk of chunks) {
+        yield chunk;
+      }
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('generateStructured unused in tool loop test');
+    },
+  };
+}
+
+function firstToolResultText(messages: Message[]): string {
+  const blocks = messages.flatMap(message => (typeof message.content === 'string' ? [] : message.content));
+  const match = blocks.find(block => block.type === 'tool_result');
+  return match?.type === 'tool_result' ? match.content : '';
+}