+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {AIProvider, MessageChunk, SendMessageParams, ToolDefinition} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+import {ToolRegistry} from './registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+describe('ToolRegistry inputSchema validation', () => {
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('enforces required and enum on execute while passing extra keys through unchanged', async () => {
+    const receivedInputs: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      locationTool('get_weather', {
+        units: {type: 'string', enum: ['celsius', 'fahrenheit'], default: 'celsius'},
+      }),
+      async input => {
+        receivedInputs.push(input);
+        return `forecast:${String(input.location)}`;
+      }
+    );
+
+    const emptyCall = await registry.execute('get_weather', {});
+    const enumCall = await registry.execute('get_weather', {location: 'Berlin', units: 'kelvin'});
+    const validCall = await registry.execute('get_weather', {location: 'Berlin', extraKey: 'preserved'});
+
+    expect({
+      receivedInputs,
+      emptyMentionsLocationRequired: emptyCall.result.includes('location') && /required/i.test(emptyCall.result),
+      enumMentionsUnits: enumCall.result.includes('units'),
+      validResult: validCall.result,
+    }).toEqual({
+      receivedInputs: [{location: 'Berlin', extraKey: 'preserved'}],
+      emptyMentionsLocationRequired: true,
+      enumMentionsUnits: true,
+      validResult: 'forecast:Berlin',
+    });
+  });
+
+  it('names failing paths and expected types while redacting values from results and logs', async () => {
+    const loggedEntries: unknown[] = [];
+    const recordLog = (category: string, message: string, fields?: Record<string, unknown>): void => {
+      loggedEntries.push({category, message, fields});
+    };
+    setLogger({debug: recordLog, info: recordLog, warn: recordLog, error: recordLog});
+
+    let executorCalls = 0;
+    const registry = new ToolRegistry();
+    registry.register(locationTool('lookup_account', {taxIdentifier: {type: 'number'}}), async () => {
+      executorCalls += 1;
+      return 'account-found';
+    });
+
+    const wrongTypeCall = await registry.execute('lookup_account', {location: 987654321});
+    const identifyingCall = await registry.execute('lookup_account', {
+      location: 'Amsterdam',
+      taxIdentifier: 'ssn-999-88-7777',
+    });
+    const combinedOutput = [wrongTypeCall.result, identifyingCall.result, JSON.stringify(loggedEntries)].join(' ');
+
+    expect({
+      executorCalls,
+      wrongTypeNamesPathAndExpectedType:
+        wrongTypeCall.result.includes('location') && /string/i.test(wrongTypeCall.result),
+      identifyingNamesPathAndExpectedType:
+        identifyingCall.result.includes('taxIdentifier') && /number/i.test(identifyingCall.result),
+      leakedNumericValue: combinedOutput.includes('987654321'),
+      leakedIdentifyingValue: combinedOutput.includes('ssn-999-88-7777') || combinedOutput.includes('Amsterdam'),
+    }).toEqual({
+      executorCalls: 0,
+      wrongTypeNamesPathAndExpectedType: true,
+      identifyingNamesPathAndExpectedType: true,
+      leakedNumericValue: false,
+      leakedIdentifyingValue: false,
+    });
+  });
+
+  it('throws at registration time naming the tool when a static schema cannot be compiled', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_lookup',
+          description: 'Carries an invalid JSON Schema type',
+          inputSchema: {type: 'not-a-json-schema-type'},
+        },
+        async () => 'never'
+      )
+    ).toThrow('broken_lookup');
+  });
+
+  it('validates a function-valued tool definition against the schema current at each call', async () => {
+    const schemaRequiring = (requiredField: string): ToolDefinition => ({
+      name: 'dynamic_lookup',
+      description: 'Resolves schema per call',
+      inputSchema: {
+        type: 'object',
+        properties: {[requiredField]: {type: 'string'}},
+        required: [requiredField],
+      },
+    });
+    let activeDefinition = schemaRequiring('city');
+    const executedInputs: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      () => activeDefinition,
+      async input => {
+        executedInputs.push(input);
+        return 'matched';
+      }
+    );
+
+    const firstCall = await registry.execute('dynamic_lookup', {city: 'Utrecht'});
+    activeDefinition = schemaRequiring('postalCode');
+    const staleCall = await registry.execute('dynamic_lookup', {city: 'Utrecht'});
+    const updatedCall = await registry.execute('dynamic_lookup', {postalCode: '3511'});
+
+    expect({
+      firstResult: firstCall.result,
+      staleMentionsPostalCode: staleCall.result.includes('postalCode') && /required/i.test(staleCall.result),
+      updatedResult: updatedCall.result,
+      executedInputs,
+    }).toEqual({
+      firstResult: 'matched',
+      staleMentionsPostalCode: true,
+      updatedResult: 'matched',
+      executedInputs: [{city: 'Utrecht'}, {postalCode: '3511'}],
+    });
+  });
+
+  it('feeds a schema rejection back through the orchestrator loop so retry resolves', async () => {
+    const executedInputs: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(locationTool('get_weather'), async input => {
+      executedInputs.push(input);
+      return `18C in ${String(input.location)}`;
+    });
+
+    const rounds: MessageChunk[][] = [
+      [
+        {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Berlin'}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'text', text: 'It is 18C in Berlin.'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ];
+    const seenMessagesPerRound: string[] = [];
+    let roundIndex = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        seenMessagesPerRound.push(JSON.stringify(params.messages));
+        for (const chunk of rounds[roundIndex++] ?? []) yield chunk;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const session: ChatSession = {
+      sessionId: 'session-1',
+      userId: 'user-1',
+      entries: [{role: 'user', content: 'Weather in Berlin?', timestamp: SENT_AT}],
+    };
+    const orchestrator = createChatOrchestrator(
+      provider,
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      registry
+    );
+    const reply = await orchestrator.processMessage(session);
+    const secondRoundPayload = seenMessagesPerRound[1] ?? '';
+
+    expect({
+      reply,
+      executedInputs,
+      providerSawRejectionForLocation: secondRoundPayload.includes('location') && /required/i.test(secondRoundPayload),
+    }).toEqual({
+      reply: 'It is 18C in Berlin.',
+      executedInputs: [{location: 'Berlin'}],
+      providerSawRejectionForLocation: true,
+    });
+  });
+});
+
+function locationTool(name: string, extraProperties: Record<string, unknown> = {}): ToolDefinition {
+  return {
+    name,
+    description: `Run ${name}`,
+    inputSchema: {
+      type: 'object',
+      properties: {location: {type: 'string'}, ...extraProperties},
+      required: ['location'],
+    },
+  };
+}