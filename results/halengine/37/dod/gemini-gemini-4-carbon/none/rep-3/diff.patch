+import {ToolRegistry} from './registry.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+import type {AIProvider, Message, MessageChunk, SendMessageParams, ToolDefinition} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+
+const FIXED_TIMESTAMP = '2026-01-01T00:00:00.000Z';
+
+describe('ToolRegistry inputSchema validation', () => {
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('returns a schema rejection to the model so a corrected retry runs the executor', async () => {
+    const receivedInputs: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Fetches weather for a city',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+            units: {type: 'string', enum: ['celsius', 'fahrenheit'], default: 'fahrenheit'},
+          },
+          required: ['location'],
+        },
+      },
+      async input => {
+        receivedInputs.push(input);
+        return '18C and sunny';
+      }
+    );
+
+    const observedToolResults: string[] = [];
+    const provider = retryProvider(observedToolResults);
+    const promptBuilder = new PromptBuilder({identity: 'You are a weather assistant.'});
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+
+    const finalReply = await orchestrator.processMessage(userSession('Weather in Berlin?'));
+
+    expect({
+      finalReply,
+      receivedInputs,
+      rejectionNamedMissingField: (observedToolResults[0] ?? '').includes('location'),
+      retryToolResult: observedToolResults[1] ?? '',
+    }).toEqual({
+      finalReply: 'Forecast ready',
+      receivedInputs: [{location: 'Berlin', requestTag: 'trace-9'}],
+      rejectionNamedMissingField: true,
+      retryToolResult: '18C and sunny',
+    });
+  });
+
+  it('names the failing field and expected type while omitting values from result and logs', async () => {
+    const loggedRecords: LoggedRecord[] = [];
+    setLogger(recordingLogger(loggedRecords));
+
+    let executorRan = false;
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'lookup_ticket',
+        description: 'Looks up a support ticket',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            customerEmail: {type: 'string'},
+            filter: {
+              type: 'object',
+              properties: {ticketId: {type: 'string'}},
+              required: ['ticketId'],
+            },
+          },
+          required: ['customerEmail', 'filter'],
+        },
+      },
+      async () => {
+        executorRan = true;
+        return 'ticket-found';
+      }
+    );
+
+    const response = await registry.execute('lookup_ticket', {
+      customerEmail: 'alice@example.com',
+      filter: {ticketId: 987654},
+    });
+    const lowerResult = response.result.toLowerCase();
+    const serializedLogs = JSON.stringify(loggedRecords);
+    const combinedSurface = [response.result, serializedLogs].join(' ');
+
+    expect({
+      executorRan,
+      namedFieldInResult: response.result.includes('ticketId'),
+      namedTypeInResult: lowerResult.includes('string'),
+      namedFieldInLogs: serializedLogs.includes('ticketId'),
+      leakedOffendingValue: combinedSurface.includes('987654'),
+      leakedIdentifyingValue: combinedSurface.includes('alice@example.com'),
+    }).toEqual({
+      executorRan: false,
+      namedFieldInResult: true,
+      namedTypeInResult: true,
+      namedFieldInLogs: true,
+      leakedOffendingValue: false,
+      leakedIdentifyingValue: false,
+    });
+  });
+
+  it('throws at registration time naming the tool when a static inputSchema is invalid', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_forecast',
+          description: 'Declares an invalid JSON Schema type',
+          inputSchema: {type: 'not-a-json-schema-type'},
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow('broken_forecast');
+  });
+
+  it('validates each call against the schema a function-valued definition returns', async () => {
+    const alphaSchema: ToolDefinition['inputSchema'] = {
+      type: 'object',
+      properties: {mode: {type: 'string', enum: ['alpha']}},
+      required: ['mode'],
+    };
+    let activeSchema = alphaSchema;
+    const acceptedModes: string[] = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      (): ToolDefinition => ({
+        name: 'switch_mode',
+        description: 'Switches the active mode',
+        inputSchema: activeSchema,
+      }),
+      async input => {
+        const chosen = String(input.mode);
+        acceptedModes.push(chosen);
+        return `switched:${chosen}`;
+      }
+    );
+
+    const firstResponse = await registry.execute('switch_mode', {mode: 'alpha'});
+    const betaSchema: ToolDefinition['inputSchema'] = {
+      type: 'object',
+      properties: {mode: {type: 'string', enum: ['beta']}},
+      required: ['mode'],
+    };
+    activeSchema = betaSchema;
+    const staleModeResponse = await registry.execute('switch_mode', {mode: 'alpha'});
+    const updatedModeResponse = await registry.execute('switch_mode', {mode: 'beta'});
+
+    expect({
+      acceptedModes,
+      firstResult: firstResponse.result,
+      staleCallNamedField: staleModeResponse.result.includes('mode'),
+      updatedResult: updatedModeResponse.result,
+    }).toEqual({
+      acceptedModes: ['alpha', 'beta'],
+      firstResult: 'switched:alpha',
+      staleCallNamedField: true,
+      updatedResult: 'switched:beta',
+    });
+  });
+});
+
+interface LoggedRecord {
+  level: string;
+  category: string;
+  message: string;
+  fields?: Record<string, unknown>;
+}
+
+function userSession(content: string): ChatSession {
+  return {
+    sessionId: 'session-validation',
+    userId: 'user-validation',
+    entries: [{role: 'user', content, timestamp: FIXED_TIMESTAMP}],
+  };
+}
+
+function retryProvider(observedToolResults: string[]): AIProvider {
+  let callIndex = 0;
+
+  return {
+    async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      const round = callIndex;
+      callIndex += 1;
+
+      if (round === 0) {
+        yield {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}};
+        yield {type: 'stop', stopReason: 'tool_use'};
+        return;
+      }
+
+      observedToolResults.push(latestToolResultContent(params.messages));
+
+      if (round === 1) {
+        yield {
+          type: 'tool_use',
+          toolCall: {
+            id: 'call-2',
+            name: 'get_weather',
+            input: {location: 'Berlin', requestTag: 'trace-9'},
+          },
+        };
+        yield {type: 'stop', stopReason: 'tool_use'};
+        return;
+      }
+
+      yield {type: 'text', text: 'Forecast ready'};
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+function latestToolResultContent(messages: Message[]): string {
+  const latestMessage = messages[messages.length - 1];
+  if (!latestMessage || typeof latestMessage.content === 'string') return '';
+  const [firstResult] = latestMessage.content;
+  if (!firstResult || firstResult.type !== 'tool_result') return '';
+  return firstResult.content;
+}
+
+function recordingLogger(records: LoggedRecord[]): Logger {
+  return {
+    debug: (category, message, fields) => void records.push({level: 'DEBUG', category, message, fields}),
+    info: (category, message, fields) => void records.push({level: 'INFO', category, message, fields}),
+    warn: (category, message, fields) => void records.push({level: 'WARN', category, message, fields}),
+    error: (category, message, fields) => void records.push({level: 'ERROR', category, message, fields}),
+  };
+}