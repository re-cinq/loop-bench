+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry input validation acceptance', () => {
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('throws at registration time naming the tool for an invalid schema', () => {
+    const registry = new ToolRegistry();
+    const brokenDefinition = {
+      name: 'broken_lookup',
+      description: 'Carries an uncompilable JSON Schema',
+      inputSchema: {
+        type: 'not-a-json-schema-type',
+        properties: {query: {type: 42}},
+        required: 'not-an-array',
+      },
+    };
+
+    expect(() => registry.register(brokenDefinition, async () => 'unused')).toThrow('broken_lookup');
+  });
+
+  it('rejects invalid input with path and constraint without leaking values', async () => {
+    const logEntries: string[] = [];
+    const record = (category: string, message: string, fields?: Record<string, unknown>) => {
+      logEntries.push(`${category} ${message} ${JSON.stringify(fields ?? {})}`);
+    };
+    setLogger({debug: record, info: record, warn: record, error: record});
+
+    let executorCalls = 0;
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'lookup_customer',
+        description: 'Look up a customer record',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            customer: {
+              type: 'object',
+              properties: {email: {type: 'string'}},
+              required: ['email'],
+            },
+            tier: {
+              type: 'string',
+              enum: ['free', 'pro'],
+            },
+          },
+          required: ['customer', 'tier'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'EXECUTOR_RAN';
+      }
+    );
+
+    const missing = await registry.execute('lookup_customer', {});
+    const wrongType = await registry.execute('lookup_customer', {
+      customer: {email: 987654321},
+      tier: 'pro',
+    });
+    const badEnum = await registry.execute('lookup_customer', {
+      customer: {email: 'alice@secret.example'},
+      tier: 'secret-vip-tier',
+    });
+
+    const combinedOutput = [missing.result, wrongType.result, badEnum.result, ...logEntries].join(' ');
+
+    expect({
+      executorCalls,
+      missingNamesField: missing.result.includes('customer'),
+      missingNamesConstraint: /required/i.test(missing.result),
+      wrongTypeNamesPath: /customer[./]email/.test(wrongType.result),
+      wrongTypeNamesExpectedType: wrongType.result.includes('string'),
+      badEnumNamesField: badEnum.result.includes('tier'),
+      badEnumNamesConstraint: /enum|allowed|one of/i.test(badEnum.result),
+      leakedSensitiveValue: ['987654321', 'alice@secret.example', 'secret-vip-tier'].some(secret =>
+        combinedOutput.includes(secret)
+      ),
+    }).toEqual({
+      executorCalls: 0,
+      missingNamesField: true,
+      missingNamesConstraint: true,
+      wrongTypeNamesPath: true,
+      wrongTypeNamesExpectedType: true,
+      badEnumNamesField: true,
+      badEnumNamesConstraint: true,
+      leakedSensitiveValue: false,
+    });
+  });
+
+  it('validates each call against a function-valued definition current schema', async () => {
+    const acceptedEnvironments: string[] = [];
+    let allowedEnvironment = 'staging';
+    const registry = new ToolRegistry();
+    registry.register(
+      () => ({
+        name: 'deploy_service',
+        description: 'Deploy to the currently permitted environment',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            environment: {type: 'string', enum: [allowedEnvironment]},
+          },
+          required: ['environment'],
+        },
+      }),
+      async input => {
+        acceptedEnvironments.push(String(input.environment));
+        return 'deployed';
+      }
+    );
+
+    const firstRejected = await registry.execute('deploy_service', {environment: 'production'});
+    allowedEnvironment = 'production';
+    const staleRejected = await registry.execute('deploy_service', {environment: 'staging'});
+    const currentAccepted = await registry.execute('deploy_service', {environment: 'production'});
+
+    expect({
+      acceptedEnvironments,
+      firstRejectedNamesField: firstRejected.result.includes('environment'),
+      staleRejectedNamesField: staleRejected.result.includes('environment'),
+      currentAcceptedResult: currentAccepted.result,
+    }).toEqual({
+      acceptedEnvironments: ['production'],
+      firstRejectedNamesField: true,
+      staleRejectedNamesField: true,
+      currentAcceptedResult: 'deployed',
+    });
+  });
+
+  it('returns schema rejections to the model and passes valid retries unchanged', async () => {
+    const executedInputs: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for a city',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+            units: {type: 'string', enum: ['celsius', 'fahrenheit'], default: 'celsius'},
+          },
+          required: ['location'],
+        },
+      },
+      async input => {
+        executedInputs.push({...input});
+        return '22C in Berlin';
+      }
+    );
+
+    let round = 0;
+    let roundTwoToolResult = '';
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        const currentRound = round;
+        round += 1;
+        if (currentRound === 0) {
+          yield {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        if (currentRound === 1) {
+          roundTwoToolResult = lastToolResult(params);
+          yield {
+            type: 'tool_use',
+            toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Berlin', traceId: 'req-7'}},
+          };
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        yield {type: 'text', text: 'Forecast: 22C in Berlin'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      generateStructured<T>(): Promise<T> {
+        return Promise.reject(new Error('unused'));
+      },
+    };
+
+    const session: ChatSession = {
+      sessionId: 's-accept',
+      userId: 'u-accept',
+      entries: [{role: 'user', content: 'Weather in Berlin?', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Test assistant.'}), registry);
+    const reply = await orchestrator.processMessage(session);
+
+    expect({
+      reply,
+      roundTwoSawLocationRejection: roundTwoToolResult.includes('location'),
+      executedInputs,
+    }).toEqual({
+      reply: 'Forecast: 22C in Berlin',
+      roundTwoSawLocationRejection: true,
+      executedInputs: [{location: 'Berlin', traceId: 'req-7'}],
+    });
+
+    function lastToolResult(params: SendMessageParams): string {
+      const lastMessage = params.messages[params.messages.length - 1];
+      if (!lastMessage) return '';
+      if (typeof lastMessage.content === 'string') return '';
+      const firstBlock = lastMessage.content[0];
+      return firstBlock?.type === 'tool_result' ? firstBlock.content : '';
+    }
+  });
+});