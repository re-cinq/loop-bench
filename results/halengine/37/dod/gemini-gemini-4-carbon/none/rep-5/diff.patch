+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry inputSchema validation', () => {
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('rejects invalid input without invoking the executor or leaking values', async () => {
+    const loggedEntries: unknown[] = [];
+    setLogger(capturingLogger(loggedEntries));
+
+    let executorCalls = 0;
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Look up weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+            units: {type: 'string', enum: ['celsius', 'fahrenheit']},
+            customerEmail: {type: 'string'},
+          },
+          required: ['location'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'forecast';
+      }
+    );
+
+    const omittedLocation = await registry.execute('get_weather', {});
+    const numericLocation = await registry.execute('get_weather', {
+      location: 90210,
+      customerEmail: 'alice@private.example',
+    });
+    const kelvinUnits = await registry.execute('get_weather', {
+      location: 'Berlin',
+      units: 'kelvin',
+      customerEmail: 'alice@private.example',
+    });
+
+    const emittedText = [
+      omittedLocation.result,
+      numericLocation.result,
+      kelvinUnits.result,
+      JSON.stringify(loggedEntries),
+    ].join(' ');
+    const confidentialInputs = ['90210', 'kelvin', 'Berlin', 'alice@private.example'];
+    const leakedInputs = confidentialInputs.filter(secret => emittedText.includes(secret));
+
+    expect({
+      executorCalls,
+      omittedLocationResult: omittedLocation.result,
+      numericLocationResult: numericLocation.result,
+      kelvinUnitsResult: kelvinUnits.result,
+      leakedInputs,
+    }).toEqual({
+      executorCalls: 0,
+      omittedLocationResult: expect.stringMatching(/^(?=.*location)(?=.*required)/is),
+      numericLocationResult: expect.stringMatching(/^(?=.*location)(?=.*string)/is),
+      kelvinUnitsResult: expect.stringMatching(/^(?=.*units)(?=.*(?:enum|allowed))/is),
+      leakedInputs: [],
+    });
+  });
+
+  it('throws at registration time naming the tool when a static schema is invalid', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_forecast',
+          description: 'Tool with an uncompilable JSON Schema type',
+          inputSchema: {type: 'not-a-json-schema-type'},
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken_forecast/);
+  });
+
+  it('validates a function-valued tool definition against each call current schema', async () => {
+    let activeSchema: Record<string, unknown> = {
+      type: 'object',
+      properties: {city: {type: 'string'}},
+      required: ['city'],
+    };
+    let executorCalls = 0;
+    const registry = new ToolRegistry();
+    registry.register(
+      () => ({
+        name: 'dynamic_lookup',
+        description: 'Switches required field between calls',
+        inputSchema: activeSchema,
+      }),
+      async input => {
+        executorCalls += 1;
+        return `looked up ${String(input.city ?? input.postalCode)}`;
+      }
+    );
+
+    const firstResponse = await registry.execute('dynamic_lookup', {city: 'Amsterdam'});
+    activeSchema = {
+      type: 'object',
+      properties: {postalCode: {type: 'string'}},
+      required: ['postalCode'],
+    };
+    const secondResponse = await registry.execute('dynamic_lookup', {city: 'Amsterdam'});
+
+    expect({
+      executorCalls,
+      firstText: firstResponse.result,
+      secondText: secondResponse.result,
+    }).toEqual({
+      executorCalls: 1,
+      firstText: 'looked up Amsterdam',
+      secondText: expect.stringMatching(/^(?=.*postalCode)(?=.*required)/is),
+    });
+  });
+
+  it('feeds a schema rejection back to the model so a retry succeeds with extra keys intact', async () => {
+    const receivedInputs: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'find_station',
+        description: 'Find weather station by city',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            city: {type: 'string'},
+            limit: {type: 'number', default: 5},
+          },
+          required: ['city'],
+        },
+      },
+      async input => {
+        receivedInputs.push(input);
+        return `Station in ${String(input.city)}`;
+      }
+    );
+
+    const observed = {rejectionSeenByModel: ''};
+    const provider = retryingStationProvider(observed);
+    const promptBuilder = new PromptBuilder({identity: 'You are a weather assistant.'});
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+    const session: ChatSession = {
+      sessionId: 'session-retry',
+      userId: 'user-1',
+      entries: [{role: 'user', content: 'Which station covers Berlin?', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+
+    const reply = await orchestrator.processMessage(session);
+
+    expect({
+      reply,
+      rejectionSeenByModel: observed.rejectionSeenByModel,
+      receivedInputs,
+    }).toEqual({
+      reply: 'Berlin Tempelhof station',
+      rejectionSeenByModel: expect.stringMatching(/^(?=.*city)(?=.*required)/is),
+      receivedInputs: [{city: 'Berlin', requestTag: 'trace-7'}],
+    });
+  });
+});
+
+function capturingLogger(sink: unknown[]): Logger {
+  const record = (category: string, message: string, fields?: Record<string, unknown>): void => {
+    sink.push({category, message, fields});
+  };
+  return {debug: record, info: record, warn: record, error: record};
+}
+
+function retryingStationProvider(observed: {rejectionSeenByModel: string}): AIProvider {
+  let round = 0;
+  return {
+    async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      const currentRound = round;
+      round += 1;
+      if (currentRound === 0) {
+        yield {type: 'tool_use', toolCall: {id: 'call-1', name: 'find_station', input: {}}};
+        yield {type: 'stop', stopReason: 'tool_use'};
+        return;
+      }
+      if (currentRound === 1) {
+        observed.rejectionSeenByModel = lastToolResultText(params);
+        yield {
+          type: 'tool_use',
+          toolCall: {id: 'call-2', name: 'find_station', input: {city: 'Berlin', requestTag: 'trace-7'}},
+        };
+        yield {type: 'stop', stopReason: 'tool_use'};
+        return;
+      }
+      yield {type: 'text', text: 'Berlin Tempelhof station'};
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('structured output unused in tool retry test');
+    },
+  };
+}
+
+function lastToolResultText(params: SendMessageParams): string {
+  const {messages} = params;
+  const latestMessage = messages[messages.length - 1];
+  if (!latestMessage || !Array.isArray(latestMessage.content)) return '';
+  const firstBlock = latestMessage.content[0];
+  if (!firstBlock || firstBlock.type !== 'tool_result') return '';
+  return firstBlock.content;
+}