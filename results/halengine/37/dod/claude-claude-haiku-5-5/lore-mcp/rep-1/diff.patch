+import {jest} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+import type {ToolExecutor} from './registry.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, Message, SendMessageParams, ToolDefinition} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const WEATHER: ToolDefinition = {
+  name: 'get_weather',
+  description: 'Forecast for a location',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}},
+    required: ['location'],
+  },
+};
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+// Records a snapshot of each request so later rounds cannot rewrite what an earlier round saw.
+function scriptedProvider(turns: MessageChunk[][]): {provider: AIProvider; requests: SendMessageParams[]} {
+  const requests: SendMessageParams[] = [];
+  const provider: AIProvider = {
+    async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      requests.push({...params, messages: [...params.messages]});
+      for (const chunk of turns[requests.length - 1]) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  return {provider, requests};
+}
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function toolResultTexts(messages: Message[]): string[] {
+  return messages
+    .flatMap(m => (m.role === 'user' && Array.isArray(m.content) ? m.content : []))
+    .filter(c => c.type === 'tool_result')
+    .map(c => c.content);
+}
+
+describe('ToolRegistry input validation', () => {
+  it('returns a rejection naming a missing required property and never invokes the executor', async () => {
+    const registry = new ToolRegistry();
+    const executor = jest.fn(async () => 'Forecast: sunny');
+    registry.register(WEATHER, executor);
+
+    const response = await registry.execute('get_weather', {});
+
+    expect(response.result).toContain('location');
+    expect(response.result).toContain('required');
+    expect(executor).toHaveBeenCalledTimes(0);
+  });
+
+  it('rejects a wrong-typed property with its path and expected type, never echoing the value', async () => {
+    const registry = new ToolRegistry();
+    const executor = jest.fn(async () => 'Forecast: sunny');
+    registry.register(WEATHER, executor);
+
+    const response = await registry.execute('get_weather', {location: 4815162342});
+
+    expect(response.result).toContain('location');
+    expect(response.result).toContain('string');
+    expect(response.result).not.toContain('4815162342');
+    expect(executor).toHaveBeenCalledTimes(0);
+  });
+
+  it('throws at register time for an uncompilable schema, naming the tool', () => {
+    const registry = new ToolRegistry();
+    const executor: ToolExecutor = async () => 'unused';
+    const broken: ToolDefinition = {
+      name: 'broken_tool',
+      description: 'Declares a type JSON Schema does not have',
+      inputSchema: {type: 'not-a-json-schema-type'},
+    };
+
+    expect(() => registry.register(broken, executor)).toThrow(/broken_tool/);
+  });
+
+  it('validates each call against the schema its source returns at that call, not a cached one', async () => {
+    const registry = new ToolRegistry();
+    const executor = jest.fn(async () => 'Forecast: sunny');
+    let requiredField = 'location';
+    registry.register(
+      (): ToolDefinition => ({
+        name: 'get_weather',
+        description: 'Forecast for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}, city: {type: 'string'}},
+          required: [requiredField],
+        },
+      }),
+      executor
+    );
+
+    await registry.execute('get_weather', {location: 'Oslo'});
+    requiredField = 'city';
+    const response = await registry.execute('get_weather', {location: 'Oslo'});
+
+    expect(response.result).toContain('city');
+    expect(executor).toHaveBeenCalledTimes(1);
+  });
+
+  it('hands a rejected tool call to the model as a result, so a corrected retry completes the turn', async () => {
+    const registry = new ToolRegistry();
+    registry.register(WEATHER, async () => 'Forecast: sunny');
+    const {provider, requests} = scriptedProvider([
+      [
+        {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Oslo'}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'text', text: 'Sunny in Oslo.'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ]);
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+
+    await expect(orchestrator.processMessage(createSession('weather?'))).resolves.toBe('Sunny in Oslo.');
+    expect(toolResultTexts(requests[1].messages).join('\n')).toContain('location');
+  });
+});