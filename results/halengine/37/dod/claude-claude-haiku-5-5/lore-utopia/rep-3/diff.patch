+import {describe, expect, it} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+// Pins what execute does with input its declared inputSchema rejects, through the registry's own entry point.
+
+const WEATHER: ToolDefinition = {
+  name: 'get_weather',
+  description: 'Forecast for a location',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}},
+    required: ['location'],
+  },
+};
+
+describe('ToolRegistry.execute input validation', () => {
+  it('answers a call missing a required property with a rejection naming it, and never runs the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(WEATHER, async () => {
+      executorCalls++;
+      return 'forecast';
+    });
+
+    const response = await registry.execute('get_weather', {});
+
+    expect(response.result).toContain('location');
+    expect(response.result).toMatch(/required/i);
+    expect(executorCalls).toBe(0);
+  });
+
+  it('answers a wrong-typed property with its path and expected type, without echoing the offending value', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(WEATHER, async () => {
+      executorCalls++;
+      return 'forecast';
+    });
+
+    const response = await registry.execute('get_weather', {location: 4242});
+
+    expect(response.result).toContain('location');
+    expect(response.result).toContain('string');
+    expect(response.result).not.toContain('4242');
+    expect(executorCalls).toBe(0);
+  });
+});