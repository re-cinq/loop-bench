+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const weather = (location: Record<string, unknown> = {type: 'string'}): ToolDefinition => ({
+  name: 'get_weather',
+  description: 'Get the current weather for a location.',
+  inputSchema: {
+    type: 'object',
+    properties: {location},
+    required: ['location'],
+  },
+});
+
+describe('ToolRegistry.execute validates input against inputSchema', () => {
+  it('rejects input missing a required property before the executor runs', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(weather(), async () => {
+      executorCalls += 1;
+      return 'forecast';
+    });
+
+    const response = await registry.execute('get_weather', {});
+
+    expect(response.result).toContain('location');
+    expect(response.result).toMatch(/required/i);
+    expect(executorCalls).toBe(0);
+  });
+
+  it('rejects a wrong-typed field naming its path and expected type, never echoing the value', async () => {
+    const registry = new ToolRegistry();
+    registry.register(weather(), async () => 'forecast');
+
+    const response = await registry.execute('get_weather', {location: 4242424});
+
+    expect(response.result).toContain('location');
+    expect(response.result).toContain('string');
+    expect(response.result).not.toContain('4242424');
+  });
+
+  it('throws at register time for an uncompilable schema, naming the tool', () => {
+    const registry = new ToolRegistry();
+    const broken: ToolDefinition = {
+      name: 'broken_tool',
+      description: 'A tool whose schema cannot compile.',
+      inputSchema: {type: 'not-a-json-schema-type'},
+    };
+
+    expect(() => registry.register(broken, async () => 'unused')).toThrow(/broken_tool/);
+  });
+
+  it('validates a function-valued definition against the schema current at each call', async () => {
+    const registry = new ToolRegistry();
+    let requireLocation = true;
+    const open: ToolDefinition = {
+      name: 'get_weather',
+      description: 'Get the current weather for a location.',
+      inputSchema: {type: 'object', properties: {location: {type: 'string'}}},
+    };
+    registry.register(
+      () => (requireLocation ? weather() : open),
+      async () => 'forecast'
+    );
+
+    const strict = await registry.execute('get_weather', {});
+    expect(strict.result).toContain('location');
+
+    requireLocation = false;
+    const permissive = await registry.execute('get_weather', {});
+    expect(permissive.result).toBe('forecast');
+  });
+});