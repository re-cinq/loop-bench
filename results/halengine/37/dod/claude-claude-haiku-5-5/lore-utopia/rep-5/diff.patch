+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const weatherTool: ToolDefinition = {
+  name: 'get_weather',
+  description: 'Forecast for a location',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}},
+    required: ['location'],
+  },
+};
+
+const context = {userId: 'u1'};
+
+// Counts executor runs. The ticket's claim is whether the executor runs at all on a malformed call.
+function countingExecutor() {
+  const seen = {calls: 0};
+  const execute = async (): Promise<string> => {
+    seen.calls += 1;
+    return 'Sunny in Lisbon';
+  };
+  return {seen, execute};
+}
+
+describe('ToolRegistry.execute input validation', () => {
+  it('returns a rejection naming a missing required property and never runs the executor', async () => {
+    const registry = new ToolRegistry();
+    const {seen, execute} = countingExecutor();
+    registry.register(weatherTool, execute);
+
+    const response = await registry.execute('get_weather', {}, context);
+
+    expect(response.result).toContain('location');
+    expect(response.result).toMatch(/required/i);
+    expect(seen.calls).toBe(0);
+  });
+
+  it('returns a rejection naming the field path and expected type, without echoing the offending value', async () => {
+    const registry = new ToolRegistry();
+    const {seen, execute} = countingExecutor();
+    registry.register(weatherTool, execute);
+
+    const response = await registry.execute('get_weather', {location: 90210}, context);
+
+    expect(response.result).toContain('location');
+    expect(response.result).toContain('string');
+    expect(response.result).not.toContain('90210');
+    expect(seen.calls).toBe(0);
+  });
+
+  it('throws at register time for a schema that will not compile, naming the tool', () => {
+    const registry = new ToolRegistry();
+    const broken: ToolDefinition = {
+      name: 'broken_tool',
+      description: 'Schema the validator cannot compile',
+      inputSchema: {type: 'nonsense'},
+    };
+
+    expect(() => registry.register(broken, countingExecutor().execute)).toThrow('broken_tool');
+  });
+});