+import {describe, expect, it} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+// Acceptance for ticket #37: ToolRegistry.execute validates input against the tool's inputSchema.
+
+const LOCATION_SCHEMA = {
+  type: 'object',
+  properties: {location: {type: 'string'}},
+  required: ['location'],
+};
+
+const WEATHER_TOOL: ToolDefinition = {
+  name: 'get_weather',
+  description: 'Forecast for a place',
+  inputSchema: LOCATION_SCHEMA,
+};
+
+describe('ToolRegistry.execute input validation', () => {
+  it('refuses a call missing a required property without running the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(WEATHER_TOOL, async () => {
+      executorCalls += 1;
+      return 'forecast';
+    });
+
+    const response = await registry.execute('get_weather', {});
+
+    expect(response.result).toMatch(/location/);
+    expect(response.result).toMatch(/required/i);
+    expect(executorCalls).toBe(0);
+  });
+
+  it('refuses a wrong-typed property, naming its path and expected type but not its value', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(WEATHER_TOOL, async () => {
+      executorCalls += 1;
+      return 'forecast';
+    });
+
+    const response = await registry.execute('get_weather', {location: 4242});
+
+    expect(response.result).toMatch(/location/);
+    expect(response.result).toMatch(/string/);
+    expect(response.result).not.toContain('4242');
+    expect(executorCalls).toBe(0);
+  });
+
+  it('throws at register time for a schema that cannot be compiled, naming the tool', () => {
+    const registry = new ToolRegistry();
+    const broken: ToolDefinition = {
+      name: 'broken_tool',
+      description: 'Declares a type JSON Schema does not have',
+      inputSchema: {type: 'not-a-json-type'},
+    };
+
+    expect(() => registry.register(broken, async () => 'unreachable')).toThrow(/broken_tool/);
+  });
+
+  it('validates a function-valued definition against the schema resolved for that call', async () => {
+    const registry = new ToolRegistry();
+    let strict = true;
+    let executorCalls = 0;
+    registry.register(
+      () => ({
+        name: 'get_weather',
+        description: 'Forecast for a place',
+        inputSchema: strict ? LOCATION_SCHEMA : {type: 'object', properties: {}},
+      }),
+      async () => {
+        executorCalls += 1;
+        return 'ok';
+      }
+    );
+
+    const strictResponse = await registry.execute('get_weather', {});
+    expect(strictResponse.result).toMatch(/location/);
+
+    strict = false;
+    const looseResponse = await registry.execute('get_weather', {});
+    expect(looseResponse.result).toBe('ok');
+    expect(executorCalls).toBe(1);
+  });
+});