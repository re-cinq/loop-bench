+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const weatherDefinition: ToolDefinition = {
+  name: 'weather',
+  description: 'Forecast for a location',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}},
+    required: ['location'],
+  },
+};
+
+describe('ToolRegistry input validation', () => {
+  it('returns a rejection naming the missing required property and never calls the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(weatherDefinition, async () => {
+      executorCalls++;
+      return 'executed';
+    });
+
+    const response = await registry.execute('weather', {});
+
+    expect(response.result).toMatch(/location/);
+    expect(response.result).toMatch(/required/i);
+    expect(executorCalls).toBe(0);
+  });
+
+  it('rejects a wrong-typed field naming its path and expected type, without echoing the value', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(weatherDefinition, async () => {
+      executorCalls++;
+      return 'executed';
+    });
+
+    const response = await registry.execute('weather', {location: 4815162342});
+
+    expect(response.result).toMatch(/location/);
+    expect(response.result).toMatch(/string/);
+    expect(response.result).not.toContain('4815162342');
+    expect(executorCalls).toBe(0);
+  });
+
+  it('throws at register time for an uncompilable schema, naming the tool', () => {
+    const registry = new ToolRegistry();
+    const broken: ToolDefinition = {
+      name: 'broken-tool',
+      description: 'Schema with an unknown type keyword',
+      inputSchema: {type: 'not-a-type'},
+    };
+
+    expect(() => registry.register(broken, async () => 'executed')).toThrow(/broken-tool/);
+  });
+
+  it('validates each call against the schema the function-valued source returns at that call', async () => {
+    const registry = new ToolRegistry();
+    let requiredKey = 'location';
+    registry.register(
+      () => ({
+        name: 'lookup',
+        description: 'Lookup by one of two keys',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}, city: {type: 'string'}},
+          required: [requiredKey],
+        },
+      }),
+      async () => 'executed'
+    );
+
+    const first = await registry.execute('lookup', {city: 'Oslo'});
+    expect(first.result).toMatch(/location/);
+
+    requiredKey = 'city';
+    const second = await registry.execute('lookup', {location: 'Oslo'});
+    expect(second.result).toMatch(/city/);
+  });
+});