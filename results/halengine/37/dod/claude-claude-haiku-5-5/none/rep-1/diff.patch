+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+// Acceptance tests for input validation in ToolRegistry.execute, via the real register/execute entry points.
+
+const WEATHER: ToolDefinition = {
+  name: 'get_weather',
+  description: 'Forecast for a location',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}},
+    required: ['location'],
+  },
+};
+
+describe('ToolRegistry input validation', () => {
+  it('rejects a call missing a required property and never runs the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(WEATHER, async () => {
+      executorCalls += 1;
+      return 'forecast';
+    });
+
+    const response = await registry.execute('get_weather', {});
+
+    expect(response.result).toContain('location');
+    expect(response.result).toMatch(/required/i);
+    expect(executorCalls).toBe(0);
+  });
+
+  it('rejects a wrong-typed field with its path and expected type, never the offending value', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(WEATHER, async () => {
+      executorCalls += 1;
+      return 'forecast';
+    });
+
+    const response = await registry.execute('get_weather', {location: 4242});
+
+    expect(response.result).toContain('location');
+    expect(response.result).toContain('string');
+    expect(response.result).not.toContain('4242');
+    expect(executorCalls).toBe(0);
+  });
+
+  it('refuses a schema that cannot be compiled at register time, naming the tool', () => {
+    const registry = new ToolRegistry();
+    const broken: ToolDefinition = {
+      name: 'broken_tool',
+      description: 'Schema that is not valid JSON Schema',
+      inputSchema: {type: 'strng'},
+    };
+
+    expect(() => registry.register(broken, async () => 'unused')).toThrow(/broken_tool/);
+  });
+});