+import {ToolRegistry} from './registry.js';
+
+// A declared schema the provider is handed verbatim: `location` is a required string.
+const weatherTool = {
+  name: 'get_weather',
+  description: 'Forecast for a place',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}},
+    required: ['location'],
+  },
+};
+
+// A plain counter stands in for the executor's observable side effect, so the test asserts on
+// whether the executor ran at all rather than on what it returned.
+function registryWithCountingExecutor(): {registry: ToolRegistry; callCount: () => number} {
+  let calls = 0;
+  const registry = new ToolRegistry();
+  registry.register(weatherTool, async () => {
+    calls += 1;
+    return 'Sunny, 21C';
+  });
+  return {registry, callCount: () => calls};
+}
+
+describe('ToolRegistry.execute validates input against the declared inputSchema', () => {
+  it('rejects input missing a required property without invoking the executor', async () => {
+    const {registry, callCount} = registryWithCountingExecutor();
+
+    const response = await registry.execute('get_weather', {});
+
+    expect(response.result).toContain('location');
+    expect(response.result).toMatch(/required/i);
+    expect(callCount()).toBe(0);
+  });
+
+  it('rejects a wrong-typed property naming its path and expected type, never echoing the value', async () => {
+    const {registry, callCount} = registryWithCountingExecutor();
+
+    const response = await registry.execute('get_weather', {location: 4217});
+
+    expect(response.result).toContain('location');
+    expect(response.result).toContain('string');
+    expect(response.result).not.toContain('4217');
+    expect(callCount()).toBe(0);
+  });
+});