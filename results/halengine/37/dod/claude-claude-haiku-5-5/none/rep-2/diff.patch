+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const WEATHER_TOOL: ToolDefinition = {
+  name: 'get_weather',
+  description: 'Get the current weather for a location.',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}},
+    required: ['location'],
+  },
+};
+
+describe('ToolRegistry.execute validates input against inputSchema', () => {
+  it('rejects input missing a required property and names it, without calling the executor', async () => {
+    const seen: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(WEATHER_TOOL, async input => {
+      seen.push(input);
+      return 'a confident forecast';
+    });
+
+    const response = await registry.execute('get_weather', {});
+
+    expect(response.result).toContain('location');
+    expect(seen).toHaveLength(0);
+  });
+
+  it('rejects a wrong-typed property naming its path and expected type, never the offending value', async () => {
+    const seen: Record<string, unknown>[] = [];
+    const registry = new ToolRegistry();
+    registry.register(WEATHER_TOOL, async input => {
+      seen.push(input);
+      return 'a confident forecast';
+    });
+
+    const response = await registry.execute('get_weather', {location: 31337});
+
+    expect(response.result).toContain('location');
+    expect(response.result).toContain('string');
+    expect(response.result).not.toContain('31337');
+    expect(seen).toHaveLength(0);
+  });
+});