+import {ToolRegistry} from './registry.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const WEATHER = {
+  name: 'get_weather',
+  description: 'Get the current weather for a location.',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}},
+    required: ['location'],
+  },
+};
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+describe('ToolRegistry.execute input validation', () => {
+  it('answers a call missing a required property with a rejection naming it, without running the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(WEATHER, async () => {
+      executorCalls++;
+      return 'forecast';
+    });
+
+    const response = await registry.execute('get_weather', {});
+
+    expect(response.result).toContain('location');
+    expect(response.result).toContain('required');
+    expect(executorCalls).toBe(0);
+  });
+
+  it('names the property path and expected type for a wrong-typed value, and never echoes the value', async () => {
+    const registry = new ToolRegistry();
+    registry.register(WEATHER, async () => 'forecast');
+
+    const response = await registry.execute('get_weather', {location: 4217});
+
+    expect(response.result).toContain('location');
+    expect(response.result).toContain('string');
+    expect(response.result).not.toContain('4217');
+  });
+
+  it('fails registration of a tool whose inputSchema cannot be compiled, and the error names the tool', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {name: 'broken_tool', description: 'never compiles', inputSchema: {type: 'nonsense'}},
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken_tool/);
+  });
+
+  it('hands a rejected tool call back to the model so a corrected retry completes the turn', async () => {
+    const registry = new ToolRegistry();
+    registry.register(WEATHER, async input => `forecast for ${(input.location as string) || 'Unknown'}`);
+
+    const calls = [
+      {id: 'call-1', name: 'get_weather', input: {}},
+      {id: 'call-2', name: 'get_weather', input: {location: 'Paris'}},
+    ];
+    const roundsSeen: string[][] = [];
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        roundsSeen.push(
+          params.messages
+            .flatMap(m => (Array.isArray(m.content) && m.role === 'user' ? m.content : []))
+            .map(c => ('content' in c ? c.content : ''))
+        );
+        const current = round++;
+        if (current < calls.length) {
+          yield {type: 'tool_use', toolCall: calls[current]};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        yield {type: 'text', text: 'done'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      provider,
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      registry
+    );
+
+    const text = await orchestrator.processMessage(createSession('weather?'));
+
+    expect(text).toBe('done');
+    expect(roundsSeen[1].join('\n')).toContain('location');
+  });
+});