+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+// The weather tool from docs/adding-a-tool.md: `location` is required and must be a string.
+const WEATHER: ToolDefinition = {
+  name: 'weather',
+  description: 'Forecast for a location',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}},
+    required: ['location'],
+  },
+};
+
+describe('ToolRegistry.execute input validation', () => {
+  it('rejects input missing a required property and does not invoke the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(WEATHER, async () => {
+      executorCalls++;
+      return 'forecast';
+    });
+
+    const response = await registry.execute('weather', {});
+
+    expect(executorCalls).toBe(0);
+    expect(response.result).toContain('location');
+    expect(response.result).toMatch(/required/i);
+  });
+
+  it('rejects a wrong-typed property naming its path and expected type, never echoing the value', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(WEATHER, async () => {
+      executorCalls++;
+      return 'forecast';
+    });
+
+    const response = await registry.execute('weather', {location: 4242});
+
+    expect(executorCalls).toBe(0);
+    expect(response.result).toContain('location');
+    expect(response.result).toContain('string');
+    expect(response.result).not.toContain('4242');
+  });
+});