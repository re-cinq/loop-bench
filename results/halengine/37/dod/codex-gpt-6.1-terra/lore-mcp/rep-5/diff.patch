@@ -0,0 +1,73 @@
+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+
+const schema = {
+  type: 'object',
+  properties: {location: {type: 'string'}, unit: {type: 'string', enum: ['celsius', 'fahrenheit'], default: 'celsius'}},
+  required: ['location'],
+};
+
+describe('tool input validation', () => {
+  it('rejects invalid input before execution while preserving valid input', async () => {
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+    registry.register({name: 'weather', description: 'Weather', inputSchema: schema}, async input => {
+      received.push(input);
+      return 'forecast';
+    });
+
+    const missing = await registry.execute('weather', {});
+    expect(missing.result).toMatch(/location/i);
+    expect(missing.result).toMatch(/required/i);
+    expect(received).toHaveLength(0);
+
+    const wrongType = await registry.execute('weather', {location: 12345});
+    expect(wrongType.result).toMatch(/location/i);
+    expect(wrongType.result).toMatch(/string/i);
+    expect(wrongType.result).not.toContain('12345');
+    const wrongEnum = await registry.execute('weather', {location: 'Berlin', unit: 'kelvin'});
+    expect(wrongEnum.result).toMatch(/unit/i);
+    expect(received).toHaveLength(0);
+
+    const valid = {location: 'Berlin', extra: 'retained'};
+    expect(await registry.execute('weather', valid)).toEqual({result: 'forecast'});
+    expect(received).toEqual([valid]);
+    await expect(registry.execute('missing', {})).rejects.toThrow('Unknown tool: missing');
+  });
+
+  it('rejects a malformed static schema at registration with the tool name', () => {
+    const registry = new ToolRegistry();
+    expect(() =>
+      registry.register({name: 'broken', description: 'Broken', inputSchema: {type: 'not-a-type'}}, async () => 'ok')
+    ).toThrow(/broken/i);
+  });
+
+  it('validates each dynamically resolved schema without exposing input values', async () => {
+    const registry = new ToolRegistry();
+    let required = 'location';
+    let executions = 0;
+    const lines: string[] = [];
+    const record = (category: string, message: string, fields?: Record<string, unknown>): void => {
+      lines.push(JSON.stringify({category, message, fields}));
+    };
+    setLogger({debug: record, info: record, warn: record, error: record});
+    try {
+      registry.register(
+        () => ({name: 'dynamic', description: 'Dynamic', inputSchema: {type: 'object', required: [required]}}),
+        async () => {
+          executions++;
+          return 'executed';
+        }
+      );
+      expect(await registry.execute('dynamic', {location: 'Berlin'})).toEqual({result: 'executed'});
+      required = 'destination';
+      const rejection = await registry.execute('dynamic', {location: 'private-person-987'});
+      expect(rejection.result).toMatch(/destination/i);
+      expect(rejection.result).toMatch(/required/i);
+      expect(executions).toBe(1);
+      expect(JSON.stringify({rejection, lines})).not.toContain('private-person-987');
+    } finally {
+      setLogger();
+    }
+  });
+});