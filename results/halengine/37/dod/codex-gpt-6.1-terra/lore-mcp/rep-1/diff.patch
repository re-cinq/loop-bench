@@ -0,0 +1,69 @@
+import {ToolRegistry} from './registry.js';
+
+const weather = {
+  name: 'weather',
+  description: 'Get a forecast',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}, units: {type: 'string', enum: ['metric', 'imperial'], default: 'metric'}},
+    required: ['location'],
+  },
+};
+
+describe('tool input validation', () => {
+  it('rejects invalid input and passes valid input through unchanged', async () => {
+    const registry = new ToolRegistry();
+    const calls: Record<string, unknown>[] = [];
+    registry.register(weather, async input => {
+      calls.push(input);
+      return 'forecast';
+    });
+    const missing = await registry.execute('weather', {});
+    const wrongType = await registry.execute('weather', {location: 74291});
+    const wrongEnum = await registry.execute('weather', {location: 'Berlin', units: 'kelvin'});
+    const valid = {location: 'Berlin', extra: 'retained'};
+    const accepted = await registry.execute('weather', valid);
+    expect({
+      missing: missing.result,
+      wrongType: wrongType.result,
+      wrongEnum: wrongEnum.result,
+      calls,
+      accepted,
+    }).toEqual({
+      missing: expect.stringMatching(/location.*required|required.*location/i),
+      wrongType: expect.stringMatching(/location.*string|string.*location/i),
+      wrongEnum: expect.stringMatching(/units.*(enum|allowed)|(enum|allowed).*units/i),
+      calls: [valid],
+      accepted: {result: 'forecast'},
+    });
+    expect(wrongType.result).not.toContain('74291');
+  });
+
+  it('rejects an invalid static schema when the tool is registered', () => {
+    const registry = new ToolRegistry();
+    expect(() =>
+      registry.register({...weather, inputSchema: {type: 'not-a-json-schema-type'}}, async () => 'ok')
+    ).toThrow(/weather/i);
+  });
+
+  it('validates each call against the current dynamic definition', async () => {
+    const registry = new ToolRegistry();
+    let required = 'location';
+    const calls: Record<string, unknown>[] = [];
+    registry.register(
+      () => ({...weather, inputSchema: {...weather.inputSchema, required: [required]}}),
+      async input => {
+        calls.push(input);
+        return 'forecast';
+      }
+    );
+    const first = await registry.execute('weather', {});
+    required = 'units';
+    const second = await registry.execute('weather', {location: 'Berlin'});
+    expect({first: first.result, second: second.result, calls}).toEqual({
+      first: expect.stringMatching(/location.*required|required.*location/i),
+      second: expect.stringMatching(/units.*required|required.*units/i),
+      calls: [],
+    });
+  });
+});