--- /dev/null
+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,64 @@
+import {ToolRegistry} from './registry.js';
+
+const definition = {
+  name: 'weather',
+  description: 'Get a forecast',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}, unit: {type: 'string', enum: ['celsius', 'fahrenheit']}},
+    required: ['location'],
+  },
+};
+
+// specs/hal-engine-tool-input-validation/spec.md#1
+it('rejects invalid input and passes valid input unchanged', async () => {
+  const registry = new ToolRegistry();
+  const received: Record<string, unknown>[] = [];
+  registry.register(definition, async input => {
+    received.push(input);
+    return 'forecast';
+  });
+  const missing = await registry.execute('weather', {});
+  const wrongType = await registry.execute('weather', {location: 123456789});
+  const wrongEnum = await registry.execute('weather', {location: 'Berlin', unit: 'kelvin'});
+  const valid = {location: 'Berlin', unit: 'celsius', extra: 'preserved'};
+  const result = await registry.execute('weather', valid);
+
+  expect(missing.result).toMatch(/location.*required|required.*location/i);
+  expect(wrongType.result).toMatch(/location.*string|string.*location/i);
+  expect(wrongType.result).not.toContain('123456789');
+  expect(wrongEnum.result).toMatch(/unit.*(enum|allowed)|(enum|allowed).*unit/i);
+  expect(result.result).toBe('forecast');
+  expect(received).toEqual([valid]);
+});
+
+// specs/hal-engine-tool-input-validation/spec.md#2
+it('rejects an invalid static schema during registration with the tool name', () => {
+  const registry = new ToolRegistry();
+  expect(() => registry.register({...definition, inputSchema: {type: 'not-a-type'}}, async () => 'forecast')).toThrow(
+    /weather/i
+  );
+});
+
+// specs/hal-engine-tool-input-validation/spec.md#3
+it('validates each call against the current dynamic schema', async () => {
+  const registry = new ToolRegistry();
+  let required = 'location';
+  const received: Record<string, unknown>[] = [];
+  registry.register(
+    () => ({...definition, inputSchema: {...definition.inputSchema, required: [required]}}),
+    async input => {
+      received.push(input);
+      return 'forecast';
+    }
+  );
+  const first = await registry.execute('weather', {unit: 'celsius'});
+  required = 'unit';
+  const second = await registry.execute('weather', {location: 'Berlin'});
+  const valid = {location: 'Berlin', unit: 'celsius'};
+  await registry.execute('weather', valid);
+
+  expect(first.result).toMatch(/location.*required|required.*location/i);
+  expect(second.result).toMatch(/unit.*required|required.*unit/i);
+  expect(received).toEqual([valid]);
+});