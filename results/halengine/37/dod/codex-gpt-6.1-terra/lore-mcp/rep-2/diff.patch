+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const definition: ToolDefinition = {
+  name: 'weather',
+  description: 'Get weather',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}, units: {type: 'string', enum: ['metric', 'imperial'], default: 'metric'}},
+    required: ['location'],
+  },
+};
+
+describe('specs/hal-engine-tool-input-validation/spec.md#1', () => {
+  it('rejects invalid input without exposing values and passes valid input unchanged', async () => {
+    const registry = new ToolRegistry();
+    const calls: Record<string, unknown>[] = [];
+    const logs: unknown[] = [];
+    const record = (category: string, message: string, fields?: Record<string, unknown>): void => {
+      logs.push({category, message, fields});
+    };
+    setLogger({debug: record, info: record, warn: record, error: record});
+    try {
+      registry.register(definition, async input => {
+        calls.push(input);
+        return 'forecast';
+      });
+      const missing = await registry.execute('weather', {});
+      const wrongType = await registry.execute('weather', {location: 12345, identity: 'private-person-123'});
+      const wrongEnum = await registry.execute('weather', {location: 'Berlin', units: 'invalid-units'});
+      const valid = {location: 'Berlin', extra: 'preserved'};
+      const accepted = await registry.execute('weather', valid);
+
+      expect(missing.result).toMatch(/location/i);
+      expect(missing.result).toMatch(/required/i);
+      expect(wrongType.result).toMatch(/location/i);
+      expect(wrongType.result).toMatch(/string/i);
+      expect(wrongEnum.result).toMatch(/units/i);
+      expect(wrongEnum.result).toMatch(/enum|allowed/i);
+      expect(JSON.stringify({missing, wrongType, wrongEnum, logs})).not.toMatch(
+        /12345|private-person-123|invalid-units/
+      );
+      expect(accepted).toEqual({result: 'forecast'});
+      expect(calls).toEqual([valid]);
+      await expect(registry.execute('unknown', {})).rejects.toThrow('Unknown tool: unknown');
+    } finally {
+      setLogger();
+    }
+  });
+});
+
+describe('specs/hal-engine-tool-input-validation/spec.md#2', () => {
+  it('rejects an uncompilable static schema at registration with the tool name', () => {
+    const registry = new ToolRegistry();
+    expect(() => registry.register({...definition, inputSchema: {type: 'not-a-type'}}, async () => 'ok')).toThrow(
+      /weather/i
+    );
+  });
+});
+
+describe('specs/hal-engine-tool-input-validation/spec.md#3', () => {
+  it('validates each dynamic definition against its current schema', async () => {
+    const registry = new ToolRegistry();
+    let required = 'location';
+    const calls: Record<string, unknown>[] = [];
+    registry.register(
+      () => ({...definition, inputSchema: {type: 'object', required: [required]}}),
+      async input => {
+        calls.push(input);
+        return 'ok';
+      }
+    );
+    const first = await registry.execute('weather', {});
+    required = 'city';
+    const second = await registry.execute('weather', {location: 'Berlin'});
+    const accepted = await registry.execute('weather', {city: 'Berlin'});
+    expect(first.result).toMatch(/location/i);
+    expect(second.result).toMatch(/city/i);
+    expect(accepted.result).toBe('ok');
+    expect(calls).toEqual([{city: 'Berlin'}]);
+  });
+});