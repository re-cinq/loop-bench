+import {ToolRegistry} from './registry.js';
+
+describe('tool input validation', () => {
+  it('rejects invalid inputs and passes valid input through unchanged', async () => {
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Forecast',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}, unit: {type: 'string', enum: ['C', 'F'], default: 'C'}},
+          required: ['location'],
+        },
+      },
+      async input => {
+        received.push(input);
+        return 'forecast';
+      }
+    );
+    const missing = await registry.execute('weather', {});
+    const wrongType = await registry.execute('weather', {location: 123456789});
+    const wrongEnum = await registry.execute('weather', {location: 'Berlin', unit: 'secret-unit'});
+    const valid = {location: 'Berlin', extra: 'unchanged'};
+    const success = await registry.execute('weather', valid);
+
+    expect(missing.result).toMatch(/location/i);
+    expect(missing.result).toMatch(/required/i);
+    expect(wrongType.result).toMatch(/location/i);
+    expect(wrongType.result).toMatch(/string/i);
+    expect(wrongType.result).not.toContain('123456789');
+    expect(wrongEnum.result).toMatch(/unit/i);
+    expect(wrongEnum.result).toMatch(/enum|allowed/i);
+    expect(wrongEnum.result).not.toContain('secret-unit');
+    expect(success.result).toBe('forecast');
+    expect(received).toEqual([valid]);
+  });
+
+  it('validates each function-valued definition against its current schema', async () => {
+    const registry = new ToolRegistry();
+    let required = 'location';
+    const received: Record<string, unknown>[] = [];
+    registry.register(
+      () => ({
+        name: 'dynamic',
+        description: 'Dynamic schema',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}, date: {type: 'string'}},
+          required: [required],
+        },
+      }),
+      async input => {
+        received.push(input);
+        return 'executed';
+      }
+    );
+    const first = await registry.execute('dynamic', {location: 'Berlin'});
+    required = 'date';
+    const rejected = await registry.execute('dynamic', {location: 'Berlin'});
+    const second = await registry.execute('dynamic', {date: 'tomorrow'});
+
+    expect(first.result).toBe('executed');
+    expect(rejected.result).toMatch(/date/i);
+    expect(rejected.result).toMatch(/required/i);
+    expect(second.result).toBe('executed');
+    expect(received).toEqual([{location: 'Berlin'}, {date: 'tomorrow'}]);
+  });
+
+  it('rejects an uncompilable static schema at registration with the tool name', () => {
+    const registry = new ToolRegistry();
+    expect(() =>
+      registry.register(
+        {name: 'broken-weather', description: 'Invalid schema', inputSchema: {type: 'not-a-json-schema-type'}},
+        async () => 'executed'
+      )
+    ).toThrow(/broken-weather/i);
+  });
+});