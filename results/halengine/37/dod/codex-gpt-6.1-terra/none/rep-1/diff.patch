+import {ToolRegistry} from './registry.js';
+
+describe('tool input validation', () => {
+  it('rejects invalid input and passes valid input through unchanged', async () => {
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+    registry.register(
+      {
+        name: 'weather',
+        description: 'weather',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}, unit: {type: 'string', enum: ['c', 'f'], default: 'c'}},
+          required: ['location'],
+        },
+      },
+      async input => {
+        received.push(input);
+        return 'forecast';
+      }
+    );
+    const valid = {location: 'Berlin', extra: 42};
+    await registry.execute('weather', valid);
+    const missing = await registry.execute('weather', {});
+    const wrongType = await registry.execute('weather', {location: 123456789});
+    const wrongEnum = await registry.execute('weather', {location: 'Berlin', unit: 'kelvin'});
+    expect({received, missing: missing.result, wrongType: wrongType.result, wrongEnum: wrongEnum.result}).toEqual({
+      received: [valid],
+      missing: expect.stringMatching(/location.*required|required.*location/i),
+      wrongType: expect.stringMatching(/location.*string|string.*location/i),
+      wrongEnum: expect.stringMatching(/unit/i),
+    });
+    expect(wrongType.result).not.toContain('123456789');
+  });
+
+  it('rejects an invalid static schema when the tool is registered', () => {
+    const registry = new ToolRegistry();
+    expect(() =>
+      registry.register({name: 'broken', description: 'broken', inputSchema: {type: 'not-a-type'}}, async () => 'ok')
+    ).toThrow(/broken/i);
+  });
+
+  it('validates each call against the current dynamic schema', async () => {
+    const registry = new ToolRegistry();
+    let field = 'first';
+    const received: Record<string, unknown>[] = [];
+    registry.register(
+      () => ({name: 'dynamic', description: 'dynamic', inputSchema: {type: 'object', required: [field]}}),
+      async input => {
+        received.push(input);
+        return 'ok';
+      }
+    );
+    await registry.execute('dynamic', {first: 'yes'});
+    field = 'second';
+    const rejection = await registry.execute('dynamic', {first: 'yes'});
+    await registry.execute('dynamic', {second: 'yes'});
+    expect({received, rejection: rejection.result}).toEqual({
+      received: [{first: 'yes'}, {second: 'yes'}],
+      rejection: expect.stringMatching(/second.*required|required.*second/i),
+    });
+  });
+});