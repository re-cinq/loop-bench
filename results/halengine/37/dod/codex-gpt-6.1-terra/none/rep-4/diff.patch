@@ -0,0 +1,76 @@
+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+
+const definition = {
+  name: 'weather',
+  description: 'Get weather',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}, units: {type: 'string', enum: ['metric', 'imperial'], default: 'metric'}},
+    required: ['location'],
+  },
+};
+
+test('rejects invalid input without executing or exposing values and passes valid input unchanged', async () => {
+  const registry = new ToolRegistry();
+  const received: Record<string, unknown>[] = [];
+  const logs: string[] = [];
+  const record = (category: string, message: string, fields?: Record<string, unknown>): void => {
+    logs.push(JSON.stringify({category, message, fields}));
+  };
+  setLogger({debug: record, info: record, warn: record, error: record});
+  registry.register(definition, async input => {
+    received.push(input);
+    return 'forecast';
+  });
+  try {
+    const missing = await registry.execute('weather', {});
+    const wrongType = await registry.execute('weather', {location: 314159, identity: 'private-person-827'});
+    const wrongEnum = await registry.execute('weather', {location: 'Berlin', units: 'invalid-units-827'});
+    const valid = {location: 'Berlin', extra: 'kept'};
+    const accepted = await registry.execute('weather', valid);
+    expect({missing: missing.result, wrongType: wrongType.result, wrongEnum: wrongEnum.result}).toEqual({
+      missing: expect.stringMatching(/location/i),
+      wrongType: expect.stringMatching(/location.*string|string.*location/i),
+      wrongEnum: expect.stringMatching(/units/i),
+    });
+    expect(missing.result).toMatch(/required/i);
+    expect(wrongEnum.result).toMatch(/enum|allowed/i);
+    expect(JSON.stringify({missing, wrongType, wrongEnum, logs})).not.toMatch(
+      /314159|private-person-827|invalid-units-827/
+    );
+    expect(accepted).toEqual({result: 'forecast'});
+    expect(received).toEqual([valid]);
+    await expect(registry.execute('absent', {})).rejects.toThrow('Unknown tool: absent');
+  } finally {
+    setLogger();
+  }
+});
+
+test('rejects an invalid static schema when registering its tool', () => {
+  const registry = new ToolRegistry();
+  expect(() => registry.register({...definition, inputSchema: {type: 'not-a-type'}}, async () => 'forecast')).toThrow(
+    /weather/i
+  );
+});
+
+test('validates each call against the current dynamic definition', async () => {
+  const registry = new ToolRegistry();
+  let required = 'location';
+  const received: Record<string, unknown>[] = [];
+  registry.register(
+    () => ({...definition, inputSchema: {type: 'object', required: [required]}}),
+    async input => {
+      received.push(input);
+      return 'forecast';
+    }
+  );
+  const first = await registry.execute('weather', {location: 'Berlin'});
+  required = 'city';
+  const rejected = await registry.execute('weather', {location: 'Berlin'});
+  const second = await registry.execute('weather', {city: 'Paris'});
+  expect(rejected.result).toMatch(/city/i);
+  expect(rejected.result).toMatch(/required/i);
+  expect([first.result, second.result]).toEqual(['forecast', 'forecast']);
+  expect(received).toEqual([{location: 'Berlin'}, {city: 'Paris'}]);
+});