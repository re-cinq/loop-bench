--- /dev/null
+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,80 @@
+import {ToolRegistry} from './registry.js';
+
+const definition = {
+  name: 'weather',
+  description: 'Look up weather',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}, unit: {type: 'string', enum: ['c', 'f'], default: 'c'}},
+    required: ['location'],
+  },
+};
+
+describe('tool input validation', () => {
+  it('rejects missing and invalid fields without invoking the executor or exposing values', async () => {
+    const registry = new ToolRegistry();
+    const calls: Record<string, unknown>[] = [];
+    registry.register(definition, async input => {
+      calls.push(input);
+      return 'executed';
+    });
+    const missing = await registry.execute('weather', {});
+    const wrongType = await registry.execute('weather', {location: 731925});
+    const wrongEnum = await registry.execute('weather', {location: 'private-person', unit: 'secret-unit'});
+    expect(missing.result).toMatch(/location/i);
+    expect(missing.result).toMatch(/required/i);
+    expect(wrongType.result).toMatch(/location/i);
+    expect(wrongType.result).toMatch(/string/i);
+    expect(wrongType.result).not.toContain('731925');
+    expect(wrongEnum.result).toMatch(/unit/i);
+    expect(wrongEnum.result).toMatch(/enum|allowed/i);
+    expect(wrongEnum.result).not.toContain('private-person');
+    expect(wrongEnum.result).not.toContain('secret-unit');
+    expect(calls).toEqual([]);
+  });
+
+  it('passes valid input with extra properties through unchanged exactly once', async () => {
+    const registry = new ToolRegistry();
+    const calls: Record<string, unknown>[] = [];
+    registry.register(definition, async input => {
+      calls.push(input);
+      return 'ok';
+    });
+    const rejected = await registry.execute('weather', {});
+    const input = {location: 'Berlin', extra: 42};
+    const accepted = await registry.execute('weather', input);
+    expect(rejected.result).toMatch(/location/i);
+    expect(accepted.result).toBe('ok');
+    expect(calls).toEqual([input]);
+  });
+
+  it('rejects an uncompilable static schema at registration with the tool name', () => {
+    const registry = new ToolRegistry();
+    expect(() =>
+      registry.register({...definition, inputSchema: {type: 'not-a-json-schema-type'}}, async () => 'ok')
+    ).toThrow(/weather/i);
+  });
+
+  it('validates each dynamic definition against its current schema', async () => {
+    const registry = new ToolRegistry();
+    let field = 'location';
+    const calls: Record<string, unknown>[] = [];
+    registry.register(
+      () => ({
+        ...definition,
+        inputSchema: {type: 'object', properties: {[field]: {type: 'string'}}, required: [field]},
+      }),
+      async input => {
+        calls.push(input);
+        return 'ok';
+      }
+    );
+    await registry.execute('weather', {location: 'Berlin'});
+    field = 'city';
+    const rejected = await registry.execute('weather', {location: 'Berlin'});
+    const accepted = await registry.execute('weather', {city: 'Paris'});
+    expect(rejected.result).toMatch(/city/i);
+    expect(accepted.result).toBe('ok');
+    expect(calls).toEqual([{location: 'Berlin'}, {city: 'Paris'}]);
+  });
+});