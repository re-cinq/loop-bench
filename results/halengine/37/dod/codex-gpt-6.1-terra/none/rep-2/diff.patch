@@ -0,0 +1,93 @@
+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+
+const definition = {
+  name: 'weather',
+  description: 'Get weather',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}, unit: {type: 'string', enum: ['c', 'f'], default: 'c'}},
+    required: ['location'],
+  },
+};
+
+test('rejects invalid input before execution without exposing values and preserves valid input', async () => {
+  const registry = new ToolRegistry();
+  const calls: Record<string, unknown>[] = [];
+  const lines: string[] = [];
+  const record = (category: string, message: string, fields?: Record<string, unknown>): void => {
+    lines.push(JSON.stringify({category, message, fields}));
+  };
+  setLogger({debug: record, info: record, warn: record, error: record});
+  try {
+    registry.register(definition, async input => {
+      calls.push(input);
+      return 'forecast';
+    });
+    const missing = await registry.execute('weather', {});
+    expect(missing.result).toMatch(/location/i);
+    expect(missing.result).toMatch(/required/i);
+    expect(calls).toHaveLength(0);
+
+    const wrong = await registry.execute('weather', {location: 12345, identity: 'private-person'});
+    expect(wrong.result).toMatch(/location/i);
+    expect(wrong.result).toMatch(/string/i);
+    expect(wrong.result).not.toContain('12345');
+    expect(wrong.result).not.toContain('private-person');
+    expect(lines.join('\n')).not.toContain('private-person');
+    expect(lines.join('\n')).not.toContain('12345');
+    const badEnum = await registry.execute('weather', {location: 'Berlin', unit: 'kelvin'});
+    expect(badEnum.result).toMatch(/unit/i);
+    expect(calls).toHaveLength(0);
+
+    const valid = {location: 'Berlin', extra: 'unchanged'};
+    expect(await registry.execute('weather', valid)).toEqual({result: 'forecast'});
+    expect(calls).toEqual([valid]);
+    await expect(registry.execute('missing', {})).rejects.toThrow('Unknown tool: missing');
+  } finally {
+    setLogger();
+  }
+});
+
+test('compiles static schemas at registration and reuses them', async () => {
+  const registry = new ToolRegistry();
+  expect(() => registry.register({...definition, inputSchema: {type: 'not-a-type'}}, async () => 'ok')).toThrow(
+    /weather/i
+  );
+  let reads = 0;
+  const schema = {
+    type: 'object',
+    get properties() {
+      reads++;
+      return {location: {type: 'string'}};
+    },
+  };
+  registry.register({...definition, inputSchema: schema}, async () => 'ok');
+  const readsAfterRegistration = reads;
+  expect(readsAfterRegistration).toBeGreaterThan(0);
+  for (let i = 0; i < 10; i++) await registry.execute('weather', {location: 'Berlin'});
+  expect(reads).toBe(readsAfterRegistration);
+});
+
+test('validates each dynamic definition against its current schema', async () => {
+  const registry = new ToolRegistry();
+  let current = definition.inputSchema;
+  let calls = 0;
+  registry.register(
+    () => ({...definition, inputSchema: current}),
+    async () => {
+      calls++;
+      return 'forecast';
+    }
+  );
+  expect((await registry.execute('weather', {})).result).toMatch(/location/i);
+  current = {
+    type: 'object',
+    properties: {location: {type: 'string'}, unit: {type: 'string', enum: ['c', 'f'], default: 'c'}},
+    required: ['unit'],
+  };
+  expect((await registry.execute('weather', {location: 'Berlin'})).result).toMatch(/unit/i);
+  expect(calls).toBe(0);
+  await registry.execute('weather', {unit: 'c'});
+  expect(calls).toBe(1);
+});