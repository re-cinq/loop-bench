+import {ToolRegistry} from './registry.js';
+
+describe('tool input validation', () => {
+  it('rejects missing required input before invoking the executor', async () => {
+    const registry = new ToolRegistry();
+    const inputs: Record<string, unknown>[] = [];
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Weather',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async input => {
+        inputs.push(input);
+        return 'forecast';
+      }
+    );
+    const response = await registry.execute('weather', {});
+    expect(response.result).toMatch(/location/i);
+    expect(response.result).toMatch(/required/i);
+    expect(inputs).toEqual([]);
+    const valid = {location: 'Berlin', extra: 'kept'};
+    await registry.execute('weather', valid);
+    expect(inputs).toEqual([valid]);
+  });
+
+  it('rejects wrong types and enum values without exposing input values', async () => {
+    const registry = new ToolRegistry();
+    const inputs: Record<string, unknown>[] = [];
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Weather',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}, unit: {enum: ['celsius', 'fahrenheit']}},
+          required: ['location'],
+        },
+      },
+      async input => {
+        inputs.push(input);
+        return 'forecast';
+      }
+    );
+    const wrongType = await registry.execute('weather', {location: 123456789});
+    expect(wrongType.result).toMatch(/location/i);
+    expect(wrongType.result).toMatch(/string/i);
+    expect(wrongType.result).not.toContain('123456789');
+    const wrongEnum = await registry.execute('weather', {location: 'Berlin', unit: 'secret-unit'});
+    expect(wrongEnum.result).toMatch(/unit/i);
+    expect(wrongEnum.result).not.toContain('secret-unit');
+    expect(inputs).toEqual([]);
+  });
+
+  it('rejects an uncompilable static schema at registration with the tool name', () => {
+    const registry = new ToolRegistry();
+    expect(() =>
+      registry.register(
+        {name: 'weather', description: 'Weather', inputSchema: {type: 'not-a-json-schema-type'}},
+        async () => 'forecast'
+      )
+    ).toThrow(/weather/i);
+  });
+
+  it('validates each dynamic definition against its current schema', async () => {
+    const registry = new ToolRegistry();
+    let required = 'location';
+    const inputs: Record<string, unknown>[] = [];
+    registry.register(
+      () => ({
+        name: 'weather',
+        description: 'Weather',
+        inputSchema: {type: 'object', properties: {[required]: {type: 'string'}}, required: [required]},
+      }),
+      async input => {
+        inputs.push(input);
+        return 'forecast';
+      }
+    );
+    await registry.execute('weather', {location: 'Berlin'});
+    required = 'city';
+    const response = await registry.execute('weather', {location: 'Berlin'});
+    expect(response.result).toMatch(/city/i);
+    expect(inputs).toEqual([{location: 'Berlin'}]);
+  });
+});