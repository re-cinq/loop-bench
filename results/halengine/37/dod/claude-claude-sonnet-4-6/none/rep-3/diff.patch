+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, Message, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+}
+
+describe('ChatOrchestrator tool validation integration', () => {
+  it('processMessage resolves and rejection text is visible to provider on the retry round', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'weather',
+        description: 'get weather',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async () => 'sunny'
+    );
+
+    let round = 0;
+    const receivedMessages: Message[][] = [];
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        receivedMessages.push(params.messages);
+        if (round++ === 0) {
+          yield {type: 'tool_use', toolCall: {id: 'tc1', name: 'weather', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+        } else {
+          yield {type: 'text', text: 'retry done'};
+          yield {type: 'stop', stopReason: 'end_turn'};
+        }
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+    const result = await orchestrator.processMessage(createSession('ask'));
+    const secondRound = receivedMessages[1] ?? [];
+    const rejectionVisible = secondRound.some(
+      m =>
+        m.role === 'user' &&
+        Array.isArray(m.content) &&
+        m.content.some(c => c.type === 'tool_result' && c.content.includes('location'))
+    );
+    expect({result, rejectionVisible}).toEqual({result: 'retry done', rejectionVisible: true});
+  });
+});
