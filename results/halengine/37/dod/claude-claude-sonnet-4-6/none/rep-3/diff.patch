@@ -0,0 +1,53 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolContext} from './registry.js';
+
+const ctx: ToolContext = {userId: 'u1', sessionId: 's1'};
+
+describe('ToolRegistry input validation', () => {
+  it('rejects missing required field: returns ToolResponse naming the field, executor not invoked', async () => {
+    const registry = new ToolRegistry();
+    let callCount = 0;
+    registry.register(
+      {
+        name: 'weather',
+        description: 'get weather',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async () => {
+        callCount++;
+        return 'sunny';
+      }
+    );
+    const response = await registry.execute('weather', {}, ctx);
+    expect({result: response.result, callCount}).toEqual({result: expect.stringContaining('location'), callCount: 0});
+  });
+
+  it('rejects wrong type: message names the field path, does not contain the offending value', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'locate',
+        description: 'locate',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async () => 'ok'
+    );
+    const response = await registry.execute('locate', {location: 42}, ctx);
+    expect({containsPath: response.result.includes('location'), containsValue: response.result.includes('42')}).toEqual(
+      {
+        containsPath: true,
+        containsValue: false,
+      }
+    );
+  });
+
+  it('throws at registration time for an uncompilable schema, message names the tool', () => {
+    const registry = new ToolRegistry();
+    expect(() =>
+      registry.register(
+        {name: 'broken-tool', description: 'bad', inputSchema: {type: 'object', required: 'must-be-array'}},
+        async () => 'x'
+      )
+    ).toThrow(expect.objectContaining({message: expect.stringContaining('broken-tool')}));
+  });
+});