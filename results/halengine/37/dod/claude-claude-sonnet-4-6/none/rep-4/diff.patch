@@ -0,0 +1,29 @@
+import {ToolRegistry} from './registry.js';
+
+it('rejects a wrong-typed input without echoing its value and without calling the executor', async () => {
+  let callCount = 0;
+  const registry = new ToolRegistry();
+  registry.register(
+    {
+      name: 'weather',
+      description: 'forecast',
+      inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+    },
+    async () => {
+      callCount++;
+      return 'sunny';
+    }
+  );
+
+  const response = await registry.execute('weather', {location: 99999});
+
+  expect({
+    callCount,
+    mentionsField: response.result.includes('location'),
+    echoesValue: response.result.includes('99999'),
+  }).toEqual({
+    callCount: 0,
+    mentionsField: true,
+    echoesValue: false,
+  });
+});