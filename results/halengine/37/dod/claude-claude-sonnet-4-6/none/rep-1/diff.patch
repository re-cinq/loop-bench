+import {ToolRegistry} from './registry.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../../types/ai.js';
+
+const promptBuilder = new PromptBuilder({identity: 'test'});
+
+describe('ToolRegistry input validation', () => {
+  it('returns a ToolResponse naming the missing required field and does not invoke the executor', async () => {
+    let executorCalls = 0;
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'weather',
+        description: 'get weather',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async () => {
+        executorCalls++;
+        return 'sunny';
+      }
+    );
+
+    const response = await registry.execute('weather', {});
+
+    expect({result: response.result, calls: executorCalls}).toMatchObject({
+      result: expect.stringMatching(/location/i),
+      calls: 0,
+    });
+  });
+
+  it('returns a ToolResponse with the field path in the message but not the offending value when a property has the wrong type', async () => {
+    let executorCalls = 0;
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'greet',
+        description: 'greet a user',
+        inputSchema: {type: 'object', properties: {name: {type: 'string'}}, required: ['name']},
+      },
+      async () => {
+        executorCalls++;
+        return 'hello';
+      }
+    );
+
+    const response = await registry.execute('greet', {name: 12345});
+
+    expect({
+      hasField: response.result.includes('name'),
+      hasValue: response.result.includes('12345'),
+      calls: executorCalls,
+    }).toEqual({hasField: true, hasValue: false, calls: 0});
+  });
+});
+
+describe('ToolRegistry validation end-to-end', () => {
+  it('feeds the validation failure back to the model as a ToolResponse so processMessage resolves through a rejected tool call', async () => {
+    let executorCalls = 0;
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'search',
+        description: 'run a search',
+        inputSchema: {type: 'object', properties: {q: {type: 'string'}}, required: ['q']},
+      },
+      async () => {
+        executorCalls++;
+        return 'found it';
+      }
+    );
+
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        round++;
+        if (round === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'tc1', name: 'search', input: {q: 99}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+        } else {
+          yield {type: 'text', text: 'done'};
+          yield {type: 'stop', stopReason: 'end_turn'};
+        }
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const session = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user' as const, content: 'search', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+
+    const result = await createChatOrchestrator(provider, promptBuilder, registry).processMessage(session);
+
+    expect({executorCalls, result}).toEqual({executorCalls: 0, result: 'done'});
+  });
+});