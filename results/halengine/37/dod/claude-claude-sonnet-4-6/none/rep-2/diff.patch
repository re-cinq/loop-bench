+import {ToolRegistry} from './registry.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../../types/ai.js';
+
+describe('ToolRegistry input schema validation', () => {
+  it('rejects a call missing a required field and never invokes the executor', async () => {
+    let callCount = 0;
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'weather',
+        description: 'get weather',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async () => {
+        callCount++;
+        return 'sunny';
+      }
+    );
+
+    const response = await registry.execute('weather', {});
+
+    expect({callCount, mentionsLocation: response.result.includes('location')}).toEqual({
+      callCount: 0,
+      mentionsLocation: true,
+    });
+  });
+
+  it('a schema-invalid tool call does not throw so the model receives the rejection text and can retry', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'weather',
+        description: 'get weather',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async () => 'sunny'
+    );
+
+    const capturedMessages: SendMessageParams[] = [];
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        capturedMessages.push(params);
+        round++;
+        if (round === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'call-1', name: 'weather', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+        } else {
+          yield {type: 'text', text: 'retry done'};
+          yield {type: 'stop', stopReason: 'end_turn'};
+        }
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const promptBuilder = new PromptBuilder({identity: 'test'});
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+    const session = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user' as const, content: 'what is the weather?', timestamp: ''}],
+    };
+
+    const result = await orchestrator.processMessage(session);
+    const round2Input = JSON.stringify(capturedMessages.at(1)?.messages ?? []);
+
+    expect({result, rejectionFedBack: round2Input.includes('location')}).toEqual({
+      result: 'retry done',
+      rejectionFedBack: true,
+    });
+  });
+});