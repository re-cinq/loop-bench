+import {ToolRegistry} from './registry.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+
+const WEATHER_TOOL = {
+  name: 'get_weather',
+  description: 'Get the current weather for a location',
+  inputSchema: {
+    type: 'object',
+    properties: {
+      location: {type: 'string'},
+    },
+    required: ['location'],
+  },
+};
+
+describe('ToolRegistry input validation', () => {
+  it('returns a ToolResponse naming the missing field and never calls the executor when a required property is absent', async () => {
+    const registry = new ToolRegistry();
+    let executorCallCount = 0;
+    registry.register(WEATHER_TOOL, async () => {
+      executorCallCount++;
+      return 'weather data';
+    });
+
+    const result = await registry.execute('get_weather', {});
+
+    expect(result.result).toMatch(/location/);
+    expect(executorCallCount).toBe(0);
+  });
+
+  it('returns a ToolResponse when a field has the wrong type and the returned text does not contain the rejected value', async () => {
+    const registry = new ToolRegistry();
+    registry.register(WEATHER_TOOL, async () => 'weather data');
+
+    const result = await registry.execute('get_weather', {location: 42});
+
+    expect(result.result).toMatch(/location/);
+    expect(result.result).not.toContain('42');
+  });
+
+  it('throws at registration time for a schema that cannot be compiled and the error names the tool', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {name: 'broken_tool', description: 'broken', inputSchema: {type: 'object', required: 'location'}},
+        async () => 'x'
+      )
+    ).toThrow(/broken_tool/);
+  });
+
+  it('a rejected tool call is returned to the provider rather than thrown, so processMessage resolves', async () => {
+    const registry = new ToolRegistry();
+    registry.register(WEATHER_TOOL, async input => `weather in ${String(input['location'])}`);
+
+    let capturedToolResult = '';
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        const hasToolResult = params.messages.some(
+          m => m.role === 'user' && Array.isArray(m.content) && m.content.some(c => c.type === 'tool_result')
+        );
+        if (!hasToolResult) {
+          yield {type: 'tool_use', toolCall: {id: 'tc1', name: 'get_weather', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+        } else {
+          for (const msg of params.messages) {
+            if (msg.role === 'user' && Array.isArray(msg.content)) {
+              for (const c of msg.content) {
+                if (c.type === 'tool_result') capturedToolResult = c.content;
+              }
+            }
+          }
+          yield {type: 'text', text: 'done'};
+          yield {type: 'stop', stopReason: 'end_turn'};
+        }
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const promptBuilder = new PromptBuilder({identity: 'test'});
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'weather?', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+
+    const result = await orchestrator.processMessage(session);
+
+    expect(result).toBe('done');
+    expect(capturedToolResult).toMatch(/location/);
+  });
+});