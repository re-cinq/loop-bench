+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry.execute input validation', () => {
+  it('returns a ToolResponse naming the missing required field without calling the executor', async () => {
+    let callCount = 0;
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'weather',
+        description: 'gets weather',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async () => {
+        callCount++;
+        return 'sunny';
+      }
+    );
+
+    const response = await registry.execute('weather', {});
+
+    expect({resultMentionsLocation: response.result.includes('location'), callCount}).toEqual({
+      resultMentionsLocation: true,
+      callCount: 0,
+    });
+  });
+
+  it('rejects a wrong-typed field without exposing the submitted value', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'lookup',
+        description: 'looks things up',
+        inputSchema: {type: 'object', properties: {userId: {type: 'string'}}, required: ['userId']},
+      },
+      async () => 'found'
+    );
+
+    const response = await registry.execute('lookup', {userId: 42});
+
+    expect({
+      resultMentionsPath: response.result.includes('userId'),
+      resultExposesValue: response.result.includes('42'),
+    }).toEqual({
+      resultMentionsPath: true,
+      resultExposesValue: false,
+    });
+  });
+});