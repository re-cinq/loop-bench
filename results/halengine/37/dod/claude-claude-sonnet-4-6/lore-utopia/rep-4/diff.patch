+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+
+const neverCalled = async () => 'should not reach';
+
+describe('ToolRegistry input validation', () => {
+  it('returns ToolResponse naming the missing required field, executor not called', async () => {
+    let executorCalled = false;
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'weather',
+        description: 'get weather',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async () => {
+        executorCalled = true;
+        return 'sunny';
+      }
+    );
+
+    const toolResponse = await registry.execute('weather', {});
+
+    expect({executorCalled, namesField: toolResponse.result.includes('location')}).toEqual({
+      executorCalled: false,
+      namesField: true,
+    });
+  });
+
+  it('rejects a wrong-typed field naming its path and type without exposing the offending value in result or logs', async () => {
+    const logged: string[] = [];
+    setLogger({
+      debug: (_c: string, _m: string, f?: Record<string, unknown>) => void logged.push(JSON.stringify(f)),
+      info: (_c: string, _m: string, f?: Record<string, unknown>) => void logged.push(JSON.stringify(f)),
+      warn: (_c: string, _m: string, f?: Record<string, unknown>) => void logged.push(JSON.stringify(f)),
+      error: (_c: string, _m: string, f?: Record<string, unknown>) => void logged.push(JSON.stringify(f)),
+    });
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'lookup',
+        description: 'looks up a record',
+        inputSchema: {type: 'object', properties: {id: {type: 'number'}}, required: ['id']},
+      },
+      neverCalled
+    );
+
+    let toolResponse;
+    try {
+      toolResponse = await registry.execute('lookup', {id: 'alice@example.com'});
+    } finally {
+      setLogger();
+    }
+
+    const logText = logged.join('\n');
+    expect({
+      namesField: toolResponse?.result.includes('id'),
+      namesType: toolResponse?.result.includes('number'),
+      valueInResult: toolResponse?.result.includes('alice@example.com'),
+      valueInLogs: logText.includes('alice@example.com'),
+    }).toEqual({namesField: true, namesType: true, valueInResult: false, valueInLogs: false});
+  });
+
+  it('throws at registration time for an uncompilable schema, naming the tool', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {name: 'broken-tool', description: 'test', inputSchema: {$ref: '#/definitions/DoesNotExist'}},
+        neverCalled
+      )
+    ).toThrow('broken-tool');
+  });
+
+  it('validates against the current schema per execute call for function-valued definitions', async () => {
+    let executorCallCount = 0;
+    let currentSchema: Record<string, unknown> = {type: 'object'};
+    const registry = new ToolRegistry();
+    registry.register(
+      () => ({
+        name: 'dynamic-tool',
+        description: 'schema changes between calls',
+        inputSchema: currentSchema,
+      }),
+      async () => {
+        executorCallCount++;
+        return 'ok';
+      }
+    );
+
+    await registry.execute('dynamic-tool', {});
+    currentSchema = {type: 'object', properties: {must: {type: 'string'}}, required: ['must']};
+    const toolResponse = await registry.execute('dynamic-tool', {});
+
+    expect({executorCallCount, secondRejected: toolResponse.result.includes('must')}).toEqual({
+      executorCallCount: 1,
+      secondRejected: true,
+    });
+  });
+});