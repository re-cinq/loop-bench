+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+const promptBuilder = new PromptBuilder({identity: 'test'});
+
+const createSession = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'ask', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+describe('ChatOrchestrator tool validation integration', () => {
+  it('resolves processMessage when a tool call fails validation and the rejection text reaches the provider on retry', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'lookup',
+        description: 'looks things up',
+        inputSchema: {type: 'object', properties: {query: {type: 'string'}}, required: ['query']},
+      },
+      async () => 'found it'
+    );
+
+    let capturedToolResult = '';
+    let roundNumber = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        roundNumber++;
+        if (roundNumber === 1) {
+          yield {type: 'tool_use' as const, toolCall: {id: 'tc1', name: 'lookup', input: {}}};
+          yield {type: 'stop' as const, stopReason: 'tool_use'};
+          return;
+        }
+        const lastMsg = params.messages[params.messages.length - 1];
+        const contentArray = lastMsg.role === 'user' ? (lastMsg.content as {content?: string}[]) : [];
+        capturedToolResult = contentArray[0]?.content ?? '';
+        yield {type: 'text' as const, text: 'done'};
+        yield {type: 'stop' as const, stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+    const finalText = await orchestrator.processMessage(createSession());
+
+    expect({finalText, rejectionMentionsQuery: capturedToolResult.includes('query')}).toEqual({
+      finalText: 'done',
+      rejectionMentionsQuery: true,
+    });
+  });
+});
