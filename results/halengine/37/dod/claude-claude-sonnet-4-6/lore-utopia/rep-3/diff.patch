+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('ChatOrchestrator tool-loop with input validation', () => {
+  it('resolves and makes the rejection text visible to the provider before the caller retries', async () => {
+    let round = 0;
+    let rejectionSeen = '';
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        round++;
+        if (round === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'tc1', name: 'weather', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        const lastContent = params.messages[params.messages.length - 1].content;
+        const toolResultItem = Array.isArray(lastContent) ? lastContent.find(c => c.type === 'tool_result') : undefined;
+        rejectionSeen = toolResultItem?.type === 'tool_result' ? toolResultItem.content : '';
+        yield {type: 'text', text: 'done'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'weather',
+        description: 'fetches weather forecast for a city',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async () => 'sunny'
+    );
+
+    const orchestrator = createChatOrchestrator(
+      provider,
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      registry
+    );
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'what is the weather?', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const result = await orchestrator.processMessage(session);
+
+    expect({resolved: result, rejectionMentionsField: /location/.test(rejectionSeen)}).toEqual({
+      resolved: 'done',
+      rejectionMentionsField: true,
+    });
+  });
+});
