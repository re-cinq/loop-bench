+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry.execute input validation', () => {
+  it('skips the executor and names the missing required field in its rejection', async () => {
+    let callCount = 0;
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'weather',
+        description: 'get weather for a location',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async () => {
+        callCount++;
+        return 'sunny';
+      }
+    );
+
+    const response = await registry.execute('weather', {});
+
+    expect({calls: callCount, result: response.result}).toEqual({
+      calls: 0,
+      result: expect.stringMatching(/location/),
+    });
+  });
+});