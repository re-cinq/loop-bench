+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,121 @@
+import {ToolRegistry} from './registry.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import type {AIProvider, Message, MessageChunk, SendMessageParams} from '../../types/ai.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../../types/session.js';
+
+function makeWeatherRegistry(): {registry: ToolRegistry; getCallCount: () => number} {
+  const registry = new ToolRegistry();
+  let callCount = 0;
+  registry.register(
+    {
+      name: 'weather',
+      description: 'get weather',
+      inputSchema: {
+        type: 'object',
+        properties: {location: {type: 'string'}},
+        required: ['location'],
+      },
+    },
+    async () => {
+      callCount++;
+      return 'sunny';
+    }
+  );
+  return {registry, getCallCount: () => callCount};
+}
+
+function toolResultStrings(messages: Message[]): string[] {
+  const last = messages[messages.length - 1];
+  if (last === undefined || last.role !== 'user' || !Array.isArray(last.content)) return [];
+  return last.content.map(part => part.content);
+}
+
+describe('ToolRegistry input validation', () => {
+  it('returns a ToolResponse naming the missing required field and never calls the executor', async () => {
+    const {registry, getCallCount} = makeWeatherRegistry();
+    const response = await registry.execute('weather', {});
+    expect({callCount: getCallCount(), mentionsLocation: /location/i.test(response.result)}).toEqual({
+      callCount: 0,
+      mentionsLocation: true,
+    });
+  });
+
+  it('rejects a wrong-typed field, naming the path and expected type, without the offending value', async () => {
+    const {registry, getCallCount} = makeWeatherRegistry();
+    const response = await registry.execute('weather', {location: 42});
+    expect({
+      callCount: getCallCount(),
+      mentionsString: /string/i.test(response.result),
+      containsValue: /42/.test(response.result),
+    }).toEqual({callCount: 0, mentionsString: true, containsValue: false});
+  });
+
+  it('throws at register time for a schema that cannot be compiled, naming the tool', () => {
+    const registry = new ToolRegistry();
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken',
+          description: 'broken tool',
+          inputSchema: {type: 'object', required: 'must-be-an-array-not-a-string'},
+        },
+        async () => 'ok'
+      )
+    ).toThrow(/broken/);
+  });
+});
+
+describe('ChatOrchestrator tool loop with schema rejection', () => {
+  it('resolves processMessage when a tool call is rejected, with the rejection text visible to the provider', async () => {
+    const captured: string[] = [];
+    let callNum = 0;
+
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        callNum++;
+        if (callNum === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'c1', name: 'weather', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        for (const r of toolResultStrings(params.messages)) {
+          captured.push(r);
+        }
+        yield {type: 'text', text: 'done'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'weather',
+        description: 'get weather',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async () => 'sunny'
+    );
+
+    const promptBuilder = new PromptBuilder({identity: 'test'});
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'what is the weather', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+    const result = await orchestrator.processMessage(session);
+
+    expect({result, rejectionMentionsLocation: captured.some(r => /location/i.test(r))}).toEqual({
+      result: 'done',
+      rejectionMentionsLocation: true,
+    });
+  });
+});