+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry.execute input validation', () => {
+  it('returns a ToolResponse naming the missing required field and never calls the executor', async () => {
+    const registry = new ToolRegistry();
+    let callCount = 0;
+    registry.register(
+      {
+        name: 'weather',
+        description: 'get weather',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async () => {
+        callCount++;
+        return 'sunny';
+      }
+    );
+
+    const result = await registry.execute('weather', {});
+
+    expect({callCount, namesMissingField: result.result.includes('location')}).toEqual({
+      callCount: 0,
+      namesMissingField: true,
+    });
+  });
+
+  it('never includes the offending value in the returned ToolResponse', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'lookup',
+        description: 'lookup',
+        inputSchema: {type: 'object', properties: {id: {type: 'integer'}}, required: ['id']},
+      },
+      async () => 'found'
+    );
+    const sensitiveValue = 'alice@example.com';
+
+    const result = await registry.execute('lookup', {id: sensitiveValue});
+
+    expect({
+      isValidationFailure: result.result !== 'found',
+      containsValue: result.result.includes(sensitiveValue),
+    }).toEqual({
+      isValidationFailure: true,
+      containsValue: false,
+    });
+  });
+});