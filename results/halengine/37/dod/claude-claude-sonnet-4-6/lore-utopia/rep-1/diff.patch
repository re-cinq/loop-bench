+import type {AIProvider, MessageChunk, SendMessageParams, ToolResultContent, ToolResultMessage} from '../types/ai.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const PROMPT_BUILDER = new PromptBuilder({identity: 'test'});
+
+describe('ChatOrchestrator tool validation loop', () => {
+  it('resolves processMessage when a corrected call follows a rejected one, with rejection text visible to the provider', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'weather',
+        description: 'get weather',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async input => `weather in ${input.location as string}`
+    );
+
+    let round = 0;
+    let round2ToolResultContent = '';
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        round++;
+        if (round === 2) {
+          const toolResults = params.messages
+            .filter((m): m is ToolResultMessage => m.role === 'user' && Array.isArray(m.content))
+            .flatMap(m => m.content.filter(c => c.type === 'tool_result'));
+          round2ToolResultContent = toolResults[0]?.content ?? '';
+        }
+        if (round === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'c1', name: 'weather', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+        } else {
+          yield {type: 'text', text: 'done'};
+          yield {type: 'stop', stopReason: 'end_turn'};
+        }
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const session = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user' as const, content: 'go', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const orchestrator = createChatOrchestrator(provider, PROMPT_BUILDER, registry);
+
+    const result = await orchestrator.processMessage(session);
+
+    expect({result, rejectionMentionsLocation: round2ToolResultContent.includes('location')}).toEqual({
+      result: 'done',
+      rejectionMentionsLocation: true,
+    });
+  });
+});
