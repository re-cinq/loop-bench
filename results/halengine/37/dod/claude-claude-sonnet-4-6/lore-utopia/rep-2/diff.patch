+// specs/hal-engine-tool-input-validation/spec.md
+import {ToolRegistry} from './registry.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../../types/ai.js';
+
+const promptBuilder = new PromptBuilder({identity: 'test'});
+
+function registryWithLocation(calls: unknown[][]) {
+  const registry = new ToolRegistry();
+  registry.register(
+    {
+      name: 'weather',
+      description: 'get weather',
+      inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+    },
+    async input => {
+      calls.push([...Object.entries(input)]);
+      return 'sunny';
+    }
+  );
+  return registry;
+}
+
+// specs/hal-engine-tool-input-validation/spec.md — missing required field
+it('missing required field returns a ToolResponse naming the field, never calls the executor', async () => {
+  const calls: unknown[][] = [];
+  const registry = registryWithLocation(calls);
+
+  const response = await registry.execute('weather', {});
+
+  expect(response.result).toMatch(/location/);
+  expect(calls).toHaveLength(0);
+});
+
+// specs/hal-engine-tool-input-validation/spec.md — wrong type rejected without echoing value
+it('wrong-typed field is rejected with a message naming the field path without echoing its value', async () => {
+  let executorCalled = false;
+  const registry = new ToolRegistry();
+  registry.register(
+    {
+      name: 'convert',
+      description: 'convert units',
+      inputSchema: {type: 'object', properties: {amount: {type: 'number'}}, required: ['amount']},
+    },
+    async () => {
+      executorCalled = true;
+      return 'converted';
+    }
+  );
+
+  const response = await registry.execute('convert', {amount: 'very-secret-string-9847263'});
+
+  expect(response.result).toMatch(/amount/);
+  expect(response.result).not.toMatch(/very-secret-string-9847263/);
+  expect(executorCalled).toBe(false);
+});
+
+// specs/hal-engine-tool-input-validation/spec.md — bad schema throws at register, names tool
+it('register throws at registration time for an uncompilable schema, naming the tool', () => {
+  const registry = new ToolRegistry();
+
+  expect(() =>
+    registry.register(
+      {
+        name: 'broken_tool',
+        description: 'a tool with a broken schema',
+        inputSchema: {$ref: '#/$defs/DoesNotExist'},
+      },
+      async () => 'ok'
+    )
+  ).toThrow(/broken_tool/);
+});
+
+// specs/hal-engine-tool-input-validation/spec.md — orchestrator resolves, rejection text visible to provider
+it('a schema-rejected tool call is returned to the provider for correction without ending the conversation', async () => {
+  const REJECTED_CALL: MessageChunk = {
+    type: 'tool_use',
+    toolCall: {id: 'c1', name: 'weather', input: {}},
+  };
+  const CORRECTED_CALL: MessageChunk = {
+    type: 'tool_use',
+    toolCall: {id: 'c2', name: 'weather', input: {location: 'Berlin'}},
+  };
+  const STOP_TOOL: MessageChunk = {type: 'stop', stopReason: 'tool_use'};
+  const STOP_DONE: MessageChunk = {type: 'stop', stopReason: 'end_turn'};
+
+  let round = 0;
+  const rounds: MessageChunk[][] = [
+    [REJECTED_CALL, STOP_TOOL],
+    [CORRECTED_CALL, STOP_TOOL],
+    [{type: 'text', text: 'done'}, STOP_DONE],
+  ];
+
+  const sentParams: SendMessageParams[] = [];
+  const provider: AIProvider = {
+    async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      sentParams.push(params);
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+
+  const executorCalls: unknown[][] = [];
+  const registry = registryWithLocation(executorCalls);
+
+  const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+  const result = await orchestrator.processMessage({
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'what is the weather?', timestamp: '2026-01-01T00:00:00.000Z'}],
+  });
+
+  // processMessage must resolve, not reject
+  expect(typeof result).toBe('string');
+
+  // The rejection text must have been visible to the provider as a tool result
+  const allToolResults = sentParams.flatMap(p =>
+    p.messages.flatMap(m => {
+      if (!Array.isArray(m.content)) return [];
+      return m.content.filter(
+        (c): c is {type: 'tool_result'; toolUseId: string; content: string} =>
+          typeof c === 'object' && c !== null && (c as {type: string}).type === 'tool_result'
+      );
+    })
+  );
+  const rejectionResult = allToolResults.find(r => /location/i.test(r.content ?? ''));
+  expect(rejectionResult).toBeDefined();
+
+  // The corrected call (with location) reached the executor
+  expect(executorCalls).toHaveLength(1);
+});