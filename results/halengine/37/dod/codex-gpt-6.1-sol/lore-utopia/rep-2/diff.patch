+# Tool Input Validation
+
+| Field  | Value                |
+| ------ | -------------------- |
+| Issue  | re-cinq/HALEngine#37 |
+| Status | Draft                |
+
+The registry owns validation of model-supplied tool input against the same JSON Schema advertised to providers.
+
+## Execution contract
+
+- Before invoking an executor, `execute` rejects missing required fields, wrong declared types and invalid enum members with a descriptive `ToolResponse.result`, naming property paths and constraints without exposing input values in returned text or logs; valid input, including unknown keys, reaches the executor exactly once without coercion or defaults, and an unknown tool name still throws `Unknown tool: <name>`. ([validated by: rejects malformed input privately and preserves valid input and unknown-tool behavior](../../src/orchestration/tools/registry.acceptance.test.ts#L12)).
+- Static schemas compile at registration, with invalid schemas throwing an error naming the tool, and a successfully compiled schema is reused across ten executions. ([validated by: compiles static schemas at registration and reuses them across ten executions](../../src/orchestration/tools/registry.acceptance.test.ts#L70)).
+- Function-valued definitions are resolved for each execution, so changing the returned schema changes which inputs are accepted, while reusing a resolved schema object reuses its compiled validator. ([validated by: validates each dynamic definition and caches by resolved schema identity](../../src/orchestration/tools/registry.acceptance.test.ts#L105)).
+
+## Integration and delivery
+
+Rejections are tool results available to the model on its next round; the existing five-round default bounds correction attempts. The implementation must retain the existing tool-loop contract and document it in README.md, docs/adding-a-tool.md and .specify/spec.md. The validator ships as a runtime dependency. The executor's one-line doc comment points here. Release work includes a consumer-facing changelog, a MINOR version bump and a migration note explaining that executors no longer receive schema-invalid inputs for custom error handling.
diff --git a/src/orchestration/tools/registry.acceptance.test.ts b/src/orchestration/tools/registry.acceptance.test.ts
new file mode 100644
index 0000000..5f26c11
--- /dev/null
+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,143 @@
+import {spawnSync} from 'node:child_process';
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const definition = (inputSchema: Record<string, unknown>): ToolDefinition => ({
+  name: 'weather',
+  description: 'Weather for a location',
+  inputSchema,
+});
+
+// specs/hal-engine-tool-input-validation/spec.md#1
+it('rejects malformed input privately and preserves valid input and unknown-tool behavior', () => {
+  const child = spawnSync(
+    process.execPath,
+    [
+      '--import',
+      'tsx',
+      '--input-type=module',
+      '--eval',
+      `
+      import {ToolRegistry} from './src/orchestration/tools/registry.ts';
+      const registry = new ToolRegistry();
+      const received = [];
+      registry.register({name: 'weather', description: 'Weather', inputSchema: {
+        type: 'object', required: ['location'], properties: {
+          location: {type: 'string'}, units: {type: 'string', enum: ['metric', 'imperial']},
+          optional: {type: 'string', default: 'do not insert'}
+        }
+      }}, async input => { received.push(structuredClone(input)); return 'forecast'; });
+      const missing = await registry.execute('weather', {});
+      const wrongType = await registry.execute('weather', {location: 934712865});
+      const wrongEnum = await registry.execute('weather', {location: 'Berlin', units: 'private-person-934712865'});
+      const validInput = {location: 'Berlin', units: 'metric', extra: {keep: true}};
+      const valid = await registry.execute('weather', validInput);
+      let unknown;
+      try { await registry.execute('absent', {}); } catch (error) { unknown = error.message; }
+      console.log('OBSERVATION:' + JSON.stringify({missing, wrongType, wrongEnum, valid, validInput, received, unknown}));
+    `,
+    ],
+    {cwd: process.cwd(), encoding: 'utf8'}
+  );
+  expect(child.status).toBe(0);
+  const observationLine = child.stdout.split('\n').find(line => line.startsWith('OBSERVATION:'));
+  expect(observationLine).toBeDefined();
+  const observed = JSON.parse(observationLine!.slice('OBSERVATION:'.length));
+  expect(observed).toEqual({
+    missing: {result: expect.stringMatching(/(?=[\s\S]*location)(?=[\s\S]*required)/i)},
+    wrongType: {result: expect.stringMatching(/(?=[\s\S]*location)(?=[\s\S]*string)/i)},
+    wrongEnum: {result: expect.stringMatching(/(?=[\s\S]*units)(?=[\s\S]*(?:enum|allowed))/i)},
+    valid: {result: 'forecast'},
+    validInput: {location: 'Berlin', units: 'metric', extra: {keep: true}},
+    received: [{location: 'Berlin', units: 'metric', extra: {keep: true}}],
+    unknown: 'Unknown tool: absent',
+  });
+  const publicOutput =
+    child.stdout
+      .split('\n')
+      .filter(line => !line.startsWith('OBSERVATION:'))
+      .join('\n') + child.stderr;
+  expect(publicOutput + JSON.stringify([observed.missing, observed.wrongType, observed.wrongEnum])).not.toContain(
+    '934712865'
+  );
+  expect(publicOutput).toMatch(/location/);
+  expect(publicOutput).toMatch(/required/);
+  expect(publicOutput).toMatch(/units/);
+  expect(publicOutput).toMatch(/enum|allowed/i);
+});
+
+// specs/hal-engine-tool-input-validation/spec.md#2
+it('compiles static schemas at registration and reuses them across ten executions', async () => {
+  const registry = new ToolRegistry();
+  let registrationError: unknown;
+  try {
+    registry.register(definition({type: 'not-a-json-schema-type'}), async () => 'unused');
+  } catch (error) {
+    registrationError = error;
+  }
+  let schemaReads = 0;
+  const schema = {
+    type: 'object',
+    get properties() {
+      schemaReads++;
+      return {location: {type: 'string'}};
+    },
+    required: ['location'],
+  };
+  registry.register(definition(schema), async () => 'forecast');
+  const readsAtRegistration = schemaReads;
+  const results = [];
+  for (let call = 0; call < 10; call++) results.push(await registry.execute('weather', {location: 'Berlin'}));
+  expect({
+    error: registrationError instanceof Error ? registrationError.message : registrationError,
+    compiledAtRegistration: readsAtRegistration > 0,
+    reused: schemaReads === readsAtRegistration,
+    results,
+  }).toEqual({
+    error: expect.stringContaining('weather'),
+    compiledAtRegistration: true,
+    reused: true,
+    results: Array.from({length: 10}, () => ({result: 'forecast'})),
+  });
+});
+
+// specs/hal-engine-tool-input-validation/spec.md#3
+it('validates each dynamic definition and caches by resolved schema identity', async () => {
+  const registry = new ToolRegistry();
+  let schemaReads = 0;
+  const stringSchema = {type: 'object', required: ['location'], properties: {location: {type: 'string'}}};
+  const numberSchema = {
+    type: 'object',
+    required: ['location'],
+    get properties() {
+      schemaReads++;
+      return {location: {type: 'number'}};
+    },
+  };
+  let current: Record<string, unknown> = stringSchema;
+  const received: Record<string, unknown>[] = [];
+  registry.register(
+    () => definition(current),
+    async input => {
+      received.push(structuredClone(input));
+      return 'forecast';
+    }
+  );
+  const first = await registry.execute('weather', {location: 'Berlin'});
+  current = numberSchema;
+  const rejected = await registry.execute('weather', {location: 'Berlin'});
+  const readsAfterResolution = schemaReads;
+  const corrected = await registry.execute('weather', {location: 52});
+  const reused = schemaReads === readsAfterResolution;
+  current = stringSchema;
+  const restored = await registry.execute('weather', {location: 'Paris'});
+  expect({first, rejected, corrected, restored, received, compiled: readsAfterResolution > 0, reused}).toEqual({
+    first: {result: 'forecast'},
+    rejected: {result: expect.stringMatching(/(?=[\s\S]*location)(?=[\s\S]*number)/i)},
+    corrected: {result: 'forecast'},
+    restored: {result: 'forecast'},
+    received: [{location: 'Berlin'}, {location: 52}, {location: 'Paris'}],
+    compiled: true,
+    reused: true,
+  });
+});