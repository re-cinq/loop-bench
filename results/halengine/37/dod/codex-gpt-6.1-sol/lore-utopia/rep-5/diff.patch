index 0000000..e987a61
--- /dev/null
+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,122 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+import {setLogger} from '../../shared/logger.js';
+
+const definition = (inputSchema: Record<string, unknown>): ToolDefinition => ({
+  name: 'weather',
+  description: 'Weather by location',
+  inputSchema,
+});
+
+const schema = (): Record<string, unknown> => ({
+  type: 'object',
+  properties: {
+    location: {type: 'string'},
+    units: {type: 'string', enum: ['C', 'F'], default: 'C'},
+  },
+  required: ['location'],
+});
+
+describe('Tool input validation', () => {
+  // spec: specs/hal-engine-tool-input-validation/spec.md#1
+  it('enforces the static schema before execution without changing input or exposing values', async () => {
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+    const logs: string[] = [];
+    const record = (category: string, message: string, fields?: Record<string, unknown>): void => {
+      logs.push(JSON.stringify({category, message, fields}));
+    };
+    setLogger({debug: record, info: record, warn: record, error: record});
+    let schemaReads = 0;
+    const inputSchema = schema();
+    Object.defineProperty(inputSchema, 'type', {
+      enumerable: true,
+      get: () => {
+        schemaReads += 1;
+        return 'object';
+      },
+    });
+    try {
+      registry.register(definition(inputSchema), async input => {
+        received.push(input);
+        return 'executor accepted';
+      });
+      const readsAtRegistration = schemaReads;
+      const missing = await registry.execute('weather', {});
+      const wrongType = await registry.execute('weather', {location: 8675309});
+      const wrongEnum = await registry.execute('weather', {location: 'private-location-37', units: 'private-unit-37'});
+      const rejectedCalls = received.length;
+      const valid = {location: 'Berlin', extra: {preserve: true}};
+      const responses = [];
+      for (let call = 0; call < 10; call += 1) responses.push(await registry.execute('weather', valid));
+      const unknown = await registry.execute('absent', {}).catch((error: Error) => error.message);
+
+      expect({
+        missing: /location/i.test(missing.result) && /required/i.test(missing.result),
+        wrongType: /location/i.test(wrongType.result) && /string/i.test(wrongType.result),
+        wrongEnum: /units/i.test(wrongEnum.result) && /enum|allowed/i.test(wrongEnum.result),
+        rejectedCalls,
+        received,
+        valid,
+        responses,
+        compiledAtRegistration: readsAtRegistration > 0,
+        reused: schemaReads === readsAtRegistration,
+        leaked: /8675309|private-location-37|private-unit-37/.test(
+          JSON.stringify({missing, wrongType, wrongEnum, logs})
+        ),
+        unknown,
+      }).toEqual({
+        missing: true,
+        wrongType: true,
+        wrongEnum: true,
+        rejectedCalls: 0,
+        received: Array.from({length: 10}, () => ({location: 'Berlin', extra: {preserve: true}})),
+        valid: {location: 'Berlin', extra: {preserve: true}},
+        responses: Array.from({length: 10}, () => ({result: 'executor accepted'})),
+        compiledAtRegistration: true,
+        reused: true,
+        leaked: false,
+        unknown: 'Unknown tool: absent',
+      });
+    } finally {
+      setLogger();
+    }
+  });
+
+  // spec: specs/hal-engine-tool-input-validation/spec.md#2
+  it('validates each dynamic definition against its current schema', async () => {
+    const registry = new ToolRegistry();
+    const schemas = [schema(), {...schema(), properties: {location: {type: 'number'}}}];
+    let current = 0;
+    const received: Record<string, unknown>[] = [];
+    registry.register(
+      () => definition(schemas[current]),
+      async input => {
+        received.push(input);
+        return 'executor accepted';
+      }
+    );
+    const first = await registry.execute('weather', {location: 'Berlin'});
+    current = 1;
+    const rejected = await registry.execute('weather', {location: 'Berlin'});
+    const second = await registry.execute('weather', {location: 42});
+    current = 0;
+    const rejectedAgain = await registry.execute('weather', {location: 42});
+
+    expect({first, second, received, numberError: rejected.result, stringError: rejectedAgain.result}).toEqual({
+      first: {result: 'executor accepted'},
+      second: {result: 'executor accepted'},
+      received: [{location: 'Berlin'}, {location: 42}],
+      numberError: expect.stringMatching(/location.*number|number.*location/i),
+      stringError: expect.stringMatching(/location.*string|string.*location/i),
+    });
+  });
+
+  // spec: specs/hal-engine-tool-input-validation/spec.md#3
+  it('rejects an uncompilable static schema at registration and names the tool', () => {
+    const registry = new ToolRegistry();
+    expect(() => registry.register(definition({type: 'not-a-json-schema-type'}), async () => 'unused')).toThrow(
+      /weather/
+    );
+  });
+});