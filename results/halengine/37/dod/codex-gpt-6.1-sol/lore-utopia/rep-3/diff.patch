+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,134 @@
+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const weather = (inputSchema: Record<string, unknown>): ToolDefinition => ({
+  name: 'weather',
+  description: 'Weather for a location',
+  inputSchema,
+});
+const locationSchema = {
+  type: 'object',
+  properties: {location: {type: 'string'}, units: {type: 'string', enum: ['C', 'F'], default: 'C'}},
+  required: ['location'],
+};
+
+afterEach(() => setLogger());
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#1
+it('rejects missing required input and passes accepted input unchanged', async () => {
+  const registry = new ToolRegistry();
+  const received: Record<string, unknown>[] = [];
+  registry.register(weather(locationSchema), async input => {
+    received.push(structuredClone(input));
+    return 'forecast';
+  });
+
+  const rejection = await registry.execute('weather', {});
+  expect({result: rejection.result, calls: received.length}).toEqual({
+    result: expect.stringMatching(/(?:location.*required|required.*location)/i),
+    calls: 0,
+  });
+
+  const input = {location: 'Berlin', extra: {keep: 'unchanged'}};
+  expect(await registry.execute('weather', input)).toEqual({result: 'forecast'});
+  expect(received).toEqual([input]);
+  expect(input).toEqual({location: 'Berlin', extra: {keep: 'unchanged'}});
+  await expect(registry.execute('missing', {})).rejects.toThrow('Unknown tool: missing');
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#2
+it('rejects type and enum violations without disclosing input values', async () => {
+  const registry = new ToolRegistry();
+  const lines: string[] = [];
+  const record = (category: string, message: string, fields?: Record<string, unknown>): void => {
+    lines.push(JSON.stringify({category, message, fields}));
+  };
+  setLogger({debug: record, info: record, warn: record, error: record});
+  let calls = 0;
+  registry.register(weather(locationSchema), async () => {
+    calls++;
+    return 'forecast';
+  });
+
+  const wrongType = await registry.execute('weather', {location: 987654321, identity: 'person@example.invalid'});
+  const wrongEnum = await registry.execute('weather', {location: 'private-address', units: 'SECRET-UNIT'});
+  expect({wrongType: wrongType.result, wrongEnum: wrongEnum.result, calls}).toEqual({
+    wrongType: expect.stringMatching(/(?:location.*string|string.*location)/i),
+    wrongEnum: expect.stringMatching(/(?:units.*enum|enum.*units)/i),
+    calls: 0,
+  });
+  const diagnostics = JSON.stringify({wrongType, wrongEnum, lines});
+  for (const value of ['987654321', 'person@example.invalid', 'private-address', 'SECRET-UNIT']) {
+    expect(diagnostics).not.toContain(value);
+  }
+  expect(lines.join('\n')).toMatch(/location/i);
+  expect(lines.join('\n')).toMatch(/(?:type|string)/i);
+  expect(lines.join('\n')).toMatch(/units/i);
+  expect(lines.join('\n')).toMatch(/enum/i);
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#3
+it('compiles static schemas at registration and reuses them for ten calls', async () => {
+  const registry = new ToolRegistry();
+  const received: Record<string, unknown>[] = [];
+  const execute = async (input: Record<string, unknown>): Promise<string> => {
+    received.push(input);
+    return 'forecast';
+  };
+  expect(() => registry.register(weather({type: 'not-a-json-schema-type'}), execute)).toThrow(/weather/);
+
+  let schemaReads = 0;
+  const schema = {
+    type: 'object',
+    get properties() {
+      schemaReads++;
+      return {location: {type: 'string'}};
+    },
+    required: ['location'],
+  };
+  registry.register(weather(schema), execute);
+  expect(schemaReads).toBeGreaterThan(0);
+  const readsAtRegistration = schemaReads;
+  for (let call = 0; call < 10; call++) {
+    expect(await registry.execute('weather', {location: 'Berlin'})).toEqual({result: 'forecast'});
+  }
+  expect({schemaReads, calls: received.length}).toEqual({schemaReads: readsAtRegistration, calls: 10});
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#4
+it('uses the current dynamic schema and caches each resolved schema object', async () => {
+  const registry = new ToolRegistry();
+  const received: Record<string, unknown>[] = [];
+  let schemaReads = 0;
+  const numberSchema = {
+    type: 'object',
+    get properties() {
+      schemaReads++;
+      return {location: {type: 'number'}};
+    },
+    required: ['location'],
+  };
+  let current: Record<string, unknown> = locationSchema;
+  registry.register(
+    () => weather(current),
+    async input => {
+      received.push(structuredClone(input));
+      return 'forecast';
+    }
+  );
+  await registry.execute('weather', {location: 'Berlin'});
+  current = numberSchema;
+  const rejected = await registry.execute('weather', {location: 'Berlin'});
+  expect({result: rejected.result, received}).toEqual({
+    result: expect.stringMatching(/(?:location.*number|number.*location)/i),
+    received: [{location: 'Berlin'}],
+  });
+  const readsAfterCompilation = schemaReads;
+  expect(readsAfterCompilation).toBeGreaterThan(0);
+  expect(await registry.execute('weather', {location: 42})).toEqual({result: 'forecast'});
+  expect(schemaReads).toBe(readsAfterCompilation);
+  current = locationSchema;
+  expect((await registry.execute('weather', {location: 42})).result).toMatch(/string/i);
+  expect(received).toEqual([{location: 'Berlin'}, {location: 42}]);
+});