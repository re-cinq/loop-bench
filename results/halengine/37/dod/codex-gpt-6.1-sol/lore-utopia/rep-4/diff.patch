index 0000000..9f0f670
--- /dev/null
+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,158 @@
+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const definition = (inputSchema: Record<string, unknown>): ToolDefinition => ({
+  name: 'weather',
+  description: 'Forecast for a location',
+  inputSchema,
+});
+
+const weatherSchema = () => ({
+  type: 'object',
+  properties: {
+    location: {type: 'string'},
+    units: {type: 'string', enum: ['metric', 'imperial'], default: 'metric'},
+  },
+  required: ['location'],
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#1
+it('rejects malformed calls safely and passes valid calls through unchanged', async () => {
+  const registry = new ToolRegistry();
+  const received: Record<string, unknown>[] = [];
+  const lines: string[] = [];
+  const write = (category: string, message: string, fields?: Record<string, unknown>) => {
+    lines.push(JSON.stringify({category, message, fields}));
+  };
+  setLogger({debug: write, info: write, warn: write, error: write});
+  try {
+    registry.register(definition(weatherSchema()), async input => {
+      received.push(structuredClone(input));
+      return 'forecast';
+    });
+    const cases = [
+      {input: {identity: 'person-381@example.test'}, constraint: /location.*required|required.*location/i},
+      {input: {location: 8675309123}, constraint: /location.*string|string.*location/i},
+      {input: {location: 'private-address-381', units: 'private-units-381'}, constraint: /units.*enum|enum.*units/i},
+    ];
+    const rejected = [];
+    for (const {input, constraint} of cases) {
+      const start = lines.length;
+      const response = await registry.execute('weather', input);
+      const logText = lines.slice(start).join('\n');
+      rejected.push({
+        describesFailure: constraint.test(response.result),
+        logsConstraint: constraint.test(logText),
+        leaksValue: ['person-381@example.test', '8675309123', 'private-address-381', 'private-units-381'].some(
+          value => response.result.includes(value) || logText.includes(value)
+        ),
+      });
+    }
+    const invalidCalls = received.length;
+    const input = {location: 'Berlin', extra: {preserve: true}};
+    const response = await registry.execute('weather', input);
+    const unknown = await registry.execute('absent', {}).then(
+      () => 'did not throw',
+      (error: Error) => error.message
+    );
+    expect({rejected, invalidCalls, received: received.slice(invalidCalls), input, response, unknown}).toEqual({
+      rejected: cases.map(() => ({describesFailure: true, logsConstraint: true, leaksValue: false})),
+      invalidCalls: 0,
+      received: [{location: 'Berlin', extra: {preserve: true}}],
+      input: {location: 'Berlin', extra: {preserve: true}},
+      response: {result: 'forecast'},
+      unknown: 'Unknown tool: absent',
+    });
+  } finally {
+    setLogger();
+  }
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#2
+it('compiles static schemas at registration and reuses them', async () => {
+  const registry = new ToolRegistry();
+  let reads = 0;
+  const schema = {
+    ...weatherSchema(),
+    get properties() {
+      reads++;
+      return weatherSchema().properties;
+    },
+  };
+  const calls: Record<string, unknown>[] = [];
+  registry.register(definition(schema), async input => {
+    calls.push(structuredClone(input));
+    return 'forecast';
+  });
+  const registrationReads = reads;
+  for (let call = 0; call < 10; call++) await registry.execute('weather', {location: 'Berlin'});
+  let registrationError = '';
+  try {
+    registry.register({...definition({type: 'not-a-json-schema-type'}), name: 'broken-weather'}, async () => 'unused');
+  } catch (error) {
+    registrationError = error instanceof Error ? error.message : String(error);
+  }
+  expect({
+    compiledAtRegistration: registrationReads > 0,
+    executionReads: reads - registrationReads,
+    calls,
+    registrationError,
+  }).toEqual({
+    compiledAtRegistration: true,
+    executionReads: 0,
+    calls: Array.from({length: 10}, () => ({location: 'Berlin'})),
+    registrationError: expect.stringContaining('broken-weather'),
+  });
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#3
+it('validates dynamic definitions against the current schema and caches each schema object', async () => {
+  const registry = new ToolRegistry();
+  const reads = [0, 0];
+  const schemas = ['string', 'number'].map((type, index) => ({
+    type: 'object',
+    required: ['location'],
+    get properties() {
+      reads[index]++;
+      return {location: {type}};
+    },
+  }));
+  let current = 0;
+  let resolutions = 0;
+  const calls: Record<string, unknown>[] = [];
+  registry.register(
+    () => {
+      resolutions++;
+      return definition(schemas[current]);
+    },
+    async input => {
+      calls.push(structuredClone(input));
+      return 'forecast';
+    }
+  );
+  const before = resolutions;
+  await registry.execute('weather', {location: 'Berlin'});
+  current = 1;
+  const numberRejection = await registry.execute('weather', {location: 'private-location-381'});
+  await registry.execute('weather', {location: 42});
+  const compiledReads = [...reads];
+  current = 0;
+  const stringRejection = await registry.execute('weather', {location: 381992});
+  await registry.execute('weather', {location: 'Paris'});
+  expect({
+    calls,
+    numberRejection: /location.*number|number.*location/i.test(numberRejection.result),
+    stringRejection: /location.*string|string.*location/i.test(stringRejection.result),
+    resolutions: resolutions - before,
+    compiledBoth: compiledReads.every(count => count > 0),
+    cachedReads: reads,
+  }).toEqual({
+    calls: [{location: 'Berlin'}, {location: 42}, {location: 'Paris'}],
+    numberRejection: true,
+    stringRejection: true,
+    resolutions: 5,
+    compiledBoth: true,
+    cachedReads: compiledReads,
+  });
+});