+import {afterEach} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const weather = (inputSchema: Record<string, unknown>): ToolDefinition => ({
+  name: 'weather',
+  description: 'Look up a forecast',
+  inputSchema,
+});
+
+const schema = (): Record<string, unknown> => ({
+  type: 'object',
+  required: ['location'],
+  properties: {
+    location: {type: 'string'},
+    unit: {type: 'string', enum: ['C', 'F'], default: 'C'},
+  },
+});
+
+afterEach(() => setLogger());
+
+describe('Tool input validation', () => {
+  // specs/hal-engine-tool-input-validation/spec.md#1
+  it('rejects malformed calls privately and passes accepted input unchanged', async () => {
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+    const lines: string[] = [];
+    const write = (category: string, message: string, fields?: Record<string, unknown>): void => {
+      lines.push(JSON.stringify({category, message, fields}));
+    };
+    setLogger({debug: write, info: write, warn: write, error: write});
+    registry.register(weather(schema()), async input => {
+      received.push(structuredClone(input));
+      return 'forecast';
+    });
+
+    const invalid = [
+      {input: {}, field: 'location', constraint: /required/i},
+      {input: {location: 867530912345}, field: 'location', constraint: /string/i},
+      {
+        input: {location: 'private-person@example.test', unit: 'private-unit'},
+        field: 'unit',
+        constraint: /enum|allowed/i,
+      },
+    ];
+    for (const {input, field, constraint} of invalid) {
+      const start = lines.length;
+      const response = await registry.execute('weather', input);
+      expect(response.result).toContain(field);
+      expect(response.result).toMatch(constraint);
+      expect(received).toEqual([]);
+      const rejectionLog = lines.slice(start).join('\n');
+      expect(rejectionLog).toContain(field);
+      expect(rejectionLog).toMatch(constraint);
+      for (const value of Object.values(input)) {
+        expect(response.result).not.toContain(String(value));
+        expect(rejectionLog).not.toContain(String(value));
+      }
+    }
+
+    const input = {location: 'Berlin', extra: {keep: true}};
+    await expect(registry.execute('weather', input)).resolves.toEqual({result: 'forecast'});
+    expect(received).toEqual([{location: 'Berlin', extra: {keep: true}}]);
+    expect(input).toEqual({location: 'Berlin', extra: {keep: true}});
+    await expect(registry.execute('missing', {})).rejects.toThrow('Unknown tool: missing');
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#2
+  it('compiles static schemas at registration and reuses them for ten calls', async () => {
+    const registry = new ToolRegistry();
+    expect(() => registry.register(weather({type: 'not-a-json-schema-type'}), async () => 'unused')).toThrow(/weather/);
+
+    let reads = 0;
+    const inputSchema = schema();
+    const definition: ToolDefinition = {
+      name: 'weather',
+      description: 'Look up a forecast',
+      get inputSchema() {
+        reads++;
+        return inputSchema;
+      },
+    };
+    const received: Record<string, unknown>[] = [];
+    registry.register(definition, async input => {
+      received.push(structuredClone(input));
+      return 'forecast';
+    });
+    const registrationReads = reads;
+    expect(registrationReads).toBeGreaterThan(0);
+    for (let call = 0; call < 10; call++) {
+      await expect(registry.execute('weather', {location: 'Berlin'})).resolves.toEqual({result: 'forecast'});
+    }
+    expect(reads).toBe(registrationReads);
+    expect(received).toEqual(Array.from({length: 10}, () => ({location: 'Berlin'})));
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#3
+  it('validates each dynamic definition against its current schema', async () => {
+    const registry = new ToolRegistry();
+    const first = schema();
+    const second = {type: 'object', required: ['location'], properties: {location: {type: 'number'}}};
+    let current = first;
+    const received: Record<string, unknown>[] = [];
+    registry.register(
+      () => weather(current),
+      async input => {
+        received.push(structuredClone(input));
+        return 'forecast';
+      }
+    );
+    await expect(registry.execute('weather', {location: 'Berlin'})).resolves.toEqual({result: 'forecast'});
+    current = second;
+    const rejected = await registry.execute('weather', {location: 'Berlin'});
+    expect(rejected.result).toMatch(/location/);
+    expect(rejected.result).toMatch(/number/);
+    expect(received).toEqual([{location: 'Berlin'}]);
+    await expect(registry.execute('weather', {location: 52})).resolves.toEqual({result: 'forecast'});
+    current = first;
+    const rejectedAgain = await registry.execute('weather', {location: 52});
+    expect(rejectedAgain.result).toMatch(/location/);
+    expect(rejectedAgain.result).toMatch(/string/);
+    expect(received).toEqual([{location: 'Berlin'}, {location: 52}]);
+  });
+});