+# Tool Input Validation
+
+| Field  | Value                |
+| ------ | -------------------- |
+| Issue  | re-cinq/HALEngine#37 |
+| Status | Draft                |
+
+The registry owns validation against the same JSON Schema definition exposed to providers, so executors receive schema-valid input and malformed calls remain recoverable tool results.
+
+## Contract
+
+1. `ToolRegistry.execute` rejects missing required properties, wrong declared types and invalid enum members before invoking the executor, returning a descriptive `ToolResponse` rather than throwing; rejection text and logs identify property paths and constraints without exposing input values, while accepted input including unknown keys passes through unchanged exactly once without coercion or defaults, and unknown tool names still throw `Unknown tool: <name>`. ([validated by: rejects malformed input safely and passes accepted input through unchanged](../../src/orchestration/tools/registry.acceptance.test.ts#L21)).
+2. Static schemas compile at registration, uncompilable schemas throw an error naming the tool at registration, and subsequent executions reuse that compilation. ([validated by: compiles static schemas at registration and reuses them for ten executions](../../src/orchestration/tools/registry.acceptance.test.ts#L65)).
+3. Function-valued definitions resolve on each call and validate against the current schema, caching compilation by the resolved schema object's identity rather than the tool name. ([validated by: validates dynamic definitions against the current schema and caches by schema identity](../../src/orchestration/tools/registry.acceptance.test.ts#L91)).
+
+## Integration and delivery
+
+Rejection results enter the existing orchestrator tool-result conversation path, allowing a corrected retry within the default five-tool-round budget. The executor's public comment points here in one line. README.md, docs/adding-a-tool.md and .specify/spec.md explain schema enforcement, unchanged extra properties and returned rejection results. The validator ships as a runtime dependency. A MINOR release and consumer-facing changelog and PR migration note explain that executors no longer receive schema-invalid input, including executors that formerly generated their own validation errors.
diff --git a/src/orchestration/tools/registry.acceptance.test.ts b/src/orchestration/tools/registry.acceptance.test.ts
new file mode 100644
index 0000000..6e506fc
--- /dev/null
+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,124 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+import {setLogger} from '../../shared/logger.js';
+
+const weather = (inputSchema: Record<string, unknown>): ToolDefinition => ({
+  name: 'weather',
+  description: 'Weather by location',
+  inputSchema,
+});
+
+const locationSchema = (): Record<string, unknown> => ({
+  type: 'object',
+  properties: {
+    location: {type: 'string'},
+    unit: {type: 'string', enum: ['celsius', 'fahrenheit'], default: 'celsius'},
+  },
+  required: ['location'],
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#1
+it('rejects malformed input safely and passes accepted input through unchanged', async () => {
+  const registry = new ToolRegistry();
+  const received: Record<string, unknown>[] = [];
+  const lines: string[] = [];
+  const record = (category: string, message: string, fields?: Record<string, unknown>): void => {
+    lines.push(JSON.stringify({category, message, fields}));
+  };
+  setLogger({debug: record, info: record, warn: record, error: record});
+  try {
+    registry.register(weather(locationSchema()), async input => {
+      received.push(structuredClone(input));
+      return 'forecast';
+    });
+    const missing = await registry.execute('weather', {});
+    const wrongType = await registry.execute('weather', {location: 987654321});
+    const wrongEnum = await registry.execute('weather', {location: 'private-address-37', unit: 'private-unit-37'});
+    const rejectedCalls = received.length;
+    const rejectionLogs = lines.join('\n');
+    const input = {location: 'Berlin', extra: {keep: true}};
+    const valid = await registry.execute('weather', input);
+    await expect(registry.execute('absent', {})).rejects.toThrow('Unknown tool: absent');
+
+    expect({missing: missing.result, wrongType: wrongType.result, wrongEnum: wrongEnum.result, rejectedCalls}).toEqual({
+      missing: expect.stringMatching(/(?=.*location)(?=.*required)/i),
+      wrongType: expect.stringMatching(/(?=.*location)(?=.*string)/i),
+      wrongEnum: expect.stringMatching(/(?=.*unit)(?=.*enum|.*allowed)/i),
+      rejectedCalls: 0,
+    });
+    expect(rejectionLogs).toMatch(/location/);
+    expect(rejectionLogs).toMatch(/required|type|string|enum/i);
+    for (const value of ['987654321', 'private-address-37', 'private-unit-37']) {
+      expect(JSON.stringify([missing, wrongType, wrongEnum]) + rejectionLogs).not.toContain(value);
+    }
+    expect({received, input, valid}).toEqual({
+      received: [input],
+      input: {location: 'Berlin', extra: {keep: true}},
+      valid: {result: 'forecast'},
+    });
+  } finally {
+    setLogger();
+  }
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#2
+it('compiles static schemas at registration and reuses them for ten executions', async () => {
+  const registry = new ToolRegistry();
+  expect(() => registry.register(weather({type: 'not-a-json-schema-type'}), async () => 'unused')).toThrow(/weather/);
+  let schemaReads = 0;
+  const schema = locationSchema();
+  Object.defineProperty(schema, 'properties', {
+    enumerable: true,
+    get: () => {
+      schemaReads++;
+      return {location: {type: 'string'}};
+    },
+  });
+  let calls = 0;
+  registry.register(weather(schema), async () => {
+    calls++;
+    return 'forecast';
+  });
+  const registrationReads = schemaReads;
+  expect(registrationReads).toBeGreaterThan(0);
+  for (let call = 0; call < 10; call++) {
+    await expect(registry.execute('weather', {location: 'Berlin'})).resolves.toEqual({result: 'forecast'});
+  }
+  expect({schemaReads, calls}).toEqual({schemaReads: registrationReads, calls: 10});
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#3
+it('validates dynamic definitions against the current schema and caches by schema identity', async () => {
+  const registry = new ToolRegistry();
+  const received: Record<string, unknown>[] = [];
+  let current = locationSchema();
+  registry.register(
+    () => weather(current),
+    async input => {
+      received.push(structuredClone(input));
+      return 'forecast';
+    }
+  );
+  await registry.execute('weather', {location: 'Berlin'});
+  let schemaReads = 0;
+  current = {
+    type: 'object',
+    get properties() {
+      schemaReads++;
+      return {location: {type: 'number', enum: [37]}};
+    },
+    required: ['location'],
+  };
+  const rejected = await registry.execute('weather', {location: 'Berlin'});
+  expect(rejected.result).toMatch(/(?=.*location)(?=.*number)/i);
+  const compiledReads = schemaReads;
+  expect(compiledReads).toBeGreaterThan(0);
+  await expect(registry.execute('weather', {location: 37})).resolves.toEqual({result: 'forecast'});
+  expect({received, schemaReads}).toEqual({
+    received: [{location: 'Berlin'}, {location: 37}],
+    schemaReads: compiledReads,
+  });
+  current = locationSchema();
+  const changedBack = await registry.execute('weather', {location: 37});
+  expect(changedBack.result).toMatch(/(?=.*location)(?=.*string)/i);
+});