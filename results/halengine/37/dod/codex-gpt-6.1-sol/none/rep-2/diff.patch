+# Tool Input Validation
+
+| Field  | Value                |
+| ------ | -------------------- |
+| Issue  | re-cinq/HALEngine#37 |
+| Status | Draft                |
+
+This specification defines the registry boundary for model-supplied tool input and preserves the existing tool-result path back to the model.
+
+## Contract
+
+- `ToolRegistry.execute` rejects missing required fields, wrong declared types and enum violations before executing a tool, returning a `ToolResponse` whose result names the property path and failed constraint; returned diagnostics and logs never include rejected input values, valid input including unknown keys passes through unchanged exactly once without coercion or defaults, and unknown tool names still throw `Unknown tool: <name>` ([validated by: rejects malformed tool input privately and passes accepted input through unchanged](../../src/orchestration/tools/registry.acceptance.test.ts#L21)).
+- Static schemas compile at registration, invalid schemas throw an error naming the tool at registration, and ten subsequent executions reuse the compiled schema without reading it again ([validated by: compiles static schemas at registration and reuses them for ten calls](../../src/orchestration/tools/registry.acceptance.test.ts#L76)).
+- Function-valued definitions resolve the current schema on each execution, enforce that schema rather than a stale one, and cache compilation by resolved schema object identity ([validated by: validates each dynamic definition and caches by resolved schema identity](../../src/orchestration/tools/registry.acceptance.test.ts#L119)).
diff --git a/src/orchestration/tools/registry.acceptance.test.ts b/src/orchestration/tools/registry.acceptance.test.ts
new file mode 100644
index 0000000..a9739e5
--- /dev/null
+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,162 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+import {setLogger} from '../../shared/logger.js';
+
+const weather = (inputSchema: Record<string, unknown>): ToolDefinition => ({
+  name: 'weather',
+  description: 'Weather at a location',
+  inputSchema,
+});
+
+const locationSchema = (): Record<string, unknown> => ({
+  type: 'object',
+  properties: {
+    location: {type: 'string'},
+    units: {type: 'string', enum: ['celsius', 'fahrenheit'], default: 'celsius'},
+  },
+  required: ['location'],
+});
+
+// specs/hal-engine-tool-input-validation/spec.md#1
+it('rejects malformed tool input privately and passes accepted input through unchanged', async () => {
+  const registry = new ToolRegistry();
+  const received: Record<string, unknown>[] = [];
+  registry.register(weather(locationSchema()), async input => {
+    received.push(structuredClone(input));
+    return 'forecast';
+  });
+  const logs: string[] = [];
+  const record = (category: string, message: string, fields?: Record<string, unknown>): void => {
+    logs.push(JSON.stringify({category, message, fields}));
+  };
+  setLogger({debug: record, info: record, warn: record, error: record});
+  try {
+    const cases = [
+      {input: {}, path: 'location', constraint: 'required'},
+      {input: {location: 987654321}, path: 'location', constraint: 'string'},
+      {input: {location: 'private-person@example.test', units: 'private-unit'}, path: 'units', constraint: 'enum'},
+    ];
+    const rejections = [];
+    for (const {input, path, constraint} of cases) {
+      logs.length = 0;
+      const response = await registry.execute('weather', input);
+      rejections.push({
+        response,
+        calls: received.length,
+        diagnostic: response.result.includes(path) && response.result.toLowerCase().includes(constraint),
+        logDiagnostic: logs.some(line => line.includes(path) && line.toLowerCase().includes(constraint)),
+        leaked: /987654321|private-person@example\.test|private-unit/.test(response.result + logs.join('\n')),
+      });
+    }
+    const valid = {location: 'Berlin', unlisted: {keep: ['this', 7]}};
+    const response = await registry.execute('weather', valid);
+    const unknown = await registry.execute('absent', {}).then(
+      () => 'did not throw',
+      (error: Error) => error.message
+    );
+    expect({rejections, received, valid, response, unknown}).toEqual({
+      rejections: cases.map(() => ({
+        response: {result: expect.any(String)},
+        calls: 0,
+        diagnostic: true,
+        logDiagnostic: true,
+        leaked: false,
+      })),
+      received: [{location: 'Berlin', unlisted: {keep: ['this', 7]}}],
+      valid: {location: 'Berlin', unlisted: {keep: ['this', 7]}},
+      response: {result: 'forecast'},
+      unknown: 'Unknown tool: absent',
+    });
+  } finally {
+    setLogger();
+  }
+});
+
+// specs/hal-engine-tool-input-validation/spec.md#2
+it('compiles static schemas at registration and reuses them for ten calls', async () => {
+  const registry = new ToolRegistry();
+  let schemaReads = 0;
+  const schema = {
+    get type(): string {
+      schemaReads++;
+      return 'object';
+    },
+    properties: {location: {type: 'string'}},
+    required: ['location'],
+  };
+  const received: Record<string, unknown>[] = [];
+  registry.register(weather(schema), async input => {
+    received.push(input);
+    return 'forecast';
+  });
+  const readsAtRegistration = schemaReads;
+  for (let call = 0; call < 10; call++) {
+    await registry.execute('weather', {location: 'Berlin'});
+  }
+  let registrationError = '';
+  try {
+    registry.register(
+      {name: 'broken-weather', description: 'Invalid schema', inputSchema: {type: 'not-a-json-type'}},
+      async () => 'unused'
+    );
+  } catch (error) {
+    registrationError = error instanceof Error ? error.message : String(error);
+  }
+  expect({
+    compiledAtRegistration: readsAtRegistration > 0,
+    rereads: schemaReads - readsAtRegistration,
+    calls: received.length,
+    registrationError,
+  }).toEqual({
+    compiledAtRegistration: true,
+    rereads: 0,
+    calls: 10,
+    registrationError: expect.stringContaining('broken-weather'),
+  });
+});
+
+// specs/hal-engine-tool-input-validation/spec.md#3
+it('validates each dynamic definition and caches by resolved schema identity', async () => {
+  const registry = new ToolRegistry();
+  let schemaReads = 0;
+  const numericSchema = {
+    get type(): string {
+      schemaReads++;
+      return 'object';
+    },
+    properties: {location: {type: 'number'}},
+    required: ['location'],
+  };
+  const textSchema = locationSchema();
+  let current: Record<string, unknown> = textSchema;
+  const received: Record<string, unknown>[] = [];
+  registry.register(
+    () => weather(current),
+    async input => {
+      received.push(structuredClone(input));
+      return 'forecast';
+    }
+  );
+  await registry.execute('weather', {location: 'Berlin'});
+  current = numericSchema;
+  const rejectedText = await registry.execute('weather', {location: 'Berlin'});
+  const readsAfterFirstNumericCall = schemaReads;
+  await registry.execute('weather', {location: 52});
+  current = textSchema;
+  const rejectedNumber = await registry.execute('weather', {location: 52});
+  current = numericSchema;
+  await registry.execute('weather', {location: 53});
+  expect({
+    received,
+    rejectedText: rejectedText.result,
+    rejectedNumber: rejectedNumber.result,
+    compiled: readsAfterFirstNumericCall > 0,
+    rereads: schemaReads - readsAfterFirstNumericCall,
+  }).toEqual({
+    received: [{location: 'Berlin'}, {location: 52}, {location: 53}],
+    rejectedText: expect.stringMatching(/(?=.*location)(?=.*number)/s),
+    rejectedNumber: expect.stringMatching(/(?=.*location)(?=.*string)/s),
+    compiled: true,
+    rereads: 0,
+  });
+});