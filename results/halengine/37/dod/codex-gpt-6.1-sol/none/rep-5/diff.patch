+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,146 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+import {setLogger} from '../../shared/logger.js';
+
+function definition(inputSchema: Record<string, unknown>): ToolDefinition {
+  return {name: 'weather', description: 'Weather by location', inputSchema};
+}
+
+function observedSchema(type: string): {schema: Record<string, unknown>; reads: () => number} {
+  let reads = 0;
+  const schema = {
+    type: 'object',
+    required: ['location'],
+    properties: {
+      location: {
+        get type(): string {
+          reads += 1;
+          return type;
+        },
+      },
+    },
+  };
+  return {schema, reads: () => reads};
+}
+
+// specs/hal-engine-tool-input-validation/spec.md#1
+it('rejects malformed input privately and passes valid input unchanged', async () => {
+  const registry = new ToolRegistry();
+  const received: Record<string, unknown>[] = [];
+  const logs: unknown[] = [];
+  const record = (...fields: unknown[]): void => {
+    logs.push(fields);
+  };
+  setLogger({debug: record, info: record, warn: record, error: record});
+  try {
+    registry.register(
+      definition({
+        type: 'object',
+        properties: {
+          location: {type: 'string'},
+          unit: {type: 'string', enum: ['C', 'F'], default: 'C'},
+        },
+        required: ['location'],
+      }),
+      async input => {
+        received.push(structuredClone(input));
+        return 'forecast';
+      }
+    );
+    const missing = await registry.execute('weather', {});
+    const wrongType = await registry.execute('weather', {location: 987654321, identity: 'private@example.test'});
+    const wrongEnum = await registry.execute('weather', {location: 'Berlin', unit: 'private-unit'});
+    const valid = {location: 'Berlin', extra: {keep: true}};
+    const original = structuredClone(valid);
+    const success = await registry.execute('weather', valid);
+    const unknown = await registry.execute('missing', {}).catch((error: Error) => error.message);
+    expect({
+      logConstraints: /(?=.*location)(?=.*required)(?=.*string)(?=.*unit)(?=.*enum|.*allowed)/is.test(
+        JSON.stringify(logs)
+      ),
+      missing: missing.result,
+      wrongType: wrongType.result,
+      wrongEnum: wrongEnum.result,
+      received,
+      valid,
+      success,
+      unknown,
+      leaks: /987654321|private@example.test|private-unit/.test(JSON.stringify({logs, missing, wrongType, wrongEnum})),
+    }).toEqual({
+      logConstraints: true,
+      missing: expect.stringMatching(/(?=.*location)(?=.*required)/is),
+      wrongType: expect.stringMatching(/(?=.*location)(?=.*string)/is),
+      wrongEnum: expect.stringMatching(/(?=.*unit)(?=.*enum|.*allowed)/is),
+      received: [original],
+      valid: original,
+      success: {result: 'forecast'},
+      unknown: 'Unknown tool: missing',
+      leaks: false,
+    });
+  } finally {
+    setLogger();
+  }
+});
+
+// specs/hal-engine-tool-input-validation/spec.md#2
+it('compiles static schemas at registration and reuses them', async () => {
+  const registry = new ToolRegistry();
+  let registrationError = '';
+  try {
+    registry.register(definition({type: 'not-a-json-schema-type'}), async () => 'unused');
+  } catch (error) {
+    registrationError = (error as Error).message;
+  }
+  const observed = observedSchema('string');
+  registry.register(definition(observed.schema), async () => 'forecast');
+  const readsAtRegistration = observed.reads();
+  for (let index = 0; index < 10; index += 1) {
+    await registry.execute('weather', {location: 'Berlin'});
+  }
+  expect({
+    registrationError,
+    compiledAtRegistration: readsAtRegistration > 0,
+    extraReads: observed.reads() - readsAtRegistration,
+  }).toEqual({registrationError: expect.stringContaining('weather'), compiledAtRegistration: true, extraReads: 0});
+});
+
+// specs/hal-engine-tool-input-validation/spec.md#3
+it('validates the current dynamic schema and caches each schema object', async () => {
+  const registry = new ToolRegistry();
+  const strings = observedSchema('string');
+  const numbers = observedSchema('number');
+  let current = strings.schema;
+  const received: Record<string, unknown>[] = [];
+  registry.register(
+    () => definition(current),
+    async input => {
+      received.push(structuredClone(input));
+      return 'forecast';
+    }
+  );
+  const first = await registry.execute('weather', {location: 42});
+  const stringReads = strings.reads();
+  current = numbers.schema;
+  const second = await registry.execute('weather', {location: 'Berlin'});
+  const numberReads = numbers.reads();
+  const accepted = await registry.execute('weather', {location: 42});
+  current = strings.schema;
+  const last = await registry.execute('weather', {location: 'Berlin'});
+  expect({
+    first: first.result,
+    second: second.result,
+    accepted,
+    last,
+    received,
+    compiledBoth: stringReads > 0 && numberReads > 0,
+    cachedBoth: strings.reads() === stringReads && numbers.reads() === numberReads,
+  }).toEqual({
+    first: expect.stringMatching(/(?=.*location)(?=.*string)/is),
+    second: expect.stringMatching(/(?=.*location)(?=.*number)/is),
+    accepted: {result: 'forecast'},
+    last: {result: 'forecast'},
+    received: [{location: 42}, {location: 'Berlin'}],
+    compiledBoth: true,
+    cachedBoth: true,
+  });
+});