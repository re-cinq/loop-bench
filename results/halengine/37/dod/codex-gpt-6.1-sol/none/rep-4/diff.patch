+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,136 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolContext} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+import {setLogger} from '../../shared/logger.js';
+
+const definition = (inputSchema: Record<string, unknown>): ToolDefinition => ({
+  name: 'weather',
+  description: 'Weather lookup',
+  inputSchema,
+});
+
+const locationSchema = () => ({
+  type: 'object',
+  properties: {location: {type: 'string'}, units: {type: 'string', enum: ['metric'], default: 'metric'}},
+  required: ['location'],
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#1
+it('rejects malformed tool input privately and passes valid input through unchanged', async () => {
+  const registry = new ToolRegistry();
+  const calls: {input: Record<string, unknown>; context?: ToolContext}[] = [];
+  registry.register(definition(locationSchema()), async (input, context) => {
+    calls.push({input: structuredClone(input), context});
+    return 'forecast';
+  });
+  const lines: string[] = [];
+  const write = (category: string, message: string, fields?: Record<string, unknown>) => {
+    lines.push(JSON.stringify({category, message, fields}));
+  };
+  setLogger({debug: write, info: write, warn: write, error: write});
+  try {
+    const rejected = [];
+    for (const input of [{}, {location: 867530912345}, {location: 'Berlin', units: 'private-unit-42'}]) {
+      lines.length = 0;
+      const response = await registry.execute('weather', input);
+      rejected.push({response, logs: lines.join('\n')});
+    }
+    const valid = {location: 'Berlin', extra: {id: 'keep-me'}};
+    const context = {userId: 'user-1', sessionId: 'session-1'};
+    const response = await registry.execute('weather', valid, context);
+    expect({rejected, calls, response, valid}).toEqual({
+      rejected: [
+        {
+          response: {result: expect.stringMatching(/(?=.*location)(?=.*required)/is)},
+          logs: expect.stringMatching(/(?=.*location)(?=.*required)/is),
+        },
+        {
+          response: {result: expect.stringMatching(/(?=.*location)(?=.*string)/is)},
+          logs: expect.stringMatching(/(?=.*location)(?=.*(?:type|string))/is),
+        },
+        {
+          response: {result: expect.stringMatching(/(?=.*units)(?=.*enum)/is)},
+          logs: expect.stringMatching(/(?=.*units)(?=.*enum)/is),
+        },
+      ],
+      calls: [{input: {location: 'Berlin', extra: {id: 'keep-me'}}, context}],
+      response: {result: 'forecast'},
+      valid: {location: 'Berlin', extra: {id: 'keep-me'}},
+    });
+    expect(JSON.stringify(rejected)).not.toMatch(/867530912345|private-unit-42/);
+    await expect(registry.execute('missing', {})).rejects.toThrow('Unknown tool: missing');
+  } finally {
+    setLogger();
+  }
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#2
+it('compiles static schemas at registration and reuses them across ten calls', async () => {
+  const registry = new ToolRegistry();
+  let schemaReads = 0;
+  const schema = {
+    ...locationSchema(),
+    get required() {
+      schemaReads++;
+      return ['location'];
+    },
+  };
+  registry.register(definition(schema), async () => 'forecast');
+  const registrationReads = schemaReads;
+  for (let call = 0; call < 10; call++) await registry.execute('weather', {location: 'Berlin'});
+  let registrationError = '';
+  try {
+    registry.register(definition({type: 'not-a-json-schema-type'}), async () => 'unreachable');
+  } catch (error) {
+    registrationError = error instanceof Error ? error.message : String(error);
+  }
+  expect({
+    compiledAtRegistration: registrationReads > 0,
+    reused: schemaReads === registrationReads,
+    registrationError,
+  }).toEqual({compiledAtRegistration: true, reused: true, registrationError: expect.stringContaining('weather')});
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#3
+it('validates dynamic definitions against the current schema and caches each schema object', async () => {
+  const registry = new ToolRegistry();
+  const stringSchema = locationSchema();
+  let numberSchemaReads = 0;
+  const numberSchema = {
+    type: 'object',
+    properties: {location: {type: 'number'}},
+    get required() {
+      numberSchemaReads++;
+      return ['location'];
+    },
+  };
+  let current: Record<string, unknown> = stringSchema;
+  const calls: Record<string, unknown>[] = [];
+  registry.register(
+    () => definition(current),
+    async input => {
+      calls.push(structuredClone(input));
+      return 'forecast';
+    }
+  );
+  await registry.execute('weather', {location: 'Berlin'});
+  current = numberSchema;
+  const rejected = await registry.execute('weather', {location: 'Berlin'});
+  const firstCompilationReads = numberSchemaReads;
+  await registry.execute('weather', {location: 12});
+  current = stringSchema;
+  await registry.execute('weather', {location: 'Paris'});
+  current = numberSchema;
+  await registry.execute('weather', {location: 13});
+  expect({
+    rejected,
+    calls,
+    compiled: firstCompilationReads > 0,
+    cached: numberSchemaReads === firstCompilationReads,
+  }).toEqual({
+    rejected: {result: expect.stringMatching(/(?=.*location)(?=.*number)/is)},
+    calls: [{location: 'Berlin'}, {location: 12}, {location: 'Paris'}, {location: 13}],
+    compiled: true,
+    cached: true,
+  });
+});