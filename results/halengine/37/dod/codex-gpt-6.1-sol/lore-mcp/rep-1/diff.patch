+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,122 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+import {setLogger} from '../../shared/logger.js';
+
+const weather = (inputSchema: Record<string, unknown>): ToolDefinition => ({
+  name: 'weather',
+  description: 'Look up weather',
+  inputSchema,
+});
+const schema = {
+  type: 'object',
+  properties: {
+    location: {type: 'string'},
+    units: {type: 'string', enum: ['metric', 'imperial'], default: 'metric'},
+  },
+  required: ['location'],
+};
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#1
+it('rejects malformed input safely and preserves accepted input', async () => {
+  const registry = new ToolRegistry();
+  const received: Record<string, unknown>[] = [];
+  const lines: string[] = [];
+  const record = (category: string, message: string, fields?: Record<string, unknown>): void => {
+    lines.push(JSON.stringify({category, message, fields}));
+  };
+  setLogger({debug: record, info: record, warn: record, error: record});
+  try {
+    registry.register(weather(schema), async input => {
+      received.push(structuredClone(input));
+      return 'forecast';
+    });
+    const missing = await registry.execute('weather', {});
+    expect(missing.result).toMatch(/location/i);
+    expect(missing.result).toMatch(/required/i);
+    expect(received).toEqual([]);
+    expect(lines.join('\n')).toMatch(/location/i);
+    expect(lines.join('\n')).toMatch(/required/i);
+
+    const wrongType = await registry.execute('weather', {location: 918273645});
+    expect(wrongType.result).toMatch(/location/i);
+    expect(wrongType.result).toMatch(/string/i);
+    const wrongEnum = await registry.execute('weather', {location: 'private-city-736', units: 'private-unit-837'});
+    expect(wrongEnum.result).toMatch(/units/i);
+    expect(wrongEnum.result).toMatch(/enum|allowed/i);
+    expect(received).toEqual([]);
+    const diagnostics = JSON.stringify({missing, wrongType, wrongEnum, lines});
+    for (const secret of ['918273645', 'private-city-736', 'private-unit-837']) {
+      expect(diagnostics).not.toContain(secret);
+    }
+
+    const input = {location: 'Berlin', extra: {keep: true}};
+    expect(await registry.execute('weather', input)).toEqual({result: 'forecast'});
+    expect(input).toEqual({location: 'Berlin', extra: {keep: true}});
+    expect(received).toEqual([{location: 'Berlin', extra: {keep: true}}]);
+    await expect(registry.execute('unregistered', {})).rejects.toThrow('Unknown tool: unregistered');
+  } finally {
+    setLogger();
+  }
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#2
+it('compiles static schemas at registration and reuses them for ten calls', async () => {
+  const registry = new ToolRegistry();
+  expect(() => registry.register(weather({type: 'not-a-json-schema-type'}), async () => 'unused')).toThrow(/weather/);
+  let reads = 0;
+  const observedSchema = {
+    ...schema,
+    get properties() {
+      reads++;
+      return schema.properties;
+    },
+  };
+  let calls = 0;
+  registry.register(weather(observedSchema), async () => {
+    calls++;
+    return 'forecast';
+  });
+  const registrationReads = reads;
+  expect(registrationReads).toBeGreaterThan(0);
+  for (let index = 0; index < 10; index++) {
+    expect(await registry.execute('weather', {location: 'Berlin'})).toEqual({result: 'forecast'});
+  }
+  expect({reads, calls}).toEqual({reads: registrationReads, calls: 10});
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#3
+it('validates each dynamic definition and caches by schema object', async () => {
+  const registry = new ToolRegistry();
+  let reads = 0;
+  const numericSchema = {
+    type: 'object',
+    get properties() {
+      reads++;
+      return {location: {type: 'number'}};
+    },
+    required: ['location'],
+  };
+  let current: Record<string, unknown> = schema;
+  const received: Record<string, unknown>[] = [];
+  registry.register(
+    () => weather(current),
+    async input => {
+      received.push(structuredClone(input));
+      return 'forecast';
+    }
+  );
+  expect((await registry.execute('weather', {location: 42})).result).toMatch(/string/i);
+  expect(received).toEqual([]);
+  expect(await registry.execute('weather', {location: 'Berlin'})).toEqual({result: 'forecast'});
+  current = numericSchema;
+  expect((await registry.execute('weather', {location: 'Berlin'})).result).toMatch(/number/i);
+  const compilationReads = reads;
+  expect(compilationReads).toBeGreaterThan(0);
+  expect(await registry.execute('weather', {location: 42})).toEqual({result: 'forecast'});
+  current = schema;
+  expect((await registry.execute('weather', {location: 42})).result).toMatch(/string/i);
+  current = numericSchema;
+  expect(await registry.execute('weather', {location: 43})).toEqual({result: 'forecast'});
+  expect(reads).toBe(compilationReads);
+  expect(received).toEqual([{location: 'Berlin'}, {location: 42}, {location: 43}]);
+});