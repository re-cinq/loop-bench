index 0000000..4b5d470
--- /dev/null
+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,124 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+import {setLogger} from '../../shared/logger.js';
+
+const definition = (inputSchema: Record<string, unknown>): ToolDefinition => ({
+  name: 'weather',
+  description: 'Weather by location',
+  inputSchema,
+});
+
+const weatherSchema = (): Record<string, unknown> => ({
+  type: 'object',
+  properties: {
+    location: {type: 'string'},
+    units: {type: 'string', enum: ['metric', 'imperial'], default: 'metric'},
+  },
+  required: ['location'],
+});
+
+describe('registered tool input validation', () => {
+  it('rejects malformed calls privately and passes accepted input through unchanged', async () => {
+    // specs/hal-engine-tool-input-validation/spec.md#1
+    const registry = new ToolRegistry();
+    const calls: Record<string, unknown>[] = [];
+    const lines: string[] = [];
+    const record = (category: string, message: string, fields?: Record<string, unknown>): void => {
+      lines.push(JSON.stringify({category, message, fields}));
+    };
+    setLogger({debug: record, info: record, warn: record, error: record});
+    try {
+      registry.register(definition(weatherSchema()), async input => {
+        calls.push(structuredClone(input));
+        return 'forecast';
+      });
+      const missing = await registry.execute('weather', {});
+      expect({result: missing.result, calls: calls.length}).toEqual({
+        result: expect.stringMatching(/(?=.*location)(?=.*required)/is),
+        calls: 0,
+      });
+      const wrongType = await registry.execute('weather', {location: 8675309});
+      expect(wrongType.result).toMatch(/(?=.*location)(?=.*string)/is);
+      const secret = 'person@example.invalid';
+      const wrongEnum = await registry.execute('weather', {location: 'Berlin', units: secret});
+      expect(wrongEnum.result).toMatch(/(?=.*units)(?=.*enum|.*allowed)/is);
+      expect(calls).toEqual([]);
+      expect(JSON.stringify([missing, wrongType, wrongEnum, lines])).not.toContain(secret);
+      expect(JSON.stringify([wrongType, lines])).not.toContain('8675309');
+      expect(lines.join('\n')).toMatch(/(?=.*location)(?=.*required)/is);
+      expect(lines.join('\n')).toMatch(/(?=.*location)(?=.*string)/is);
+      expect(lines.join('\n')).toMatch(/(?=.*units)(?=.*enum|.*allowed)/is);
+      const accepted = {location: 'Berlin', extra: {contact: 'keep me'}};
+      expect(await registry.execute('weather', accepted)).toEqual({result: 'forecast'});
+      expect(calls).toEqual([accepted]);
+      expect(accepted).toEqual({location: 'Berlin', extra: {contact: 'keep me'}});
+      await expect(registry.execute('unknown', {})).rejects.toThrow('Unknown tool: unknown');
+    } finally {
+      setLogger();
+    }
+  });
+
+  it('compiles static schemas at registration and reuses them across ten executions', async () => {
+    // specs/hal-engine-tool-input-validation/spec.md#2
+    const registry = new ToolRegistry();
+    expect(() => registry.register(definition({type: 'not-a-json-schema-type'}), async () => 'forecast')).toThrow(
+      /weather/
+    );
+    let reads = 0;
+    const schema = weatherSchema();
+    const properties = schema.properties;
+    Object.defineProperty(schema, 'properties', {
+      enumerable: true,
+      get() {
+        reads++;
+        return properties;
+      },
+    });
+    registry.register(definition(schema), async () => 'forecast');
+    const registrationReads = reads;
+    expect(registrationReads).toBeGreaterThan(0);
+    for (let index = 0; index < 10; index++) {
+      expect(await registry.execute('weather', {location: 'Berlin'})).toEqual({result: 'forecast'});
+    }
+    expect(reads).toBe(registrationReads);
+  });
+
+  it('validates each dynamic definition against its current schema and caches by schema object', async () => {
+    // specs/hal-engine-tool-input-validation/spec.md#3
+    const registry = new ToolRegistry();
+    let reads = 0;
+    const stringSchema = weatherSchema();
+    const numberProperties = {location: {type: 'number'}};
+    const numberSchema = {
+      type: 'object',
+      required: ['location'],
+      get properties() {
+        reads++;
+        return numberProperties;
+      },
+    };
+    let current: Record<string, unknown> = stringSchema;
+    const calls: Record<string, unknown>[] = [];
+    registry.register(
+      () => definition(current),
+      async input => {
+        calls.push(structuredClone(input));
+        return 'forecast';
+      }
+    );
+    expect(await registry.execute('weather', {location: 'Berlin'})).toEqual({result: 'forecast'});
+    current = numberSchema;
+    const rejected = await registry.execute('weather', {location: 'Berlin'});
+    expect({result: rejected.result, calls: calls.length}).toEqual({
+      result: expect.stringMatching(/(?=.*location)(?=.*number)/is),
+      calls: 1,
+    });
+    const compilationReads = reads;
+    expect(compilationReads).toBeGreaterThan(0);
+    expect(await registry.execute('weather', {location: 42})).toEqual({result: 'forecast'});
+    expect(reads).toBe(compilationReads);
+    current = stringSchema;
+    expect((await registry.execute('weather', {location: 42})).result).toMatch(/(?=.*location)(?=.*string)/is);
+    expect(calls).toEqual([{location: 'Berlin'}, {location: 42}]);
+  });
+});