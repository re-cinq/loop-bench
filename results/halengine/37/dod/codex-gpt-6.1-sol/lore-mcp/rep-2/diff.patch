+import {spawnSync} from 'node:child_process';
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const weather = (inputSchema: Record<string, unknown>): ToolDefinition => ({
+  name: 'weather',
+  description: 'Look up weather',
+  inputSchema,
+});
+
+const locationSchema = (): Record<string, unknown> => ({
+  type: 'object',
+  properties: {location: {type: 'string'}, units: {type: 'string', default: 'metric'}},
+  required: ['location'],
+});
+
+describe('ToolRegistry input validation', () => {
+  // specs/hal-engine-tool-input-validation/spec.md#1
+  it('rejects missing input and preserves accepted input and unknown-tool behavior', async () => {
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+    registry.register(weather(locationSchema()), async input => {
+      received.push(structuredClone(input));
+      return 'forecast';
+    });
+
+    await expect(registry.execute('missing', {})).rejects.toThrow('Unknown tool: missing');
+    const input = {location: 'Berlin', extra: {account: 42}};
+    await expect(registry.execute('weather', input)).resolves.toEqual({result: 'forecast'});
+    expect(received).toEqual([{location: 'Berlin', extra: {account: 42}}]);
+    expect(input).toEqual({location: 'Berlin', extra: {account: 42}});
+    received.length = 0;
+
+    const rejection = await registry.execute('weather', {});
+    expect({result: rejection.result, received}).toEqual({
+      result: expect.stringMatching(/(?=.*location)(?=.*required)/is),
+      received: [],
+    });
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#2
+  it('rejects types and enums with safe property diagnostics in results and real logs', () => {
+    const script = `
+      import {ToolRegistry} from './src/orchestration/tools/registry.ts';
+      const registry = new ToolRegistry();
+      const received = [];
+      registry.register({name: 'weather', description: 'Weather', inputSchema: {
+        type: 'object', required: ['location', 'units'], properties: {
+          location: {type: 'string'}, units: {type: 'string', enum: ['metric', 'imperial']}
+        }
+      }}, async input => {received.push(input); return 'executor ran';});
+      const type = await registry.execute('weather', {location: 987654321, units: 'metric', identity: 'private@example.test'});
+      const enumeration = await registry.execute('weather', {location: 'Private Street 22', units: 'secret-units'});
+      console.log('ACCEPTANCE_RESULT=' + JSON.stringify({type, enumeration, received}));
+    `;
+    const processResult = spawnSync(process.execPath, ['--import', 'tsx', '--input-type=module', '-e', script], {
+      cwd: process.cwd(),
+      encoding: 'utf8',
+      env: {...process.env, LOG_LEVEL: 'debug'},
+      stdio: ['ignore', 'pipe', 'pipe'],
+    });
+    expect(processResult.status).toBe(0);
+    const output = processResult.stdout + processResult.stderr;
+    const marker = output.split('\n').find(line => line.startsWith('ACCEPTANCE_RESULT='));
+    const result = JSON.parse(marker!.slice('ACCEPTANCE_RESULT='.length));
+    expect(result).toEqual({
+      type: {result: expect.stringMatching(/(?=.*location)(?=.*string)/is)},
+      enumeration: {result: expect.stringMatching(/(?=.*units)(?=.*enum|.*allowed)/is)},
+      received: [],
+    });
+    for (const value of ['987654321', 'private@example.test', 'Private Street 22', 'secret-units']) {
+      expect(output).not.toContain(value);
+    }
+    const logs = output.split('\n').filter(line => line && !line.startsWith('ACCEPTANCE_RESULT='));
+    expect(logs.some(line => /location/.test(line) && /type|string/.test(line))).toBe(true);
+    expect(logs.some(line => /units/.test(line) && /enum|allowed/.test(line))).toBe(true);
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#3
+  it('compiles static schemas at registration and reuses them across ten executions', async () => {
+    const registry = new ToolRegistry();
+    let schemaReads = 0;
+    const schema = {
+      type: 'object',
+      get properties() {
+        schemaReads++;
+        return {location: {type: 'string'}};
+      },
+      required: ['location'],
+    };
+    const received: Record<string, unknown>[] = [];
+    registry.register(weather(schema), async input => {
+      received.push(input);
+      return 'forecast';
+    });
+    const readsAtRegistration = schemaReads;
+    for (let call = 0; call < 10; call++) {
+      await expect(registry.execute('weather', {location: 'Berlin'})).resolves.toEqual({result: 'forecast'});
+    }
+    expect(received).toHaveLength(10);
+    expect(schemaReads).toBe(readsAtRegistration);
+    expect(readsAtRegistration).toBeGreaterThan(0);
+    expect(() => registry.register(weather({type: 'not-a-json-schema-type'}), async () => 'unused')).toThrow(/weather/);
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#4
+  it('validates the current dynamic schema and caches by resolved schema identity', async () => {
+    const registry = new ToolRegistry();
+    const reads = [0, 0];
+    const schemas = ['string', 'number'].map((type, index) => ({
+      type: 'object',
+      get properties() {
+        reads[index]!++;
+        return {location: {type}};
+      },
+      required: ['location'],
+    }));
+    let current = 0;
+    const received: Record<string, unknown>[] = [];
+    registry.register(
+      () => weather(schemas[current]!),
+      async input => {
+        received.push(input);
+        return 'accepted';
+      }
+    );
+    await expect(registry.execute('weather', {location: 'Berlin'})).resolves.toEqual({result: 'accepted'});
+    current = 1;
+    const rejection = await registry.execute('weather', {location: 'Berlin'});
+    expect({result: rejection.result, received}).toEqual({
+      result: expect.stringMatching(/(?=.*location)(?=.*number)/is),
+      received: [{location: 'Berlin'}],
+    });
+    const afterFirstCompilation = [...reads];
+    await expect(registry.execute('weather', {location: 52})).resolves.toEqual({result: 'accepted'});
+    current = 0;
+    await expect(registry.execute('weather', {location: 'Paris'})).resolves.toEqual({result: 'accepted'});
+    expect(received).toEqual([{location: 'Berlin'}, {location: 52}, {location: 'Paris'}]);
+    expect(reads).toEqual(afterFirstCompilation);
+    expect(reads.every(count => count > 0)).toBe(true);
+  });
+});