index 0000000..d6e01ab
--- /dev/null
+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,139 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+import {setLogger} from '../../shared/logger.js';
+
+const definition = (inputSchema: Record<string, unknown>): ToolDefinition => ({
+  name: 'weather',
+  description: 'Weather for a location',
+  inputSchema,
+});
+
+const locationSchema = {
+  type: 'object',
+  properties: {
+    location: {type: 'string'},
+    units: {type: 'string', enum: ['metric', 'imperial'], default: 'metric'},
+  },
+  required: ['location'],
+};
+
+// specs/hal-engine-tool-input-validation/spec.md#1
+it('rejects malformed tool input privately and passes accepted input through unchanged', async () => {
+  const registry = new ToolRegistry();
+  const calls: Record<string, unknown>[] = [];
+  const lines: string[] = [];
+  const record = (category: string, message: string, fields?: Record<string, unknown>): void => {
+    lines.push(JSON.stringify({category, message, fields}));
+  };
+  setLogger({debug: record, info: record, warn: record, error: record});
+  try {
+    registry.register(definition(locationSchema), async input => {
+      calls.push(structuredClone(input));
+      return 'forecast';
+    });
+    const payloads = [{}, {location: 867530912345}, {location: 'Berlin', units: 'private-units-48392'}];
+    const responses = [];
+    for (const payload of payloads) responses.push(await registry.execute('weather', payload));
+    const rejectedCalls = [...calls];
+    const accepted = {location: 'Berlin', extra: {identifying: 'private-extra-73821'}};
+    const original = structuredClone(accepted);
+    const success = await registry.execute('weather', accepted);
+    const unknown = await registry.execute('unregistered', {}).then(
+      () => 'unexpected success',
+      (error: Error) => error.message
+    );
+
+    expect({responses, rejectedCalls, calls, accepted, success, unknown}).toEqual({
+      responses: [
+        {result: expect.stringMatching(/(?=.*location)(?=.*required)/is)},
+        {result: expect.stringMatching(/(?=.*location)(?=.*string)/is)},
+        {result: expect.stringMatching(/(?=.*units)(?=.*enum|.*allowed)/is)},
+      ],
+      rejectedCalls: [],
+      calls: [original],
+      accepted: original,
+      success: {result: 'forecast'},
+      unknown: 'Unknown tool: unregistered',
+    });
+    const diagnosticText = JSON.stringify(responses) + lines.join('\n');
+    for (const value of ['867530912345', 'private-units-48392', 'private-extra-73821']) {
+      expect(diagnosticText).not.toContain(value);
+    }
+    expect(lines.join('\n')).toMatch(/location/);
+    expect(lines.join('\n')).toMatch(/required|string/);
+    expect(lines.join('\n')).toMatch(/units/);
+    expect(lines.join('\n')).toMatch(/enum|allowed/);
+  } finally {
+    setLogger();
+  }
+});
+
+// specs/hal-engine-tool-input-validation/spec.md#2
+it('compiles static schemas at registration and reuses them for ten executions', async () => {
+  const registry = new ToolRegistry();
+  let schemaReads = 0;
+  const schema = {
+    type: 'object',
+    properties: {location: {type: 'string'}},
+    get required() {
+      schemaReads++;
+      return ['location'];
+    },
+  };
+  registry.register(definition(schema), async () => 'forecast');
+  const readsAtRegistration = schemaReads;
+  for (let call = 0; call < 10; call++) await registry.execute('weather', {location: 'Berlin'});
+  let registrationError = '';
+  try {
+    registry.register(
+      definition({type: 'object', properties: {location: {type: 'not-a-json-schema-type'}}}),
+      async () => 'unused'
+    );
+  } catch (error) {
+    registrationError = error instanceof Error ? error.message : String(error);
+  }
+  expect({readsAtRegistration, readsAfterExecution: schemaReads, registrationError}).toEqual({
+    readsAtRegistration: expect.any(Number),
+    readsAfterExecution: readsAtRegistration,
+    registrationError: expect.stringContaining('weather'),
+  });
+  expect(readsAtRegistration).toBeGreaterThan(0);
+});
+
+// specs/hal-engine-tool-input-validation/spec.md#3
+it('validates each dynamic definition against its current schema and reuses schema objects', async () => {
+  const registry = new ToolRegistry();
+  const calls: Record<string, unknown>[] = [];
+  let schemaReads = 0;
+  const numericSchema = {
+    type: 'object',
+    properties: {location: {type: 'number'}},
+    get required() {
+      schemaReads++;
+      return ['location'];
+    },
+  };
+  let current = locationSchema as Record<string, unknown>;
+  registry.register(
+    () => definition(current),
+    async input => {
+      calls.push(structuredClone(input));
+      return 'forecast';
+    }
+  );
+  await registry.execute('weather', {location: 'Berlin'});
+  current = numericSchema;
+  const rejected = await registry.execute('weather', {location: 'Berlin'});
+  const readsAfterCompile = schemaReads;
+  const accepted = await registry.execute('weather', {location: 42});
+  current = locationSchema;
+  const stringAgain = await registry.execute('weather', {location: 42});
+  expect({rejected, accepted, stringAgain, calls}).toEqual({
+    rejected: {result: expect.stringMatching(/(?=.*location)(?=.*number)/is)},
+    accepted: {result: 'forecast'},
+    stringAgain: {result: expect.stringMatching(/(?=.*location)(?=.*string)/is)},
+    calls: [{location: 'Berlin'}, {location: 42}],
+  });
+  expect(readsAfterCompile).toBeGreaterThan(0);
+  expect(schemaReads).toBe(readsAfterCompile);
+});