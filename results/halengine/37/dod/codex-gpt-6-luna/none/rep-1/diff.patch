+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry input schema validation', () => {
+  it('rejects missing required input before invoking the executor', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Weather lookup',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async () => {
+        calls += 1;
+        return 'forecast';
+      }
+    );
+
+    const response = await registry.execute('weather', {});
+
+    expect(response.result).toContain('location');
+    expect(calls).toBe(0);
+  });
+
+  it('passes valid input and extra properties through unchanged', async () => {
+    const registry = new ToolRegistry();
+    const input = {location: 'Berlin', trace: 'caller metadata'};
+    let received: Record<string, unknown> | undefined;
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Weather lookup',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async value => {
+        received = value;
+        return 'forecast';
+      }
+    );
+
+    await registry.execute('weather', input);
+
+    expect(received).toEqual(input);
+  });
+
+  it('validates against the current function supplied schema on each call', async () => {
+    const registry = new ToolRegistry();
+    let call = 0;
+    registry.register(
+      () => ({
+        name: 'dynamic',
+        description: 'Dynamic schema',
+        inputSchema: {
+          type: 'object',
+          properties: {first: {type: 'string'}, second: {type: 'string'}},
+          required: [call++ === 0 ? 'first' : 'second'],
+        },
+      }),
+      async () => 'accepted'
+    );
+
+    const first = await registry.execute('dynamic', {first: 'one'});
+    const second = await registry.execute('dynamic', {first: 'one'});
+
+    expect(first.result).toBe('accepted');
+    expect(second.result).toContain('second');
+  });
+});