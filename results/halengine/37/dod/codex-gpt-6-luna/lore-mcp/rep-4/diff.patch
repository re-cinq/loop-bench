@@ -0,0 +1,28 @@
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry input schema validation', () => {
+  it('returns a validation result for missing required input without invoking the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalled = false;
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Get the weather',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async () => {
+        executorCalled = true;
+        return 'forecast';
+      }
+    );
+
+    const response = await registry.execute('weather', {});
+
+    expect(response.result).toMatch(/location|required/i);
+    expect(executorCalled).toBe(false);
+  });
+});