+import {ToolRegistry} from './registry.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+
+const definition = {
+  name: 'lookup',
+  description: 'Look up a location',
+  inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+};
+
+describe('ToolRegistry input validation', () => {
+  it('rejects missing and wrong-typed fields before invoking the executor', async () => {
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+    registry.register(definition, async input => {
+      received.push(input);
+      return 'forecast';
+    });
+
+    const missing = await registry.execute('lookup', {});
+    const wrongType = await registry.execute('lookup', {location: 8675309});
+
+    expect({missing, wrongType, received}).toEqual({
+      missing: {result: expect.stringContaining('location')},
+      wrongType: {result: expect.stringContaining('location')},
+      received: [],
+    });
+    expect(wrongType.result).toMatch(/string/i);
+    expect(wrongType.result).not.toContain('8675309');
+  });
+
+  it('passes valid input with extra properties through unchanged', async () => {
+    const registry = new ToolRegistry();
+    let received: Record<string, unknown> | undefined;
+    let calls = 0;
+    registry.register(definition, async input => {
+      calls += 1;
+      received = input;
+      return 'forecast';
+    });
+    const input = {location: 'Berlin', trace: 'keep-me'};
+
+    await registry.execute('lookup', input);
+
+    expect({received, calls}).toEqual({received: input, calls: 1});
+  });
+
+  it('checks each call against its current function-resolved schema', async () => {
+    const registry = new ToolRegistry();
+    let required = 'location';
+    let executions = 0;
+    registry.register(
+      () => ({
+        ...definition,
+        inputSchema: {type: 'object', properties: {[required]: {type: 'string'}}, required: [required]},
+      }),
+      async () => {
+        executions += 1;
+        return 'ok';
+      }
+    );
+
+    const first = await registry.execute('lookup', {location: 'Berlin'});
+    required = 'city';
+    const second = await registry.execute('lookup', {location: 'Berlin'});
+    const third = await registry.execute('lookup', {city: 'Berlin'});
+
+    expect({first, second, third, executions}).toEqual({
+      first: {result: 'ok'},
+      second: {result: expect.stringContaining('city')},
+      third: {result: 'ok'},
+      executions: 2,
+    });
+  });
+
+  it('rejects invalid schemas at registration and preserves unknown-tool errors', async () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register({...definition, inputSchema: {type: 'not-a-json-schema-type'}}, async () => 'unreachable')
+    ).toThrow(/lookup/i);
+    await expect(registry.execute('absent', {})).rejects.toThrow('Unknown tool: absent');
+  });
+
+  it('lets the model correct a rejected tool call on the next round', async () => {
+    const registry = new ToolRegistry();
+    registry.register(definition, async input => `forecast for ${String(input.location)}`);
+    const requests: SendMessageParams[] = [];
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        requests.push(params);
+        round += 1;
+        if (round === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'first', name: 'lookup', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+        } else if (round === 2) {
+          yield {type: 'tool_use', toolCall: {id: 'retry', name: 'lookup', input: {location: 'Berlin'}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+        } else {
+          yield {type: 'text', text: 'Here is the forecast.'};
+          yield {type: 'stop', stopReason: 'end_turn'};
+        }
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const session: ChatSession = {
+      sessionId: 'session',
+      userId: 'user',
+      entries: [{role: 'user', content: 'Weather please', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Test assistant'}), registry);
+
+    await expect(orchestrator.processMessage(session)).resolves.toBe('Here is the forecast.');
+
+    const secondRequest = requests[1];
+    expect(JSON.stringify(secondRequest.messages)).toMatch(/location.{0,30}required/i);
+  });
+});