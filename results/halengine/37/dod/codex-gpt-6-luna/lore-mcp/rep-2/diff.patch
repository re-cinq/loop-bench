@@ -0,0 +1,85 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const definition = (inputSchema: Record<string, unknown>): ToolDefinition => ({
+  name: 'weather',
+  description: 'Look up weather',
+  inputSchema,
+});
+
+describe('ToolRegistry input schema acceptance', () => {
+  it('rejects required, type and enum violations before execution', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(
+      definition({
+        type: 'object',
+        properties: {location: {type: 'string', enum: ['Berlin']}},
+        required: ['location'],
+      }),
+      async () => {
+        calls += 1;
+        return 'forecast';
+      }
+    );
+
+    const missing = await registry.execute('weather', {});
+    const wrongType = await registry.execute('weather', {location: 42});
+    const wrongEnum = await registry.execute('weather', {location: 'Paris'});
+
+    expect(missing.result).toContain('location');
+    expect(missing.result.toLowerCase()).toContain('required');
+    expect(wrongType.result).toContain('location');
+    expect(wrongType.result).toContain('string');
+    expect(wrongType.result).not.toContain('42');
+    expect(wrongEnum.result).toContain('location');
+    expect(wrongEnum.result.toLowerCase()).toContain('enum');
+    expect(wrongEnum.result).not.toContain('Paris');
+    expect(calls).toBe(0);
+  });
+
+  it('passes valid input with extra properties through unchanged', async () => {
+    const registry = new ToolRegistry();
+    const input = {location: 'Berlin', traceId: 'trace-123'};
+    const received: Record<string, unknown>[] = [];
+    registry.register(
+      definition({type: 'object', properties: {location: {type: 'string'}}, required: ['location']}),
+      async value => {
+        received.push(value);
+        return 'forecast';
+      }
+    );
+
+    await registry.execute('weather', input);
+
+    expect(received).toEqual([input]);
+  });
+
+  it('fails invalid static schemas at registration and uses each resolved dynamic schema', async () => {
+    const registry = new ToolRegistry();
+    expect(() => registry.register(definition({type: 'not-a-json-schema-type'}), async () => 'forecast')).toThrow(
+      'weather'
+    );
+
+    let resolutions = 0;
+    let executions = 0;
+    registry.register(
+      () => {
+        resolutions += 1;
+        const field = resolutions <= 2 ? 'location' : 'date';
+        return definition({type: 'object', properties: {[field]: {type: 'string'}}, required: [field]});
+      },
+      async () => {
+        executions += 1;
+        return 'forecast';
+      }
+    );
+
+    const first = await registry.execute('weather', {});
+    const second = await registry.execute('weather', {});
+
+    expect(first.result).toContain('location');
+    expect(second.result).toContain('date');
+    expect(executions).toBe(0);
+  });
+});