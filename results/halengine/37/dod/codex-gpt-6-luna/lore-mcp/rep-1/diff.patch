+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry input validation', () => {
+  it('returns a required-field validation result without invoking the executor', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Get weather',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async () => {
+        calls += 1;
+        return 'forecast';
+      }
+    );
+
+    const response = await registry.execute('weather', {});
+
+    expect(response.result).toMatch(/location.*required/i);
+    expect(calls).toBe(0);
+  });
+});