@@ -0,0 +1,71 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const definition = (inputSchema: Record<string, unknown>): ToolDefinition => ({
+  name: 'lookup',
+  description: 'Look up a place',
+  inputSchema,
+});
+
+describe('ToolRegistry input validation', () => {
+  it('rejects invalid input before invoking the executor', async () => {
+    let calls = 0;
+    const registry = new ToolRegistry();
+    registry.register(
+      definition({type: 'object', properties: {location: {type: 'string'}}, required: ['location']}),
+      async () => {
+        calls += 1;
+        return 'executed';
+      }
+    );
+
+    const response = await registry.execute('lookup', {});
+    const typedResponse = await registry.execute('lookup', {location: 42});
+
+    expect(response.result).toMatch(/location/i);
+    expect(typedResponse.result).toContain('location');
+    expect(typedResponse.result).not.toContain('42');
+    expect(calls).toBe(0);
+  });
+
+  it('passes valid input through unchanged', async () => {
+    const input = {location: 'Berlin', extra: {requestedBy: 'caller'}};
+    let calls = 0;
+    const registry = new ToolRegistry();
+    registry.register(
+      definition({type: 'object', properties: {location: {type: 'string'}}, required: ['location']}),
+      async received => {
+        calls += 1;
+        expect(received).toEqual(input);
+        return 'ok';
+      }
+    );
+
+    await registry.execute('lookup', input);
+
+    expect(calls).toBe(1);
+  });
+
+  it('validates each resolved function schema', async () => {
+    let currentRequired = 'first';
+    const registry = new ToolRegistry();
+    registry.register(
+      () =>
+        definition({type: 'object', properties: {[currentRequired]: {type: 'string'}}, required: [currentRequired]}),
+      async () => 'executed'
+    );
+
+    const firstResponse = await registry.execute('lookup', {first: 'ok'});
+    currentRequired = 'second';
+    const secondResponse = await registry.execute('lookup', {first: 'ok'});
+
+    expect(firstResponse.result).toBe('executed');
+    expect(secondResponse.result).toMatch(/second/i);
+  });
+
+  it('preserves unknown tool errors', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('missing', {})).rejects.toThrow('Unknown tool: missing');
+  });
+});