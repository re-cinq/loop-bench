+import {jest} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../../types/ai.js';
+
+const requiredLocation = {
+  name: 'weather',
+  description: 'Looks up the weather',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string', enum: ['Berlin', 'Paris'], default: 'Paris'}},
+    required: ['location'],
+  },
+};
+
+describe('ToolRegistry input schema acceptance', () => {
+  it('rejects invalid input without exposing values and preserves valid input', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    const received: Record<string, unknown>[] = [];
+    const logLines: string[] = [];
+    const logSpy = jest.spyOn(console, 'log').mockImplementation((line: unknown) => logLines.push(String(line)));
+    registry.register(requiredLocation, async input => {
+      calls += 1;
+      received.push(input);
+      return 'forecast';
+    });
+
+    try {
+      const validInput = {location: 'Berlin', trace: {requestId: 'r-7'}};
+      const valid = await registry.execute('weather', validInput);
+      const missing = await registry.execute('weather', {});
+      const identifyingValue = 'person@example.test';
+      const mistyped = await registry.execute('weather', {location: 42, email: identifyingValue});
+      const outsideEnum = await registry.execute('weather', {location: 'Atlantis'});
+
+      expect({
+        valid,
+        received,
+        requiredRejected: /location.*required/i.test(missing.result),
+        mistypedRejected: /location.*string/i.test(mistyped.result),
+        enumRejected: /location.*enum/i.test(outsideEnum.result),
+        identifyingValueHidden:
+          !mistyped.result.includes(identifyingValue) && !logLines.join('\n').includes(identifyingValue),
+        calls,
+      }).toEqual({
+        valid: {result: 'forecast'},
+        received: [validInput],
+        requiredRejected: true,
+        mistypedRejected: true,
+        enumRejected: true,
+        identifyingValueHidden: true,
+        calls: 1,
+      });
+    } finally {
+      logSpy.mockRestore();
+    }
+  });
+
+  it('rejects an invalid schema when registering its tool', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {name: 'broken-weather', description: 'Broken schema', inputSchema: {type: 'not-a-json-schema-type'}},
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken-weather/i);
+    return expect(registry.execute('missing', {})).rejects.toThrow('Unknown tool: missing');
+  });
+
+  it('compiles a static schema at registration and reuses it for ten executions', async () => {
+    const registry = new ToolRegistry();
+    let schemaReads = 0;
+    let calls = 0;
+    registry.register(
+      {
+        name: 'static-weather',
+        description: 'Static schema',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          get required() {
+            schemaReads += 1;
+            return ['location'];
+          },
+        },
+      },
+      async () => {
+        calls += 1;
+        return 'forecast';
+      }
+    );
+    const readsAtRegistration = schemaReads;
+
+    for (let index = 0; index < 10; index += 1) {
+      await registry.execute('static-weather', {location: 'Berlin'});
+    }
+
+    expect(readsAtRegistration).toBeGreaterThan(0);
+    expect(schemaReads).toBe(readsAtRegistration);
+    expect(calls).toBe(10);
+  });
+
+  it('validates function sourced tools against the current schema', async () => {
+    const registry = new ToolRegistry();
+    let resolutions = 0;
+    let calls = 0;
+    registry.register(
+      () => {
+        resolutions += 1;
+        const field = resolutions === 1 ? 'first' : 'second';
+        return {
+          name: 'changing',
+          description: 'Changes schema per resolution',
+          inputSchema: {type: 'object', properties: {[field]: {type: 'string'}}, required: [field]},
+        };
+      },
+      async () => {
+        calls += 1;
+        return 'accepted';
+      }
+    );
+
+    const currentSchemaInput = await registry.execute('changing', {second: 'current'});
+    const staleSchemaInput = await registry.execute('changing', {first: 'stale'});
+
+    expect(currentSchemaInput).toEqual({result: 'accepted'});
+    expect(staleSchemaInput.result).toMatch(/second.*required/i);
+    expect(calls).toBe(1);
+  });
+
+  it('returns a rejected call to the provider so it can correct the input next round', async () => {
+    let round = 0;
+    let retryContent = '';
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        if (round++ === 0) {
+          yield {type: 'tool_use', toolCall: {id: 'weather-1', name: 'weather', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        const lastMessage = params.messages.at(-1);
+        if (lastMessage?.role === 'user' && Array.isArray(lastMessage.content)) {
+          retryContent = JSON.stringify(lastMessage.content);
+        }
+        yield {type: 'text', text: 'corrected'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(requiredLocation, async () => {
+      executorCalls += 1;
+      return 'forecast';
+    });
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), registry);
+
+    await expect(
+      orchestrator.processMessage({
+        sessionId: 'validation-retry',
+        userId: 'user-1',
+        entries: [{role: 'user', content: 'weather?', timestamp: '2026-01-01T00:00:00.000Z'}],
+      })
+    ).resolves.toBe('corrected');
+    expect(retryContent).toMatch(/location.*required/i);
+    expect(executorCalls).toBe(0);
+  });
+});