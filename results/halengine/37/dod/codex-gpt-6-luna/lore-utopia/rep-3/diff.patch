--- /dev/null
+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,65 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const definition = (inputSchema: Record<string, unknown>): ToolDefinition => ({
+  name: 'weather',
+  description: 'Gets the weather',
+  inputSchema,
+});
+
+describe('ToolRegistry input validation acceptance', () => {
+  it('rejects input that violates the schema before invoking the executor', async () => {
+    const registry = new ToolRegistry();
+    const calls: Record<string, unknown>[] = [];
+    const execute = async (input: Record<string, unknown>) => {
+      calls.push(input);
+      return JSON.stringify(input);
+    };
+    registry.register(
+      definition({type: 'object', properties: {location: {type: 'string'}}, required: ['location']}),
+      execute
+    );
+
+    const missing = await registry.execute('weather', {});
+    expect(missing.result).toMatch(/location.*required/i);
+    expect(calls).toHaveLength(0);
+
+    const wrongType = await registry.execute('weather', {location: 821});
+    expect(wrongType.result).toMatch(/location.*string/i);
+    expect(wrongType.result).not.toContain('821');
+    expect(calls).toHaveLength(0);
+
+    const validInput = {location: 'Berlin', extra: 'kept'};
+    await registry.execute('weather', validInput);
+    expect(calls).toHaveLength(1);
+    expect(calls[0]).toEqual(validInput);
+    expect(calls[0]).toBe(validInput);
+  });
+
+  it('validates each call against its current function-valued tool schema', async () => {
+    const registry = new ToolRegistry();
+    let requiredField = 'first';
+    let calls = 0;
+    const execute = async () => {
+      calls += 1;
+      return 'ok';
+    };
+    registry.register(
+      () => definition({type: 'object', properties: {[requiredField]: {type: 'string'}}, required: [requiredField]}),
+      execute
+    );
+
+    const first = await registry.execute('weather', {});
+    expect(first.result).toMatch(/first.*required/i);
+    requiredField = 'second';
+    const second = await registry.execute('weather', {});
+    expect(second.result).toMatch(/second.*required/i);
+    expect(calls).toBe(0);
+  });
+
+  it('rejects an uncompilable static schema at registration', () => {
+    const registry = new ToolRegistry();
+
+    expect(() => registry.register(definition({type: 'not-a-json-schema-type'}), async () => 'ok')).toThrow(/weather/i);
+  });
+});