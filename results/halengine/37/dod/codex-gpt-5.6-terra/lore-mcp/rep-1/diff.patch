@@ -0,0 +1,111 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const weatherDefinition = (inputSchema: Record<string, unknown>): ToolDefinition => ({
+  name: 'weather',
+  description: 'Returns the weather for a location.',
+  inputSchema,
+});
+
+const messageDescribes = (result: string, property: string, constraint: string): boolean =>
+  result.includes(property) && result.toLowerCase().includes(constraint);
+
+describe('ToolRegistry input-schema validation', () => {
+  it('rejects schema-invalid calls before invoking the executor while preserving accepted input', async () => {
+    const registry = new ToolRegistry();
+    const executedInputs: Record<string, unknown>[] = [];
+    const identifyingValue = 'member-12345';
+    const validInput = {location: 'Berlin', units: 'celsius', requestedBy: identifyingValue};
+
+    registry.register(
+      weatherDefinition({
+        type: 'object',
+        required: ['location'],
+        properties: {
+          location: {type: 'string'},
+          units: {enum: ['celsius', 'fahrenheit']},
+        },
+      }),
+      async input => {
+        executedInputs.push(input);
+        return 'forecast';
+      }
+    );
+
+    const missing = await registry.execute('weather', {});
+    const wrongType = await registry.execute('weather', {location: 42, requestedBy: identifyingValue});
+    const wrongEnum = await registry.execute('weather', {location: 'Berlin', units: 'kelvin'});
+    const accepted = await registry.execute('weather', validInput);
+
+    expect({
+      missingIsRequiredError: messageDescribes(missing.result, 'location', 'required'),
+      wrongTypeNamesPathAndType: messageDescribes(wrongType.result, 'location', 'string'),
+      wrongEnumNamesPropertyAndConstraint: messageDescribes(wrongEnum.result, 'units', 'allowed'),
+      rejectedResultsRedactInput: [missing, wrongType, wrongEnum].every(
+        response => !response.result.includes(identifyingValue)
+      ),
+      accepted,
+      executedInputs,
+    }).toEqual({
+      missingIsRequiredError: true,
+      wrongTypeNamesPathAndType: true,
+      wrongEnumNamesPropertyAndConstraint: true,
+      rejectedResultsRedactInput: true,
+      accepted: {result: 'forecast'},
+      executedInputs: [validInput],
+    });
+  });
+
+  it('rejects an invalid static schema when registering its named tool', () => {
+    const registry = new ToolRegistry();
+    let registrationResult = 'registered';
+
+    try {
+      registry.register(
+        {name: 'broken_weather', description: 'Cannot be compiled.', inputSchema: {type: 'not-a-json-schema-type'}},
+        async () => 'unreachable'
+      );
+    } catch (error) {
+      registrationResult = error instanceof Error ? error.message : String(error);
+    }
+
+    expect({
+      threw: registrationResult !== 'registered',
+      namesTool: registrationResult.includes('broken_weather'),
+    }).toEqual({
+      threw: true,
+      namesTool: true,
+    });
+  });
+
+  it('validates each function-defined tool call against its current schema', async () => {
+    const registry = new ToolRegistry();
+    const executedInputs: Record<string, unknown>[] = [];
+    let locationType = 'string';
+
+    registry.register(
+      () => weatherDefinition({type: 'object', properties: {location: {type: locationType}}}),
+      async input => {
+        executedInputs.push(input);
+        return 'forecast';
+      }
+    );
+
+    const initiallyValid = await registry.execute('weather', {location: 'Berlin'});
+    locationType = 'number';
+    const staleValue = await registry.execute('weather', {location: 'Berlin'});
+    const currentlyValid = await registry.execute('weather', {location: 42});
+
+    expect({
+      initiallyValid,
+      staleValueRejectsCurrentSchema: messageDescribes(staleValue.result, 'location', 'number'),
+      currentlyValid,
+      executedInputs,
+    }).toEqual({
+      initiallyValid: {result: 'forecast'},
+      staleValueRejectsCurrentSchema: true,
+      currentlyValid: {result: 'forecast'},
+      executedInputs: [{location: 'Berlin'}, {location: 42}],
+    });
+  });
+});