+import {ToolRegistry} from './registry.js';
+
+const locationDefinition = {
+  name: 'weather',
+  description: 'looks up weather',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}},
+    required: ['location'],
+  },
+};
+
+describe('ToolRegistry input validation', () => {
+  it('rejects missing required input before execution while passing valid unknown keys through unchanged', async () => {
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+    registry.register(locationDefinition, async input => {
+      received.push(input);
+      return 'forecast';
+    });
+
+    const rejection = await registry.execute('weather', {});
+    const acceptedInput = {location: 'Berlin', unit: 'celsius'};
+    const accepted = await registry.execute('weather', acceptedInput);
+
+    expect(rejection.result).toMatch(/location.*required|required.*location/i);
+    expect(received).toEqual([acceptedInput]);
+    expect(accepted).toEqual({result: 'forecast'});
+  });
+
+  it('returns a redacted type rejection instead of executing a malformed call', async () => {
+    const registry = new ToolRegistry();
+    let executions = 0;
+    registry.register(locationDefinition, async () => {
+      executions += 1;
+      return 'forecast';
+    });
+
+    const response = await registry.execute('weather', {location: 42});
+
+    expect(response.result).toMatch(/location/i);
+    expect(response.result).toMatch(/string/i);
+    expect(response.result).not.toContain('42');
+    expect(executions).toBe(0);
+  });
+
+  it('compiles static schemas during registration and keeps using that compiled schema', async () => {
+    const registry = new ToolRegistry();
+    const invalidDefinition = {
+      name: 'broken-weather',
+      description: 'has an invalid schema',
+      inputSchema: {type: 'not-a-json-schema-type'},
+    };
+    const staticSchema: Record<string, unknown> = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    let executions = 0;
+
+    expect(() => registry.register(invalidDefinition, async () => 'never')).toThrow(/broken-weather/i);
+
+    registry.register(
+      {name: 'static-weather', description: 'uses a static schema', inputSchema: staticSchema},
+      async () => {
+        executions += 1;
+        return 'forecast';
+      }
+    );
+    staticSchema.required = [];
+    const response = await registry.execute('static-weather', {});
+
+    expect(response.result).toMatch(/location.*required|required.*location/i);
+    expect(executions).toBe(0);
+  });
+
+  it('validates a function-defined tool against the schema resolved for each call', async () => {
+    const registry = new ToolRegistry();
+    let locationIsRequired = true;
+    let executions = 0;
+    registry.register(
+      () => ({
+        name: 'dynamic-weather',
+        description: 'changes with configuration',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: locationIsRequired ? ['location'] : [],
+        },
+      }),
+      async () => {
+        executions += 1;
+        return 'forecast';
+      }
+    );
+
+    const rejected = await registry.execute('dynamic-weather', {});
+    locationIsRequired = false;
+    const accepted = await registry.execute('dynamic-weather', {});
+
+    expect(rejected.result).toMatch(/location.*required|required.*location/i);
+    expect(accepted).toEqual({result: 'forecast'});
+    expect(executions).toBe(1);
+  });
+});