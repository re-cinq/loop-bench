+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const session = (): ChatSession => ({
+  sessionId: 'session-1',
+  userId: 'user-1',
+  entries: [{role: 'user', content: 'what is the weather?', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+describe('tool-loop input-schema rejection', () => {
+  it('returns a rejected call to the provider so it can retry with a corrected tool request', async () => {
+    const requests: SendMessageParams[] = [];
+    let executorCalls = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        requests.push(params);
+        if (requests.length === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'call-1', name: 'weather', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        yield {type: 'text', text: 'Weather for Berlin'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'weather',
+        description: 'looks up weather',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async () => {
+        executorCalls++;
+        return 'executor should not run';
+      }
+    );
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), registry);
+    const result = await orchestrator.processMessage(session());
+    const retryResult = requests[1]?.messages.at(-1);
+
+    expect({
+      result,
+      executorCalls,
+      providerSawRequiredLocationFailure:
+        retryResult?.role === 'user' &&
+        Array.isArray(retryResult.content) &&
+        /location/i.test(retryResult.content[0]?.content ?? '') &&
+        /required/i.test(retryResult.content[0]?.content ?? ''),
+    }).toEqual({result: 'Weather for Berlin', executorCalls: 0, providerSawRequiredLocationFailure: true});
+  });
+});
