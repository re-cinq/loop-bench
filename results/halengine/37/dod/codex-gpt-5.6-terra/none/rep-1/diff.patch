+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+
+const weatherDefinition = {
+  name: 'weather',
+  description: 'looks up weather',
+  inputSchema: {
+    type: 'object',
+    properties: {
+      location: {type: 'string'},
+      units: {enum: ['metric']},
+    },
+    required: ['location'],
+  },
+};
+
+const recordedLogger = (lines: string[]): Logger => {
+  const record = (category: string, message: string, fields?: Record<string, unknown>): void => {
+    lines.push(JSON.stringify({category, message, fields}));
+  };
+
+  return {debug: record, info: record, warn: record, error: record};
+};
+
+describe('ToolRegistry input-schema validation', () => {
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('returns redacted required, type, and enum failures before an executor receives malformed input', async () => {
+    const registry = new ToolRegistry();
+    const lines: string[] = [];
+    const identifyingValue = 'person@example.test';
+    let executorCalls = 0;
+    setLogger(recordedLogger(lines));
+    registry.register(weatherDefinition, async () => {
+      executorCalls++;
+      return 'executed';
+    });
+
+    const [missing, wrongType, wrongEnum] = await Promise.all([
+      registry.execute('weather', {}),
+      registry.execute('weather', {location: identifyingValue}),
+      registry.execute('weather', {location: 'Berlin', units: 'imperial'}),
+    ]);
+    const transcript = [missing.result, wrongType.result, wrongEnum.result, ...lines].join('\n');
+
+    expect({
+      executorCalls,
+      missingNamesRequired: /location/i.test(missing.result) && /required/i.test(missing.result),
+      wrongTypeNamesPathAndExpectedType: /location/i.test(wrongType.result) && /string/i.test(wrongType.result),
+      wrongEnumNamesPathAndConstraint: /units/i.test(wrongEnum.result) && /enum/i.test(wrongEnum.result),
+      identifyingValueIsRedacted: !transcript.includes(identifyingValue),
+    }).toEqual({
+      executorCalls: 0,
+      missingNamesRequired: true,
+      wrongTypeNamesPathAndExpectedType: true,
+      wrongEnumNamesPathAndConstraint: true,
+      identifyingValueIsRedacted: true,
+    });
+  });
+
+  it('passes schema-valid unknown properties through unchanged while retaining unknown-tool errors and compiling static schemas only at registration', async () => {
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+    registry.register(weatherDefinition, async input => {
+      received.push(input);
+      return 'ok';
+    });
+    const validInput = {location: 'Berlin', providerHint: 'cached'};
+    const validResult = await registry.execute('weather', validInput);
+    const unknownToolError = await registry.execute('missing', {}).then(
+      () => 'resolved',
+      (error: Error) => error.message
+    );
+    const brokenRegistration = (() => {
+      try {
+        registry.register(
+          {name: 'broken-weather', description: 'has an invalid schema', inputSchema: {type: 'not-a-json-schema-type'}},
+          async () => 'unreachable'
+        );
+        return 'registered';
+      } catch (error) {
+        return error instanceof Error ? error.message : String(error);
+      }
+    })();
+    let staticSchemaTypeReads = 0;
+    const staticSchema = {
+      get type(): string {
+        staticSchemaTypeReads++;
+        return 'object';
+      },
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    const compileOnceRegistry = new ToolRegistry();
+    let staticExecutorCalls = 0;
+    compileOnceRegistry.register(
+      {name: 'compile-once', description: 'uses a static schema', inputSchema: staticSchema},
+      async () => {
+        staticExecutorCalls++;
+        return 'ok';
+      }
+    );
+    const staticSchemaReadsAtRegistration = staticSchemaTypeReads;
+    await Promise.all(
+      Array.from({length: 10}, () => compileOnceRegistry.execute('compile-once', {location: 'Berlin'}))
+    );
+
+    expect({
+      validResult,
+      received,
+      unknownToolError,
+      brokenSchemaNamesTool: /broken-weather/i.test(brokenRegistration),
+      staticSchemaReadsAfterExecutions: staticSchemaTypeReads,
+      staticSchemaReadsAtRegistration,
+      staticExecutorCalls,
+    }).toEqual({
+      validResult: {result: 'ok'},
+      received: [validInput],
+      unknownToolError: 'Unknown tool: missing',
+      brokenSchemaNamesTool: true,
+      staticSchemaReadsAfterExecutions: staticSchemaReadsAtRegistration,
+      staticSchemaReadsAtRegistration: expect.any(Number),
+      staticExecutorCalls: 10,
+    });
+  });
+
+  it('uses the current function-supplied schema for every call instead of a stale schema', async () => {
+    const registry = new ToolRegistry();
+    let expectedType = 'string';
+    let executorCalls = 0;
+    registry.register(
+      () => ({
+        name: 'changing-weather',
+        description: 'changes with tenant configuration',
+        inputSchema: {type: 'object', properties: {location: {type: expectedType}}, required: ['location']},
+      }),
+      async () => {
+        executorCalls++;
+        return 'executed';
+      }
+    );
+
+    const first = await registry.execute('changing-weather', {location: 'Berlin'});
+    expectedType = 'number';
+    const second = await registry.execute('changing-weather', {location: 'Berlin'});
+
+    expect({
+      first,
+      secondNamesChangedType: /location/i.test(second.result) && /number/i.test(second.result),
+      executorCalls,
+    }).toEqual({first: {result: 'executed'}, secondNamesChangedType: true, executorCalls: 1});
+  });
+});