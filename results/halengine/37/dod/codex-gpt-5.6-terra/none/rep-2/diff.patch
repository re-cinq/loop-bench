+import {setLogger} from '../../shared/logger.js';
+import type {ToolDefinition} from '../../types/ai.js';
+import {ToolRegistry} from './registry.js';
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#1
+const weatherDefinition = (): ToolDefinition => ({
+  name: 'weather',
+  description: 'looks up weather',
+  inputSchema: {
+    type: 'object',
+    properties: {
+      location: {type: 'string'},
+      units: {type: 'string', enum: ['celsius', 'fahrenheit']},
+    },
+    required: ['location'],
+  },
+});
+
+describe('ToolRegistry input-schema validation', () => {
+  it('rejects required, typed, and enum-invalid input before execution without exposing input values', async () => {
+    const registry = new ToolRegistry();
+    let executions = 0;
+    const logLines: string[] = [];
+    const identifyingValue = 'customer-ssn-123-45-6789';
+    setLogger({
+      debug: (_category, message, fields) => logLines.push(JSON.stringify({message, fields})),
+      info: (_category, message, fields) => logLines.push(JSON.stringify({message, fields})),
+      warn: (_category, message, fields) => logLines.push(JSON.stringify({message, fields})),
+      error: (_category, message, fields) => logLines.push(JSON.stringify({message, fields})),
+    });
+    registry.register(weatherDefinition(), async () => {
+      executions++;
+      return 'executor ran';
+    });
+
+    try {
+      const missing = await registry.execute('weather', {customer: identifyingValue});
+      const wrongType = await registry.execute('weather', {location: 42, customer: identifyingValue});
+      const wrongEnum = await registry.execute('weather', {
+        location: 'Berlin',
+        units: 'kelvin',
+        customer: identifyingValue,
+      });
+
+      expect(missing.result).toMatch(/location.*required|required.*location/i);
+      expect(wrongType.result).toMatch(/location.*string|string.*location/i);
+      expect(wrongEnum.result).toMatch(/units.*enum|enum.*units/i);
+      expect(executions).toBe(0);
+      expect([missing.result, wrongType.result, wrongEnum.result, ...logLines].join('\n')).not.toContain(
+        identifyingValue
+      );
+    } finally {
+      setLogger();
+    }
+  });
+
+  it('passes schema-valid input, including unknown keys, to the executor exactly once without rewriting it', async () => {
+    const registry = new ToolRegistry();
+    const input = {location: 'Berlin', units: 'celsius', requestTag: 'keep-me'};
+    let received: Record<string, unknown> | undefined;
+    let executions = 0;
+    registry.register(weatherDefinition(), async toolInput => {
+      executions++;
+      received = toolInput;
+      return 'forecast';
+    });
+
+    const response = await registry.execute('weather', input);
+    expect(response).toEqual({result: 'forecast'});
+    expect(received).toEqual(input);
+    expect(executions).toBe(1);
+
+    const malformedResponse = await registry.execute('weather', {location: 7, requestTag: 'do-not-coerce'});
+
+    expect(malformedResponse.result).toMatch(/location.*string|string.*location/i);
+    expect(executions).toBe(1);
+  });
+
+  it('compiles static schemas at registration, retains that compiled schema, and preserves unknown-tool errors', async () => {
+    const registry = new ToolRegistry();
+    const definition = weatherDefinition();
+    let executions = 0;
+    registry.register(definition, async () => {
+      executions++;
+      return 'executor ran';
+    });
+    definition.inputSchema = {type: 'object', required: ['postalCode']};
+
+    const responses = await Promise.all(Array.from({length: 10}, () => registry.execute('weather', {})));
+
+    expect(responses).toEqual(
+      Array.from({length: 10}, () => ({result: expect.stringMatching(/location.*required|required.*location/i)}))
+    );
+    expect(executions).toBe(0);
+    expect(() =>
+      registry.register(
+        {name: 'broken-tool', description: 'has a broken schema', inputSchema: {type: 'not-a-json-schema-type'}},
+        async () => 'never runs'
+      )
+    ).toThrow(/broken-tool/);
+    await expect(registry.execute('missing-tool', {})).rejects.toThrow('Unknown tool: missing-tool');
+  });
+
+  it('resolves function-valued definitions for each call and validates the schema current for that call', async () => {
+    const registry = new ToolRegistry();
+    let resolution = 0;
+    let executions = 0;
+    registry.register(
+      () => {
+        resolution++;
+        return resolution === 1
+          ? weatherDefinition()
+          : {
+              name: 'weather',
+              description: 'now needs a postal code',
+              inputSchema: {
+                type: 'object',
+                properties: {postalCode: {type: 'number'}},
+                required: ['postalCode'],
+              },
+            };
+      },
+      async () => {
+        executions++;
+        return 'executor ran';
+      }
+    );
+
+    const response = await registry.execute('weather', {location: 'Berlin'});
+
+    expect(response.result).toMatch(/postalCode.*required|required.*postalCode/i);
+    expect(executions).toBe(0);
+  });
+});