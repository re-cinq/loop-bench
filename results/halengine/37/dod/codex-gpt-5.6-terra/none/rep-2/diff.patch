+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#5
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+class CorrectingProvider implements AIProvider {
+  readonly requests: SendMessageParams[] = [];
+
+  async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    this.requests.push(params);
+    if (this.requests.length === 1) {
+      yield {type: 'tool_use', toolCall: {id: 'call-1', name: 'weather', input: {}}};
+      yield {type: 'stop', stopReason: 'tool_use'};
+      return;
+    }
+
+    yield {type: 'text', text: 'corrected forecast'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  }
+
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  }
+}
+
+const session: ChatSession = {
+  sessionId: 'session-1',
+  userId: 'user-1',
+  entries: [{role: 'user', content: 'weather please', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+describe('tool input validation through the chat loop', () => {
+  it('returns a rejected call to the provider so its corrected retry completes instead of rejecting the conversation', async () => {
+    const registry = new ToolRegistry();
+    let executions = 0;
+    registry.register(
+      {
+        name: 'weather',
+        description: 'looks up weather',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async () => {
+        executions++;
+        return 'executor ran';
+      }
+    );
+    const provider = new CorrectingProvider();
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+
+    await expect(orchestrator.processMessage({...session, entries: [...session.entries]})).resolves.toBe(
+      'corrected forecast'
+    );
+
+    expect(executions).toBe(0);
+    expect(provider.requests[1]?.messages).toContainEqual({
+      role: 'user',
+      content: [
+        {
+          type: 'tool_result',
+          toolUseId: 'call-1',
+          content: expect.stringMatching(/location.*required|required.*location/i),
+        },
+      ],
+    });
+  });
+});
