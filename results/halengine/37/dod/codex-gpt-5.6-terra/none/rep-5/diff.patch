+import {ToolRegistry} from './registry.js';
+
+const weatherDefinition = {
+  name: 'weather',
+  description: 'gets weather',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}},
+    required: ['location'],
+  },
+};
+
+describe('ToolRegistry input-schema validation', () => {
+  it('returns a required-field rejection before invoking the executor and retains a static compilation', async () => {
+    const registry = new ToolRegistry();
+    const calls: Record<string, unknown>[] = [];
+    const inputSchema = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    registry.register({...weatherDefinition, inputSchema}, async input => {
+      calls.push(input);
+      return 'executor ran';
+    });
+
+    const rejected = await registry.execute('weather', {});
+    inputSchema.properties.location.type = 'not-a-json-schema-type';
+    const accepted = await Promise.all(
+      Array.from({length: 10}, () => registry.execute('weather', {location: 'Berlin'}))
+    );
+
+    expect({rejected, accepted, calls}).toEqual({
+      rejected: {result: expect.stringMatching(/location[\s\S]*required/i)},
+      accepted: Array.from({length: 10}, () => ({result: 'executor ran'})),
+      calls: Array.from({length: 10}, () => ({location: 'Berlin'})),
+    });
+  });
+
+  it('rejects a wrong-typed value without exposing it and forwards valid extra keys unchanged once', async () => {
+    const registry = new ToolRegistry();
+    const calls: Record<string, unknown>[] = [];
+    const identifyingValue = 'person@example.test';
+    registry.register(weatherDefinition, async input => {
+      calls.push(input);
+      return 'forecast';
+    });
+
+    const rejected = await registry.execute('weather', {location: 42, contact: identifyingValue});
+    const validInput = {location: 'Berlin', units: 'metric'};
+    const accepted = await registry.execute('weather', validInput);
+
+    expect({rejected, accepted, calls, rejectionExposesValue: rejected.result.includes(identifyingValue)}).toEqual({
+      rejected: {result: expect.stringMatching(/location[\s\S]*string/i)},
+      accepted: {result: 'forecast'},
+      calls: [validInput],
+      rejectionExposesValue: false,
+    });
+  });
+
+  it('uses the schema currently returned by a definition source on every execution', async () => {
+    const registry = new ToolRegistry();
+    const calls: Record<string, unknown>[] = [];
+    const schemas = [
+      {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      {type: 'object', properties: {location: {type: 'number'}}, required: ['location']},
+    ];
+    let resolutions = 0;
+    registry.register(
+      () => ({name: 'changing-weather', description: 'gets weather', inputSchema: schemas[resolutions++]}),
+      async input => {
+        calls.push(input);
+        return 'forecast';
+      }
+    );
+
+    const first = await registry.execute('changing-weather', {location: 'Berlin'});
+    const second = await registry.execute('changing-weather', {location: 'Paris'});
+
+    expect({first, second, calls}).toEqual({
+      first: {result: 'forecast'},
+      second: {result: expect.stringMatching(/location[\s\S]*number/i)},
+      calls: [{location: 'Berlin'}],
+    });
+  });
+
+  it('rejects an uncompilable static schema at registration time and names its tool', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken-weather',
+          description: 'gets weather',
+          inputSchema: {type: 'not-a-json-schema-type'},
+        },
+        async () => 'forecast'
+      )
+    ).toThrow(/broken-weather/);
+  });
+});