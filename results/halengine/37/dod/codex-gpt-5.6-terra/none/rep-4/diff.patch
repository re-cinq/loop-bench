+import {setLogger} from '../../shared/logger.js';
+import {ToolRegistry} from './registry.js';
+
+const weatherSchema = {
+  type: 'object',
+  properties: {
+    location: {type: 'string'},
+    units: {type: 'string', enum: ['celsius', 'fahrenheit']},
+  },
+  required: ['location'],
+};
+
+const weatherDefinition = (inputSchema: Record<string, unknown>) => ({
+  name: 'weather',
+  description: 'Looks up weather.',
+  inputSchema,
+});
+
+describe('ToolRegistry input-schema validation', () => {
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('rejects schema-invalid input before the executor while preserving valid unknown fields', async () => {
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+    const logLines: string[] = [];
+    const identifyingValue = 'customer-2849@example.test';
+    setLogger({
+      debug: () => undefined,
+      info: (category, message, fields) => void logLines.push(JSON.stringify([category, message, fields])),
+      warn: () => undefined,
+      error: () => undefined,
+    });
+    registry.register(weatherDefinition(weatherSchema), async input => {
+      received.push(input);
+      return `executed for ${String(input.customer)}`;
+    });
+
+    const validInput = {location: 'Berlin', customer: identifyingValue};
+    const validResponse = await registry.execute('weather', validInput);
+    const missingResponse = await registry.execute('weather', {});
+    const typedResponse = await registry.execute('weather', {location: 7, customer: identifyingValue});
+    const enumResponse = await registry.execute('weather', {location: 'Berlin', units: 'kelvin'});
+
+    expect({validResponse, received}).toEqual({
+      validResponse: {result: `executed for ${identifyingValue}`},
+      received: [validInput],
+    });
+    expect({
+      missing: missingResponse.result,
+      typed: typedResponse.result,
+      enum: enumResponse.result,
+      calls: received.length,
+      identifiesInput: [missingResponse.result, typedResponse.result, enumResponse.result, ...logLines].some(line =>
+        line.includes(identifyingValue)
+      ),
+    }).toEqual({
+      missing: expect.stringMatching(/location.*required|required.*location/i),
+      typed: expect.stringMatching(/location.*string|string.*location/i),
+      enum: expect.stringMatching(/units.*enum|enum.*units/i),
+      calls: 1,
+      identifiesInput: false,
+    });
+  });
+
+  it('rejects an invalid static schema when the named tool is registered', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        weatherDefinition({type: 'object', properties: {location: {type: 'not-a-json-schema-type'}}}),
+        async () => 'ok'
+      )
+    ).toThrow(/weather/i);
+  });
+
+  it('keeps a static schema compiled at registration across executions', async () => {
+    const registry = new ToolRegistry();
+    const schema = {type: 'object', properties: {location: {type: 'string'}}, required: ['location']};
+    let calls = 0;
+    registry.register(weatherDefinition(schema), async () => {
+      calls++;
+      return 'executed';
+    });
+    schema.properties.location.type = 'number';
+
+    const responses = await Promise.all(Array.from({length: 10}, () => registry.execute('weather', {location: 7})));
+
+    expect({results: responses.map(response => response.result), calls}).toEqual({
+      results: Array.from({length: 10}, () => expect.stringMatching(/location.*string|string.*location/i)),
+      calls: 0,
+    });
+  });
+
+  it('uses the schema resolved for each dynamic tool invocation', async () => {
+    const registry = new ToolRegistry();
+    let resolution = 0;
+    let calls = 0;
+    const schemas = [
+      weatherSchema,
+      {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      {type: 'object', properties: {location: {type: 'number'}}, required: ['location']},
+    ];
+    registry.register(
+      () => weatherDefinition(schemas[resolution++] ?? schemas[2]),
+      async () => {
+        calls++;
+        return 'executed';
+      }
+    );
+
+    const stringViolation = await registry.execute('weather', {location: 7});
+    const numberViolation = await registry.execute('weather', {location: 'Berlin'});
+
+    expect({
+      stringViolation: stringViolation.result,
+      numberViolation: numberViolation.result,
+      calls,
+    }).toEqual({
+      stringViolation: expect.stringMatching(/location.*string|string.*location/i),
+      numberViolation: expect.stringMatching(/location.*number|number.*location/i),
+      calls: 0,
+    });
+  });
+});