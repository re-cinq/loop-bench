+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {ToolRegistry} from './registry.js';
+import type {AIProvider, MessageChunk, SendMessageParams, ToolDefinition} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+
+const LOCATION_SCHEMA = {
+  type: 'object',
+  properties: {location: {type: 'string'}},
+  required: ['location'],
+};
+
+const SESSION: ChatSession = {
+  sessionId: 'session-1',
+  userId: 'user-1',
+  entries: [{role: 'user', content: 'weather please', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+describe('ToolRegistry input-schema validation', () => {
+  it('returns a readable required-field rejection without executing or exposing input values', async () => {
+    const registry = new ToolRegistry();
+    let executions = 0;
+    registry.register({name: 'weather', description: 'gets weather', inputSchema: LOCATION_SCHEMA}, async () => {
+      executions++;
+      return 'should not execute';
+    });
+
+    const response = await registry.execute('weather', {email: 'person@example.com'});
+
+    expect(response.result).toMatch(/location.*required|required.*location/i);
+    expect(response.result).not.toContain('person@example.com');
+    expect(executions).toBe(0);
+  });
+
+  it('passes schema-valid input, including unlisted properties, unchanged exactly once while rejecting a later malformed call', async () => {
+    const registry = new ToolRegistry();
+    const input = {location: 'Berlin', units: 'metric'};
+    const received: Record<string, unknown>[] = [];
+    registry.register({name: 'weather', description: 'gets weather', inputSchema: LOCATION_SCHEMA}, async toolInput => {
+      received.push(toolInput);
+      return 'forecast';
+    });
+
+    const response = await registry.execute('weather', input);
+    const rejection = await registry.execute('weather', {});
+
+    expect(response).toEqual({result: 'forecast'});
+    expect(received).toEqual([{location: 'Berlin', units: 'metric'}]);
+    expect(rejection.result).toMatch(/location.*required|required.*location/i);
+  });
+
+  it('rejects a wrong type with its property path and expected type without exposing the value', async () => {
+    const registry = new ToolRegistry();
+    let executions = 0;
+    registry.register({name: 'weather', description: 'gets weather', inputSchema: LOCATION_SCHEMA}, async () => {
+      executions++;
+      return 'should not execute';
+    });
+
+    const response = await registry.execute('weather', {location: 42, account: 'person@example.com'});
+
+    expect(response.result).toMatch(/location/);
+    expect(response.result).toMatch(/string/);
+    expect(response.result).not.toContain('42');
+    expect(response.result).not.toContain('person@example.com');
+    expect(executions).toBe(0);
+  });
+
+  it('keeps unknown-tool errors while compiling static schemas once at registration and using the schema returned for each dynamic call', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('missing-weather', {})).rejects.toThrow('Unknown tool: missing-weather');
+
+    expect(() =>
+      registry.register(
+        {name: 'broken-weather', description: 'gets weather', inputSchema: {type: 'not-a-json-schema-type'}},
+        async () => 'never'
+      )
+    ).toThrow(/broken-weather/);
+
+    let staticSchemaReads = 0;
+    const staticSchema = {
+      get type(): string {
+        staticSchemaReads++;
+        return 'object';
+      },
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    let staticExecutions = 0;
+    registry.register({name: 'static-weather', description: 'gets weather', inputSchema: staticSchema}, async () => {
+      staticExecutions++;
+      return 'forecast';
+    });
+    const readsAtRegistration = staticSchemaReads;
+    await Promise.all(Array.from({length: 10}, () => registry.execute('static-weather', {location: 'Berlin'})));
+
+    expect(readsAtRegistration).toBeGreaterThan(0);
+    expect(staticSchemaReads).toBe(readsAtRegistration);
+    expect(staticExecutions).toBe(10);
+
+    let definitionCalls = 0;
+    const dynamicDefinition = (): ToolDefinition => {
+      definitionCalls++;
+      const required = definitionCalls === 2 ? 'location' : 'postalCode';
+      return {
+        name: 'changing-weather',
+        description: 'gets weather',
+        inputSchema: {type: 'object', properties: {[required]: {type: 'string'}}, required: [required]},
+      };
+    };
+    registry.register(dynamicDefinition, async () => 'should not execute');
+
+    const first = await registry.execute('changing-weather', {});
+    const second = await registry.execute('changing-weather', {});
+
+    expect(first.result).toMatch(/location.*required|required.*location/i);
+    expect(second.result).toMatch(/postalCode.*required|required.*postalCode/i);
+  });
+
+  it('returns the rejection to the provider so a corrected retry completes the tool loop', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {name: 'weather', description: 'gets weather', inputSchema: LOCATION_SCHEMA},
+      async input => `forecast for ${input.location}`
+    );
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        if (round++ === 0) {
+          yield {type: 'tool_use', toolCall: {id: 'bad-call', name: 'weather', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+
+        if (round === 2) {
+          const latest = params.messages.at(-1);
+          expect(latest).toEqual({
+            role: 'user',
+            content: [
+              {
+                type: 'tool_result',
+                toolUseId: 'bad-call',
+                content: expect.stringMatching(/location.*required|required.*location/i),
+              },
+            ],
+          });
+          yield {type: 'tool_use', toolCall: {id: 'good-call', name: 'weather', input: {location: 'Berlin'}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+
+        yield {type: 'text', text: 'The Berlin forecast is ready.'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'You are helpful.'}), registry);
+
+    await expect(orchestrator.processMessage(SESSION)).resolves.toBe('The Berlin forecast is ready.');
+  });
+});