+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const session: ChatSession = {
+  sessionId: 'validation-session',
+  userId: 'validation-user',
+  entries: [{role: 'user', content: 'What is the weather?', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+describe('tool input validation in the orchestration loop', () => {
+  // specs/hal-engine-tool-input-validation/spec.md#0006
+  it('returns a schema rejection to the provider so its corrected retry resolves', async () => {
+    let round = 0;
+    let retryTranscript = '';
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        round++;
+        if (round === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'weather-1', name: 'weather', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        if (round === 2) {
+          retryTranscript = JSON.stringify(params.messages);
+          yield {type: 'tool_use', toolCall: {id: 'weather-2', name: 'weather', input: {location: 'Berlin'}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        yield {type: 'text', text: 'Sunny in Berlin'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Gets weather',
+        inputSchema: {type: 'object', required: ['location'], properties: {location: {type: 'string'}}},
+      },
+      async input => `Sunny in ${input.location}`
+    );
+
+    const result = await createChatOrchestrator(
+      provider,
+      new PromptBuilder({identity: 'You are a weather assistant.'}),
+      registry
+    ).processMessage(session);
+
+    expect({result, rejectionReachedProvider: /location/.test(retryTranscript)}).toEqual({
+      result: 'Sunny in Berlin',
+      rejectionReachedProvider: true,
+    });
+  });
+});
