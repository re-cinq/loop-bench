+import {setLogger} from '../../shared/logger.js';
+import {ToolRegistry} from './registry.js';
+
+afterEach(() => setLogger(undefined));
+
+describe('ToolRegistry input-schema validation', () => {
+  // specs/hal-engine-tool-input-validation/spec.md#0002
+  it('rejects invalid input safely before invoking the executor while preserving accepted input', async () => {
+    const logs: string[] = [];
+    const capture = (_category: string, message: string, fields?: Record<string, unknown>): void =>
+      void logs.push(JSON.stringify({message, fields}));
+    setLogger({debug: capture, info: capture, warn: capture, error: capture});
+
+    const registry = new ToolRegistry();
+    let calls = 0;
+    let received: Record<string, unknown> | undefined;
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Gets weather',
+        inputSchema: {type: 'object', required: ['location'], properties: {location: {type: 'string'}}},
+      },
+      async input => {
+        calls++;
+        received = input;
+        return 'sunny';
+      }
+    );
+
+    const missing = await registry.execute('weather', {});
+    const wrongType = await registry.execute('weather', {location: 424242});
+    await registry.execute('weather', {location: 'Berlin', extra: 'preserved'});
+
+    await expect(registry.execute('invented', {})).rejects.toThrow('Unknown tool: invented');
+
+    expect({
+      missingNamesRequiredLocation: /required/.test(missing.result) && /location/.test(missing.result),
+      wrongTypeNamesPathAndExpectedType: /location/.test(wrongType.result) && /string/.test(wrongType.result),
+      rejectedValueIsRedacted: ![wrongType.result, ...logs].join('\n').includes('424242'),
+      executorCalls: calls,
+      received,
+    }).toEqual({
+      missingNamesRequiredLocation: true,
+      wrongTypeNamesPathAndExpectedType: true,
+      rejectedValueIsRedacted: true,
+      executorCalls: 1,
+      received: {location: 'Berlin', extra: 'preserved'},
+    });
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#0005
+  it('compiles static schemas at registration and resolves function schemas per call', async () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {name: 'broken-schema', description: 'Broken schema', inputSchema: {type: 'not-a-schema-type'}},
+        async () => 'never called'
+      )
+    ).toThrow(/broken-schema/);
+
+    let version = 'first';
+    registry.register(
+      () => ({
+        name: 'versioned',
+        description: 'A definition that changes by call',
+        inputSchema:
+          version === 'first'
+            ? {type: 'object', required: ['alpha'], properties: {alpha: {type: 'string'}}}
+            : {type: 'object', required: ['beta'], properties: {beta: {type: 'string'}}},
+      }),
+      async () => 'ok'
+    );
+
+    const first = await registry.execute('versioned', {beta: 'value'});
+    version = 'second';
+    const second = await registry.execute('versioned', {alpha: 'value'});
+
+    expect({firstRejectsAlpha: /alpha/.test(first.result), secondRejectsBeta: /beta/.test(second.result)}).toEqual({
+      firstRejectsAlpha: true,
+      secondRejectsBeta: true,
+    });
+  });
+});