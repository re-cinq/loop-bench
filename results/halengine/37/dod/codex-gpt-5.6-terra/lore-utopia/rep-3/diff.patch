+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const WEATHER_TOOL: ToolDefinition = {
+  name: 'weather',
+  description: 'Looks up weather for a location.',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}, units: {type: 'string', enum: ['celsius', 'fahrenheit']}},
+    required: ['location'],
+  },
+};
+
+describe('ToolRegistry input-schema validation', () => {
+  it('rejects malformed input before the executor while preserving unknown-tool throws', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(WEATHER_TOOL, async () => {
+      calls += 1;
+      return 'forecast';
+    });
+
+    const results = await Promise.allSettled([
+      registry.execute('weather', {}),
+      registry.execute('weather', {location: 918273645}),
+      registry.execute('missing', {}),
+    ]);
+
+    expect({calls, results}).toEqual({
+      calls: 0,
+      results: [
+        {status: 'fulfilled', value: {result: expect.stringMatching(/location.*required|required.*location/i)}},
+        {
+          status: 'fulfilled',
+          value: {result: expect.stringMatching(/^(?!.*918273645).*?(location.*string|string.*location)/i)},
+        },
+        {status: 'rejected', reason: expect.objectContaining({message: 'Unknown tool: missing'})},
+      ],
+    });
+  });
+
+  it('passes schema-valid extra properties unchanged and rejects an invalid enum value', async () => {
+    const registry = new ToolRegistry();
+    let received: Record<string, unknown> | undefined;
+    let calls = 0;
+    registry.register(WEATHER_TOOL, async input => {
+      calls += 1;
+      received = input;
+      return 'forecast';
+    });
+    const input = {location: 'Berlin', units: 'celsius'};
+
+    const [response, rejected] = await Promise.all([
+      registry.execute('weather', input),
+      registry.execute('weather', {location: 'Berlin', units: 'kelvin'}),
+    ]);
+
+    expect({calls, received, response, rejected}).toEqual({
+      calls: 1,
+      received: input,
+      response: {result: 'forecast'},
+      rejected: {result: expect.stringMatching(/units.*enum|enum.*units/i)},
+    });
+  });
+
+  it('rejects an uncompilable schema while registering the named tool', () => {
+    const registry = new ToolRegistry();
+    const invalidDefinition: ToolDefinition = {
+      ...WEATHER_TOOL,
+      name: 'broken-weather',
+      inputSchema: {type: 'not-a-json-schema-type'},
+    };
+
+    expect(() => registry.register(invalidDefinition, async () => 'forecast')).toThrow(/broken-weather/);
+  });
+
+  it('uses the schema resolved for each function-valued definition call', async () => {
+    const registry = new ToolRegistry();
+    let resolutions = 0;
+    let calls = 0;
+    registry.register(
+      () => {
+        resolutions += 1;
+        return {
+          ...WEATHER_TOOL,
+          inputSchema:
+            resolutions === 1
+              ? WEATHER_TOOL.inputSchema
+              : {type: 'object', properties: {location: {type: 'number'}}, required: ['location']},
+        };
+      },
+      async () => {
+        calls += 1;
+        return 'forecast';
+      }
+    );
+
+    const response = await registry.execute('weather', {location: 'Berlin'});
+
+    expect({calls, response}).toEqual({
+      calls: 0,
+      response: {result: expect.stringMatching(/location.*number|number.*location/i)},
+    });
+  });
+});