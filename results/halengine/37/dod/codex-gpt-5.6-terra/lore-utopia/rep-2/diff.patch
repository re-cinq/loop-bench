@@ -0,0 +1,102 @@
+import {ToolRegistry} from './registry.js';
+
+const locationSchema = {
+  type: 'object',
+  properties: {location: {type: 'string'}},
+  required: ['location'],
+};
+
+describe('ToolRegistry input-schema validation', () => {
+  it('validates malformed input safely while preserving valid extra properties', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    let received: Record<string, unknown> | undefined;
+    const identifyingValue = 'person@example.test';
+    const input = {location: 'Berlin', units: 'metric'};
+    registry.register({name: 'weather', description: 'gets weather', inputSchema: locationSchema}, async toolInput => {
+      calls++;
+      received = toolInput;
+      return 'executor ran';
+    });
+
+    const missing = await registry.execute('weather', {});
+    const wrongType = await registry.execute('weather', {location: 42, contact: identifyingValue});
+    const valid = await registry.execute('weather', input);
+
+    expect({
+      missing: missing.result,
+      wrongType: wrongType.result,
+      wrongTypeLeaksInput: wrongType.result.includes(identifyingValue),
+      valid,
+      received,
+      calls,
+    }).toEqual({
+      missing: expect.stringMatching(/location.*required|required.*location/i),
+      wrongType: expect.stringMatching(/location.*string|string.*location/i),
+      wrongTypeLeaksInput: false,
+      valid: {result: 'executor ran'},
+      received: input,
+      calls: 1,
+    });
+  });
+
+  it('rejects an invalid static schema when registering the named tool', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {name: 'weather', description: 'gets weather', inputSchema: {type: 'not-a-json-schema-type'}},
+        async () => 'forecast'
+      )
+    ).toThrow(/weather/);
+  });
+
+  it('uses the current schema returned by a dynamic definition', async () => {
+    const registry = new ToolRegistry();
+    let requiredType = 'string';
+    let calls = 0;
+    registry.register(
+      () => ({
+        name: 'weather',
+        description: 'gets weather',
+        inputSchema: {type: 'object', properties: {location: {type: requiredType}}, required: ['location']},
+      }),
+      async () => {
+        calls++;
+        return 'forecast';
+      }
+    );
+
+    const stringLocation = await registry.execute('weather', {location: 'Berlin'});
+    requiredType = 'number';
+    const staleStringLocation = await registry.execute('weather', {location: 'Berlin'});
+
+    expect({
+      stringLocation: stringLocation.result,
+      staleStringLocation: staleStringLocation.result,
+      calls,
+    }).toEqual({
+      stringLocation: 'forecast',
+      staleStringLocation: expect.stringMatching(/location.*number|number.*location/i),
+      calls: 1,
+    });
+  });
+
+  it('keeps using the schema compiled at static registration across executions', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    const schema = {type: 'object', properties: {location: {type: 'string'}}, required: ['location']};
+    registry.register({name: 'weather', description: 'gets weather', inputSchema: schema}, async () => {
+      calls++;
+      return 'forecast';
+    });
+    (schema.properties.location as {type: string}).type = 'number';
+
+    const response = await registry.execute('weather', {location: 42});
+
+    expect({response: response.result, calls}).toEqual({
+      response: expect.stringMatching(/location.*string|string.*location/i),
+      calls: 0,
+    });
+  });
+});