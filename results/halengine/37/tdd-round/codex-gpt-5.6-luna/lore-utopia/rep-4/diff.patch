+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry input validation', () => {
+  it('rejects input missing a required property with a ToolResponse and never calls the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {name: 'get_weather', description: 'Weather', inputSchema: {required: ['location']}},
+      async () => {
+        executorCalls += 1;
+        return 'sunny';
+      }
+    );
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({executorCalls, result: response.result}).toEqual({
+      executorCalls: 0,
+      result: expect.stringMatching(/location.*required/i),
+    });
+  });
+
+  it('rejects a wrong-typed property with its field and expected type without leaking its value', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'lookup',
+        description: 'Lookup',
+        inputSchema: {type: 'object', properties: {ssn: {type: 'string'}}, required: ['ssn']},
+      },
+      async () => {
+        executorCalls += 1;
+        return 'found';
+      }
+    );
+
+    const response = await registry.execute('lookup', {ssn: 123456789});
+
+    expect({executorCalls, result: response.result}).toEqual({
+      executorCalls: 0,
+      result: expect.stringMatching(/ssn.*string/i),
+    });
+  });
+
+  it('names a wrong-typed property when the schema omits the root object type', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'lookup_without_root_type',
+        description: 'Lookup',
+        inputSchema: {properties: {ssn: {type: 'string'}}, required: ['ssn']},
+      },
+      async () => 'found'
+    );
+
+    const response = await registry.execute('lookup_without_root_type', {ssn: 123456789});
+
+    expect(response.result).toMatch(/ssn.*string/i);
+  });
+
+  it('reuses a static schema validator across ten executions', async () => {
+    const registry = new ToolRegistry();
+    const inputSchema = {type: 'object', properties: {location: {type: 'string'}}, required: ['location']};
+    let executorCalls = 0;
+    registry.register({name: 'get_weather', description: 'Weather', inputSchema}, async () => {
+      executorCalls += 1;
+      return 'sunny';
+    });
+
+    inputSchema.required = ['unrelated'];
+    const responses = await Promise.all(
+      Array.from({length: 10}, () => registry.execute('get_weather', {location: 'Paris'}))
+    );
+
+    expect({executorCalls, results: responses.map(response => response.result)}).toEqual({
+      executorCalls: 10,
+      results: Array(10).fill('sunny'),
+    });
+  });
+
+  it('validates a function-valued tool against the schema current at each execution', async () => {
+    const registry = new ToolRegistry();
+    let sourceCalls = 0;
+    const executorInputs: Array<Record<string, unknown>> = [];
+    registry.register(
+      () => {
+        sourceCalls += 1;
+        const property = sourceCalls % 2 === 0 ? 'city' : 'location';
+        return {
+          name: 'get_weather',
+          description: 'Weather',
+          inputSchema: {type: 'object', properties: {[property]: {type: 'string'}}, required: [property]},
+        };
+      },
+      async input => {
+        executorInputs.push(input);
+        return 'sunny';
+      }
+    );
+
+    const first = await registry.execute('get_weather', {city: 'Paris'});
+    const second = await registry.execute('get_weather', {location: 'Paris'});
+
+    expect({first: first.result, second: second.result, executorInputs}).toEqual({
+      first: 'sunny',
+      second: 'sunny',
+      executorInputs: [{city: 'Paris'}, {location: 'Paris'}],
+    });
+  });
+
+  it('passes valid input with undeclared properties through unchanged exactly once', async () => {
+    const registry = new ToolRegistry();
+    const executorInputs: Array<Record<string, unknown>> = [];
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Weather',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async input => {
+        executorInputs.push(input);
+        return 'sunny';
+      }
+    );
+
+    const input = {location: 'Paris', extra: 'preserved'};
+    const response = await registry.execute('get_weather', input);
+
+    expect({response: response.result, executorInputs}).toEqual({
+      response: 'sunny',
+      executorInputs: [input],
+    });
+  });
+
+  it('names the nested field path when a property has the wrong type', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'profile_lookup',
+        description: 'Lookup a profile',
+        inputSchema: {
+          type: 'object',
+          properties: {profile: {type: 'object', properties: {email: {type: 'string'}}}},
+        },
+      },
+      async () => 'found'
+    );
+
+    const response = await registry.execute('profile_lookup', {profile: {email: 42}});
+
+    expect(response.result).toMatch(/input\.profile\.email.*string/i);
+  });
+
+  it('names the field and enum constraint when a property is not one of its allowed values', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'set_weather_unit',
+        description: 'Set weather unit',
+        inputSchema: {
+          type: 'object',
+          properties: {unit: {enum: ['celsius', 'fahrenheit']}},
+          required: ['unit'],
+        },
+      },
+      async () => 'updated'
+    );
+
+    const response = await registry.execute('set_weather_unit', {unit: 'kelvin'});
+
+    expect(response.result).toMatch(/input\.unit must be one of the allowed enum values/i);
+  });
+
+  it('returns a schema rejection for a non-object runtime payload', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Weather',
+        inputSchema: {type: 'object'},
+      },
+      async () => {
+        executorCalls += 1;
+        return 'sunny';
+      }
+    );
+
+    const response = await registry.execute('get_weather', null as unknown as Record<string, unknown>);
+
+    expect({executorCalls, result: response.result}).toEqual({
+      executorCalls: 0,
+      result: expect.stringMatching(/input.*object/i),
+    });
+  });
+
+  it('throws the unchanged unknown-tool error for an unregistered name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('missing_tool', {})).rejects.toThrow('Unknown tool: missing_tool');
+  });
+});
