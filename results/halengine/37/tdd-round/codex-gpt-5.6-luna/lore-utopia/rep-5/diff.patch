+import {jest} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry input validation', () => {
+  // spec: specs/hal-engine-tool-input-validation#1
+  it('returns a required-property rejection without invoking the executor', async () => {
+    const registry = new ToolRegistry();
+    const executor = jest.fn(async () => 'sunny');
+
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      executor
+    );
+
+    const response = await registry.execute('get_weather', {});
+
+    const {calls} = executor.mock;
+    expect({executorCalled: calls.length, result: response.result}).toEqual({
+      executorCalled: 0,
+      result: 'Input validation failed at /location: property is required',
+    });
+  });
+
+  // spec: specs/hal-engine-tool-input-validation#2
+  it('names the nested required property in a schema rejection', async () => {
+    const registry = new ToolRegistry();
+
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            address: {
+              type: 'object',
+              properties: {city: {type: 'string'}},
+              required: ['city'],
+            },
+          },
+        },
+      },
+      async () => 'sunny'
+    );
+
+    const response = await registry.execute('get_weather', {address: {}});
+
+    expect(response.result).toMatch(/\/address\/city.*required|required.*\/address\/city/i);
+  });
+
+  // spec: specs/hal-engine-tool-input-validation#5
+  it('names the top-level property and expected type for a type rejection', async () => {
+    const registry = new ToolRegistry();
+
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async () => 'sunny'
+    );
+
+    const response = await registry.execute('get_weather', {location: 42});
+
+    expect(response.result).toMatch(/\/location.*string|string.*\/location/i);
+  });
+
+  // spec: specs/hal-engine-tool-input-validation#3
+  it('names the nested property path for a type rejection', async () => {
+    const registry = new ToolRegistry();
+
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for an address',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            address: {
+              type: 'object',
+              properties: {city: {type: 'string'}},
+            },
+          },
+        },
+      },
+      async () => 'sunny'
+    );
+
+    const response = await registry.execute('get_weather', {address: {city: 42}});
+
+    expect(response.result).toMatch(/\/address\/city.*string|string.*\/address\/city/i);
+  });
+
+  // spec: specs/hal-engine-tool-input-validation#4
+  it('names the property path when an enum constraint rejects input', async () => {
+    const registry = new ToolRegistry();
+
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {unit: {type: 'string', enum: ['celsius', 'fahrenheit']}},
+          required: ['unit'],
+        },
+      },
+      async () => 'sunny'
+    );
+
+    const response = await registry.execute('get_weather', {unit: 'kelvin'});
+
+    expect(response.result).toMatch(/\/unit.*enum|enum.*\/unit/i);
+  });
+
+  // spec: specs/hal-engine-tool-input-validation#5
+  it('passes valid input and undeclared properties through unchanged once', async () => {
+    const registry = new ToolRegistry();
+    const input = {location: 'Paris', timezone: 'Europe/Paris'};
+    const executorInputs: Array<Record<string, unknown>> = [];
+
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async receivedInput => {
+        executorInputs.push(receivedInput);
+        return 'sunny';
+      }
+    );
+
+    await registry.execute('get_weather', input);
+
+    expect(executorInputs).toEqual([input]);
+  });
+
+  // spec: specs/hal-engine-tool-input-validation#8
+  it('reuses a static validator after the schema object changes', async () => {
+    const registry = new ToolRegistry();
+    const definition = {
+      name: 'get_weather',
+      description: 'Get weather for a location',
+      inputSchema: {
+        type: 'object',
+        properties: {location: {type: 'string'}},
+        required: ['location'],
+      },
+    };
+    const executor = jest.fn(async () => 'sunny');
+
+    registry.register(definition, executor);
+    definition.inputSchema = {
+      type: 'object',
+      properties: {location: {type: 'number'}},
+      required: ['location'],
+    };
+
+    await registry.execute('get_weather', {location: 'Paris'});
+
+    expect(executor).toHaveBeenCalledTimes(1);
+  });
+
+  // spec: specs/hal-engine-tool-input-validation#9
+  it('validates a function-valued definition against its current schema', async () => {
+    const registry = new ToolRegistry();
+    let definitionCalls = 0;
+    const executorInputs: Array<Record<string, unknown>> = [];
+
+    registry.register(
+      () => {
+        definitionCalls += 1;
+        const type = definitionCalls % 2 === 0 ? 'number' : 'string';
+        return {
+          name: 'get_weather',
+          description: 'Get weather for a location',
+          inputSchema: {type: 'object', properties: {location: {type}}, required: ['location']},
+        };
+      },
+      async input => {
+        executorInputs.push(input);
+        return 'sunny';
+      }
+    );
+
+    const firstResponse = await registry.execute('get_weather', {location: 42});
+    const secondResponse = await registry.execute('get_weather', {location: 'Paris'});
+
+    expect({
+      firstResponse: firstResponse.result,
+      secondResponse: secondResponse.result,
+      executorInputs,
+    }).toEqual({
+      firstResponse: 'sunny',
+      secondResponse: 'sunny',
+      executorInputs: [{location: 42}, {location: 'Paris'}],
+    });
+  });
+
+  // spec: specs/hal-engine-tool-input-validation#7
+  it('throws for an unregistered tool name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('missing', {})).rejects.toThrow('Unknown tool: missing');
+  });
+});
