+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+
+describe('ToolRegistry input validation', () => {
+  it('returns a required-property rejection without invoking the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'required_location',
+        description: 'Requires a location',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async () => {
+        executorCalls += 1;
+        return 'sunny';
+      }
+    );
+
+    const response = await registry.execute('required_location', {});
+
+    expect({result: response.result, executorCalls}).toEqual({
+      result: expect.stringMatching(/location.*required/i),
+      executorCalls: 0,
+    });
+  });
+
+  it('names the full path for a nested required property rejection', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'nested_required_location',
+        description: 'Requires a nested location',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            address: {
+              type: 'object',
+              properties: {city: {type: 'string'}},
+              required: ['city'],
+            },
+          },
+          required: ['address'],
+        },
+      },
+      async () => 'sunny'
+    );
+
+    const response = await registry.execute('nested_required_location', {address: {}});
+
+    expect(response.result).toBe('Input property address.city is required');
+  });
+
+  it('reports the failing property path for a wrong-typed input', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'lookup_location',
+        description: 'Looks up a location',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            profile: {
+              type: 'object',
+              properties: {city: {type: 'string'}},
+            },
+          },
+        },
+      },
+      async () => 'sunny'
+    );
+
+    const response = await registry.execute('lookup_location', {profile: {city: 123456789}});
+
+    expect(response.result).toBe('profile.city must be string');
+  });
+
+  it('describes a wrong-typed field without echoing its value', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'lookup_profile',
+        description: 'Looks up a profile',
+        inputSchema: {
+          type: 'object',
+          properties: {profile: {type: 'object', properties: {city: {type: 'string'}}}},
+        },
+      },
+      async () => 'sunny'
+    );
+
+    const response = await registry.execute('lookup_profile', {profile: {city: 123456789}});
+
+    expect(response.result).toBe('profile.city must be string');
+  });
+
+  it('reports an enum rejection with its field path and constraint', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'lookup_weather',
+        description: 'Looks up weather',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string', enum: ['Paris', 'London']}},
+        },
+      },
+      async () => 'sunny'
+    );
+
+    const response = await registry.execute('lookup_weather', {location: 'Berlin'});
+
+    expect(response.result).toBe('location must be one of the allowed values');
+  });
+
+  it('passes valid input and undeclared properties through unchanged exactly once', async () => {
+    const registry = new ToolRegistry();
+    const input = {location: 'Paris', privateNote: 'near the river'};
+    const received: Array<Record<string, unknown>> = [];
+    registry.register(
+      {
+        name: 'get_weather_with_extra_input',
+        description: 'Gets weather with extra input',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async executorInput => {
+        received.push(executorInput);
+        return 'sunny';
+      }
+    );
+
+    const response = await registry.execute('get_weather_with_extra_input', input);
+
+    expect({response: response.result, received}).toEqual({response: 'sunny', received: [input]});
+  });
+
+  it('does not apply schema defaults or coerce values before execution', async () => {
+    const registry = new ToolRegistry();
+    const received: Array<Record<string, unknown>> = [];
+    registry.register(
+      {
+        name: 'get_weather_without_mutation',
+        description: 'Gets weather without changing input',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+            units: {type: 'string', default: 'celsius'},
+          },
+          required: ['location'],
+        },
+      },
+      async input => {
+        received.push(input);
+        return 'sunny';
+      }
+    );
+
+    const input = {location: 'Paris'};
+    await registry.execute('get_weather_without_mutation', input);
+
+    expect(received).toEqual([input]);
+  });
+
+  it('throws for an unregistered tool name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('missing_tool', {})).rejects.toThrow('Unknown tool: missing_tool');
+  });
+
+  it('reuses a static schema validator across execute calls', async () => {
+    const inputSchema: Record<string, unknown> = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    const registry = new ToolRegistry();
+    const inputs: Array<Record<string, unknown>> = [];
+    registry.register({name: 'get_weather', description: 'Get weather', inputSchema}, async input => {
+      inputs.push(input);
+      return 'sunny';
+    });
+
+    inputSchema.required = ['city'];
+    const responses = await Promise.all(
+      Array.from({length: 10}, () => registry.execute('get_weather', {location: 'Paris'}))
+    );
+
+    expect({
+      responses: responses.map(response => response.result),
+      inputs,
+    }).toEqual({
+      responses: Array(10).fill('sunny'),
+      inputs: Array(10).fill({location: 'Paris'}),
+    });
+  });
+
+  it('validates each function-valued schema against the definition current at that call', async () => {
+    const locationSchema = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    const citySchema = {
+      type: 'object',
+      properties: {city: {type: 'string'}},
+      required: ['city'],
+    };
+    let definitionCalls = 0;
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      () => ({
+        name: 'dynamic_weather',
+        description: 'Uses a changing schema',
+        inputSchema: definitionCalls++ < 2 ? locationSchema : citySchema,
+      }),
+      async () => {
+        executorCalls += 1;
+        return 'sunny';
+      }
+    );
+
+    const firstResponse = await registry.execute('dynamic_weather', {});
+    const secondResponse = await registry.execute('dynamic_weather', {city: 42});
+
+    expect({
+      firstResult: firstResponse.result,
+      secondResult: secondResponse.result,
+      executorCalls,
+    }).toEqual({
+      firstResult: expect.stringMatching(/location.*required/i),
+      secondResult: 'city must be string',
+      executorCalls: 0,
+    });
+  });
+
+  it('preserves escaped property names in validation paths', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'lookup_escaped_property',
+        description: 'Looks up an escaped property',
+        inputSchema: {
+          type: 'object',
+          properties: {'profile/city': {type: 'string'}},
+        },
+      },
+      async () => 'sunny'
+    );
+
+    const response = await registry.execute('lookup_escaped_property', {'profile/city': 123456789});
+
+    expect(response.result).toBe('profile/city must be string');
+  });
+
+  it('preserves escaped property names at nested validation paths', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'lookup_nested_escaped_property',
+        description: 'Looks up a nested escaped property',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            profile: {
+              type: 'object',
+              properties: {'profile/city': {type: 'string'}},
+            },
+          },
+        },
+      },
+      async () => 'sunny'
+    );
+
+    const response = await registry.execute('lookup_nested_escaped_property', {
+      profile: {'profile/city': 123456789},
+    });
+
+    expect(response.result).toBe('profile.profile/city must be string');
+  });
+
+  it('logs rejected paths and constraints without logging the rejected value', async () => {
+    const logLines: string[] = [];
+    const record = (category: string, message: string, fields?: Record<string, unknown>) => {
+      logLines.push(JSON.stringify({category, message, fields}));
+    };
+    const logger: Logger = {debug: record, info: record, warn: record, error: record};
+    setLogger(logger);
+
+    try {
+      const registry = new ToolRegistry();
+      registry.register(
+        {
+          name: 'lookup_private_profile',
+          description: 'Looks up a private profile',
+          inputSchema: {
+            type: 'object',
+            properties: {profile: {type: 'object', properties: {ssn: {type: 'string'}}}},
+          },
+        },
+        async () => 'found'
+      );
+
+      const response = await registry.execute('lookup_private_profile', {profile: {ssn: 123456789}});
+
+      const logs = logLines.join('\n');
+      expect({result: response.result, logs, containsRejectedValue: logs.includes('123456789')}).toEqual({
+        result: 'profile.ssn must be string',
+        logs: expect.stringMatching(/profile\.ssn.*string/),
+        containsRejectedValue: false,
+      });
+    } finally {
+      setLogger();
+    }
+  });
+});
