+import Ajv, {type ErrorObject, type Options, type ValidateFunction} from 'ajv';
 import type {ToolDefinition} from '../../types/ai.js';
 import type {OutgoingMessage} from '../../types/messages.js';
 import {log} from '../../shared/logger.js';
@@ -27,6 +28,24 @@ export function normalizeToolResponse(response: string | ToolResponse): ToolResp
 
 export type ToolDefinitionSource = ToolDefinition | (() => ToolDefinition);
 
+function formatInstancePath(instancePath?: string, dataPath?: string): string {
+  if (instancePath) {
+    const normalizedPath = instancePath
+      .replace(/^\//, '')
+      .split('/')
+      .map(segment => segment.replaceAll('~1', '/').replaceAll('~0', '~'))
+      .join('.');
+    return normalizedPath || 'input';
+  }
+  if (!dataPath) return 'input';
+  const normalizedPath = dataPath
+    .replace(/^\./, '')
+    .replace(/\[['"]([^'"]+)['"]\]/g, '.$1')
+    .replace(/\[(\d+)\]/g, '.$1')
+    .replace(/^\./, '');
+  return normalizedPath || 'input';
+}
+
 export interface RegisteredTool {
   definition: ToolDefinition;
   execute: ToolExecutor;
@@ -35,18 +54,61 @@ export interface RegisteredTool {
 interface StoredTool {
   definitionSource: ToolDefinitionSource;
   execute: ToolExecutor;
+  validator?: ValidateFunction;
 }
 
 export class ToolRegistry {
   private readonly tools = new Map<string, StoredTool>();
+  private readonly validator = new Ajv({strict: false, validateFormats: false} as Options);
+  private readonly schemaValidators = new WeakMap<object, ValidateFunction>();
 
   private resolveDefinition(source: ToolDefinitionSource): ToolDefinition {
     return typeof source === 'function' ? source() : source;
   }
 
+  private compileValidator(name: string, schema: Record<string, unknown>): ValidateFunction {
+    try {
+      return this.validator.compile(schema);
+    } catch (error) {
+      const detail = error instanceof Error ? error.message : String(error);
+      throw new Error(`Invalid inputSchema for tool ${name}: ${detail}`, {cause: error});
+    }
+  }
+
+  private validatorFor(tool: StoredTool, definition: ToolDefinition): ValidateFunction {
+    if (tool.validator) return tool.validator;
+    const schema = definition.inputSchema;
+    const cached = this.schemaValidators.get(schema);
+    if (cached) return cached;
+    const validator = this.compileValidator(definition.name, schema);
+    this.schemaValidators.set(schema, validator);
+    return validator;
+  }
+
+  private rejection(error: ErrorObject): ToolResponse {
+    if (error.keyword === 'required') {
+      const missingProperty = 'missingProperty' in error.params ? error.params.missingProperty : 'unknown';
+      const instancePath =
+        'instancePath' in error && typeof error.instancePath === 'string' ? error.instancePath : undefined;
+      const dataPath = 'dataPath' in error && typeof error.dataPath === 'string' ? error.dataPath : undefined;
+      const parentPath = formatInstancePath(instancePath, dataPath);
+      const path = parentPath === 'input' ? String(missingProperty) : `${parentPath}.${String(missingProperty)}`;
+      return {result: `Input property ${path} is required`};
+    }
+    const instancePath =
