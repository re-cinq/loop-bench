+import Ajv from 'ajv';
+import {jest} from '@jest/globals';
+import {setLogger} from '../../shared/logger.js';
+import {ToolRegistry} from './registry.js';
+
+const executeTenTimes = (registry: ToolRegistry, input: Record<string, unknown>): Promise<unknown[]> =>
+  Promise.all(Array.from({length: 10}, () => registry.execute('weather', input)));
+
+describe('ToolRegistry', () => {
+  it('compiles a static schema once across repeated executions', async () => {
+    const compile = jest.spyOn(Ajv.prototype, 'compile');
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Get weather',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}},
+      },
+      async () => 'sunny'
+    );
+
+    await executeTenTimes(registry, {location: 'Paris'});
+
+    expect(compile).toHaveBeenCalledTimes(1);
+    compile.mockRestore();
+  });
+
+  it('rejects a wrong-typed property with its field and expected type without leaking its value', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'ssn_lookup',
+        description: 'Look up a record by identifier',
+        inputSchema: {
+          type: 'object',
+          properties: {ssn: {type: 'string'}},
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'sunny';
+      }
+    );
+
+    const response = await registry.execute('ssn_lookup', {ssn: 123456789});
+
+    expect({executorCalls, result: response.result, leaksValue: response.result.includes('123456789')}).toEqual({
+      executorCalls: 0,
+      result: expect.stringMatching(/ssn.*string/i),
+      leaksValue: false,
+    });
+  });
+
+  it('names the complete nested path when a required property is missing', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'nested_weather',
+        description: 'Get nested weather data',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {
+              type: 'object',
+              properties: {city: {type: 'string'}},
+              required: ['city'],
+            },
+          },
+          required: ['location'],
+        },
+      },
+      async () => 'sunny'
+    );
+
+    const response = await registry.execute('nested_weather', {location: {}});
+
+    expect(response.result).toMatch(/\/location.*city.*required/i);
+  });
+
+  it('reports the parent path before a nested required property', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'forecast',
+        description: 'Get a forecast',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'object', required: ['city']}},
+          required: ['location'],
+        },
+      },
+      async () => 'sunny'
+    );
+
+    const response = await registry.execute('forecast', {location: {}});
+
+    expect(response.result).toMatch(/\/location\/city must have required property/i);
+  });
+
+  it('reports nested required properties with the complete instance path', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'nested_forecast',
+        description: 'Get a nested forecast',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'object', required: ['city']}},
+          required: ['location'],
+        },
+      },
+      async () => 'sunny'
+    );
+
+    const response = await registry.execute('nested_forecast', {location: {}});
+
+    expect(response.result).toMatch(/\/location\/city.*required/i);
+  });
+
+  it('logs the rejected field and constraint without logging its value', async () => {
+    const logLines: string[] = [];
+    const logger = {
+      debug: (_category: string, message: string, fields?: Record<string, unknown>) =>
+        logLines.push(JSON.stringify({message, fields})),
+      info: (_category: string, message: string, fields?: Record<string, unknown>) =>
+        logLines.push(JSON.stringify({message, fields})),
+      warn: (_category: string, message: string, fields?: Record<string, unknown>) =>
+        logLines.push(JSON.stringify({message, fields})),
+      error: (_category: string, message: string, fields?: Record<string, unknown>) =>
+        logLines.push(JSON.stringify({message, fields})),
+    };
+    setLogger(logger);
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'ssn_lookup',
+        description: 'Look up a record',
+        inputSchema: {type: 'object', properties: {ssn: {type: 'string'}}},
+      },
+      async () => 'found'
+    );
+
+    await registry.execute('ssn_lookup', {ssn: 123456789});
+
+    expect({
+      hasPathAndConstraint: logLines.some(line => line.includes('ssn') && line.includes('string')),
+      leaksValue: logLines.some(line => line.includes('123456789')),
+    }).toEqual({hasPathAndConstraint: true, leaksValue: false});
+    setLogger(undefined);
+  });
+
+  it('passes valid input with undeclared properties through unchanged', async () => {
+    const registry = new ToolRegistry();
+    const input = {location: 'Paris', requestId: 'req-123'};
+    const executorInputs: Array<Record<string, unknown>> = [];
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Get weather',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async receivedInput => {
+        executorInputs.push(receivedInput);
+        return 'sunny';
+      }
+    );
+
+    await registry.execute('weather', input);
+
+    expect(executorInputs).toEqual([input]);
+  });
+
+  it('compiles a function-valued schema once per schema object across repeated executions', async () => {
+    const compile = jest.spyOn(Ajv.prototype, 'compile');
+    const registry = new ToolRegistry();
+    const schema = {type: 'object', properties: {location: {type: 'string'}}};
+    registry.register(
+      () => ({name: 'weather', description: 'Get weather', inputSchema: schema}),
+      async () => 'sunny'
+    );
+
+    await executeTenTimes(registry, {location: 'Paris'});
+
+    expect(compile).toHaveBeenCalledTimes(1);
+    compile.mockRestore();
+  });
+
+  it('validates each call against the schema the definition function returns at that call', async () => {
+    let definitionCalls = 0;
+    const executorInputs: Array<Record<string, unknown>> = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      () => {
+        definitionCalls += 1;
+        const property = definitionCalls === 2 ? 'location' : 'city';
+        return {
+          name: 'weather',
+          description: 'Get weather',
+          inputSchema: {
+            type: 'object',
+            properties: {[property]: {type: 'string'}},
+            required: [property],
+          },
+        };
+      },
+      async input => {
+        executorInputs.push(input);
+        return 'sunny';
+      }
+    );
+
+    await registry.execute('weather', {location: 'Paris'});
+    await registry.execute('weather', {city: 'Berlin'});
+
+    expect({definitionCalls, executorInputs}).toEqual({
+      definitionCalls: 3,
+      executorInputs: [{location: 'Paris'}, {city: 'Berlin'}],
+    });
+  });
+
+  it('throws at register time naming the tool when a static schema cannot be compiled', () => {
+    const registry = new ToolRegistry();
+    const brokenDefinition = {
+      name: 'broken_weather',
+      description: 'Has an invalid JSON Schema type',
+      inputSchema: {
+        type: 'object',
+        properties: {location: {type: 'not-a-json-schema-type'}},
+      },
+    };
+
+    expect(() => registry.register(brokenDefinition, async () => 'unreachable')).toThrow(
+      /Invalid inputSchema for tool 'broken_weather'/
+    );
+  });
+});
