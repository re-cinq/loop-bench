+import {ToolRegistry} from './registry.js';
+import Ajv from 'ajv';
+import {jest} from '@jest/globals';
+
+describe('ToolRegistry input validation', () => {
+  it('rejects missing required input before invoking the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+
+    registry.register(weatherDefinition(), async () => {
+      executorCalls += 1;
+      return 'sunny';
+    });
+
+    const response = await registry.execute('weather', {});
+
+    expect({result: response.result, executorCalls}).toEqual({
+      result: expect.stringMatching(/location.*required/i),
+      executorCalls: 0,
+    });
+  });
+
+  it('passes valid input and undeclared properties through unchanged exactly once', async () => {
+    // specs/hal-engine-tool-input-validation#2
+    const registry = new ToolRegistry();
+    const input = {location: 'Berlin', unit: 'celsius'};
+    const received: Array<Record<string, unknown>> = [];
+    registry.register(weatherDefinition(), async toolInput => {
+      received.push(toolInput);
+      return 'sunny';
+    });
+
+    await registry.execute('weather', input);
+
+    expect(received).toEqual([input]);
+  });
+
+  it('names the field and expected type when rejecting a wrong-typed property', async () => {
+    const response = await executeWeather({location: 42});
+
+    expect(response.result).toBe('location must be string');
+  });
+
+  it('names the enum constraint when rejecting a value outside the enum', async () => {
+    // specs/hal-engine-tool-input-validation#4
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Get weather',
+        inputSchema: {
+          type: 'object',
+          properties: {unit: {type: 'string', enum: ['celsius', 'fahrenheit']}},
+        },
