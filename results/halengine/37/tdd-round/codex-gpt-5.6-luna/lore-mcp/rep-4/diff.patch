+import Ajv from 'ajv';
+import {jest} from '@jest/globals';
+import {setLogger, type Logger} from '../../shared/logger.js';
+import {ToolRegistry} from './registry.js';
+
+const weatherDefinition = {
+  name: 'get_weather',
+  description: 'Get weather for a location',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}},
+    required: ['location'],
+  },
+};
+
+const lookupDefinition = {
+  name: 'lookup_record',
+  description: 'Look up a record',
+  inputSchema: {
+    type: 'object',
+    properties: {identifier: {type: 'string'}},
+  },
+};
+
+async function captureToolWarnings(
+  action: () => Promise<void>
+): Promise<Array<{message: string; fields?: Record<string, unknown>}>> {
+  const warnings: Array<{message: string; fields?: Record<string, unknown>}> = [];
+  const logger: Logger = {
+    debug: () => undefined,
+    info: () => undefined,
+    warn: (category, message, fields) => {
+      if (category === 'tool') warnings.push({message, fields});
+    },
+    error: () => undefined,
+  };
+  setLogger(logger);
+  try {
+    await action();
+  } finally {
+    setLogger();
+  }
+  return warnings;
+}
+
+describe('ToolRegistry input validation', () => {
+  it('passes valid input and unlisted properties through unchanged', async () => {
+    const registry = new ToolRegistry();
+    const input = {location: 'Berlin', extra: 'keep me'};
+    let received: Record<string, unknown> | undefined;
+    registry.register(
+      {
+        ...weatherDefinition,
+      },
+      async value => {
+        received = value;
+        return 'sunny';
+      }
+    );
+
+    await registry.execute('get_weather', input);
+
+    expect(received).toEqual(input);
+  });
+
+  it('rejects input missing a required property with a ToolResponse and never calls the executor', async () => {
+    const registry = new ToolRegistry();
+    const calls = {count: 0};
+    registry.register(
+      {
+        ...weatherDefinition,
+      },
+      async () => {
+        calls.count += 1;
+        return 'sunny';
+      }
+    );
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({
+      executorCalls: calls.count,
+      result: response.result,
+      mentionsRequiredField: response.result.includes('location') && /required/i.test(response.result),
+    }).toEqual({
+      executorCalls: 0,
+      result: expect.any(String),
+      mentionsRequiredField: true,
+    });
+  });
+
+  it('logs the missing required property path and constraint', async () => {
+    const warnings = await captureToolWarnings(async () => {
+      const registry = new ToolRegistry();
+      registry.register(
+        {
+          ...weatherDefinition,
+        },
+        async () => 'sunny'
+      );
+
+      await registry.execute('get_weather', {});
+    });
+
+    expect(warnings).toContainEqual({
+      message: 'input validation failed',
+      fields: {name: 'get_weather', paths: ['/location'], constraints: ['required']},
+    });
+  });
+
+  it('rejects a wrong-typed property with its path and expected type without leaking the value', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        ...lookupDefinition,
+      },
+      async () => {
+        executorCalls += 1;
+        return 'found';
+      }
+    );
+
+    const response = await registry.execute('lookup_record', {identifier: 123456789});
+
+    expect({
+      executorCalls,
+      result: response.result,
+      namesField: response.result.includes('identifier'),
+      namesExpectedType: response.result.includes('string'),
+      leaksValue: response.result.includes('123456789'),
+    }).toEqual({
+      executorCalls: 0,
+      result: expect.any(String),
+      namesField: true,
+      namesExpectedType: true,
+      leaksValue: false,
+    });
+  });
+
+  it('names the enum constraint when rejecting an unlisted value', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'set_weather_unit',
+        description: 'Set the weather unit',
+        inputSchema: {
+          type: 'object',
+          properties: {unit: {type: 'string', enum: ['celsius', 'fahrenheit']}},
+          required: ['unit'],
+        },
+      },
+      async () => 'updated'
+    );
+
+    const response = await registry.execute('set_weather_unit', {unit: 'kelvin'});
+
+    expect(response.result).toContain('/unit enum');
+    expect(response.result).not.toContain('kelvin');
+  });
+
+  it('compiles a static schema once across repeated executions', async () => {
+    const compile = jest.spyOn(Ajv.prototype, 'compile');
+    const registry = new ToolRegistry();
+    registry.register(weatherDefinition, async () => 'sunny');
+
+    for (let call = 0; call < 10; call += 1) {
+      await registry.execute('get_weather', {location: 'Berlin'});
+    }
+
+    expect(compile).toHaveBeenCalledTimes(1);
+    compile.mockRestore();
+  });
+
+  it('logs the failing property path without the rejected value', async () => {
+    const registry = new ToolRegistry();
+    const warnings = await captureToolWarnings(async () => {
+      registry.register(
+        {
+          ...lookupDefinition,
+        },
+        async () => 'found'
+      );
+
+      await registry.execute('lookup_record', {identifier: 123456789});
+    });
+
+    expect(warnings).toEqual([
+      {
+        message: 'input validation failed',
+        fields: {name: 'lookup_record', paths: ['/identifier'], constraints: ['type']},
+      },
+    ]);
+  });
+
+  it('rejects an uncompilable static schema at registration and names the tool', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_weather',
+          description: 'Broken weather tool',
+          inputSchema: {type: 'not-a-json-schema-type'},
+        },
+        async () => 'sunny'
+      )
+    ).toThrow("Invalid inputSchema for tool 'broken_weather'");
+  });
+
+  it('validates each function-valued definition against its current schema', async () => {
+    const registry = new ToolRegistry();
+    let definitionCalls = 0;
+    const inputs: Array<Record<string, unknown>> = [];
+    registry.register(
+      () => {
+        definitionCalls += 1;
+        const property = definitionCalls === 2 ? 'location' : 'city';
+        return {
+          name: 'get_weather',
+          description: 'Get weather for a location',
+          inputSchema: {
+            type: 'object',
+            properties: {[property]: {type: 'string'}},
+            required: [property],
+          },
+        };
+      },
+      async input => {
+        inputs.push(input);
+        return 'sunny';
+      }
+    );
+
+    const first = await registry.execute('get_weather', {location: 'Berlin'});
+    const second = await registry.execute('get_weather', {city: 'Paris'});
+
+    expect({
+      firstResult: first.result,
+      secondResult: second.result,
+      inputs,
+    }).toEqual({
+      firstResult: 'sunny',
+      secondResult: 'sunny',
+      inputs: [{location: 'Berlin'}, {city: 'Paris'}],
+    });
+  });
+
+  it('throws Unknown tool for an unregistered name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('missing_tool', {})).rejects.toThrow('Unknown tool: missing_tool');
+  });
+
+  it('reports the complete path for a nested missing required property', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'nested_weather',
+        description: 'Get weather with nested location data',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {
+              type: 'object',
+              properties: {city: {type: 'string'}},
+              required: ['city'],
+            },
+          },
+          required: ['location'],
+        },
+      },
+      async () => 'sunny'
+    );
+
+    const response = await registry.execute('nested_weather', {location: {}});
+
+    expect(response.result).toContain('/location/city');
+  });
+});
