@@ -0,0 +1,295 @@
+import {ToolRegistry} from './registry.js';
+import Ajv from 'ajv';
+import {jest} from '@jest/globals';
+import {setLogger} from '../../shared/logger.js';
+
+describe('ToolRegistry dynamic input validation', () => {
+  // spec: specs/hal-engine-tool-input-validation#7
+  it('validates each function-valued definition against its current schema', async () => {
+    const registry = new ToolRegistry();
+    let definitionCalls = 0;
+    let executorCalls = 0;
+    registry.register(
+      () => {
+        definitionCalls += 1;
+        const required = definitionCalls === 2 ? 'location' : 'city';
+        return {
+          name: 'get_weather',
+          description: 'Get weather for a location',
+          inputSchema: {
+            type: 'object',
+            properties: {[required]: {type: 'string'}},
+            required: [required],
+          },
+        };
+      },
+      async () => {
+        executorCalls += 1;
+        return 'sunny';
+      }
+    );
+
+    const firstResponse = await registry.execute('get_weather', {location: 'Paris'});
+    const secondResponse = await registry.execute('get_weather', {location: 'Paris'});
