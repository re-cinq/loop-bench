+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry', () => {
+  const weatherSchema = {
+    type: 'object',
+    properties: {location: {type: 'string'}},
+    required: ['location'],
+  };
+
+  const registerWeather = (registry: ToolRegistry, executor: Parameters<ToolRegistry['register']>[1]): void => {
+    registry.register({name: 'weather', description: 'Get weather', inputSchema: weatherSchema}, executor);
+  };
+
+  const countCompiles = (registry: ToolRegistry): {get: () => number} => {
+    let compileCalls = 0;
+    const ajv = (
+      registry as unknown as {
+        ajv: {compile: (inputSchema: Record<string, unknown>) => unknown};
+      }
+    ).ajv;
+    const originalCompile = ajv.compile.bind(ajv);
+    ajv.compile = inputSchema => {
+      compileCalls += 1;
+      return originalCompile(inputSchema);
+    };
+    return {get: () => compileCalls};
+  };
+
+  const executeTenTimes = async (registry: ToolRegistry): Promise<void> => {
+    for (let call = 0; call < 10; call += 1) {
+      await registry.execute('weather', {location: 'Paris'});
+    }
+  };
+
+  it('rejects input missing a required property without calling the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+
+    registry.register(
+      {
+        name: 'city_forecast',
+        description: 'Get a forecast for a city',
+        inputSchema: {
+          type: 'object',
+          properties: {city: {type: 'string'}},
+          required: ['city'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'clear';
+      }
+    );
+
+    const response = await registry.execute('city_forecast', {});
+
+    expect({executorCalls, result: response.result}).toEqual({
+      executorCalls: 0,
+      result: expect.stringContaining('city'),
+    });
+  });
+
+  it('rejects a wrong-typed nested property with a redacted path-aware message', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+
+    registry.register(
+      {
+        name: 'lookup_profile',
+        description: 'Look up a profile by display name',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            profile: {
+              type: 'object',
+              properties: {displayName: {type: 'string'}},
+              required: ['displayName'],
+            },
+          },
+          required: ['profile'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'found';
+      }
+    );
+
+    const response = await registry.execute('lookup_profile', {profile: {displayName: 987654321}});
+
+    expect({
+      executorCalls,
+      result: response.result,
+      leaksValue: response.result.includes('987654321'),
+    }).toEqual({
+      executorCalls: 0,
+      result: '/profile/displayName must be string',
+      leaksValue: false,
+    });
+  });
+
+  it('passes valid input with extra properties through unchanged exactly once', async () => {
+    const registry = new ToolRegistry();
+    const input = {location: 'Paris', requestedBy: 'Ada'};
+    let executorCalls = 0;
+    let received: Record<string, unknown> | undefined;
+    const executor = async (executorInput: Record<string, unknown>) => {
+      executorCalls += 1;
+      received = executorInput;
+      return 'clear';
+    };
+
+    registerWeather(registry, executor);
+
+    await registry.execute('weather', input);
+
+    expect({calls: executorCalls, received}).toEqual({
+      calls: 1,
+      received: input,
+    });
+  });
+
+  it('compiles a function-source schema once when the same schema object is reused', async () => {
+    const registry = new ToolRegistry();
+    const schema = weatherSchema;
+    const compileCounter = countCompiles(registry);
+
+    registry.register(
+      () => ({name: 'weather', description: 'Get weather', inputSchema: schema}),
+      async () => 'clear'
+    );
+
+    await executeTenTimes(registry);
+
+    expect(compileCounter.get()).toBe(1);
+  });
+
+  it('validates function-source input against the schema returned for each call', async () => {
+    const registry = new ToolRegistry();
+    let useLocationSchema = true;
+    let executorCalls = 0;
+    const executor = async () => {
+      executorCalls += 1;
+      return 'clear';
+    };
+
+    registry.register(
+      () => ({
+        name: 'weather',
+        description: 'Get weather',
+        inputSchema: useLocationSchema
+          ? {type: 'object', properties: {location: {type: 'string'}}, required: ['location']}
+          : {type: 'object', properties: {city: {type: 'string'}}, required: ['city']},
+      }),
+      executor
+    );
+
+    const firstResponse = await registry.execute('weather', {location: 'Paris'});
+    useLocationSchema = false;
+    const secondResponse = await registry.execute('weather', {location: 'Paris'});
+    expect({
+      firstResult: firstResponse.result,
+      secondResult: secondResponse.result,
+      executorCalls,
+    }).toEqual({
+      firstResult: 'clear',
+      secondResult: expect.stringContaining('city'),
+      executorCalls: 1,
+    });
+  });
+
+  it('compiles a static schema once across repeated executions', async () => {
+    const registry = new ToolRegistry();
+    const compileCounter = countCompiles(registry);
+
+    registerWeather(registry, async () => 'clear');
+
+    await executeTenTimes(registry);
+
+    expect(compileCounter.get()).toBe(1);
+  });
+
+  it('throws the unchanged unknown-tool error', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('missing_weather', {})).rejects.toThrow('Unknown tool: missing_weather');
+  });
+});
