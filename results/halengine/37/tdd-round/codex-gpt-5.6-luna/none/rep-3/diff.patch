+import {formatValidationError, ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+describe('ToolRegistry schema compilation', () => {
+  it('passes valid input and undeclared properties through unchanged exactly once', async () => {
+    const registry = new ToolRegistry();
+    const inputs: Array<Record<string, unknown>> = [];
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async input => {
+        inputs.push(input);
+        return 'sunny';
+      }
+    );
+
+    const input = {location: 'Paris', requestId: 'opaque'};
+    await registry.execute('get_weather', input);
+
+    expect(inputs).toEqual([input]);
+  });
+
+  it('compiles a static schema once across repeated executions', async () => {
+    let schemaReads = 0;
+    const inputSchema = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    const definition = {
+      name: 'get_weather',
+      description: 'Get weather for a location',
+      get inputSchema() {
+        schemaReads += 1;
+        return inputSchema;
+      },
+    } as ToolDefinition;
+    const registry = new ToolRegistry();
+
+    registry.register(definition, async () => 'sunny');
+    for (let call = 0; call < 10; call += 1) {
+      await registry.execute('get_weather', {location: 'Paris'});
+    }
+
+    expect(schemaReads).toBe(1);
+  });
+
+  it('validates each function-valued definition against its current schema', async () => {
+    const schemas = [
+      {
+        type: 'object',
+        properties: {location: {type: 'string'}},
+        required: ['location'],
+      },
+      {
+        type: 'object',
+        properties: {units: {enum: ['celsius', 'fahrenheit']}},
+        required: ['units'],
+      },
+    ];
+    let calls = 0;
+    const registry = new ToolRegistry();
+    registry.register(
+      () => ({
+        name: 'get_weather',
+        description: 'Get weather',
+        inputSchema: schemas[Math.max(0, calls++ - 1) % schemas.length],
+      }),
+      async input => JSON.stringify(input)
+    );
+
+    const first = await registry.execute('get_weather', {location: 'Paris'});
+    const second = await registry.execute('get_weather', {units: 'celsius'});
+
+    expect([first.result, second.result]).toEqual([
+      JSON.stringify({location: 'Paris'}),
+      JSON.stringify({units: 'celsius'}),
+    ]);
+  });
+
+  it('reports a wrong-typed property by path without the offending value', async () => {
+    const registry = new ToolRegistry();
