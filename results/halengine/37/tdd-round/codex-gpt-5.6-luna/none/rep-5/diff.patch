+import {ToolRegistry} from './registry.js';
+import {jest} from '@jest/globals';
+
+describe('ToolRegistry input validation', () => {
+  // ([validated by: returns a required-property rejection without invoking the executor](../../specs/hal-engine-tool-input-validation/spec.md#L12))
+  it('returns a required-property rejection without invoking the executor', async () => {
+    const registry = new ToolRegistry();
+    const executor = jest.fn(async () => 'sunny');
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      executor
+    );
+
+    const response = await registry.execute('get_weather', {});
+
+    const {calls} = executor.mock;
+    expect({
+      resultNamesRequiredLocation: /location.*required/i.test(response.result),
+      executorCalls: calls.length,
+    }).toEqual({resultNamesRequiredLocation: true, executorCalls: 0});
+  });
+
+  // ([validated by](../../specs/hal-engine-tool-input-validation/spec.md#L15))
+  it('throws the unchanged unknown-tool error for an unregistered name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('missing_weather', {})).rejects.toThrow('Unknown tool: missing_weather');
+  });
+
+  // ([validated by](../../specs/hal-engine-tool-input-validation/spec.md#L14))
+  it('passes valid input with extra properties reaches the executor unchanged', async () => {
+    const registry = new ToolRegistry();
+    const executor = jest.fn(async (input: Record<string, unknown>) => JSON.stringify(input));
+    const input = {location: 'Paris', identifyingNote: 'private'};
+    registry.register(
+      {
+        name: 'pass_through_weather',
+        description: 'Reads weather',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      executor
+    );
+
+    await registry.execute('pass_through_weather', input);
+
+    expect(executor.mock.calls).toEqual([[input, undefined]]);
+  });
+
+  // ([validated by](../../specs/hal-engine-tool-input-validation/spec.md#L16))
+  it('names the full path for a nested required property rejection', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'nested_weather',
+        description: 'Reads a nested location',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            address: {
+              type: 'object',
+              properties: {city: {type: 'string'}},
+              required: ['city'],
+            },
+          },
+          required: ['address'],
+        },
+      },
+      async () => 'ok'
+    );
+
+    const response = await registry.execute('nested_weather', {address: {}});
+
+    expect(response.result).toEqual(expect.stringMatching(/address.*city|\/address\/city/i));
+  });
+
+  // ([validated by](../../specs/hal-engine-tool-input-validation/spec.md#L20))
+  it('reuses a static schema validator across ten executions', async () => {
+    const registry = new ToolRegistry();
+    const executor = jest.fn(async () => 'ok');
+    const inputSchema: Record<string, unknown> = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+    };
+    registry.register({name: 'cached_weather', description: 'Reads weather', inputSchema}, executor);
+    Object.defineProperty(inputSchema, 'properties', {
+      enumerable: true,
+      get: () => {
+        throw new Error('schema was read after registration');
+      },
+    });
+
+    for (let attempt = 0; attempt < 10; attempt += 1) {
+      await registry.execute('cached_weather', {location: 'Paris'});
+    }
+
+    expect(executor).toHaveBeenCalledTimes(10);
+  });
+
+  // ([validated by](../../specs/hal-engine-tool-input-validation/spec.md#L21))
+  it('validates function-valued definitions against the schema returned for each call', async () => {
+    const registry = new ToolRegistry();
+    const executor = jest.fn(async () => 'ok');
+    const schemas = [
+      {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      {type: 'object', properties: {postalCode: {type: 'number'}}, required: ['postalCode']},
+    ];
+    let calls = 0;
+    registry.register(
+      () => ({
+        name: 'dynamic_weather',
+        description: 'Reads weather with a changing schema',
+        inputSchema: schemas[Math.max(0, Math.min(calls++ - 1, schemas.length - 1))],
+      }),
+      executor
+    );
+
+    const first = await registry.execute('dynamic_weather', {location: 'Paris'});
+    const second = await registry.execute('dynamic_weather', {postalCode: 75001});
+
+    const {calls: executorCalls} = executor.mock;
+    expect({
+      response: {first: first.result, second: second.result},
+      executorCalls: executorCalls.length,
+    }).toEqual({
+      response: {first: 'ok', second: 'ok'},
+      executorCalls: 2,
+    });
+  });
+});
