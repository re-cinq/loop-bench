+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry schema compilation', () => {
+  it('throws at register time naming the tool when a static inputSchema cannot be compiled', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_tool',
+          description: 'Has an invalid schema',
+          inputSchema: {
+            type: 'object',
+            properties: {location: {type: 'not-a-valid-json-schema-type'}},
+          },
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken_tool/);
+  });
+
+  it('rejects input missing a required property without calling the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'sunny';
+      }
+    );
+
+    const response = await registry.execute('get_weather', {});
+
+    expect(executorCalls).toBe(0);
+    expect(response.result).toContain('location');
+    expect(response.result).toMatch(/required/i);
+  });
+
+  it('invokes executor once when input satisfies schema and passes input through unchanged', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    let capturedInput: Record<string, unknown> | undefined;
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async input => {
+        executorCalls += 1;
+        capturedInput = input;
+        return 'sunny';
+      }
+    );
+
+    const response = await registry.execute('get_weather', {location: 'Paris', extra: 'property'});
+
+    expect(executorCalls).toBe(1);
+    expect(response.result).toBe('sunny');
+    expect(capturedInput).toEqual({location: 'Paris', extra: 'property'});
+  });
+
+  it('throws Unknown tool: <name> for an unregistered tool name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('unregistered_tool', {})).rejects.toThrow(/Unknown tool: unregistered_tool/);
+  });
+
+  it('compiles a static tool schema once and reuses it across multiple execute calls', async () => {
+    const registry = new ToolRegistry();
+    const definition = {
+      name: 'get_weather',
+      description: 'Get weather for a location',
+      inputSchema: {
+        type: 'object',
+        properties: {location: {type: 'string'}},
+        required: ['location'],
+      },
+    };
+    registry.register(definition, async () => 'sunny');
+
+    // Execute 10 times with valid input
+    for (let i = 0; i < 10; i++) {
+      const response = await registry.execute('get_weather', {location: 'Paris'});
+      expect(response.result).toBe('sunny');
+    }
+  });
+
+  it('validates function-valued schema against the schema returned for that call', async () => {
+    const registry = new ToolRegistry();
+    let callCount = 0;
+    registry.register(
+      () => {
+        callCount += 1;
+        return {
+          name: 'dynamic_schema',
+          description: 'Has a dynamic schema',
+          inputSchema: {
+            type: 'object',
+            properties: {value: {type: 'string'}},
+            required: ['value'],
+          },
+        };
+      },
+      async () => 'result'
+    );
+
+    // First execute should accept the schema
+    const response1 = await registry.execute('dynamic_schema', {value: 'test'});
+    expect(response1.result).toBe('result');
+
+    // Second execute should reject invalid input against the same schema
+    const response2 = await registry.execute('dynamic_schema', {});
+    expect(response2.result).toContain('value');
+    expect(response2.result).toMatch(/required/i);
+  });
+});
