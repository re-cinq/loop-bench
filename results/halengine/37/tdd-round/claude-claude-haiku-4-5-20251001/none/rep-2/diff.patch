+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+
+describe('ToolRegistry.execute validates input against inputSchema', () => {
+  afterEach(() => {
+    setLogger(undefined);
+  });
+
+  it('rejects input missing a required field without calling executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+
+    registry.register(
+      {
+        name: 'test_tool',
+        description: 'Test tool',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+          },
+          required: ['location'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'success';
+      }
+    );
+
+    const response = await registry.execute('test_tool', {});
+
+    expect({
+      executorCalls,
+      mentionsLocation: response.result.includes('location'),
+      mentionsRequired: /required/i.test(response.result),
+    }).toEqual({
+      executorCalls: 0,
+      mentionsLocation: true,
+      mentionsRequired: true,
+    });
+  });
+
+  it('rejects wrong-typed property naming the field and expected type without leaking the offending value', async () => {
+    const recordedLogs: string[] = [];
+    const recordLine = (category: string, message: string, fields?: Record<string, unknown>) => {
+      recordedLogs.push(JSON.stringify({category, message, fields}));
+    };
+    const logger: Logger = {
+      debug: recordLine,
+      info: recordLine,
+      warn: recordLine,
+      error: recordLine,
+    };
+    setLogger(logger);
+
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+
+    registry.register(
+      {
+        name: 'id_lookup',
+        description: 'Look up by ID',
+        inputSchema: {
+          type: 'object',
+          properties: {id: {type: 'string'}},
+          required: ['id'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'found';
+      }
+    );
+
+    const response = await registry.execute('id_lookup', {id: 12345});
+
+    expect({
+      executorCalls,
+      mentionsField: response.result.includes('id'),
+      mentionsExpectedType: response.result.includes('string'),
+      leaksValueInResult: response.result.includes('12345'),
+      leaksValueInLogs: recordedLogs.some(line => line.includes('12345')),
+    }).toEqual({
+      executorCalls: 0,
+      mentionsField: true,
+      mentionsExpectedType: true,
+      leaksValueInResult: false,
+      leaksValueInLogs: false,
+    });
+  });
+});
