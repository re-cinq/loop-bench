@@ -0,0 +1,251 @@
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry', () => {
+  it('throws Unknown tool for unregistered tools', async () => {
+    const registry = new ToolRegistry();
+    await expect(registry.execute('nonexistent', {})).rejects.toThrow('Unknown tool: nonexistent');
+  });
+
+  it('passes valid input through to executor unchanged including extra properties', async () => {
+    const registry = new ToolRegistry();
+    const executorInputs: Array<Record<string, unknown>> = [];
+
+    registry.register(
+      {
+        name: 'accept_input',
+        description: 'Accepts input',
+        inputSchema: {
+          type: 'object',
+          properties: {name: {type: 'string'}},
+          required: ['name'],
+        },
+      },
+      async input => {
+        executorInputs.push(input);
+        return 'ok';
+      }
+    );
+
+    const response = await registry.execute('accept_input', {name: 'test', extra: 'field'});
+
+    expect({
+      result: response.result,
+      inputCount: executorInputs.length,
+      hasExtra: executorInputs[0]?.extra === 'field',
+    }).toEqual({
+      result: 'ok',
+      inputCount: 1,
+      hasExtra: true,
+    });
+  });
+
+  it('compiles a static tool schema once across ten execute calls', async () => {
+    const registry = new ToolRegistry();
+
+    registry.register(
+      {
+        name: 'static_schema',
+        description: 'Static schema tool',
+        inputSchema: {
+          type: 'object',
+          properties: {value: {type: 'string'}},
+          required: ['value'],
+        },
+      },
+      async () => 'ok'
+    );
+
+    const results = [];
+    for (let i = 0; i < 10; i++) {
+      const result = await registry.execute('static_schema', {value: `call${i}`});
+      results.push(result);
+    }
+
+    expect(results).toHaveLength(10);
+  });
+
+  it('validates function-valued schema against the current definition, not a stale cached schema', async () => {
+    const registry = new ToolRegistry();
+    let callCount = 0;
+
+    registry.register(
+      () => {
+        callCount += 1;
+        const schema = {
+          type: 'object',
+          properties: {field: {type: callCount === 2 ? 'string' : 'number'}},
+          required: ['field'],
+        };
+        return {
+          name: 'dynamic_schema',
+          description: 'Dynamic schema tool',
+          inputSchema: schema,
+        };
+      },
+      async input => `received: ${String(input.field)}`
+    );
+
+    const firstCallWithString = await registry.execute('dynamic_schema', {field: 'text'});
+    const secondCallWithNumber = await registry.execute('dynamic_schema', {field: 42});
+    const thirdCallRejectsString = await registry.execute('dynamic_schema', {field: 'text'});
+
+    expect({
+      firstAccepted: firstCallWithString.result,
+      secondAccepted: secondCallWithNumber.result,
+      thirdRejected: thirdCallRejectsString.result,
+    }).toEqual({
+      firstAccepted: 'received: text',
+      secondAccepted: 'received: 42',
+      thirdRejected: expect.stringMatching(/field.*number/),
+    });
+  });
+
+  it('returns registered tool with definition and executor for get', async () => {
+    const registry = new ToolRegistry();
+    const toolDef = {
+      name: 'get_test_tool',
+      description: 'Test tool for get',
+      inputSchema: {
+        type: 'object',
+        properties: {input: {type: 'string'}},
+      },
+    };
+
+    const executor = async () => 'result';
+    registry.register(toolDef, executor);
+
+    const retrieved = registry.get('get_test_tool');
+
+    expect({
+      isDefined: retrieved !== undefined,
+      hasDefinition: retrieved?.definition?.name === 'get_test_tool',
+      hasExecutor: typeof retrieved?.execute === 'function',
+    }).toEqual({
+      isDefined: true,
+      hasDefinition: true,
+      hasExecutor: true,
+    });
+  });
+
+  it('returns undefined for get on unregistered tool', () => {
+    const registry = new ToolRegistry();
+    const retrieved = registry.get('nonexistent_tool');
+    expect(retrieved).toBeUndefined();
+  });
+
+  it('has returns true for registered tools and false for unregistered', () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'has_test_tool',
+        description: 'Test tool',
+        inputSchema: {type: 'object', properties: {}},
+      },
+      async () => 'ok'
+    );
+
+    expect({
+      hasRegistered: registry.has('has_test_tool'),
+      hasUnregistered: registry.has('nonexistent'),
+    }).toEqual({
+      hasRegistered: true,
+      hasUnregistered: false,
+    });
+  });
+
+  it('getDefinitions returns all registered tool definitions', () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'tool_a',
+        description: 'Tool A',
+        inputSchema: {type: 'object', properties: {}},
+      },
+      async () => 'a'
+    );
+    registry.register(
+      {
+        name: 'tool_b',
+        description: 'Tool B',
+        inputSchema: {type: 'object', properties: {}},
+      },
+      async () => 'b'
+    );
+
+    const definitions = registry.getDefinitions();
+    expect({
+      count: definitions.length,
+      names: definitions.map(d => d.name).sort(),
+    }).toEqual({
+      count: 2,
+      names: ['tool_a', 'tool_b'],
+    });
+  });
+
+  it('getPromptInstructions returns instructions for tools with promptInstructions', () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'with_instructions',
+        description: 'Tool with instructions',
+        inputSchema: {type: 'object', properties: {}},
+        promptInstructions: 'Use this tool when needed',
+      },
+      async () => 'ok'
+    );
+    registry.register(
+      {
+        name: 'without_instructions',
+        description: 'Tool without',
+        inputSchema: {type: 'object', properties: {}},
+      },
+      async () => 'ok'
+    );
+
+    const instructions = registry.getPromptInstructions();
+    expect(instructions).toEqual(['with_instructions: Use this tool when needed']);
+  });
+
+  it('getExamplePrompts returns flattened example prompts from tools', () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'tool_with_examples',
+        description: 'Tool with examples',
+        inputSchema: {type: 'object', properties: {}},
+        examplePrompts: ['Example 1', 'Example 2'],
+      },
+      async () => 'ok'
+    );
+    registry.register(
+      {
+        name: 'tool_without_examples',
+        description: 'Tool without',
+        inputSchema: {type: 'object', properties: {}},
+      },
+      async () => 'ok'
+    );
+
+    const examples = registry.getExamplePrompts();
+    expect(examples).toEqual(['Example 1', 'Example 2']);
+  });
+
+  it('rejects input with enum validation failure', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'enum_test',
+        description: 'Test enum validation',
+        inputSchema: {
+          type: 'object',
+          properties: {status: {type: 'string', enum: ['active', 'inactive']}},
+          required: ['status'],
+        },
+      },
+      async () => 'ok'
+    );
+
+    const response = await registry.execute('enum_test', {status: 'invalid'});
+    expect(response.result).toContain('Validation failed');
+  });
+});
