+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry', () => {
+  it('passes valid input with extra unlisted properties through to executor unchanged', async () => {
+    const registry = new ToolRegistry();
+    const schema = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    const executorInputs: Record<string, unknown>[] = [];
+
+    registry.register(
+      {
+        name: 'test_tool',
+        description: 'Test tool',
+        inputSchema: schema,
+      },
+      async input => {
+        executorInputs.push(input);
+        return 'result';
+      }
+    );
+
+    const result = await registry.execute('test_tool', {location: 'Paris', extra: 'value', another: 123});
+
+    expect({
+      executorCalls: executorInputs.length,
+      inputUnchanged: executorInputs[0],
+      resultSuccess: result.result,
+    }).toEqual({
+      executorCalls: 1,
+      inputUnchanged: {location: 'Paris', extra: 'value', another: 123},
+      resultSuccess: 'result',
+    });
+  });
+
+  // ([validated by: compiles a static tools schema once across multiple execute calls](specs/hal-engine-tool-input-validation/spec.md#L20))
+  it('compiles a static tools schema once across multiple execute calls', async () => {
+    const registry = new ToolRegistry();
+    const schema = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    let compileCount = 0;
+    // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    const registryRef = registry as any;
+    const originalCompile = registryRef.compileSchema.bind(registry);
+    registryRef.compileSchema = (s: unknown, name: string) => {
+      if (s === schema) compileCount += 1;
+      return originalCompile(s, name);
+    };
+
+    registry.register(
+      {
+        name: 'test_tool',
+        description: 'Test tool',
+        inputSchema: schema,
+      },
+      async () => 'result'
+    );
+
+    for (let i = 0; i < 10; i++) {
+      await registry.execute('test_tool', {location: 'test'});
+    }
+
+    expect(compileCount).toBe(1);
+  });
+
+  // ([validated by: validates function-valued schema against current schema](specs/hal-engine-tool-input-validation/spec.md#L21))
+  it('validates function-valued tool definition against current schema on each call', async () => {
+    const registry = new ToolRegistry();
+    const executorInputs: Record<string, unknown>[] = [];
+    let schemaVersion = 1;
+
+    registry.register(
+      () => ({
+        name: 'dynamic_tool',
+        description: 'Dynamic schema tool',
+        inputSchema:
+          schemaVersion === 1
+            ? {type: 'object', properties: {value: {type: 'string'}}, required: ['value']}
+            : {type: 'object', properties: {value: {type: 'number'}}, required: ['value']},
+      }),
+      async input => {
+        executorInputs.push(input);
+        return 'ok';
+      }
+    );
+
+    const result1 = await registry.execute('dynamic_tool', {value: 'text'});
+
+    schemaVersion = 2;
+    const result2 = await registry.execute('dynamic_tool', {value: 'text'});
+
+    expect({
+      firstCallSuccess: result1.result === 'ok',
+      executorCallsAfterRejection: executorInputs.length,
+      secondCallRejected: result2.result.includes('type'),
+    }).toEqual({
+      firstCallSuccess: true,
+      executorCallsAfterRejection: 1,
+      secondCallRejected: true,
+    });
+  });
+
+  // ([validated by: throws Unknown tool error for unregistered tool names](specs/hal-engine-tool-input-validation/spec.md#L15))
+  it('throws Unknown tool error for unregistered tool names', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('nonexistent_tool', {})).rejects.toThrow('Unknown tool: nonexistent_tool');
+  });
+});
