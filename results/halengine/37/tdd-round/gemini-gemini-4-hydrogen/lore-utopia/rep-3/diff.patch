+    }).toEqual({
+      rejectedMentionsUnit: true,
+      rejectedMentionsAllowed: true,
+      rejectedLeaksOffendingValue: false,
+      acceptedResult: 'ok',
+      receivedInputs: [{unit: 'celsius', extraRegion: 'eu'}],
+    });
+  });
+
+  it('throws Unknown tool when execute is called with an unregistered tool name', async () => {
+    const registry = new ToolRegistry();
+    let caughtMessage = '';
+
+    try {
+      await registry.execute('missing_tool', {});
+    } catch (error) {
+      caughtMessage = error instanceof Error ? error.message : String(error);
+    }
+
+    expect(caughtMessage).toBe('Unknown tool: missing_tool');
+  });
+
+  it('compiles a static inputSchema once at register and reuses it across ten execute calls', async () => {
+    const registry = new ToolRegistry();
+    let schemaPropertyReads = 0;
+    const inputSchema: Record<string, unknown> = {
+      type: 'object',
+      required: ['city'],
+    };
+    Object.defineProperty(inputSchema, 'properties', {
+      enumerable: true,
+      get() {
+        schemaPropertyReads += 1;
+        return {city: {type: 'string'}};
+      },
+    });
+
+    registry.register(
+      {
+        name: 'city_weather',
+        description: 'Look up weather for a city',
+        inputSchema,
+      },
+      async input => String(input.city)
+    );
+
+    const readsAtRegister = schemaPropertyReads;
+    schemaPropertyReads = 0;
+
+    const results: string[] = [];
+    for (let attempt = 0; attempt < 10; attempt += 1) {
+      const response = await registry.execute('city_weather', {city: 'Berlin'});
+      results.push(response.result);
+    }
+
+    expect({
+      compiledOnRegister: readsAtRegister > 0,
+      readsDuringExecutes: schemaPropertyReads,
+      executeCount: results.length,
+    }).toEqual({
+      compiledOnRegister: true,
+      readsDuringExecutes: 0,
+      executeCount: 10,
+    });
+  });
+
+  it('formats nested required paths, union types, root failures, and other schema constraints without leaking values', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'schedule_trip',
+        description: 'Schedule a trip',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            guest: {
+              type: 'object',
+              properties: {nights: {type: 'number'}},
+              required: ['nights'],
+            },
+            amount: {type: ['string', 'number']},
+            tag: {type: 'string', minLength: 3},
+          },
+          required: ['guest'],
+        },
+      },
+      async () => 'scheduled'
+    );
+    registry.register(
+      {
+        name: 'pick_mode',
+        description: 'Pick a mode',
+        inputSchema: {enum: ['fast', 'accurate']},
+      },
+      async () => 'picked'
+    );
+
+    const fieldErrors = await registry.execute('schedule_trip', {
+      guest: {},
+      amount: true,
+      tag: 'x',
+    });
+    const rootTypeError = await registry.execute('schedule_trip', [] as unknown as Record<string, unknown>);
+    const rootEnumError = await registry.execute('pick_mode', 'secret-mode' as unknown as Record<string, unknown>);
+
+    expect({
+      nestedRequired: fieldErrors.result.includes('guest.nights: missing required property'),
+      unionType: fieldErrors.result.includes('amount: must be string | number'),
+      minLengthFallback: /tag: (?:must|should) NOT (?:have fewer|be shorter) than 3 characters/.test(
+        fieldErrors.result
+      ),
+      rootType: rootTypeError.result.includes('(root): must be object'),
+      rootEnum: rootEnumError.result.includes('(root): must be one of "fast", "accurate"'),
+      leaksRootEnumValue: rootEnumError.result.includes('secret-mode'),
+    }).toEqual({
+      nestedRequired: true,
+      unionType: true,
+      minLengthFallback: true,
+      rootType: true,
+      rootEnum: true,
+      leaksRootEnumValue: false,
+    });
+  });
+
+  it('preserves clientMessages and suppressAssistantResponse when executor returns a ToolResponse object', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'send_card',
+        description: 'Send a card directly to the client',
+        inputSchema: {
+          type: 'object',
+          properties: {title: {type: 'string'}},
+          required: ['title'],
+        },
+      },
+      async input => ({
+        result: `sent:${String(input.title)}`,
+        clientMessages: [{type: 'stream_end'}],
+        suppressAssistantResponse: true,
+      })
+    );
+
+    const response = await registry.execute('send_card', {title: 'Summary'});
+
+    expect(response).toEqual({
+      result: 'sent:Summary',
+      clientMessages: [{type: 'stream_end'}],
+      suppressAssistantResponse: true,
+    });
+  });
+});
