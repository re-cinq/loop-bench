+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+
+describe('ToolRegistry', () => {
+  afterEach(() => {
+    setLogger(undefined);
+  });
+
+  it('throws naming the tool and omits it from the registry when static inputSchema is malformed', () => {
+    const registry = new ToolRegistry();
+    let caughtMessage = '';
+
+    try {
+      registry.register(
+        {
+          name: 'lookup_user',
+          description: 'Look up a user record',
+          inputSchema: {
+            type: 'object',
+            required: 'userId',
+          },
+        },
+        async () => 'found'
+      );
+    } catch (error) {
+      caughtMessage = error instanceof Error ? error.message : String(error);
+    }
+
+    expect({
+      mentionsToolName: caughtMessage.includes('lookup_user'),
+      stillRegistered: registry.has('lookup_user'),
+    }).toEqual({
+      mentionsToolName: true,
+      stillRegistered: false,
+    });
+  });
+
+  it('caches compiled validators for function-valued definitions by inputSchema reference', async () => {
+    const registry = new ToolRegistry();
+    const firstSchema: Record<string, unknown> = {
+      type: 'object',
+      properties: {city: {type: 'string'}},
+      required: ['city'],
+    };
+    const replacementSchema: Record<string, unknown> = {
+      type: 'object',
+      required: 'city',
+    };
+    let activeSchema = firstSchema;
+
+    registry.register(
+      () => ({
+        name: 'dynamic_weather',
+        description: 'Look up weather',
+        inputSchema: activeSchema,
+      }),
+      async () => 'sunny'
+    );
+
+    const firstResult = await registry.execute('dynamic_weather', {city: 'Paris'});
+
+    firstSchema.required = 'city';
+    const cachedResult = await registry.execute('dynamic_weather', {city: 'Paris'});
+
+    activeSchema = replacementSchema;
+    let replacementError = '';
+    try {
+      await registry.execute('dynamic_weather', {city: 'Paris'});
+    } catch (error) {
+      replacementError = error instanceof Error ? error.message : String(error);
+    }
+
+    expect({
+      firstResult: firstResult.result,
+      cachedResult: cachedResult.result,
+      mentionsToolOnNewSchemaError: replacementError.includes('dynamic_weather'),
+    }).toEqual({
+      firstResult: 'sunny',
+      cachedResult: 'sunny',
+      mentionsToolOnNewSchemaError: true,
+    });
+  });
+
+  it('rejects invalid input before calling executor and omits offending values from result and logs', async () => {
+    const recordedLogs: string[] = [];
+    const recordLog = (category: string, message: string, fields?: Record<string, unknown>) => {
+      recordedLogs.push(JSON.stringify({category, message, fields}));
+    };
+    const logger: Logger = {debug: recordLog, info: recordLog, warn: recordLog, error: recordLog};
+    setLogger(logger);
+
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'create_booking',
+        description: 'Create a booking',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            guest: {
+              type: 'object',
+              properties: {nights: {type: 'number'}},
+              required: ['nights'],
+            },
+            destination: {type: 'string'},
+          },
+          required: ['guest', 'destination'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'booked';
+      }
+    );
+
+    const response = await registry.execute('create_booking', {
+      guest: {nights: 'secret-invalid-value'},
+    });
+
+    expect({
+      executorCalls,
+      mentionsNestedField: response.result.includes('guest.nights'),
+      mentionsExpectedType: response.result.includes('number'),
+      mentionsMissingField: response.result.includes('destination') && /required/i.test(response.result),
+      leaksValueInResult: response.result.includes('secret-invalid-value'),
+      leaksValueInLogs: recordedLogs.some(line => line.includes('secret-invalid-value')),
+    }).toEqual({
+      executorCalls: 0,
+      mentionsNestedField: true,
+      mentionsExpectedType: true,
+      mentionsMissingField: true,
+      leaksValueInResult: false,
+      leaksValueInLogs: false,
+    });
+  });
+
+  it('passes valid input with extra properties through unchanged and rejects invalid enum values', async () => {
+    const registry = new ToolRegistry();
+    const receivedInputs: Array<Record<string, unknown>> = [];
+    registry.register(
+      {
+        name: 'forecast_lookup',
+        description: 'Look up forecast with unit selection',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            unit: {type: 'string', enum: ['celsius', 'fahrenheit']},
+            days: {type: 'number', default: 3},
+          },
+          required: ['unit'],
+        },
+      },
+      async input => {
+        receivedInputs.push(input);
+        return 'ok';
+      }
