+  } catch (error) {
+    const reason = error instanceof Error ? error.message : String(error);
+    throw new Error(`Invalid inputSchema for tool "${definition.name}": ${reason}`, {cause: error});
+  }
+}
+
+function formatValidationErrors(errors: ErrorObject[] | null | undefined): string[] {
+  if (!errors || errors.length === 0) return ['input failed schema validation'];
+  return errors.map(formatValidationError);
+}
+
+type KeywordFormatter = (basePath: string, params: Map<string, unknown>) => string;
+
+const KEYWORD_FORMATTERS: Record<string, KeywordFormatter> = {
+  required: formatRequiredError,
+  type: formatTypeError,
+  enum: formatEnumError,
+};
+
+function formatValidationError(error: ErrorObject): string {
+  const pathHolder: {instancePath?: string; dataPath?: string} = error;
+  const rawPath = pathHolder.instancePath ?? pathHolder.dataPath ?? '';
+  const basePath = rawPath.replace(/^[./]/, '').replace(/\//g, '.');
+  const params = new Map<string, unknown>(Object.entries(error.params));
+  if (Object.hasOwn(KEYWORD_FORMATTERS, error.keyword)) {
+    return KEYWORD_FORMATTERS[error.keyword](basePath, params);
+  }
+  return `${basePath || '(root)'}: ${error.message ?? error.keyword}`;
+}
+
+function formatRequiredError(basePath: string, params: Map<string, unknown>): string {
+  const missingProperty = String(params.get('missingProperty'));
+  const requiredPath = basePath ? `${basePath}.${missingProperty}` : missingProperty;
+  return `${requiredPath}: missing required property`;
+}
+
+function formatTypeError(basePath: string, params: Map<string, unknown>): string {
+  const expected = params.get('type');
+  const expectedType = String(expected).split(',').join(' | ');
+  return `${basePath || '(root)'}: must be ${expectedType}`;
+}
+
+function formatEnumError(basePath: string, params: Map<string, unknown>): string {
+  const fieldPath = basePath || '(root)';
+  const allowedValues = params.get('allowedValues');
+  const allowedOptions = Array.isArray(allowedValues) ? allowedValues : [];
+  const allowedList = allowedOptions.map(allowedOption => JSON.stringify(allowedOption)).join(', ');
+  return `${fieldPath}: must be one of ${allowedList}`;
 }