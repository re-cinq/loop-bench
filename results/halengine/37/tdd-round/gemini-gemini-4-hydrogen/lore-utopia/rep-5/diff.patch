+import {jest} from '@jest/globals';
+import AjvImport from 'ajv';
+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+
+describe('ToolRegistry', () => {
+  afterEach(() => {
+    setLogger(undefined);
+    jest.restoreAllMocks();
+  });
+
+  it('throws at register time naming the tool when a static inputSchema is uncompilable', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_tool',
+          description: 'Tool with an invalid JSON Schema type',
+          inputSchema: {
+            type: 'object',
+            properties: {query: {type: 'invalid-type'}},
+          },
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken_tool/);
+  });
+
+  it('caches compiled validators for function-valued tool definitions by schema object reference', async () => {
+    let schemaAReads = 0;
+    let schemaBReads = 0;
+    const schemaA = buildTrackedSchema(() => {
+      schemaAReads += 1;
+    });
+    const schemaB = buildTrackedSchema(() => {
+      schemaBReads += 1;
+    });
+    const schemas = [schemaA, schemaA, schemaB];
+    let callIndex = 0;
+
+    const registry = new ToolRegistry();
+    registry.register(
+      () => ({
+        name: 'dynamic_tool',
+        description: 'Tool whose schema can vary per call',
+        inputSchema: schemas[Math.min(callIndex, schemas.length - 1)],
+      }),
+      async input => String(input.location ?? '')
+    );
+
+    await registry.execute('dynamic_tool', {location: 'Paris'});
+    callIndex += 1;
+    const readsAfterFirstA = schemaAReads;
+
+    await registry.execute('dynamic_tool', {location: 'Berlin'});
+    callIndex += 1;
+    const readsAfterSecondA = schemaAReads;
+
+    await registry.execute('dynamic_tool', {location: 'Tokyo'});
+
+    expect({
+      firstCompiled: readsAfterFirstA > 0,
+      cachedOnSameSchema: readsAfterSecondA === readsAfterFirstA,
+      compiledNewSchema: schemaBReads > 0,
+    }).toEqual({
+      firstCompiled: true,
+      cachedOnSameSchema: true,
+      compiledNewSchema: true,
+    });
+  });
+
+  it('rejects invalid input before calling the executor, naming the failing path and constraint without leaking values', async () => {
+    const recordedLogs = captureLogLines();
+
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'record_lookup',
+        description: 'Look up a user record',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            filter: {
+              type: 'object',
+              properties: {
+                secretCode: {type: 'string'},
+              },
+              required: ['secretCode'],
+            },
+          },
+          required: ['filter'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'ok';
+      }
+    );
+
+    const missingResponse = await registry.execute('record_lookup', {});
+    const wrongTypeResponse = await registry.execute('record_lookup', {filter: {secretCode: 987654321}});
+
+    expect({
+      executorCalls,
+      missingMentionsFilterRequired:
+        missingResponse.result.includes('filter') && /required/i.test(missingResponse.result),
+      wrongTypeMentionsPathAndType:
+        wrongTypeResponse.result.includes('filter.secretCode') && wrongTypeResponse.result.includes('string'),
+      leaksValueInResult: wrongTypeResponse.result.includes('987654321'),
+      leaksValueInLogs: recordedLogs.some(line => line.includes('987654321')),
+    }).toEqual({
+      executorCalls: 0,
+      missingMentionsFilterRequired: true,
+      wrongTypeMentionsPathAndType: true,
+      leaksValueInResult: false,
+      leaksValueInLogs: false,
+    });
+  });
+
+  it('passes extra properties unchanged without defaults or coercion and rejects enum errors', async () => {
+    const registry = new ToolRegistry();
+    const receivedInputs: Array<Record<string, unknown>> = [];
+    registry.register(
+      {
+        name: 'forecast',
+        description: 'Get forecast for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+            unit: {type: 'string', enum: ['celsius', 'fahrenheit'], default: 'celsius'},
+            days: {type: 'number'},
+          },
+          required: ['location'],
+        },
+      },
+      async input => {
+        receivedInputs.push(input);
+        return 'ok';
+      }
+    );
+
+    const validResponse = await registry.execute('forecast', {location: 'Paris', extraNote: 'keep-me'});
+    const enumResponse = await registry.execute('forecast', {location: 'Paris', unit: 'kelvin'});
+    const uncoercedResponse = await registry.execute('forecast', {location: 'Paris', days: '3'});
+
+    expect({
+      validResult: validResponse.result,
+      receivedInputs,
+      enumMentionsUnit: enumResponse.result.includes('unit'),
+      uncoercedMentionsDaysAndNumber:
+        uncoercedResponse.result.includes('days') && uncoercedResponse.result.includes('number'),
+    }).toEqual({
+      validResult: 'ok',
+      receivedInputs: [{location: 'Paris', extraNote: 'keep-me'}],
+      enumMentionsUnit: true,
+      uncoercedMentionsDaysAndNumber: true,
+    });
+  });
+
+  it('compiles a static inputSchema once at register time and reuses it across ten execute calls', async () => {
+    let schemaReads = 0;
+    const staticSchema = buildTrackedSchema(() => {
+      schemaReads += 1;
+    });
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'static_weather',
+        description: 'Get weather for a city',
+        inputSchema: staticSchema,
+      },
+      async input => `ok:${String(input.location ?? '')}`
+    );
+    const readsAfterRegister = schemaReads;
+
+    const results: string[] = [];
+    for (let call = 0; call < 10; call += 1) {
+      const response = await registry.execute('static_weather', {location: 'Paris'});
+      results.push(response.result);
+    }
+
+    expect({
+      compiledAtRegister: readsAfterRegister > 0,
+      noRecompileAcrossTenCalls: schemaReads === readsAfterRegister,
+      allSucceeded: results.every(result => result === 'ok:Paris'),
+    }).toEqual({
+      compiledAtRegister: true,
+      noRecompileAcrossTenCalls: true,
+      allSucceeded: true,
+    });
+  });
+
+  it('throws Unknown tool when execute is called with an unregistered tool name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('unregistered_tool', {})).rejects.toThrow('Unknown tool: unregistered_tool');
+  });
+
+  it('names the dotted field path when a nested required property is omitted', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'weather_lookup',
+        description: 'Look up forecast by nested query',
+        inputSchema: {
+          type: 'object',
+          properties: {query: {type: 'object', properties: {city: {type: 'string'}}, required: ['city']}},
+          required: ['query'],
+        },
+      },
+      async () => 'ok'
+    );
+
+    const response = await registry.execute('weather_lookup', {query: {}});
+
+    expect(response.result).toBe('Invalid input for tool "weather_lookup": query.city: missing required property');
+  });
+
+  it('formats error paths whether the validator reports dataPath or instancePath', async () => {
+    const errorQueue: Array<Record<string, unknown>> = [
+      {keyword: 'required', dataPath: '', params: {missingProperty: 'location'}},
+      {keyword: 'type', dataPath: '.filter.secretCode', message: 'should be string'},
+      {keyword: 'type', instancePath: '/filter/secretCode', message: 'must be string'},
+      {keyword: 'type'},
+    ];
+    jest.spyOn(resolveAjvPrototype(AjvImport), 'compile').mockImplementation(() => {
+      const validateFn = Object.assign(
+        () => {
+          validateFn.errors = errorQueue.splice(0, 1);
+          return false;
+        },
+        {errors: [] as Array<Record<string, unknown>>}
+      );
+      return validateFn;
+    });
+    const registry = new ToolRegistry();
+    registry.register(
+      {name: 'compat_tool', description: 'checks error path compatibility', inputSchema: {type: 'object'}},
+      async () => 'ok'
+    );
+
+    const rootRequiredResult = await registry.execute('compat_tool', {});
+    const dottedPathResult = await registry.execute('compat_tool', {});
+    const slashPathResult = await registry.execute('compat_tool', {});
+    const pathlessResult = await registry.execute('compat_tool', {});
+
+    expect({
+      rootRequired: rootRequiredResult.result,
+      dottedPath: dottedPathResult.result,
+      slashPath: slashPathResult.result,
+      pathless: pathlessResult.result,
+    }).toEqual({
+      rootRequired: 'Invalid input for tool "compat_tool": location: missing required property',
+      dottedPath: 'Invalid input for tool "compat_tool": filter.secretCode: should be string',
+      slashPath: 'Invalid input for tool "compat_tool": filter.secretCode: must be string',
+      pathless: 'Invalid input for tool "compat_tool": input: type',
+    });
+  });
+});
+
+interface AjvPrototype {
+  compile(schema: Record<string, unknown>): unknown;
+}
+
+function resolveAjvPrototype(imported: unknown): AjvPrototype {
+  if (typeof imported !== 'object' || imported === null) {
+    return (imported as {prototype: AjvPrototype}).prototype;
+  }
+  if ('default' in imported) {
+    const ajvClass = (imported as {default: {prototype: AjvPrototype}}).default;
+    return ajvClass.prototype;
+  }
+  return (imported as {prototype: AjvPrototype}).prototype;
+}
+
+function buildTrackedSchema(onPropertyRead: () => void): Record<string, unknown> {
+  const schema: Record<string, unknown> = {type: 'object'};
+  Object.defineProperty(schema, 'properties', {
+    enumerable: true,
+    get() {
+      onPropertyRead();
+      return {location: {type: 'string'}};
+    },
+  });
+  return schema;
+}
+
+function captureLogLines(): string[] {
+  const lines: string[] = [];
+  const append = (category: string, message: string, fields?: Record<string, unknown>) => {
+    lines.push(JSON.stringify({category, message, fields}));
+  };
+  setLogger({debug: append, info: append, warn: append, error: append});
+  return lines;
+}
