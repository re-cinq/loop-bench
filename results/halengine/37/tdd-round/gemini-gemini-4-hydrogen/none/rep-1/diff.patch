@@ -0,0 +1,139 @@
+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+
+describe('ToolRegistry', () => {
+  afterEach(() => {
+    setLogger(undefined);
+  });
+
+  it('throws at register time naming the tool for an uncompilable static schema', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_tool',
+          description: 'Has an invalid JSON Schema type',
+          inputSchema: {
+            type: 'object',
+            properties: {location: {type: 'not-a-json-schema-type'}},
+          },
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken_tool/);
+  });
+
+  it('caches compiled validators by schema object reference for function-valued tool definitions', async () => {
+    let schemaAReads = 0;
+    const schemaA: Record<string, unknown> = {
+      type: 'object',
+      get properties() {
+        schemaAReads += 1;
+        return {location: {type: 'string'}};
+      },
+    };
+    let currentSchema = schemaA;
+    const registry = new ToolRegistry();
+    registry.register(
+      () => ({
+        name: 'weather',
+        description: 'Get weather',
+        inputSchema: currentSchema,
+      }),
+      async () => 'ok'
+    );
+
+    await registry.execute('weather', {location: 'Paris'});
+    const readsAfterFirstA = schemaAReads;
+    await registry.execute('weather', {location: 'Berlin'});
+    const readsAfterSecondA = schemaAReads;
+
+    let schemaBReads = 0;
+    const schemaB: Record<string, unknown> = {
+      type: 'object',
+      get properties() {
+        schemaBReads += 1;
+        return {city: {type: 'string'}};
+      },
+    };
+    currentSchema = schemaB;
+    await registry.execute('weather', {city: 'London'});
+
+    expect({
+      compiledA: readsAfterFirstA > 0,
+      reusedA: readsAfterSecondA === readsAfterFirstA,
+      compiledB: schemaBReads > 0,
+    }).toEqual({
+      compiledA: true,
+      reusedA: true,
+      compiledB: true,
+    });
+  });
+
+  it('rejects invalid input with field paths and constraints without calling executor or leaking values', async () => {
+    const loggedEntries: string[] = [];
+    const capture = (category: string, message: string, fields?: Record<string, unknown>) =>
+      loggedEntries.push(`${category}:${message}:${JSON.stringify(fields ?? {})}`);
+    setLogger({debug: capture, info: capture, warn: capture, error: capture});
+
