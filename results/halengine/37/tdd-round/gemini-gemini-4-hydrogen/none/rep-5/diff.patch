+      firstResultMentionsQuery: true,
+      firstResultMentionsRequired: true,
+      secondResult: 'found hal',
+    });
+  });
 });
+
+function toolResultTexts(content: ToolCallContent[] | ToolResultContent[]): string[] {
+  const texts: string[] = [];
+  for (const block of content) {
+    if (block.type === 'tool_result') texts.push(block.content);
+  }
+  return texts;
+}
