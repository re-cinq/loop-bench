+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+
+describe('ToolRegistry', () => {
+  afterEach(() => {
+    setLogger(undefined);
+  });
+
+  it('throws synchronously naming the tool when registering an invalid static inputSchema', () => {
+    const registry = new ToolRegistry();
+    const schema = {type: 'object', properties: {count: {type: 'unknown_type'}}};
+
+    expect(() =>
+      registry.register({name: 'broken_counter', description: 'Counts items', inputSchema: schema}, async () => '0')
+    ).toThrow(/broken_counter/);
+  });
+
+  it('reuses the static validator across repeated execute calls without re-reading inputSchema', async () => {
+    let schemaReads = 0;
+    const schema = {type: 'object', properties: {location: {type: 'string'}}};
+    const definition = {
+      name: 'get_weather',
+      description: 'Get weather',
+      get inputSchema() {
+        schemaReads += 1;
+        return schema;
+      },
+    };
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(definition, async () => {
+      executorCalls += 1;
+      return 'sunny';
+    });
+    const readsAtRegister = schemaReads;
+
+    for (let i = 0; i < 10; i += 1) {
+      await registry.execute('get_weather', {location: 'Paris'});
+    }
+
+    expect({readsAtRegister, schemaReads, executorCalls}).toEqual({
+      readsAtRegister: 1,
+      schemaReads: 1,
+      executorCalls: 10,
+    });
+  });
+
+  it('caches compiled validators by schema reference for function-valued tool sources', async () => {
+    const trackedA = trackedSchema({city: {type: 'string'}});
+    let sourceCalls = 0;
+    let currentSchema = trackedA.schema;
+
+    const registry = new ToolRegistry();
+    registry.register(
+      () => {
+        sourceCalls += 1;
+        return {
