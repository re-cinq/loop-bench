+      missingMentionsRequired: true,
+      mismatchMentionsPath: true,
+      mismatchMentionsType: true,
+      mismatchMentionsEnumField: true,
+      leaksOffendingValuesInResult: false,
+      leaksOffendingValuesInLogs: false,
+      receivedInputs: [validInput],
+      validResponse: {result: 'ok'},
+    });
+  });
+
+  it('throws Unknown tool: <name> when executing an unregistered tool', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('missing_tool', {})).rejects.toThrow('Unknown tool: missing_tool');
+  });
+});
+
+function captureLogEntries(): string[] {
+  const captured: string[] = [];
+  const sink: Logger['warn'] = (...payload) => {
+    captured.push(JSON.stringify(payload));
+  };
+  setLogger({debug: sink, info: sink, warn: sink, error: sink});
+  return captured;
+}
+
+function trackedSchema(
+  properties: Record<string, unknown>,
+  required?: string[]
+): {
+  schema: Record<string, unknown>;
+  getCompileReads: () => number;
+} {
+  let compileReads = 0;
+  const schema: Record<string, unknown> = required ? {type: 'object', required} : {type: 'object'};
+  Object.defineProperty(schema, 'properties', {
+    enumerable: true,
+    get() {
+      compileReads += 1;
+      return properties;
+    },
+  });
+  return {
+    schema,
+    getCompileReads: () => compileReads,
+  };
+}
