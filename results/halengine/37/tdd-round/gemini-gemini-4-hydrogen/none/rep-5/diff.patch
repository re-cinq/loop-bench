+
+  it('validates input against inputSchema before execution without leaking values or altering valid extra fields', async () => {
+    const receivedInputs: Array<Record<string, unknown>> = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'forecast',
+        description: 'Forecast weather',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+            unit: {type: 'string', enum: ['celsius', 'fahrenheit']},
+            options: {
+              type: 'object',
+              properties: {days: {type: 'number'}},
+              required: ['days'],
+            },
+          },
+          required: ['location'],
+        },
+      },
+      async input => {
+        receivedInputs.push(input);
+        return 'ok';
+      }
+    );
+
+    const logEntries = captureLogEntries();
+    const missingResponse = await registry.execute('forecast', {});
+    const mismatchResponse = await registry.execute('forecast', {
+      location: 'Paris',
+      unit: 'kelvin-secret',
+      options: {days: 'three-secret'},
+    });
+    const validInput = {location: 'Paris', unit: 'celsius', options: {days: 3}, extra: 'keep'};
+    const validResponse = await registry.execute('forecast', validInput);
+
+    expect({
+      missingMentionsLocation: missingResponse.result.includes('location'),
+      missingMentionsRequired: /required/i.test(missingResponse.result),
+      mismatchMentionsPath: mismatchResponse.result.includes('options.days'),
+      mismatchMentionsType: mismatchResponse.result.includes('number'),
