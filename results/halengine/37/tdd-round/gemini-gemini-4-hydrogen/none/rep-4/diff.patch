+
+function resolveValidator(
+  tool: StoredTool,
+  dynamicValidators: WeakMap<Record<string, unknown>, ValidateFunction>
+): ValidateFunction {
+  if (tool.staticValidate) {
+    return tool.staticValidate;
+  }
+  const resolved = typeof tool.definitionSource === 'function' ? tool.definitionSource() : tool.definitionSource;
+  const cachedValidator = dynamicValidators.get(resolved.inputSchema);
+  if (cachedValidator) {
+    return cachedValidator;
+  }
+  const compiledValidator = compileInputSchema(resolved.name, resolved.inputSchema);
+  dynamicValidators.set(resolved.inputSchema, compiledValidator);
+  return compiledValidator;
+}
+
+function compileInputSchema(toolName: string, inputSchema: Record<string, unknown>): ValidateFunction {
+  try {
+    return schemaValidator.compile(inputSchema);
+  } catch (error) {
+    const reason = error instanceof Error ? error.message : String(error);
+    throw new Error(`Invalid inputSchema for tool "${toolName}": ${reason}`, {cause: error});
+  }
+}