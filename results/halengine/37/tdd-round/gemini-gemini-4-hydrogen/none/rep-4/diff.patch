+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+
+describe('ToolRegistry', () => {
+  afterEach(() => {
+    setLogger(undefined);
+  });
+
+  it('throws synchronously from register naming the tool when a static inputSchema is invalid', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'invalid_weather',
+          description: 'Has an invalid JSON Schema property type',
+          inputSchema: {
+            type: 'object',
+            properties: {location: {type: 'not-a-json-schema-type'}},
+          },
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow(/invalid_weather/);
+  });
+
+  it('reuses the compiled static validator across execute calls without re-reading inputSchema', async () => {
+    let schemaReads = 0;
+    let propertyReads = 0;
+    const inputSchema: Record<string, unknown> = {
+      type: 'object',
+      required: ['location'],
+    };
+    Object.defineProperty(inputSchema, 'properties', {
+      enumerable: true,
+      get() {
+        propertyReads += 1;
+        return {location: {type: 'string'}};
+      },
+    });
+    const definition = {
+      name: 'get_weather',
+      description: 'Get weather for a location',
+      get inputSchema() {
+        schemaReads += 1;
+        return inputSchema;
+      },
+    };
+
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(definition, async input => {
+      executorCalls += 1;
+      return `sunny in ${String(input.location)}`;
+    });
+
+    const schemaReadsAfterRegister = schemaReads;
+    const propertyReadsAfterRegister = propertyReads;
+
+    const validResults: string[] = [];
+    for (let callIndex = 0; callIndex < 10; callIndex += 1) {
+      const response = await registry.execute('get_weather', {location: 'Paris'});
+      validResults.push(response.result);
+    }
+    const invalidResponse = await registry.execute('get_weather', {});
+    const invalidResult = invalidResponse.result;
+
+    expect({
+      schemaReadsAfterRegister,
+      schemaReadsAfterExecute: schemaReads,
+      propertyReadsAfterRegister,
+      propertyReadsAfterExecute: propertyReads,
+      executorCalls,
+      invalidRejected: invalidResult !== 'sunny in undefined' && invalidResult.length > 0,
+      validCount: validResults.filter(resultText => resultText === 'sunny in Paris').length,
+    }).toEqual({
+      schemaReadsAfterRegister: 1,
+      schemaReadsAfterExecute: 1,
+      propertyReadsAfterRegister,
+      propertyReadsAfterExecute: propertyReadsAfterRegister,
+      executorCalls: 10,
+      invalidRejected: true,
+      validCount: 10,
+    });
+  });
+
+  it('caches dynamic inputSchema validators by object reference and validates against the current schema on execute', async () => {
+    let schemaAPropertyReads = 0;
+    const schemaA: Record<string, unknown> = {
+      type: 'object',
+      required: ['city'],
+    };
+    Object.defineProperty(schemaA, 'properties', {
+      enumerable: true,
+      get() {
+        schemaAPropertyReads += 1;
+        return {city: {type: 'string'}};
+      },
+    });
+
+    let currentSchema = schemaA;
+    const registry = new ToolRegistry();
+    const executedInputs: Array<Record<string, unknown>> = [];
+    registry.register(
+      () => ({
+        name: 'dynamic_weather',
+        description: 'Get weather dynamically',
+        inputSchema: currentSchema,
+      }),
+      async input => {
+        executedInputs.push(input);
+        return 'ok';
+      }
+    );
+
+    const readsAfterRegister = schemaAPropertyReads;
+    const firstValid = await registry.execute('dynamic_weather', {city: 'Paris'});
+    const readsAfterFirstCompile = schemaAPropertyReads;
+    const secondValid = await registry.execute('dynamic_weather', {city: 'Lyon'});
+    const schemaAPhase = {
+      readsAfterRegister,
+      compiledOnFirstExecute: readsAfterFirstCompile > 0,
+      reusedCompiledSchema: schemaAPropertyReads === readsAfterFirstCompile,
+      firstValidResult: firstValid.result,
+      secondValidResult: secondValid.result,
+    };
+
+    const firstInvalid = await registry.execute('dynamic_weather', {});
+    const schemaB: Record<string, unknown> = {
+      type: 'object',
+      required: ['postalCode'],
+      properties: {postalCode: {type: 'string'}},
+    };
+    currentSchema = schemaB;
+    const staleInputRejected = await registry.execute('dynamic_weather', {city: 'Paris'});
+    const switchedValid = await registry.execute('dynamic_weather', {postalCode: '75001'});
+
+    expect({
+      ...schemaAPhase,
+      firstInvalidRejected: firstInvalid.result !== 'ok' && firstInvalid.result.length > 0,
+      staleInputRejected: staleInputRejected.result !== 'ok' && staleInputRejected.result.length > 0,
+      switchedValidResult: switchedValid.result,
+      executedInputs,
+    }).toEqual({
+      readsAfterRegister: 0,
+      compiledOnFirstExecute: true,
+      reusedCompiledSchema: true,
+      firstValidResult: 'ok',
+      firstInvalidRejected: true,
+      secondValidResult: 'ok',
+      staleInputRejected: true,
+      switchedValidResult: 'ok',
+      executedInputs: [{city: 'Paris'}, {city: 'Lyon'}, {postalCode: '75001'}],
+    });
+  });
+
+  it('returns a rejection ToolResponse naming failing field paths and constraints without leaking values or invoking the executor', async () => {
+    const loggedEntries: string[] = [];
+    const appendLog = (category: string, message: string, fields?: Record<string, unknown>) => {
+      loggedEntries.push(JSON.stringify({category, message, fields}));
+    };
+    const logger: Logger = {
+      debug: appendLog,
+      info: appendLog,
+      warn: appendLog,
+      error: appendLog,
+    };
+    setLogger(logger);
+
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'lookup_profile',
+        description: 'Look up a profile by location and postal code',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+            details: {
+              type: 'object',
+              properties: {
+                zip: {type: 'string'},
+              },
+              required: ['zip'],
+            },
+          },
+          required: ['location'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'profile';
+      }
+    );
+
+    const missingResponse = await registry.execute('lookup_profile', {});
+    const secretZip = '987654321';
+    const wrongTypeResponse = await registry.execute('lookup_profile', {
+      location: 'Paris',
+      details: {zip: 987654321},
+    });
+
+    expect({
+      executorCalls,
+      missingNamesLocation: missingResponse.result.includes('location'),
+      missingMentionsRequired: /required/i.test(missingResponse.result),
+      wrongTypeNamesPath: wrongTypeResponse.result.includes('details.zip'),
+      wrongTypeNamesExpectedType: wrongTypeResponse.result.includes('string'),
+      leaksValueInResult: wrongTypeResponse.result.includes(secretZip),
+      leaksValueInLogs: loggedEntries.some(entry => entry.includes(secretZip)),
+      logsPathAndConstraint: loggedEntries.some(entry => entry.includes('details.zip') && entry.includes('string')),
+    }).toEqual({
+      executorCalls: 0,
+      missingNamesLocation: true,
+      missingMentionsRequired: true,
+      wrongTypeNamesPath: true,
+      wrongTypeNamesExpectedType: true,
+      leaksValueInResult: false,
+      leaksValueInLogs: false,
+      logsPathAndConstraint: true,
+    });
+  });
+});
