+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+describe('ToolRegistry', () => {
+  afterEach(() => {
+    setLogger(undefined);
+  });
+
+  it('compiles a static inputSchema once at register time without re-reading it on execute', async () => {
+    const registry = new ToolRegistry();
+    let schemaReads = 0;
+    const definition: ToolDefinition = {
+      name: 'weather',
+      description: 'Get weather',
+      get inputSchema() {
+        schemaReads += 1;
+        return {type: 'object', properties: {location: {type: 'string'}}, required: ['location']};
+      },
+    };
+
+    registry.register(definition, async input => String(input.location));
+    const readsAtRegister = schemaReads;
+    for (let i = 0; i < 10; i++) {
+      await registry.execute('weather', {location: 'Oslo'});
+    }
+
+    const brokenError = captureThrow(() =>
+      registry.register(
+        {
+          name: 'broken_weather',
+          description: 'Has an uncompilable schema',
+          inputSchema: {type: 'object', properties: {location: {type: 'not-a-json-schema-type'}}},
+        },
+        async () => 'unreachable'
+      )
+    );
+
+    expect({
+      readsAtRegister,
+      readsAfterTenExecutes: schemaReads,
+      namesBrokenTool: brokenError.includes('broken_weather'),
+    }).toEqual({
+      readsAtRegister: 1,
+      readsAfterTenExecutes: 1,
+      namesBrokenTool: true,
+    });
+  });
+
+  it('caches compiled validators for function-valued definitions by schema object reference', async () => {
+    const registry = new ToolRegistry();
