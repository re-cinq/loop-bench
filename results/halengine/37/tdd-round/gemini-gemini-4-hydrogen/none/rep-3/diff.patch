+
+  it('feeds a schema rejection back as a tool_result so the model can retry and resolve', async () => {
+    const registry = new ToolRegistry();
+    const receivedInputs: Array<Record<string, unknown>> = [];
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async input => {
+        receivedInputs.push(input);
+        return `20C in ${String(input.location)}`;
+      }
+    );
+
+    const rounds: MessageChunk[][] = [
+      [{type: 'tool_use', toolCall: {id: 'c1', name: 'get_weather', input: {}}}, STOP_FOR_TOOL],
+      [{type: 'tool_use', toolCall: {id: 'c2', name: 'get_weather', input: {location: 'Madrid'}}}, STOP_FOR_TOOL],
+      [{type: 'text', text: '20C in Madrid'}, STOP_DONE],
+    ];
+    const observedResults: string[] = [];
+    let turn = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        const last = params.messages[params.messages.length - 1];
+        if (last.role === 'user' && Array.isArray(last.content)) {
+          const [firstPart] = last.content;
+          observedResults.push(firstPart?.content ?? '');
+        }
+        for (const chunk of rounds[turn++] ?? []) yield chunk;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+    const reply = await orchestrator.processMessage(createSession('Weather in Madrid?'));
+    const firstRejection = observedResults[0] ?? '';
+
+    expect({
+      reply,
+      receivedInputs,
+      rejectionVisibleToProvider: firstRejection.includes('location') && /required/i.test(firstRejection),
+    }).toEqual({
+      reply: '20C in Madrid',
+      receivedInputs: [{location: 'Madrid'}],
+      rejectionVisibleToProvider: true,
+    });
+  });
 });
