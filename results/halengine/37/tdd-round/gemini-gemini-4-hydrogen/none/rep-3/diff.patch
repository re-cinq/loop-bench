+function captureLogs(): string[] {
+  const entries: string[] = [];
+  const sink =
+    (level: string): Logger['info'] =>
+    (category, message, fields) =>
+      void entries.push(JSON.stringify({level, category, message, fields}));
+  setLogger({debug: sink('debug'), info: sink('info'), warn: sink('warn'), error: sink('error')});
+  return entries;
+}
+
+function trackSchemaCompilation(requiredField: string): {
+  schema: Record<string, unknown>;
+  reads: () => number;
+} {
+  let propertyReads = 0;
+  const schema: Record<string, unknown> = {
+    type: 'object',
+    get properties() {
+      propertyReads += 1;
+      return {[requiredField]: {type: 'string'}};
+    },
+    required: [requiredField],
+  };
+  return {schema, reads: () => propertyReads};
+}
+
+function captureThrow(action: () => void): string {
+  try {
+    action();
+    return '';
+  } catch (error) {
+    return error instanceof Error ? error.message : String(error);
+  }
+}
