+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+
+describe('ToolRegistry', () => {
+  afterEach(() => {
+    setLogger(undefined);
+  });
+
+  describe('register', () => {
+    it('throws at register time naming the tool when a static inputSchema is invalid', () => {
+      const registry = new ToolRegistry();
+
+      expect(() =>
+        registry.register(
+          {
+            name: 'broken_tool',
+            description: 'Tool with invalid schema',
+            inputSchema: {
+              type: 'object',
+              properties: {location: {type: 'not-a-json-schema-type'}},
+            },
+          },
+          async () => 'ok'
+        )
+      ).toThrow(/broken_tool/);
+    });
+  });
+
+  describe('execute', () => {
+    it('reuses the static validator compiled at register time without re-reading inputSchema', async () => {
+      let schemaReads = 0;
+      let executorCalls = 0;
+      const schema = {
+        type: 'object',
+        properties: {location: {type: 'string'}},
+        required: ['location'],
+      };
+      const registry = new ToolRegistry();
+      registry.register(
+        {
+          name: 'get_weather',
+          description: 'Get weather for a location',
+          get inputSchema() {
+            schemaReads += 1;
+            return schema;
+          },
+        },
+        async () => {
+          executorCalls += 1;
+          return 'sunny';
+        }
+      );
+
+      for (let call = 0; call < 9; call += 1) {
+        await registry.execute('get_weather', {location: 'Paris'});
+      }
+      const rejected = await registry.execute('get_weather', {});
+
+      expect({
+        schemaReads,
+        executorCalls,
+        rejectedWithoutExecutor: rejected.result.length > 0,
+      }).toEqual({
+        schemaReads: 1,
+        executorCalls: 9,
+        rejectedWithoutExecutor: true,
+      });
+    });
+
+    it('caches dynamic tool schema validators by reference and validates against the current schema', async () => {
+      let locationSchemaReads = 0;
+      const locationSchema: Record<string, unknown> = {
+        type: 'object',
+        get properties() {
+          locationSchemaReads += 1;
+          return {location: {type: 'string'}};
+        },
+        required: ['location'],
+      };
+
+      let activeSchema = locationSchema;
+      const executorInputs: Array<Record<string, unknown>> = [];
+      const registry = new ToolRegistry();
+      registry.register(
+        () => ({
+          name: 'get_weather',
+          description: 'Get weather for a location',
+          inputSchema: activeSchema,
+        }),
+        async input => {
+          executorInputs.push(input);
+          return 'sunny';
+        }
+      );
+
+      const locationReadCounts: number[] = [];
+      await registry.execute('get_weather', {location: 'Paris'});
+      locationReadCounts.push(locationSchemaReads);
+      await registry.execute('get_weather', {location: 'Berlin'});
+      locationReadCounts.push(locationSchemaReads);
+
+      let citySchemaReads = 0;
+      const citySchema: Record<string, unknown> = {
+        type: 'object',
+        get properties() {
+          citySchemaReads += 1;
+          return {city: {type: 'string'}};
+        },
+        required: ['city'],
+      };
+      activeSchema = citySchema;
+      const rejectedAfterSwitch = await registry.execute('get_weather', {location: 'Paris'});
+      const cityReadsAfterFirst = citySchemaReads;
+      await registry.execute('get_weather', {city: 'Paris'});
+      const cityReadsAfterSecond = citySchemaReads;
+
+      expect({
+        locationSchemaCached: locationReadCounts[0] > 0 && locationReadCounts[1] === locationReadCounts[0],
+        citySchemaCached: cityReadsAfterFirst > 0 && cityReadsAfterSecond === cityReadsAfterFirst,
+        executorInputs,
+        rejectedAfterSwitch: rejectedAfterSwitch.result.length > 0 && rejectedAfterSwitch.result !== 'sunny',
+      }).toEqual({
+        locationSchemaCached: true,
+        citySchemaCached: true,
+        executorInputs: [{location: 'Paris'}, {location: 'Berlin'}, {city: 'Paris'}],
+        rejectedAfterSwitch: true,
+      });
+    });
+
+    it('passes valid input including extra properties through unchanged while enforcing enum and without coercing or defaulting', async () => {
+      const receivedInputs: Array<Record<string, unknown>> = [];
+      const registry = new ToolRegistry();
+      registry.register(
+        {
+          name: 'forecast',
+          description: 'Forecast with enum and default metadata',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              city: {type: 'string'},
+              units: {type: 'string', enum: ['celsius', 'fahrenheit'], default: 'celsius'},
+              days: {type: 'number'},
+            },
+            required: ['city'],
+          },
+        },
+        async input => {
+          receivedInputs.push(input);
+          return 'forecast-ok';
+        }
+      );
+
+      const enumRejection = await registry.execute('forecast', {city: 'Paris', units: 'kelvin'});
+      const coercionRejection = await registry.execute('forecast', {city: 'Paris', days: '2'});
+      const acceptedResponse = await registry.execute('forecast', {city: 'Paris', extraNote: 'keep-me'});
+
+      expect({
+        receivedInputs,
+        acceptedResult: acceptedResponse.result,
+        rejectedEnumField: enumRejection.result.includes('units'),
+        rejectedStringNumber: coercionRejection.result.includes('days') && coercionRejection.result.includes('number'),
+      }).toEqual({
+        receivedInputs: [{city: 'Paris', extraNote: 'keep-me'}],
+        acceptedResult: 'forecast-ok',
+        rejectedEnumField: true,
+        rejectedStringNumber: true,
+      });
+    });
+
+    it('throws Unknown tool when execute is called for an unregistered tool', async () => {
+      const registry = new ToolRegistry();
+
+      await expect(registry.execute('missing_tool', {location: 'Paris'})).rejects.toThrow('Unknown tool: missing_tool');
+    });
+
+    it('names failing nested field paths and constraints in result and logs without leaking offending values', async () => {
+      const recordedLogs: string[] = [];
+      const captureLog = (category: string, message: string, fields?: Record<string, unknown>) => {
+        recordedLogs.push(JSON.stringify({category, message, fields}));
+      };
+      const logger: Logger = {
+        debug: captureLog,
+        info: captureLog,
+        warn: captureLog,
+        error: captureLog,
+      };
+      setLogger(logger);
+
+      const registry = new ToolRegistry();
+      let executorCalls = 0;
+      registry.register(
+        {
+          name: 'create_user',
+          description: 'Create a user profile',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              profile: {
+                type: 'object',
+                properties: {
+                  age: {type: 'number'},
+                },
+                required: ['age'],
+              },
+            },
+            required: ['profile'],
+          },
+        },
+        async () => {
+          executorCalls += 1;
+          return 'created';
+        }
+      );
+
+      const wrongType = await registry.execute('create_user', {profile: {age: 'sensitive-bad-age'}});
+      const missingRequired = await registry.execute('create_user', {profile: {}});
+      const loggedPathAndType = recordedLogs.some(line => line.includes('profile.age') && line.includes('number'));
+      const loggedOffendingValue = recordedLogs.some(line => line.includes('sensitive-bad-age'));
+
+      expect({
+        executorCalls,
+        wrongTypeNamesPathAndType: wrongType.result.includes('profile.age') && wrongType.result.includes('number'),
+        wrongTypeOmitsValue: !wrongType.result.includes('sensitive-bad-age'),
+        wrongTypeLogsPathWithoutValue: loggedPathAndType && !loggedOffendingValue,
+        missingRequiredNamesField: missingRequired.result.includes('age') && /required/i.test(missingRequired.result),
+      }).toEqual({
+        executorCalls: 0,
+        wrongTypeNamesPathAndType: true,
+        wrongTypeOmitsValue: true,
+        wrongTypeLogsPathWithoutValue: true,
+        missingRequiredNamesField: true,
+      });
+    });
+  });
+});
