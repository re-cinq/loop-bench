+    let secondRoundReceivedResult = '';
+    const round1ToolCall: MessageChunk = {
+      type: 'tool_use',
+      toolCall: {id: 'call-fail', name: 'search', input: {}},
+    };
+    const round2ToolCall: MessageChunk = {
