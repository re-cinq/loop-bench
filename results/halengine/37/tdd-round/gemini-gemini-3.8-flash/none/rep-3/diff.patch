+
+function extractToolResultContent(messages: readonly unknown[]): string {
+  const lastMessage = messages[messages.length - 1];
+  if (!lastMessage || typeof lastMessage !== 'object') {
+    return '';
+  }
+  if (!('content' in lastMessage) || !Array.isArray(lastMessage.content)) {
+    return '';
+  }
+  const firstContentBlock = lastMessage.content[0];
+  if (!firstContentBlock || typeof firstContentBlock !== 'object') {
+    return '';
+  }
+  if (!('content' in firstContentBlock) || typeof firstContentBlock.content !== 'string') {
+    return '';
+  }
+  return firstContentBlock.content;
+}
