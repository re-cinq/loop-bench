+import {jest} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry schema compilation', () => {
+  it('throws at register time naming the tool when a static inputSchema cannot be compiled', () => {
+    const registry = new ToolRegistry();
+    const badDefinition = {
+      name: 'broken_calculator',
+      description: 'Invalid schema definition',
+      inputSchema: {
+        type: 'object',
+        properties: {operation: {type: 'unsupported_json_schema_type'}},
+      },
+    };
+
+    expect(() => registry.register(badDefinition, async () => 'unreachable')).toThrow(/broken_calculator/);
+  });
+});
+
+describe('ToolRegistry execute input validation', () => {
+  it('rejects input missing a required property with a ToolResponse and never calls the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    const definition = {
+      name: 'lookup_weather',
+      description: 'Fetch weather report for location',
+      inputSchema: {
+        type: 'object',
+        properties: {location: {type: 'string'}},
+        required: ['location'],
+      },
+    };
+    registry.register(definition, async () => {
+      executorCalls += 1;
+      return 'weather_result';
+    });
+
+    const response = await registry.execute('lookup_weather', {});
+    const mentionsRequired = /required/i.test(response.result);
+    const mentionsLocation = response.result.includes('location');
+
+    expect({
+      executorCalls,
+      mentionsRequired,
+      mentionsLocation,
+    }).toEqual({
+      executorCalls: 0,
+      mentionsRequired: true,
+      mentionsLocation: true,
+    });
+  });
+
+  it('passes valid input with undeclared extra properties through to the executor unchanged', async () => {
+    const registry = new ToolRegistry();
+    let receivedPayload: Record<string, unknown> | undefined;
+    let callCount = 0;
+    registry.register(
+      {
+        name: 'save_record',
+        description: 'Saves a record',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            title: {type: 'string'},
+            priority: {type: 'string', enum: ['low', 'high']},
+          },
+          required: ['title'],
+        },
+      },
+      async input => {
+        callCount += 1;
+        receivedPayload = input;
+        return 'saved';
+      }
+    );
+
+    const extraInput = {title: 'Doc', priority: 'high', unlistedTag: 42, customFlag: true};
+    const response = await registry.execute('save_record', extraInput);
+
+    expect({
+      callCount,
+      responseResult: response.result,
+      receivedPayload,
+    }).toEqual({
+      callCount: 1,
+      responseResult: 'saved',
+      receivedPayload: extraInput,
+    });
+  });
+
+  it('throws Unknown tool when executing an unregistered tool name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('nonexistent_tool', {})).rejects.toThrow('Unknown tool: nonexistent_tool');
+  });
+
+  it('reuses compiled static validator across execute calls without recompiling', async () => {
+    const registry = new ToolRegistry();
+    const compileSpy = jest.spyOn(
+      registry as unknown as {compileSchema: (name: string, schema: Record<string, unknown>) => unknown},
+      'compileSchema'
+    );
+    registry.register(
+      {
+        name: 'echo_tag',
+        description: 'Echoes a tag',
+        inputSchema: {
+          type: 'object',
+          properties: {tag: {type: 'string'}},
+        },
+      },
+      async input => `echo-${input.tag}`
+    );
+
+    for (let i = 0; i < 10; i += 1) {
+      await registry.execute('echo_tag', {tag: `v${i}`});
+    }
+
+    expect(compileSpy).toHaveBeenCalledTimes(1);
+  });
+
+  it('validates dynamic tool definition against the schema current at that call', async () => {
+    const registry = new ToolRegistry();
+    let activeSchema = {
+      type: 'object',
+      properties: {stepOne: {type: 'string'}},
+      required: ['stepOne'],
+    };
+    registry.register(
+      () => ({
+        name: 'stepped_workflow',
+        description: 'Workflow with changing input schema',
+        inputSchema: activeSchema,
+      }),
+      async () => 'step_ok'
+    );
+
+    const validFirst = await registry.execute('stepped_workflow', {stepOne: 'alpha'});
+
+    activeSchema = {
+      type: 'object',
+      properties: {stepTwo: {type: 'string'}},
+      required: ['stepTwo'],
+    };
+
+    const rejectedSecond = await registry.execute('stepped_workflow', {stepOne: 'alpha'});
+
+    expect({
+      validResult: validFirst.result,
+      mentionsStepTwo: rejectedSecond.result.includes('stepTwo'),
+      mentionsRequired: /required/i.test(rejectedSecond.result),
+    }).toEqual({
+      validResult: 'step_ok',
+      mentionsStepTwo: true,
+      mentionsRequired: true,
+    });
+  });
+});
