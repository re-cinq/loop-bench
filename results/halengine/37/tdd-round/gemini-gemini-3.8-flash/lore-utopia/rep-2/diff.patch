+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry', () => {
+  it('throws at register time when the inputSchema is uncompilable and the message names the tool', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'invalid_calculator',
+          description: 'Fails compilation due to unknown property type',
+          inputSchema: {
+            type: 'object',
+            properties: {expression: {type: 'unrecognized_type'}},
+          },
+        },
+        async () => 'never'
+      )
+    ).toThrow(/invalid_calculator/);
+  });
+
+  it('returns a ToolResponse naming the missing required field and does not invoke the executor', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(
+      {
+        name: 'lookup_user',
+        description: 'Find user by username',
+        inputSchema: {
+          type: 'object',
+          properties: {username: {type: 'string'}},
+          required: ['username'],
+        },
+      },
+      async () => {
+        calls += 1;
+        return 'user-found';
+      }
+    );
+
+    const response = await registry.execute('lookup_user', {});
+
+    expect({
+      calls,
+      mentionsUsername: response.result.includes('username'),
+      mentionsRequired: /required/i.test(response.result),
+    }).toEqual({
+      calls: 0,
+      mentionsUsername: true,
+      mentionsRequired: true,
+    });
+  });
+});
