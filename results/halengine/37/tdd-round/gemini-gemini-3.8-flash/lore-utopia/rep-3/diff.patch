+        return 'catalog-item';
+      }
+    );
+
+    let observedRejection = '';
+    const turnSequence: Array<(params: SendMessageParams) => MessageChunk[]> = [
+      () => [
+        {type: 'tool_use', toolCall: {id: 'attempt-1', name: 'search_catalog', input: {}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      params => {
+        const history = params.messages;
+        const lastMessage = history[history.length - 1] as ToolResultMessage;
+        const contents = lastMessage.content;
+        const firstEntry = contents[0];
+        observedRejection = firstEntry?.content ?? '';
+        return [
+          {type: 'tool_use', toolCall: {id: 'attempt-2', name: 'search_catalog', input: {term: 'books'}}},
+          {type: 'stop', stopReason: 'tool_use'},
+        ];
+      },
+      () => [
+        {type: 'text', text: 'found book result'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ];
+
+    let currentTurnIndex = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        const handler = turnSequence[currentTurnIndex++];
+        const chunks = handler ? handler(params) : [];
+        for (const chunk of chunks) {
+          yield chunk;
+        }
