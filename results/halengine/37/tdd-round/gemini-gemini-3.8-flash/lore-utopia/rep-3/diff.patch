+import {jest} from '@jest/globals';
+import Ajv from 'ajv';
+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+
+describe('ToolRegistry schema compilation at register time', () => {
+  it('throws at register time when the inputSchema is uncompilable and the message names the tool', () => {
+    const registry = new ToolRegistry();
+
+    const registerInvalid = () => {
+      registry.register(
+        {
+          name: 'query_db',
+          description: 'Execute database query',
+          inputSchema: {
+            type: 'object',
+            properties: {sql: {type: 'unsupported-schema-primitive'}},
+          },
+        },
+        async () => 'rows'
+      );
+    };
+
+    expect(registerInvalid).toThrow(/query_db/);
+  });
+});
+
+describe('ToolRegistry input validation at execute time', () => {
+  it('returns a ToolResponse naming the missing required field and does not invoke the executor', async () => {
+    const registry = new ToolRegistry();
+    let invoked = false;
+
+    registry.register(
+      {
+        name: 'send_email',
+        description: 'Send email message',
+        inputSchema: {
+          type: 'object',
+          properties: {recipient: {type: 'string'}},
+          required: ['recipient'],
+        },
+      },
+      async () => {
+        invoked = true;
+        return 'sent';
+      }
+    );
+
+    const outcome = await registry.execute('send_email', {});
+
+    expect({
+      invoked,
+      hasRequiredProperty: outcome.result.includes('recipient') && /required/i.test(outcome.result),
+    }).toEqual({
+      invoked: false,
+      hasRequiredProperty: true,
+    });
+  });
+
+  it('rejects a wrong-typed property naming the field and expected type without leaking the offending value to the result or logs', async () => {
+    const logSnapshots: string[] = [];
+    const capture = (_kind: string, text: string, meta?: Record<string, unknown>) => {
+      logSnapshots.push(`${text} ${JSON.stringify(meta ?? {})}`);
+    };
+    setLogger({debug: capture, info: capture, warn: capture, error: capture});
+
+    try {
+      const registry = new ToolRegistry();
+      let executorCalls = 0;
+      registry.register(
+        {
+          name: 'lookup_user',
+          description: 'Lookup user by id',
+          inputSchema: {
+            type: 'object',
+            properties: {userId: {type: 'string'}},
+            required: ['userId'],
+          },
+        },
+        async () => {
+          executorCalls += 1;
+          return 'found';
+        }
+      );
+
+      const secretValue = 987654321;
+      const outcome = await registry.execute('lookup_user', {userId: secretValue});
+
+      expect({
+        executorCalls,
+        namesField: outcome.result.includes('userId'),
+        namesExpectedType: outcome.result.includes('string'),
+        omitsOffendingValueFromResult: !outcome.result.includes(String(secretValue)),
+        omitsOffendingValueFromLogs: logSnapshots.every(line => !line.includes(String(secretValue))),
+      }).toEqual({
+        executorCalls: 0,
+        namesField: true,
+        namesExpectedType: true,
+        omitsOffendingValueFromResult: true,
+        omitsOffendingValueFromLogs: true,
+      });
+    } finally {
+      setLogger(undefined);
+    }
+  });
+
+  it('passes valid input with unlisted extra property through to executor unchanged exactly once', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    let receivedInput: Record<string, unknown> | undefined;
+
+    registry.register(
+      {
+        name: 'echo',
+        description: 'Echo input',
+        inputSchema: {
+          type: 'object',
+          properties: {query: {type: 'string'}},
+          required: ['query'],
+        },
+      },
+      async input => {
+        executorCalls += 1;
+        receivedInput = input;
+        return 'ok';
+      }
+    );
+
+    const input = {query: 'search', extraField: 123, another: true};
+    const outcome = await registry.execute('echo', input);
+
+    expect({
+      result: outcome.result,
+      executorCalls,
+      receivedInput,
+    }).toEqual({
+      result: 'ok',
+      executorCalls: 1,
+      receivedInput: {query: 'search', extraField: 123, another: true},
+    });
+  });
+
+  it('throws Unknown tool when executing an unregistered tool name', async () => {
+    const registry = new ToolRegistry();
+    await expect(registry.execute('missing_tool', {})).rejects.toThrow('Unknown tool: missing_tool');
+  });
+});
+
+describe('ToolRegistry schema caching', () => {
+  it('compiles a static tool schema once across ten execute calls', async () => {
+    const compileSpy = jest.spyOn(Ajv.prototype, 'compile');
+    try {
+      const registry = new ToolRegistry();
+      registry.register(
+        {
+          name: 'cached_tool',
+          description: 'Compiles schema once',
+          inputSchema: {
+            type: 'object',
+            properties: {query: {type: 'string'}},
+            required: ['query'],
+          },
+        },
+        async () => 'done'
+      );
+
+      const runResults: string[] = [];
+      for (let i = 0; i < 10; i++) {
+        const response = await registry.execute('cached_tool', {query: 'test'});
+        runResults.push(response.result);
+      }
+
+      const mock = compileSpy.mock;
+      const calls = mock.calls;
+      const compilationCalls = calls.length;
+      expect({
+        compilationCalls,
+        runResults,
+      }).toEqual({
+        compilationCalls: 1,
+        runResults: Array.from({length: 10}, () => 'done'),
+      });
+    } finally {
+      compileSpy.mockRestore();
+    }
+  });
+
+  it('validates function-valued tool definition against current schema and caches by schema reference', async () => {
+    const registry = new ToolRegistry();
+    const schemaA: Record<string, unknown> = {
+      type: 'object',
+      properties: {stepA: {type: 'string'}},
+      required: ['stepA'],
+    };
+
+    let activeSchema = schemaA;
+    registry.register(
+      () => ({
+        name: 'dynamic_tool',
+        description: 'Dynamic schema tool',
+        inputSchema: activeSchema,
+      }),
+      async () => 'executed'
+    );
+
+    const first = await registry.execute('dynamic_tool', {stepA: 'value'});
+    const firstInvalid = await registry.execute('dynamic_tool', {stepB: 123});
+
+    const schemaB: Record<string, unknown> = {
+      type: 'object',
+      properties: {stepB: {type: 'number'}},
+      required: ['stepB'],
+    };
+    activeSchema = schemaB;
+
+    const second = await registry.execute('dynamic_tool', {stepB: 123});
+    const secondInvalid = await registry.execute('dynamic_tool', {stepA: 'value'});
+
+    expect({
+      firstResult: first.result,
+      firstNamesMissingStepA: firstInvalid.result.includes('stepA'),
+      secondResult: second.result,
+      secondNamesMissingStepB: secondInvalid.result.includes('stepB'),
+    }).toEqual({
+      firstResult: 'executed',
+      firstNamesMissingStepA: true,
+      secondResult: 'executed',
+      secondNamesMissingStepB: true,
+    });
+  });
+});
