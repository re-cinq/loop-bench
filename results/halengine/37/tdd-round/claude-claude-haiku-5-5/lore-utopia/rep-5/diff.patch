+import {jest} from '@jest/globals';
+import Ajv from 'ajv';
+import {log} from '../../shared/logger.js';
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry input validation', () => {
+  it('rejects an enum-violating input without calling the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'set_unit',
+        description: 'Set the display unit',
+        inputSchema: {
+          type: 'object',
