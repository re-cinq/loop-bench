+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry', () => {
+  it('rejects a value outside the declared enum with a ToolResponse and never calls the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'set_units',
+        description: 'Set display units',
+        inputSchema: {
+          type: 'object',
+          properties: {units: {enum: ['metric', 'imperial']}},
+          required: ['units'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'ok';
+      }
+    );
+
+    const response = await registry.execute('set_units', {units: 'kelvin'});
+
+    expect({
