+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry execute input validation', () => {
+  it('returns a rejection ToolResponse naming the missing required property and skips the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}, units: {type: 'string'}},
+          required: ['location', 'units'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'sunny';
+      }
+    );
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({result: response.result, executorCalls}).toEqual({
+      result: expect.stringMatching(/location/),
+      executorCalls: 0,
+    });
+  });
+});
diff --git a/src/orchestration/tools/registry.ts b/src/orchestration/tools/registry.ts
index a01748c..8d50be3 100644
--- a/src/orchestration/tools/registry.ts
+++ b/src/orchestration/tools/registry.ts
@@ -1,7 +1,11 @@
+import Ajv from 'ajv';
+import type {ErrorObject, ValidateFunction} from 'ajv';
 import type {ToolDefinition} from '../../types/ai.js';
 import type {OutgoingMessage} from '../../types/messages.js';
 import {log} from '../../shared/logger.js';
 
+const ajv = new Ajv({strict: false, validateFormats: false});
+
 export interface ToolResponse {
   result: string;
   clientMessages?: OutgoingMessage[];
@@ -27,6 +31,12 @@ export function normalizeToolResponse(response: string | ToolResponse): ToolResp
 
 export type ToolDefinitionSource = ToolDefinition | (() => ToolDefinition);
 
+// Names the path and constraint only; ajv's message never includes the offending value.
+function describeError(error: ErrorObject): string {
+  if (error.keyword === 'required') return `${String(error.params.missingProperty)} is required`;
+  return `${error.instancePath || 'input'} ${error.message ?? 'is invalid'}`;
+}
+
 export interface RegisteredTool {
   definition: ToolDefinition;
   execute: ToolExecutor;
@@ -35,6 +45,7 @@ export interface RegisteredTool {
 interface StoredTool {
   definitionSource: ToolDefinitionSource;
   execute: ToolExecutor;
+  validate?: ValidateFunction;
 }
 
 export class ToolRegistry {
@@ -46,7 +57,16 @@ export class ToolRegistry {
 
   register(definition: ToolDefinitionSource, execute: ToolExecutor): void {
     const resolved = this.resolveDefinition(definition);
-    this.tools.set(resolved.name, {definitionSource: definition, execute});
+    const validate = typeof definition === 'function' ? undefined : this.compile(resolved);
+    this.tools.set(resolved.name, {definitionSource: definition, execute, validate});
+  }
+
+  private compile(definition: ToolDefinition): ValidateFunction {
+    try {
+      return ajv.compile(definition.inputSchema);
+    } catch (error) {
+      throw new Error(`Invalid inputSchema for tool ${definition.name}: ${(error as Error).message}`, {cause: error});
