@@ -0,0 +1,86 @@
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry.register', () => {
+  it('throws synchronously naming the tool when a static inputSchema is not valid JSON Schema', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_lookup',
+          description: 'Has an invalid JSON Schema type',
+          inputSchema: {
+            type: 'object',
+            properties: {id: {type: 'not-a-json-schema-type'}},
+          },
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken_lookup/);
+  });
+
+  it('leaves a tool with an invalid static inputSchema unregistered', () => {
+    const registry = new ToolRegistry();
+    const outcome = (() => {
+      try {
+        registry.register(
+          {
+            name: 'broken_lookup',
+            description: 'Has an invalid JSON Schema type',
+            inputSchema: {
+              type: 'object',
+              properties: {id: {type: 'not-a-json-schema-type'}},
+            },
+          },
+          async () => 'unreachable'
+        );
+        return 'registered';
+      } catch {
+        return 'rejected';
+      }
+    })();
+
+    expect({outcome, registered: registry.has('broken_lookup')}).toEqual({outcome: 'rejected', registered: false});
+  });
+});
+
+describe('ToolRegistry.execute', () => {
+  it('names the missing required property and skips the executor', async () => {
+    const registry = new ToolRegistry();
+    const inputSchema = {type: 'object', properties: {location: {type: 'string'}}, required: ['location']};
+    let executorCalls = 0;
+    registry.register({name: 'get_weather', description: 'Get weather for a location', inputSchema}, async () => {
+      executorCalls += 1;
+      return 'sunny';
+    });
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({result: response.result, executorCalls}).toEqual({
+      result: expect.stringMatching(/location/),
+      executorCalls: 0,
+    });
+  });
+
+  it('validates a function-valued source against the schema returned for each call', async () => {
+    const registry = new ToolRegistry();
+    let idType: 'string' | 'number' = 'string';
+    let executorCalls = 0;
+    registry.register(
+      () => ({
+        name: 'lookup',
+        description: 'Look up a record by id',
+        inputSchema: {type: 'object', properties: {id: {type: idType}}, required: ['id']},
+      }),
+      async () => {
+        executorCalls += 1;
+        return 'found';
+      }
+    );
+    idType = 'number';
+
+    const response = await registry.execute('lookup', {id: 'abc'});
+
+    expect({rejected: response.result.includes('id'), executorCalls}).toEqual({rejected: true, executorCalls: 0});
+  });
+});
diff --git a/src/orchestration/tools/registry.ts b/src/orchestration/tools/registry.ts
