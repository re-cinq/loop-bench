+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry registration', () => {
+  // Schema compilation contract: specs/hal-engine-tool-input-validation/spec.md#5
+  it('rejects a static schema with an invalid type (spec: specs/hal-engine-tool-input-validation/spec.md#5)', () => {
+    const registry = new ToolRegistry();
+    expect(() =>
+      registry.register(
+        {name: 'weather', description: 'Weather lookup', inputSchema: {type: 'not-a-json-schema-type'}},
+        async () => 'sunny'
+      )
+    ).toThrow(/weather/);
+  });
+});
diff --git a/src/orchestration/tools/registry.ts b/src/orchestration/tools/registry.ts
index a01748c..858823f 100644
--- a/src/orchestration/tools/registry.ts
+++ b/src/orchestration/tools/registry.ts
@@ -1,3 +1,4 @@
+import {Ajv} from 'ajv';
 import type {ToolDefinition} from '../../types/ai.js';
 import type {OutgoingMessage} from '../../types/messages.js';
 import {log} from '../../shared/logger.js';
@@ -38,6 +39,7 @@ interface StoredTool {
 }
 
 export class ToolRegistry {
+  private readonly validator = new Ajv({strict: false, validateFormats: false});
   private readonly tools = new Map<string, StoredTool>();
 
   private resolveDefinition(source: ToolDefinitionSource): ToolDefinition {
@@ -46,6 +48,13 @@ export class ToolRegistry {
 
   register(definition: ToolDefinitionSource, execute: ToolExecutor): void {
     const resolved = this.resolveDefinition(definition);
+    if (typeof definition !== 'function') {
+      try {
+        this.validator.compile(resolved.inputSchema);
+      } catch {
+        throw new Error(`Invalid inputSchema for tool: ${resolved.name}`);
+      }
+    }
     this.tools.set(resolved.name, {definitionSource: definition, execute});
   }