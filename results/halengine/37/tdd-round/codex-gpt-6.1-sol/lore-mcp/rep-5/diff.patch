+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry dynamic schemas', () => {
+  it('enforces the current dynamic location type (specs/hal-engine-tool-input-validation/spec.md#9)', async () => {
+    const registry = new ToolRegistry();
+    let locationType = 'string';
+    const executions: Record<string, unknown>[] = [];
+    registry.register(
+      () => ({
+        name: 'weather',
+        description: 'Weather forecast',
+        inputSchema: {type: 'object', properties: {location: {type: locationType}}, required: ['location']},
+      }),
+      async input => {
+        executions.push(input);
+        return 'sunny';
+      }
+    );
+
+    const first = await registry.execute('weather', {location: 'Berlin'});
+    locationType = 'number';
+    const rejected = await registry.execute('weather', {location: 'Berlin'});
+    const corrected = await registry.execute('weather', {location: 52});
+
+    expect({first, rejected, corrected, executions}).toEqual({
+      first: {result: 'sunny'},
+      rejected: {result: expect.stringMatching(/location.*number/)},
+      corrected: {result: 'sunny'},
+      executions: [{location: 'Berlin'}, {location: 52}],
+    });
+  });
+});
