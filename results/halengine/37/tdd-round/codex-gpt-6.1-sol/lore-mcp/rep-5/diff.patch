+import {jest} from '@jest/globals';
+import AjvModule, {type Ajv} from 'ajv';
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry static validator', () => {
+  it('reuses validators for static and repeated dynamic schemas (specs/hal-engine-tool-input-validation/spec.md#8)', async () => {
+    const compile = jest.spyOn((AjvModule as unknown as {prototype: Ajv}).prototype, 'compile');
+    const {mock} = compile;
+    try {
+      const registry = new ToolRegistry();
+      registry.register({name: 'weather', description: 'Forecast', inputSchema: {type: 'object'}}, async () => 'sunny');
+      const registrations = mock.calls.length;
+      const dynamic = {name: 'dynamic', description: 'Forecast', inputSchema: {type: 'object'}};
+      registry.register(
+        () => dynamic,
+        async () => 'sunny'
+      );
+      for (let call = 0; call < 10; call++) {
+        await registry.execute('weather', {});
+        await registry.execute('dynamic', {});
+      }
+      expect({registrations, total: mock.calls.length}).toEqual({registrations: 1, total: 2});
+    } finally {
+      compile.mockRestore();
+    }
+  });
+});
