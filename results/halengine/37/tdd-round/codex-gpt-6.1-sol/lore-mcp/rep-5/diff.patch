+import {formatInputErrors} from './inputValidation.js';
+
+describe('Tool input diagnostics', () => {
+  it('normalizes legacy and current enum diagnostics (specs/hal-engine-tool-input-validation/spec.md#12)', () => {
+    const errors = [
+      {dataPath: '.location', keyword: 'enum', message: 'should be equal to one of the allowed values'},
+      {instancePath: '/location', keyword: 'enum', message: 'must be equal to one of the allowed values'},
+    ];
+    expect(errors.map(error => formatInputErrors([error]))).toEqual([
+      'data/location must be equal to one of the allowed values',
+      'data/location must be equal to one of the allowed values',
+    ]);
+  });
+});
diff --git a/src/orchestration/tools/inputValidation.ts b/src/orchestration/tools/inputValidation.ts
new file mode 100644
index 0000000..abfd263
--- /dev/null
+++ b/src/orchestration/tools/inputValidation.ts
@@ -0,0 +1,15 @@
+interface InputError {
+  instancePath?: string;
+  dataPath?: string;
+  message?: string;
+}
+
+export function formatInputErrors(errors: readonly InputError[] | null | undefined): string {
+  return (errors ?? [])
+    .map(error => {
+      const path = error.instancePath ?? error.dataPath?.replace(/\./g, '/') ?? '';
+      const message = error.message?.replace(/^should\b/, 'must') ?? 'is invalid';
+      return `data${path} ${message}`;
+    })
+    .join(', ');
+}
diff --git a/src/orchestration/tools/registry.acceptance.test.ts b/src/orchestration/tools/registry.acceptance.test.ts
