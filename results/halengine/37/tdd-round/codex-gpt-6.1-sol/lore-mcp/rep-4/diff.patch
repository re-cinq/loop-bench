@@ -0,0 +1,29 @@
+import {jest} from '@jest/globals';
+import AjvModule from 'ajv';
+import type {Ajv as AjvInstance, Options} from 'ajv';
+import {ToolRegistry} from './registry.js';
+
+// @spec specs/hal-engine-tool-input-validation/spec.md#7
+it('caches dynamic weather schemas by object identity', async () => {
+  const Ajv = AjvModule as unknown as new (options?: Options) => AjvInstance;
+  const compile = jest.spyOn(Ajv.prototype, 'compile');
+  const first = {type: 'object', properties: {location: {type: 'string'}}};
+  const second = {type: 'object', properties: {location: {type: 'number'}}};
+  let schema = first;
+  const registry = new ToolRegistry();
+  registry.register(
+    () => ({name: 'weather', description: 'Weather lookup', inputSchema: schema}),
+    async () => 'forecast'
+  );
+
+  try {
+    await registry.execute('weather', {location: 'Berlin'});
+    schema = second;
+    await registry.execute('weather', {location: 42});
+    schema = first;
+    await registry.execute('weather', {location: 'Berlin'});
+    expect(compile).toHaveBeenCalledTimes(2);
+  } finally {
+    compile.mockRestore();
+  }
+});
diff --git a/src/orchestration/tools/registry-enum.test.ts b/src/orchestration/tools/registry-enum.test.ts
new file mode 100644
index 0000000..daf7952
--- /dev/null
+++ b/src/orchestration/tools/registry-enum.test.ts
@@ -0,0 +1,25 @@
+import {jest} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+
+// @spec specs/hal-engine-tool-input-validation/spec.md#13
+it('names the enum constraint when rejecting weather units', async () => {
+  const executor = jest.fn(async () => 'forecast');
+  const registry = new ToolRegistry();
+  registry.register(
+    {
+      name: 'weather',
+      description: 'Weather lookup',
+      inputSchema: {type: 'object', properties: {units: {type: 'string', enum: ['celsius', 'fahrenheit']}}},
+    },
+    executor
+  );
+
+  const response = await registry.execute('weather', {units: 'private-units'});
+  const {calls} = executor.mock;
+  expect({
+    namesPath: response.result.includes('/units'),
+    namesConstraint: response.result.includes('enum'),
+    leaksValue: response.result.includes('private-units'),
+    calls: calls.length,
+  }).toEqual({namesPath: true, namesConstraint: true, leaksValue: false, calls: 0});
+});
