+++ b/src/orchestration/tools/registry-ajv-root.test.ts
@@ -0,0 +1,31 @@
+import {jest} from '@jest/globals';
+import AjvModule from 'ajv';
+import type {Ajv as AjvInstance, Options} from 'ajv';
+
+const Ajv = AjvModule as unknown as new (options?: Options) => AjvInstance;
+
+// Contract fixture: observe construction through the public package entry point.
+const constructors: Options[] = [];
+class PackageAjv extends Ajv {
+  constructor(options: Options = {}) {
+    super(options);
+    constructors.push(options);
+  }
+}
+jest.unstable_mockModule('ajv', () => ({default: PackageAjv}));
+const {ToolRegistry} = await import('./registry.js');
+
+// @spec specs/hal-engine-tool-input-validation/spec.md#12
+it('constructs the weather validator through the Ajv package root', async () => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'weather', description: 'Weather lookup', inputSchema: {type: 'object'}},
+    async () => 'forecast'
+  );
+
+  const response = await registry.execute('weather', {});
+  expect({response, constructors}).toEqual({
+    response: {result: 'forecast'},
+    constructors: [{strict: false, validateFormats: false}],
+  });
+});
