+import {jest} from '@jest/globals';
+import {log} from '../../shared/logger.js';
+import {ToolRegistry} from './registry.js';
+
+// @spec specs/hal-engine-tool-input-validation/spec.md#2
+it('rejects malformed weather input before execution without exposing its value', async () => {
+  const warnings = jest.spyOn(log, 'warn').mockImplementation(() => undefined);
+  const executionLogs = jest.spyOn(log, 'info').mockImplementation(() => undefined);
+  const executor = jest.fn(async () => 'forecast');
+  try {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Weather lookup',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      executor
+    );
+    const missing = await registry.execute('weather', {});
+    const wrongType = await registry.execute('weather', {location: 123456789});
+    const logs = JSON.stringify([...warnings.mock.calls, ...executionLogs.mock.calls]);
+
+    const executorCalls = executor.mock.calls;
+    expect({
+      missingRequiredLocation: /required/i.test(missing.result) && missing.result.includes('location'),
+      wrongLocationType: wrongType.result.includes('/location') && wrongType.result.includes('string'),
+      leaksValue: (missing.result + wrongType.result + logs).includes('123456789'),
+      logsConstraint: logs.includes('/location') && logs.includes('string') && logs.includes('required'),
+      executorCalls: executorCalls.length,
+    }).toEqual({
+      missingRequiredLocation: true,
+      wrongLocationType: true,
+      leaksValue: false,
+      logsConstraint: true,
+      executorCalls: 0,
+    });
+  } finally {
+    warnings.mockRestore();
+    executionLogs.mockRestore();
+  }
+});
