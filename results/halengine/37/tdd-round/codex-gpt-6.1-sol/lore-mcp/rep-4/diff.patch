+import {jest} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+
+// @spec specs/hal-engine-tool-input-validation/spec.md#4
+it('executes valid weather input once without changing extra properties or applying defaults', async () => {
+  const registry = new ToolRegistry();
+  const execute = jest.fn(async (input: Record<string, unknown>) => JSON.stringify(input));
+  registry.register(
+    {
+      name: 'weather',
+      description: 'Weather lookup',
+      inputSchema: {
+        type: 'object',
+        required: ['location'],
+        properties: {
+          location: {type: 'string'},
+          units: {type: 'string', enum: ['metric', 'imperial'], default: 'metric'},
+        },
+      },
+    },
+    execute
+  );
+  const input = {location: 'Berlin', extra: 42};
+
+  const response = await registry.execute('weather', input);
+  const {calls} = execute.mock;
+
+  expect({response, calls}).toEqual({
+    response: {result: JSON.stringify(input)},
+    calls: [[{location: 'Berlin', extra: 42}, undefined]],
+  });
+});
