+import {jest} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+
+// @spec specs/hal-engine-tool-input-validation/spec.md#6
+it('reuses the registered static schema across ten executions', async () => {
+  const schema = {type: 'object', properties: {location: {type: 'string'}}};
+  const readSchema = jest.fn(() => schema);
+  const registry = new ToolRegistry();
+  registry.register(
+    {
+      name: 'weather',
+      description: 'Weather lookup',
+      get inputSchema() {
+        return readSchema();
+      },
+    },
+    async () => 'forecast'
+  );
+  readSchema.mockClear();
+
+  for (let call = 0; call < 10; call++) {
+    await registry.execute('weather', {location: 'Berlin'});
+  }
+
+  expect(readSchema).not.toHaveBeenCalled();
+});
