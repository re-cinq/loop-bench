+// @spec specs/hal-engine-tool-input-validation/spec.md#8
+import {expect, it} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+
+it('reuses the registered static schema across ten executions', async () => {
+  const registry = new ToolRegistry();
+  const inputs: Record<string, unknown>[] = [];
+  const input = {location: 'Berlin', extra: 42};
+  let schemaReads = 0;
+  registry.register(
+    {
+      name: 'weather',
+      description: 'Weather forecast',
+      get inputSchema() {
+        schemaReads++;
+        return {
+          type: 'object',
+          properties: {location: {type: 'string'}, units: {type: 'string', default: 'celsius'}},
+          required: ['location'],
+        };
+      },
+    },
+    async received => {
+      inputs.push(received);
+      return 'forecast';
+    }
+  );
+
+  for (let call = 0; call < 10; call++) {
+    await registry.execute('weather', input);
+  }
+
+  expect({schemaReads, inputs}).toEqual({schemaReads: 1, inputs: Array.from({length: 10}, () => input)});
+});
