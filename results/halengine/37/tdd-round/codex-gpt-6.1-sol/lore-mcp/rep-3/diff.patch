+// @spec specs/hal-engine-tool-input-validation/spec.md#9
+import {expect, it, jest} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+
+it('caches dynamic validators by schema identity while resolving each call', async () => {
+  const registry = new ToolRegistry();
+  const stringSchema = {type: 'object', properties: {location: {type: 'string'}}};
+  const numberSchema = {type: 'object', properties: {location: {type: 'number'}}};
+  let inputSchema = stringSchema;
+  let resolutions = 0;
+  registry.register(
+    () => {
+      resolutions++;
+      return {name: 'weather', description: 'Weather forecast', inputSchema};
+    },
+    async () => 'accepted'
+  );
+
+  const compile = jest.spyOn(registry['ajv'], 'compile');
+  const first = await registry.execute('weather', {location: 'Berlin'});
+  inputSchema = numberSchema;
+  const second = await registry.execute('weather', {location: 'Berlin'});
+  inputSchema = stringSchema;
+  const third = await registry.execute('weather', {location: 'Berlin'});
+
+  const {calls} = compile.mock;
+  expect({compilations: calls.length, resolutions, first, second, third}).toEqual({
+    compilations: 2,
+    resolutions: 4,
+    first: {result: 'accepted'},
+    second: {result: expect.stringMatching(/location.*number/)},
+    third: {result: 'accepted'},
+  });
+});
