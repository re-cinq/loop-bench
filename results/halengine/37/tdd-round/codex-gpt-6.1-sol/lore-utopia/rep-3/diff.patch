+import {jest} from '@jest/globals';
+import AjvModule, {type Ajv} from 'ajv';
+import {ToolRegistry} from './registry.js';
+
+// @spec specs/hal-engine-tool-input-validation/spec.md#7
+it('caches dynamic validators by schema identity while resolving each call', async () => {
+  const constructor = AjvModule as unknown as {prototype: Ajv};
+  const compile = jest.spyOn(constructor.prototype, 'compile');
+  try {
+    const registry = new ToolRegistry();
+    const schemas = [
+      {type: 'object', properties: {city: {type: 'string'}}, required: ['city']},
+      {type: 'object', properties: {region: {type: 'string'}}, required: ['region']},
+    ];
+    let current = 0;
+    const resolve = jest.fn(() => ({name: 'dynamic', description: 'Current schema', inputSchema: schemas[current]!}));
+    const execute = jest.fn(async () => 'accepted');
+    registry.register(resolve, execute);
+    const responses = [await registry.execute('dynamic', {city: 'Berlin'})];
+    current = 1;
+    responses.push(await registry.execute('dynamic', {city: 'Berlin'}));
+    current = 0;
+    responses.push(await registry.execute('dynamic', {city: 'Berlin'}));
+    const {calls: compilations} = compile.mock;
+    const {calls: resolutions} = resolve.mock;
+    const {calls: executions} = execute.mock;
+    expect({
+      first: responses[0],
+      second: responses[1],
+      third: responses[2],
+      compilations: compilations.length,
+      resolutions: resolutions.length,
+      executions: executions.length,
+    }).toEqual({
+      first: {result: 'accepted'},
+      second: {result: expect.stringMatching(/required.*region/)},
+      third: {result: 'accepted'},
+      compilations: 2,
+      resolutions: 4,
+      executions: 2,
+    });
+  } finally {
+    compile.mockRestore();
+  }
+});
