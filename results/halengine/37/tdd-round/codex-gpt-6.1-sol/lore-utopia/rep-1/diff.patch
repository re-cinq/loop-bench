+import type {ToolDefinition} from '../../types/ai.js';
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry dynamic definitions', () => {
+  // spec: specs/hal-engine-tool-input-validation/spec.md#9
+  it('rejects input against the current dynamic schema', async () => {
+    const registry = new ToolRegistry();
