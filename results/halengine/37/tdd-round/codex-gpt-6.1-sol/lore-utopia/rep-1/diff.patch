+import {jest} from '@jest/globals';
+import {setLogger} from '../../shared/logger.js';
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry rejection diagnostics', () => {
+  // spec: specs/hal-engine-tool-input-validation/spec.md#4
+  it('logs rejection constraints without exposing input values', async () => {
+    const records: unknown[] = [];
+    const capture = (...args: unknown[]): void => {
+      records.push(args);
+    };
+    setLogger({debug: capture, info: capture, warn: capture, error: capture});
+    const execute = jest.fn(async () => 'unexpected');
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Weather',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}},
+      },
+      execute
+    );
+    try {
+      const response = await registry.execute('weather', {location: 987654321, identity: 'private@example.com'});
+      const logs = JSON.stringify(records);
+      const leaked = /987654321|private@example.com/.test(JSON.stringify({response, records}));
+      const {calls} = execute.mock;
+      expect({response, logs, calls: calls.length, leaked}).toEqual({
+        response: {result: expect.stringMatching(/location.*string/)},
+        logs: expect.stringMatching(/location.*string/),
+        calls: 0,
+        leaked: false,
+      });
+    } finally {
+      setLogger();
+    }
+  });
+});
