+import {createRequire} from 'node:module';
+import {jest} from '@jest/globals';
+import type {ToolDefinition} from '../../types/ai.js';
+import {ToolRegistry} from './registry.js';
+
+const Ajv = createRequire(import.meta.url)('ajv') as {
+  prototype: {compile: (schema: ToolDefinition['inputSchema']) => unknown};
+};
+
+// @spec specs/hal-engine-tool-input-validation/spec.md#7
+it('caches dynamic validators by schema identity while enforcing the current schema', async () => {
+  const compile = jest.spyOn(Ajv.prototype, 'compile');
+  const registry = new ToolRegistry();
+  const stringSchema: ToolDefinition['inputSchema'] = {
+    type: 'object',
+    properties: {location: {type: 'string'}},
+  };
+  const numberSchema: ToolDefinition['inputSchema'] = {
+    type: 'object',
+    properties: {location: {type: 'number'}},
+  };
+  let inputSchema = stringSchema;
+  registry.register(
+    () => ({name: 'weather', description: 'Weather lookup', inputSchema}),
+    async () => 'forecast'
+  );
+
+  try {
+    const first = await registry.execute('weather', {location: 'Berlin'});
+    inputSchema = numberSchema;
+    const rejected = await registry.execute('weather', {location: 'Berlin'});
+    inputSchema = stringSchema;
+    const repeated = await registry.execute('weather', {location: 'Berlin'});
+    const {calls} = compile.mock;
+    expect({first, rejected, repeated, compilations: calls.length}).toEqual({
+      first: {result: 'forecast'},
+      rejected: {result: expect.stringMatching(/location.*number/)},
+      repeated: {result: 'forecast'},
+      compilations: 2,
+    });
+  } finally {
+    compile.mockRestore();
+  }
+});
