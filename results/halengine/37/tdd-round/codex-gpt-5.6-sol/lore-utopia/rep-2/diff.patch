+
+    expect(result).not.toHaveProperty('location');
+  });
+
+  it('preserves schema-valid weather input without changing its units', async () => {
+    const result = JSON.parse(String(await executeWeather({location: 'Berlin', units: 'fahrenheit'}))) as Record<
