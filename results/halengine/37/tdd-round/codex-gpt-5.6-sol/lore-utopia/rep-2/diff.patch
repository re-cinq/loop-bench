+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+
+const REQUIRED_LOCATION_TOOL = {
+  name: 'weather',
+  description: 'Gets the weather',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}},
+    required: ['location'],
+  },
+};
+
+describe('ToolRegistry', () => {
+  afterEach(() => {
+    setLogger(undefined);
+  });
+
+  it('returns a required-property rejection before invoking the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(REQUIRED_LOCATION_TOOL, async () => {
+      executorCalls += 1;
+      return 'sunny';
+    });
+
+    const response = await registry.execute('weather', {});
+
+    expect({response, executorCalls}).toEqual({
+      response: {result: 'Invalid tool input: location is required'},
+      executorCalls: 0,
+    });
+  });
+
+  it('passes valid input with an undeclared property through unchanged exactly once', async () => {
+    const registry = new ToolRegistry();
+    const input = {location: 'Berlin', units: 'metric'};
+    const received: Record<string, unknown>[] = [];
+    registry.register(REQUIRED_LOCATION_TOOL, async toolInput => {
+      received.push(toolInput);
+      return 'sunny';
+    });
+
+    await registry.execute('weather', input);
+
+    expect(received).toEqual([input]);
+  });
+
+  it('names the complete path of a nested missing required property', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'local_weather',
+        description: 'Gets weather for a city',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            address: {
+              type: 'object',
+              properties: {city: {type: 'string'}},
+              required: ['city'],
+            },
+          },
+          required: ['address'],
+        },
+      },
+      async () => 'sunny'
+    );
+
+    const response = await registry.execute('local_weather', {address: {}});
+
+    expect(response).toEqual({result: 'Invalid tool input: address.city is required'});
+  });
+
+  it('names a wrong-typed property and expected type without returning its value', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'identity_lookup',
+        description: 'Looks up an identity',
+        inputSchema: {
+          type: 'object',
+          properties: {identity: {type: 'string'}},
+          required: ['identity'],
+        },
+      },
+      async () => 'found'
+    );
+
+    const response = await registry.execute('identity_lookup', {identity: 123456789});
+
+    expect({
+      result: response.result,
+      leaksValue: response.result.includes('123456789'),
+    }).toEqual({
+      result: 'Invalid tool input: identity must be a string',
+      leaksValue: false,
+    });
+  });
+
+  it('names an enum property and its allowed choices without returning its value', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'weather_units',
+        description: 'Gets weather in the requested units',
+        inputSchema: {
+          type: 'object',
+          properties: {units: {type: 'string', enum: ['celsius', 'fahrenheit']}},
+        },
+      },
+      async () => 'sunny'
+    );
+
+    const response = await registry.execute('weather_units', {units: 'kelvin'});
+
+    expect({result: response.result, leaksValue: response.result.includes('kelvin')}).toEqual({
+      result: 'Invalid tool input: units must be one of celsius, fahrenheit',
+      leaksValue: false,
+    });
+  });
+
+  it('logs a rejected field and constraint without logging its value', async () => {
+    const warnings: Array<{message: string; fields?: Record<string, unknown>}> = [];
+    const logger: Logger = {
+      debug: () => undefined,
+      info: () => undefined,
+      warn: (_category, message, fields) => warnings.push({message, fields}),
+      error: () => undefined,
+    };
+    setLogger(logger);
+    const registry = new ToolRegistry();
+    registry.register(REQUIRED_LOCATION_TOOL, async () => 'sunny');
+
+    await registry.execute('weather', {location: 123456789});
+
+    expect(warnings).toEqual([
+      {
+        message: 'input rejected',
+        fields: {name: 'weather', error: 'location must be a string'},
+      },
+    ]);
+  });
+
+  it('compiles the current schema from a function-valued definition before execution', async () => {
+    const registry = new ToolRegistry();
+    const schema: Record<string, unknown> = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+    };
+    let currentSchema = schema;
+    let executorCalls = 0;
+    registry.register(
+      () => ({
+        name: 'dynamic_weather',
+        description: 'Changes schema between calls',
+        inputSchema: currentSchema,
+      }),
+      async () => {
+        executorCalls += 1;
+        return 'sunny';
+      }
+    );
+
+    await registry.execute('dynamic_weather', {location: 'Berlin'});
+    schema.properties = {location: {type: 'not-a-json-schema-type'}};
+    await registry.execute('dynamic_weather', {location: 'Berlin'});
+    currentSchema = {...schema};
+
+    let thrown: unknown;
+    try {
+      await registry.execute('dynamic_weather', {location: 'Berlin'});
+    } catch (error) {
+      thrown = error;
+    }
+
+    expect({
+      executorCalls,
+      error: thrown instanceof Error ? thrown.message : String(thrown),
+    }).toEqual({executorCalls: 2, error: expect.stringMatching(/dynamic_weather/)});
+  });
+});
