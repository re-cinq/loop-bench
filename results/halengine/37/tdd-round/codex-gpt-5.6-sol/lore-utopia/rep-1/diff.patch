@@ -0,0 +1,97 @@
+import {jest} from '@jest/globals';
+import {ToolRegistry, type ToolExecutor} from './registry.js';
+
+function registerWeather(registry: ToolRegistry, execute: ToolExecutor): void {
+  registry.register(
+    {
+      name: 'weather',
+      description: 'Get weather',
+      inputSchema: {
+        type: 'object',
+        properties: {location: {type: 'string'}},
+        required: ['location'],
+      },
+    },
+    execute
+  );
+}
+
+describe('ToolRegistry', () => {
+  it('rejects an invalid static schema when the tool is registered', () => {
+    const registry = new ToolRegistry();
+    const invalidSchema = {
+      type: 'object',
+      properties: {location: {type: 'not-a-json-schema-type'}},
+    };
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_weather',
+          description: 'Has an invalid JSON Schema type',
+          inputSchema: invalidSchema,
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken_weather/);
+  });
+
+  it('returns a required-property rejection without invoking the executor', async () => {
+    const registry = new ToolRegistry();
+    const execute = jest.fn(async () => 'sunny');
+    registerWeather(registry, execute);
+
+    const response = await registry.execute('weather', {});
+
+    expect({response, executorCalls: execute.mock.calls}).toEqual({
+      response: {result: '/location is required'},
+      executorCalls: [],
+    });
+  });
+
+  it('validates each execution against the current function-valued schema', async () => {
+    const registry = new ToolRegistry();
+    const stringSchema = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    const numberSchema = {
+      type: 'object',
+      properties: {location: {type: 'number'}},
+      required: ['location'],
+    };
+    let currentSchema = stringSchema;
+    const execute = jest.fn(async () => 'sunny');
+    registry.register(() => ({name: 'weather', description: 'Get weather', inputSchema: currentSchema}), execute);
+
+    const firstResponse = await registry.execute('weather', {location: 42});
+    currentSchema = numberSchema;
+    const secondResponse = await registry.execute('weather', {location: 42});
