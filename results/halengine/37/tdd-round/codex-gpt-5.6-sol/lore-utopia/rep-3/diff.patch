+import {jest} from '@jest/globals';
+
+import {setLogger} from '../../shared/logger.js';
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry', () => {
+  afterEach(() => setLogger(undefined));
+
+  // specs/hal-engine-tool-input-validation/spec.md#1
+  it('returns a ToolResponse naming the missing required field and does not invoke the executor', async () => {
+    const registry = new ToolRegistry();
+    const executor = jest.fn(async () => 'sunny');
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      executor
+    );
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({result: response.result, executorCalls: executor.mock.calls}).toEqual({
+      result: expect.stringMatching(/location.*required|required.*location/i),
+      executorCalls: [],
+    });
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#3
+  it('names an enum constraint without exposing the rejected value', async () => {
+    const registry = new ToolRegistry();
+    const executor = jest.fn(async () => 'unreachable');
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {units: {type: 'string', enum: ['metric', 'imperial']}},
+        },
+      },
+      executor
+    );
+
+    const response = await registry.execute('get_weather', {units: 'private-units'});
+
+    expect({
+      mentionsConstraint: /units.*enum|enum.*units/i.test(response.result),
+      leaksValue: response.result.includes('private-units'),
+      executorCalls: executor.mock.calls,
+    }).toEqual({mentionsConstraint: true, leaksValue: false, executorCalls: []});
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#2
+  it('logs the rejected field and expected type without logging its value', async () => {
+    const logInfo = jest.fn();
+    setLogger({debug: jest.fn(), info: logInfo, warn: jest.fn(), error: jest.fn()});
+    const registry = new ToolRegistry();
+    const executor = jest.fn(async () => 'unreachable');
+    registry.register(
+      {
+        name: 'lookup',
+        description: 'Look up an identifier',
+        inputSchema: {type: 'object', properties: {identifier: {type: 'string'}}},
+      },
+      executor
+    );
+
+    const response = await registry.execute('lookup', {identifier: 8675309});
+
+    const logOutput = JSON.stringify(logInfo.mock.calls);
+    expect({
+      resultMentionsField: response.result.includes('identifier'),
+      resultMentionsExpectedType: response.result.includes('string'),
+      resultLeaksValue: response.result.includes('8675309'),
+      logsMentionField: logOutput.includes('identifier'),
+      logsMentionExpectedType: logOutput.includes('string'),
+      logsLeakValue: logOutput.includes('8675309'),
+      executorCalls: executor.mock.calls,
+    }).toEqual({
+      resultMentionsField: true,
+      resultMentionsExpectedType: true,
+      resultLeaksValue: false,
+      logsMentionField: true,
+      logsMentionExpectedType: true,
+      logsLeakValue: false,
+      executorCalls: [],
+    });
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#4
+  it('passes valid input with an unknown property to the executor unchanged exactly once', async () => {
+    const registry = new ToolRegistry();
+    const executor = jest.fn(async () => 'sunny');
+    const input = {location: 'Berlin', requestId: 'weather-123'};
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      executor
+    );
+
+    await registry.execute('get_weather', input);
+
+    expect(executor.mock.calls).toEqual([[input, undefined]]);
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#5
+  it('compiles a static schema at registration and names the tool when the schema is invalid', () => {
+    const registry = new ToolRegistry();
+    const invalidDefinition = {
+      name: 'broken_weather',
+      description: 'Has an invalid JSON Schema type',
+      inputSchema: {type: 'object', properties: {location: {type: 'not-a-json-schema-type'}}},
+    };
+
+    expect(() => registry.register(invalidDefinition, async () => 'unreachable')).toThrow(/broken_weather/);
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#6
+  it('compiles a static schema once across ten execute calls', async () => {
+    const registry = new ToolRegistry();
+    const executor = jest.fn(async () => 'sunny');
+    const inputSchema = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    let schemaReads = 0;
+    const definition = {
+      name: 'get_weather',
+      description: 'Get weather for a location',
+      get inputSchema() {
+        schemaReads += 1;
+        if (schemaReads > 1) throw new Error('static schema was read again');
+        return inputSchema;
+      },
+    };
+    registry.register(definition, executor);
+
+    const responses = await Promise.all(
+      Array.from({length: 10}, () => registry.execute('get_weather', {location: 'Berlin'}))
+    );
+
+    expect({schemaReads, results: responses.map(response => response.result)}).toEqual({
+      schemaReads: 1,
+      results: Array.from({length: 10}, () => 'sunny'),
+    });
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#7
+  it('validates each call against the schema returned for that call', async () => {
+    const registry = new ToolRegistry();
+    const executor = jest.fn(async () => 'matched');
+    let requiresPostalCode = false;
+    registry.register(
+      () => ({
+        name: 'lookup',
+        description: 'Look up a place',
+        inputSchema: {
+          type: 'object',
+          properties: requiresPostalCode ? {postalCode: {type: 'number'}} : {location: {type: 'string'}},
+          required: [requiresPostalCode ? 'postalCode' : 'location'],
+        },
+      }),
+      executor
+    );
+
+    await registry.execute('lookup', {location: 'Berlin'});
+    requiresPostalCode = true;
+    const rejected = await registry.execute('lookup', {location: 'Berlin'});
+
+    expect({executorCalls: executor.mock.calls, rejected: rejected.result}).toEqual({
+      executorCalls: [[{location: 'Berlin'}, undefined]],
+      rejected: expect.stringMatching(/postalCode.*required|required.*postalCode/i),
+    });
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#5
+  it('throws the unchanged unknown-tool error for an unregistered name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('missing_tool', {})).rejects.toThrow('Unknown tool: missing_tool');
+  });
+});
