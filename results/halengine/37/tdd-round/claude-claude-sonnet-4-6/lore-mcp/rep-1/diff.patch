+import {jest} from '@jest/globals';
+import Ajv from 'ajv';
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry', () => {
+  it('validates against the schema returned at execute time for a function-valued source', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    let round = 0;
+    const schemaAcceptsX = {type: 'object', properties: {x: {type: 'string'}}, required: ['x']};
+    const schemaAcceptsY = {type: 'object', properties: {y: {type: 'string'}}, required: ['y']};
+    registry.register(
+      () => ({
+        name: 'switcher',
+        description: 'Schema changes each call',
+        inputSchema: round === 0 ? schemaAcceptsX : schemaAcceptsY,
+      }),
+      async () => {
+        executorCalls += 1;
+        return 'ok';
+      }
+    );
+
+    const firstResult = await registry.execute('switcher', {x: 'v'});
+    round = 1;
+    const secondResult = await registry.execute('switcher', {x: 'v'});
+
+    expect({
+      executorCalls,
+      firstPassed: firstResult.result === 'ok',
+      secondRejected: secondResult.result.includes('y') && /required/i.test(secondResult.result),
+    }).toEqual({
+      executorCalls: 1,
+      firstPassed: true,
+      secondRejected: true,
+    });
+  });
+
+  it('passes valid input with extra properties through to executor unchanged', async () => {
+    const registry = new ToolRegistry();
+    let received: Record<string, unknown> | undefined;
+    registry.register(
+      {
+        name: 'passthrough',
+        description: 'Needs x',
+        inputSchema: {type: 'object', properties: {x: {type: 'string'}}, required: ['x']},
+      },
+      async input => {
+        received = input;
+        return 'ok';
+      }
+    );
+
+    const response = await registry.execute('passthrough', {x: 'hello', extra: 42});
+
+    expect({result: response.result, received}).toEqual({
+      result: 'ok',
+      received: {x: 'hello', extra: 42},
+    });
+  });
+
+  it('throws Unknown tool: <name> for an unregistered tool name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('nonexistent', {})).rejects.toThrow('Unknown tool: nonexistent');
+  });
+
+  it('reuses compiled validator across multiple execute calls for a static tool', async () => {
+    const compileSpy = jest.spyOn(Ajv.prototype, 'compile');
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'static_check',
+        description: 'Has static schema',
+        inputSchema: {type: 'object', properties: {x: {type: 'string'}}, required: ['x']},
+      },
+      async () => 'ok'
+    );
+    const compileCountAfterRegister = compileSpy.mock.calls.length;
+
+    for (let i = 0; i < 10; i++) {
+      await registry.execute('static_check', {x: 'value'});
+    }
+
+    expect(compileSpy.mock.calls.length).toBe(compileCountAfterRegister);
+    compileSpy.mockRestore();
+  });
+});
