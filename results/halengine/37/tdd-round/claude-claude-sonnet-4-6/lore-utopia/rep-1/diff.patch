+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry', () => {
+  it('passes valid input with an extra unlisted property to the executor unchanged', async () => {
+    const registry = new ToolRegistry();
+    let receivedInput: Record<string, unknown> | undefined;
+    registry.register(
+      {
+        name: 'greet',
+        description: 'Greet by name',
+        inputSchema: {
+          type: 'object',
+          properties: {name: {type: 'string'}},
+          required: ['name'],
+        },
+      },
+      async input => {
+        receivedInput = input;
+        return `Hello, ${String(input.name)}`;
+      }
+    );
+
+    await registry.execute('greet', {name: 'Alice', extra: 'ignored'});
+
+    expect(receivedInput).toEqual({name: 'Alice', extra: 'ignored'});
+  });
+
+  it('execute returns a ToolResponse naming the missing required property when a required field is omitted', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'send_email',
+        description: 'Send an email',
+        inputSchema: {type: 'object', properties: {to: {type: 'string'}}, required: ['to']},
+      },
+      async () => 'sent'
+    );
+    const response = await registry.execute('send_email', {});
+    expect(response.result).toMatch(/'to' is required/);
+  });
+
+  it('execute throws an error when called with an unregistered tool name', async () => {
+    const registry = new ToolRegistry();
+    await expect(registry.execute('no_such_tool', {})).rejects.toThrow('Unknown tool: no_such_tool');
+  });
+
+  it('execute names the field path and expected type for a wrong-typed property', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'lookup',
+        description: 'Look something up',
+        inputSchema: {
+          type: 'object',
+          properties: {id: {type: 'number'}},
+          required: ['id'],
+        },
+      },
+      async () => 'found'
+    );
+    const response = await registry.execute('lookup', {id: 'not-a-number'});
+    expect(response.result).toMatch(/'id' must be number/);
+  });
+
+  it('register throws an error naming the tool for a static schema that fails to compile', () => {
+    const registry = new ToolRegistry();
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_tool',
+          description: 'Has an invalid schema',
+          inputSchema: {
+            type: 'object',
+            properties: {location: {type: 'not-a-json-schema-type'}},
+          },
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow('broken_tool');
+  });
+
+  it('execute validates against the per-call schema from a function-valued definition', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      () => ({
+        name: 'dynamic_tool',
+        description: 'Has a dynamic definition',
+        inputSchema: {
+          type: 'object',
+          properties: {x: {type: 'string'}},
+          required: ['x'],
+        },
+      }),
+      async () => 'ok'
+    );
+    const response = await registry.execute('dynamic_tool', {});
+    expect(response.result).toMatch(/'x' is required/);
+  });
+
+  it('get returns undefined for a tool that has not been registered', () => {
+    const registry = new ToolRegistry();
+    expect(registry.get('missing')).toBeUndefined();
+  });
+
+  it('get returns the registered tool definition and executor', () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {name: 'my_tool', description: 'test', inputSchema: {type: 'object', properties: {}}},
+      async () => 'ok'
+    );
+    expect(registry.get('my_tool')?.definition).toMatchObject({name: 'my_tool'});
+  });
+
+  it('has returns false for a tool that has not been registered', () => {
+    const registry = new ToolRegistry();
+    expect(registry.has('missing')).toBe(false);
+  });
+
+  it('getPromptInstructions returns the instructions for tools that declare them', () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'advisor',
+        description: 'test',
+        inputSchema: {type: 'object', properties: {}},
+        promptInstructions: 'Use when asked for advice',
+      },
+      async () => 'ok'
+    );
+    expect(registry.getPromptInstructions()).toEqual(['advisor: Use when asked for advice']);
+  });
+
+  it('execute returns a result naming the field for a constraint other than required or type', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'pick_color',
+        description: 'pick a color',
+        inputSchema: {type: 'object', properties: {color: {enum: ['red', 'blue']}}, required: ['color']},
+      },
+      async () => 'ok'
+    );
+    const response = await registry.execute('pick_color', {color: 'green'});
+    expect(response.result).toContain('color');
+  });
+});
