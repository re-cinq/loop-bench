+import {Ajv} from 'ajv';
+import {jest} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const BASE_SCHEMA: ToolDefinition['inputSchema'] = {type: 'object', properties: {name: {type: 'string'}}};
+const REQUIRED_SCHEMA: ToolDefinition['inputSchema'] = {
+  type: 'object',
+  properties: {name: {type: 'string'}},
+  required: ['name'],
+};
+
+describe('ToolRegistry', () => {
+  describe('execute — valid input', () => {
+    it('passes valid input with extra properties through to executor unchanged', async () => {
+      const registry = new ToolRegistry();
+      let received: Record<string, unknown> = {};
+      registry.register({name: 'greet', description: 'greet', inputSchema: BASE_SCHEMA}, async input => {
+        received = input;
+        return 'hi';
+      });
+
+      await registry.execute('greet', {name: 'Alice', extra: 'ignored'});
+
+      expect(received).toEqual({name: 'Alice', extra: 'ignored'});
+    });
+  });
+
+  describe('execute — unknown tool', () => {
+    it('throws for an unregistered tool name', async () => {
+      const registry = new ToolRegistry();
+
+      await expect(registry.execute('no_such_tool', {})).rejects.toThrow('Unknown tool: no_such_tool');
+    });
+  });
+
+  describe('execute — static schema compiled at register time', () => {
+    it('applies the schema compiled at register time even when the definition object is mutated afterwards', async () => {
+      const registry = new ToolRegistry();
+      let executorCalls = 0;
+      const definition: ToolDefinition = {
+        name: 'static_tool',
+        description: 'test',
+        inputSchema: {...REQUIRED_SCHEMA},
+      };
+      registry.register(definition, async () => {
+        executorCalls += 1;
+        return 'done';
+      });
+
+      // Mutate the stored schema reference after registration.
+      definition.inputSchema = {type: 'object'};
+
+      // Using compiled validator (not re-reading definition) means mutation is ignored and 'name' is still required.
+      const result = await registry.execute('static_tool', {});
+
+      expect({executorCalls, rejected: /required/i.test(result.result)}).toEqual({
+        executorCalls: 0,
+        rejected: true,
+      });
+    });
+  });
+
+  describe('execute — function-valued definition source', () => {
+    it('validates against the schema the source returns for that call, not a stale one', async () => {
+      const registry = new ToolRegistry();
+      const schemas: ToolDefinition['inputSchema'][] = [
+        {type: 'object', properties: {a: {type: 'string'}}, required: ['a']},
+        {type: 'object', properties: {b: {type: 'string'}}, required: ['b']},
+      ];
+      let schemaIndex = 0;
+      registry.register(
+        () => ({name: 'switcher', description: 'changes schema', inputSchema: schemas[schemaIndex]!}),
+        async () => 'ok'
+      );
+
+      schemaIndex = 0;
+      const result1 = await registry.execute('switcher', {b: 'x'});
+
+      schemaIndex = 1;
+      const result2 = await registry.execute('switcher', {b: 'x'});
+
+      expect({
+        firstRejected: /required/i.test(result1.result) && result1.result.includes('a'),
+        secondPassed: result2.result === 'ok',
+      }).toEqual({firstRejected: true, secondPassed: true});
+    });
+  });
+
+  describe('execute — static compiled exactly once', () => {
+    it('compiles the schema once at register time and reuses it across ten execute calls', async () => {
+      const compileSpy = jest.spyOn(Ajv.prototype, 'compile');
+      try {
+        const registry = new ToolRegistry();
+        const before = compileSpy.mock.calls.length;
+        registry.register({name: 'once', description: 'test', inputSchema: REQUIRED_SCHEMA}, async () => 'ok');
+        const afterRegister = compileSpy.mock.calls.length;
+        for (let i = 0; i < 10; i++) {
+          await registry.execute('once', {name: 'x'});
+        }
+        expect({
+          compiledAtRegister: afterRegister - before,
+          recompiledDuringExecute: compileSpy.mock.calls.length - afterRegister,
+        }).toEqual({compiledAtRegister: 1, recompiledDuringExecute: 0});
+      } finally {
+        compileSpy.mockRestore();
+      }
+    });
+  });
+
+  describe('execute — function-valued WeakMap cache', () => {
+    it('reuses the compiled validator across multiple calls when the schema object reference is unchanged', async () => {
+      const compileSpy = jest.spyOn(Ajv.prototype, 'compile');
+      try {
+        const registry = new ToolRegistry();
+        let executorCalls = 0;
+        registry.register(
+          () => ({name: 'fn_cached', description: 'test', inputSchema: REQUIRED_SCHEMA}),
+          async () => {
+            executorCalls += 1;
+            return 'ok';
+          }
+        );
+
+        const before = compileSpy.mock.calls.length;
+        for (let i = 0; i < 5; i++) {
+          await registry.execute('fn_cached', {name: 'x'});
+        }
+
+        expect({
+          executorCalls,
+          compileDuringExecute: compileSpy.mock.calls.length - before,
+        }).toEqual({
+          executorCalls: 5,
+          compileDuringExecute: 1,
+        });
+      } finally {
+        compileSpy.mockRestore();
+      }
+    });
+  });
+});
