+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry', () => {
+  it('rejects input missing a required property returning a ToolResponse and not calling the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
