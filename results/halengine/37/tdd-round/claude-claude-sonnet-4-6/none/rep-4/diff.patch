+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry', () => {
+  it('validates function-valued source against schema current at each call', async () => {
+    const registry = new ToolRegistry();
+    let schema: Record<string, unknown> = {
+      type: 'object',
+      properties: {x: {type: 'string'}},
+      required: ['x'],
+    };
+    registry.register(
+      () => ({name: 'flex', description: 'flexible', inputSchema: schema}),
+      async () => 'ok'
+    );
+
+    const r1 = await registry.execute('flex', {x: 'hello'});
+    schema = {type: 'object', properties: {y: {type: 'string'}}, required: ['y']};
+    const r2 = await registry.execute('flex', {x: 'hello'});
+
+    expect({
+      firstCallResult: r1.result,
+      secondCallMentionsNewField: r2.result.includes('y'),
+      secondCallMentionsRequired: /required/i.test(r2.result),
+    }).toEqual({
+      firstCallResult: 'ok',
+      secondCallMentionsNewField: true,
+      secondCallMentionsRequired: true,
+    });
+  });
+
+  it('passes valid input with extra properties through to the executor unchanged', async () => {
+    const registry = new ToolRegistry();
+    let capturedInput: Record<string, unknown> | undefined;
+    registry.register(
+      {
+        name: 'capture',
+        description: 'captures input',
+        inputSchema: {type: 'object', properties: {x: {type: 'string'}}, required: ['x']},
+      },
+      async input => {
+        capturedInput = input;
+        return 'ok';
+      }
+    );
+
+    const payload = {x: 'hello', extra: 42};
+    const response = await registry.execute('capture', payload);
+
+    expect({result: response.result, capturedInput}).toEqual({
+      result: 'ok',
+      capturedInput: {x: 'hello', extra: 42},
+    });
+  });
+
+  it('throws Unknown tool: <name> for an unregistered tool name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('no_such_tool', {})).rejects.toThrow('Unknown tool: no_such_tool');
+  });
+
+  it('compiles a static schema once across ten execute calls', async () => {
+    const registry = new ToolRegistry();
+    let inputSchemaReadCount = 0;
+    const baseSchema: Record<string, unknown> = {
+      type: 'object',
+      properties: {x: {type: 'string'}},
+      required: ['x'],
+    };
+    const definition = {
+      name: 'once',
+      description: 'read-counted tool',
+      get inputSchema(): Record<string, unknown> {
+        inputSchemaReadCount++;
+        return baseSchema;
+      },
+    };
+
+    registry.register(definition, async () => 'ok');
+
+    for (let i = 0; i < 10; i++) {
+      await registry.execute('once', {x: 'value'});
+    }
+
+    expect(inputSchemaReadCount).toBe(1);
+  });
+});
