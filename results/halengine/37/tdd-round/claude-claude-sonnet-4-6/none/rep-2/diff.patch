+      async input => {
+        capturedInput = input;
+        return 'ok';
+      }
+    );
+
+    await registry.execute('trim_check', {a: '1', extra: 'bonus'});
+
+    expect(capturedInput).toEqual({a: '1', extra: 'bonus'});
+  });
+
+  it('throws Unknown tool for an unregistered tool name', async () => {
+    const registry = new ToolRegistry();
+    const caughtMessage = await registry.execute('ghost', {}).then(
+      () => null,
+      (e: Error) => e.message
+    );
+    expect(caughtMessage).toMatch(/Unknown tool: ghost/);
+  });
+
+  it('rejects a wrong-typed field naming the path and expected type without leaking the value in the result', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'type_check',
+        description: 'type check',
+        inputSchema: {type: 'object', properties: {score: {type: 'string'}}, required: ['score']},
+      },
