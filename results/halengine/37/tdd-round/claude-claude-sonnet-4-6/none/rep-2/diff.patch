+        {
+          name: 'bad_schema',
+          description: 'bad schema',
+          inputSchema: {type: 'object', properties: {x: {type: 'invalid-type'}}},
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow(/bad_schema/);
+  });
+
+  it('compiles a static schema exactly once across multiple execute calls', async () => {
+    const compileSpy = jest.spyOn(Ajv.prototype, 'compile');
+    const countBeforeRegister = compileSpy.mock.calls.length;
