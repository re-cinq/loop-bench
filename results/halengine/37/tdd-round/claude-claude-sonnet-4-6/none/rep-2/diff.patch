+
+    const countAfterRegister = compileSpy.mock.calls.length;
+
+    for (let i = 0; i < 10; i++) {
+      await registry.execute('once_tool', {v: `run${i}`});
+    }
+
+    expect({
+      compiledOnRegister: countAfterRegister - countBeforeRegister,
+      compiledOnExecute: compileSpy.mock.calls.length - countAfterRegister,
+    }).toEqual({compiledOnRegister: 1, compiledOnExecute: 0});
+  });
+
+  it('validates against the schema returned on that call for function-valued sources', async () => {
