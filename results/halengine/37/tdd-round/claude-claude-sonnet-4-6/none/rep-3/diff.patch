+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry', () => {
+  it('passes valid input with an extra property unchanged to the executor', async () => {
+    const registry = new ToolRegistry();
+    let capturedInput: Record<string, unknown> | null = null;
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Get weather',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async input => {
+        capturedInput = input;
+        return 'sunny';
+      }
+    );
+
+    await registry.execute('weather', {location: 'Paris', extra: 'value'});
+
+    expect(capturedInput).toEqual({location: 'Paris', extra: 'value'});
+  });
+
+  it('throws for an unregistered name', async () => {
+    const registry = new ToolRegistry();
+    await expect(registry.execute('no_such_tool', {})).rejects.toThrow('Unknown tool: no_such_tool');
+  });
+
+  it('uses the validator compiled at register time, ignoring post-registration schema mutations', async () => {
+    const registry = new ToolRegistry();
+    const schema: Record<string, unknown> = {type: 'object', properties: {x: {type: 'string'}}, required: ['x']};
+    registry.register({name: 'static_tool', description: '', inputSchema: schema}, async () => 'ok');
+    schema['required'] = ['x', 'extra'];
+    const response = await registry.execute('static_tool', {x: 'hello'});
+    expect(response.result).toBe('ok');
+  });
+
+  it('function-valued source validates against the schema returned for that call not a stale one', async () => {
+    const registry = new ToolRegistry();
+    let restrictive = false;
+    registry.register(
+      () => ({
+        name: 'adaptive',
+        description: '',
+        inputSchema: restrictive
+          ? {type: 'object', properties: {x: {type: 'string'}}, required: ['x']}
+          : {type: 'object'},
+      }),
+      async () => 'ok'
+    );
+    const permissive = await registry.execute('adaptive', {});
+    restrictive = true;
+    const rejected = await registry.execute('adaptive', {});
+    expect({permissive: permissive.result, rejectedMentionsX: rejected.result.includes('x')}).toEqual({
+      permissive: 'ok',
+      rejectedMentionsX: true,
+    });
+  });
+});
