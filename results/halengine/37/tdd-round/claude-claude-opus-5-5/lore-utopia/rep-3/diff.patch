@@ -0,0 +1,165 @@
+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+
+const LOCATION_SCHEMA = {
+  type: 'object',
+  properties: {location: {type: 'string'}},
+  required: ['location'],
+};
+
+function registerCountingWeatherTool(registry: ToolRegistry): () => number {
+  let calls = 0;
+  registry.register({name: 'get_weather', description: 'Weather', inputSchema: LOCATION_SCHEMA}, async () => {
+    calls += 1;
+    return 'sunny';
+  });
+  return () => calls;
+}
+
+type Warning = {message: string; fields?: Record<string, unknown>};
+
+function recordWarnings(): Warning[] {
+  const warnings: Warning[] = [];
+  const ignore = () => undefined;
+  setLogger({
+    debug: ignore,
+    info: ignore,
+    error: ignore,
+    warn: (_c, message, fields) => warnings.push({message, fields}),
+  });
+  return warnings;
+}
+
+describe('ToolRegistry.execute', () => {
+  it('returns a result naming location as required and runs no executor for {}', async () => {
+    const registry = new ToolRegistry();
+    const executorCalls = registerCountingWeatherTool(registry);
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({executorCalls: executorCalls(), result: response.result}).toEqual({
+      executorCalls: 0,
+      result: expect.stringMatching(/location.*required|required.*location/i),
+    });
+  });
+});
+
+describe('ToolRegistry.register', () => {
+  it('throws naming the tool when a static inputSchema cannot be compiled', () => {
+    const registry = new ToolRegistry();
+    const brokenSchema = {type: 'object', properties: {location: {type: 'not-a-type'}}};
+
+    expect(() =>
+      registry.register({name: 'broken_tool', description: 'Broken', inputSchema: brokenSchema}, async () => 'never')
+    ).toThrow(/broken_tool/);
+  });
+});
+
+describe('ToolRegistry.execute with a function-valued definition', () => {
+  it('validates against the schema the definition returns for that call, not a stale one', async () => {
+    const registry = new ToolRegistry();
+    let currentSchema: Record<string, unknown> = LOCATION_SCHEMA;
+    const executed: Record<string, unknown>[] = [];
+    registry.register(
+      () => ({name: 'get_weather', description: 'Weather', inputSchema: currentSchema}),
+      async input => {
+        executed.push(input);
+        return 'sunny';
+      }
+    );
+
+    await registry.execute('get_weather', {location: 'Berlin'});
+    currentSchema = {type: 'object', properties: {city: {type: 'string'}}, required: ['city']};
+    const stale = await registry.execute('get_weather', {location: 'Berlin'});
+    await registry.execute('get_weather', {city: 'Paris'});
+
+    expect({executed, staleResult: stale.result}).toEqual({
+      executed: [{location: 'Berlin'}, {city: 'Paris'}],
+      staleResult: expect.stringMatching(/city/),
+    });
+  });
+
+  it('compiles each distinct returned schema object once across repeated calls', async () => {
+    const registry = new ToolRegistry();
+    let reads = 0;
+    const schema = {type: 'object', properties: {}};
+    const tracked = new Proxy(schema, {
+      get(target, key, receiver) {
+        reads += 1;
+        return Reflect.get(target, key, receiver) as unknown;
+      },
+    });
+    registry.register(
+      () => ({name: 'dyn', description: 'Dynamic', inputSchema: tracked}),
+      async () => 'ok'
+    );
+
+    await registry.execute('dyn', {});
+    const readsAfterFirst = reads;
