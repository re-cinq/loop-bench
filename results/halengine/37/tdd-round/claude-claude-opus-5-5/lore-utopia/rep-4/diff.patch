@@ -0,0 +1,67 @@
+import {jest} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry schema compilation', () => {
+  it('throws from register naming the tool when a required list is not an array', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'malformed_required',
+          description: 'Declares required as a string',
+          inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: 'location'},
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow(/malformed_required/);
+  });
+});
+
+const weatherDefinition = {
+  name: 'get_weather',
+  description: 'Get weather for a location',
+  inputSchema: {type: 'object', required: ['location'], properties: {location: {type: 'string'}}},
+};
+
