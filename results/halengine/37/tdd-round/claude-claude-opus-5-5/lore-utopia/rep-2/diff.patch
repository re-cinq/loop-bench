@@ -0,0 +1,73 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinitionSource} from './registry.js';
+
+const requiresLocation = {type: 'object', properties: {location: {type: 'string'}}, required: ['location']};
+
+function recordingRegistry(source: ToolDefinitionSource) {
+  const registry = new ToolRegistry();
+  const inputs: Array<Record<string, unknown>> = [];
+  registry.register(source, async input => {
+    inputs.push(input);
+    return 'sunny';
+  });
+  return {registry, inputs};
+}
+
+describe('ToolRegistry.execute input validation', () => {
