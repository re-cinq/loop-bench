@@ -0,0 +1,132 @@
+import {jest} from '@jest/globals';
+import Ajv from 'ajv';
+import {ToolRegistry, type ToolDefinitionSource} from './registry.js';
+
+const locationSchema = {
+  type: 'object',
+  properties: {location: {type: 'string'}},
+  required: ['location'],
+};
+
+const ajvPrototype: Ajv.Ajv = Object.getPrototypeOf(new Ajv());
+
+function recordingRegistry(source: ToolDefinitionSource): {
+  registry: ToolRegistry;
+  executorInputs: Array<Record<string, unknown>>;
+} {
+  const registry = new ToolRegistry();
+  const executorInputs: Array<Record<string, unknown>> = [];
+  registry.register(source, async input => {
+    executorInputs.push(input);
+    return 'sunny';
+  });
+  return {registry, executorInputs};
+}
+
+describe('ToolRegistry', () => {
+  afterEach(() => {
+    jest.restoreAllMocks();
+  });
+
+  it('returns a rejection naming location as required and never calls the executor when input is empty', async () => {
+    const {registry, executorInputs} = recordingRegistry({
+      name: 'get_weather',
+      description: 'Weather lookup',
+      inputSchema: locationSchema,
+    });
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({executorCalls: executorInputs.length, result: response.result}).toEqual({
+      executorCalls: 0,
+      result: expect.stringMatching(/location.*required|required.*location/i),
+    });
+  });
+
+  it('passes valid input with an undeclared extra property to the executor unchanged, exactly once', async () => {
+    const {registry, executorInputs} = recordingRegistry({
+      name: 'get_weather',
+      description: 'Weather lookup',
+      inputSchema: locationSchema,
+    });
+
+    await registry.execute('get_weather', {location: 'Paris', units: 'metric'});
+
+    expect(executorInputs).toEqual([{location: 'Paris', units: 'metric'}]);
+  });
+
