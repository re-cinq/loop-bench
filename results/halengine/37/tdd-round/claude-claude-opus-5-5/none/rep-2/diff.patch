+import {jest} from '@jest/globals';
+import ajvModule from 'ajv';
+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+
+function registryWith(properties: Record<string, Record<string, unknown>>, required: string[]) {
+  const registry = new ToolRegistry();
+  const calls: Array<Record<string, unknown>> = [];
+  registry.register(
+    {name: 'probe', description: 'Probe tool', inputSchema: {type: 'object', properties, required}},
+    async input => {
+      calls.push(input);
+      return 'ok';
+    }
+  );
+  return {registry, calls};
+}
+
+describe('ToolRegistry.execute', () => {
+  afterEach(() => {
+    setLogger(undefined);
+  });
+
+  it('returns a rejection naming location as required and never calls the executor for {}', async () => {
+    const {registry, calls} = registryWith({location: {type: 'string'}}, ['location']);
+
+    const {result} = await registry.execute('probe', {});
+
+    expect({executorCalls: calls.length, result}).toEqual({
+      executorCalls: 0,
+      result: expect.stringMatching(/location.*required|required.*location/),
+    });
+  });
+
+  it('rejects a number where a string is required naming the path and type but never the value', async () => {
+    const logLines: string[] = [];
+    const record = (...args: unknown[]) => {
+      logLines.push(JSON.stringify(args));
+    };
+    setLogger({debug: record, info: record, warn: record, error: record});
+    const {registry, calls} = registryWith({email: {type: 'string'}}, ['email']);
+
+    const {result} = await registry.execute('probe', {email: 4155550123});
+
+    expect({
+      executorCalls: calls.length,
+      result,
