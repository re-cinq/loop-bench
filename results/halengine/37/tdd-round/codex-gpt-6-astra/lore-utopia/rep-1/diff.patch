+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry registration', () => {
+  // @spec specs/hal-engine-tool-input-validation/spec.md#5
+  it('rejects a static schema with an invalid property type naming the tool', () => {
+    const registry = new ToolRegistry();
+    expect(() =>
+      registry.register(
+        {
+          name: 'get_weather',
+          description: 'Get weather for a location',
+          inputSchema: {type: 'object', properties: {location: {type: 'invalid'}}},
+        },
+        async input => JSON.stringify(input)
+      )
+    ).toThrow(/get_weather/);
+  });
+});
