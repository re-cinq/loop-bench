+import type {ToolDefinition} from '../../types/ai.js';
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry static validation', () => {
+  // @spec specs/hal-engine-tool-input-validation/spec.md#6
+  it('retains the registered static schema when its definition changes', async () => {
+    const registry = new ToolRegistry();
+    const definition: ToolDefinition = {
+      name: 'weather',
+      description: 'Weather at a location',
+      inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+    };
+    registry.register(definition, async input => JSON.stringify(input));
+    definition.inputSchema = {type: 'object', properties: {location: {type: 'number'}}};
+
+    await expect(registry.execute('weather', {location: 'Berlin'})).resolves.toEqual({
+      result: JSON.stringify({location: 'Berlin'}),
+    });
+  });
+});
