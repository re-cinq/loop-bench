+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+import {setLogger} from '../../shared/logger.js';
+
+function registerWeather(inputSchema: ToolDefinition['inputSchema']) {
+  const registry = new ToolRegistry();
+  let calls = 0;
+  registry.register({name: 'weather', description: 'Get weather', inputSchema}, async () => {
+    calls += 1;
+    return 'sunny';
+  });
+  return {registry, getCalls: () => calls};
+}
+
+function recordWarnings(): string[] {
+  const warnings: string[] = [];
+  setLogger({
+    debug: () => {},
+    info: () => {},
+    warn: (category, message, fields) => warnings.push(JSON.stringify({category, message, fields})),
+    error: () => {},
+  });
+  return warnings;
+}
+
+describe('ToolRegistry input validation', () => {
+  it('rejects a wrong-typed field without exposing its value (specs/hal-engine-tool-input-validation/spec.md#4)', async () => {
+    const {registry, getCalls} = registerWeather({
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    });
+    const warnings = recordWarnings();
+    try {
+      const response = await registry.execute('weather', {location: 123456789});
+
+      expect({
+        path: response.result.includes('/location'),
+        type: response.result.includes('string'),
+        leaksResult: response.result.includes('123456789'),
+        leaksLog: warnings.join(' ').includes('123456789'),
+        calls: getCalls(),
+      }).toEqual({path: true, type: true, leaksResult: false, leaksLog: false, calls: 0});
+    } finally {
+      setLogger();
+    }
+  });
+
+  it('passes valid input with undeclared properties unchanged (specs/hal-engine-tool-input-validation/spec.md#5)', async () => {
+    const registry = new ToolRegistry();
+    const input = {location: 'Berlin', note: 'keep me'};
+    const received: Record<string, unknown>[] = [];
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Get weather',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async value => {
+        received.push(value);
+        return JSON.stringify(value);
+      }
+    );
+
+    const response = await registry.execute('weather', input);
+
+    expect({response, received}).toEqual({
+      response: {result: JSON.stringify(input)},
+      received: [input],
+    });
+  });
+
+  it('rejects an enum mismatch before executing (specs/hal-engine-tool-input-validation/spec.md#5)', async () => {
+    const {registry, getCalls} = registerWeather({
+      type: 'object',
+      properties: {unit: {type: 'string', enum: ['celsius', 'fahrenheit']}},
+      required: ['unit'],
+    });
+
+    const warnings = recordWarnings();
+    try {
+      const response = await registry.execute('weather', {unit: 'kelvin'});
+      const warningText = warnings.join(' ');
+
+      expect({
+        resultNamesField: response.result.includes('/unit'),
+        resultNamesConstraint: response.result.includes('allowed values'),
+        resultLeaksValue: response.result.includes('kelvin'),
+        logNamesField: warningText.includes('/unit'),
+        logNamesConstraint: warningText.includes('allowed values'),
+        logLeaksValue: warningText.includes('kelvin'),
+        calls: getCalls(),
+      }).toEqual({
+        resultNamesField: true,
+        resultNamesConstraint: true,
+        resultLeaksValue: false,
+        logNamesField: true,
+        logNamesConstraint: true,
+        logLeaksValue: false,
+        calls: 0,
+      });
+    } finally {
+      setLogger();
+    }
+  });
+
+  it('names the full path of a missing nested property (specs/hal-engine-tool-input-validation/spec.md#3)', async () => {
+    const {registry, getCalls} = registerWeather({
+      type: 'object',
+      properties: {address: {type: 'object', properties: {street: {type: 'string'}}, required: ['street']}},
+      required: ['address'],
+    });
+
+    const response = await registry.execute('weather', {address: {}});
+
+    expect({response, calls: getCalls()}).toEqual({
+      response: {result: 'Input validation failed: /address/street is required'},
+      calls: 0,
+    });
+  });
+
+  it('reuses the static schema compiled at registration (specs/hal-engine-tool-input-validation/spec.md#9)', async () => {
+    const registry = new ToolRegistry();
+    const locationSchema = {type: 'string'};
+    const inputSchema = {type: 'object', properties: {location: locationSchema}};
+    registry.register({name: 'weather', description: 'Get weather', inputSchema}, async () => 'sunny');
+
+    locationSchema.type = 'number';
+    const results = await Promise.all(Array.from({length: 10}, () => registry.execute('weather', {location: 'Paris'})));
+
+    expect(results.map(response => response.result)).toEqual(Array(10).fill('sunny'));
+  });
+
+  it('validates each resolved dynamic schema (specs/hal-engine-tool-input-validation/spec.md#10)', async () => {
+    const registry = new ToolRegistry();
+    const schemas = [
+      {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      {type: 'object', properties: {unit: {type: 'string'}}, required: ['unit']},
+    ];
+    let resolutions = 0;
+    let executions = 0;
+    registry.register(
+      () => ({
+        name: 'weather',
+        description: 'Get weather',
+        inputSchema: schemas[Math.min(Math.floor(resolutions++ / 2), 1)],
+      }),
+      async () => {
+        executions += 1;
+        return 'sunny';
+      }
+    );
+
+    const first = await registry.execute('weather', {location: 'Paris'});
+    const second = await registry.execute('weather', {location: 'Paris'});
+
+    expect({first, second, executions}).toEqual({
+      first: {result: 'sunny'},
+      second: {result: 'Input validation failed: unit is required'},
+      executions: 1,
+    });
+  });
+
+  it('escapes separators in missing property paths (specs/hal-engine-tool-input-validation/spec.md#3)', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Get weather',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            address: {type: 'object', properties: {'street/name': {type: 'string'}}, required: ['street/name']},
+          },
+        },
+      },
+      async () => 'sunny'
+    );
+
+    expect(await registry.execute('weather', {address: {}})).toEqual({
+      result: 'Input validation failed: /address/street~1name is required',
+    });
+  });
+
+  it('returns a required-field rejection before executing (specs/hal-engine-tool-input-validation/spec.md#3)', async () => {
+    const {registry, getCalls} = registerWeather({
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    });
+
+    const response = await registry.execute('weather', {});
+
+    expect({result: response.result, calls: getCalls()}).toEqual({
+      result: 'Input validation failed: location is required',
+      calls: 0,
+    });
+  });
+
+  it('names a forbidden extra property without exposing its value (specs/hal-engine-tool-input-validation/spec.md#7)', async () => {
+    const {registry, getCalls} = registerWeather({type: 'object', additionalProperties: false});
+    const response = await registry.execute('weather', {secret: '123456789'});
+
+    expect({
+      namesPath: response.result.includes('/secret'),
+      namesConstraint: response.result.includes('additional properties'),
+      leaksValue: response.result.includes('123456789'),
+      calls: getCalls(),
+    }).toEqual({namesPath: true, namesConstraint: true, leaksValue: false, calls: 0});
+  });
+});
