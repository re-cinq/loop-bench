@@ -0,0 +1,102 @@
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry schema compilation', () => {
+  // specs/hal-engine-tool-input-validation/spec.md#2
+  it('rejects missing required input before calling the executor', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    const execute = async () => {
+      calls += 1;
+      return 'sunny';
+    };
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Weather forecast',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      execute
+    );
+
+    const response = await registry.execute('weather', {});
+
+    expect({mentionsRequiredLocation: /location.*required|required.*location/.test(response.result), calls}).toEqual({
+      mentionsRequiredLocation: true,
+      calls: 0,
+    });
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#3
