+import {jest} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+
+function registerAccountLookup(registry: ToolRegistry): void {
+  registry.register(
+    {
+      name: 'lookup',
+      description: 'Look up an account',
+      inputSchema: {type: 'object', required: ['account/id']},
+    },
+    async () => 'unreachable'
+  );
+}
+
+function registerLegacyValidator(registry: ToolRegistry, error: Record<string, unknown>): void {
+  const validator = Object.assign(() => false, {errors: [error]});
+  const compiler = (registry as unknown as {ajv: {compile: () => typeof validator}}).ajv;
+  compiler.compile = () => validator;
+  registerAccountLookup(registry);
+}
+
+describe('ToolRegistry schema compilation', () => {
+  // specs/hal-engine-tool-input-validation/spec.md#5
+  it('passes valid input with an undeclared property to the executor unchanged', async () => {
+    const registry = new ToolRegistry();
+    const inputs: Record<string, unknown>[] = [];
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Weather lookup',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async input => {
+        inputs.push(input);
+        return 'forecast';
+      }
+    );
+    const input = {location: 'Paris', extra: 'kept'};
+
+    const response = await registry.execute('weather', input);
+
+    expect({response, inputs}).toEqual({response: {result: 'forecast'}, inputs: [input]});
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#7
+  it('names the tool when registration rejects an invalid static schema', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_weather',
+          description: 'Weather lookup',
+          inputSchema: {type: 'object', properties: {location: {type: 'not-a-json-schema-type'}}},
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken_weather/);
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#10
+  it('validates each dynamic schema and reuses a schema object validator', async () => {
+    const registry = new ToolRegistry();
+    const locationSchema = {type: 'object', properties: {location: {type: 'string'}}, required: ['location']};
+    const zipSchema = {type: 'object', properties: {zip: {type: 'string'}}, required: ['zip']};
+    let currentSchema: Record<string, unknown> = locationSchema;
+    const inputs: Array<Record<string, unknown>> = [];
+    registry.register(
+      () => ({name: 'weather', description: 'Weather lookup', inputSchema: currentSchema}),
+      async input => {
+        inputs.push(input);
+        return 'forecast';
+      }
+    );
+
+    const missingLocation = await registry.execute('weather', {});
+    currentSchema = zipSchema;
+    const validZip = await registry.execute('weather', {zip: '12345'});
+    const missingZip = await registry.execute('weather', {location: 'Paris'});
+    currentSchema = locationSchema;
+    const validLocation = await registry.execute('weather', {location: 'Paris'});
+
+    expect({
+      missingLocationIsRequired: /location.*required|required.*location/.test(missingLocation.result),
+      validZip: validZip.result,
+      missingZipIsRequired: /zip.*required|required.*zip/.test(missingZip.result),
+      validLocation: validLocation.result,
+      inputs,
+    }).toEqual({
+      missingLocationIsRequired: true,
+      validZip: 'forecast',
+      missingZipIsRequired: true,
+      validLocation: 'forecast',
+      inputs: [{zip: '12345'}, {location: 'Paris'}],
+    });
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#4
+  it('names a wrong-typed property path without exposing its value', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'lookup',
+        description: 'Look up an identifier',
+        inputSchema: {type: 'object', properties: {identifier: {type: 'string'}}},
+      },
+      async () => {
+        executorCalls += 1;
+        return 'unreachable';
+      }
+    );
+
+    const response = await registry.execute('lookup', {identifier: 123456789});
+
+    expect({
+      result: response.result,
+      executorCalls,
+    }).toEqual({
+      result: '/identifier: expected string',
+      executorCalls: 0,
+    });
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#12
+  it('names an explicitly forbidden extra property without exposing its value', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'lookup',
+        description: 'Look up an identifier',
+        inputSchema: {
+          type: 'object',
+          properties: {identifier: {type: 'string'}},
+          additionalProperties: false,
+        },
+      },
+      async () => 'unreachable'
+    );
+
+    const response = await registry.execute('lookup', {identifier: 'safe', secret: '123456789'});
+
+    expect(response).toEqual({result: '/secret: additionalProperties'});
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#13
+  it('names allowed enum choices without exposing the rejected value', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Get weather',
+        inputSchema: {
+          type: 'object',
+          properties: {unit: {type: 'string', enum: ['celsius', 'fahrenheit']}},
+          required: ['unit'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'unreachable';
+      }
+    );
+
+    const response = await registry.execute('weather', {unit: 'private-value'});
+
+    expect({result: response.result, executorCalls}).toEqual({
+      result: '/unit: expected one of celsius, fahrenheit',
+      executorCalls: 0,
+    });
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#14
+  it('escapes a slash in a required property path', async () => {
+    const registry = new ToolRegistry();
+    registerAccountLookup(registry);
+
+    const response = await registry.execute('lookup', {});
+
+    expect(response).toEqual({result: '/account~1id: required'});
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#14
+  it('normalizes a bracketed required property from a legacy validator', async () => {
+    const registry = new ToolRegistry();
+    registerLegacyValidator(registry, {keyword: 'required', params: {missingProperty: "['account/id']"}, dataPath: ''});
+
+    const response = await registry.execute('lookup', {});
+
+    expect(response).toEqual({result: '/account~1id: required'});
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#8
+  it('compiles a static schema once across ten executions', async () => {
+    const registry = new ToolRegistry();
+    const compiler = (registry as unknown as {ajv: {compile: (schema: object) => unknown}}).ajv;
+    const compile = jest.spyOn(compiler, 'compile');
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Weather lookup',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async () => 'forecast'
+    );
+    const validInput = {location: 'Paris'};
+
+    for (let call = 0; call < 10; call += 1) {
+      await registry.execute('weather', validInput);
+    }
+
+    expect(compile).toHaveBeenCalledTimes(1);
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#15
+  it('normalizes a nested legacy bracket path', async () => {
+    const registry = new ToolRegistry();
+    registerLegacyValidator(registry, {keyword: 'type', params: {type: 'string'}, dataPath: ".profile['account/id']"});
+
+    const response = await registry.execute('lookup', {profile: {'account/id': 42}});
+
+    expect(response).toEqual({result: '/profile/account~1id: expected string'});
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#16
+  it('escapes a tilde in a dotted legacy property path', async () => {
+    const registry = new ToolRegistry();
+    registerLegacyValidator(registry, {keyword: 'type', params: {type: 'string'}, dataPath: '.account~id'});
+
+    const response = await registry.execute('lookup', {'account~id': 42});
+
+    expect(response).toEqual({result: '/account~0id: expected string'});
+  });
+});
