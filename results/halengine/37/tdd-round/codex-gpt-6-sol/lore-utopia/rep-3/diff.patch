+import Ajv from 'ajv';
+import type {ValidateFunction} from 'ajv';
+import {jest} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#4
+it('distinguishes a numeric object property from an array index', async () => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {
+      name: 'lookup',
+      description: 'Look up a record',
+      inputSchema: {type: 'object', properties: {'123': {type: 'string'}}},
+    },
+    async () => 'unreachable'
+  );
+
+  const response = await registry.execute('lookup', {'123': 456});
+
+  expect(response.result).toBe('123 must be string');
+});
+
+// spec: specs/hal-engine-tool-input-validation/spec.md#4
+it('names a nested numeric object property without array brackets', async () => {
+  const registry = new ToolRegistry();
+  const validate = Object.assign(() => false, {
+    errors: [{keyword: 'type', dataPath: ".record['123']", params: {type: 'string'}}],
+  });
+  const compile = jest.spyOn(Ajv.prototype, 'compile').mockReturnValue(validate as unknown as ValidateFunction);
+  try {
+    registry.register(
+      () => ({
+        name: 'lookup',
+        description: 'Look up a record',
+        inputSchema: {type: 'object', properties: {record: {type: 'object', properties: {'123': {type: 'string'}}}}},
+      }),
+      async () => 'unreachable'
+    );
+
+    const response = await registry.execute('lookup', {record: {'123': 456}});
+
+    expect(response.result).toBe('record.123 must be string');
+  } finally {
+    compile.mockRestore();
+  }
+});
