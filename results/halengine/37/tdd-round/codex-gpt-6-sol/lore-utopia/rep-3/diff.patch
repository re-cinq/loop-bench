+import Ajv from 'ajv';
+import type {ValidateFunction} from 'ajv';
+import {jest} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry rejection paths', () => {
+  // spec: specs/hal-engine-tool-input-validation/spec.md#4
+  it('names a slash-bearing property without exposing its value', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'lookup',
+        description: 'Look up a record',
+        inputSchema: {type: 'object', properties: {'personal/data': {type: 'string'}}},
+      },
+      async () => 'unreachable'
+    );
+
+    const response = await registry.execute('lookup', {'personal/data': 123456789});
+
+    expect({
+      path: response.result.includes('personal/data'),
+      type: response.result.includes('string'),
+      leaked: response.result.includes('123456789'),
+    }).toEqual({path: true, type: true, leaked: false});
+  });
+
+  // spec: specs/hal-engine-tool-input-validation/spec.md#5
+  it('names an explicitly forbidden extra property without exposing its value', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'lookup',
+        description: 'Look up a record',
+        inputSchema: {type: 'object', additionalProperties: false},
+      },
+      async () => 'unreachable'
+    );
+
+    const personalIdKey = 'personal_id';
+    const response = await registry.execute('lookup', {[personalIdKey]: 'secret-123'});
+
+    expect({
+      path: response.result.includes('personal_id'),
+      constraint: response.result.includes('additionalProperties'),
+      leaked: response.result.includes('secret-123'),
+    }).toEqual({path: true, constraint: true, leaked: false});
+  });
+
+  // spec: specs/hal-engine-tool-input-validation/spec.md#4
+  it('names an array element field with its index and expected type', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'forecast',
+        description: 'Get forecasts',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            forecasts: {type: 'array', items: {type: 'object', properties: {location: {type: 'string'}}}},
+          },
+        },
+      },
+      async () => 'unreachable'
+    );
+
+    const response = await registry.execute('forecast', {forecasts: [{location: 12345}]});
+
+    expect(response.result).toBe('forecasts[0].location must be string');
+  });
+});
+
+describe('ToolRegistry schema compilation', () => {
+  // spec: specs/hal-engine-tool-input-validation/spec.md#10
+  it('keeps the schema compiled at registration when a static definition changes', async () => {
+    const registry = new ToolRegistry();
+    const definition = {
+      name: 'weather',
+      description: 'Get weather',
+      inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+    };
+    const inputs: Array<Record<string, unknown>> = [];
+    registry.register(definition, async input => {
+      inputs.push(input);
+      return 'forecast';
+    });
+    definition.inputSchema = {type: 'object', properties: {location: {type: 'string'}}, required: ['days']};
+
+    const response = await registry.execute('weather', {location: 'Paris'});
+
+    expect({response, inputs}).toEqual({response: {result: 'forecast'}, inputs: [{location: 'Paris'}]});
+  });
+
+  // spec: specs/hal-engine-tool-input-validation/spec.md#9
+  it('rejects an invalid static input schema when registering its named tool', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_weather',
+          description: 'Get weather',
+          inputSchema: {type: 'object', properties: {location: {type: 'not-a-json-schema-type'}}},
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken_weather/);
+  });
+});
+
+describe('ToolRegistry dynamic schema validation', () => {
+  // spec: specs/hal-engine-tool-input-validation/spec.md#12
