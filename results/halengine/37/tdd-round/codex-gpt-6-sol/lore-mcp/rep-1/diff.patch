+import {ToolRegistry} from './registry.js';
+import Ajv from 'ajv';
+import {jest} from '@jest/globals';
+
+describe('ToolRegistry input validation', () => {
+  it('names every missing required property in one rejection [specs/hal-engine-tool-input-validation/spec.md#2]', async () => {
+    const registry = new ToolRegistry();
+    const executor = jest.fn(async () => 'ok');
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Weather',
+        inputSchema: {type: 'object', required: ['location', 'units']},
+      },
+      executor
+    );
+
+    const response = await registry.execute('weather', {});
+    const calls = executor.mock.calls;
+    expect({
+      namesLocation: response.result.includes('/location'),
+      namesUnits: response.result.includes('/units'),
+      executorCalls: calls.length,
+    }).toEqual({namesLocation: true, namesUnits: true, executorCalls: 0});
+  });
+});
+
+describe('ToolRegistry schema compilation', () => {
+  it('throws at register time for an invalid static schema and names the tool [specs/hal-engine-tool-input-validation/spec.md#7]', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_weather',
+          description: 'Broken weather tool',
+          inputSchema: {type: 'object', properties: {location: {type: 'not-a-json-schema-type'}}},
+        },
+        async () => 'unused'
+      )
+    ).toThrow(/broken_weather/);
+  });
+
+  it('names an explicitly forbidden extra property without revealing its value [specs/hal-engine-tool-input-validation/spec.md#5]', async () => {
+    const registry = new ToolRegistry();
+    const executor = jest.fn(async () => 'ok');
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Weather',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, additionalProperties: false},
+      },
+      executor
+    );
+
+    const result = (await registry.execute('weather', {location: 'Paris', secret: 'private-identifier'})).result;
+    const executorCalls = executor.mock.calls;
+    expect({
+      namesPath: result.includes('/secret'),
+      namesConstraint: result.includes('additionalProperties'),
+      leaksValue: result.includes('private-identifier'),
+      executorCalls: executorCalls.length,
+    }).toEqual({namesPath: true, namesConstraint: true, leaksValue: false, executorCalls: 0});
+  });
+});
+
+describe('ToolRegistry dynamic schemas', () => {
+  it('validates each resolved schema and reuses validators for the same schema object [specs/hal-engine-tool-input-validation/spec.md#9]', async () => {
+    const registry = new ToolRegistry();
+    const compile = jest.spyOn(Ajv.prototype, 'compile');
+    const locationSchema = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    const unitSchema = {
+      type: 'object',
+      properties: {unit: {type: 'string'}},
+      required: ['unit'],
+    };
+    let currentSchema: typeof locationSchema | typeof unitSchema = locationSchema;
+    const executor = jest.fn(async () => 'ok');
+    registry.register(() => ({name: 'weather', description: 'Weather', inputSchema: currentSchema}), executor);
+
+    try {
+      const firstResult = (await registry.execute('weather', {})).result;
+      currentSchema = unitSchema;
+      const secondResult = (await registry.execute('weather', {})).result;
+      const thirdResult = (await registry.execute('weather', {})).result;
+      const executorCalls = executor.mock.calls;
+      const compileCalls = compile.mock.calls;
+      expect({
+        firstNamesLocation: firstResult.includes('location'),
+        secondNamesUnit: secondResult.includes('unit'),
+        thirdNamesUnit: thirdResult.includes('unit'),
+        executorCalls: executorCalls.length,
+        compileCalls: compileCalls.length,
+      }).toEqual({
+        firstNamesLocation: true,
+        secondNamesUnit: true,
+        thirdNamesUnit: true,
+        executorCalls: 0,
+        compileCalls: 2,
+      });
+    } finally {
+      compile.mockRestore();
+    }
+  });
+});
