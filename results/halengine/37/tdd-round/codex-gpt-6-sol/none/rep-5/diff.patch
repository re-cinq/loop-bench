+import {jest} from '@jest/globals';
+import Ajv, {type ValidateFunction} from 'ajv';
+import {setLogger} from '../../shared/logger.js';
+import {ToolRegistry} from './registry.js';
+
+function mockValidatorError(error: NonNullable<ValidateFunction['errors']>[number]) {
+  const validator = (() => false) as ValidateFunction;
+  validator.errors = [error];
+  return jest.spyOn(Ajv.prototype, 'compile').mockReturnValue(validator);
+}
+
+function registerWeatherTool(): ToolRegistry {
+  const registry = new ToolRegistry();
+  registry.register(
+    {
+      name: 'weather',
+      description: 'Get weather',
+      inputSchema: {type: 'object', properties: {address: {type: 'object', properties: {city: {type: 'string'}}}}},
+    },
+    async () => 'sunny'
+  );
+  return registry;
+}
+
+function registerLookupTool(registry: ToolRegistry, execute: () => Promise<string>): void {
+  registry.register(
+    {
+      name: 'lookup',
+      description: 'Look up a profile',
+      inputSchema: {type: 'object', properties: {profile: {type: 'object', required: ['home/address']}}},
+    },
+    execute
+  );
+}
+
+async function rejectedLookupOutcome(registry: ToolRegistry, execute: jest.Mock<() => Promise<string>>) {
+  const result = await rejectedLookupResult(registry);
+  const calls = execute.mock.calls;
+  return {result, executions: calls.length};
+}
+
+async function rejectedLookupResult(registry: ToolRegistry): Promise<string> {
+  return (await registry.execute('lookup', {profile: {}})).result;
+}
+
+describe('ToolRegistry schema registration', () => {
+  // specs/hal-engine-tool-input-validation/spec.md#5
+  it('rejects an invalid static input schema while registering the named tool', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'weather',
+          description: 'Get weather',
+          inputSchema: {type: 'object', properties: {location: {type: 'invalid-type'}}},
+        },
+        async () => 'sunny'
+      )
+    ).toThrow(/weather/);
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#6
+  it('compiles a static tool schema once across ten executions', async () => {
+    const compile = jest.spyOn(Ajv.prototype, 'compile');
+    const execute = jest.fn(async () => 'sunny');
+    const registry = new ToolRegistry();
+    try {
+      registry.register(
+        {name: 'weather', description: 'Get weather', inputSchema: {type: 'object', required: ['location']}},
+        execute
+      );
+      for (let index = 0; index < 10; index += 1) await registry.execute('weather', {location: 'Berlin'});
+
+      const compileCalls = compile.mock.calls;
+      const executeCalls = execute.mock.calls;
+      expect({compilations: compileCalls.length, executions: executeCalls.length}).toEqual({
+        compilations: 1,
+        executions: 10,
+      });
+    } finally {
+      compile.mockRestore();
+    }
+  });
+});
+
+describe('ToolRegistry dynamic schema validation', () => {
+  // specs/hal-engine-tool-input-validation/spec.md#7
+  it('compiles each dynamic schema object once and validates against the current one', async () => {
+    const locationSchema = {type: 'object', properties: {location: {type: 'string'}}, required: ['location']};
+    const citySchema = {type: 'object', properties: {city: {type: 'string'}}, required: ['city']};
+    let currentSchema: Record<string, unknown> = locationSchema;
+    const execute = jest.fn(async () => 'sunny');
+    const compile = jest.spyOn(Ajv.prototype, 'compile');
+    const registry = new ToolRegistry();
+    registry.register(() => ({name: 'weather', description: 'Get weather', inputSchema: currentSchema}), execute);
+
+    try {
+      await registry.execute('weather', {location: 'Paris'});
+      await registry.execute('weather', {location: 'Berlin'});
+      currentSchema = citySchema;
+      const rejected = await registry.execute('weather', {location: 'Paris'});
+
+      const compileCalls = compile.mock.calls;
+      const executeCalls = execute.mock.calls;
+      expect({
+        rejected: /city.*required|required.*city/i.test(rejected.result),
+        compiled: compileCalls.length,
+        executed: executeCalls.length,
+      }).toEqual({rejected: true, compiled: 2, executed: 2});
+    } finally {
+      compile.mockRestore();
+    }
+  });
+});
+
+describe('ToolRegistry input rejection', () => {
+  // specs/hal-engine-tool-input-validation/spec.md#2
+  it('logs the expected type and field path for a rejected tool input', async () => {
+    const warn = jest.fn();
+    setLogger({debug: () => undefined, info: () => undefined, warn, error: () => undefined});
+    try {
+      const registry = new ToolRegistry();
+      registry.register(
+        {
+          name: 'weather',
+          description: 'Get weather',
+          inputSchema: {type: 'object', properties: {location: {type: 'string'}}},
+        },
+        async () => 'sunny'
+      );
+
+      await registry.execute('weather', {location: 123456789});
+
+      const warningCalls = warn.mock.calls;
+      expect({warning: warningCalls[0], leaksValue: JSON.stringify(warningCalls).includes('123456789')}).toEqual({
+        warning: ['tool', 'input rejected', expect.objectContaining({path: '/location', constraint: 'must be string'})],
+        leaksValue: false,
+      });
+    } finally {
+      setLogger();
+    }
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#3
+  it('names the enum constraint without exposing the rejected value', async () => {
+    const registry = new ToolRegistry();
+    let executions = 0;
+    registry.register(
+      {
+        name: 'lookup',
+        description: 'Look up a profile',
+        inputSchema: {type: 'object', properties: {profile: {type: 'object', properties: {region: {enum: ['eu']}}}}},
+      },
+      async () => {
+        executions += 1;
+        return 'found';
+      }
+    );
+
+    const response = await registry.execute('lookup', {profile: {region: 'private-region'}});
+
+    expect({
+      path: response.result.includes('/profile/region'),
+      constraint: response.result.includes('enum'),
+      leaksValue: response.result.includes('private-region'),
+      executions,
+    }).toEqual({path: true, constraint: true, leaksValue: false, executions: 0});
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#1
+  it('escapes a required field name in the rejection path without invoking the executor', async () => {
+    const registry = new ToolRegistry();
+    const execute = jest.fn(async () => 'found');
+    registerLookupTool(registry, execute);
+
+    expect(await rejectedLookupOutcome(registry, execute)).toEqual({
+      result: "Invalid tool input at /profile/home~1address: must have required property 'home/address'",
+      executions: 0,
+    });
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#1
+  it('normalizes a legacy required-property error with a slash', async () => {
+    const compile = mockValidatorError({
+      keyword: 'required',
+      dataPath: '.profile',
+      schemaPath: '#/properties/profile/required',
+      params: {missingProperty: "['home/address']"},
+      message: "should have required property '['home/address']'",
+    });
+    const registry = new ToolRegistry();
+    const execute = jest.fn(async () => 'found');
+    try {
+      registerLookupTool(registry, execute);
+
+      expect(await rejectedLookupOutcome(registry, execute)).toEqual({
+        result: "Invalid tool input at /profile/home~1address: must have required property 'home/address'",
+        executions: 0,
+      });
+    } finally {
+      compile.mockRestore();
+    }
+  });
+});
+
+describe('ToolRegistry nested input rejection', () => {
+  // specs/hal-engine-tool-input-validation/spec.md#4
+  it('keeps a bracket-quoted field containing a closing bracket in the rejection path', async () => {
+    const compile = mockValidatorError({
+      keyword: 'type',
+      dataPath: ".address['city]name']",
+      schemaPath: '#/properties/address/properties/city]name/type',
+      params: {type: 'string'},
+      message: 'should be string',
+    });
+    try {
+      const registry = registerWeatherTool();
+      const response = await registry.execute('weather', {address: {'city]name': 123456789}});
+
+      expect(response.result).toBe('Invalid tool input at /address/city]name: must be string');
+    } finally {
+      compile.mockRestore();
+    }
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#2
+  it('does not echo a validator message containing the rejected property value', async () => {
+    const compile = mockValidatorError({
+      keyword: 'type',
+      dataPath: '.address.city',
+      schemaPath: '#/properties/address/properties/city/type',
+      params: {type: 'string'},
+      message: 'value 123456789 should be string',
+    });
+    try {
+      const registry = registerWeatherTool();
+      const response = await registry.execute('weather', {address: {city: 123456789}});
+
+      expect(response.result).toBe('Invalid tool input at /address/city: must be string');
+    } finally {
+      compile.mockRestore();
+    }
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#2
+  it('names a nested wrong-typed field from a dataPath error without echoing its value', async () => {
+    const compile = mockValidatorError({
+      keyword: 'type',
+      dataPath: '.address.city',
+      schemaPath: '#/properties/address/properties/city/type',
+      params: {type: 'string'},
+      message: 'should be string',
+    });
+    try {
+      const registry = registerWeatherTool();
+      const response = await registry.execute('weather', {address: {city: 123456789}});
+
+      expect({
+        path: response.result.includes('/address/city'),
+        type: response.result.includes('string'),
+        leaksValue: response.result.includes('123456789'),
+      }).toEqual({path: true, type: true, leaksValue: false});
+    } finally {
+      compile.mockRestore();
+    }
+  });
+});
+
+describe('ToolRegistry valid input', () => {
+  // specs/hal-engine-tool-input-validation/spec.md#4
+  it('passes schema-valid input with an extra property to the executor unchanged once', async () => {
+    const registry = new ToolRegistry();
+    const execute = jest.fn(async () => 'sunny');
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Get weather',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      execute
+    );
+    const input = {location: 'Berlin', extra: {unit: 'celsius'}};
+
+    const response = await registry.execute('weather', input);
+
+    expect({response, calls: execute.mock.calls}).toEqual({
+      response: {result: 'sunny'},
+      calls: [[{location: 'Berlin', extra: {unit: 'celsius'}}, undefined]],
+    });
+  });
+});
+
+describe('ToolRegistry unknown tool', () => {
+  // specs/hal-engine-tool-input-validation/spec.md#7
+  it('throws Unknown tool for an unregistered name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('missing', {})).rejects.toThrow('Unknown tool: missing');
+  });
+});
