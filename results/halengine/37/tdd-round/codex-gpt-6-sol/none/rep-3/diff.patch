index 0000000..f913b20
--- /dev/null
+++ b/specs/hal-engine-tool-input-validation/spec.md
@@ -0,0 +1,38 @@
+# Tool Input Validation
+
+| Field  | Value                |
+| ------ | -------------------- |
+| Issue  | re-cinq/HALEngine#37 |
+| Status | In Progress          |
+
+Every tool registered in `src/orchestration/tools/registry.ts` declares a JSON Schema `inputSchema` that is forwarded to the configured AI provider, and `ToolRegistry.execute` validates the model-supplied `input` against that schema before calling the tool's executor. When validation fails, `execute` returns a rejection `ToolResponse` describing what was wrong rather than throwing, so the orchestrator feeds the failure back to the model as a `tool_result` within the existing tool-round budget.
+
+## Validation at execute time
+
+- When `input` omits a property listed in `required`, `ToolRegistry.execute` returns a `ToolResponse` whose `result` names the missing property as required and never invokes the executor ([validated by: rejects input missing a required property with a ToolResponse and never calls the executor](../../src/orchestration/tools/registry.acceptance.test.ts#L16)).
+- A required property's path uses JSON Pointer escaping for `~` and `/` in the property name ([validated by: escapes a required property name in the reported JSON Pointer path](../../src/orchestration/tools/registry.test.ts#L98)).
+- When `input` supplies a property whose value does not match its declared JSON Schema type, `ToolRegistry.execute` returns a `ToolResponse` naming the failing field path and expected type without invoking the executor, and neither `result` nor the emitted log record contains the offending property value ([validated by: rejects a wrong-typed property naming the field and expected type without leaking the offending value to the result or logs](../../src/orchestration/tools/registry.acceptance.test.ts#L46)).
+- An Ajv `dataPath` error for a top-level property reports that property as a JSON Pointer path ([validated by: names a wrong-typed top-level property from an Ajv dataPath error](../../src/orchestration/tools/registry.test.ts#L13)).
+- An Ajv `dataPath` error using bracket notation for a property name containing a dot reports the literal property name as one JSON Pointer segment ([validated by: preserves a dotted property name from an Ajv bracket dataPath](../../src/orchestration/tools/registry.test.ts#L32)).
+- An Ajv `dataPath` required-property error strips its leading dot before reporting the missing property's JSON Pointer path ([validated by: strips a leading dot from an Ajv required property name](../../src/orchestration/tools/registry.test.ts#L51)).
+- When one call violates multiple schema constraints, its rejection names every failing property path and constraint without including any rejected value ([validated by: reports every failing field path and constraint for one invalid call](../../src/orchestration/tools/registry.test.ts#L70)).
+- When `input` satisfies `required`, declared property types and `enum`, `ToolRegistry.execute` invokes the executor once and passes the input object through unchanged — including undeclared extra properties — without injecting `additionalProperties: false`, coercing types or applying defaults.
+- When `ToolRegistry.execute` is called with a tool name that has not been registered, it throws `Unknown tool: <name>` because an unregistered tool is a programming or configuration error rather than a recoverable input mistake.
+
+## Schema compilation and caching
+
+- A static `ToolDefinition` has its `inputSchema` compiled once at `register` time, so a schema that is not valid JSON Schema throws synchronously from `register` with an error message naming the offending tool ([validated by: throws at register time naming the tool when a static inputSchema cannot be compiled](../../src/orchestration/tools/registry.acceptance.test.ts#L94)).
+- A failed static schema compilation leaves the named tool unregistered ([validated by: rejects an invalid static schema before registering the named tool](../../src/orchestration/tools/registry.test.ts#L126)).
+- A static tool's `inputSchema` is compiled at `register` time and reused on every `execute` call without re-reading or re-compiling `definition.inputSchema` ([validated by: reuses a static schema without reading it again for ten calls](../../src/orchestration/tools/registry.test.ts#L250)).
+- A later static registration recompiles its schema even when it reuses a schema object from an earlier registration, so a schema made invalid between registrations fails at the later registration ([validated by: recompiles a reused static schema at each registration](../../src/orchestration/tools/registry.test.ts#L213)).
+- A function-valued `ToolDefinitionSource` resolves its definition on each `execute` call and validates against the `inputSchema` returned for that call, caching compiled validators by schema object reference (`WeakMap`) so distinct returned schemas each enforce their own rules ([validated by: validates each resolved schema and reuses a validator for the same schema object](../../src/orchestration/tools/registry.test.ts#L150)).
+
+## Orchestrator tool-loop recovery
+
+- Because a schema rejection returns a `ToolResponse` instead of throwing, `src/orchestration/chatOrchestrator.ts` sends the rejection `result` back to the provider as a `tool_result` message, allowing the model to issue a corrected tool call on the next round and complete the turn within `maxToolRounds` ([validated by: returns a schema rejection as a tool_result in the orchestrator loop so the model can correct the call on the next round](../../src/orchestration/tools/registry.acceptance.test.ts#L112)).
+
+## Explicitly forbidden extra properties
+
+- When a tool schema explicitly sets `additionalProperties: false`, the rejection names the forbidden property's JSON Pointer path and the `additionalProperties` constraint without reporting its value ([validated by: names the path of an explicitly forbidden extra property without its value](../../src/orchestration/tools/registry.test.ts#L189)).
+- A required property whose name begins with a dot keeps that dot in its reported JSON Pointer path when the validator supplies an `instancePath` error ([validated by: preserves a leading dot in an actual required property name](../../src/orchestration/tools/registry.test.ts#L233)).
+- A nested required property whose name begins with a dot keeps that dot when the validator supplies a legacy `dataPath` error ([validated by: preserves a leading dot in a nested required property with a legacy dataPath error](../../src/orchestration/tools/registry.round.test.ts#L7)).
diff --git a/src/orchestration/tools/registry.acceptance.test.ts b/src/orchestration/tools/registry.acceptance.test.ts
new file mode 100644
index 0000000..4f0722c
--- /dev/null
+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,184 @@
+import {ToolRegistry} from './registry.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+import type {AIProvider, MessageChunk, SendMessageParams, ToolResultMessage} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+describe('ToolRegistry inputSchema validation acceptance', () => {
+  afterEach(() => {
+    setLogger(undefined);
+  });
+
+  it('rejects input missing a required property with a ToolResponse and never calls the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'sunny';
+      }
+    );
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({
+      executorCalls,
+      mentionsRequiredField: response.result.includes('location') && /required/i.test(response.result),
+    }).toEqual({
+      executorCalls: 0,
+      mentionsRequiredField: true,
+    });
+  });
+
+  it('rejects a wrong-typed property naming the field and expected type without leaking the offending value to the result or logs', async () => {
+    const recordedLogs: string[] = [];
+    const recordLine = (category: string, message: string, fields?: Record<string, unknown>) => {
+      recordedLogs.push(JSON.stringify({category, message, fields}));
+    };
+    const logger: Logger = {
+      debug: recordLine,
+      info: recordLine,
+      warn: recordLine,
+      error: recordLine,
+    };
+    setLogger(logger);
+
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'ssn_lookup',
+        description: 'Look up record by identifier',
+        inputSchema: {
+          type: 'object',
+          properties: {ssn: {type: 'string'}},
+          required: ['ssn'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'found';
+      }
+    );
+
+    const response = await registry.execute('ssn_lookup', {ssn: 123456789});
+
+    expect({
+      executorCalls,
+      mentionsField: response.result.includes('ssn'),
+      mentionsExpectedType: response.result.includes('string'),
+      leaksValueInResult: response.result.includes('123456789'),
+      leaksValueInLogs: recordedLogs.some(line => line.includes('123456789')),
+    }).toEqual({
+      executorCalls: 0,
+      mentionsField: true,
+      mentionsExpectedType: true,
+      leaksValueInResult: false,
+      leaksValueInLogs: false,
+    });
+  });
+
+  it('throws at register time naming the tool when a static inputSchema cannot be compiled', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_weather',
+          description: 'Has an invalid JSON Schema type',
+          inputSchema: {
+            type: 'object',
+            properties: {location: {type: 'not-a-json-schema-type'}},
+          },
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken_weather/);
+  });
+
+  it('returns a schema rejection as a tool_result in the orchestrator loop so the model can correct the call on the next round', async () => {
+    const registry = new ToolRegistry();
+    const executorInputs: Array<Record<string, unknown>> = [];
+    registry.register(
+      () => ({
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      }),
+      async input => {
+        executorInputs.push(input);
+        return `22C in ${String(input.location)}`;
+      }
+    );
+
+    let firstRoundToolResult = '';
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        round += 1;
+        if (round === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        if (round !== 2) {
+          yield {type: 'text', text: '22C in Paris'};
+          yield {type: 'stop', stopReason: 'end_turn'};
+          return;
+        }
+        const lastMessage = params.messages[params.messages.length - 1] as ToolResultMessage;
+        const [firstResult] = lastMessage.content;
+        firstRoundToolResult = firstResult?.content ?? '';
+        yield {
+          type: 'tool_use',
+          toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Paris'}},
+        };
+        yield {type: 'stop', stopReason: 'tool_use'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      provider,
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      registry
+    );
+    const session: ChatSession = {
+      sessionId: 's-retry',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'Weather in Paris?', timestamp: SENT_AT}],
+    };
+
+    const reply = await orchestrator.processMessage(session);
+
+    expect({
+      reply,
+      executorInputs,
