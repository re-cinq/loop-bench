+import Ajv, {type ValidateFunction} from 'ajv';
+import {jest} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+function mockValidationError(keyword: string, dataPath: string, params: Record<string, unknown>) {
+  const validate = Object.assign(() => false, {errors: [{keyword, dataPath, params}]});
+  return jest.spyOn(Ajv.prototype, 'compile').mockReturnValue(validate as unknown as ValidateFunction);
+}
+
+describe('ToolRegistry schema registration', () => {
+  // specs/hal-engine-tool-input-validation/spec.md#4
+  it('names a wrong-typed top-level property from an Ajv dataPath error', async () => {
+    const compile = mockValidationError('type', '.unit', {type: 'string'});
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Weather',
+        inputSchema: {type: 'object', properties: {unit: {type: 'string'}}},
+      },
+      async () => 'sunny'
+    );
+
+    const response = await registry.execute('weather', {unit: 42});
+    compile.mockRestore();
+
+    expect(response.result).toBe('/unit must be string');
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#5
+  it('preserves a dotted property name from an Ajv bracket dataPath', async () => {
+    const compile = mockValidationError('type', "['account.id']", {type: 'string'});
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'lookup',
+        description: 'Lookup',
+        inputSchema: {type: 'object', properties: {'account.id': {type: 'string'}}},
+      },
+      async () => 'found'
+    );
+
+    const response = await registry.execute('lookup', {'account.id': 42});
+    compile.mockRestore();
+
+    expect(response.result).toBe('/account.id must be string');
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#6
+  it('strips a leading dot from an Ajv required property name', async () => {
+    const compile = mockValidationError('required', '', {missingProperty: '.location'});
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Weather',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async () => 'sunny'
+    );
+
+    const response = await registry.execute('weather', {});
+    compile.mockRestore();
+
+    expect(response.result).toBe('/location is required');
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#7
+  it('reports every failing field path and constraint for one invalid call', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Weather',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}, unit: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'sunny';
+      }
+    );
+
+    const response = await registry.execute('weather', {unit: 42});
+
+    expect({result: response.result, executorCalls}).toEqual({
+      result: expect.stringMatching(/\/location is required; \/unit must be string/),
+      executorCalls: 0,
+    });
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#2
+  it('escapes a required property name in the reported JSON Pointer path', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Weather',
+        inputSchema: {
+          type: 'object',
+          properties: {'account/id': {type: 'string'}},
+          required: ['account/id'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'sunny';
+      }
+    );
+
+    const response = await registry.execute('weather', {});
+
+    expect({result: response.result, executorCalls}).toEqual({
+      result: '/account~1id is required',
+      executorCalls: 0,
+    });
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#11
+  it('rejects an invalid static schema before registering the named tool', () => {
+    const registry = new ToolRegistry();
+
+    let errorMessage = '';
+    try {
+      registry.register(
+        {
+          name: 'broken_weather',
+          description: 'Weather',
+          inputSchema: {type: 'object', properties: {location: {type: 'not-a-json-schema-type'}}},
+        },
+        async () => 'unreachable'
+      );
+    } catch (error) {
+      errorMessage = (error as Error).message;
+    }
+
+    expect({errorMessage, registered: registry.has('broken_weather')}).toEqual({
+      errorMessage: expect.stringMatching(/broken_weather/),
+      registered: false,
+    });
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#13
+  it('validates each resolved schema and reuses a validator for the same schema object', async () => {
+    const registry = new ToolRegistry();
+    const firstSchema = {type: 'object', properties: {location: {type: 'string'}}, required: ['location']};
+    const secondSchema = {type: 'object', properties: {zip: {type: 'string'}}, required: ['zip']};
+    let schema: ToolDefinition['inputSchema'] = firstSchema;
+    let executorCalls = 0;
+    registry.register(
+      () => ({name: 'lookup', description: 'Lookup', inputSchema: schema}),
+      async () => {
+        executorCalls += 1;
+        return 'ok';
+      }
+    );
+
+    const compile = jest.spyOn(Ajv.prototype, 'compile');
+    const first = await registry.execute('lookup', {});
+    schema = secondSchema;
+    const second = await registry.execute('lookup', {});
+    const third = await registry.execute('lookup', {zip: '12345'});
+
+    const calls = compile.mock.calls;
+    const compilationCount = calls.length;
+    expect({
+      first: first.result,
+      second: second.result,
+      third: third.result,
+      executorCalls,
+      compiled: compilationCount,
+    }).toEqual({
+      first: expect.stringMatching(/location.*required|required.*location/),
+      second: expect.stringMatching(/zip.*required|required.*zip/),
+      third: 'ok',
+      executorCalls: 1,
+      compiled: 2,
+    });
+    compile.mockRestore();
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#14
+  it('names the path of an explicitly forbidden extra property without its value', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Weather',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, additionalProperties: false},
+      },
+      async () => {
+        executorCalls += 1;
+        return 'sunny';
+      }
+    );
+
+    const response = await registry.execute('weather', {location: 'Paris', secret: 'private-value'});
+
+    expect({result: response.result, executorCalls}).toEqual({
+      result: '/secret violates additionalProperties',
+      executorCalls: 0,
+    });
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#12
+  it('recompiles a reused static schema at each registration', () => {
+    const registry = new ToolRegistry();
+    const location = {type: 'string'};
+    const schema = {type: 'object', properties: {location}};
+    registry.register({name: 'first', description: 'First', inputSchema: schema}, async () => 'first');
+    location.type = 'not-a-json-schema-type';
+
+    let errorMessage = '';
+    try {
+      registry.register({name: 'second', description: 'Second', inputSchema: schema}, async () => 'second');
+    } catch (error) {
+      errorMessage = (error as Error).message;
+    }
+    expect({errorMessage, registered: registry.has('second')}).toEqual({
+      errorMessage: expect.stringMatching(/second/),
+      registered: false,
+    });
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#15
+  it('preserves a leading dot in an actual required property name', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Weather',
+        inputSchema: {type: 'object', properties: {'.location': {type: 'string'}}, required: ['.location']},
+      },
+      async () => 'sunny'
+    );
+
+    const response = await registry.execute('weather', {});
+
+    expect(response.result).toBe('/.location is required');
+  });
+
+  // specs/hal-engine-tool-input-validation/spec.md#12
+  it('reuses a static schema without reading it again for ten calls', async () => {
+    const registry = new ToolRegistry();
+    const schema = {type: 'object', properties: {location: {type: 'string'}}, required: ['location']};
+    let schemaReads = 0;
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Weather',
+        get inputSchema() {
+          schemaReads += 1;
+          return schema;
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'sunny';
+      }
+    );
+
+    const responses = await Promise.all(
+      Array.from({length: 10}, () => registry.execute('weather', {location: 'Berlin'}))
+    );
+
+    expect({schemaReads, executorCalls, results: responses.map(response => response.result)}).toEqual({
+      schemaReads: 1,
+      executorCalls: 10,
+      results: Array(10).fill('sunny'),
+    });
+  });
+});
