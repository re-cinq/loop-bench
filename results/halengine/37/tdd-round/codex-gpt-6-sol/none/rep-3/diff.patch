+import Ajv, {type ValidateFunction} from 'ajv';
+import {jest} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry nested legacy required property paths', () => {
+  // specs/hal-engine-tool-input-validation/spec.md#16
+  it('preserves a leading dot in a nested required property with a legacy dataPath error', async () => {
+    const validate = Object.assign(() => false, {
+      errors: [{keyword: 'required', dataPath: '.details', params: {missingProperty: '.location'}}],
+    });
+    const compile = jest.spyOn(Ajv.prototype, 'compile').mockReturnValue(validate as unknown as ValidateFunction);
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Weather',
+        inputSchema: {
+          type: 'object',
+          properties: {details: {type: 'object', properties: {'.location': {type: 'string'}}, required: ['.location']}},
+        },
+      },
+      async () => 'sunny'
+    );
+
+    const response = await registry.execute('weather', {details: {}});
+    compile.mockRestore();
+
+    expect(response.result).toBe('/details/.location is required');
+  });
+});
