@@ -0,0 +1,208 @@
+import Ajv from 'ajv';
+import type {ValidateFunction} from 'ajv';
+import {jest} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+
+const rejectedLegacyPath = (dataPath: string): ValidateFunction =>
+  Object.assign(() => false, {
+    errors: [{dataPath, params: {type: 'string'}, keyword: 'type'}],
+  }) as unknown as ValidateFunction;
+
+describe('ToolRegistry schema registration', () => {
+  it('rejects an invalid static schema at registration with the tool name', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_weather',
+          description: 'Invalid location schema',
+          inputSchema: {type: 'object', properties: {location: {type: 'not-a-json-schema-type'}}},
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken_weather/);
+  });
+});
+
+describe('ToolRegistry dynamic schemas', () => {
+  // specs/hal-engine-tool-input-validation/spec.md#9
+  it('validates each resolved schema and compiles each schema object once', async () => {
