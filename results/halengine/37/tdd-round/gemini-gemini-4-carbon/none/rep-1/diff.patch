+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+
+describe('ToolRegistry', () => {
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('throws synchronously from register naming the tool when a static inputSchema is invalid', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'faulty_search',
+          description: 'Declares an unknown JSON Schema type keyword value',
+          inputSchema: {type: 'not-a-valid-type'},
+        },
+        async () => 'unused'
+      )
+    ).toThrow(/faulty_search/);
+  });
+
+  it('validates a function-valued tool against each call schema and caches validators by schema reference', async () => {
+    const registry = new ToolRegistry();
+    let citySchemaReads = 0;
+    const citySchema: Record<string, unknown> = {
+      type: 'object',
+      get properties() {
+        citySchemaReads += 1;
+        return {city: {type: 'string'}};
+      },
+      required: ['city'],
+    };
+    const postalSchema: Record<string, unknown> = {
+      type: 'object',
+      properties: {postalCode: {type: 'string'}},
+      required: ['postalCode'],
+    };
+    let activeSchema = citySchema;
+    const seenInputs: Record<string, unknown>[] = [];
+    registry.register(
+      () => ({name: 'lookup_place', description: 'Looks up a place', inputSchema: activeSchema}),
+      async input => {
+        seenInputs.push(input);
+        return 'found';
+      }
+    );
+    const context = {userId: 'u1', sessionId: 's1'};
+
+    await registry.execute('lookup_place', {city: 'Amsterdam'}, context);
+    const readsAfterFirstCall = citySchemaReads;
+    await registry.execute('lookup_place', {city: 'Berlin'}, context);
+    const readsAfterCachedCall = citySchemaReads;
+    activeSchema = postalSchema;
+    const rejection = await registry.execute('lookup_place', {city: 'Berlin'}, context);
+
+    expect({
+      seenInputs,
+      reusedCompiledValidator: readsAfterFirstCall > 0 && readsAfterCachedCall === readsAfterFirstCall,
+      mentionsPostalCodeRequired: rejection.result.includes('postalCode') && /required/i.test(rejection.result),
+    }).toEqual({
+      seenInputs: [{city: 'Amsterdam'}, {city: 'Berlin'}],
+      reusedCompiledValidator: true,
+      mentionsPostalCodeRequired: true,
+    });
+  });
+
+  it('rejects missing required input with a ToolResponse naming location and skips the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Fetches current weather for a city',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'sunny';
+      }
+    );
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({
+      executorCalls,
+      mentionsLocationRequired: response.result.includes('location') && /required/i.test(response.result),
+      clientMessages: response.clientMessages,
+      suppressAssistantResponse: response.suppressAssistantResponse,
+    }).toEqual({
+      executorCalls: 0,
+      mentionsLocationRequired: true,
+      clientMessages: undefined,
+      suppressAssistantResponse: undefined,
+    });
+  });
+
+  it('rejects wrong-typed and disallowed enum fields naming expectations without leaking input values', async () => {
+    const capturedLogs: string[] = [];
+    const recordLog = (level: string, category: string, message: string, metadata?: Record<string, unknown>): void => {
+      capturedLogs.push(JSON.stringify({level, category, message, metadata}));
+    };
+    const spyLogger: Logger = {
+      debug: (category, message, metadata) => recordLog('debug', category, message, metadata),
+      info: (category, message, metadata) => recordLog('info', category, message, metadata),
+      warn: (category, message, metadata) => recordLog('warn', category, message, metadata),
+      error: (category, message, metadata) => recordLog('error', category, message, metadata),
+    };
+    setLogger(spyLogger);
+
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'update_preferences',
+        description: 'Updates user weather preferences',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+            units: {type: 'string', enum: ['celsius', 'fahrenheit']},
+          },
+          required: ['location', 'units'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'updated';
+      }
+    );
+
+    const response = await registry.execute('update_preferences', {
+      location: 987654,
+      units: 'kelvin',
+      nationalId: 'id-secret-9912',
+    });
+    const combinedOutput = `${response.result} ${capturedLogs.join(' ')}`;
+    const namesUnitsField = response.result.includes('units') && response.result.includes('celsius');
+
+    expect({
+      executorCalls,
+      namesLocationString: response.result.includes('location') && /string/i.test(response.result),
+      namesAllowedEnumValues: namesUnitsField && response.result.includes('fahrenheit'),
+      leakedNumberValue: combinedOutput.includes('987654'),
+      leakedEnumValue: combinedOutput.includes('kelvin'),
+      leakedIdentifyingValue: combinedOutput.includes('id-secret-9912'),
+      emittedWarnLog: capturedLogs.some(entry => entry.includes('"level":"warn"')),
+    }).toEqual({
+      executorCalls: 0,
+      namesLocationString: true,
+      namesAllowedEnumValues: true,
+      leakedNumberValue: false,
+      leakedEnumValue: false,
+      leakedIdentifyingValue: false,
+      emittedWarnLog: true,
+    });
+  });
+
+  it('passes valid input including undeclared extra properties through to the executor unchanged once', async () => {
+    const registry = new ToolRegistry();
+    const receivedCalls: Array<{input: Record<string, unknown>; userId: string | number | undefined}> = [];
+    registry.register(
+      {
+        name: 'get_forecast',
+        description: 'Returns a multi-day forecast',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+            units: {type: 'string', enum: ['celsius', 'fahrenheit'], default: 'celsius'},
+            days: {type: 'number', default: 5},
+            when: {type: 'string', format: 'date-time', example: 'tomorrow'},
+          },
+          required: ['location'],
+        },
+      },
+      async (input, context) => {
+        receivedCalls.push({input, userId: context?.userId});
+        return {result: 'clear skies', suppressAssistantResponse: true};
+      }
+    );
+
+    const response = await registry.execute(
+      'get_forecast',
+      {location: 'Berlin', units: 'fahrenheit', when: 'next-tuesday', requestTag: 'trace-42'},
+      {userId: 'user-7', sessionId: 'sess-1'}
+    );
+
+    expect({receivedCalls, response}).toEqual({
+      receivedCalls: [
+        {
+          input: {location: 'Berlin', units: 'fahrenheit', when: 'next-tuesday', requestTag: 'trace-42'},
+          userId: 'user-7',
+        },
+      ],
+      response: {result: 'clear skies', suppressAssistantResponse: true},
+    });
+  });
+
+  it('compiles a static tool schema once at register time across ten execute calls', async () => {
+    const registry = new ToolRegistry();
+    let schemaReads = 0;
+    const trackedSchema: Record<string, unknown> = {
+      type: 'object',
+      get properties() {
+        schemaReads += 1;
+        return {location: {type: 'string'}};
+      },
+      required: ['location'],
+    };
+    let executorCalls = 0;
+    registry.register({name: 'ping_city', description: 'Pings a city', inputSchema: trackedSchema}, async () => {
+      executorCalls += 1;
+      return 'pong';
+    });
+    const readsAtRegister = schemaReads;
+
+    for (let i = 0; i < 10; i += 1) {
+      await registry.execute('ping_city', {location: 'Paris'});
+    }
+
+    expect({
+      compiledAtRegister: readsAtRegister > 0,
+      extraReadsAcrossTenCalls: schemaReads - readsAtRegister,
+      executorCalls,
+    }).toEqual({
+      compiledAtRegister: true,
+      extraReadsAcrossTenCalls: 0,
+      executorCalls: 10,
+    });
+  });
+
+  it('throws Unknown tool when execute is called with an unregistered tool name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('unregistered_tool', {query: 'status'})).rejects.toThrow(
+      'Unknown tool: unregistered_tool'
+    );
+  });
+});
