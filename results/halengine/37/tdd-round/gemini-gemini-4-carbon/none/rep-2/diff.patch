+import {ToolRegistry, buildSchemaRejection} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+
+describe('ToolRegistry', () => {
+  afterEach(() => {
+    setLogger(undefined);
+  });
+
+  it('throws synchronously from register naming the tool when inputSchema is not valid JSON Schema', () => {
+    const registry = new ToolRegistry();
+    const brokenTool = {name: 'broken_lookup', description: 'Bad keyword type', inputSchema: {type: 'bogus'}};
+
+    expect(() => registry.register(brokenTool, async () => 'ok')).toThrow(/broken_lookup/);
+  });
+
+  it('throws synchronously from register naming the tool when inputSchema declares async validation', () => {
+    const registry = new ToolRegistry();
+    const asyncTool = {
+      name: 'async_lookup',
+      description: 'Unsupported async schema',
+      inputSchema: {$async: true, type: 'object'},
+    };
+
+    expect(() => registry.register(asyncTool, async () => 'ok')).toThrow(/async_lookup/);
+  });
+
+  it('rejects empty input missing a required location property without calling the executor', async () => {
+    const registry = new ToolRegistry();
+    let invocations = 0;
+    registry.register(
+      {
+        name: 'weather_by_location',
+        description: 'Fetch weather by location',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async () => {
+        invocations += 1;
+        return 'clear';
+      }
+    );
+
+    const response = await registry.execute('weather_by_location', {});
+
+    expect({
+      invocations,
+      namesLocationAsRequired: /location.*required/i.test(response.result),
+    }).toEqual({
+      invocations: 0,
+      namesLocationAsRequired: true,
+    });
+  });
+
+  it('rejects invalid input naming failed paths and types without calling executor or leaking', async () => {
+    const emitted: string[] = [];
+    const sink = (_category: string, message: string, fields?: Record<string, unknown>) => {
+      emitted.push(`${message} ${JSON.stringify(fields ?? {})}`);
+    };
+    setLogger({debug: sink, info: sink, warn: sink, error: sink});
+
+    const registry = new ToolRegistry();
+    let invocations = 0;
+    registry.register(
+      {
+        name: 'audit_lookup',
+        description: 'Look up audit record',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+            secretToken: {type: 'string'},
+          },
+          required: ['location', 'secretToken'],
+        },
+      },
+      async () => {
+        invocations += 1;
+        return 'ok';
+      }
+    );
+
+    const response = await registry.execute('audit_lookup', {secretToken: 987654321});
+
+    expect({
+      invocations,
+      mentionsMissingLocation: /location.*required/i.test(response.result),
+      mentionsWrongTypedToken: /secretToken.*string/i.test(response.result),
+      echoesOffendingValue: response.result.includes('987654321'),
+      logsOffendingValue: emitted.some(entry => entry.includes('987654321')),
+      logsFailedPaths: emitted.some(entry => entry.includes('location') && entry.includes('secretToken')),
+    }).toEqual({
+      invocations: 0,
+      mentionsMissingLocation: true,
+      mentionsWrongTypedToken: true,
+      echoesOffendingValue: false,
+      logsOffendingValue: false,
+      logsFailedPaths: true,
+    });
+  });
+
+  it('enforces enum values and forwards valid input with undeclared extra properties unchanged once', async () => {
+    const receivedInputs: Array<Record<string, unknown>> = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'forecast_units',
+        description: 'Forecast with temperature unit selection',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+            units: {type: 'string', enum: ['celsius', 'fahrenheit']},
+          },
+          required: ['location'],
+        },
+      },
+      async input => {
+        receivedInputs.push(input);
+        return {result: '18C'};
+      }
+    );
+
+    const enumRejection = await registry.execute('forecast_units', {location: 'Berlin', units: 'kelvin'});
+    const validPayload = {location: 'Berlin', units: 'celsius', extraMetadata: {traceId: 't-42'}};
+    const accepted = await registry.execute('forecast_units', validPayload);
+
+    expect({
+      enumMentionsFieldAndConstraint: /units.*enum/i.test(enumRejection.result),
+      enumLeaksValue: enumRejection.result.includes('kelvin'),
+      acceptedResult: accepted.result,
+      receivedInputs,
+    }).toEqual({
+      enumMentionsFieldAndConstraint: true,
+      enumLeaksValue: false,
+      acceptedResult: '18C',
+      receivedInputs: [{location: 'Berlin', units: 'celsius', extraMetadata: {traceId: 't-42'}}],
+    });
+  });
+
+  it('throws Unknown tool naming the requested tool when execute is called for an unregistered name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('missing_tool', {})).rejects.toThrow('Unknown tool: missing_tool');
+  });
+
+  it('compiles a static tool inputSchema once at registration across ten execute calls', async () => {
+    let schemaReads = 0;
+    const staticSchema: Record<string, unknown> = {
+      type: 'object',
+      get properties() {
+        schemaReads += 1;
+        return {query: {type: 'string'}};
+      },
+      required: ['query'],
+    };
+    const registry = new ToolRegistry();
+    let executedCount = 0;
+    registry.register(
+      {
+        name: 'search_catalog',
+        description: 'Search catalog entries',
+        inputSchema: staticSchema,
+      },
+      async () => {
+        executedCount += 1;
+        return 'hit';
+      }
+    );
+    const readsAtRegistration = schemaReads;
+
+    for (let round = 0; round < 10; round += 1) {
+      await registry.execute('search_catalog', {query: `item-${round}`});
+    }
+
+    expect({
+      compiledAtRegistration: readsAtRegistration > 0,
+      extraReadsAcrossTenCalls: schemaReads - readsAtRegistration,
+      executedCount,
+    }).toEqual({
+      compiledAtRegistration: true,
+      extraReadsAcrossTenCalls: 0,
+      executedCount: 10,
+    });
+  });
+
+  it('validates function-valued tool definitions against each call schema and caches compiled validators by schema reference', async () => {
+    let citySchemaReads = 0;
+    const citySchema: Record<string, unknown> = {
+      type: 'object',
+      get properties() {
+        citySchemaReads += 1;
+        return {city: {type: 'string'}};
+      },
+      required: ['city'],
+    };
+    let activeSchema = citySchema;
+    const executedInputs: Array<Record<string, unknown>> = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      () => ({
+        name: 'dynamic_weather',
+        description: 'Look up weather using the active schema',
+        inputSchema: activeSchema,
+      }),
+      async input => {
+        executedInputs.push(input);
+        return 'ok';
+      }
+    );
+
+    const readSnapshots: number[] = [];
+    await registry.execute('dynamic_weather', {city: 'Berlin'});
+    readSnapshots.push(citySchemaReads);
+    activeSchema = {
+      type: 'object',
+      properties: {postalCode: {type: 'string'}},
+      required: ['postalCode'],
+    };
+    const staleCityRejected = await registry.execute('dynamic_weather', {city: 'Berlin'});
+    await registry.execute('dynamic_weather', {postalCode: '10115'});
+    activeSchema = citySchema;
+    await registry.execute('dynamic_weather', {city: 'Munich'});
+    const cachedCityRejected = await registry.execute('dynamic_weather', {postalCode: '10115'});
+
+    expect({
+      executedInputs,
+      staleCityMentionsPostal: /postalCode.*required/i.test(staleCityRejected.result),
+      cachedCityMentionsCity: /city.*required/i.test(cachedCityRejected.result),
+      compiledCitySchemaOnce: readSnapshots[0] > 0 && citySchemaReads === readSnapshots[0],
+    }).toEqual({
+      executedInputs: [{city: 'Berlin'}, {postalCode: '10115'}, {city: 'Munich'}],
+      staleCityMentionsPostal: true,
+      cachedCityMentionsCity: true,
+      compiledCitySchemaOnce: true,
+    });
+  });
+
+  it('reports root-level schema constraint failures without calling the executor or leaking values', async () => {
+    const warnings: string[] = [];
+    const captureWarn = (_category: string, message: string, fields?: Record<string, unknown>) => {
+      warnings.push(`${message}:${JSON.stringify(fields ?? {})}`);
+    };
+    setLogger({debug: () => {}, info: () => {}, warn: captureWarn, error: () => {}});
+
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(
+      {
+        name: 'strict_lookup',
+        description: 'Rejects undeclared top-level keys when schema opts in',
+        inputSchema: {
+          type: 'object',
+          properties: {id: {type: 'string'}},
+          required: ['id'],
+          additionalProperties: false,
+        },
+      },
+      async () => {
+        calls += 1;
+        return 'ok';
+      }
+    );
+
+    const rejection = await registry.execute('strict_lookup', {id: '42', bearerSecret: 'tok_live_998877'});
+
+    expect({
+      calls,
+      resultSummary: rejection.result,
+      loggedRootFailure: warnings.some(line => line.includes('"<root>"') && line.includes('"additionalProperties"')),
+      leakedSecret:
+        rejection.result.includes('tok_live_998877') || warnings.some(line => line.includes('tok_live_998877')),
+    }).toEqual({
+      calls: 0,
+      resultSummary: 'Invalid input for tool "strict_lookup": <root> failed additionalProperties constraint',
+      loggedRootFailure: true,
+      leakedSecret: false,
+    });
+  });
+
+  it('normalizes legacy dataPath and nested instancePath validator errors without leaking params', () => {
+    const loggedFields: Array<Record<string, unknown> | undefined> = [];
+    const skipLevel = () => undefined;
+    setLogger({
+      debug: skipLevel,
+      info: skipLevel,
+      warn: (_category, _message, fields) => {
+        loggedFields.push(fields);
+      },
+      error: skipLevel,
+    });
+
+    const rejection = buildSchemaRejection('ssn_lookup', [
+      {keyword: 'required', dataPath: '', params: {missingProperty: 'location'}},
+      {keyword: 'type', dataPath: '.ssn', params: {type: 'string'}},
+      {keyword: 'type', dataPath: "['api-key']", params: {type: 'string'}},
+      {keyword: 'required', dataPath: '.tags[0]', params: {missingProperty: 'code'}},
+      {keyword: 'enum', dataPath: '.filter.city', params: {allowedValues: ['SecretCity']}},
+      {keyword: 'additionalProperties', dataPath: '', params: {additionalProperty: 'secretField'}},
+      {keyword: 'type', instancePath: '/filter/postalCode', params: {type: 'string'}},
+      {keyword: 'type', params: {type: 'object'}},
+    ]);
+
+    expect({
+      result: rejection.result,
+      loggedFields,
+      leaksAllowedValue: JSON.stringify({rejection, loggedFields}).includes('SecretCity'),
+      leaksAdditionalProperty: JSON.stringify({rejection, loggedFields}).includes('secretField'),
+    }).toEqual({
+      result:
+        'Invalid input for tool "ssn_lookup": ' +
+        'location is required; ' +
+        'ssn must be of type string; ' +
+        'api-key must be of type string; ' +
+        'tags.0.code is required; ' +
+        'filter.city failed enum constraint; ' +
+        '<root> failed additionalProperties constraint; ' +
+        'filter.postalCode must be of type string; ' +
+        '<root> must be of type object',
+      loggedFields: [
+        {
+          name: 'ssn_lookup',
+          failures: [
+            {path: 'location', constraint: 'required'},
+            {path: 'ssn', constraint: 'type: string'},
+            {path: 'api-key', constraint: 'type: string'},
+            {path: 'tags.0.code', constraint: 'required'},
+            {path: 'filter.city', constraint: 'enum'},
