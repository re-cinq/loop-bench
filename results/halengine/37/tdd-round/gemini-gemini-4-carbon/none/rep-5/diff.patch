+import {ToolRegistry, createSchemaCompiler, formatValidationError} from './registry.js';
+import type {OutgoingMessage} from '../../types/messages.js';
+import {setLogger} from '../../shared/logger.js';
+
+function installRecordingLogger(): string[] {
+  const emittedLogs: string[] = [];
+  const recordLog = (category: string, message: string, fields?: Record<string, unknown>) => {
+    emittedLogs.push(JSON.stringify({category, message, fields}));
+  };
+  setLogger({debug: recordLog, info: recordLog, warn: recordLog, error: recordLog});
+  return emittedLogs;
+}
+
+describe('ToolRegistry', () => {
+  afterEach(() => {
+    setLogger(undefined);
+  });
+
+  it('throws synchronously from register naming the tool when a static inputSchema is invalid', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'weather_lookup',
+          description: 'Look up weather for a city',
+          inputSchema: {
+            type: 'object',
+            properties: {location: {type: 'invalid-json-schema-type'}},
+          },
+        },
+        async () => 'sunny'
+      )
+    ).toThrow(/weather_lookup/);
+  });
+
+  it('returns a ToolResponse naming a missing required location and skips the executor', async () => {
+    const registry = new ToolRegistry();
+    let callCount = 0;
+    const executor = async () => {
+      callCount += 1;
+      return 'forecast';
+    };
+    const locationProperty = {type: 'string'};
+    const requiredKeys = ['location'];
+    registry.register(
+      {
+        name: 'forecast_by_location',
+        description: 'Fetch forecast',
+        inputSchema: {type: 'object', properties: {location: locationProperty}, required: requiredKeys},
+      },
+      executor
+    );
+
+    const response = await registry.execute('forecast_by_location', {});
+
+    expect({
+      callCount,
+      namesLocationRequired: response.result.includes('location') && /required/i.test(response.result),
+    }).toEqual({
+      callCount: 0,
+      namesLocationRequired: true,
+    });
+  });
+
+  it('rejects invalid input naming field paths and constraints without leaking values', async () => {
+    const registry = new ToolRegistry();
+    let invocations = 0;
+    registry.register(
+      {
+        name: 'patient_record',
+        description: 'Fetch patient record',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            nationalId: {type: 'string'},
+            units: {type: 'string', enum: ['celsius', 'fahrenheit']},
+          },
+          required: ['nationalId'],
+          additionalProperties: false,
+        },
+      },
+      async () => {
+        invocations += 1;
+        return 'record';
+      }
+    );
+    const emittedLogs = installRecordingLogger();
+
+    const response = await registry.execute('patient_record', {
+      nationalId: 987654321,
+      units: 'kelvin-secret',
+      apiToken: 'tok-99999',
+    });
+    const combinedLogs = emittedLogs.join(' ');
+    const secrets = ['987654321', 'kelvin-secret', 'tok-99999'];
+
+    expect({
+      invocations,
+      namesWrongTypeField: response.result.includes('nationalId') && response.result.includes('string'),
+      namesEnumConstraint: response.result.includes('units') && response.result.includes('celsius, fahrenheit'),
+      namesUnexpectedField: response.result.includes('apiToken'),
+      logsFailurePaths:
+        combinedLogs.includes('nationalId') && combinedLogs.includes('units') && combinedLogs.includes('apiToken'),
+      leaksValuesInResult: secrets.some(secret => response.result.includes(secret)),
+      leaksValuesInLogs: secrets.some(secret => combinedLogs.includes(secret)),
+    }).toEqual({
+      invocations: 0,
+      namesWrongTypeField: true,
+      namesEnumConstraint: true,
+      namesUnexpectedField: true,
+      logsFailurePaths: true,
+      leaksValuesInResult: false,
+      leaksValuesInLogs: false,
+    });
+  });
+
+  it('passes valid input with undeclared extra properties through unchanged without coercion or defaults', async () => {
+    const registry = new ToolRegistry();
+    const receivedInputs: Array<Record<string, unknown>> = [];
+    const clientMessages: OutgoingMessage[] = [{type: 'entry_commit', index: 0}];
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+            units: {type: 'string', enum: ['celsius', 'fahrenheit'], default: 'celsius'},
+            zipCode: {type: 'string'},
+          },
+          required: ['location'],
+        },
+      },
+      async input => {
+        receivedInputs.push({...input});
+        return {result: '18C', clientMessages, suppressAssistantResponse: true};
+      }
+    );
+
+    const response = await registry.execute('get_weather', {
+      location: 'Berlin',
+      zipCode: '10115',
+      traceId: 'req-42',
+    });
+
+    expect({response, receivedInputs}).toEqual({
+      response: {result: '18C', clientMessages, suppressAssistantResponse: true},
+      receivedInputs: [{location: 'Berlin', zipCode: '10115', traceId: 'req-42'}],
+    });
+  });
+
+  it('throws Unknown tool for an unregistered tool name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('unregistered_tool', {})).rejects.toThrow('Unknown tool: unregistered_tool');
+  });
+
+  it('compiles a static inputSchema once at register time across ten execute calls', async () => {
+    const registry = new ToolRegistry();
+    let schemaReads = 0;
+    let executions = 0;
+    registry.register(
+      {
+        name: 'ping',
+        description: 'Ping endpoint',
+        promptInstructions: 'Use for connectivity checks.',
+        examplePrompts: ['Ping the server'],
+        get inputSchema(): Record<string, unknown> {
+          schemaReads += 1;
+          return {
+            type: 'object',
+            properties: {seq: {type: 'number'}},
+            required: ['seq'],
+          };
+        },
+      },
+      async () => {
+        executions += 1;
+        return 'pong';
+      }
+    );
+
+    const responses = await Promise.all(Array.from({length: 10}, (_, seq) => registry.execute('ping', {seq})));
+    const registeredPing = registry.get('ping');
+
+    expect({
+      schemaReads,
+      executions,
+      hasPing: registry.has('ping'),
+      registeredName: registeredPing?.definition.name,
+      promptInstructions: registry.getPromptInstructions(),
+      examplePrompts: registry.getExamplePrompts(),
+      missingTool: registry.get('absent'),
+      allPong: responses.every(entry => entry.result === 'pong'),
+    }).toEqual({
+      schemaReads: 1,
+      executions: 10,
+      hasPing: true,
+      registeredName: 'ping',
+      promptInstructions: ['ping: Use for connectivity checks.'],
+      examplePrompts: ['Ping the server'],
+      missingTool: undefined,
+      allPong: true,
+    });
+  });
+
+  it('validates dynamic definitions against each call schema and caches validators', async () => {
+    let citySchemaReads = 0;
+    const citySchema: Record<string, unknown> = {
+      type: 'object',
+      get properties() {
+        citySchemaReads += 1;
+        return {city: {type: 'string'}};
+      },
+      required: ['city'],
+    };
+    let activeSchema = citySchema;
+    const seenInputs: Array<Record<string, unknown>> = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      () => ({
+        name: 'locate',
+        description: 'Resolve location dynamically',
+        inputSchema: activeSchema,
+      }),
+      async input => {
+        seenInputs.push(input);
+        return 'ok';
+      }
+    );
+
+    const outcomes: string[] = [`reads:${citySchemaReads}`];
+    outcomes.push((await registry.execute('locate', {country: 'NL'})).result);
+    outcomes.push(`reads:${citySchemaReads}`);
+
+    const countrySchema: Record<string, unknown> = {
+      type: 'object',
+      properties: {country: {type: 'string'}},
+      required: ['country'],
+    };
+    activeSchema = countrySchema;
+    outcomes.push((await registry.execute('locate', {city: 'Amsterdam'})).result);
+    outcomes.push((await registry.execute('locate', {country: 'NL'})).result);
+
+    activeSchema = citySchema;
+    outcomes.push((await registry.execute('locate', {city: 'Amsterdam'})).result);
+    outcomes.push(`reads:${citySchemaReads}`);
+
+    expect({
+      readsBeforeFirstExecute: outcomes[0],
+      firstRejectedCity: outcomes[1]?.includes('city'),
+      compiledOnFirstExecute: outcomes[2] !== 'reads:0',
+      secondRejectedCountry: outcomes[3]?.includes('country'),
+      secondPassResult: outcomes[4],
+      cachedPassResult: outcomes[5],
+      reusedCachedValidator: outcomes[6] === outcomes[2],
+      seenInputs,
+    }).toEqual({
+      readsBeforeFirstExecute: 'reads:0',
+      firstRejectedCity: true,
+      compiledOnFirstExecute: true,
+      secondRejectedCountry: true,
+      secondPassResult: 'ok',
+      cachedPassResult: 'ok',
+      reusedCachedValidator: true,
+      seenInputs: [{country: 'NL'}, {city: 'Amsterdam'}],
+    });
+  });
+
+  it('initializes schema compilers from constructor or default exports and formats dataPath errors', () => {
+    const seenOptions = captureCompilerOptions();
+
+    expect({
+      seenOptions,
+      legacyTypeFailure: formatValidationError({
+        keyword: 'type',
+        dataPath: '/nested/city',
+        params: {type: 'string'},
+        message: 'should be string',
+      }),
+      legacyMissingChild: formatValidationError({
+        keyword: 'required',
+        dataPath: '/nested',
+        params: {missingProperty: 'postalCode'},
+        message: "should have required property 'postalCode'",
+      }),
+      rootKeywordFallback: formatValidationError({
+        keyword: 'minProperties',
+        params: {},
+      }),
+    }).toEqual({
+      seenOptions: [
+        {format: false, unknownFormats: 'ignore', jsonPointers: true, allErrors: true},
+        {strict: false, validateFormats: false, allErrors: true},
+      ],
+      legacyTypeFailure: 'nested.city: should be string',
+      legacyMissingChild: "nested.postalCode: should have required property 'postalCode'",
+      rootKeywordFallback: 'failed "minProperties" constraint',
+    });
+  });
+
+  it('throws from createSchemaCompiler when the module export is not a constructor', () => {
+    expect(() => createSchemaCompiler(null)).toThrow('Unable to initialize Ajv validator');
+  });
+});
+
+function captureCompilerOptions(): Array<Record<string, unknown>> {
+  const seenOptions: Array<Record<string, unknown>> = [];
+  class LegacyCompilerStub {
+    constructor(options: Record<string, unknown>) {
+      seenOptions.push(options);
+    }
+    compile() {
+      return () => true;
+    }
+  }
+  class VocabularyCompilerStub {
+    constructor(options: Record<string, unknown>) {
+      seenOptions.push(options);
+    }
+    addVocabulary(): boolean {
+      return true;
+    }
+    compile() {
+      return () => true;
+    }
+  }
+  createSchemaCompiler(LegacyCompilerStub);
+  createSchemaCompiler({default: VocabularyCompilerStub});
+  return seenOptions;
+}
