@@ -519,4 +519,83 @@ describe('ChatOrchestrator tool loop', () => {
 
     expect(seen).toEqual(usage);
   });
+
+  it('feeds a schema rejection back to the provider as a tool_result and resolves after retry', async () => {
+    const registry = new ToolRegistry();
+    const executedInputs: Array<Record<string, unknown>> = [];
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for a city',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async input => {
+        executedInputs.push(input);
+        return '18C in Berlin';
+      }
+    );
+    const seenParams: SendMessageParams[] = [];
+    const provider = recordingProvider(
+      [
+        [{type: 'tool_use', toolCall: {id: 'call-bad', name: 'get_weather', input: {}}}, STOP_FOR_TOOL],
+        [
+          {type: 'tool_use', toolCall: {id: 'call-good', name: 'get_weather', input: {location: 'Berlin'}}},
+          STOP_FOR_TOOL,
+        ],
+        [{type: 'text', text: 'It is 18C in Berlin.'}, STOP_DONE],
+      ],
+      seenParams
+    );
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+
+    const reply = await orchestrator.processMessage(createSession('weather in Berlin'));
+    const rejectionSentToProvider = readToolResultText(seenParams[1], 'call-bad');
+
+    expect({
+      reply,
+      executedInputs,
+      rejectionNamesLocation: rejectionSentToProvider.includes('location') && /required/i.test(rejectionSentToProvider),
+    }).toEqual({
+      reply: 'It is 18C in Berlin.',
+      executedInputs: [{location: 'Berlin'}],
+      rejectionNamesLocation: true,
+    });
+  });
 });
+
+function recordingProvider(rounds: MessageChunk[][], seenParams: SendMessageParams[]): AIProvider {
+  let round = 0;
+
+  return {
+    async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      seenParams.push({...params, messages: [...params.messages]});
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+function readToolResultText(params: SendMessageParams | undefined, toolUseId: string): string {
+  for (const message of params?.messages ?? []) {
+    const match = findToolResultInMessage(message, toolUseId);
+    if (match !== undefined) return match;
+  }
+  return '';
+}
+
+function findToolResultInMessage(
+  message: SendMessageParams['messages'][number],
+  toolUseId: string
+): string | undefined {
+  if (!Array.isArray(message.content)) return undefined;
+  for (const part of message.content) {
+    if (part.type === 'tool_result' && part.toolUseId === toolUseId) return part.content;
+  }
+  return undefined;
+}
