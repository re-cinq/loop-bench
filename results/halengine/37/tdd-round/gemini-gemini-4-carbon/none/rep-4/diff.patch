+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+import {ToolRegistry, createSchemaCompiler, formatValidationErrors} from './registry.js';
+
+const rejectionOf = (call: Promise<unknown>): Promise<string> =>
+  call.then(() => 'resolved without throwing').catch((failure: Error) => failure.message);
+
+const thrownBy = (action: () => unknown): string => {
+  try {
+    action();
+    return 'returned without throwing';
+  } catch (failure) {
+    return failure instanceof Error ? failure.message : String(failure);
+  }
+};
+
+describe('ToolRegistry', () => {
+  afterEach(() => {
+    setLogger(undefined);
+  });
+
+  it('compiles static schemas under lenient rules and throws naming invalid tools', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'schedule_event',
+        description: 'Schedules an event',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            startsAt: {type: 'string', format: 'date-time', example: '2026-11-14T10:00:00Z'},
+          },
+          required: ['startsAt'],
+        },
+      },
+      async () => 'scheduled'
+    );
+
+    const scheduleResponse = await registry.execute('schedule_event', {startsAt: 'tomorrow morning'});
+    let thrownMessage = '';
+    try {
+      registry.register(
+        {
+          name: 'malformed_lookup',
+          description: 'Declares an unknown JSON Schema type',
+          inputSchema: {
+            type: 'object',
+            properties: {query: {type: 'nonexistent-schema-type'}},
+          },
+        },
+        async () => 'unreachable'
+      );
+    } catch (failure) {
+      thrownMessage = failure instanceof Error ? failure.message : String(failure);
+    }
+
+    expect({
+      hasValidLenientTool: registry.has('schedule_event'),
+      nonIsoFormatAccepted: scheduleResponse.result,
+      hasMalformedTool: registry.has('malformed_lookup'),
+      namesMalformedTool: thrownMessage.includes('malformed_lookup'),
+    }).toEqual({
+      hasValidLenientTool: true,
+      nonIsoFormatAccepted: 'scheduled',
+      hasMalformedTool: false,
+      namesMalformedTool: true,
+    });
+  });
+
+  it('validates required, type, and enum rules without leaking values and keeps extra keys', async () => {
+    const emittedLogs: string[] = [];
+    const recordEntry = (category: string, message: string, fields?: Record<string, unknown>) => {
+      emittedLogs.push(JSON.stringify({category, message, fields}));
+    };
+    const logger: Logger = {
+      debug: recordEntry,
+      info: recordEntry,
+      warn: recordEntry,
+      error: recordEntry,
+    };
+    setLogger(logger);
+
+    const registry = new ToolRegistry();
+    const receivedInputs: Array<Record<string, unknown>> = [];
+    registry.register(
+      {
+        name: 'book_flight',
+        description: 'Books a flight segment',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            cabin: {type: 'string', enum: ['economy', 'business']},
+            passenger: {
+              type: 'object',
+              properties: {passportNumber: {type: 'string'}},
+              required: ['passportNumber'],
+            },
+          },
+          required: ['cabin', 'passenger'],
+        },
+      },
+      async input => {
+        receivedInputs.push(input);
+        return 'booked';
+      }
+    );
+    registry.register(
+      {
+        name: 'strict_ping',
+        description: 'Accepts no extra fields',
+        inputSchema: {
+          type: 'object',
+          minProperties: 1,
+          properties: {
+            target: {type: 'string', minLength: 2},
+            'meta/tag~id': {type: ['string', 'number']},
+            nested: {
+              type: 'object',
+              properties: {code: {type: 'string'}},
+              required: ['code'],
+              additionalProperties: false,
+            },
+          },
+          additionalProperties: false,
+        },
+      },
+      async () => ({
+        result: 'pong',
+        clientMessages: [{type: 'stream_end'}],
+        suppressAssistantResponse: true,
+      })
+    );
+
+    const validPayload = {
+      cabin: 'economy',
+      passenger: {passportNumber: 'AB123'},
+      seatPreference: 'aisle',
+    };
+    const emptyStrictResponse = await registry.execute('strict_ping', {});
+    const validStrictResponse = await registry.execute('strict_ping', {target: 'ok'});
+    const [missingResponse, rejectedResponse, objectTypeResponse, unexpectedPropResponse, acceptedResponse] =
+      await Promise.all([
+        registry.execute('book_flight', {}),
+        registry.execute('book_flight', {cabin: 'vip-secret', passenger: {passportNumber: 987654321}}),
+        registry.execute('book_flight', {cabin: 'economy', passenger: 'raw-passenger-secret'}),
+        registry.execute('strict_ping', {
+          target: 'x',
+          'meta/tag~id': true,
+          nested: {extraKey: 'nested-secret'},
+          unexpectedToken: 'token-secret-42',
+        }),
+        registry.execute('book_flight', validPayload),
+      ]);
+    const secrets = ['vip-secret', '987654321', 'raw-passenger-secret', 'nested-secret', 'token-secret-42'];
+    const mentionsSecret = (text: string) => secrets.some(secret => text.includes(secret));
+    const rejectedTexts = [
+      rejectedResponse.result,
+      objectTypeResponse.result,
+      emptyStrictResponse.result,
+      unexpectedPropResponse.result,
+    ];
+
+    expect({
+      missingCabinNamed: missingResponse.result.includes('cabin') && /required/i.test(missingResponse.result),
+      nestedPathNamed: rejectedResponse.result.includes('passenger.passportNumber'),
+      expectedStringNamed: rejectedResponse.result.includes('string'),
+      expectedObjectNamed:
+        objectTypeResponse.result.includes('passenger') && objectTypeResponse.result.includes('object'),
+      allowedEnumNamed: rejectedResponse.result.includes('economy'),
+      rootConstraintNamed: emptyStrictResponse.result.includes('input failed "minProperties" constraint'),
+      unexpectedKeyNamed: unexpectedPropResponse.result.includes('unexpectedToken'),
+      nestedMissingNamed: unexpectedPropResponse.result.includes('nested.code'),
+      nestedUnexpectedNamed: unexpectedPropResponse.result.includes('nested.extraKey'),
+      fallbackConstraintNamed: unexpectedPropResponse.result.includes('minLength'),
+      unionNamed: unexpectedPropResponse.result.includes('meta/tag~id" must be of type string | number'),
+      leakedSecretInResult: rejectedTexts.some(mentionsSecret),
+      leakedSecretInLogs: emittedLogs.some(mentionsSecret),
+      strictResponse: validStrictResponse,
+      acceptedResult: acceptedResponse.result,
+      receivedInputs,
+    }).toEqual({
+      missingCabinNamed: true,
+      nestedPathNamed: true,
+      expectedStringNamed: true,
+      expectedObjectNamed: true,
+      allowedEnumNamed: true,
+      rootConstraintNamed: true,
+      unexpectedKeyNamed: true,
+      nestedMissingNamed: true,
+      nestedUnexpectedNamed: true,
+      fallbackConstraintNamed: true,
+      unionNamed: true,
+      leakedSecretInResult: false,
+      leakedSecretInLogs: false,
+      strictResponse: {
+        result: 'pong',
+        clientMessages: [{type: 'stream_end'}],
+        suppressAssistantResponse: true,
+      },
+      acceptedResult: 'booked',
+      receivedInputs: [validPayload],
+    });
+  });
+
+  it('reuses static validators across ten calls and caches dynamic ones by schema', async () => {
+    const registry = new ToolRegistry();
+    let staticSchemaReads = 0;
+    registry.register(
+      {
+        name: 'convert_units',
+        description: 'Converts measurement units',
+        get inputSchema(): Record<string, unknown> {
+          staticSchemaReads += 1;
+          return {
+            type: 'object',
+            properties: {unit: {type: 'string'}},
+            required: ['unit'],
+          };
+        },
+      },
+      async input => String(input.unit)
+    );
+
+    const staticResults: string[] = [];
+    for (let callIndex = 0; callIndex < 10; callIndex += 1) {
+      const staticReply = await registry.execute('convert_units', {unit: 'km'});
+      staticResults.push(staticReply.result);
+    }
+
+    let strictTypeReads = 0;
+    const strictSchema: Record<string, unknown> = {
+      get type(): string {
+        strictTypeReads += 1;
+        return 'object';
+      },
+      properties: {region: {type: 'string', enum: ['eu', 'us']}},
+      required: ['region'],
+    };
+
+    let activeSchema = strictSchema;
+    registry.register(
+      () => ({
+        name: 'deploy_service',
+        description: 'Deploys to an allowed region',
+        inputSchema: activeSchema,
+      }),
+      async input => `deployed:${String(input.region)}`
+    );
+    const runWithSchema = async (schema: Record<string, unknown>, region: string): Promise<string> => {
+      activeSchema = schema;
+      const reply = await registry.execute('deploy_service', {region});
+      return reply.result;
+    };
+
+    const firstStrictResult = await runWithSchema(strictSchema, 'apac');
+    const readsAfterFirstCompile = strictTypeReads;
+    const cachedStrictResult = await runWithSchema(strictSchema, 'eu');
+    const expandedSchema: Record<string, unknown> = {
+      type: 'object',
+      properties: {region: {type: 'string', enum: ['eu', 'us', 'apac']}},
+      required: ['region'],
+    };
+    const expandedResult = await runWithSchema(expandedSchema, 'apac');
+    const restoredStrictResult = await runWithSchema(strictSchema, 'apac');
+
+    expect({
+      staticSchemaReads,
+      staticCallCount: staticResults.length,
+      compiledDynamicSchema: readsAfterFirstCompile > 0,
+      reusedCachedDynamicValidator: strictTypeReads === readsAfterFirstCompile,
+      firstStrictRejected: firstStrictResult.includes('region'),
+      cachedStrictAccepted: cachedStrictResult,
+      expandedAccepted: expandedResult,
+      restoredStrictRejected: restoredStrictResult.includes('region'),
+    }).toEqual({
+      staticSchemaReads: 1,
+      staticCallCount: 10,
+      compiledDynamicSchema: true,
+      reusedCachedDynamicValidator: true,
+      firstStrictRejected: true,
+      cachedStrictAccepted: 'deployed:eu',
+      expandedAccepted: 'deployed:apac',
+      restoredStrictRejected: true,
+    });
+  });
+
+  it('throws Unknown tool naming an unregistered tool and exposes registered metadata', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'lookup_docs',
+        description: 'Finds documentation pages',
+        promptInstructions: 'Use when asked about docs.',
+        examplePrompts: ['Show docs for hooks'],
+        inputSchema: {type: 'object'},
+      },
+      async () => ({result: 'found'})
+    );
+    registry.register(
+      {
+        name: 'silent_ping',
+        description: 'Carries no prompt instructions or examples',
+        inputSchema: {type: 'object'},
+      },
+      async () => 'ok'
+    );
+
+    const rejection = await rejectionOf(registry.execute('unregistered_lookup', {}));
+    const lookedUp = registry.get('lookup_docs');
+    const lookedUpDefinition = lookedUp?.definition;
+    const definitions = registry.getDefinitions();
+
+    expect({
+      rejection,
+      registeredName: lookedUpDefinition?.name,
+      missingTool: registry.get('unregistered_lookup'),
+      definitionCount: definitions.length,
+      instructions: registry.getPromptInstructions(),
+      examples: registry.getExamplePrompts(),
+    }).toEqual({
+      rejection: 'Unknown tool: unregistered_lookup',
+      registeredName: 'lookup_docs',
+      missingTool: undefined,
+      definitionCount: 2,
+      instructions: ['lookup_docs: Use when asked about docs.'],
+      examples: ['Show docs for hooks'],
+    });
+  });
+
+  it('resolves direct CommonJS and default-exported schema compilers and formats legacy dataPath errors', () => {
+    const receivedOptions: Array<Record<string, unknown>> = [];
+    function DirectCompiler(options: Record<string, unknown>) {
+      receivedOptions.push(options);
+      return {
+        compile: () => () => true,
+      };
+    }
+
+    const directValidator = createSchemaCompiler(DirectCompiler).compile({type: 'object'});
+    const wrappedValidator = createSchemaCompiler({default: DirectCompiler}).compile({type: 'object'});
+    const nullExportFailure = thrownBy(() => createSchemaCompiler(null));
+    const emptyExportFailure = thrownBy(() => createSchemaCompiler({}));
+    const legacyViolations = formatValidationErrors([
+      {keyword: 'required', dataPath: '', params: {missingProperty: 'location'}},
+      {keyword: 'type', dataPath: '/meta~1tag~0id', params: {type: 'string,number'}},
+      {keyword: 'enum', dataPath: '/units', params: {allowedValues: 'unexpected'}},
+      {keyword: 'minLength', instancePath: '/label', params: {limit: 2}},
+    ]);
+
+    expect({
+      directAccepted: directValidator({}),
+      wrappedAccepted: wrappedValidator({}),
+      optionSetCount: receivedOptions.length,
+      firstOptions: receivedOptions[0],
+      nullExportFailure,
+      emptyExportFailure,
+      legacyViolations,
+      emptyErrorFallback: formatValidationErrors(undefined),
+    }).toEqual({
+      directAccepted: true,
+      wrappedAccepted: true,
+      optionSetCount: 2,
+      firstOptions: {
+        strict: false,
+        validateFormats: false,
+        format: false,
+        jsonPointers: true,
+        logger: false,
+        allErrors: true,
+      },
+      nullExportFailure: 'Failed to resolve JSON Schema compiler constructor',
+      emptyExportFailure: 'Failed to resolve JSON Schema compiler constructor',
