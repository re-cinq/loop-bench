+import {setLogger} from '../../shared/logger.js';
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry', () => {
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('throws synchronously at register time for an uncompilable schema and names the tool', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'lookup_forecast',
+          description: 'Look up forecast by city',
+          inputSchema: {type: 'bogus_schema_type'},
+        },
+        async () => 'unused'
+      )
+    ).toThrow(/lookup_forecast/);
+  });
+
+  it('rejects invalid input with failing paths and constraints while omitting input values from result and logs', async () => {
+    const capturedLogs: string[] = [];
+    const capture = (category: string, message: string, fields?: Record<string, unknown>) => {
+      capturedLogs.push(JSON.stringify({category, message, fields}));
+    };
+    setLogger({debug: capture, info: capture, warn: capture, error: capture});
+
+    let invocations = 0;
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'lookup_customer',
+        description: 'Look up customer record',
+        inputSchema: {
+          type: 'object',
+          properties: {taxId: {type: 'string'}, country: {type: 'string'}},
+          required: ['taxId', 'country'],
+        },
+      },
+      async () => {
+        invocations += 1;
+        return 'customer-record';
+      }
+    );
+
+    const toolResponse = await registry.execute('lookup_customer', {taxId: 987654321});
+
+    expect({
+      invocations,
+      namesTypedField: toolResponse.result.includes('taxId'),
+      namesExpectedType: toolResponse.result.includes('string'),
+      namesMissingField: toolResponse.result.includes('country'),
