+import type {ToolDefinition} from '../../types/ai.js';
+import {setLogger} from '../../shared/logger.js';
+import {ToolRegistry, createValidatorCompiler} from './registry.js';
+import type {SchemaValidator, ValidatorCompiler} from './registry.js';
+
+describe('ToolRegistry', () => {
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('rejects missing required location without invoking the executor', async () => {
+    let executorCallCount = 0;
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Fetch weather for a city',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+            filter: {
+              type: 'object',
+              properties: {unit: {type: 'string'}},
+              required: ['unit'],
+            },
+          },
+          required: ['location'],
+        },
+      },
+      async () => {
+        executorCallCount += 1;
+        return 'sunny';
+      }
+    );
+
+    const rootRejection = await registry.execute('get_weather', {});
+    const nestedRejection = await registry.execute('get_weather', {location: 'Berlin', filter: {}});
+
+    expect({
+      executorCallCount,
+      namesMissingLocation: rootRejection.result.includes('location') && rootRejection.result.includes('required'),
+      namesMissingNested: nestedRejection.result.includes('filter.unit'),
+    }).toEqual({
+      executorCallCount: 0,
+      namesMissingLocation: true,
+      namesMissingNested: true,
+    });
+  });
+
+  it('rejects wrong-typed fields and extra schema constraints without leaking values to result or logs', async () => {
+    const loggedLines: string[] = [];
+    const recordLog = (category: string, message: string, fields?: Record<string, unknown>) => {
+      loggedLines.push(JSON.stringify({category, message, fields}));
+    };
+    setLogger({debug: recordLog, info: recordLog, warn: recordLog, error: recordLog});
+
+    let executorCallCount = 0;
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'lookup_customer',
+        description: 'Lookup customer record',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            accountEmail: {type: 'string', minLength: 5},
+            zipCode: {type: 'string'},
+          },
+          required: ['accountEmail', 'zipCode'],
+        },
+      },
+      async () => {
+        executorCallCount += 1;
+        return 'found';
+      }
+    );
+
+    const typeRejection = await registry.execute('lookup_customer', {
+      accountEmail: 'alice@private.example',
+      zipCode: 90210,
+    });
+    const lengthRejection = await registry.execute('lookup_customer', {
+      accountEmail: 'ab',
+      zipCode: '10115',
+    });
+    const combinedOutput = [typeRejection.result, lengthRejection.result, ...loggedLines].join(' ');
+    const containsSensitiveValue = combinedOutput.includes('alice@private.example') || combinedOutput.includes('90210');
+
+    expect({
+      executorCallCount,
+      namesFieldAndType: typeRejection.result.includes('zipCode') && typeRejection.result.includes('string'),
+      namesKeywordConstraint:
+        lengthRejection.result.includes('accountEmail') && lengthRejection.result.includes('minLength'),
+      containsSensitiveValue,
+    }).toEqual({
+      executorCallCount: 0,
+      namesFieldAndType: true,
+      namesKeywordConstraint: true,
+      containsSensitiveValue: false,
+    });
+  });
+
+  it('names nested additionalProperties and JSON-Pointer-escaped field paths without leaking values', async () => {
+    const loggedLines: string[] = [];
+    const captureLog = (category: string, message: string, fields?: Record<string, unknown>) => {
+      loggedLines.push(JSON.stringify({category, message, fields}));
+    };
+    setLogger({debug: captureLog, info: captureLog, warn: captureLog, error: captureLog});
+
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'strict_lookup',
+        description: 'Strict schema lookup',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            'meta/tag~id': {type: 'string'},
+            filter: {
+              type: 'object',
+              properties: {unit: {type: 'string'}},
+              additionalProperties: false,
+            },
+          },
+          additionalProperties: false,
+        },
+      },
+      async () => 'ok'
+    );
+
+    const nestedRejection = await registry.execute('strict_lookup', {
+      'meta/tag~id': 404,
+      filter: {unit: 'celsius', apiToken: 'secret-token-77'},
+    });
+    const rootExtraRejection = await registry.execute('strict_lookup', {
+      rootSecret: 'top-secret-88',
+    });
+    const allText = [nestedRejection.result, rootExtraRejection.result, ...loggedLines].join(' ');
+    const leaksAnySecret = ['secret-token-77', 'top-secret-88', '404'].some(secret => allText.includes(secret));
+
+    expect({
+      namesEscapedField: nestedRejection.result.includes('meta/tag~id') && nestedRejection.result.includes('string'),
+      namesNestedUnexpectedPath:
+        nestedRejection.result.includes('filter.apiToken') && nestedRejection.result.includes('additionalProperties'),
+      namesRootUnexpectedPath:
+        rootExtraRejection.result.includes('rootSecret') && rootExtraRejection.result.includes('additionalProperties'),
+      leaksAnySecret,
+    }).toEqual({
+      namesEscapedField: true,
+      namesNestedUnexpectedPath: true,
+      namesRootUnexpectedPath: true,
+      leaksAnySecret: false,
+    });
+  });
+
+  it('passes valid input with undeclared extra properties through to the executor unchanged once', async () => {
+    const receivedInputs: Array<Record<string, unknown>> = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'get_forecast',
+        description: 'Get forecast',
+        promptInstructions: 'Check weather',
+        examplePrompts: ['Weather in Paris?'],
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+            units: {type: 'string', enum: ['celsius', 'fahrenheit']},
+          },
+          required: ['location'],
+        },
+      },
+      async input => {
+        receivedInputs.push(input);
+        return {
+          result: 'sunny',
+          clientMessages: [{type: 'entry_commit', index: 0}],
+          suppressAssistantResponse: true,
+        };
+      }
+    );
+    registry.register({name: 'ping', description: 'Health ping', inputSchema: {type: 'object'}}, async () => 'pong');
+
+    const forecastResponse = await registry.execute('get_forecast', {
+      location: 'Berlin',
+      units: 'celsius',
+      extraTraceId: 'trace-42',
+      rawCount: '007',
+    });
+    const pingResponse = await registry.execute('ping', {});
+    const registered = registry.get('get_forecast');
+
+    expect({
+      receivedInputs,
+      suppressAssistantResponse: forecastResponse.suppressAssistantResponse,
+      pingResult: pingResponse.result,
+      hasForecast: registry.has('get_forecast'),
+      registeredName: registered?.definition.name,
+      absentLookup: registry.get('absent'),
+      promptInstructions: registry.getPromptInstructions(),
+      examplePrompts: registry.getExamplePrompts(),
+    }).toEqual({
+      receivedInputs: [{location: 'Berlin', units: 'celsius', extraTraceId: 'trace-42', rawCount: '007'}],
+      suppressAssistantResponse: true,
+      pingResult: 'pong',
+      hasForecast: true,
+      registeredName: 'get_forecast',
+      absentLookup: undefined,
+      promptInstructions: ['get_forecast: Check weather'],
+      examplePrompts: ['Weather in Paris?'],
+    });
+  });
+
+  it('throws Unknown tool for an unregistered tool name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('missing_tool', {location: 'Berlin'})).rejects.toThrow('Unknown tool: missing_tool');
+  });
+
+  it('compiles static inputSchema at register time, allowing formats and naming invalid tools', () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'schedule_event',
+        description: 'Schedule an event',
+        inputSchema: {
+          type: 'object',
+          properties: {when: {type: 'string', format: 'date-time', 'x-ui': 'picker'}},
+        },
+      },
+      async () => ({result: 'ok'})
+    );
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'bad_schema_tool',
+          description: 'Invalid schema',
+          inputSchema: {type: 'not-a-type'},
+        },
+        async () => ({result: 'ok'})
+      )
+    ).toThrow(/bad_schema_tool/);
+  });
+
+  it('compiles a static tool schema once across ten execute calls', async () => {
+    let schemaTypeReads = 0;
+    let definitionSchemaReads = 0;
+    const staticSchema: Record<string, unknown> = {
+      get type() {
+        schemaTypeReads += 1;
+        return 'object';
+      },
+      properties: {city: {type: 'string'}},
+      required: ['city'],
+    };
+    const staticDefinition: ToolDefinition = {
+      name: 'lookup_city',
+      description: 'Lookup city',
+      get inputSchema() {
+        definitionSchemaReads += 1;
+        return staticSchema;
+      },
+    };
+    const registry = new ToolRegistry();
+    registry.register(staticDefinition, async () => 'ok');
+
+    const readsAfterRegister = schemaTypeReads;
+    let completedCalls = 0;
+    for (let callIndex = 0; callIndex < 10; callIndex += 1) {
+      await registry.execute('lookup_city', {city: 'Berlin'});
+      completedCalls += 1;
+    }
+
+    expect({
+      definitionSchemaReads,
+      compiledAtRegister: readsAfterRegister > 0,
+      reusedCompiledValidator: schemaTypeReads === readsAfterRegister,
+      completedCalls,
+    }).toEqual({
+      definitionSchemaReads: 1,
+      compiledAtRegister: true,
+      reusedCompiledValidator: true,
+      completedCalls: 10,
+    });
+  });
+
+  it('validates function-valued tool definitions against each call schema while caching per schema object', async () => {
+    let alphaTypeReads = 0;
+    const schemaAlpha: Record<string, unknown> = {
+      get type() {
+        alphaTypeReads += 1;
+        return 'object';
+      },
+      properties: {mode: {type: 'string', enum: ['alpha']}},
+      required: ['mode'],
+    };
+    let activeSchema = schemaAlpha;
+    const executorInputs: Array<Record<string, unknown>> = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      () => ({
+        name: 'dynamic_mode',
+        description: 'Switches schema dynamically',
+        inputSchema: activeSchema,
+      }),
+      async input => {
+        executorInputs.push(input);
+        return 'accepted';
+      }
+    );
+
+    const readSnapshots: number[] = [alphaTypeReads];
+    await registry.execute('dynamic_mode', {mode: 'alpha'});
+    readSnapshots.push(alphaTypeReads);
+    await registry.execute('dynamic_mode', {mode: 'alpha'});
+    readSnapshots.push(alphaTypeReads);
+
+    const schemaBeta: Record<string, unknown> = {
+      type: 'object',
+      properties: {mode: {type: 'string', enum: ['beta']}},
+      required: ['mode'],
+    };
+    activeSchema = schemaBeta;
+    const staleAttempt = await registry.execute('dynamic_mode', {mode: 'alpha'});
+    const updatedAttempt = await registry.execute('dynamic_mode', {mode: 'beta'});
+
+    expect({
+      compiledLazilyOnce: readSnapshots[0] === 0 && readSnapshots[1] > 0 && readSnapshots[2] === readSnapshots[1],
+      executorInputs,
+      staleRejectedNamingField: staleAttempt.result.includes('mode') && !staleAttempt.result.includes('alpha'),
+      updatedAccepted: updatedAttempt.result,
+    }).toEqual({
+      compiledLazilyOnce: true,
+      executorInputs: [{mode: 'alpha'}, {mode: 'alpha'}, {mode: 'beta'}],
+      staleRejectedNamingField: true,
+      updatedAccepted: 'accepted',
+    });
+  });
+
+  it('normalizes legacy dataPath errors and configures compatible validator compilers', async () => {
+    const legacyProbe = buildLegacyCompilerProbe();
+    const legacyRegistry = new ToolRegistry(legacyProbe.compiler);
+    legacyRegistry.register(
+      {name: 'legacy_check', description: 'Legacy schema check', inputSchema: {type: 'object'}},
+      async () => 'ok'
+    );
+
+    const modernProbe = buildModernCompilerProbe();
