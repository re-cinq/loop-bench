+          schemaReads += 1;
+          return staticSchema;
+        },
+      },
+      async input => `hit:${String(input.query)}`
+    );
+
+    const responses = await Promise.all(
+      Array.from({length: 10}, (_, index) => registry.execute('searchDocs', {query: `term-${index}`}))
+    );
+
+    expect({
+      compileCount: compiledSchemas.length,
+      schemaReads,
+      resultsCount: responses.length,
+    }).toEqual({
+      compileCount: 1,
+      schemaReads: 1,
+      resultsCount: 10,
+    });
+  });
+
+  it('caches compiled validators by schema reference for function-valued definitions and enforces the active schema', async () => {
+    const {registry, compiledSchemas} = createCountingRegistry();
+    const firstSchema = {type: 'object', required: ['alpha'], properties: {alpha: {type: 'string'}}};
+    const secondSchema = {type: 'object', required: ['beta'], properties: {beta: {type: 'string'}}};
+    let activeSchema: Record<string, unknown> = firstSchema;
+    registry.register(
+      () => ({name: 'dynamicLookup', description: 'Lookup by active field', inputSchema: activeSchema}),
+      async () => 'accepted'
+    );
+
+    const firstAccepted = await registry.execute('dynamicLookup', {alpha: 'one'});
+    activeSchema = secondSchema;
+    const staleRejected = await registry.execute('dynamicLookup', {alpha: 'stale'});
+    const secondAccepted = await registry.execute('dynamicLookup', {beta: 'two'});
+    activeSchema = firstSchema;
+    const cachedAccepted = await registry.execute('dynamicLookup', {alpha: 'three'});
+
+    expect({
+      compiledSchemas,
+      firstResult: firstAccepted.result,
+      staleNamesBeta: staleRejected.result.includes('beta') && /required/i.test(staleRejected.result),
+      secondResult: secondAccepted.result,
+      cachedResult: cachedAccepted.result,
+    }).toEqual({
+      compiledSchemas: [firstSchema, secondSchema],
+      firstResult: 'accepted',
+      staleNamesBeta: true,
+      secondResult: 'accepted',
+      cachedResult: 'accepted',
+    });
+  });
+
+  it('unwraps nested ESM default validator exports with modern Ajv options and formats nested required paths', async () => {
+    const {moduleExport, readOptions} = createModernValidatorExport();
+    const esmCompiler = createSchemaCompiler(moduleExport);
+    const registry = new ToolRegistry(esmCompiler);
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'saveContact',
+        description: 'Save contact details',
+        inputSchema: {type: 'object'},
+        promptInstructions: 'Provide contact email',
+        examplePrompts: ['Save my email'],
+      },
+      async () => {
+        executorCalls += 1;
+        return 'saved';
+      }
+    );
+
+    const response = await registry.execute('saveContact', {contact: {}});
+    const savedTool = registry.get('saveContact');
+
+    expect({
+      executorCalls,
+      registered: registry.has('saveContact') && savedTool?.definition.name === 'saveContact',
+      absentTool: registry.get('nonexistentTool'),
+      instructions: registry.getPromptInstructions(),
+      examples: registry.getExamplePrompts(),
+      options: readOptions(),
+      namesNestedRequired: response.result.includes('contact.email') && /required/i.test(response.result),
+    }).toEqual({
+      executorCalls: 0,
+      registered: true,
+      absentTool: undefined,
+      instructions: ['saveContact: Provide contact email'],
+      examples: ['Save my email'],
+      options: {strict: false, validateFormats: false, allErrors: true},
+      namesNestedRequired: true,
+    });
+  });
+});
+
+function captureLogs(): string[] {
+  const entries: string[] = [];
+  const sink = (...parts: unknown[]) => void entries.push(JSON.stringify(parts));
+  setLogger({debug: sink, info: sink, warn: sink, error: sink});
+  return entries;
+}
+
+class CjsValidatorStub implements SchemaCompiler {
+  private readonly receivedOptions: Record<string, unknown> | undefined;
+
+  constructor(options?: Record<string, unknown>) {
+    this.receivedOptions = options;
+  }
+
+  compile(): SchemaValidator {
+    const validator: SchemaValidator = () => {
+      void this.receivedOptions;
+      validator.errors = [{keyword: 'type', dataPath: '/contact/email', params: {type: 'string'}}];
+      return false;
+    };
+    return validator;
+  }
+}
+
+function createCountingRegistry(): {registry: ToolRegistry; compiledSchemas: Array<Record<string, unknown>>} {
+  const baseCompiler = createSchemaCompiler();
+  const compiledSchemas: Array<Record<string, unknown>> = [];
+  const registry = new ToolRegistry({
+    compile: schema => {
+      compiledSchemas.push(schema);
+      return baseCompiler.compile(schema);
+    },
+  });
+  return {registry, compiledSchemas};
+}
+
+function createModernValidatorExport(): {
+  moduleExport: ValidatorExport;
+  readOptions: () => Record<string, unknown> | undefined;
+} {
+  let capturedOptions: Record<string, unknown> | undefined;
+
+  class ModernValidatorStub implements SchemaCompiler {
+    constructor(options?: Record<string, unknown>) {
+      capturedOptions = options;
+    }
+
+    compile(): SchemaValidator {
+      const validator: SchemaValidator = () => {
+        validator.errors = [{keyword: 'required', instancePath: '/contact', params: {missingProperty: 'email'}}];
+        return false;
+      };
+      return validator;
+    }
+  }
+
+  Object.defineProperty(ModernValidatorStub.prototype, '_addVocabularies', {value: () => undefined});
+  return {
+    moduleExport: {default: {default: ModernValidatorStub}},
+    readOptions: () => capturedOptions,
+  };
+}
