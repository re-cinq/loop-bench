+import {setLogger} from '../../shared/logger.js';
+import {ToolRegistry, createSchemaCompiler} from './registry.js';
+import type {SchemaCompiler, SchemaValidator, ValidatorExport} from './registry.js';
+
+describe('ToolRegistry', () => {
+  afterEach(() => {
+    setLogger(undefined);
+  });
+
+  it('returns a rejection naming missing required location and skips the executor when called with empty input', async () => {
+    const registry = new ToolRegistry();
+    let invocationCount = 0;
+    const forecastTool = {
+      name: 'fetchForecast',
+      description: 'Fetch forecast by city',
+      inputSchema: {type: 'object', required: ['location'], properties: {location: {type: 'string'}}},
+    };
+    registry.register(forecastTool, async () => {
+      invocationCount += 1;
+      return 'clear';
+    });
+
+    const rejection = await registry.execute('fetchForecast', {});
+
+    expect({
+      invocationCount,
+      namesLocation: rejection.result.includes('location'),
+      namesRequired: /required/i.test(rejection.result),
+    }).toEqual({
+      invocationCount: 0,
+      namesLocation: true,
+      namesRequired: true,
+    });
+  });
+
+  it('rejects invalid input naming failing paths and constraints without leaking values', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'updateProfile',
+        description: 'Update user profile preferences',
+        inputSchema: {
+          type: 'object',
+          required: ['location', 'contact', 'units'],
+          properties: {
+            location: {type: 'string'},
+            contact: {type: 'object', required: ['email'], properties: {email: {type: 'string', format: 'email'}}},
+            units: {type: 'string', enum: ['celsius', 'fahrenheit']},
+          },
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'updated';
+      }
+    );
+
+    const logEntries = captureLogs();
+    const response = await registry.execute('updateProfile', {
+      contact: {email: 987654},
+      units: 'kelvin-val',
+      ssn: '123-45-6789',
+    });
+    const combinedOutput = [response.result, ...logEntries].join(' ');
+
+    expect({
+      executorCalls,
+      namesMissingLocation: response.result.includes('location') && /required/i.test(response.result),
+      namesNestedTypeFailure: response.result.includes('contact.email') && response.result.includes('string'),
+      namesEnumFailure: response.result.includes('units') && /enum/i.test(response.result),
+      loggedWarning: logEntries.some(entry => entry.includes('contact.email') && entry.includes('location')),
+      leakedFieldValue: ['987654', 'kelvin-val', '123-45-6789'].some(secret => combinedOutput.includes(secret)),
+    }).toEqual({
+      executorCalls: 0,
+      namesMissingLocation: true,
+      namesNestedTypeFailure: true,
+      namesEnumFailure: true,
+      loggedWarning: true,
+      leakedFieldValue: false,
+    });
+  });
+
+  it('formats failing nested dataPath fields when constructed from a direct CJS validator export', async () => {
+    const cjsCompiler = createSchemaCompiler(CjsValidatorStub);
+    const registry = new ToolRegistry(cjsCompiler);
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'syncContact',
+        description: 'Sync contact record',
+        inputSchema: {type: 'object'},
+      },
+      async () => {
+        executorCalls += 1;
+        return 'synced';
+      }
+    );
+
+    const response = await registry.execute('syncContact', {contact: {email: 404}});
+
+    expect({
+      executorCalls,
+      namesNestedPath: response.result.includes('contact.email') && response.result.includes('string'),
+      leakedNumber: response.result.includes('404'),
+    }).toEqual({
+      executorCalls: 0,
+      namesNestedPath: true,
+      leakedNumber: false,
+    });
+  });
+
+  it('passes valid input with unlisted extra properties through unchanged once without defaults or coercion', async () => {
+    const registry = new ToolRegistry();
+    const receivedInputs: Array<Record<string, unknown>> = [];
+    registry.register(
+      {
+        name: 'lookupWeather',
+        description: 'Look up weather forecast',
+        inputSchema: {
+          type: 'object',
+          required: ['location', 'postalCode'],
+          properties: {
+            location: {type: 'string', format: 'custom-city-format'},
+            postalCode: {type: 'string'},
+            units: {type: 'string', enum: ['celsius', 'fahrenheit'], default: 'celsius'},
+          },
+        },
+      },
+      async input => {
+        receivedInputs.push(input);
+        return {result: 'forecast-ok', clientMessages: [{type: 'pong', timestamp: 0}], suppressAssistantResponse: true};
+      }
+    );
+
+    const callerInput = {location: 'Berlin', postalCode: '10115', traceTag: 'req-99'};
+    const response = await registry.execute('lookupWeather', callerInput);
+
+    expect({
+      result: response.result,
+      suppressAssistantResponse: response.suppressAssistantResponse,
