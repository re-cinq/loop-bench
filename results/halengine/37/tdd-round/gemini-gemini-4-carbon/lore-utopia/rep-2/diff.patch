+      result: 'forecast-ok',
+      suppressAssistantResponse: true,
+      receivedInputs: [{location: 'Berlin', postalCode: '10115', traceTag: 'req-99'}],
+    });
+  });
+
+  it('throws Unknown tool when execute is called with an unregistered tool name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('missingTool', {})).rejects.toThrow('Unknown tool: missingTool');
+  });
+
+  it('throws synchronously from register naming the tool when a static inputSchema is uncompilable', () => {
+    const registry = new ToolRegistry();
+    const malformedDefinition = {
+      name: 'lookupOrder',
+      description: 'Fetch an order',
+      inputSchema: {type: 'object', required: 'orderId'},
+    };
+
+    expect(() => registry.register(malformedDefinition, async () => 'ok')).toThrow(/lookupOrder/);
+  });
+
+  it('compiles a static tool inputSchema once at register time across ten execute calls', async () => {
+    const {registry, compiledSchemas} = createCountingRegistry();
