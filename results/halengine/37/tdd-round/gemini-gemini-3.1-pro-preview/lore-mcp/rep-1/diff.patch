index dbe7b33..6ec472d 100644
--- a/src/orchestration/chatOrchestrator.test.ts
+++ b/src/orchestration/chatOrchestrator.test.ts
@@ -410,6 +410,60 @@ describe('ChatOrchestrator tool loop', () => {
     expect(chunks.map(c => c.type)).toEqual(['tool_use', 'stop', 'text', 'stop']);
   });
 
+  it('drives a stub provider through a rejected tool call followed by a corrected retry without rejecting', async () => {
+    let callCount = 0;
+    let interceptedMessage: unknown;
+
+    const provider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        callCount++;
+        if (callCount === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'c1', name: 'my_tool', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+
