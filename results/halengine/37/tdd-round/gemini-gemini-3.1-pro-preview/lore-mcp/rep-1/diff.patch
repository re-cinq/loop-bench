+import {jest} from '@jest/globals';
+import {ToolRegistry, type ToolExecutor} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+describe('ToolRegistry', () => {
+  function createRegistryAndExecute() {
+    const registry = new ToolRegistry();
+    const execute = jest.fn<ToolExecutor>().mockResolvedValue('success');
+    return {registry, execute};
+  }
+
+  function registerTool(
+    registry: ToolRegistry,
+    execute: jest.Mock<ToolExecutor>,
+    schemaProps: unknown,
+    required: string[] = []
+  ) {
+    registry.register(
+      {
+        name: 'test-tool',
+        description: 'A test tool',
+        inputSchema: {
+          type: 'object',
+          // eslint-disable-next-line @typescript-eslint/no-explicit-any
+          properties: schemaProps as any,
+          required,
+        },
+      } as unknown as ToolDefinition,
+      execute
+    );
+  }
+
+  describe('execute', () => {
+    it('rejects input missing a required property with a ToolResponse and never calls the executor', async () => {
+      const {registry, execute} = createRegistryAndExecute();
+      registerTool(registry, execute, {location: {type: 'string'}}, ['location']);
+
+      const response = await registry.execute('test-tool', {});
+
+      const calls = execute.mock.calls;
+      expect({calls: calls.length, result: response.result}).toEqual({
+        calls: 0,
+        result: expect.stringMatching(/(must|should) have required property 'location'/),
+      });
+    });
+
+    it('passes valid input with an unlisted extra property through to the executor unchanged exactly once', async () => {
+      const {registry, execute} = createRegistryAndExecute();
+      registerTool(registry, execute, {location: {type: 'string'}}, ['location']);
+
+      const input = {location: 'Paris', extra: 'data'};
+      await registry.execute('test-tool', input);
+
+      expect(execute.mock.calls).toEqual([[input]]);
+    });
+
+    it('rejects a wrong-typed field with a message naming the field path and expected type, without leaking the value', async () => {
+      const {registry, execute} = createRegistryAndExecute();
+      registerTool(registry, execute, {location: {type: 'string'}});
+
+      const response = await registry.execute('test-tool', {location: 42});
+
+      const calls = execute.mock.calls;
+      expect({
+        calls: calls.length,
+        hasPath:
+          typeof response.result === 'string' &&
+          (response.result.includes('/location') || response.result.includes('.location')),
+        hasType:
+          typeof response.result === 'string' &&
+          (response.result.includes('must be string') || response.result.includes('should be string')),
+        hasValue: typeof response.result === 'string' && response.result.includes('42'),
+      }).toEqual({
+        calls: 0,
+        hasPath: true,
+        hasType: true,
+        hasValue: false,
+      });
+    });
+
+    it('throws Unknown tool: <name> for an unregistered name', async () => {
+      const {registry} = createRegistryAndExecute();
+      await expect(registry.execute('non-existent', {})).rejects.toThrow('Unknown tool: non-existent');
+    });
+
+    it('validates a function-valued tool definition against the schema current at that call', async () => {
+      const {registry, execute} = createRegistryAndExecute();
+      let callCount = 0;
+      registry.register(() => {
+        callCount++;
+        return {
+          name: 'dynamic-tool',
+          description: 'A dynamic tool',
+          inputSchema: {
+            type: 'object',
+            properties: {flag: {type: callCount <= 2 ? 'string' : 'number'}},
+          },
+        } as unknown as ToolDefinition;
+      }, execute);
+
+      const r1 = await registry.execute('dynamic-tool', {flag: 'value'});
+      const r2 = await registry.execute('dynamic-tool', {flag: 42});
+      const r3 = await registry.execute('dynamic-tool', {flag: 'value'});
+
+      const calls = execute.mock.calls;
+      expect({
+        calls: calls.length,
+        r1,
+        r2,
+        r3IsNumberError:
+          typeof r3.result === 'string' &&
+          (r3.result.includes('must be number') || r3.result.includes('should be number')),
+      }).toEqual({
+        calls: 2,
+        r1: {result: 'success'},
+        r2: {result: 'success'},
+        r3IsNumberError: true,
+      });
+    });
+
+    it('compiles a static tool schema once across multiple execute calls', async () => {
+      const {registry, execute} = createRegistryAndExecute();
+      registerTool(registry, execute, {location: {type: 'string'}});
+
+      // eslint-disable-next-line @typescript-eslint/no-explicit-any
+      const internalAjv = (registry as any).ajv;
+      const originalCompile = internalAjv.compile;
+
+      // eslint-disable-next-line @typescript-eslint/no-explicit-any
+      const compileSpy = jest.fn((...args: any[]) => originalCompile.apply(internalAjv, args));
+      internalAjv.compile = compileSpy;
+
+      for (let i = 0; i < 10; i++) {
+        await registry.execute('test-tool', {location: 'Paris'});
+      }
+
+      const executeCalls = execute.mock.calls;
+      const compileCalls = compileSpy.mock.calls;
+      expect({
+        executeCalls: executeCalls.length,
+        compileCalls: compileCalls.length,
+      }).toEqual({
+        executeCalls: 10,
+        compileCalls: 0,
+      });
+    });
+  });
+
+  describe('register', () => {
+    it('throws at registration time for an uncompilable static schema', () => {
+      const {registry, execute} = createRegistryAndExecute();
+
+      expect(() => {
+        registerTool(registry, execute, {location: {type: 'invalid-type-xyz'}});
+      }).toThrow('Failed to compile schema for tool test-tool');
+    });
+  });
+});
