+
+  const registerStringLookup = (registry: ToolRegistry): void => {
+    registry.register(
+      {
+        name: 'lookup_record',
+        description: 'Look up a record',
+        inputSchema: {
+          type: 'object',
+          properties: {identifier: {type: 'string'}},
+          required: ['identifier'],
+        },
+      },
+      async () => 'found'
+    );
+  };
+
+  it('returns a required-property rejection without running the tool', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    const weatherDefinition = {
+      name: 'get_weather',
+      description: 'Get weather for a location',
+      inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+    } satisfies ToolDefinition;
+    registry.register(weatherDefinition, async () => ((executorCalls += 1), 'sunny'));
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({executorCalls, rejectionNamesRequiredLocation: /location.*required/i.test(response.result)}).toEqual({
+      executorCalls: 0,
+      rejectionNamesRequiredLocation: true,
+    });
+  });
+
+  it('reports complete paths for nested required and type errors', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'nested_lookup',
+        description: 'Look up a nested value',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            user: {
+              type: 'object',
+              properties: {location: {type: 'string'}},
+              required: ['location'],
+            },
+          },
+          required: ['user'],
+        },
+      },
+      async () => 'found'
+    );
+
+    const response = await registry.execute('nested_lookup', {user: {}});
+
+    const wrongTypeResponse = await registry.execute('nested_lookup', {user: {location: 123}});
+
+    expect({
+      requiredPath: response.result.includes('/user/location'),
+      wrongTypePath: wrongTypeResponse.result.includes('/user/location'),
+    }).toEqual({requiredPath: true, wrongTypePath: true});
+  });
+
+  it('reports the expected type at a nested property path', async () => {
+    const compile = jest.spyOn(Ajv.prototype, 'compile').mockReturnValue(
+      Object.assign(() => false, {
+        errors: [{keyword: 'type', dataPath: '.user.location', params: {type: 'string'}}],
+      }) as never
+    );
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'nested_type_lookup',
+        description: 'Look up a nested value',
+        inputSchema: {
+          type: 'object',
+          properties: {user: {type: 'object', properties: {location: {type: 'string'}}}},
+        },
+      },
+      async () => 'found'
+    );
+
+    const response = await registry.execute('nested_type_lookup', {user: {location: 123456789}});
+    compile.mockRestore();
+
+    expect(response.result).toBe('Invalid input at /user/location: must be a string.');
+  });
+
+  it('describes the expected type for an invalid field without echoing its value', async () => {
+    const registry = new ToolRegistry();
+    registerStringLookup(registry);
+
+    const response = await registry.execute('lookup_record', {identifier: 912345});
+
+    expect({
+      namesExpectedType: response.result.includes('string'),
+      leaksValue: response.result.includes('912345'),
+    }).toEqual({
+      namesExpectedType: true,
+      leaksValue: false,
+    });
+  });
+
+  it('does not enforce schema constraints beyond required, type, and enum', async () => {
+    const registry = new ToolRegistry();
+    let received: Record<string, unknown> | undefined;
+    registry.register(
+      {
+        name: 'short_label',
+        description: 'Accept a short label',
+        inputSchema: {
+          type: 'object',
+          properties: {label: {type: 'string', minLength: 4}},
+          required: ['label'],
+        },
+      },
+      async input => {
+        received = input;
+        return 'accepted';
+      }
+    );
+
+    const input = {label: 'x', extra: true};
+    const response = await registry.execute('short_label', input);
+
+    expect({response, received}).toEqual({response: {result: 'accepted'}, received: input});
+  });
+
+  it('compiles a static schema only once across repeated executions', async () => {
+    const compile = jest.spyOn(Ajv.prototype, 'compile');
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'cached_tool',
+        description: 'A tool with a cached schema',
+        inputSchema: {type: 'object', properties: {value: {type: 'string'}}},
+      },
+      async () => 'ok'
+    );
+
+    for (let attempt = 0; attempt < 10; attempt += 1) {
+      await registry.execute('cached_tool', {value: 'valid'});
+    }
+
+    expect(compile).toHaveBeenCalledTimes(1);
+    compile.mockRestore();
+  });
+
+  it('names the field path for a wrong-typed property', async () => {
+    const registry = new ToolRegistry();
+    registerStringLookup(registry);
+
+    const response = await registry.execute('lookup_record', {identifier: 123456789});
+
+    expect(response.result).toContain('/identifier');
+  });
+
+  it('names the property in a top-level type rejection', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'ssn_lookup',
+        description: 'Look up a record by identifier',
+        inputSchema: {type: 'object', properties: {ssn: {type: 'string'}}, required: ['ssn']},
+      },
+      async () => 'found'
+    );
+
+    const response = await registry.execute('ssn_lookup', {ssn: 123456789});
+
+    expect(response.result).toContain('/ssn');
+  });
+});
