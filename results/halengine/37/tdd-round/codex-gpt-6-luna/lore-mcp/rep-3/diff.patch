+import {ToolRegistry} from './registry.js';
+import Ajv from 'ajv';
+import {jest} from '@jest/globals';
+
+describe('ToolRegistry', () => {
+  it('rejects input missing a required property with a ToolResponse and never calls the executor', async () => {
+    const registry = new ToolRegistry();
+    const executor = jest.fn(async () => 'sunny');
+    registry.register(weatherTool, executor);
+
+    const response = await registry.execute('get_weather', {});
+    const executorCalls = executor.mock.calls;
+
+    expect({result: response.result, calls: executorCalls.length}).toEqual({
+      result: expect.stringMatching(/location.*required/i),
+      calls: 0,
+    });
+  });
+
+  it('compiles a static schema once across ten executions', async () => {
+    const registry = new ToolRegistry();
+    const compile = jest.spyOn(Ajv.prototype, 'compile');
+    registry.register(weatherTool, async () => 'sunny');
+
+    for (let call = 0; call < 10; call += 1) {
+      await registry.execute('get_weather', {location: 'Paris'});
+    }
+
+    expect(compile).toHaveBeenCalledTimes(1);
+    compile.mockRestore();
+  });
+
+  it('validates each function-valued definition against its current schema', async () => {
+    let currentSchema = stringSchema;
+    const registry = new ToolRegistry();
+    const executor = jest.fn(async () => 'accepted');
+    registry.register(() => ({...weatherTool, inputSchema: currentSchema}), executor);
+    const compile = jest.spyOn(Ajv.prototype, 'compile');
+
+    const first = await registry.execute('get_weather', {location: 'Paris'});
+    await registry.execute('get_weather', {location: 'Berlin'});
+    currentSchema = numberSchema;
+    const second = await registry.execute('get_weather', {location: 'Paris'});
+    const executorCalls = executor.mock.calls;
+    const compilationCalls = compile.mock.calls;
+
+    expect({
+      first: first.result,
+      second: second.result,
+      executorCalls: executorCalls.length,
+      compilations: compilationCalls.length,
+    }).toEqual({
+      first: 'accepted',
+      second: expect.stringMatching(/\/location.*number/i),
+      executorCalls: 2,
+      compilations: 2,
+    });
+    compile.mockRestore();
+  });
+
+  it('passes valid input with undeclared properties through unchanged', async () => {
+    const registry = new ToolRegistry();
+    const input = {location: 'Paris', debugLabel: 'kept'};
+    let receivedInput: Record<string, unknown> | undefined;
+    const executor = jest.fn(async (received: Record<string, unknown>) => {
+      receivedInput = received;
+      return JSON.stringify(received);
+    });
+    registry.register(weatherTool, executor);
+
+    await registry.execute('get_weather', input);
+
+    expect(receivedInput).toEqual(input);
+  });
+
+  it('throws for an unregistered tool name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('missing_tool', {})).rejects.toThrow('Unknown tool: missing_tool');
+  });
+});
+
+const weatherTool = {
+  name: 'get_weather',
+  description: 'Get weather for a location',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}},
+    required: ['location'],
+  },
+};
+
+const stringSchema = weatherTool.inputSchema;
+const numberSchema = {
+  type: 'object',
+  properties: {location: {type: 'number'}},
+  required: ['location'],
+};
