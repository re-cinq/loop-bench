@@ -398,6 +398,51 @@ const chunksFrom = async (stream: AsyncGenerator<MessageChunk>): Promise<Message
 };
 
 describe('ChatOrchestrator tool loop', () => {
+  it('returns a schema rejection to the provider before a corrected retry', async () => {
+    const requests: SendMessageParams[] = [];
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        requests.push(params);
+        if (round++ === 0) {
+          yield {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {}}};
+          yield STOP_FOR_TOOL;
+          return;
+        }
+        if (round === 2) {
+          yield {type: 'tool_use', toolCall: {id: 'call-2', name: 'lookup', input: {q: 'x'}}};
+          yield STOP_FOR_TOOL;
+          return;
+        }
+        yield {type: 'text', text: 'recovered'};
+        yield STOP_DONE;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'lookup',
+        description: 'looks things up',
+        inputSchema: {type: 'object', properties: {q: {type: 'string'}}, required: ['q']},
+      },
+      async () => 'found'
+    );
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+
+    const result = await orchestrator.processMessage(createSession('ask'));
+
+    expect({
