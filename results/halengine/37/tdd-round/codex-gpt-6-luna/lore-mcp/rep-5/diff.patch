+import Ajv from 'ajv';
+import {jest} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry', () => {
+  const weatherDefinition = {
+    name: 'get_weather',
+    description: 'Get weather for a location',
+    inputSchema: {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    },
+  };
+  const registerWeatherTool = (registry: ToolRegistry, onExecute: () => void) => {
+    registry.register(weatherDefinition, async () => {
+      onExecute();
+      return 'sunny';
+    });
+  };
+
+  it('rejects input missing a required property and never calls the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registerWeatherTool(registry, () => executorCalls++);
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({executorCalls, result: response.result}).toEqual({
+      executorCalls: 0,
+      result: expect.stringMatching(/location.*required|required.*location/i),
+    });
+  });
+
+  it('rejects a wrong-typed property with its field path and expected type without exposing its value', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registerWeatherTool(registry, () => executorCalls++);
+
+    const response = await registry.execute('get_weather', {location: 123456789});
+
+    expect({
+      executorCalls,
+      namesField: response.result.includes('location'),
+      namesExpectedType: response.result.includes('string'),
+      leaksValue: response.result.includes('123456789'),
+    }).toEqual({executorCalls: 0, namesField: true, namesExpectedType: true, leaksValue: false});
+  });
+
+  it('reports a nested invalid property path', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'object', properties: {city: {type: 'string'}}}},
+        },
+      },
+      async () => 'sunny'
+    );
+
+    const response = await registry.execute('get_weather', {location: {city: 123456789}});
+
+    expect(response.result).toMatch(/location\.city.*string/i);
+  });
+
+  it('names a root property when its value has the wrong type', async () => {
+    const registry = new ToolRegistry();
+    registerWeatherTool(registry, () => undefined);
+
+    const response = await registry.execute('get_weather', {location: 123});
+
+    expect(response.result).toMatch(/location.*string/i);
+  });
+
+  it('rejects a property value outside its declared enum', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {unit: {type: 'string', enum: ['celsius', 'fahrenheit']}},
+          required: ['unit'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'sunny';
+      }
+    );
+
+    const response = await registry.execute('get_weather', {unit: 'kelvin'});
+
+    expect({executorCalls, result: response.result}).toEqual({
+      executorCalls: 0,
+      result: expect.stringMatching(/unit.*enum|enum.*unit/i),
+    });
+  });
+
+  it('reports the root property path from a type validation error', async () => {
+    const registry = new ToolRegistry();
+    registerWeatherTool(registry, () => undefined);
+
+    const response = await registry.execute('get_weather', {location: 123});
+
+    expect(response.result).toContain('location');
+  });
+
+  it('reports a disallowed property path without exposing its value', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'strict_tool',
+        description: 'Rejects extra properties',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, additionalProperties: false},
+      },
+      async () => 'unexpectedly executed'
+    );
+
+    const response = await registry.execute('strict_tool', {location: 'Paris', secretNote: 'private-value'});
+
+    expect({
+      namesProperty: /secretNote.*additionalProperties|additionalProperties.*secretNote/i.test(response.result),
+      leaksValue: response.result.includes('private-value'),
+    }).toEqual({namesProperty: true, leaksValue: false});
+  });
+
+  it('throws for an unregistered tool name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('missing-tool', {})).rejects.toThrow('Unknown tool: missing-tool');
+  });
+
+  it('passes valid input with undeclared properties through unchanged exactly once', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    let receivedInput: Record<string, unknown> | undefined;
+    registry.register(weatherDefinition, async input => {
+      executorCalls += 1;
+      receivedInput = input;
+      return 'sunny';
+    });
+    const input = {location: 'Paris', unit: 'celsius'};
+
+    await registry.execute('get_weather', input);
+
+    expect({executorCalls, receivedInput}).toEqual({executorCalls: 1, receivedInput: input});
+  });
+
+  it('validates function-valued definitions against the schema returned for each call', async () => {
+    let definitionVersion = 0;
+    const registry = new ToolRegistry();
+    registry.register(
+      () => ({
+        name: 'dynamic',
+        description: 'Dynamic schema tool',
+        inputSchema:
+          definitionVersion++ < 2
+            ? {type: 'object', properties: {first: {type: 'string'}}, required: ['first']}
+            : {type: 'object', properties: {second: {type: 'string'}}, required: ['second']},
+      }),
+      async () => 'ok'
+    );
+
+    const firstResponse = await registry.execute('dynamic', {first: 'one'});
+    const secondResponse = await registry.execute('dynamic', {first: 'one'});
+
+    expect({firstResult: firstResponse.result, secondResult: secondResponse.result}).toEqual({
+      firstResult: 'ok',
+      secondResult: expect.stringMatching(/second.*required|required.*second/i),
+    });
+  });
+
+  it('throws at registration naming the tool when its static schema is invalid', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {name: 'broken_tool', description: 'Invalid schema', inputSchema: {type: 'not-a-json-schema-type'}},
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken_tool/);
+  });
+
+  it('compiles a static schema once across repeated executions', async () => {
+    const compile = jest.spyOn(Ajv.prototype, 'compile');
+    try {
+      const registry = new ToolRegistry();
+      registerWeatherTool(registry, () => undefined);
+
+      for (let call = 0; call < 10; call++) {
+        await registry.execute('get_weather', {location: 'Paris'});
+      }
+
+      expect(compile).toHaveBeenCalledTimes(1);
+    } finally {
+      compile.mockRestore();
+    }
+  });
+});
