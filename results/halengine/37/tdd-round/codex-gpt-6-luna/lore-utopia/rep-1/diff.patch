@@ -0,0 +1,196 @@
+import {ToolRegistry} from './registry.js';
+import Ajv, {type ValidateFunction} from 'ajv';
+import {jest} from '@jest/globals';
+
+const compileCount = (compile: {mock: {calls: unknown[][]}}): number => {
+  const {calls} = compile.mock;
+  return calls.length;
+};
+const legacyErrorValidator = (keyword: string, dataPath: string, params: object): ValidateFunction =>
+  Object.assign(() => false, {errors: [{keyword, dataPath, params}]}) as unknown as ValidateFunction;
+
+describe('ToolRegistry input validation', () => {
+  it('compiles a static tool schema once across repeated executions', async () => {
+    const compile = jest.spyOn(Ajv.prototype, 'compile');
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async () => {
+        executorCalls += 1;
+        return 'sunny';
+      }
+    );
+    try {
+      for (let call = 0; call < 10; call += 1) await registry.execute('get_weather', {location: 'Oslo'});
+
+      const compileCallCount = compileCount(compile);
+      expect({compileCallCount, executorCalls}).toEqual({compileCallCount: 1, executorCalls: 10});
+    } finally {
+      compile.mockRestore();
+    }
+  });
+
+  it('normalizes legacy nested validation paths before reporting required properties', async () => {
+    const validator = legacyErrorValidator('required', '.address', {missingProperty: 'city/name'});
+    const compile = jest.spyOn(Ajv.prototype, 'compile').mockReturnValue(validator);
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            address: {
+              type: 'object',
+              properties: {'city/name': {type: 'string'}},
+              required: ['city/name'],
+            },
+          },
+        },
+      },
+      async () => 'sunny'
+    );
+
+    try {
+      const response = await registry.execute('get_weather', {address: {}});
+
+      expect(response.result).toBe('Input property /address/city~1name is required');
+    } finally {
+      compile.mockRestore();
+    }
+  });
+
+  it('formats legacy nested type-error paths as JSON pointers', async () => {
+    const validator = legacyErrorValidator('type', '.address.city', {type: 'string'});
+    const compile = jest.spyOn(Ajv.prototype, 'compile').mockReturnValue(validator);
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather',
+        inputSchema: {type: 'object'},
+      },
+      async () => 'sunny'
+    );
+
+    try {
+      const response = await registry.execute('get_weather', {address: {city: 42}});
+
+      expect(response.result).toBe('Input property /address/city must be string');
+    } finally {
+      compile.mockRestore();
+    }
+  });
+
+  it('names the full path of a missing nested required property', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            address: {
+              type: 'object',
+              properties: {city: {type: 'string'}},
+              required: ['city'],
+            },
+          },
+          required: ['address'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'sunny';
+      }
+    );
+
+    const response = await registry.execute('get_weather', {address: {}});
+
+    expect({result: response.result, executorCalls}).toEqual({
+      result: 'Input property /address/city is required',
+      executorCalls: 0,
+    });
+  });
+
+  it('uses the current function-valued schema and reuses validators by schema object', async () => {
+    const compile = jest.spyOn(Ajv.prototype, 'compile');
+    const registry = new ToolRegistry();
+    let definitionCalls = 0;
+    let executorCalls = 0;
+    const firstSchema = {type: 'object', properties: {first: {type: 'string'}}, required: ['first']};
+    const secondSchema = {type: 'object', properties: {second: {type: 'number'}}, required: ['second']};
+    registry.register(
+      () => ({
+        name: 'dynamic_tool',
+        description: 'Dynamic schema',
+        inputSchema: definitionCalls++ < 2 ? firstSchema : secondSchema,
+      }),
+      async () => {
+        executorCalls += 1;
+        return 'ok';
+      }
+    );
+
+    const first = await registry.execute('dynamic_tool', {first: 'yes'});
+    const staleSchemaRejected = await registry.execute('dynamic_tool', {first: 'yes'});
+    const second = await registry.execute('dynamic_tool', {second: 2});
+
+    try {
+      const compileCallCount = compileCount(compile);
+      expect({
+        results: [first.result, staleSchemaRejected.result, second.result],
+        compileCallCount,
+        executorCalls,
+      }).toEqual({
+        results: ['ok', 'Input property /second is required', 'ok'],
+        compileCallCount: 2,
+        executorCalls: 2,
+      });
+    } finally {
+      compile.mockRestore();
+    }
+  });
+
+  it('passes valid input with extra properties unchanged and throws for unknown tools', async () => {
+    const registry = new ToolRegistry();
+    const input = {location: 'Oslo', traceId: 'request-17'};
+    const execute = jest.fn(async (received: Record<string, unknown>) => JSON.stringify(received));
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      execute
+    );
+
+    const response = await registry.execute('get_weather', input);
+
+    const unknownToolOutcome = await registry.execute('missing_tool', {}).then(
+      () => 'resolved',
+      (error: Error) => error.message
+    );
+    const calls = execute.mock.calls;
+
+    expect({
+      result: response.result,
+      callCount: calls.length,
+      receivedInput: calls[0]?.[0],
+      unknownToolOutcome,
+    }).toEqual({
+      result: JSON.stringify(input),
+      callCount: 1,
+      receivedInput: input,
+      unknownToolOutcome: 'Unknown tool: missing_tool',
+    });
+  });
+});
