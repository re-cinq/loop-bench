+import Ajv from 'ajv';
+
+interface SchemaError {
+  keyword: string;
+  dataPath?: string;
+  instancePath?: string;
+  params: {missingProperty?: string; type?: string};
+  message?: string;
+}
+
+type SchemaValidator = ((input: unknown) => boolean) & {errors?: SchemaError[] | null};
+
+const ajv = new Ajv({validateFormats: false, strict: false} as ConstructorParameters<typeof Ajv>[0]);
+
+function validationFailure(name: string, validate: SchemaValidator): string {
+  const reasons = (validate.errors ?? []).map(error => {
+    if (error.keyword === 'required') {
+      const missing = String(error.params.missingProperty);
+      const path = formatErrorPath(error.instancePath ?? error.dataPath ?? '');
+      return `${path ? `${path}.` : ''}${missing} is required`;
+    }
+    const path = formatErrorPath(error.instancePath ?? error.dataPath ?? '') || '/';
+    if (error.keyword === 'enum') return `${path} must match the declared enum of allowed values`;
+    const expected = error.params.type;
+    return `${path} ${expected ? `must be ${expected}` : (error.message ?? 'is invalid')}`;
+  });
+  return `Invalid input for ${name}: ${reasons.join('; ')}`;
+}
+
+function formatErrorPath(path: string): string {
+  return path.replace(/^\//, '').replace(/\//g, '.');
+}
+
+function compileSchema(name: string, schema: Record<string, unknown>): SchemaValidator {
+  try {
+    return ajv.compile(schema as never) as SchemaValidator;
+  } catch (error) {
+    const detail = error instanceof Error ? error.message : String(error);
+    throw new Error(`Invalid inputSchema for tool ${name}: ${detail}`, {cause: error});
+  }
+}
 
