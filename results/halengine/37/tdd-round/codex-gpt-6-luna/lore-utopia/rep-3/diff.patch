+  it('feeds a rejected tool call back to the provider before a corrected retry', async () => {
+    const requests: SendMessageParams[] = [];
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        requests.push(params);
+        if (round++ === 0) {
+          yield {type: 'tool_use', toolCall: {id: 'bad-call', name: 'lookup', input: {}}};
+          yield STOP_FOR_TOOL;
+        }
+        if (round === 2) {
+          yield {type: 'tool_use', toolCall: {id: 'good-call', name: 'lookup', input: {q: 'x'}}};
+          yield STOP_FOR_TOOL;
+        }
+        if (round > 2) {
+          yield {type: 'text', text: 'found it'};
+          yield STOP_DONE;
+        }
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
