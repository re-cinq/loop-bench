+      retryContainsRejection: retryMessages.some(
+        message =>
+          message.role === 'user' &&
+          Array.isArray(message.content) &&
+          message.content.some(content => content.type === 'tool_result' && /q.*required/i.test(content.content))
+      ),
+      executorCalls,
+    }).toEqual({result: 'found it', retryContainsRejection: true, executorCalls: 1});
+  });
+
+  // @spec specs/hal-engine-tool-input-validation/spec.md#8
