+import {jest} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry dynamic inputSchema validation', () => {
+  // @spec specs/hal-engine-tool-input-validation/spec.md#1
+  it('reports a nested required property path in dot notation', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'nested_tool',
+        description: 'Validates a nested property',
+        inputSchema: {
+          type: 'object',
+          properties: {profile: {type: 'object', properties: {token: {type: 'string'}}, required: ['token']}},
+        },
+      },
+      async () => 'unreachable'
+    );
+
+    const response = await registry.execute('nested_tool', {profile: {}});
+
+    expect(response.result).toMatch(/profile\.token.*required/i);
+  });
+
+  // @spec specs/hal-engine-tool-input-validation/spec.md#1
+  it('rejects a missing required property without invoking the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    const execute = jest.fn(async () => {
+      executorCalls += 1;
+      return 'sunny';
+    });
+    registry.register(
+      () => ({
+        name: 'dynamic_weather',
+        description: 'Requires a location',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      }),
+      execute
+    );
+
+    const response = await registry.execute('dynamic_weather', {});
+
+    expect({result: response.result, calls: executorCalls}).toEqual({
+      result: expect.stringMatching(/location.*required/i),
+      calls: 0,
+    });
+  });
+
+  // @spec specs/hal-engine-tool-input-validation/spec.md#2
+  it('rejects a nested wrong-typed property without leaking its value', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    const execute = jest.fn(async () => {
+      executorCalls += 1;
+      return 'found';
+    });
+    registry.register(
+      {
+        name: 'token_lookup',
+        description: 'Looks up a record by token',
+        inputSchema: {
+          type: 'object',
+          properties: {profile: {type: 'object', properties: {token: {type: 'string'}}}},
+        },
+      },
+      execute
+    );
+
+    const emittedLogs: string[] = [];
+    const logOutput = jest.spyOn(console, 'log').mockImplementation(line => {
+      emittedLogs.push(String(line));
+    });
+    const response = await registry.execute('token_lookup', {profile: {token: 981230}});
+    logOutput.mockRestore();
+
+    expect({
+      mentionsField: response.result.includes('profile.token'),
+      mentionsExpectedType: response.result.includes('string'),
+      leaksValueInResult: response.result.includes('981230'),
+      leaksValueInLogs: emittedLogs.some(line => line.includes('981230')),
+      executorCalls,
+    }).toEqual({
+      mentionsField: true,
+      mentionsExpectedType: true,
+      leaksValueInResult: false,
+      leaksValueInLogs: false,
+      executorCalls: 0,
+    });
+  });
+
+  // @spec specs/hal-engine-tool-input-validation/spec.md#2
+  it('identifies enum as the failed constraint without echoing the supplied value', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'status_tool',
+        description: 'Accepts a known status',
+        inputSchema: {type: 'object', properties: {status: {type: 'string', enum: ['ready', 'done']}}},
+      },
+      async () => 'unreachable'
+    );
+
+    const response = await registry.execute('status_tool', {status: 'private-value'});
+
+    expect({
+      identifiesEnum: /status.*enum.*allowed values/i.test(response.result),
+      leaksValue: response.result.includes('private-value'),
+    }).toEqual({identifiesEnum: true, leaksValue: false});
+  });
+
+  // @spec specs/hal-engine-tool-input-validation/spec.md#7
+  it('validates each function supplied definition against its current schema', async () => {
+    const registry = new ToolRegistry();
+    const inputs: Array<Record<string, unknown>> = [];
+    let definitionCalls = 0;
+    registry.register(
+      () => {
+        definitionCalls += 1;
+        return definitionCalls <= 2
+          ? {
+              name: 'dynamic_tool',
+              description: 'Uses a changing schema',
+              inputSchema: {
+                type: 'object',
+                properties: {first: {type: 'string'}},
+                required: ['first'],
+              },
+            }
+          : {
+              name: 'dynamic_tool',
+              description: 'Uses a changing schema',
+              inputSchema: {
+                type: 'object',
+                properties: {second: {type: 'number'}},
+                required: ['second'],
+              },
+            };
+      },
+      async input => {
+        inputs.push(input);
+        return 'ok';
+      }
+    );
+
+    const first = await registry.execute('dynamic_tool', {first: 'ready'});
+    const second = await registry.execute('dynamic_tool', {second: 2});
+
+    expect({first: first.result, second: second.result, inputs}).toEqual({
+      first: 'ok',
+      second: 'ok',
+      inputs: [{first: 'ready'}, {second: 2}],
+    });
+  });
+
+  // @spec specs/hal-engine-tool-input-validation/spec.md#3
+  it('passes valid input with undeclared properties through unchanged', async () => {
+    const registry = new ToolRegistry();
+    const receivedInputs: Array<Record<string, unknown>> = [];
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Looks up weather',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async input => {
+        receivedInputs.push(input);
+        return 'sunny';
+      }
+    );
+    const input = {location: 'Berlin', traceId: 'keep-me'};
+
+    const response = await registry.execute('weather', input);
+
+    expect({result: response.result, receivedInputs}).toEqual({result: 'sunny', receivedInputs: [input]});
+  });
+
+  // @spec specs/hal-engine-tool-input-validation/spec.md#4
+  it('compiles a static schema once across ten execute calls', async () => {
+    const registry = new ToolRegistry();
+    let schemaReads = 0;
+    const inputSchema = {type: 'object', properties: {location: {type: 'string'}}};
+    registry.register(
+      {
+        name: 'static_weather',
+        description: 'Uses a static schema',
+        get inputSchema() {
+          schemaReads += 1;
+          return inputSchema;
+        },
+      },
+      async () => 'sunny'
+    );
+
+    for (let call = 0; call < 10; call += 1) {
+      await registry.execute('static_weather', {location: 'Berlin'});
+    }
+
+    expect(schemaReads).toBe(1);
+  });
+
+  // @spec specs/hal-engine-tool-input-validation/spec.md#5
+  it('throws for an unknown tool name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('missing_tool', {})).rejects.toThrow('Unknown tool: missing_tool');
+  });
+});
