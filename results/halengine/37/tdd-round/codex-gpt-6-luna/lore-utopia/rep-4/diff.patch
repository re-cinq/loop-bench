+import {ToolRegistry} from './registry.js';
+import {jest} from '@jest/globals';
+import Ajv from 'ajv';
+
+describe('ToolRegistry', () => {
+  it('returns a rejection for a missing required property without calling the executor [specs/hal-engine-tool-input-validation/spec.md#3]', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {name: 'weather', description: '', inputSchema: {type: 'object', required: ['location']}},
+      async () => {
+        executorCalls += 1;
+        return 'sunny';
+      }
+    );
+    const result = await registry.execute('weather', {});
+    expect({
+      resultNamesRequiredLocation: /location.*required|required.*location/i.test(result.result),
+      executorCalls,
+    }).toEqual({resultNamesRequiredLocation: true, executorCalls: 0});
+  });
+
+  it('names the property path and expected type for a wrong-typed value [specs/hal-engine-tool-input-validation/spec.md#4]', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'weather',
+        description: '',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async () => {
+        executorCalls += 1;
+        return 'sunny';
+      }
+    );
+
+    const result = await registry.execute('weather', {location: 123});
+
+    expect({
+      namesPathAndType: /\/location.*string|string.*\/location/i.test(result.result),
+      leaksValue: result.result.includes('123'),
+      executorCalls,
+    }).toEqual({namesPathAndType: true, leaksValue: false, executorCalls: 0});
+  });
+
+  it('passes a valid input and undeclared properties through unchanged [specs/hal-engine-tool-input-validation/spec.md#5]', async () => {
+    const registry = new ToolRegistry();
+    let received: Record<string, unknown> | undefined;
+    registry.register(
+      {name: 'weather', description: '', inputSchema: {type: 'object', properties: {location: {type: 'string'}}}},
+      async input => {
+        received = input;
+        return 'sunny';
+      }
+    );
+    const input = {location: 'Berlin', extra: true};
+
+    await registry.execute('weather', input);
+
+    expect(received).toEqual(input);
+  });
+
+  it('throws for an unregistered tool name [specs/hal-engine-tool-input-validation/spec.md#6]', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('missing', {})).rejects.toThrow('Unknown tool: missing');
+  });
+
+  it('resolves and validates a function-valued tool definition on each call [specs/hal-engine-tool-input-validation/spec.md#8]', async () => {
+    const registry = new ToolRegistry();
+    let useCitySchema = false;
+    registry.register(
+      () => ({
+        name: 'weather',
+        description: '',
+        inputSchema: useCitySchema
+          ? {type: 'object', properties: {city: {type: 'string'}}, required: ['city']}
+          : {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      }),
+      async () => 'sunny'
+    );
+
+    const locationResult = await registry.execute('weather', {location: 'Berlin'});
+    useCitySchema = true;
+    const cityResult = await registry.execute('weather', {city: 'Berlin'});
+
+    expect([locationResult.result, cityResult.result]).toEqual(['sunny', 'sunny']);
+  });
+
+  it('includes the complete parent path when a nested required property is missing [specs/hal-engine-tool-input-validation/spec.md#3]', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'weather',
+        description: '',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'object', required: ['city']}},
+          required: ['location'],
+        },
+      },
+      async () => 'sunny'
+    );
+
+    const result = await registry.execute('weather', {location: {}});
+
+    expect({
+      hasFullPath: result.result.includes('/location/city'),
+      hasExtraDot: result.result.includes('/location/.city'),
+    }).toEqual({
+      hasFullPath: true,
+      hasExtraDot: false,
+    });
+  });
+
+  it('compiles a static schema once across repeated executions [specs/hal-engine-tool-input-validation/spec.md#7]', async () => {
+    const compile = jest.spyOn(Ajv.prototype, 'compile');
+    try {
+      const registry = new ToolRegistry();
+      registry.register({name: 'weather', description: '', inputSchema: {type: 'object'}}, async () => 'sunny');
+
+      for (let call = 0; call < 10; call += 1) await registry.execute('weather', {});
+
+      expect(compile).toHaveBeenCalledTimes(1);
+    } finally {
+      compile.mockRestore();
+    }
+  });
+});
