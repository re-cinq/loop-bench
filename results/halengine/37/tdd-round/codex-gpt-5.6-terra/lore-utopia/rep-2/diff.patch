+import {jest} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry inputSchema validation', () => {
+  it('rejects input missing a required property before calling the executor', async () => {
+    const registry = new ToolRegistry();
+    const executor = jest.fn<() => Promise<string>>().mockResolvedValue('sunny');
+    registry.register(
+      {
+        name: 'require_location',
+        description: 'Requires a location',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      executor
+    );
+
+    const response = await registry.execute('require_location', {});
+    const executorCalls = executor.mock.calls;
+
+    expect({result: response.result, executorCalls: executorCalls.length}).toEqual({
+      result: expect.stringMatching(/location.*required|required.*location/i),
+      executorCalls: 0,
+    });
+  });
+
+  it('reports the path and expected type for a rejected typed property', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'find_user',
+        description: 'Find a user by email',
+        inputSchema: {type: 'object', properties: {email: {type: 'string'}}, required: ['email']},
+      },
+      async () => 'unreachable'
+    );
+
+    const response = await registry.execute('find_user', {email: 42});
+
+    expect(response.result).toMatch(/email.*string/i);
+  });
+
+  it('names the rejected property when Ajv reports a legacy dataPath', async () => {
+    const registry = new ToolRegistry();
