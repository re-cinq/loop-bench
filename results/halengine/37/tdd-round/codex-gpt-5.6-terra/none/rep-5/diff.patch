@@ -0,0 +1,258 @@
+import {ToolRegistry} from './registry.js';
+
+function registryWithWeatherSchema(inputSchema: Record<string, unknown>): ToolRegistry {
+  const registry = new ToolRegistry();
+  registry.register({name: 'weather', description: 'Gets weather', inputSchema}, async () => 'sunny');
+  return registry;
+}
+
+function nestedLocationSchema(required: string[]): Record<string, unknown> {
+  return {
+    type: 'object',
+    properties: {
+      location: {
+        type: 'object',
+        properties: {
+          postalCode: {type: 'string'},
+          ...(required.includes('country') ? {country: {type: 'string'}} : {}),
+        },
+        required,
+      },
+    },
+    required: ['location'],
+  };
+}
+
+describe('ToolRegistry', () => {
+  it('rejects an invalid ignored constraint at registration', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'weather',
+          description: 'Gets weather',
+          inputSchema: {type: 'object', minimum: 'one'},
+        },
+        async () => 'sunny'
+      )
+    ).toThrow('weather');
+  });
+
+  it('throws for an unregistered tool name', async () => {
+    const registry = new ToolRegistry();
+
