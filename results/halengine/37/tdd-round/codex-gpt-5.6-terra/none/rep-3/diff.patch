diff --git a/specs/hal-engine-tool-input-validation/spec.md b/specs/hal-engine-tool-input-validation/spec.md
new file mode 100644
index 0000000..d3902cb
--- /dev/null
+++ b/specs/hal-engine-tool-input-validation/spec.md
@@ -0,0 +1,28 @@
+# Tool Input Validation
+
+| Field  | Value                |
+| ------ | -------------------- |
+| Issue  | re-cinq/HALEngine#37 |
+| Status | Shipped              |
+
+Every tool registered in `src/orchestration/tools/registry.ts` declares a JSON Schema `inputSchema` that is forwarded to the configured AI provider, and `ToolRegistry.execute` validates the model-supplied `input` against that schema before calling the tool's executor. When validation fails, `execute` returns a rejection `ToolResponse` describing what was wrong rather than throwing, so the orchestrator feeds the failure back to the model as a `tool_result` within the existing tool-round budget.
+
+## Validation at execute time
+
+- When `input` omits a property listed in `required`, `ToolRegistry.execute` returns a `ToolResponse` whose `result` names the missing property as required and never invokes the executor ([validated by: returns a required-property rejection before invoking the executor](../../src/orchestration/tools/registry.test.ts#L4), [validated by: rejects input missing a required property with a ToolResponse and never calls the executor](../../src/orchestration/tools/registry.acceptance.test.ts#L16)).
+- When `input` supplies a property whose value does not match its declared JSON Schema type, `ToolRegistry.execute` returns a `ToolResponse` naming the failing field path and expected type without invoking the executor, and neither `result` nor the emitted log record contains the offending property value ([validated by: rejects a wrong-typed property before invoking the executor](../../src/orchestration/tools/registry.test.ts#L56), [validated by: rejects a wrong-typed property naming the field and expected type without leaking the offending value to the result or logs](../../src/orchestration/tools/registry.acceptance.test.ts#L46)).
+- When `input` satisfies `required`, declared property types and `enum`, `ToolRegistry.execute` invokes the executor once and passes the input object through unchanged — including undeclared extra properties — without injecting `additionalProperties: false`, coercing types or applying defaults ([validated by: passes valid undeclared properties through to the executor unchanged](../../src/orchestration/tools/registry.test.ts#L31)).
+- Input validation applies only `required`, declared property types, and `enum`; values that violate another JSON Schema constraint still reach the executor unchanged ([validated by: passes input that only violates an unsupported schema constraint to the executor](../../src/orchestration/tools/registry.test.ts#L153)).
+- When an enum fails, its rejection names the property and the allowed values ([validated by: rejects an enum value with the allowed values](../../src/orchestration/tools/registry.test.ts#L83)).
+- When `ToolRegistry.execute` is called with a tool name that has not been registered, it throws `Unknown tool: <name>` because an unregistered tool is a programming or configuration error rather than a recoverable input mistake ([validated by: throws unchanged for an unknown tool name](../../src/orchestration/tools/registry.test.ts#L203)).
+
+## Schema compilation and caching
+
+- A static `ToolDefinition` has its `inputSchema` compiled once at `register` time, so a schema that is not valid JSON Schema throws synchronously from `register` with an error message naming the offending tool ([validated by: throws at register time naming the tool when a static inputSchema cannot be compiled](../../src/orchestration/tools/registry.acceptance.test.ts#L94)).
+- Registering an invalid static schema fails before the tool is stored, so callers receive an error that identifies the tool they attempted to register ([validated by: does not register a tool whose static schema cannot be compiled](../../src/orchestration/tools/registry.test.ts#L127)).
+- A static tool's `inputSchema` is compiled at `register` time and reused on every `execute` call without re-reading or re-compiling `definition.inputSchema` ([validated by: reuses a static schema without rereading it during execution](../../src/orchestration/tools/registry.test.ts#L181)).
+- A function-valued `ToolDefinitionSource` resolves its definition on each `execute` call and validates against the `inputSchema` returned for that call, caching compiled validators by schema object reference (`WeakMap`) so distinct returned schemas each enforce their own rules ([validated by: validates a function definition against the schema resolved for each call](../../src/orchestration/tools/registry.test.ts#L103)).
+
+## Orchestrator tool-loop recovery
+
+- Because a schema rejection returns a `ToolResponse` instead of throwing, `src/orchestration/chatOrchestrator.ts` sends the rejection `result` back to the provider as a `tool_result` message, allowing the model to issue a corrected tool call on the next round and complete the turn within `maxToolRounds` ([validated by: returns a schema rejection as a tool_result in the orchestrator loop so the model can correct the call on the next round](../../src/orchestration/tools/registry.acceptance.test.ts#L112)).
diff --git a/src/orchestration/tools/registry.acceptance.test.ts b/src/orchestration/tools/registry.acceptance.test.ts
new file mode 100644
index 0000000..297cb4e
--- /dev/null
+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,186 @@
+import {ToolRegistry} from './registry.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+import type {AIProvider, MessageChunk, SendMessageParams, ToolResultMessage} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+describe('ToolRegistry inputSchema validation acceptance', () => {
+  afterEach(() => {
+    setLogger(undefined);
+  });
+
+  it('rejects input missing a required property with a ToolResponse and never calls the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'sunny';
+      }
+    );
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({
+      executorCalls,
+      mentionsRequiredField: response.result.includes('location') && /required/i.test(response.result),
+    }).toEqual({
+      executorCalls: 0,
+      mentionsRequiredField: true,
+    });
+  });
+
+  it('rejects a wrong-typed property naming the field and expected type without leaking the offending value to the result or logs', async () => {
+    const recordedLogs: string[] = [];
+    const recordLine = (category: string, message: string, fields?: Record<string, unknown>) => {
+      recordedLogs.push(JSON.stringify({category, message, fields}));
+    };
+    const logger: Logger = {
+      debug: recordLine,
+      info: recordLine,
+      warn: recordLine,
+      error: recordLine,
+    };
+    setLogger(logger);
+
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'ssn_lookup',
+        description: 'Look up record by identifier',
+        inputSchema: {
+          type: 'object',
+          properties: {ssn: {type: 'string'}},
+          required: ['ssn'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'found';
+      }
+    );
+
+    const response = await registry.execute('ssn_lookup', {ssn: 123456789});
+
+    expect({
+      executorCalls,
+      mentionsField: response.result.includes('ssn'),
+      mentionsExpectedType: response.result.includes('string'),
+      leaksValueInResult: response.result.includes('123456789'),
+      leaksValueInLogs: recordedLogs.some(line => line.includes('123456789')),
+    }).toEqual({
+      executorCalls: 0,
+      mentionsField: true,
+      mentionsExpectedType: true,
+      leaksValueInResult: false,
+      leaksValueInLogs: false,
+    });
+  });
+
+  it('throws at register time naming the tool when a static inputSchema cannot be compiled', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_weather',
+          description: 'Has an invalid JSON Schema type',
+          inputSchema: {
+            type: 'object',
+            properties: {location: {type: 'not-a-json-schema-type'}},
+          },
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken_weather/);
+  });
+
+  it('returns a schema rejection as a tool_result in the orchestrator loop so the model can correct the call on the next round', async () => {
+    const registry = new ToolRegistry();
+    const executorInputs: Array<Record<string, unknown>> = [];
+    registry.register(
+      () => ({
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      }),
+      async input => {
+        executorInputs.push(input);
+        return `22C in ${String(input.location)}`;
+      }
+    );
+
+    let firstRoundToolResult = '';
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        round += 1;
+        if (round === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        if (round === 2) {
+          const lastMessage = params.messages[params.messages.length - 1] as ToolResultMessage;
+          const firstToolResult = lastMessage.content[0];
+          firstRoundToolResult = firstToolResult?.content ?? '';
+        }
+        if (round !== 2) {
+          yield {type: 'text', text: '22C in Paris'};
+          yield {type: 'stop', stopReason: 'end_turn'};
+          return;
+        }
+        yield {
+          type: 'tool_use',
+          toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Paris'}},
+        };
+        yield {type: 'stop', stopReason: 'tool_use'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      provider,
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      registry
+    );
+    const session: ChatSession = {
+      sessionId: 's-retry',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'Weather in Paris?', timestamp: SENT_AT}],
+    };
+
+    const reply = await orchestrator.processMessage(session);
+
+    expect({
+      reply,
+      executorInputs,
+      firstAttemptRejectedForLocation:
+        firstRoundToolResult.includes('location') && /required/i.test(firstRoundToolResult),
+    }).toEqual({
+      reply: '22C in Paris',
+      executorInputs: [{location: 'Paris'}],
+      firstAttemptRejectedForLocation: true,
+    });
+  });
+});
