@@ -0,0 +1,208 @@
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry', () => {
+  it('returns a required-property rejection before invoking the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'find_city',
+        description: 'Finds a city by postal code',
+        inputSchema: {
+          type: 'object',
+          properties: {postalCode: {type: 'string'}},
+          required: ['postalCode'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'unreachable';
+      }
+    );
+
+    const response = await registry.execute('find_city', {});
+
+    expect({executorCalls, result: response.result}).toEqual({
+      executorCalls: 0,
+      result: 'Invalid tool input: /postalCode is required',
+    });
+  });
+
+  it('passes valid undeclared properties through to the executor unchanged', async () => {
+    const registry = new ToolRegistry();
+    const input = {location: 'Berlin', units: 'metric'};
+    const receivedInputs: Array<Record<string, unknown>> = [];
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Gets a forecast',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async receivedInput => {
+        receivedInputs.push(receivedInput);
+        return 'Forecast';
+      }
+    );
+
+    await registry.execute('weather', input);
+
+    expect(receivedInputs).toEqual([input]);
+  });
+
+  it('rejects a wrong-typed property before invoking the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
