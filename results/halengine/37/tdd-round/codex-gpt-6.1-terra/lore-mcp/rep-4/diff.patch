+import {jest} from '@jest/globals';
+
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry', () => {
+  it('rejects an invalid static schema at registration specs/hal-engine-tool-input-validation/spec.md#5', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {name: 'broken', description: 'Invalid schema', inputSchema: {type: 'invalid'}},
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken/);
+  });
+  it('rejects missing input specs/hal-engine-tool-input-validation/spec.md#1', async () => {
+    const registry = new ToolRegistry();
+    const execute = jest.fn(async () => 'forecast');
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Weather',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      execute
+    );
+
+    const response = await registry.execute('weather', {});
+    const calls = execute.mock.calls;
+    expect({result: response.result, calls: calls.length}).toEqual({
+      result: expect.stringMatching(/location.*required|required.*location/i),
+      calls: 0,
+    });
+  });
+  it('validates each dynamic schema specs/hal-engine-tool-input-validation/spec.md#7', async () => {
+    const registry = new ToolRegistry();
+    let required = 'location';
+    registry.register(
+      () => ({name: 'dynamic', description: 'Dynamic', inputSchema: {type: 'object', required: [required]}}),
+      async () => 'accepted'
+    );
+    const first = await registry.execute('dynamic', {});
+    required = 'date';
+    const second = await registry.execute('dynamic', {});
+    expect([first.result, second.result]).toEqual([expect.stringMatching(/location/), expect.stringMatching(/date/)]);
+  });
+});
