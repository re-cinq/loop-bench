+import {jest} from '@jest/globals';
+import Ajv from 'ajv';
+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+
+describe('ToolRegistry unit', () => {
+  it('caches compiled validators for function-valued tool definitions by schema reference', async () => {
+    const registry = new ToolRegistry();
+    const schema = {type: 'object', properties: {location: {type: 'string'}}};
+    const compileSpy = jest.spyOn(Ajv.prototype, 'compile');
+
+    registry.register(
+      () => ({
+        name: 'get_weather',
+        description: 'test',
+        inputSchema: schema,
+      }),
+      async () => 'ok'
+    );
+
+    // First execution compiles and caches
+    await registry.execute('get_weather', {location: 'Paris'});
+    const {calls} = compileSpy.mock;
+    const firstCallCount = calls.length;
+
+    // Second execution should use cache
+    await registry.execute('get_weather', {location: 'London'});
+
+    expect({
+      compiledAtLeastOnce: firstCallCount > 0,
+      stillSameCount: calls.length,
+    }).toEqual({
+      compiledAtLeastOnce: true,
+      stillSameCount: firstCallCount,
+    });
+
+    compileSpy.mockRestore();
+  });
+
+  it('provides prompt instructions from all registered tools', () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'tool1',
+        description: 'd1',
+        inputSchema: {},
+        promptInstructions: 'Instruction 1',
+      },
+      async () => ''
+    );
+    registry.register(
+      {
+        name: 'tool2',
+        description: 'd2',
+        inputSchema: {},
+        promptInstructions: 'Instruction 2',
+      },
+      async () => ''
+    );
+
+    expect(registry.getPromptInstructions()).toEqual(['tool1: Instruction 1', 'tool2: Instruction 2']);
+  });
+
+  it('provides example prompts from all registered tools', () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'tool1',
+        description: 'd1',
+        inputSchema: {},
+        examplePrompts: ['p1', 'p2'],
+      },
+      async () => ''
+    );
+    registry.register(
+      {
+        name: 'tool2',
+        description: 'd2',
+        inputSchema: {},
+        examplePrompts: ['p3'],
+      },
+      async () => ''
+    );
+
+    expect(registry.getExamplePrompts()).toEqual(['p1', 'p2', 'p3']);
+  });
+
+  it('passes through extra properties unchanged', async () => {
+    const registry = new ToolRegistry();
+    let capturedInput: Record<string, unknown> | undefined;
+    registry.register(
+      {
+        name: 'test',
+        description: 'd',
+        inputSchema: {type: 'object', properties: {a: {type: 'string'}}},
+      },
+      async input => {
+        capturedInput = input;
+        return 'ok';
+      }
+    );
+
+    const input = {a: 'val', extra: 'prop'};
+    await registry.execute('test', input);
+
+    expect(capturedInput).toEqual(input);
+  });
+
+  it('rejects input missing a required property with a ToolResponse and never calls the executor', async () => {
+    const registry = new ToolRegistry();
+    let callCount = 0;
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get the weather',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+          },
+          required: ['location'],
+        },
+      },
+      async () => {
+        callCount++;
+        return 'ok';
+      }
+    );
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({
+      resultIncludesLocation: response.result.includes('location is required'),
+      callCount,
+    }).toEqual({
+      resultIncludesLocation: true,
+      callCount: 0,
+    });
+  });
+
+  it('rejects a wrong-typed property naming the field and expected type', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'tool',
+        description: 'd',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            count: {type: 'number'},
+          },
+        },
+      },
+      async () => 'ok'
+    );
+
+    const response = await registry.execute('tool', {count: 'not-a-number'} as unknown as Record<string, unknown>);
+
+    expect({
+      resultIncludesCount: response.result.includes('count'),
+      resultIncludesNumber: response.result.includes('number'),
+    }).toEqual({
+      resultIncludesCount: true,
+      resultIncludesNumber: true,
+    });
+  });
+
+  it('throws at register time naming the tool when a static inputSchema cannot be compiled', () => {
+    const registry = new ToolRegistry();
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_tool',
+          description: 'd',
+          inputSchema: {type: 'invalid-type'} as unknown as Record<string, unknown>,
+        },
+        async () => 'ok'
+      )
+    ).toThrow(/broken_tool/);
+  });
+
+  it('throws for unregistered tool names', async () => {
+    const registry = new ToolRegistry();
+    await expect(registry.execute('missing', {})).rejects.toThrow('Unknown tool: missing');
+  });
+
+  it('compiles static schema once at register time', async () => {
+    const compileSpy = jest.spyOn(Ajv.prototype, 'compile');
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'static_tool',
+        description: 'd',
+        inputSchema: {type: 'object'},
+      },
+      async () => 'ok'
+    );
+
+    const {calls} = compileSpy.mock;
+    const countAfterRegister = calls.length;
+
+    for (let i = 0; i < 10; i++) {
+      await registry.execute('static_tool', {});
+    }
+
+    expect({
+      registeredOnce: countAfterRegister,
+      stillSameCount: calls.length,
+    }).toEqual({
+      registeredOnce: 1,
+      stillSameCount: 1,
+    });
+    compileSpy.mockRestore();
+  });
+
+  it('redacts values from logs and results on validation failure', async () => {
+    const recordedLogs: string[] = [];
+    const logger: Logger = {
+      debug: (cat, msg, fields) => recordedLogs.push(JSON.stringify({cat, msg, fields})),
+      info: (cat, msg, fields) => recordedLogs.push(JSON.stringify({cat, msg, fields})),
+      warn: (cat, msg, fields) => recordedLogs.push(JSON.stringify({cat, msg, fields})),
+      error: (cat, msg, fields) => recordedLogs.push(JSON.stringify({cat, msg, fields})),
+    };
+    setLogger(logger);
+
+    const registry = new ToolRegistry();
+    const SECRET = 'SECRET_VALUE_123';
+    registry.register(
+      {
+        name: 'tool',
+        description: 'd',
+        inputSchema: {type: 'object', properties: {val: {type: 'string'}}},
+      },
+      async () => 'ok'
+    );
+
+    await registry.execute('tool', {val: 123} as unknown as Record<string, unknown>);
+    const response2 = await registry.execute('tool', {val: 123, secret: SECRET} as unknown as Record<string, unknown>);
+
+    expect({
+      leaksInResult: response2.result.includes(SECRET),
+      leaksInLogs: recordedLogs.some(l => l.includes(SECRET)),
+    }).toEqual({
+      leaksInResult: false,
+      leaksInLogs: false,
+    });
+
+    setLogger(undefined);
+  });
+
+  it('validates against the current schema for function-valued definitions', async () => {
+    const registry = new ToolRegistry();
+    let schema: Record<string, unknown> = {type: 'object', properties: {a: {type: 'string'}}};
+
+    registry.register(
+      () => ({
+        name: 'dynamic',
+        description: 'd',
+        inputSchema: schema,
+      }),
+      async () => 'ok'
+    );
+
+    const res1 = await registry.execute('dynamic', {a: 1});
+    schema = {type: 'object', properties: {a: {type: 'number'}}};
+    const res2 = await registry.execute('dynamic', {a: 1});
+    const res3 = await registry.execute('dynamic', {a: 'string'});
+
+    expect({
+      res1Failed: res1.result.includes('Validation failed'),
+      res2Passed: res2.result,
+      res3Failed: res3.result.includes('Validation failed'),
+    }).toEqual({
+      res1Failed: true,
+      res2Passed: 'ok',
+      res3Failed: true,
+    });
+  });
+
+  it('formats nested property paths in validation errors', async () => {
+    // Rejection messages and log lines name failing property paths using dot notation for nested fields. ([validated by](src/orchestration/tools/registry.test.ts#L281))
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'test',
+        description: 'd',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            user: {
+              type: 'object',
+              properties: {
+                address: {
+                  type: 'object',
+                  properties: {
+                    city: {type: 'string'},
+                  },
+                  required: ['city'],
+                },
+              },
+            },
+          },
+        },
+      },
+      async () => 'ok'
+    );
+
+    const response1 = await registry.execute('test', {user: {address: {}}});
+    const response2 = await registry.execute('test', {user: {address: {city: 123}}} as unknown as Record<
+      string,
+      unknown
+    >);
+
+    expect({
+      res1: response1.result,
+      res2: response2.result,
+    }).toEqual({
+      res1: expect.stringContaining('user.address.city is required'),
+      res2: expect.stringContaining('user.address.city must be string'),
+    });
+  });
+});
