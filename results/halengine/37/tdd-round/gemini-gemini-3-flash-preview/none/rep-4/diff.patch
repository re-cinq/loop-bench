+import {jest} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry', () => {
+  it('throws at register time naming the tool when a static inputSchema cannot be compiled', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_tool',
+          description: 'Has an invalid JSON Schema type',
+          inputSchema: {
+            type: 'object',
+            properties: {location: {type: 'not-a-json-schema-type' as unknown as string}},
+          },
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken_tool/);
+  });
+
+  it('rejects input missing a required property with a ToolResponse and never calls the executor', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async () => {
+        calls++;
+        return 'Sunny';
+      }
+    );
+
+    const response = await registry.execute('get_weather', {});
+
+    expect(response.result).toMatch(/location/);
+    expect(response.result).toMatch(/required/i);
+    expect(calls).toBe(0);
+  });
+
+  it("asserts a static tool's schema is compiled once across ten execute calls", async () => {
+    const registry = new ToolRegistry();
+    const ajv = (registry as any).ajv;
+    const spy = jest.spyOn(ajv, 'compile');
+
+    registry.register(
+      {
+        name: 'static_tool',
+        description: 'Static',
+        inputSchema: {type: 'object', properties: {a: {type: 'string'}}},
+      },
+      async () => 'ok'
+    );
+
+    expect(spy).toHaveBeenCalledTimes(1);
+
+    for (let i = 0; i < 10; i++) {
+      await registry.execute('static_tool', {a: 'val'});
+    }
+
+    expect(spy).toHaveBeenCalledTimes(1);
+    spy.mockRestore();
+  });
+
+  it('asserts a function-valued tool definition whose returned schema differs between calls is validated against the schema current at that call', async () => {
+    const registry = new ToolRegistry();
+    let schemaVersion = 1;
+    const getDefinition = () => ({
+      name: 'dynamic_tool',
+      description: 'Dynamic',
+      inputSchema:
+        schemaVersion === 1
+          ? {type: 'object', properties: {v1: {type: 'string'}}, required: ['v1']}
+          : {type: 'object', properties: {v2: {type: 'string'}}, required: ['v2']},
+    });
+
+    registry.register(getDefinition, async () => 'ok');
+
+    // First call with v1
+    const res1 = await registry.execute('dynamic_tool', {v1: 'hi'});
+    expect(res1.result).toBe('ok');
+
+    // Change version
+    schemaVersion = 2;
+
+    // Call with v1 (should fail now as it expects v2)
+    const res2 = await registry.execute('dynamic_tool', {v1: 'hi'});
+    expect(res2.result).toMatch(/v2/);
+    expect(res2.result).toMatch(/required/i);
+
+    // Call with v2 (should pass)
+    const res3 = await registry.execute('dynamic_tool', {v2: 'hi'});
+    expect(res3.result).toBe('ok');
+  });
+});
