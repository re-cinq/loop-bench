+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+describe('ToolRegistry unit tests', () => {
+  beforeAll(() => {
+    setLogger({
+      debug: () => {},
+      info: () => {},
+      warn: () => {},
+      error: () => {},
+    });
+  });
+
+  afterAll(() => {
+    setLogger(undefined);
+  });
+
+  it('validates input against schema and rejects missing required fields', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(
+      {
+        name: 'test_tool',
+        description: 'test',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async () => {
+        calls++;
+        return 'ok';
+      }
+    );
+
+    const response = await registry.execute('test_tool', {});
+
+    expect({calls, result: response.result}).toMatchObject({
+      calls: 0,
+      result: expect.stringMatching(/location.*required|required.*location/),
+    });
+  });
+
+  it('throws at register time naming the tool when a static inputSchema cannot be compiled', () => {
+    const registry = new ToolRegistry();
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_tool',
+          description: 'test',
+          inputSchema: {
+            type: 'object',
+            properties: {location: {type: 'invalid-type'}},
+          } as unknown as Record<string, unknown>,
+        },
+        async () => 'ok'
+      )
+    ).toThrow(/broken_tool/);
+  });
+
+  it('caches compiled validators by schema object reference', async () => {
+    const registry = new ToolRegistry();
+    const schema = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+
+    registry.register(
+      () => ({
+        name: 'cached_tool',
+        description: 'test',
+        inputSchema: schema,
+      }),
+      async () => 'ok'
+    );
+
+    await registry.execute('cached_tool', {location: 'Paris'});
+    const response = await registry.execute('cached_tool', {location: 'London'});
+    expect(response.result).toBe('ok');
+  });
+
+  it('asserts valid input with an unlisted extra property is passed through to the executor unchanged', async () => {
+    const registry = new ToolRegistry();
+    let receivedInput: Record<string, unknown> | undefined;
+    registry.register(
+      {
+        name: 'extra_props',
+        description: 'test',
+        inputSchema: {type: 'object', properties: {a: {type: 'string'}}},
+      },
+      async input => {
+        receivedInput = input;
+        return 'ok';
+      }
+    );
+
+    await registry.execute('extra_props', {a: 'val', b: 'extra'});
+    expect(receivedInput).toEqual({a: 'val', b: 'extra'});
+  });
+
+  it('rejects a wrong-typed field naming the field and expected type without leaking the offending value', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'type_check',
+        description: 'test',
+        inputSchema: {type: 'object', properties: {age: {type: 'number'}}},
+      },
+      async () => 'ok'
+    );
+
+    const response = await registry.execute('type_check', {age: 'not-a-number'});
+    expect({
+      result: response.result,
+      leakedValue: response.result.includes('not-a-number'),
+    }).toMatchObject({
+      result: expect.stringMatching(/age.*number/),
+      leakedValue: false,
+    });
+  });
+
+  it('rejects an enum value without leaking the offending value', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'enum_check',
+        description: 'test',
+        inputSchema: {type: 'object', properties: {color: {enum: ['red', 'blue']}}},
+      },
+      async () => 'ok'
+    );
+
+    const response = await registry.execute('enum_check', {color: 'green'});
+    expect(response.result).not.toContain('green');
+  });
+
+  it('throws Unknown tool: <name> for an unregistered name', async () => {
+    const registry = new ToolRegistry();
+    await expect(registry.execute('non_existent', {})).rejects.toThrow('Unknown tool: non_existent');
+  });
+
+  it('validates against the schema current at that call for function-valued definitions', async () => {
+    const registry = new ToolRegistry();
+    let schema: Record<string, unknown> = {};
+
+    registry.register(
+      () => ({
+        name: 'dynamic_tool',
+        description: 'test',
+        inputSchema: schema,
+      }),
+      async () => 'ok'
+    );
+
+    const results = [];
+
+    // First call: require location
+    schema = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    results.push((await registry.execute('dynamic_tool', {})).result);
+
+    // Second call: require age
+    schema = {
+      type: 'object',
+      properties: {age: {type: 'number'}},
+      required: ['age'],
+    };
+    results.push((await registry.execute('dynamic_tool', {})).result);
+
+    expect(results).toMatchObject([
+      expect.stringMatching(/location.*required/),
+      expect.stringMatching(/age.*required/),
+    ]);
+  });
+
+  it('compiles a static tool schema once across multiple execute calls', async () => {
+    const registry = new ToolRegistry();
+    let schemaReadCount = 0;
+    const definition = {
+      name: 'static_tool',
+      description: 'test',
+      get inputSchema() {
+        schemaReadCount++;
+        return {type: 'object'};
+      },
+    };
+
+    registry.register(definition as ToolDefinition, async () => 'ok');
+    await registry.execute('static_tool', {});
+    await registry.execute('static_tool', {});
+
+    // Once during register, then reused
+    expect(schemaReadCount).toBe(1);
+  });
+});
