@@ -0,0 +1,198 @@
+import {jest, describe, it, expect} from '@jest/globals';
+import Ajv from 'ajv';
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry', () => {
+  describe('register', () => {
+    it('throws when a static inputSchema is invalid', () => {
+      const registry = new ToolRegistry();
+      expect(() =>
+        registry.register(
+          {
+            name: 'bad_tool',
+            description: 'A tool with a bad schema',
+            inputSchema: {
+              type: 'invalid-type',
+            },
+          },
+          async () => 'ok'
+        )
+      ).toThrow(/bad_tool/);
+    });
+
+    it('compiles a static tool schema only once', async () => {
+      const AjvClass = Ajv;
+      const spy = jest.spyOn(AjvClass.prototype, 'compile');
+      const registry = new ToolRegistry();
+      registry.register(
+        {
+          name: 'static_tool',
+          description: 'A tool',
+          inputSchema: {type: 'object'},
+        },
+        async () => 'ok'
+      );
+
+      // Already compiled once during register
+      const callsAfterRegister = spy.mock.calls;
+      const callCountAfterRegister = callsAfterRegister.length;
+
+      for (let i = 0; i < 10; i++) {
+        await registry.execute('static_tool', {});
+      }
+
+      // Should still be exactly what it was after register (1)
+      const finalCalls = spy.mock.calls;
+      expect(finalCalls.length).toBe(callCountAfterRegister);
+      spy.mockRestore();
+    });
+  });
+
+  describe('execute', () => {
+    it('returns a ToolResponse on validation failure and does not call the executor', async () => {
+      const registry = new ToolRegistry();
+      let called = false;
+      registry.register(
+        {
+          name: 'greet',
+          description: 'Greets a person',
+          inputSchema: {
+            type: 'object',
+            properties: {name: {type: 'string'}},
+            required: ['name'],
+          },
+        },
+        async () => {
+          called = true;
+          return 'hello';
+        }
+      );
+
+      const response = await registry.execute('greet', {});
+      const lowerResult = response.result.toLowerCase();
+
+      expect({
+        called,
+        isValidationFailure: lowerResult.includes('required') && response.result.includes('name'),
+      }).toEqual({
+        called: false,
+        isValidationFailure: true,
+      });
+    });
+
+    it('passes through unlisted extra properties to the executor', async () => {
+      const registry = new ToolRegistry();
+      let capturedInput: Record<string, unknown> | undefined;
+      registry.register(
+        {
+          name: 'echo',
+          description: 'Echoes input',
+          inputSchema: {
+            type: 'object',
+            properties: {text: {type: 'string'}},
+          },
+        },
+        async input => {
+          capturedInput = input;
+          return 'ok';
+        }
+      );
+
+      await registry.execute('echo', {text: 'hi', extra: 123});
+
+      expect(capturedInput).toEqual({text: 'hi', extra: 123});
+    });
+
+    it('rejects wrong-typed fields and does not leak the value', async () => {
+      const registry = new ToolRegistry();
+      registry.register(
+        {
+          name: 'age_check',
+          description: 'Checks age',
+          inputSchema: {
+            type: 'object',
+            properties: {age: {type: 'number'}},
+          },
+        },
+        async () => 'ok'
+      );
+
+      const secretValue = '999999999';
+      const response = await registry.execute('age_check', {age: secretValue});
+
+      expect({
+        hasField: response.result.includes('age'),
+        hasType: response.result.includes('number'),
+        leaksValue: response.result.includes(secretValue),
+      }).toEqual({
+        hasField: true,
+        hasType: true,
+        leaksValue: false,
+      });
+    });
+
+    it('rejects nested wrong-typed fields naming the full path', async () => {
+      const registry = new ToolRegistry();
+      registry.register(
+        {
+          name: 'nested_tool',
+          description: 'Nested properties',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              user: {
+                type: 'object',
+                properties: {
+                  id: {type: 'number'},
+                },
+              },
+            },
+          },
+        },
+        async () => 'ok'
+      );
+
+      const response = await registry.execute('nested_tool', {user: {id: 'not-a-number'}});
+
+      expect(response.result).toContain('user/id');
+      expect(response.result).toContain('number');
+    });
+
+    it('validates function-valued tools against the current schema', async () => {
+      const registry = new ToolRegistry();
+      let schemaVersion = 1;
+      registry.register(
+        () => ({
+          name: 'dynamic',
+          description: 'Dynamic schema tool',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              field: {type: schemaVersion === 1 ? 'string' : 'number'},
+            },
+          },
+        }),
+        async () => 'ok'
+      );
+
+      // Round 1: schema expects string
+      const resp1 = await registry.execute('dynamic', {field: 123});
+      const firstResultMatches = resp1.result.includes('string');
+
+      // Round 2: schema expects number
+      schemaVersion = 2;
+      const resp2 = await registry.execute('dynamic', {field: 'hi'});
+      const secondResultMatches = resp2.result.includes('number');
+
+      expect({firstResultMatches, secondResultMatches}).toEqual({
+        firstResultMatches: true,
+        secondResultMatches: true,
+      });
+    });
+
+    it('throws Unknown tool for unregistered name', async () => {
+      const registry = new ToolRegistry();
+      await expect(registry.execute('nope', {})).rejects.toThrow(/Unknown tool: nope/);
+    });
+  });
+});
