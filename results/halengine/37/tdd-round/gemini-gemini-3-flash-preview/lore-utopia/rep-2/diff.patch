+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+
+describe('ToolRegistry', () => {
+  afterEach(() => {
+    setLogger(undefined);
+  });
+
+  it('passes valid input with an unlisted extra property through unchanged (specs/hal-engine-tool-input-validation/spec.md#L16)', async () => {
+    const registry = new ToolRegistry();
+    let capturedInput: Record<string, unknown> | null = null;
+
+    registry.register(
+      {
+        name: 'test_tool',
+        description: 'Test tool',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            foo: {type: 'string'},
+          },
+          required: ['foo'],
+        },
+      },
+      async input => {
+        capturedInput = input;
+        return 'ok';
+      }
+    );
+
+    const input = {foo: 'bar', extra: 'baz'};
+    await registry.execute('test_tool', input);
+
+    // Use toEqual to ensure no properties were added or coerced and 'extra' remains.
+    expect(capturedInput).toEqual(input);
+  });
+
+  it('resolves and validates against current and updated schemas for function-valued tool definitions (specs/hal-engine-tool-input-validation/spec.md#L25)', async () => {
+    const registry = new ToolRegistry();
+    let currentSchema: Record<string, unknown> = {
+      type: 'object',
+      properties: {foo: {type: 'string'}},
+      required: ['foo'],
+    };
+
+    registry.register(
+      () => ({
+        name: 'dynamic',
+        description: 'd',
+        inputSchema: currentSchema,
+      }),
+      async () => 'ok'
+    );
+
+    const r1 = await registry.execute('dynamic', {foo: 'v'});
+
+    currentSchema = {type: 'object', properties: {bar: {type: 'string'}}, required: ['bar']};
+    const r2 = await registry.execute('dynamic', {foo: 'v'});
+
+    const r3 = await registry.execute('dynamic', {bar: 'v'});
+
+    expect({
+      r1: r1.result,
+      r2: r2.result,
+      r3: r3.result,
+    }).toMatchObject({
+      r1: 'ok',
+      r2: expect.stringMatching(/bar.*required/),
+      r3: 'ok',
+    });
+  });
+
+  it('throws Unknown tool for an unregistered name (specs/hal-engine-tool-input-validation/spec.md#L17)', async () => {
+    const registry = new ToolRegistry();
+    await expect(registry.execute('missing', {})).rejects.toThrow(/Unknown tool: missing/);
+  });
+
+  it('rejects a wrong-typed field naming the field path and the expected type (specs/hal-engine-tool-input-validation/spec.md#L14)', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'type_test',
+        description: 'd',
+        inputSchema: {type: 'object', properties: {count: {type: 'number'}}},
+      },
+      async () => 'ok'
+    );
+
+    const response = await registry.execute('type_test', {count: 'not-a-number'});
+    expect(response.result).toMatch(/count.*number/);
+  });
+
+  it('rejects a wrong-typed field without leaking the offending value (specs/hal-engine-tool-input-validation/spec.md#L14)', async () => {
+    const recordedLogs: {cat: string; msg: string; details?: unknown}[] = [];
+    setLogger({
+      debug: () => {},
+      info: () => {},
+      warn: (cat, msg, details) => recordedLogs.push({cat, msg, details}),
+      error: () => {},
+    });
+
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'secret_tool',
+        description: 'd',
+        inputSchema: {type: 'object', properties: {password: {type: 'string'}}},
+      },
+      async () => 'ok'
+    );
+
+    const secretValue = 'VERY_SECRET_123';
+    const response = await registry.execute('secret_tool', {password: 12345, secret: secretValue});
+
+    expect({
+      result: response.result,
+      leaked: response.result.includes(secretValue) || recordedLogs.some(l => JSON.stringify(l).includes(secretValue)),
+    }).toMatchObject({
+      result: expect.stringContaining('password'),
+      leaked: false,
+    });
+  });
+
+  it('throws at register time naming the tool when a static inputSchema cannot be compiled (specs/hal-engine-tool-input-validation/spec.md#L20)', () => {
+    const registry = new ToolRegistry();
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_tool',
+          description: 'd',
+          inputSchema: {type: 'object', properties: {foo: {type: 'invalid-type'}}},
+        },
+        async () => 'ok'
+      )
+    ).toThrow(/broken_tool/);
+  });
+
+  it('reports whether a tool is registered (specs/hal-engine-tool-input-validation/spec.md#L18)', () => {
+    const registry = new ToolRegistry();
+    registry.register({name: 't1', description: 'd1', inputSchema: {}}, async () => 'ok');
+    expect(registry.has('t1')).toBe(true);
+  });
+
+  it('retrieves a registered tool definition (specs/hal-engine-tool-input-validation/spec.md#L8)', () => {
+    const registry = new ToolRegistry();
+    registry.register({name: 't1', description: 'd1', inputSchema: {}}, async () => 'ok');
+    const tool = registry.get('t1');
+    expect(tool?.definition.name).toBe('t1');
+  });
+
+  it('lists all registered definitions (specs/hal-engine-tool-input-validation/spec.md#L18)', () => {
+    const registry = new ToolRegistry();
+    registry.register({name: 't1', description: 'd1', inputSchema: {}}, async () => 'ok');
+    expect(registry.getDefinitions()).toHaveLength(1);
+  });
+
+  it('validates input in ToolRegistry.execute before calling the executor (specs/hal-engine-tool-input-validation/spec.md#L11)', async () => {
+    const registry = new ToolRegistry();
+    let called = false;
+    registry.register({name: 't', description: 'd', inputSchema: {type: 'object', required: ['x']}}, async () => {
+      called = true;
+      return 'ok';
+    });
+
+    const resp = await registry.execute('t', {});
+    expect({result: resp.result, called}).toMatchObject({
+      result: expect.stringContaining('required'),
+      called: false,
+    });
+  });
+
+  it('compiles a static tool schema once across multiple calls (specs/hal-engine-tool-input-validation/spec.md#L23)', async () => {
+    const registry = new ToolRegistry();
+    const def = {name: 'static', description: 'd', inputSchema: {type: 'object'}};
+    registry.register(def, async () => 'ok');
+
+    // Access private tools map to verify staticValidator reuse.
+    const internal = registry as unknown as {tools: Map<string, {staticValidator: unknown}>};
+    const tool = internal.tools.get('static');
+    const originalValidator = tool?.staticValidator;
+
+    const results = [];
+    for (let i = 0; i < 10; i++) {
+      await registry.execute('static', {});
+      const currentTool = internal.tools.get('static');
+      results.push(currentTool?.staticValidator);
