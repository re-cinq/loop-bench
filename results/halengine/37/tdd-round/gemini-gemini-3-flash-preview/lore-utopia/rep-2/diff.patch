@@ -0,0 +1,26 @@
+# Tool Input Validation
+
+| Field  | Value                |
+| ------ | -------------------- |
+| Issue  | re-cinq/HALEngine#37 |
+| Status | Implemented          |
+
+Every tool registered in `src/orchestration/tools/registry.ts` declares a JSON Schema `inputSchema` that is forwarded to the configured AI provider, and `ToolRegistry.execute` validates the model-supplied `input` against that schema before calling the tool's executor ([ToolRegistry unit: retrieves a registered tool definition](../../src/orchestration/tools/registry.test.ts#L144)). When validation fails, `execute` returns a rejection `ToolResponse` describing what was wrong rather than throwing, so the orchestrator feeds the failure back to the model as a `tool_result` within the existing tool-round budget.
+
+## Validation at execute time
+
+- When `input` omits a property listed in `required`, `ToolRegistry.execute` returns a `ToolResponse` whose `result` names the missing property as required and never invokes the executor ([validated by: rejects input missing a required property with a ToolResponse and never calls the executor](../../src/orchestration/tools/registry.acceptance.test.ts#L16), [ToolRegistry unit: validates input in ToolRegistry.execute before calling the executor](../../src/orchestration/tools/registry.test.ts#L157)).
+- When `input` supplies a property whose value does not match its declared JSON Schema type, `ToolRegistry.execute` returns a `ToolResponse` naming the failing field path and expected type without invoking the executor, and neither `result` nor the emitted log record contains the offending property value ([validated by: rejects a wrong-typed property naming the field and expected type without leaking the offending value to the result or logs](../../src/orchestration/tools/registry.acceptance.test.ts#L46), [ToolRegistry unit: rejects a wrong-typed field naming the field path and the expected type](../../src/orchestration/tools/registry.test.ts#L78), [ToolRegistry unit: rejects a wrong-typed field without leaking the offending value](../../src/orchestration/tools/registry.test.ts#L93)).
+- When `input` satisfies `required`, declared property types and `enum`, `ToolRegistry.execute` invokes the executor once and passes the input object through unchanged — including undeclared extra properties — without injecting `additionalProperties: false`, coercing types or applying defaults ([ToolRegistry unit: passes valid input with an unlisted extra property through unchanged](../../src/orchestration/tools/registry.test.ts#L9)).
+- When `ToolRegistry.execute` is called with a tool name that has not been registered, it throws `Unknown tool: <name>` because an unregistered tool is a programming or configuration error rather than a recoverable input mistake ([ToolRegistry unit: throws Unknown tool for an unregistered name](../../src/orchestration/tools/registry.test.ts#L73)).
+- The registry provides metadata methods to check for tool registration and retrieve definitions for discovery or prompt injection ([ToolRegistry unit: reports whether a tool is registered](../../src/orchestration/tools/registry.test.ts#L138), [ToolRegistry unit: lists all registered definitions](../../src/orchestration/tools/registry.test.ts#L151)).
+
+## Schema compilation and caching
+
+- A static `ToolDefinition` has its `inputSchema` compiled once at `register` time, so a schema that is not valid JSON Schema throws synchronously from `register` with an error message naming the offending tool ([validated by: throws at register time naming the tool when a static inputSchema cannot be compiled](../../src/orchestration/tools/acceptance.test.ts#L94), [ToolRegistry unit: throws at register time naming the tool when a static inputSchema cannot be compiled](../../src/orchestration/tools/registry.test.ts#L124)).
+- A static tool's `inputSchema` is compiled at `register` time and reused on every `execute` call without re-reading or re-compiling `definition.inputSchema` ([ToolRegistry unit: compiles a static tool schema once across multiple calls](../../src/orchestration/tools/registry.test.ts#L172)).
+- A function-valued `ToolDefinitionSource` resolves its definition on each `execute` call and validates against the `inputSchema` returned for that call, caching compiled validators by schema object reference (`WeakMap`) so distinct returned schemas each enforce their own rules ([ToolRegistry unit: resolves and validates against current and updated schemas for function-valued tool definitions](../../src/orchestration/tools/registry.test.ts#L38)).
+
+## Orchestrator tool-loop recovery
+
+- Because a schema rejection returns a `ToolResponse` instead of throwing, `src/orchestration/chatOrchestrator.ts` sends the rejection `result` back to the provider as a `tool_result` message, allowing the model to issue a corrected tool call on the next round and complete the turn within `maxToolRounds` ([validated by: returns a schema rejection as a tool_result in the orchestrator loop so the model can correct the call on the next round](../../src/orchestration/tools/registry.acceptance.test.ts#L112), [ChatOrchestrator unit: feeds a tool validation failure back to the provider for retry](../../src/orchestration/chatOrchestrator.test.ts#L523)).
diff --git a/src/orchestration/chatOrchestrator.test.ts b/src/orchestration/chatOrchestrator.test.ts
index dbe7b33..e51c935 100644
--- a/src/orchestration/chatOrchestrator.test.ts
+++ b/src/orchestration/chatOrchestrator.test.ts
@@ -519,4 +519,57 @@ describe('ChatOrchestrator tool loop', () => {
 
     expect(seen).toEqual(usage);
   });
+
+  it('feeds a tool validation failure back to the provider for retry (specs/hal-engine-tool-input-validation/spec.md#L25)', async () => {
+    const registry = new ToolRegistry();
+    let executorCalled = false;
+    registry.register(
+      {
+        name: 'validate_me',
+        description: 'needs a field',
+        inputSchema: {type: 'object', properties: {foo: {type: 'string'}}, required: ['foo']},
+      },
+      async () => {
+        executorCalled = true;
+        return 'ok';
+      }
+    );
+
+    let receivedToolResult = '';
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        const messages = params.messages;
+        const round = messages.filter(m => m.role === 'assistant').length;
+        if (round === 0) {
+          yield {type: 'tool_use', toolCall: {id: 'c1', name: 'validate_me', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+
+        const last = messages[messages.length - 1];
+        const first = last.role === 'user' && Array.isArray(last.content) ? last.content[0] : undefined;
+        const isObj = first && typeof first === 'object';
+        const isToolResult = isObj && 'type' in first && first.type === 'tool_result';
+        if (isToolResult) {
+          receivedToolResult = (first as {content: string}).content;
+        }
+        yield {type: 'text', text: 'recovered'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+    await orchestrator.processMessage(createSession('go'));
+
+    expect({
+      receivedToolResult: receivedToolResult.toLowerCase(),
+      executorCalled,
+    }).toMatchObject({
+      receivedToolResult: expect.stringMatching(/invalid input.*foo.*required/),
+      executorCalled: false,
+    });
+  });
 });
