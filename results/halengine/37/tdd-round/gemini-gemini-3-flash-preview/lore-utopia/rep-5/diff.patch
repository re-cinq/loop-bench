     const resolved = this.resolveDefinition(definition);
-    this.tools.set(resolved.name, {definitionSource: definition, execute});
+    let staticValidator: ValidateFunction | undefined;
+
+    if (isStatic) {
+      try {
+        staticValidator = this.ajv.compile(resolved.inputSchema);
+      } catch (error) {
