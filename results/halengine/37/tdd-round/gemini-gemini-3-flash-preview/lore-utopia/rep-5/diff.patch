@@ -519,4 +519,72 @@ describe('ChatOrchestrator tool loop', () => {
 
     expect(seen).toEqual(usage);
   });
+
+  it('feeds a validation rejection back to the provider so it can retry with valid input', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'test-tool',
+        description: 'desc',
+        inputSchema: {
+          type: 'object',
+          properties: {foo: {type: 'string'}},
+          required: ['foo'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'ok';
+      }
+    );
+
+    let rejectionVisibleToProvider = false;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        const round = params.messages.filter(m => m.role === 'assistant').length;
+        if (round === 0) {
+          // First attempt: invalid input (missing required 'foo')
+          yield {type: 'tool_use', toolCall: {id: 'c1', name: 'test-tool', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        if (round === 1) {
+          // Check if rejection is visible
+          const lastMessage = params.messages[params.messages.length - 1];
+          if (
+            lastMessage.role === 'user' &&
+            Array.isArray(lastMessage.content) &&
+            lastMessage.content[0]?.type === 'tool_result' &&
+            lastMessage.content[0].content?.includes('missing required property: foo')
+          ) {
+            rejectionVisibleToProvider = true;
+          }
+
+          // Second attempt: valid input
+          yield {type: 'tool_use', toolCall: {id: 'c2', name: 'test-tool', input: {foo: 'bar'}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        yield {type: 'text', text: 'all done'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+    const result = await orchestrator.processMessage(createSession('go'));
+
+    expect({
+      result,
+      executorCalls,
+      rejectionVisibleToProvider,
+    }).toEqual({
+      result: 'all done',
+      executorCalls: 1,
+      rejectionVisibleToProvider: true,
+    });
+  });
 });
diff --git a/src/orchestration/tools/registry.acceptance.test.ts b/src/orchestration/tools/registry.acceptance.test.ts
