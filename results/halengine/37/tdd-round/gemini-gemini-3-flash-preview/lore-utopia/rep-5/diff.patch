@@ -35,18 +37,51 @@ export interface RegisteredTool {
 interface StoredTool {
   definitionSource: ToolDefinitionSource;
   execute: ToolExecutor;
+  staticValidator?: ValidateFunction;
 }
 
 export class ToolRegistry {
   private readonly tools = new Map<string, StoredTool>();
+  private readonly dynamicValidators = new WeakMap<object, ValidateFunction>();
+  private readonly ajv = new Ajv({
+    strict: false,
+    validateFormats: false,
+  });
 
   private resolveDefinition(source: ToolDefinitionSource): ToolDefinition {
     return typeof source === 'function' ? source() : source;
   }
 
+  private getValidator(definition: ToolDefinition, storedTool: StoredTool): ValidateFunction {
+    if (storedTool.staticValidator) {
+      return storedTool.staticValidator;
+    }
+
+    const schema = definition.inputSchema;
+    let validator = this.dynamicValidators.get(schema);
+    if (!validator) {
+      validator = this.ajv.compile(schema);
+      this.dynamicValidators.set(schema, validator);
+    }
+    return validator;
+  }
