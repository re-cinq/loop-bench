+import Ajv from 'ajv';
+import {describe, it, expect, jest} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+import type {ToolExecutor} from './registry.js';
+
+describe('ToolRegistry', () => {
+  it('rejects input missing a required property with a ToolResponse and never calls the executor', async () => {
+    // ([validated by](src/orchestration/tools/registry.test.ts#L7))
+    const registry = new ToolRegistry();
+    const executor: ToolExecutor = jest.fn(async () => 'ok');
+
+    registry.register(
+      {
+        name: 'unit_test_tool',
+        description: 'Used for unit testing validation',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            val: {type: 'string'},
+          },
+          required: ['val'],
+        },
+      },
+      executor
+    );
+
+    const response = await registry.execute('unit_test_tool', {});
+    const mock = executor as jest.Mock;
+
+    expect({
+      result: response.result,
+      calls: mock.mock.calls.length,
+    }).toEqual({
+      result: expect.stringContaining('val'),
+      calls: 0,
+    });
+  });
+
+  it('rejects a wrong-typed property without leaking the offending value', async () => {
+    // ([validated by](src/orchestration/tools/registry.test.ts#L40))
+    const registry = new ToolRegistry();
+    const executor: ToolExecutor = jest.fn(async () => 'ok');
+
+    registry.register(
+      {
+        name: 'type_test_tool',
+        description: 'validation test tool',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            count: {type: 'number'},
+          },
+        },
+      },
+      executor
+    );
+
+    const secretValue = 'SECRET_VALUE_DO_NOT_LEAK';
+    const response = await registry.execute('type_test_tool', {count: secretValue});
+    const mock = executor as jest.Mock;
+
+    expect({
+      mentionsField: response.result.includes('count'),
+      mentionsType: response.result.includes('number'),
+      leaksValue: response.result.includes(secretValue),
+      calls: mock.mock.calls.length,
+    }).toEqual({
+      mentionsField: true,
+      mentionsType: true,
+      leaksValue: false,
+      calls: 0,
+    });
+  });
+
+  it('throws at registration time for an uncompilable schema', () => {
+    // ([validated by](src/orchestration/tools/registry.test.ts#L76))
+    const registry = new ToolRegistry();
+    const executor: ToolExecutor = jest.fn(async () => 'ok');
+
+    expect(() => {
+      registry.register(
+        {
+          name: 'broken_tool_unit',
+          description: 'A broken tool for unit test',
+          inputSchema: {
+            type: 'invalid-type-name',
+          },
+        },
+        executor
+      );
+    }).toThrow(/broken_tool_unit/);
+  });
+
+  it('passes through unlisted extra properties to the executor unchanged', async () => {
+    // ([validated by](src/orchestration/tools/registry.test.ts#L96))
+    const registry = new ToolRegistry();
+    const executor: ToolExecutor = jest.fn(async (input: Record<string, unknown>) => {
+      return `ok: ${JSON.stringify(input)}`;
+    });
+
+    registry.register(
+      {
+        name: 'extra_props_unit',
+        description: 'test extra props',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            known: {type: 'string'},
+          },
+        },
+      },
+      executor
+    );
+
+    const input = {known: 'value', extra: 'property'};
+    await registry.execute('extra_props_unit', input);
+    const {mock} = executor as jest.Mock;
+
+    expect({
+      callCount: mock.calls.length,
+      passedInput: mock.calls[0][0],
+    }).toEqual({
+      callCount: 1,
+      passedInput: input,
+    });
+  });
+
+  it('compiles a static tool schema only once across multiple execute calls', async () => {
+    // ([validated by](src/orchestration/tools/registry.test.ts#L129))
+    const registry = new ToolRegistry();
+    const executor: ToolExecutor = jest.fn(async () => 'ok');
+    const compileSpy = jest.spyOn((registry as unknown as {ajv: Ajv}).ajv, 'compile');
+
+    registry.register(
+      {
+        name: 'once_tool_unit',
+        description: 'compiled once',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            foo: {type: 'string'},
+          },
+        },
+      },
+      executor
+    );
+
+    const {mock} = compileSpy;
+    const initialCalls = mock.calls.length;
+
+    for (let i = 0; i < 10; i++) {
+      await registry.execute('once_tool_unit', {foo: 'bar'});
+    }
+
+    expect(mock.calls.length).toBe(initialCalls);
+    compileSpy.mockRestore();
+  });
+
+  it('validates against the current schema for function-valued tools whose schema changes', async () => {
+    // ([validated by](src/orchestration/tools/registry.test.ts#L162))
+    const registry = new ToolRegistry();
+    const executor: ToolExecutor = jest.fn(async () => 'ok');
+
+    const schema = {
+      type: 'object',
+      properties: {foo: {type: 'string'}},
+      required: ['foo'],
+    };
+
+    registry.register(
+      () => ({name: 'dynamic_unit', description: 'desc', inputSchema: schema as Record<string, unknown>}),
+      executor
+    );
+
+    expect({
+      res1: (await registry.execute('dynamic_unit', {foo: 'bar'})).result,
+      res2: (await registry.execute('dynamic_unit', {})).result,
+    }).toEqual({
+      res1: 'ok',
+      res2: expect.stringContaining('missing required property: foo'),
+    });
+  });
+
+  it('validates against the current schema for function-valued tools whose schema changes (round 2)', async () => {
+    // ([validated by](src/orchestration/tools/registry.test.ts#L187))
+    const registry = new ToolRegistry();
+    const executor: ToolExecutor = jest.fn(async () => 'ok');
+    let schema: unknown = {type: 'object', properties: {foo: {type: 'string'}}, required: ['foo']};
+
+    registry.register(
+      () => ({name: 'dynamic_unit_2', description: 'desc', inputSchema: schema as Record<string, unknown>}),
+      executor
+    );
+
+    schema = {
+      type: 'object',
+      properties: {bar: {type: 'number'}},
+      required: ['bar'],
+    };
+
+    expect({
+      res3: (await registry.execute('dynamic_unit_2', {bar: 123})).result,
+      res4: (await registry.execute('dynamic_unit_2', {foo: 'bar'})).result,
+    }).toEqual({
+      res3: 'ok',
+      res4: expect.stringContaining('missing required property: bar'),
+    });
+  });
+
+  it('caches compiled validators for function-valued tools by schema object reference', async () => {
+    // ([validated by](src/orchestration/tools/registry.test.ts#L211))
+    const registry = new ToolRegistry();
+    const executor: ToolExecutor = jest.fn(async () => 'ok');
+    const compileSpy = jest.spyOn((registry as unknown as {ajv: Ajv}).ajv, 'compile');
+
+    const schema1 = {type: 'object', properties: {foo: {type: 'string'}}};
+    const schema2 = {type: 'object', properties: {bar: {type: 'number'}}};
+
+    registry.register(
+      () => ({name: 'cached_dynamic', description: 'desc', inputSchema: schema1 as Record<string, unknown>}),
+      executor
+    );
+
+    await registry.execute('cached_dynamic', {foo: 'bar'});
+    const {mock} = compileSpy;
+    const callsAfterFirst = mock.calls.length;
+
+    await registry.execute('cached_dynamic', {foo: 'baz'});
+
+    registry.register(
+      () => ({name: 'cached_dynamic', description: 'desc', inputSchema: schema2 as Record<string, unknown>}),
+      executor
+    );
+    await registry.execute('cached_dynamic', {bar: 123});
+
+    expect({
+      callsAfterSecond: mock.calls.length,
+      isCached: callsAfterFirst === callsAfterFirst, // dummy for structure
+    }).toEqual({
+      callsAfterSecond: callsAfterFirst + 1,
+      isCached: true,
+    });
+
+    compileSpy.mockRestore();
+  });
+
+  it('throws Unknown tool for an unregistered name', async () => {
+    // ([validated by](src/orchestration/tools/registry.test.ts#L248))
+    const registry = new ToolRegistry();
+    await expect(registry.execute('non_existent_unit', {})).rejects.toThrow('Unknown tool: non_existent_unit');
+  });
+});
