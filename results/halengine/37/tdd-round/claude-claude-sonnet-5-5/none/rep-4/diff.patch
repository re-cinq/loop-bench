+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+
+describe('ToolRegistry', () => {
+  it('passes valid input with an unlisted extra property to the executor unchanged, exactly once', async () => {
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async input => {
+        received.push(input);
+        return 'sunny';
+      }
+    );
+
+    await registry.execute('get_weather', {location: 'Berlin', extra: 1});
+
+    expect(received).toEqual([{location: 'Berlin', extra: 1}]);
+  });
+
+  it('throws Unknown tool for an unregistered name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('missing_tool', {})).rejects.toThrow('Unknown tool: missing_tool');
+  });
+
+  describe('function-valued definition whose schema changes between calls', () => {
+    const run = async () => {
+      const registry = new ToolRegistry();
+      let schema: Record<string, unknown> = {type: 'object', properties: {n: {type: 'string'}}, required: ['n']};
+      const received: Record<string, unknown>[] = [];
+      registry.register(
+        () => ({name: 'dynamic_tool', description: 'Dynamic schema', inputSchema: schema}),
+        async input => {
+          received.push(input);
+          return 'ok';
+        }
+      );
+
+      await registry.execute('dynamic_tool', {n: 'a'});
+      schema = {type: 'object', properties: {n: {type: 'number'}}, required: ['n']};
+      const rejected = await registry.execute('dynamic_tool', {n: 'a'});
+      await registry.execute('dynamic_tool', {n: 2});
+      return {rejected, received};
+    };
+
+    it('validates a function-valued definition against the schema current at each call', async () => {
+      const {rejected} = await run();
+
+      expect(rejected.result).toContain('/n');
+    });
+
+    it('runs the executor only for input the current schema accepted', async () => {
+      const {received} = await run();
+
+      expect(received).toEqual([{n: 'a'}, {n: 2}]);
+    });
+  });
+
+  it('reads a static definition inputSchema only at register time across ten executes', async () => {
+    const registry = new ToolRegistry();
+    let schemaReads = 0;
+    const definition = {
+      name: 'static_tool',
+      description: 'Static schema',
+      get inputSchema(): Record<string, unknown> {
+        schemaReads += 1;
+        return {type: 'object', properties: {n: {type: 'string'}}, required: ['n']};
+      },
+    };
+    registry.register(definition, async () => 'ok');
+    const readsAfterRegister = schemaReads;
+
+    for (let call = 0; call < 10; call += 1) {
+      await registry.execute('static_tool', {n: 'a'});
+    }
+
+    expect(schemaReads).toBe(readsAfterRegister);
+  });
+
+  it('keeps an identifying property value out of the returned text and every log line when it rejects', async () => {
+    const lines: string[] = [];
+    const record = (category: string, message: string, fields?: Record<string, unknown>) => {
+      lines.push(JSON.stringify({category, message, fields}));
+    };
+    setLogger({debug: record, info: record, warn: record, error: record});
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'lookup_user',
+        description: 'Look up a user',
+        inputSchema: {type: 'object', properties: {id: {type: 'string'}}, required: ['id']},
+      },
+      async () => 'found'
+    );
+
+    const response = await registry.execute('lookup_user', {email: 'jane.doe@example.com'});
+    setLogger(undefined);
+
+    expect([response.result, ...lines].filter(text => text.includes('jane.doe@example.com'))).toEqual([]);
+  });
+});
