+import {ToolRegistry} from './registry.js';
+
+type AjvClass = {prototype: {compile: (schema: unknown) => unknown}};
+const AjvExports = AjvModule as unknown as AjvClass | {default: AjvClass};
+const Ajv = 'default' in AjvExports ? AjvExports.default : AjvExports;
+
+describe('ToolRegistry', () => {
+  it('rejects a value outside the declared enum without calling the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'set_unit',
+        description: 'Set unit',
+        inputSchema: {
+          type: 'object',
+          properties: {unit: {type: 'string', enum: ['celsius', 'fahrenheit']}},
+          required: ['unit'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'ok';
+      }
+    );
+
+    const response = await registry.execute('set_unit', {unit: 'kelvin'});
+
+    expect({
+      executorCalls,
+      namesPath: response.result.includes('/unit'),
+      namesAllowed: response.result.includes('celsius'),
+      leaksValue: response.result.includes('kelvin'),
+    }).toEqual({executorCalls: 0, namesPath: true, namesAllowed: true, leaksValue: false});
+  });
+
+  it('passes valid input with an unlisted extra property to the executor unchanged, exactly once', async () => {
+    const registry = new ToolRegistry();
+    const received: Record<string, unknown>[] = [];
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}, units: {type: 'string', default: 'celsius'}},
+          required: ['location'],
+        },
+      },
+      async input => {
+        received.push(input);
+        return 'sunny';
+      }
+    );
+
+    await registry.execute('get_weather', {location: 'Paris', extra: 1});
+
+    expect(received).toEqual([{location: 'Paris', extra: 1}]);
+  });
+
+  it('validates a function-valued definition against the schema current at each call', async () => {
+    const registry = new ToolRegistry();
+    let required = 'city';
+    const received: Record<string, unknown>[] = [];
+    registry.register(
+      () => ({
+        name: 'lookup',
+        description: 'Lookup',
+        inputSchema: {type: 'object', properties: {[required]: {type: 'string'}}, required: [required]},
+      }),
+      async input => {
+        received.push(input);
+        return 'ok';
+      }
+    );
+
+    const first = await registry.execute('lookup', {city: 'Paris'});
+    required = 'zip';
+    const second = await registry.execute('lookup', {city: 'Paris'});
+
+    expect({
+      received,
+      firstRejected: first.result.includes('Invalid'),
+      secondNamesZip: second.result.includes('zip'),
+    }).toEqual({
+      received: [{city: 'Paris'}],
+      firstRejected: false,
+      secondNamesZip: true,
+    });
+  });
+
+  it('compiles a static tool schema once across ten execute calls', async () => {
+    const compile = jest.spyOn(Ajv.prototype, 'compile');
+    try {
+      const registry = new ToolRegistry();
+      registry.register(
+        {
+          name: 'echo',
+          description: 'Echo',
+          inputSchema: {type: 'object', properties: {text: {type: 'string'}}, required: ['text']},
+        },
+        async () => 'ok'
+      );
+      for (let i = 0; i < 10; i += 1) {
+        await registry.execute('echo', {text: 'hi'});
+      }
+
+      expect(compile).toHaveBeenCalledTimes(1);
+    } finally {
+      compile.mockRestore();
+    }
+  });
+
+  it('throws Unknown tool for an unregistered name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('missing_tool', {})).rejects.toThrow('Unknown tool: missing_tool');
+  });
+});
