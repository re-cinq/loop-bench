@@ -0,0 +1,237 @@
+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const outcomeOfSync = (call: () => unknown): string => {
+  try {
+    call();
+    return 'returned without throwing';
+  } catch (error) {
+    return error instanceof Error ? error.message : String(error);
+  }
+};
+
+describe('ToolRegistry', () => {
+  afterEach(() => {
+    setLogger(undefined);
+  });
+
+  it('throws at registration naming the tool when a static inputSchema is invalid JSON Schema', () => {
+    const registry = new ToolRegistry();
+    const message = outcomeOfSync(() =>
+      registry.register(
+        {
+          name: 'bad_schema_tool',
+          description: 'Declares an invalid JSON Schema type',
+          inputSchema: {type: 'not_a_json_schema_type'},
+        },
+        async () => 'unreachable'
+      )
+    );
+
+    expect({
+      mentionsTool: message.includes('bad_schema_tool'),
+      mentionsSchema: /schema/i.test(message),
+    }).toEqual({
+      mentionsTool: true,
+      mentionsSchema: true,
+    });
+  });
+
+  it('compiles a static tool inputSchema once at registration across ten execute calls', async () => {
+    const registry = new ToolRegistry();
+    let schemaReads = 0;
+    const rawSchema: Record<string, unknown> = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    const definition: ToolDefinition = {
+      name: 'get_weather',
+      description: 'Get the current weather for a location.',
+      get inputSchema() {
+        schemaReads += 1;
+        return rawSchema;
+      },
+    };
+
+    registry.register(definition, async input => String(input.location));
+    const readsAtRegister = schemaReads;
+
+    for (let i = 0; i < 10; i++) {
