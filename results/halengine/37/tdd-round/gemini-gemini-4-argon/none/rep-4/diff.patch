+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const WEATHER_DEF: ToolDefinition = {
+  name: 'get_weather',
+  description: 'Get weather',
+  inputSchema: {
+    type: 'object',
+    properties: {
+      location: {type: 'string'},
+      units: {type: 'string', enum: ['celsius', 'fahrenheit'], default: 'celsius'},
+    },
+    required: ['location'],
+  },
+};
+
+describe('ToolRegistry', () => {
+  afterEach(() => {
+    setLogger(undefined);
+  });
+
+  it('rejects input missing a required property and does not invoke the executor', async () => {
+    const registry = new ToolRegistry();
+    const invokedWith: Array<Record<string, unknown>> = [];
+    registry.register(WEATHER_DEF, async input => {
+      invokedWith.push(input);
+      return 'sunny';
+    });
+
+    const {result} = await registry.execute('get_weather', {});
+
+    expect({
+      executorCallCount: invokedWith.length,
+      namesMissingLocation: result.includes('location') && result.includes('required'),
+    }).toEqual({
+      executorCallCount: 0,
+      namesMissingLocation: true,
+    });
+  });
+
+  it('rejects a wrong-typed property naming the field and expected type without leaking the value to result or logs', async () => {
+    const loggedPayloads: unknown[] = [];
+    const sink = (_cat: string, msg: string, logContext?: Record<string, unknown>) => {
+      loggedPayloads.push([msg, logContext]);
+    };
+    setLogger({debug: sink, info: sink, warn: sink, error: sink});
+
+    const registry = new ToolRegistry();
+    let invoked = false;
+    registry.register(WEATHER_DEF, async () => {
+      invoked = true;
+      return 'ok';
+    });
+
+    const {result} = await registry.execute('get_weather', {location: 987654321});
+    const serializedLogs = JSON.stringify(loggedPayloads);
+
+    expect({
+      invoked,
+      namesFieldAndType: result.includes('location') && result.includes('string'),
+      leakedValue: result.includes('987654321') || serializedLogs.includes('987654321'),
+    }).toEqual({
+      invoked: false,
+      namesFieldAndType: true,
+      leakedValue: false,
+    });
+  });
+
+  it('rejects an input value outside a declared enum without calling the executor', async () => {
+    const registry = new ToolRegistry();
+    let invoked = false;
+    registry.register(WEATHER_DEF, async () => {
+      invoked = true;
+      return 'sunny';
+    });
+
+    const {result} = await registry.execute('get_weather', {location: 'Berlin', units: 'kelvin'});
+
+    expect({
+      invoked,
+      mentionsFieldAndEnum: result.includes('units') && result.includes('enum'),
+      leaksValue: result.includes('kelvin'),
+    }).toEqual({
+      invoked: false,
+      mentionsFieldAndEnum: true,
+      leaksValue: false,
+    });
+  });
+
+  it('rejects input violating a nested property constraint and names the dotted field path', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'search_records',
+        description: 'Search records',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            filter: {
+              type: 'object',
+              properties: {limit: {type: 'number'}},
+              required: ['limit'],
+            },
+          },
+          required: ['filter'],
+        },
+      },
+      async () => 'found'
+    );
+
+    const missingNested = await registry.execute('search_records', {filter: {}});
+    const wrongNestedType = await registry.execute('search_records', {filter: {limit: 'ten'}});
+
+    expect({
+      missingPath: missingNested.result.includes('filter.limit'),
+      wrongTypePath: wrongNestedType.result.includes('filter.limit') && wrongNestedType.result.includes('number'),
+    }).toEqual({
+      missingPath: true,
+      wrongTypePath: true,
+    });
+  });
+
+  it('throws at register time naming the tool when a static inputSchema is invalid', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'invalid_schema_tool',
+          description: 'Has an invalid schema',
+          inputSchema: {
+            type: 'object',
+            properties: {query: {type: 'not-a-valid-type'}},
+          },
+        },
+        async () => 'ok'
+      )
+    ).toThrow(/invalid_schema_tool/);
+  });
+
+  it('compiles a static tool inputSchema once at register time across ten execute calls', async () => {
+    const registry = new ToolRegistry();
+    let schemaReads = 0;
+    const definition: ToolDefinition = {
+      name: 'get_weather',
+      description: 'Get weather',
+      get inputSchema() {
+        schemaReads += 1;
+        return WEATHER_DEF.inputSchema;
+      },
+    };
+
+    registry.register(definition, async () => 'sunny');
+
+    for (let i = 0; i < 10; i++) {
+      await registry.execute('get_weather', {location: 'Berlin'});
+    }
+
+    expect(schemaReads).toBe(1);
+  });
+
+  it('validates against the schema returned by a function-valued ToolDefinitionSource and caches per schema reference', async () => {
+    const registry = new ToolRegistry();
+    let activeField = 'city';
+    const citySchema = {
+      type: 'object',
+      properties: {city: {type: 'string'}},
+      required: ['city'],
+    };
+    const zipSchema = {
+      type: 'object',
+      properties: {zip: {type: 'string'}},
+      required: ['zip'],
+    };
+    registry.register(
+      () => ({
+        name: 'dynamic_weather',
+        description: 'Dynamic weather tool',
+        inputSchema: activeField === 'city' ? citySchema : zipSchema,
+      }),
+      async input => JSON.stringify(input)
+    );
+
+    const firstValid = await registry.execute('dynamic_weather', {city: 'Paris'});
+    const secondCached = await registry.execute('dynamic_weather', {city: 'Lyon'});
+    activeField = 'zip';
+    const rejectedAfterSwitch = await registry.execute('dynamic_weather', {city: 'Paris'});
+    const validAfterSwitch = await registry.execute('dynamic_weather', {zip: '75001'});
+
+    expect({
+      firstValid: firstValid.result,
+      secondCached: secondCached.result,
+      rejectedMentionsZip: rejectedAfterSwitch.result.includes('zip'),
+      validAfterSwitch: validAfterSwitch.result,
+    }).toEqual({
+      firstValid: '{"city":"Paris"}',
+      secondCached: '{"city":"Lyon"}',
+      rejectedMentionsZip: true,
+      validAfterSwitch: '{"zip":"75001"}',
+    });
+  });
+
+  it('passes valid input to the executor unchanged without coercing types, applying defaults, or rejecting undeclared properties', async () => {
+    const registry = new ToolRegistry();
+    const receivedInputs: Array<Record<string, unknown>> = [];
+    registry.register(WEATHER_DEF, async input => {
+      receivedInputs.push(input);
+      return '20C';
+    });
+
+    const callerInput = {location: 'Berlin', extraFlag: true};
+    const response = await registry.execute('get_weather', callerInput);
+
+    expect({
+      result: response.result,
+      receivedInputs,
+    }).toEqual({
+      result: '20C',
+      receivedInputs: [{location: 'Berlin', extraFlag: true}],
+    });
+  });
+
+  it('rejects a stringified number when the schema requires a number rather than coercing it', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'set_limit',
+        description: 'Set numeric limit',
+        inputSchema: {
+          type: 'object',
+          properties: {count: {type: 'number'}},
+          required: ['count'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'ok';
+      }
+    );
+
+    const response = await registry.execute('set_limit', {count: '42'});
+
+    expect({
+      executorCalls,
+      mentionsNumber: response.result.includes('count') && response.result.includes('number'),
+    }).toEqual({
+      executorCalls: 0,
+      mentionsNumber: true,
+    });
+  });
+
+  it('checks tool existence before schema validation and throws when the tool is not registered', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('missing_tool', {})).rejects.toThrow('Unknown tool: missing_tool');
+  });
+
+  it('exposes registered tool definitions, prompt instructions, and example prompts', () => {
+    const registry = new ToolRegistry();
+    const execute = async () => ({result: 'done'});
+    registry.register(
+      {
+        name: 'alpha',
+        description: 'Alpha tool',
+        promptInstructions: 'Use alpha for first step',
+        examplePrompts: ['Run alpha'],
+        inputSchema: {type: 'object'},
+      },
+      execute
+    );
+
+    const alphaDefinition = registry.get('alpha')?.definition;
+
+    expect({
+      hasAlpha: registry.has('alpha'),
+      hasBeta: registry.has('beta'),
+      gotAlphaName: alphaDefinition?.name,
+      gotBeta: registry.get('beta'),
+      instructions: registry.getPromptInstructions(),
+      examples: registry.getExamplePrompts(),
+    }).toEqual({
+      hasAlpha: true,
+      hasBeta: false,
+      gotAlphaName: 'alpha',
+      gotBeta: undefined,
+      instructions: ['alpha: Use alpha for first step'],
+      examples: ['Run alpha'],
+    });
+  });
+});
