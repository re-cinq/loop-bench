+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+
+const LOCATION_REQUIRED_SCHEMA: Record<string, unknown> = {
+  type: 'object',
+  properties: {location: {type: 'string'}},
+  required: ['location'],
+};
+
+describe('ToolRegistry schema compilation and caching', () => {
+  afterEach(() => {
+    setLogger(undefined);
+  });
+
+  it('compiles a static tool inputSchema once at register time without re-reading it across ten execute calls', async () => {
+    const registry = new ToolRegistry();
+    let schemaReads = 0;
+    const definition = {
+      name: 'get_weather',
+      description: 'Get weather for a location',
+      get inputSchema(): Record<string, unknown> {
+        schemaReads += 1;
+        return LOCATION_REQUIRED_SCHEMA;
+      },
+    };
+
+    registry.register(definition, async () => '20C');
+    const readsAtRegister = schemaReads;
+
+    for (let i = 0; i < 10; i++) {
+      await registry.execute('get_weather', {location: 'Berlin'});
+    }
+
+    expect({readsAtRegister, readsAfterTenExecutes: schemaReads}).toEqual({
+      readsAtRegister: 1,
+      readsAfterTenExecutes: 1,
+    });
+  });
+
+  it('throws at registration time when a static tool declares an uncompilable inputSchema', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_tool',
+          description: 'declares an invalid JSON Schema type',
+          inputSchema: {type: 'not-a-json-schema-type'},
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken_tool/);
+  });
+
+  it('validates a function-valued tool against the schema current at each execute call', async () => {
+    let activeSchema: Record<string, unknown> = LOCATION_REQUIRED_SCHEMA;
+    let executorCalls = 0;
+
+    const registry = new ToolRegistry();
+    registry.register(
+      () => ({
+        name: 'lookup_office',
+        description: 'Look up office by location',
+        inputSchema: activeSchema,
+      }),
+      async () => {
+        executorCalls += 1;
+        return 'found';
+      }
+    );
+
+    const missingRequired = await registry.execute('lookup_office', {});
+    const passedUnderFirstSchema = await registry.execute('lookup_office', {location: 'Berlin'});
+    activeSchema = {
+      type: 'object',
+      properties: {
+        location: {type: 'string'},
+        postalCode: {type: 'string'},
+      },
+      required: ['location', 'postalCode'],
+    };
+    const loggedLines = captureLoggerOutput();
+    const wrongTypeUnderSecondSchema = await registry.execute('lookup_office', {
+      location: 'Berlin',
+      postalCode: 987654321,
+    });
+
+    expect({
+      executorCalls,
+      missingNamesLocation: missingRequired.result.includes('location'),
+      missingMentionsRequired: /required/i.test(missingRequired.result),
+      firstSchemaResult: passedUnderFirstSchema.result,
+      secondNamesPostalCode: wrongTypeUnderSecondSchema.result.includes('postalCode'),
+      secondMentionsString: wrongTypeUnderSecondSchema.result.includes('string'),
+      leaksValueInResult: wrongTypeUnderSecondSchema.result.includes('987654321'),
+      leaksValueInLogs: loggedLines.some(line => line.includes('987654321')),
+    }).toEqual({
+      executorCalls: 1,
+      missingNamesLocation: true,
+      missingMentionsRequired: true,
+      firstSchemaResult: 'found',
+      secondNamesPostalCode: true,
+      secondMentionsString: true,
+      leaksValueInResult: false,
+      leaksValueInLogs: false,
+    });
+  });
+
+  it('returns a ToolResponse naming the missing required property without calling the executor', async () => {
+    const registry = new ToolRegistry();
+    const callCount = {invoked: 0};
+    const weatherDefinition = {
+      name: 'get_weather',
+      description: 'Get weather for a location',
+      inputSchema: LOCATION_REQUIRED_SCHEMA,
+    };
+    registry.register(weatherDefinition, async () => {
+      callCount.invoked += 1;
+      return 'sunny';
+    });
+
+    const rejection = await registry.execute('get_weather', {});
+
+    expect({
+      executorCallCount: callCount.invoked,
+      namesLocation: rejection.result.includes('location'),
+      mentionsRequired: /required/i.test(rejection.result),
+    }).toEqual({
+      executorCallCount: 0,
+      namesLocation: true,
+      mentionsRequired: true,
+    });
+  });
+
+  it('rejects a wrong-typed field without calling the executor or leaking its value', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'lookup_customer',
+        description: 'Look up a customer by tax identifier',
+        inputSchema: {
+          type: 'object',
+          properties: {taxId: {type: 'string'}},
+          required: ['taxId'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'customer-record';
+      }
+    );
+
+    const loggedLines = captureLoggerOutput();
+    const rejection = await registry.execute('lookup_customer', {taxId: 987654321});
+
+    expect({
+      executorCalls,
+      namesField: rejection.result.includes('taxId'),
+      namesExpectedType: rejection.result.includes('string'),
+      leaksValueInResult: rejection.result.includes('987654321'),
+      leaksValueInLogs: loggedLines.some(line => line.includes('987654321')),
+    }).toEqual({
+      executorCalls: 0,
+      namesField: true,
+      namesExpectedType: true,
+      leaksValueInResult: false,
+      leaksValueInLogs: false,
+    });
+  });
+
+  it('passes valid input with an unlisted extra property through to the executor unchanged once', async () => {
+    const registry = new ToolRegistry();
+    const receivedInputs: Array<Record<string, unknown>> = [];
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+            units: {type: 'string', enum: ['celsius', 'fahrenheit'], default: 'celsius'},
+          },
+          required: ['location'],
+        },
+      },
+      async input => {
+        receivedInputs.push(input);
+        return '18C';
+      }
+    );
+
+    const response = await registry.execute('get_weather', {
+      location: 'Berlin',
+      extraKey: 'keep-me',
+    });
+
+    expect({receivedInputs, response}).toEqual({
+      receivedInputs: [{location: 'Berlin', extraKey: 'keep-me'}],
+      response: {result: '18C'},
+    });
+  });
+
+  it('throws Unknown tool when execute is called for an unregistered tool name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('unregistered_tool', {})).rejects.toThrow('Unknown tool: unregistered_tool');
+  });
+});
+
+function captureLoggerOutput(): string[] {
+  const lines: string[] = [];
+  const pushLine: Logger['warn'] = (...entry) => {
+    lines.push(JSON.stringify(entry));
+  };
+  setLogger({debug: pushLine, info: pushLine, warn: pushLine, error: pushLine});
+  return lines;
+}
