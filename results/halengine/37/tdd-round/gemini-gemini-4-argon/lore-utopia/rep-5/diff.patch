+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const weatherTool: ToolDefinition = {
+  name: 'get_weather',
+  description: 'Get current weather for a location',
+  inputSchema: {
+    type: 'object',
+    properties: {
+      location: {type: 'string', description: 'City name'},
+      units: {type: 'string', enum: ['celsius', 'fahrenheit']},
+    },
+    required: ['location'],
+  },
+};
+
+describe('ToolRegistry.execute — input validation', () => {
+  afterEach(() => {
+    setLogger(undefined);
+  });
+
+  it('returns a ToolResponse naming the missing required field and does not invoke the executor', async () => {
+    const registry = new ToolRegistry();
+    let invoked = false;
+    registry.register(weatherTool, async () => {
+      invoked = true;
+      return '20C';
+    });
+
+    const response = await registry.execute('get_weather', {units: 'celsius'});
+
+    expect({
+      invoked,
+      namesTool: response.result.includes('get_weather'),
+      namesField: response.result.includes('location'),
+      mentionsRequired: /required/i.test(response.result),
+    }).toEqual({
+      invoked: false,
+      namesTool: true,
+      namesField: true,
+      mentionsRequired: true,
+    });
+  });
+
+  it('rejects a wrong-typed field naming the field path and expected type without leaking the offending value to the result or logs', async () => {
+    const loggedLines: string[] = [];
+    const record = (category: string, message: string, data?: Record<string, unknown>) => {
+      loggedLines.push(JSON.stringify({category, message, data}));
+    };
+    const testLogger: Logger = {debug: record, info: record, warn: record, error: record};
+    setLogger(testLogger);
+
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(weatherTool, async () => {
+      executorCalls += 1;
+      return '20C';
+    });
+
+    const response = await registry.execute('get_weather', {location: 987654321});
+
+    expect({
+      executorCalls,
+      namesFieldPath: response.result.includes('location'),
+      namesExpectedType: response.result.includes('string'),
+      resultContainsOffendingValue: response.result.includes('987654321'),
+      logsContainOffendingValue: loggedLines.some(line => line.includes('987654321')),
+    }).toEqual({
+      executorCalls: 0,
+      namesFieldPath: true,
+      namesExpectedType: true,
+      resultContainsOffendingValue: false,
+      logsContainOffendingValue: false,
+    });
+  });
+
+  it('passes valid input with an unlisted extra property through to the executor unchanged and invokes it once', async () => {
+    const registry = new ToolRegistry();
+    const receivedInputs: Array<Record<string, unknown>> = [];
+    registry.register(weatherTool, async input => {
+      receivedInputs.push(input);
+      return '20C';
+    });
+
+    const response = await registry.execute('get_weather', {
+      location: 'Amsterdam',
+      units: 'celsius',
+      extraTraceId: 'trace-42',
+    });
+
+    expect({response, receivedInputs}).toEqual({
+      response: {result: '20C'},
+      receivedInputs: [{location: 'Amsterdam', units: 'celsius', extraTraceId: 'trace-42'}],
+    });
+  });
+
+  it('throws at register time when the inputSchema is uncompilable and the message names the tool', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_weather',
+          description: 'Invalid schema',
+          inputSchema: {
+            type: 'object',
+            properties: {location: {type: 'not-a-valid-type'}},
+          },
+        },
+        async () => 'ok'
+      )
+    ).toThrow(/broken_weather/);
+  });
+
+  it('compiles a static tool schema once at register time across ten execute calls', async () => {
+    const registry = new ToolRegistry();
+    let schemaReads = 0;
+    const schema = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    const definition = {
+      name: 'get_weather',
+      description: 'Get current weather',
+      get inputSchema(): ToolDefinition['inputSchema'] {
+        schemaReads += 1;
+        return schema;
+      },
+    };
+
+    registry.register(definition, async input => `Weather in ${String(input.location)}`);
+
+    for (let i = 0; i < 10; i += 1) {
+      await registry.execute('get_weather', {location: `City-${i}`});
+    }
+
+    expect(schemaReads).toBe(1);
+  });
+
+  it('validates a function-valued tool definition against the schema returned on each call', async () => {
+    const registry = new ToolRegistry();
+    let requiredKey: 'location' | 'zipCode' = 'location';
+    registry.register(
+      () => ({
+        name: 'lookup_place',
+        description: 'Look up a place',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+            zipCode: {type: 'string'},
+          },
+          required: [requiredKey],
+        },
+      }),
+      async input => `found:${Object.keys(input).join(',')}`
+    );
+
+    const firstValid = await registry.execute('lookup_place', {location: 'Berlin'});
+    requiredKey = 'zipCode';
+    const secondRejected = await registry.execute('lookup_place', {location: 'Berlin'});
+    const secondValid = await registry.execute('lookup_place', {zipCode: '10115'});
+
+    expect({
+      firstResult: firstValid.result,
+      secondRejectedNamesZipCode: secondRejected.result.includes('zipCode') && /required/i.test(secondRejected.result),
+      secondValidResult: secondValid.result,
+    }).toEqual({
+      firstResult: 'found:location',
+      secondRejectedNamesZipCode: true,
+      secondValidResult: 'found:zipCode',
+    });
+  });
+
+  it('throws Unknown tool: <name> when execute is called with an unregistered tool name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('unregistered_tool', {})).rejects.toThrow('Unknown tool: unregistered_tool');
+  });
+});
