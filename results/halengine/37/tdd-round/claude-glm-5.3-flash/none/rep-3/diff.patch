@@ -0,0 +1,136 @@
+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const locationOnly = (): ToolDefinition => ({
+  name: 'fetch_weather',
+  description: 'unit fixture for schema validation',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}},
+    required: ['location'],
+  },
+});
+
+const countingExecutor = () => {
+  let calls = 0;
+  return {
+    run: async (): Promise<string> => {
+      calls += 1;
+      return 'ok';
+    },
+    calls: () => calls,
+  };
+};
+
+describe('ToolRegistry schema validation', () => {
+  afterEach(() => {
+    setLogger(undefined);
+  });
+
+  it('rejects a call missing the required location and leaves the executor unused', async () => {
+    const registry = new ToolRegistry();
+    const executor = countingExecutor();
+    registry.register(locationOnly(), executor.run);
+
+    const rejection = await registry.execute('fetch_weather', {});
+
+    expect({result: rejection.result, executorCalls: executor.calls()}).toEqual({
+      result: expect.stringMatching(/(must|should) have required property 'location'/),
+      executorCalls: 0,
+    });
+  });
+
+  it('rejects a wrong-typed value naming the field and expected type, never the value', async () => {
+    const lines: string[] = [];
+    const capture = (category: string, message: string, fields?: Record<string, unknown>): void => {
+      lines.push(`${category} ${message} ${JSON.stringify(fields ?? null)}`);
+    };
+    setLogger({debug: capture, info: capture, warn: capture, error: capture});
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'find_person',
+        description: 'unit fixture for value redaction',
+        inputSchema: {type: 'object', properties: {ssn: {type: 'string'}}, required: ['ssn']},
+      },
+      async () => 'unused'
+    );
+
+    const rejection = await registry.execute('find_person', {ssn: 123456789});
+
+    expect({result: rejection.result, logs: lines.join('\n')}).toEqual({
+      result: expect.stringMatching(/^[/.]ssn (must|should) be string$/),
+      logs: expect.not.stringContaining('123456789'),
+    });
+  });
+
+  it('hands valid input with undeclared extra properties to the executor unchanged, exactly once', async () => {
+    const registry = new ToolRegistry();
+    const seen: Array<Record<string, unknown>> = [];
+    registry.register(locationOnly(), async input => {
+      seen.push(input);
+      return 'ok';
+    });
+
