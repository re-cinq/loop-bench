+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,184 @@
+import {ToolRegistry} from './registry.js';
+import {createChatOrchestrator} from '../chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+import type {AIProvider, MessageChunk, SendMessageParams, ToolResultMessage} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+describe('ToolRegistry inputSchema validation acceptance', () => {
+  afterEach(() => {
+    setLogger(undefined);
+  });
+
+  it('rejects input missing a required property with a ToolResponse and never calls the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'sunny';
+      }
+    );
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({
+      executorCalls,
+      mentionsRequiredField: response.result.includes('location') && /required/i.test(response.result),
+    }).toEqual({
+      executorCalls: 0,
+      mentionsRequiredField: true,
+    });
+  });
+
+  it('rejects a wrong-typed property naming the field and expected type without leaking the offending value to the result or logs', async () => {
+    const recordedLogs: string[] = [];
+    const recordLine = (category: string, message: string, fields?: Record<string, unknown>) => {
+      recordedLogs.push(JSON.stringify({category, message, fields}));
+    };
+    const logger: Logger = {
+      debug: recordLine,
+      info: recordLine,
+      warn: recordLine,
+      error: recordLine,
+    };
+    setLogger(logger);
+
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'ssn_lookup',
+        description: 'Look up record by identifier',
+        inputSchema: {
+          type: 'object',
+          properties: {ssn: {type: 'string'}},
+          required: ['ssn'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'found';
+      }
+    );
+
+    const response = await registry.execute('ssn_lookup', {ssn: 123456789});
+
+    expect({
+      executorCalls,
+      mentionsField: response.result.includes('ssn'),
+      mentionsExpectedType: response.result.includes('string'),
+      leaksValueInResult: response.result.includes('123456789'),
+      leaksValueInLogs: recordedLogs.some(line => line.includes('123456789')),
+    }).toEqual({
+      executorCalls: 0,
+      mentionsField: true,
+      mentionsExpectedType: true,
+      leaksValueInResult: false,
+      leaksValueInLogs: false,
+    });
+  });
+
+  it('throws at register time naming the tool when a static inputSchema cannot be compiled', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_weather',
+          description: 'Has an invalid JSON Schema type',
+          inputSchema: {
+            type: 'object',
+            properties: {location: {type: 'not-a-json-schema-type'}},
+          },
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken_weather/);
+  });
+
+  it('returns a schema rejection as a tool_result in the orchestrator loop so the model can correct the call on the next round', async () => {
+    const registry = new ToolRegistry();
+    const executorInputs: Array<Record<string, unknown>> = [];
+    registry.register(
+      () => ({
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      }),
+      async input => {
+        executorInputs.push(input);
+        return `22C in ${String(input.location)}`;
+      }
+    );
+
+    let firstRoundToolResult = '';
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        round += 1;
+        if (round === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
