+  it('feeds a schema rejection back as a tool_result the provider reads on its next round', async () => {
+    const registry = new ToolRegistry();
+    const executorInputs: Array<Record<string, unknown>> = [];
+    registry.register(
+      {
+        name: 'lookup',
+        description: 'looks things up',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async input => {
+        executorInputs.push(input);
+        return '22C in Paris';
+      }
+    );
+    const sent: SendMessageParams[] = [];
+    const provider = recording(
+      scriptedProvider([
+        [{type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {}}}, STOP_FOR_TOOL],
+        [{type: 'tool_use', toolCall: {id: 'call-2', name: 'lookup', input: {location: 'Paris'}}}, STOP_FOR_TOOL],
+        [{type: 'text', text: '22C in Paris'}, STOP_DONE],
+      ]),
+      sent
+    );
+
+    const reply = await createChatOrchestrator(provider, promptBuilder, registry).processMessage(createSession('ask'));
+
+    const secondRoundMessages = sent[1].messages;
+    const rejectionTexts: string[] = [];
+    for (const message of secondRoundMessages) {
+      if (!Array.isArray(message.content)) continue;
+      for (const content of message.content) {
+        if (content.type === 'tool_result') rejectionTexts.push(content.content);
+      }
+    }
+    const rejections = rejectionTexts.join('; ');
+
+    expect({
+      reply,
+      executorInputs,
+      rejectionReachedProvider: rejections.includes('location') && /required/i.test(rejections),
+    }).toEqual({
+      reply: '22C in Paris',
+      executorInputs: [{location: 'Paris'}],
+      rejectionReachedProvider: true,
+    });
+  });
 });
