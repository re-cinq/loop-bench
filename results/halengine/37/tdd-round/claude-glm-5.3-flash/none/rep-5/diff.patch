+import {ToolRegistry} from './registry.js';
+import type {ToolExecutor} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const citySchema = {
+  type: 'object',
+  properties: {location: {type: 'string'}, units: {type: 'string'}},
+  required: ['location'],
+};
+
+const registerLookupCity = (registry: ToolRegistry, executor: ToolExecutor): ToolDefinition => {
+  const definition: ToolDefinition = {
+    name: 'lookup_city',
+    description: 'Look up a city record',
+    // A fresh schema object per registration, so a test may mutate its own copy.
+    inputSchema: {...citySchema},
+  };
+  registry.register(definition, executor);
+  return definition;
+};
+
+describe('ToolRegistry inputSchema validation', () => {
+  it('rejects an empty input naming the required property with zero executor calls', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registerLookupCity(registry, async () => {
+      executorCalls += 1;
+      return 'clear';
+    });
+
+    const response = await registry.execute('lookup_city', {});
+
+    expect({
+      executorCalls,
+      namesLocationAsRequired: response.result.includes('location') && /required/i.test(response.result),
+    }).toEqual({
+      executorCalls: 0,
+      namesLocationAsRequired: true,
+    });
+  });
+
+  it('passes valid input with an unlisted extra property through to the executor unchanged, exactly once', async () => {
+    const registry = new ToolRegistry();
+    const executorInputs: Array<Record<string, unknown>> = [];
+    registerLookupCity(registry, async input => {
+      executorInputs.push(input);
+      return 'clear';
+    });
+
+    const response = await registry.execute('lookup_city', {location: 'Paris', tz: 'cet'});
+
+    expect({result: response.result, executorInputs}).toEqual({
+      result: 'clear',
+      executorInputs: [{location: 'Paris', tz: 'cet'}],
+    });
+  });
+
+  it('throws Unknown tool for a name that was never registered', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('never_registered', {})).rejects.toThrow('Unknown tool: never_registered');
+  });
+
+  it('validates ten execute calls against the schema compiled at register time, not the schema object as it later reads', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    const definition = registerLookupCity(registry, async () => {
+      executorCalls += 1;
+      return 'clear';
+    });
+
+    // The static schema was compiled once at register time, so loosening the object afterwards
+    // cannot loosen what execute enforces.
+    delete definition.inputSchema.required;
+
+    const rejections: string[] = [];
+    for (let call = 0; call < 10; call++) {
+      rejections.push((await registry.execute('lookup_city', {})).result);
+    }
+
+    expect({
+      executorCalls,
+      everyRejectionNamesLocation: rejections.every(result => result.includes('location')),
+    }).toEqual({
+      executorCalls: 0,
+      everyRejectionNamesLocation: true,
+    });
+  });
+
+  it('validates a function-valued source against the schema it returns for that call', async () => {
+    const registry = new ToolRegistry();
+    const locationSchema = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    const zipSchema = {
+      type: 'object',
+      properties: {location: {type: 'string'}, zip: {type: 'string'}},
+      required: ['zip'],
+    };
+    let currentSchema = locationSchema;
+    registry.register(
+      () => ({
+        name: 'shaped_city',
+        description: 'Look up a city record',
+        inputSchema: currentSchema,
+      }),
+      async () => 'clear'
+    );
+
+    const validForLocation = await registry.execute('shaped_city', {location: 'Paris'});
+    currentSchema = zipSchema;
+    const rejectedForZip = await registry.execute('shaped_city', {location: 'Paris'});
+    const validForZip = await registry.execute('shaped_city', {location: 'Paris', zip: '75001'});
+
+    expect({
+      locationRoundResult: validForLocation.result,
+      zipRoundNamesZip: rejectedForZip.result.includes('zip'),
+      zipRoundPassesWithZip: validForZip.result,
+    }).toEqual({
+      locationRoundResult: 'clear',
+      zipRoundNamesZip: true,
+      zipRoundPassesWithZip: 'clear',
+    });
+  });
+});
