+import type {ToolRegistry} from './registry.js';
+
+// Shared by the registry suites, which all drive the same location-requiring tool shape.
+/** Registers the weather tool requiring a location string and returns its executor call count. */
+export function registerLocationTool(registry: ToolRegistry): () => number {
+  let executorCallCount = 0;
+  registry.register(
+    {
+      name: 'get_weather',
+      description: 'Get weather for a location',
+      inputSchema: {
+        type: 'object',
+        properties: {location: {type: 'string'}},
+        required: ['location'],
+      },
+    },
+    async () => {
+      executorCallCount += 1;
+      return 'sunny';
+    }
+  );
+  return () => executorCallCount;
+}