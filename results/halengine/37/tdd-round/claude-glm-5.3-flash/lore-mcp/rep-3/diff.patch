+import {ToolRegistry} from './registry.js';
+import {registerLocationTool} from './registryTestSupport.js';
+
+describe('ToolRegistry inputSchema validation', () => {
+  it('returns a rejection naming the required property and skips the executor for input missing it', async () => {
+    const registry = new ToolRegistry();
+    const executorCalls = registerLocationTool(registry);
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({
+      executorCalls: executorCalls(),
+      namesRequiredLocation: response.result.includes('location') && /required/i.test(response.result),
+    }).toEqual({executorCalls: 0, namesRequiredLocation: true});
+  });
+
+  it('rejects a wrong-typed property naming the path and expected type without echoing the value', async () => {
+    const registry = new ToolRegistry();
+    const executorCalls = registerLocationTool(registry);
+
+    const response = await registry.execute('get_weather', {location: 42});
+
+    expect({
+      executorCalls: executorCalls(),
+      namesPath: response.result.includes('location'),
+      namesExpectedType: response.result.includes('string'),
+      echoesValue: response.result.includes('42'),
+    }).toEqual({executorCalls: 0, namesPath: true, namesExpectedType: true, echoesValue: false});
+  });
+
+  it('passes valid input with an unlisted extra property through to the executor unchanged, exactly once', async () => {
+    const registry = new ToolRegistry();
+    const executorInputs: Array<Record<string, unknown>> = [];
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}},
+      },
+      async input => {
+        executorInputs.push(input);
+        return 'sunny';
+      }
+    );
+
+    await registry.execute('get_weather', {location: 'Paris', unit: 'celsius'});
+
+    expect(executorInputs).toEqual([{location: 'Paris', unit: 'celsius'}]);
+  });
+
