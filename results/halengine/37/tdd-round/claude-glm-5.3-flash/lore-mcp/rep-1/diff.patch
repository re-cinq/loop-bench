@@ -0,0 +1,139 @@
+import {describeSchemaErrors, ToolRegistry} from './registry.js';
+
+describe('ToolRegistry input validation', () => {
+  it('rejects input missing a required property with a ToolResponse naming it and never calls the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorRuns = 0;
+    registry.register(
+      {
+        name: 'send_alert',
+        description: 'Send an alert to a channel',
+        inputSchema: {
+          type: 'object',
+          properties: {channel: {type: 'string'}},
+          required: ['channel'],
+        },
+      },
+      async () => {
+        executorRuns += 1;
+        return 'sent';
+      }
+    );
+
+    const rejection = await registry.execute('send_alert', {});
+
+    expect({
+      executorRuns,
+      namesChannel: rejection.result.includes('channel'),
+      saysRequired: /required/i.test(rejection.result),
+    }).toEqual({executorRuns: 0, namesChannel: true, saysRequired: true});
+  });
+
+  it('passes valid input through to the executor unchanged, undeclared keys included, exactly once', async () => {
+    const registry = new ToolRegistry();
+    const executorInputs: Array<Record<string, unknown>> = [];
+    registry.register(
+      {
+        name: 'book_room',
+        description: 'Book a room by id',
+        inputSchema: {
+          type: 'object',
+          properties: {roomId: {type: 'string'}},
+          required: ['roomId'],
+        },
+      },
+      async input => {
+        executorInputs.push(input);
+        return 'booked';
+      }
+    );
+
+    await registry.execute('book_room', {roomId: 'r1', guestNote: 'late arrival'});
+
+    expect(executorInputs).toEqual([{roomId: 'r1', guestNote: 'late arrival'}]);
+  });
+
+  it('throws from register when a static inputSchema is not valid JSON Schema, naming the tool', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_converter',
+          description: 'Declares an impossible schema',
+          inputSchema: {type: 42, properties: {}},
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken_converter/);
+  });
+
+  it('reuses a static tool schema compiled once at register across ten execute calls', async () => {
+    const registry = new ToolRegistry();
+    const schema: Record<string, unknown> = {
+      type: 'object',
+      properties: {documentId: {type: 'string'}},
+      required: ['documentId'],
+    };
+    let executorRuns = 0;
+    registry.register(
+      {name: 'count_pages', description: 'Count pages of a document', inputSchema: schema},
+      async () => {
+        executorRuns += 1;
+        return 'ok';
+      }
+    );
+    // If execute re-read the schema instead of reusing the register-time validator, every call below would reject.
+    schema.required = ['pageCount'];
+
+    const results: string[] = [];
+    for (let page = 0; page < 10; page++) {
+      results.push((await registry.execute('count_pages', {documentId: `doc-${page}`})).result);
+    }
+
+    expect({executorRuns, results}).toEqual({
+      executorRuns: 10,
+      results: Array.from({length: 10}, () => 'ok'),
+    });
+  });
+
+  it('validates each call of a function-valued source against the schema that call returns, not a stale one', async () => {
+    const registry = new ToolRegistry();
+    const citySchema = {type: 'object', properties: {city: {type: 'string'}}, required: ['city']};
+    const postcodeSchema = {type: 'object', properties: {postcode: {type: 'string'}}, required: ['postcode']};
+    let resolution = 0;
+    registry.register(
+      () => ({
+        name: 'geocode',
+        description: 'Resolve a place to coordinates',
+        // register resolves the source once to learn the tool's name, so the city schema covers that call and the first execute.
+        inputSchema: resolution++ < 2 ? citySchema : postcodeSchema,
+      }),
+      async () => 'resolved'
+    );
+
+    const underCitySchema = await registry.execute('geocode', {postcode: 'SW1A 1AA'});
+    const underPostcodeSchema = await registry.execute('geocode', {postcode: 'SW1A 1AA'});
+
+    expect({
+      namesCity: underCitySchema.result.includes('city'),
+      retryResolved: underPostcodeSchema,
+    }).toEqual({namesCity: true, retryResolved: {result: 'resolved'}});
+  });
+
+  it('throws Unknown tool for a name that was never registered', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('never_registered', {})).rejects.toThrow('Unknown tool: never_registered');
+  });
+
+  it('renders ajv errors from either major shape, naming the field path and the constraint it failed', () => {
+    const modern = describeSchemaErrors([{instancePath: '/ssn', message: 'must be string'}]);
+    const legacy = describeSchemaErrors([{dataPath: '.ssn', message: 'should be string'}]);
+
+    expect({modern: modern[0], legacy: legacy[0]}).toEqual({
+      modern: 'input/ssn must be string',
+      legacy: 'input.ssn should be string',
+    });
+  });
+});
