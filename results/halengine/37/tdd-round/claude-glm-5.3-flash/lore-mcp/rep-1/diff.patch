index a01748c..fca6c1c 100644
--- a/src/orchestration/tools/registry.ts
+++ b/src/orchestration/tools/registry.ts
@@ -1,3 +1,5 @@
+import Ajv from 'ajv';
+import type {ValidateFunction} from 'ajv';
 import type {ToolDefinition} from '../../types/ai.js';
 import type {OutgoingMessage} from '../../types/messages.js';
 import {log} from '../../shared/logger.js';
@@ -35,18 +37,58 @@ export interface RegisteredTool {
 interface StoredTool {
   definitionSource: ToolDefinitionSource;
   execute: ToolExecutor;
+  validator?: ValidateFunction;
 }
 
+// Structural across ajv majors — the path and message only, never `data`, which echoes the offending input value.
+interface SchemaError {
+  instancePath?: string;
+  dataPath?: string;
+  message?: string;
+}
+
+export function describeSchemaErrors(errors: readonly SchemaError[]): string[] {
+  return errors.map(error => {
+    const path = error.instancePath ?? error.dataPath;
+    return `${path ? `input${path}` : 'input'} ${error.message ?? 'failed validation'}`;
+  });
+}
+
+const AJV_OPTIONS: {strict?: boolean; validateFormats?: boolean} = {strict: false, validateFormats: false};
+
+// ajv majors type the default export differently; this is the constructor shape either one actually provides at runtime.
+const AjvCtor = Ajv as unknown as new (options?: {strict?: boolean; validateFormats?: boolean}) => import('ajv').Ajv;
+
 export class ToolRegistry {
   private readonly tools = new Map<string, StoredTool>();
+  // A plain object, not a literal argument, so ajv majors whose Options lack these keys still typecheck it. `strict: false` tolerates provider-shaped schemas carrying unknown keywords; `validateFormats: false` ignores `format` instead of failing because ajv-formats is not installed.
+  private readonly ajv = new AjvCtor(AJV_OPTIONS);
+  private readonly validators = new WeakMap<object, ValidateFunction>();
 
   private resolveDefinition(source: ToolDefinitionSource): ToolDefinition {
     return typeof source === 'function' ? source() : source;
   }
 
+  private compileValidator(name: string, inputSchema: Record<string, unknown>): ValidateFunction {
