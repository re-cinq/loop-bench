     expect(seen).toEqual(usage);
   });
+
+  it('feeds a schema-rejected call back as a tool_result and resolves once the model retries with valid input', async () => {
+    const executorInputs: Array<Record<string, unknown>> = [];
+    const registry = new ToolRegistry();
