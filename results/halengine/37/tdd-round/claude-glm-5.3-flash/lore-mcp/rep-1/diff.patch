+        const firstResult = results.find(part => part.type === 'tool_result');
+        if (!firstResult) {
+          yield {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {}}};
+          yield STOP_FOR_TOOL;
+          return;
+        }
+        if (retryIssued) {
+          yield {type: 'text', text: 'answered after retry'};
+          yield STOP_DONE;
+          return;
+        }
+        retryIssued = true;
+        rejectionText = firstResult.content;
+        yield {type: 'tool_use', toolCall: {id: 'call-2', name: 'lookup', input: {q: 'x'}}};
+        yield STOP_FOR_TOOL;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+
+    // A rejection here would fail this test as a thrown error, which is the assertion: processMessage resolves.
+    const reply = await orchestrator.processMessage(createSession('ask'));
+
+    expect({
+      reply,
+      executorInputs,
+      rejectionReachedProvider: rejectionText.includes('q') && /required/i.test(rejectionText),
+    }).toEqual({
+      reply: 'answered after retry',
+      executorInputs: [{q: 'x'}],
+      rejectionReachedProvider: true,
+    });
+  });
 });
diff --git a/src/orchestration/tools/registry.acceptance.test.ts b/src/orchestration/tools/registry.acceptance.test.ts
