+import {jest} from '@jest/globals';
+import Ajv from 'ajv';
+import {ToolRegistry} from './registry.js';
+import type {ToolExecutor} from './registry.js';
+
+/** Registers a tool whose schema requires a location string, so every unit test below shares one shape of tool. */
+const registerLocationTool = (name: string, execute: ToolExecutor): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {
+      name,
+      description: `Unit tool ${name}, schema requires a location string`,
+      inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+    },
+    execute
+  );
+  return registry;
+};
+
+describe('ToolRegistry input validation', () => {
+  it('rejects a call missing the required location and never calls the executor', async () => {
+    let executorCalls = 0;
+    const registry = registerLocationTool('unit_lookup', async () => {
+      executorCalls += 1;
+      return 'sunny';
+    });
+
+    const response = await registry.execute('unit_lookup', {});
+
+    expect({
+      executorCalls,
+      namesLocation: response.result.includes('location'),
+      saysRequired: /required/i.test(response.result),
+    }).toEqual({executorCalls: 0, namesLocation: true, saysRequired: true});
+  });
+
+  it('passes valid input through to the executor unchanged, exactly once, extras included', async () => {
+    const seenInputs: Array<Record<string, unknown>> = [];
+    const registry = registerLocationTool('unit_passthrough', async input => {
+      seenInputs.push(input);
+      return 'ok';
+    });
+
+    const response = await registry.execute('unit_passthrough', {location: 'Paris', tzOffsetMinutes: 60});
+
+    expect({response, seenInputs}).toEqual({
+      response: {result: 'ok'},
+      seenInputs: [{location: 'Paris', tzOffsetMinutes: 60}],
+    });
+  });
+
+  it('validates a function-valued source against the schema current at each call, not a cached one', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    let schemaGeneration = 0;
+    registry.register(
+      () => ({
+        name: 'unit_dynamic',
+        description: 'Returns a different schema as the generations advance',
+        inputSchema:
+          schemaGeneration === 0
+            ? {type: 'object', properties: {location: {type: 'string'}}, required: ['location']}
+            : {
+                type: 'object',
+                properties: {location: {type: 'string'}, units: {type: 'string', enum: ['celsius']}},
+                required: ['location', 'units'],
+              },
+      }),
+      async () => {
+        executorCalls += 1;
+        return 'ok';
+      }
+    );
+
+    const first = await registry.execute('unit_dynamic', {location: 'Paris'});
+    schemaGeneration = 1;
+    const second = await registry.execute('unit_dynamic', {location: 'Paris'});
+
+    expect({
+      executorCalls,
+      firstAccepted: first.result,
+      secondRejectedForUnits: second.result.includes('units') && /required/i.test(second.result),
+    }).toEqual({executorCalls: 1, firstAccepted: 'ok', secondRejectedForUnits: true});
+  });
+
+  it('compiles a static tool schema once at register time and reuses it across ten execute calls', async () => {
+    const compileSpy = jest.spyOn(Ajv.prototype, 'compile');
+    try {
+      const registry = new ToolRegistry();
+      registry.register(
+        {
+          name: 'static_forecast',
+          description: 'Static schema that must compile once',
+          inputSchema: {
+            type: 'object',
+            properties: {location: {type: 'string'}},
+            required: ['location'],
+          },
+        },
+        async () => 'clear'
+      );
+      const compileCalls = compileSpy.mock.calls;
+      const compilesAtRegister = compileCalls.length;
+      for (let round = 0; round < 10; round += 1) {
+        await registry.execute('static_forecast', {location: 'Paris'});
+      }
+
+      expect({compilesAtRegister, compilesAcrossTenExecutes: compileCalls.length}).toEqual({
+        compilesAtRegister: 1,
+        compilesAcrossTenExecutes: 1,
+      });
+    } finally {
+      compileSpy.mockRestore();
+    }
+  });
+
+  it('throws Unknown tool for an unregistered name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('ghost_tool', {})).rejects.toThrow('Unknown tool: ghost_tool');
+  });
+});
