+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+function weatherDefinition(): ToolDefinition {
+  return {
+    name: 'get_weather',
+    description: 'Get weather for a location',
+    inputSchema: {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    },
+  };
+}
+
+describe('ToolRegistry', () => {
+  it('throws at registration time naming the tool for an uncompilable schema', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_lookup',
+          description: 'Tool with an invalid JSON Schema type',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              query: {type: 'not-a-json-schema-type'},
+            },
+          },
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken_lookup/);
+  });
+
+  it('rejects input missing the required location with a ToolResponse and zero executor calls', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(weatherDefinition(), async () => {
+      executorCalls += 1;
+      return 'sunny';
+    });
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({
+      executorCalls,
+      namesLocationAsRequired: response.result.includes('location') && /required/i.test(response.result),
+    }).toEqual({executorCalls: 0, namesLocationAsRequired: true});
+  });
+
+  it('passes valid input through unchanged, undeclared extra properties included, exactly once', async () => {
+    const registry = new ToolRegistry();
+    const received: Array<Record<string, unknown>> = [];
+    registry.register(weatherDefinition(), async input => {
+      received.push(input);
+      return 'sunny';
+    });
+
+    await registry.execute('get_weather', {location: 'Berlin', units: 'metric'});
+
+    expect({executorCalls: received.length, executorSaw: received[0]}).toEqual({
+      executorCalls: 1,
+      executorSaw: {location: 'Berlin', units: 'metric'},
+    });
+  });
+
+  it('compiles a static schema at register time and reuses it across ten execute calls', async () => {
+    const registry = new ToolRegistry();
+    const definition: ToolDefinition = {
+      name: 'static_tool',
+      description: 'Schema is compiled once at register time',
+      inputSchema: {
+        type: 'object',
+        properties: {location: {type: 'string'}},
+        required: ['location'],
+      },
+    };
+    registry.register(definition, async () => 'executed');
+    // Swapped after registration; if execute re-read the definition, these calls would pass validation.
+    definition.inputSchema = {type: 'object'};
+
+    const results = [];
+    for (let round = 0; round < 10; round += 1) {
+      results.push((await registry.execute('static_tool', {})).result);
+    }
+
+    expect({allTenKeptLocationRequired: results.every(result => /required/i.test(result))}).toEqual({
+      allTenKeptLocationRequired: true,
+    });
+  });
+
+  it('validates a function-valued definition against the schema current at that call', async () => {
+    const registry = new ToolRegistry();
+    const schemas = [
+      {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      {type: 'object', properties: {location: {type: 'string'}}},
+    ];
+    let resolution = 0;
+    registry.register(
+      () => {
+        const schema = schemas[resolution % 2];
+        resolution += 1;
+        return {name: 'dynamic_tool', description: 'Schema differs between calls', inputSchema: schema};
+      },
+      async () => 'executed'
+    );
+
+    const results = [];
+    for (let round = 0; round < 2; round += 1) {
+      results.push((await registry.execute('dynamic_tool', {})).result);
+    }
+
+    expect({
+      firstPassedUnderUnrequiredSchema: results[0],
+      secondRejectedNamingLocation: results[1].includes('location') && /required/i.test(results[1]),
+    }).toEqual({firstPassedUnderUnrequiredSchema: 'executed', secondRejectedNamingLocation: true});
+  });
+
+  it('throws Unknown tool naming the unregistered name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('no_such_tool', {})).rejects.toThrow('Unknown tool: no_such_tool');
+  });
+});
