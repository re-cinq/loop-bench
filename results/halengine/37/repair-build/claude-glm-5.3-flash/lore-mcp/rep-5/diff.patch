+import {ToolRegistry, describeSchemaError} from './registry.js';
+
+describe('ToolRegistry', () => {
+  it('throws at registration time naming the tool for an uncompilable schema', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_lookup',
+          description: 'Tool with an invalid JSON Schema type',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              query: {type: 'not-a-json-schema-type'},
+            },
+          },
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken_lookup/);
+  });
+
+  it('rejects a call missing the required location with a ToolResponse and never invokes the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'sunny';
+      }
+    );
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({
+      executorCalls,
+      namesLocationAsRequired: response.result.includes('location') && /required/i.test(response.result),
+    }).toEqual({executorCalls: 0, namesLocationAsRequired: true});
+  });
+
+  it('throws Unknown tool for an unregistered name, unchanged', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('never_registered', {})).rejects.toThrow('Unknown tool: never_registered');
+  });
+
+  it('passes valid input with an unlisted extra property through to the executor unchanged, exactly once', async () => {
+    const registry = new ToolRegistry();
+    const received: Array<Record<string, unknown>> = [];
+    registry.register(
+      {
+        name: 'passthrough_weather',
+        description: 'Accepts location, tolerates extra keys',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async input => {
+        received.push(input);
+        return 'ok';
+      }
+    );
+
+    await registry.execute('passthrough_weather', {location: 'Paris', region: 'idf'});
+
+    expect(received).toEqual([{location: 'Paris', region: 'idf'}]);
+  });
+
+  it('compiles a static schema once at register and reuses it across ten execute calls', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    const schema: Record<string, unknown> = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    registry.register(
+      {name: 'static_weather', description: 'Schema compiled at register time', inputSchema: schema},
+      async () => {
+        executorCalls += 1;
+        return 'ok';
+      }
+    );
+
+    schema.required = ['location', 'unit'];
+
+    const results: string[] = [];
+    for (let call = 0; call < 10; call += 1) {
+      results.push((await registry.execute('static_weather', {location: 'Paris'})).result);
+    }
+
+    expect({executorCalls, allAccepted: results.every(result => result === 'ok')}).toEqual({
+      executorCalls: 10,
+      allAccepted: true,
+    });
+  });
+
+  it('validates a function-valued definition against the schema returned for the current call', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    let requireUnit = false;
+    const schemaWithoutUnit: Record<string, unknown> = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    const schemaWithUnit: Record<string, unknown> = {
+      type: 'object',
+      properties: {location: {type: 'string'}, unit: {enum: ['celsius', 'fahrenheit']}},
+      required: ['location', 'unit'],
+    };
+    registry.register(
+      () => ({
+        name: 'dynamic_weather',
+        description: 'Schema resolved per call',
+        inputSchema: requireUnit ? schemaWithUnit : schemaWithoutUnit,
+      }),
+      async () => {
+        executorCalls += 1;
+        return 'ok';
+      }
+    );
+
+    const first = await registry.execute('dynamic_weather', {location: 'Paris'});
+    requireUnit = true;
+    const second = await registry.execute('dynamic_weather', {location: 'Paris'});
+    const third = await registry.execute('dynamic_weather', {location: 'Paris', unit: 'celsius'});
+
+    expect({
+      executorCalls,
+      firstAccepted: first.result === 'ok',
+      secondRejectedNamingUnit: second.result.includes('unit') && /required/i.test(second.result),
+      thirdAccepted: third.result === 'ok',
+    }).toEqual({
+      executorCalls: 2,
+      firstAccepted: true,
+      secondRejectedNamingUnit: true,
+      thirdAccepted: true,
+    });
+  });
+
+  it('rejects a value violating a declared enum, naming the property and not the value', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'units_weather',
+        description: 'Requires a units enum',
+        inputSchema: {
+          type: 'object',
+          properties: {units: {enum: ['celsius', 'fahrenheit']}},
+          required: ['units'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'ok';
+      }
+    );
+
+    const response = await registry.execute('units_weather', {units: 'kelvin'});
+
+    expect({
+      executorCalls,
+      namesUnits: response.result.includes('units'),
+      namesEnum: /enum/i.test(response.result),
+      leaksValue: response.result.includes('kelvin'),
+    }).toEqual({executorCalls: 0, namesUnits: true, namesEnum: true, leaksValue: false});
+  });
+
+  it('renders rejections from the keyword, property path and constraint, whatever shape the error arrives in', () => {
+    expect(describeSchemaError({keyword: 'type', instancePath: '/ssn', params: {type: 'string'}})).toBe(
+      "property '/ssn' must be of type string"
+    );
+    expect(describeSchemaError({keyword: 'type', dataPath: '.ssn', params: {type: 'string'}})).toBe(
+      "property '.ssn' must be of type string"
+    );
+    expect(describeSchemaError({keyword: 'required', params: {missingProperty: 'location'}})).toBe(
+      "input is missing required property 'location'"
+    );
+    expect(describeSchemaError({keyword: 'enum', instancePath: '/units'})).toBe(
+      "property '/units' must be one of the declared enum values"
+    );
+    expect(describeSchemaError({keyword: 'minLength', instancePath: '/name', message: 'is too short'})).toBe(
+      "property '/name' is too short"
+    );
+    expect(describeSchemaError({keyword: 'pattern'})).toBe('input does not match its declared schema');
+    expect(describeSchemaError({keyword: 'type', params: {type: 42}})).toBe(
+      'input must be of type declared by the schema'
+    );
+    expect(describeSchemaError({keyword: 'type', params: null})).toBe('input must be of type declared by the schema');
+    expect(describeSchemaError({keyword: 'required', params: 'weird'})).toBe(
+      "input is missing required property 'a required property'"
+    );
+  });
+});
