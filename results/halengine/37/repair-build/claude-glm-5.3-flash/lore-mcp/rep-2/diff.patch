+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry', () => {
+  it('throws at registration time naming the tool for an uncompilable schema', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_lookup',
+          description: 'Tool with an invalid JSON Schema type',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              query: {type: 'not-a-json-schema-type'},
+            },
+          },
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken_lookup/);
+  });
+
+  it('passes valid input through to the executor unchanged, undeclared extra properties included, exactly once', async () => {
+    const registry = new ToolRegistry();
+    const receivedInputs: Array<Record<string, unknown>> = [];
+    registry.register(
+      {
+        name: 'lookup_record',
+        description: 'Look up a record',
+        inputSchema: {
+          type: 'object',
+          properties: {region: {type: 'string'}},
+          required: ['region'],
+        },
+      },
+      async input => {
+        receivedInputs.push(input);
+        return 'ok';
+      }
+    );
+
+    await registry.execute('lookup_record', {region: 'west', traceId: 't-1'});
+
+    expect(receivedInputs).toEqual([{region: 'west', traceId: 't-1'}]);
+  });
+
+  it('throws Unknown tool for an unregistered name, unchanged', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('never_registered', {})).rejects.toThrow('Unknown tool: never_registered');
+  });
+
+  it('reuses the schema compiled at register time across ten execute calls without re-reading the definition', async () => {
+    const registry = new ToolRegistry();
+    const definition = {
+      name: 'report_weather',
+      description: 'Report the weather for a region',
+      inputSchema: {
+        type: 'object',
+        properties: {region: {type: 'string'}},
+        required: ['region'],
+      },
+    };
+    let executorCalls = 0;
+    registry.register(definition, async () => {
+      executorCalls += 1;
+      return 'ok';
+    });
+    definition.inputSchema = {
+      type: 'object',
+      properties: {region: {type: 'number'}},
+      required: ['region'],
+    };
+
+    const responses = [];
+    for (let round = 0; round < 10; round++) {
+      responses.push(await registry.execute('report_weather', {region: 'west'}));
+    }
+
+    expect({
+      executorCalls,
+      allAccepted: responses.every(response => response.result === 'ok'),
+    }).toEqual({executorCalls: 10, allAccepted: true});
+  });
+
+  it('validates a function-valued definition against the schema returned for that call, cached by schema object', async () => {
+    const registry = new ToolRegistry();
+    const locationSchema = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    const querySchema = {
+      type: 'object',
+      properties: {query: {type: 'string'}},
+      required: ['query'],
+    };
+    let resolveCount = 0;
+    let executorCalls = 0;
+    registry.register(
+      () => {
+        resolveCount += 1;
+        // Register resolves the source once to compile up front, so the second resolution is the first execute.
+        const schema = resolveCount === 3 ? querySchema : locationSchema;
+        return {name: 'search_records', description: 'Search records', inputSchema: schema};
+      },
+      async () => {
+        executorCalls += 1;
+        return 'ok';
+      }
+    );
+
+    const byLocation = await registry.execute('search_records', {});
+    const byQuery = await registry.execute('search_records', {});
+    // Third call returns the first schema object again, now mutated: the cache must still hold the validator compiled from it before the mutation.
+    locationSchema.required = ['location', 'query'];
+    const cachedReuse = await registry.execute('search_records', {location: 'paris'});
+
+    expect({
+      firstRejectedForLocation: byLocation.result.includes('location'),
+      secondValidatedAgainstQuery: byQuery.result.includes('query'),
+      thirdReusedFirstCompile: cachedReuse.result === 'ok',
+      executorCalls,
+    }).toEqual({
+      firstRejectedForLocation: true,
+      secondValidatedAgainstQuery: true,
+      thirdReusedFirstCompile: true,
+      executorCalls: 1,
+    });
+  });
+});
