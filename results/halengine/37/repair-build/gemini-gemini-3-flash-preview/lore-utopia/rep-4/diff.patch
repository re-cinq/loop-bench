+          type: 'object',
+          properties: {ssn: {type: 'string'}},
+          required: ['ssn'],
+        },
+      },
+      async () => 'found'
+    );
+
+    const response = await registry.execute('ssn_lookup', {ssn: 12345});
+    expect(response.result).toContain('ssn');
+    expect(response.result).toMatch(/string/i);
+    expect(response.result).not.toContain('12345');
+  });
+
+  it('throws at registration time naming the tool for an uncompilable schema ([validated by: A static ToolDefinition has its inputSchema compiled once at register time, so a schema that is not valid JSON Schema throws synchronously from register with an error message naming the offending tool](../../specs/hal-engine-tool-input-validation/spec.md))', () => {
+    const registry = new ToolRegistry();
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_lookup',
+          description: 'Tool with an invalid JSON Schema type',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              query: {type: 'not-a-json-schema-type' as any},
+            },
+          },
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken_lookup/);
+  });
+
+  it('asserts a function-valued tool definition whose returned schema differs between calls is validated against the schema current at that call ([validated by: A function-valued ToolDefinitionSource resolves its definition on each execute call and validates against the inputSchema returned for that call, caching compiled validators by schema object reference (WeakMap) so distinct returned schemas each enforce their own rules.](../../specs/hal-engine-tool-input-validation/spec.md))', async () => {
+    const registry = new ToolRegistry();
+    let schemaType = 'string';
+    registry.register(
+      () => ({
+        name: 'dynamic',
+        description: 'dynamic',
+        inputSchema: {
+          type: 'object',
+          properties: {val: {type: schemaType as any}},
+        },
+      }),
+      async () => 'ok'
+    );
+
+    // First call: val must be string
+    const res1 = await registry.execute('dynamic', {val: 123});
+    expect(res1.result).toMatch(/string/i);
+
+    // Change schema requirement
+    schemaType = 'number';
+    const res2 = await registry.execute('dynamic', {val: 'abc'});
+    expect(res2.result).toMatch(/number/i);
+  });
+
+  it('still throws Unknown tool for an unregistered name ([validated by: When ToolRegistry.execute is called with a tool name that has not been registered, it throws Unknown tool: <name> because an unregistered tool is a programming or configuration error rather than a recoverable input mistake.](../../specs/hal-engine-tool-input-validation/spec.md))', async () => {
+    const registry = new ToolRegistry();
+    await expect(registry.execute('nope', {})).rejects.toThrow('Unknown tool: nope');
+  });
+
+  it("asserts a rejected payload containing an identifying field produces no returned text containing that field's value ([validated by: When input supplies a property whose value does not match its declared JSON Schema type, ToolRegistry.execute returns a ToolResponse naming the failing field path and expected type without invoking the executor, and neither result nor the emitted log record contains the offending property value](../../specs/hal-engine-tool-input-validation/spec.md))", async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'ssn_lookup',
+        description: 'Look up record by identifier',
+        inputSchema: {
+          type: 'object',
+          properties: {ssn: {type: 'string'}},
+          required: ['ssn'],
+        },
+      },
+      async () => 'found'
+    );
+
+    const response = await registry.execute('ssn_lookup', {ssn: 'hidden-value'});
+    // We want a rejection, so we need to provide a wrong type
+    const response2 = await registry.execute('ssn_lookup', {ssn: 999});
+    expect(response2.result).toContain('ssn');
+    expect(response2.result).not.toContain('999');
+  });
+
+  it("asserts a static tool schema is compiled once across ten execute calls ([validated by: A static tool's inputSchema is compiled at register time and reused on every execute call without re-reading or re-compiling definition.inputSchema.](../../specs/hal-engine-tool-input-validation/spec.md))", async () => {
+    let compileCount = 0;
+    const AjvModule = await import('ajv');
+    const Ajv = (AjvModule.default || AjvModule) as any;
+    const originalCompile = Ajv.prototype.compile;
+    Ajv.prototype.compile = function (this: any, ...args: any[]) {
+      compileCount++;
+      return originalCompile.apply(this, args);
+    };
+
+    try {
+      const registry = new ToolRegistry();
+      registry.register(
+        {
+          name: 'static_compile_test',
+          description: 'static',
+          inputSchema: {type: 'object'},
+        },
+        async () => 'ok'
+      );
+
+      const countAfterRegister = compileCount;
+      expect(countAfterRegister).toBeGreaterThan(0);
+
+      for (let i = 0; i < 10; i++) {
+        await registry.execute('static_compile_test', {});
+      }
+
+      expect(compileCount).toBe(countAfterRegister);
+    } finally {
+      Ajv.prototype.compile = originalCompile;
+    }
+  });
+});
