     expect(seen).toEqual(usage);
   });
+
+  it('drives a stub provider through a rejected tool call followed by a corrected retry, and asserts processMessage resolves ([validated by: Because a schema rejection returns a ToolResponse instead of throwing, src/orchestration/chatOrchestrator.ts sends the rejection result back to the provider as a tool_result message, allowing the model to issue a corrected tool call on the next round and complete the turn within maxToolRounds](../../specs/hal-engine-tool-input-validation/spec.md))', async () => {
+    const registry = new ToolRegistry();
+    let executorInput: any;
+    registry.register(
+      {
+        name: 'weather',
+        description: 'weather',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async input => {
+        executorInput = input;
+        return `22C in ${input.location}`;
+      }
+    );
+
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        const lastMessage = params.messages[params.messages.length - 1];
+        if (lastMessage.role === 'user' && typeof lastMessage.content === 'string') {
+          yield {type: 'tool_use', toolCall: {id: 'c1', name: 'weather', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+
+        if (lastMessage.role === 'user' && Array.isArray(lastMessage.content)) {
+          const firstResult = lastMessage.content[0];
+          if (firstResult?.content.includes('location is required')) {
+            yield {type: 'tool_use', toolCall: {id: 'c2', name: 'weather', input: {location: 'London'}}};
+            yield {type: 'stop', stopReason: 'tool_use'};
+            return;
+          }
+        }
+
+        yield {type: 'text', text: 'London is 22C'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+    const result = await orchestrator.processMessage(createSession('weather?'));
+
+    expect(result).toBe('London is 22C');
+    expect(executorInput).toEqual({location: 'London'});
+  });
