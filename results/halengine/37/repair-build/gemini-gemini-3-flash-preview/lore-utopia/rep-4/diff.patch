+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry', () => {
+  it('registers a tool requiring a location string, calls execute with {}, and asserts the returned result names location as required and the executor call count is 0 ([validated by: When input omits a property listed in required, ToolRegistry.execute returns a ToolResponse whose result names the missing property as required and never invokes the executor](../../specs/hal-engine-tool-input-validation/spec.md))', async () => {
