+        name: 'get_weather',
+        description: 'Get weather',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'sunny';
+      }
+    );
+
+    const response = await registry.execute('get_weather', {});
+    expect(response.result).toContain('location');
+    expect(response.result).toMatch(/required/i);
+    expect(executorCalls).toBe(0);
+  });
+
+  it('asserts valid input with an unlisted extra property is passed through to the executor unchanged — exactly once ([validated by: When input satisfies required, declared property types and enum, ToolRegistry.execute invokes the executor once and passes the input object through unchanged — including undeclared extra properties — without injecting additionalProperties: false, coercing types or applying defaults.](../../specs/hal-engine-tool-input-validation/spec.md))', async () => {
+    const registry = new ToolRegistry();
+    let executorInput: any;
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'echo',
+        description: 'Echo input',
+        inputSchema: {type: 'object', properties: {foo: {type: 'string'}}},
+      },
+      async input => {
+        executorCalls += 1;
+        executorInput = input;
+        return 'ok';
+      }
+    );
+
+    const input = {foo: 'bar', extra: 'baz'};
+    await registry.execute('echo', input);
+
+    expect(executorCalls).toBe(1);
+    expect(executorInput).toEqual({foo: 'bar', extra: 'baz'});
+  });
+
+  it('asserts a wrong-typed field is rejected with a message naming the field path and expected type, and no offending value ([validated by: When input supplies a property whose value does not match its declared JSON Schema type, ToolRegistry.execute returns a ToolResponse naming the failing field path and expected type without invoking the executor, and neither result nor the emitted log record contains the offending property value](../../specs/hal-engine-tool-input-validation/spec.md))', async () => {
+    const registry = new ToolRegistry();
