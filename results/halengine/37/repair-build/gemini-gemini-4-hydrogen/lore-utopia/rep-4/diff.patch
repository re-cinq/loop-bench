+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+describe('ToolRegistry', () => {
+  it('throws at registration time naming the tool for an uncompilable schema', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_lookup',
+          description: 'Tool with an invalid JSON Schema type',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              query: {type: 'not-a-json-schema-type'},
+            },
+          },
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken_lookup/);
+  });
+
+  it('passes valid input with undeclared extra properties through to the executor unchanged', async () => {
+    const registry = new ToolRegistry();
+    const receivedInputs: Array<Record<string, unknown>> = [];
+    registry.register(weatherDefinition(), async input => {
+      receivedInputs.push(input);
+      return String(input.location);
+    });
+
+    const response = await registry.execute('get_weather', {location: 'Berlin', extra: 42});
+
+    expect({response, receivedInputs}).toEqual({
+      response: {result: 'Berlin'},
+      receivedInputs: [{location: 'Berlin', extra: 42}],
+    });
+  });
+
+  it('rejects a disallowed enum value without echoing the offending value', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(weatherDefinition(), async () => {
+      executorCalls += 1;
+      return 'unreachable';
+    });
+
+    const response = await registry.execute('get_weather', {location: 'Berlin', units: 'kelvin'});
+
+    expect({
+      executorCalls,
+      mentionsField: response.result.includes('units'),
+      mentionsAllowedValue: response.result.includes('celsius'),
+      echoesOffendingValue: response.result.includes('kelvin'),
+    }).toEqual({
+      executorCalls: 0,
+      mentionsField: true,
