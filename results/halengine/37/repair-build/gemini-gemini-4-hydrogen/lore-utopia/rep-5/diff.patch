+        const [firstResult] = lastMessage.content;
+        rejectionSeenByProvider = firstResult?.content ?? '';
+        yield {type: 'tool_use', toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Oslo'}}};
+        yield STOP_FOR_TOOL;
+      },
