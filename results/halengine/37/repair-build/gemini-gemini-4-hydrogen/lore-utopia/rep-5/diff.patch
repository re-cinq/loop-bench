+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+describe('ToolRegistry', () => {
+  afterEach(() => {
+    setLogger(undefined);
+  });
+
+  it('throws at registration time naming the tool for an uncompilable schema', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_lookup',
+          description: 'Tool with an invalid JSON Schema type',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              query: {type: 'not-a-json-schema-type'},
+            },
+          },
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken_lookup/);
+  });
+
+  it('returns a rejection ToolResponse naming a missing required property without calling the executor', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async () => {
+        calls += 1;
+        return 'ok';
+      }
+    );
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({
+      calls,
+      namesLocation: response.result.includes('location'),
+      mentionsRequired: /required/i.test(response.result),
+    }).toEqual({
+      calls: 0,
+      namesLocation: true,
+      mentionsRequired: true,
+    });
+  });
+
+  it('passes valid input with unlisted extra properties through to the executor unchanged', async () => {
+    const registry = new ToolRegistry();
+    const receivedInputs: Array<Record<string, unknown>> = [];
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+            units: {type: 'string', default: 'celsius'},
+          },
+          required: ['location'],
+        },
+      },
+      async input => {
+        receivedInputs.push(input);
+        return 'sunny';
+      }
+    );
+
+    const payload = {location: 'Berlin', extraFlag: true, extraCount: 42};
+    const response = await registry.execute('get_weather', payload);
+
+    expect({response, receivedInputs}).toEqual({
+      response: {result: 'sunny'},
+      receivedInputs: [{location: 'Berlin', extraFlag: true, extraCount: 42}],
+    });
+  });
+
+  it('rejects a wrong-typed field naming the path and expected type without leaking the value', async () => {
+    const logs: string[] = [];
+    const collect = (category: string, message: string, fields?: Record<string, unknown>) => {
+      logs.push(JSON.stringify({category, message, fields}));
+    };
+    const logger: Logger = {debug: collect, info: collect, warn: collect, error: collect};
+    setLogger(logger);
+
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(
+      {
+        name: 'create_ticket',
+        description: 'Create ticket',
+        inputSchema: {
+          type: 'object',
+          properties: {priority: {type: 'number'}},
+          required: ['priority'],
+        },
+      },
+      async () => {
+        calls += 1;
+        return 'created';
+      }
+    );
+
+    const response = await registry.execute('create_ticket', {priority: 'secret-value-999'});
+
+    expect({
+      calls,
+      namesField: response.result.includes('priority'),
+      namesType: response.result.includes('number'),
+      leaksInResult: response.result.includes('secret-value-999'),
+      leaksInLogs: logs.some(line => line.includes('secret-value-999')),
+    }).toEqual({
+      calls: 0,
+      namesField: true,
+      namesType: true,
+      leaksInResult: false,
+      leaksInLogs: false,
+    });
+  });
+
+  it('rejects an enum mismatch naming the field path without leaking the offending value', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            units: {type: 'string', enum: ['celsius', 'fahrenheit']},
+          },
+          required: ['units'],
+        },
+      },
+      async () => {
+        calls += 1;
+        return 'ok';
+      }
+    );
+
+    const response = await registry.execute('get_weather', {units: 'kelvin-secret'});
+
+    expect({
+      calls,
+      namesField: response.result.includes('units'),
+      leaksValue: response.result.includes('kelvin-secret'),
+    }).toEqual({
+      calls: 0,
+      namesField: true,
+      leaksValue: false,
+    });
+  });
+
+  it('validates a function-valued tool definition against the schema current at each call', async () => {
+    const registry = new ToolRegistry();
+    const schemaA = {
+      type: 'object',
+      properties: {alpha: {type: 'string'}},
+      required: ['alpha'],
+    };
+    const schemaB = {
+      type: 'object',
+      properties: {beta: {type: 'string'}},
+      required: ['beta'],
+    };
+    let currentSchema = schemaA;
+
+    registry.register(
+      () => ({
+        name: 'dynamic_tool',
+        description: 'Dynamic tool',
+        inputSchema: currentSchema,
+      }),
+      async input => JSON.stringify(input)
+    );
+
+    const firstValid = await registry.execute('dynamic_tool', {alpha: 'one'});
+    currentSchema = schemaB;
+    const secondRejected = await registry.execute('dynamic_tool', {alpha: 'one'});
+    const secondValid = await registry.execute('dynamic_tool', {beta: 'two'});
+
+    expect({
+      firstResult: firstValid.result,
+      secondRejectedNamesBeta: secondRejected.result.includes('beta'),
+      secondResult: secondValid.result,
+    }).toEqual({
+      firstResult: '{"alpha":"one"}',
+      secondRejectedNamesBeta: true,
+      secondResult: '{"beta":"two"}',
+    });
+  });
+
+  it('compiles a static tool schema once across ten execute calls', async () => {
+    const registry = new ToolRegistry();
+    let schemaReads = 0;
+    const schema = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    const definition: ToolDefinition = {
+      name: 'static_weather',
+      description: 'Static weather',
+      inputSchema: schema,
+    };
+    Object.defineProperty(definition, 'inputSchema', {
+      enumerable: true,
+      get() {
+        schemaReads += 1;
+        return schema;
+      },
+    });
+
+    registry.register(definition, async input => String(input.location));
+
+    const results: string[] = [];
+    for (let i = 0; i < 10; i += 1) {
+      const response = await registry.execute('static_weather', {location: `city-${i}`});
+      results.push(response.result);
+    }
+
+    expect({schemaReads, callCount: results.length}).toEqual({schemaReads: 1, callCount: 10});
+  });
+
+  it('throws Unknown tool when executing an unregistered name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('missing_tool', {})).rejects.toThrow('Unknown tool: missing_tool');
+  });
+});
