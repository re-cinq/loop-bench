+  it('resolves after a schema-rejected tool call when the model retries with valid input', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'lookup',
+        description: 'Look up a record',
+        inputSchema: {type: 'object', properties: {query: {type: 'string'}}, required: ['query']},
+      },
+      async input => {
+        executorCalls += 1;
+        return `found:${String(input.query)}`;
+      }
+    );
+
+    const observedResults: string[] = [];
+    let callIndex = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        callIndex += 1;
+        if (callIndex === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'c1', name: 'lookup', input: {}}};
+          yield STOP_FOR_TOOL;
+          return;
+        }
+        if (callIndex !== 2) {
+          yield {type: 'text', text: 'completed after retry'};
+          yield STOP_DONE;
+          return;
+        }
+        const toolMessage = params.messages[params.messages.length - 1] as ToolResultMessage;
+        const [firstEntry] = toolMessage.content;
+        observedResults.push(firstEntry?.content ?? '');
+        yield {type: 'tool_use', toolCall: {id: 'c2', name: 'lookup', input: {query: 'hal'}}};
+        yield STOP_FOR_TOOL;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+    const reply = await orchestrator.processMessage(createSession('find hal'));
+
+    expect({
+      reply,
+      executorCalls,
+      rejectedForQuery: observedResults[0]?.includes('query') && /required/i.test(observedResults[0] ?? ''),
+    }).toEqual({
+      reply: 'completed after retry',
+      executorCalls: 1,
+      rejectedForQuery: true,
+    });
+  });
 });
