+  const append = (category: string, message: string, fields?: Record<string, unknown>) => {
+    entries.push(JSON.stringify({category, message, fields}));
+  };
+  const logger: Logger = {debug: append, info: append, warn: append, error: append};
+  setLogger(logger);
+  return entries;
