diff --git a/specs/hal-engine-tool-input-validation/spec.md b/specs/hal-engine-tool-input-validation/spec.md
new file mode 100644
index 0000000..741c88d
--- /dev/null
+++ b/specs/hal-engine-tool-input-validation/spec.md
@@ -0,0 +1,26 @@
+# Tool Input Validation
+
+| Field  | Value                |
+| ------ | -------------------- |
+| Issue  | re-cinq/HALEngine#37 |
+| Status | Shipped              |
+
+Every tool registered in `src/orchestration/tools/registry.ts` declares a JSON Schema `inputSchema` that is forwarded to the configured AI provider, and `ToolRegistry.execute` validates the model-supplied `input` against that schema before calling the tool's executor. When validation fails, `execute` returns a rejection `ToolResponse` describing what was wrong without echoing or logging offending values, so the orchestrator feeds the failure back to the model as a `tool_result` within the existing tool-round budget.
+
+## Validation at execute time
+
+- When `input` omits a property listed in `required`, `ToolRegistry.execute` returns a `ToolResponse` whose `result` names the missing property as required and never invokes the executor ([validated by: rejects input missing a required property with a ToolResponse and never calls the executor](../../src/orchestration/tools/registry.acceptance.test.ts#L16), [validated by: rejects input missing a required property and leaves the executor uncalled](../../src/orchestration/tools/registry.test.ts#L41)).
+- When `input` supplies a property whose value does not match its declared JSON Schema type, `ToolRegistry.execute` returns a `ToolResponse` naming the failing field path and expected type without invoking the executor, and neither `result` nor the emitted log record contains the offending property value ([validated by: rejects a wrong-typed property naming the field and expected type without leaking the offending value to the result or logs](../../src/orchestration/tools/registry.acceptance.test.ts#L46), [validated by: rejects a wrong-typed property naming the field path and expected type without leaking the value](../../src/orchestration/tools/registry.test.ts#L115)).
+- When `input` supplies a value outside a property's declared `enum`, `ToolRegistry.execute` returns a `ToolResponse` naming the failing field and allowed values without leaking the offending value to `result` or logs ([validated by: rejects a value outside the declared enum without leaking the offending value](../../src/orchestration/tools/registry.test.ts#L158)).
+- When `input` satisfies `required`, declared property types and `enum`, `ToolRegistry.execute` invokes the executor once and passes the input object through unchanged — including undeclared extra properties — without injecting `additionalProperties: false`, coercing types or applying defaults ([validated by: passes valid input with unlisted extra properties unchanged without adding defaults or coercing](../../src/orchestration/tools/registry.test.ts#L73)).
+- When `ToolRegistry.execute` is called with a tool name that has not been registered, it throws `Unknown tool: <name>` because an unregistered tool is a programming or configuration error rather than a recoverable input mistake ([validated by: throws Unknown tool for an unregistered tool name](../../src/orchestration/tools/registry.test.ts#L260)).
+
+## Schema compilation and caching
+
+- A static `ToolDefinition` has its `inputSchema` compiled once at `register` time with `ajv` (`strict: false`, `validateFormats: false`, `allErrors: true`), so a schema that is not valid JSON Schema throws synchronously from `register` with an error message naming the offending tool ([validated by: throws at register time naming the tool when a static inputSchema cannot be compiled](../../src/orchestration/tools/registry.acceptance.test.ts#L94), [validated by: throws at registration time naming the tool for an uncompilable schema](../../src/orchestration/tools/registry.test.ts#L21)).
+- A static tool's `inputSchema` is compiled at `register` time and reused on every `execute` call without re-reading or re-compiling `definition.inputSchema` ([validated by: compiles a static tool schema once across ten execute calls](../../src/orchestration/tools/registry.test.ts#L230)).
+- A function-valued `ToolDefinitionSource` resolves its definition on each `execute` call and validates against the `inputSchema` returned for that call, caching compiled validators by schema object reference (`WeakMap`) so distinct returned schemas each enforce their own rules ([validated by: validates a function-valued tool definition against the schema current at each execute call](../../src/orchestration/tools/registry.test.ts#L191)).
+
+## Orchestrator tool-loop recovery
+
+- Because a schema rejection returns a `ToolResponse` instead of throwing, `src/orchestration/chatOrchestrator.ts` sends the rejection `result` back to the provider as a `tool_result` message, allowing the model to issue a corrected tool call on the next round and complete the turn within `maxToolRounds` ([validated by: returns a schema rejection as a tool_result in the orchestrator loop so the model can correct the call on the next round](../../src/orchestration/tools/registry.acceptance.test.ts#L112), [validated by: feeds a schema rejection back to the provider so the model can retry and resolve](../../src/orchestration/chatOrchestrator.test.ts#L523)).
diff --git a/src/orchestration/chatOrchestrator.test.ts b/src/orchestration/chatOrchestrator.test.ts
index dbe7b33..397e6fb 100644
--- a/src/orchestration/chatOrchestrator.test.ts
+++ b/src/orchestration/chatOrchestrator.test.ts
@@ -519,4 +519,56 @@ describe('ChatOrchestrator tool loop', () => {
 
     expect(seen).toEqual(usage);
   });
+
+  it('feeds a schema rejection back to the provider so the model can retry and resolve', async () => {
+    const registry = new ToolRegistry();
+    const seenInputs: Array<Record<string, unknown>> = [];
+    registry.register(
+      {
+        name: 'lookup_city',
+        description: 'Look up city details',
+        inputSchema: {
+          type: 'object',
+          properties: {city: {type: 'string'}},
+          required: ['city'],
+        },
+      },
+      async input => {
+        seenInputs.push(input);
+        return `Found ${String(input.city)}`;
+      }
+    );
+
+    const recordedParams: SendMessageParams[] = [];
+    const baseProvider = scriptedProvider([
+      [{type: 'tool_use', toolCall: {id: 'c1', name: 'lookup_city', input: {}}}, STOP_FOR_TOOL],
+      [{type: 'tool_use', toolCall: {id: 'c2', name: 'lookup_city', input: {city: 'Lyon'}}}, STOP_FOR_TOOL],
+      [{type: 'text', text: 'City is Lyon'}, STOP_DONE],
+    ]);
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        recordedParams.push({...params, messages: [...params.messages]});
+        yield* baseProvider.sendMessage(params);
+      },
+      generateStructured: baseProvider.generateStructured,
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+    const reply = await orchestrator.processMessage(createSession('Look up Lyon'));
+
+    const secondRoundMessages = recordedParams[1]?.messages ?? [];
+    const lastEntry = secondRoundMessages[secondRoundMessages.length - 1];
+    const toolResultBlocks = Array.isArray(lastEntry?.content) ? lastEntry.content : [];
+    const rejectionText = toolResultBlocks[0]?.content ?? '';
+
+    expect({
+      reply,
+      seenInputs,
+      rejectionIncludedCity: rejectionText.includes('city') && /required/i.test(rejectionText),
+    }).toEqual({
+      reply: 'City is Lyon',
+      seenInputs: [{city: 'Lyon'}],
+      rejectionIncludedCity: true,
+    });
+  });
 });
