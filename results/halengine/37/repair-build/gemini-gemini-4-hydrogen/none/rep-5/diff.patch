+    registry.register(
+      {
+        name: 'forecast',
+        description: 'Forecast lookup',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async () => {
+        calls += 1;
+        return 'clear';
+      }
+    );
+
+    const response: ToolResponse = await registry.execute('forecast', {});
+
+    expect({
+      calls,
+      hasLocation: response.result.includes('location'),
