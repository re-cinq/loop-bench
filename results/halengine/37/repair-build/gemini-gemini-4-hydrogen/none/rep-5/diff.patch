@@ -519,4 +519,50 @@ describe('ChatOrchestrator tool loop', () => {
 
     expect(seen).toEqual(usage);
   });
+
+  it('feeds a schema rejection back to the provider so a corrected retry resolves', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'lookup',
+        description: 'looks things up',
+        inputSchema: {type: 'object', properties: {q: {type: 'string'}}, required: ['q']},
+      },
+      async input => `found ${String(input.q)}`
+    );
+
+    const seenToolResults: string[] = [];
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        round += 1;
+        if (round === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {}}};
+          yield STOP_FOR_TOOL;
+          return;
+        }
+        if (round !== 2) {
+          yield {type: 'text', text: 'recovered'};
+          yield STOP_DONE;
+          return;
+        }
+        const last = params.messages[params.messages.length - 1];
+        const firstPart = last.role === 'user' && Array.isArray(last.content) ? last.content[0] : undefined;
+        if (firstPart) seenToolResults.push(firstPart.content);
+        yield {type: 'tool_use', toolCall: {id: 'call-2', name: 'lookup', input: {q: 'ok'}}};
+        yield STOP_FOR_TOOL;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+    const reply = await orchestrator.processMessage(createSession('ask'));
+
+    expect({
+      reply,
+      rejectionIncludedQ: seenToolResults.some(text => text.includes('q') && /required/i.test(text)),
+    }).toEqual({reply: 'recovered', rejectionIncludedQ: true});
+  });
 });
