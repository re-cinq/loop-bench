+    const schema = {type: 'object', properties: {city: {type: 'string'}}, required: ['city']};
+    let schemaReads = 0;
+    const definition: ToolDefinition = {name: 'static_weather', description: 'Static schema', inputSchema: {}};
+    Object.defineProperty(definition, 'inputSchema', {
+      enumerable: true,
+      get() {
+        schemaReads += 1;
+        return schema;
+      },
+    });
+
+    registry.register(definition, async input => String(input.city));
+
+    const results: string[] = [];
+    for (let index = 0; index < 10; index += 1) {
+      const response = await registry.execute('static_weather', {city: 'Oslo'});
+      results.push(response.result);
+    }
+
+    expect({schemaReads, callCount: results.length}).toEqual({schemaReads: 1, callCount: 10});
+  });
+
+  it('validates function-valued tool definitions against the current schema and caches per object', async () => {
+    const registry = new ToolRegistry();
+    const citySchema = {type: 'object', properties: {city: {type: 'string'}}, required: ['city']};
+    const postalSchema = {type: 'object', properties: {postalCode: {type: 'string'}}, required: ['postalCode']};
+    let activeSchema: Record<string, unknown> = citySchema;
+
+    registry.register(
+      () => ({name: 'dynamic_geo', description: 'Geo lookup', inputSchema: activeSchema}),
+      async input => JSON.stringify(input)
+    );
+
+    const firstValid = await registry.execute('dynamic_geo', {city: 'Paris'});
+    activeSchema = postalSchema;
+    const staleRejected = await registry.execute('dynamic_geo', {city: 'Paris'});
+    const secondValid = await registry.execute('dynamic_geo', {postalCode: '75001'});
+
+    expect({
+      firstAccepted: firstValid.result === '{"city":"Paris"}',
+      staleRejectedForPostal: staleRejected.result.includes('postalCode') && /required/i.test(staleRejected.result),
+      secondAccepted: secondValid.result === '{"postalCode":"75001"}',
+    }).toEqual({firstAccepted: true, staleRejectedForPostal: true, secondAccepted: true});
+  });
+
+  it('throws Unknown tool for an unregistered tool name', async () => {
+    const registry = new ToolRegistry();
+    const pendingCall = registry.execute('missing_tool', {});
+    const outcome = await pendingCall.then(() => 'resolved').catch((error: Error) => error.message);
+
+    expect(outcome).toBe('Unknown tool: missing_tool');
+  });
+});
