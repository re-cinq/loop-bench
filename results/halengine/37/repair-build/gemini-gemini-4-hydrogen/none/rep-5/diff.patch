+    registry.register(
+      {
+        name: 'forecast',
+        description: 'Forecast lookup',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+            units: {type: 'string', enum: ['celsius', 'fahrenheit'], default: 'celsius'},
+          },
+          required: ['location'],
+        },
+      },
+      async input => {
+        received.push(input);
+        return 'ok';
+      }
+    );
+
+    const payload = {location: 'Berlin', extraTag: 'keep-me'};
+    await registry.execute('forecast', payload);
+
+    expect(received).toEqual([{location: 'Berlin', extraTag: 'keep-me'}]);
+  });
+
+  it('rejects wrong-typed input naming field path and expected type without offending value', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(
+      {
+        name: 'counter_tool',
+        description: 'Accepts a string label',
+        inputSchema: {
+          type: 'object',
+          properties: {label: {type: 'string'}},
+          required: ['label'],
+        },
+      },
+      async () => {
+        calls += 1;
+        return 'ok';
+      }
+    );
+
+    const response = await registry.execute('counter_tool', {label: 987654});
+
+    expect({
+      calls,
+      mentionsField: response.result.includes('label'),
+      mentionsType: response.result.includes('string'),
+      leaksValue: response.result.includes('987654'),
+    }).toEqual({calls: 0, mentionsField: true, mentionsType: true, leaksValue: false});
+  });
+
+  it('rejects enum violations without leaking identifying values to result or logs', async () => {
+    const logLines: string[] = [];
+    const capture = (category: string, message: string, fields?: Record<string, unknown>) => {
+      logLines.push(JSON.stringify({category, message, fields}));
+    };
+    const logger: Logger = {debug: capture, info: capture, warn: capture, error: capture};
+    setLogger(logger);
+
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'unit_tool',
+        description: 'Unit selector',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            units: {type: 'string', enum: ['celsius', 'fahrenheit']},
+            secretToken: {type: 'string'},
+          },
+          required: ['units'],
+        },
+      },
+      async () => 'ok'
+    );
+
+    const response = await registry.execute('unit_tool', {
+      units: 'secret-kelvin-value',
+      secretToken: 'tok-998877',
+    });
+
+    expect({
+      mentionsUnits: response.result.includes('units'),
+      leaksEnumValue: response.result.includes('secret-kelvin-value'),
+      leaksToken: response.result.includes('tok-998877'),
