+import {WebSocket} from 'ws';
+import {createHalEngine} from '../../config.js';
+import {InMemorySessionStore} from '../../infrastructure/stores/inMemorySessionStore.js';
+import type {SessionListOptions} from '../../types/sessionStore.js';
+import type {OutgoingMessage} from '../../types/messages.js';
+
+class RecordingSessionStore extends InMemorySessionStore {
+  readonly listedUsers: Array<string | number> = [];
+
+  override listFor(userId: string | number, options?: SessionListOptions) {
+    this.listedUsers.push(userId);
+    return super.listFor(userId, options);
+  }
+}
+
+describe('the conversation list websocket protocol', () => {
+  it('answers a list request with only the authenticated user’s summaries as ISO dates', async () => {
+    const sessionStore = new RecordingSessionStore();
+    sessionStore.create('own-conversation', 'alice');
+    sessionStore.create('other-conversation', 'bob');
+    const expected = sessionStore.listFor('alice').map(summary => ({
+      ...summary,
+      createdAt: summary.createdAt.toISOString(),
+      updatedAt: summary.updatedAt.toISOString(),
+    }));
+    sessionStore.listedUsers.length = 0;
+    const engine = createHalEngine({
+      provider: {type: 'mock'},
+      prompt: {identity: 'test assistant'},
+      session: sessionStore,
+      auth: {ws: async () => ({id: 'alice'})},
+      transport: {history: {enabled: true}},
+    });
+
+    await engine.start(0);
+    const address = engine.server.address();
+    if (!address || typeof address === 'string') throw new Error('WebSocket server did not bind a TCP port');
+    const socket = new WebSocket(`ws://127.0.0.1:${address.port}/hal/ws`, ['hal.v1']);
+    const messages: OutgoingMessage[] = [];
+
+    try {
+      await new Promise<void>((resolve, reject) => {
+        socket.on('message', raw => {
+          const message = JSON.parse(raw.toString()) as OutgoingMessage;
+          messages.push(message);
+          if (message.type === 'connected') {
+            socket.send(JSON.stringify({type: 'list_conversations', userId: 'bob'}));
+          } else {
+            resolve();
+          }
+        });
+        socket.once('error', reject);
+      });
+
+      expect(messages.slice(1)).toEqual([{type: 'conversation_list', conversations: expected}]);
+      expect(sessionStore.listedUsers).toEqual(['alice']);
+    } finally {
+      const closed = new Promise<void>(resolve => socket.once('close', () => resolve()));
+      socket.close();
+      await closed;
+      await engine.stop();
+    }
+  });
+});