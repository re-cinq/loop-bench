@@ -0,0 +1,157 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import type {Express} from 'express';
+import {WebSocket} from 'ws';
+import {InMemorySessionStore} from '../../infrastructure/stores/inMemorySessionStore.js';
+import {createServer} from '../createServer.js';
+import {createChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../../providers/mock/index.js';
+import {HAL_WS_SUBPROTOCOL} from './subprotocol.js';
+import type {SessionListOptions, SessionSummary} from '../../types/sessionStore.js';
+import {validateMessage} from './validation.js';
+
+interface Frame {
+  type: string;
+  code?: string;
+  conversations?: Array<{
+    sessionId: string;
+    createdAt: string;
+    updatedAt: string;
+    entryCount: number;
+  }>;
+}
+
+describe('conversation list over the WebSocket protocol', () => {
+  // spec: specs/hal-engine-conversation-list/spec.md#39
+  it('accepts a composite paging cursor and names invalid list fields', () => {
+    expect(
+      validateMessage({
+        type: 'list_conversations',
+        limit: 1,
+        before: {updatedAt: '2026-01-02T00:00:00.000Z', sessionId: 'middle'},
+      })
+    ).toMatchObject({valid: true});
+
+    for (const [field, value] of [
+      ['limit', 0],
+      ['limit', 201],
+      ['limit', 1.5],
+      ['limit', '10'],
+      ['before', {updatedAt: 'not a date', sessionId: 'middle'}],
+      ['before', {updatedAt: '2026-01-02T00:00:00.000Z'}],
+    ]) {
+      expect(validateMessage({type: 'list_conversations', [field]: value})).toMatchObject({
+        valid: false,
+        error: expect.stringContaining(field),
+      });
+    }
+  });
+
+  // spec: specs/hal-engine-conversation-list/spec.md#37
+  it('returns only the authenticated user’s summaries as wire-safe dates when asked', async () => {
+    const {hal, client, sessionStore} = await engine(true);
+
+    try {
+      const connected = once(client, 'message');
+      await once(client, 'open');
+      await connected;
+      const answer = once(client, 'message');
+      client.send(JSON.stringify({type: 'list_conversations', userId: 'u2'}));
+      const [raw] = await answer;
+      const frame = JSON.parse(String(raw)) as Frame;
+
+      expect(frame.type).toBe('conversation_list');
+      expect(frame.conversations?.map(({sessionId}) => sessionId)).toEqual(['newest', 'middle', 'older']);
+      expect(frame.conversations).toHaveLength(3);
+      expect(
+        frame.conversations?.every(
+          ({createdAt, updatedAt}) =>
+            !Number.isNaN(Date.parse(createdAt)) &&
+            new Date(createdAt).toISOString() === createdAt &&
+            !Number.isNaN(Date.parse(updatedAt)) &&
+            new Date(updatedAt).toISOString() === updatedAt
+        )
+      ).toBe(true);
+
+      const nextPage = once(client, 'message');
+      const before = {updatedAt: '2026-01-02T00:00:00.000Z', sessionId: 'middle'};
+      client.send(JSON.stringify({type: 'list_conversations', limit: 1, before}));
+      const [nextRaw] = await nextPage;
+      const nextFrame = JSON.parse(String(nextRaw)) as Frame;
+      expect(nextFrame.conversations?.map(({sessionId}) => sessionId)).toEqual(['older']);
+      expect(sessionStore.requestedUserIds).toEqual(['u1', 'u1']);
+      expect(sessionStore.requestedOptions).toEqual([
+        {limit: undefined, before: undefined},
+        {limit: 1, before},
+      ]);
+    } finally {
+      client.close();
+      await once(client, 'close');
+      await hal.stop();
+    }
+  });
+
+  // spec: specs/hal-engine-conversation-list/spec.md#38
+  it('reports that listing is unsupported while history is disabled', async () => {
+    const {hal, client, sessionStore} = await engine(false);
+
+    try {
+      const connected = once(client, 'message');
+      await once(client, 'open');
+      await connected;
+      const answer = once(client, 'message');
+      client.send(JSON.stringify({type: 'list_conversations'}));
+      const [raw] = await answer;
+      const frame = JSON.parse(String(raw)) as Frame;
+
+      expect(frame).toMatchObject({type: 'error', code: 'UNSUPPORTED'});
+      expect(frame.conversations).toBeUndefined();
+      expect(sessionStore.requestedUserIds).toEqual([]);
+    } finally {
+      client.close();
+      await once(client, 'close');
+      await hal.stop();
+    }
+  });
+});
+
+async function engine(history: boolean) {
+  const sessionStore = new RecordingSessionStore();
+  for (const [sessionId, userId, updatedAt] of [
+    ['older', 'u1', '2026-01-01T00:00:00.000Z'],
+    ['middle', 'u1', '2026-01-02T00:00:00.000Z'],
+    ['newest', 'u1', '2026-01-03T00:00:00.000Z'],
+    ['private', 'u2', '2026-01-04T00:00:00.000Z'],
+  ]) {
+    const session = sessionStore.create(sessionId, userId);
+    session.entries.push({role: 'user', content: 'hello', timestamp: updatedAt});
+  }
+
+  const options = {
+    app: (() => undefined) as unknown as Express,
+    wsAuth: async () => ({id: 'u1'}),
+    sessionStore,
+    orchestrator: createChatOrchestrator(
+      createMockProvider(),
+      new PromptBuilder({identity: 'Acceptance test assistant.'})
+    ),
+    ...(history ? {history: {enabled: true}} : {}),
+  };
+  const hal = createServer(options);
+  await hal.start(0);
+  const {port} = hal.server.address() as AddressInfo;
+  const client = new WebSocket(`ws://127.0.0.1:${port}/hal/ws`, [HAL_WS_SUBPROTOCOL, 'token']);
+  return {hal, client, sessionStore};
+}
+
+class RecordingSessionStore extends InMemorySessionStore {
+  readonly requestedUserIds: Array<string | number> = [];
+  readonly requestedOptions: Array<SessionListOptions | undefined> = [];
+
+  override listFor(userId: string | number, options?: SessionListOptions): SessionSummary[] {
+    this.requestedUserIds.push(userId);
+    this.requestedOptions.push(options);
+    return super.listFor(userId, options);
+  }
+}