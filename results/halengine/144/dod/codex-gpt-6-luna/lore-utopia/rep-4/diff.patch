@@ -0,0 +1,147 @@
+import {afterEach} from '@jest/globals';
+import type {RawData, WebSocket} from 'ws';
+import {InMemorySessionStore} from '../../infrastructure/stores/inMemorySessionStore.js';
+import type {SessionListOptions} from '../../types/sessionStore.js';
+import type {SessionSummary} from '../../types/sessionStore.js';
+import {validateMessage} from './validation.js';
+import {connectClient, startEngineWith, stopEngines} from '../wsTestSupport.js';
+
+afterEach(async () => {
+  await stopEngines();
+  await new Promise(resolve => setTimeout(resolve, 20));
+});
+
+class RecordingSessionStore extends InMemorySessionStore {
+  readonly listCalls: Array<{userId: string | number; options: SessionListOptions | undefined}> = [];
+
+  override listFor(userId: string | number, options?: SessionListOptions): SessionSummary[] {
+    this.listCalls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+async function openHistorySocket(store: InMemorySessionStore, history?: {enabled: boolean}) {
+  const {url} = await startEngineWith({
+    sessionStore: store,
+    wsAuth: async () => ({id: 'authenticated-user'}),
+    orchestrator: {
+      processMessage: async () => '',
+      async *processMessageStream() {},
+    },
+    ...(history === undefined ? {} : {history}),
+    heartbeatIntervalMs: 60_000,
+  });
+  const socket = connectClient(url);
+  const frames: Array<Record<string, unknown>> = [];
+  const connected = new Promise<void>(resolve => {
+    socket.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as Record<string, unknown>;
+      frames.push(frame);
+      if (frame.type === 'connected') resolve();
+    });
+  });
+  const opened = new Promise<void>((resolve, reject) => {
+    socket.once('open', resolve);
+    socket.once('error', reject);
+  });
+  await Promise.all([opened, connected]);
+  return {socket, frames};
+}
+
+function nextFrame(socket: WebSocket) {
+  return new Promise<Record<string, unknown>>(resolve => {
+    const onMessage = (raw: RawData) => {
+      const frame = JSON.parse(String(raw)) as Record<string, unknown>;
+      socket.off('message', onMessage);
+      resolve(frame);
+    };
+    socket.on('message', onMessage);
+  });
+}
+
+// @spec specs/hal-engine-websocket-protocol/spec.md#4.3
+describe('conversation list over the WebSocket protocol', () => {
+  // @spec specs/hal-engine-websocket-protocol/spec.md#5.9
+  it("returns the authenticated user's summaries as ISO timestamps when history is enabled", async () => {
+    const store = new RecordingSessionStore();
+    store.create('mine-1', 'authenticated-user');
+    store.create('mine-2', 'authenticated-user');
+    store.create('theirs', 'another-user');
+    const {socket, frames} = await openHistorySocket(store, {enabled: true});
+    const received = nextFrame(socket);
+    const before = {updatedAt: new Date(Date.now() + 86_400_000).toISOString(), sessionId: 'zz'};
+
+    socket.send(JSON.stringify({type: 'list_conversations', userId: 'another-user', limit: 3, before}));
+
+    const list = await received;
+    expect(list.type).toBe('conversation_list');
+    const conversations = list.conversations as Array<Record<string, unknown>>;
+    expect({
+      type: list.type,
+      count: conversations.length,
+      ids: conversations.map(row => row.sessionId).sort(),
+      foreignConversationIncluded: conversations.some(row => row.sessionId === 'theirs'),
+      listFrameCount: frames.filter(frame => frame.type === 'conversation_list').length,
+      onlySummaryFields: conversations.every(
+        row => Object.keys(row).sort().join(',') === 'createdAt,entryCount,sessionId,updatedAt'
+      ),
+      isoTimes: conversations.every(row =>
+        ['createdAt', 'updatedAt'].every(
+          field => typeof row[field] === 'string' && !Number.isNaN(Date.parse(row[field] as string))
+        )
+      ),
+      calledFor: store.listCalls.at(-1)?.userId,
+      options: store.listCalls.at(-1)?.options,
+      streamEnd: frames.some(frame => frame.type === 'stream_end'),
+    }).toEqual({
+      type: 'conversation_list',
+      count: 3,
+      ids: expect.arrayContaining(['mine-1', 'mine-2']),
+      foreignConversationIncluded: false,
+      listFrameCount: 1,
+      isoTimes: true,
+      onlySummaryFields: true,
+      calledFor: 'authenticated-user',
+      options: {limit: 3, before},
+      streamEnd: false,
+    });
+  });
+
+  it('validates list_conversations pagination fields at the protocol boundary', () => {
+    expect(validateMessage({type: 'list_conversations'})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations'},
+    });
+    const invalidFrames: Array<[unknown, string]> = [
+      [{type: 'list_conversations', limit: 0}, 'limit'],
+      [{type: 'list_conversations', limit: 201}, 'limit'],
+      [{type: 'list_conversations', limit: 1.5}, 'limit'],
+      [{type: 'list_conversations', limit: '10'}, 'limit'],
+      [{type: 'list_conversations', before: 'not a date'}, 'before'],
+    ];
+    for (const [frame, field] of invalidFrames) {
+      const result = validateMessage(frame);
+      expect(result).toMatchObject({valid: false});
+      if (!result.valid) expect(result.error).toContain(field);
+    }
+  });
+
+  it('answers with UNSUPPORTED and no list when history is disabled or the store cannot list', async () => {
+    const {socket, frames} = await openHistorySocket(new RecordingSessionStore());
+    const received = nextFrame(socket);
+
+    socket.send(JSON.stringify({type: 'list_conversations'}));
+
+    expect(await received).toMatchObject({type: 'error', code: 'UNSUPPORTED'});
+    expect(frames.some(frame => frame.type === 'conversation_list')).toBe(false);
+
+    const store = new InMemorySessionStore();
+    Object.defineProperty(store, 'listFor', {value: undefined});
+    const unavailable = await openHistorySocket(store, {enabled: true});
+    const unavailableResponse = nextFrame(unavailable.socket);
+    unavailable.socket.send(JSON.stringify({type: 'list_conversations'}));
+
+    expect(await unavailableResponse).toMatchObject({type: 'error', code: 'UNSUPPORTED'});
+    expect(unavailable.frames.some(frame => frame.type === 'conversation_list')).toBe(false);
+  });
+});