--- /dev/null
+++ b/src/transport/ws/conversationList.acceptance.test.ts
@@ -0,0 +1,229 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import type {Express} from 'express';
+import {WebSocket} from 'ws';
+import {createServer} from '../createServer.js';
+import {InMemorySessionStore} from '../../infrastructure/stores/inMemorySessionStore.js';
+import {deferred} from '../wsTestSupport.js';
+import {HAL_WS_SUBPROTOCOL} from './subprotocol.js';
+import {validateMessage} from './validation.js';
+
+describe('conversation list over the WebSocket protocol', () => {
+  it('serves the authenticated user’s conversation summaries over the WebSocket', async () => {
+    const store = new InMemorySessionStore();
+    const older = store.create('older', 'u1');
+    older.entries.push({role: 'user', content: 'private text', timestamp: '2026-01-01T00:00:01.000Z'});
+    const newer = store.create('newer', 'u1');
+    newer.entries.push({role: 'user', content: 'another private text', timestamp: '2026-01-02T00:00:01.000Z'});
+    store.create('other-user', 'u2');
+
+    const options: Parameters<typeof createServer>[0] & {history: {enabled: boolean}} = {
+      app: (() => undefined) as unknown as Express,
+      wsAuth: async () => ({id: 'u1'}),
+      sessionStore: store,
+      orchestrator: {
+        processMessage: async () => '',
+        async *processMessageStream() {},
+      },
+      history: {enabled: true},
+      resume: {enabled: true},
+    };
+    const hal = createServer(options);
+    await hal.start(0);
+    const {port} = hal.server.address() as AddressInfo;
+    const client = new WebSocket(`ws://127.0.0.1:${port}/hal/ws`, [HAL_WS_SUBPROTOCOL, 'token']);
+    let resumedClient: WebSocket | undefined;
+
+    try {
+      let connectedSessionId = '';
+      const received: Array<Record<string, unknown>> = [];
+      client.on('message', raw => {
+        const frame = JSON.parse(String(raw)) as Record<string, unknown>;
+        received.push(frame);
+        if (frame.type === 'connected') connectedSessionId = String(frame.sessionId);
+      });
+      const response = (): Promise<Record<string, unknown>> =>
+        new Promise((resolve, reject) => {
+          client.on('message', raw => {
+            const frame = JSON.parse(String(raw)) as Record<string, unknown>;
+            if (frame.type === 'conversation_list' || frame.type === 'error') resolve(frame);
+          });
+          client.once('error', reject);
+        });
+      await once(client, 'open');
+      const firstResponse = response();
+      client.send(JSON.stringify({type: 'list_conversations', limit: 2, userId: 'u2'}));
+      const frame = await firstResponse;
+
+      expect(frame).toMatchObject({type: 'conversation_list'});
+      expect(frame.conversations).toHaveLength(2);
+      const rows = frame.conversations as Array<Record<string, unknown>>;
+      expect(rows.map(row => row.sessionId)).toEqual([connectedSessionId, 'newer']);
+      expect(rows.map(row => row.entryCount)).toEqual([0, 1]);
+      for (const row of rows) {
+        expect(Object.keys(row).sort()).toEqual(['createdAt', 'entryCount', 'sessionId', 'updatedAt']);
+        for (const field of ['createdAt', 'updatedAt']) {
+          expect(typeof row[field]).toBe('string');
+          expect(new Date(row[field] as string).toISOString()).toBe(row[field]);
+        }
+      }
+      expect(JSON.stringify(frame)).not.toContain('private text');
+
+      const secondResponse = response();
+      client.send(
+        JSON.stringify({
+          type: 'list_conversations',
+          limit: 1,
+          before: {updatedAt: rows[1].updatedAt, sessionId: rows[1].sessionId},
+        })
+      );
+      const nextPage = await secondResponse;
+      expect(nextPage).toMatchObject({type: 'conversation_list', conversations: [{sessionId: 'older'}]});
+      expect(received.filter(receivedFrame => receivedFrame.type === 'conversation_list')).toHaveLength(2);
+      expect(received.some(receivedFrame => receivedFrame.type === 'stream_end')).toBe(false);
+
+      resumedClient = new WebSocket(`ws://127.0.0.1:${port}/hal/ws?sessionId=newer`, [HAL_WS_SUBPROTOCOL, 'token']);
+      const replayFrames: Array<Record<string, unknown>> = [];
+      const replay = new Promise<void>((resolve, reject) => {
+        resumedClient?.on('message', raw => {
+          const replayFrame = JSON.parse(String(raw)) as Record<string, unknown>;
+          replayFrames.push(replayFrame);
+          if (replayFrame.type === 'entry_upsert') resolve();
+        });
+        resumedClient?.once('error', reject);
+      });
+      await once(resumedClient, 'open');
+      await replay;
+      expect(replayFrames[0]).toMatchObject({type: 'connected', resumed: true});
+      expect(replayFrames[1]).toMatchObject({type: 'entry_upsert', index: 0, entry: {content: 'another private text'}});
+    } finally {
+      if (resumedClient) {
+        const resumedClosed = once(resumedClient, 'close');
+        resumedClient.terminate();
+        await resumedClosed;
+      }
+      const closed = once(client, 'close');
+      client.terminate();
+      await closed;
+      await hal.stop();
+    }
+  });
+
+  it('validates list paging fields before the handler reads them', () => {
+    expect(validateMessage({type: 'list_conversations'})).toMatchObject({valid: true});
+    expect(
+      validateMessage({
+        type: 'list_conversations',
+        limit: 1,
+        before: {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: 's1'},
+      })
+    ).toMatchObject({valid: true});
+
+    for (const limit of [0, 201, 1.5, '10']) {
+      expect(validateMessage({type: 'list_conversations', limit})).toMatchObject({
+        valid: false,
+        error: expect.stringContaining('limit'),
+      });
+    }
+    expect(
+      validateMessage({type: 'list_conversations', before: {updatedAt: 'not a date', sessionId: 's1'}})
+    ).toMatchObject({
+      valid: false,
+      error: expect.stringContaining('before'),
+    });
+  });
+
+  it('refuses a history request when the transport history option is off', async () => {
+    const options: Parameters<typeof createServer>[0] & {history: {enabled: boolean}} = {
+      app: (() => undefined) as unknown as Express,
+      wsAuth: async () => ({id: 'u1'}),
+      sessionStore: new InMemorySessionStore(),
+      orchestrator: {
+        processMessage: async () => '',
+        async *processMessageStream() {},
+      },
+      history: {enabled: false},
+    };
+    const hal = createServer(options);
+    await hal.start(0);
+    const {port} = hal.server.address() as AddressInfo;
+    const client = new WebSocket(`ws://127.0.0.1:${port}/hal/ws`, [HAL_WS_SUBPROTOCOL, 'token']);
+
+    try {
+      const response = new Promise<Record<string, unknown>>((resolve, reject) => {
+        client.on('message', raw => {
+          const frame = JSON.parse(String(raw)) as Record<string, unknown>;
+          if (frame.type === 'error' || frame.type === 'conversation_list') resolve(frame);
+        });
+        client.once('error', reject);
+      });
+      await once(client, 'open');
+      client.send(JSON.stringify({type: 'list_conversations'}));
+
+      expect(await response).toMatchObject({type: 'error', code: 'UNSUPPORTED'});
+    } finally {
+      const closed = once(client, 'close');
+      client.terminate();
+      await closed;
+      await hal.stop();
+    }
+  });
+
+  it('answers a history request before a streaming turn on the same session ends', async () => {
+    const turnStarted = deferred();
+    const releaseTurn = deferred();
+    const options: Parameters<typeof createServer>[0] & {history: {enabled: boolean}} = {
+      app: (() => undefined) as unknown as Express,
+      wsAuth: async () => ({id: 'u1'}),
+      sessionStore: new InMemorySessionStore(),
+      orchestrator: {
+        processMessage: async () => '',
+        async *processMessageStream() {
+          turnStarted.release();
+          await releaseTurn.until;
+          yield {type: 'text', text: 'answer'};
+          yield {type: 'stop', stopReason: 'end_turn'};
+        },
+      },
+      history: {enabled: true},
+    };
+    const hal = createServer(options);
+    await hal.start(0);
+    const {port} = hal.server.address() as AddressInfo;
+    const client = new WebSocket(`ws://127.0.0.1:${port}/hal/ws`, [HAL_WS_SUBPROTOCOL, 'token']);
+    const frames: Array<Record<string, unknown>> = [];
+    const listResponse = new Promise<Record<string, unknown>>((resolve, reject) => {
+      client.on('message', raw => {
+        const frame = JSON.parse(String(raw)) as Record<string, unknown>;
+        frames.push(frame);
+        if (frame.type === 'conversation_list' || frame.type === 'error') resolve(frame);
+      });
+      client.once('error', reject);
+    });
+    const streamEnd = new Promise<void>(resolve => {
+      client.on('message', raw => {
+        if ((JSON.parse(String(raw)) as Record<string, unknown>).type === 'stream_end') resolve();
+      });
+    });
+
+    try {
+      await once(client, 'open');
+      client.send(JSON.stringify({type: 'user_message', content: 'hello'}));
+      await turnStarted.until;
+      client.send(JSON.stringify({type: 'list_conversations'}));
+      expect(await listResponse).toMatchObject({type: 'conversation_list'});
+      expect(frames.some(frame => frame.type === 'stream_end')).toBe(false);
+      releaseTurn.release();
