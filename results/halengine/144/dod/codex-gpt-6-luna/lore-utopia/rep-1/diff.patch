-### 5.8 stream_end
+### 5.8 conversation_list
+
+The server sends this frame only in response to an enabled `list_conversations` request. Its summaries are newest first and carry ISO string times; the list contains the authenticated user's metadata, never entries or credentials ([validated by: answers with the authenticated user's summaries, in wire-safe newest-first pages](../../src/transport/conversationList.acceptance.test.ts#L48)).
+
+| Field           | Type                   | Description                                       |
+| --------------- | ---------------------- | ------------------------------------------------- |
+| `type`          | string                 | `"conversation_list"`                             |
+| `conversations` | `ConversationSummary[]` | Conversation metadata with ISO string timestamps |
+
+### 5.9 stream_end
 
 Signals that the server has finished processing a user message. Sent exactly once for every `user_message` the server receives, after all `entry_commit` messages have been sent, whether the run succeeded or failed.
 
diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..c22edcb
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,156 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import type {Express} from 'express';
+import {WebSocket} from 'ws';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {ChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import {createServer} from './createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+import {setLogger} from '../shared/logger.js';
+
+beforeAll(() => {
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined});
+});
+
+interface Frame {
+  type: string;
+  code?: string;
+  conversations?: Array<{sessionId: string; createdAt: string; updatedAt: string; entryCount: number}>;
+}
+
+describe('conversation list over the WebSocket protocol', () => {
+  it('accepts valid list requests and names invalid paging fields', () => {
+    const validFrame = {
+      type: 'list_conversations',
+      limit: 10,
+      before: {updatedAt: '2026-10-01T12:00:00.000Z', sessionId: 's1'},
+    };
+    expect(validateMessage(validFrame)).toEqual({
+      valid: true,
+      data: validFrame,
+    });
+
+    for (const payload of [
+      {type: 'list_conversations', limit: 0},
+      {type: 'list_conversations', limit: 201},
+      {type: 'list_conversations', limit: 1.5},
+      {type: 'list_conversations', limit: '10'},
+      {type: 'list_conversations', before: {updatedAt: 'not a date', sessionId: 's1'}},
+      {type: 'list_conversations', before: {updatedAt: new Date().toISOString()}},
+    ]) {
+      const result = validateMessage(payload);
+      expect(result.valid).toBe(false);
+      if (!result.valid) expect(result.error).toMatch(/limit|before/i);
+    }
+  });
+
+  it("answers with the authenticated user's summaries, in wire-safe newest-first pages", async () => {
+    const store = new InMemorySessionStore();
+    store.create('own-older', 'u1');
+    await new Promise(resolve => setTimeout(resolve, 2));
+    store.create('own-newer', 'u1');
+    store.create('other-user', 'u2');
+
+    const calls: Array<{
+      userId: string | number;
+      options?: {limit?: number; before?: {updatedAt: string; sessionId: string}};
+    }> = [];
+    const listFor = store.listFor.bind(store);
+    store.listFor = (userId, options) => {
+      calls.push({userId, options: options as (typeof calls)[number]['options']});
+      return listFor(userId, options);
+    };
+
+    const hal = createServer({
+      app: (() => undefined) as unknown as Express,
+      wsAuth: async () => ({id: 'u1'}),
+      sessionStore: store,
+      orchestrator: {} as ChatOrchestrator,
+      history: {enabled: true},
+    } as unknown as Parameters<typeof createServer>[0]);
+    await hal.start(0);
+    const {port} = hal.server.address() as AddressInfo;
+    const socket = new WebSocket(`ws://127.0.0.1:${port}/hal/ws`, [HAL_WS_SUBPROTOCOL, 'token']);
+    const frames: Frame[] = [];
+    socket.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as Frame;
+      frames.push(frame);
+      if (frame.type === 'connected') {
+        socket.send(JSON.stringify({type: 'list_conversations', userId: 'u2', limit: 1}));
+      }
+    });
+
+    try {
+      await once(socket, 'open');
+      await new Promise<void>((resolve, reject) => {
+        const timer = setTimeout(() => reject(new Error('conversation list response timed out')), 1000);
+        const check = () => {
+          if (frames.some(frame => frame.type === 'conversation_list' || frame.type === 'error')) {
+            clearTimeout(timer);
+            resolve();
+          }
+        };
+        socket.on('message', check);
+      });
+
+      expect(frames.filter(frame => frame.type !== 'connected')).toEqual([
+        {
+          type: 'conversation_list',
+          conversations: [expect.objectContaining({sessionId: 'own-newer'})],
+        },
+      ]);
+      const row = frames.find(frame => frame.type === 'conversation_list')?.conversations?.[0];
+      expect(row).toMatchObject({sessionId: 'own-newer', entryCount: 0});
+      expect(row?.createdAt).toMatch(/^\d{4}-\d\d-\d\dT.*Z$/);
+      expect(row?.updatedAt).toMatch(/^\d{4}-\d\d-\d\dT.*Z$/);
+      expect(calls).toEqual([{userId: 'u1', options: {limit: 1, before: undefined}}]);
+    } finally {
+      const closed = once(socket, 'close');
+      socket.terminate();
+      await closed;
+      await hal.stop();
+    }
+  });
+
+  it('refuses a list request with UNSUPPORTED when history is not enabled', async () => {
+    const store = new InMemorySessionStore();
+    const hal = createServer({
+      app: (() => undefined) as unknown as Express,
+      wsAuth: async () => ({id: 'u1'}),
+      sessionStore: store,
+      orchestrator: {} as ChatOrchestrator,
+    });
+
+    await hal.start(0);
+    const {port} = hal.server.address() as AddressInfo;
+    const socket = new WebSocket(`ws://127.0.0.1:${port}/hal/ws`, [HAL_WS_SUBPROTOCOL, 'token']);
+    const frames: Frame[] = [];
+    socket.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as Frame;
+      frames.push(frame);
+      if (frame.type === 'connected') socket.send(JSON.stringify({type: 'list_conversations'}));
+    });
+
+    try {
+      await once(socket, 'open');
+      await new Promise<void>((resolve, reject) => {
+        const timer = setTimeout(() => reject(new Error('disabled history response timed out')), 1000);
+        socket.on('message', () => {
+          if (frames.some(frame => frame.type === 'error')) {
+            clearTimeout(timer);
+            resolve();
+          }
+        });
+      });
+      expect(frames.filter(frame => frame.type !== 'connected')).toEqual([
+        expect.objectContaining({type: 'error', code: 'UNSUPPORTED'}),
+      ]);
+    } finally {
+      const closed = once(socket, 'close');
+      socket.terminate();
+      await closed;
+      await hal.stop();
+    }
+  });
+});