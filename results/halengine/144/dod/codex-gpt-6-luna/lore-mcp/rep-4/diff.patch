+import {jest} from '@jest/globals';
+import {WebSocket} from 'ws';
+import {createMessageHandler} from './messageHandler.js';
+import type {ChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import type {ChatSession} from '../../types/session.js';
+import type {SessionStore} from '../../types/sessionStore.js';
+import type {OutgoingMessage} from '../../types/messages.js';
+
+describe('conversation list over the WebSocket protocol', () => {
+  it('answers the authenticated user with their own summaries on the wire', async () => {
+    const sent: OutgoingMessage[] = [];
+    const ws = {
+      userId: 'owner',
+      send: (raw: string) => sent.push(JSON.parse(raw) as OutgoingMessage),
+    } as unknown as WebSocket;
+    const summaries = [
+      {
+        sessionId: 'newest',
+        createdAt: new Date('2026-01-02T00:00:00.000Z'),
+        updatedAt: new Date('2026-01-03T00:00:00.000Z'),
+        entryCount: 2,
+      },
+    ];
+    const listFor = jest.fn(async () => summaries);
+    const store = {listFor} as unknown as SessionStore;
+    const session: ChatSession = {sessionId: 'active', userId: 'owner', entries: []};
+    const handle = createMessageHandler({} as ChatOrchestrator, store, {history: {enabled: true}});
+
+    await handle(ws, session, {type: 'list_conversations', userId: 'someone-else'});
+
+    expect({frames: sent, userIds: listFor.mock.calls.map(([userId]) => userId)}).toEqual({
+      frames: [
+        {
+          type: 'conversation_list',
+          conversations: [
+            {
+              sessionId: 'newest',
+              createdAt: '2026-01-02T00:00:00.000Z',
+              updatedAt: '2026-01-03T00:00:00.000Z',
+              entryCount: 2,
+            },
+          ],
+        },
+      ],
+      userIds: ['owner'],
+    });
+  });
+});