+import {jest} from '@jest/globals';
+import {WebSocket} from 'ws';
+import {InMemorySessionStore} from '../../infrastructure/stores/inMemorySessionStore.js';
+import type {ChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import {createMessageHandler} from './messageHandler.js';
+import type {OutgoingMessage} from '../../types/messages.js';
+
+describe('conversation list over WebSocket', () => {
+  it('answers an authenticated user with their own summaries and no conversation content', async () => {
+    const store = new InMemorySessionStore();
+    const own = store.create('own-session', 'alice');
+    own.entries.push({role: 'user', content: 'private conversation text', timestamp: new Date()});
+    store.create('other-session', 'bob');
+    const sent: OutgoingMessage[] = [];
+    const ws = {
+      userId: 'alice',
+      readyState: WebSocket.OPEN,
+      send: (raw: string) => sent.push(JSON.parse(raw) as OutgoingMessage),
+    } as unknown as WebSocket;
+    const handler = createMessageHandler({} as ChatOrchestrator, store, {enabled: true});
+
+    await handler(ws, own, {type: 'list_conversations', userId: 'bob'});
+
+    expect(sent).toHaveLength(1);
+    expect(sent[0]).toMatchObject({
+      type: 'conversation_list',
+      conversations: [{sessionId: 'own-session', entryCount: 1}],
+    });
+    if (sent[0]?.type === 'conversation_list') {
+      expect(typeof sent[0].conversations[0]?.createdAt).toBe('string');
+      expect(typeof sent[0].conversations[0]?.updatedAt).toBe('string');
+      expect(JSON.stringify(sent[0])).not.toContain('private conversation text');
+    }
+  });
+});