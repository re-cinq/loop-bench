diff --git a/src/transport/ws/conversationList.acceptance.test.ts b/src/transport/ws/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..aeeb669
--- /dev/null
+++ b/src/transport/ws/conversationList.acceptance.test.ts
@@ -0,0 +1,174 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import type {Express} from 'express';
+import {createServer} from '../createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './subprotocol.js';
+import {InMemorySessionStore} from '../../infrastructure/stores/inMemorySessionStore.js';
+import {answeringOrchestrator} from '../wsTestSupport.js';
+import {validateMessage} from './validation.js';
+
+interface Frame {
+  type: string;
+  [key: string]: unknown;
+}
+
+const servers: Array<ReturnType<typeof createServer>> = [];
+const clients: WebSocket[] = [];
+
+afterEach(async () => {
+  for (const client of clients.splice(0)) {
+    const closed = once(client, 'close');
+    client.terminate();
+    await closed;
+  }
+  for (const server of servers.splice(0)) {
+    for (let attempt = 0; attempt < 50 && server.wss.clients.size > 0; attempt++) {
+      await new Promise(resolve => setTimeout(resolve, 10));
+    }
+    await server.stop();
+  }
+});
+
+const connect = async (store: InMemorySessionStore, history?: {enabled: boolean}) => {
+  const server = createServer({
+    app: (() => undefined) as unknown as Express,
+    wsAuth: async () => ({id: 'u1'}),
+    sessionStore: store,
+    orchestrator: answeringOrchestrator,
+    history,
+  } as Parameters<typeof createServer>[0]);
+  await server.start(0);
+  servers.push(server);
+  const {port} = server.server.address() as AddressInfo;
+  const client = new WebSocket(`ws://127.0.0.1:${port}/hal/ws`, [HAL_WS_SUBPROTOCOL, 'token']);
+  clients.push(client);
+  await once(client, 'open');
+  return client;
+};
+
+const receiveThrough = (client: WebSocket, terminalTypes: string[]): Promise<Frame[]> => {
+  const frames: Frame[] = [];
+  return new Promise(resolve => {
+    client.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as Frame;
+      frames.push(frame);
+      if (terminalTypes.includes(frame.type)) resolve(frames);
+    });
+  });
+};
+
+describe('conversation list WebSocket acceptance', () => {
+  it('accepts bounded limits and an ISO cursor, and names invalid fields', () => {
+    const accepted = validateMessage({
+      type: 'list_conversations',
+      limit: 10,
+      before: {updatedAt: '2026-10-27T00:00:00.000Z', sessionId: 'last-seen'},
+    });
+    const invalid = [
+      {limit: 0, field: 'limit'},
+      {limit: 201, field: 'limit'},
+      {limit: 1.5, field: 'limit'},
+      {limit: '10', field: 'limit'},
+      {before: {updatedAt: 'not a date', sessionId: 'last-seen'}, field: 'before'},
+    ].map(({field, ...rest}) => {
+      const result = validateMessage({type: 'list_conversations', ...rest});
+      return {field, result};
+    });
+
+    expect({
+      accepted: accepted.valid,
+      invalid: invalid.map(({field, result}) => !result.valid && result.error.includes(field)),
+    }).toEqual({accepted: true, invalid: [true, true, true, true, true]});
+  });
+
+  it("answers with the authenticated user's newest summaries as ISO wire values", async () => {
+    const store = new InMemorySessionStore();
+    store.create('older', 'u1');
+    store.create('newer', 'u1');
+    store.create('private-to-u2', 'u2');
+    const client = await connect(store, {enabled: true});
+    const received = receiveThrough(client, ['conversation_list', 'error']);
+
+    client.send(JSON.stringify({type: 'list_conversations', userId: 'u2'}));
+
+    const frames = await received;
+    const list = frames.find(frame => frame.type === 'conversation_list') as
+      {conversations: Array<{sessionId: string; createdAt: unknown; updatedAt: unknown}>} | undefined;
+    expect({
+      types: frames.map(frame => frame.type),
+      sessions: list?.conversations.map(row => row.sessionId),
+      wireTimes: list?.conversations.every(
+        row =>
+          typeof row.createdAt === 'string' &&
+          new Date(row.createdAt).toISOString() === row.createdAt &&
+          typeof row.updatedAt === 'string' &&
+          new Date(row.updatedAt).toISOString() === row.updatedAt
+      ),
+    }).toEqual({
+      types: ['conversation_list'],
+      sessions: store.listFor('u1').map(row => row.sessionId),
+      wireTimes: true,
+    });
+  });
+
+  it('uses the limit and composite before cursor to page through the store order', async () => {
+    const store = new InMemorySessionStore();
+    const older = store.create('older', 'u1');
+    older.entries.push({role: 'user', content: 'old', timestamp: new Date(Date.now() + 30_000).toISOString()});
+    const newer = store.create('newer', 'u1');
+    newer.entries.push({role: 'user', content: 'new', timestamp: new Date(Date.now() + 60_000).toISOString()});
+    const client = await connect(store, {enabled: true});
+    const firstPage = receiveThrough(client, ['conversation_list', 'error']);
+
+    client.send(JSON.stringify({type: 'list_conversations', limit: 1}));
+
+    const first = (await firstPage).find(frame => frame.type === 'conversation_list') as
+      {conversations: Array<{sessionId: string; updatedAt: string}>} | undefined;
+    const nextPage = receiveThrough(client, ['conversation_list', 'error']);
+    client.send(
+      JSON.stringify({
+        type: 'list_conversations',
+        limit: 1,
+        before: {updatedAt: first?.conversations[0]?.updatedAt, sessionId: first?.conversations[0]?.sessionId},
+      })
+    );
+
+    const second = (await nextPage).find(frame => frame.type === 'conversation_list') as
+      {conversations: Array<{sessionId: string}>} | undefined;
+    expect({
+      first: first?.conversations.map(row => row.sessionId),
+      second: second?.conversations.map(row => row.sessionId),
+    }).toEqual({
+      first: ['newer'],
+      second: ['older'],
+    });
+  });
+
+  it('refuses a list when history is not enabled', async () => {
+    const client = await connect(new InMemorySessionStore());
+    const received = receiveThrough(client, ['error']);
+
+    client.send(JSON.stringify({type: 'list_conversations'}));
+
+    const frames = await received;
+    expect(frames.filter(({type}) => type === 'error').map(({type, code}) => ({type, code}))).toEqual([
+      {type: 'error', code: 'UNSUPPORTED'},
+    ]);
+  });
+
+  it('reports an unsupported error when the store cannot list', async () => {
+    const store = new InMemorySessionStore();
+    const storeWithoutList = Object.create(store) as InMemorySessionStore;
+    Object.defineProperty(storeWithoutList, 'listFor', {value: undefined});
+    const client = await connect(storeWithoutList, {enabled: true});
+    const received = receiveThrough(client, ['error']);
+
+    client.send(JSON.stringify({type: 'list_conversations'}));
+
+    const frames = await received;
+    expect(frames.filter(({type}) => type === 'error').map(({type, code}) => ({type, code}))).toEqual([
+      {type: 'error', code: 'UNSUPPORTED'},
+    ]);
+  });
+});