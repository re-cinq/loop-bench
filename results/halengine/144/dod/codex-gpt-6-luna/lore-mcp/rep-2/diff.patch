+import {WebSocket} from 'ws';
+import {createMessageHandler} from './messageHandler.js';
+import type {ChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import type {SessionSummary} from '../../types/session.js';
+import type {OutgoingMessage} from '../../types/messages.js';
+
+it('answers an authenticated socket with its own conversation summaries over the wire', async () => {
+  const rows: SessionSummary[] = [
+    {
+      sessionId: 'mine',
+      createdAt: new Date('2026-01-01T00:00:00.000Z'),
+      updatedAt: new Date('2026-01-02T00:00:00.000Z'),
+      entryCount: 3,
+    },
+  ];
+  const calls: unknown[][] = [];
+  const sessionStore = {
+    listFor: async (...args: unknown[]) => {
+      calls.push(args);
+      return rows;
+    },
+  };
+  const sent: OutgoingMessage[] = [];
+  const ws = {
+    userId: 'connected-user',
+    readyState: WebSocket.OPEN,
+    send: (frame: string) => sent.push(JSON.parse(frame) as OutgoingMessage),
+  } as unknown as WebSocket;
+  const session = {sessionId: 'active-session', userId: 'connected-user', entries: []};
+  const handle = Reflect.apply(createMessageHandler, undefined, [
+    {} as ChatOrchestrator,
+    sessionStore,
+    {enabled: true},
+  ]) as (socket: WebSocket, session: typeof session, frame: unknown) => Promise<void>;
+
+  await handle(ws, session, {type: 'list_conversations', userId: 'other-user'});
+
+  expect(calls[0]?.[0]).toBe('connected-user');
+  expect(sent).toEqual([
+    {
+      type: 'conversation_list',
+      conversations: [
+        {
+          sessionId: 'mine',
+          createdAt: '2026-01-01T00:00:00.000Z',
+          updatedAt: '2026-01-02T00:00:00.000Z',
+          entryCount: 3,
+        },
+      ],
+    },
+  ]);
+});