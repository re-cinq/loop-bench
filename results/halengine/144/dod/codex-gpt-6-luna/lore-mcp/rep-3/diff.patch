+import {WebSocket} from 'ws';
+import {InMemorySessionStore} from '../../infrastructure/stores/inMemorySessionStore.js';
+import type {OutgoingMessage} from '../../types/messages.js';
+import type {ChatSession} from '../../types/session.js';
+import {createMessageHandler} from './messageHandler.js';
+
+describe('conversation list over the websocket protocol', () => {
+  it('answers an authenticated user with their own ISO summary rows when they ask', async () => {
+    const store = new InMemorySessionStore();
+    const older = store.create('older', 'alice');
+    older.entries.push({role: 'user', content: 'private text', timestamp: '2026-01-01T00:00:00.000Z'});
+    store.create('newer', 'alice');
+    store.create('belongs-to-bob', 'bob');
+
+    const sent: OutgoingMessage[] = [];
+    const ws = {
+      userId: 'alice',
+      send: (raw: string) => sent.push(JSON.parse(raw) as OutgoingMessage),
+    } as unknown as WebSocket & {userId: string};
+    const session: ChatSession = {sessionId: 'connected-session', userId: 'alice', entries: []};
+    const createHandler = createMessageHandler as unknown as (
+      orchestrator: unknown,
+      sessionStore: InMemorySessionStore,
+      options: {history: {enabled: boolean}}
+    ) => (ws: WebSocket, session: ChatSession, raw: unknown, signal?: AbortSignal) => Promise<void>;
+    const handler = createHandler({processMessageStream: async function* () {}} as never, store, {
+      history: {enabled: true},
+    });
+
+    await handler(ws, session, {type: 'list_conversations', userId: 'bob'});
+
+    const lists = sent.filter(frame => frame.type === 'conversation_list');
+    expect(lists).toHaveLength(1);
+    expect(lists[0]).toEqual({
+      type: 'conversation_list',
+      conversations: expect.arrayContaining([
+        expect.objectContaining({sessionId: 'older', entryCount: 1}),
+        expect.objectContaining({sessionId: 'newer', entryCount: 0}),
+      ]),
+    });
+    if (lists[0]?.type === 'conversation_list') {
+      expect(lists[0].conversations.map(row => row.sessionId)).toEqual(['newer', 'older']);
+      for (const row of lists[0].conversations) {
+        expect(row.createdAt).toEqual(expect.stringMatching(/^\d{4}-\d\d-\d\dT.*Z$/));
+        expect(row.updatedAt).toEqual(expect.stringMatching(/^\d{4}-\d\d-\d\dT.*Z$/));
+        expect(Object.keys(row).sort()).toEqual(['createdAt', 'entryCount', 'sessionId', 'updatedAt']);
+      }
+    }
+    expect(sent.some(frame => frame.type === 'stream_end')).toBe(false);
+    expect(sent.some(frame => frame.type === 'entry_upsert' && JSON.stringify(frame).includes('private text'))).toBe(
+      false
+    );
+  });
+});