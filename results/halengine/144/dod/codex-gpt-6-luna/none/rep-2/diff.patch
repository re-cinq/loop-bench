diff --git a/src/transport/ws/conversationList.acceptance.test.ts b/src/transport/ws/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..a028713
--- /dev/null
+++ b/src/transport/ws/conversationList.acceptance.test.ts
@@ -0,0 +1,140 @@
+import {validateMessage} from './validation.js';
+import {createMessageHandler} from './messageHandler.js';
+import {InMemorySessionStore} from '../../infrastructure/stores/inMemorySessionStore.js';
+import type {ChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import type {ChatSession} from '../../types/session.js';
+import type {OutgoingMessage} from '../../types/messages.js';
+import type {SessionStore} from '../../types/sessionStore.js';
+import {WebSocket, WebSocketServer} from 'ws';
+import type {ExtWebSocket} from './connectionHandler.js';
+
+// Spec anchors: specs/hal-engine-websocket-protocol#4.3 and #5.8.
+const orchestrator = {} as ChatOrchestrator;
+
+const request = (
+  store: SessionStore,
+  history: {enabled: boolean} | undefined,
+  userId = 'u1',
+  frame: unknown = {type: 'list_conversations'}
+): Promise<OutgoingMessage[]> =>
+  new Promise((resolve, reject) => {
+    const wss = new WebSocketServer({port: 0});
+    const server = wss;
+    let client: WebSocket;
+    const cleanup = () => {
+      client?.close();
+      void new Promise<void>(done => wss.close(() => done()));
+    };
+    wss.on('listening', () => {
+      const address = wss.address();
+      if (typeof address === 'string' || address === null) {
+        reject(new Error('WebSocket test server did not bind to a TCP port'));
+        cleanup();
+        return;
+      }
+      client = new WebSocket(`ws://127.0.0.1:${address.port}`);
+      client.once('open', () => client.send(JSON.stringify(frame)));
+      client.once('message', raw => {
+        const frames = [JSON.parse(raw.toString()) as OutgoingMessage];
+        cleanup();
+        resolve(frames);
+      });
+      client.once('error', error => {
+        cleanup();
+        reject(error);
+      });
+    });
+    server.on('connection', socket => {
+      const authenticatedSocket = socket as ExtWebSocket;
+      authenticatedSocket.userId = userId;
+      const session: ChatSession = {sessionId: 'socket-session', userId, entries: []};
+      const create = createMessageHandler as unknown as (
+        orchestrator: ChatOrchestrator,
+        store: SessionStore,
+        options?: {history?: {enabled: boolean}}
+      ) => (ws: ExtWebSocket, session: ChatSession, frame: unknown) => Promise<void>;
+      void create(orchestrator, store, {history})(authenticatedSocket, session, frame);
+    });
+  });
+
+describe('WebSocket conversation list acceptance', () => {
+  it('accepts a paged list frame and delivers only the authenticated user’s newest ISO summaries', async () => {
+    const store = new InMemorySessionStore();
+    await store.create('older', 'u1');
+    await store.create('newer', 'u1');
+    await store.create('private', 'u2');
+    const rows = await store.listFor('u1');
+    const cursor = rows[0];
+    const calls: unknown[] = [];
+    const listFor = store.listFor.bind(store);
+    store.listFor = async (userId, options) => {
+      calls.push({userId, options});
+      return listFor(userId, options);
+    };
+    const before = {updatedAt: cursor.updatedAt.toISOString(), sessionId: cursor.sessionId};
+    const result = validateMessage({type: 'list_conversations', limit: 1, before});
+    const sent = await request(store, {enabled: true}, 'u1', {
+      type: 'list_conversations',
+      limit: 1,
+      before,
+      userId: 'u2',
+    });
+
+    expect(result).toEqual({
+      valid: true,
+      data: {
+        type: 'list_conversations',
+        limit: 1,
+        before,
+      },
+    });
+    expect(calls).toEqual([
+      {
+        userId: 'u1',
+        options: {limit: 1, before},
+      },
+    ]);
+    expect(sent).toEqual([
+      {
+        type: 'conversation_list',
+        conversations: [
+          {
+            sessionId: rows[1].sessionId,
+            createdAt: rows[1].createdAt.toISOString(),
+            updatedAt: rows[1].updatedAt.toISOString(),
+            entryCount: rows[1].entryCount,
+          },
+        ],
+      },
+    ]);
+  });
+
+  it('rejects invalid paging fields by name while accepting the frame without options', () => {
+    expect(validateMessage({type: 'list_conversations'})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations'},
+    });
+    for (const [frame, field] of [
+      [{type: 'list_conversations', limit: 0}, 'limit'],
+      [{type: 'list_conversations', limit: 201}, 'limit'],
+      [{type: 'list_conversations', limit: 1.5}, 'limit'],
+      [{type: 'list_conversations', limit: '10'}, 'limit'],
+      [{type: 'list_conversations', before: 'not a date'}, 'before'],
+    ] as const) {
+      const result = validateMessage(frame);
+      expect(result.valid).toBe(false);
+      if (!result.valid) expect(result.error).toContain(field);
+    }
+  });
+
+  it('returns UNSUPPORTED when history is disabled or the store cannot list', async () => {
+    const store = new InMemorySessionStore();
+    const [disabled, unsupportedStore] = await Promise.all([
+      request(store, undefined),
+      request({} as SessionStore, {enabled: true}),
+    ]);
+
+    expect(disabled).toEqual([{type: 'error', code: 'UNSUPPORTED', message: expect.any(String)}]);
+    expect(unsupportedStore).toEqual([{type: 'error', code: 'UNSUPPORTED', message: expect.any(String)}]);
+  });
+});