@@ -0,0 +1,89 @@
+import {WebSocket} from 'ws';
+import {InMemorySessionStore} from '../../infrastructure/stores/inMemorySessionStore.js';
+import type {ChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import type {ChatSession} from '../../types/session.js';
+import type {OutgoingMessage} from '../../types/messages.js';
+import {createMessageHandler} from './messageHandler.js';
+import {validateMessage} from './validation.js';
+
+const handler = createMessageHandler as unknown as (
+  orchestrator: ChatOrchestrator,
+  store: InMemorySessionStore,
+  options: {history?: {enabled: boolean}}
+) => (ws: WebSocket, session: ChatSession, raw: unknown) => Promise<void>;
+
+const setup = () => {
+  const store = new InMemorySessionStore();
+  const oldest = store.create('mine-oldest', 'u1');
+  oldest.entries.push({role: 'user', content: 'old', timestamp: '2026-01-01T00:00:00.000Z'});
+  store.create('mine-middle', 'u1').entries.push({
+    role: 'user',
+    content: 'middle',
+    timestamp: '2026-01-02T00:00:00.000Z',
+  });
+  store.create('mine-newest', 'u1').entries.push({
+    role: 'user',
+    content: 'newest',
+    timestamp: '2026-01-03T00:00:00.000Z',
+  });
+  store.create('theirs', 'u2');
+  const session: ChatSession = {sessionId: 'connected-session', userId: 'u1', entries: []};
+  const sent: OutgoingMessage[] = [];
+  const ws = {
+    userId: 'u1',
+    send: (raw: string) => sent.push(JSON.parse(raw) as OutgoingMessage),
+  } as unknown as WebSocket;
+  const orchestrator = {} as ChatOrchestrator;
+  return {store, session, sent, ws, orchestrator};
+};
+
+describe('conversation list WebSocket acceptance', () => {
+  it('validates the list frame and its bounded paging fields', () => {
+    expect(validateMessage({type: 'list_conversations'})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations'},
+    });
+    for (const frame of [
+      {type: 'list_conversations', limit: 0},
+      {type: 'list_conversations', limit: 201},
+      {type: 'list_conversations', limit: 1.5},
+      {type: 'list_conversations', limit: '10'},
+      {type: 'list_conversations', before: 'not a date'},
+    ]) {
+      const result = validateMessage(frame);
+      expect(result.valid).toBe(false);
+      if (!result.valid) expect(result.error).toMatch(/limit|before/);
+    }
+  });
+
+  it('answers an enabled request with only the authenticated user’s ISO summaries and no turn frame', async () => {
+    const {store, session, sent, ws, orchestrator} = setup();
+
+    await handler(orchestrator, store, {history: {enabled: true}})(ws, session, {
+      type: 'list_conversations',
+      userId: 'u2',
+    });
+
+    expect(sent).toHaveLength(1);
+    expect(sent[0]?.type).toBe('conversation_list');
+    if (sent[0]?.type === 'conversation_list') {
+      expect(sent[0].conversations.map(row => row.sessionId)).toEqual(['mine-newest', 'mine-middle', 'mine-oldest']);
+      expect(Object.keys(sent[0].conversations[0] ?? {}).sort()).toEqual([
+        'createdAt',
+        'entryCount',
+        'sessionId',
+        'updatedAt',
+      ]);
+      expect(sent[0].conversations[0]?.createdAt).toEqual(expect.stringMatching(/^\d{4}-\d\d-\d\dT/));
+      expect(sent[0].conversations[0]?.updatedAt).toEqual(expect.stringMatching(/^\d{4}-\d\d-\d\dT/));
+    }
+  });
+
+  it('answers disabled history with UNSUPPORTED and no list', async () => {
+    const disabled = setup();
+    await handler(disabled.orchestrator, disabled.store, {})(disabled.ws, disabled.session, {
+      type: 'list_conversations',
+    });
+    expect(disabled.sent).toEqual([expect.objectContaining({type: 'error', code: 'UNSUPPORTED'})]);
+  });
+});