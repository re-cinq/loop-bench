+import {afterAll, describe, expect, it} from '@jest/globals';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {connectClient, startEngineWith, stopEngines} from './wsTestSupport.js';
+
+afterAll(async () => stopEngines());
+
+describe('conversation list over the WebSocket protocol', () => {
+  it('answers an authenticated client with only its own conversation summaries', async () => {
+    const store = new InMemorySessionStore();
+    store.create('own-conversation', 'u1');
+    store.create('other-conversation', 'u2');
+    const {url} = await startEngineWith({
+      sessionStore: store,
+      history: {enabled: true},
+    } as never);
+    const client = connectClient(url);
+    const response = new Promise<Record<string, unknown>>((resolve, reject) => {
+      client.once('open', () => client.send(JSON.stringify({type: 'list_conversations', userId: 'u2'})));
+      client.once('message', raw => {
+        const frame = JSON.parse(String(raw)) as Record<string, unknown>;
+        if (frame.type === 'connected') {
+          client.once('message', next => resolve(JSON.parse(String(next)) as Record<string, unknown>));
+        } else {
+          reject(new Error(`Expected connected before response, got ${String(frame.type)}`));
+        }
+      });
+    });
+
+    try {
+      const frame = await response;
+
+      expect(frame.type).toBe('conversation_list');
+      const conversations = frame.conversations as Array<Record<string, unknown>>;
+      expect(conversations).toEqual(
+        expect.arrayContaining([
+          expect.objectContaining({
+            sessionId: 'own-conversation',
+            createdAt: expect.stringMatching(/^\d{4}-\d\d-\d\dT/),
+            updatedAt: expect.stringMatching(/^\d{4}-\d\d-\d\dT/),
+            entryCount: 0,
+          }),
+        ])
+      );
+      expect(conversations.map(row => row.sessionId)).not.toContain('other-conversation');
+      expect(conversations.every(row => typeof row.createdAt === 'string' && typeof row.updatedAt === 'string')).toBe(
+        true
+      );
+    } finally {
+      const closed = new Promise<void>(resolve => client.once('close', () => resolve()));
+      client.close();
+      await closed;
+      await new Promise<void>(resolve => setTimeout(resolve, 0));
+    }
+  });
+});