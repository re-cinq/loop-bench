+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import type {Express} from 'express';
+import {WebSocket} from 'ws';
+import {InMemorySessionStore} from '../../infrastructure/stores/inMemorySessionStore.js';
+import type {ChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import {createServer} from '../createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './subprotocol.js';
+
+describe('the authenticated conversation list WebSocket frame', () => {
+  it('delivers only the connected user’s summaries with ISO dates when history is enabled', async () => {
+    const store = new InMemorySessionStore();
+    store.create('00000000-0000-4000-8000-000000000001', 'u1');
+    store.create('00000000-0000-4000-8000-000000000002', 'u2');
+    const server = createServer({
+      app: (() => undefined) as unknown as Express,
+      wsAuth: async () => ({id: 'u1'}),
+      sessionStore: store,
+      orchestrator: {} as ChatOrchestrator,
+      ...({history: {enabled: true}} as object),
+    });
+    const client = new WebSocket(
+      `ws://127.0.0.1:${
+        (
+          await (async () => {
+            await server.start(0);
+            return server.server.address() as AddressInfo;
+          })()
+        ).port
+      }/hal/ws`,
+      [HAL_WS_SUBPROTOCOL, 'token']
+    );
+    const frames: Array<Record<string, unknown>> = [];
+    const result = new Promise<Record<string, unknown>>((resolve, reject) => {
+      client.on('message', raw => {
+        const frame = JSON.parse(String(raw)) as Record<string, unknown>;
+        frames.push(frame);
+        if (frame.type === 'connected') {
+          client.send(JSON.stringify({type: 'list_conversations', userId: 'u2'}));
+        }
+        if (frame.type === 'conversation_list' || frame.type === 'error') resolve(frame);
+      });
+      client.once('error', reject);
+    });
+
+    try {
+      await once(client, 'open');
+      const response = await result;
+
+      expect(response).toMatchObject({
+        type: 'conversation_list',
+        conversations: [
+          {
+            sessionId: '00000000-0000-4000-8000-000000000001',
+            entryCount: 0,
+          },
+        ],
+      });
+      const conversations = response.conversations as Array<Record<string, unknown>>;
+      expect(conversations[0]?.createdAt).toEqual(expect.any(String));
+      expect(conversations[0]?.updatedAt).toEqual(expect.any(String));
+      expect(frames.filter(frame => frame.type === 'conversation_list')).toHaveLength(1);
+      expect(frames.some(frame => frame.type === 'stream_end')).toBe(false);
+    } finally {
+      client.terminate();
+      await server.stop();
+    }
+  });
+});