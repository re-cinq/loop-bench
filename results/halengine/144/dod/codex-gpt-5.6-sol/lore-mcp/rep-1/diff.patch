diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..8420ac2
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,226 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import type {Express} from 'express';
+import {WebSocket} from 'ws';
+import {createServer} from './createServer.js';
+import type {HalServer, HalServerOptions} from './createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {ChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import type {MessageChunk} from '../types/ai.js';
+import type {SessionListOptions, SessionSummary} from '../types/sessionStore.js';
+import {setLogger} from '../shared/logger.js';
+
+interface Frame {
+  type: string;
+  code?: string;
+  sessionId?: string;
+  resumed?: boolean;
+  conversations?: Array<{
+    sessionId: string;
+    createdAt: string;
+    updatedAt: string;
+    entryCount: number;
+  }>;
+}
+
+class ObservedStore extends InMemorySessionStore {
+  readonly calls: Array<{userId: string | number; options: SessionListOptions | undefined}> = [];
+
+  override listFor(userId: string | number, options?: SessionListOptions): SessionSummary[] {
+    this.calls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+const servers: HalServer[] = [];
+const clients: WebSocket[] = [];
+
+beforeAll(() => {
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined});
+});
+
+afterAll(() => {
+  setLogger();
+});
+
+afterEach(async () => {
+  for (const client of clients.splice(0)) client.terminate();
+  for (const server of servers.splice(0)) {
+    for (let attempt = 0; attempt < 50 && server.wss.clients.size > 0; attempt++) {
+      await new Promise(resolve => setTimeout(resolve, 10));
+    }
+    await server.stop();
+  }
+});
+
+const start = async (
+  sessionStore: InMemorySessionStore,
+  options: {history?: {enabled: boolean}; orchestrator?: ChatOrchestrator} = {}
+): Promise<string> => {
+  const serverOptions = {
+    app: (() => undefined) as unknown as Express,
+    wsAuth: async () => ({id: 'alice'}),
+    sessionStore,
+    orchestrator:
+      options.orchestrator ??
+      ({
+        processMessage: async () => 'done',
+        async *processMessageStream(): AsyncGenerator<MessageChunk> {
+          yield {type: 'stop', stopReason: 'end_turn'};
+        },
+      } as ChatOrchestrator),
+    resume: {enabled: true},
+    history: options.history,
+  } as HalServerOptions & {history?: {enabled: boolean}};
+  const hal = createServer(serverOptions);
+  await hal.start(0);
+  servers.push(hal);
+  const {port} = hal.server.address() as AddressInfo;
+  return `ws://127.0.0.1:${port}/hal/ws`;
+};
+
+const open = async (url: string): Promise<{client: WebSocket; frames: Frame[]}> => {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'token']);
+  clients.push(client);
+  const frames: Frame[] = [];
+  client.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  await once(client, 'open');
+  return {client, frames};
+};
+
+const nextFrame = (client: WebSocket, type: string): Promise<Frame> =>
+  new Promise(resolve => {
+    const receive = (raw: WebSocket.RawData) => {
+      const frame = JSON.parse(String(raw)) as Frame;
+      if (frame.type !== type) return;
+      client.off('message', receive);
+      resolve(frame);
+    };
+    client.on('message', receive);
+  });
+
+const nextMessage = (client: WebSocket): Promise<Frame> =>
+  new Promise(resolve => {
+    client.once('message', raw => resolve(JSON.parse(String(raw)) as Frame));
+  });
+
+describe('conversation lists over WebSocket', () => {
+  it('validates the list frame and its bounded composite cursor', () => {
+    const valid = [
+      {type: 'list_conversations'},
+      {
+        type: 'list_conversations',
+        limit: 25,
+        before: {updatedAt: '2026-10-29T12:00:00.000Z', sessionId: 'conversation-2'},
+      },
+    ];
+    const invalid = [
+      {frame: {type: 'list_conversations', limit: 0}, field: 'limit'},
+      {frame: {type: 'list_conversations', limit: 201}, field: 'limit'},
+      {frame: {type: 'list_conversations', limit: 1.5}, field: 'limit'},
+      {frame: {type: 'list_conversations', limit: '10'}, field: 'limit'},
+      {frame: {type: 'list_conversations', before: {updatedAt: 'not a date', sessionId: 's1'}}, field: 'before'},
+      {frame: {type: 'list_conversations', before: {updatedAt: '2026-10-29T12:00:00.000Z'}}, field: 'before'},
+    ];
+
+    expect(valid.map(frame => validateMessage(frame))).toEqual(valid.map(data => ({valid: true, data})));
+    for (const {frame, field} of invalid) {
+      const result = validateMessage(frame);
+      expect(result).toMatchObject({valid: false});
+      if (!result.valid) expect(result.error).toContain(field);
+    }
+  });
+
+  it('lists only the authenticated user, pages on the wire cursor off the turn lock, and resumes a chosen row', async () => {
+    const gate = (() => {
+      let release = (): void => undefined;
+      const wait = new Promise<void>(resolve => (release = resolve));
+      return {wait, release};
+    })();
+    const orchestrator = {
+      processMessage: async () => 'done',
+      async *processMessageStream(): AsyncGenerator<MessageChunk> {
+        yield {type: 'text', text: 'working'};
+        await gate.wait;
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+    } as ChatOrchestrator;
+    const store = new ObservedStore();
+    const rows = [
+      ['conversation-1', 'alice', '2026-10-27T12:00:00.000Z'],
+      ['conversation-2', 'alice', '2026-10-28T12:00:00.000Z'],
+      ['conversation-3', 'alice', '2026-10-29T12:00:00.000Z'],
+      ['private-to-bob', 'bob', '2026-10-30T12:00:00.000Z'],
+    ] as const;
+    for (const [sessionId, userId, timestamp] of rows) {
+      store.create(sessionId, userId).entries.push({role: 'user', content: sessionId, timestamp});
+    }
+    const base = await start(store, {history: {enabled: true}, orchestrator});
+    const {client, frames} = await open(`${base}?sessionId=conversation-1`);
+    client.send(JSON.stringify({type: 'user_message', content: 'keep the turn open'}));
+    await nextFrame(client, 'entry_delta');
+
+    const listed = nextMessage(client);
+    client.send(JSON.stringify({type: 'list_conversations', userId: 'bob'}));
+    const first = await listed;
+
+    expect(first.type).toBe('conversation_list');
+    expect(first.conversations?.map(row => row.sessionId)).toEqual([
+      'conversation-3',
+      'conversation-2',
+      'conversation-1',
+    ]);
+    expect(
+      first.conversations?.every(
+        row => !Number.isNaN(Date.parse(row.createdAt)) && !Number.isNaN(Date.parse(row.updatedAt))
+      )
+    ).toBe(true);
+    expect(frames.some(frame => frame.type === 'stream_end')).toBe(false);
+    expect(store.calls[0]).toEqual({userId: 'alice', options: {limit: undefined, before: undefined}});
+
+    const before = first.conversations?.[1];
+    const paged = nextMessage(client);
+    client.send(JSON.stringify({type: 'list_conversations', limit: 1, before}));
+    const page = await paged;
+    expect(page.type).toBe('conversation_list');
+    expect(page.conversations?.map(row => row.sessionId)).toEqual(['conversation-1']);
+    expect(store.calls[1]).toEqual({
+      userId: 'alice',
+      options: {limit: 1, before: {updatedAt: before?.updatedAt, sessionId: 'conversation-2'}},
+    });
+
+    const resumed = await open(`${base}?sessionId=conversation-2`);
+    const pong = nextFrame(resumed.client, 'pong');
+    resumed.client.send(JSON.stringify({type: 'ping', timestamp: 1}));
+    await pong;
+    expect(resumed.frames[0]).toMatchObject({type: 'connected', sessionId: 'conversation-2', resumed: true});
+    expect(resumed.frames.some(frame => frame.type === 'entry_upsert')).toBe(true);
+    gate.release();
+  });
+
+  it('returns UNSUPPORTED when history is off or unavailable instead of pretending the list is empty', async () => {
+    const store = new InMemorySessionStore();
+    store.create('conversation-1', 'alice');
+
+    for (const history of [undefined, {enabled: false}]) {
+      const base = await start(store, {history});
+      const {client} = await open(`${base}?sessionId=conversation-1`);
+      const error = nextFrame(client, 'error');
+      client.send(JSON.stringify({type: 'list_conversations'}));
+      expect(await error).toMatchObject({type: 'error', code: 'UNSUPPORTED'});
+    }
+
+    const unavailable = new InMemorySessionStore() as InMemorySessionStore & {listFor?: undefined};
+    Object.defineProperty(unavailable, 'listFor', {value: undefined});
+    unavailable.create('conversation-2', 'alice');
+    const base = await start(unavailable, {history: {enabled: true}});
+    const {client, frames} = await open(`${base}?sessionId=conversation-2`);
+    const error = nextFrame(client, 'error');
+    client.send(JSON.stringify({type: 'list_conversations'}));
+
+    expect(await error).toMatchObject({type: 'error', code: 'UNSUPPORTED'});
+    expect(frames.some(frame => frame.type === 'conversation_list')).toBe(false);
+  });
+});