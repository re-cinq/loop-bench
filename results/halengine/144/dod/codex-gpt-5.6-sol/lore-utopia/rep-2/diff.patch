index 0000000..47975ae
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,260 @@
+import {once} from 'node:events';
+import {WebSocket} from 'ws';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {setLogger} from '../shared/logger.js';
+import type {MessageChunk} from '../types/ai.js';
+import type {ChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import type {SessionListOptions} from '../types/sessionStore.js';
+import {connectClient, deferred, startEngineWith, stopEngines} from './wsTestSupport.js';
+import {validateMessage} from './ws/validation.js';
+
+// specs/hal-engine-websocket-protocol/spec.md#1
+describe('conversation lists over the WebSocket protocol', () => {
+  it('validates the request and its paging fields at the wire boundary', () => {
+    const valid = [
+      {type: 'list_conversations'},
+      {type: 'list_conversations', limit: 1, before: {updatedAt: '2026-10-01T12:00:00.000Z', sessionId: 's2'}},
+      {type: 'list_conversations', limit: 200},
+    ].map(validateMessage);
+    const invalid = [
+      {type: 'list_conversations', limit: 0},
+      {type: 'list_conversations', limit: 201},
+      {type: 'list_conversations', limit: 1.5},
+      {type: 'list_conversations', limit: '10'},
+      {type: 'list_conversations', before: {updatedAt: 'not a date', sessionId: 's2'}},
+      {type: 'list_conversations', before: {updatedAt: '2026-10-01T12:00:00.000Z'}},
+    ].map(validateMessage);
+
+    expect({valid, invalid}).toEqual({
+      valid: [
+        {valid: true, data: {type: 'list_conversations', limit: undefined, before: undefined}},
+        {
+          valid: true,
+          data: {
+            type: 'list_conversations',
+            limit: 1,
+            before: {updatedAt: '2026-10-01T12:00:00.000Z', sessionId: 's2'},
+          },
+        },
+        {valid: true, data: {type: 'list_conversations', limit: 200, before: undefined}},
+      ],
+      invalid: [
+        {valid: false, error: expect.stringContaining('limit')},
+        {valid: false, error: expect.stringContaining('limit')},
+        {valid: false, error: expect.stringContaining('limit')},
+        {valid: false, error: expect.stringContaining('limit')},
+        {valid: false, error: expect.stringContaining('before')},
+        {valid: false, error: expect.stringContaining('before')},
+      ],
+    });
+  });
+
+  // specs/hal-engine-websocket-protocol/spec.md#2
+  it("returns only the authenticated user's newest-first summaries and passes the client's page unchanged", async () => {
+    class ObservedStore extends InMemorySessionStore {
+      readonly calls: Array<{userId: string | number; options: SessionListOptions | undefined}> = [];
+
+      override listFor(userId: string | number, options?: SessionListOptions) {
+        this.calls.push({userId, options});
+        return super.listFor(userId, options);
+      }
+    }
+
+    const store = new ObservedStore();
+    store.create('older', 'u1').entries.push({
+      role: 'user',
+      content: 'old conversation',
+      timestamp: '2026-10-01T10:00:00.000Z',
+    });
+    store.create('newer', 'u1').entries.push({
+      role: 'user',
+      content: 'new conversation',
+      timestamp: '2026-10-01T11:00:00.000Z',
+    });
+    store.create('private-to-u2', 'u2').entries.push({
+      role: 'user',
+      content: 'must not cross users',
+      timestamp: '2026-10-01T12:00:00.000Z',
+    });
+    const {url} = await startEngineWith({
+      sessionStore: store,
+      resume: {enabled: true},
+      ...({history: {enabled: true}} as object),
+    });
+    const client = connectClient(url);
+    await once(client, 'message');
+
+    client.send(JSON.stringify({type: 'list_conversations', userId: 'u2'}));
+    const first = await nextFrame(client);
+    expect(first.type).toBe('conversation_list');
+    const conversations = frameRows(first);
+    const cursor = conversations[1];
+    client.send(JSON.stringify({type: 'list_conversations', limit: 1, before: cursor}));
+    const second = await nextFrame(client, 'conversation_list');
+
+    expect({
+      firstTypes: [first.type],
+      ids: conversations.map(row => row.sessionId),
+      rowKeys: conversations.map(row => Object.keys(row).sort()),
+      isoTimes: conversations.every(row => isIso(row.createdAt) && isIso(row.updatedAt)),
+      secondCount: frameRows(second).length,
+      calls: store.calls,
+    }).toEqual({
+      firstTypes: ['conversation_list'],
+      ids: [expect.any(String), 'newer', 'older'],
+      rowKeys: Array(3).fill(['createdAt', 'entryCount', 'sessionId', 'updatedAt']),
+      isoTimes: true,
+      secondCount: 1,
+      calls: [
+        {userId: 'u1', options: {limit: undefined, before: undefined}},
+        {
+          userId: 'u1',
+          options: {limit: 1, before: {updatedAt: cursor.updatedAt, sessionId: cursor.sessionId}},
+        },
+      ],
+    });
+  });
+
+  // specs/hal-engine-websocket-protocol/spec.md#3
+  it('answers disabled and unavailable history with UNSUPPORTED rather than an empty list', async () => {
+    const enabledStore = new InMemorySessionStore();
+    enabledStore.create('held', 'u1');
+    const disabled = await startEngineWith({sessionStore: enabledStore});
+    const unavailableStore = withoutListFor(new InMemorySessionStore());
+    unavailableStore.create('held', 'u1');
+    const unavailable = await startEngineWith({
+      sessionStore: unavailableStore,
+      ...({history: {enabled: true}} as object),
+    });
+
+    const disabledClient = connectClient(disabled.url);
+    const unavailableClient = connectClient(unavailable.url);
+    await Promise.all([once(disabledClient, 'message'), once(unavailableClient, 'message')]);
+    disabledClient.send(JSON.stringify({type: 'list_conversations'}));
+    unavailableClient.send(JSON.stringify({type: 'list_conversations'}));
+
+    const answers = await Promise.all([nextFrame(disabledClient, 'error'), nextFrame(unavailableClient, 'error')]);
+    expect(answers).toEqual([
+      {type: 'error', code: 'UNSUPPORTED', message: expect.any(String)},
+      {type: 'error', code: 'UNSUPPORTED', message: expect.any(String)},
+    ]);
+  });
+
+  // specs/hal-engine-websocket-protocol/spec.md#4
+  it('answers a history request while a turn is streaming, without a stream_end of its own', async () => {
+    const gate = deferred();
+    const orchestrator: ChatOrchestrator = {
+      processMessage: async () => 'finished',
+      async *processMessageStream(): AsyncGenerator<MessageChunk> {
+        yield {type: 'text', text: 'started'};
+        await gate.until;
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+    };
+    const {url} = await startEngineWith({
+      sessionStore: new InMemorySessionStore(),
+      orchestrator,
+      ...({history: {enabled: true}} as object),
+    });
+    const client = connectClient(url);
+    await once(client, 'message');
+    client.send(JSON.stringify({type: 'user_message', content: 'hold this turn'}));
+    await nextFrame(client, 'entry_delta');
+
+    client.send(JSON.stringify({type: 'list_conversations'}));
+    const list = await nextFrame(client);
+    gate.release();
+    const end = await nextFrame(client, 'stream_end');
+
+    expect({list: list.type, end: end.type}).toEqual({list: 'conversation_list', end: 'stream_end'});
+  });
+
+  // specs/hal-engine-websocket-protocol/spec.md#5
+  it('sanitizes a store failure, logs its session, and keeps the socket usable', async () => {
+    class FailingStore extends InMemorySessionStore {
+      override listFor(): never {
+        throw new Error('database password appeared here');
+      }
+    }
+
+    const errors: Array<{message: string; fields?: Record<string, unknown>}> = [];
+    setLogger({
+      debug: () => undefined,
+      info: () => undefined,
+      warn: () => undefined,
+      error: (_category, message, fields) => void errors.push({message, fields}),
+    });
+    const {url} = await startEngineWith({
+      sessionStore: new FailingStore(),
+      ...({history: {enabled: true}} as object),
+    });
+    const client = connectClient(url);
+    const connected = await nextFrame(client, 'connected');
+    client.send(JSON.stringify({type: 'list_conversations'}));
+    const failure = await nextFrame(client, 'error');
+    client.send(JSON.stringify({type: 'ping', timestamp: 41}));
+    const pong = await nextFrame(client, 'pong');
+
+    expect({failure, pong, errors}).toEqual({
+      failure: {type: 'error', code: 'SERVER_ERROR', message: 'Failed to list conversations'},
+      pong: {type: 'pong', timestamp: 41},
+      errors: [
+        {
+          message: expect.any(String),
+          fields: expect.objectContaining({sessionId: expect.any(String)}),
+        },
+      ],
+    });
+    expect(JSON.stringify({failure, errors})).not.toContain('database password appeared here');
+    expect(connected.type).toBe('connected');
+  });
+});
+
+interface Frame {
+  type: string;
+  code?: string;
+  message?: string;
+  timestamp?: number;
+  conversations?: ConversationRow[];
+}
+
+interface ConversationRow {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+
+const nextFrame = (client: WebSocket, type?: string): Promise<Frame> =>
+  new Promise(resolve => {
+    const receive = (raw: WebSocket.RawData) => {
+      const frame = JSON.parse(String(raw)) as Frame;
+      if (type !== undefined && frame.type !== type) return;
+      client.off('message', receive);
+      resolve(frame);
+    };
+    client.on('message', receive);
+  });
+
+const frameRows = (frame: Frame): ConversationRow[] => frame.conversations ?? [];
+
+const isIso = (value: string): boolean => new Date(value).toISOString() === value;
+
+const withoutListFor = (inner: InMemorySessionStore) => ({
+  create: inner.create.bind(inner),
+  get: inner.get.bind(inner),
+  delete: inner.delete.bind(inner),
+  count: inner.count.bind(inner),
+  clear: inner.clear.bind(inner),
+});
+
+beforeAll(() =>
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined})
+);
+
+afterEach(async () => {
+  await stopEngines();
+  await new Promise(resolve => setTimeout(resolve, 0));
+});
+
+afterAll(() => setLogger());