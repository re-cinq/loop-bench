diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..e8e53dc
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,159 @@
+import {WebSocket} from 'ws';
+import type {ChatSession} from '../types/session.js';
+import type {SessionListOptions, SessionStore} from '../types/sessionStore.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {setLogger} from '../shared/logger.js';
+import {validateMessage} from './ws/validation.js';
+import {connectClient, startEngineWith, stopEngines} from './wsTestSupport.js';
+
+type WireFrame = Record<string, unknown> & {type: string};
+
+class RecordingStore extends InMemorySessionStore {
+  readonly calls: Array<{userId: string | number; options: SessionListOptions | undefined}> = [];
+
+  override listFor(userId: string | number, options?: SessionListOptions) {
+    this.calls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+class StoreWithoutConversationLists implements SessionStore {
+  private readonly sessions = new Map<string, ChatSession>();
+
+  create(sessionId: string, userId: string | number): ChatSession {
+    const session = {sessionId, userId, entries: []};
+    this.sessions.set(sessionId, session);
+    return session;
+  }
+
+  get(sessionId: string): ChatSession | undefined {
+    return this.sessions.get(sessionId);
+  }
+
+  delete(sessionId: string): boolean {
+    return this.sessions.delete(sessionId);
+  }
+
+  count(): number {
+    return this.sessions.size;
+  }
+
+  clear(): void {
+    this.sessions.clear();
+  }
+}
+
+const nextFrame = (client: WebSocket): Promise<WireFrame> =>
+  new Promise((resolve, reject) => {
+    const timeout = setTimeout(() => reject(new Error('timed out waiting for a WebSocket frame')), 1000);
+    client.once('message', raw => {
+      clearTimeout(timeout);
+      resolve(JSON.parse(String(raw)) as WireFrame);
+    });
+  });
+
+const connect = async (store: SessionStore, history?: {enabled: boolean}) => {
+  const options = {sessionStore: store, history} as Parameters<typeof startEngineWith>[0] & {
+    history?: {enabled: boolean};
+  };
+  const {url} = await startEngineWith(options);
+  const client = connectClient(url);
+  const connected = await nextFrame(client);
+  expect(connected.type).toBe('connected');
+  return client;
+};
+
+beforeAll(() => {
+  const discard = () => undefined;
+  setLogger({debug: discard, info: discard, warn: discard, error: discard});
+});
+
+afterEach(async () => {
+  await stopEngines();
+  await new Promise<void>(resolve => setImmediate(resolve));
+});
+
+describe('conversation lists over the WebSocket protocol', () => {
+  it('validates the list request and its paging fields', () => {
+    expect(validateMessage({type: 'list_conversations'})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations', limit: undefined, before: undefined},
+    });
+    expect(
+      validateMessage({
+        type: 'list_conversations',
+        limit: 10,
+        before: {updatedAt: '2026-01-02T03:04:05.000Z', sessionId: 'previous'},
+      })
+    ).toEqual({
+      valid: true,
+      data: {
+        type: 'list_conversations',
+        limit: 10,
+        before: {updatedAt: '2026-01-02T03:04:05.000Z', sessionId: 'previous'},
+      },
+    });
+
+    for (const [field, value] of [
+      ['limit', 0],
+      ['limit', 201],
+      ['limit', 1.5],
+      ['limit', '10'],
+      ['before', {updatedAt: 'not a date', sessionId: 'previous'}],
+      ['before', {updatedAt: '2026-01-02T03:04:05.000Z'}],
+    ] as const) {
+      const result = validateMessage({type: 'list_conversations', [field]: value});
+      expect(result).toMatchObject({valid: false, error: expect.stringContaining(field)});
+    }
+  });
+
+  it('answers with the authenticated user’s newest conversations and forwards the cursor', async () => {
+    const store = new RecordingStore();
+    store.create('older', 'u1').entries.push({
+      role: 'user',
+      content: 'old',
+      timestamp: '2025-01-01T00:00:00.000Z',
+    });
+    store.create('newer', 'u1').entries.push({
+      role: 'user',
+      content: 'new',
+      timestamp: '2025-02-01T00:00:00.000Z',
+    });
+    store.create('somebody-elses', 'u2');
+    const client = await connect(store, {enabled: true});
+
+    client.send(JSON.stringify({type: 'list_conversations', userId: 'u2'}));
+    const first = await nextFrame(client);
+
+    expect(first.type).toBe('conversation_list');
+    const conversations = first.conversations as Array<Record<string, unknown>>;
+    expect(conversations).toHaveLength(3);
+    expect(conversations.map(row => row.sessionId)).not.toContain('somebody-elses');
+    expect(conversations.slice(1).map(row => row.sessionId)).toEqual(['newer', 'older']);
+    for (const row of conversations) {
+      expect(row).toEqual({
+        sessionId: expect.any(String),
+        createdAt: expect.stringMatching(/^\d{4}-\d\d-\d\dT/),
+        updatedAt: expect.stringMatching(/^\d{4}-\d\d-\d\dT/),
+        entryCount: expect.any(Number),
+      });
+    }
+    expect(store.calls[0]).toEqual({userId: 'u1', options: {limit: undefined, before: undefined}});
+
+    const before = {updatedAt: conversations[0].updatedAt as string, sessionId: conversations[0].sessionId as string};
+    client.send(JSON.stringify({type: 'list_conversations', limit: 1, before}));
+    await nextFrame(client);
+
+    expect(store.calls[1]).toEqual({userId: 'u1', options: {limit: 1, before}});
+  });
+
+  it('reports UNSUPPORTED when history is disabled or the store cannot list', async () => {
+    const disabled = await connect(new InMemorySessionStore());
+    disabled.send(JSON.stringify({type: 'list_conversations'}));
+    await expect(nextFrame(disabled)).resolves.toMatchObject({type: 'error', code: 'UNSUPPORTED'});
+
+    const unavailable = await connect(new StoreWithoutConversationLists(), {enabled: true});
+    unavailable.send(JSON.stringify({type: 'list_conversations'}));
+    await expect(nextFrame(unavailable)).resolves.toMatchObject({type: 'error', code: 'UNSUPPORTED'});
+  });
+});