diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..92d9b4d
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,230 @@
+import type {AddressInfo} from 'node:net';
+import type {Express} from 'express';
+import {WebSocket} from 'ws';
+import {createServer} from './createServer.js';
+import type {HalServer, HalServerOptions} from './createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {ChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import type {MessageChunk} from '../types/ai.js';
+import type {SessionCursor, SessionListOptions, SessionStore, SessionSummary} from '../types/sessionStore.js';
+import {setLogger} from '../shared/logger.js';
+
+interface Frame {
+  type: string;
+  code?: string;
+  sessionId?: string;
+  conversations?: Array<{
+    sessionId: string;
+    createdAt: string;
+    updatedAt: string;
+    entryCount: number;
+  }>;
+}
+
+interface HistoryOptions {
+  history?: {enabled: boolean};
+}
+
+const servers: HalServer[] = [];
+const clients: WebSocket[] = [];
+
+beforeAll(() => {
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined});
+});
+
+afterAll(() => {
+  setLogger();
+});
+
+afterEach(async () => {
+  for (const client of clients.splice(0)) client.terminate();
+  for (const server of servers.splice(0)) await server.stop();
+  await new Promise(resolve => setTimeout(resolve, 0));
+});
+
+const start = async (
+  sessionStore: SessionStore,
+  options: HistoryOptions = {},
+  orchestrator: ChatOrchestrator = idleOrchestrator
+): Promise<string> => {
+  const server = createServer({
+    app: (() => undefined) as unknown as Express,
+    wsAuth: async () => ({id: 'owner'}),
+    sessionStore,
+    orchestrator,
+    resume: {enabled: true},
+    ...options,
+  } as HalServerOptions & HistoryOptions);
+  await server.start(0);
+  servers.push(server);
+  const {port} = server.server.address() as AddressInfo;
+  return `ws://127.0.0.1:${port}/hal/ws`;
+};
+
+const open = (url: string): WebSocket => {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'token']);
+  clients.push(client);
+  return client;
+};
+
+const framesThrough = (client: WebSocket, terminal: (frames: Frame[]) => boolean): Promise<Frame[]> =>
+  new Promise(resolve => {
+    const frames: Frame[] = [];
+    client.on('message', raw => {
+      frames.push(JSON.parse(String(raw)) as Frame);
+      if (terminal(frames)) resolve(frames);
+    });
+  });
+
+const idleOrchestrator: ChatOrchestrator = {
+  processMessage: async () => '',
+  async *processMessageStream(): AsyncGenerator<MessageChunk> {
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+};
+
+class RecordingStore extends InMemorySessionStore {
+  readonly calls: Array<{userId: string | number; options: SessionListOptions | undefined}> = [];
+
+  override listFor(userId: string | number, options?: SessionListOptions) {
+    this.calls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+class FailingStore extends InMemorySessionStore {
+  override async listFor(): Promise<SessionSummary[]> {
+    throw new Error('database password must not cross the wire');
+  }
+}
+
+describe('conversation lists over the WebSocket protocol', () => {
+  it('accepts a list request and rejects invalid limits or an incomplete cursor', () => {
+    expect(validateMessage({type: 'list_conversations'})).toMatchObject({valid: true});
+
+    const invalid = [
+      {limit: 0, field: 'limit'},
+      {limit: 201, field: 'limit'},
+      {limit: 1.5, field: 'limit'},
+      {limit: '10', field: 'limit'},
+      {before: {updatedAt: 'not a date', sessionId: 's1'}, field: 'before'},
+      {before: {updatedAt: '2026-01-01T00:00:00.000Z'}, field: 'before'},
+    ];
+
+    for (const {field, ...payload} of invalid) {
+      expect(validateMessage({type: 'list_conversations', ...payload})).toEqual({
+        valid: false,
+        error: expect.stringContaining(field),
+      });
+    }
+  });
+
+  it('lists only the authenticated user, forwards the page, and answers outside a streaming turn', async () => {
+    const store = new RecordingStore();
+    const first = store.create('first', 'owner');
+    first.entries.push({role: 'user', content: 'one', timestamp: '2026-01-01T00:00:00.000Z'});
+    const newest = store.create('newest', 'owner');
+    newest.entries.push({role: 'user', content: 'two', timestamp: '2026-01-03T00:00:00.000Z'});
+    store.create('empty', 'owner');
+    store.create('someone-elses', 'intruder');
+
+    let release = (): void => undefined;
+    const held = new Promise<void>(resolve => (release = resolve));
+    const orchestrator: ChatOrchestrator = {
+      processMessage: async () => '',
+      async *processMessageStream(): AsyncGenerator<MessageChunk> {
+        await held;
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+    };
+    const base = await start(store, {history: {enabled: true}}, orchestrator);
+    const client = open(`${base}?sessionId=newest`);
+    const cursor: SessionCursor = {updatedAt: '2026-01-03T00:00:00.000Z', sessionId: 'newest'};
+    const received = framesThrough(client, frames => {
+      const lists = frames.filter(frame => frame.type === 'conversation_list');
+      if (lists.length === 1) {
+        client.send(JSON.stringify({type: 'list_conversations', limit: 3, before: cursor}));
+      }
+      return lists.length === 2 || frames.some(frame => frame.type === 'error');
+    });
+    client.on('open', () => {
+      client.send(JSON.stringify({type: 'user_message', content: 'held open'}));
+      client.send(JSON.stringify({type: 'list_conversations', userId: 'intruder'}));
+    });
+
+    const frames = await received;
+    release();
+    const lists = frames.filter(frame => frame.type === 'conversation_list');
+
+    expect({calls: store.calls, lists, types: frames.map(frame => frame.type)}).toEqual({
+      calls: [
+        {userId: 'owner', options: {limit: undefined, before: undefined}},
+        {userId: 'owner', options: {limit: 3, before: cursor}},
+      ],
+      lists: [
+        {
+          type: 'conversation_list',
+          conversations: [
+            expect.objectContaining({sessionId: 'newest', entryCount: 2}),
+            expect.objectContaining({sessionId: 'empty', entryCount: 0}),
+            expect.objectContaining({sessionId: 'first', entryCount: 1}),
+          ],
+        },
+        {
+          type: 'conversation_list',
+          conversations: [expect.objectContaining({sessionId: 'first', entryCount: 1})],
+        },
+      ],
+      types: expect.not.arrayContaining(['stream_end']),
+    });
+    for (const summary of lists[0]?.conversations ?? []) {
+      expect(new Date(summary.createdAt).toISOString()).toBe(summary.createdAt);
+      expect(new Date(summary.updatedAt).toISOString()).toBe(summary.updatedAt);
+      expect(summary.sessionId).not.toBe('someone-elses');
+    }
+  });
+
+  it('reports unsupported or failed listing as errors without closing the socket or inventing an empty list', async () => {
+    const unsupportedStore: SessionStore = {
+      create: (sessionId, userId) => ({sessionId, userId, entries: []}),
+      get: () => undefined,
+      delete: () => false,
+      count: () => 0,
+      clear: () => undefined,
+    };
+    const disabled = open(await start(new InMemorySessionStore()));
+    const missing = open(await start(unsupportedStore, {history: {enabled: true}}));
+    const rejected = open(await start(new FailingStore(), {history: {enabled: true}}));
+
+    const ask = async (client: WebSocket): Promise<Frame[]> => {
+      const answer = framesThrough(client, frames => frames.some(frame => frame.type === 'pong'));
+      client.on('open', () => {
+        client.send(JSON.stringify({type: 'list_conversations'}));
+        client.send(JSON.stringify({type: 'ping', timestamp: 1}));
+      });
+      return answer;
+    };
+    const [offFrames, missingFrames, rejectedFrames] = await Promise.all([ask(disabled), ask(missing), ask(rejected)]);
+
+    expect([offFrames, missingFrames].map(frames => frames.filter(frame => frame.type !== 'connected'))).toEqual([
+      [
+        {type: 'error', code: 'UNSUPPORTED', message: expect.any(String)},
+        {type: 'pong', timestamp: 1},
+      ],
+      [
+        {type: 'error', code: 'UNSUPPORTED', message: expect.any(String)},
+        {type: 'pong', timestamp: 1},
+      ],
+    ]);
+    expect(rejectedFrames.filter(frame => frame.type !== 'connected')).toEqual([
+      {type: 'error', code: 'SERVER_ERROR', message: expect.not.stringContaining('database password')},
+      {type: 'pong', timestamp: 1},
+    ]);
+    expect([...offFrames, ...missingFrames, ...rejectedFrames]).not.toContainEqual({
+      type: 'conversation_list',
+      conversations: [],
+    });
+  });
+});