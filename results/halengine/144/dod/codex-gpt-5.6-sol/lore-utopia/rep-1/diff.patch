diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..f7c4643
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,184 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import type {Express} from 'express';
+import {createServer} from './createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {ChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import type {MessageChunk} from '../types/ai.js';
+import type {SessionStore} from '../types/sessionStore.js';
+import {answeringOrchestrator, deferred} from './wsTestSupport.js';
+
+type Frame = Record<string, unknown> & {type: string};
+type HistoryOptions = {enabled: boolean};
+
+const servers: Array<ReturnType<typeof createServer>> = [];
+const clients: WebSocket[] = [];
+
+const eventually = async (check: () => boolean): Promise<void> => {
+  for (let attempt = 0; attempt < 50 && !check(); attempt++) await new Promise(resolve => setTimeout(resolve, 10));
+};
+
+const start = async (
+  sessionStore: SessionStore,
+  history: HistoryOptions | undefined,
+  orchestrator: ChatOrchestrator = answeringOrchestrator
+): Promise<string> => {
+  const hal = createServer({
+    app: (() => undefined) as unknown as Express,
+    wsAuth: async () => ({id: 'owner'}),
+    sessionStore,
+    orchestrator,
+    resume: {enabled: true},
+    history,
+  } as Parameters<typeof createServer>[0] & {history?: HistoryOptions});
+  await hal.start(0);
+  servers.push(hal);
+  const {port} = hal.server.address() as AddressInfo;
+  return `ws://127.0.0.1:${port}/hal/ws`;
+};
+
+const connect = async (url: string): Promise<{client: WebSocket; connected: Frame}> => {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'token']);
+  clients.push(client);
+  const [raw] = (await once(client, 'message')) as [Buffer];
+  return {client, connected: JSON.parse(String(raw)) as Frame};
+};
+
+const exchange = (client: WebSocket, request: unknown): Promise<Frame> =>
+  new Promise(resolve => {
+    client.once('message', raw => resolve(JSON.parse(String(raw)) as Frame));
+    client.send(JSON.stringify(request));
+  });
+
+afterEach(async () => {
+  for (const client of clients.splice(0)) client.terminate();
+  for (const hal of servers.splice(0)) {
+    await eventually(() => hal.wss.clients.size === 0);
+    await hal.stop();
+  }
+});
+
+describe('a user requesting their conversation list over WebSocket', () => {
+  it('validates the request and identifies every invalid paging field', () => {
+    expect(validateMessage({type: 'list_conversations'})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations', limit: undefined, before: undefined},
+    });
+
+    const invalid = [
+      [{type: 'list_conversations', limit: 0}, 'limit'],
+      [{type: 'list_conversations', limit: 201}, 'limit'],
+      [{type: 'list_conversations', limit: 1.5}, 'limit'],
+      [{type: 'list_conversations', limit: '10'}, 'limit'],
+      [{type: 'list_conversations', before: 'not a cursor'}, 'before'],
+      [{type: 'list_conversations', before: {updatedAt: '2026-01-01T00:00:00.000Z'}}, 'before'],
+    ] as const;
+
+    for (const [request, field] of invalid) {
+      const result = validateMessage(request);
+      expect(result).toMatchObject({valid: false});
+      if (!result.valid) expect(result.error).toContain(field);
+    }
+  });
+
+  it("answers with only the authenticated user's newest summaries, pages them, and lets a listed id resume", async () => {
+    const store = new InMemorySessionStore();
+    store.create('older', 'owner').entries.push({
+      role: 'user',
+      content: 'old',
+      timestamp: '2098-01-01T00:00:00.000Z',
+    });
+    store.create('newer', 'owner').entries.push({
+      role: 'user',
+      content: 'new',
+      timestamp: '2099-01-01T00:00:00.000Z',
+    });
+    store.create('private', 'another-user');
+    const base = await start(store, {enabled: true});
+    const {client, connected} = await connect(base);
+
+    const first = await exchange(client, {
+      type: 'list_conversations',
+      userId: 'another-user',
+      limit: 2,
+    });
+
+    expect(first).toMatchObject({
+      type: 'conversation_list',
+      conversations: [
+        {sessionId: 'newer', updatedAt: '2099-01-01T00:00:00.000Z', entryCount: 1},
+        {sessionId: 'older', updatedAt: '2098-01-01T00:00:00.000Z', entryCount: 1},
+      ],
+    });
+    expect(JSON.stringify(first)).not.toContain('private');
+    expect(
+      (first.conversations as Array<Record<string, unknown>>).every(row => typeof row.createdAt === 'string')
+    ).toBe(true);
+
+    const second = await exchange(client, {
+      type: 'list_conversations',
+      limit: 1,
+      before: {updatedAt: '2098-01-01T00:00:00.000Z', sessionId: 'older'},
+    });
+    expect(second).toMatchObject({
+      type: 'conversation_list',
+      conversations: [{sessionId: connected.sessionId}],
+    });
+
+    const resumed = await connect(`${base}?sessionId=newer`);
+    expect(resumed.connected).toMatchObject({type: 'connected', sessionId: 'newer', resumed: true, entryCount: 1});
+  });
+
+  it('reports UNSUPPORTED when history is off or the store cannot list, never an empty list', async () => {
+    const disabled = await connect(await start(new InMemorySessionStore(), undefined));
+    expect(await exchange(disabled.client, {type: 'list_conversations'})).toMatchObject({
+      type: 'error',
+      code: 'UNSUPPORTED',
+    });
+
+    const legacyStore = new InMemorySessionStore();
+    Object.defineProperty(legacyStore, 'listFor', {value: undefined});
+    const unavailable = await connect(await start(legacyStore, {enabled: true}));
+    const answer = await exchange(unavailable.client, {type: 'list_conversations'});
+    expect(answer).toMatchObject({type: 'error', code: 'UNSUPPORTED'});
+    expect(answer.type).not.toBe('conversation_list');
+  });
+
+  it('reports a store failure without its detail and leaves the socket usable', async () => {
+    const store = new InMemorySessionStore();
+    Object.defineProperty(store, 'listFor', {
+      value: async () => Promise.reject(new Error('database password and query must stay private')),
+    });
+    const {client} = await connect(await start(store, {enabled: true}));
+
+    const answer = await exchange(client, {type: 'list_conversations'});
+    expect(answer).toMatchObject({type: 'error', code: 'SERVER_ERROR'});
+    expect(JSON.stringify(answer)).not.toContain('database password');
+    expect(await exchange(client, {type: 'ping', timestamp: 144})).toEqual({type: 'pong', timestamp: 144});
+  });
+
+  it('answers a list while a turn is streaming, before that turn ends', async () => {
+    const pause = deferred();
+    const orchestrator: ChatOrchestrator = {
+      processMessage: async () => 'eventual answer',
+      async *processMessageStream(): AsyncGenerator<MessageChunk> {
+        yield {type: 'text', text: 'started'};
+        await pause.until;
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+    };
+    const {client} = await connect(await start(new InMemorySessionStore(), {enabled: true}, orchestrator));
+    const order: string[] = [];
+    client.on('message', raw => order.push((JSON.parse(String(raw)) as Frame).type));
+    client.send(JSON.stringify({type: 'user_message', content: 'hold this turn'}));
+    await eventually(() => order.includes('entry_delta'));
+
+    const listed = exchange(client, {type: 'list_conversations'});
+    await expect(listed).resolves.toMatchObject({type: 'conversation_list'});
+    expect(order).not.toContain('stream_end');
+    pause.release();
+  });
+});