index 0000000..6525b1a
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,243 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import type {Express} from 'express';
+import {WebSocket} from 'ws';
+import type {RawData} from 'ws';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {createChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import {setLogger} from '../shared/logger.js';
+import type {SessionStore} from '../types/sessionStore.js';
+import type {HalServer, HalServerOptions} from './createServer.js';
+import {createServer} from './createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+
+interface Frame {
+  type: string;
+  sessionId?: string;
+  resumed?: boolean;
+  code?: string;
+  message?: string;
+  conversations?: Array<{
+    sessionId: string;
+    createdAt: string;
+    updatedAt: string;
+    entryCount: number;
+  }>;
+}
+
+interface HistoryOptions {
+  enabled: boolean;
+}
+
+const servers: HalServer[] = [];
+const clients: WebSocket[] = [];
+const errorLogs: Array<{message: string; fields?: Record<string, unknown>}> = [];
+
+const eventually = async (predicate: () => boolean): Promise<void> => {
+  for (let attempt = 0; attempt < 50 && !predicate(); attempt++) {
+    await new Promise(resolve => setTimeout(resolve, 10));
+  }
+};
+
+const waitFor = (client: WebSocket, predicate: (frame: Frame) => boolean): Promise<Frame> =>
+  new Promise(resolve => {
+    const receive = (raw: RawData) => {
+      const frame = JSON.parse(String(raw)) as Frame;
+      if (predicate(frame)) {
+        client.off('message', receive);
+        resolve(frame);
+      }
+    };
+    client.on('message', receive);
+  });
+
+const start = async (
+  sessionStore: SessionStore,
+  history: HistoryOptions | undefined,
+  beforeModelResponse?: () => Promise<string>
+): Promise<string> => {
+  const orchestrator = createChatOrchestrator(
+    createMockProvider(),
+    new PromptBuilder({identity: 'Conversation-list acceptance test.'}),
+    undefined,
+    {hooks: beforeModelResponse ? {beforeModelResponse: async () => beforeModelResponse()} : undefined, sessionStore}
+  );
+  const options = {
+    app: (() => undefined) as unknown as Express,
+    wsAuth: async () => ({id: 'alice'}),
+    sessionStore,
+    orchestrator,
+    resume: {enabled: true},
+    history,
+  } as HalServerOptions & {history?: HistoryOptions};
+  const server = createServer(options);
+  await server.start(0);
+  servers.push(server);
+  const {port} = server.server.address() as AddressInfo;
+  return `ws://127.0.0.1:${port}/hal/ws`;
+};
+
+const connect = async (url: string): Promise<WebSocket> => {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'token']);
+  clients.push(client);
+  await once(client, 'open');
+  return client;
+};
+
+const askForList = async (client: WebSocket, extra: Record<string, unknown> = {}): Promise<Frame> => {
+  const answer = waitFor(client, frame => frame.type === 'conversation_list' || frame.type === 'error');
+  client.send(JSON.stringify({type: 'list_conversations', ...extra}));
+  return answer;
+};
+
+beforeAll(() => {
+  setLogger({
+    debug: () => undefined,
+    info: () => undefined,
+    warn: () => undefined,
+    error: (_category, message, fields) => void errorLogs.push({message, fields}),
+  });
+});
+
+afterAll(() => setLogger());
+
+afterEach(async () => {
+  for (const client of clients.splice(0)) client.terminate();
+  for (const server of servers.splice(0)) {
+    await eventually(() => server.wss.clients.size === 0);
+    await server.stop();
+  }
+  errorLogs.length = 0;
+});
+
+describe('conversation lists over WebSocket', () => {
+  it('validates an optional limit and composite before cursor before accepting the frame', () => {
+    expect(validateMessage({type: 'list_conversations'})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations', limit: undefined, before: undefined},
+    });
+    expect(
+      validateMessage({
+        type: 'list_conversations',
+        limit: 25,
+        before: {updatedAt: '2026-10-29T10:00:00.000Z', sessionId: 'session-2'},
+      })
+    ).toEqual({
+      valid: true,
+      data: {
+        type: 'list_conversations',
+        limit: 25,
+        before: {updatedAt: '2026-10-29T10:00:00.000Z', sessionId: 'session-2'},
+      },
+    });
+
+    for (const [field, value] of [
+      ['limit', 0],
+      ['limit', 201],
+      ['limit', 1.5],
+      ['limit', '10'],
+      ['before', {updatedAt: 'not a date', sessionId: 'session-2'}],
+      ['before', {updatedAt: '2026-10-29T10:00:00.000Z'}],
+    ] as const) {
+      const result = validateMessage({type: 'list_conversations', [field]: value});
+      expect(result).toMatchObject({valid: false});
+      if (!result.valid) expect(result.error).toContain(field);
+    }
+  });
+
+  it('answers from the authenticated user immediately, pages with the wire cursor, and resumes a listed conversation', async () => {
+    class RecordingStore extends InMemorySessionStore {
+      readonly listCalls: Parameters<InMemorySessionStore['listFor']>[] = [];
+
+      override listFor(...args: Parameters<InMemorySessionStore['listFor']>) {
+        this.listCalls.push(args);
+        return super.listFor(...args);
+      }
+    }
+    const store = new RecordingStore();
+    store.create('alice-older', 'alice').entries.push({
+      role: 'user',
+      content: 'older',
+      timestamp: '2026-10-28T10:00:00.000Z',
+    });
+    store.create('alice-newer', 'alice').entries.push({
+      role: 'user',
+      content: 'newer',
+      timestamp: '2026-10-29T10:00:00.000Z',
+    });
+    store.create('bob-secret', 'bob').entries.push({
+      role: 'user',
+      content: 'secret',
+      timestamp: '2026-10-30T10:00:00.000Z',
+    });
+
+    let releaseModel = (): void => undefined;
+    const modelGate = new Promise<void>(resolve => {
+      releaseModel = resolve;
+    });
+    const base = await start(store, {enabled: true}, async () => {
+      await modelGate;
+      return 'Conversation-list acceptance test.';
+    });
+    const client = await connect(base);
+    const frames: string[] = [];
+    client.on('message', raw => frames.push((JSON.parse(String(raw)) as Frame).type));
+    client.send(JSON.stringify({type: 'user_message', content: 'hold this turn'}));
+    await waitFor(client, frame => frame.type === 'entry_upsert');
+
+    const first = await askForList(client, {limit: 3, userId: 'bob'});
+    expect(first.type).toBe('conversation_list');
+    expect(first.conversations).toHaveLength(3);
+    expect(first.conversations?.map(row => row.sessionId)).toEqual([expect.any(String), 'alice-newer', 'alice-older']);
+    expect(
+      first.conversations?.every(row => typeof row.createdAt === 'string' && typeof row.updatedAt === 'string')
+    ).toBe(true);
+    expect(frames).not.toContain('stream_end');
+    expect(store.listCalls[0]).toEqual(['alice', {limit: 3, before: undefined}]);
+
+    const cursor = first.conversations?.at(-1);
+    const next = await askForList(client, {
+      limit: 2,
+      before: cursor && {updatedAt: cursor.updatedAt, sessionId: cursor.sessionId},
+    });
+    expect(next).toMatchObject({type: 'conversation_list', conversations: []});
+
+    releaseModel();
+    await waitFor(client, frame => frame.type === 'stream_end');
+
+    const resumed = await connect(`${base}?sessionId=${first.conversations?.[1]?.sessionId}`);
+    const connected = await waitFor(resumed, frame => frame.type === 'connected');
+    expect(connected).toMatchObject({sessionId: 'alice-newer', resumed: true});
+  });
+
+  it('reports unsupported and failed stores as errors without pretending the user has an empty history', async () => {
+    const disabled = await connect(await start(new InMemorySessionStore(), undefined));
+    await expect(askForList(disabled)).resolves.toMatchObject({type: 'error', code: 'UNSUPPORTED'});
+
+    const originalFive: SessionStore = {
+      create: (sessionId, userId) => ({sessionId, userId, entries: []}),
+      get: () => undefined,
+      delete: () => false,
+      count: () => 0,
+      clear: () => undefined,
+    };
+    const unsupported = await connect(await start(originalFive, {enabled: true}));
+    await expect(askForList(unsupported)).resolves.toMatchObject({type: 'error', code: 'UNSUPPORTED'});
+
+    class FailingListStore extends InMemorySessionStore {
+      override listFor(): never {
+        throw new Error('database password and user content must stay private');
+      }
+    }
+    const failed = await connect(await start(new FailingListStore(), {enabled: true}));
+    const failure = await askForList(failed);
+    expect(failure).toMatchObject({type: 'error', code: 'SERVER_ERROR'});
+    expect(failure.message).not.toContain('database password');
+    expect(failed.readyState).toBe(WebSocket.OPEN);
+    expect(errorLogs.at(-1)?.fields).toMatchObject({sessionId: expect.any(String)});
+    expect(JSON.stringify(errorLogs.at(-1))).not.toContain('database password');
+  });
+});