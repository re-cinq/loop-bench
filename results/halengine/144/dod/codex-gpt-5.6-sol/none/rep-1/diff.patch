diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..8ef69bd
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,224 @@
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import {createHalEngine} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {setLogger} from '../shared/logger.js';
+import type {SessionListOptions, SessionSummary} from '../types/sessionStore.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+
+interface Frame {
+  type: string;
+  code?: string;
+  message?: string;
+  sessionId?: string;
+  resumed?: boolean;
+  conversations?: Array<{
+    sessionId: string;
+    createdAt: string;
+    updatedAt: string;
+    entryCount: number;
+  }>;
+}
+
+class RecordingStore extends InMemorySessionStore {
+  readonly listCalls: Array<{userId: string | number; options: SessionListOptions | undefined}> = [];
+
+  override listFor(userId: string | number, options?: SessionListOptions): SessionSummary[] {
+    this.listCalls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+const engines: Array<ReturnType<typeof createHalEngine>> = [];
+const clients: WebSocket[] = [];
+
+beforeAll(() => {
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined});
+});
+
+afterAll(() => setLogger());
+
+afterEach(async () => {
+  const closing = clients.splice(0).map(client => {
+    const closed =
+      client.readyState === WebSocket.CLOSED
+        ? Promise.resolve()
+        : new Promise<void>(resolve => client.once('close', resolve));
+    client.terminate();
+    return closed;
+  });
+  await Promise.all(closing);
+  for (const engine of engines.splice(0)) await engine.stop();
+});
+
+const start = async (
+  store: InMemorySessionStore,
+  history: {enabled: boolean} | undefined,
+  beforeModelResponse?: () => Promise<string>
+): Promise<string> => {
+  const engine = createHalEngine({
+    provider: {type: 'mock'},
+    prompt: {identity: 'Acceptance test engine'},
+    session: store,
+    auth: {ws: async () => ({id: 'owner'})},
+    orchestrator: {hooks: {beforeModelResponse}},
+    transport: {
+      resume: {enabled: true},
+      history,
+    } as NonNullable<Parameters<typeof createHalEngine>[0]['transport']>,
+  });
+  await engine.start(0);
+  engines.push(engine);
+  const {port} = engine.server.address() as AddressInfo;
+  return `ws://127.0.0.1:${port}/hal/ws`;
+};
+
+const open = (url: string): WebSocket => {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'token']);
+  clients.push(client);
+  return client;
+};
+
+const frames = (client: WebSocket) => {
+  const waiting: Array<(frame: Frame) => void> = [];
+  const queued: Frame[] = [];
+  client.on('message', raw => {
+    const frame = JSON.parse(String(raw)) as Frame;
+    const resolve = waiting.shift();
+    if (resolve) resolve(frame);
+    else queued.push(frame);
+  });
+  return () => {
+    const queuedFrame = queued.shift();
+    return queuedFrame ? Promise.resolve(queuedFrame) : new Promise<Frame>(resolve => waiting.push(resolve));
+  };
+};
+
+const ask = async (client: WebSocket, next: () => Promise<Frame>, frame: object): Promise<Frame> => {
+  client.send(JSON.stringify(frame));
+  return next();
+};
+
+describe('conversation lists over the WebSocket protocol', () => {
+  it('validates the list frame and its complete composite cursor', () => {
+    const valid = validateMessage({
+      type: 'list_conversations',
+      limit: 2,
+      before: {updatedAt: '2026-10-01T10:00:00.000Z', sessionId: 'second'},
+    });
+    const invalid = [
+      validateMessage({type: 'list_conversations', limit: 0}),
+      validateMessage({type: 'list_conversations', limit: 201}),
+      validateMessage({type: 'list_conversations', limit: 1.5}),
+      validateMessage({type: 'list_conversations', limit: '10'}),
+      validateMessage({type: 'list_conversations', before: {updatedAt: 'not a date', sessionId: 'second'}}),
+      validateMessage({type: 'list_conversations', before: {updatedAt: '2026-10-01T10:00:00.000Z'}}),
+    ];
+
+    expect({valid, invalid}).toEqual({
+      valid: {
+        valid: true,
+        data: {
+          type: 'list_conversations',
+          limit: 2,
+          before: {updatedAt: '2026-10-01T10:00:00.000Z', sessionId: 'second'},
+        },
+      },
+      invalid: [
+        {valid: false, error: expect.stringContaining('limit')},
+        {valid: false, error: expect.stringContaining('limit')},
+        {valid: false, error: expect.stringContaining('limit')},
+        {valid: false, error: expect.stringContaining('limit')},
+        {valid: false, error: expect.stringContaining('before')},
+        {valid: false, error: expect.stringContaining('before')},
+      ],
+    });
+  });
+
+  it('lists only the authenticated user, forwards paging unchanged, and lets a listed id resume', async () => {
+    const store = new RecordingStore();
+    for (const [sessionId, userId, timestamp] of [
+      ['oldest', 'owner', '2026-10-01T10:00:00.000Z'],
+      ['middle', 'owner', '2026-10-02T10:00:00.000Z'],
+      ['newest', 'owner', '2026-10-03T10:00:00.000Z'],
+      ['somebody-elses', 'other', '2026-10-04T10:00:00.000Z'],
+    ] as const) {
+      store.create(sessionId, userId).entries.push({role: 'user', content: sessionId, timestamp});
+    }
+    const base = await start(store, {enabled: true});
+    const client = open(`${base}?sessionId=newest`);
+    const next = frames(client);
+    expect(await next()).toMatchObject({type: 'connected', sessionId: 'newest', resumed: true});
+    expect(await next()).toMatchObject({type: 'entry_upsert', entry: {content: 'newest'}});
+
+    const first = await ask(client, next, {type: 'list_conversations', userId: 'other', limit: 2});
+    expect(first).toMatchObject({
+      type: 'conversation_list',
+      conversations: [
+        {sessionId: 'newest', updatedAt: '2026-10-03T10:00:00.000Z', entryCount: 1},
+        {sessionId: 'middle', updatedAt: '2026-10-02T10:00:00.000Z', entryCount: 1},
+      ],
+    });
+    expect(first.conversations?.every(row => typeof row.createdAt === 'string')).toBe(true);
+    expect(store.listCalls[0]).toEqual({userId: 'owner', options: {limit: 2, before: undefined}});
+
+    const before = first.conversations?.at(-1);
+    const second = await ask(client, next, {type: 'list_conversations', before});
+    expect(second).toMatchObject({type: 'conversation_list', conversations: [{sessionId: 'oldest'}]});
+    expect(store.listCalls[1]).toEqual({userId: 'owner', options: {limit: undefined, before}});
+
+    const resumed = open(`${base}?sessionId=${second.conversations?.[0]?.sessionId}`);
+    const resumedNext = frames(resumed);
+    expect(await resumedNext()).toMatchObject({type: 'connected', sessionId: 'oldest', resumed: true});
+    expect(await resumedNext()).toMatchObject({type: 'entry_upsert', entry: {content: 'oldest'}});
+  });
+
+  it('answers UNSUPPORTED when history is off or the store cannot list, never an empty list', async () => {
+    const offBase = await start(new InMemorySessionStore(), undefined);
+    const off = open(offBase);
+    const offNext = frames(off);
+    await offNext();
+    expect(await ask(off, offNext, {type: 'list_conversations'})).toMatchObject({type: 'error', code: 'UNSUPPORTED'});
+
+    const legacyStore = new InMemorySessionStore();
+    Object.defineProperty(legacyStore, 'listFor', {value: undefined});
+    const legacyBase = await start(legacyStore, {enabled: true});
+    const legacy = open(legacyBase);
+    const legacyNext = frames(legacy);
+    await legacyNext();
+    expect(await ask(legacy, legacyNext, {type: 'list_conversations'})).toMatchObject({
+      type: 'error',
+      code: 'UNSUPPORTED',
+    });
+  });
+
+  it('answers a list while a turn is still waiting, before that turn can send stream_end', async () => {
+    let entered = (): void => undefined;
+    let release = (): void => undefined;
+    const waiting = new Promise<void>(resolve => {
+      entered = resolve;
+    });
+    const held = new Promise<void>(resolve => {
+      release = resolve;
+    });
+    const base = await start(new InMemorySessionStore(), {enabled: true}, async () => {
+      entered();
+      await held;
+      return 'Acceptance test engine';
+    });
+    const client = open(base);
+    const next = frames(client);
+    await next();
+    client.send(JSON.stringify({type: 'user_message', content: 'hold this turn'}));
+    await waiting;
+    expect(await next()).toMatchObject({type: 'entry_upsert', entry: {content: 'hold this turn'}});
+
+    client.send(JSON.stringify({type: 'list_conversations'}));
+    const answer = await next();
+    release();
+
+    expect(answer).toMatchObject({type: 'conversation_list'});
+    expect(answer.type).not.toBe('stream_end');
+  });
+});