diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..0fd79f5
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,190 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import express from 'express';
+import {WebSocket} from 'ws';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import {ToolRegistry} from '../orchestration/tools/registry.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import {setLogger} from '../shared/logger.js';
+import type {HalServerOptions} from './createServer.js';
+import {createServer} from './createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+
+// specs/hal-engine-websocket-protocol/spec.md#list-conversations
+
+interface Frame {
+  type: string;
+  code?: string;
+  timestamp?: number;
+  conversations?: Array<{
+    sessionId: string;
+    createdAt: string;
+    updatedAt: string;
+    entryCount: number;
+  }>;
+}
+
+const servers: ReturnType<typeof createServer>[] = [];
+const clients: WebSocket[] = [];
+const orchestrator = createChatOrchestrator(
+  createMockProvider(),
+  new PromptBuilder({identity: 'Acceptance test'}),
+  new ToolRegistry()
+);
+
+const eventually = async (check: () => boolean): Promise<void> => {
+  for (let attempt = 0; attempt < 50 && !check(); attempt++) await new Promise(resolve => setTimeout(resolve, 10));
+};
+
+beforeAll(() => {
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined});
+});
+
+afterAll(() => {
+  setLogger();
+});
+
+afterEach(async () => {
+  for (const client of clients.splice(0)) client.terminate();
+  for (const server of servers.splice(0)) {
+    await eventually(() => server.wss.clients.size === 0);
+    await server.stop();
+  }
+});
+
+const start = async (store: InMemorySessionStore, history?: {enabled: boolean}) => {
+  const options = {
+    app: express(),
+    wsAuth: async () => ({id: 'owner'}),
+    sessionStore: store,
+    orchestrator,
+    resume: {enabled: true},
+    history,
+  } as HalServerOptions;
+  const server = createServer(options);
+  await server.start(0);
+  servers.push(server);
+  const {port} = server.server.address() as AddressInfo;
+  return `ws://127.0.0.1:${port}/hal/ws`;
+};
+
+const open = async (url: string): Promise<WebSocket> => {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'token']);
+  clients.push(client);
+  await once(client, 'message');
+  return client;
+};
+
+const request = async (client: WebSocket, frame: object): Promise<Frame[]> => {
+  const frames: Frame[] = [];
+  return new Promise(resolve => {
+    const receive = (raw: Buffer) => {
+      const answer = JSON.parse(String(raw)) as Frame;
+      frames.push(answer);
+      if (answer.type === 'pong') {
+        client.off('message', receive);
+        resolve(frames);
+      }
+    };
+    client.on('message', receive);
+    client.send(JSON.stringify(frame));
+    client.send(JSON.stringify({type: 'ping', timestamp: 144}));
+  });
+};
+
+const seededStore = (): InMemorySessionStore => {
+  const store = new InMemorySessionStore();
+  for (const [sessionId, userId, timestamp] of [
+    ['older', 'owner', '2026-01-01T00:00:00.000Z'],
+    ['newer', 'owner', '2026-02-01T00:00:00.000Z'],
+    ['foreign', 'another-user', '2026-03-01T00:00:00.000Z'],
+  ] as const) {
+    store.create(sessionId, userId).entries.push({role: 'user', content: sessionId, timestamp});
+  }
+  return store;
+};
+
+describe('a user requesting their conversation list over WebSocket', () => {
+  it('validates the list frame and its bounded composite cursor', () => {
+    expect(validateMessage({type: 'list_conversations'})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations', limit: undefined, before: undefined},
+    });
+    expect(
+      validateMessage({
+        type: 'list_conversations',
+        limit: 2,
+        before: {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: 'older'},
+      })
+    ).toEqual({
+      valid: true,
+      data: {
+        type: 'list_conversations',
+        limit: 2,
+        before: {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: 'older'},
+      },
+    });
+
+    for (const [frame, field] of [
+      [{type: 'list_conversations', limit: 0}, 'limit'],
+      [{type: 'list_conversations', limit: 201}, 'limit'],
+      [{type: 'list_conversations', limit: 1.5}, 'limit'],
+      [{type: 'list_conversations', limit: '10'}, 'limit'],
+      [{type: 'list_conversations', before: {updatedAt: 'not a date', sessionId: 'older'}}, 'before'],
+      [{type: 'list_conversations', before: {updatedAt: '2026-01-01T00:00:00.000Z'}}, 'before'],
+    ] as const) {
+      const result = validateMessage(frame);
+      expect(result.valid).toBe(false);
+      if (!result.valid) expect(result.error).toContain(field);
+    }
+  });
+
+  it('answers from the authenticated user in newest-first wire form and pages with the returned cursor', async () => {
+    const store = seededStore();
+    const base = await start(store, {enabled: true});
+    const client = await open(`${base}?sessionId=newer`);
+
+    const first = await request(client, {type: 'list_conversations', userId: 'another-user'});
+    const list = first.filter(frame => frame.type === 'conversation_list');
+    expect(first.map(frame => frame.type)).toEqual(['conversation_list', 'pong']);
+    expect(list).toHaveLength(1);
+    expect(list[0].conversations?.map(row => row.sessionId)).toEqual(['newer', 'older']);
+    expect(
+      list[0].conversations?.every(
+        row =>
+          new Date(row.createdAt).toISOString() === row.createdAt &&
+          new Date(row.updatedAt).toISOString() === row.updatedAt
+      )
+    ).toBe(true);
+
+    const cursor = list[0].conversations?.[0];
+    const second = await request(client, {
+      type: 'list_conversations',
+      limit: 1,
+      before: cursor && {updatedAt: cursor.updatedAt, sessionId: cursor.sessionId},
+    });
+    expect(second).toEqual([
+      {type: 'conversation_list', conversations: [list[0].conversations?.[1]]},
+      {type: 'pong', timestamp: 144},
+    ]);
+  });
+
+  it('reports UNSUPPORTED instead of an empty list when history is disabled or the store cannot list', async () => {
+    const disabled = await open(`${await start(seededStore())}?sessionId=newer`);
+    expect(await request(disabled, {type: 'list_conversations'})).toEqual([
+      {type: 'error', code: 'UNSUPPORTED', message: expect.any(String)},
+      {type: 'pong', timestamp: 144},
+    ]);
+
+    const store = seededStore();
+    Object.defineProperty(store, 'listFor', {value: undefined});
+    const unavailable = await open(`${await start(store, {enabled: true})}?sessionId=newer`);
+    expect(await request(unavailable, {type: 'list_conversations'})).toEqual([
+      {type: 'error', code: 'UNSUPPORTED', message: expect.any(String)},
+      {type: 'pong', timestamp: 144},
+    ]);
+  });
+});