diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..d66630a
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,191 @@
+import type {AddressInfo} from 'node:net';
+import {once} from 'node:events';
+import {WebSocket} from 'ws';
+import {createHalEngine} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {setLogger} from '../shared/logger.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+
+interface Frame {
+  type: string;
+  code?: string;
+  sessionId?: string;
+  conversations?: Array<{
+    sessionId: string;
+    createdAt: string;
+    updatedAt: string;
+    entryCount: number;
+  }>;
+}
+
+const engines: Array<ReturnType<typeof createHalEngine>> = [];
+const clients: WebSocket[] = [];
+
+beforeAll(() => {
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined});
+});
+
+afterAll(() => setLogger());
+
+afterEach(async () => {
+  const closing = clients.splice(0).map(client => {
+    if (client.readyState === WebSocket.CLOSED) return Promise.resolve();
+    const closed = once(client, 'close');
+    client.terminate();
+    return closed;
+  });
+  await Promise.all(closing);
+  for (const engine of engines.splice(0)) {
+    for (let attempt = 0; attempt < 50 && engine.wss.clients.size > 0; attempt++) {
+      await new Promise(resolve => setTimeout(resolve, 0));
+    }
+    await engine.stop();
+  }
+});
+
+const configuredEngine = async (
+  store: InMemorySessionStore,
+  history: {enabled: boolean} | undefined,
+  beforeProvider?: () => Promise<void>
+) => {
+  const transport = {
+    port: 0,
+    resume: {enabled: true},
+    ...(history === undefined ? {} : {history}),
+  };
+  const engine = createHalEngine({
+    provider: {type: 'mock'},
+    prompt: {identity: 'acceptance test'},
+    session: store,
+    transport,
+    auth: {ws: async () => ({id: 'owner'})},
+    orchestrator: beforeProvider === undefined ? undefined : {hooks: {beforeProvider}},
+  });
+  await engine.start();
+  engines.push(engine);
+  const {port} = engine.server.address() as AddressInfo;
+  return `ws://127.0.0.1:${port}/hal/ws`;
+};
+
+const connect = (url: string): WebSocket => {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'token']);
+  clients.push(client);
+  return client;
+};
+
+const nextFrame = (client: WebSocket, ...types: string[]): Promise<Frame> =>
+  new Promise(resolve => {
+    const read = (raw: WebSocket.RawData) => {
+      const frame = JSON.parse(String(raw)) as Frame;
+      if (!types.includes(frame.type)) return;
+      client.off('message', read);
+      resolve(frame);
+    };
+    client.on('message', read);
+  });
+
+const seed = (store: InMemorySessionStore, sessionId: string, userId: string, timestamp: string) => {
+  const session = store.create(sessionId, userId);
+  session.entries.push({role: 'user', content: sessionId, timestamp});
+};
+
+describe('conversation history over the WebSocket protocol', () => {
+  it('validates a list request and rejects each malformed limit or cursor by field name', () => {
+    expect(validateMessage({type: 'list_conversations'})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations', limit: undefined, before: undefined},
+    });
+
+    for (const limit of [0, 201, 1.5, '10']) {
+      expect(validateMessage({type: 'list_conversations', limit})).toMatchObject({
+        valid: false,
+        error: expect.stringMatching(/limit/i),
+      });
+    }
+    for (const before of [
+      'not a date',
+      {updatedAt: 'not a date', sessionId: 's1'},
+      {updatedAt: '2026-01-01T00:00:00.000Z'},
+      {sessionId: 's1'},
+    ]) {
+      expect(validateMessage({type: 'list_conversations', before})).toMatchObject({
+        valid: false,
+        error: expect.stringMatching(/before/i),
+      });
+    }
+  });
+
+  it("answers from the authenticated user's store window before an in-flight turn ends", async () => {
+    const store = new InMemorySessionStore();
+    seed(store, 'owner-old', 'owner', '2026-01-01T00:00:00.000Z');
+    seed(store, 'owner-middle', 'owner', '2026-02-01T00:00:00.000Z');
+    seed(store, 'owner-new', 'owner', '2026-03-01T00:00:00.000Z');
+    seed(store, 'intruder', 'other-user', '2026-04-01T00:00:00.000Z');
+
+    let release = (): void => undefined;
+    const held = new Promise<void>(resolve => {
+      release = resolve;
+    });
+    const base = await configuredEngine(store, {enabled: true}, () => held);
+    const client = connect(`${base}?sessionId=owner-new`);
+    const connected = await nextFrame(client, 'connected');
+    expect(connected.sessionId).toBe('owner-new');
+
+    const firstList = nextFrame(client, 'conversation_list', 'error');
+    const terminal = nextFrame(client, 'stream_end');
+    client.send(JSON.stringify({type: 'user_message', content: 'hold this turn open'}));
+    client.send(JSON.stringify({type: 'list_conversations', userId: 'other-user'}));
+
+    const first = await firstList;
+    release();
+    await terminal;
+
+    expect(first.type).toBe('conversation_list');
+    expect(first.conversations?.map(row => row.sessionId)).toEqual(['owner-new', 'owner-middle', 'owner-old']);
+    expect(first.conversations).toEqual(
+      expect.arrayContaining([
+        expect.objectContaining({
+          createdAt: expect.any(String),
+          updatedAt: expect.any(String),
+          entryCount: expect.any(Number),
+        }),
+      ])
+    );
+    expect(
+      first.conversations?.every(
+        row => !Number.isNaN(Date.parse(row.createdAt)) && !Number.isNaN(Date.parse(row.updatedAt))
+      )
+    ).toBe(true);
+
+    const page = nextFrame(client, 'conversation_list');
+    client.send(
+      JSON.stringify({
+        type: 'list_conversations',
+        limit: 1,
+        before: {updatedAt: first.conversations?.[0].updatedAt, sessionId: first.conversations?.[0].sessionId},
+      })
+    );
+    await expect(page).resolves.toMatchObject({conversations: [{sessionId: 'owner-middle'}]});
+  });
+
+  it('answers UNSUPPORTED, never an empty list, when history is off or the store cannot list', async () => {
+    const disabledStore = new InMemorySessionStore();
+    seed(disabledStore, 'held', 'owner', '2026-01-01T00:00:00.000Z');
+    const disabledBase = await configuredEngine(disabledStore, undefined);
+    const disabled = connect(disabledBase);
+    await nextFrame(disabled, 'connected');
+    const disabledError = nextFrame(disabled, 'error');
+    disabled.send(JSON.stringify({type: 'list_conversations'}));
+    await expect(disabledError).resolves.toMatchObject({type: 'error', code: 'UNSUPPORTED'});
+
+    const unsupportedStore = new InMemorySessionStore();
+    Object.defineProperty(unsupportedStore, 'listFor', {value: undefined});
+    const unsupportedBase = await configuredEngine(unsupportedStore, {enabled: true});
+    const unsupported = connect(unsupportedBase);
+    await nextFrame(unsupported, 'connected');
+    const unsupportedError = nextFrame(unsupported, 'error');
+    unsupported.send(JSON.stringify({type: 'list_conversations'}));
+    await expect(unsupportedError).resolves.toMatchObject({type: 'error', code: 'UNSUPPORTED'});
+  });
+});