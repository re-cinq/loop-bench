diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..52023ff
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,106 @@
+import {once} from 'node:events';
+import {WebSocket} from 'ws';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {connectClient, startEngineWith, stopEngines} from './wsTestSupport.js';
+import {validateMessage} from './ws/validation.js';
+
+const receive = (client: WebSocket): Promise<Record<string, unknown>> =>
+  once(client, 'message').then(([raw]) => JSON.parse(String(raw)) as Record<string, unknown>);
+
+describe('conversation lists over WebSocket', () => {
+  afterEach(stopEngines);
+
+  it('validates a list request and its bounded composite cursor', () => {
+    const cursor = {updatedAt: '2026-01-02T03:04:05.000Z', sessionId: 'session-2'};
+    const cases = [
+      {frame: {type: 'list_conversations'}, valid: true},
+      {frame: {type: 'list_conversations', limit: 1, before: cursor}, valid: true},
+      {frame: {type: 'list_conversations', limit: 0}, valid: false, field: 'limit'},
+      {frame: {type: 'list_conversations', limit: 201}, valid: false, field: 'limit'},
+      {frame: {type: 'list_conversations', limit: 1.5}, valid: false, field: 'limit'},
+      {frame: {type: 'list_conversations', limit: '10'}, valid: false, field: 'limit'},
+      {
+        frame: {type: 'list_conversations', before: {updatedAt: 'not a date', sessionId: 'session-2'}},
+        valid: false,
+        field: 'before',
+      },
+      {
+        frame: {type: 'list_conversations', before: {updatedAt: cursor.updatedAt}},
+        valid: false,
+        field: 'before',
+      },
+    ];
+
+    expect(
+      cases.map(({frame, field}) => {
+        const result = validateMessage(frame);
+        return {
+          valid: result.valid,
+          namesField: result.valid || field === undefined ? undefined : result.error.includes(field),
+        };
+      })
+    ).toEqual(cases.map(({valid, field}) => ({valid, namesField: valid || field === undefined ? undefined : true})));
+  });
+
+  it("answers an enabled request with only the authenticated user's newest summaries on the wire", async () => {
+    const store = new InMemorySessionStore();
+    const older = store.create('older', 'u1');
+    older.entries.push({role: 'user', content: 'first', timestamp: '2026-01-01T00:00:00.000Z'});
+    const newer = store.create('newer', 'u1');
+    newer.entries.push({role: 'user', content: 'second', timestamp: '2026-01-02T00:00:00.000Z'});
+    store.create('somebody-elses', 'u2');
+
+    const {url} = await startEngineWith({
+      sessionStore: store,
+      ...({history: {enabled: true}} as Record<string, unknown>),
+    });
+    const client = connectClient(url);
+    const connected = receive(client);
+    await once(client, 'open');
+    const connectedFrame = await connected;
+
+    const answer = receive(client);
+    client.send(JSON.stringify({type: 'list_conversations', userId: 'u2', limit: 3}));
+
+    await expect(answer).resolves.toEqual({
+      type: 'conversation_list',
+      conversations: [
+        expect.objectContaining({
+          sessionId: connectedFrame.sessionId,
+          createdAt: expect.stringMatching(/Z$/),
+          updatedAt: expect.stringMatching(/Z$/),
+          entryCount: 0,
+        }),
+        expect.objectContaining({
+          sessionId: 'newer',
+          createdAt: expect.stringMatching(/Z$/),
+          updatedAt: '2026-01-02T00:00:00.000Z',
+          entryCount: 1,
+        }),
+        expect.objectContaining({
+          sessionId: 'older',
+          createdAt: expect.stringMatching(/Z$/),
+          updatedAt: '2026-01-01T00:00:00.000Z',
+          entryCount: 1,
+        }),
+      ],
+    });
+  });
+
+  it('refuses a list request unless the deployer opted in', async () => {
+    const {url} = await startEngineWith({sessionStore: new InMemorySessionStore()});
+    const client = connectClient(url);
+    const connected = receive(client);
+    await once(client, 'open');
+    await connected;
+
+    const answer = receive(client);
+    client.send(JSON.stringify({type: 'list_conversations'}));
+
+    await expect(answer).resolves.toEqual({
+      type: 'error',
+      code: 'UNSUPPORTED',
+      message: expect.any(String),
+    });
+  });
+});