+// spec: specs/hal-engine-conversation-list/spec.md#39
+it('refuses unavailable history and sanitizes store failures without closing the socket', async () => {
+  const inner = seeded();
+  // A closed real Mongo client fails immediately, without a daemon, network or fabricated exception.
+  const mongo = new MongoClient('mongodb://127.0.0.1:27017');
+  await mongo.close();
+  const collection = mongo.db('private_database').collection<MongoSessionDocument>('private_collection');
+  const failed = new MongoSessionStore({collection: collection as unknown as CollectionLike<MongoSessionDocument>});
+  const legacyCollection: CollectionLike<MongoSessionDocument> = {
+    findOne: collection.findOne.bind(collection),
+    updateOne: collection.updateOne.bind(collection),
+    deleteOne: collection.deleteOne.bind(collection),
+    deleteMany: collection.deleteMany.bind(collection),
+    countDocuments: collection.countDocuments.bind(collection),
+  };
+  const unsupported = new MongoSessionStore({collection: legacyCollection});
+  const scenarios = [
+    {name: 'absent', store: inner, history: undefined, code: 'UNSUPPORTED'},
+    {name: 'disabled', store: inner, history: {enabled: false}, code: 'UNSUPPORTED'},
+    {name: 'no listFor', store: core(inner), history: {enabled: true}, code: 'UNSUPPORTED'},
+    {
+      name: 'no find',
+      store: {...core(inner), listFor: unsupported.listFor.bind(unsupported)},
+      history: {enabled: true},
+      code: 'UNSUPPORTED',
+    },
+    {
+      name: 'failed query',
+      store: {...core(inner), listFor: failed.listFor.bind(failed)},
+      history: {enabled: true},
+      code: 'SERVER_ERROR',
+    },
+  ];
+  const outcomes = [];
+  let failedSession: string | undefined;
+  let failureLogs: typeof logs = [];
+  for (const scenario of scenarios) {
+    const client = await connect(await start(scenario.store, scenario.history));
+    const offset = logs.length;
+    const frames = await client.request({type: 'list_conversations'});
+    outcomes.push({name: scenario.name, frames, open: client.socket.readyState === WebSocket.OPEN});
+    if (scenario.code === 'SERVER_ERROR') {
+      expect(JSON.stringify(frames)).not.toMatch(/private_|Mongo|connect|client|topology/i);
+      failedSession = client.frames[0].sessionId;
+      failureLogs = logs.slice(offset).filter(line => line.level === 'error');
+    }
+  }
+  expect(outcomes).toEqual(
+    scenarios.map(scenario => ({
+      name: scenario.name,
+      frames: [{type: 'error', code: scenario.code, message: expect.any(String)}],
+      open: true,
+    }))
+  );
+  expect(failureLogs).toEqual([expect.objectContaining({fields: expect.objectContaining({sessionId: failedSession})})]);
+  expect(JSON.stringify(logs)).not.toMatch(
+    /private_database|private_collection|private-conversation-content|private-credential/
+  );
+});
