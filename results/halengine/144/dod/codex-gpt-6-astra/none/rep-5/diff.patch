+// spec: specs/hal-engine-conversation-list/spec.md#40
+it('answers history while a user turn holds the session lock', async () => {
+  let release!: () => void;
+  const held = new Promise<void>(resolve => {
+    release = resolve;
+  });
+  let entered = false;
+  // A real consumer policy holds the turn, then refuses it before any provider request is made.
+  const url = await start(
+    seeded(),
+    {enabled: true},
+    {
+      hooks: {
+        beforeSession: async () => {
+          entered = true;
+          await held;
+          throw new Error('Input refused by consumer policy');
+        },
+      },
+    }
+  );
+  const client = await connect(url);
+  try {
+    client.send({type: 'user_message', content: 'a pending turn'});
+    await client.waitFor(() => entered);
+    expect(entered).toBe(true);
+    const response = await client.request({type: 'list_conversations'});
+    expect(response).toEqual([{type: 'conversation_list', conversations: expect.any(Array)}]);
+    expect(client.frames.some(frame => frame.type === 'stream_end')).toBe(false);
+  } finally {
+    release();
+    await client.waitFor(() => client.frames.some(frame => frame.type === 'stream_end'));
+  }
+});