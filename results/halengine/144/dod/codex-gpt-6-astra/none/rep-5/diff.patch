new file mode 100644
index 0000000..23dbaf1
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,310 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {MongoClient} from 'mongodb';
+import {WebSocket} from 'ws';
+import {createHalEngine} from '../config.js';
+import type {HalEngineConfig} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {MongoSessionStore} from '../infrastructure/stores/mongo/mongoSessionStore.js';
+import type {CollectionLike} from '../infrastructure/stores/mongo/mongoDriverTypes.js';
+import type {MongoSessionDocument} from '../infrastructure/stores/mongo/mongoSessionDocument.js';
+import type {SessionListOptions, SessionStore, SessionSummary} from '../types/sessionStore.js';
+import {setLogger} from '../shared/logger.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+
+type Row = Omit<SessionSummary, 'createdAt' | 'updatedAt'> & {createdAt: string; updatedAt: string};
+interface Frame {
+  type: string;
+  sessionId?: string;
+  conversations?: Row[];
+  code?: string;
+  message?: string;
+  timestamp?: number;
+}
+const engines: ReturnType<typeof createHalEngine>[] = [];
+const clients: WebSocket[] = [];
+const logs: Array<{level: string; fields: unknown; message: string}> = [];
+const record = (level: string) => (_category: string, message: string, fields?: Record<string, unknown>) => {
+  logs.push({level, message, fields});
+};
+beforeEach(() => {
+  logs.length = 0;
+});
+afterEach(async () => {
+  await Promise.all(
+    clients.splice(0).map(async client => {
+      if (client.readyState === WebSocket.CLOSED) return;
+      const closed = once(client, 'close');
+      client.terminate();
+      await closed;
+    })
+  );
+  for (const engine of engines.splice(0)) await engine.stop();
+  setLogger();
+});
+
+async function start(
+  store: SessionStore,
+  history?: {enabled: boolean},
+  hooks?: HalEngineConfig['orchestrator'],
+  resume = true
+) {
+  // Structural extension lets today's public factory receive tomorrow's additive option without a missing import.
+  const transport = {port: 0, resume: {enabled: resume}, history};
+  const engine = createHalEngine({
+    provider: {type: 'bedrock', region: 'eu-central-1', modelId: 'unused', maxTokens: 1},
+    prompt: {identity: 'Conversation history acceptance'},
+    session: store,
+    transport,
+    auth: {
+      ws: async request => (request.headers['sec-websocket-protocol']?.includes('owner-token') ? {id: 'owner'} : null),
+    },
+    logger: {debug: record('debug'), info: record('info'), warn: record('warn'), error: record('error')},
+    orchestrator: hooks,
+  });
+  engines.push(engine);
+  await engine.start();
+  return `ws://127.0.0.1:${(engine.server.address() as AddressInfo).port}/hal/ws`;
+}
+
+async function connect(url: string) {
+  const socket = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'owner-token']);
+  clients.push(socket);
+  const frames: Frame[] = [];
+  socket.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  const waitFor = async (predicate: () => boolean) => {
+    const deadline = Date.now() + 1500;
+    while (!predicate() && Date.now() < deadline) await new Promise(resolve => setTimeout(resolve, 5));
+  };
+  const send = (frame: unknown) => socket.send(JSON.stringify(frame));
+  let timestamp = 0;
+  const settle = async () => {
+    const marker = ++timestamp;
+    send({type: 'ping', timestamp: marker});
+    await waitFor(() => frames.some(frame => frame.type === 'pong' && frame.timestamp === marker));
+    expect(frames.at(-1)).toMatchObject({type: 'pong', timestamp: marker});
+  };
+  await waitFor(() => frames.some(frame => frame.type === 'connected'));
+  await settle();
+  const request = async (frame: unknown): Promise<Frame[]> => {
+    const offset = frames.length;
+    send(frame);
+    await waitFor(() => frames.slice(offset).some(item => ['conversation_list', 'error'].includes(item.type)));
+    await settle();
+    return frames.slice(offset).filter(item => item.type !== 'pong');
+  };
+  return {socket, frames, send, waitFor, settle, request};
+}
+
+// These adapters delegate every operation to a real store; recording does not replace its result.
+function core(store: InMemorySessionStore): SessionStore {
+  return {
+    create: (id, user, options) => store.create(id, user, options),
+    get: id => store.get(id),
+    delete: id => store.delete(id),
+    count: () => store.count(),
+    clear: () => store.clear(),
+  };
+}
+function seeded() {
+  const store = new InMemorySessionStore();
+  const tiedActivity = new Date(Date.now() + 60_000).toISOString();
+  for (const [id, user] of [
+    ['a', 'owner'],
+    ['b', 'owner'],
+    ['foreign', 'other'],
+  ]) {
+    store.create(id, user, {authHeaders: {authorization: 'private-credential'}}).entries.push({
+      role: 'user',
+      content: 'private-conversation-content',
+      timestamp: tiedActivity,
+    });
+  }
+  return store;
+}
+
+// spec: specs/hal-engine-conversation-list/spec.md#37
+it('validates history limits and composite cursors independently of configuration', () => {
+  const cursor = {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: 'b'};
+  const valid = [
+    {type: 'list_conversations'},
+    {type: 'list_conversations', limit: 1, before: cursor},
+    {type: 'list_conversations', limit: 200},
+  ];
+  expect(valid.map(frame => validateMessage(frame))).toEqual(valid.map(data => ({valid: true, data})));
+  for (const limit of [0, 201, 1.5, '10', null]) {
+    expect(validateMessage({type: 'list_conversations', limit})).toEqual({
+      valid: false,
+      error: expect.stringMatching(/limit/i),
+    });
+  }
+  for (const before of [
+    'not a date',
+    cursor.updatedAt,
+    null,
+    {},
+    {updatedAt: cursor.updatedAt},
+    {sessionId: 'b'},
+    {...cursor, updatedAt: 'not a date'},
+    {...cursor, updatedAt: 123},
+    {...cursor, sessionId: 123},
+  ]) {
+    expect(validateMessage({type: 'list_conversations', before})).toEqual({
+      valid: false,
+      error: expect.stringMatching(/before/i),
+    });
+  }
+});
+
+// spec: specs/hal-engine-conversation-list/spec.md#38
+it('lists only the authenticated users metadata, pages ties and reopens a listed conversation', async () => {
+  const inner = seeded();
+  const calls: Array<{userId: string | number; options: SessionListOptions | undefined}> = [];
+  const store: SessionStore = {
+    ...core(inner),
+    listFor: (userId, options) => {
+      calls.push({userId, options});
+      return inner.listFor(userId, options);
+    },
+  };
+  const url = await start(store, {enabled: true});
