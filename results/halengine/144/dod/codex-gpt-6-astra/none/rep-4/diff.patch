@@ -0,0 +1,297 @@
+import {jest} from '@jest/globals';
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import {MongoClient} from 'mongodb';
+import {createHalEngine} from '../config.js';
+import type {HalEngineConfig, HalEngine} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {MongoSessionStore} from '../infrastructure/stores/mongo/mongoSessionStore.js';
+import {startMongo, MONGO_START_MS} from '../infrastructure/stores/mongo/mongoTestSupport.js';
+import type {MongoSessionDocument} from '../infrastructure/stores/mongo/mongoSessionDocument.js';
+import type {SessionStore, SessionListOptions} from '../types/sessionStore.js';
+import type {IncomingMessage, OutgoingMessage} from '../types/messages.js';
+import {setLogger} from '../shared/logger.js';
+import {validateMessage} from './ws/validation.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+
+jest.setTimeout(MONGO_START_MS);
+
+interface Row {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+interface Frame {
+  type: string;
+  code?: string;
+  message?: string;
+  sessionId?: string;
+  resumed?: boolean;
+  conversations?: Row[];
+  entry?: unknown;
+}
+
+// Recording preserves the real store's filtering, sorting and paging implementation.
+class RecordedStore extends InMemorySessionStore {
+  readonly calls: Array<{userId: string | number; options?: SessionListOptions}> = [];
+  override listFor(userId: string | number, options?: SessionListOptions) {
+    this.calls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+const engines: HalEngine[] = [];
+const sockets: WebSocket[] = [];
+const errors: Array<Record<string, unknown>> = [];
+const warnings: Array<Record<string, unknown>> = [];
+beforeEach(() => {
+  errors.length = 0;
+  warnings.length = 0;
+  setLogger({
+    debug: () => undefined,
+    info: () => undefined,
+    warn: (category, message, fields) => void warnings.push({category, message, ...fields}),
+    error: (category, message, fields) => void errors.push({category, message, ...fields}),
+  });
+});
+
+afterEach(async () => {
+  await Promise.all(
+    sockets.splice(0).map(async socket => {
+      const closed = once(socket, 'close');
+      socket.terminate();
+      await closed;
+    })
+  );
+  await Promise.all(engines.splice(0).map(engine => engine.stop()));
+  setLogger();
+});
+
+async function start(
+  store: SessionStore,
+  history?: {enabled: boolean},
+  hooks?: HalEngineConfig['orchestrator'],
+  resume = true
+) {
+  const transport = {resume: {enabled: resume}, history};
+  const engine = createHalEngine({
+    provider: {type: 'mock'},
+    prompt: {identity: 'Conversation history acceptance'},
+    session: store,
+    auth: {ws: async () => ({id: 'owner'})},
+    transport,
+    orchestrator: hooks,
+  });
+  engines.push(engine);
+  await engine.start(0);
+  return `ws://127.0.0.1:${(engine.server.address() as AddressInfo).port}/hal/ws`;
+}
+
+async function connect(url: string) {
+  const socket = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'acceptance-token']);
+  sockets.push(socket);
+  const frames: Frame[] = [];
+  socket.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  await until(() => frames.some(frame => frame.type === 'connected'));
+  return {socket, frames};
+}
+
+async function until(predicate: () => boolean) {
+  const deadline = Date.now() + 2000;
+  while (!predicate() && Date.now() < deadline) await new Promise(resolve => setTimeout(resolve, 5));
+  expect(predicate()).toBe(true);
+}
+
+async function request(peer: Awaited<ReturnType<typeof connect>>, frame: unknown) {
+  const offset = peer.frames.length;
+  peer.socket.send(JSON.stringify(frame));
+  await until(() => peer.frames.slice(offset).some(value => ['error', 'conversation_list'].includes(value.type)));
+  peer.socket.send(JSON.stringify({type: 'ping', timestamp: 1}));
+  await until(() => peer.frames.slice(offset).some(value => value.type === 'pong'));
+  return peer.frames.slice(offset).filter(value => value.type !== 'pong');
+}
+
+// spec: specs/hal-engine-conversation-list/spec.md#37
+it('validates history windows independently of deployment settings', () => {
+  expect(validateMessage({type: 'list_conversations'})).toEqual({valid: true, data: {type: 'list_conversations'}});
+  const legacyIncoming: IncomingMessage[] = [
+    {type: 'user_message', content: 'hello'},
+    {type: 'ping', timestamp: 1},
+  ];
+  for (const frame of legacyIncoming) expect(validateMessage(frame)).toEqual({valid: true, data: frame});
+  const legacyOutgoing: OutgoingMessage[] = [
+    {type: 'connected', sessionId: 'old', message: 'Connected', examplePrompts: []},
+    {
+      type: 'connected',
+      sessionId: 'old',
+      message: 'Connected',
+      examplePrompts: [],
+      resumed: false,
+      resumeFailure: 'unknown',
+    },
+    {type: 'entry_upsert', index: 0, entry: {role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}},
+    {type: 'entry_delta', index: 1, delta: 'hello'},
+    {type: 'entry_commit', index: 1},
+    {type: 'entry_skip', index: 2},
+    {type: 'error', code: 'SERVER_ERROR', message: 'Failed'},
+    {type: 'pong', timestamp: 1},
+    {type: 'stream_end'},
+  ];
+  expect(JSON.parse(JSON.stringify(legacyOutgoing))).toEqual(legacyOutgoing);
+  const before = {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: 'row'};
+  for (const limit of [1, 200]) {
+    const frame = {type: 'list_conversations', limit, before};
+    expect(validateMessage({...frame, userId: 'someone-else'})).toEqual({valid: true, data: frame});
+  }
+  for (const limit of [0, 201, 1.5, '10', null]) {
+    expect(validateMessage({type: 'list_conversations', limit})).toEqual({
+      valid: false,
+      error: expect.stringMatching(/limit/i),
+    });
+  }
+  for (const cursor of [
+    'not a date',
+    before.updatedAt,
+    {},
+    {updatedAt: before.updatedAt},
+    {sessionId: 'row'},
+    {...before, updatedAt: 'bad'},
+    {...before, sessionId: 1},
