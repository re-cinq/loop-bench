+  const peer = await connect(
+    await start(
+      new InMemorySessionStore(),
+      {enabled: true},
+      {
+        hooks: {
+          afterModelResponse: async () => {
+            entered = true;
+            await gate;
+          },
+        },
+      }
+    )
+  );
+  peer.socket.send(JSON.stringify({type: 'user_message', content: 'hello'}));
+  try {
+    await until(() => entered && peer.frames.some(frame => frame.type === 'entry_delta'));
