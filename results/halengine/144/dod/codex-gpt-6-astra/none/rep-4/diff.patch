+    expect(answer).toEqual([{type: 'conversation_list', conversations: expect.any(Array)}]);
+    expect(peer.frames.some(frame => frame.type === 'stream_end')).toBe(false);
+  } finally {
+    release();
+    await until(() => peer.frames.some(frame => frame.type === 'stream_end'));
+  }
+});
