@@ -0,0 +1,19 @@
+import {readFileSync} from 'node:fs';
+
+// Preserve the existing Jest descriptors and expose each acceptance test's stamped spec anchor.
+const descriptors = JSON.parse(readFileSync(0, 'utf8'));
+const stamps = new Map();
+for (const {file} of descriptors) {
+  if (!file.endsWith('.acceptance.test.ts') || stamps.has(file)) continue;
+  const source = readFileSync(file, 'utf8');
+  const entries = [...source.matchAll(/\/\/ spec: (specs\/[^\s]+#\d+)\s+it\(\s*(['"])(.*?)\2/g)];
+  stamps.set(file, new Map(entries.map(match => [match[3], match[1]])));
+}
+process.stdout.write(
+  JSON.stringify(
+    descriptors.map(test => {
+      const spec = stamps.get(test.file)?.get(test.name);
+      return spec ? {...test, spec} : test;
+    })
+  ) + '\n'
+);
