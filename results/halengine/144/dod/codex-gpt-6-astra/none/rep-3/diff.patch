+it('lists only the connected user on demand, pages ties, bypasses turns and resumes a listed conversation (specs/hal-engine-conversation-list/spec.md#37)', async () => {
+  const store = new RecordedStore();
+  for (const id of ['a', 'b', 'foreign']) {
+    store.create(id, id === 'foreign' ? 'other' : 'owner', {authHeaders: {Authorization: 'private'}});
+  }
+  const timestamp = new Date().toISOString();
+  for (const id of ['a', 'b', 'foreign']) {
+    store.get(id)!.entries.push({role: 'user', content: `private ${id}`, timestamp});
+  }
+  await new Promise(resolve => setTimeout(resolve, 5));
+  const holding = latch();
+  const entered = latch();
+  const base = await start(
+    store,
+    {enabled: true},
+    {
+      hooks: {
+        afterModelResponse: async () => {
+          entered.release();
+          await holding.promise;
+        },
+      },
+    }
+  );
+  const client = await open(base);
+  expect(client.frames.map(frame => frame.type)).toEqual(['connected', 'pong']);
+  const expected = JSON.parse(JSON.stringify(InMemorySessionStore.prototype.listFor.call(store, 'owner'))) as Row[];
+  expect(expected.map(row => row.sessionId)).toEqual([client.frames[0].sessionId, 'b', 'a']);
+  expect(await client.request({type: 'list_conversations', userId: 'other'})).toEqual([
+    {type: 'conversation_list', conversations: expected},
+  ]);
+  expect(store.calls).toEqual([{userId: 'owner', options: {limit: undefined, before: undefined}}]);
+  const before = {updatedAt: expected[0].updatedAt, sessionId: expected[0].sessionId};
+  expect(await client.request({type: 'list_conversations', limit: 1, before})).toEqual([
+    {type: 'conversation_list', conversations: [expected[1]]},
+  ]);
+  expect(store.calls.at(-1)).toEqual({userId: 'owner', options: {limit: 1, before}});
+  const tiedCursor = {updatedAt: expected[1].updatedAt, sessionId: expected[1].sessionId};
+  expect(await client.request({type: 'list_conversations', limit: 1, before: tiedCursor})).toEqual([
+    {type: 'conversation_list', conversations: [expected[2]]},
+  ]);
+  const end = {updatedAt: expected[2].updatedAt, sessionId: expected[2].sessionId};
+  expect(await client.request({type: 'list_conversations', before: end})).toEqual([
+    {type: 'conversation_list', conversations: []},
+  ]);
+  try {
+    client.send({type: 'user_message', content: 'hello'});
+    await entered.promise;
+    await client.until(() => client.frames.some(frame => frame.type === 'entry_delta'));
+    expect(await client.request({type: 'list_conversations'})).toEqual([
+      {type: 'conversation_list', conversations: expect.any(Array)},
+    ]);
+    expect(client.frames.some(frame => frame.type === 'stream_end')).toBe(false);
+  } finally {
+    holding.release();
+  }
+  await client.until(() => client.frames.some(frame => frame.type === 'stream_end'));
+  const lists = client.frames.filter(frame => frame.type === 'conversation_list').length;
+  await client.barrier();
+  expect(client.frames.filter(frame => frame.type === 'conversation_list')).toHaveLength(lists);
+  const resumed = await open(`${base}?sessionId=${expected[1].sessionId}`);
+  expect(resumed.frames[0]).toMatchObject({type: 'connected', sessionId: 'b', resumed: true, entryCount: 1});
+  expect(resumed.frames.filter(frame => frame.type === 'entry_upsert').map(frame => frame.entry)).toEqual(
+    store.get('b')!.entries
+  );
+});
