+
+## 14. Conversation list (#144)
+
+The request and response extend the protocol additively; the connection's existing `connected` frame is unchanged.
+
+### Request: list_conversations
+
+| Field    | Type    | Required | Description                                                                              |
+| -------- | ------- | -------- | ---------------------------------------------------------------------------------------- |
+| `type`   | string  | Yes      | `list_conversations`                                                                     |
+| `limit`  | integer | No       | 1–200                                                                                    |
+| `before` | object  | No       | Composite cursor containing `updatedAt` (parseable date string) and `sessionId` (string) |
+
+- The validator accepts this request even when history is disabled and rejects malformed limits or incomplete cursors with a field-specific error ([validated by: validates history frames and composite cursors without changing existing frames (specs/hal-engine-conversation-list/spec.md#36)](../../src/transport/conversationHistory.acceptance.test.ts#L148)).
+
+### Response: conversation_list
+
+| Field                        | Type                  | Description                                            |
+| ---------------------------- | --------------------- | ------------------------------------------------------ |
+| `type`                       | string                | `conversation_list`                                    |
+| `conversations`              | ConversationSummary[] | Newest activity first, with the session-id tie-break   |
+| `conversations[].sessionId`  | string                | Conversation id, usable with the existing resume query |
+| `conversations[].createdAt`  | string                | ISO creation time                                      |
+| `conversations[].updatedAt`  | string                | ISO activity time                                      |
+| `conversations[].entryCount` | number                | Stored entry count                                     |
+
+- **GDPR:** The response contains only one authenticated user's conversation metadata and no content or credentials; identity comes from the connection, never the frame, requests bypass the turn lock, and responses are sent only when asked with no `stream_end` ([validated by: lists only the connected user on demand, pages ties, bypasses turns and resumes a listed conversation (specs/hal-engine-conversation-list/spec.md#37)](../../src/transport/conversationHistory.acceptance.test.ts#L208)).
+- `transport.history` is the deployer's independent decision to expose history to a client, defaulting off; unsupported capability returns `UNSUPPORTED`, a store failure returns a sanitized `SERVER_ERROR` and session-scoped log without closing the socket, and history enabled without resume warns that returned rows cannot be reopened ([validated by: reports unavailable history explicitly and contains store failures without closing the socket (specs/hal-engine-conversation-list/spec.md#38)](../../src/transport/conversationHistory.acceptance.test.ts#L275)).
diff --git a/src/transport/conversationHistory.acceptance.test.ts b/src/transport/conversationHistory.acceptance.test.ts
new file mode 100644
index 0000000..1e37885
--- /dev/null
+++ b/src/transport/conversationHistory.acceptance.test.ts
@@ -0,0 +1,332 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {MongoClient} from 'mongodb';
+import {WebSocket} from 'ws';
+import {createHalEngine} from '../config.js';
+import * as publicApi from '../index.js';
+import type {HalEngine, HalEngineConfig} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {MongoSessionStore} from '../infrastructure/stores/mongo/mongoSessionStore.js';
+import type {MongoSessionDocument} from '../infrastructure/stores/mongo/mongoSessionDocument.js';
+import type {SessionListOptions, SessionStore} from '../types/sessionStore.js';
+import type {
+  IncomingMessage,
+  OutgoingMessage,
+  ListConversationsMessage,
+  ConversationListMessage,
+  ConversationCursor,
+  ConversationSummary,
+} from '../types/messages.js';
+import {setLogger} from '../shared/logger.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+
+interface Row {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+interface Frame {
+  type: string;
+  sessionId?: string;
+  conversations?: Row[];
+  code?: string;
+  message?: string;
+  resumed?: boolean;
+  entry?: unknown;
+}
+const engines: HalEngine[] = [];
+const clients: WebSocket[] = [];
+const errors: Array<Record<string, unknown>> = [];
+const warnings: Array<Record<string, unknown>> = [];
+const logger = {
+  debug: () => undefined,
+  info: () => undefined,
+  warn: (category: string, message: string, fields?: Record<string, unknown>) =>
+    void warnings.push({category, message, ...fields}),
+  error: (category: string, message: string, fields?: Record<string, unknown>) =>
+    void errors.push({category, message, ...fields}),
+};
+
+beforeEach(() => {
+  errors.length = 0;
+  warnings.length = 0;
+});
+afterEach(async () => {
+  await Promise.all(
+    clients.splice(0).map(async client => {
+      if (client.readyState === WebSocket.CLOSED) return;
+      const closed = once(client, 'close');
+      client.terminate();
+      await closed;
+    })
+  );
+  for (const engine of engines.splice(0)) await engine.stop();
+  setLogger();
+});
+
+function latch() {
+  let release!: () => void;
+  const promise = new Promise<void>(resolve => {
+    release = resolve;
+  });
+  return {promise, release};
+}
+
+async function start(
+  store: SessionStore,
+  history?: {enabled: boolean},
+  hooks?: HalEngineConfig['orchestrator'],
+  resume = true
+) {
+  // A variable keeps the proposed additive option usable before its interface exists.
+  const transport = {history, resume: {enabled: resume}};
+  const engine = createHalEngine({
+    provider: {type: 'mock'},
+    prompt: {identity: 'Answer briefly.'},
+    session: store,
+    transport,
+    auth: {ws: () => Promise.resolve({id: 'owner'})},
+    orchestrator: hooks,
+    logger,
+  });
+  engines.push(engine);
+  await engine.start(0);
+  return `ws://127.0.0.1:${(engine.server.address() as AddressInfo).port}/hal/ws`;
+}
+
+async function open(url: string) {
+  const socket = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'credential']);
+  clients.push(socket);
+  const frames: Frame[] = [];
+  socket.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  async function until(predicate: () => boolean) {
+    const deadline = Date.now() + 2000;
+    while (!predicate() && Date.now() < deadline) await new Promise(resolve => setTimeout(resolve, 5));
+    expect(predicate()).toBe(true);
+  }
+  function send(frame: unknown) {
+    socket.send(JSON.stringify(frame));
+  }
+  async function barrier() {
+    const count = frames.filter(frame => frame.type === 'pong').length;
+    send({type: 'ping', timestamp: 1});
+    await until(() => frames.filter(frame => frame.type === 'pong').length > count);
+  }
+  async function request(frame: unknown) {
+    const from = frames.length;
+    send(frame);
+    await until(() => frames.slice(from).some(item => item.type === 'conversation_list' || item.type === 'error'));
+    await barrier();
+    return frames.slice(from).filter(item => item.type !== 'pong');
+  }
+  await until(() => frames.some(frame => frame.type === 'connected'));
+  await barrier();
+  return {socket, frames, until, send, barrier, request};
+}
+
+// Observation only: every recorded call executes the shipped store unchanged.
+class RecordedStore extends InMemorySessionStore {
+  readonly calls: Array<{userId: string | number; options: SessionListOptions | undefined}> = [];
+  override listFor(userId: string | number, options?: SessionListOptions) {
+    this.calls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+function basicStore(store: InMemorySessionStore): SessionStore {
+  return {
+    create: store.create.bind(store),
+    get: store.get.bind(store),
+    delete: store.delete.bind(store),
+    count: store.count.bind(store),
+    clear: store.clear.bind(store),
+  };
+}
+
+it('validates history frames and composite cursors without changing existing frames (specs/hal-engine-conversation-list/spec.md#36)', () => {
+  const cursor: ConversationCursor = {updatedAt: '2026-10-01T00:00:00.000Z', sessionId: 'older'};
+  const valid: ListConversationsMessage[] = [
+    {type: 'list_conversations'},
+    {type: 'list_conversations', limit: 1},
+    {type: 'list_conversations', limit: 200, before: cursor},
+  ];
+  expect(valid.map(validateMessage)).toEqual(valid.map(data => ({valid: true, data})));
+  for (const limit of [0, 201, 1.5, '10', null]) {
+    expect(validateMessage({type: 'list_conversations', limit})).toEqual({
+      valid: false,
+      error: expect.stringMatching(/limit/i),
+    });
+  }
+  for (const before of [
+    'not a date',
+    cursor.updatedAt,
+    null,
+    {},
+    {updatedAt: cursor.updatedAt},
+    {sessionId: 'older'},
+    {...cursor, updatedAt: 'bad'},
+    {...cursor, sessionId: 1},
+  ]) {
+    expect(validateMessage({type: 'list_conversations', before})).toEqual({
+      valid: false,
+      error: expect.stringMatching(/before/i),
+    });
+  }
+  const incoming: IncomingMessage[] = [
+    {type: 'ping', timestamp: 1},
+    {type: 'user_message', content: 'hello'},
+  ];
+  const outgoing: OutgoingMessage[] = [
+    {type: 'connected', sessionId: 's', message: 'hi', examplePrompts: []},
+    {type: 'connected', sessionId: 's', message: 'hi', examplePrompts: [], resumed: false, resumeFailure: 'unknown'},
+    {type: 'connected', sessionId: 's', message: 'hi', examplePrompts: [], resumed: true, entryCount: 0},
+    {type: 'entry_upsert', index: 0, entry: {role: 'user', content: 'hello', timestamp: cursor.updatedAt}},
+    {type: 'entry_delta', index: 1, delta: 'hi'},
+    {type: 'entry_commit', index: 1},
+    {type: 'entry_skip', index: 2},
+    {type: 'stream_end'},
+    {type: 'pong', timestamp: 1},
