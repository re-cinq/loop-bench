+it('reports unavailable history explicitly and contains store failures without closing the socket (specs/hal-engine-conversation-list/spec.md#38)', async () => {
+  const memory = new InMemorySessionStore();
+  const mongo = new MongoClient('mongodb://127.0.0.1:1/private-history', {serverSelectionTimeoutMS: 50});
+  const collection = mongo.db().collection<MongoSessionDocument>('private-conversations');
+  await mongo.close();
+  const failedStore = new MongoSessionStore({collection});
+  const legacyCollection = {
+    findOne: collection.findOne.bind(collection),
+    updateOne: collection.updateOne.bind(collection),
+    deleteOne: collection.deleteOne.bind(collection),
+    deleteMany: collection.deleteMany.bind(collection),
+    countDocuments: collection.countDocuments.bind(collection),
+  };
+  const cannotList = new MongoSessionStore({collection: legacyCollection});
+  const outcomes: Array<{case: string; frames: Frame[]}> = [];
+  let failedSessionId: string | undefined;
+  const cases = [
+    {name: 'default off', store: memory, history: undefined},
+    {name: 'explicit off', store: memory, history: {enabled: false}},
+    {name: 'legacy store', store: basicStore(memory), history: {enabled: true}},
+    {
+      name: 'collection without find',
+      store: {...basicStore(memory), listFor: cannotList.listFor.bind(cannotList)},
+      history: {enabled: true},
+    },
+    {
+      name: 'closed database',
+      store: {...basicStore(memory), listFor: failedStore.listFor.bind(failedStore)},
+      history: {enabled: true},
+    },
+  ];
+  for (const scenario of cases) {
+    const client = await open(await start(scenario.store, scenario.history));
+    const frames = await client.request({type: 'list_conversations'});
+    outcomes.push({case: scenario.name, frames});
+    expect(client.socket.readyState).toBe(WebSocket.OPEN);
+    if (scenario.name === 'closed database') {
+      failedSessionId = client.frames[0].sessionId;
+      expect(JSON.stringify(frames)).not.toMatch(
+        /Mongo|private-history|private-conversations|127\.0\.0\.1|closed|connect/i
+      );
+    }
+  }
+  expect(outcomes).toEqual(
+    cases.map((scenario, index) => ({
+      case: scenario.name,
+      frames: [{type: 'error', code: index === 4 ? 'SERVER_ERROR' : 'UNSUPPORTED', message: expect.any(String)}],
+    }))
+  );
+  const unsupported = await cannotList.listFor('owner').catch((error: unknown) => error);
+  expect(unsupported).toBeInstanceOf(Error);
+  expect((unsupported as Error).constructor).toBe(Reflect.get(publicApi, 'StoreCannotList'));
+  expect(errors).toEqual(expect.arrayContaining([expect.objectContaining({sessionId: failedSessionId})]));
+  expect(JSON.stringify(errors)).not.toMatch(/credential|private-history|private-conversations/);
+  await start(memory, {enabled: true}, undefined, false);
+  expect(JSON.stringify(warnings)).toMatch(/history/i);
+  expect(JSON.stringify(warnings)).toMatch(/resume/i);
