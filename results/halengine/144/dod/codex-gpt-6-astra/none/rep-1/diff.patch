diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..58e6c4f
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,300 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {MongoClient} from 'mongodb';
+import {WebSocket} from 'ws';
+import {createHalEngine} from '../config.js';
+import type {HalEngineConfig, HalEngine} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {MongoSessionStore} from '../infrastructure/stores/mongo/mongoSessionStore.js';
+import type {MongoSessionDocument} from '../infrastructure/stores/mongo/mongoSessionDocument.js';
+import type {SessionStore, SessionListOptions} from '../types/sessionStore.js';
+import {setLogger} from '../shared/logger.js';
+import type {IncomingMessage, OutgoingMessage} from '../types/messages.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+
+interface Row {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+interface Frame {
+  type: string;
+  code?: string;
+  message?: string;
+  sessionId?: string;
+  resumed?: boolean;
+  conversations?: Row[];
+  entry?: unknown;
+}
+const engines: HalEngine[] = [];
+const sockets: WebSocket[] = [];
+const logs: unknown[] = [];
+const errors: unknown[] = [];
+
+beforeEach(() => {
+  logs.length = 0;
+  errors.length = 0;
+  const record = (category: string, message: string, fields?: Record<string, unknown>) =>
+    void logs.push({category, message, ...fields});
+  setLogger({
+    debug: record,
+    info: record,
+    warn: record,
+    error: (category, message, fields) => {
+      errors.push({category, message, ...fields});
+      record(category, message, fields);
+    },
+  });
+});
+afterEach(async () => {
+  const closed = engines.flatMap(engine => [...engine.wss.clients].map(socket => once(socket, 'close')));
+  for (const socket of sockets.splice(0)) socket.terminate();
+  await Promise.all(closed);
+  for (const engine of engines.splice(0)) await engine.stop();
+  setLogger();
+});
+
+async function start(
+  session: SessionStore,
+  history?: {enabled: boolean},
+  hooks?: NonNullable<HalEngineConfig['orchestrator']>['hooks'],
+  resume = true
+) {
+  const transport = {port: 0, history, resume: {enabled: resume}};
+  const engine = createHalEngine({
+    provider: {type: 'mock'},
+    prompt: {identity: 'Answer briefly.'},
+    auth: {ws: async () => ({id: 'owner'})},
+    session,
+    transport,
+    orchestrator: {hooks},
+  });
+  engines.push(engine);
+  await engine.start();
+  return `ws://127.0.0.1:${(engine.server.address() as AddressInfo).port}/hal/ws`;
+}
+
+async function connect(url: string) {
+  const socket = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'credential']);
+  sockets.push(socket);
+  const frames: Frame[] = [];
+  socket.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  await until(() => frames.some(frame => frame.type === 'connected'));
+  return {socket, frames};
+}
+
+async function until(check: () => boolean) {
+  for (let i = 0; i < 200 && !check(); i++) await new Promise(resolve => setTimeout(resolve, 5));
+  expect(check()).toBe(true);
+}
+
+async function request(peer: Awaited<ReturnType<typeof connect>>, payload: unknown) {
+  const offset = peer.frames.length;
+  peer.socket.send(JSON.stringify(payload));
+  await until(() => peer.frames.slice(offset).some(frame => ['error', 'conversation_list'].includes(frame.type)));
+  peer.socket.send(JSON.stringify({type: 'ping', timestamp: 1}));
+  await until(() => peer.frames.slice(offset).some(frame => frame.type === 'pong'));
+  return peer.frames.slice(offset).filter(frame => frame.type !== 'pong');
+}
+
+function legacyStore(inner: InMemorySessionStore): SessionStore {
+  return {
+    create: (...args) => inner.create(...args),
+    get: id => inner.get(id),
+    delete: id => inner.delete(id),
+    clear: () => inner.clear(),
+    count: () => inner.count(),
+  };
+}
+
+// @spec specs/hal-engine-conversation-list/spec.md#37
+it('validates history limits and composite cursors independently of configuration', () => {
+  const existingIncoming = [
+    {type: 'user_message', content: 'hello'},
+    {type: 'ping', timestamp: 1},
+  ] satisfies IncomingMessage[];
+  const existingOutgoing = [
+    {type: 'connected', sessionId: 'a', message: 'connected', examplePrompts: []},
+    {type: 'entry_upsert', index: 0, entry: {role: 'user', content: 'hello', timestamp: '2026-10-01T00:00:00.000Z'}},
+    {type: 'entry_delta', index: 1, delta: 'answer'},
+    {type: 'entry_commit', index: 1},
+    {type: 'entry_skip', index: 2},
+    {type: 'stream_end'},
+    {type: 'pong', timestamp: 1},
+    {type: 'error', code: 'SERVER_ERROR', message: 'failed'},
+  ] satisfies OutgoingMessage[];
+  expect(JSON.parse(JSON.stringify(existingOutgoing))).toEqual(existingOutgoing);
+  for (const data of existingIncoming) expect(validateMessage(data)).toEqual({valid: true, data});
+  const before = {updatedAt: '2026-10-01T00:00:00.000Z', sessionId: 'row'};
+  for (const fields of [{}, {limit: 1}, {limit: 200, before}]) {
+    expect(validateMessage({type: 'list_conversations', ...fields, userId: 'intruder'})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations', ...fields},
+    });
+  }
+  for (const limit of [0, 201, 1.5, '10', null]) {
+    expect(validateMessage({type: 'list_conversations', limit})).toEqual({
+      valid: false,
+      error: expect.stringMatching(/limit/i),
+    });
+  }
+  for (const cursor of [
+    'not a date',
+    before.updatedAt,
+    {},
+    {updatedAt: before.updatedAt},
+    {sessionId: 'row'},
+    {...before, updatedAt: 'not a date'},
+    {...before, sessionId: 12},
+    null,
+  ]) {
+    expect(validateMessage({type: 'list_conversations', before: cursor})).toEqual({
+      valid: false,
+      error: expect.stringMatching(/before/i),
+    });
+  }
+});
+
+// @spec specs/hal-engine-conversation-list/spec.md#38
+it('lists only the socket owner with wire dates, pages ties, and resumes a listed conversation', async () => {
+  const store = new InMemorySessionStore();
+  const calls: Array<[string | number, SessionListOptions | undefined]> = [];
+  const observed: SessionStore = {
+    ...legacyStore(store),
+    lookup: id => store.lookup(id),
+    listFor: (userId, options) => {
+      calls.push([userId, options]);
+      return store.listFor(userId, options);
+    },
+  };
+  const timestamp = new Date(Date.now() + 60_000).toISOString();
+  for (const id of ['a', 'b', 'c']) {
+    store.create(id, 'owner', {authHeaders: {Authorization: 'secret'}}).entries.push({
+      role: 'user',
+      content: `private ${id}`,
+      timestamp: id === 'a' ? new Date(Date.parse(timestamp) - 30_000).toISOString() : timestamp,
+    });
+  }
+  store.create('foreign', 'other').entries.push({role: 'user', content: 'foreign secret', timestamp});
+  const base = await start(observed, {enabled: true});
+  const peer = await connect(`${base}?sessionId=a`);
+  expect(peer.frames.map(frame => frame.type)).toEqual(['connected', 'entry_upsert']);
+  const response = await request(peer, {type: 'list_conversations', userId: 'other'});
+  const expected = JSON.parse(JSON.stringify(store.listFor('owner'))) as Row[];
+  expect(response).toEqual([{type: 'conversation_list', conversations: expected}]);
+  expect(expected.map(row => row.sessionId)).toEqual(['c', 'b', 'a']);
+  expect(calls).toEqual([['owner', {limit: undefined, before: undefined}]]);
+  for (const row of response[0].conversations ?? []) {
+    expect(Object.keys(row).sort()).toEqual(['createdAt', 'entryCount', 'sessionId', 'updatedAt']);
+    expect(new Date(row.createdAt).toISOString()).toBe(row.createdAt);
+    expect(new Date(row.updatedAt).toISOString()).toBe(row.updatedAt);
+  }
+  const seen: Row[] = [];
+  let before: {updatedAt: string; sessionId: string} | undefined;
+  for (let i = 0; i < 4; i++) {
+    const page = await request(peer, {type: 'list_conversations', limit: 1, before});
+    expect(page).toEqual([{type: 'conversation_list', conversations: expected.slice(i, i + 1)}]);
+    expect(calls.at(-1)).toEqual(['owner', {limit: 1, before}]);
+    seen.push(...(page[0].conversations ?? []));
+    const row = seen.at(-1);
+    if (row) before = {updatedAt: row.updatedAt, sessionId: row.sessionId};
+  }
+  expect(seen).toEqual(expected);
+  const resumed = await connect(`${base}?sessionId=${seen[0].sessionId}`);
+  resumed.socket.send(JSON.stringify({type: 'ping', timestamp: 2}));
+  await until(() => resumed.frames.some(frame => frame.type === 'pong'));
+  expect(resumed.frames[0]).toMatchObject({type: 'connected', sessionId: 'c', resumed: true, entryCount: 1});
+  expect(resumed.frames[1]).toMatchObject({type: 'entry_upsert', index: 0, entry: store.get('c')?.entries[0]});
+  const fresh = await connect(base);
+  const freshList = await request(fresh, {type: 'list_conversations'});
+  expect(freshList[0].conversations).toContainEqual(
+    expect.objectContaining({sessionId: fresh.frames[0].sessionId, entryCount: 0})
+  );
+});
