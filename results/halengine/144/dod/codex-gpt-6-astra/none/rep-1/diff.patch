+// @spec specs/hal-engine-conversation-list/spec.md#39
+it('refuses disabled history and stores without listing with UNSUPPORTED', async () => {
+  for (const [history, missing] of [
+    [undefined, false],
+    [{enabled: false}, false],
+    [{enabled: true}, true],
+  ] as const) {
+    const inner = new InMemorySessionStore();
+    inner.create('existing', 'owner');
+    const peer = await connect(await start(missing ? legacyStore(inner) : inner, history));
+    const response = await request(peer, {type: 'list_conversations'});
+    expect(response).toEqual([{type: 'error', code: 'UNSUPPORTED', message: expect.any(String)}]);
+    expect(peer.socket.readyState).toBe(WebSocket.OPEN);
+  }
+});
