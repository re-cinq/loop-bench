+it('reports real store failures safely and distinguishes a collection without find', async () => {
+  const client = new MongoClient('mongodb://127.0.0.1:1');
+  const collection = client.db('history').collection<MongoSessionDocument>('sessions');
+  await client.close();
+  const withoutFind = {
+    findOne: collection.findOne.bind(collection),
+    updateOne: collection.updateOne.bind(collection),
+    deleteOne: collection.deleteOne.bind(collection),
+    deleteMany: collection.deleteMany.bind(collection),
+    countDocuments: collection.countDocuments.bind(collection),
+  };
+  for (const [source, code] of [
+    [collection, 'SERVER_ERROR'],
+    [withoutFind, 'UNSUPPORTED'],
+  ] as const) {
+    const database = new MongoSessionStore({collection: source});
+    const store = {...legacyStore(new InMemorySessionStore()), listFor: database.listFor.bind(database)};
+    const peer = await connect(await start(store, {enabled: true}));
+    errors.length = 0;
+    const response = await request(peer, {type: 'list_conversations'});
+    expect(response).toEqual([{type: 'error', code, message: expect.any(String)}]);
+    expect(JSON.stringify(response)).not.toMatch(/MongoNotConnectedError|127\.0\.0\.1|credential/);
+    expect(peer.socket.readyState).toBe(WebSocket.OPEN);
+    if (code === 'SERVER_ERROR') {
+      expect(errors).toContainEqual(expect.objectContaining({sessionId: peer.frames[0].sessionId}));
+    }
+    expect(JSON.stringify(logs)).not.toContain('credential');
+  }
+});
