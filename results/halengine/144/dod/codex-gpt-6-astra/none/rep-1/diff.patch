+// @spec specs/hal-engine-conversation-list/spec.md#41
+it('answers history while a real turn holds the session lock before stream_end', async () => {
+  let release = () => {};
+  let entered = false;
+  const gate = new Promise<void>(resolve => {
+    release = resolve;
+  });
+  const peer = await connect(
+    await start(
+      new InMemorySessionStore(),
+      {enabled: true},
+      {
+        afterModelResponse: async () => {
+          entered = true;
+          await gate;
+        },
+      }
+    )
+  );
+  try {
+    peer.socket.send(JSON.stringify({type: 'user_message', content: 'hello'}));
+    await until(() => entered && peer.frames.some(frame => frame.type === 'entry_delta'));
+    const response = await request(peer, {type: 'list_conversations'});
+    expect(response).toEqual([{type: 'conversation_list', conversations: expect.any(Array)}]);
+    expect(peer.frames.some(frame => frame.type === 'stream_end')).toBe(false);
+    release();
+    await until(() => peer.frames.some(frame => frame.type === 'stream_end'));
+    const listIndex = peer.frames.findIndex(frame => frame.type === 'conversation_list');
+    expect(listIndex).toBeLessThan(peer.frames.findIndex(frame => frame.type === 'stream_end'));
+    expect(peer.frames.filter(frame => frame.type === 'conversation_list')).toHaveLength(1);
+    expect(peer.frames.filter(frame => frame.type === 'stream_end')).toHaveLength(1);
+    peer.socket.close();
+    await once(peer.socket, 'close');
+  } finally {
+    release();
+  }
+});