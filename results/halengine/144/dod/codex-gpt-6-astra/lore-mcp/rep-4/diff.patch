+// spec: specs/hal-engine-conversation-list/spec.md#39
+it('distinguishes a real store failure from a collection unable to list without leaking details or closing the socket', async () => {
+  const client = new MongoClient('mongodb://127.0.0.1:1/private-history');
+  const collection = client.db().collection<MongoSessionDocument>('private-conversations');
+  await client.close();
+  const cannotList = new MongoSessionStore({
+    collection: {
+      findOne: collection.findOne.bind(collection),
+      updateOne: collection.updateOne.bind(collection),
+      deleteOne: collection.deleteOne.bind(collection),
+      deleteMany: collection.deleteMany.bind(collection),
+      countDocuments: collection.countDocuments.bind(collection),
+    },
+  });
+  const failed = new MongoSessionStore({collection});
+  for (const [listing, code] of [
+    [failed, 'SERVER_ERROR'],
+    [cannotList, 'UNSUPPORTED'],
+  ] as const) {
+    const store = {...originalMembers(new InMemorySessionStore()), listFor: listing.listFor.bind(listing)};
+    const peer = await connect(await start(store, {enabled: true}));
+    const result = await request(peer, {type: 'list_conversations', userId: 'private-user-content'});
+    expect(result).toEqual([{type: 'error', code, message: expect.any(String)}]);
+    expect(JSON.stringify(result)).not.toMatch(/Mongo|connect|find|private-|127\.0\.0\.1/i);
+    expect(peer.socket.readyState).toBe(WebSocket.OPEN);
+    const failures = logs.filter(
+      line => ['warn', 'error'].includes(line.level) && line.fields?.sessionId === peer.frames[0].sessionId
+    );
+    expect(failures.length).toBeGreaterThan(0);
+    expect(JSON.stringify(failures)).not.toMatch(/private-user-content|credential-not-for-history/);
+  }
+  const capabilityError: unknown = await cannotList.listFor('owner').catch((error: unknown) => error);
+  const exported = publicAPI as unknown as Record<string, unknown>;
+  expect(typeof exported.StoreCannotList).toBe('function');
+  expect(capabilityError).toBeInstanceOf(exported.StoreCannotList as new (...args: never[]) => Error);
+});
