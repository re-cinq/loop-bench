@@ -0,0 +1,312 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {MongoClient} from 'mongodb';
+import {WebSocket} from 'ws';
+import {createHalEngine} from '../config.js';
+import * as publicAPI from '../index.js';
+import type {HalEngineConfig} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {MongoSessionStore} from '../infrastructure/stores/mongo/mongoSessionStore.js';
+import type {MongoSessionDocument} from '../infrastructure/stores/mongo/mongoSessionDocument.js';
+import type {SessionListOptions, SessionStore, SessionSummary} from '../types/sessionStore.js';
+import type {IncomingMessage, OutgoingMessage} from '../types/messages.js';
+import {setLogger} from '../shared/logger.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+
+type Row = Omit<SessionSummary, 'createdAt' | 'updatedAt'> & {createdAt: string; updatedAt: string};
+type Frame = {type: string; sessionId?: string; conversations?: Row[]; code?: string; message?: string};
+const engines: ReturnType<typeof createHalEngine>[] = [];
+const clients: WebSocket[] = [];
+const logs: Array<{level: string; message: string; fields?: Record<string, unknown>}> = [];
+
+class ObservedStore extends InMemorySessionStore {
+  readonly requests: unknown[][] = [];
+  override listFor(userId: string | number, options?: SessionListOptions): SessionSummary[] {
+    this.requests.push([userId, options]);
+    return super.listFor(userId, options);
+  }
+}
+
+beforeEach(() => {
+  logs.length = 0;
+  const record = (level: string) => (_category: string, message: string, fields?: Record<string, unknown>) => {
+    logs.push({level, message, fields});
+  };
+  setLogger({debug: record('debug'), info: record('info'), warn: record('warn'), error: record('error')});
+});
+
+afterEach(async () => {
+  for (const client of clients.splice(0)) client.terminate();
+  for (const engine of engines.splice(0)) {
+    await waitFor(() => engine.wss.clients.size === 0);
+    await engine.stop();
+  }
+  setLogger();
+});
+
+async function start(
+  session: SessionStore,
+  history?: {enabled: boolean},
+  resume = true,
+  hooks?: NonNullable<HalEngineConfig['orchestrator']>['hooks']
+) {
+  // A variable preserves today's config assignability while exercising the additive option at runtime.
+  const transport = {port: 0, resume: {enabled: resume}, history};
+  const engine = createHalEngine({
+    provider: {type: 'bedrock', region: 'eu-central-1', modelId: 'unused', maxTokens: 1},
+    prompt: {identity: 'Conversation list acceptance'},
+    auth: {ws: async () => ({id: 'owner'})},
+    session,
+    transport,
+    orchestrator: {hooks},
+  });
+  engines.push(engine);
+  await engine.start();
+  const {port} = engine.server.address() as AddressInfo;
+  return `ws://127.0.0.1:${port}/hal/ws`;
+}
+
+async function connect(url: string) {
+  const socket = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'credential-not-for-history']);
+  clients.push(socket);
+  const frames: Frame[] = [];
+  socket.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  await waitFor(() => frames.some(frame => frame.type === 'connected'));
+  return {socket, frames};
+}
+
+async function waitFor(check: () => boolean) {
+  const deadline = Date.now() + 1500;
+  while (!check() && Date.now() < deadline) await new Promise(resolve => setTimeout(resolve, 5));
+  expect(check()).toBe(true);
+}
+
+async function request(peer: Awaited<ReturnType<typeof connect>>, payload: unknown) {
+  const offset = peer.frames.length;
+  peer.socket.send(JSON.stringify(payload));
+  await waitFor(() => peer.frames.slice(offset).some(frame => ['conversation_list', 'error'].includes(frame.type)));
+  peer.socket.send(JSON.stringify({type: 'ping', timestamp: 144}));
+  await waitFor(() => peer.frames.slice(offset).some(frame => frame.type === 'pong'));
+  return peer.frames.slice(offset).filter(frame => frame.type !== 'pong');
+}
+
+function originalMembers(store: InMemorySessionStore): SessionStore {
+  return {
+    create: store.create.bind(store),
+    get: store.get.bind(store),
+    delete: store.delete.bind(store),
+    count: store.count.bind(store),
+    clear: store.clear.bind(store),
+  };
+}
+
+// spec: specs/hal-engine-websocket-protocol/spec.md#77
+it('validates history frames and composite cursors without changing existing messages', () => {
+  const before = {updatedAt: '2026-11-01T00:00:00.000Z', sessionId: 'last-row'};
+  for (const frame of [
+    {type: 'list_conversations'},
+    {type: 'list_conversations', limit: 1},
+    {type: 'list_conversations', limit: 200, before},
+  ]) {
+    expect(validateMessage(frame)).toEqual({valid: true, data: frame});
+  }
+  for (const limit of [0, 201, 1.5, '10', null]) {
+    expect(validateMessage({type: 'list_conversations', limit})).toEqual({
+      valid: false,
+      error: expect.stringMatching(/limit/i),
+    });
+  }
+  for (const cursor of [
+    'not a date',
+    before.updatedAt,
+    null,
+    {},
+    {updatedAt: before.updatedAt},
+    {sessionId: 'x'},
+    {updatedAt: 'not a date', sessionId: 'x'},
+    {updatedAt: 123, sessionId: 'x'},
+    {...before, sessionId: 42},
+  ]) {
+    expect(validateMessage({type: 'list_conversations', before: cursor})).toEqual({
+      valid: false,
+      error: expect.stringMatching(/before/i),
+    });
+  }
+  const incoming: IncomingMessage[] = [
+    {type: 'user_message', content: 'hello'},
+    {type: 'ping', timestamp: 1},
+  ];
+  for (const frame of incoming) expect(validateMessage(frame)).toEqual({valid: true, data: frame});
+  const outgoing: OutgoingMessage[] = [
+    {type: 'connected', sessionId: 's', message: 'hello', examplePrompts: []},
+    {type: 'connected', sessionId: 's', message: 'hello', examplePrompts: [], resumed: true, entryCount: 0},
+    {type: 'connected', sessionId: 's', message: 'hello', examplePrompts: [], resumed: false, resumeFailure: 'unknown'},
+    {type: 'entry_upsert', index: 0, entry: {role: 'user', content: 'hello', timestamp: before.updatedAt}},
+    {type: 'entry_delta', index: 0, delta: 'hello'},
+    {type: 'entry_commit', index: 0},
+    {type: 'entry_skip', index: 0},
+    {type: 'error', code: 'SERVER_ERROR', message: 'failed'},
+    {type: 'pong', timestamp: 1},
+    {type: 'stream_end'},
+  ];
+  expect(JSON.parse(JSON.stringify(outgoing))).toEqual(outgoing);
+});
+
+// spec: specs/hal-engine-conversation-list/spec.md#37
+it('lists only the authenticated owner with wire dates, pages ties, and resumes a listed conversation', async () => {
+  const store = new ObservedStore();
+  const stamp = new Date(Date.now() + 60_000).toISOString();
+  for (const id of ['a', 'b']) {
+    store.create(id, 'owner', {authHeaders: {Authorization: 'private-credential'}}).entries.push({
+      role: 'user',
+      content: `private-content-${id}`,
+      timestamp: stamp,
+    });
+  }
+  store.create('foreign', 'another-user');
+  const base = await start(store, {enabled: true});
+  const peer = await connect(base);
+  expect(peer.frames.map(frame => frame.type)).toEqual(['connected']);
