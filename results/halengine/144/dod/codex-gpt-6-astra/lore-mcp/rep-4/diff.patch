+// spec: specs/hal-engine-conversation-list/spec.md#40
+it('answers history before the pending turn releases its session lock', async () => {
+  let release!: () => void;
+  const gate = new Promise<void>(resolve => {
+    release = resolve;
+  });
+  let entered = false;
+  const peer = await connect(
+    await start(new InMemorySessionStore(), {enabled: true}, true, {
+      beforeModelResponse: async (_session, prompt) => {
+        entered = true;
+        await gate;
+        return prompt;
+      },
+    })
+  );
+  try {
+    peer.socket.send(JSON.stringify({type: 'user_message', content: 'private pending turn'}));
+    await waitFor(() => entered);
+    const result = await request(peer, {type: 'list_conversations'});
+    expect(result).toEqual([
+      {
+        type: 'conversation_list',
+        conversations: [
+          {
+            sessionId: peer.frames[0].sessionId,
+            createdAt: expect.any(String),
+            updatedAt: expect.any(String),
+            entryCount: 1,
+          },
+        ],
+      },
+    ]);
+    expect(peer.frames.some(frame => frame.type === 'stream_end')).toBe(false);
+  } finally {
+    peer.socket.close();
+    await once(peer.socket, 'close');
+    // Wait for the server's close too: the client close alone does not prove the turn is aborted.
+    await waitFor(() =>
+      logs.some(line => line.message === 'disconnected' && line.fields?.sessionId === peer.frames[0].sessionId)
+    );
+    release();
+    await waitFor(() =>
+      logs.some(
+        line =>
+          line.message === 'turn abandoned: its socket closed' && line.fields?.sessionId === peer.frames[0].sessionId
+      )
+    );
+  }
+});