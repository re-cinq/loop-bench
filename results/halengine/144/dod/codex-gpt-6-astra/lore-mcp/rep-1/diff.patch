+  const oldCollection = {
+    findOne: collection.findOne.bind(collection),
+    updateOne: collection.updateOne.bind(collection),
+    deleteOne: collection.deleteOne.bind(collection),
+    deleteMany: collection.deleteMany.bind(collection),
+    countDocuments: collection.countDocuments.bind(collection),
+  };
+  const cannotList = new MongoSessionStore({collection: oldCollection});
+  const cases = [
+    {store: memory, history: undefined},
+    {store: memory, history: {enabled: false}},
+    {store: legacyStore(memory), history: {enabled: true}},
+    {store: {...legacyStore(memory), listFor: cannotList.listFor.bind(cannotList)}, history: {enabled: true}},
