+// spec: specs/hal-engine-conversation-list/spec.md#41
+it('answers history while the same session has an unfinished turn holding its lock', async () => {
+  let release!: () => void;
+  let entered!: () => void;
+  const held = new Promise<void>(resolve => {
+    release = resolve;
+  });
+  const started = new Promise<void>(resolve => {
+    entered = resolve;
+  });
+  const {engine, url} = await start(
+    new InMemorySessionStore(),
+    {enabled: true},
+    {
+      hooks: {
+        beforeModelResponse: async (_session, prompt) => {
+          entered();
+          await held;
+          return prompt;
+        },
+      },
+    }
+  );
+  const client = await connect(url);
+  client.socket.send(JSON.stringify({type: 'user_message', content: 'hold this turn'}));
+  await started;
+  await client.until(() => client.frames.some(frame => frame.type === 'entry_upsert'));
+  try {
+    expect(await client.request({type: 'list_conversations'})).toEqual([
+      {type: 'conversation_list', conversations: expect.any(Array)},
+    ]);
+    expect(client.frames.some(frame => frame.type === 'stream_end')).toBe(false);
+  } finally {
+    const serverSocket = [...engine.wss.clients][0];
+    const closed = once(serverSocket, 'close');
+    client.socket.terminate();
+    await closed;
+    release();
+  }
