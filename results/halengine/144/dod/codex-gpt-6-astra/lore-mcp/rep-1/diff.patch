+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,269 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {MongoClient} from 'mongodb';
+import {WebSocket} from 'ws';
+import {createHalEngine, type HalEngineConfig, type HalEngine} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {MongoSessionStore} from '../infrastructure/stores/mongo/mongoSessionStore.js';
+import type {MongoSessionDocument} from '../infrastructure/stores/mongo/mongoSessionDocument.js';
+import type {SessionListOptions, SessionStore} from '../types/sessionStore.js';
+import {setLogger} from '../shared/logger.js';
+import {validateMessage} from './ws/validation.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+
+interface Row {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+interface Frame {
+  type: string;
+  code?: string;
+  sessionId?: string;
+  conversations?: Row[];
+  [key: string]: unknown;
+}
+const engines: HalEngine[] = [];
+const sockets: WebSocket[] = [];
+const logs: Array<{level: string; fields?: Record<string, unknown>; message: string}> = [];
+beforeEach(() => {
+  logs.length = 0;
+  const sink = (level: string) => (_category: string, message: string, fields?: Record<string, unknown>) => {
+    logs.push({level, message, fields});
+  };
+  setLogger({debug: sink('debug'), info: sink('info'), warn: sink('warn'), error: sink('error')});
+});
+afterEach(async () => {
+  for (const socket of sockets.splice(0)) socket.terminate();
+  for (const engine of engines.splice(0)) await engine.stop();
+  setLogger();
+});
+
+async function start(session: SessionStore, history?: {enabled: boolean}, hooks?: HalEngineConfig['orchestrator']) {
+  // A variable permits the additive option to reach today's real factory without casting away its other types.
+  const transport = {port: 0, resume: {enabled: true}, history};
+  const engine = createHalEngine({
+    provider: {type: 'bedrock', region: 'eu-central-1', modelId: 'unused', maxTokens: 1},
+    prompt: {identity: 'Conversation list acceptance'},
+    auth: {ws: async () => ({id: 'owner'})},
+    session,
+    transport,
+    orchestrator: hooks,
+  });
+  engines.push(engine);
+  await engine.start();
+  return {engine, url: `ws://127.0.0.1:${(engine.server.address() as AddressInfo).port}/hal/ws`};
+}
+
+async function connect(url: string) {
+  const socket = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'acceptance-credential']);
+  sockets.push(socket);
+  const frames: Frame[] = [];
+  socket.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  async function until(predicate: () => boolean) {
+    for (let i = 0; i < 100 && !predicate(); i++) await new Promise(resolve => setTimeout(resolve, 10));
+    expect(predicate()).toBe(true);
+  }
+  await until(() => frames.some(frame => frame.type === 'connected'));
+  async function request(payload: unknown): Promise<Frame[]> {
+    const from = frames.length;
+    socket.send(JSON.stringify(payload));
+    await until(() => frames.slice(from).some(frame => ['conversation_list', 'error', 'pong'].includes(frame.type)));
+    // A pong is a barrier for any extra stream_end sent after the response.
+    if ((payload as {type: string}).type !== 'ping') {
+      socket.send(JSON.stringify({type: 'ping', timestamp: 91}));
+      await until(() => frames.slice(from).some(frame => frame.type === 'pong'));
+    }
+    return frames.slice(from).filter(frame => frame.type !== 'pong');
+  }
+  return {socket, frames, until, request};
+}
+
+function legacyStore(store: InMemorySessionStore): SessionStore {
+  return {
+    create: store.create.bind(store),
+    get: store.get.bind(store),
+    delete: store.delete.bind(store),
+    clear: store.clear.bind(store),
+    count: store.count.bind(store),
+  };
+}
+
+// spec: specs/hal-engine-conversation-list/spec.md#37
+it('validates history limits and complete composite cursors independently of configuration', () => {
+  const before = {updatedAt: '2026-10-01T00:00:00.000Z', sessionId: 'row'};
+  for (const frame of [
+    {type: 'list_conversations'},
+    {type: 'list_conversations', limit: 1, before},
+    {type: 'list_conversations', limit: 200},
+  ]) {
+    expect(validateMessage(frame)).toEqual({valid: true, data: frame});
+  }
+  for (const limit of [0, 201, 1.5, '10', null]) {
+    expect(validateMessage({type: 'list_conversations', limit})).toEqual({
+      valid: false,
+      error: expect.stringMatching(/limit/i),
+    });
+  }
+  for (const cursor of [
+    'not a date',
+    before.updatedAt,
+    {},
+    {updatedAt: before.updatedAt},
+    {sessionId: 'row'},
+    {...before, updatedAt: 'not a date'},
+    {...before, sessionId: 12},
+    null,
+  ]) {
+    expect(validateMessage({type: 'list_conversations', before: cursor})).toEqual({
+      valid: false,
+      error: expect.stringMatching(/before/i),
+    });
+  }
+  expect(validateMessage({type: 'list_conversations', userId: 'other'})).toEqual({
+    valid: true,
+    data: {type: 'list_conversations'},
+  });
+});
+
+// spec: specs/hal-engine-conversation-list/spec.md#38
+it('lists only the authenticated owner with wire dates, pages ties, and resumes a listed conversation', async () => {
+  const memory = new InMemorySessionStore();
+  const stamp = new Date(Date.now() + 1000).toISOString();
+  for (const id of ['a', 'b', 'c'])
+    memory.create(id, 'owner').entries.push({role: 'user', content: `private ${id}`, timestamp: stamp});
+  memory.create('foreign', 'other').entries.push({role: 'user', content: 'foreign secret', timestamp: stamp});
+  const calls: Array<{userId: string | number; options?: SessionListOptions}> = [];
+  const store: SessionStore = {
+    ...legacyStore(memory),
+    listFor(userId, options) {
+      calls.push({userId, options});
+      return memory.listFor(userId, options);
+    },
+  };
+  const {url} = await start(store, {enabled: true});
+  const client = await connect(`${url}?sessionId=a`);
+  await client.request({type: 'ping', timestamp: 1});
+  expect(client.frames.some(frame => frame.type === 'conversation_list')).toBe(false);
+  const expected = JSON.parse(JSON.stringify(memory.listFor('owner'))) as Row[];
+  expect(await client.request({type: 'list_conversations', userId: 'other'})).toEqual([
+    {type: 'conversation_list', conversations: expected},
+  ]);
+  expect(calls).toEqual([{userId: 'owner', options: {limit: undefined, before: undefined}}]);
+  expect(expected.map(row => row.sessionId)).toEqual(['c', 'b', 'a']);
+  const before = {updatedAt: expected[0].updatedAt, sessionId: expected[0].sessionId};
+  expect(await client.request({type: 'list_conversations', limit: 1, before})).toEqual([
+    {type: 'conversation_list', conversations: [expected[1]]},
+  ]);
+  expect(calls.at(-1)).toEqual({userId: 'owner', options: {limit: 1, before}});
