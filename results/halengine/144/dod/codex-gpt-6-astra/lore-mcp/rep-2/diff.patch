index c9ee424..f23b209 100644
--- a/specs/hal-engine-conversation-list/spec.md
+++ b/specs/hal-engine-conversation-list/spec.md
@@ -68,3 +68,10 @@ Resume gets a client back into one conversation: the id it names, or the user's
 ## When the store cannot answer
 
 - A store whose collection fails rejects rather than answering a partial or empty list: what to show a user who may have conversations is the caller's decision, and an empty history is not a safe guess ([validated by: rejects rather than answering a partial list when the collection fails](../../src/infrastructure/stores/mongo/mongoConversationList.test.ts#L225)).
+
+## Listing over the WebSocket (#144)
+
+- The static validator accepts `list_conversations` with an optional integer `limit` from 1 through 200 and an optional composite `before: {updatedAt, sessionId}` cursor whose time is a parseable string and whose id is a string, and rejects malformed fields with an error naming the field ([validated by: validates list requests and rejects malformed limits and composite cursors](../../src/transport/conversationList.acceptance.test.ts#L141)).
+- With `transport.history.enabled`, a request receives exactly one `conversation_list` containing only the authenticated connection user’s metadata, newest first with ISO times, ignoring a frame’s `userId`, forwarding pagination unchanged to `listFor`, including the current conversation, and allowing a listed id to be reopened through the existing resume and replay path without unsolicited lists or `stream_end` ([validated by: lists only the authenticated user metadata, pages tied rows and resumes a listed conversation](../../src/transport/conversationList.acceptance.test.ts#L197)).
+- History defaults off independently of resume and enabling history without resume warns at startup; disabled history, an absent `listFor` or a store unable to list returns `UNSUPPORTED`, whereas a failed store returns a sanitized `SERVER_ERROR`, leaves the socket usable and logs the session id without personal content instead of pretending the history is empty ([validated by: refuses disabled or unavailable history and sanitizes real store failures without closing the socket](../../src/transport/conversationList.acceptance.test.ts#L242)).
+- A history request receives its response while a turn on the same session still holds the lock, before that turn ends ([validated by: answers history while the same session turn holds the lock](../../src/transport/conversationList.acceptance.test.ts#L291)).
diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..481d81d
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,327 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {MongoClient} from 'mongodb';
+import {WebSocket} from 'ws';
+import {createHalEngine} from '../config.js';
+import type {HalEngine, HalEngineConfig} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {MongoSessionStore} from '../infrastructure/stores/mongo/mongoSessionStore.js';
+import type {CollectionLike} from '../infrastructure/stores/mongo/mongoDriverTypes.js';
+import type {MongoSessionDocument} from '../infrastructure/stores/mongo/mongoSessionDocument.js';
+import type {SessionListOptions, SessionStore} from '../types/sessionStore.js';
+import type {
+  IncomingMessage,
+  OutgoingMessage,
+  ConversationCursor,
+  ConversationSummary,
+  ListConversationsMessage,
+  ConversationListMessage,
+} from '../types/messages.js';
+import {validateMessage} from './ws/validation.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {setLogger} from '../shared/logger.js';
+
+interface Row {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+interface Frame {
+  type: string;
+  code?: string;
+  message?: string;
+  sessionId?: string;
+  resumed?: boolean;
+  conversations?: Row[];
+  entry?: unknown;
+}
+
+const engines: HalEngine[] = [];
+const clients: WebSocket[] = [];
+const logs: Array<{level: string; message: string; fields?: Record<string, unknown>}> = [];
+
+beforeEach(() => {
+  logs.length = 0;
+  const record = (level: string) => (_category: string, message: string, fields?: Record<string, unknown>) => {
+    logs.push({level, message, fields});
+  };
+  setLogger({debug: record('debug'), info: record('info'), warn: record('warn'), error: record('error')});
+});
+afterEach(async () => {
+  const closed = engines.flatMap(engine => [...engine.wss.clients].map(socket => once(socket, 'close')));
+  for (const client of clients.splice(0)) client.terminate();
+  await Promise.all(closed);
+  for (const engine of engines.splice(0)) await engine.stop();
+  setLogger();
+});
+
+// Records the boundary arguments while retaining the shipped store's real filtering and paging.
+class RecordedStore extends InMemorySessionStore {
+  readonly calls: Array<{userId: string | number; options?: SessionListOptions}> = [];
+  override listFor(userId: string | number, options?: SessionListOptions) {
+    this.calls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+async function start(
+  store: SessionStore,
+  enabled?: boolean,
+  hooks?: HalEngineConfig['orchestrator'],
+  resumeEnabled = true
+) {
+  const transport = {resume: {enabled: resumeEnabled}, ...(enabled === undefined ? {} : {history: {enabled}})};
+  const engine = createHalEngine({
+    provider: {type: 'bedrock', modelId: 'unused', region: 'eu-west-1', maxTokens: 1},
+    prompt: {identity: 'Conversation list acceptance'},
+    session: store,
+    transport,
+    auth: {ws: async () => ({id: 'owner'})},
+    orchestrator: hooks,
+  });
+  engines.push(engine);
+  await engine.start(0);
+  const {port} = engine.server.address() as AddressInfo;
+  return {engine, url: `ws://127.0.0.1:${port}/hal/ws`};
+}
+
+async function open(url: string) {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'credential']);
+  clients.push(client);
+  const frames: Frame[] = [];
+  client.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  await once(client, 'message');
+  await exchange(client, {type: 'ping', timestamp: 0});
+  return {client, frames};
+}
+
+async function waitFor(client: WebSocket, type: string): Promise<void> {
+  const controller = new AbortController();
+  const timer = setTimeout(() => controller.abort(), 2000);
+  try {
+    while (true) {
+      const [raw] = await once(client, 'message', {signal: controller.signal});
+      if ((JSON.parse(String(raw)) as Frame).type === type) return;
+    }
+  } finally {
+    clearTimeout(timer);
+  }
+}
+
+async function exchange(client: WebSocket, payload: unknown): Promise<Frame[]> {
+  const frames: Frame[] = [];
+  const record = (raw: Buffer) => frames.push(JSON.parse(String(raw)) as Frame);
+  client.on('message', record);
+  try {
+    const first = once(client, 'message', {signal: AbortSignal.timeout(2000)});
+    client.send(JSON.stringify(payload));
+    await first;
+    const barrier = waitFor(client, 'pong');
+    client.send(JSON.stringify({type: 'ping', timestamp: 99}));
+    await barrier;
+    return frames.filter(frame => frame.type !== 'pong');
+  } finally {
+    client.off('message', record);
+  }
+}
+
+// This adapter exposes real storage operations while deliberately exposing only the original store port.
+function originalPort(inner: InMemorySessionStore): SessionStore {
+  return {
+    create: inner.create.bind(inner),
+    get: inner.get.bind(inner),
+    delete: inner.delete.bind(inner),
+    count: inner.count.bind(inner),
+    clear: inner.clear.bind(inner),
+  };
+}
+
+// @spec specs/hal-engine-conversation-list/spec.md#36
+it('validates list requests and rejects malformed limits and composite cursors', () => {
+  const legacyIncoming: IncomingMessage[] = [
+    {type: 'user_message', content: 'hello'},
+    {type: 'ping', timestamp: 1},
+  ];
+  const legacyOutgoing: OutgoingMessage[] = [
+    {type: 'connected', sessionId: 's', message: 'hello', examplePrompts: []},
+    {type: 'entry_upsert', index: 0, entry: {role: 'user', content: 'hello', timestamp: '2026-11-03T10:00:00.000Z'}},
+    {type: 'entry_delta', index: 1, delta: 'hello'},
+    {type: 'entry_commit', index: 1},
+    {type: 'entry_skip', index: 2},
+    {type: 'error', code: 'SERVER_ERROR', message: 'Failed'},
+    {type: 'pong', timestamp: 1},
+    {type: 'stream_end'},
+  ];
+  expect(legacyIncoming.map(payload => validateMessage(payload).valid)).toEqual([true, true]);
+  expect(JSON.parse(JSON.stringify(legacyOutgoing))).toEqual(legacyOutgoing);
+  const before: ConversationCursor = {updatedAt: '2026-11-03T10:00:00.000Z', sessionId: 'older'};
+  const row: ConversationSummary = {...before, createdAt: before.updatedAt, entryCount: 0};
+  const request: ListConversationsMessage = {type: 'list_conversations', before};
+  const response: ConversationListMessage = {type: 'conversation_list', conversations: [row]};
+  const incoming: IncomingMessage = request;
+  const outgoing: OutgoingMessage = response;
+  expect(JSON.parse(JSON.stringify(outgoing))).toEqual(response);
+  expect(validateMessage(incoming)).toMatchObject({valid: true, data: request});
+  for (const payload of [
+    {type: 'list_conversations'},
+    {type: 'list_conversations', limit: 1, before},
+    {type: 'list_conversations', limit: 200},
+  ]) {
+    expect(validateMessage(payload)).toMatchObject({valid: true, data: payload});
+  }
+  for (const limit of [0, 201, 1.5, '10', null]) {
+    expect(validateMessage({type: 'list_conversations', limit})).toEqual({
+      valid: false,
+      error: expect.stringMatching(/limit/i),
+    });
+  }
+  for (const cursor of [
+    'not a date',
+    before.updatedAt,
+    null,
+    {},
+    {updatedAt: before.updatedAt},
+    {sessionId: 'older'},
+    {...before, updatedAt: 'invalid'},
+    {...before, sessionId: 1},
+  ]) {
+    expect(validateMessage({type: 'list_conversations', before: cursor})).toEqual({
+      valid: false,
+      error: expect.stringMatching(/before/i),
+    });
+  }
+});
+
+// @spec specs/hal-engine-conversation-list/spec.md#37
+it('lists only the authenticated user metadata, pages tied rows and resumes a listed conversation', async () => {
+  const store = new RecordedStore();
+  const timestamp = new Date().toISOString();
+  for (const [id, user] of [
+    ['a', 'owner'],
+    ['b', 'owner'],
+    ['c', 'owner'],
+    ['foreign', 'other'],
+  ]) {
+    store
+      .create(id, user, {authHeaders: {authorization: 'private credential'}})
+      .entries.push({role: 'user', content: `private ${id}`, timestamp});
+  }
+  const {url} = await start(store, true);
+  const {client, frames} = await open(`${url}?sessionId=c`);
+  expect(frames.some(frame => frame.type === 'conversation_list')).toBe(false);
+  const expected = JSON.parse(JSON.stringify(InMemorySessionStore.prototype.listFor.call(store, 'owner'))) as Row[];
+  expect(await exchange(client, {type: 'list_conversations', userId: 'other'})).toEqual([
+    {type: 'conversation_list', conversations: expected},
+  ]);
+  expect(expected.map(row => row.sessionId)).toEqual(['c', 'b', 'a']);
+  expect(store.calls).toEqual([{userId: 'owner', options: {limit: undefined, before: undefined}}]);
+  for (const row of expected) {
+    expect(Object.keys(row).sort()).toEqual(['createdAt', 'entryCount', 'sessionId', 'updatedAt']);
+    expect(new Date(row.createdAt).toISOString()).toBe(row.createdAt);
+    expect(new Date(row.updatedAt).toISOString()).toBe(row.updatedAt);
+  }
+  const before = {updatedAt: expected[0].updatedAt, sessionId: expected[0].sessionId};
+  const page = await exchange(client, {type: 'list_conversations', limit: 1, before});
+  expect(page).toEqual([{type: 'conversation_list', conversations: [expected[1]]}]);
+  expect(store.calls.at(-1)).toEqual({userId: 'owner', options: {limit: 1, before}});
+  const selected = page[0].conversations![0].sessionId;
+  const reopened = await open(`${url}?sessionId=${selected}`);
+  expect(reopened.frames[0]).toMatchObject({type: 'connected', sessionId: selected, resumed: true});
+  expect(reopened.frames.filter(frame => frame.type === 'entry_upsert').map(frame => frame.entry)).toEqual(
+    store.get(selected)!.entries
+  );
+  const fresh = await open(url);
+  const freshList = await exchange(fresh.client, {type: 'list_conversations'});
+  expect(freshList[0].conversations).toContainEqual(
+    expect.objectContaining({sessionId: fresh.frames[0].sessionId, entryCount: 0})
+  );
+});
+
+// @spec specs/hal-engine-conversation-list/spec.md#38
+it('refuses disabled or unavailable history and sanitizes real store failures without closing the socket', async () => {
+  const memory = new InMemorySessionStore();
+  const mongo = new MongoClient('mongodb://127.0.0.1:1/private-history');
+  await mongo.close();
+  const collection = mongo.db().collection('sessions') as unknown as CollectionLike<MongoSessionDocument>;
+  const legacyCollection = {
+    findOne: collection.findOne.bind(collection),
+    updateOne: collection.updateOne.bind(collection),
+    deleteOne: collection.deleteOne.bind(collection),
+    deleteMany: collection.deleteMany.bind(collection),
+    countDocuments: collection.countDocuments.bind(collection),
+  };
+  const unavailable = new MongoSessionStore({collection: legacyCollection});
+  const failed = new MongoSessionStore({collection});
+  const outcomes: unknown[] = [];
+  let failedSession: string | undefined;
+  for (const [store, enabled] of [
+    [memory, undefined],
+    [memory, false],
+    [originalPort(memory), true],
+    [{...originalPort(memory), listFor: unavailable.listFor.bind(unavailable)}, true],
+    [{...originalPort(memory), listFor: failed.listFor.bind(failed)}, true],
+  ] as Array<[SessionStore, boolean | undefined]>) {
+    const {url} = await start(store, enabled);
+    const {client, frames} = await open(url);
+    const response = await exchange(client, {type: 'list_conversations'});
+    outcomes.push(response.map(frame => ({type: frame.type, code: frame.code})));
+    expect(client.readyState).toBe(WebSocket.OPEN);
+    if (store.listFor && enabled && store !== memory) {
+      expect(JSON.stringify(response)).not.toMatch(/private-history|MongoClient|find|collection/i);
+    }
+    if (outcomes.length === 5) failedSession = frames[0].sessionId;
+  }
+  expect(outcomes).toEqual(
+    ['UNSUPPORTED', 'UNSUPPORTED', 'UNSUPPORTED', 'UNSUPPORTED', 'SERVER_ERROR'].map(code => [{type: 'error', code}])
+  );
+  expect(logs.filter(line => line.level === 'error')).toContainEqual(
+    expect.objectContaining({fields: expect.objectContaining({sessionId: failedSession})})
+  );
+  expect(JSON.stringify(logs.filter(line => line.level === 'error'))).not.toContain('private-history');
+  await start(memory, true, undefined, false);
+  expect(
+    logs
+      .filter(line => line.level === 'warn')
+      .some(line => /history/i.test(JSON.stringify(line)) && /resume/i.test(JSON.stringify(line)))
+  ).toBe(true);
+});
+
+// @spec specs/hal-engine-conversation-list/spec.md#39
+it('answers history while the same session turn holds the lock', async () => {
+  let entered!: () => void;
+  const pending = new Promise<void>(resolve => {
+    entered = resolve;
+  });
+  let release!: () => void;
+  const held = new Promise<void>(resolve => {
+    release = resolve;
+  });
+  const store = new InMemorySessionStore();
+  const {url} = await start(store, true, {
+    hooks: {
+      afterUserInput: async () => {
+        entered();
+        await held;
+        throw new Error('Consumer cancelled the pending turn');
+      },
+    },
+  });
+  const {client, frames} = await open(url);
+  try {
+    const userEntry = waitFor(client, 'entry_upsert');
+    client.send(JSON.stringify({type: 'user_message', content: 'private pending input'}));
+    await Promise.all([pending, userEntry]);
+    const response = await exchange(client, {type: 'list_conversations'});
+    expect(response).toEqual([
+      {
+        type: 'conversation_list',
+        conversations: expect.arrayContaining([expect.objectContaining({sessionId: frames[0].sessionId})]),
+      },
+    ]);
+    expect(frames.some(frame => frame.type === 'stream_end')).toBe(false);
+  } finally {
+    client.terminate();
+    release();
+  }
+});