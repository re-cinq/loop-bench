new file mode 100644
index 0000000..dfaf045
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,346 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {MongoClient} from 'mongodb';
+import {WebSocket} from 'ws';
+import {createHalEngine} from '../config.js';
+import * as publicApi from '../index.js';
+import type {HalEngine, HalEngineConfig} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {MongoSessionStore} from '../infrastructure/stores/mongo/mongoSessionStore.js';
+import type {MongoSessionDocument} from '../infrastructure/stores/mongo/mongoSessionDocument.js';
+import type {SessionListOptions, SessionStore} from '../types/sessionStore.js';
+import type {IncomingMessage, OutgoingMessage} from '../types/messages.js';
+import {setLogger} from '../shared/logger.js';
+import {credentialFromSubprotocol, HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+
+interface Row {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+interface Frame {
+  type: string;
+  sessionId?: string;
+  conversations?: Row[];
+  code?: string;
+  message?: string;
+  timestamp?: number;
+}
+
+const engines: HalEngine[] = [];
+const sockets: WebSocket[] = [];
+const logs: Array<{level: string; message: string; fields?: Record<string, unknown>}> = [];
+const record = (level: string) => (_category: string, message: string, fields?: Record<string, unknown>) => {
+  logs.push({level, message, fields});
+};
+
+beforeEach(() => {
+  logs.length = 0;
+});
+afterEach(async () => {
+  await Promise.all(
+    sockets.splice(0).map(async socket => {
+      if (socket.readyState === WebSocket.CLOSED) return;
+      const closed = once(socket, 'close');
+      socket.terminate();
+      await closed;
+    })
+  );
+  for (const engine of engines.splice(0)) await engine.stop();
+  setLogger();
+});
+
+// An observing decorator: every call still executes the real in-memory query.
+class RecordedStore extends InMemorySessionStore {
+  readonly calls: Array<{userId: string | number; options?: SessionListOptions}> = [];
+  override listFor(userId: string | number, options?: SessionListOptions) {
+    this.calls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+// A working adapter exposing precisely the original five-member store port.
+const originalPort = (store: InMemorySessionStore): SessionStore => ({
+  create: store.create.bind(store),
+  get: store.get.bind(store),
+  delete: store.delete.bind(store),
+  count: store.count.bind(store),
+  clear: store.clear.bind(store),
+});
+
+const start = async (
+  session: SessionStore,
+  history?: {enabled: boolean},
+  hooks?: NonNullable<HalEngineConfig['orchestrator']>['hooks'],
+  resume = true
+) => {
+  // Structural assignment keeps this test runnable before history is added to the config type.
+  const transport = {port: 0, resume: {enabled: resume}, history};
+  const engine = createHalEngine({
+    session,
+    transport,
+    provider: {type: 'bedrock', region: 'eu-central-1', modelId: 'unused', maxTokens: 1},
+    prompt: {identity: 'History acceptance'},
+    auth: {
+      ws: async request => {
+        const token = credentialFromSubprotocol(request.headers['sec-websocket-protocol']);
+        return token === 'alice' || token === 'bob' ? {id: token} : null;
+      },
+    },
+    orchestrator: {hooks},
+    logger: {debug: record('debug'), info: record('info'), warn: record('warn'), error: record('error')},
+  });
+  engines.push(engine);
+  await engine.start();
+  return `ws://127.0.0.1:${(engine.server.address() as AddressInfo).port}/hal/ws`;
+};
+
+const connect = async (url: string, user = 'alice') => {
+  const socket = new WebSocket(url, [HAL_WS_SUBPROTOCOL, user]);
+  sockets.push(socket);
+  const frames: Frame[] = [];
+  socket.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  const until = async (predicate: () => boolean) => {
+    const deadline = Date.now() + 2000;
+    while (!predicate() && Date.now() < deadline) await new Promise(resolve => setTimeout(resolve, 5));
+    expect(predicate()).toBe(true);
+  };
+  const send = (frame: unknown) => socket.send(JSON.stringify(frame));
+  let timestamp = 0;
+  const settle = async () => {
+    const stamp = ++timestamp;
+    send({type: 'ping', timestamp: stamp});
+    await until(() => frames.some(frame => frame.type === 'pong' && frame.timestamp === stamp));
+  };
+  await until(() => frames.some(frame => frame.type === 'connected'));
+  await settle();
+  const request = async (frame: unknown) => {
+    const offset = frames.length;
+    send(frame);
+    await until(() => frames.slice(offset).some(item => ['conversation_list', 'error'].includes(item.type)));
+    await settle();
+    return frames.slice(offset).filter(item => item.type !== 'pong');
+  };
+  return {socket, frames, send, until, settle, request};
+};
+
+// spec: specs/hal-engine-conversation-list/spec.md#37
+it('validates history frames and composite cursors without changing existing message literals', () => {
+  const legacyIncoming: IncomingMessage[] = [
+    {type: 'user_message', content: 'hello'},
+    {type: 'ping', timestamp: 1},
+  ];
+  const legacyOutgoing: OutgoingMessage[] = [
+    {type: 'connected', sessionId: 's', message: 'hi', examplePrompts: []},
+    {type: 'entry_upsert', index: 0, entry: {role: 'user', content: 'hi', timestamp: '2026-01-01T00:00:00Z'}},
+    {type: 'entry_delta', index: 0, delta: 'hi'},
+    {type: 'entry_commit', index: 0},
+    {type: 'entry_skip', index: 0},
+    {type: 'error', code: 'SERVER_ERROR', message: 'failed'},
+    {type: 'pong', timestamp: 1},
+    {type: 'stream_end'},
+  ];
+  const before = {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: 's'};
+  const valid = [
+    {type: 'list_conversations'},
