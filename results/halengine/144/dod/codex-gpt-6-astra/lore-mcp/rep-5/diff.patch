+// spec: specs/hal-engine-conversation-list/spec.md#40
+it('answers history before an active user turn ends without taking the session lock', async () => {
+  let release!: () => void;
+  const held = new Promise<void>(resolve => {
+    release = resolve;
+  });
+  let entered!: () => void;
+  const inTurn = new Promise<void>(resolve => {
+    entered = resolve;
+  });
+  // A consumer policy hook holds the real streaming orchestration path, then declines the model call.
+  // It makes no provider request, never substitutes an orchestrator and never touches the session lock.
+  const url = await start(
+    new InMemorySessionStore(),
+    {enabled: true},
+    {
+      beforeModelResponse: async () => {
+        entered();
+        await held;
+        throw new Error('Consumer policy declined the model call');
+      },
+    }
+  );
+  const client = await connect(url);
+  client.send({type: 'user_message', content: 'private user content'});
+  await inTurn;
+  await client.until(() => client.frames.some(frame => frame.type === 'entry_upsert'));
+  try {
+    const frames = await client.request({type: 'list_conversations'});
+    expect(frames).toEqual([
+      {
+        type: 'conversation_list',
+        conversations: [
+          expect.objectContaining({
+            sessionId: client.frames[0].sessionId,
+            entryCount: 1,
+          }),
+        ],
+      },
+    ]);
+    expect(client.frames.some(frame => frame.type === 'stream_end')).toBe(false);
+  } finally {
+    release();
+    await client.until(() => client.frames.some(frame => frame.type === 'stream_end'));
+  }
+  expect(client.frames.filter(frame => frame.type === 'conversation_list')).toHaveLength(1);
+});