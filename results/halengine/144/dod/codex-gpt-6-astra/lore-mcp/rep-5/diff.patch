+// spec: specs/hal-engine-conversation-list/spec.md#39
+it('refuses disabled or unavailable history and contains real store failures without closing the socket', async () => {
+  const memory = new RecordedStore();
+  memory.create('owned', 'alice');
+  // A closed real driver fails locally; no database server or scripted rejection is needed.
+  const mongoClient = new MongoClient('mongodb://127.0.0.1:1');
+  const collection = mongoClient.db('history_private_detail').collection<MongoSessionDocument>('sessions');
+  await mongoClient.close();
+  const failedStore = new MongoSessionStore({collection});
+  const withoutFind = new MongoSessionStore({
+    collection: {
+      findOne: collection.findOne.bind(collection),
+      updateOne: collection.updateOne.bind(collection),
+      deleteOne: collection.deleteOne.bind(collection),
+      deleteMany: collection.deleteMany.bind(collection),
+      countDocuments: collection.countDocuments.bind(collection),
+    },
+  });
+  const unavailable = await withoutFind.listFor('alice').catch((error: unknown) => error);
+  const failed = await failedStore.listFor('alice').catch((error: unknown) => error);
+  expect(unavailable).toBeInstanceOf(Error);
+  expect(failed).toBeInstanceOf(Error);
+  let failedSessionId: string | undefined;
+  const outcomes: Array<{name: string; frames: Frame[]; open: boolean}> = [];
+  const invalidFrames: Frame[][] = [];
+  for (const [name, history, store] of [
+    ['absent', undefined, memory],
+    ['off', {enabled: false}, memory],
+    ['no-listFor', {enabled: true}, originalPort(memory)],
+    ['no-find', {enabled: true}, {...originalPort(memory), listFor: withoutFind.listFor.bind(withoutFind)}],
+    ['failed', {enabled: true}, {...originalPort(memory), listFor: failedStore.listFor.bind(failedStore)}],
+  ] as const) {
+    const client = await connect(await start(store, history));
+    const frames = await client.request({type: 'list_conversations'});
+    outcomes.push({name, frames, open: client.socket.readyState === WebSocket.OPEN});
+    if (name === 'failed') failedSessionId = client.frames[0].sessionId;
+    invalidFrames.push(await client.request({type: 'list_conversations', limit: 0}));
+  }
+  expect(outcomes).toEqual([
+    ...['absent', 'off', 'no-listFor', 'no-find', 'failed'].map(name => ({
+      name,
+      frames: [{type: 'error', code: name === 'failed' ? 'SERVER_ERROR' : 'UNSUPPORTED', message: expect.any(String)}],
+      open: true,
+    })),
+  ]);
+  expect(invalidFrames).toEqual(
+    Array.from({length: 5}, () => [{type: 'error', code: 'INVALID_MESSAGE', message: expect.stringMatching(/limit/i)}])
+  );
+  expect(logs).toEqual(
+    expect.arrayContaining([
+      expect.objectContaining({level: 'error', fields: expect.objectContaining({sessionId: failedSessionId})}),
+    ])
+  );
+  expect(Reflect.get(publicApi, 'StoreCannotList')).toBe((unavailable as Error).constructor);
+  expect(JSON.stringify(outcomes)).not.toContain((failed as Error).message);
+  expect(memory.calls).toEqual([]);
+  expect(JSON.stringify(logs)).not.toMatch(/history_private_detail|private credential|private content/);
+  expect(JSON.stringify(outcomes)).not.toMatch(/history_private_detail|MongoClient|closed|connect/i);
+  const warningOffset = logs.length;
+  await start(memory, {enabled: true}, undefined, false);
+  expect(logs.slice(warningOffset)).toEqual(
+    expect.arrayContaining([expect.objectContaining({level: 'warn', message: expect.stringMatching(/resume/i)})])
+  );
+});
