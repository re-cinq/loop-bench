+// spec: specs/hal-engine-conversation-list/spec.md#38
+it('lists only the authenticated user, pages tied activity and resumes a listed conversation', async () => {
+  const store = new RecordedStore();
+  const activity = new Date(Date.now() + 60_000).toISOString();
+  for (const [id, user] of [
+    ['older', 'alice'],
+    ['newer', 'alice'],
+    ['foreign', 'bob'],
+  ]) {
+    store.create(id, user, {authHeaders: {authorization: 'private credential'}}).entries.push({
+      role: 'user',
+      content: `private content ${id}`,
+      timestamp: activity,
+    });
+  }
+  const url = await start(store, {enabled: true});
+  const client = await connect(url);
+  expect(client.frames.map(frame => frame.type)).toEqual(['connected', 'pong']);
+  const current = client.frames[0].sessionId!;
+  const expected = JSON.parse(JSON.stringify(InMemorySessionStore.prototype.listFor.call(store, 'alice'))) as Row[];
+  expect(expected.map(row => row.sessionId)).toEqual(['older', 'newer', current]);
+  const frames = await client.request({type: 'list_conversations', userId: 'bob'});
+  expect(frames).toEqual([{type: 'conversation_list', conversations: expected}]);
+  expect(store.calls).toEqual([{userId: 'alice', options: {limit: undefined, before: undefined}}]);
+  const first = await client.request({type: 'list_conversations', limit: 1});
+  expect(first).toEqual([{type: 'conversation_list', conversations: [expected[0]]}]);
+  const before = {updatedAt: expected[0].updatedAt, sessionId: expected[0].sessionId};
+  expect(await client.request({type: 'list_conversations', limit: 1, before})).toEqual([
+    {type: 'conversation_list', conversations: [expected[1]]},
+  ]);
+  expect(store.calls.at(-1)).toEqual({userId: 'alice', options: {limit: 1, before}});
+  expect(await client.request({type: 'list_conversations', before: expected.at(-1)})).toEqual([
+    {type: 'conversation_list', conversations: []},
+  ]);
+  const resumed = await connect(`${url}?sessionId=${first[0].conversations![0].sessionId}`);
+  expect(resumed.frames[0]).toMatchObject({type: 'connected', sessionId: 'older', resumed: true, entryCount: 1});
+  expect(resumed.frames.slice(1)).toEqual([
+    {type: 'entry_upsert', index: 0, entry: store.get('older')!.entries[0]},
+    {type: 'pong', timestamp: 1},
+  ]);
+  const other = await connect(url, 'bob');
+  expect(await other.request({type: 'list_conversations', userId: 'alice'})).toEqual([
+    {
+      type: 'conversation_list',
+      conversations: JSON.parse(JSON.stringify(InMemorySessionStore.prototype.listFor.call(store, 'bob'))),
+    },
+  ]);
