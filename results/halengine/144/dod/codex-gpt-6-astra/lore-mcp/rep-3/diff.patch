+it('distinguishes a store that cannot list from a failed store without exposing details or closing the socket', async () => {
+  const client = new MongoClient('mongodb://127.0.0.1:1');
+  await client.close();
+  const collection = client.db('private-database').collection<MongoSessionDocument>('private-conversations');
+  const legacyCollection = {
+    findOne: collection.findOne.bind(collection),
+    updateOne: collection.updateOne.bind(collection),
+    deleteOne: collection.deleteOne.bind(collection),
+    deleteMany: collection.deleteMany.bind(collection),
+    countDocuments: collection.countDocuments.bind(collection),
+  };
+  for (const [listing, code] of [
+    [new MongoSessionStore({collection}), 'SERVER_ERROR'],
+    [new MongoSessionStore({collection: legacyCollection}), 'UNSUPPORTED'],
+  ] as const) {
+    // Real memory CRUD permits the upgrade; real Mongo listing exercises closed-driver and absent-find failures.
+    const memory = new InMemorySessionStore();
+    const session = {...originalPort(memory), listFor: listing.listFor.bind(listing)};
+    const peer = await connect(await start(session));
+    memory
+      .get(String(peer.connected.sessionId))
+      ?.entries.push({role: 'user', content: 'private-content', timestamp: new Date().toISOString()});
+    logs.length = 0;
+    const frames = await request(peer, {type: 'list_conversations'});
+    expect(frames).toEqual([{type: 'error', code, message: expect.any(String)}]);
+    expect(JSON.stringify(frames)).not.toMatch(/Mongo|private-|Client must be connected|does not implement find/i);
+    expect(publicApi).toHaveProperty('StoreCannotList', expect.any(Function));
+    if (code === 'UNSUPPORTED') {
+      const failure = await listing.listFor('owner').catch((error: unknown) => error);
+      expect(failure).toBeInstanceOf(Reflect.get(publicApi, 'StoreCannotList'));
+    }
+    expect(peer.socket.readyState).toBe(WebSocket.OPEN);
+    expect(
+      logs.some(
+        line =>
+          line.fields?.sessionId === peer.connected.sessionId && (code !== 'SERVER_ERROR' || line.level === 'error')
+      )
+    ).toBe(true);
+    expect(JSON.stringify(logs)).not.toMatch(/owner-token|private-/);
+  }
+});
