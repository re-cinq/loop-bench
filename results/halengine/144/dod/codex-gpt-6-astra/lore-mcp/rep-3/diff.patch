+## 14. Conversation list (#144)
+
+`list_conversations` requests history on the already authenticated connection; its validation and delivery contract is specified in [Conversation List](../hal-engine-conversation-list/spec.md#listing-over-the-authenticated-websocket-144).
+
+| Client field | Type    | Required | Meaning                                                                                 |
+| ------------ | ------- | -------- | --------------------------------------------------------------------------------------- |
+| `type`       | string  | Yes      | `list_conversations`                                                                    |
+| `limit`      | integer | No       | Page size, 1–200                                                                        |
+| `before`     | object  | No       | Composite cursor with both `updatedAt` (parseable date string) and `sessionId` (string) |
+
+| Server field                 | Type   | Meaning                                     |
+| ---------------------------- | ------ | ------------------------------------------- |
+| `type`                       | string | `conversation_list`                         |
+| `conversations`              | array  | Summaries in newest activity order          |
+| `conversations[].sessionId`  | string | Id to reconnect with when resume is enabled |
+| `conversations[].createdAt`  | string | ISO creation time                           |
+| `conversations[].updatedAt`  | string | ISO activity time                           |
+| `conversations[].entryCount` | number | Stored entry count                          |
+
+**GDPR and authorisation.** The list contains only the authenticated connection user's conversation metadata, never conversation content or credentials; the user id comes from the connection, never the frame, and `transport.history` is the deployer's independent opt-in to making that history reachable from the client, subject to the retention and erasure decision in re-cinq/HALEngine#41 ([validated by: lists only the authenticated user with ISO metadata and pages into the existing resume path](../../src/transport/conversationList.acceptance.test.ts#L184)).
diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..8ca4700
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,336 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {MongoClient} from 'mongodb';
+import {WebSocket} from 'ws';
+import * as publicApi from '../index.js';
+import {createHalEngine} from '../config.js';
+import type {HalEngineConfig, HalEngine} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {MongoSessionStore} from '../infrastructure/stores/mongo/mongoSessionStore.js';
+import type {MongoSessionDocument} from '../infrastructure/stores/mongo/mongoSessionDocument.js';
+import type {SessionStore, SessionListOptions} from '../types/sessionStore.js';
+import type {IncomingMessage, OutgoingMessage} from '../types/messages.js';
+import {setLogger} from '../shared/logger.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+
+interface Row {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+interface Frame {
+  type: string;
+  sessionId?: string;
+  code?: string;
+  message?: string;
+  conversations?: Row[];
+  [key: string]: unknown;
+}
+
+const engines: HalEngine[] = [];
+const sockets: WebSocket[] = [];
+const logs: Array<{level: string; message: string; fields?: Record<string, unknown>}> = [];
+const logger = Object.fromEntries(
+  ['debug', 'info', 'warn', 'error'].map(level => [
+    level,
+    (_category: string, message: string, fields?: Record<string, unknown>) => logs.push({level, message, fields}),
+  ])
+) as NonNullable<HalEngineConfig['logger']>;
+
+beforeEach(() => {
+  logs.length = 0;
+});
+afterEach(async () => {
+  const closed = engines.flatMap(engine => [...engine.wss.clients].map(socket => once(socket, 'close')));
+  for (const socket of sockets.splice(0)) socket.terminate();
+  await Promise.all(closed);
+  for (const engine of engines.splice(0)) await engine.stop();
+  setLogger();
+});
+
+async function start(
+  session: SessionStore,
+  history: {enabled: boolean} | null = {enabled: true},
+  hooks?: NonNullable<HalEngineConfig['orchestrator']>['hooks'],
+  resume = true
+) {
+  // Structural assignment keeps today's config compilable while exercising the public opt-in at runtime.
+  const transport = {history: history ?? undefined, resume: {enabled: resume}};
+  const engine = createHalEngine({
+    provider: {type: 'mock'},
+    prompt: {identity: 'Acceptance conversation'},
+    session,
+    transport,
+    auth: {ws: async () => ({id: 'owner'})},
+    logger,
+    orchestrator: {hooks},
+  });
+  engines.push(engine);
+  await engine.start(0);
+  return `ws://127.0.0.1:${(engine.server.address() as AddressInfo).port}/hal/ws`;
+}
+
+async function until(check: () => boolean) {
+  const deadline = Date.now() + 2000;
+  while (!check() && Date.now() < deadline) await new Promise(resolve => setTimeout(resolve, 5));
+  expect(check()).toBe(true);
+}
+
+async function connect(url: string) {
+  const socket = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'owner-token']);
+  sockets.push(socket);
+  const frames: Frame[] = [];
+  socket.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  await until(() => frames.some(frame => frame.type === 'connected'));
+  const send = (frame: unknown) => socket.send(JSON.stringify(frame));
+  const settle = async () => {
+    const timestamp = frames.length + 1;
+    send({type: 'ping', timestamp});
+    await until(() => frames.some(frame => frame.type === 'pong' && frame.timestamp === timestamp));
+  };
+  await settle();
+  expect(frames.filter(frame => frame.type === 'conversation_list')).toEqual([]);
+  const connected = frames[0];
+  const initialFrames = [...frames];
+  frames.length = 0;
+  return {socket, frames, connected, initialFrames, send, settle};
+}
+
+async function request(peer: Awaited<ReturnType<typeof connect>>, frame: unknown) {
+  peer.frames.length = 0;
+  peer.send(frame);
+  await until(() => peer.frames.some(item => item.type === 'conversation_list' || item.type === 'error'));
+  await peer.settle();
+  return peer.frames.filter(item => item.type !== 'pong');
+}
+
+// Records the real call and delegates every result to the shipped store, without substituting its behavior.
+class RecordedStore extends InMemorySessionStore {
+  readonly calls: Array<{userId: string | number; options: SessionListOptions | undefined}> = [];
+  override listFor(userId: string | number, options?: SessionListOptions) {
+    this.calls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+function originalPort(store: InMemorySessionStore): SessionStore {
+  return {
+    create: store.create.bind(store),
+    get: store.get.bind(store),
+    delete: store.delete.bind(store),
+    count: store.count.bind(store),
+    clear: store.clear.bind(store),
+  };
+}
+
+// @spec specs/hal-engine-conversation-list/spec.md#37
+it('validates history pagination without changing existing message literals', () => {
+  const oldIncoming: IncomingMessage[] = [
+    {type: 'ping', timestamp: 1},
+    {type: 'user_message', content: 'hello'},
+  ];
+  const oldOutgoing: OutgoingMessage[] = [
+    {type: 'connected', sessionId: 's', message: 'Connected', examplePrompts: []},
+    {type: 'connected', sessionId: 's', message: 'Connected', examplePrompts: [], resumed: true, entryCount: 1},
+    {
+      type: 'connected',
+      sessionId: 's',
+      message: 'Connected',
+      examplePrompts: [],
+      resumed: false,
+      resumeFailure: 'expired',
+    },
+    {type: 'entry_upsert', index: 0, entry: {role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}},
+    {type: 'entry_delta', index: 1, delta: 'hello'},
+    {type: 'entry_commit', index: 1},
+    {type: 'entry_skip', index: 2},
+    {type: 'stream_end'},
+    {type: 'pong', timestamp: 1},
+    {type: 'error', code: 'SERVER_ERROR', message: 'Failed'},
+  ];
+  expect(JSON.parse(JSON.stringify(oldOutgoing))).toEqual(oldOutgoing);
+  for (const frame of oldIncoming) expect(validateMessage(frame)).toEqual({valid: true, data: frame});
+  const before = {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: 's'};
+  for (const fields of [{}, {limit: 1}, {limit: 200, before}]) {
+    const frame = {type: 'list_conversations', ...fields};
+    expect(validateMessage({...frame, userId: 'intruder'})).toEqual({valid: true, data: frame});
+  }
+  for (const limit of [0, 201, 1.5, '10', null]) {
+    expect(validateMessage({type: 'list_conversations', limit})).toEqual({
+      valid: false,
+      error: expect.stringMatching(/limit/i),
+    });
+  }
+  for (const cursor of [
+    'not a date',
+    before.updatedAt,
+    {},
+    {updatedAt: before.updatedAt},
+    {sessionId: 's'},
+    {...before, updatedAt: 'bad'},
+    {...before, sessionId: 3},
+    null,
+  ]) {
