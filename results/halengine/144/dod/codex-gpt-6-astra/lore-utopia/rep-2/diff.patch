--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,259 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {MongoClient} from 'mongodb';
+import {WebSocket} from 'ws';
+import {createHalEngine} from '../config.js';
+import type {HalEngineConfig} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {MongoSessionStore} from '../infrastructure/stores/mongo/mongoSessionStore.js';
+import type {MongoSessionDocument} from '../infrastructure/stores/mongo/mongoSessionDocument.js';
+import type {SessionListOptions, SessionStore} from '../types/sessionStore.js';
+import type {SessionEntry} from '../types/session.js';
+import {captureErrors} from '../shared/logCaptureTestSupport.js';
+import {validateMessage} from './ws/validation.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+
+interface Row {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+interface Frame {
+  type: string;
+  sessionId?: string;
+  resumed?: boolean;
+  conversations?: Row[];
+  code?: string;
+  message?: string;
+  entry?: SessionEntry;
+}
+const engines: ReturnType<typeof createHalEngine>[] = [];
+const sockets: WebSocket[] = [];
+
+afterEach(async () => {
+  for (const socket of sockets.splice(0)) socket.terminate();
+  for (const engine of engines.splice(0)) {
+    const closed = [...engine.wss.clients].map(socket => once(socket, 'close'));
+    await engine.stop();
+    await Promise.all(closed);
+  }
+});
+
+const errors = captureErrors();
+
+async function start(session: SessionStore, history?: {enabled: boolean}, hooks?: HalEngineConfig['orchestrator']) {
+  // A variable keeps this executable before the additive history config member exists.
+  const transport = {port: 0, resume: {enabled: true}, history};
+  const engine = createHalEngine({
+    provider: {type: 'bedrock', region: 'eu-central-1', modelId: 'unused', maxTokens: 1},
+    prompt: {identity: 'History acceptance'},
+    auth: {ws: async () => ({id: 'owner'})},
+    session,
+    transport,
+    orchestrator: hooks,
+  });
+  engines.push(engine);
+  await engine.start();
+  return `ws://127.0.0.1:${(engine.server.address() as AddressInfo).port}/hal/ws`;
+}
+
+async function connect(url: string) {
+  const socket = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'credential']);
+  sockets.push(socket);
+  const frames: Frame[] = [];
+  socket.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  await once(socket, 'message');
+  const waitFor = async (predicate: (frames: Frame[]) => boolean) => {
+    const deadline = Date.now() + 1500;
+    while (!predicate(frames) && Date.now() < deadline) await new Promise(resolve => setTimeout(resolve, 5));
+    expect(predicate(frames)).toBe(true);
+  };
+  const send = (frame: object) => socket.send(JSON.stringify(frame));
+  const request = async (frame: object) => {
+    const from = frames.length;
+    send(frame);
+    await waitFor(all => all.slice(from).some(item => ['conversation_list', 'error'].includes(item.type)));
+    send({type: 'ping', timestamp: 1});
+    await waitFor(all => all.slice(from).some(item => item.type === 'pong'));
+    return frames.slice(from).filter(item => item.type !== 'pong');
+  };
+  return {socket, frames, waitFor, send, request};
+}
+
+// Records calls without replacing the store's query, ownership filter, ordering or paging.
+class ObservedStore extends InMemorySessionStore {
+  readonly calls: Array<{userId: string | number; options?: SessionListOptions}> = [];
+  override listFor(userId: string | number, options?: SessionListOptions) {
+    this.calls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+// A real legacy store adapter: all five required operations delegate to the in-memory store.
+function legacy(store: InMemorySessionStore): SessionStore {
+  return {
+    create: store.create.bind(store),
+    get: store.get.bind(store),
+    delete: store.delete.bind(store),
+    count: store.count.bind(store),
+    clear: store.clear.bind(store),
+  };
+}
+
+// @spec specs/hal-engine-conversation-list/spec.md#37
+it('validates history limits and complete wire cursors without a feature flag', () => {
+  const before = {updatedAt: '2026-10-01T12:00:00.000Z', sessionId: 'conversation'};
+  for (const frame of [
+    {type: 'list_conversations'},
+    {type: 'list_conversations', limit: 1},
+    {type: 'list_conversations', limit: 200, before},
+  ])
+    expect(validateMessage(frame)).toMatchObject({valid: true, data: frame});
+  for (const [field, value] of [
+    ...[0, 201, 1.5, '10', null].map(value => ['limit', value]),
+    ...[
+      'not a date',
+      before.updatedAt,
+      null,
+      {},
+      {updatedAt: before.updatedAt},
+      {sessionId: 's'},
+      {updatedAt: 'not a date', sessionId: 's'},
+      {updatedAt: 1, sessionId: 's'},
+      {updatedAt: before.updatedAt, sessionId: 1},
+    ].map(value => ['before', value]),
+  ]) {
+    expect(validateMessage({type: 'list_conversations', [String(field)]: value})).toEqual({
+      valid: false,
+      error: expect.stringMatching(String(field)),
+    });
+  }
+  expect(validateMessage({type: 'ping', timestamp: 1})).toMatchObject({valid: true});
+  expect(validateMessage({type: 'user_message', content: 'hello'})).toMatchObject({valid: true});
+});
+
+// @spec specs/hal-engine-conversation-list/spec.md#38
+it('lists and pages only the socket owner during a pending turn and resumes a listed conversation', async () => {
+  const store = new ObservedStore();
+  const timestamp = '2099-01-01T00:00:00.000Z';
+  for (const id of ['a', 'b']) {
+    store.create(id, 'owner', {authHeaders: {Authorization: 'secret'}}).entries.push({
+      role: 'user',
+      content: `private-${id}`,
+      timestamp,
+    });
+  }
+  store.create('foreign', 'other').entries.push({role: 'user', content: 'foreign-secret', timestamp});
+  let release!: () => void;
+  const gate = new Promise<void>(resolve => {
+    release = resolve;
+  });
+  let entered!: () => void;
+  const pending = new Promise<void>(resolve => {
+    entered = resolve;
+  });
+  const url = await start(
+    store,
+    {enabled: true},
+    {
+      hooks: {
+        beforeSession: async () => {
+          entered();
+          await gate;
+          throw new Error('Turn ended by application policy');
+        },
+      },
+    }
+  );
+  const client = await connect(url);
+  try {
+    client.send({type: 'ping', timestamp: 1});
+    await client.waitFor(frames => frames.some(frame => frame.type === 'pong'));
+    expect(client.frames.map(frame => frame.type)).toEqual(['connected', 'pong']);
+    const expected = JSON.parse(JSON.stringify(InMemorySessionStore.prototype.listFor.call(store, 'owner'))) as Row[];
+    const answer = await client.request({type: 'list_conversations', userId: 'other'});
+    expect(answer).toEqual([{type: 'conversation_list', conversations: expected}]);
+    expect(expected.map(row => row.sessionId)).toEqual(['b', 'a', client.frames[0].sessionId]);
+    expect(store.calls).toEqual([{userId: 'owner', options: {limit: undefined, before: undefined}}]);
+    for (const row of answer[0].conversations ?? []) {
+      expect(Object.keys(row).sort()).toEqual(['createdAt', 'entryCount', 'sessionId', 'updatedAt']);
+      expect(new Date(row.createdAt).toISOString()).toBe(row.createdAt);
