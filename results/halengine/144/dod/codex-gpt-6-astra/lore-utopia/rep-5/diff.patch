+it('distinguishes an incapable collection from a failed store without leaking details or closing the socket', async () => {
+  const driver = new MongoClient('mongodb://127.0.0.1:27017');
+  const collection = driver.db('history_private_database').collection<MongoSessionDocument>('sessions');
+  await driver.close();
+  const withoutFind = {
+    findOne: collection.findOne.bind(collection),
+    updateOne: collection.updateOne.bind(collection),
+    deleteOne: collection.deleteOne.bind(collection),
+    deleteMany: collection.deleteMany.bind(collection),
+    countDocuments: collection.countDocuments.bind(collection),
+  };
+  const outcomes = [];
+  const failureLogs: typeof logs = [];
+  let failedSessionId: string | undefined;
+  for (const [mongo, code] of [
+    [new MongoSessionStore({collection: withoutFind}), 'UNSUPPORTED'],
+    [new MongoSessionStore({collection}), 'SERVER_ERROR'],
+  ] as const) {
+    const inner = new InMemorySessionStore();
+    const store = {...legacyPort(inner), listFor: mongo.listFor.bind(mongo)};
+    const {url} = await start(store, {enabled: true});
+    const client = await connect(url);
+    const offset = logs.length;
+    const frames = await request(client, {type: 'list_conversations'});
+    outcomes.push({frames, code});
+    expect(client.ws.readyState).toBe(WebSocket.OPEN);
+    if (code === 'SERVER_ERROR') {
+      failureLogs.push(...logs.slice(offset));
+      failedSessionId = client.frames[0].sessionId;
+    }
+    expect(JSON.stringify({frames, logs: logs.slice(offset)})).not.toMatch(
+      /history_private_database|acceptance-credential/
+    );
+  }
+  expect(outcomes).toEqual(
+    ['UNSUPPORTED', 'SERVER_ERROR'].map(code => ({code, frames: [{type: 'error', code, message: expect.any(String)}]}))
+  );
+  expect(failureLogs).toEqual(
+    expect.arrayContaining([
+      expect.objectContaining({level: 'error', fields: expect.objectContaining({sessionId: failedSessionId})}),
+    ])
+  );
+  expect(outcomes[1].frames[0].message).not.toMatch(/Mongo|closed|connect|topology/i);
+  expect(publicApi).toHaveProperty('StoreCannotList', expect.any(Function));
+  await expect(new MongoSessionStore({collection: withoutFind}).listFor('owner')).rejects.toMatchObject({
+    name: 'StoreCannotList',
+  });
+});
