diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..74e27df
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,337 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {MongoClient} from 'mongodb';
+import {WebSocket} from 'ws';
+import * as publicApi from '../index.js';
+import {createHalEngine} from '../config.js';
+import type {HalEngine, HalEngineConfig} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {MongoSessionStore} from '../infrastructure/stores/mongo/mongoSessionStore.js';
+import type {MongoSessionDocument} from '../infrastructure/stores/mongo/mongoSessionDocument.js';
+import type {SessionListOptions, SessionStore} from '../types/sessionStore.js';
+import type {
+  IncomingMessage,
+  OutgoingMessage,
+  ConversationCursor,
+  ConversationSummary,
+  ListConversationsMessage,
+  ConversationListMessage,
+} from '../types/messages.js';
+import type {Logger} from '../shared/logger.js';
+import {setLogger} from '../shared/logger.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+
+type Row = ConversationSummary;
+interface Frame {
+  type: string;
+  sessionId?: string;
+  conversations?: Row[];
+  code?: string;
+  message?: string;
+  timestamp?: number;
+}
+
+const engines: HalEngine[] = [];
+const sockets: WebSocket[] = [];
+const logs: Array<{level: string; message: string; fields?: Record<string, unknown>}> = [];
+const logger = Object.fromEntries(
+  ['debug', 'info', 'warn', 'error'].map(level => [
+    level,
+    (_category: string, message: string, fields?: Record<string, unknown>) => logs.push({level, message, fields}),
+  ])
+) as unknown as Logger;
+
+// An observing decorator: every query still executes the shipped in-memory store.
+class RecordedStore extends InMemorySessionStore {
+  readonly calls: Array<{userId: string | number; options?: SessionListOptions}> = [];
+  override listFor(userId: string | number, options?: SessionListOptions) {
+    this.calls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+// A functioning legacy store port exposing only the five original operations.
+function legacyPort(inner: InMemorySessionStore): SessionStore {
+  return {
+    create: inner.create.bind(inner),
+    get: inner.get.bind(inner),
+    delete: inner.delete.bind(inner),
+    count: inner.count.bind(inner),
+    clear: inner.clear.bind(inner),
+  };
+}
+
+async function start(
+  session: SessionStore,
+  history?: {enabled: boolean},
+  hooks?: NonNullable<HalEngineConfig['orchestrator']>['hooks'],
+  resume = true
+) {
+  const transport = {port: 0, resume: {enabled: resume}, history};
+  const engine = createHalEngine({
+    provider: {type: 'bedrock', region: 'eu-central-1', modelId: 'unused', maxTokens: 1},
+    prompt: {identity: 'History acceptance'},
+    session,
+    transport,
+    auth: {ws: async () => ({id: 'owner'})},
+    orchestrator: {hooks},
+    logger,
+  });
+  engines.push(engine);
+  await engine.start();
+  return {engine, url: `ws://127.0.0.1:${(engine.server.address() as AddressInfo).port}/hal/ws`};
+}
+
+async function until(predicate: () => boolean) {
+  const deadline = Date.now() + 1500;
+  while (!predicate() && Date.now() < deadline) await new Promise(resolve => setTimeout(resolve, 5));
+}
+
+async function connect(url: string) {
+  const ws = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'acceptance-credential']);
+  sockets.push(ws);
+  const frames: Frame[] = [];
+  ws.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  await once(ws, 'open');
+  await until(() => frames.some(frame => frame.type === 'connected'));
+  expect(frames[0]?.type).toBe('connected');
+  return {ws, frames};
+}
+
+async function request(client: Awaited<ReturnType<typeof connect>>, frame: unknown) {
+  const offset = client.frames.length;
+  client.ws.send(JSON.stringify(frame));
+  await until(() => client.frames.slice(offset).some(item => ['error', 'conversation_list'].includes(item.type)));
+  const timestamp = Date.now();
+  client.ws.send(JSON.stringify({type: 'ping', timestamp}));
+  await until(() => client.frames.slice(offset).some(item => item.type === 'pong' && item.timestamp === timestamp));
+  return client.frames.slice(offset).filter(item => item.type !== 'pong');
+}
+
+afterEach(async () => {
+  for (const socket of sockets.splice(0)) socket.terminate();
+  for (const engine of engines.splice(0)) await engine.stop();
+  logs.length = 0;
+  setLogger();
+});
+
+// @spec specs/hal-engine-conversation-list/spec.md#37
+it('validates history limits and composite cursors independently of feature configuration', () => {
+  const legacyIncoming: IncomingMessage[] = [
+    {type: 'user_message', content: 'hello'},
+    {type: 'ping', timestamp: 1},
+  ];
+  const legacyOutgoing: OutgoingMessage[] = [
+    {type: 'connected', sessionId: 's', message: 'hello', examplePrompts: []},
+    {type: 'entry_upsert', index: 0, entry: {role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}},
+    {type: 'entry_delta', index: 1, delta: 'hello'},
+    {type: 'entry_commit', index: 1},
+    {type: 'entry_skip', index: 2},
+    {type: 'error', code: 'SERVER_ERROR', message: 'failed'},
+    {type: 'pong', timestamp: 1},
+    {type: 'stream_end'},
+  ];
+  expect(legacyIncoming.map(validateMessage).every(result => result.valid)).toBe(true);
+  expect(JSON.parse(JSON.stringify(legacyOutgoing))).toEqual(legacyOutgoing);
+  const before: ConversationCursor = {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: 'previous'};
+  const valid: IncomingMessage[] = [
+    {type: 'list_conversations'} satisfies ListConversationsMessage,
+    {type: 'list_conversations', limit: 1, before},
+    {type: 'list_conversations', limit: 200},
+  ];
+  expect(valid.map(validateMessage)).toEqual(valid.map(data => ({valid: true, data})));
+  for (const limit of [0, 201, 1.5, '10', null]) {
+    expect(validateMessage({type: 'list_conversations', limit})).toEqual({
+      valid: false,
+      error: expect.stringMatching(/limit/i),
+    });
+  }
+  for (const cursor of [
+    'not a date',
+    before.updatedAt,
+    null,
+    {},
+    {updatedAt: before.updatedAt},
+    {sessionId: 'previous'},
+    {...before, updatedAt: 'not a date'},
+    {...before, sessionId: 123},
+  ]) {
