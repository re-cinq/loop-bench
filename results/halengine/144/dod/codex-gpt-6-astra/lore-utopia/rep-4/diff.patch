@@ -655,3 +655,26 @@ After 5 failed attempts, the client MUST stop reconnecting and report a disconne
 | Message validation       | `src/transport/ws/validation.ts`                  |
 | Message handling         | `src/transport/ws/messageHandler.ts`              |
 | Connection handler       | `src/transport/ws/connectionHandler.ts`           |
+
+## 14. Conversation list (#144)
+
+`list_conversations` requests metadata over the authenticated connection. Its validation is static, including when history is disabled ([validated by: validates history limits and complete ISO cursors independently of configuration](../../src/transport/conversationList.acceptance.test.ts#L97)).
+
+| Client field | Type    | Required | Description                                                                         |
+| ------------ | ------- | -------- | ----------------------------------------------------------------------------------- |
+| `type`       | string  | Yes      | `list_conversations`                                                                |
+| `limit`      | integer | No       | 1–200                                                                               |
+| `before`     | object  | No       | `{updatedAt, sessionId}` from the last row; both strings, with a parseable ISO time |
+
+The response is one `conversation_list`, with no `stream_end`; it carries only the authenticated user's conversation metadata, never content or credentials, and the user id comes from the connection, never the frame ([validated by: lists only the authenticated users metadata, pages ties and resumes a listed conversation](../../src/transport/conversationList.acceptance.test.ts#L126)).
+
+| Server field    | Type   | Description                                                                                          |
+| --------------- | ------ | ---------------------------------------------------------------------------------------------------- |
+| `type`          | string | `conversation_list`                                                                                  |
+| `conversations` | array  | Rows containing only `sessionId`, `createdAt`, `updatedAt`, `entryCount`; both times are ISO strings |
+
+`transport.history` is the deployer's separate decision to expose personal history to the client; it defaults off, and unavailable history returns `UNSUPPORTED` rather than claiming there are no conversations ([validated by: answers UNSUPPORTED when history is absent, disabled or the store cannot list](../../src/transport/conversationList.acceptance.test.ts#L161)).
+
+Store failures produce a sanitized `SERVER_ERROR` without disconnecting the client ([validated by: reports a real store failure without leaking details or closing the socket](../../src/transport/conversationList.acceptance.test.ts#L195)).
+
+History requests bypass the turn lock ([validated by: answers history while a real turn holds the session lock](../../src/transport/conversationList.acceptance.test.ts#L210)).
diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..a1f96fa
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,241 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import {MongoClient} from 'mongodb';
+import {createHalEngine} from '../config.js';
+import type {HalEngineConfig, HalEngine} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {MongoSessionStore} from '../infrastructure/stores/mongo/index.js';
+import type {SessionListOptions, SessionStore} from '../types/sessionStore.js';
+import {validateMessage} from './ws/validation.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {setLogger} from '../shared/logger.js';
+
+type Frame = Record<string, unknown> & {type: string};
+type Row = {sessionId: string; createdAt: string; updatedAt: string; entryCount: number};
+const servers: HalEngine[] = [];
+const clients: WebSocket[] = [];
+const logs: unknown[] = [];
+const record = (...args: unknown[]) => void logs.push(args);
+const logger = {debug: record, info: record, warn: record, error: record};
+
+beforeEach(() => {
+  logs.length = 0;
+});
+afterEach(async () => {
+  for (const ws of clients.splice(0)) {
+    if (ws.readyState === WebSocket.CLOSED) continue;
+    const closed = once(ws, 'close');
+    ws.terminate();
+    await closed;
+  }
+  for (const server of servers.splice(0)) await server.stop();
+  setLogger();
+});
+
+const start = async (session: SessionStore, enabled?: boolean, hooks?: HalEngineConfig['orchestrator']) => {
+  const transport = {resume: {enabled: true}, ...(enabled === undefined ? {} : {history: {enabled}})};
+  const hal = createHalEngine({
+    provider: {type: 'bedrock', modelId: 'unused', region: 'eu-central-1', maxTokens: 1},
+    prompt: {identity: 'History acceptance'},
+    session,
+    transport,
+    logger,
+    orchestrator: hooks,
+    auth: {ws: async () => ({id: 'alice'})},
+  });
+  servers.push(hal);
+  await hal.start(0);
+  return `ws://127.0.0.1:${(hal.server.address() as AddressInfo).port}/hal/ws`;
+};
+
+const connect = async (url: string) => {
+  const ws = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'acceptance']);
+  clients.push(ws);
+  const frames: Frame[] = [];
+  ws.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  await once(ws, 'message');
+  return {ws, frames};
+};
+
+const waitFor = async (frames: Frame[], predicate: (frame: Frame) => boolean) => {
+  const deadline = Date.now() + 1500;
+  while (!frames.some(predicate) && Date.now() < deadline) await new Promise(resolve => setTimeout(resolve, 5));
+  expect(frames.some(predicate)).toBe(true);
+};
+
+const request = async (ws: WebSocket, frames: Frame[], payload: unknown): Promise<Frame[]> => {
+  const offset = frames.length;
+  ws.send(JSON.stringify(payload));
+  const deadline = Date.now() + 1500;
+  while (frames.length === offset && Date.now() < deadline) await new Promise(resolve => setTimeout(resolve, 5));
+  expect(frames.length).toBeGreaterThan(offset);
+  // A pong bounds the response frames, including an erroneous stream_end.
+  const stamp = Date.now();
+  ws.send(JSON.stringify({type: 'ping', timestamp: stamp}));
+  await waitFor(frames, frame => frame.type === 'pong' && frame.timestamp === stamp);
+  return frames.slice(offset).filter(frame => frame.type !== 'pong');
+};
+
+class RecordedStore extends InMemorySessionStore {
+  readonly calls: Array<{userId: string | number; options?: SessionListOptions}> = [];
+  override listFor(userId: string | number, options?: SessionListOptions) {
+    this.calls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+const originalMembers = (store: InMemorySessionStore): SessionStore => ({
+  create: store.create.bind(store),
+  get: store.get.bind(store),
+  delete: store.delete.bind(store),
+  count: store.count.bind(store),
+  clear: store.clear.bind(store),
+});
+
+// specs/hal-engine-conversation-list/spec.md#wire-validation
+it('validates history limits and complete ISO cursors independently of configuration', () => {
+  const before = {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: 'row'};
+  for (const fields of [{}, {limit: 1}, {limit: 200, before}]) {
+    const frame = {type: 'list_conversations', ...fields};
+    expect(validateMessage({...frame, userId: 'bob'})).toEqual({valid: true, data: frame});
+  }
+  for (const limit of [0, 201, 1.5, '10', null]) {
+    expect(validateMessage({type: 'list_conversations', limit})).toEqual({
+      valid: false,
+      error: expect.stringMatching(/limit/i),
+    });
+  }
+  for (const cursor of [
+    'not a date',
+    before.updatedAt,
+    {},
+    {updatedAt: before.updatedAt},
+    {sessionId: 'row'},
+    {...before, updatedAt: 'bad'},
+    {...before, sessionId: 3},
+  ]) {
+    expect(validateMessage({type: 'list_conversations', before: cursor})).toEqual({
+      valid: false,
+      error: expect.stringMatching(/before/i),
+    });
+  }
+});
+
+// specs/hal-engine-conversation-list/spec.md#wire-history
+it('lists only the authenticated users metadata, pages ties and resumes a listed conversation', async () => {
+  const store = new RecordedStore();
+  for (const id of ['older-a', 'older-b', 'foreign']) {
+    store
+      .create(id, id === 'foreign' ? 'bob' : 'alice', {authHeaders: {Authorization: 'secret'}})
+      .entries.push({role: 'user', content: `private-${id}`, timestamp: '2026-01-01T00:00:00.000Z'});
+  }
+  const url = await start(store, true);
+  const {ws, frames} = await connect(url);
+  expect(frames.map(frame => frame.type)).toEqual(['connected']);
+  const response = await request(ws, frames, {type: 'list_conversations', userId: 'bob'});
+  expect(response).toEqual([{type: 'conversation_list', conversations: expect.any(Array)}]);
+  const rows = response[0].conversations as Row[];
+  expect(rows.map(row => row.sessionId)).toEqual([frames[0].sessionId, 'older-b', 'older-a']);
+  expect(store.calls).toEqual([{userId: 'alice', options: {limit: undefined, before: undefined}}]);
+  for (const row of rows) {
+    expect(Object.keys(row).sort()).toEqual(['createdAt', 'entryCount', 'sessionId', 'updatedAt']);
+    expect(new Date(row.createdAt).toISOString()).toBe(row.createdAt);
+    expect(new Date(row.updatedAt).toISOString()).toBe(row.updatedAt);
+  }
+  expect(rows.map(row => row.entryCount)).toEqual([0, 1, 1]);
+  const before = {updatedAt: rows[1].updatedAt, sessionId: rows[1].sessionId};
+  expect(await request(ws, frames, {type: 'list_conversations', limit: 1, before})).toEqual([
+    {type: 'conversation_list', conversations: [rows[2]]},
+  ]);
+  expect(store.calls.at(-1)).toEqual({userId: 'alice', options: {limit: 1, before}});
+  const resumed = await connect(`${url}?sessionId=${rows[1].sessionId}`);
+  await request(resumed.ws, resumed.frames, {type: 'ping', timestamp: 0});
+  expect(resumed.frames[0]).toMatchObject({resumed: true, sessionId: 'older-b', entryCount: 1});
+  expect(resumed.frames.filter(frame => frame.type === 'entry_upsert')).toEqual([
+    {type: 'entry_upsert', index: 0, entry: store.get('older-b')!.entries[0]},
+  ]);
+});
+
+// specs/hal-engine-conversation-list/spec.md#wire-opt-in
+it('answers UNSUPPORTED when history is absent, disabled or the store cannot list', async () => {
+  for (const mode of ['absent', 'disabled', 'no-list', 'no-find']) {
+    const enabled = mode === 'absent' ? undefined : mode !== 'disabled';
+    const inner = new RecordedStore();
+    inner.create('existing', 'alice');
+    const collection = new MongoClient('mongodb://127.0.0.1:27017').db('history').collection('sessions');
+    const legacyCollection = {
+      findOne: collection.findOne.bind(collection),
+      updateOne: collection.updateOne.bind(collection),
+      deleteOne: collection.deleteOne.bind(collection),
+      deleteMany: collection.deleteMany.bind(collection),
+      countDocuments: collection.countDocuments.bind(collection),
+    };
+    const legacy = new MongoSessionStore({
+      collection: legacyCollection as unknown as import('../infrastructure/stores/mongo/index.js').CollectionLike<
+        import('../infrastructure/stores/mongo/index.js').MongoSessionDocument
+      >,
+    });
+    const store =
+      mode === 'no-find'
+        ? {...originalMembers(inner), listFor: legacy.listFor.bind(legacy)}
+        : mode === 'no-list'
+          ? originalMembers(inner)
+          : inner;
+    const {ws, frames} = await connect(await start(store, enabled));
+    expect(await request(ws, frames, {type: 'list_conversations'})).toEqual([
+      {type: 'error', code: 'UNSUPPORTED', message: expect.any(String)},
+    ]);
+    expect(inner.calls).toEqual([]);
+    expect(ws.readyState).toBe(WebSocket.OPEN);
+  }
+});
+
+// specs/hal-engine-conversation-list/spec.md#wire-failure
+it('reports a real store failure without leaking details or closing the socket', async () => {
+  const inner = new InMemorySessionStore();
+  const broken = new MongoSessionStore({url: 'invalid-private-database-url', dbName: 'private-db'});
+  const store = {...originalMembers(inner), listFor: broken.listFor.bind(broken)};
+  const {ws, frames} = await connect(await start(store, true));
+  logs.length = 0;
+  const response = await request(ws, frames, {type: 'list_conversations'});
+  expect(response).toEqual([{type: 'error', code: 'SERVER_ERROR', message: expect.any(String)}]);
+  expect(JSON.stringify(response)).not.toMatch(/private|mongodb|scheme|invalid/i);
+  expect(ws.readyState).toBe(WebSocket.OPEN);
+  expect(JSON.stringify(logs)).toContain(String(frames[0].sessionId));
+  expect(JSON.stringify(logs)).not.toMatch(/private-db|invalid-private-database-url/);
+});
+
+// specs/hal-engine-conversation-list/spec.md#wire-lock
+it('answers history while a real turn holds the session lock', async () => {
+  let release!: () => void;
+  let entered!: () => void;
+  const gate = new Promise<void>(resolve => {
+    release = resolve;
+  });
+  const started = new Promise<void>(resolve => {
+    entered = resolve;
+  });
+  const store = new InMemorySessionStore();
+  const url = await start(store, true, {
+    hooks: {
+      beforeModelResponse: async () => {
+        entered();
+        await gate;
+        throw new Error('Acceptance policy ends this turn before any external provider call');
+      },
+    },
+  });
+  const {ws, frames} = await connect(url);
+  try {
+    ws.send(JSON.stringify({type: 'user_message', content: 'hold this turn'}));
+    await started;
+    await waitFor(frames, frame => frame.type === 'entry_upsert');
+    const response = await request(ws, frames, {type: 'list_conversations'});
+    expect(response).toEqual([{type: 'conversation_list', conversations: expect.any(Array)}]);
+    expect(frames.some(frame => frame.type === 'stream_end')).toBe(false);
+  } finally {
+    release();
+    await waitFor(frames, frame => frame.type === 'stream_end');
+  }
+});