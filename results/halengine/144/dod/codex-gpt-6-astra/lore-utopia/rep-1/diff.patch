+
+## 14. Conversation list (#144)
+
+The client requests history with `list_conversations`; the response is `conversation_list`.
+The executable delivery contract is in [WebSocket history delivery](../hal-engine-conversation-list/spec.md#websocket-history-delivery-144).
+
+| Request field | Type    | Required | Description                                                             |
+| ------------- | ------- | -------- | ----------------------------------------------------------------------- |
+| `type`        | string  | Yes      | `list_conversations`                                                    |
+| `limit`       | integer | No       | 1–200                                                                   |
+| `before`      | object  | No       | Composite cursor with `updatedAt` (ISO string) and `sessionId` (string) |
+
+| Response field  | Type                  | Description                                                                     |
+| --------------- | --------------------- | ------------------------------------------------------------------------------- |
+| `type`          | string                | `conversation_list`                                                             |
+| `conversations` | ConversationSummary[] | Rows with `sessionId`, ISO string `createdAt` and `updatedAt`, and `entryCount` |
+
+**GDPR.** This is one authenticated user's own conversation metadata, never conversation content; the authorisation identity comes from the connection, never from a frame's `userId` ([validated by: lists only the authenticated owner and pages metadata into the existing resume path](../../src/transport/conversationList.acceptance.test.ts#L139)).
+`transport.history` is the deployer's decision to make that metadata reachable from the client, independently of resume; retention remains the consumer's responsibility under #41.
diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..2f0648c
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,271 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import {createHalEngine} from '../config.js';
+import type {HalEngine, HalEngineConfig} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {MongoSessionStore} from '../infrastructure/stores/mongo/mongoSessionStore.js';
+import {freshCollection, startMongo} from '../infrastructure/stores/mongo/mongoTestSupport.js';
+import type {SessionListOptions, SessionStore} from '../types/sessionStore.js';
+import {validateMessage} from './ws/validation.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {setLogger} from '../shared/logger.js';
+
+interface Row {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+interface Frame {
+  type: string;
+  sessionId?: string;
+  resumed?: boolean;
+  timestamp?: number;
+  conversations?: Row[];
+  code?: string;
+  message?: string;
+  entry?: unknown;
+}
+
+const engines: HalEngine[] = [];
+const sockets: WebSocket[] = [];
+const logs: Array<{level: string; message: string; fields?: Record<string, unknown>}> = [];
+const record = (level: string) => (_category: string, message: string, fields?: Record<string, unknown>) => {
+  logs.push({level, message, fields});
+};
+
+beforeEach(() => {
+  logs.length = 0;
+  setLogger({debug: record('debug'), info: record('info'), warn: record('warn'), error: record('error')});
+});
+afterEach(async () => {
+  for (const socket of sockets.splice(0)) {
+    if (socket.readyState === WebSocket.CLOSED) continue;
+    const closed = once(socket, 'close');
+    socket.terminate();
+    await closed;
+  }
+  for (const engine of engines.splice(0)) await engine.stop();
+  setLogger();
+});
+
+async function start(store: SessionStore, enabled?: boolean, hooks?: HalEngineConfig['orchestrator'], resume = true) {
+  const transport = {resume: {enabled: resume}, ...(enabled === undefined ? {} : {history: {enabled}})};
+  const engine = createHalEngine({
+    provider: {type: 'bedrock', modelId: 'unused', region: 'eu-central-1', maxTokens: 10},
+    prompt: {identity: 'History acceptance'},
+    auth: {ws: async () => ({id: 'owner'})},
+    session: store,
+    transport,
+    orchestrator: hooks,
+  });
+  engines.push(engine);
+  await engine.start(0);
+  return `ws://127.0.0.1:${(engine.server.address() as AddressInfo).port}/hal/ws`;
+}
+
+async function connect(url: string) {
+  const socket = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'credential']);
+  sockets.push(socket);
+  const frames: Frame[] = [];
+  socket.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  await once(socket, 'message');
+  const waitFor = async (predicate: () => boolean) => {
+    const until = Date.now() + 1500;
+    while (!predicate() && Date.now() < until) await new Promise(resolve => setTimeout(resolve, 5));
+    expect(predicate()).toBe(true);
+  };
+  const request = async (frame: unknown) => {
+    const offset = frames.length;
+    socket.send(JSON.stringify(frame));
+    await waitFor(() => frames.slice(offset).some(item => ['conversation_list', 'error', 'pong'].includes(item.type)));
+    const barrier = -offset - 1;
+    socket.send(JSON.stringify({type: 'ping', timestamp: barrier}));
+    await waitFor(() => frames.slice(offset).some(item => item.type === 'pong' && item.timestamp === barrier));
+    return frames.slice(offset).filter(item => item.type !== 'pong');
+  };
+  return {socket, frames, request, waitFor};
+}
+
+// A recording decorator delegates every list to the real store, preserving its ownership and paging behavior.
+class RecordedStore extends InMemorySessionStore {
+  readonly calls: Array<{userId: string | number; options?: SessionListOptions}> = [];
+  override listFor(userId: string | number, options?: SessionListOptions) {
+    this.calls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+function originalStorePort(store: SessionStore): SessionStore {
+  return {
+    create: store.create.bind(store),
+    get: store.get.bind(store),
+    delete: store.delete.bind(store),
+    count: store.count.bind(store),
+    clear: store.clear.bind(store),
+  };
+}
+
+// @spec specs/hal-engine-conversation-list/spec.md#37
+it('validates history requests and complete composite cursors independently of configuration', () => {
+  const type = 'list_conversations';
+  expect(validateMessage({type})).toEqual({valid: true, data: {type}});
+  const before = {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: 'row'};
+  for (const limit of [1, 200]) {
+    expect(validateMessage({type, limit, before, userId: 'intruder'})).toEqual({
+      valid: true,
+      data: {type, limit, before},
+    });
+  }
+  for (const limit of [0, 201, 1.5, '10', null]) {
+    expect(validateMessage({type, limit})).toEqual({valid: false, error: expect.stringMatching(/limit/i)});
+  }
+  for (const cursor of [
+    'not a date',
+    before.updatedAt,
+    {},
+    {updatedAt: before.updatedAt},
+    {sessionId: 'row'},
+    {...before, updatedAt: 'not a date'},
+    {...before, sessionId: 1},
+    null,
+  ]) {
+    expect(validateMessage({type, before: cursor})).toEqual({valid: false, error: expect.stringMatching(/before/i)});
+  }
+});
+
+// @spec specs/hal-engine-conversation-list/spec.md#38
+it('lists only the authenticated owner and pages metadata into the existing resume path', async () => {
+  const store = new RecordedStore();
+  const entry = {role: 'user' as const, content: 'private conversation', timestamp: '2099-01-01T00:00:00.000Z'};
+  store.create('older', 'owner', {authHeaders: {Authorization: 'secret'}}).entries.push(entry);
+  store.create('newer', 'owner').entries.push({...entry, timestamp: '2099-01-02T00:00:00.000Z'});
+  store.create('foreign', 'another-user').entries.push(entry);
+  const base = await start(store, true);
+  const client = await connect(base);
+  expect(await client.request({type: 'ping', timestamp: 1})).toEqual([]);
+  expect(client.frames.map(frame => frame.type)).toEqual(['connected', 'pong', 'pong']);
+  const expected = JSON.parse(JSON.stringify(InMemorySessionStore.prototype.listFor.call(store, 'owner'))) as Row[];
+  const answer = await client.request({type: 'list_conversations', userId: 'another-user'});
+  expect(answer).toEqual([{type: 'conversation_list', conversations: expected}]);
+  expect(expected).toHaveLength(3);
+  expect(store.calls).toStrictEqual([{userId: 'owner', options: {limit: undefined, before: undefined}}]);
+  expect(expected.map(row => row.sessionId)).toEqual(['newer', 'older', client.frames[0].sessionId]);
+  for (const row of answer[0].conversations ?? []) {
+    expect(Object.keys(row).sort()).toEqual(['createdAt', 'entryCount', 'sessionId', 'updatedAt']);
+    expect(new Date(row.createdAt).toISOString()).toBe(row.createdAt);
+    expect(new Date(row.updatedAt).toISOString()).toBe(row.updatedAt);
+  }
+  const before = {updatedAt: expected[0].updatedAt, sessionId: expected[0].sessionId};
+  expect(await client.request({type: 'list_conversations', limit: 1, before})).toEqual([
+    {type: 'conversation_list', conversations: [expected[1]]},
+  ]);
+  expect(store.calls.at(-1)).toEqual({userId: 'owner', options: {limit: 1, before}});
