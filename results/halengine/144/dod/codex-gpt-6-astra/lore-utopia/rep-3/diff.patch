diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..fe86db9
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,284 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {MongoClient} from 'mongodb';
+import {WebSocket} from 'ws';
+import {createHalEngine} from '../config.js';
+import type {HalEngine, HalEngineConfig} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {MongoSessionStore} from '../infrastructure/stores/mongo/mongoSessionStore.js';
+import type {CollectionLike} from '../infrastructure/stores/mongo/mongoDriverTypes.js';
+import type {MongoSessionDocument} from '../infrastructure/stores/mongo/mongoSessionDocument.js';
+import type {SessionListOptions, SessionStore} from '../types/sessionStore.js';
+import {setLogger} from '../shared/logger.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+
+interface Row {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+interface Frame {
+  type: string;
+  sessionId?: string;
+  conversations?: Row[];
+  code?: string;
+  message?: string;
+  [key: string]: unknown;
+}
+
+const engines: HalEngine[] = [];
+const sockets: WebSocket[] = [];
+const logs: Array<{level: string; message: string; fields?: Record<string, unknown>}> = [];
+const record = (level: string) => (_category: string, message: string, fields?: Record<string, unknown>) => {
+  logs.push({level, message, fields});
+};
+
+beforeEach(() => {
+  logs.length = 0;
+});
+afterEach(async () => {
+  await Promise.all(
+    sockets.splice(0).map(async socket => {
+      if (socket.readyState === WebSocket.CLOSED) return;
+      const closed = once(socket, 'close');
+      socket.terminate();
+      await closed;
+    })
+  );
+  await Promise.all(engines.splice(0).map(engine => engine.stop()));
+  setLogger();
+});
+
+const start = async (session: SessionStore, history?: {enabled: boolean}, hooks?: HalEngineConfig['orchestrator']) => {
+  const transport = {history, resume: {enabled: true}};
+  const engine = createHalEngine({
+    provider: {type: 'bedrock', region: 'eu-central-1', modelId: 'unused', maxTokens: 1},
+    prompt: {identity: 'History acceptance'},
+    session,
+    transport,
+    auth: {ws: async request => ({id: request.headers['x-user'] === 'other' ? 'other' : 'owner'})},
+    orchestrator: hooks,
+    logger: {debug: record('debug'), info: record('info'), warn: record('warn'), error: record('error')},
+  });
+  engines.push(engine);
+  await engine.start(0);
+  return `ws://127.0.0.1:${(engine.server.address() as AddressInfo).port}/hal/ws`;
+};
+
+const connect = async (url: string) => {
+  const socket = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'acceptance-token']);
+  sockets.push(socket);
+  const frames: Frame[] = [];
+  socket.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  const wait = async (predicate: (frame: Frame) => boolean, from = 0) => {
+    const deadline = Date.now() + 1500;
+    while (!frames.slice(from).some(predicate) && Date.now() < deadline) {
+      await new Promise(resolve => setTimeout(resolve, 5));
+    }
+    expect(frames.slice(from).some(predicate)).toBe(true);
+  };
+  await wait(frame => frame.type === 'connected');
+  const barrier = async () => {
+    const from = frames.length;
+    socket.send(JSON.stringify({type: 'ping', timestamp: from}));
+    await wait(frame => frame.type === 'pong', from);
+  };
+  const ask = async (message: unknown): Promise<Frame[]> => {
+    const from = frames.length;
+    socket.send(JSON.stringify(message));
+    await wait(frame => frame.type === 'conversation_list' || frame.type === 'error', from);
+    await barrier();
+    return frames.slice(from).filter(frame => frame.type !== 'pong');
+  };
+  await barrier();
+  return {socket, frames, wait, ask};
+};
+
+// Records real store calls without replacing their implementation or their results.
+class RecordedStore extends InMemorySessionStore {
+  readonly calls: Array<{userId: string | number; options?: SessionListOptions}> = [];
+  override listFor(userId: string | number, options?: SessionListOptions) {
+    this.calls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+const requiredMembers = (store: InMemorySessionStore): SessionStore => ({
+  create: store.create.bind(store),
+  get: store.get.bind(store),
+  delete: store.delete.bind(store),
+  count: store.count.bind(store),
+  clear: store.clear.bind(store),
+});
+
+// spec: specs/hal-engine-websocket-protocol/spec.md#4.3
+it('validates history frames and composite cursors without accepting malformed paging fields', () => {
+  const before = {updatedAt: '2026-10-01T12:00:00.000Z', sessionId: 'b'};
+  const valid = [
+    {type: 'list_conversations'},
+    {type: 'list_conversations', limit: 1, before},
+    {type: 'list_conversations', limit: 200},
+  ];
+  expect(valid.map(validateMessage)).toEqual(valid.map(data => ({valid: true, data})));
+  expect(validateMessage({type: 'list_conversations', userId: 'other'})).toEqual({
+    valid: true,
+    data: {type: 'list_conversations'},
+  });
+  for (const limit of [0, 201, 1.5, '10', null]) {
+    expect(validateMessage({type: 'list_conversations', limit})).toEqual({
+      valid: false,
+      error: expect.stringMatching(/limit/i),
+    });
+  }
+  for (const cursor of [
+    'not a date',
+    before.updatedAt,
+    null,
+    {},
+    {updatedAt: before.updatedAt},
+    {sessionId: 'b'},
+    {updatedAt: 'not a date', sessionId: 'b'},
+    {updatedAt: 123, sessionId: 'b'},
+    {updatedAt: before.updatedAt, sessionId: ''},
+  ]) {
+    expect(validateMessage({type: 'list_conversations', before: cursor})).toEqual({
+      valid: false,
+      error: expect.stringMatching(/before/i),
+    });
+  }
+});
+
+// spec: specs/hal-engine-websocket-protocol/spec.md#5.9
+it('lists only the authenticated owner, pages ties, resumes a listed row and bypasses a running turn', async () => {
+  const store = new RecordedStore();
+  const tiedActivity = new Date(Date.now() + 60_000).toISOString();
+  for (const [id, user] of [
+    ['a', 'owner'],
+    ['b', 'owner'],
+    ['private', 'other'],
+  ]) {
+    store.create(id, user, {authHeaders: {Authorization: 'secret'}}).entries.push({
+      role: 'user',
+      content: `private content ${id}`,
+      timestamp: tiedActivity,
+    });
+  }
+  let entered!: () => void;
+  let release!: () => void;
+  const running = new Promise<void>(resolve => {
+    entered = resolve;
+  });
+  const held = new Promise<void>(resolve => {
+    release = resolve;
+  });
+  const base = await start(
+    store,
+    {enabled: true},
+    {
+      hooks: {
+        beforeSession: async () => {
+          entered();
+          await held;
+        },
+      },
+    }
+  );
+  const client = await connect(base);
+  const currentId = client.frames[0].sessionId!;
+  expect(client.frames.map(frame => frame.type)).toEqual(['connected', 'pong']);
+  const expected = JSON.parse(JSON.stringify(store.listFor('owner'))) as Row[];
+  store.calls.length = 0;
+  const answer = await client.ask({type: 'list_conversations', userId: 'other'});
+  expect(answer).toEqual([{type: 'conversation_list', conversations: expected}]);
+  expect(expected.map(row => row.sessionId)).toEqual(['b', 'a', currentId]);
+  expect(store.calls).toEqual([{userId: 'owner', options: {limit: undefined, before: undefined}}]);
