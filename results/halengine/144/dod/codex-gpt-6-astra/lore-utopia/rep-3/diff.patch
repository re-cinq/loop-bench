+  await driver.close();
+  const collection = driver.db().collection('sessions') as unknown as CollectionLike<MongoSessionDocument>;
+  const {findOne, updateOne, deleteOne, deleteMany, countDocuments} = collection;
+  const withoutFind: CollectionLike<MongoSessionDocument> = {
+    findOne: findOne.bind(collection),
+    updateOne: updateOne.bind(collection),
+    deleteOne: deleteOne.bind(collection),
+    deleteMany: deleteMany.bind(collection),
+    countDocuments: countDocuments.bind(collection),
+  };
+  const cannotList = new MongoSessionStore({collection: withoutFind});
+  const failed = new MongoSessionStore({collection});
+  await expect(failed.listFor('owner')).rejects.toThrow();
+  const outcomes: Record<string, Frame[]> = {};
+  let failedSessionId: string | undefined;
+  for (const [name, history, store] of [
+    ['default off', undefined, inner],
+    ['explicit off', {enabled: false}, inner],
+    ['no listFor', {enabled: true}, requiredMembers(inner)],
+    ['no find', {enabled: true}, {...requiredMembers(inner), listFor: cannotList.listFor.bind(cannotList)}],
+    ['closed database', {enabled: true}, {...requiredMembers(inner), listFor: failed.listFor.bind(failed)}],
+  ] as const) {
+    const client = await connect(await start(store, history));
+    if (name === 'closed database') failedSessionId = client.frames[0].sessionId;
+    outcomes[name] = await client.ask({type: 'list_conversations'});
+    expect(client.socket.readyState).toBe(WebSocket.OPEN);
+  }
+  expect(outcomes).toEqual(
+    Object.fromEntries(
+      Object.keys(outcomes).map(name => [
