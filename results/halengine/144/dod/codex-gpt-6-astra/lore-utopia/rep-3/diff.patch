+            message: expect.any(String),
+          },
+        ],
+      ])
+    )
+  );
+  expect(inner.calls).toEqual([]);
+  expect(JSON.stringify(outcomes)).not.toMatch(/history-private|Mongo|topology|client must be connected/i);
+  expect(logs.filter(line => line.level === 'error')).toEqual(
+    expect.arrayContaining([expect.objectContaining({fields: expect.objectContaining({sessionId: failedSessionId})})])
+  );
+  expect(JSON.stringify(logs)).not.toMatch(/acceptance-token|history-private|private content/);
