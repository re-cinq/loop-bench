diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..c5f7f2f
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,130 @@
+import {once} from 'node:events';
+import {WebSocket} from 'ws';
+import type {HalServerOptions} from './createServer.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {setLogger} from '../shared/logger.js';
+import {connectClient, startEngineWith, stopEngines} from './wsTestSupport.js';
+import {validateMessage} from './ws/validation.js';
+
+interface ConversationListFrame {
+  type: 'conversation_list';
+  conversations: Array<{
+    sessionId: string;
+    createdAt: string;
+    updatedAt: string;
+    entryCount: number;
+  }>;
+}
+
+interface ErrorFrame {
+  type: 'error';
+  code: string;
+}
+
+const historyEnabled = {history: {enabled: true}} as unknown as Partial<HalServerOptions>;
+
+const waitsForListReply = (client: WebSocket): Promise<void> =>
+  new Promise(resolve =>
+    client.on('message', raw => {
+      const {type} = JSON.parse(String(raw)) as {type: string};
+      if (type === 'conversation_list' || type === 'error') resolve();
+    })
+  );
+
+beforeEach(() => {
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined});
+});
+
+afterEach(async () => {
+  await stopEngines();
+  await new Promise(resolve => setTimeout(resolve, 0));
+  setLogger();
+});
+
+describe('conversation list WebSocket acceptance', () => {
+  it('accepts only a bounded list request with a complete ISO cursor', () => {
+    expect(validateMessage({type: 'list_conversations'})).toEqual({valid: true, data: {type: 'list_conversations'}});
+    expect(
+      validateMessage({
+        type: 'list_conversations',
+        limit: 2,
+        before: {updatedAt: '2026-01-02T03:04:05.000Z', sessionId: 's2'},
+      })
+    ).toEqual({
+      valid: true,
+      data: {type: 'list_conversations', limit: 2, before: {updatedAt: '2026-01-02T03:04:05.000Z', sessionId: 's2'}},
+    });
+
+    for (const invalid of [
+      {limit: 0},
+      {limit: 201},
+      {limit: 1.5},
+      {limit: '10'},
+      {before: {updatedAt: 'not a date', sessionId: 's2'}},
+      {before: {updatedAt: '2026-01-02T03:04:05.000Z'}},
+    ]) {
+      const result = validateMessage({type: 'list_conversations', ...invalid});
+      expect(result).toMatchObject({valid: false});
+      if (!result.valid) expect(result.error).toMatch(/limit|before/i);
+    }
+  });
+
+  it('delivers only the connected user’s ISO summaries over the socket when history is enabled', async () => {
+    const store = new InMemorySessionStore();
+    store.create('recent', 'u1').entries.push({role: 'user', content: 'recent', timestamp: '2099-01-02T00:00:00.000Z'});
+    store.create('older', 'u1').entries.push({role: 'user', content: 'older', timestamp: '2098-01-02T00:00:00.000Z'});
+    store
+      .create('another-user', 'u2')
+      .entries.push({role: 'user', content: 'private', timestamp: '2100-01-02T00:00:00.000Z'});
+    const {url} = await startEngineWith({sessionStore: store, ...historyEnabled});
+    const client = connectClient(url);
+    const frames: Array<ConversationListFrame | {type: string; sessionId?: string}> = [];
+
+    client.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as ConversationListFrame | {type: string; sessionId?: string};
+      frames.push(frame);
+      if (frame.type === 'connected') {
+        client.send(JSON.stringify({type: 'list_conversations', userId: 'u2'}));
+      }
+    });
+
+    await once(client, 'open');
+    await waitsForListReply(client);
+
+    const reply = frames.find((frame): frame is ConversationListFrame => frame.type === 'conversation_list');
+
+    expect({
+      conversationIds: reply?.conversations.map(summary => summary.sessionId),
+      hasOnlyWireFields: reply?.conversations.every(
+        summary => Object.keys(summary).sort().join(',') === 'createdAt,entryCount,sessionId,updatedAt'
+      ),
+      datesAreIso: reply?.conversations.every(summary =>
+        [summary.createdAt, summary.updatedAt].every(value => new Date(value).toISOString() === value)
+      ),
+      streamEnded: frames.some(frame => frame.type === 'stream_end'),
+    }).toEqual({
+      conversationIds: ['recent', 'older', expect.any(String)],
+      hasOnlyWireFields: true,
+      datesAreIso: true,
+      streamEnded: false,
+    });
+  });
+
+  it('refuses a list request when history was not enabled', async () => {
+    const {url} = await startEngineWith({sessionStore: new InMemorySessionStore()});
+    const client = connectClient(url);
+    const frames: Array<ErrorFrame | {type: string}> = [];
+
+    client.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as ErrorFrame | {type: string};
+      frames.push(frame);
+      if (frame.type === 'connected') client.send(JSON.stringify({type: 'list_conversations'}));
+    });
+
+    await once(client, 'open');
+    await waitsForListReply(client);
+
+    expect(frames).toContainEqual({type: 'error', code: 'UNSUPPORTED'});
+    expect(frames).not.toContainEqual(expect.objectContaining({type: 'conversation_list'}));
+  });
+});