index 0000000..774a25c
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,200 @@
+import type {AddressInfo} from 'node:net';
+import {once} from 'node:events';
+import {WebSocket} from 'ws';
+import {createHalEngine} from '../config.js';
+import type {HalEngine, HalEngineConfig} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+import type {SessionListOptions} from '../types/sessionStore.js';
+import {setLogger} from '../shared/logger.js';
+
+interface ConversationSummaryFrame {
+  type: string;
+  code?: string;
+  sessionId?: string;
+  conversations?: Array<{sessionId: string; createdAt: string; updatedAt: string; entryCount: number}>;
+}
+
+interface HistoryTransport {
+  history?: {enabled: boolean};
+}
+
+class ObservedInMemorySessionStore extends InMemorySessionStore {
+  readonly listCalls: Array<[string | number, SessionListOptions | undefined]> = [];
+
+  override listFor(userId: string | number, options?: SessionListOptions) {
+    this.listCalls.push([userId, options]);
+    return super.listFor(userId, options);
+  }
+}
+
+let engine: HalEngine | undefined;
+let client: WebSocket | undefined;
+
+beforeAll(() => {
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined});
+});
+
+afterAll(() => setLogger());
+
+const stop = async (): Promise<void> => {
+  const closed = client && client.readyState !== WebSocket.CLOSED ? once(client, 'close') : undefined;
+  client?.terminate();
+  await closed;
+  client = undefined;
+  for (let attempt = 0; engine && engine.wss.clients.size > 0 && attempt < 50; attempt++) {
+    await new Promise(resolve => setTimeout(resolve, 10));
+  }
+  await engine?.stop();
+  engine = undefined;
+};
+
+afterEach(stop);
+
+const start = async (store: InMemorySessionStore, history?: {enabled: boolean}): Promise<string> => {
+  const transport: HalEngineConfig['transport'] & HistoryTransport = {port: 0, history};
+  engine = createHalEngine({
+    provider: {type: 'mock'},
+    prompt: {identity: 'conversation-list acceptance'},
+    session: store,
+    transport,
+    auth: {ws: async () => ({id: 'u1'})},
+  });
+  await engine.start();
+  const {port} = engine.server.address() as AddressInfo;
+  return `ws://127.0.0.1:${port}/hal/ws`;
+};
+
+const askForList = async (url: string, request: Record<string, unknown>): Promise<ConversationSummaryFrame[]> => {
+  const frames: ConversationSummaryFrame[] = [];
+  client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'test-token']);
+
+  return new Promise((resolve, reject) => {
+    client?.on('error', reject);
+    client?.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as ConversationSummaryFrame;
+      frames.push(frame);
+      if (frame.type === 'connected') client?.send(JSON.stringify(request));
+      if (frame.type === 'conversation_list' || frame.type === 'error') resolve(frames);
+    });
+  });
+};
+
+const seed = (store: InMemorySessionStore): void => {
+  const older = store.create('older', 'u1');
+  older.entries.push({role: 'user', content: 'older', timestamp: '2030-01-01T00:00:00.000Z'});
+  const newer = store.create('newer', 'u1');
+  newer.entries.push(
+    {role: 'user', content: 'newer', timestamp: '2030-02-01T00:00:00.000Z'},
+    {role: 'assistant', content: 'reply', timestamp: '2030-02-01T00:00:01.000Z', isStreaming: false}
+  );
+  store.create('another-users', 'u2');
+};
+
+describe('conversation-list WebSocket acceptance', () => {
+  it('validates list_conversations limits and complete ISO cursors before history is enabled', () => {
+    const cursor = {updatedAt: '2030-02-01T00:00:01.000Z', sessionId: 'newer'};
+    const invalid = [
+      {field: 'limit', frame: {type: 'list_conversations', limit: 0}},
+      {field: 'limit', frame: {type: 'list_conversations', limit: 201}},
+      {field: 'limit', frame: {type: 'list_conversations', limit: 1.5}},
+      {field: 'limit', frame: {type: 'list_conversations', limit: '10'}},
+      {field: 'before', frame: {type: 'list_conversations', before: {updatedAt: 'not a date', sessionId: 'newer'}}},
+      {field: 'before', frame: {type: 'list_conversations', before: {updatedAt: cursor.updatedAt}}},
+    ];
+
+    expect({
+      valid: validateMessage({type: 'list_conversations', limit: 1, before: cursor}),
+      invalid: invalid.map(({field, frame}) => {
+        const result = validateMessage(frame);
+        return {field, valid: result.valid, error: result.valid ? undefined : result.error};
+      }),
+    }).toEqual({
+      valid: {valid: true, data: {type: 'list_conversations', limit: 1, before: cursor}},
+      invalid: invalid.map(({field}) => ({field, valid: false, error: expect.stringMatching(new RegExp(field))})),
+    });
+  });
+
+  it('delivers only the connecting users newest conversation summaries as ISO wire values', async () => {
+    const store = new ObservedInMemorySessionStore();
+    seed(store);
+    const frames = await askForList(await start(store, {enabled: true}), {
+      type: 'list_conversations',
+      userId: 'u2',
+    });
+    const connected = frames.find(frame => frame.type === 'connected');
+    const listed = frames.find(frame => frame.type === 'conversation_list');
+
+    expect({
+      types: frames.map(frame => frame.type),
+      ids: listed?.conversations?.map(summary => summary.sessionId),
+      rows: listed?.conversations?.map(summary => ({
+        fields: Object.keys(summary).sort(),
+        createdAt: summary.createdAt,
+        updatedAt: summary.updatedAt,
+        entryCount: summary.entryCount,
+      })),
+      listCalls: store.listCalls,
+    }).toEqual({
+      types: ['connected', 'conversation_list'],
+      ids: ['newer', 'older', connected?.sessionId],
+      rows: [
+        {
+          fields: ['createdAt', 'entryCount', 'sessionId', 'updatedAt'],
+          createdAt: expect.stringMatching(/^\d{4}-\d{2}-\d{2}T/),
+          updatedAt: '2030-02-01T00:00:01.000Z',
+          entryCount: 2,
+        },
+        {
+          fields: ['createdAt', 'entryCount', 'sessionId', 'updatedAt'],
+          createdAt: expect.stringMatching(/^\d{4}-\d{2}-\d{2}T/),
+          updatedAt: '2030-01-01T00:00:00.000Z',
+          entryCount: 1,
+        },
+        {
+          fields: ['createdAt', 'entryCount', 'sessionId', 'updatedAt'],
+          createdAt: expect.stringMatching(/^\d{4}-\d{2}-\d{2}T/),
+          updatedAt: expect.stringMatching(/^\d{4}-\d{2}-\d{2}T/),
+          entryCount: 0,
+        },
+      ],
+      listCalls: [['u1', {limit: undefined, before: undefined}]],
+    });
+  });
+
+  it('forwards a bounded page and its composite cursor to the authenticated users store query', async () => {
+    const store = new ObservedInMemorySessionStore();
+    seed(store);
+    const before = {updatedAt: '2030-02-01T00:00:01.000Z', sessionId: 'newer'};
+    const frames = await askForList(await start(store, {enabled: true}), {
+      type: 'list_conversations',
+      limit: 1,
+      before,
+    });
+    const listed = frames.find(frame => frame.type === 'conversation_list');
+
+    expect({ids: listed?.conversations?.map(summary => summary.sessionId), listCalls: store.listCalls}).toEqual({
+      ids: ['older'],
+      listCalls: [['u1', {limit: 1, before}]],
+    });
+  });
+
+  it('reports UNSUPPORTED rather than an empty list when history is disabled or the store cannot list', async () => {
+    const disabledStore = new InMemorySessionStore();
+    seed(disabledStore);
+    const disabled = await askForList(await start(disabledStore), {type: 'list_conversations'});
+    await stop();
+
+    const cannotListStore = new InMemorySessionStore();
+    Object.defineProperty(cannotListStore, 'listFor', {value: undefined});
+    const cannotList = await askForList(await start(cannotListStore, {enabled: true}), {type: 'list_conversations'});
+
+    expect(
+      [disabled, cannotList].map(frames => ({types: frames.map(frame => frame.type), code: frames.at(-1)?.code}))
+    ).toEqual([
+      {types: ['connected', 'error'], code: 'UNSUPPORTED'},
+      {types: ['connected', 'error'], code: 'UNSUPPORTED'},
+    ]);
+  });
+});