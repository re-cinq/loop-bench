diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..cf20087
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,196 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import type {Express} from 'express';
+import {WebSocket} from 'ws';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {createServer} from './createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+import {setLogger} from '../shared/logger.js';
+import type {SessionListOptions, SessionSummary, SessionStore} from '../types/sessionStore.js';
+
+interface Frame {
+  type: string;
+  code?: string;
+  message?: string;
+  sessionId?: string;
+  resumed?: boolean;
+  conversations?: Array<{sessionId: string; createdAt: string; updatedAt: string; entryCount: number}>;
+}
+
+class RecordingStore extends InMemorySessionStore {
+  calls: Array<{userId: string | number; options: SessionListOptions | undefined}> = [];
+
+  override listFor(userId: string | number, options?: SessionListOptions): SessionSummary[] {
+    this.calls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+const servers: Array<ReturnType<typeof createServer>> = [];
+const clients: WebSocket[] = [];
+
+beforeAll(() => {
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined});
+});
+
+afterAll(() => {
+  setLogger();
+});
+
+afterEach(async () => {
+  await Promise.all(
+    clients.splice(0).map(async client => {
+      if (client.readyState === WebSocket.CLOSED) return;
+      const closed = once(client, 'close');
+      client.terminate();
+      await closed;
+    })
+  );
+  for (const server of servers) {
+    for (let attempt = 0; attempt < 50 && server.wss.clients.size > 0; attempt++) {
+      await new Promise(resolve => setTimeout(resolve, 10));
+    }
+  }
+  for (const server of servers.splice(0)) await server.stop();
+});
+
+const start = async (sessionStore: SessionStore, history: boolean, resume = false) => {
+  const server = createServer({
+    app: (() => undefined) as unknown as Express,
+    wsAuth: async () => ({id: 'owner'}),
+    sessionStore,
+    orchestrator: {
+      processMessage: async () => 'unused',
+      async *processMessageStream() {
+        return;
+      },
+    },
+    // The public option is intentionally cast until this ticket adds it to HalServerOptions.
+    ...(history ? {history: {enabled: true}} : {}),
+    ...(resume ? {resume: {enabled: true}} : {}),
+  } as Parameters<typeof createServer>[0]);
+  await server.start(0);
+  servers.push(server);
+  const {port} = server.server.address() as AddressInfo;
+  return `ws://127.0.0.1:${port}/hal/ws`;
+};
+
+const open = (url: string) => {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'token']);
+  clients.push(client);
+  return client;
+};
+
+const requestList = async (
+  url: string,
+  frame: Record<string, unknown>
+): Promise<{frames: Frame[]; client: WebSocket}> => {
+  const client = open(url);
+  const frames: Frame[] = [];
+  await new Promise<void>(resolve => {
+    client.on('message', raw => {
+      const received = JSON.parse(String(raw)) as Frame;
+      frames.push(received);
+      if (received.type === 'connected') client.send(JSON.stringify(frame));
+      if (received.type === 'conversation_list' || received.type === 'error') resolve();
+    });
+  });
+  return {frames, client};
+};
+
+describe('conversation-list WebSocket acceptance', () => {
+  it('accepts the list frame only with a bounded integer limit and complete ISO cursor', () => {
+    const cursor = {updatedAt: '2026-01-02T03:04:05.000Z', sessionId: 's1'};
+
+    expect([
+      validateMessage({type: 'list_conversations'}),
+      validateMessage({type: 'list_conversations', limit: 1, before: cursor}),
+      ...[0, 201, 1.5, '10'].map(limit => validateMessage({type: 'list_conversations', limit})),
+      validateMessage({type: 'list_conversations', before: {updatedAt: 'not a date', sessionId: 's1'}}),
+      validateMessage({type: 'list_conversations', before: {updatedAt: cursor.updatedAt}}),
+    ]).toEqual([
+      {valid: true, data: {type: 'list_conversations'}},
+      {valid: true, data: {type: 'list_conversations', limit: 1, before: cursor}},
+      {valid: false, error: expect.stringMatching(/limit/)},
+      {valid: false, error: expect.stringMatching(/limit/)},
+      {valid: false, error: expect.stringMatching(/limit/)},
+      {valid: false, error: expect.stringMatching(/limit/)},
+      {valid: false, error: expect.stringMatching(/before/)},
+      {valid: false, error: expect.stringMatching(/before/)},
+    ]);
+  });
+
+  it("delivers only the connected user's ISO summaries, forwards its cursor, and lets a listed id resume", async () => {
+    const store = new RecordingStore();
+    for (const [sessionId, userId, timestamp] of [
+      ['mine-old', 'owner', '2998-01-01T00:00:00.000Z'],
+      ['mine-new', 'owner', '2999-01-01T00:00:00.000Z'],
+      ['not-mine', 'another-user', '2999-12-31T00:00:00.000Z'],
+    ] as const) {
+      store.create(sessionId, userId).entries.push({role: 'user', content: sessionId, timestamp});
+    }
+    const before = {updatedAt: '3000-01-01T00:00:00.000Z', sessionId: 'after-everything'};
+    const url = await start(store, true, true);
+
+    const {frames, client} = await requestList(url, {
+      type: 'list_conversations',
+      limit: 3,
+      before,
+      userId: 'another-user',
+    });
+    const listed = frames.find(frame => frame.type === 'conversation_list');
+    const currentSessionId = frames.find(frame => frame.type === 'connected')?.sessionId;
+
+    expect({listed, call: store.calls}).toEqual({
+      listed: {
+        type: 'conversation_list',
+        conversations: [
+          {sessionId: 'mine-new', createdAt: expect.any(String), updatedAt: '2999-01-01T00:00:00.000Z', entryCount: 1},
+          {sessionId: 'mine-old', createdAt: expect.any(String), updatedAt: '2998-01-01T00:00:00.000Z', entryCount: 1},
+          {sessionId: currentSessionId, createdAt: expect.any(String), updatedAt: expect.any(String), entryCount: 0},
+        ],
+      },
+      call: [{userId: 'owner', options: {limit: 3, before}}],
+    });
+    for (const summary of listed?.conversations ?? []) {
+      expect({createdAt: Date.parse(summary.createdAt), updatedAt: Date.parse(summary.updatedAt)}).toEqual({
+        createdAt: expect.any(Number),
+        updatedAt: expect.any(Number),
+      });
+    }
+
+    client.close();
+    await once(client, 'close');
+    const resumed = open(`${url}?sessionId=mine-new`);
+    const replay: Frame[] = [];
+    await new Promise<void>(resolve => {
+      resumed.on('message', raw => {
+        const frame = JSON.parse(String(raw)) as Frame;
+        replay.push(frame);
+        if (frame.type === 'connected') resumed.send(JSON.stringify({type: 'ping', timestamp: 1}));
+        if (frame.type === 'pong') resolve();
+      });
+    });
+
+    expect(replay[0]).toMatchObject({type: 'connected', sessionId: 'mine-new', resumed: true});
+  });
+
+  it('refuses a history request with UNSUPPORTED when history is off or the store cannot list', async () => {
+    const disabled = await requestList(await start(new InMemorySessionStore(), false), {type: 'list_conversations'});
+    const backing = new InMemorySessionStore();
+    const noList: SessionStore = {
+      create: backing.create.bind(backing),
+      get: backing.get.bind(backing),
+      delete: backing.delete.bind(backing),
+      count: backing.count.bind(backing),
+      clear: backing.clear.bind(backing),
+    };
+    const unavailable = await requestList(await start(noList, true), {type: 'list_conversations'});
+
+    expect({disabled: disabled.frames.at(-1), unavailable: unavailable.frames.at(-1)}).toEqual({
+      disabled: {type: 'error', code: 'UNSUPPORTED', message: expect.any(String)},
+      unavailable: {type: 'error', code: 'UNSUPPORTED', message: expect.any(String)},
+    });
+  });
+});