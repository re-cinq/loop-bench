index 0000000..634f1a0
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,195 @@
+import express from 'express';
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import {createServer} from './createServer.js';
+import type {HalServer, HalServerOptions} from './createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {createChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import {createBedrockProvider} from '../providers/bedrock/index.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {SessionListOptions} from '../types/sessionStore.js';
+import {validateMessage} from './ws/validation.js';
+
+interface Frame {
+  type: string;
+  code?: string;
+  conversations?: Array<{
+    sessionId: string;
+    createdAt: string;
+    updatedAt: string;
+    entryCount: number;
+  }>;
+}
+
+type ConversationListServerOptions = HalServerOptions & {history?: {enabled: boolean}};
+
+class RecordingSessionStore extends InMemorySessionStore {
+  readonly listCalls: Array<{userId: string | number; options: SessionListOptions | undefined}> = [];
+
+  override listFor(userId: string | number, options?: SessionListOptions) {
+    this.listCalls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+const servers: HalServer[] = [];
+const clients: WebSocket[] = [];
+
+const eventually = async (check: () => boolean): Promise<void> => {
+  for (let attempt = 0; attempt < 50 && !check(); attempt++) await new Promise(resolve => setTimeout(resolve, 10));
+};
+
+afterEach(async () => {
+  await Promise.all(
+    clients.splice(0).map(async client => {
+      if (client.readyState === WebSocket.CLOSED) return;
+      const closed = once(client, 'close');
+      client.terminate();
+      await closed;
+    })
+  );
+  for (const server of servers.splice(0)) {
+    await eventually(() => server.wss.clients.size === 0);
+    await server.stop();
+  }
+});
+
+const start = async (store: InMemorySessionStore, history?: {enabled: boolean}): Promise<string> => {
+  const server = createServer({
+    app: express(),
+    wsAuth: async () => ({id: 'u1'}),
+    sessionStore: store,
+    orchestrator: createChatOrchestrator(
+      createBedrockProvider({type: 'bedrock', modelId: 'unused', region: 'eu-central-1', maxTokens: 1}),
+      new PromptBuilder({identity: 'test'})
+    ),
+    resume: {enabled: true},
+    history,
+  } as ConversationListServerOptions);
+  await server.start(0);
+  servers.push(server);
+  const {port} = server.server.address() as AddressInfo;
+  return `ws://127.0.0.1:${port}/hal/ws`;
+};
+
+const connect = (url: string): WebSocket => {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'token']);
+  clients.push(client);
+  return client;
+};
+
+const nextFrame = (client: WebSocket, type: string): Promise<Frame> =>
+  new Promise(resolve => {
+    client.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as Frame;
+      if (frame.type === type) resolve(frame);
+    });
+  });
+
+const nextResponse = (client: WebSocket): Promise<Frame> =>
+  new Promise(resolve => {
+    client.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as Frame;
+      if (frame.type === 'conversation_list' || frame.type === 'error') resolve(frame);
+    });
+  });
+
+describe('conversation-list WebSocket protocol', () => {
+  it("delivers the authenticated user's paged summaries as ISO wire values, ignoring a supplied userId", async () => {
+    const store = new RecordingSessionStore();
+    for (const [sessionId, userId, timestamp] of [
+      ['oldest', 'u1', '2026-01-01T00:00:00.000Z'],
+      ['middle', 'u1', '2026-01-02T00:00:00.000Z'],
+      ['newest', 'u1', '2026-01-03T00:00:00.000Z'],
+      ['other-user', 'u2', '2026-01-04T00:00:00.000Z'],
+    ] as const) {
+      store.create(sessionId, userId).entries.push({role: 'user', content: sessionId, timestamp});
+    }
+    const url = await start(store, {enabled: true});
+    const client = connect(`${url}?sessionId=newest`);
+
+    await nextFrame(client, 'connected');
+    const listed = nextResponse(client);
+    client.send(
+      JSON.stringify({
+        type: 'list_conversations',
+        limit: 2,
+        before: {updatedAt: '2026-01-03T00:00:00.000Z', sessionId: 'newest'},
+        userId: 'u2',
+      })
+    );
+
+    const frame = await listed;
+    expect({frame, calls: store.listCalls}).toEqual({
+      frame: {
+        type: 'conversation_list',
+        conversations: [
+          {
+            sessionId: 'middle',
+            createdAt: expect.stringMatching(/^\d{4}-\d{2}-\d{2}T/),
+            updatedAt: '2026-01-02T00:00:00.000Z',
+            entryCount: 1,
+          },
+          {
+            sessionId: 'oldest',
+            createdAt: expect.stringMatching(/^\d{4}-\d{2}-\d{2}T/),
+            updatedAt: '2026-01-01T00:00:00.000Z',
+            entryCount: 1,
+          },
+        ],
+      },
+      calls: [
+        {
+          userId: 'u1',
+          options: {limit: 2, before: {updatedAt: '2026-01-03T00:00:00.000Z', sessionId: 'newest'}},
+        },
+      ],
+    });
+  });
+
+  it('validates list_conversations pagination fields before dispatching it', () => {
+    expect({
+      valid: validateMessage({
+        type: 'list_conversations',
+        limit: 1,
+        before: {updatedAt: '2026-01-03T00:00:00.000Z', sessionId: 'newest'},
+      }),
+      invalid: [
+        validateMessage({type: 'list_conversations', limit: 0}),
+        validateMessage({type: 'list_conversations', limit: 201}),
+        validateMessage({type: 'list_conversations', limit: 1.5}),
+        validateMessage({type: 'list_conversations', limit: '10'}),
+        validateMessage({type: 'list_conversations', before: {updatedAt: 'not a date', sessionId: 'newest'}}),
+      ],
+    }).toEqual({
+      valid: {
+        valid: true,
+        data: {
+          type: 'list_conversations',
+          limit: 1,
+          before: {updatedAt: '2026-01-03T00:00:00.000Z', sessionId: 'newest'},
+        },
+      },
+      invalid: [
+        {valid: false, error: expect.stringMatching(/limit/)},
+        {valid: false, error: expect.stringMatching(/limit/)},
+        {valid: false, error: expect.stringMatching(/limit/)},
+        {valid: false, error: expect.stringMatching(/limit/)},
+        {valid: false, error: expect.stringMatching(/before/)},
+      ],
+    });
+  });
+
+  it('refuses conversation lists when history is not enabled', async () => {
+    const url = await start(new InMemorySessionStore());
+    const client = connect(url);
+
+    await nextFrame(client, 'connected');
+    const error = nextFrame(client, 'error');
+    client.send(JSON.stringify({type: 'list_conversations'}));
+
+    await expect(error).resolves.toEqual({type: 'error', code: 'UNSUPPORTED'});
+  });
+});