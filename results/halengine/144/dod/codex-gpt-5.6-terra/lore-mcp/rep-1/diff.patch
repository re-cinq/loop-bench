--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,83 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import type {Express} from 'express';
+import {WebSocket} from 'ws';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {ChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import {createServer} from './createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+
+interface ConversationListFrame {
+  type: 'conversation_list';
+  conversations: Array<{sessionId: string; createdAt: string; updatedAt: string; entryCount: number}>;
+}
+
+class RecordingSessionStore extends InMemorySessionStore {
+  listCalls: Array<{userId: string | number; options: unknown}> = [];
+
+  override listFor(userId: string | number, options?: Parameters<InMemorySessionStore['listFor']>[1]) {
+    this.listCalls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+const addConversation = (store: InMemorySessionStore, sessionId: string, userId: string, updatedAt: string): void => {
+  store.create(sessionId, userId).entries.push({role: 'user', content: sessionId, timestamp: updatedAt});
+};
+
+describe('conversation-list WebSocket delivery', () => {
+  it('returns the authenticated user’s ISO summaries and passes the cursor to the store', async () => {
+    const store = new RecordingSessionStore();
+    addConversation(store, 'older', 'u1', '2030-01-01T00:00:00.000Z');
+    addConversation(store, 'newest', 'u1', '2030-01-03T00:00:00.000Z');
+    addConversation(store, 'middle', 'u1', '2030-01-02T00:00:00.000Z');
+    addConversation(store, 'someone-else', 'u2', '2030-01-04T00:00:00.000Z');
+    const cursor = {updatedAt: '2030-02-01T00:00:00.000Z', sessionId: 'cursor'};
+    const hal = createServer({
+      app: (() => undefined) as unknown as Express,
+      wsAuth: async () => ({id: 'u1'}),
+      sessionStore: store,
+      orchestrator: {} as ChatOrchestrator,
+      history: {enabled: true},
+    } as unknown as Parameters<typeof createServer>[0]);
+
+    await hal.start(0);
+    const {port} = hal.server.address() as AddressInfo;
+    const client = new WebSocket(`ws://127.0.0.1:${port}/hal/ws`, [HAL_WS_SUBPROTOCOL, 'token']);
+
+    try {
+      const response = await new Promise<ConversationListFrame | {type: string}>(resolve => {
+        client.on('message', raw => {
+          const frame = JSON.parse(String(raw)) as ConversationListFrame | {type: string};
+          if (frame.type === 'connected') {
+            client.send(JSON.stringify({type: 'list_conversations', limit: 3, before: cursor, userId: 'u2'}));
+            return;
+          }
+          resolve(frame);
+        });
+      });
+
+      expect({
+        response,
+        listCalls: store.listCalls,
+      }).toEqual({
+        response: {
+          type: 'conversation_list',
+          conversations: [
+            expect.objectContaining({sessionId: 'newest', updatedAt: '2030-01-03T00:00:00.000Z', entryCount: 1}),
+            expect.objectContaining({sessionId: 'middle', updatedAt: '2030-01-02T00:00:00.000Z', entryCount: 1}),
+            expect.objectContaining({sessionId: 'older', updatedAt: '2030-01-01T00:00:00.000Z', entryCount: 1}),
+          ],
+        },
+        listCalls: [{userId: 'u1', options: {limit: 3, before: cursor}}],
+      });
+
+      const list = response as ConversationListFrame;
+      expect(list.conversations.every(summary => /^\d{4}-\d{2}-\d{2}T.*Z$/.test(summary.createdAt))).toBe(true);
+    } finally {
+      client.close();
+      await once(client, 'close');
+      await hal.stop();
+    }
+  });
+});