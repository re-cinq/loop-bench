diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..ebd9472
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,122 @@
+import {jest} from '@jest/globals';
+import {WebSocket} from 'ws';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {connectClient, startEngineWith, stopEngines} from './wsTestSupport.js';
+import {validateMessage} from './ws/validation.js';
+
+interface Frame {
+  type: string;
+  [field: string]: unknown;
+}
+
+const HISTORY_ON = {history: {enabled: true}} as unknown as Parameters<typeof startEngineWith>[0];
+
+function storeWithConversations(): InMemorySessionStore {
+  const store = new InMemorySessionStore();
+  for (const [sessionId, userId, timestamp] of [
+    ['oldest', 'u1', '2099-01-01T00:00:00.000Z'],
+    ['middle', 'u1', '2099-01-02T00:00:00.000Z'],
+    ['newest', 'u1', '2099-01-03T00:00:00.000Z'],
+    ['private-to-someone-else', 'u2', '2099-01-04T00:00:00.000Z'],
+  ] as const) {
+    store.create(sessionId, userId).entries.push({role: 'user', content: sessionId, timestamp});
+  }
+  return store;
+}
+
+function ask(url: string, message: unknown): Promise<Frame[]> {
+  const client = connectClient(url);
+  const frames: Frame[] = [];
+  return new Promise(resolve => {
+    client.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as Frame;
+      frames.push(frame);
+      if (frame.type === 'conversation_list' || frame.type === 'error') resolve(frames);
+    });
+    client.on('open', () => client.send(JSON.stringify(message)));
+  });
+}
+
+describe('conversation list WebSocket acceptance', () => {
+  afterEach(() => stopEngines());
+
+  it('accepts a list request but rejects invalid list windows by their field', () => {
+    expect(validateMessage({type: 'list_conversations'})).toMatchObject({valid: true});
+
+    for (const request of [
+      {type: 'list_conversations', limit: 0},
+      {type: 'list_conversations', limit: 201},
+      {type: 'list_conversations', limit: 1.5},
+      {type: 'list_conversations', limit: '10'},
+      {type: 'list_conversations', before: {updatedAt: 'not a date', sessionId: 's1'}},
+    ]) {
+      expect(validateMessage(request)).toMatchObject({valid: false, error: expect.stringMatching(/limit|before/)});
+    }
+  });
+
+  it('returns only the authenticated user’s newest summaries as ISO wire values', async () => {
+    const store = storeWithConversations();
+    const listed = jest.spyOn(store, 'listFor');
+    const {url} = await startEngineWith({sessionStore: store, ...HISTORY_ON});
+
+    const frames = await ask(url, {type: 'list_conversations', userId: 'u2'});
+    const response = frames.at(-1);
+    const conversations = (response?.conversations ?? []) as Array<{
+      sessionId: string;
+      createdAt: string;
+      updatedAt: string;
+      entryCount: number;
+    }>;
+
+    expect({
+      types: frames.map(frame => frame.type),
+      seededRows: conversations
+        .filter(row => ['newest', 'middle', 'oldest'].includes(row.sessionId))
+        .map(row => ({sessionId: row.sessionId, updatedAt: row.updatedAt, entryCount: row.entryCount})),
+      hasAnotherUsersConversation: conversations.some(row => row.sessionId === 'private-to-someone-else'),
+      allTimesAreIso: conversations.every(row =>
+        [row.createdAt, row.updatedAt].every(
+          timestamp => /^\d{4}-\d{2}-\d{2}T/.test(timestamp) && Number.isFinite(Date.parse(timestamp))
+        )
+      ),
+      listFor: listed.mock.calls,
+    }).toEqual({
+      types: ['connected', 'conversation_list'],
+      seededRows: [
+        {
+          sessionId: 'newest',
+          updatedAt: '2099-01-03T00:00:00.000Z',
+          entryCount: 1,
+        },
+        {
+          sessionId: 'middle',
+          updatedAt: '2099-01-02T00:00:00.000Z',
+          entryCount: 1,
+        },
+        {
+          sessionId: 'oldest',
+          updatedAt: '2099-01-01T00:00:00.000Z',
+          entryCount: 1,
+        },
+      ],
+      hasAnotherUsersConversation: false,
+      allTimesAreIso: true,
+      listFor: [['u1', {limit: undefined, before: undefined}]],
+    });
+  });
+
+  it('refuses a list request with UNSUPPORTED when history is not enabled', async () => {
+    const {url} = await startEngineWith({sessionStore: storeWithConversations()});
+
+    const frames = await ask(url, {type: 'list_conversations'});
+
+    expect({types: frames.map(frame => frame.type), response: frames.at(-1)}).toEqual({
+      types: ['connected', 'error'],
+      response: {
+        type: 'error',
+        code: 'UNSUPPORTED',
+        message: expect.any(String),
+      },
+    });
+  });
+});