diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..6512c07
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,238 @@
+import type {AddressInfo} from 'node:net';
+import {once} from 'node:events';
+import {WebSocket} from 'ws';
+import type {Express} from 'express';
+import {createServer} from './createServer.js';
+import type {HalServer, HalServerOptions} from './createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {SessionListOptions, SessionStore, SessionSummary} from '../types/sessionStore.js';
+import type {ChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import type {MessageChunk} from '../types/ai.js';
+import {setLogger} from '../shared/logger.js';
+import {answeringOrchestrator, deferred} from './wsTestSupport.js';
+
+type Frame = {type: string; code?: string; message?: string; conversations?: ConversationSummary[]};
+type ConversationSummary = {sessionId: string; createdAt: string; updatedAt: string; entryCount: number};
+type HistoryOptions = {enabled: boolean};
+
+// The production in-memory store still supplies the list; this records the boundary argument without changing it.
+class RecordingStore extends InMemorySessionStore {
+  readonly listCalls: Array<{userId: string | number; options: SessionListOptions | undefined}> = [];
+
+  override listFor(userId: string | number, options?: SessionListOptions): SessionSummary[] {
+    this.listCalls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+// This is the compatibility shape the optional SessionStore member permits: every old required operation still delegates to a real store.
+const withoutListFor = (store: InMemorySessionStore): SessionStore => ({
+  create: (sessionId, userId, options) => store.create(sessionId, userId, options),
+  get: sessionId => store.get(sessionId),
+  delete: sessionId => store.delete(sessionId),
+  count: () => store.count(),
+  clear: () => store.clear(),
+});
+
+const servers: HalServer[] = [];
+const clients: WebSocket[] = [];
+
+beforeAll(() =>
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined})
+);
+afterAll(() => setLogger());
+
+const waitForSocketsToClose = async (server: HalServer): Promise<void> => {
+  for (let attempt = 0; attempt < 50 && server.wss.clients.size > 0; attempt++) {
+    await new Promise(resolve => setTimeout(resolve, 10));
+  }
+};
+
+afterEach(async () => {
+  for (const client of clients.splice(0)) {
+    if (client.readyState === WebSocket.CLOSED) continue;
+    const closed = once(client, 'close');
+    client.terminate();
+    await closed;
+  }
+  for (const server of servers.splice(0)) {
+    await waitForSocketsToClose(server);
+    await server.stop();
+  }
+});
+
+const start = async (
+  sessionStore: SessionStore,
+  history: HistoryOptions | undefined,
+  orchestrator: ChatOrchestrator = answeringOrchestrator
+): Promise<string> => {
+  const options: HalServerOptions & {history?: HistoryOptions} = {
+    app: (() => undefined) as unknown as Express,
+    wsAuth: async () => ({id: 'connected-user'}),
+    sessionStore,
+    orchestrator,
+    ...(history === undefined ? {} : {history}),
+  };
+  const server = createServer(options);
+  await server.start(0);
+  servers.push(server);
+  const {port} = server.server.address() as AddressInfo;
+  return `ws://127.0.0.1:${port}/hal/ws`;
+};
+
+const listFrames = async (url: string, firstRequest: Record<string, unknown>): Promise<Frame[]> => {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'token']);
+  clients.push(client);
+  const frames: Frame[] = [];
+
+  return new Promise(resolve => {
+    client.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as Frame;
+      if (frame.type === 'connected') client.send(JSON.stringify(firstRequest));
+      if (frame.type === 'conversation_list') {
+        frames.push(frame);
+        if (frames.length === 1) {
+          const before = frame.conversations?.[1];
+          client.send(JSON.stringify({type: 'list_conversations', limit: 2, before}));
+        } else resolve(frames);
+      }
+      if (frame.type === 'error') resolve([frame]);
+    });
+  });
+};
+
+describe('conversation-list WebSocket delivery', () => {
+  it('validates the list cursor and its bounded integer limit', () => {
+    const valid = validateMessage({
+      type: 'list_conversations',
+      limit: 2,
+      before: {updatedAt: '2027-01-03T00:00:00.000Z', sessionId: 'middle'},
+    });
+    const invalid = [
+      {limit: 0},
+      {limit: 201},
+      {limit: 1.5},
+      {limit: '10'},
+      {before: {updatedAt: 'not a date', sessionId: 'middle'}},
+      {before: {updatedAt: '2027-01-03T00:00:00.000Z'}},
+    ].map(fields => validateMessage({type: 'list_conversations', ...fields}));
+
+    expect({valid, invalid: invalid.map(result => (result.valid ? 'valid' : result.error))}).toEqual({
+      valid: {
+        valid: true,
+        data: {
+          type: 'list_conversations',
+          limit: 2,
+          before: {updatedAt: '2027-01-03T00:00:00.000Z', sessionId: 'middle'},
+        },
+      },
+      invalid: [
+        expect.stringContaining('limit'),
+        expect.stringContaining('limit'),
+        expect.stringContaining('limit'),
+        expect.stringContaining('limit'),
+        expect.stringContaining('before'),
+        expect.stringContaining('before'),
+      ],
+    });
+  });
+
+  it("lists only the connected user's ISO summaries, then passes its cursor to the store", async () => {
+    const store = new RecordingStore();
+    for (const [sessionId, userId, timestamp] of [
+      ['oldest', 'connected-user', '2027-01-01T00:00:00.000Z'],
+      ['middle', 'connected-user', '2027-01-02T00:00:00.000Z'],
+      ['newest', 'connected-user', '2027-01-03T00:00:00.000Z'],
+      ['another-users', 'another-user', '2027-01-04T00:00:00.000Z'],
+    ] as const) {
+      const session = store.create(sessionId, userId);
+      session.entries.push({role: 'user', content: sessionId, timestamp});
+    }
+
+    const frames = await listFrames(await start(store, {enabled: true}), {
+      type: 'list_conversations',
+      userId: 'another-user',
+    });
+
+    expect({
+      frames: frames.map(frame => ({
+        type: frame.type,
+        ids: frame.conversations?.map(row => row.sessionId),
+        timesAreIso: frame.conversations?.every(row =>
+          [row.createdAt, row.updatedAt].every(
+            value => /^\d{4}-\d\d-\d\dT/.test(value) && !Number.isNaN(Date.parse(value))
+          )
+        ),
+      })),
+      calls: store.listCalls,
+    }).toEqual({
+      frames: [
+        {type: 'conversation_list', ids: ['newest', 'middle', 'oldest'], timesAreIso: true},
+        {type: 'conversation_list', ids: ['oldest'], timesAreIso: true},
+      ],
+      calls: [
+        {userId: 'connected-user', options: {limit: undefined, before: undefined}},
+        {
+          userId: 'connected-user',
+          options: {limit: 2, before: expect.objectContaining({sessionId: 'middle'})},
+        },
+      ],
+    });
+  });
+
+  it('reports unsupported history and a failed store without fabricating an empty list', async () => {
+    const disabled = await listFrames(await start(new InMemorySessionStore(), undefined), {type: 'list_conversations'});
+    const missing = await listFrames(await start(withoutListFor(new InMemorySessionStore()), {enabled: true}), {
+      type: 'list_conversations',
+    });
+    const failing = new RecordingStore();
+    failing.listFor = () => {
