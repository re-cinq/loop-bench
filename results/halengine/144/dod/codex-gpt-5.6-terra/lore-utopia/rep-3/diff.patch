diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..c96c6ef
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,151 @@
+import type {AddressInfo} from 'node:net';
+import express from 'express';
+import {WebSocket} from 'ws';
+import {createChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {createMockProvider} from '../providers/mock/index.js';
+import {createServer} from './createServer.js';
+import type {HalServer, HalServerOptions} from './createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+import type {SessionListOptions, SessionSummary} from '../types/sessionStore.js';
+
+class RecordingStore extends InMemorySessionStore {
+  readonly listCalls: Array<{userId: string | number; options: SessionListOptions | undefined}> = [];
+
+  override listFor(userId: string | number, options?: SessionListOptions): SessionSummary[] {
+    this.listCalls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+interface ConversationListFrame {
+  type: 'conversation_list';
+  conversations: Array<{
+    sessionId: string;
+    createdAt: string;
+    updatedAt: string;
+    entryCount: number;
+  }>;
+}
+
+interface ErrorFrame {
+  type: 'error';
+  code: string;
+}
+
+interface ListResponse {
+  frame: ConversationListFrame | ErrorFrame;
+  frameTypes: string[];
+}
+
+const orchestrator = createChatOrchestrator(createMockProvider(), new PromptBuilder({identity: 'Acceptance test.'}));
+
+const start = async (store: InMemorySessionStore, history?: {enabled: boolean}) => {
+  const options = {
+    app: express(),
+    wsAuth: async () => ({id: 'connected-user'}),
+    sessionStore: store,
+    orchestrator,
+    history,
+  } as unknown as HalServerOptions;
+  const hal = createServer(options);
+  await hal.start(0);
+  const {port} = hal.server.address() as AddressInfo;
+  return {hal, url: `ws://127.0.0.1:${port}/hal/ws`};
+};
+
+const requestList = async (url: string): Promise<ListResponse> =>
+  new Promise((resolve, reject) => {
+    const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'token']);
+    let response: ConversationListFrame | ErrorFrame | undefined;
+    const frameTypes: string[] = [];
+    client.once('error', reject);
+    client.once('close', () => {
+      if (response === undefined) reject(new Error('socket closed before the conversation-list response'));
+      else resolve({frame: response, frameTypes});
+    });
+    client.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as {type: string};
+      frameTypes.push(frame.type);
+      if (frame.type === 'connected') {
+        client.send(JSON.stringify({type: 'list_conversations', userId: 'another-user'}));
+        return;
+      }
+      if (frame.type === 'conversation_list' || frame.type === 'error') {
+        response = frame as ConversationListFrame | ErrorFrame;
+        setTimeout(() => client.terminate(), 20);
+      }
+    });
+  });
+
+const stop = async (hal: HalServer): Promise<void> => {
+  for (let attempt = 0; attempt < 50 && hal.wss.clients.size > 0; attempt++) {
+    await new Promise(resolve => setTimeout(resolve, 10));
+  }
+  await hal.stop();
+};
+
+describe('conversation list WebSocket acceptance', () => {
+  it('accepts only a complete, bounded conversation-list request', () => {
+    expect(validateMessage({type: 'list_conversations'})).toEqual({valid: true, data: {type: 'list_conversations'}});
+
+    for (const frame of [
+      {type: 'list_conversations', limit: 0},
+      {type: 'list_conversations', limit: 201},
+      {type: 'list_conversations', limit: 1.5},
+      {type: 'list_conversations', limit: '10'},
+      {type: 'list_conversations', before: {updatedAt: 'not a date', sessionId: 's1'}},
+      {type: 'list_conversations', before: {updatedAt: '2026-01-01T00:00:00.000Z'}},
+    ]) {
+      const result = validateMessage(frame);
+      expect(result.valid && result.error).toMatch(/limit|before/);
+    }
+  });
+
+  it('sends the authenticated user only their ISO conversation summaries when history is enabled', async () => {
+    const store = new RecordingStore();
+    for (const [sessionId, userId, timestamp] of [
+      ['old', 'connected-user', '2026-01-01T00:00:00.000Z'],
+      ['new', 'connected-user', '2026-01-03T00:00:00.000Z'],
+      ['middle', 'connected-user', '2026-01-02T00:00:00.000Z'],
+      ['private', 'another-user', '2026-01-04T00:00:00.000Z'],
+    ] as const) {
+      store.create(sessionId, userId).entries.push({role: 'user', content: sessionId, timestamp});
+    }
+    const {hal, url} = await start(store, {enabled: true});
+
+    try {
+      const {frame, frameTypes} = await requestList(url);
+
+      expect(frame).toEqual({
+        type: 'conversation_list',
+        conversations: expect.arrayContaining([
+          expect.objectContaining({sessionId: 'new', entryCount: 1}),
+          expect.objectContaining({sessionId: 'middle', entryCount: 1}),
+          expect.objectContaining({sessionId: 'old', entryCount: 1}),
+        ]),
+      });
+      if (frame.type === 'conversation_list') {
+        expect(frame.conversations.map(summary => summary.sessionId)).toEqual(['new', 'middle', 'old']);
+        expect(frame.conversations.every(summary => /^\d{4}-\d\d-\d\dT/.test(summary.createdAt))).toBe(true);
+        expect(frame.conversations.every(summary => /^\d{4}-\d\d-\d\dT/.test(summary.updatedAt))).toBe(true);
+      }
+      expect(frameTypes).toEqual(['connected', 'conversation_list']);
+      expect(store.listCalls).toEqual([{userId: 'connected-user', options: {limit: undefined, before: undefined}}]);
+    } finally {
+      await stop(hal);
+    }
+  });
+
+  it('refuses a list request with UNSUPPORTED until the deployer enables history', async () => {
+    const {hal, url} = await start(new InMemorySessionStore());
+
+    try {
+      await expect(requestList(url)).resolves.toMatchObject({frame: {type: 'error', code: 'UNSUPPORTED'}});
+    } finally {
+      await stop(hal);
+    }
+  });
+});