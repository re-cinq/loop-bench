diff --git a/src/transport/ws/conversationList.acceptance.test.ts b/src/transport/ws/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..14bccd1
--- /dev/null
+++ b/src/transport/ws/conversationList.acceptance.test.ts
@@ -0,0 +1,152 @@
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import type {Express} from 'express';
+import {createServer} from '../createServer.js';
+import type {HalServer} from '../createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './subprotocol.js';
+import {validateMessage} from './validation.js';
+import {InMemorySessionStore} from '../../infrastructure/stores/inMemorySessionStore.js';
+import {answeringOrchestrator} from '../wsTestSupport.js';
+
+// Real sockets make the connection's authenticated identity, rather than a frame field, observable.
+
+interface Frame {
+  type: string;
+  code?: string;
+  conversations?: Array<{sessionId: string; createdAt: string; updatedAt: string; entryCount: number}>;
+}
+
+class RecordingStore extends InMemorySessionStore {
+  readonly listCalls: Array<{userId: string | number; options: unknown}> = [];
+
+  override listFor(userId: string | number, options?: Parameters<InMemorySessionStore['listFor']>[1]) {
+    this.listCalls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+const servers: HalServer[] = [];
+const clients: WebSocket[] = [];
+
+afterEach(async () => {
+  await Promise.all(
+    clients.splice(0).map(
+      client =>
+        new Promise<void>(resolve => {
+          if (client.readyState === WebSocket.CLOSED) return resolve();
+          client.once('close', () => resolve());
+          client.terminate();
+        })
+    )
+  );
+  for (const server of servers) {
+    for (let attempt = 0; attempt < 50 && server.wss.clients.size > 0; attempt++) {
+      await new Promise(resolve => setTimeout(resolve, 10));
+    }
+  }
+  for (const server of servers.splice(0)) await server.stop();
+});
+
+const start = async (store: InMemorySessionStore, history?: {enabled: boolean}): Promise<string> => {
+  const server = createServer({
+    app: (() => undefined) as unknown as Express,
+    wsAuth: async () => ({id: 'owner'}),
+    sessionStore: store,
+    orchestrator: answeringOrchestrator,
+    // `history` is deliberately passed through the public server entry point before its type exists.
+    ...(history === undefined ? {} : {history}),
+  });
+  await server.start(0);
+  servers.push(server);
+  const {port} = server.server.address() as AddressInfo;
+  return `ws://127.0.0.1:${port}/hal/ws`;
+};
+
+const list = async (url: string, frame: unknown): Promise<Frame[]> => {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'token']);
+  clients.push(client);
+  const received: Frame[] = [];
+  await new Promise<void>(resolve => {
+    client.on('message', raw => {
+      const message = JSON.parse(String(raw)) as Frame;
+      received.push(message);
+      if (message.type === 'connected') client.send(JSON.stringify(frame));
+      if (message.type === 'conversation_list' || message.type === 'error') resolve();
+    });
+  });
+  return received;
+};
+
+describe('conversation-list WebSocket acceptance', () => {
+  it('accepts only a bounded list_conversations frame with a complete ISO cursor', () => {
+    const valid = validateMessage({
+      type: 'list_conversations',
+      limit: 200,
+      before: {updatedAt: '2026-01-02T03:04:05.000Z', sessionId: 's2'},
+    });
+    const invalid = [
+      {type: 'list_conversations', limit: 0},
+      {type: 'list_conversations', limit: 201},
+      {type: 'list_conversations', limit: 1.5},
+      {type: 'list_conversations', limit: '10'},
+      {type: 'list_conversations', before: {updatedAt: 'not a date', sessionId: 's2'}},
+      {type: 'list_conversations', before: {updatedAt: '2026-01-02T03:04:05.000Z'}},
+    ].map(frame => validateMessage(frame));
+
+    expect({valid, invalid: invalid.map(result => result.valid)}).toEqual({
+      valid: true,
+      invalid: [false, false, false, false, false, false],
+    });
+    expect(invalid.map(result => (result.valid ? '' : result.error))).toEqual(
+      expect.arrayContaining([expect.stringContaining('limit'), expect.stringContaining('before')])
+    );
+  });
+
+  it('delivers only the authenticated user’s ISO summaries and forwards the composite cursor', async () => {
+    const store = new RecordingStore();
+    for (const [sessionId, userId, timestamp] of [
+      ['older', 'owner', '2026-01-01T00:00:00.000Z'],
+      ['newer', 'owner', '2026-02-01T00:00:00.000Z'],
+      ['private', 'other-user', '2026-03-01T00:00:00.000Z'],
+    ] as const) {
+      store.create(sessionId, userId).entries.push({role: 'user', content: sessionId, timestamp});
+    }
+    const before = {updatedAt: '2099-01-01T00:00:00.000Z', sessionId: 'later'};
+
+    const frames = await list(await start(store, {enabled: true}), {
+      type: 'list_conversations',
+      userId: 'other-user',
+      limit: 200,
+      before,
+    });
+
+    const response = frames.find(frame => frame.type === 'conversation_list');
+    expect({calls: store.listCalls, ids: response?.conversations?.map(row => row.sessionId).sort()}).toEqual({
+      calls: [{userId: 'owner', options: {limit: 200, before}}],
+      ids: expect.arrayContaining(['older', 'newer']),
+    });
+    expect(response?.conversations).toEqual(
+      expect.arrayContaining([
+        expect.objectContaining({
+          sessionId: 'newer',
+          createdAt: expect.stringMatching(/^\d{4}-\d{2}-\d{2}T/),
+          updatedAt: '2026-02-01T00:00:00.000Z',
+          entryCount: 1,
+        }),
+      ])
+    );
+    expect(frames.map(frame => frame.type)).not.toContain('stream_end');
+  });
+
+  it('reports UNSUPPORTED instead of an empty list when history is disabled or unavailable', async () => {
+    const disabled = await list(await start(new InMemorySessionStore()), {type: 'list_conversations'});
+    const unavailableStore = new InMemorySessionStore();
+    unavailableStore.listFor = undefined;
+    const unavailable = await list(await start(unavailableStore, {enabled: true}), {type: 'list_conversations'});
+
+    expect([disabled.at(-1), unavailable.at(-1)]).toEqual([
+      {type: 'error', code: 'UNSUPPORTED', message: expect.any(String)},
+      {type: 'error', code: 'UNSUPPORTED', message: expect.any(String)},
+    ]);
+  });
+});