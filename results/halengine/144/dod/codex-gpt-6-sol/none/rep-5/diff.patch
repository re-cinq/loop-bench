diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..0c13285
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,221 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import {createHalEngine} from '../config.js';
+import type {HalEngineConfig} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {SessionListOptions, SessionStore, SessionSummary} from '../types/sessionStore.js';
+import {validateMessage} from './ws/validation.js';
+import {setLogger} from '../shared/logger.js';
+
+interface Frame {
+  type: string;
+  sessionId?: string;
+  resumed?: boolean;
+  entry?: {content?: string};
+  code?: string;
+  conversations?: Array<{sessionId: string; createdAt: string; updatedAt: string; entryCount: number}>;
+}
+
+class RecordingSessionStore extends InMemorySessionStore {
+  readonly listCalls: Array<{userId: string | number; options: SessionListOptions | undefined}> = [];
+
+  override listFor(userId: string | number, options?: SessionListOptions): SessionSummary[] {
+    this.listCalls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+const engines: Array<ReturnType<typeof createHalEngine>> = [];
+const clients: WebSocket[] = [];
+
+async function start(
+  store: SessionStore,
+  transport?: HalEngineConfig['transport'],
+  orchestrator?: HalEngineConfig['orchestrator']
+) {
+  const engine = createHalEngine({
+    provider: {type: 'mock'},
+    prompt: {identity: 'test'},
+    session: store,
+    auth: {ws: async () => ({id: 'alice'})},
+    transport,
+    orchestrator,
+  });
+  engines.push(engine);
+  await engine.start(0);
+  return `ws://127.0.0.1:${(engine.server.address() as AddressInfo).port}/hal/ws`;
+}
+
+async function connect(url: string) {
+  const client = new WebSocket(url, ['hal.v1', 'token']);
+  clients.push(client);
+  const frames: Frame[] = [];
+  client.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  await once(client, 'open');
+  await until(client, frames, frame => frame.type === 'connected');
+  return {client, frames};
+}
+
+function until(client: WebSocket, frames: Frame[], matches: (frame: Frame) => boolean): Promise<Frame> {
+  const existing = frames.find(matches);
+  if (existing) return Promise.resolve(existing);
+  return new Promise(resolve => {
+    const listener = (raw: Buffer) => {
+      const frame = JSON.parse(String(raw)) as Frame;
+      if (matches(frame)) {
+        client.off('message', listener);
+        resolve(frame);
+      }
+    };
+    client.on('message', listener);
+  });
+}
+
+async function request(client: WebSocket, frames: Frame[], payload: object): Promise<Frame> {
+  const answer = until(client, frames, frame => frame.type === 'conversation_list' || frame.type === 'error');
+  client.send(JSON.stringify(payload));
+  return answer;
+}
+
+function history(enabled: boolean): HalEngineConfig['transport'] {
+  return {history: {enabled}, resume: {enabled: true}} as HalEngineConfig['transport'];
+}
+
+beforeAll(() => {
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined});
+});
+
+afterAll(() => {
+  setLogger();
+});
+
+afterEach(async () => {
+  for (const client of clients.splice(0)) {
+    if (client.readyState !== WebSocket.CLOSED) {
+      const closed = once(client, 'close');
+      client.terminate();
+      await closed;
+    }
+  }
+  for (const engine of engines.splice(0)) await engine.stop();
+});
+
+describe('conversation list over the WebSocket', () => {
+  it('accepts a list request and rejects invalid limits or incomplete cursors', () => {
+    expect(validateMessage({type: 'list_conversations'})).toMatchObject({
+      valid: true,
+      data: {type: 'list_conversations'},
+    });
+    expect(
+      validateMessage({
+        type: 'list_conversations',
+        limit: 2,
+        before: {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: 's1'},
+      })
+    ).toMatchObject({valid: true});
+    for (const limit of [0, 201, 1.5, '10']) {
+      expect(validateMessage({type: 'list_conversations', limit})).toMatchObject({
+        valid: false,
+        error: expect.stringMatching(/limit/),
+      });
+    }
+    for (const before of [
+      'not a date',
+      {updatedAt: 'not a date', sessionId: 's1'},
+      {updatedAt: '2026-01-01T00:00:00.000Z'},
+      {sessionId: 's1'},
+    ]) {
+      expect(validateMessage({type: 'list_conversations', before})).toMatchObject({
+        valid: false,
+        error: expect.stringMatching(/before/),
+      });
+    }
+  });
+
+  it('lists only the authenticated user’s summaries, pages on the wire cursor, and resumes a selected row', async () => {
+    const store = new RecordingSessionStore();
+    const older = store.create('older', 'alice');
+    older.entries.push({role: 'user', content: 'private older text', timestamp: '2030-01-02T00:00:00.000Z'});
+    const newer = store.create('newer', 'alice');
+    newer.entries.push({role: 'user', content: 'private newer text', timestamp: '2030-01-03T00:00:00.000Z'});
+    store.create('someone-elses', 'bob');
+    const base = await start(store, history(true));
+    const {client, frames} = await connect(base);
+    expect(Object.keys(frames[0]).sort()).toEqual(['examplePrompts', 'message', 'resumed', 'sessionId', 'type']);
+    expect(frames.some(frame => frame.type === 'conversation_list')).toBe(false);
+
+    const answer = await request(client, frames, {type: 'list_conversations', userId: 'bob'});
+    expect(answer.type).toBe('conversation_list');
+    expect(store.listCalls).toEqual([{userId: 'alice', options: {limit: undefined, before: undefined}}]);
+    expect(answer.conversations?.map(row => row.sessionId)).toEqual(['newer', 'older', frames[0].sessionId]);
+    for (const row of answer.conversations ?? []) {
+      expect(Object.keys(row).sort()).toEqual(['createdAt', 'entryCount', 'sessionId', 'updatedAt']);
+      expect(row.createdAt).toBe(new Date(row.createdAt).toISOString());
+      expect(row.updatedAt).toBe(new Date(row.updatedAt).toISOString());
+    }
+    expect(frames.some(frame => frame.type === 'stream_end')).toBe(false);
+
+    const cursor = {updatedAt: answer.conversations![0].updatedAt, sessionId: answer.conversations![0].sessionId};
+    const next = until(client, frames.slice(), frame => frame.type === 'conversation_list' && frame !== answer);
+    client.send(JSON.stringify({type: 'list_conversations', limit: 1, before: cursor}));
+    const page = await next;
+    expect(page.conversations?.map(row => row.sessionId)).toEqual(['older']);
+    expect(store.listCalls[1]).toEqual({userId: 'alice', options: {limit: 1, before: cursor}});
+
+    const resumed = await connect(`${base}?sessionId=${answer.conversations?.[0].sessionId}`);
+    expect(resumed.frames[0]).toMatchObject({type: 'connected', sessionId: 'newer', resumed: true});
+    await until(resumed.client, resumed.frames, frame => frame.type === 'entry_upsert');
+    expect(resumed.frames.find(frame => frame.type === 'entry_upsert')?.entry?.content).toBe('private newer text');
+  });
+
+  it('answers with UNSUPPORTED when history is not enabled', async () => {
+    const base = await start(new InMemorySessionStore());
+    const {client, frames} = await connect(base);
+    expect(await request(client, frames, {type: 'list_conversations'})).toMatchObject({
+      type: 'error',
+      code: 'UNSUPPORTED',
+    });
+    expect(frames.some(frame => frame.type === 'conversation_list')).toBe(false);
+  });
+
+  it('answers with UNSUPPORTED when an enabled store has no listFor', async () => {
+    const store: SessionStore = new InMemorySessionStore();
+    Object.defineProperty(store, 'listFor', {value: undefined});
+    const base = await start(store, history(true));
+    const {client, frames} = await connect(base);
+    expect(await request(client, frames, {type: 'list_conversations'})).toMatchObject({
+      type: 'error',
+      code: 'UNSUPPORTED',
+    });
+    expect(frames.some(frame => frame.type === 'conversation_list')).toBe(false);
+  });
+
+  it('answers a list request before a streaming turn ends', async () => {
+    let release = (): void => undefined;
+    const held = new Promise<void>(resolve => {
+      release = resolve;
+    });
+    const base = await start(new InMemorySessionStore(), history(true), {
+      hooks: {
+        beforeModelResponse: async (_session, prompt) => {
+          await held;
+          return prompt;
+        },
+      },
+    });
+    const {client, frames} = await connect(base);
+    client.send(JSON.stringify({type: 'user_message', content: 'hello'}));
+    await until(client, frames, frame => frame.type === 'entry_upsert');
+    try {
+      const answer = await Promise.race([
+        request(client, frames, {type: 'list_conversations'}),
+        new Promise<undefined>(resolve => setTimeout(() => resolve(undefined), 500)),
+      ]);
+      expect(answer?.type).toBe('conversation_list');
+      expect(frames.some(frame => frame.type === 'stream_end')).toBe(false);
+    } finally {
+      release();
+    }
+  });
+});