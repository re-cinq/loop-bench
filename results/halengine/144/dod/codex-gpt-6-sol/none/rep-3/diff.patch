diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..f210caa
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,158 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import express from 'express';
+import {WebSocket} from 'ws';
+import type {RawData} from 'ws';
+import {createServer} from './createServer.js';
+import {answeringOrchestrator} from './wsTestSupport.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {SessionCursor, SessionListOptions, SessionSummary} from '../types/sessionStore.js';
+
+interface Frame {
+  type: string;
+  code?: string;
+  sessionId?: string;
+  resumed?: boolean;
+  conversations?: Array<Omit<SessionSummary, 'createdAt' | 'updatedAt'> & {createdAt: string; updatedAt: string}>;
+}
+
+class RecordingStore extends InMemorySessionStore {
+  calls: Array<{userId: string | number; options: SessionListOptions | undefined}> = [];
+
+  override listFor(userId: string | number, options?: SessionListOptions): SessionSummary[] {
+    this.calls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+const running: Array<ReturnType<typeof createServer>> = [];
+const clients: WebSocket[] = [];
+
+afterEach(async () => {
+  for (const client of clients.splice(0)) client.terminate();
+  for (const server of running.splice(0)) {
+    for (let attempt = 0; attempt < 50 && server.wss.clients.size > 0; attempt++) {
+      await new Promise(resolve => setTimeout(resolve, 10));
+    }
+    await server.stop();
+  }
+});
+
+async function start(store: InMemorySessionStore, history?: {enabled: boolean}) {
+  const options = {
+    app: express(),
+    wsAuth: async () => ({id: 'owner'}),
+    sessionStore: store,
+    orchestrator: answeringOrchestrator,
+    resume: {enabled: true},
+    history,
+  };
+  const server = createServer(options);
+  await server.start(0);
+  running.push(server);
+  return `ws://127.0.0.1:${(server.server.address() as AddressInfo).port}/hal/ws`;
+}
+
+function nextFrame(client: WebSocket): Promise<Frame> {
+  return new Promise((resolve, reject) => {
+    const timeout = setTimeout(() => {
+      client.off('message', receive);
+      reject(new Error('Timed out waiting for a WebSocket frame'));
+    }, 2000);
+    const receive = (raw: RawData) => {
+      clearTimeout(timeout);
+      resolve(JSON.parse(String(raw)) as Frame);
+    };
+    client.once('message', receive);
+  });
+}
+
+async function connect(url: string): Promise<{client: WebSocket; connected: Frame}> {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'token']);
+  clients.push(client);
+  const connected = nextFrame(client);
+  await once(client, 'open');
+  return {client, connected: await connected};
+}
+
+async function request(client: WebSocket, frame: object): Promise<Frame> {
+  const answer = nextFrame(client);
+  client.send(JSON.stringify(frame));
+  return answer;
+}
+
+// specs/hal-engine-websocket-protocol/spec.md#conversation-list-validation
+describe('conversation list over the WebSocket protocol', () => {
+  it('accepts a list request and rejects invalid limits and incomplete or invalid cursors', () => {
+    expect(validateMessage({type: 'list_conversations'})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations'},
+    });
+
+    for (const limit of [0, 201, 1.5, '10']) {
+      expect(validateMessage({type: 'list_conversations', limit})).toMatchObject({
+        valid: false,
+        error: expect.stringMatching(/limit/i),
+      });
+    }
+    for (const before of [
+      {updatedAt: 'not a date', sessionId: 'one'},
+      {updatedAt: '2026-01-01T00:00:00.000Z'},
+      {sessionId: 'one'},
+    ]) {
+      expect(validateMessage({type: 'list_conversations', before})).toMatchObject({
+        valid: false,
+        error: expect.stringMatching(/before/i),
+      });
+    }
+  });
+
+  // specs/hal-engine-websocket-protocol/spec.md#conversation-list-answer
+  it('lists only the authenticated user’s summaries in order, pages with the wire cursor, and reopens a row', async () => {
+    const store = new RecordingStore();
+    for (const [id, owner, time] of [
+      ['old', 'owner', '2027-01-01T00:00:00.000Z'],
+      ['middle', 'owner', '2027-01-02T00:00:00.000Z'],
+      ['new', 'owner', '2027-01-03T00:00:00.000Z'],
+      ['private', 'another-user', '2027-01-04T00:00:00.000Z'],
+    ]) {
+      store.create(id, owner).entries.push({role: 'user', content: id, timestamp: time});
+    }
+    const url = await start(store, {enabled: true});
+    const {client} = await connect(`${url}?sessionId=new`);
+
+    const first = await request(client, {type: 'list_conversations', userId: 'another-user'});
+    expect(first.type).toBe('conversation_list');
+    expect(first.conversations?.map(row => row.sessionId)).toEqual(['new', 'middle', 'old']);
+    expect(store.calls[0]).toEqual({userId: 'owner', options: {limit: undefined, before: undefined}});
+    for (const row of first.conversations ?? []) {
+      expect(Object.keys(row).sort()).toEqual(['createdAt', 'entryCount', 'sessionId', 'updatedAt']);
+      expect(row.createdAt).toBe(new Date(row.createdAt).toISOString());
+      expect(row.updatedAt).toBe(new Date(row.updatedAt).toISOString());
+    }
+
+    const before: SessionCursor = {
+      updatedAt: first.conversations![0].updatedAt,
+      sessionId: first.conversations![0].sessionId,
+    };
+    const second = await request(client, {type: 'list_conversations', limit: 1, before});
+    expect(second.conversations?.map(row => row.sessionId)).toEqual(['middle']);
+    expect(store.calls[1]).toEqual({userId: 'owner', options: {limit: 1, before}});
+
+    const resumed = await connect(`${url}?sessionId=${first.conversations![0].sessionId}`);
+    expect(resumed.connected).toMatchObject({type: 'connected', sessionId: 'new', resumed: true});
+  });
+
+  // specs/hal-engine-websocket-protocol/spec.md#conversation-list-opt-in
+  it('refuses a list when history is not enabled instead of reporting an empty history', async () => {
+    const store = new RecordingStore();
+    store.create('existing', 'owner');
+    const url = await start(store);
+    const {client} = await connect(url);
+
+    expect(await request(client, {type: 'list_conversations'})).toMatchObject({type: 'error', code: 'UNSUPPORTED'});
+    expect(store.calls).toEqual([]);
+  });
+});