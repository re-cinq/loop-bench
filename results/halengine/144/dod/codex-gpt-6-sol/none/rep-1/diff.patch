index 0000000..806a46c
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,226 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import {createServer} from './createServer.js';
+import {createApp} from './createApp.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {createChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import type {SessionListOptions, SessionSummary} from '../types/sessionStore.js';
+import {setLogger} from '../shared/logger.js';
+import {deferred} from './wsTestSupport.js';
+
+interface Frame {
+  type: string;
+  sessionId?: string;
+  resumed?: boolean;
+  code?: string;
+  message?: string;
+  conversations?: Array<{sessionId: string; createdAt: string; updatedAt: string; entryCount: number}>;
+}
+
+class RecordingStore extends InMemorySessionStore {
+  readonly calls: Array<{userId: string | number; options?: SessionListOptions}> = [];
+
+  override listFor(userId: string | number, options?: SessionListOptions): SessionSummary[] {
+    this.calls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+const running: Array<ReturnType<typeof createServer>> = [];
+const sockets: WebSocket[] = [];
+
+async function engine(store: InMemorySessionStore, history?: {enabled: boolean}, gate?: ReturnType<typeof deferred>) {
+  const orchestrator = createChatOrchestrator(
+    createMockProvider(),
+    new PromptBuilder({identity: 'History test.'}),
+    undefined,
+    {
+      hooks: gate
+        ? {
+            beforeModelResponse: async (_session, prompt) => {
+              await gate.until;
+              return prompt;
+            },
+          }
+        : undefined,
+    }
+  );
+  const options = {
+    app: createApp(),
+    wsAuth: async () => ({id: 'owner'}),
+    sessionStore: store,
+    orchestrator,
+    ...(history ? {history} : {}),
+    resume: {enabled: true},
+  };
+  const hal = createServer(options);
+  await hal.start(0);
+  running.push(hal);
+  return `ws://127.0.0.1:${(hal.server.address() as AddressInfo).port}/hal/ws`;
+}
+
+async function connect(url: string): Promise<{socket: WebSocket; connected: Frame; frames: Frame[]}> {
+  const socket = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'token']);
+  sockets.push(socket);
+  const frames: Frame[] = [];
+  socket.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  const [raw] = await once(socket, 'message');
+  return {socket, connected: JSON.parse(String(raw)) as Frame, frames};
+}
+
+function whenFrame(socket: WebSocket, wanted: string): Promise<void> {
+  return new Promise(resolve => {
+    const read = (raw: unknown) => {
+      if ((JSON.parse(String(raw)) as Frame).type !== wanted) return;
+      socket.off('message', read);
+      resolve();
+    };
+    socket.on('message', read);
+  });
+}
+
+async function answer(socket: WebSocket, request: object): Promise<Frame> {
+  const response = once(socket, 'message');
+  socket.send(JSON.stringify(request));
+  const [raw] = await response;
+  return JSON.parse(String(raw)) as Frame;
+}
+
+beforeAll(() =>
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined})
+);
+afterAll(() => setLogger());
+afterEach(async () => {
+  await Promise.all(
+    sockets.splice(0).map(async socket => {
+      if (socket.readyState === WebSocket.CLOSED) return;
+      const closed = once(socket, 'close');
+      socket.terminate();
+      await closed;
+    })
+  );
+  for (const hal of running.splice(0)) {
+    for (let attempt = 0; attempt < 50 && hal.wss.clients.size > 0; attempt++) {
+      await new Promise(resolve => setTimeout(resolve, 10));
+    }
+    await hal.stop();
+  }
+});
+
+// specs/hal-engine-websocket-protocol/spec.md#4.3
+it('accepts list requests and rejects invalid limits or incomplete cursors', () => {
+  const cursor = {updatedAt: '2026-01-15T14:30:00.000Z', sessionId: 'earlier'};
+  expect(validateMessage({type: 'list_conversations'})).toMatchObject({valid: true});
+  expect(validateMessage({type: 'list_conversations', limit: 2, before: cursor})).toEqual({
+    valid: true,
+    data: {type: 'list_conversations', limit: 2, before: cursor},
+  });
+  for (const limit of [0, 201, 1.5, '10']) {
+    expect(validateMessage({type: 'list_conversations', limit})).toMatchObject({
+      valid: false,
+      error: expect.stringMatching(/limit/i),
+    });
+  }
+  for (const before of [{updatedAt: 'not a date', sessionId: 'earlier'}, {updatedAt: cursor.updatedAt}]) {
+    expect(validateMessage({type: 'list_conversations', before})).toMatchObject({
+      valid: false,
+      error: expect.stringMatching(/before/i),
+    });
+  }
+});
+
+// specs/hal-engine-websocket-protocol/spec.md#4.3
+it('lists only the authenticated user’s newest summaries and passes a composite cursor to the store', async () => {
+  const store = new RecordingStore();
+  for (const [id, user, activity] of [
+    ['older', 'owner', '2999-01-01T00:00:00.000Z'],
+    ['newer', 'owner', '2999-01-03T00:00:00.000Z'],
+    ['middle', 'owner', '2999-01-02T00:00:00.000Z'],
+    ['secret', 'someone-else', '2999-01-04T00:00:00.000Z'],
+  ]) {
+    store.create(id, user).entries.push({role: 'user', content: id, timestamp: activity});
+  }
+  const url = await engine(store, {enabled: true});
+  const {socket, connected, frames} = await connect(url);
+  const first = await answer(socket, {type: 'list_conversations', userId: 'someone-else', limit: 2});
+
+  expect(first.type).toBe('conversation_list');
+  expect(first.conversations?.map(row => row.sessionId)).toEqual(['newer', 'middle']);
+  expect(
+    first.conversations?.every(row => Object.keys(row).sort().join(',') === 'createdAt,entryCount,sessionId,updatedAt')
+  ).toBe(true);
+  expect(
+    first.conversations?.every(
+      row =>
+        new Date(row.createdAt).toISOString() === row.createdAt &&
+        new Date(row.updatedAt).toISOString() === row.updatedAt
+    )
+  ).toBe(true);
+  expect(store.calls[0]).toEqual({userId: 'owner', options: {limit: 2, before: undefined}});
+
+  const before = {updatedAt: first.conversations![1].updatedAt, sessionId: first.conversations![1].sessionId};
+  const second = await answer(socket, {type: 'list_conversations', limit: 2, before});
+  expect(second.conversations?.map(row => row.sessionId)).toEqual(['older', connected.sessionId]);
+  expect(store.calls[1]).toEqual({userId: 'owner', options: {limit: 2, before}});
+  await answer(socket, {type: 'ping', timestamp: 9});
+  expect(frames.map(frame => frame.type)).toEqual(['connected', 'conversation_list', 'conversation_list', 'pong']);
+});
+
+// specs/hal-engine-websocket-protocol/spec.md#4.3
+it('returns UNSUPPORTED when history is off or the store cannot list', async () => {
+  const off = await engine(new InMemorySessionStore());
+  const offSocket = (await connect(off)).socket;
+  expect(await answer(offSocket, {type: 'list_conversations'})).toMatchObject({type: 'error', code: 'UNSUPPORTED'});
+
+  const store = new InMemorySessionStore();
+  Object.defineProperty(store, 'listFor', {value: undefined});
+  const on = await engine(store, {enabled: true});
+  const onSocket = (await connect(on)).socket;
+  expect(await answer(onSocket, {type: 'list_conversations'})).toMatchObject({type: 'error', code: 'UNSUPPORTED'});
+});
+
+// specs/hal-engine-websocket-protocol/spec.md#5.9
+it('returns a generic SERVER_ERROR for a failed list and keeps the socket usable', async () => {
+  class FailingStore extends InMemorySessionStore {
+    override listFor(): SessionSummary[] {
+      throw new Error('private database detail');
+    }
+  }
+  const url = await engine(new FailingStore(), {enabled: true});
+  const {socket} = await connect(url);
+  const failure = await answer(socket, {type: 'list_conversations'});
