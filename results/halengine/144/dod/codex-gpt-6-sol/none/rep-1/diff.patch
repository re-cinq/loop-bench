+// specs/hal-engine-websocket-protocol/spec.md#4.3
+it('answers a list during a turn and lets its selected conversation resume with replay', async () => {
+  const gate = deferred();
+  const store = new InMemorySessionStore();
+  const url = await engine(store, {enabled: true}, gate);
+  const {socket, connected} = await connect(url);
+  socket.send(JSON.stringify({type: 'user_message', content: 'hello'}));
+  const [upsert] = await once(socket, 'message');
+  expect((JSON.parse(String(upsert)) as Frame).type).toBe('entry_upsert');
+  const list = await answer(socket, {type: 'list_conversations'});
+  expect(list.type).toBe('conversation_list');
+  expect(list.conversations?.map(row => row.sessionId)).toContain(connected.sessionId);
+
+  const streamEnded = whenFrame(socket, 'stream_end');
+  gate.release();
+  await streamEnded;
+  const selected = list.conversations![0].sessionId;
+  const resumed = await connect(`${url}?sessionId=${selected}`);
+  expect(resumed.connected).toMatchObject({type: 'connected', sessionId: selected, resumed: true});
+  const pong = whenFrame(resumed.socket, 'pong');
+  resumed.socket.send(JSON.stringify({type: 'ping', timestamp: 8}));
+  await pong;
+  expect(resumed.frames.filter(frame => frame.type === 'entry_upsert')).toHaveLength(2);
