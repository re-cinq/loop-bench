index 0000000..6aa5a8b
--- /dev/null
+++ b/src/transport/ws/conversationList.acceptance.test.ts
@@ -0,0 +1,250 @@
+import type {AddressInfo} from 'node:net';
+import {once} from 'node:events';
+import {WebSocket} from 'ws';
+import {InMemorySessionStore} from '../../infrastructure/stores/inMemorySessionStore.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {createChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import type {OrchestratorHooks} from '../../orchestration/chatOrchestrator.js';
+import {createMockProvider} from '../../providers/mock/mockProvider.js';
+import {setLogger} from '../../shared/logger.js';
+import type {SessionListOptions, SessionSummary} from '../../types/sessionStore.js';
+import {createServer} from '../createServer.js';
+import {createApp} from '../createApp.js';
+import {HAL_WS_SUBPROTOCOL} from './subprotocol.js';
+import {validateMessage} from './validation.js';
+
+// specs/hal-engine-websocket-protocol/spec.md#conversation-list
+interface Frame {
+  type: string;
+  code?: string;
+  resumed?: boolean;
+  entry?: {role: string; content: string};
+  conversations?: Array<{sessionId: string; createdAt: string; updatedAt: string; entryCount: number}>;
+}
+
+class RecordingStore extends InMemorySessionStore {
+  calls: Array<{userId: string | number; options: SessionListOptions | undefined}> = [];
+
+  override listFor(userId: string | number, options?: SessionListOptions): SessionSummary[] {
+    this.calls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+const servers: Array<ReturnType<typeof createServer>> = [];
+const clients: WebSocket[] = [];
+
+beforeAll(() =>
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined})
+);
+afterAll(() => setLogger());
+afterEach(async () => {
+  await Promise.all(
+    clients.splice(0).map(async client => {
+      if (client.readyState === WebSocket.CLOSED) return;
+      const closed = once(client, 'close');
+      client.terminate();
+      await closed;
+    })
+  );
+  for (const server of servers.splice(0)) {
+    for (let attempt = 0; attempt < 50 && server.wss.clients.size > 0; attempt++) {
+      await new Promise(resolve => setTimeout(resolve, 10));
+    }
+    await server.stop();
+  }
+});
+
+async function connect(store: InMemorySessionStore, history?: {enabled: boolean}, hooks?: OrchestratorHooks) {
+  const orchestrator = createChatOrchestrator(createMockProvider(), new PromptBuilder({identity: 'Test'}), undefined, {
+    hooks,
+  });
+  const server = createServer({
+    app: createApp(),
+    wsAuth: async () => ({id: 'owner'}),
+    sessionStore: store,
+    orchestrator,
+    history,
+    resume: {enabled: true},
+  } as Parameters<typeof createServer>[0] & {history?: {enabled: boolean}});
+  servers.push(server);
+  await server.start(0);
+  const port = (server.server.address() as AddressInfo).port;
+  const client = new WebSocket(`ws://127.0.0.1:${port}/hal/ws`, [HAL_WS_SUBPROTOCOL, 'token']);
+  clients.push(client);
+  await new Promise<void>(resolve => client.once('message', () => resolve()));
+  return client;
+}
+
+async function request(client: WebSocket, payload: object): Promise<Frame[]> {
+  const frames: Frame[] = [];
+  const result = new Promise<Frame[]>((resolve, reject) => {
+    const timer = setTimeout(() => reject(new Error('No response to list_conversations')), 3000);
+    const onMessage = (raw: unknown) => {
+      const frame = JSON.parse(String(raw)) as Frame;
+      frames.push(frame);
+      if (frame.type === 'conversation_list' || frame.type === 'error') {
+        clearTimeout(timer);
+        client.off('message', onMessage);
+        resolve(frames);
+      }
+    };
+    client.on('message', onMessage);
+  });
+  client.send(JSON.stringify(payload));
+  return result;
+}
+
+async function settle(client: WebSocket): Promise<Frame[]> {
+  const frames: Frame[] = [];
+  const result = new Promise<Frame[]>(resolve => {
+    const onMessage = (raw: unknown) => {
+      const frame = JSON.parse(String(raw)) as Frame;
+      frames.push(frame);
+      if (frame.type === 'pong') {
+        client.off('message', onMessage);
+        resolve(frames);
+      }
+    };
+    client.on('message', onMessage);
+  });
+  client.send(JSON.stringify({type: 'ping', timestamp: 1}));
+  return result;
+}
+
+async function reconnect(url: string): Promise<Frame[]> {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'token']);
+  clients.push(client);
+  const frames: Frame[] = [];
+  return new Promise(resolve => {
+    client.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as Frame;
+      frames.push(frame);
+      if (frame.type === 'connected') client.send(JSON.stringify({type: 'ping', timestamp: 1}));
+      if (frame.type === 'pong') resolve(frames);
+    });
+  });
+}
+
+describe('conversation list over the authenticated WebSocket', () => {
+  // specs/hal-engine-websocket-protocol/spec.md#1
+  it('accepts a list request and rejects malformed limits and cursors', () => {
+    const frame = (payload: object) => {
+      const result = validateMessage(payload);
+      return result.valid ? {valid: true} : {valid: false, error: result.error};
+    };
+    const limits = [0, 201, 1.5, '10'].map(limit => frame({type: 'list_conversations', limit}));
+    const cursors = ['not a date', {updatedAt: '2026-01-01T00:00:00.000Z'}, {sessionId: 'one'}].map(before =>
+      frame({type: 'list_conversations', before})
+    );
+    expect({plain: frame({type: 'list_conversations'}), limits, cursors}).toEqual({
+      plain: {valid: true},
+      limits: Array(4).fill({valid: false, error: expect.stringContaining('limit')}),
+      cursors: Array(3).fill({valid: false, error: expect.stringContaining('before')}),
+    });
+  });
+
+  // specs/hal-engine-websocket-protocol/spec.md#2
+  it('returns only the connection owner’s newest summaries, forwarding the page cursor', async () => {
+    const store = new RecordingStore();
+    for (const [id, user, time] of [
+      ['old', 'owner', '2027-01-01T00:00:00.000Z'],
+      ['new', 'owner', '2027-01-03T00:00:00.000Z'],
+      ['middle', 'owner', '2027-01-02T00:00:00.000Z'],
+      ['foreign', 'other', '2027-01-04T00:00:00.000Z'],
+    ]) {
+      store.create(id, user).entries.push({role: 'user', content: id, timestamp: time});
+    }
+    const client = await connect(store, {enabled: true});
+    const frames = await request(client, {type: 'list_conversations', userId: 'other'});
+    const afterList = await settle(client);
+    const before = {updatedAt: '2027-01-03T00:00:00.000Z', sessionId: 'new'};
+    const page = await request(client, {type: 'list_conversations', limit: 2, before});
+    const replay = await reconnect(`${client.url}?sessionId=new`);
+    const rows = frames[0].conversations ?? [];
+    expect({
+      firstFrames: frames.map(frame => frame.type),
+      afterList: afterList.map(frame => frame.type),
+      count: rows.length,
+      newest: rows.map(row => row.sessionId).slice(0, 3),
+      pageIds: page[0].conversations?.map(row => row.sessionId),
+      resumed: replay[0].resumed,
+      replayedEntries: replay.filter(frame => frame.type === 'entry_upsert').map(frame => frame.entry?.content),
+      rowShape: rows.map(row => ({
+        fields: Object.keys(row).sort(),
+        isoTimes:
+          row.createdAt === new Date(row.createdAt).toISOString() &&
+          row.updatedAt === new Date(row.updatedAt).toISOString(),
+      })),
+      calls: store.calls,
+    }).toEqual({
+      firstFrames: ['conversation_list'],
+      afterList: ['pong'],
+      count: 4,
+      newest: ['new', 'middle', 'old'],
+      pageIds: ['middle', 'old'],
+      resumed: true,
+      replayedEntries: ['new'],
+      rowShape: Array(4).fill({fields: ['createdAt', 'entryCount', 'sessionId', 'updatedAt'], isoTimes: true}),
+      calls: [
+        {userId: 'owner', options: {limit: undefined, before: undefined}},
+        {userId: 'owner', options: {limit: 2, before}},
+      ],
+    });
+  });
+
+  // specs/hal-engine-websocket-protocol/spec.md#4
+  it('answers a list while a turn is still streaming', async () => {
+    let release = (): void => undefined;
+    let entered = (): void => undefined;
+    const untilReleased = new Promise<void>(resolve => {
+      release = resolve;
+    });
+    const insideHook = new Promise<void>(resolve => {
+      entered = resolve;
+    });
+    const store = new InMemorySessionStore();
+    const client = await connect(
+      store,
+      {enabled: true},
+      {
+        afterModelResponse: async () => {
+          entered();
+          await untilReleased;
+        },
+      }
+    );
+    const frames: Frame[] = [];
+    client.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+    client.send(JSON.stringify({type: 'user_message', content: 'hello'}));
+    await insideHook;
+    try {
+      const response = await request(client, {type: 'list_conversations'});
+      expect({
+        responseTypes: response
+          .map(frame => frame.type)
+          .filter(type => type === 'conversation_list' || type === 'error'),
+        turnEnded: frames.some(frame => frame.type === 'stream_end'),
+      }).toEqual({
+        responseTypes: ['conversation_list'],
+        turnEnded: false,
+      });
+    } finally {
+      release();
+    }
+  });
+
+  // specs/hal-engine-websocket-protocol/spec.md#3
+  it('reports unsupported history when disabled or when the store cannot list', async () => {
+    const off = await connect(new InMemorySessionStore());
+    const disabled = await request(off, {type: 'list_conversations'});
+    const store = new InMemorySessionStore();
+    const withoutList = Object.assign(store, {listFor: undefined});
+    const enabled = await connect(withoutList, {enabled: true});
+    const unavailable = await request(enabled, {type: 'list_conversations'});
+    expect({disabled, unavailable}).toEqual({
+      disabled: [{type: 'error', code: 'UNSUPPORTED', message: expect.any(String)}],
+      unavailable: [{type: 'error', code: 'UNSUPPORTED', message: expect.any(String)}],
+    });
+  });
+});