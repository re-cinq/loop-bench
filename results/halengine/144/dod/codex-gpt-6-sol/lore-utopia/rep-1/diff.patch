+++ b/src/transport/ws/conversationList.acceptance.test.ts
@@ -0,0 +1,164 @@
+import type {AddressInfo} from 'net';
+import type {Express} from 'express';
+import {WebSocket} from 'ws';
+import {createServer} from '../createServer.js';
+import {InMemorySessionStore} from '../../infrastructure/stores/inMemorySessionStore.js';
+import type {SessionListOptions, SessionStore} from '../../types/sessionStore.js';
+import {HAL_WS_SUBPROTOCOL} from './subprotocol.js';
+import {answeringOrchestrator} from '../wsTestSupport.js';
+import {validateMessage} from './validation.js';
+
+interface Frame {
+  type: string;
+  code?: string;
+  sessionId?: string;
+  resumed?: boolean;
+  conversations?: Array<{
+    sessionId: string;
+    createdAt: string;
+    updatedAt: string;
+    entryCount: number;
+  }>;
+  entry?: {content?: string};
+}
+
+class RecordingStore extends InMemorySessionStore {
+  calls: Array<{userId: string | number; options?: SessionListOptions}> = [];
+
+  override listFor(userId: string | number, options?: SessionListOptions) {
+    this.calls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+const servers: Array<ReturnType<typeof createServer>> = [];
+const clients: WebSocket[] = [];
+
+afterEach(async () => {
+  for (const client of clients.splice(0)) client.terminate();
+  for (const server of servers.splice(0)) {
+    for (let attempt = 0; attempt < 50 && server.wss.clients.size; attempt++) {
+      await new Promise(resolve => setTimeout(resolve, 10));
+    }
+    await server.stop();
+  }
+});
+
+async function start(store: SessionStore, history?: {enabled: boolean}) {
+  const options = {
+    app: (() => undefined) as unknown as Express,
+    wsAuth: async () => ({id: 'owner'}),
+    sessionStore: store,
+    orchestrator: answeringOrchestrator,
+    resume: {enabled: true},
+    history,
+  };
+  const server = createServer(options);
+  await server.start(0);
+  servers.push(server);
+  const port = (server.server.address() as AddressInfo).port;
+  return `ws://127.0.0.1:${port}/hal/ws`;
+}
+
+async function open(url: string): Promise<{client: WebSocket; connected: Frame}> {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'token']);
+  clients.push(client);
+  const connected = await new Promise<Frame>((resolve, reject) => {
+    client.once('error', reject);
+    client.once('message', raw => resolve(JSON.parse(String(raw)) as Frame));
+  });
+  return {client, connected};
+}
+
+async function reply(client: WebSocket, request: object): Promise<Frame> {
+  const response = new Promise<Frame>((resolve, reject) => {
+    client.once('error', reject);
+    client.once('message', raw => resolve(JSON.parse(String(raw)) as Frame));
+  });
+  client.send(JSON.stringify(request));
+  return response;
+}
+
+// specs/hal-engine-websocket-protocol/spec.md#14.1
+describe('conversation list over the WebSocket protocol', () => {
+  it('accepts a list request and rejects malformed limits and cursors by field', () => {
+    expect(validateMessage({type: 'list_conversations'})).toMatchObject({valid: true});
+    for (const limit of [0, 201, 1.5, '10']) {
+      expect(validateMessage({type: 'list_conversations', limit})).toMatchObject({
+        valid: false,
+        error: expect.stringMatching(/limit/),
+      });
+    }
+    for (const before of [
+      'not a date',
+      {updatedAt: 'not a date', sessionId: 's1'},
+      {updatedAt: '2026-01-01T00:00:00.000Z'},
+      {sessionId: 's1'},
+    ]) {
+      expect(validateMessage({type: 'list_conversations', before})).toMatchObject({
+        valid: false,
+        error: expect.stringMatching(/before/),
+      });
+    }
+  });
+
+  // specs/hal-engine-websocket-protocol/spec.md#14.2
+  it('returns only the connected user’s newest summaries and pages by the supplied cursor', async () => {
+    const store = new RecordingStore();
+    for (const [id, user, day] of [
+      ['old', 'owner', '2026-01-01'],
+      ['middle', 'owner', '2026-01-02'],
+      ['new', 'owner', '2026-01-03'],
+      ['foreign', 'someone-else', '2026-01-04'],
+    ]) {
+      store.create(id, user).entries.push({role: 'user', content: id, timestamp: `${day}T12:00:00.000Z`});
+    }
+    const base = await start(store, {enabled: true});
+    const {client} = await open(base);
+
+    const first = await reply(client, {type: 'list_conversations', userId: 'someone-else'});
+    expect(first).toEqual({
+      type: 'conversation_list',
+      conversations: [
+        {sessionId: expect.any(String), createdAt: expect.any(String), updatedAt: expect.any(String), entryCount: 0},
+        {sessionId: 'new', createdAt: expect.any(String), updatedAt: '2026-01-03T12:00:00.000Z', entryCount: 1},
+        {sessionId: 'middle', createdAt: expect.any(String), updatedAt: '2026-01-02T12:00:00.000Z', entryCount: 1},
+        {sessionId: 'old', createdAt: expect.any(String), updatedAt: '2026-01-01T12:00:00.000Z', entryCount: 1},
+      ],
+    });
+    expect(first.conversations?.every(row => new Date(row.createdAt).toISOString() === row.createdAt)).toBe(true);
+    expect(store.calls[0]).toEqual({userId: 'owner', options: {limit: undefined, before: undefined}});
+
+    const before = {updatedAt: '2026-01-03T12:00:00.000Z', sessionId: 'new'};
+    const page = await reply(client, {type: 'list_conversations', limit: 1, before});
+    expect(page).toMatchObject({type: 'conversation_list', conversations: [{sessionId: 'middle'}]});
+    expect(store.calls[1]).toEqual({userId: 'owner', options: {limit: 1, before}});
+
+    const resumed = await open(`${base}?sessionId=${page.conversations?.[0].sessionId}`);
+    expect(resumed.connected).toMatchObject({type: 'connected', sessionId: 'middle', resumed: true});
+  });
+
+  // specs/hal-engine-websocket-protocol/spec.md#14.3
+  it('answers with UNSUPPORTED when history is disabled or the store cannot list', async () => {
+    const disabled = await open(await start(new InMemorySessionStore()));
+    expect(await reply(disabled.client, {type: 'list_conversations'})).toMatchObject({
+      type: 'error',
+      code: 'UNSUPPORTED',
+    });
+
+    const inner = new InMemorySessionStore();
+    const oldStore = {
+      create: inner.create.bind(inner),
+      get: inner.get.bind(inner),
+      delete: inner.delete.bind(inner),
+      count: inner.count.bind(inner),
+      clear: inner.clear.bind(inner),
+    };
+    const base = await start(oldStore, {enabled: true});
+    const enabled = await open(base);
+    expect(await reply(enabled.client, {type: 'list_conversations'})).toMatchObject({
+      type: 'error',
+      code: 'UNSUPPORTED',
+    });
+  });
+});