diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..0a9f2f3
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,226 @@
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import {createHalEngine} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {SessionListOptions, SessionStore, SessionSummary} from '../types/sessionStore.js';
+import {validateMessage} from './ws/validation.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {setLogger} from '../shared/logger.js';
+
+type Frame = Record<string, unknown> & {type: string};
+const engines: Array<ReturnType<typeof createHalEngine>> = [];
+const clients: WebSocket[] = [];
+
+class RecordingStore extends InMemorySessionStore {
+  calls: Array<{userId: string | number; options: SessionListOptions | undefined}> = [];
+
+  override listFor(userId: string | number, options?: SessionListOptions): SessionSummary[] {
+    this.calls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+const start = async (
+  store: SessionStore,
+  transport: {history?: {enabled: boolean}; resume?: {enabled: boolean}} = {},
+  beforeModelResponse?: () => Promise<string>
+): Promise<string> => {
+  const engine = createHalEngine({
+    provider: {type: 'mock'},
+    prompt: {identity: 'Conversation list acceptance test'},
+    session: store,
+    auth: {ws: async () => ({id: 'owner'})},
+    transport,
+    orchestrator: beforeModelResponse ? {hooks: {beforeModelResponse}} : undefined,
+  });
+  await engine.start(0);
+  engines.push(engine);
+  const {port} = engine.server.address() as AddressInfo;
+  return `ws://127.0.0.1:${port}/hal/ws`;
+};
+
+const connect = (url: string): {socket: WebSocket; frames: Frame[]; next: () => Promise<Frame>} => {
+  const socket = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'token']);
+  clients.push(socket);
+  const frames: Frame[] = [];
+  const pending: Array<(frame: Frame) => void> = [];
+  socket.on('message', raw => {
+    const frame = JSON.parse(String(raw)) as Frame;
+    frames.push(frame);
+    pending.shift()?.(frame);
+  });
+  let read = 0;
+  return {
+    socket,
+    frames,
+    next: () => {
+      if (read < frames.length) return Promise.resolve(frames[read++]);
+      read++;
+      return new Promise(resolve => pending.push(resolve));
+    },
+  };
+};
+
+const request = async (client: ReturnType<typeof connect>, frame: object): Promise<Frame> => {
+  client.socket.send(JSON.stringify(frame));
+  for (;;) {
+    const answer = await client.next();
+    if (answer.type === 'conversation_list' || answer.type === 'error') return answer;
+  }
+};
+
+beforeAll(() =>
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined})
+);
+afterAll(() => setLogger());
+afterEach(async () => {
+  await Promise.all(
+    clients.splice(0).map(
+      client =>
+        new Promise<void>(resolve => {
+          if (client.readyState === WebSocket.CLOSED) return resolve();
+          client.once('close', () => resolve());
+          client.terminate();
+        })
+    )
+  );
+  for (const engine of engines.splice(0)) await engine.stop();
+});
+
+describe('conversation list over the authenticated WebSocket', () => {
+  // specs/hal-engine-websocket-protocol/spec.md#1
+  it('accepts a list request and rejects malformed limits and composite cursors', () => {
+    expect(validateMessage({type: 'list_conversations'})).toMatchObject({
+      valid: true,
+      data: {type: 'list_conversations'},
+    });
+    for (const limit of [0, 201, 1.5, '10']) {
+      expect(validateMessage({type: 'list_conversations', limit})).toMatchObject({
+        valid: false,
+        error: expect.stringMatching(/limit/),
+      });
+    }
+    for (const before of [
+      'not a date',
+      {updatedAt: 'not a date', sessionId: 's1'},
+      {updatedAt: '2026-01-01T00:00:00.000Z'},
+      {sessionId: 's1'},
+    ]) {
+      expect(validateMessage({type: 'list_conversations', before})).toMatchObject({
+        valid: false,
+        error: expect.stringMatching(/before/),
+      });
+    }
+  });
+
+  // specs/hal-engine-websocket-protocol/spec.md#2
+  it('lists only the connected owner’s rows in newest-first order, pages with the wire cursor, and resumes a selected row', async () => {
+    const store = new RecordingStore();
+    for (const [id, user, stamp] of [
+      ['older', 'owner', '2030-01-01T00:00:00.000Z'],
+      ['middle', 'owner', '2030-01-02T00:00:00.000Z'],
+      ['newest', 'owner', '2030-01-03T00:00:00.000Z'],
+      ['private', 'someone-else', '2030-01-04T00:00:00.000Z'],
+    ]) {
+      store.create(id, user).entries.push({role: 'user', content: id, timestamp: stamp});
+    }
+    const base = await start(store, {history: {enabled: true}, resume: {enabled: true}});
+    const client = connect(`${base}?sessionId=newest`);
+    expect((await client.next()).type).toBe('connected');
+    client.socket.send(JSON.stringify({type: 'ping', timestamp: 7}));
+    while ((await client.next()).type !== 'pong') {
+      // Drain the resumed conversation's replay before asking for a list.
+    }
+    expect(client.frames.some(frame => frame.type === 'conversation_list')).toBe(false);
+
+    const first = await request(client, {type: 'list_conversations', userId: 'someone-else', limit: 3});
+    expect(first.type).toBe('conversation_list');
+    const rows = first.conversations as Array<Record<string, unknown>>;
+    expect(rows.map(row => row.sessionId)).toEqual(['newest', 'middle', 'older']);
+    expect(rows.every(row => Object.keys(row).sort().join(',') === 'createdAt,entryCount,sessionId,updatedAt')).toBe(
+      true
+    );
+    expect(
+      rows.every(
+        row =>
+          typeof row.createdAt === 'string' &&
+          typeof row.updatedAt === 'string' &&
+          new Date(row.createdAt as string).toISOString() === row.createdAt &&
+          new Date(row.updatedAt as string).toISOString() === row.updatedAt
+      )
+    ).toBe(true);
+    expect(store.calls[0]).toEqual({userId: 'owner', options: {limit: 3, before: undefined}});
+
+    const before = {updatedAt: rows[1].updatedAt, sessionId: rows[1].sessionId};
+    const second = await request(client, {type: 'list_conversations', limit: 1, before});
+    expect((second.conversations as Array<{sessionId: string}>).map(row => row.sessionId)).toEqual(['older']);
+    expect(store.calls[1]).toEqual({userId: 'owner', options: {limit: 1, before}});
+    client.socket.send(JSON.stringify({type: 'ping', timestamp: 8}));
+    expect(await client.next()).toMatchObject({type: 'pong', timestamp: 8});
+    expect(client.frames.filter(frame => frame.type === 'conversation_list')).toHaveLength(2);
+    expect(client.frames.filter(frame => frame.type === 'stream_end')).toHaveLength(0);
+
+    const selected = connect(`${base}?sessionId=${rows[0].sessionId}`);
+    expect(await selected.next()).toMatchObject({type: 'connected', sessionId: 'newest', resumed: true});
+    expect(await selected.next()).toMatchObject({type: 'entry_upsert', entry: {content: 'newest'}});
+  });
+
+  // specs/hal-engine-websocket-protocol/spec.md#3
+  it('answers disabled or unavailable history with UNSUPPORTED and a store failure with a safe SERVER_ERROR', async () => {
+    const store = new InMemorySessionStore();
+    const off = connect(await start(store));
+    await off.next();
+    expect(await request(off, {type: 'list_conversations'})).toMatchObject({type: 'error', code: 'UNSUPPORTED'});
+
+    const noList: SessionStore = {
+      create: (id, user, options) => store.create(id, user, options),
+      get: id => store.get(id),
+      delete: id => store.delete(id),
+      count: () => store.count(),
+      clear: () => store.clear(),
+    };
+    const unsupported = connect(await start(noList, {history: {enabled: true}}));
+    await unsupported.next();
+    expect(await request(unsupported, {type: 'list_conversations'})).toMatchObject({
+      type: 'error',
+      code: 'UNSUPPORTED',
+    });
+
+    class FailingStore extends InMemorySessionStore {
+      override listFor(): SessionSummary[] {
+        throw new Error('private database detail');
+      }
+    }
+    const failed = connect(await start(new FailingStore(), {history: {enabled: true}}));
+    await failed.next();
+    const error = await request(failed, {type: 'list_conversations'});
+    expect(error).toMatchObject({type: 'error', code: 'SERVER_ERROR'});
+    expect(JSON.stringify(error)).not.toContain('private database detail');
+    expect(failed.socket.readyState).toBe(WebSocket.OPEN);
+    failed.socket.send(JSON.stringify({type: 'ping', timestamp: 7}));
+    expect(await failed.next()).toMatchObject({type: 'pong', timestamp: 7});
+  });
+
+  // specs/hal-engine-websocket-protocol/spec.md#4
+  it('answers a history request while a turn is streaming, before its stream_end', async () => {
+    let release = (): void => undefined;
+    const held = new Promise<void>(resolve => {
+      release = resolve;
+    });
+    const base = await start(new InMemorySessionStore(), {history: {enabled: true}}, async () => {
+      await held;
+      return 'prompt';
+    });
+    const client = connect(base);
+    await client.next();
+    client.socket.send(JSON.stringify({type: 'user_message', content: 'hello'}));
+    try {
+      expect(await client.next()).toMatchObject({type: 'entry_upsert', entry: {role: 'user'}});
+      const response = await request(client, {type: 'list_conversations'});
+      expect(response.type).toBe('conversation_list');
+      expect(client.frames.some(frame => frame.type === 'stream_end')).toBe(false);
+    } finally {
+      release();
+    }
+  });
