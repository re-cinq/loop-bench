diff --git a/src/transport/conversationHistory.acceptance.test.ts b/src/transport/conversationHistory.acceptance.test.ts
new file mode 100644
index 0000000..9c2cbf1
--- /dev/null
+++ b/src/transport/conversationHistory.acceptance.test.ts
@@ -0,0 +1,200 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import {createHalEngine} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {SessionListOptions, SessionSummary} from '../types/sessionStore.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+
+type Frame = Record<string, unknown> & {type: string};
+
+class ObservedStore extends InMemorySessionStore {
+  calls: Array<{userId: string | number; options: SessionListOptions | undefined}> = [];
+
+  override listFor(userId: string | number, options?: SessionListOptions): SessionSummary[] {
+    this.calls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+const engines: Array<ReturnType<typeof createHalEngine>> = [];
+const clients: WebSocket[] = [];
+
+afterEach(async () => {
+  await Promise.all(
+    clients.splice(0).map(async client => {
+      if (client.readyState === WebSocket.CLOSED) return;
+      const closed = once(client, 'close');
+      client.terminate();
+      await closed;
+    })
+  );
+  for (const engine of engines.splice(0)) await engine.stop();
+});
+
+async function start(
+  store: InMemorySessionStore,
+  history?: {enabled: boolean},
+  resume = false,
+  beforeSession?: () => Promise<void>
+): Promise<string> {
+  const engine = createHalEngine({
+    provider: {type: 'mock'},
+    prompt: {identity: 'Test assistant'},
+    session: store,
+    auth: {ws: async () => ({id: 'owner'})},
+    transport: {port: 0, resume: {enabled: resume}, ...{history}},
+    orchestrator: {hooks: {beforeSession}},
+  });
+  await engine.start();
+  engines.push(engine);
+  const {port} = engine.server.address() as AddressInfo;
+  return `ws://127.0.0.1:${port}/hal/ws`;
+}
+
+function open(url: string): WebSocket {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'token']);
+  clients.push(client);
+  return client;
+}
+
+async function exchange(url: string, request: object): Promise<Frame[]> {
+  const client = open(url);
+  const frames: Frame[] = [];
+  client.on('message', raw => {
+    const frame = JSON.parse(String(raw)) as Frame;
+    frames.push(frame);
+    if (frame.type === 'connected') {
+      client.send(JSON.stringify(request));
+      client.send(JSON.stringify({type: 'ping', timestamp: 17}));
+    }
+  });
+  await once(client, 'open');
+  for (let attempt = 0; attempt < 30 && !frames.some(frame => frame.type === 'pong'); attempt++) {
+    await new Promise(resolve => setTimeout(resolve, 10));
+  }
+  await new Promise(resolve => setTimeout(resolve, 30));
+  return frames.filter(frame => frame.type !== 'pong');
+}
+
+function seed(store: InMemorySessionStore): void {
+  for (const [sessionId, userId, time] of [
+    ['older', 'owner', '2026-10-01T00:00:00.000Z'],
+    ['newer', 'owner', '2026-10-03T00:00:00.000Z'],
+    ['middle', 'owner', '2026-10-02T00:00:00.000Z'],
+    ['private', 'someone-else', '2026-10-04T00:00:00.000Z'],
+  ]) {
+    store.create(sessionId, userId).entries.push({role: 'user', content: sessionId, timestamp: time});
+  }
+}
+
+describe('conversation history over the WebSocket protocol', () => {
+  // specs/hal-engine-websocket-protocol/spec.md#1
+  it('validates the list frame and its complete paging cursor before dispatch', () => {
+    const before = {updatedAt: '2026-10-03T00:00:00.000Z', sessionId: 'newer'};
+    expect(validateMessage({type: 'list_conversations', limit: 2, before})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations', limit: 2, before},
+    });
+    for (const [field, value] of [
+      ['limit', 0],
+      ['limit', 201],
+      ['limit', 1.5],
+      ['limit', '10'],
+      ['before', {updatedAt: 'not a date', sessionId: 'newer'}],
+      ['before', {updatedAt: before.updatedAt}],
+    ] as const) {
+      const result = validateMessage({type: 'list_conversations', [field]: value});
+      expect(result).toMatchObject({valid: false, error: expect.stringContaining(field)});
+    }
+  });
+
+  // specs/hal-engine-websocket-protocol/spec.md#2
+  it('sends only the authenticated user’s newest summaries and passes the wire cursor to the store', async () => {
+    const store = new ObservedStore();
+    seed(store);
+    const url = await start(store, {enabled: true}, true);
+    const first = await exchange(url, {type: 'list_conversations', userId: 'someone-else'});
+    const list = first.find(frame => frame.type === 'conversation_list');
+    const rows = list?.conversations as Array<Record<string, unknown>> | undefined;
+
+    expect(first.map(frame => frame.type)).toEqual(['connected', 'conversation_list']);
+    expect(rows?.some(row => row.sessionId === first[0].sessionId)).toBe(true);
+    expect(rows?.map(row => row.sessionId).filter(id => id !== first[0].sessionId)).toEqual([
+      'newer',
+      'middle',
+      'older',
+    ]);
+    expect(
+      rows?.every(
+        row =>
+          Object.keys(row).sort().join(',') === 'createdAt,entryCount,sessionId,updatedAt' &&
+          typeof row.createdAt === 'string' &&
+          typeof row.updatedAt === 'string' &&
+          new Date(row.createdAt).toISOString() === row.createdAt &&
+          new Date(row.updatedAt).toISOString() === row.updatedAt
+      )
+    ).toBe(true);
+    expect(store.calls[0]).toEqual({userId: 'owner', options: {limit: undefined, before: undefined}});
+
+    const before = {updatedAt: '2026-10-03T00:00:00.000Z', sessionId: 'newer'};
+    const page = await exchange(url, {type: 'list_conversations', limit: 1, before});
+    expect(page.find(frame => frame.type === 'conversation_list')?.conversations).toMatchObject([
+      {sessionId: 'middle'},
+    ]);
+    expect(store.calls[1]).toEqual({userId: 'owner', options: {limit: 1, before}});
+
+    const replay = await exchange(`${url}?sessionId=newer`, {type: 'ping', timestamp: 18});
+    expect(replay[0]).toMatchObject({type: 'connected', sessionId: 'newer', resumed: true});
+    expect(replay.some(frame => frame.type === 'entry_upsert')).toBe(true);
+  });
+
+  // specs/hal-engine-websocket-protocol/spec.md#3
+  it('answers a disabled or unavailable list with UNSUPPORTED rather than an empty history', async () => {
+    const store = new InMemorySessionStore();
+    seed(store);
+    const disabled = await exchange(await start(store), {type: 'list_conversations'});
+    expect(disabled.slice(1)).toMatchObject([{type: 'error', code: 'UNSUPPORTED'}]);
+
+    const withoutList = new InMemorySessionStore();
+    Object.defineProperty(withoutList, 'listFor', {value: undefined});
+    const unavailable = await exchange(await start(withoutList, {enabled: true}), {type: 'list_conversations'});
+    expect(unavailable.slice(1)).toMatchObject([{type: 'error', code: 'UNSUPPORTED'}]);
+  });
+
+  // specs/hal-engine-websocket-protocol/spec.md#4
+  it('answers a list while the same session’s user turn is still running', async () => {
+    let entered = (): void => undefined;
+    let release = (): void => undefined;
+    const insideTurn = new Promise<void>(resolve => {
+      entered = resolve;
+    });
+    const holdTurn = new Promise<void>(resolve => {
+      release = resolve;
+    });
+    const store = new InMemorySessionStore();
+    const url = await start(store, {enabled: true}, false, async () => {
+      entered();
+      await holdTurn;
+    });
+    const client = open(url);
+    const frames: Frame[] = [];
+    client.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as Frame;
+      frames.push(frame);
+      if (frame.type === 'connected') client.send(JSON.stringify({type: 'user_message', content: 'hello'}));
+    });
+    await insideTurn;
+    client.send(JSON.stringify({type: 'list_conversations'}));
+    client.send(JSON.stringify({type: 'ping', timestamp: 19}));
+    for (let attempt = 0; attempt < 30 && !frames.some(frame => frame.type === 'pong'); attempt++) {
+      await new Promise(resolve => setTimeout(resolve, 10));
+    }
+    await new Promise(resolve => setTimeout(resolve, 30));
+    const whileRunning = frames.map(frame => frame.type);
+    release();
+    expect(whileRunning).toContain('conversation_list');
+    expect(whileRunning).not.toContain('stream_end');
+  });
+});