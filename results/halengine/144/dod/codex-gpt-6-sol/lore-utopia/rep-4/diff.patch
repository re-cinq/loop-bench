diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..3a36358
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,130 @@
+import {WebSocket, type RawData} from 'ws';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {SessionListOptions, SessionSummary} from '../types/sessionStore.js';
+import {validateMessage} from './ws/validation.js';
+import {connectClient, startEngineWith, stopEngines} from './wsTestSupport.js';
+
+interface Frame {
+  type: string;
+  code?: string;
+  sessionId?: string;
+  conversations?: Array<Omit<SessionSummary, 'createdAt' | 'updatedAt'> & {createdAt: string; updatedAt: string}>;
+}
+
+class RecordingStore extends InMemorySessionStore {
+  calls: Array<{userId: string | number; options?: SessionListOptions}> = [];
+
+  override listFor(userId: string | number, options?: SessionListOptions): SessionSummary[] {
+    this.calls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+const ask = (client: WebSocket, request: object): Promise<Frame[]> =>
+  new Promise(resolve => {
+    const frames: Frame[] = [];
+    const onMessage = (raw: RawData) => {
+      const frame = JSON.parse(String(raw)) as Frame;
+      frames.push(frame);
+      if (frame.type === 'connected') client.send(JSON.stringify(request));
+      if (frame.type === 'conversation_list' || frame.type === 'error') {
+        client.off('message', onMessage);
+        resolve(frames);
+      }
+    };
+    client.on('message', onMessage);
+  });
+
+const askAgain = (client: WebSocket, request: object): Promise<Frame> =>
+  new Promise(resolve => {
+    const onMessage = (raw: RawData) => {
+      const frame = JSON.parse(String(raw)) as Frame;
+      if (frame.type !== 'conversation_list' && frame.type !== 'error') return;
+      client.off('message', onMessage);
+      resolve(frame);
+    };
+    client.on('message', onMessage);
+    client.send(JSON.stringify(request));
+  });
+
+afterEach(async () => {
+  await stopEngines();
+  await new Promise(resolve => setTimeout(resolve, 10));
+});
+
+describe('conversation list over WebSocket', () => {
+  it('accepts the list request and rejects invalid limits and cursors at the protocol boundary', () => {
+    expect(validateMessage({type: 'list_conversations'})).toEqual({valid: true, data: {type: 'list_conversations'}});
+
+    for (const limit of [0, 201, 1.5, '10']) {
+      expect(validateMessage({type: 'list_conversations', limit})).toMatchObject({
+        valid: false,
+        error: expect.stringMatching(/limit/),
+      });
+    }
+    for (const before of [
+      'not a date',
+      {updatedAt: 'not a date', sessionId: 's1'},
+      {updatedAt: new Date().toISOString()},
+      {sessionId: 's1'},
+    ]) {
+      expect(validateMessage({type: 'list_conversations', before})).toMatchObject({
+        valid: false,
+        error: expect.stringMatching(/before/),
+      });
+    }
+    expect(
+      validateMessage({
+        type: 'list_conversations',
+        limit: 2,
+        before: {updatedAt: new Date().toISOString(), sessionId: 's1'},
+      })
+    ).toMatchObject({valid: true});
+  });
+
+  it('answers with the authenticated user’s newest summaries and passes the composite cursor to the store', async () => {
+    const store = new RecordingStore();
+    const old = store.create('old', 'u1');
+    old.entries.push({role: 'user', content: 'private', timestamp: '2026-01-01T00:00:00.000Z'});
+    const recent = store.create('recent', 'u1');
+    recent.entries.push({role: 'user', content: 'private', timestamp: '2026-10-01T00:00:00.000Z'});
+    store.create('another-user', 'u2');
+    const {url} = await startEngineWith({sessionStore: store, ...({history: {enabled: true}} as object)});
+    const client = connectClient(url);
+    const first = await ask(client, {type: 'list_conversations', userId: 'u2', limit: 3});
+
+    expect(first.map(frame => frame.type)).toEqual(['connected', 'conversation_list']);
+    expect(first[1].conversations?.map(row => row.sessionId)).toEqual([first[0].sessionId, 'recent', 'old']);
+    expect(first[1].conversations).toHaveLength(3);
+    for (const row of first[1].conversations ?? []) {
+      expect(Object.keys(row).sort()).toEqual(['createdAt', 'entryCount', 'sessionId', 'updatedAt']);
+      expect(row.createdAt).toBe(new Date(row.createdAt).toISOString());
+      expect(row.updatedAt).toBe(new Date(row.updatedAt).toISOString());
+    }
+    expect(store.calls[0]).toEqual({userId: 'u1', options: {limit: 3, before: undefined}});
+
+    const before = {updatedAt: first[1].conversations![0].updatedAt, sessionId: first[1].conversations![0].sessionId};
+    const next = await askAgain(client, {type: 'list_conversations', limit: 2, before});
+    expect(next.conversations?.map(row => row.sessionId)).toEqual(['recent', 'old']);
+    expect(store.calls[1]).toEqual({userId: 'u1', options: {limit: 2, before}});
+  });
+
+  it('answers UNSUPPORTED without a list when history is off or the store cannot list', async () => {
+    const store = new InMemorySessionStore();
+    const {url} = await startEngineWith({sessionStore: store});
+    const off = await ask(connectClient(url), {type: 'list_conversations'});
+    expect(off.map(frame => [frame.type, frame.code])).toEqual([
+      ['connected', undefined],
+      ['error', 'UNSUPPORTED'],
+    ]);
+
+    const noList = new InMemorySessionStore();
+    Object.defineProperty(noList, 'listFor', {value: undefined});
+    const {url: enabledUrl} = await startEngineWith({sessionStore: noList, ...({history: {enabled: true}} as object)});
+    const unavailable = await ask(connectClient(enabledUrl), {type: 'list_conversations'});
+    expect(unavailable.map(frame => [frame.type, frame.code])).toEqual([
+      ['connected', undefined],
+      ['error', 'UNSUPPORTED'],
+    ]);
+  });
+});