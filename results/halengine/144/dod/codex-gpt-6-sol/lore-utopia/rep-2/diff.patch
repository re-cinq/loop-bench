diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..c0bc1e5
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,137 @@
+import {once} from 'node:events';
+import type {WebSocket} from 'ws';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {SessionListOptions} from '../types/sessionStore.js';
+import type {HalServerOptions} from './createServer.js';
+import {connectClient, startEngineWith, stopEngines} from './wsTestSupport.js';
+import {validateMessage} from './ws/validation.js';
+import {setLogger} from '../shared/logger.js';
+
+interface Frame {
+  type: string;
+  code?: string;
+  conversations?: Array<{sessionId: string; createdAt: string; updatedAt: string; entryCount: number}>;
+}
+
+class RecordingStore extends InMemorySessionStore {
+  readonly calls: Array<{userId: string | number; options: SessionListOptions | undefined}> = [];
+
+  override listFor(userId: string | number, options?: SessionListOptions) {
+    this.calls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+const historyOptions = (sessionStore: InMemorySessionStore, enabled: boolean) =>
+  ({sessionStore, history: {enabled}}) as Partial<HalServerOptions> &
+    Pick<HalServerOptions, 'sessionStore'> & {history: {enabled: boolean}};
+
+const nextFrame = async (client: WebSocket): Promise<Frame> => {
+  const [raw] = await once(client, 'message');
+  return JSON.parse(String(raw)) as Frame;
+};
+
+beforeAll(() =>
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined})
+);
+afterEach(stopEngines);
+
+describe('conversation history over the authenticated WebSocket', () => {
+  it('validates a list request and its bounded composite cursor', () => {
+    const valid = validateMessage({
+      type: 'list_conversations',
+      limit: 2,
+      before: {updatedAt: '2026-01-02T00:00:00.000Z', sessionId: 's2'},
+    });
+    const invalid = [
+      {type: 'list_conversations', limit: 0},
+      {type: 'list_conversations', limit: 201},
+      {type: 'list_conversations', limit: 1.5},
+      {type: 'list_conversations', limit: '10'},
+      {type: 'list_conversations', before: {updatedAt: 'not a date', sessionId: 's2'}},
+      {type: 'list_conversations', before: {updatedAt: '2026-01-02T00:00:00.000Z'}},
+    ];
+
+    expect({
+      empty: validateMessage({type: 'list_conversations'}),
+      valid,
+      invalid: invalid.map(validateMessage),
+    }).toEqual({
+      empty: {valid: true, data: {type: 'list_conversations'}},
+      valid: {
+        valid: true,
+        data: {
+          type: 'list_conversations',
+          limit: 2,
+          before: {updatedAt: '2026-01-02T00:00:00.000Z', sessionId: 's2'},
+        },
+      },
+      invalid: [
+        expect.objectContaining({valid: false, error: expect.stringContaining('limit')}),
+        expect.objectContaining({valid: false, error: expect.stringContaining('limit')}),
+        expect.objectContaining({valid: false, error: expect.stringContaining('limit')}),
+        expect.objectContaining({valid: false, error: expect.stringContaining('limit')}),
+        expect.objectContaining({valid: false, error: expect.stringContaining('before')}),
+        expect.objectContaining({valid: false, error: expect.stringContaining('before')}),
+      ],
+    });
+  });
+
+  it('answers with the connected user’s newest summaries and pages from a wire cursor', async () => {
+    const store = new RecordingStore();
+    for (const [id, userId, time] of [
+      ['old', 'u1', '2027-01-01T00:00:00.000Z'],
+      ['new', 'u1', '2027-01-03T00:00:00.000Z'],
+      ['middle', 'u1', '2027-01-02T00:00:00.000Z'],
+      ['private', 'u2', '2027-01-04T00:00:00.000Z'],
+    ]) {
+      store.create(id, userId).entries.push({role: 'user', content: id, timestamp: time});
+    }
+    const {url} = await startEngineWith(historyOptions(store, true));
+    const client = connectClient(url);
+    await nextFrame(client);
+    const expected = store.listFor('u1').map(row => ({
+      sessionId: row.sessionId,
+      createdAt: row.createdAt.toISOString(),
+      updatedAt: row.updatedAt.toISOString(),
+      entryCount: row.entryCount,
+    }));
+    store.calls.length = 0;
+    client.send(JSON.stringify({type: 'list_conversations', userId: 'u2'}));
+    const first = await nextFrame(client);
+    const before = {updatedAt: expected[0].updatedAt, sessionId: expected[0].sessionId};
+    client.send(JSON.stringify({type: 'list_conversations', limit: 1, before}));
+    const page = await nextFrame(client);
+    client.send(JSON.stringify({type: 'ping', timestamp: 7}));
+    const afterPage = await nextFrame(client);
+
+    expect({first, page, afterPage, calls: store.calls}).toEqual({
+      first: {type: 'conversation_list', conversations: expected},
+      page: {type: 'conversation_list', conversations: [expected[1]]},
+      afterPage: {type: 'pong', timestamp: 7},
+      calls: [
+        {userId: 'u1', options: {limit: undefined, before: undefined}},
+        {userId: 'u1', options: {limit: 1, before}},
+      ],
+    });
+  });
+
+  it('refuses history when the separate opt-in is off', async () => {
+    const replies: Frame[] = [];
+    for (const enabled of [undefined, false]) {
+      const store = new InMemorySessionStore();
+      const {url} = await startEngineWith(
+        enabled === undefined ? {sessionStore: store} : historyOptions(store, enabled)
+      );
+      const client = connectClient(url);
+      await nextFrame(client);
+      client.send(JSON.stringify({type: 'list_conversations'}));
+      replies.push(await nextFrame(client));
+    }
+
+    expect(replies).toEqual([
+      expect.objectContaining({type: 'error', code: 'UNSUPPORTED'}),
+      expect.objectContaining({type: 'error', code: 'UNSUPPORTED'}),
+    ]);
+  });
+});