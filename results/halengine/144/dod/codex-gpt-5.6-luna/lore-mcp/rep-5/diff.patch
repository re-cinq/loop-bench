diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..0f28717
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,124 @@
+import {WebSocket} from 'ws';
+import type {Express} from 'express';
+import {createServer} from './createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {SessionListOptions, SessionSummary} from '../types/sessionStore.js';
+import {answeringOrchestrator} from './wsTestSupport.js';
+
+const baseOptions = {
+  app: (() => undefined) as unknown as Express,
+  wsAuth: async () => ({id: 'u1'}),
+  orchestrator: answeringOrchestrator,
+};
+
+class RecordingSessionStore extends InMemorySessionStore {
+  readonly requestedUsers: Array<string | number> = [];
+
+  override listFor(userId: string | number, options?: SessionListOptions): SessionSummary[] {
+    this.requestedUsers.push(userId);
+    return super.listFor(userId, options);
+  }
+}
+
+async function start(options: Record<string, unknown>, store: InMemorySessionStore) {
+  const server = createServer({...baseOptions, sessionStore: store, ...options});
+  await server.start(0);
+  const address = server.server.address();
+  if (address === null || typeof address === 'string') throw new Error('test server did not bind a port');
+  return {server, url: `ws://127.0.0.1:${address.port}/hal/ws/c1`};
+}
+
+function receiveAnswer(url: string, frame: Record<string, unknown>): Promise<Record<string, unknown>[]> {
+  return new Promise((resolve, reject) => {
+    const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'token']);
+    const received: Record<string, unknown>[] = [];
+    const timeout = setTimeout(() => reject(new Error('timed out waiting for WebSocket answer')), 1000);
+
+    client.on('open', () => client.send(JSON.stringify(frame)));
+    client.on('message', raw => {
+      const message = JSON.parse(String(raw)) as Record<string, unknown>;
+      received.push(message);
+      if (message.type === 'conversation_list' || message.type === 'error') {
+        clearTimeout(timeout);
+        client.close();
+        client.once('close', () => resolve(received));
+      }
+    });
+    client.on('error', reject);
+  });
+}
+
+describe('conversation list over the WebSocket protocol', () => {
+  it('validates list_conversations windows and its composite cursor', () => {
+    const before = {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: 'older'};
+
+    expect(validateMessage({type: 'list_conversations', limit: 200, before})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations', limit: 200, before},
+    });
+    expect(
+      [0, 201, 1.5, '10', {updatedAt: 'not a date', sessionId: 'older'}].map(value =>
+        validateMessage({
+          type: 'list_conversations',
+          ...(typeof value === 'object' ? {before: value} : {limit: value}),
+        })
+      )
+    ).toEqual(
+      [0, 201, 1.5, '10', {updatedAt: 'not a date', sessionId: 'older'}].map(() =>
+        expect.objectContaining({valid: false})
+      )
+    );
+  });
+
+  it("delivers only the authenticated user's summaries, newest first, as wire-safe timestamps", async () => {
+    const store = new RecordingSessionStore();
+    store.create('oldest', 'u1');
+    await new Promise(resolve => setTimeout(resolve, 2));
+    store.create('middle', 'u1');
+    await new Promise(resolve => setTimeout(resolve, 2));
+    store.create('newest', 'u1');
+    store.create('other-user', 'u2');
+    const {server, url} = await start({history: {enabled: true}}, store);
+
+    try {
+      const frames = await receiveAnswer(url, {type: 'list_conversations', userId: 'u2'});
+      const list = frames.find(frame => frame.type === 'conversation_list') as
+        {type: 'conversation_list'; conversations: SessionSummary[]} | undefined;
+
+      expect({
+        types: frames.map(frame => frame.type),
+        requestedUsers: store.requestedUsers,
+        ids: list?.conversations.map(conversation => conversation.sessionId),
+        timestamps: list?.conversations.every(
+          conversation => typeof conversation.createdAt === 'string' && typeof conversation.updatedAt === 'string'
+        ),
+      }).toEqual({
+        types: ['connected', 'conversation_list'],
+        requestedUsers: ['u1'],
+        ids: ['newest', 'middle', 'oldest'],
+        timestamps: true,
+      });
+    } finally {
+      await server.stop();
+    }
+  });
+
+  it('refuses the frame with UNSUPPORTED when history is not enabled', async () => {
+    const store = new InMemorySessionStore();
+    store.create('existing', 'u1');
+    const {server, url} = await start({}, store);
+
+    try {
+      const frames = await receiveAnswer(url, {type: 'list_conversations'});
+
+      expect(frames).toEqual([
+        expect.objectContaining({type: 'connected'}),
+        {type: 'error', code: 'UNSUPPORTED', message: expect.any(String)},
+      ]);
+    } finally {
+      await server.stop();
+    }
+  });
+});