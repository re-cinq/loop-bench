+import {WebSocket} from 'ws';
+import {createMessageHandler} from './messageHandler.js';
+import {validateMessage} from './validation.js';
+import {createChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import {createMockProvider} from '../../providers/mock/mockProvider.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from '../../orchestration/tools/registry.js';
+import {InMemorySessionStore} from '../../infrastructure/stores/inMemorySessionStore.js';
+import type {ChatSession} from '../../types/session.js';
+import type {SessionStore} from '../../types/sessionStore.js';
+import type {OutgoingMessage} from '../../types/messages.js';
+
+// spec: specs/hal-engine-conversation-list#1
+const realOrchestrator = createChatOrchestrator(
+  createMockProvider({type: 'mock'}),
+  new PromptBuilder({identity: 'Acceptance test assistant.'}),
+  new ToolRegistry()
+);
+
+type Handler = (ws: WebSocket, session: ChatSession, payload: unknown) => Promise<void>;
+
+const handler = (store: SessionStore, options?: unknown): Handler =>
+  (createMessageHandler as unknown as (...args: unknown[]) => Handler)(realOrchestrator, store, options);
+
+const socket = (userId: string, frames: OutgoingMessage[]) =>
+  ({
+    userId,
+    send: (raw: string) => frames.push(JSON.parse(raw) as OutgoingMessage),
+  }) as unknown as WebSocket;
+
+const session = (userId: string): ChatSession => ({sessionId: 'connected-session', userId, entries: []});
+
+describe('conversation list WebSocket acceptance contract', () => {
+  it('validates a list frame and its bounded composite cursor', () => {
+    expect(validateMessage({type: 'list_conversations'})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations'},
+    });
+    expect(validateMessage({type: 'list_conversations', limit: 0})).toMatchObject({valid: false});
+    expect(validateMessage({type: 'list_conversations', limit: 201})).toMatchObject({valid: false});
+    expect(validateMessage({type: 'list_conversations', limit: 1.5})).toMatchObject({valid: false});
+    expect(
+      validateMessage({type: 'list_conversations', before: {updatedAt: 'not a date', sessionId: 's1'}})
+    ).toMatchObject({
+      valid: false,
+    });
+    expect(validateMessage({type: 'list_conversations', before: {updatedAt: new Date().toISOString()}})).toMatchObject({
+      valid: false,
+    });
+  });
+
+  it('answers the authenticated user list with ISO summaries and forwards paging', async () => {
+    const store = new InMemorySessionStore();
+    for (const id of ['s1', 's2', 's3']) await store.create(id, 'u1');
+    await store.create('other-user-session', 'u2');
+
+    const firstFrames: OutgoingMessage[] = [];
+    await handler(store, {enabled: true})(socket('u1', firstFrames), session('not-from-frame'), {
+      type: 'list_conversations',
+      limit: 2,
+      userId: 'u2',
+    });
+
+    const first = firstFrames[0];
+    expect(first).toMatchObject({type: 'conversation_list'});
+    if (first?.type !== 'conversation_list') return;
+    expect(first.conversations).toHaveLength(2);
+    expect(
+      first.conversations.every(row => typeof row.createdAt === 'string' && typeof row.updatedAt === 'string')
+    ).toBe(true);
+    expect(firstFrames.some(frame => frame.type === 'stream_end')).toBe(false);
+
+    const cursor = first.conversations.at(-1);
+    const nextFrames: OutgoingMessage[] = [];
+    await handler(store, {enabled: true})(socket('u1', nextFrames), session('not-from-frame'), {
+      type: 'list_conversations',
+      limit: 1,
+      before: cursor,
+    });
+
+    expect(nextFrames).toHaveLength(1);
+    expect(nextFrames[0]).toMatchObject({type: 'conversation_list', conversations: [{sessionId: expect.any(String)}]});
+    expect(
+      (nextFrames[0] as {type: 'conversation_list'; conversations: Array<{sessionId: string}>}).conversations[0]
+        .sessionId
+    ).not.toBe(cursor?.sessionId);
+  });
+
+  it('refuses history when disabled or when the store cannot list', async () => {
+    const store = new InMemorySessionStore();
+    await store.create('s1', 'u1');
+    const disabled: OutgoingMessage[] = [];
+
+    await handler(store)(socket('u1', disabled), session('u1'), {type: 'list_conversations'});
+    expect(disabled).toEqual([{type: 'error', code: 'UNSUPPORTED', message: expect.any(String)}]);
+
+    const legacyStore = {
+      create: store.create.bind(store),
+      get: store.get.bind(store),
+      delete: store.delete.bind(store),
+      count: store.count.bind(store),
+      clear: store.clear.bind(store),
+    } as SessionStore;
+    const unsupported: OutgoingMessage[] = [];
+    await handler(legacyStore, {enabled: true})(socket('u1', unsupported), session('u1'), {type: 'list_conversations'});
+    expect(unsupported).toEqual([{type: 'error', code: 'UNSUPPORTED', message: expect.any(String)}]);
+  });
+});