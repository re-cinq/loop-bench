+import {WebSocket} from 'ws';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {validateMessage} from './ws/validation.js';
+import {connectClient, startEngineWith, stopEngines, answeringOrchestrator} from './wsTestSupport.js';
+import type {ChatSession} from '../types/session.js';
+
+const HISTORY = {enabled: true};
+const OPTIONS = (sessionStore: InMemorySessionStore) =>
+  ({sessionStore, orchestrator: answeringOrchestrator, history: HISTORY}) as Parameters<typeof startEngineWith>[0];
+
+interface Frame {
+  type: string;
+  [key: string]: unknown;
+}
+
+function request(url: string, frame: unknown, until: string): {client: WebSocket; answer: Promise<Frame>} {
+  const client = connectClient(url);
+  const answer = new Promise<Frame>(resolve => {
+    client.on('message', raw => {
+      const received = JSON.parse(String(raw)) as Frame;
+      if (received.type === until || received.type === 'error') resolve(received);
+    });
+  });
+  client.on('open', () => client.send(JSON.stringify(frame)));
+  return {client, answer};
+}
+
+describe('conversation list over the WebSocket protocol', () => {
+  afterEach(() => stopEngines());
+
+  it('validates list_conversations limits and its complete before cursor', () => {
+    expect(validateMessage({type: 'list_conversations'})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations'},
+    });
+
+    for (const [frame, field] of [
+      [{type: 'list_conversations', limit: 0}, 'limit'],
+      [{type: 'list_conversations', limit: 201}, 'limit'],
+      [{type: 'list_conversations', limit: 1.5}, 'limit'],
+      [{type: 'list_conversations', limit: '10'}, 'limit'],
+      [{type: 'list_conversations', before: 'not a date'}, 'before'],
+      [{type: 'list_conversations', before: {updatedAt: '2026-01-01T00:00:00.000Z'}}, 'before'],
+    ] as const) {
+      const result = validateMessage(frame);
+      expect(result.valid).toBe(false);
+      if (!result.valid) expect(result.error).toContain(field);
+    }
+  });
+
+  it('delivers only the authenticated user’s summaries as ISO wire values when history is enabled', async () => {
+    const store = new InMemorySessionStore();
+    const own: ChatSession = store.create('own', 'u1');
+    own.entries.push({role: 'user', content: 'hello', timestamp: '2099-01-01T00:00:00.000Z'});
+    store.create('another-users', 'u2');
+
+    const {url} = await startEngineWith(OPTIONS(store));
+    const {client, answer} = request(url, {type: 'list_conversations', userId: 'u2'}, 'conversation_list');
+    const received = await answer;
+    if (received.type === 'conversation_list') client.send(JSON.stringify({type: 'ping', timestamp: 1}));
+
+    const conversations = received.conversations as Array<Record<string, unknown>>;
+    expect(conversations).toEqual([
+      expect.objectContaining({
+        sessionId: 'own',
+        createdAt: expect.stringMatching(/^\d{4}-\d{2}-\d{2}T.*Z$/),
+        updatedAt: '2099-01-01T00:00:00.000Z',
+        entryCount: 1,
+      }),
+      expect.objectContaining({sessionId: expect.any(String), entryCount: 0}),
+    ]);
+    expect(conversations.map(conversation => conversation.sessionId)).not.toContain('another-users');
+  });
+
+  it('answers an error instead of a list when history is not enabled', async () => {
+    const {url} = await startEngineWith({sessionStore: new InMemorySessionStore()});
+    const {answer} = request(url, {type: 'list_conversations'}, 'error');
+
+    await expect(answer).resolves.toMatchObject({type: 'error', code: 'UNSUPPORTED'});
+  });
+});