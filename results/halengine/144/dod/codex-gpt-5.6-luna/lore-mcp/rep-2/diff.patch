diff --git a/src/transport/ws/conversationList.acceptance.test.ts b/src/transport/ws/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..ad58228
--- /dev/null
+++ b/src/transport/ws/conversationList.acceptance.test.ts
@@ -0,0 +1,131 @@
+import {WebSocket} from 'ws';
+import {InMemorySessionStore} from '../../infrastructure/stores/inMemorySessionStore.js';
+import type {HalServerOptions} from '../createServer.js';
+import type {OutgoingMessage} from '../../types/messages.js';
+import {validateMessage} from './validation.js';
+import {connectClient, startEngineWith, stopEngines} from '../wsTestSupport.js';
+import {setLogger} from '../../shared/logger.js';
+
+interface ConversationListFrame {
+  type: 'conversation_list';
+  conversations: Array<{
+    sessionId: string;
+    createdAt: string;
+    updatedAt: string;
+    entryCount: number;
+  }>;
+}
+
+interface ErrorFrame {
+  type: 'error';
+  code: string;
+  message: string;
+}
+
+const historyOptions = (enabled: boolean): Partial<HalServerOptions> =>
+  ({history: {enabled}}) as unknown as Partial<HalServerOptions>;
+
+const seed = (store: InMemorySessionStore, sessionId: string, userId: string, activity: number): void => {
+  const session = store.create(sessionId, userId);
+  session.entries.push({role: 'user', content: sessionId, timestamp: new Date(activity).toISOString()});
+};
+
+const askForConversations = async (url: string, extra: Record<string, unknown> = {}): Promise<OutgoingMessage[]> => {
+  const client = connectClient(url) as WebSocket;
+  const received: OutgoingMessage[] = [];
+  await new Promise<void>((resolve, reject) => {
+    client.once('open', () => client.send(JSON.stringify({type: 'list_conversations', ...extra})));
+    client.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as OutgoingMessage;
+      received.push(frame);
+      if (frame.type === 'conversation_list' || frame.type === 'error') resolve();
+    });
+    client.once('error', reject);
+  });
+  return received;
+};
+
+afterEach(async () => {
+  await stopEngines();
+});
+
+beforeAll(() => {
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined});
+});
+
+describe('conversation lists over the WebSocket protocol', () => {
+  // spec: specs/hal-engine-websocket-protocol#1
+  it('validates list_conversations and names every invalid pagination field', () => {
+    expect(validateMessage({type: 'list_conversations'})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations'},
+    });
+
+    for (const [payload, field] of [
+      [{type: 'list_conversations', limit: 0}, 'limit'],
+      [{type: 'list_conversations', limit: 201}, 'limit'],
+      [{type: 'list_conversations', limit: 1.5}, 'limit'],
+      [{type: 'list_conversations', limit: '10'}, 'limit'],
+      [{type: 'list_conversations', before: 'not a date'}, 'before'],
+    ] as const) {
+      const result = validateMessage(payload);
+      expect(result.valid).toBe(false);
+      if (!result.valid) expect(result.error).toContain(field);
+    }
+  });
+
+  // spec: specs/hal-engine-websocket-protocol#2
+  it('lists only the authenticated user conversations as ISO summaries when history is enabled', async () => {
+    const store = new InMemorySessionStore();
+    const now = Date.now();
+    seed(store, 'older', 'u1', now - 3_000);
+    seed(store, 'newest', 'u1', now - 1_000);
+    seed(store, 'middle', 'u1', now - 2_000);
+    seed(store, 'other-user', 'u2', now);
+
+    const {url} = await startEngineWith({sessionStore: store, ...historyOptions(true)});
+    const frames = await askForConversations(url, {userId: 'u2'});
+    const list = frames.find((frame): frame is ConversationListFrame => frame.type === 'conversation_list');
+
+    expect(list).toEqual({
+      type: 'conversation_list',
+      conversations: expect.arrayContaining([
+        expect.objectContaining({sessionId: 'newest'}),
+        expect.objectContaining({sessionId: 'middle'}),
+        expect.objectContaining({sessionId: 'older'}),
+      ]),
+    });
+    expect(list?.conversations).toHaveLength(3);
+    expect(list?.conversations.map(conversation => conversation.sessionId)).toEqual(['newest', 'middle', 'older']);
+    expect(
+      list?.conversations.every(
+        conversation => typeof conversation.createdAt === 'string' && typeof conversation.updatedAt === 'string'
+      )
+    ).toBe(true);
+    expect(frames.some(frame => frame.type === 'stream_end')).toBe(false);
+  });
+
+  // spec: specs/hal-engine-websocket-protocol#3
+  it('refuses the list with UNSUPPORTED when history is not enabled', async () => {
+    const store = new InMemorySessionStore();
+    seed(store, 'owned', 'u1', Date.now());
+    const {url} = await startEngineWith({sessionStore: store});
+    const client = connectClient(url);
+    const received: OutgoingMessage[] = [];
+    const done = new Promise<void>((resolve, reject) => {
+      client.on('message', raw => {
+        const frame = JSON.parse(String(raw)) as OutgoingMessage;
+        received.push(frame);
+        if (frame.type === 'error') resolve();
+      });
+      client.once('error', reject);
+    });
+    await new Promise<void>(resolve => client.once('open', resolve));
+    client.send(JSON.stringify({type: 'list_conversations'}));
+    await done;
+
+    const error = received.find((frame): frame is ErrorFrame => frame.type === 'error');
+    expect(error).toMatchObject({type: 'error', code: 'UNSUPPORTED'});
+    expect(received.some(frame => frame.type === 'conversation_list')).toBe(false);
+  });
+});