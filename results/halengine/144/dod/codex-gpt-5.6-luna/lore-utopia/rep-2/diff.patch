@@ -0,0 +1,122 @@
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {validateMessage} from './ws/validation.js';
+import {answeringOrchestrator, connectClient, startEngineWith, stopEngines} from './wsTestSupport.js';
+import {setLogger} from '../shared/logger.js';
+
+type WireFrame = {
+  type: string;
+  code?: string;
+  conversations?: Array<Record<string, unknown>>;
+};
+
+const historyEnabled = {history: {enabled: true}};
+
+const waitForListResponse = async (url: string, request: unknown): Promise<WireFrame[]> => {
+  const client = connectClient(url, 'token');
+  const frames: WireFrame[] = [];
+
+  return new Promise<WireFrame[]>((resolve, reject) => {
+    const timeout = setTimeout(() => {
+      client.terminate();
+      reject(
+        new Error(`Timed out waiting for a response to ${JSON.stringify(request)}; received ${JSON.stringify(frames)}`)
+      );
+    }, 100);
+    const finish = (result: WireFrame[]): void => {
+      clearTimeout(timeout);
+      client.close();
+      resolve(result);
+    };
+
+    client.on('error', reject);
+    client.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as WireFrame;
+      if (frame.type === 'connected') {
+        client.send(JSON.stringify(request));
+        return;
+      }
+      frames.push(frame);
+      if (frame.type === 'conversation_list' || frame.type === 'error') {
+        finish(frames);
+      }
+    });
+  });
+};
+
+describe('conversation list acceptance contract', () => {
+  beforeAll(() => {
+    setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined});
+  });
+
+  afterEach(async () => {
+    await stopEngines();
+  });
+
+  it('accepts list_conversations and validates its limit and composite before cursor', () => {
+    expect(validateMessage({type: 'list_conversations'})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations', limit: undefined, before: undefined},
+    });
+
+    for (const message of [
+      {type: 'list_conversations', limit: 0},
+      {type: 'list_conversations', limit: 201},
+      {type: 'list_conversations', limit: 1.5},
+      {type: 'list_conversations', limit: '10'},
+      {type: 'list_conversations', before: {updatedAt: '2026-10-27T12:00:00.000Z'}},
+      {type: 'list_conversations', before: {sessionId: 's1'}},
+    ]) {
+      const result = validateMessage(message);
+      expect(result.valid).toBe(false);
+      if (!result.valid) expect(result.error).toMatch(/limit|before/);
+    }
+  });
+
+  it('answers the authenticated user’s list with summaries, ignoring a frame userId', async () => {
+    const store = new InMemorySessionStore();
+    const newest = store.create('newest', 'u1');
+    newest.entries.push({role: 'user', content: 'newest', timestamp: '2026-12-01T00:00:00.000Z'});
+    const older = store.create('older', 'u1');
+    older.entries.push({role: 'user', content: 'older', timestamp: '2026-11-01T00:00:00.000Z'});
+    store.create('another-user', 'u2');
+
+    const {url} = await startEngineWith({
+      sessionStore: store,
+      orchestrator: answeringOrchestrator,
+      wsAuth: async () => ({id: 'u1'}),
+      ...(historyEnabled as never),
+    });
+    const [frame] = await waitForListResponse(url, {type: 'list_conversations', userId: 'u2'});
+
+    expect(frame).toMatchObject({type: 'conversation_list'});
+    expect(frame.conversations).toHaveLength(3);
+    expect(frame.conversations?.map(conversation => conversation.sessionId)).toEqual([
+      'newest',
+      'older',
+      expect.any(String),
+    ]);
+    expect(
+      frame.conversations?.every(
+        conversation => Object.keys(conversation).sort().join(',') === 'createdAt,entryCount,sessionId,updatedAt'
+      )
+    ).toBe(true);
+    expect(
+      frame.conversations?.every(
+        conversation =>
+          typeof conversation.createdAt === 'string' &&
+          typeof conversation.updatedAt === 'string' &&
+          new Date(conversation.createdAt).toISOString() === conversation.createdAt &&
+          new Date(conversation.updatedAt).toISOString() === conversation.updatedAt
+      )
+    ).toBe(true);
+  });
+
+  it('refuses the list with UNSUPPORTED when history is not enabled', async () => {
+    const store = new InMemorySessionStore();
+    const {url} = await startEngineWith({sessionStore: store, orchestrator: answeringOrchestrator});
+
+    await expect(waitForListResponse(url, {type: 'list_conversations'})).resolves.toEqual([
+      {type: 'error', code: 'UNSUPPORTED', message: expect.any(String)},
+    ]);
+  });
+});