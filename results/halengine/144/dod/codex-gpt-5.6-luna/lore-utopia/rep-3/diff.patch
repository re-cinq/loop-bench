diff --git a/src/transport/ws/conversationList.acceptance.test.ts b/src/transport/ws/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..2322c3b
--- /dev/null
+++ b/src/transport/ws/conversationList.acceptance.test.ts
@@ -0,0 +1,98 @@
+import {WebSocket} from 'ws';
+import {InMemorySessionStore} from '../../infrastructure/stores/inMemorySessionStore.js';
+import {validateMessage} from './validation.js';
+import {startEngineWith, stopEngines} from '../wsTestSupport.js';
+import type {HalServerOptions} from '../createServer.js';
+
+const nextFrame = (client: WebSocket): Promise<Record<string, unknown>> =>
+  new Promise(resolve => client.once('message', raw => resolve(JSON.parse(String(raw)) as Record<string, unknown>)));
+
+const openClient = async (url: string): Promise<{client: WebSocket; connected: Record<string, unknown>}> => {
+  const client = new WebSocket(url, ['hal.v1', 'acceptance-token']);
+  const connected = nextFrame(client);
+  await new Promise<void>((resolve, reject) => {
+    client.once('open', () => resolve());
+    client.once('error', reject);
+  });
+  return {client, connected: await connected};
+};
+
+afterEach(async () => {
+  await stopEngines();
+});
+
+describe('conversation list over the WebSocket protocol', () => {
+  it('accepts list_conversations and validates its paging fields', () => {
+    expect(validateMessage({type: 'list_conversations'})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations'},
+    });
+
+    for (const frame of [
+      {type: 'list_conversations', limit: 0},
+      {type: 'list_conversations', limit: 201},
+      {type: 'list_conversations', limit: 1.5},
+      {type: 'list_conversations', limit: '10'},
+      {type: 'list_conversations', before: 'not a date'},
+    ]) {
+      const result = validateMessage(frame);
+      expect(result.valid).toBe(false);
+      if (!result.valid) expect(result.error).toMatch(/limit|before/);
+    }
+  });
+
+  it('answers an enabled list with only the authenticated user’s summaries as ISO wire values', async () => {
+    const store = new InMemorySessionStore();
+    const older = store.create('older', 'u1');
+    older.entries.push({role: 'user', content: 'older', timestamp: '2026-01-01T00:00:00.000Z'});
+    const newer = store.create('newer', 'u1');
+    newer.entries.push({role: 'user', content: 'newer', timestamp: '2026-02-01T00:00:00.000Z'});
+    store.create('other-user', 'u2');
+
+    const {url} = await startEngineWith({
+      sessionStore: store,
+      history: {enabled: true},
+    } as Partial<HalServerOptions> & Pick<HalServerOptions, 'sessionStore'>);
+    const {client, connected} = await openClient(url);
+    expect(connected.type).toBe('connected');
+    const received: Array<Record<string, unknown>> = [];
+    client.on('message', raw => received.push(JSON.parse(String(raw)) as Record<string, unknown>));
+
+    client.send(JSON.stringify({type: 'list_conversations', userId: 'u2'}));
+    const frame = await nextFrame(client);
+    await new Promise(resolve => setTimeout(resolve, 10));
+
+    expect(frame.type).toBe('conversation_list');
+    expect(received.map(receivedFrame => receivedFrame.type)).toEqual(['conversation_list']);
+    expect(frame.conversations).toHaveLength(3);
+    expect(frame.conversations).not.toEqual(
+      expect.arrayContaining([expect.objectContaining({sessionId: 'other-user'})])
+    );
+    for (const summary of frame.conversations as Array<Record<string, unknown>>) {
+      expect(summary).toEqual(
+        expect.objectContaining({
+          sessionId: expect.any(String),
+          entryCount: expect.any(Number),
+          createdAt: expect.stringMatching(/^\d{4}-\d\d-\d\dT.*Z$/),
+          updatedAt: expect.stringMatching(/^\d{4}-\d\d-\d\dT.*Z$/),
+        })
+      );
+    }
+    expect((frame.conversations as Array<Record<string, unknown>>).map(summary => summary.sessionId)).toEqual([
+      expect.any(String),
+      'newer',
+      'older',
+    ]);
+  });
+
+  it('answers one disabled history request with UNSUPPORTED and no list', async () => {
+    const {url} = await startEngineWith({sessionStore: new InMemorySessionStore()});
+    const {client, connected} = await openClient(url);
+    expect(connected.type).toBe('connected');
+
+    client.send(JSON.stringify({type: 'list_conversations'}));
+    const frame = await nextFrame(client);
+
+    expect(frame).toEqual(expect.objectContaining({type: 'error', code: 'UNSUPPORTED'}));
+  });
+});