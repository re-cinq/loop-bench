diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..1c49e09
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,113 @@
+import {WebSocket} from 'ws';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {validateMessage} from './ws/validation.js';
+import {connectClient, startEngineWith, stopEngines} from './wsTestSupport.js';
+import {setLogger} from '../shared/logger.js';
+
+interface Frame {
+  type: string;
+  code?: string;
+  conversations?: Array<{
+    sessionId: string;
+    createdAt: string;
+    updatedAt: string;
+    entryCount: number;
+  }>;
+}
+
+const nextFrame = (client: WebSocket): Promise<Frame> =>
+  new Promise(resolve => {
+    client.once('message', raw => resolve(JSON.parse(String(raw)) as Frame));
+  });
+
+const seed = (store: InMemorySessionStore, sessionId: string, sentAt: string): void => {
+  const session = store.create(sessionId, 'u1');
+  session.entries.push({role: 'user', content: sessionId, timestamp: sentAt});
+};
+
+afterEach(async () => {
+  await stopEngines();
+});
+
+beforeAll(() => {
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined});
+});
+
+describe('conversation list over the WebSocket protocol', () => {
+  it('accepts list_conversations and names invalid limit and cursor fields', () => {
+    expect(validateMessage({type: 'list_conversations'})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations'},
+    });
+
+    for (const [field, value] of [
+      ['limit', 0],
+      ['limit', 201],
+      ['limit', 1.5],
+      ['limit', '10'],
+      ['before', 'not a date'],
+    ] as const) {
+      const result = validateMessage({type: 'list_conversations', [field]: value});
+      expect(result).toMatchObject({valid: false});
+      expect(result).toMatchObject({error: expect.stringContaining(field)});
+    }
+  });
+
+  it('lists only the authenticated user conversations, with ISO summaries and cursor paging', async () => {
+    const store = new InMemorySessionStore();
+    const now = Date.now();
+    seed(store, 'older', new Date(now - 20_000).toISOString());
+    seed(store, 'newer', new Date(now - 10_000).toISOString());
+    seed(store, 'other-user', new Date(now - 5_000).toISOString());
+
+    const {url} = await startEngineWith({
+      sessionStore: store,
+      transport: {history: {enabled: true}},
+    } as never);
+    const client = connectClient(url);
+
+    const connected = await nextFrame(client);
+    expect(connected.type).toBe('connected');
+
+    client.send(JSON.stringify({type: 'list_conversations', userId: 'another-user'}));
+    const first = await nextFrame(client);
+
+    expect(first.type).toBe('conversation_list');
+    expect(first.conversations).toHaveLength(3);
+    expect(first.conversations?.map(row => row.sessionId)).not.toContain('other-user');
+    expect(first.conversations?.every(row => Number.isNaN(Date.parse(row.createdAt)) === false)).toBe(true);
+    expect(first.conversations?.every(row => Number.isNaN(Date.parse(row.updatedAt)) === false)).toBe(true);
+    expect(
+      first.conversations?.every(
+        row => Object.keys(row).sort().join(',') === 'createdAt,entryCount,sessionId,updatedAt'
+      )
+    ).toBe(true);
+
+    const last = first.conversations?.at(-1);
+    expect(last).toBeDefined();
+    client.send(
+      JSON.stringify({
+        type: 'list_conversations',
+        limit: 1,
+        before: {updatedAt: last?.updatedAt, sessionId: last?.sessionId},
+      })
+    );
+    const second = await nextFrame(client);
+
+    expect(second.type).toBe('conversation_list');
+    expect(second.conversations).toHaveLength(1);
+    expect(second.conversations?.[0].sessionId).toBe('newer');
+  });
+
+  it('refuses list_conversations when history is not enabled', async () => {
+    const store = new InMemorySessionStore();
+    const {url} = await startEngineWith({sessionStore: store});
+    const client = connectClient(url);
+
+    const connected = await nextFrame(client);
+    expect(connected.type).toBe('connected');
+
+    client.send(JSON.stringify({type: 'list_conversations'}));
+    await expect(nextFrame(client)).resolves.toMatchObject({type: 'error', code: 'UNSUPPORTED'});
+  });
+});