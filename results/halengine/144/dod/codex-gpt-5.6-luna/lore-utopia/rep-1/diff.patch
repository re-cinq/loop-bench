diff --git a/src/transport/ws/conversationList.acceptance.test.ts b/src/transport/ws/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..55b8799
--- /dev/null
+++ b/src/transport/ws/conversationList.acceptance.test.ts
@@ -0,0 +1,174 @@
+import {jest} from '@jest/globals';
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import type {Express} from 'express';
+import {createServer} from '../createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './subprotocol.js';
+import {validateMessage} from './validation.js';
+import {InMemorySessionStore} from '../../infrastructure/stores/inMemorySessionStore.js';
+import type {SessionStore} from '../../types/sessionStore.js';
+import {answeringOrchestrator} from '../wsTestSupport.js';
+import {setLogger} from '../../shared/logger.js';
+
+interface WireFrame {
+  type: string;
+  code?: string;
+  conversations?: Array<{
+    sessionId: string;
+    createdAt: string;
+    updatedAt: string;
+    entryCount: number;
+  }>;
+}
+
+const servers: Array<ReturnType<typeof createServer>> = [];
+const clients: WebSocket[] = [];
+
+beforeAll(() => {
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined});
+});
+
+afterAll(() => setLogger());
+
+afterEach(async () => {
+  for (const client of clients.splice(0)) client.terminate();
+  for (const server of servers.splice(0)) {
+    for (let attempt = 0; attempt < 50 && server.wss.clients.size > 0; attempt++) {
+      await new Promise(resolve => setTimeout(resolve, 10));
+    }
+    await server.stop();
+  }
+});
+
+const openServer = async (sessionStore: SessionStore, options: Record<string, unknown> = {}) => {
+  const server = createServer({
+    app: (() => undefined) as unknown as Express,
+    wsAuth: async () => ({id: 'u1'}),
+    orchestrator: answeringOrchestrator,
+    sessionStore,
+    ...options,
+  });
+  await server.start(0);
+  servers.push(server);
+  const {port} = server.server.address() as AddressInfo;
+  return `ws://127.0.0.1:${port}/hal/ws/client`;
+};
+
+const receiveAfterConnected = (url: string, message: unknown): Promise<{frame: WireFrame; frames: WireFrame[]}> => {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'token']);
+  clients.push(client);
+  const frames: WireFrame[] = [];
+  return new Promise((resolve, reject) => {
+    const timeout = setTimeout(() => reject(new Error('timed out waiting for a response')), 1000);
+    client.on('error', reject);
+    client.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as WireFrame;
+      frames.push(frame);
+      if (frame.type === 'connected') client.send(JSON.stringify(message));
+      if (frame.type === 'conversation_list' || frame.type === 'error') {
+        clearTimeout(timeout);
+        resolve({frame, frames});
+      }
+    });
+  });
+};
+
+// spec: specs/hal-engine-websocket-protocol#4.3
+describe('conversation list acceptance', () => {
+  it('validates list_conversations limits and the composite ISO cursor', () => {
+    expect(validateMessage({type: 'list_conversations'})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations'},
+    });
+    expect(
+      validateMessage({
+        type: 'list_conversations',
+        limit: 3,
+        before: {updatedAt: '2026-10-27T12:00:00.000Z', sessionId: 's1'},
+      })
+    ).toEqual({
+      valid: true,
+      data: {
+        type: 'list_conversations',
+        limit: 3,
+        before: {updatedAt: '2026-10-27T12:00:00.000Z', sessionId: 's1'},
+      },
+    });
+
+    for (const [field, value] of [
+      ['limit', 0],
+      ['limit', 201],
+      ['limit', 1.5],
+      ['limit', '10'],
+      ['before', {updatedAt: 'not a date', sessionId: 's1'}],
+      ['before', {updatedAt: '2026-10-27T12:00:00.000Z'}],
+    ] as const) {
+      const result = validateMessage({type: 'list_conversations', [field]: value});
+      expect(result.valid).toBe(false);
+      if (!result.valid) expect(result.error).toContain(field);
+    }
+  });
+
+  // spec: specs/hal-engine-websocket-protocol#5.8
+  it('answers the authenticated user with an ordered ISO conversation list and forwards paging', async () => {
+    const store = new InMemorySessionStore();
+    for (const [sessionId, timestamp] of [
+      ['older', '2026-10-25T10:00:00.000Z'],
+      ['newer', '2026-10-26T10:00:00.000Z'],
+    ]) {
+      const session = store.create(sessionId, 'u1');
+      session.entries.push({role: 'user', content: sessionId, timestamp});
+    }
+    const other = store.create('other-user', 'u2');
+    other.entries.push({role: 'user', content: 'private', timestamp: '2026-10-27T12:00:00.000Z'});
+
+    const calls: Array<{userId: string | number; options?: unknown}> = [];
+    const observedStore = new Proxy(store, {
+      get(target, property, receiver) {
+        if (property === 'listFor') {
+          return (userId: string | number, options?: unknown) => {
+            calls.push({userId, options});
+            return target.listFor(userId, options as Parameters<NonNullable<SessionStore['listFor']>>[1]);
+          };
+        }
+        return Reflect.get(target, property, receiver);
+      },
+    });
+    const url = await openServer(observedStore, {history: {enabled: true}});
+    const before = {updatedAt: '9999-12-31T23:59:59.999Z', sessionId: 'zzzz'};
+    const result = await receiveAfterConnected(url, {
+      type: 'list_conversations',
+      userId: 'u2',
+      limit: 3,
+      before,
+    });
+
+    expect(result.frame.type).toBe('conversation_list');
+    expect(result.frame.conversations?.map(row => row.sessionId)).toEqual([expect.any(String), 'newer', 'older']);
+    expect(result.frame.conversations).toHaveLength(3);
+    expect(result.frame.conversations?.every(row => row.sessionId !== 'other-user')).toBe(true);
+    expect(result.frame.conversations?.every(row => Number.isNaN(Date.parse(row.createdAt)) === false)).toBe(true);
+    expect(result.frame.conversations?.every(row => Number.isNaN(Date.parse(row.updatedAt)) === false)).toBe(true);
+    expect(result.frames.map(frame => frame.type)).not.toContain('stream_end');
+    expect(calls).toEqual([{userId: 'u1', options: {limit: 3, before}}]);
+  });
+
+  it('refuses the list when history is off or the store cannot list', async () => {
+    const disabled = await receiveAfterConnected(await openServer(new InMemorySessionStore()), {
+      type: 'list_conversations',
+    });
+    expect(disabled.frame).toMatchObject({type: 'error', code: 'UNSUPPORTED'});
+
+    const store = new InMemorySessionStore();
+    const withoutList = new Proxy(store, {
+      get(target, property, receiver) {
+        if (property === 'listFor') return undefined;
+        return Reflect.get(target, property, receiver);
+      },
+    }) as SessionStore;
+    const unsupported = await receiveAfterConnected(await openServer(withoutList, {history: {enabled: true}}), {
+      type: 'list_conversations',
+    });
+    expect(unsupported.frame).toMatchObject({type: 'error', code: 'UNSUPPORTED'});
+  });
+});