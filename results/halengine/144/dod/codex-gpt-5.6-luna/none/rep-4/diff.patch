new file mode 100644
index 0000000..b55c230
--- /dev/null
+++ b/src/transport/ws/conversation-list.acceptance.test.ts
@@ -0,0 +1,89 @@
+import {WebSocket} from 'ws';
+import {InMemorySessionStore} from '../../infrastructure/stores/inMemorySessionStore.js';
+import {validateMessage} from './validation.js';
+import {afterEach, describe, expect, it} from '@jest/globals';
+import {connectClient, startEngineWith, stopEngines} from '../wsTestSupport.js';
+
+afterEach(async () => {
+  await stopEngines();
+});
+
+const nextFrame = (client: WebSocket, type: string): Promise<Record<string, unknown>> =>
+  new Promise((resolve, reject) => {
+    const onMessage = (raw: WebSocket.RawData) => {
+      const frame = JSON.parse(String(raw)) as Record<string, unknown>;
+      if (frame.type === type) {
+        client.off('message', onMessage);
+        resolve(frame);
+      } else if (frame.type === 'error' && type !== 'error') {
+        client.off('message', onMessage);
+        reject(new Error(`expected ${type}, received error ${String(frame.code)}`));
+      }
+    };
+    client.on('message', onMessage);
+  });
+
+const serverOptions = (sessionStore: InMemorySessionStore, history: boolean) =>
+  ({sessionStore, history: {enabled: history}}) as Parameters<typeof startEngineWith>[0];
+
+describe('the conversation list WebSocket contract', () => {
+  it('validates list_conversations cursors and limits', () => {
+    expect(validateMessage({type: 'list_conversations'})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations'},
+    });
+
+    for (const [field, value] of [
+      ['limit', 0],
+      ['limit', 201],
+      ['limit', 1.5],
+      ['limit', '10'],
+      ['before', 'not a date'],
+    ] as const) {
+      const result = validateMessage({type: 'list_conversations', [field]: value});
+      expect(result).toMatchObject({valid: false});
+      expect(result).toHaveProperty('error', expect.stringContaining(field));
+    }
+  });
+
+  it('delivers only the authenticated user’s summaries, in pages, with ISO timestamps', async () => {
+    const store = new InMemorySessionStore();
+    const older = store.create('older', 'u1');
+    older.entries.push({role: 'user', content: 'old', timestamp: '2026-01-01T00:00:00.000Z'});
+    const newer = store.create('newer', 'u1');
+    newer.entries.push({role: 'user', content: 'new', timestamp: '2026-02-01T00:00:00.000Z'});
+    store.create('other-user', 'u2');
+
+    const {url} = await startEngineWith(serverOptions(store, true));
+    const client = connectClient(url);
+    const connected = await nextFrame(client, 'connected');
+    const connectionSessionId = connected.sessionId as string;
+
+    client.send(JSON.stringify({type: 'list_conversations', userId: 'u2', limit: 2}));
+    const first = await nextFrame(client, 'conversation_list');
+    const firstRows = first.conversations as Array<Record<string, unknown>>;
+
+    expect(firstRows).toHaveLength(2);
+    expect(firstRows.map(row => row.sessionId)).toEqual([connectionSessionId, 'newer']);
+    expect(
+      firstRows.every(row => Object.keys(row).sort().join(',') === 'createdAt,entryCount,sessionId,updatedAt')
+    ).toBe(true);
+    expect(firstRows.every(row => typeof row.createdAt === 'string' && typeof row.updatedAt === 'string')).toBe(true);
+
+    client.send(JSON.stringify({type: 'list_conversations', before: firstRows[1]}));
+    const second = await nextFrame(client, 'conversation_list');
+    expect((second.conversations as Array<Record<string, unknown>>).map(row => row.sessionId)).toEqual(['older']);
+  });
+
+  it('refuses the list with UNSUPPORTED when history is not enabled', async () => {
+    const store = new InMemorySessionStore();
+    store.create('existing', 'u1');
+    const {url} = await startEngineWith(serverOptions(store, false));
+    const client = connectClient(url);
+    await nextFrame(client, 'connected');
+
+    client.send(JSON.stringify({type: 'list_conversations'}));
+    const error = await nextFrame(client, 'error');
+    expect(error).toMatchObject({type: 'error', code: 'UNSUPPORTED'});
+  });
+});