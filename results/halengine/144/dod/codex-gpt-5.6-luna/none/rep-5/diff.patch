diff --git a/src/transport/ws/conversationList.acceptance.test.ts b/src/transport/ws/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..4169099
--- /dev/null
+++ b/src/transport/ws/conversationList.acceptance.test.ts
@@ -0,0 +1,111 @@
+import {jest} from '@jest/globals';
+import {InMemorySessionStore} from '../../infrastructure/stores/inMemorySessionStore.js';
+import {validateMessage} from './validation.js';
+import type {HalServerOptions} from '../createServer.js';
+import {connectClient, startEngineWith, stopEngines} from '../wsTestSupport.js';
+
+type Frame = Record<string, unknown>;
+
+const historyEnabled = {history: {enabled: true}} as unknown as Partial<HalServerOptions>;
+
+function wait(ms: number): Promise<void> {
+  return new Promise(resolve => setTimeout(resolve, ms));
+}
+
+async function connectedClient(url: string) {
+  const client = connectClient(url);
+  await new Promise<void>((resolve, reject) => {
+    const timer = setTimeout(() => reject(new Error('timed out waiting for connected')), 1000);
+    client.on('message', raw => {
+      if ((JSON.parse(String(raw)) as Frame).type === 'connected') {
+        clearTimeout(timer);
+        resolve();
+      }
+    });
+  });
+  return client;
+}
+
+async function framesAfter(client: ReturnType<typeof connectClient>, payload: Frame): Promise<Frame[]> {
+  const frames: Frame[] = [];
+  const onMessage = (raw: Buffer) => frames.push(JSON.parse(String(raw)) as Frame);
+  client.on('message', onMessage);
+  client.send(JSON.stringify(payload));
+  await wait(50);
+  client.off('message', onMessage);
+  return frames;
+}
+
+beforeEach(() => jest.useRealTimers());
+afterEach(async () => stopEngines());
+
+describe('conversation list WebSocket acceptance contract', () => {
+  it('accepts list_conversations and validates its limit and composite before cursor', () => {
+    expect(validateMessage({type: 'list_conversations'})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations'},
+    });
+
+    for (const [field, value] of [
+      ['limit', 0],
+      ['limit', 201],
+      ['limit', 1.5],
+      ['limit', '10'],
+      ['before', {updatedAt: 'not a date', sessionId: 's1'}],
+      ['before', {updatedAt: new Date().toISOString()}],
+    ] as const) {
+      const result = validateMessage({type: 'list_conversations', [field]: value});
+      expect(result).toMatchObject({valid: false});
+      expect(result).toMatchObject({error: expect.stringContaining(field)});
+    }
+  });
+
+  it('delivers only the authenticated user’s newest summaries and pages with the returned cursor', async () => {
+    const store = new InMemorySessionStore();
+    const older = store.create('older', 'u1');
+    older.entries.push({role: 'user', content: 'old', timestamp: '2026-01-01T00:00:01.000Z'});
+    const middle = store.create('middle', 'u1');
+    middle.entries.push({role: 'user', content: 'middle', timestamp: '2026-01-01T00:00:02.000Z'});
+    const otherUser = store.create('other-user', 'u2');
+    otherUser.entries.push({role: 'user', content: 'private', timestamp: '2026-01-01T00:00:03.000Z'});
+
+    const {url} = await startEngineWith({sessionStore: store, ...historyEnabled});
+    const client = await connectedClient(url);
+
+    const first = await framesAfter(client, {
+      type: 'list_conversations',
+      limit: 1,
+      userId: 'u2',
+    });
+    expect(first).toHaveLength(1);
+    expect(first[0]).toMatchObject({type: 'conversation_list', conversations: [{sessionId: 'middle', entryCount: 1}]});
+    expect(first[0]?.conversations).toEqual([
+      expect.objectContaining({
+        sessionId: 'middle',
+        createdAt: expect.stringMatching(/^\d{4}-\d\d-\d\dT/),
+        updatedAt: expect.stringMatching(/^\d{4}-\d\d-\d\dT/),
+      }),
+    ]);
+
+    const cursor = (first[0]?.conversations as Frame[])[0];
+    const second = await framesAfter(client, {type: 'list_conversations', before: cursor});
+    expect(second).toHaveLength(1);
+    expect(second[0]).toMatchObject({
+      type: 'conversation_list',
+      conversations: [expect.objectContaining({sessionId: 'older'})],
+    });
+    expect(second.map(frame => frame.type)).not.toContain('stream_end');
+  });
+
+  it('refuses the frame with UNSUPPORTED when history is not enabled', async () => {
+    const store = new InMemorySessionStore();
+    store.create('existing', 'u1');
+    const {url} = await startEngineWith({sessionStore: store});
+    const client = await connectedClient(url);
+
+    const frames = await framesAfter(client, {type: 'list_conversations'});
+
+    expect(frames).toEqual([expect.objectContaining({type: 'error', code: 'UNSUPPORTED'})]);
+    expect(frames.map(frame => frame.type)).not.toContain('conversation_list');
+  });
+});