diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..aed819c
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,235 @@
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import type {Express} from 'express';
+import {createServer} from './createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {answeringOrchestrator, deferred} from './wsTestSupport.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {ChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import type {MessageChunk} from '../types/ai.js';
+import type {SessionResumeOptions} from './ws/sessionResume.js';
+import type {SessionStore} from '../types/sessionStore.js';
+import {setLogger} from '../shared/logger.js';
+
+declare module './createServer.js' {
+  interface HalServerOptions {
+    history?: {
+      enabled: boolean;
+    };
+  }
+}
+
+interface ProtocolFrame {
+  type: string;
+  sessionId?: string;
+  resumed?: boolean;
+  code?: string;
+  message?: string;
+  conversations?: Array<{
+    sessionId: string;
+    createdAt: string;
+    updatedAt: string;
+    entryCount: number;
+  }>;
+}
+
+const servers: Array<ReturnType<typeof createServer>> = [];
+const clients: WebSocket[] = [];
+
+const eventually = async (check: () => boolean): Promise<void> => {
+  for (let attempt = 0; attempt < 50 && !check(); attempt++) await new Promise(resolve => setTimeout(resolve, 10));
+};
+
+beforeAll(() => {
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined});
+});
+
+afterAll(() => {
+  setLogger();
+});
+
+afterEach(async () => {
+  for (const client of clients.splice(0)) client.terminate();
+  for (const hal of servers.splice(0)) {
+    const {wss} = hal;
+    await eventually(() => wss.clients.size === 0);
+    await hal.stop();
+  }
+});
+
+const startEngine = async (
+  store: SessionStore,
+  history?: {enabled: boolean},
+  resume?: SessionResumeOptions,
+  orchestrator: ChatOrchestrator = answeringOrchestrator
+) => {
+  const hal = createServer({
+    app: (() => undefined) as unknown as Express,
+    wsAuth: async () => ({id: 'u1'}),
+    sessionStore: store,
+    orchestrator,
+    resume,
+    history,
+  });
+  await hal.start(0);
+  servers.push(hal);
+  const {port} = hal.server.address() as AddressInfo;
+  return {base: `ws://127.0.0.1:${port}/hal/ws`};
+};
+
+const openClient = (url: string, token = 't'): WebSocket => {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, token]);
+  clients.push(client);
+  return client;
+};
+
+const nextFrame = (client: WebSocket, expectedType: string | string[]): Promise<ProtocolFrame> => {
+  const wanted = Array.isArray(expectedType) ? expectedType : [expectedType];
+  return new Promise((resolve, reject) => {
+    const timer = setTimeout(() => {
+      client.off('message', onMessage);
+      reject(new Error(`Timeout waiting for frame of type: ${wanted.join(', ')}`));
+    }, 2000);
+
+    const onMessage = (raw: WebSocket.RawData) => {
+      const frame = JSON.parse(String(raw)) as ProtocolFrame;
+      if (wanted.includes(frame.type)) {
+        clearTimeout(timer);
+        client.off('message', onMessage);
+        resolve(frame);
+      }
+    };
+    client.on('message', onMessage);
+  });
+};
+
+describe('conversation list over websocket', () => {
+  it("delivers the authenticated user's conversation list over WebSocket, ignoring foreign userId in the frame", async () => {
+    const store = new InMemorySessionStore();
+    store.create('s_older', 'u1');
+    const newer = store.create('s_newer', 'u1');
+    newer.entries.push({role: 'user', content: 'hello', timestamp: '2026-01-01T12:00:00.000Z'});
+    store.create('s_foreign', 'u2');
+
+    const {base} = await startEngine(store, {enabled: true}, {enabled: true});
+    const client = openClient(base);
+    await nextFrame(client, 'connected');
+
+    const seenTypes: string[] = [];
+    const trackFrames = (raw: WebSocket.RawData) => {
+      const parsed = JSON.parse(String(raw)) as ProtocolFrame;
+      seenTypes.push(parsed.type);
+    };
+    client.on('message', trackFrames);
+
+    client.send(JSON.stringify({type: 'list_conversations', userId: 'u2'}));
+    const listFrame = await nextFrame(client, ['conversation_list', 'error']);
+
+    client.off('message', trackFrames);
+
+    const resumedClient = openClient(`${base}?sessionId=s_newer`);
+    const resumeConnected = await nextFrame(resumedClient, 'connected');
+
+    expect({
+      listType: listFrame.type,
+      sessions: listFrame.conversations?.map(c => c.sessionId),
+      isoDates: listFrame.conversations?.every(
+        c =>
+          typeof c.createdAt === 'string' &&
+          typeof c.updatedAt === 'string' &&
+          new Date(c.createdAt).toISOString() === c.createdAt &&
+          new Date(c.updatedAt).toISOString() === c.updatedAt
+      ),
+      resumed: resumeConnected.resumed,
+      hasStreamEnd: seenTypes.includes('stream_end'),
+    }).toEqual({
+      listType: 'conversation_list',
+      sessions: ['s_newer', 's_older'],
+      isoDates: true,
+      resumed: true,
+      hasStreamEnd: false,
+    });
+  });
+
+  it('refuses list_conversations with an UNSUPPORTED error when history is not enabled or the store cannot list', async () => {
+    const store = new InMemorySessionStore();
+    const {base: baseDisabled} = await startEngine(store);
+    const client1 = openClient(baseDisabled);
+    await nextFrame(client1, 'connected');
+    client1.send(JSON.stringify({type: 'list_conversations'}));
+    const frame1 = await nextFrame(client1, ['error', 'conversation_list']);
+
+    const storeWithoutList: SessionStore = {
+      create: (id, u) => store.create(id, u),
+      get: id => store.get(id),
+      delete: id => store.delete(id),
+      count: () => store.count(),
+      clear: () => store.clear(),
+    };
+    const {base: baseNoList} = await startEngine(storeWithoutList, {enabled: true});
+    const client2 = openClient(baseNoList);
+    await nextFrame(client2, 'connected');
+    client2.send(JSON.stringify({type: 'list_conversations'}));
+    const frame2 = await nextFrame(client2, ['error', 'conversation_list']);
+
+    expect({
+      disabledCode: frame1.code,
+      disabledType: frame1.type,
+      noListCode: frame2.code,
+      noListType: frame2.type,
+    }).toEqual({
+      disabledCode: 'UNSUPPORTED',
+      disabledType: 'error',
+      noListCode: 'UNSUPPORTED',
+      noListType: 'error',
+    });
+  });
+
+  it('answers list_conversations without waiting for a streaming turn in progress to end', async () => {
+    const store = new InMemorySessionStore();
+    const gate = deferred();
+    const orchestrator: ChatOrchestrator = {
+      processMessage: async () => 'hi',
+      async *processMessageStream(): AsyncGenerator<MessageChunk> {
+        yield {type: 'text', text: 'start'};
+        await gate.until;
+        yield {type: 'text', text: ' finish'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+    };
+
+    const {base} = await startEngine(store, {enabled: true}, undefined, orchestrator);
+    const client = openClient(base);
+    await nextFrame(client, 'connected');
+
+    client.send(JSON.stringify({type: 'user_message', content: 'hello'}));
+    await nextFrame(client, 'entry_delta');
+
+    const framesBeforeGate: string[] = [];
+    const listReceived = new Promise<string>(resolve => {
+      const handler = (raw: WebSocket.RawData) => {
+        const parsed = JSON.parse(String(raw)) as ProtocolFrame;
+        framesBeforeGate.push(parsed.type);
+        if (parsed.type === 'conversation_list' || parsed.type === 'error') {
+          client.off('message', handler);
+          resolve(parsed.type);
+        }
+      };
+      client.on('message', handler);
+    });
+
+    client.send(JSON.stringify({type: 'list_conversations'}));
+    const receivedType = await listReceived;
+
+    gate.release();
+    await nextFrame(client, 'stream_end');
+
+    expect({
+      receivedType,
+      hadStreamEndBeforeList: framesBeforeGate.includes('stream_end'),
+    }).toEqual({
+      receivedType: 'conversation_list',
+      hadStreamEndBeforeList: false,
+    });
+  });
+});