diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..6381911
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,223 @@
+import {jest} from '@jest/globals';
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import type {Express} from 'express';
+import {createServer} from './createServer.js';
+import type {HalServerOptions} from './createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {answeringOrchestrator, deferred} from './wsTestSupport.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {ChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import type {MessageChunk} from '../types/ai.js';
+import {setLogger} from '../shared/logger.js';
+
+interface ConversationSummaryWire {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+
+interface Frame {
+  type: string;
+  code?: string;
+  message?: string;
+  conversations?: ConversationSummaryWire[];
+  sessionId?: string;
+  resumed?: boolean;
+}
+
+const servers: Array<ReturnType<typeof createServer>> = [];
+const clients: WebSocket[] = [];
+
+const eventually = async (check: () => boolean): Promise<void> => {
+  for (let attempt = 0; attempt < 50 && !check(); attempt++) {
+    await new Promise(resolve => setTimeout(resolve, 10));
+  }
+};
+
+beforeAll(() => {
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined});
+});
+
+afterAll(() => {
+  setLogger();
+});
+
+afterEach(async () => {
+  for (const client of clients.splice(0)) client.terminate();
+  for (const hal of servers.splice(0)) {
+    const {wss} = hal;
+    await eventually(() => wss.clients.size === 0);
+    await hal.stop();
+  }
+});
+
+const startEngine = async (
+  store: InMemorySessionStore,
+  options?: {history?: {enabled: boolean}; resume?: {enabled: boolean}},
+  orchestrator: ChatOrchestrator = answeringOrchestrator
+) => {
+  const auth = {userId: 'u1'};
+  const serverOptions: HalServerOptions & {history?: {enabled: boolean}} = {
+    app: (() => undefined) as unknown as Express,
+    wsAuth: async () => ({id: auth.userId}),
+    sessionStore: store,
+    orchestrator,
+    resume: options?.resume,
+    history: options?.history,
+  };
+  const hal = createServer(serverOptions);
+  await hal.start(0);
+  servers.push(hal);
+  const {port} = hal.server.address() as AddressInfo;
+  return {auth, base: `ws://127.0.0.1:${port}/hal/ws`};
+};
+
+const open = (url: string, token = 't'): WebSocket => {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, token]);
+  clients.push(client);
+  return client;
+};
+
+const nextFrame = (client: WebSocket): Promise<Frame> =>
+  new Promise((resolve, reject) => {
+    const timer = setTimeout(() => reject(new Error('timed out waiting for frame')), 2000);
+    client.once('message', raw => {
+      clearTimeout(timer);
+      resolve(JSON.parse(String(raw)) as Frame);
+    });
+  });
+
+const connectClient = async (url: string): Promise<WebSocket> => {
+  const client = open(url);
+  const connected = await nextFrame(client);
+  expect(connected.type).toBe('connected');
+  return client;
+};
+
+describe('conversation list over WebSocket', () => {
+  it("delivers the authenticated user's conversation list over WebSocket, ignoring any userId in the frame", async () => {
+    const store = new InMemorySessionStore();
+    const s1 = store.create('s1', 'u1');
+    s1.entries.push({
+      role: 'user',
+      content: 'hello 1',
+      timestamp: '2026-09-30T08:00:00.000Z',
+    });
+    s1.entries.push({
+      role: 'assistant',
+      content: 'hi 1',
+      timestamp: '2026-09-30T08:00:01.000Z',
+    });
+
+    const s2 = store.create('s2', 'u1');
+    s2.entries.push({
+      role: 'user',
+      content: 'hello 2',
+      timestamp: '2026-09-30T08:05:00.000Z',
+    });
+
+    const s3 = store.create('s3', 'u1');
+    s3.entries.push({
+      role: 'user',
+      content: 'hello 3',
+      timestamp: '2026-09-30T08:10:00.000Z',
+    });
+
+    const sOther = store.create('s-other', 'u2');
+    sOther.entries.push({
+      role: 'user',
+      content: 'hello other',
+      timestamp: '2026-09-30T08:15:00.000Z',
+    });
+
+    const listForSpy = jest.spyOn(store, 'listFor');
+
+    const server = await startEngine(store, {
+      history: {enabled: true},
+      resume: {enabled: true},
+    });
+
+    const client = await connectClient(server.base);
+    client.send(JSON.stringify({type: 'list_conversations', userId: 'u2'}));
+
+    const response = await nextFrame(client);
+
+    expect(response.type).toBe('conversation_list');
+    expect(response.conversations).toBeDefined();
+    expect(response.conversations).toHaveLength(3);
+    expect(response.conversations?.map(c => c.sessionId)).toEqual(['s3', 's2', 's1']);
+
+    for (const summary of response.conversations ?? []) {
+      expect(typeof summary.createdAt).toBe('string');
+      expect(typeof summary.updatedAt).toBe('string');
+      expect(Number.isNaN(Date.parse(summary.createdAt))).toBe(false);
+      expect(Number.isNaN(Date.parse(summary.updatedAt))).toBe(false);
+    }
+
+    expect(listForSpy).toHaveBeenCalledWith('u1', expect.anything());
+    expect(listForSpy).not.toHaveBeenCalledWith('u2', expect.anything());
+
+    const reconnectClient = open(`${server.base}?sessionId=s1`);
+    const reconnected = await nextFrame(reconnectClient);
+    expect(reconnected.type).toBe('connected');
+    expect(reconnected.resumed).toBe(true);
+  });
+
+  it('answers list_conversations with an UNSUPPORTED error frame when history is not enabled', async () => {
+    const store = new InMemorySessionStore();
+    store.create('s1', 'u1');
+
+    const server = await startEngine(store);
+    const client = await connectClient(server.base);
+
+    client.send(JSON.stringify({type: 'list_conversations'}));
+
+    const response = await nextFrame(client);
+
+    expect(response.type).toBe('error');
+    expect(response.code).toBe('UNSUPPORTED');
+  });
+
+  it('answers list_conversations without waiting for an in-flight streaming turn on the session lock', async () => {
+    const store = new InMemorySessionStore();
+    store.create('s1', 'u1');
+
+    const gate = deferred();
+    const slowOrchestrator: ChatOrchestrator = {
+      processMessage: async () => 'done',
+      async *processMessageStream(): AsyncGenerator<MessageChunk> {
+        yield {type: 'text', text: 'streaming...'};
+        await gate.until;
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+    };
+
+    const server = await startEngine(store, {history: {enabled: true}}, slowOrchestrator);
+    const client = await connectClient(server.base);
+
+    const receivedFrames: Frame[] = [];
+    client.on('message', raw => {
+      receivedFrames.push(JSON.parse(String(raw)) as Frame);
+    });
+
+    client.send(JSON.stringify({type: 'user_message', content: 'hello'}));
+
