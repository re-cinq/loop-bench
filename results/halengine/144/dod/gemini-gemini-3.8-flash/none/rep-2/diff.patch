diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..f136b91
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,250 @@
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import type {Express} from 'express';
+import {createServer} from './createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {answeringOrchestrator} from './wsTestSupport.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {ChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import type {MessageChunk} from '../types/ai.js';
+import {setLogger} from '../shared/logger.js';
+
+// Real upgrades over a real socket: what a WebSocket client receives when requesting
+// its conversation list is the protocol contract, and no double can observe it.
+
+const servers: Array<ReturnType<typeof createServer>> = [];
+const clients: WebSocket[] = [];
+
+const eventually = async (check: () => boolean): Promise<void> => {
+  for (let attempt = 0; attempt < 50 && !check(); attempt++) await new Promise(resolve => setTimeout(resolve, 10));
+};
+
+beforeAll(() => {
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined});
+});
+
+afterAll(() => {
+  setLogger();
+});
+
+afterEach(async () => {
+  for (const client of clients.splice(0)) client.terminate();
+  for (const hal of servers.splice(0)) {
+    const {wss} = hal;
+    await eventually(() => wss.clients.size === 0);
+    await hal.stop();
+  }
+});
+
+const startServer = async (
+  store: InMemorySessionStore,
+  history?: {enabled: boolean},
+  orchestrator: ChatOrchestrator = answeringOrchestrator
+) => {
+  const options = {
+    app: (() => undefined) as unknown as Express,
+    wsAuth: async () => ({id: 'u1'}),
+    sessionStore: store,
+    orchestrator,
+    resume: {enabled: true},
+    history,
+  };
+  const hal = createServer(options);
+  await hal.start(0);
+  servers.push(hal);
+  const {port} = hal.server.address() as AddressInfo;
+  return {base: `ws://127.0.0.1:${port}/hal/ws`};
+};
+
+const open = (url: string, token = 't'): WebSocket => {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, token]);
+  clients.push(client);
+  return client;
+};
+
+const waitForConnected = (client: WebSocket, timeoutMs = 2000): Promise<Record<string, unknown>> =>
+  new Promise((resolve, reject) => {
+    const timer = setTimeout(() => reject(new Error('Timed out waiting for connected frame')), timeoutMs);
+    const onMessage = (raw: WebSocket.RawData) => {
+      const frame = JSON.parse(String(raw)) as Record<string, unknown>;
+      if (frame.type === 'connected') {
+        clearTimeout(timer);
+        client.off('message', onMessage);
+        resolve(frame);
+      }
+    };
+    client.on('message', onMessage);
+  });
+
+const nextFrame = (client: WebSocket, timeoutMs = 2000): Promise<Record<string, unknown>> =>
+  new Promise((resolve, reject) => {
+    const timer = setTimeout(() => reject(new Error('Timed out waiting for frame')), timeoutMs);
+    client.once('message', raw => {
+      clearTimeout(timer);
+      resolve(JSON.parse(String(raw)) as Record<string, unknown>);
+    });
+  });
+
+const waitForType = (client: WebSocket, expectedType: string, timeoutMs = 2000): Promise<Record<string, unknown>> =>
+  new Promise((resolve, reject) => {
+    const timer = setTimeout(() => reject(new Error(`Timed out waiting for ${expectedType}`)), timeoutMs);
+    const onMessage = (raw: WebSocket.RawData) => {
+      const frame = JSON.parse(String(raw)) as Record<string, unknown>;
+      if (frame.type === expectedType) {
+        clearTimeout(timer);
+        client.off('message', onMessage);
+        resolve(frame);
+      }
+    };
+    client.on('message', onMessage);
+  });
+
+const waitForListOrError = (client: WebSocket, timeoutMs = 2000): Promise<Record<string, unknown>> =>
+  new Promise((resolve, reject) => {
+    const timer = setTimeout(() => reject(new Error('Timed out waiting for conversation_list or error')), timeoutMs);
+    const onMessage = (raw: WebSocket.RawData) => {
+      const frame = JSON.parse(String(raw)) as Record<string, unknown>;
+      if (frame.type === 'conversation_list' || frame.type === 'error') {
+        clearTimeout(timer);
+        client.off('message', onMessage);
+        resolve(frame);
+      }
+    };
+    client.on('message', onMessage);
+  });
+
+describe('conversation list over websocket protocol', () => {
+  it("delivers the authenticated user's conversation summaries over websocket, newest first, and allows rejoining a conversation", async () => {
+    const store = new InMemorySessionStore();
+    const session1 = store.create('sess-1', 'u1');
+    session1.entries.push({role: 'user', content: 'older message', timestamp: '2026-01-01T00:00:00.000Z'});
+    const session2 = store.create('sess-2', 'u1');
+    session2.entries.push({role: 'user', content: 'newer message', timestamp: '2026-01-01T01:00:00.000Z'});
+    const sessionOther = store.create('sess-other', 'u2');
+    sessionOther.entries.push({role: 'user', content: 'other user message', timestamp: '2026-01-01T02:00:00.000Z'});
+
+    const {base} = await startServer(store, {enabled: true});
+    const client = open(base);
+    await waitForConnected(client);
+
+    const seenFrames: Array<Record<string, unknown>> = [];
+    client.on('message', raw => seenFrames.push(JSON.parse(String(raw))));
+
+    const framePromise = nextFrame(client);
+    client.send(JSON.stringify({type: 'list_conversations', userId: 'u2'}));
+    const listFrame = await framePromise;
+
+    let reconnectFrame: Record<string, unknown> | undefined;
+    if (listFrame.type === 'conversation_list' && Array.isArray(listFrame.conversations)) {
+      const firstId = (listFrame.conversations[0] as {sessionId?: string})?.sessionId;
+      if (firstId) {
+        const reconnectClient = open(`${base}?sessionId=${firstId}`);
+        reconnectFrame = await waitForConnected(reconnectClient);
+      }
+    }
+
+    const conversations = Array.isArray(listFrame.conversations)
+      ? (listFrame.conversations as Array<Record<string, unknown>>).map(c => ({
+          sessionId: c.sessionId,
+          createdAt: typeof c.createdAt === 'string' && !isNaN(Date.parse(c.createdAt)),
+          updatedAt: c.updatedAt,
+          entryCount: c.entryCount,
+        }))
+      : undefined;
+
+    const streamEndSent = seenFrames.some(frame => frame.type === 'stream_end');
+
+    expect({
+      type: listFrame.type,
+      conversations,
+      streamEndSent,
+      reconnectResumed: reconnectFrame?.resumed,
+      reconnectSessionId: reconnectFrame?.sessionId,
+    }).toEqual({
+      type: 'conversation_list',
+      conversations: [
+        {
+          sessionId: 'sess-2',
+          createdAt: true,
+          updatedAt: '2026-01-01T01:00:00.000Z',
+          entryCount: 1,
+        },
+        {
+          sessionId: 'sess-1',
+          createdAt: true,
+          updatedAt: '2026-01-01T00:00:00.000Z',
+          entryCount: 1,
+        },
+      ],
+      streamEndSent: false,
+      reconnectResumed: true,
+      reconnectSessionId: 'sess-2',
+    });
+  });
+
+  it('answers list_conversations with an UNSUPPORTED error frame when history is not enabled', async () => {
+    const store = new InMemorySessionStore();
+    const {base} = await startServer(store);
+    const client = open(base);
+    await waitForConnected(client);
+
+    const framePromise = nextFrame(client);
+    client.send(JSON.stringify({type: 'list_conversations'}));
+    const frame = await framePromise;
+
+    expect({
+      type: frame.type,
+      code: frame.code,
+    }).toEqual({
+      type: 'error',
+      code: 'UNSUPPORTED',
+    });
+  });
+
+  it('answers list_conversations while a user message is streaming without waiting on the turn lock', async () => {
+    const store = new InMemorySessionStore();
+    let releaseTurn = (): void => undefined;
+    const turnBlocked = new Promise<void>(resolve => {
+      releaseTurn = resolve;
+    });
+
