new file mode 100644
index 0000000..7bcf472
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,237 @@
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import type {Express} from 'express';
+import {createServer, type HalServer, type HalServerOptions} from './createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {answeringOrchestrator, deferred} from './wsTestSupport.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {ChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import type {MessageChunk} from '../types/ai.js';
+import type {SessionStore} from '../types/sessionStore.js';
+import {setLogger} from '../shared/logger.js';
+
+interface ProtocolFrame {
+  type: string;
+  code?: string;
+  message?: string;
+  conversations?: Array<{
+    sessionId: string;
+    createdAt: string;
+    updatedAt: string;
+    entryCount: number;
+  }>;
+  resumed?: boolean;
+  sessionId?: string;
+  [key: string]: unknown;
+}
+
+const servers: HalServer[] = [];
+const clients: WebSocket[] = [];
+
+beforeAll(() => {
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined});
+});
+
+afterAll(() => {
+  setLogger();
+});
+
+afterEach(async () => {
+  for (const client of clients.splice(0)) client.terminate();
+  for (const hal of servers.splice(0)) {
+    const {wss} = hal;
+    while (wss.clients.size > 0) await new Promise(resolve => setTimeout(resolve, 10));
+    await hal.stop();
+  }
+});
+
+interface EngineOptions {
+  history?: {enabled: boolean};
+  store?: SessionStore;
+  orchestrator?: ChatOrchestrator;
+  userId?: string;
+}
+
+async function startEngine(options: EngineOptions = {}) {
+  const userId = options.userId ?? 'u1';
+  const store = options.store ?? new InMemorySessionStore();
+  const orchestrator = options.orchestrator ?? answeringOrchestrator;
+
+  const hal = createServer({
+    app: (() => undefined) as unknown as Express,
+    wsAuth: async () => ({id: userId}),
+    sessionStore: store,
+    orchestrator,
+    resume: {enabled: true},
+    ...('history' in options ? {history: options.history} : {}),
+  } as HalServerOptions);
+
+  await hal.start(0);
+  servers.push(hal);
+  const {port} = hal.server.address() as AddressInfo;
+  return {store, base: `ws://127.0.0.1:${port}/hal/ws`};
+}
+
+function openClient(url: string, token = 'token'): WebSocket {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, token]);
+  clients.push(client);
+  return client;
+}
+
+function nextMessage(client: WebSocket): Promise<ProtocolFrame> {
+  return new Promise((resolve, reject) => {
+    const onMessage = (raw: unknown) => {
+      cleanup();
+      try {
+        resolve(JSON.parse(String(raw)) as ProtocolFrame);
+      } catch (err) {
+        reject(err);
+      }
+    };
+    const onError = (err: Error) => {
+      cleanup();
+      reject(err);
+    };
+    const cleanup = () => {
+      client.off('message', onMessage);
+      client.off('error', onError);
+    };
+    client.on('message', onMessage);
+    client.on('error', onError);
+  });
+}
+
+describe('conversation list over WebSocket', () => {
+  it("delivers the authenticated user's conversation list over WebSocket, respecting paging and ignoring any frame userId", async () => {
+    const store = new InMemorySessionStore();
+
+    const s1 = store.create('session-1', 'u1');
+    s1.entries.push({role: 'user', content: 'hello from s1', timestamp: '2026-10-01T10:00:00.000Z'});
+
+    const s2 = store.create('session-2', 'u1');
+    s2.entries.push({role: 'user', content: 'hello from s2', timestamp: '2026-10-02T10:00:00.000Z'});
+
+    const s3 = store.create('session-3', 'u1');
+    s3.entries.push({role: 'user', content: 'hello from s3', timestamp: '2026-10-03T10:00:00.000Z'});
+
+    const s4 = store.create('session-other', 'u2');
+    s4.entries.push({role: 'user', content: 'hello from other', timestamp: '2026-10-04T10:00:00.000Z'});
+
+    const {base} = await startEngine({store, history: {enabled: true}, userId: 'u1'});
+    const client = openClient(base);
+
+    const connected = await nextMessage(client);
+    expect(connected.type).toBe('connected');
+
+    client.send(JSON.stringify({type: 'list_conversations', userId: 'u2'}));
+
+    const listFrame = await nextMessage(client);
+    expect(listFrame).toEqual({
+      type: 'conversation_list',
+      conversations: [
+        {
+          sessionId: 'session-3',
+          createdAt: expect.stringMatching(/^\d{4}-\d{2}-\d{2}T/),
+          updatedAt: expect.stringMatching(/^\d{4}-\d{2}-\d{2}T/),
+          entryCount: 1,
+        },
+        {
+          sessionId: 'session-2',
+          createdAt: expect.stringMatching(/^\d{4}-\d{2}-\d{2}T/),
+          updatedAt: expect.stringMatching(/^\d{4}-\d{2}-\d{2}T/),
+          entryCount: 1,
+        },
+        {
+          sessionId: 'session-1',
+          createdAt: expect.stringMatching(/^\d{4}-\d{2}-\d{2}T/),
+          updatedAt: expect.stringMatching(/^\d{4}-\d{2}-\d{2}T/),
+          entryCount: 1,
+        },
+      ],
+    });
+
+    const cursor = {
+      updatedAt: listFrame.conversations![0].updatedAt,
+      sessionId: listFrame.conversations![0].sessionId,
+    };
+    client.send(JSON.stringify({type: 'list_conversations', limit: 1, before: cursor}));
+
+    const pagedFrame = await nextMessage(client);
+    expect(pagedFrame).toEqual({
+      type: 'conversation_list',
+      conversations: [
+        {
+          sessionId: 'session-2',
+          createdAt: expect.stringMatching(/^\d{4}-\d{2}-\d{2}T/),
+          updatedAt: expect.stringMatching(/^\d{4}-\d{2}-\d{2}T/),
+          entryCount: 1,
+        },
+      ],
+    });
+
+    client.close();
+    const resumeClient = openClient(`${base}?sessionId=session-3`);
+    const resumedConnected = await nextMessage(resumeClient);
+    expect(resumedConnected).toMatchObject({
+      type: 'connected',
+      sessionId: 'session-3',
+      resumed: true,
+    });
+  });
+
+  it('answers list_conversations with an UNSUPPORTED error frame when history is not enabled or store has no listFor', async () => {
+    const {base: baseWithoutHistory} = await startEngine({history: undefined});
+    const client1 = openClient(baseWithoutHistory);
+    await nextMessage(client1);
+    client1.send(JSON.stringify({type: 'list_conversations'}));
+    const response1 = await nextMessage(client1);
+    expect(response1).toEqual({
+      type: 'error',
+      code: 'UNSUPPORTED',
+      message: expect.any(String),
+    });
+
+    const storeWithoutList = new InMemorySessionStore();
+    delete (storeWithoutList as Partial<SessionStore>).listFor;
+    const {base: baseWithoutList} = await startEngine({history: {enabled: true}, store: storeWithoutList});
+    const client2 = openClient(baseWithoutList);
+    await nextMessage(client2);
+    client2.send(JSON.stringify({type: 'list_conversations'}));
+    const response2 = await nextMessage(client2);
+    expect(response2).toEqual({
+      type: 'error',
+      code: 'UNSUPPORTED',
+      message: expect.any(String),
+    });
+  });
+
+  it('answers list_conversations off the per-session lock while a user message is streaming', async () => {
+    const streamGate = deferred();
+    const pausingOrchestrator: ChatOrchestrator = {
+      processMessage: async () => 'hello response',
+      async *processMessageStream(): AsyncGenerator<MessageChunk> {
