diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..e6b8c50
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,315 @@
+import {once} from 'node:events';
+import type {WebSocket} from 'ws';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {MongoSessionStore} from '../infrastructure/stores/mongo/mongoSessionStore.js';
+import {fakeCollection} from '../infrastructure/stores/mongo/mongoTestSupport.js';
+import type {ChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import {setLogger} from '../shared/logger.js';
+import type {MessageChunk} from '../types/ai.js';
+import {ErrorCodes} from '../types/messages.js';
+import type {SessionListOptions, SessionStore} from '../types/sessionStore.js';
+import type {HalServer} from './createServer.js';
+import {connectClient, deferred, framesUntil, startEngineWith, stopEngines} from './wsTestSupport.js';
+
+const activeServers: HalServer[] = [];
+
+interface WireSummary {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+
+interface WireFrame {
+  type: string;
+  sessionId?: string;
+  conversations?: WireSummary[];
+  code?: string;
+  message?: string;
+  timestamp?: number;
+}
+
+interface RecordedListCall {
+  userId: string | number;
+  options?: SessionListOptions;
+}
+
+const seededStore = (): InMemorySessionStore => {
+  const store = new InMemorySessionStore();
+  const tiedFirst = store.create('tie-a', 'u1', {authHeaders: {authorization: 'Bearer secret'}});
+  tiedFirst.entries.push({role: 'user', content: 'first', timestamp: '2099-01-01T00:00:02.000Z'});
+  const tiedSecond = store.create('tie-b', 'u1', {authHeaders: {cookie: 'sid=hidden'}});
+  tiedSecond.entries.push(
+    {role: 'user', content: 'second', timestamp: '2099-01-01T00:00:01.000Z'},
+    {role: 'assistant', content: 'reply', timestamp: '2099-01-01T00:00:02.000Z', isStreaming: false}
+  );
+  const newest = store.create('newest', 'u1');
+  newest.entries.push({role: 'user', content: 'third', timestamp: '2099-01-01T00:00:04.000Z'});
+  const theirs = store.create('theirs', 'u2');
+  theirs.entries.push({role: 'user', content: 'other', timestamp: '2099-01-01T00:00:05.000Z'});
+  return store;
+};
+
+const fiveMemberStore = (inner: InMemorySessionStore): SessionStore => ({
+  create: (sessionId, userId, options) => inner.create(sessionId, userId, options),
+  get: sessionId => inner.get(sessionId),
+  delete: sessionId => inner.delete(sessionId),
+  count: () => inner.count(),
+  clear: () => inner.clear(),
+});
+
+const recordingStore = (inner: InMemorySessionStore, calls: RecordedListCall[]): SessionStore => ({
+  ...fiveMemberStore(inner),
+  listFor: (userId, options) => {
+    calls.push({userId, options});
+    return inner.listFor(userId, options);
+  },
+});
+
+const nextFrame = async (client: WebSocket): Promise<WireFrame> => {
+  const [raw] = (await once(client, 'message')) as [Buffer];
+  return JSON.parse(String(raw)) as WireFrame;
+};
+
+const requestFrame = async (client: WebSocket, payload: Record<string, unknown>): Promise<WireFrame> => {
+  const reply = nextFrame(client);
+  client.send(JSON.stringify(payload));
+  return reply;
+};
+
+const openReadySocket = async (
+  sessionStore: SessionStore,
+  options: Parameters<typeof startEngineWith>[0] = {sessionStore}
+): Promise<{client: WebSocket; sessionId: string}> => {
+  const {url, hal} = await startEngineWith(options);
+  activeServers.push(hal);
+  const client = connectClient(url);
+  let sessionId = '';
+  let frame = await nextFrame(client);
+  while (frame.type !== 'pong') {
+    if (frame.type === 'connected') {
+      sessionId = frame.sessionId ?? '';
+      client.send(JSON.stringify({type: 'ping', timestamp: 1}));
+    }
+    frame = await nextFrame(client);
+  }
+  return {client, sessionId};
+};
+
+describe('delivering a conversation list over the websocket protocol', () => {
+  beforeAll(() => {
+    setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined});
+  });
+
+  afterAll(() => {
+    setLogger();
+  });
+
+  afterEach(async () => {
+    await stopEngines();
+    while (activeServers.some(hal => hal.wss.clients.size > 0)) {
+      await new Promise(resolve => setImmediate(resolve));
+    }
+    activeServers.length = 0;
+  });
+
+  it("delivers the authenticated user's conversations newest-first as ISO summaries and pages with limit and a composite before cursor, including ties", async () => {
+    const inner = seededStore();
+    const calls: RecordedListCall[] = [];
+    const store = recordingStore(inner, calls);
+    const {client} = await openReadySocket(store, {
+      sessionStore: store,
+      resume: {enabled: true},
+    });
+    const expected = inner.listFor('u1').map(row => ({
+      sessionId: row.sessionId,
+      createdAt: row.createdAt.toISOString(),
+      updatedAt: row.updatedAt.toISOString(),
+      entryCount: row.entryCount,
+    }));
+
+    const firstPage = await requestFrame(client, {
+      type: 'list_conversations',
+      limit: 1,
+      userId: 'u2',
+      extra: 'ignored',
+    });
+    const secondPage = await requestFrame(client, {
+      type: 'list_conversations',
+      limit: 1,
+      before: {
+        updatedAt: expected[0].updatedAt,
+        sessionId: expected[0].sessionId,
+        extra: 'ignored',
+      },
+    });
+    const thirdPage = await requestFrame(client, {
+      type: 'list_conversations',
+      limit: 1,
+      before: {
+        updatedAt: expected[1].updatedAt,
+        sessionId: expected[1].sessionId,
+      },
+    });
+    const fullReply = await requestFrame(client, {type: 'list_conversations'});
+
+    expect({
+      firstPage,
+      secondPage,
+      thirdPage,
+      includesOtherUser: fullReply.conversations?.some(row => row.sessionId === 'theirs') ?? true,
+      calls: calls.slice(0, 2),
+    }).toEqual({
+      firstPage: {type: 'conversation_list', conversations: [expected[0]]},
+      secondPage: {type: 'conversation_list', conversations: [expected[1]]},
