+
+    const defaultReply = await requestFrame(defaultClient, {type: 'list_conversations'});
+    const bareReply = await requestFrame(bareClient, {type: 'list_conversations'});
+    const mongoReply = await requestFrame(mongoClient, {type: 'list_conversations'});
+    const failureReply = await requestFrame(failingClient, {type: 'list_conversations'});
+    const followUpPong = await requestFrame(failingClient, {type: 'ping', timestamp: 42});
+
+    const unsupportedFrame = {
+      type: 'error',
+      code: 'UNSUPPORTED',
