+    const loggedErrors: Array<{category: string; message: string}> = [];
+    setLogger({
+      debug: () => undefined,
+      info: () => undefined,
+      warn: () => undefined,
+      error: (category, message) => void loggedErrors.push({category, message}),
+    });
+
+    const {client: defaultClient} = await openReadySocket(defaultStore, {sessionStore: defaultStore});
+    const {client: bareClient} = await openReadySocket(bareStore, {
+      sessionStore: bareStore,
+      resume: {enabled: true},
+    });
+    const {client: mongoClient} = await openReadySocket(minimalMongoStore, {
+      sessionStore: minimalMongoStore,
+      resume: {enabled: true},
+    });
+    const {client: failingClient} = await openReadySocket(failingStore, {
+      sessionStore: failingStore,
+      resume: {enabled: true},
