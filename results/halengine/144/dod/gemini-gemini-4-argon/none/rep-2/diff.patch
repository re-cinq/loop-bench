+  it('answers list_conversations while a turn is streaming without waiting on the session lock or sending an extra stream_end', async () => {
+    const gate = deferred();
+    const orchestrator: ChatOrchestrator = {
+      processMessage: async () => 'hello',
+      async *processMessageStream(): AsyncGenerator<MessageChunk> {
+        yield {type: 'text', text: 'hel'};
+        await gate.until;
+        yield {type: 'text', text: 'lo'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+    };
+    const store = new InMemorySessionStore();
+    const {client, sessionId} = await openReadySocket(store, {
+      sessionStore: store,
+      orchestrator,
+      resume: {enabled: true},
+    });
+    const firstChunk = framesUntil(client, 'entry_delta');
+    client.send(JSON.stringify({type: 'user_message', content: 'hi'}));
+    await firstChunk;
+
+    const duringStream = await requestFrame(client, {type: 'list_conversations'});
+    const streamFinished = framesUntil(client, 'stream_end');
+    gate.release();
+    const trailingFrames = await streamFinished;
+
+    expect({
+      type: duringStream.type,
+      listedIds: duringStream.conversations?.map(row => row.sessionId),
+      streamEndCount: trailingFrames.filter(frameType => frameType === 'stream_end').length,
+      finishedWith: trailingFrames.at(-1),
+    }).toEqual({
+      type: 'conversation_list',
+      listedIds: [sessionId],
+      streamEndCount: 1,
+      finishedWith: 'stream_end',
+    });
+  });
