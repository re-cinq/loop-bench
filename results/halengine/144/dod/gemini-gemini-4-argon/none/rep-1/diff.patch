diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..39b74dc
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,267 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import {createHalEngine} from '../config.js';
+import type {HalEngine, HalEngineConfig} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {setLogger} from '../shared/logger.js';
+import type {AIProvider} from '../types/ai.js';
+import type {SessionStore} from '../types/sessionStore.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {deferred} from './wsTestSupport.js';
+
+// Real WebSocket connections through createHalEngine: history is delivered over the authenticated socket.
+
+interface Frame {
+  type: string;
+  sessionId?: string;
+  resumed?: boolean;
+  entryCount?: number;
+  code?: string;
+  message?: string;
+  timestamp?: number;
+  conversations?: Array<{
+    sessionId: string;
+    createdAt: string;
+    updatedAt: string;
+    entryCount: number;
+  }>;
+}
+
+const engines: HalEngine[] = [];
+const clients: WebSocket[] = [];
+
+const eventually = async (check: () => boolean): Promise<void> => {
+  for (let attempt = 0; attempt < 50 && !check(); attempt++) await new Promise(resolve => setTimeout(resolve, 10));
+};
+
+beforeAll(() => {
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined});
+});
+
+afterAll(() => {
+  setLogger();
+});
+
+afterEach(async () => {
+  for (const client of clients.splice(0)) client.terminate();
+  for (const engine of engines.splice(0)) {
+    const {wss} = engine;
+    await eventually(() => wss.clients.size === 0);
+    await engine.stop();
+  }
+});
+
+const startEngine = async (
+  session: SessionStore,
+  transport?: Record<string, unknown>,
+  provider: AIProvider = {
+    async *sendMessage() {
+      yield {type: 'text', text: 'hi'};
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  }
+) => {
+  const auth = {userId: 'u1'};
+  const engine = createHalEngine({
+    provider: {type: 'custom', instance: provider},
+    prompt: {identity: 'History test.'},
+    auth: {ws: async () => ({id: auth.userId})},
+    session,
+    transport: transport as HalEngineConfig['transport'],
+  });
+  await engine.start(0);
+  engines.push(engine);
+  const {port} = engine.server.address() as AddressInfo;
+  return {auth, base: `ws://127.0.0.1:${port}/hal/ws`};
+};
+
+const open = (url: string): WebSocket => {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 't']);
+  clients.push(client);
+  return client;
+};
+
+// Sends `request` right after `connected`, followed by a ping barrier so every frame written for `request` is collected.
+const askAfterConnect = async (url: string, request: Record<string, unknown>): Promise<Frame[]> => {
+  const client = open(url);
+  const frames: Frame[] = [];
+  await new Promise<void>(resolve => {
+    client.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as Frame;
+      frames.push(frame);
+      if (frame.type === 'connected') {
+        client.send(JSON.stringify(request));
+        client.send(JSON.stringify({type: 'ping', timestamp: 1}));
+      }
+      if (frame.type === 'pong') resolve();
+    });
+  });
+  client.close();
+  await once(client, 'close');
+  return frames;
+};
+
+const seededStore = (): InMemorySessionStore => {
+  const store = new InMemorySessionStore();
+  const s1 = store.create('s1', 'u1');
+  s1.entries.push({role: 'user', content: 'first', timestamp: '2099-09-30T08:00:00.000Z'});
+  const s2 = store.create('s2', 'u1');
+  s2.entries.push(
+    {role: 'user', content: 'second', timestamp: '2099-09-30T09:00:00.000Z'},
+    {role: 'assistant', content: 'reply', timestamp: '2099-09-30T09:00:05.000Z', isStreaming: false}
+  );
+  const theirs = store.create('theirs', 'u2');
+  theirs.entries.push({role: 'user', content: 'secret', timestamp: '2099-09-30T10:00:00.000Z'});
+  return store;
+};
+
+const delegatingWithoutList = (inner: InMemorySessionStore): SessionStore => ({
+  create: (sessionId, userId, options) => inner.create(sessionId, userId, options),
+  get: sessionId => inner.get(sessionId),
+  delete: sessionId => inner.delete(sessionId),
+  count: () => inner.count(),
+  clear: () => inner.clear(),
+});
+
+describe('delivering a conversation list over the WebSocket protocol', () => {
+  it('with history enabled, answers list_conversations with the connected user summaries newest first, pages with limit and before, and resumes a chosen id', async () => {
+    const inner = seededStore();
+    const recordedCalls: Array<{userId: string | number; options: unknown}> = [];
+    const store: SessionStore = {
+      ...delegatingWithoutList(inner),
+      lookup: sessionId => inner.lookup(sessionId),
+      listFor: (userId, options) => {
+        recordedCalls.push({userId, options});
+        return inner.listFor(userId, options);
+      },
+    };
+    const {base} = await startEngine(store, {history: {enabled: true}, resume: {enabled: true}});
+
+    const allFrames = await askAfterConnect(base, {type: 'list_conversations', userId: 'u2'});
+    const firstList = allFrames.find(frame => frame.type === 'conversation_list');
+    const cursor = {updatedAt: '2099-09-30T09:00:05.000Z', sessionId: 's2'};
+    const pagedFrames = await askAfterConnect(base, {
+      type: 'list_conversations',
+      limit: 1,
+      before: cursor,
+    });
+    const pagedList = pagedFrames.find(frame => frame.type === 'conversation_list');
+    const resumedFrames = await askAfterConnect(`${base}?sessionId=s2`, {type: 'ping', timestamp: 2});
+
+    expect({
+      types: allFrames.map(frame => frame.type),
+      listedIds: firstList?.conversations?.map(row => row.sessionId),
+      isoDates: firstList?.conversations?.every(
+        row => !Number.isNaN(Date.parse(row.createdAt)) && !Number.isNaN(Date.parse(row.updatedAt))
+      ),
+      calledForUsers: recordedCalls.map(call => call.userId),
+      secondCallOptions: recordedCalls[1]?.options,
+      pagedIds: pagedList?.conversations?.map(row => row.sessionId),
+      resumed: {
+        resumed: resumedFrames[0]?.resumed,
+        entryCount: resumedFrames[0]?.entryCount,
+        upserts: resumedFrames.filter(frame => frame.type === 'entry_upsert').length,
+      },
+    }).toEqual({
+      types: ['connected', 'conversation_list', 'pong'],
+      listedIds: ['s2', 's1', allFrames[0]?.sessionId ?? ''],
+      isoDates: true,
+      calledForUsers: ['u1', 'u1'],
+      secondCallOptions: {
+        limit: 1,
+        before: cursor,
+      },
+      pagedIds: ['s1'],
+      resumed: {resumed: true, entryCount: 2, upserts: 2},
+    });
+  });
+
+  it('answers list_conversations off the per-session lock while a user_message is streaming on the same session', async () => {
+    const gate = deferred();
+    const provider: AIProvider = {
+      async *sendMessage() {
+        yield {type: 'text', text: 'streaming'};
+        await gate.until;
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const {base} = await startEngine(seededStore(), {history: {enabled: true}}, provider);
+    const client = open(base);
+    const seen: string[] = [];
+
+    await new Promise<void>(resolve => {
+      client.on('message', raw => {
+        const frame = JSON.parse(String(raw)) as Frame;
+        seen.push(frame.type);
+        if (frame.type === 'connected') {
