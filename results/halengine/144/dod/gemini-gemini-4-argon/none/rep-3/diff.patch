@@ -68,3 +68,9 @@ Resume gets a client back into one conversation: the id it names, or the user's
 ## When the store cannot answer
 
 - A store whose collection fails rejects rather than answering a partial or empty list: what to show a user who may have conversations is the caller's decision, and an empty history is not a safe guess ([validated by: rejects rather than answering a partial list when the collection fails](../../src/infrastructure/stores/mongo/mongoConversationList.test.ts#L225)).
+
+## Over the WebSocket protocol
+
+- With `transport.history: {enabled: true}` and a store that implements `listFor`, a `list_conversations` frame is answered with a `conversation_list` frame carrying the connecting user's summaries newest first with ISO-8601 `createdAt` and `updatedAt` strings, forwarding `{limit, before}` to `store.listFor`, ignoring any `userId` on the wire, leaving `connected` unchanged, and letting the client rejoin a listed `sessionId` by reconnecting with `?sessionId=<id>` ([validated by: answers list_conversations with a conversation_list of the connecting user summaries newest first, paging with limit and before, ignoring a wire userId, and resuming a listed id on reconnect](../../src/transport/conversationList.acceptance.test.ts#L138)).
+- With `transport.history` off, when the store omits `listFor`, or when `listFor` throws `StoreCannotList`, `list_conversations` is answered with an `error` frame carrying code `UNSUPPORTED` rather than an empty list; when `listFor` rejects, it answers `SERVER_ERROR` with no store detail; and when `limit` or `before` fails boundary validation, it answers `INVALID_MESSAGE` ([validated by: refuses list_conversations with UNSUPPORTED when history is off or the store cannot list, with SERVER_ERROR and no store detail when listFor rejects, and with INVALID_MESSAGE on malformed fields](../../src/transport/conversationList.acceptance.test.ts#L202)).
+- `list_conversations` is answered off the per-session lock, so a request sent while a `user_message` is streaming on the same session receives its `conversation_list` before that turn's `stream_end` ([validated by: answers list_conversations off the per-session lock before an in-flight user_message sends stream_end](../../src/transport/conversationList.acceptance.test.ts#L245)).
diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..cdd07c9
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,283 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import type {Express} from 'express';
+import {createServer} from './createServer.js';
+import type {HalServerOptions} from './createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import type {SessionResumeOptions} from './ws/sessionResume.js';
+import {answeringOrchestrator} from './wsTestSupport.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {ChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import type {MessageChunk} from '../types/ai.js';
+import type {SessionListOptions, SessionStore} from '../types/sessionStore.js';
+import {setLogger} from '../shared/logger.js';
+
+// Real upgrades over a real socket: how a conversation list travels on the wire is the contract.
+
+interface ConversationRow {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+
+interface Frame {
+  type: string;
+  sessionId?: string;
+  resumed?: boolean;
+  entryCount?: number;
+  conversations?: ConversationRow[];
+  code?: string;
+  message?: string;
+}
+
+const RESUME_ON: SessionResumeOptions = {enabled: true};
+const HISTORY_ON = {enabled: true};
+
+const servers: Array<ReturnType<typeof createServer>> = [];
+const clients: WebSocket[] = [];
+
+const eventually = async (check: () => boolean): Promise<void> => {
+  for (let attempt = 0; attempt < 50 && !check(); attempt++) await new Promise(resolve => setTimeout(resolve, 10));
+};
+
+beforeAll(() => {
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined});
+});
+
+afterAll(() => {
+  setLogger();
+});
+
+afterEach(async () => {
+  for (const client of clients.splice(0)) client.terminate();
+  for (const hal of servers.splice(0)) {
+    const {wss} = hal;
+    await eventually(() => wss.clients.size === 0);
+    await hal.stop();
+  }
+});
+
+interface StartOptions {
+  resume?: SessionResumeOptions;
+  history?: {enabled: boolean};
+  orchestrator?: ChatOrchestrator;
+}
+
+const startEngine = async (store: SessionStore, options: StartOptions = {}) => {
+  const auth = {userId: 'u1'};
+  const serverOptions = {
+    app: (() => undefined) as unknown as Express,
+    wsAuth: async () => ({id: auth.userId}),
+    sessionStore: store,
+    orchestrator: options.orchestrator ?? answeringOrchestrator,
+    resume: options.resume,
+    history: options.history,
+  };
+  const hal = createServer(serverOptions as HalServerOptions);
+  await hal.start(0);
+  servers.push(hal);
+  const {port} = hal.server.address() as AddressInfo;
+  return {auth, base: `ws://127.0.0.1:${port}/hal/ws`};
+};
+
+const open = (url: string, token = 't'): WebSocket => {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, token]);
+  clients.push(client);
+  return client;
+};
+
+const connectAndSettle = async (url: string): Promise<{client: WebSocket; frames: Frame[]}> => {
+  const client = open(url);
+  const frames: Frame[] = [];
+  await new Promise<void>(resolve => {
+    client.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as Frame;
+      frames.push(frame);
+      if (frame.type === 'connected') client.send(JSON.stringify({type: 'ping', timestamp: 1}));
+      if (frame.type === 'pong') resolve();
+    });
+  });
+  return {client, frames};
+};
+
+const sendAndReceive = async (client: WebSocket, payload: Record<string, unknown>): Promise<Frame> => {
+  const next = once(client, 'message') as Promise<[Buffer]>;
+  client.send(JSON.stringify(payload));
+  const [raw] = await next;
+  return JSON.parse(String(raw)) as Frame;
+};
+
+const storeWith = (conversations: Array<[sessionId: string, userId: string, sentAt: string]>): InMemorySessionStore => {
+  const store = new InMemorySessionStore();
+  for (const [sessionId, userId, sentAt] of conversations) {
+    const {entries} = store.create(sessionId, userId);
+    entries.push({role: 'user', content: sessionId, timestamp: sentAt});
+  }
+  return store;
+};
+
+const delegatingTo = (inner: InMemorySessionStore): SessionStore => ({
+  create: (sessionId, userId, options) => inner.create(sessionId, userId, options),
+  get: sessionId => inner.get(sessionId),
+  delete: sessionId => inner.delete(sessionId),
+  count: () => inner.count(),
+  clear: () => inner.clear(),
+});
+
+const deferred = () => {
+  let release = (): void => undefined;
+  const until = new Promise<void>(resolve => {
+    release = resolve;
+  });
+  return {until, release: () => release()};
+};
+
+describe('delivering a user conversation list over the WebSocket protocol', () => {
+  it('answers list_conversations with a conversation_list of the connecting user summaries newest first, paging with limit and before, ignoring a wire userId, and resuming a listed id on reconnect', async () => {
+    const inner = storeWith([
+      ['oldest', 'u1', '2026-09-30T07:00:00.000Z'],
+      ['middle', 'u1', '2026-09-30T08:00:00.000Z'],
+      ['newest', 'u1', '2026-09-30T09:00:00.000Z'],
+      ['theirs', 'u2', '2026-09-30T10:00:00.000Z'],
+    ]);
+    const listCalls: Array<{userId: string | number; options?: SessionListOptions}> = [];
+    const store: SessionStore = {
+      ...delegatingTo(inner),
+      listFor: (userId, options) => {
+        listCalls.push({userId, options});
+        return inner.listFor(userId, options);
+      },
+    };
+    const {base} = await startEngine(store, {resume: RESUME_ON, history: HISTORY_ON});
+    const {client, frames: initialFrames} = await connectAndSettle(`${base}?sessionId=newest`);
+
+    const allPage = await sendAndReceive(client, {type: 'list_conversations', userId: 'u2'});
+    const firstPage = await sendAndReceive(client, {type: 'list_conversations', limit: 1});
+    const cursor = firstPage.conversations?.[0];
+    const secondPage = await sendAndReceive(client, {
+      type: 'list_conversations',
+      limit: 2,
+      before: cursor ? {updatedAt: cursor.updatedAt, sessionId: cursor.sessionId} : undefined,
+    });
+    const pickedId = secondPage.conversations?.[1]?.sessionId ?? '';
+    const resumedConn = await connectAndSettle(`${base}?sessionId=${pickedId}`);
+
+    expect({
+      connectedHasConversations: 'conversations' in initialFrames[0],
+      allType: allPage.type,
+      allIds: allPage.conversations?.map(row => row.sessionId),
+      firstRow: firstPage.conversations?.[0],
+      secondIds: secondPage.conversations?.map(row => row.sessionId),
+      listCalls,
+      resumed: {
+        sessionId: resumedConn.frames[0].sessionId,
+        resumed: resumedConn.frames[0].resumed,
+        entryCount: resumedConn.frames[0].entryCount,
+      },
+    }).toEqual({
+      connectedHasConversations: false,
+      allType: 'conversation_list',
+      allIds: ['newest', 'middle', 'oldest'],
+      firstRow: {
+        sessionId: 'newest',
+        createdAt: expect.stringMatching(/^\d{4}-\d{2}-\d{2}T/),
+        updatedAt: '2026-09-30T09:00:00.000Z',
+        entryCount: 1,
+      },
+      secondIds: ['middle', 'oldest'],
+      listCalls: [
+        {userId: 'u1', options: {limit: undefined, before: undefined}},
+        {userId: 'u1', options: {limit: 1, before: undefined}},
+        {
+          userId: 'u1',
+          options: {limit: 2, before: {updatedAt: '2026-09-30T09:00:00.000Z', sessionId: 'newest'}},
+        },
+      ],
+      resumed: {sessionId: 'oldest', resumed: true, entryCount: 1},
+    });
+  });
+
+  it('refuses list_conversations with UNSUPPORTED when history is off or the store cannot list, with SERVER_ERROR and no store detail when listFor rejects, and with INVALID_MESSAGE on malformed fields', async () => {
+    const inner = storeWith([['known', 'u1', '2026-09-30T08:00:00.000Z']]);
+    const failingStore: SessionStore = {
+      ...delegatingTo(inner),
+      listFor: async () => {
+        throw new Error('secret database host 10.0.0.9 unreachable');
+      },
+    };
+    const historyOff = await startEngine(inner);
+    const noListFor = await startEngine(delegatingTo(inner), {history: HISTORY_ON});
+    const failing = await startEngine(failingStore, {history: HISTORY_ON});
+    const offConn = await connectAndSettle(historyOff.base);
+    const absentConn = await connectAndSettle(noListFor.base);
+    const failingConn = await connectAndSettle(failing.base);
+
+    const offReply = await sendAndReceive(offConn.client, {type: 'list_conversations'});
+    const absentReply = await sendAndReceive(absentConn.client, {type: 'list_conversations'});
+    const failingReply = await sendAndReceive(failingConn.client, {type: 'list_conversations'});
+    const badLimit = await sendAndReceive(absentConn.client, {type: 'list_conversations', limit: 0});
+    const badBefore = await sendAndReceive(absentConn.client, {
+      type: 'list_conversations',
+      before: {updatedAt: 'not-a-date', sessionId: 's1'},
+    });
+
+    expect({
+      offCode: offReply.code,
+      absentCode: absentReply.code,
+      failingType: failingReply.type,
+      failingCode: failingReply.code,
+      leakedStoreDetail: Boolean(failingReply.message?.includes('10.0.0.9')),
+      badLimitCode: badLimit.code,
+      badBeforeCode: badBefore.code,
+    }).toEqual({
+      offCode: 'UNSUPPORTED',
+      absentCode: 'UNSUPPORTED',
+      failingType: 'error',
+      failingCode: 'SERVER_ERROR',
+      leakedStoreDetail: false,
+      badLimitCode: 'INVALID_MESSAGE',
+      badBeforeCode: 'INVALID_MESSAGE',
+    });
+  });
+
+  it('answers list_conversations off the per-session lock before an in-flight user_message sends stream_end', async () => {
+    const gate = deferred();
+    const streamingStarted = deferred();
+    const slowOrchestrator: ChatOrchestrator = {
+      processMessage: async () => 'done',
+      async *processMessageStream(): AsyncGenerator<MessageChunk> {
+        yield {type: 'text', text: 'thinking...'};
+        streamingStarted.release();
+        await gate.until;
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+    };
+    const store = storeWith([['earlier', 'u1', '2026-09-30T08:00:00.000Z']]);
+    const {base} = await startEngine(store, {resume: RESUME_ON, history: HISTORY_ON, orchestrator: slowOrchestrator});
+    const {client} = await connectAndSettle(`${base}?sessionId=earlier`);
+    const seenTypes: string[] = [];
+    client.on('message', raw => {
+      seenTypes.push((JSON.parse(String(raw)) as Frame).type);
+    });
+
+    client.send(JSON.stringify({type: 'user_message', content: 'take your time'}));
+    await streamingStarted.until;
+    client.send(JSON.stringify({type: 'list_conversations'}));
+    await eventually(() => seenTypes.includes('conversation_list'));
+    const beforeStreamEnd = [...seenTypes];
+    gate.release();
+    await eventually(() => seenTypes.includes('stream_end'));
+
+    expect({
+      listedWhileStreaming: beforeStreamEnd.includes('conversation_list'),
+      streamEndedBeforeRelease: beforeStreamEnd.includes('stream_end'),
+      endedAfterRelease: seenTypes.at(-1),
+    }).toEqual({
+      listedWhileStreaming: true,
+      streamEndedBeforeRelease: false,
+      endedAfterRelease: 'stream_end',
+    });
+  });
+});