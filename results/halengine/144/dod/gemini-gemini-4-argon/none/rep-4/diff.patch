@@ -0,0 +1,290 @@
+import type {HalServer, HalServerOptions} from './createServer.js';
+import {createServer} from './createServer.js';
+import {connectClient, deferred, startEngine, startEngineWith, stopEngines} from './wsTestSupport.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {fiveMemberStore} from '../infrastructure/stores/sessionStoreTestSupport.js';
+import {setLogger} from '../shared/logger.js';
+import type {Logger} from '../shared/logger.js';
+import type {ChatSession} from '../types/session.js';
+import type {SessionCursor, SessionListOptions, SessionStore, SessionSummary} from '../types/sessionStore.js';
+import type {OutgoingMessage} from '../types/messages.js';
+
+interface WireSummary {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+
+type Frame = OutgoingMessage | {type: 'conversation_list'; conversations: WireSummary[]};
+
+const HISTORY_ON = {history: {enabled: true}} as unknown as Partial<HalServerOptions>;
+
+// Opens a socket against `url`, sends `request` once `connected` arrives, and resolves with the reply frame.
+async function sendFrame(url: string, request: unknown): Promise<Frame> {
+  const client = connectClient(url);
+  return new Promise<Frame>(resolve => {
+    client.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as Frame;
+      if (frame.type === 'connected') {
+        client.send(JSON.stringify(request));
+        return;
+      }
+      resolve(frame);
+    });
+  });
+}
+
+// Records a user entry on the session so its updatedAt advances past creation and its entryCount is non-zero.
+function addTurn(session: ChatSession, content: string, timestamp: string): void {
+  session.entries.push({role: 'user', content, timestamp});
+}
+
+describe('delivering a conversation list over the WebSocket protocol', () => {
+  afterEach(async () => {
+    await stopEngines();
+    await new Promise<void>(resolve => setTimeout(resolve, 20));
+    setLogger();
+  });
+
+  it('pages the connecting user conversations newest first with ISO dates and forwards limit and before', async () => {
+    let clock = Date.parse('2026-03-01T10:00:00.000Z');
+    const store = new InMemorySessionStore({
+      now: () => {
+        clock += 1_000;
+        return new Date(clock);
+      },
+    });
+    const older = store.create('s-1', 'u1', {authHeaders: {authorization: 'Bearer secret'}});
+    addTurn(older, 'first turn', '2026-03-01T10:05:00.000Z');
+    const newer = store.create('s-2', 'u1', {authHeaders: {cookie: 'sid=secret'}});
+    addTurn(newer, 'second turn', '2026-03-01T10:10:00.000Z');
+    const otherUser = store.create('s-other', 'u2');
+    addTurn(otherUser, 'other user turn', '2026-03-01T10:20:00.000Z');
+
+    const forwarded: Array<{userId: string | number; options?: SessionListOptions}> = [];
+    const tracked: SessionStore = {
+      create: (id, userId, options) => store.create(id, userId, options),
+      get: id => store.get(id),
+      delete: id => store.delete(id),
+      count: () => store.count(),
+      clear: () => store.clear(),
+      listFor: (userId, options) => {
+        forwarded.push({userId, options});
+        return store.listFor(userId, options);
+      },
+    };
+    const {url} = await startEngineWith({
+      ...HISTORY_ON,
+      sessionStore: tracked,
+      wsAuth: async () => ({id: 'u1'}),
+    });
+
+    // A hostile `userId` on the frame is ignored: the socket's own authenticated user is queried instead.
+    const firstFrame = await sendFrame(url, {type: 'list_conversations', limit: 2, userId: 'u2'});
+    const firstList = firstFrame.type === 'conversation_list' ? firstFrame.conversations : [];
+    const cursor = firstList.find(row => row.sessionId === 's-2');
+    const secondFrame = await sendFrame(url, {
+      type: 'list_conversations',
+      limit: 1,
+      before: cursor
+        ? {updatedAt: cursor.updatedAt, sessionId: cursor.sessionId}
+        : {updatedAt: '2026-03-01T10:10:00.000Z', sessionId: 's-2'},
+    });
+    const secondList = secondFrame.type === 'conversation_list' ? secondFrame.conversations : [];
+
+    expect({
+      firstType: firstFrame.type,
+      ids: firstList.map(row => row.sessionId),
+      s2: cursor && {
+        keys: Object.keys(cursor).sort(),
+        entryCount: cursor.entryCount,
+        updatedAt: cursor.updatedAt,
+        createdAtIso: !Number.isNaN(Date.parse(cursor.createdAt)),
+      },
+      secondIds: secondList.map(row => row.sessionId),
+      forwarded,
+    }).toEqual({
+      firstType: 'conversation_list',
+      ids: ['s-2', 's-1'],
+      s2: {
+        keys: ['createdAt', 'entryCount', 'sessionId', 'updatedAt'],
+        entryCount: 1,
+        updatedAt: '2026-03-01T10:10:00.000Z',
+        createdAtIso: true,
+      },
+      secondIds: ['s-1'],
+      forwarded: [
+        {userId: 'u1', options: {limit: 2, before: undefined}},
+        {
+          userId: 'u1',
+          options: {
+            limit: 1,
+            before: {updatedAt: '2026-03-01T10:10:00.000Z', sessionId: 's-2'},
+          },
+        },
+      ],
+    });
+  });
+
+  it('answers list_conversations at once without waiting for an in-flight user_message stream', async () => {
+    const gate = deferred();
+    const store = new InMemorySessionStore();
+    const seeded = store.create('s-prior', 'u1');
+    addTurn(seeded, 'earlier question', '2026-03-01T09:00:00.000Z');
+
+    const {url} = await startEngineWith({
+      ...HISTORY_ON,
+      sessionStore: store,
+      orchestrator: {
+        processMessage: async () => 'answer',
+        async *processMessageStream() {
+          yield {type: 'text', text: 'first '};
+          await gate.until;
+          yield {type: 'text', text: 'second'};
+          yield {type: 'stop', stopReason: 'end_turn'};
+        },
+      },
+    });
+
+    const client = connectClient(url);
+    const order: string[] = [];
+    const listReplied = deferred();
+    const streamDone = deferred();
+
+    client.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as Frame;
+      order.push(frame.type);
+      if (frame.type === 'connected') {
+        client.send(JSON.stringify({type: 'user_message', content: 'hold the turn'}));
+      }
+      if (frame.type === 'entry_delta' && order.filter(kind => kind === 'entry_delta').length === 1) {
+        client.send(JSON.stringify({type: 'list_conversations'}));
+      }
+      if (frame.type === 'conversation_list' || frame.type === 'error') listReplied.release();
+      if (frame.type === 'stream_end') streamDone.release();
+    });
+
+    await listReplied.until;
+    const beforeRelease = [...order];
+    gate.release();
+    await streamDone.until;
+
+    expect({
+      answeredWhileStreaming: beforeRelease.includes('conversation_list') && !beforeRelease.includes('stream_end'),
+      endedCleanly: order.at(-1),
+    }).toEqual({
+      answeredWhileStreaming: true,
+      endedCleanly: 'stream_end',
+    });
+  });
+
+  it('accepts valid limit and before bounds and rejects malformed ones with INVALID_MESSAGE without calling listFor', async () => {
+    const calls: unknown[] = [];
+    const base = new InMemorySessionStore();
+    const store: SessionStore = {
+      create: (id, userId, options) => base.create(id, userId, options),
+      get: id => base.get(id),
+      delete: id => base.delete(id),
+      count: () => base.count(),
+      clear: () => base.clear(),
+      listFor: (userId, options) => {
+        calls.push({userId, options});
+        return [];
+      },
+    };
+    const {url} = await startEngineWith({...HISTORY_ON, sessionStore: store});
+
+    const validBottom = await sendFrame(url, {type: 'list_conversations', limit: 1});
+    const validTop = await sendFrame(url, {
+      type: 'list_conversations',
+      limit: 200,
+      before: {updatedAt: '2026-03-01T10:00:00.000Z', sessionId: 's-1'},
+    });
+
+    const invalidFrames = [
+      {type: 'list_conversations', limit: 0},
+      {type: 'list_conversations', limit: -1},
+      {type: 'list_conversations', limit: 1.5},
+      {type: 'list_conversations', limit: 201},
+      {type: 'list_conversations', limit: '10'},
+      {type: 'list_conversations', before: '2026-03-01T10:00:00.000Z'},
+      {type: 'list_conversations', before: {updatedAt: 'not-a-date', sessionId: 's-1'}},
+      {type: 'list_conversations', before: {updatedAt: '2026-03-01T10:00:00.000Z', sessionId: ''}},
+      {type: 'list_conversations', before: {updatedAt: '2026-03-01T10:00:00.000Z'}},
+    ];
+
+    const invalidOutcomes: string[] = [];
+    for (const payload of invalidFrames) {
+      const frame = await sendFrame(url, payload);
+      invalidOutcomes.push(frame.type === 'error' ? `${frame.type}:${frame.code}` : frame.type);
+    }
+
+    expect({
+      valid: [validBottom.type, validTop.type],
+      invalidOutcomes,
+      calls,
+    }).toEqual({
+      valid: ['conversation_list', 'conversation_list'],
+      invalidOutcomes: Array.from({length: invalidFrames.length}, () => 'error:INVALID_MESSAGE'),
+      calls: [
+        {userId: 'u1', options: {limit: 1, before: undefined}},
+        {
+          userId: 'u1',
+          options: {
+            limit: 200,
+            before: {updatedAt: '2026-03-01T10:00:00.000Z', sessionId: 's-1'},
+          },
+        },
+      ],
+    });
+  });
+
+  it('answers with error UNSUPPORTED when history is absent or the store implements no listFor, and SERVER_ERROR when listFor rejects', async () => {
+    const logged: Array<Record<string, unknown>> = [];
+    const quiet = () => undefined;
+    setLogger({
+      debug: quiet,
+      info: quiet,
+      warn: quiet,
+      error: (category, message, fields) => void logged.push({category, message, ...fields}),
+    } as Logger);
+
+    const historyOffUrl = await startEngine(new InMemorySessionStore());
+    const historyOffFrame = await sendFrame(historyOffUrl, {type: 'list_conversations'});
+
+    const {url: unsupportedUrl} = await startEngineWith({...HISTORY_ON, sessionStore: fiveMemberStore});
+    const unsupportedFrame = await sendFrame(unsupportedUrl, {type: 'list_conversations'});
+
+    const throwingStore: SessionStore = {
+      ...fiveMemberStore,
+      listFor: async (): Promise<SessionSummary[]> => {
+        throw new Error('secret-for-u1-connection-string');
+      },
+    };
+    const {url: throwingUrl} = await startEngineWith({...HISTORY_ON, sessionStore: throwingStore});
+    const throwingFrame = await sendFrame(throwingUrl, {type: 'list_conversations'});
+
+    const format = (frame: Frame) =>
+      frame.type === 'error' ? {type: frame.type, code: frame.code} : {type: frame.type};
+    const listFailures = logged.filter(line => line.category === 'message');
+
+    expect({
+      historyOff: format(historyOffFrame),
+      unsupported: format(unsupportedFrame),
+      throwing: format(throwingFrame),
+      leakedUserInLog: listFailures.some(line => JSON.stringify(line).includes('u1')),
+      loggedError: listFailures.length > 0,
+    }).toEqual({
+      historyOff: {type: 'error', code: 'UNSUPPORTED'},
+      unsupported: {type: 'error', code: 'UNSUPPORTED'},
+      throwing: {type: 'error', code: 'SERVER_ERROR'},
+      leakedUserInLog: false,
+      loggedError: true,
+    });
+  });
+});
+
+void (null as unknown as HalServer);
+void (null as unknown as SessionCursor);
+void createServer;