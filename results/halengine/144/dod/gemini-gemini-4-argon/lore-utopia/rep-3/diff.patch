+  it('answers list_conversations at once while a user_message turn is still streaming', async () => {
+    const firstChunkSent = deferred();
+    const finishTurn = deferred();
+    const holdingOrchestrator: ChatOrchestrator = {
+      processMessage: async () => 'held',
+      async *processMessageStream(): AsyncGenerator<MessageChunk> {
+        yield {type: 'text', text: 'streaming'};
+        firstChunkSent.release();
+        await finishTurn.until;
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+    };
+    const base = await startHistoryServer(seededStore(), {
+      historyEnabled: true,
+      orchestrator: holdingOrchestrator,
+    });
+    const {client} = await connectClient(base);
+    const seenTypes: string[] = [];
+    client.on('message', raw => {
+      seenTypes.push((JSON.parse(String(raw)) as Frame).type);
+    });
+
+    client.send(JSON.stringify({type: 'user_message', content: 'hold the turn'}));
+    await firstChunkSent.until;
+    client.send(JSON.stringify({type: 'list_conversations'}));
+    await eventually(() => seenTypes.includes('conversation_list') || seenTypes.includes('error'));
+    finishTurn.release();
+    await eventually(() => seenTypes.includes('stream_end'));
+
+    expect({
+      listIndex: seenTypes.indexOf('conversation_list'),
+      beforeStreamEnd:
+        seenTypes.includes('conversation_list') &&
+        seenTypes.indexOf('conversation_list') < seenTypes.indexOf('stream_end'),
+    }).toEqual({
+      listIndex: expect.any(Number),
+      beforeStreamEnd: true,
+    });
+  });
