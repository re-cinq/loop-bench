+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,262 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import type {Express} from 'express';
+import {createServer} from './createServer.js';
+import type {HalServerOptions} from './createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {answeringOrchestrator, deferred} from './wsTestSupport.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {ChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import type {MessageChunk} from '../types/ai.js';
+import {ErrorCodes} from '../types/messages.js';
+import type {SessionEntry} from '../types/session.js';
+import type {SessionListOptions, SessionStore} from '../types/sessionStore.js';
+import {setLogger} from '../shared/logger.js';
+
+interface SummaryRow {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+
+interface Frame {
+  type: string;
+  sessionId?: string;
+  resumed?: boolean;
+  entryCount?: number;
+  code?: string;
+  message?: string;
+  conversations?: SummaryRow[];
+  index?: number;
+  entry?: SessionEntry;
+}
+
+const servers: Array<ReturnType<typeof createServer>> = [];
+const clients: WebSocket[] = [];
+
+const eventually = async (check: () => boolean): Promise<void> => {
+  for (let attempt = 0; attempt < 50 && !check(); attempt++) await new Promise(resolve => setTimeout(resolve, 10));
+};
+
+beforeAll(() => {
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined});
+});
+
+afterAll(() => {
+  setLogger();
+});
+
+afterEach(async () => {
+  for (const client of clients.splice(0)) client.terminate();
+  for (const hal of servers.splice(0)) {
+    const {wss} = hal;
+    await eventually(() => wss.clients.size === 0);
+    await hal.stop();
+  }
+});
+
+const startServer = async (
+  sessionStore: SessionStore,
+  extra: Record<string, unknown> = {},
+  orchestrator: ChatOrchestrator = answeringOrchestrator
+) => {
+  const auth = {userId: 'u1'};
+  const options: HalServerOptions = {
+    app: (() => undefined) as unknown as Express,
+    wsAuth: async () => ({id: auth.userId}),
+    sessionStore,
+    orchestrator,
+    ...extra,
+  };
+  const hal = createServer(options);
+  await hal.start(0);
+  servers.push(hal);
+  const {port} = hal.server.address() as AddressInfo;
+  return {auth, base: `ws://127.0.0.1:${port}/hal/ws`};
+};
+
+const openConnected = async (url: string): Promise<{client: WebSocket; connected: Frame}> => {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 't']);
+  clients.push(client);
+  const [raw] = (await once(client, 'message')) as [Buffer];
+  return {client, connected: JSON.parse(String(raw)) as Frame};
+};
+
+const nextFrame = async (client: WebSocket): Promise<Frame> => {
+  const [raw] = (await once(client, 'message')) as [Buffer];
+  return JSON.parse(String(raw)) as Frame;
+};
+
+describe('delivering a conversation list over the websocket', () => {
+  it("lists the connecting user's conversations newest first as ISO summaries, forwards the cursor, and resumes a chosen row", async () => {
+    const inner = new InMemorySessionStore();
+    for (const [id, sentAt] of [
+      ['s1', '2026-09-30T08:00:00.000Z'],
+      ['s2', '2026-09-30T09:00:00.000Z'],
+      ['s3', '2026-09-30T10:00:00.000Z'],
+    ] as const) {
+      const {entries} = inner.create(id, 'u1');
+      entries.push({role: 'user', content: `msg-${id}`, timestamp: sentAt});
+    }
+    inner.create('theirs', 'u2').entries.push({role: 'user', content: 'secret', timestamp: '2026-09-30T11:00:00.000Z'});
+
+    const calls: Array<{userId: string | number; options?: SessionListOptions}> = [];
+    const store: SessionStore = {
+      create: (id, userId, opts) => inner.create(id, userId, opts),
+      get: id => inner.get(id),
+      delete: id => inner.delete(id),
+      count: () => inner.count(),
+      clear: () => inner.clear(),
+      listFor: (userId, options) => {
+        calls.push({userId, options});
+        return inner.listFor(userId, options);
+      },
+    };
+
+    const {base} = await startServer(store, {resume: {enabled: true}, history: {enabled: true}});
+    const {client, connected} = await openConnected(base);
+
+    const cursor = {updatedAt: '2026-09-30T10:00:00.000Z', sessionId: 's3'};
+    client.send(JSON.stringify({type: 'list_conversations', userId: 'u2'}));
+    const fullList = await nextFrame(client);
+
+    client.send(JSON.stringify({type: 'list_conversations', limit: 2, before: cursor}));
+    const pagedList = await nextFrame(client);
+
+    const chosenId = pagedList.conversations?.[0]?.sessionId ?? 'missing';
+    const resumedClient = new WebSocket(`${base}?sessionId=${chosenId}`, [HAL_WS_SUBPROTOCOL, 't']);
+    clients.push(resumedClient);
+    const resumedFrames: Frame[] = [];
+    await new Promise<void>(resolve => {
+      resumedClient.on('message', raw => {
+        const frame = JSON.parse(String(raw)) as Frame;
+        resumedFrames.push(frame);
+        if (frame.type === 'connected') resumedClient.send(JSON.stringify({type: 'ping', timestamp: 1}));
+        if (frame.type === 'pong') resolve();
+      });
+    });
+
+    const rows = fullList.conversations ?? [];
+    const isoTimes = rows.every(
+      row => !Number.isNaN(Date.parse(row.createdAt)) && !Number.isNaN(Date.parse(row.updatedAt))
+    );
+    expect({
+      type: fullList.type,
+      ids: rows.map(row => row.sessionId),
+      isoTimes,
+      calls,
+      pagedIds: (pagedList.conversations ?? []).map(row => row.sessionId),
+      resumed: {resumed: resumedFrames[0].resumed, replayed: resumedFrames[1]?.entry},
+    }).toEqual({
+      type: 'conversation_list',
+      ids: ['s3', 's2', 's1', connected.sessionId],
+      isoTimes: true,
+      calls: [
+        {userId: 'u1', options: {limit: undefined, before: undefined}},
+        {userId: 'u1', options: {limit: 2, before: cursor}},
+      ],
+      pagedIds: ['s2', 's1'],
+      resumed: {
+        resumed: true,
+        replayed: {role: 'user', content: 'msg-s2', timestamp: '2026-09-30T09:00:00.000Z'},
+      },
+    });
+  });
+
+  it('refuses a list with UNSUPPORTED when history is off or the store lacks listFor, INVALID_MESSAGE on bad bounds, and SERVER_ERROR when the store rejects', async () => {
+    const inner = new InMemorySessionStore();
+    const {base: offBase} = await startServer(inner);
+    const {client: offClient} = await openConnected(offBase);
+    offClient.send(JSON.stringify({type: 'list_conversations'}));
+    const whenOff = await nextFrame(offClient);
+
+    const noListStore: SessionStore = {
+      create: (id, userId, opts) => inner.create(id, userId, opts),
+      get: id => inner.get(id),
+      delete: id => inner.delete(id),
+      count: () => inner.count(),
+      clear: () => inner.clear(),
+    };
+    const {base: noListBase} = await startServer(noListStore, {history: {enabled: true}});
+    const {client: noListClient} = await openConnected(noListBase);
+    noListClient.send(JSON.stringify({type: 'list_conversations'}));
+    const whenUnimplemented = await nextFrame(noListClient);
+
+    noListClient.send(JSON.stringify({type: 'list_conversations', limit: 0}));
+    const badLimit = await nextFrame(noListClient);
+
+    const failingStore: SessionStore = {
+      ...noListStore,
+      listFor: async () => {
+        throw new Error('secret database password');
+      },
+    };
+    const {base: failBase} = await startServer(failingStore, {history: {enabled: true}});
+    const {client: failClient} = await openConnected(failBase);
+    failClient.send(JSON.stringify({type: 'list_conversations'}));
+    const whenRejected = await nextFrame(failClient);
+
+    const unsupportedCode = (ErrorCodes as Record<string, string>).UNSUPPORTED ?? 'UNSUPPORTED';
+    expect({
+      whenOff: {type: whenOff.type, code: whenOff.code},
+      whenUnimplemented: {type: whenUnimplemented.type, code: whenUnimplemented.code},
+      badLimit: {
+        type: badLimit.type,
+        code: badLimit.code,
+        namesField: badLimit.message?.includes('limit') ?? false,
+      },
+      whenRejected: {
+        type: whenRejected.type,
+        code: whenRejected.code,
+        leaked: whenRejected.message?.includes('secret') ?? true,
+      },
+    }).toEqual({
+      whenOff: {type: 'error', code: unsupportedCode},
+      whenUnimplemented: {type: 'error', code: unsupportedCode},
+      badLimit: {type: 'error', code: ErrorCodes.INVALID_MESSAGE, namesField: true},
+      whenRejected: {type: 'error', code: ErrorCodes.SERVER_ERROR, leaked: false},
+    });
+  });
+
+  it('answers list_conversations while a user_message is streaming, without waiting on the session lock', async () => {
+    const gate = deferred();
+    const holdStream: ChatOrchestrator = {
+      processMessage: async () => 'done',
+      async *processMessageStream(): AsyncGenerator<MessageChunk> {
+        yield {type: 'text', text: 'first chunk'};
+        await gate.until;
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+    };
+    const store = new InMemorySessionStore();
+    const {base} = await startServer(store, {history: {enabled: true}}, holdStream);
+    const {client} = await openConnected(base);
+
+    const seen: string[] = [];
+    const done = new Promise<void>(resolve => {
+      client.on('message', raw => {
+        const frame = JSON.parse(String(raw)) as Frame;
+        seen.push(frame.type);
+        if (frame.type === 'entry_delta') {
+          client.send(JSON.stringify({type: 'list_conversations'}));
+        }
+        if (frame.type === 'conversation_list' || frame.type === 'error') {
+          gate.release();
+        }
+        if (frame.type === 'stream_end') resolve();
+      });
+    });
+
+    client.send(JSON.stringify({type: 'user_message', content: 'start turn'}));
+    await done;
+
+    const listIndex = seen.indexOf('conversation_list');
+    const endIndex = seen.indexOf('stream_end');
+    expect({listed: listIndex !== -1, beforeStreamEnd: listIndex < endIndex}).toEqual({
+      listed: true,
+      beforeStreamEnd: true,
+    });
+  });
+});