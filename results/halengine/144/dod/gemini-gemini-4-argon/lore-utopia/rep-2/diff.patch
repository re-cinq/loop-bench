+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,267 @@
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import type {Express} from 'express';
+import {createServer} from './createServer.js';
+import type {HalServerOptions} from './createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+import {answeringOrchestrator} from './wsTestSupport.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {ChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import type {MessageChunk} from '../types/ai.js';
+import type {SessionEntry} from '../types/session.js';
+import type {SessionListOptions, SessionStore} from '../types/sessionStore.js';
+import {setLogger} from '../shared/logger.js';
+
+interface WireSummary {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+
+interface WireFrame {
+  type: string;
+  sessionId?: string;
+  resumed?: boolean;
+  entryCount?: number;
+  conversations?: WireSummary[];
+  code?: string;
+  message?: string;
+  index?: number;
+  entry?: SessionEntry;
+}
+
+const servers: Array<ReturnType<typeof createServer>> = [];
+const clients: WebSocket[] = [];
+
+const eventually = async (check: () => boolean): Promise<void> => {
+  for (let attempt = 0; attempt < 50 && !check(); attempt++) await new Promise(resolve => setTimeout(resolve, 10));
+};
+
+beforeAll(() => {
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined});
+});
+
+afterAll(() => {
+  setLogger();
+});
+
+afterEach(async () => {
+  for (const client of clients.splice(0)) client.terminate();
+  for (const hal of servers.splice(0)) {
+    const {wss} = hal;
+    await eventually(() => wss.clients.size === 0);
+    await hal.stop();
+  }
+});
+
+const startServer = async (
+  store: SessionStore,
+  extra: Record<string, unknown> = {},
+  orchestrator: ChatOrchestrator = answeringOrchestrator
+): Promise<{base: string; auth: {userId: string}}> => {
+  const auth = {userId: 'u1'};
+  const options = {
+    app: (() => undefined) as unknown as Express,
+    wsAuth: async () => ({id: auth.userId}),
+    sessionStore: store,
+    orchestrator,
+    ...extra,
+  } as unknown as HalServerOptions;
+  const hal = createServer(options);
+  await hal.start(0);
+  servers.push(hal);
+  const {port} = hal.server.address() as AddressInfo;
+  return {base: `ws://127.0.0.1:${port}/hal/ws`, auth};
+};
+
+const openSocket = (url: string, token = 't'): WebSocket => {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, token]);
+  clients.push(client);
+  return client;
+};
+
+const sendAndSettle = async (url: string, payload: Record<string, unknown>): Promise<WireFrame[]> => {
+  const client = openSocket(url);
+  const frames: WireFrame[] = [];
+  await new Promise<void>(resolve => {
+    client.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as WireFrame;
+      frames.push(frame);
+      if (frame.type === 'connected') {
+        client.send(JSON.stringify(payload));
+        client.send(JSON.stringify({type: 'ping', timestamp: 1}));
+      }
+      if (frame.type === 'pong') resolve();
+    });
+  });
+  return frames;
+};
+
+describe('conversation list over the WebSocket protocol', () => {
+  it('validates list_conversations and rejects out-of-range limits or malformed cursors by field name', () => {
+    const validCursor = {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: 's1'};
+    const validEmpty = validateMessage({type: 'list_conversations'});
+    const validWithArgs = validateMessage({
+      type: 'list_conversations',
+      limit: 25,
+      before: validCursor,
+      userId: 'stranger',
+    });
+    const invalidLimits = [0, 201, 1.5, '10'].map(limit => validateMessage({type: 'list_conversations', limit}));
+    const invalidBefores = [
+      'not a date',
+      {updatedAt: 'not a date', sessionId: 's1'},
+      {updatedAt: validCursor.updatedAt},
+    ].map(before => validateMessage({type: 'list_conversations', before}));
+
+    expect({
+      validEmpty,
+      validWithArgs,
+      limitsValid: invalidLimits.some(res => res.valid),
+      limitsMentionField: invalidLimits.every(res => !res.valid && res.error.includes('limit')),
+      beforesValid: invalidBefores.some(res => res.valid),
+      beforesMentionField: invalidBefores.every(res => !res.valid && res.error.includes('before')),
+    }).toEqual({
+      validEmpty: {valid: true, data: {type: 'list_conversations'}},
+      validWithArgs: {valid: true, data: {type: 'list_conversations', limit: 25, before: validCursor}},
+      limitsValid: false,
+      limitsMentionField: true,
+      beforesValid: false,
+      beforesMentionField: true,
+    });
+  });
+
+  it("answers list_conversations with the authenticated user's summaries newest first, forwards limit and before, and resumes a picked session", async () => {
+    const inner = new InMemorySessionStore();
+    inner.create('s1', 'u1').entries.push({role: 'user', content: 'first', timestamp: '2026-01-01T00:01:00.000Z'});
+    inner.create('s2', 'u1').entries.push({role: 'user', content: 'second', timestamp: '2026-01-01T00:02:00.000Z'});
+    inner.create('theirs', 'u2').entries.push({role: 'user', content: 'other', timestamp: '2026-01-01T00:03:00.000Z'});
+    const recordedCalls: Array<{userId: string | number; options?: SessionListOptions}> = [];
+    const store: SessionStore = {
+      create: (id, userId, opts) => inner.create(id, userId, opts),
+      get: id => inner.get(id),
+      lookup: id => inner.lookup(id),
+      delete: id => inner.delete(id),
+      count: () => inner.count(),
+      clear: () => inner.clear(),
+      listFor: (userId, options) => {
+        recordedCalls.push({userId, options});
+        return inner.listFor(userId, options);
+      },
+    };
+    const {base} = await startServer(store, {history: {enabled: true}, resume: {enabled: true}});
+
+    const cursor = {updatedAt: '2026-01-01T00:05:00.000Z', sessionId: 's9'};
+    const frames = await sendAndSettle(base, {
+      type: 'list_conversations',
+      limit: 10,
+      before: cursor,
+      userId: 'u2',
+    });
+    const listFrame = frames.find(frame => frame.type === 'conversation_list');
+    const summaries = listFrame?.conversations ?? [];
+    const resumedFrames = await sendAndSettle(`${base}?sessionId=s1`, {type: 'ping', timestamp: 2});
+
+    expect({
+      frameTypes: frames.map(frame => frame.type),
+      calledWith: recordedCalls,
