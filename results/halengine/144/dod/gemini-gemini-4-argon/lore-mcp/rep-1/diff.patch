diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..1a81e8f
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,260 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import type {Express} from 'express';
+import {createServer} from './createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {answeringOrchestrator, deferred} from './wsTestSupport.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {ChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import type {MessageChunk} from '../types/ai.js';
+import type {SessionStore} from '../types/sessionStore.js';
+import {setLogger} from '../shared/logger.js';
+
+interface WireSummary {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+
+interface WireFrame {
+  type: string;
+  conversations?: WireSummary[];
+  code?: string;
+  message?: string;
+  timestamp?: number;
+}
+
+const servers: Array<ReturnType<typeof createServer>> = [];
+const clients: WebSocket[] = [];
+
+const eventually = async (check: () => boolean): Promise<void> => {
+  for (let attempt = 0; attempt < 50 && !check(); attempt++) await new Promise(resolve => setTimeout(resolve, 10));
+};
+
+beforeAll(() => {
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined});
+});
+
+afterAll(() => {
+  setLogger();
+});
+
+afterEach(async () => {
+  for (const client of clients.splice(0)) client.terminate();
+  for (const hal of servers.splice(0)) {
+    const {wss} = hal;
+    await eventually(() => wss.clients.size === 0);
+    await hal.stop();
+  }
+});
+
+const startServer = async (
+  sessionStore: SessionStore,
+  userId: string | number = 'u1',
+  orchestrator: ChatOrchestrator = answeringOrchestrator
+) => {
+  const hal = createServer({
+    app: (() => undefined) as unknown as Express,
+    wsAuth: async () => ({id: userId}),
+    sessionStore,
+    orchestrator,
+  });
+  await hal.start(0);
+  servers.push(hal);
+  const {port} = hal.server.address() as AddressInfo;
+  return `ws://127.0.0.1:${port}/hal/ws`;
+};
+
+const openReadySocket = async (url: string): Promise<WebSocket> => {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 't']);
+  clients.push(client);
+  await once(client, 'message');
+  return client;
+};
+
+const sendAndCollectUntilPong = async (client: WebSocket, payload: unknown): Promise<WireFrame[]> => {
+  const frames: WireFrame[] = [];
+  await new Promise<void>(resolve => {
+    const onMessage = (raw: Buffer | string) => {
+      const frame = JSON.parse(String(raw)) as WireFrame;
+      frames.push(frame);
+      if (frame.type === 'pong') {
+        client.off('message', onMessage);
+        resolve();
+      }
+    };
+    client.on('message', onMessage);
+    client.send(JSON.stringify(payload));
+    client.send(JSON.stringify({type: 'ping', timestamp: 1}));
+  });
+  return frames.filter(frame => frame.type !== 'pong');
+};
+
+const storeWithHistory = (): InMemorySessionStore => {
+  const store = new InMemorySessionStore();
+  const c1 = store.create('c1', 'u1');
+  c1.entries.push({role: 'user', content: 'first', timestamp: '2026-09-30T08:00:00.000Z'});
+  const c2 = store.create('c2', 'u1');
+  c2.entries.push(
+    {role: 'user', content: 'second', timestamp: '2026-09-30T09:00:00.000Z'},
+    {role: 'assistant', content: 'reply', timestamp: '2026-09-30T09:00:01.000Z', isStreaming: false}
+  );
+  const c3 = store.create('c3', 'u1');
+  c3.entries.push({role: 'user', content: 'third', timestamp: '2026-09-30T10:00:00.000Z'});
+  const other = store.create('other', 'u2');
+  other.entries.push({role: 'user', content: 'stranger', timestamp: '2026-09-30T11:00:00.000Z'});
+  return store;
+};
+
+const fiveMemberStore = (inner: InMemorySessionStore): SessionStore => ({
+  create: (sessionId, userId, options) => inner.create(sessionId, userId, options),
+  get: sessionId => inner.get(sessionId),
+  delete: sessionId => inner.delete(sessionId),
+  count: () => inner.count(),
+  clear: () => inner.clear(),
+});
+
+describe('conversation_list over WebSocket', () => {
+  it('delivers the authenticated user conversation_list newest-first, supports limit and before paging, and answers an empty array when the user has none', async () => {
+    const store = storeWithHistory();
+    const url = await startServer(store, 'u1');
+    const client = await openReadySocket(url);
+
+    const firstPage = await sendAndCollectUntilPong(client, {
+      type: 'conversation_list',
+      limit: 2,
+      before: {updatedAt: '2026-09-30T10:00:00.000Z', sessionId: 'c3'},
+    });
+    const zeroPage = await sendAndCollectUntilPong(client, {type: 'conversation_list', limit: 0});
+
+    const emptyStore = new InMemorySessionStore();
+    const emptyUrl = await startServer(emptyStore, 'u9');
+    const emptyClient = await openReadySocket(emptyUrl);
+    emptyStore.clear();
+    const nonePage = await sendAndCollectUntilPong(emptyClient, {type: 'conversation_list'});
+
+    expect({
+      firstPage,
+      zeroPage,
+      nonePage,
+    }).toEqual({
+      firstPage: [
+        {
+          type: 'conversation_list',
+          conversations: [
+            {
+              sessionId: 'c2',
+              createdAt: expect.stringMatching(/^\d{4}-\d{2}-\d{2}T/),
+              updatedAt: '2026-09-30T09:00:01.000Z',
+              entryCount: 2,
+            },
+            {
+              sessionId: 'c1',
+              createdAt: expect.stringMatching(/^\d{4}-\d{2}-\d{2}T/),
+              updatedAt: '2026-09-30T08:00:00.000Z',
+              entryCount: 1,
+            },
+          ],
+        },
+      ],
+      zeroPage: [{type: 'conversation_list', conversations: []}],
+      nonePage: [{type: 'conversation_list', conversations: []}],
+    });
+  });
+
+  it('answers conversation_list immediately while a turn is streaming on the same session without waiting for the per-session lock', async () => {
+    const gate = deferred();
+    const store = storeWithHistory();
+    const slowOrchestrator: ChatOrchestrator = {
+      processMessage: async () => 'slow',
+      async *processMessageStream(): AsyncGenerator<MessageChunk> {
+        yield {type: 'text', text: 'thinking...'};
+        await gate.until;
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+    };
+    const url = await startServer(store, 'u1', slowOrchestrator);
+    const client = await openReadySocket(url);
+
+    const seenBeforeRelease: string[] = [];
+    const deltaSeen = new Promise<void>(resolve => {
+      const onMessage = (raw: Buffer | string) => {
