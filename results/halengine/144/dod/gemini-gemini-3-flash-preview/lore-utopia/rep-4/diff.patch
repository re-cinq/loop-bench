diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..0e5b013
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,150 @@
+import {jest} from '@jest/globals';
+import {WebSocket} from 'ws';
+import {createMessageHandler} from './ws/messageHandler.js';
+import type {ChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import type {ChatSession} from '../types/session.js';
+import type {OutgoingMessage} from '../types/messages.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {deferred} from './wsTestSupport.js';
+
+// specs/hal-engine-websocket-protocol/spec.md#4.3
+// specs/hal-engine-websocket-protocol/spec.md#5.9
+// specs/hal-engine-conversation-list/spec.md
+
+const wire = (sent: OutgoingMessage[]): string[] =>
+  sent.map(frame => {
+    if (frame.type === 'conversation_list') {
+      return `conversation_list ${frame.conversations.length} summaries`;
+    }
+    if (frame.type === 'error') return `error ${frame.code}`;
+    return frame.type;
+  });
+
+const harness = (options: any = {}) => {
+  const sent: OutgoingMessage[] = [];
+  const ws = {
+    send: (raw: string) => sent.push(JSON.parse(raw) as OutgoingMessage),
+    readyState: WebSocket.OPEN,
+    userId: 'u1',
+  } as unknown as WebSocket & {userId: string};
+
+  const orchestrator = {
+    processMessageStream: async function* () {
+      yield {type: 'text', text: 'hi'};
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+  } as unknown as ChatOrchestrator;
+
+  const sessionStore = options.sessionStore ?? new InMemorySessionStore();
+  const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+
+  // createMessageHandler is expected to be updated to take sessionStore and options
+  const handle = (createMessageHandler as any)(orchestrator, sessionStore, options.config);
+
+  return {
+    ws,
+    session,
+    sessionStore,
+    sent,
+    frames: () => wire(sent),
+    send: (raw: unknown) => handle(ws, session, raw),
+  };
+};
+
+describe('Conversation list acceptance tests', () => {
+  it("answers the user's conversations newest first (specs/hal-engine-websocket-protocol/spec.md#5.9)", async () => {
+    const store = new InMemorySessionStore();
+    store.create('s1', 'u1');
+    store.create('s2', 'u1');
+    store.create('s3', 'u1');
+
+    const h = harness({
+      sessionStore: store,
+      config: {history: {enabled: true}},
+    });
+
+    await h.send({type: 'list_conversations'});
+
+    expect(h.frames()).toEqual(['conversation_list 3 summaries']);
+    const listFrame = h.sent[0] as any;
+    expect(listFrame.conversations[0].sessionId).toBe('s3');
+    expect(typeof listFrame.conversations[0].createdAt).toBe('string');
+    expect(typeof listFrame.conversations[0].updatedAt).toBe('string');
+    expect(h.frames()).not.toContain('stream_end');
+  });
+
+  it("answers the connecting user's own conversations even when the frame names another user (specs/hal-engine-websocket-protocol/spec.md#4.3)", async () => {
+    const store = new InMemorySessionStore();
+    store.create('s1', 'u1');
+    const listForSpy = jest.spyOn(store, 'listFor');
+
+    const h = harness({
+      sessionStore: store,
+      config: {history: {enabled: true}},
+    });
+
+    await h.send({type: 'list_conversations', userId: 'another-user'});
+
+    expect(h.frames()).toEqual(['conversation_list 1 summaries']);
+    expect(listForSpy).toHaveBeenCalledWith('u1', expect.anything());
+  });
+
+  it('refuses the frame when history is disabled (specs/hal-engine-conversation-list/spec.md)', async () => {
+    const h = harness({
+      config: {history: {enabled: false}},
+    });
+
+    await h.send({type: 'list_conversations'});
+
+    expect(h.frames()).toEqual(['error UNSUPPORTED']);
+  });
+
+  it('answers UNSUPPORTED when the store cannot list (specs/hal-engine-conversation-list/spec.md)', async () => {
+    const store = {
+      // listFor is missing
+      get: jest.fn(),
+      create: jest.fn(),
+    };
+
+    const h = harness({
+      sessionStore: store,
+      config: {history: {enabled: true}},
+    });
+
+    await h.send({type: 'list_conversations'});
+
+    expect(h.frames()).toEqual(['error UNSUPPORTED']);
+  });
+
+  it('answers a list in the middle of a streaming turn, before that turn ends (specs/hal-engine-websocket-protocol/spec.md#5.9)', async () => {
+    const {until, release} = deferred();
+
+    const orchestrator = {
+      processMessageStream: async function* () {
+        yield {type: 'text', text: 'hi'};
+        await until;
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+    } as unknown as ChatOrchestrator;
+
+    const h = harness({
+      config: {history: {enabled: true}},
+    });
+    (h as any).orchestrator = orchestrator; // bit of a hack since harness creates its own
+
+    // Re-create handle with the slow orchestrator
+    const handle = (createMessageHandler as any)(orchestrator, h.sessionStore, {history: {enabled: true}});
+
+    const turn = handle(h.ws, h.session, {type: 'user_message', content: 'hello'});
+
+    // While the turn is running, ask for the list
+    await handle(h.ws, h.session, {type: 'list_conversations'});
+
+    expect(h.frames()).toContain('conversation_list 0 summaries');
+    expect(h.frames()).not.toContain('stream_end');
+
+    release();
+    await turn;
+    expect(h.frames()).toContain('stream_end');
+  });
+});