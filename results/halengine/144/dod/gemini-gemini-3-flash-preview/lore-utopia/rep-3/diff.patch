index 0000000..2028c29
--- /dev/null
+++ b/src/transport/ws/conversationList.acceptance.test.ts
@@ -0,0 +1,205 @@
+import {jest} from '@jest/globals';
+import {WebSocket} from 'ws';
+import {createMessageHandler} from './messageHandler.js';
+import type {ChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import type {ChatSession} from '../../types/session.js';
+import type {SessionStore, SessionSummary} from '../../types/sessionStore.js';
+import type {OutgoingMessage, IncomingMessage} from '../../types/messages.js';
+
+describe('conversation list (acceptance)', () => {
+  const orchestrator = {} as unknown as ChatOrchestrator;
+  const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+
+  const setup = (historyConfig?: {enabled: boolean}, store?: Partial<SessionStore>) => {
+    const sent: OutgoingMessage[] = [];
+    const ws = {
+      send: (raw: string) => sent.push(JSON.parse(raw) as OutgoingMessage),
+      readyState: WebSocket.OPEN,
+    } as unknown as WebSocket;
+
+    // createMessageHandler signature will need to change to accept store and config
+    // @ts-expect-error - implementing the new signature before it exists
+    const handle = createMessageHandler(orchestrator, store as SessionStore, historyConfig);
+
+    return {
+      ws,
+      sent,
+      handle: (msg: unknown) => handle(ws, session, msg),
+    };
+  };
+
+  it('Protocol: types and validation - accepts valid list_conversations', async () => {
+    const h = setup({enabled: true}, {listFor: async () => []});
+    await h.handle({type: 'list_conversations', limit: 10});
+
+    const errorFrame = h.sent.find(f => f.type === 'error');
+    expect(errorFrame).toBeUndefined();
+  });
+
+  it('Protocol: types and validation - rejects invalid limit (0)', async () => {
+    const h = setup({enabled: true});
+    await h.handle({type: 'list_conversations', limit: 0});
+
+    expect(h.sent).toContainEqual(
+      expect.objectContaining({
+        type: 'error',
+        code: 'INVALID_MESSAGE',
+        message: expect.stringContaining('limit'),
+      })
+    );
+  });
+
+  it('Protocol: types and validation - rejects invalid limit (201)', async () => {
+    const h = setup({enabled: true});
+    await h.handle({type: 'list_conversations', limit: 201});
+
+    expect(h.sent).toContainEqual(
+      expect.objectContaining({
+        type: 'error',
+        code: 'INVALID_MESSAGE',
+        message: expect.stringContaining('limit'),
+      })
+    );
+  });
+
+  it('Protocol: types and validation - rejects malformed cursor (missing sessionId)', async () => {
+    const h = setup({enabled: true});
+    await h.handle({type: 'list_conversations', before: {updatedAt: '2023-01-01T00:00:00Z'}});
+
+    expect(h.sent).toContainEqual(
+      expect.objectContaining({
+        type: 'error',
+        code: 'INVALID_MESSAGE',
+        message: expect.stringContaining('before'),
+      })
+    );
+  });
+
+  it('Handler: delivers conversation list - returns summaries with ISO strings', async () => {
+    const now = new Date('2023-10-27T10:00:00Z');
+    const summaries: SessionSummary[] = [{sessionId: 's1', createdAt: now, updatedAt: now, entryCount: 5}];
+    const listFor = jest.fn(async () => summaries);
+    const h = setup({enabled: true}, {listFor});
+
+    await h.handle({type: 'list_conversations'});
+
+    expect(listFor).toHaveBeenCalledWith('u1', expect.anything());
+    expect(h.sent).toContainEqual({
+      type: 'conversation_list',
+      conversations: [
+        {
+          sessionId: 's1',
+          createdAt: '2023-10-27T10:00:00.000Z',
+          updatedAt: '2023-10-27T10:00:00.000Z',
+          entryCount: 5,
+        },
+      ],
+    });
+  });
+
+  it('Handler: respects authentication - uses ws.userId, not frame userId', async () => {
+    const listFor = jest.fn(async () => []);
+    const h = setup({enabled: true}, {listFor});
+
+    await h.handle({type: 'list_conversations', userId: 'other-user'});
+
+    expect(listFor).toHaveBeenCalledWith('u1', expect.anything());
+  });
+
+  it('Handler: opt-in - returns UNSUPPORTED when history is disabled', async () => {
+    const h = setup({enabled: false}, {listFor: async () => []});
+    await h.handle({type: 'list_conversations'});
+
+    expect(h.sent).toContainEqual(
+      expect.objectContaining({
+        type: 'error',
+        code: 'UNSUPPORTED',
+      })
+    );
+  });
+
+  it('Handler: unsupported store - returns UNSUPPORTED when store lacks listFor', async () => {
+    const h = setup({enabled: true}, {}); // No listFor
+    await h.handle({type: 'list_conversations'});
+
+    expect(h.sent).toContainEqual(
+      expect.objectContaining({
+        type: 'error',
+        code: 'UNSUPPORTED',
+      })
+    );
+  });
+
+  it('Handler: non-blocking - answers list_conversations while user_message is streaming', async () => {
+    const sent: OutgoingMessage[] = [];
+    const ws = {
+      send: (raw: string) => sent.push(JSON.parse(raw) as OutgoingMessage),
+      readyState: WebSocket.OPEN,
+    } as unknown as WebSocket;
+
+    const listFor = jest.fn(async () => []);
+
+    // We need a real orchestrator that we can pause
+    let resolveStream: () => void;
+    const streamStarted = new Promise<void>(resolve => {
+      resolveStream = resolve;
+    });
+    const streamFinished = new Promise<void>(resolve => {
+      /* never resolves */
+    });
+
+    const mockOrchestrator = {
+      processMessageStream: async function* () {
+        resolveStream();
+        await streamFinished;
+        yield {type: 'text', text: 'hi'};
+      },
+    } as unknown as ChatOrchestrator;
+
+    // @ts-expect-error
+    const handle = createMessageHandler(mockOrchestrator, {listFor} as SessionStore, {enabled: true});
+
+    const userMessagePromise = handle(ws, session, {type: 'user_message', content: 'hello'});
+    await streamStarted;
+
+    // While user_message is "streaming" (paused), send list_conversations
+    await handle(ws, session, {type: 'list_conversations'});
+
+    expect(sent.some(f => f.type === 'conversation_list')).toBe(true);
+    // User message should still be pending
+    const upsertFrame = sent.find(f => f.type === 'entry_upsert');
+    expect(upsertFrame).toBeDefined();
+    const stream_endFrame = sent.find(f => f.type === 'stream_end');
+    expect(stream_endFrame).toBeUndefined();
+  });
+
+  it('Integration: session resume - reconnecting with an id from the list receives resumed: true and replay', async () => {
+    // This is an integration test of the #45 path, using the output of list_conversations.
+    // Since we write no production code, we rely on the existing server setup if possible,
+    // or we describe it as the ticket does: "the test exercises the existing #45 path end to end".
+    // In this pod, we can't easily start a full server, so we pin the protocol expectation.
+    // The ticket says: "A client that takes an id from a conversation_list and reconnects with ?sessionId=<id>
+    // receives resumed: true and that conversation's replay, with no new transport code"
