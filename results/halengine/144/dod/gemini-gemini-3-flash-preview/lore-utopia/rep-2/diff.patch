+import {jest} from '@jest/globals';
+import {WebSocket} from 'ws';
+import {validateMessage} from './validation.js';
+import {createMessageHandler} from './messageHandler.js';
+import type {ChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import type {ChatSession} from '../../types/session.js';
+import type {SessionStore} from '../../types/sessionStore.js';
+import {ErrorCodes} from '../../types/messages.js';
+
+describe('Conversation List Acceptance Tests', () => {
+  describe('Validation', () => {
+    it('accepts list_conversations and returns the typed frame', () => {
+      const result = validateMessage({type: 'list_conversations'});
+
+      expect(result).toEqual({
+        valid: true,
+        data: {type: 'list_conversations'},
+      });
+    });
+
+    it('accepts list_conversations with limit and before cursor', () => {
+      const result = validateMessage({
+        type: 'list_conversations',
+        limit: 10,
+        before: {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: 's1'},
+      });
+
+      expect(result).toEqual({
+        valid: true,
+        data: {
+          type: 'list_conversations',
+          limit: 10,
+          before: {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: 's1'},
+        },
+      });
+    });
+
+    it('rejects list_conversations with invalid limit', () => {
+      const result = validateMessage({type: 'list_conversations', limit: 0});
+      expect(result.valid).toBe(false);
+      expect((result as any).error).toContain('limit');
+
+      const result2 = validateMessage({type: 'list_conversations', limit: 201});
+      expect(result2.valid).toBe(false);
+      expect((result2 as any).error).toContain('limit');
+
+      const result3 = validateMessage({type: 'list_conversations', limit: 1.5});
+      expect(result3.valid).toBe(false);
+      expect((result3 as any).error).toContain('limit');
+    });
+
+    it('rejects list_conversations with invalid before cursor', () => {
+      const result = validateMessage({type: 'list_conversations', before: 'not-a-cursor'});
+      expect(result.valid).toBe(false);
+      expect((result as any).error).toContain('before');
+
+      const result2 = validateMessage({type: 'list_conversations', before: {updatedAt: '2026-01-01'}});
+      expect(result2.valid).toBe(false);
+      expect((result2 as any).error).toContain('before');
+    });
+  });
+
+  describe('Handling', () => {
+    const orchestrator = {
+      processMessageStream: jest.fn(),
+    } as unknown as ChatOrchestrator;
+
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [],
+    };
+
+    function setup(options: any = {}) {
+      const sent: any[] = [];
+      const ws = {
+        send: (raw: string) => sent.push(JSON.parse(raw)),
+        readyState: WebSocket.OPEN,
+        userId: 'u1', // The connecting user's ID
+      } as unknown as WebSocket & {userId: string};
+
+      const store = {
+        listFor: jest.fn(),
+      } as unknown as SessionStore;
+
+      // Passing store and config to createMessageHandler as per ticket
+      const handle = (createMessageHandler as any)(orchestrator, store, options);
+
+      return {ws, store, sent, handle};
+    }
+
+    it('answers list_conversations with conversation_list when enabled', async () => {
+      const {ws, store, sent, handle} = setup({history: {enabled: true}});
+      const now = new Date();
+      store.listFor = jest
+        .fn()
+        .mockResolvedValue([{sessionId: 's1', createdAt: now, updatedAt: now, entryCount: 5}]) as any;
+
+      await handle(ws, session, {type: 'list_conversations'});
+
+      expect(sent).toContainEqual({
+        type: 'conversation_list',
+        conversations: [
+          {
+            sessionId: 's1',
+            createdAt: now.toISOString(),
+            updatedAt: now.toISOString(),
+            entryCount: 5,
+          },
+        ],
+      });
+    });
+
+    it('answers UNSUPPORTED when history is disabled', async () => {
+      const {ws, handle, sent} = setup({history: {enabled: false}});
+
+      await handle(ws, session, {type: 'list_conversations'});
+
+      expect(sent).toContainEqual({
+        type: 'error',
+        code: 'UNSUPPORTED',
+        message: expect.any(String),
+      });
+    });
+
+    it('uses ws.userId and ignores frame userId', async () => {
+      const {ws, store, handle} = setup({history: {enabled: true}});
+      (ws as any).userId = 'real-user';
+      store.listFor = jest.fn().mockResolvedValue([]) as any;
+
+      await handle(ws, session, {type: 'list_conversations', userId: 'evil-user'});
+
+      expect(store.listFor).toHaveBeenCalledWith('real-user', expect.anything());
+    });
+
+    it('answers UNSUPPORTED if store does not implement listFor', async () => {
+      const {ws, handle, sent} = setup({history: {enabled: true}});
+      const storeWithoutList = {} as any;
+      const handleNoList = (createMessageHandler as any)(orchestrator, storeWithoutList, {history: {enabled: true}});
+
+      await handleNoList(ws, session, {type: 'list_conversations'});
+
+      expect(sent).toContainEqual({
+        type: 'error',
+        code: 'UNSUPPORTED',
+        message: expect.any(String),
+      });
+    });
+
+    it('answers SERVER_ERROR when listFor fails', async () => {
+      const {ws, store, handle, sent} = setup({history: {enabled: true}});
+      store.listFor = jest.fn().mockRejectedValue(new Error('DB Down')) as any;
+
+      await handle(ws, session, {type: 'list_conversations'});
+
+      expect(sent).toContainEqual({
+        type: 'error',
+        code: 'SERVER_ERROR',
+        message: expect.not.stringContaining('DB Down'),
+      });
+    });
+
+    it('is not blocked by a streaming user_message', async () => {
+      const {ws, store, handle, sent} = setup({history: {enabled: true}});
+
+      // A mock orchestrator that hangs
+      let resolveStream: () => void;
+      const streamHang = new Promise<void>(resolve => {
+        resolveStream = resolve;
+      });
+
+      orchestrator.processMessageStream = async function* () {
+        await streamHang;
+        yield {type: 'text', text: 'hi'};
+      } as any;
+
+      store.listFor = jest.fn().mockResolvedValue([]) as any;
+
+      // Start a user message (will hang on the lock/orchestrator)
+      const userMessagePromise = handle(ws, session, {type: 'user_message', content: 'hello'});
+
+      // Send list_conversations (should answer immediately)
+      await handle(ws, session, {type: 'list_conversations'});
+
+      expect(sent).toContainEqual(expect.objectContaining({type: 'conversation_list'}));
+
+      // Now resolve the stream
+      resolveStream!();
+      await userMessagePromise;
+    });
+  });
+});