+import {jest} from '@jest/globals';
+import type {WebSocket} from 'ws';
+import {createMessageHandler} from './messageHandler.js';
+import type {ChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import type {ChatSession, SessionSummary} from '../../types/session.js';
+import type {SessionStore} from '../../types/sessionStore.js';
+import type {OutgoingMessage} from '../../types/messages.js';
+import {deferred} from '../wsTestSupport.js';
+
+describe('conversation list handler logic', () => {
+  const setup = (config: {history?: {enabled: boolean}} = {history: {enabled: true}}) => {
+    const sent: OutgoingMessage[] = [];
+    const ws = {
+      send: (raw: string) => sent.push(JSON.parse(raw) as OutgoingMessage),
+      userId: 'u1',
+    } as unknown as WebSocket & {userId: string};
+
+    const listFor = jest.fn<SessionStore['listFor']>();
+    const store = {listFor} as unknown as SessionStore;
+    const orchestrator = {} as unknown as ChatOrchestrator;
+    const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+
+    // Assuming createMessageHandler will be updated to take (orchestrator, store, options)
+    // For now, I'll write it as I expect it to be.
+    // @ts-expect-error - createMessageHandler signature will change
+    const handle = createMessageHandler(orchestrator, store, config);
+
+    return {ws, session, store, listFor, sent, handle};
+  };
+
+  it('answers list_conversations with the user list when enabled', async () => {
+    const {ws, session, listFor, sent, handle} = setup();
+    const summaries: SessionSummary[] = [
+      {
+        sessionId: 's2',
+        createdAt: new Date('2026-01-01T00:00:00Z'),
+        updatedAt: new Date('2026-01-01T01:00:00Z'),
+        entryCount: 5,
+      },
+    ];
+    listFor.mockResolvedValue(summaries);
+
+    await handle(ws, session, {type: 'list_conversations'});
+
+    expect(listFor).toHaveBeenCalledWith('u1', {limit: undefined, before: undefined});
+    expect(sent).toContainEqual({
+      type: 'conversation_list',
+      conversations: [
+        {
+          sessionId: 's2',
+          createdAt: '2026-01-01T00:00:00.000Z',
+          updatedAt: '2026-01-01T01:00:00.000Z',
+          entryCount: 5,
+        },
+      ],
+    });
+  });
+
+  it('uses ws.userId and ignores a userId in the frame', async () => {
+    const {ws, session, listFor, handle} = setup();
+    listFor.mockResolvedValue([]);
+
+    await handle(ws, session, {type: 'list_conversations', userId: 'other-user'});
+
+    expect(listFor).toHaveBeenCalledWith('u1', expect.anything());
+  });
+
+  it('answers with UNSUPPORTED when history is disabled', async () => {
+    const {ws, session, sent, handle} = setup({history: {enabled: false}});
+
+    await handle(ws, session, {type: 'list_conversations'});
+
+    expect(sent).toContainEqual(
+      expect.objectContaining({
+        type: 'error',
+        code: 'UNSUPPORTED',
+      })
+    );
+  });
+
+  it('answers with UNSUPPORTED when the store does not implement listFor', async () => {
+    const {ws, session, store, sent, handle} = setup();
+    // @ts-expect-error - deleting required method for test
+    delete (store as any).listFor;
+
+    await handle(ws, session, {type: 'list_conversations'});
+
+    expect(sent).toContainEqual(
+      expect.objectContaining({
+        type: 'error',
+        code: 'UNSUPPORTED',
+      })
+    );
+  });
+
+  it('answers list_conversations without waiting for the session lock', async () => {
+    const {ws, session, listFor, sent, handle} = setup();
+    listFor.mockResolvedValue([]);
+
+    // A fake long-running user_message that would hold the lock
+    const lockReleased = deferred();
+    // This is tricky to test "direct" without a real orchestrator that uses the lock.
+    // But the ticket says: "answering list_conversations on the non-locked path beside ping"
+    // So I will attempt to send a list_conversations WHILE a user_message is "running".
+
+    // In the real implementation, the handler for user_message will await the lock.
+    // If we call handle() twice, and the first one is a user_message,
+    // the second one (list_conversations) should complete even if the first is still pending.
+
+    // I'll need to mock the orchestrator to hang.
+    const orchestratorHangs = deferred();
+    const orchestrator = {
+      processMessageStream: jest.fn().mockImplementation(async function* () {
+        await orchestratorHangs.promise;
+        yield {type: 'stop', stopReason: 'end_turn'};
+      }),
+    } as unknown as ChatOrchestrator;
+
+    // @ts-expect-error - signature change
+    const lockedHandle = createMessageHandler(orchestrator, {listFor} as any, {history: {enabled: true}});
+
+    const userMsgPromise = lockedHandle(ws, session, {type: 'user_message', content: 'hello'});
+    const listMsgPromise = lockedHandle(ws, session, {type: 'list_conversations'});
+
+    // The list message should complete before we resolve the user message
+    await listMsgPromise;
+    expect(sent).toContainEqual(expect.objectContaining({type: 'conversation_list'}));
+
+    orchestratorHangs.resolve();
+    await userMsgPromise;
+  });
+});
