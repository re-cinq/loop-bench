+import {validateMessage} from './validation.js';
+
+describe('conversation list frame validation', () => {
+  it('accepts a minimal list_conversations message', () => {
+    const result = validateMessage({type: 'list_conversations'});
+    expect(result).toEqual({valid: true, data: {type: 'list_conversations'}});
+  });
+
+  it('accepts a list_conversations message with limit and before cursor', () => {
+    const before = {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: 's1'};
+    const result = validateMessage({type: 'list_conversations', limit: 50, before});
+    expect(result).toEqual({valid: true, data: {type: 'list_conversations', limit: 50, before}});
+  });
+
+  it('rejects invalid limit values', () => {
+    expect(validateMessage({type: 'list_conversations', limit: 0}).valid).toBe(false);
+    expect(validateMessage({type: 'list_conversations', limit: 201}).valid).toBe(false);
+    expect(validateMessage({type: 'list_conversations', limit: 1.5}).valid).toBe(false);
+    expect(validateMessage({type: 'list_conversations', limit: '10'}).valid).toBe(false);
+  });
+
+  it('rejects invalid before cursor', () => {
+    // Missing sessionId
+    expect(validateMessage({type: 'list_conversations', before: {updatedAt: '2026-01-01T00:00:00.000Z'}}).valid).toBe(
+      false
+    );
+    // Invalid date
+    expect(
+      validateMessage({type: 'list_conversations', before: {updatedAt: 'not-a-date', sessionId: 's1'}}).valid
+    ).toBe(false);
+  });
+});
