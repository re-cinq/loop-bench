+import {jest} from '@jest/globals';
+import {WebSocket} from 'ws';
+import {startEngineWith, connectClient, stopEngines, deferred} from '../wsTestSupport.js';
+import type {SessionStore} from '../../types/sessionStore.js';
+import {ErrorCodes} from '../../types/session.js';
+
+describe('conversation list acceptance tests', () => {
+  afterEach(stopEngines);
+
+  it('accepts a valid list_conversations frame', async () => {
+    // specs/hal-engine-websocket-protocol/spec.md#4.3
+    const listFor = jest.fn(async () => [
+      {
+        sessionId: 's1',
+        createdAt: new Date('2026-01-15T14:30:00Z'),
+        updatedAt: new Date('2026-01-15T14:30:05Z'),
+        entryCount: 12,
+      },
+    ]);
+    const sessionStore = {
+      listFor,
+      create: jest.fn(async (id: string, userId: string) => ({sessionId: id, userId, entries: []})),
+    } as unknown as SessionStore;
+
+    const {url} = await startEngineWith({
+      sessionStore,
+      transport: {history: {enabled: true}} as any,
+    });
+    const client = connectClient(url);
+
+    const reply = await new Promise<any>(resolve => {
+      client.on('open', () => {
+        client.send(JSON.stringify({type: 'list_conversations', limit: 20}));
+      });
+      client.on('message', raw => {
+        const frame = JSON.parse(String(raw));
+        if (frame.type === 'conversation_list' || frame.type === 'error') {
+          resolve(frame);
+        }
+      });
+    });
+
+    expect(reply).toEqual({
+      type: 'conversation_list',
+      conversations: [
+        {
+          sessionId: 's1',
+          createdAt: '2026-01-15T14:30:00.000Z',
+          updatedAt: '2026-01-15T14:30:05.000Z',
+          entryCount: 12,
+        },
+      ],
+    });
+    expect(listFor).toHaveBeenCalledWith('u1', {limit: 20, before: undefined});
+  });
+
+  it('accepts list_conversations with valid limit and before', async () => {
+    // specs/hal-engine-websocket-protocol/spec.md#4.3
+    const listFor = jest.fn(async () => []);
+    const sessionStore = {
+      listFor,
+      create: jest.fn(async (id: string, userId: string) => ({sessionId: id, userId, entries: []})),
+    } as unknown as SessionStore;
+
+    const {url} = await startEngineWith({
+      sessionStore,
+      transport: {history: {enabled: true}} as any,
+    });
+    const client = connectClient(url);
+
+    const before = {updatedAt: '2026-01-15T14:30:00Z', sessionId: 's0'};
+    await new Promise<void>(resolve => {
+      client.on('open', () => {
+        client.send(JSON.stringify({type: 'list_conversations', limit: 10, before}));
+        resolve();
+      });
+    });
+
+    // Wait for the store to be called
+    await new Promise(resolve => setTimeout(resolve, 50));
+    expect(listFor).toHaveBeenCalledWith('u1', {limit: 10, before});
+  });
+
+  it('rejects list_conversations with invalid limit', async () => {
+    // specs/hal-engine-websocket-protocol/spec.md#4.3
+    const sessionStore = {
+      listFor: jest.fn(),
+      create: jest.fn(async (id: string, userId: string) => ({sessionId: id, userId, entries: []})),
+    } as unknown as SessionStore;
+    const {url} = await startEngineWith({
+      sessionStore,
+      transport: {history: {enabled: true}} as any,
+    });
+
+    const client = connectClient(url);
+    const reply = await new Promise<any>(resolve => {
+      client.on('open', () => client.send(JSON.stringify({type: 'list_conversations', limit: 0})));
+      client.on('message', raw => {
+        const frame = JSON.parse(String(raw));
+        if (frame.type === 'error') resolve(frame);
+      });
+    });
+
+    expect(reply).toEqual({
+      type: 'error',
+      code: ErrorCodes.INVALID_MESSAGE,
+      message: expect.stringContaining('limit'),
+    });
+  });
+
+  it('rejects list_conversations with invalid before cursor', async () => {
+    // specs/hal-engine-websocket-protocol/spec.md#4.3
+    const sessionStore = {
+      listFor: jest.fn(),
+      create: jest.fn(async (id: string, userId: string) => ({sessionId: id, userId, entries: []})),
+    } as unknown as SessionStore;
+    const {url} = await startEngineWith({
+      sessionStore,
+      transport: {history: {enabled: true}} as any,
+    });
+
+    const client = connectClient(url);
+    const reply = await new Promise<any>(resolve => {
+      client.on('open', () =>
+        client.send(JSON.stringify({type: 'list_conversations', before: {updatedAt: 'not a date'}}))
+      );
+      client.on('message', raw => {
+        const frame = JSON.parse(String(raw));
+        if (frame.type === 'error') resolve(frame);
+      });
+    });
+
+    expect(reply).toEqual({
+      type: 'error',
+      code: ErrorCodes.INVALID_MESSAGE,
+      message: expect.stringContaining('before'),
+    });
+  });
+
+  it('uses the authenticated user id from the socket, not the frame', async () => {
+    // specs/hal-engine-websocket-protocol/spec.md#4.3
+    const listFor = jest.fn(async () => []);
+    const sessionStore = {
+      listFor,
+      create: jest.fn(async (id: string, userId: string) => ({sessionId: id, userId, entries: []})),
+    } as unknown as SessionStore;
+
+    const {url} = await startEngineWith({
+      sessionStore,
+      transport: {history: {enabled: true}} as any,
+    });
+    const client = connectClient(url);
+
+    await new Promise<void>(resolve => {
+      client.on('open', () => {
+        client.send(JSON.stringify({type: 'list_conversations', userId: 'attacker'}));
+        resolve();
+      });
+    });
+
+    await new Promise(resolve => setTimeout(resolve, 50));
+    expect(listFor).toHaveBeenCalledWith('u1', expect.anything());
+  });
+
+  it('answers with UNSUPPORTED when history is disabled', async () => {
+    // specs/hal-engine-websocket-protocol/spec.md#5.6
+    const sessionStore = {
+      listFor: jest.fn(),
+      create: jest.fn(async (id: string, userId: string) => ({sessionId: id, userId, entries: []})),
+    } as unknown as SessionStore;
+    const {url} = await startEngineWith({
+      sessionStore,
+      transport: {history: {enabled: false}} as any,
+    });
+
+    const client = connectClient(url);
+    const reply = await new Promise<any>(resolve => {
+      client.on('open', () => client.send(JSON.stringify({type: 'list_conversations'})));
+      client.on('message', raw => {
+        const frame = JSON.parse(String(raw));
+        if (frame.type === 'error') resolve(frame);
+      });
+    });
+
+    expect(reply.code).toBe('UNSUPPORTED');
+  });
+
+  it('answers with UNSUPPORTED when the store does not implement listFor', async () => {
+    // specs/hal-engine-websocket-protocol/spec.md#5.6
+    const sessionStore = {
+      create: jest.fn(async (id: string, userId: string) => ({sessionId: id, userId, entries: []})),
+    } as unknown as SessionStore;
+    const {url} = await startEngineWith({
+      sessionStore,
+      transport: {history: {enabled: true}} as any,
+    });
+
+    const client = connectClient(url);
+    const reply = await new Promise<any>(resolve => {
+      client.on('open', () => client.send(JSON.stringify({type: 'list_conversations'})));
+      client.on('message', raw => {
+        const frame = JSON.parse(String(raw));
+        if (frame.type === 'error') resolve(frame);
+      });
+    });
+
+    expect(reply.code).toBe('UNSUPPORTED');
+  });
+
+  it('answers list_conversations immediately even if a user_message is running', async () => {
+    // specs/hal-engine-websocket-protocol/spec.md#4.3
+    const {until, release} = deferred();
