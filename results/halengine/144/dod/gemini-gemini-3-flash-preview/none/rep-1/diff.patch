+
+async function waitForFrame(client: WebSocket, type: string): Promise<any> {
+  return new Promise((resolve, reject) => {
+    const timeout = setTimeout(() => reject(new Error(`Timeout waiting for frame ${type}`)), 2000);
+    const handler = (raw: string) => {
+      const frame = JSON.parse(String(raw));
+      if (frame.type === type) {
+        clearTimeout(timeout);
+        client.off('message', handler);
+        resolve(frame);
+      }
+    };
+    client.on('message', handler);
+  });
