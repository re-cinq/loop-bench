+      create: (id: string, uid: string) => ({sessionId: id, userId: uid, entries: []}),
+      get: jest.fn().mockResolvedValue({sessionId: 'c1', userId, entries: []}),
+      listFor,
+    } as unknown as SessionStore;
+
+    // An orchestrator that hangs until we release it
+    let releaseMessage: () => void;
+    const until = new Promise<void>(resolve => {
+      releaseMessage = resolve;
+    });
+
+    const orchestrator = {
+      processMessageStream: async function* () {
+        await until;
+        yield {type: 'text', text: 'done'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+    } as any;
+
+    const {url} = await startEngineWith({
+      sessionStore,
+      orchestrator,
+      transport: {history: {enabled: true}} as any,
+    });
+
+    const client = connectClient(url);
+    await new Promise<void>(resolve => client.on('open', resolve));
+
+    // Start a long-running message
+    client.send(JSON.stringify({type: 'user_message', content: 'wait for it'}));
+
+    // Ensure the message has started (received user entry upsert)
+    await waitForFrame(client, 'entry_upsert');
+
+    // Send list_conversations while the message is still "running"
+    client.send(JSON.stringify({type: 'list_conversations'}));
+
+    // Should receive conversation_list BEFORE stream_end
+    const frames: string[] = [];
+    const receivedAll = new Promise<void>(resolve => {
+      client.on('message', raw => {
+        const {type} = JSON.parse(String(raw));
+        frames.push(type);
+        if (type === 'stream_end') resolve();
+      });
+    });
+
+    const listFrame = await waitForFrame(client, 'conversation_list');
+    expect(listFrame.type).toBe('conversation_list');
+
+    // Release the blocked message
+    releaseMessage!();
+    await receivedAll;
+
+    expect(frames).toContain('conversation_list');
+    const listPos = frames.indexOf('conversation_list');
+    const endPos = frames.indexOf('stream_end');
+    expect(listPos).toBeLessThan(endPos);
+  });
