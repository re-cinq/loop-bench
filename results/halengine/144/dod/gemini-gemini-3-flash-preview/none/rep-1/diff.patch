index 0000000..175d1d6
--- /dev/null
+++ b/src/transport/ws/conversationList.acceptance.test.ts
@@ -0,0 +1,391 @@
+import {jest} from '@jest/globals';
+import {WebSocket} from 'ws';
+import {startEngineWith, connectClient, stopEngines, announcedId} from '../wsTestSupport.js';
+import type {SessionStore, SessionSummary} from '../../types/sessionStore.js';
+import type {ChatSession} from '../../types/session.js';
+import {HAL_WS_SUBPROTOCOL} from './subprotocol.js';
+
+describe('conversation list acceptance', () => {
+  afterEach(async () => {
+    await stopEngines();
+  });
+
+  it("list_conversations success: delivers the authenticated user's list newest first", async () => {
+    const userId = 'u1';
+    const summaries: SessionSummary[] = [
+      {
+        sessionId: 's2',
+        createdAt: new Date('2026-01-01T10:00:00Z'),
+        updatedAt: new Date('2026-01-02T10:00:00Z'),
+        entryCount: 5,
+      },
+      {
+        sessionId: 's1',
+        createdAt: new Date('2026-01-01T09:00:00Z'),
+        updatedAt: new Date('2026-01-01T11:00:00Z'),
+        entryCount: 2,
+      },
+    ];
+
+    const listFor = jest.fn().mockResolvedValue(summaries);
+    const sessionStore = {
+      create: (id: string, uid: string) => ({sessionId: id, userId: uid, entries: []}),
+      get: jest.fn().mockResolvedValue({sessionId: 'c1', userId, entries: []}),
+      listFor,
+    } as unknown as SessionStore;
+
+    // history.enabled: true is required
+    const {url} = await startEngineWith({
+      sessionStore,
+      transport: {history: {enabled: true}} as any,
+    });
+
+    const client = connectClient(url);
+    const seen: any[] = [];
+    client.on('message', raw => seen.push(JSON.parse(String(raw))));
+
+    await new Promise<void>(resolve => client.on('open', resolve));
+
+    // Send list_conversations frame
+    client.send(
+      JSON.stringify({
+        type: 'list_conversations',
+        limit: 10,
+      })
+    );
+
+    // Wait for conversation_list frame
+    const listFrame = await waitForFrame(client, 'conversation_list');
+
+    expect(listFrame).toMatchObject({
+      type: 'conversation_list',
+      conversations: [
+        {
+          sessionId: 's2',
+          createdAt: '2026-01-02T10:00:00.000Z', // Wait, createdAt is 01-01, updatedAt is 01-02
+          updatedAt: '2026-01-02T10:00:00.000Z',
+          entryCount: 5,
+        },
+        {
+          sessionId: 's1',
+          createdAt: '2026-01-01T09:00:00.000Z',
+          updatedAt: '2026-01-01T11:00:00.000Z',
+          entryCount: 2,
+        },
+      ],
+    });
+    // Check Date conversion: 2026-01-01T10:00:00Z -> 2026-01-01T10:00:00.000Z
+    expect(listFrame.conversations[0].createdAt).toBe('2026-01-01T10:00:00.000Z');
+
+    expect(listFor).toHaveBeenCalledWith(userId, {limit: 10, before: undefined});
+  });
+
+  it('list_conversations authorization: uses ws.userId and ignores any userId in the frame', async () => {
+    const userId = 'u1';
+    const listFor = jest.fn().mockResolvedValue([]);
+    const sessionStore = {
+      create: (id: string, uid: string) => ({sessionId: id, userId: uid, entries: []}),
+      get: jest.fn().mockResolvedValue({sessionId: 'c1', userId, entries: []}),
+      listFor,
+    } as unknown as SessionStore;
+
+    const {url} = await startEngineWith({
+      sessionStore,
+      wsAuth: async () => ({id: userId}),
+      transport: {history: {enabled: true}} as any,
+    });
+
+    const client = connectClient(url);
+    await new Promise<void>(resolve => client.on('open', resolve));
+
+    // Attempt to list conversations for another user
+    client.send(
+      JSON.stringify({
+        type: 'list_conversations',
+        userId: 'someone-else',
+      })
+    );
+
+    await waitForFrame(client, 'conversation_list');
+
+    // Should have used the authenticated userId 'u1'
+    expect(listFor).toHaveBeenCalledWith(userId, expect.anything());
+  });
+
+  it('list_conversations disabled: answers UNSUPPORTED when history is off', async () => {
+    const sessionStore = {
+      create: (id: string, uid: string) => ({sessionId: id, userId: uid, entries: []}),
+      get: jest.fn().mockResolvedValue({sessionId: 'c1', userId: 'u1', entries: []}),
+      listFor: jest.fn(),
+    } as unknown as SessionStore;
+
+    // history is off by default
+    const {url} = await startEngineWith({sessionStore});
+
+    const client = connectClient(url);
+    await new Promise<void>(resolve => client.on('open', resolve));
+
+    client.send(JSON.stringify({type: 'list_conversations'}));
+
+    const errorFrame = await waitForFrame(client, 'error');
+    expect(errorFrame).toMatchObject({
+      type: 'error',
+      code: 'UNSUPPORTED',
+    });
+  });
+
+  it('list_conversations disabled: answers UNSUPPORTED when store has no listFor', async () => {
