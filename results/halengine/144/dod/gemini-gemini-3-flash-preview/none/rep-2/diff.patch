+import {jest} from '@jest/globals';
+import type {WebSocket} from 'ws';
+import {createMessageHandler} from './messageHandler.js';
+import type {ChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import type {ChatSession} from '../../types/session.js';
+import type {SessionStore} from '../../types/sessionStore.js';
+import type {OutgoingMessage} from '../../types/messages.js';
+import {createServer} from '../createServer.js';
+import type {AddressInfo} from 'node:net';
+import {WebSocket as RealWebSocket} from 'ws';
+import {HAL_WS_SUBPROTOCOL} from './subprotocol.js';
+
+describe('list conversations extended acceptance', () => {
+  const harness = (options: {historyEnabled?: boolean; store?: Partial<SessionStore>} = {}) => {
+    const sent: OutgoingMessage[] = [];
+    const ws = {
+      send: (raw: string) => sent.push(JSON.parse(raw) as OutgoingMessage),
+      userId: 'u1',
+      readyState: 1,
+    } as unknown as WebSocket & {userId: string};
+
+    const orchestrator = {} as ChatOrchestrator;
+    const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+    const store = (options.store || {}) as SessionStore;
+
+    const handle = (createMessageHandler as any)(orchestrator, store, {
+      transport: {history: {enabled: options.historyEnabled ?? false}},
+    });
+
+    return {
+      session,
+      sent,
+      ws,
+      send: (msg: unknown) => handle(ws, session, msg),
+    };
+  };
+
+  describe('validation', () => {
+    const cases = [
+      {name: 'limit: 0', frame: {type: 'list_conversations', limit: 0}},
+      {name: 'limit: 201', frame: {type: 'list_conversations', limit: 201}},
+      {name: 'limit: 1.5', frame: {type: 'list_conversations', limit: 1.5}},
+      {name: 'limit: "10"', frame: {type: 'list_conversations', limit: '10'}},
+      {name: 'before: "not a date"', frame: {type: 'list_conversations', before: 'not a date'}},
+      {name: 'before: {updatedAt: "invalid"}', frame: {type: 'list_conversations', before: {updatedAt: 'invalid'}}},
+      {
+        name: 'before: missing sessionId',
+        frame: {type: 'list_conversations', before: {updatedAt: '2026-01-15T14:30:00Z'}},
+      },
+    ];
+
+    test.each(cases)('refuses $name with INVALID_MESSAGE naming the field', async ({name, frame}) => {
+      const h = harness({historyEnabled: true});
+      await h.send(frame);
+
+      expect(h.sent).toContainEqual(
+        expect.objectContaining({
+          type: 'error',
+          code: 'INVALID_MESSAGE',
+          message: expect.stringMatching(new RegExp(name.split(':')[0], 'i')),
+        })
+      );
+    });
+  });
+
+  describe('store integration and error handling', () => {
+    it('passes limit and before cursor to listFor', async () => {
+      const listFor = jest.fn<SessionStore['listFor'] & ((...args: any[]) => any)>().mockResolvedValue([]);
+      const h = harness({historyEnabled: true, store: {listFor}});
+
+      const before = {updatedAt: '2026-01-15T14:30:00Z', sessionId: 's0'};
+      await h.send({type: 'list_conversations', limit: 20, before});
+
+      expect(listFor).toHaveBeenCalledWith(
+        'u1',
+        expect.objectContaining({
+          limit: 20,
+          before: expect.objectContaining({
+            updatedAt: expect.anything(),
+            sessionId: 's0',
+          }),
+        })
+      );
+    });
+
+    it('answers SERVER_ERROR when listFor rejects with generic error', async () => {
+      const listFor = jest
+        .fn<SessionStore['listFor'] & ((...args: any[]) => any)>()
+        .mockRejectedValue(new Error('DB Fail'));
+      const h = harness({historyEnabled: true, store: {listFor}});
+
+      await h.send({type: 'list_conversations'});
+
+      expect(h.sent).toContainEqual(
+        expect.objectContaining({
+          type: 'error',
+          code: 'SERVER_ERROR',
+        })
+      );
+      // Message should not carry store detail
+      const errorFrame = h.sent.find(f => (f as any).code === 'SERVER_ERROR') as any;
+      expect(errorFrame.message).not.toContain('DB Fail');
+    });
+
+    it('answers UNSUPPORTED when listFor rejects with StoreCannotList', async () => {
+      const error = new Error('Cannot list');
+      (error as any).name = 'StoreCannotList';
+      const listFor = jest.fn<SessionStore['listFor'] & ((...args: any[]) => any)>().mockRejectedValue(error);
+      const h = harness({historyEnabled: true, store: {listFor}});
+
+      await h.send({type: 'list_conversations'});
+
+      expect(h.sent).toContainEqual(
+        expect.objectContaining({
+          type: 'error',
+          code: 'UNSUPPORTED',
+        })
+      );
+    });
+  });
+
+  describe('reconnection', () => {
+    it('allows reconnecting using a session id from a conversation list', async () => {
+      const store = {
+        listFor: jest.fn<SessionStore['listFor'] & ((...args: any[]) => any)>().mockResolvedValue([
+          {
+            sessionId: 's-from-list',
+            createdAt: new Date('2026-01-15T14:30:00Z'),
+            updatedAt: new Date('2026-01-15T14:35:00Z'),
+            entryCount: 1,
+          },
+        ]),
+        get: jest.fn<SessionStore['get'] & ((...args: any[]) => any)>().mockResolvedValue({
+          sessionId: 's-from-list',
+          userId: 'u1',
+          entries: [{role: 'user', content: 'hello', timestamp: '2026-01-15T14:30:00Z'}],
+        }),
+      } as unknown as SessionStore;
+
+      const hal = createServer({
+        app: (() => undefined) as any,
+        wsAuth: async () => ({id: 'u1'}),
+        sessionStore: store,
+        orchestrator: {} as ChatOrchestrator,
+        resume: {enabled: true},
+        transport: {history: {enabled: true}} as any,
+      });
+
+      await hal.start(0);
+      const {port} = hal.server.address() as AddressInfo;
+
+      try {
+        const ws = new RealWebSocket(`ws://localhost:${port}/hal/ws?sessionId=s-from-list`, [
+          HAL_WS_SUBPROTOCOL,
+          'token',
+        ]);
+        const messages: any[] = [];
+        ws.on('message', data => messages.push(JSON.parse(data.toString())));
+
+        await new Promise((resolve, reject) => {
+          ws.on('open', resolve);
+          ws.on('error', reject);
+          setTimeout(() => reject(new Error('Timeout')), 2000);
+        });
+
+        // Should receive connected frame with resumed: true
+        await new Promise(resolve => setTimeout(resolve, 100));
+        const connected = messages.find(m => m.type === 'connected');
+        expect(connected).toBeDefined();
+        expect(connected.resumed).toBe(true);
+        expect(connected.sessionId).toBe('s-from-list');
+
+        // Should receive replay
+        expect(messages).toContainEqual(
+          expect.objectContaining({
+            type: 'entry_upsert',
+            entry: expect.objectContaining({content: 'hello'}),
+          })
+        );
+      } finally {
+        await hal.stop();
+      }
+    });
+  });
+});