@@ -0,0 +1,325 @@
+import {jest} from '@jest/globals';
+import {createMessageHandler} from './messageHandler.js';
+import {validateMessage} from './validation.js';
+import {InMemorySessionStore} from '../../infrastructure/stores/inMemorySessionStore.js';
+import type {SessionSummary} from '../../types/sessionStore.js';
+import {startEngineWith, connectClient, stopEngines} from '../wsTestSupport.js';
+import type {IncomingMessage, OutgoingMessage} from '../../types/messages.js';
+
+describe('Conversation List Acceptance', () => {
+  const orchestrator = {
+    processMessageStream: jest.fn().mockImplementation(async function* () {
+      yield {type: 'stop', stopReason: 'end_turn'};
+    }),
+  } as any;
+
+  afterEach(async () => {
+    await stopEngines();
+    jest.restoreAllMocks();
+  });
+
+  describe('Protocol Stability', () => {
+    it('pins that every message literal valid before this change still compiles', () => {
+      const _incoming: IncomingMessage[] = [
+        {type: 'user_message', content: 'hello'},
+        {type: 'ping', timestamp: 123},
+      ];
+
+      const _outgoing: OutgoingMessage[] = [
+        {type: 'connected', sessionId: 's1', message: 'hi', examplePrompts: []},
+        {type: 'entry_upsert', index: 0, entry: {role: 'user', content: 'hi', timestamp: '2026-01-01T00:00:00Z'}},
+        {type: 'entry_delta', index: 0, delta: ' '},
+        {type: 'entry_commit', index: 0},
+        {type: 'entry_skip', index: 0},
+        {type: 'error', code: 'ERR', message: 'msg'},
+        {type: 'pong', timestamp: 123},
+        {type: 'stream_end'},
+      ];
+      expect(true).toBe(true);
+    });
+
+    it('uses new conversation list message types (currently absent from types)', () => {
+      // These will fail to compile once we remove 'any' or when we run a real typecheck.
+      // For now, we can check that they are NOT accepted by a hypothetical runtime union check if we had one.
+      // But more simply, we want these to be VALID once implemented.
+      const _newIncoming: IncomingMessage[] = [
+        {
+          type: 'list_conversations',
+          limit: 50,
+          before: {updatedAt: '2026-01-15T14:30:00Z', sessionId: 's1'},
+        } as any,
+      ];
+
+      const _newOutgoing: OutgoingMessage[] = [
+        {
+          type: 'conversation_list',
+          conversations: [
+            {
+              sessionId: 's1',
+              createdAt: '2026-01-15T14:30:00Z',
+              updatedAt: '2026-01-15T14:30:05Z',
+              entryCount: 4,
+            },
+          ],
+        } as any,
+      ];
+      expect(true).toBe(true);
+    });
+  });
+
+  describe('Protocol Validation', () => {
+    it('accepts valid list_conversations frame', () => {
+      const result = validateMessage({type: 'list_conversations'} as any);
+      expect(result).toEqual({valid: true, data: {type: 'list_conversations'}});
+    });
+
+    it('rejects invalid limit (0)', () => {
+      const result = validateMessage({type: 'list_conversations', limit: 0} as any);
+      expect(result.valid).toBe(false);
+      expect(result.error).toMatch(/limit/i);
+    });
+
+    it('rejects invalid limit (201)', () => {
+      const result = validateMessage({type: 'list_conversations', limit: 201} as any);
+      expect(result.valid).toBe(false);
+      expect(result.error).toMatch(/limit/i);
+    });
+
+    it('rejects non-integer limit', () => {
+      const result = validateMessage({type: 'list_conversations', limit: 1.5} as any);
+      expect(result.valid).toBe(false);
+      expect(result.error).toMatch(/limit/i);
+    });
+
+    it('rejects invalid before cursor', () => {
+      const result = validateMessage({type: 'list_conversations', before: 'not-a-cursor'} as any);
+      expect(result.valid).toBe(false);
+      expect(result.error).toMatch(/before/i);
+    });
+
+    it('rejects incomplete before cursor (missing sessionId)', () => {
+      const result = validateMessage({type: 'list_conversations', before: {updatedAt: '2026-01-01T00:00:00Z'}} as any);
+      expect(result.valid).toBe(false);
+      expect(result.error).toMatch(/before/i);
+    });
+  });
+
+  describe('Delivery and Authorization', () => {
+    it('delivers conversation list newest first when history is enabled', async () => {
+      const store = new InMemorySessionStore();
+      const s1: SessionSummary = {
+        sessionId: 's1',
+        createdAt: new Date('2026-01-01T00:00:00Z'),
+        updatedAt: new Date('2026-01-01T02:00:00Z'),
+        entryCount: 1,
+      };
