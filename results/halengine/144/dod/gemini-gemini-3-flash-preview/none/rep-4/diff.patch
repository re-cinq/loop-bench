diff --git a/src/transport/ws/conversationList.acceptance.test.ts b/src/transport/ws/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..7017c2d
--- /dev/null
+++ b/src/transport/ws/conversationList.acceptance.test.ts
@@ -0,0 +1,149 @@
+import {jest} from '@jest/globals';
+import {WebSocket} from 'ws';
+import {createMessageHandler} from './messageHandler.js';
+import {InMemorySessionStore} from '../../infrastructure/stores/inMemorySessionStore.js';
+import type {ChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import type {ChatSession} from '../../types/session.js';
+import type {OutgoingMessage} from '../../types/messages.js';
+
+describe('conversation list acceptance', () => {
+  const setup = (historyEnabled = true, store = new InMemorySessionStore()) => {
+    const sent: OutgoingMessage[] = [];
+    const ws = {
+      send: (raw: string) => sent.push(JSON.parse(raw) as OutgoingMessage),
+      readyState: 1, // WebSocket.OPEN
+    } as unknown as WebSocket;
+
+    const orchestrator = {
+      processMessageStream: async function* () {
+        /* noop */
+      },
+    } as unknown as ChatOrchestrator;
+    const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+
+    // The handler should eventually take the store and config.
+    // For now we pass them; the current implementation ignores them.
+    // @ts-ignore
+    const handle = createMessageHandler(orchestrator, store, {transport: {history: {enabled: historyEnabled}}});
+
+    return {
+      store,
+      sent,
+      send: (raw: unknown) => handle(ws, session, raw),
+    };
+  };
+
+  /**
+   * specs/hal-engine-websocket-protocol/spec.md#1
+   */
+  it('returns a conversation list when history is enabled', async () => {
+    const {store, sent, send} = setup(true);
+    // Create a conversation for the user
+    await store.create('c1', 'u1');
+
+    await send({type: 'list_conversations'});
+
+    expect(sent).toContainEqual(
+      expect.objectContaining({
+        type: 'conversation_list',
+        conversations: expect.arrayContaining([expect.objectContaining({sessionId: 'c1'})]),
+      })
+    );
+  });
+
+  /**
+   * specs/hal-engine-websocket-protocol/spec.md#2
+   */
+  it('returns UNSUPPORTED error when history is disabled', async () => {
+    const {sent, send} = setup(false);
+
+    await send({type: 'list_conversations'});
+
+    expect(sent).toContainEqual(
+      expect.objectContaining({
+        type: 'error',
+        code: 'UNSUPPORTED',
+      })
+    );
+  });
+
+  /**
+   * specs/hal-engine-websocket-protocol/spec.md#3
+   */
+  it('returns UNSUPPORTED error when store cannot list', async () => {
+    // A store that satisfies SessionStore but lacks listFor
+    const store = new InMemorySessionStore();
+    delete (store as any).listFor;
+
+    const {sent, send} = setup(true, store);
+
+    await send({type: 'list_conversations'});
+
+    expect(sent).toContainEqual(
+      expect.objectContaining({
+        type: 'error',
+        code: 'UNSUPPORTED',
+      })
+    );
+  });
+
+  /**
+   * specs/hal-engine-websocket-protocol/spec.md#4
+   */
+  it('returns list for authenticated user ignoring userId in frame', async () => {
+    const {store, sent, send} = setup(true);
+    await store.create('c1', 'u1'); // user 1
+    await store.create('c2', 'u2'); // user 2
+
+    await send({type: 'list_conversations', userId: 'u2'});
+
+    const listFrame = sent.find(f => f.type === 'conversation_list') as any;
+    expect(listFrame).toBeDefined();
+    expect(listFrame.conversations).toHaveLength(1);
+    expect(listFrame.conversations[0].sessionId).toBe('c1');
+  });
+
+  /**
+   * specs/hal-engine-websocket-protocol/spec.md#5
+   */
+  it('is answered immediately even if a user_message is streaming', async () => {
+    const sent: OutgoingMessage[] = [];
+    const ws = {
+      send: (raw: string) => sent.push(JSON.parse(raw) as OutgoingMessage),
+      readyState: 1, // WebSocket.OPEN
+    } as unknown as WebSocket;
+
+    // A stream that waits for us to release it
+    const release = {now: () => {}};
+    const until = new Promise<void>(resolve => {
+      release.now = resolve;
+    });
+
+    const orchestrator = {
+      processMessageStream: async function* () {
+        yield {type: 'text', text: 'hi'};
+        await until;
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+    } as unknown as ChatOrchestrator;
+    const store = new InMemorySessionStore();
+    const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+
+    // @ts-ignore
+    const handle = createMessageHandler(orchestrator, store, {transport: {history: {enabled: true}}});
+
+    // Start a user message (will hang on 'until')
+    const turn = handle(ws, session, {type: 'user_message', content: 'hello'});
+
+    // Send list_conversations while turn is in progress
+    await handle(ws, session, {type: 'list_conversations'});
+
+    // The list_conversations should be answered before the turn finishes
+    expect(sent.map(f => f.type)).toContain('conversation_list');
+    expect(sent.map(f => f.type)).not.toContain('stream_end');
+
+    release.now();
+    await turn;
+    expect(sent.map(f => f.type)).toContain('stream_end');
+  });
+});