+    const refusals = [
+      [{limit: 0}, 'limit'],
+      [{limit: 201}, 'limit'],
+      [{limit: 1.5}, 'limit'],
+      [{limit: '10'}, 'limit'],
+      [{before: 'not a date'}, 'before'],
+      [{before: {updatedAt: 'not a date', sessionId: 'c'}}, 'before'],
+      [{before: {updatedAt: CURSOR.updatedAt}}, 'before'],
+      [{before: {sessionId: 'c'}}, 'before'],
+    ] as const;
+
+    const refused = refusals.map(([fields, field]) => {
+      const result = validateMessage({type: 'list_conversations', ...fields});
+      return {fields, valid: result.valid, namesField: !result.valid && result.error.includes(field)};
+    });
+
+    expect({accepted, refused}).toEqual({
