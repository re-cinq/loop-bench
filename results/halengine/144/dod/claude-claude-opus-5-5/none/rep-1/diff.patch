diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..ec4f747
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,209 @@
+import type {WebSocket} from 'ws';
+import {connectClient, deferred, startEngineWith, stopEngines} from './wsTestSupport.js';
+import {validateMessage} from './ws/validation.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {ChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import type {MessageChunk} from '../types/ai.js';
+import type {SessionListOptions, SessionStore} from '../types/sessionStore.js';
+import {setLogger} from '../shared/logger.js';
+
+// Real upgrades over a real socket (re-cinq/HALEngine#144): the list a client is sent is the contract.
+
+interface Frame {
+  type: string;
+  code?: string;
+  conversations?: Array<Record<string, unknown>>;
+}
+
+const HISTORY_ON = {enabled: true};
+
+// Each stored conversation holds one user entry, sent at the given time: later than any connect, so the order is theirs.
+const storeWith = (conversations: Array<[sessionId: string, userId: string, sentAt: string]>): InMemorySessionStore => {
+  const store = new InMemorySessionStore();
+  for (const [sessionId, userId, sentAt] of conversations) {
+    store.create(sessionId, userId).entries.push({role: 'user', content: sessionId, timestamp: sentAt});
+  }
+  return store;
+};
+
+const THREE_OF_U1_ONE_OF_U2: Array<[string, string, string]> = [
+  ['older', 'u1', '2099-10-01T08:00:00.000Z'],
+  ['newest', 'u1', '2099-10-03T08:00:00.000Z'],
+  ['middle', 'u1', '2099-10-02T08:00:00.000Z'],
+  ['theirs', 'u2', '2099-10-04T08:00:00.000Z'],
+];
+
+// The store's required members, with listFor present or left out, recording every call it answers.
+const recording = (inner: InMemorySessionStore, list: 'present' | 'absent' | 'rejects' = 'present') => {
+  const calls: Array<[userId: string | number, options?: SessionListOptions]> = [];
+  const store: SessionStore = {
+    create: (sessionId, userId, options) => inner.create(sessionId, userId, options),
+    get: sessionId => inner.get(sessionId),
+    delete: sessionId => inner.delete(sessionId),
+    count: () => inner.count(),
+    clear: () => inner.clear(),
+  };
+  if (list === 'present') {
+    store.listFor = (userId, options) => {
+      calls.push([userId, options]);
+      return inner.listFor(userId, options);
+    };
+  }
+  if (list === 'rejects') {
+    store.listFor = async () => {
+      throw new Error('mongo://admin:hunter2@db-7 timed out');
+    };
+  }
+  return {store, calls};
+};
+
+// Built as a variable, not a literal, so a config key the engine does not know yet fails on behaviour, not on a type.
+const start = (sessionStore: SessionStore, extra: Record<string, unknown> = {}, orchestrator?: ChatOrchestrator) => {
+  const options = {sessionStore, ...extra, ...(orchestrator ? {orchestrator} : {})};
+  return startEngineWith(options);
+};
+
+// Sends the frame on connect, then a ping as a barrier: every answer to the frame precedes its pong.
+const askAndSettle = (client: WebSocket, frame: Record<string, unknown>): Promise<Frame[]> => {
+  const frames: Frame[] = [];
+  return new Promise(resolve => {
+    client.on('message', raw => {
+      const parsed = JSON.parse(String(raw)) as Frame;
+      if (parsed.type === 'connected') {
+        client.send(JSON.stringify(frame));
+        client.send(JSON.stringify({type: 'ping', timestamp: 1}));
+        return;
+      }
+      if (parsed.type === 'pong') resolve(frames);
+      else frames.push(parsed);
+    });
+  });
+};
+
+const onTheWire = (store: InMemorySessionStore, userId: string) =>
+  store.listFor(userId).map(summary => ({
+    ...summary,
+    createdAt: summary.createdAt.toISOString(),
+    updatedAt: summary.updatedAt.toISOString(),
+  }));
+
+// Silenced and left so: a socket's close is logged after teardown, and jest gives each file its own logger module.
+beforeAll(() => {
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined});
+});
+
+afterEach(stopEngines);
+
+describe('delivering a conversation list over the socket', () => {
+  it('accepts list_conversations and refuses a bad limit or before, naming the field', () => {
+    const refused = [
+      [{limit: 0}, /limit/],
+      [{limit: 201}, /limit/],
+      [{limit: 1.5}, /limit/],
+      [{limit: '10'}, /limit/],
+      [{before: 'not a date'}, /before/],
+      [{before: {updatedAt: 'not a date', sessionId: 's1'}}, /before/],
+      [{before: {updatedAt: '2099-10-01T08:00:00.000Z'}}, /before/],
+    ] as const;
+
+    expect({
+      bare: validateMessage({type: 'list_conversations'}).valid,
+      paged: validateMessage({
+        type: 'list_conversations',
+        limit: 200,
+        before: {updatedAt: '2099-10-01T08:00:00.000Z', sessionId: 's1'},
+      }).valid,
+      refused: refused.map(([fields, names]) => {
+        const result = validateMessage({type: 'list_conversations', ...fields});
+        return !result.valid && names.test(result.error);
+      }),
+    }).toEqual({bare: true, paged: true, refused: refused.map(() => true)});
+  });
+
+  it("answers with the connection's own user's list, newest first in ISO times, whatever user id the frame names", async () => {
+    const held = storeWith(THREE_OF_U1_ONE_OF_U2);
+    const {store, calls} = recording(held);
+    const {url} = await start(store, {history: HISTORY_ON});
+    const before = {updatedAt: '2100-01-01T00:00:00.000Z', sessionId: 'zzz'};
+
+    const frames = await askAndSettle(connectClient(url), {
+      type: 'list_conversations',
+      userId: 'u2',
+      limit: 10,
+      before,
+    });
+
+    const listed = frames[0]?.conversations ?? [];
+    expect({
+      types: frames.map(frame => frame.type),
+      conversations: listed,
+      seededOrder: listed.map(row => row.sessionId).filter(id => ['older', 'middle', 'newest'].includes(String(id))),
+      calls,
+    }).toEqual({
+      types: ['conversation_list'],
+      conversations: onTheWire(held, 'u1'),
+      seededOrder: ['newest', 'middle', 'older'],
+      calls: [['u1', {limit: 10, before}]],
+    });
+  });
+
+  it('answers UNSUPPORTED and no list with history off, and with history on over a store that cannot list', async () => {
+    const off = await start(recording(storeWith(THREE_OF_U1_ONE_OF_U2)).store);
+    const cannot = await start(recording(storeWith(THREE_OF_U1_ONE_OF_U2), 'absent').store, {history: HISTORY_ON});
+
+    const answers = await Promise.all(
+      [off.url, cannot.url].map(url => askAndSettle(connectClient(url), {type: 'list_conversations'}))
+    );
+
+    expect(answers.map(frames => frames.map(({type, code}) => ({type, code})))).toEqual([
+      [{type: 'error', code: 'UNSUPPORTED'}],
+      [{type: 'error', code: 'UNSUPPORTED'}],
+    ]);
+  });
+
+  it('answers a store that rejects with SERVER_ERROR carrying no store detail, and keeps the socket open', async () => {
+    const {url} = await start(recording(storeWith(THREE_OF_U1_ONE_OF_U2), 'rejects').store, {history: HISTORY_ON});
+    const client = connectClient(url);
+
+    const frames = await askAndSettle(client, {type: 'list_conversations'});
+
+    expect({
+      frames: frames.map(({type, code}) => ({type, code})),
+      leaks: JSON.stringify(frames).includes('hunter2') || JSON.stringify(frames).includes('db-7'),
+      open: client.readyState === client.OPEN,
+    }).toEqual({frames: [{type: 'error', code: 'SERVER_ERROR'}], leaks: false, open: true});
+  });
+
+  it('answers list_conversations while a user_message is still streaming, before its stream_end', async () => {
+    const hold = deferred();
+    const streaming: ChatOrchestrator = {
+      processMessage: async () => 'hi',
+      async *processMessageStream(): AsyncGenerator<MessageChunk> {
+        yield {type: 'text', text: 'hi'};
+        await hold.until;
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+    };
+    const {url} = await start(storeWith(THREE_OF_U1_ONE_OF_U2), {history: HISTORY_ON}, streaming);
+    const client = connectClient(url);
+    // Released by the list's arrival, or after a second if it never comes, so a red run reports instead of hanging.
+    const fallback = setTimeout(hold.release, 1000);
+
+    const order = await new Promise<string[]>(resolve => {
+      const seen: string[] = [];
+      client.on('message', raw => {
+        const {type} = JSON.parse(String(raw)) as Frame;
+        if (type === 'connected') {
+          client.send(JSON.stringify({type: 'user_message', content: 'hello'}));
+          client.send(JSON.stringify({type: 'list_conversations'}));
+        }
+        if (type === 'conversation_list' || type === 'stream_end') seen.push(type);
+        if (type === 'conversation_list') hold.release();
+        if (type === 'stream_end') resolve(seen);
+      });
+    });
+    clearTimeout(fallback);
+
+    expect(order).toEqual(['conversation_list', 'stream_end']);
+  });
+});