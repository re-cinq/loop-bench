diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..f98fa74
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,228 @@
+import type {WebSocket} from 'ws';
+import {validateMessage} from './ws/validation.js';
+import {announcedId, connectClient, deferred, startEngineWith, stopEngines} from './wsTestSupport.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {setLogger} from '../shared/logger.js';
+import type {ChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import type {MessageChunk} from '../types/ai.js';
+import type {SessionStore} from '../types/sessionStore.js';
+
+// Acceptance tests for re-cinq/HALEngine#144: a client asks its own conversation list over the socket it already holds.
+
+interface Summary {
+  sessionId: string;
+  createdAt: unknown;
+  updatedAt: unknown;
+  entryCount: number;
+}
+
+interface Frame {
+  type: string;
+  code?: string;
+  message?: string;
+  resumed?: boolean;
+  conversations?: Summary[];
+  entry?: {content?: string};
+}
+
+const HISTORY_ON = {enabled: true};
+const RESUME_ON = {enabled: true};
+
+const errors: Array<Record<string, unknown>> = [];
+const quiet = () => undefined;
+
+// Silenced for the whole file, so a socket closing after a test ends logs nothing; error lines are kept to assert on.
+beforeAll(() => {
+  setLogger({
+    debug: quiet,
+    info: quiet,
+    warn: quiet,
+    error: (category, message, fields) => void errors.push({category, message, ...fields}),
+  });
+});
+
+// Restored only once the last server has seen its sockets close, so no disconnect is logged after the file ends.
+afterAll(async () => {
+  await new Promise(resolve => setTimeout(resolve, 100));
+  setLogger();
+});
+
+afterEach(async () => {
+  errors.length = 0;
+  await stopEngines();
+});
+
+/** Every frame the client receives from now on, in arrival order. */
+function record(client: WebSocket): Frame[] {
+  const frames: Frame[] = [];
+  client.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  return frames;
+}
+
+/** Resolves once a frame of one of the given types has arrived after `from`, or after `ms` without one. */
+async function frameAfter(frames: Frame[], from: number, types: string[], ms = 2000): Promise<Frame | undefined> {
+  for (let waited = 0; waited < ms; waited += 10) {
+    const found = frames.slice(from).find(frame => types.includes(frame.type));
+    if (found) return found;
+    await new Promise(resolve => setTimeout(resolve, 10));
+  }
+  return undefined;
+}
+
+async function open(url: string): Promise<{client: WebSocket; frames: Frame[]; sessionId: () => string}> {
+  const client = connectClient(url);
+  const sessionId = announcedId(client);
+  const frames = record(client);
+  await frameAfter(frames, 0, ['connected']);
+  return {client, frames, sessionId};
+}
+
+/** Sends one frame and returns every frame that answered it, up to the pong of a ping sent once it was answered. */
+async function ask(client: WebSocket, frames: Frame[], frame: Record<string, unknown>): Promise<Frame[]> {
+  const from = frames.length;
+  client.send(JSON.stringify(frame));
+  await frameAfter(frames, from, ['conversation_list', 'error']);
+  client.send(JSON.stringify({type: 'ping', timestamp: 1}));
+  await frameAfter(frames, from, ['pong']);
+  return frames.slice(from);
+}
+
+// Three conversations for the connecting user, at known activity times, and a newer one of somebody else's.
+function seededStore(): InMemorySessionStore {
+  const store = new InMemorySessionStore();
+  const seed = (sessionId: string, userId: string, timestamp: string) =>
+    store.create(sessionId, userId).entries.push({role: 'user', content: sessionId, timestamp});
+  seed('conv-a', 'u1', '2026-11-01T08:00:00.000Z');
+  seed('conv-b', 'u1', '2026-11-02T08:00:00.000Z');
+  seed('conv-c', 'u1', '2026-11-03T08:00:00.000Z');
+  seed('conv-x', 'u2', '2026-11-04T08:00:00.000Z');
+  return store;
+}
+
+describe('list_conversations (re-cinq/HALEngine#144)', () => {
+  it('accepts a list_conversations frame and refuses a bad limit or cursor, naming the field', () => {
+    expect(validateMessage({type: 'list_conversations'}).valid).toBe(true);
+    const cursor = {updatedAt: '2026-11-02T08:00:00.000Z', sessionId: 'conv-b'};
+    expect(validateMessage({type: 'list_conversations', limit: 200, before: cursor}).valid).toBe(true);
+
+    for (const limit of [0, 201, 1.5, '10']) {
+      const result = validateMessage({type: 'list_conversations', limit});
+      expect(result).toEqual({valid: false, error: expect.stringContaining('limit')});
+    }
+    const badCursors = ['not a date', {updatedAt: 'not a date', sessionId: 'conv-b'}, {updatedAt: cursor.updatedAt}];
+    for (const before of badCursors) {
+      const result = validateMessage({type: 'list_conversations', before});
+      expect(result).toEqual({valid: false, error: expect.stringContaining('before')});
+    }
+  });
+
+  it("answers the connection's own user, newest first in ISO strings, pages as asked, and a row reopens by its id", async () => {
+    // A const, not a literal, so the option this change adds is not refused by the excess-property check.
+    const options1 = {sessionStore: seededStore(), resume: RESUME_ON, history: HISTORY_ON};
+    const {url} = await startEngineWith(options1);
+    const {client, frames} = await open(`${url}?sessionId=conv-a`);
+
+    const answer = await ask(client, frames, {type: 'list_conversations', userId: 'u2'});
+    expect(answer.map(frame => frame.type)).toEqual(['conversation_list', 'pong']);
+    const rows = answer[0].conversations ?? [];
+    expect(rows.map(row => row.sessionId)).toEqual(['conv-c', 'conv-b', 'conv-a']);
+    expect(rows[0]).toEqual({
+      sessionId: 'conv-c',
+      createdAt: expect.any(String),
+      updatedAt: '2026-11-03T08:00:00.000Z',
+      entryCount: 1,
+    });
+    for (const row of rows) expect(new Date(row.createdAt as string).toISOString()).toBe(row.createdAt);
+
+    const page = await ask(client, frames, {
+      type: 'list_conversations',
+      limit: 1,
+      before: {updatedAt: rows[0].updatedAt, sessionId: rows[0].sessionId},
+    });
+    expect(page[0].conversations?.map(row => row.sessionId)).toEqual(['conv-b']);
+
+    const reopened = await open(`${url}?sessionId=${rows[0].sessionId}`);
+    await frameAfter(reopened.frames, 0, ['entry_upsert']);
+    expect(reopened.frames[0]).toMatchObject({type: 'connected', resumed: true});
+    expect(reopened.frames.find(frame => frame.type === 'entry_upsert')?.entry?.content).toBe('conv-c');
+  });
+
+  it('refuses with an error rather than an empty list when history is off, the store cannot list, or listFor fails', async () => {
+    const refusals: Frame[][] = [];
+
+    // A const, not a literal, so the option this change adds is not refused by the excess-property check.
+    const options2 = {sessionStore: seededStore()};
+    const off = await startEngineWith(options2);
+    const offClient = await open(off.url);
+    refusals.push(await ask(offClient.client, offClient.frames, {type: 'list_conversations'}));
+
+    const unlisting = seededStore() as SessionStore;
+    const noListFor: SessionStore = {
+      create: (id, userId, options) => unlisting.create(id, userId, options),
+      get: id => unlisting.get(id),
+      delete: id => unlisting.delete(id),
+      count: () => unlisting.count(),
+      clear: () => unlisting.clear(),
+    };
+    // A const, not a literal, so the option this change adds is not refused by the excess-property check.
+    const options3 = {sessionStore: noListFor, history: HISTORY_ON};
+    const cannot = await startEngineWith(options3);
+    const cannotClient = await open(cannot.url);
+    refusals.push(await ask(cannotClient.client, cannotClient.frames, {type: 'list_conversations'}));
+
+    expect(refusals.map(answer => answer.map(frame => [frame.type, frame.code]))).toEqual([
+      [
+        ['error', 'UNSUPPORTED'],
+        ['pong', undefined],
+      ],
+      [
+        ['error', 'UNSUPPORTED'],
+        ['pong', undefined],
+      ],
+    ]);
+
+    const failing = new InMemorySessionStore();
+    failing.listFor = () => {
+      throw new Error('connection refused by mongodb://secret-host:27017');
+    };
+    // A const, not a literal, so the option this change adds is not refused by the excess-property check.
+    const options4 = {sessionStore: failing, history: HISTORY_ON};
+    const broken = await startEngineWith(options4);
+    const brokenClient = await open(broken.url);
+    const answer = await ask(brokenClient.client, brokenClient.frames, {type: 'list_conversations'});
+
+    expect(answer.map(frame => [frame.type, frame.code])).toEqual([
+      ['error', 'SERVER_ERROR'],
+      ['pong', undefined],
+    ]);
+    expect(answer[0].message).not.toContain('secret-host');
+    expect(errors).toContainEqual(expect.objectContaining({sessionId: brokenClient.sessionId()}));
+  });
+
+  it("answers a list request while the session's turn is still streaming, before its stream_end", async () => {
+    const hold = deferred();
+    const heldOrchestrator: ChatOrchestrator = {
+      processMessage: async () => 'hi',
+      async *processMessageStream(): AsyncGenerator<MessageChunk> {
+        yield {type: 'text', text: 'hi'};
+        await hold.until;
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+    };
+    // A const, not a literal, so the option this change adds is not refused by the excess-property check.
+    const options5 = {sessionStore: seededStore(), orchestrator: heldOrchestrator, history: HISTORY_ON};
+    const {url} = await startEngineWith(options5);
+    const {client, frames} = await open(url);
