+import {jest} from '@jest/globals';
+import {once} from 'node:events';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {setLogger} from '../shared/logger.js';
+import {connectClient, startEngineWith, stopEngines} from './wsTestSupport.js';
+
+// A client's own conversation list over the socket, the one thing a browser cannot get from the store today.
+// `history` is not yet on HalServerOptions, so it is spread in: a spread is not checked for excess properties.
+
+const HISTORY_ON = {history: {enabled: true}};
+const MINUTE = 60_000;
+
+interface Summary {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+
+interface Frame {
+  type: string;
+  sessionId?: string;
+  code?: string;
+  conversations?: Summary[];
+}
+
+// Dated `minutesAgo` before now, so the list's order is set by the dates and not by the clock's resolution.
+function seed(store: InMemorySessionStore, userId: string, sessionId: string, minutesAgo: number): void {
+  const at = Date.now() - minutesAgo * MINUTE;
+  const spy = jest.spyOn(Date, 'now').mockReturnValue(at);
+  try {
+    store.create(sessionId, userId);
+  } finally {
+    spy.mockRestore();
+  }
+}
+
+const until = async (check: () => boolean): Promise<void> => {
+  for (let attempt = 0; attempt < 200 && !check(); attempt++) await new Promise(resolve => setTimeout(resolve, 10));
+};
+
+// Connects, waits for `connected`, asks with `request`, and returns every frame the server sent.
+async function askForList(url: string, request: object): Promise<Frame[]> {
+  const client = connectClient(url);
+  const frames: Frame[] = [];
+  client.on('message', raw => void frames.push(JSON.parse(String(raw)) as Frame));
+  await once(client, 'open');
+  await until(() => frames.some(frame => frame.type === 'connected'));
+  client.send(JSON.stringify(request));
+  await until(() => frames.some(frame => frame.type === 'conversation_list' || frame.type === 'error'));
+  return frames;
+}
+
+const connectedIdOf = (frames: Frame[]): string => frames.find(frame => frame.type === 'connected')?.sessionId ?? '';
+
+describe('the conversation list over the socket', () => {
+  beforeAll(() => {
+    setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined});
+  });
+
+  afterAll(() => {
+    setLogger();
+  });
+
+  afterEach(() => stopEngines());
+
+  it("answers list_conversations with the connecting user's conversations, newest first, times as ISO strings", async () => {
+    const store = new InMemorySessionStore();
+    seed(store, 'u1', 'oldest', 30);
+    seed(store, 'u1', 'middle', 20);
+    seed(store, 'u1', 'newest', 10);
+    const {url} = await startEngineWith({sessionStore: store, ...HISTORY_ON});
+
+    const frames = await askForList(url, {type: 'list_conversations'});
+    const answers = frames.filter(frame => frame.type !== 'connected');
+    const rows = answers[0]?.conversations ?? [];
+
+    expect({
+      frames: answers.map(frame => frame.type),
+      order: rows.map(row => row.sessionId),
+      isoTimes: rows.every(
+        row =>
+          new Date(row.createdAt).toISOString() === row.createdAt &&
+          new Date(row.updatedAt).toISOString() === row.updatedAt
+      ),
+    }).toEqual({
+      frames: ['conversation_list'],
+      // The connection's own session is listed too: it is the user's newest conversation the moment it exists.
+      order: [connectedIdOf(frames), 'newest', 'middle', 'oldest'],
+      isoTimes: true,
+    });
+  });
+
+  it("ignores a userId carried in the frame and answers with the connecting user's own list", async () => {
+    const store = new InMemorySessionStore();
+    seed(store, 'u1', 'mine', 10);
+    seed(store, 'u2', 'theirs', 10);
+    const {url} = await startEngineWith({sessionStore: store, ...HISTORY_ON});
+
+    const frames = await askForList(url, {type: 'list_conversations', userId: 'u2'});
+    const listed = (frames.find(frame => frame.type === 'conversation_list')?.conversations ?? []).map(
+      row => row.sessionId
+    );
+
+    expect(listed.sort()).toEqual([connectedIdOf(frames), 'mine'].sort());
+  });
+
+  it('answers UNSUPPORTED, and no list, when the deployer has not opted in to history', async () => {
+    const store = new InMemorySessionStore();
+    seed(store, 'u1', 'mine', 10);
+    const {url} = await startEngineWith({sessionStore: store});
+
+    const frames = await askForList(url, {type: 'list_conversations'});
+    const answers = frames.filter(frame => frame.type !== 'connected');
+
+    expect(answers.map(frame => [frame.type, frame.code])).toEqual([['error', 'UNSUPPORTED']]);
+  });
+});