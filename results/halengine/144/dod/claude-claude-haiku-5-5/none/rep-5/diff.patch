+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,106 @@
+import {WebSocket} from 'ws';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {connectClient, startEngineWith, stopEngines} from './wsTestSupport.js';
+import type {SessionStore} from '../types/sessionStore.js';
+
+// Acceptance for #144: a client asks for its own conversation list over the socket it already holds.
+
+interface Row {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+
+interface Frame {
+  type: string;
+  sessionId?: string;
+  code?: string;
+  conversations?: Row[];
+}
+
+// Spread, not a literal, so the not-yet-existing option is not an excess-property compile error.
+const historyOn = {history: {enabled: true}};
+
+const servers: Array<Awaited<ReturnType<typeof startEngineWith>>['hal']> = [];
+
+const startEngine = async (store: SessionStore, transport: object = {}): Promise<string> => {
+  const {url, hal} = await startEngineWith({sessionStore: store, ...transport});
+  servers.push(hal);
+  return url;
+};
+
+// Each stored conversation holds one user entry, sent at the given time and reading as its own id.
+const storeWith = (conversations: Array<[sessionId: string, userId: string, sentAt: string]>): InMemorySessionStore => {
+  const store = new InMemorySessionStore();
+  for (const [sessionId, userId, sentAt] of conversations) {
+    const {entries} = store.create(sessionId, userId);
+    entries.push({role: 'user', content: sessionId, timestamp: sentAt});
+  }
+  return store;
+};
+
+// A ping sent after the answer is a barrier: its pong can only follow that answer.
+const askAndSettle = async (url: string, request: object): Promise<Frame[]> => {
+  const client = connectClient(url);
+  const frames: Frame[] = [];
+  await new Promise<void>(resolve => {
+    client.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as Frame;
+      frames.push(frame);
+      if (frame.type === 'connected') client.send(JSON.stringify(request));
+      if (frame.type === 'conversation_list' || frame.type === 'error')
+        client.send(JSON.stringify({type: 'ping', timestamp: 1}));
+      if (frame.type === 'pong') resolve();
+    });
+  });
+  return frames;
+};
+
+afterEach(async () => {
+  await stopEngines();
+  servers.splice(0);
+});
+
+describe('listing a user conversations over the WebSocket', () => {
+  it("answers a list_conversations frame with the connection's own conversations, newest first, as ISO times and no stream_end", async () => {
+    const store = storeWith([
+      ['older', 'u1', '2026-09-28T08:00:00.000Z'],
+      ['newest', 'u1', '2026-09-30T08:00:00.000Z'],
+      ['middle', 'u1', '2026-09-29T08:00:00.000Z'],
+      ['theirs', 'u2', '2026-09-30T09:00:00.000Z'],
+    ]);
+    const url = await startEngine(store, historyOn);
+
+    // The frame names another user; the answer must still be the connecting user's, read from the connection.
+    const frames = await askAndSettle(url, {type: 'list_conversations', userId: 'u2'});
+
+    const connectedId = frames[0].sessionId;
+    const list = frames.find(frame => frame.type === 'conversation_list');
+    const isoTime = (time: string) => new Date(time).toISOString() === time;
+    expect({
+      types: frames.map(frame => frame.type),
+      rows: list?.conversations?.map(row => row.sessionId),
+      timesAreIso: list?.conversations?.every(row => isoTime(row.createdAt) && isoTime(row.updatedAt)),
+    }).toEqual({
+      types: ['connected', 'conversation_list', 'pong'],
+      // The connection's own conversation is a row like any other, and it is the newest the moment it exists.
+      rows: [connectedId, 'newest', 'middle', 'older'],
+      timesAreIso: true,
+    });
+  });
+
+  it('answers a list_conversations frame with an UNSUPPORTED error and no list while history is off', async () => {
+    const url = await startEngine(storeWith([['only', 'u1', '2026-09-30T08:00:00.000Z']]));
+
+    const frames = await askAndSettle(url, {type: 'list_conversations'});
+
+    expect({
+      types: frames.map(frame => frame.type),
+      code: frames.find(frame => frame.type === 'error')?.code,
+    }).toEqual({
+      types: ['connected', 'error', 'pong'],
+      code: 'UNSUPPORTED',
+    });
+  });
+});