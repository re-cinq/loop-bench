+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import type {Express} from 'express';
+import {createServer} from '../createServer.js';
+import type {HalServer} from '../createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './subprotocol.js';
+import {answeringOrchestrator} from '../wsTestSupport.js';
+import {InMemorySessionStore} from '../../infrastructure/stores/inMemorySessionStore.js';
+import {setLogger} from '../../shared/logger.js';
+
+// Acceptance for #144: a client on the socket asks for its user's conversation list and is answered over that same socket.
+
+interface Row {
+  sessionId: string;
+  createdAt: unknown;
+  updatedAt: unknown;
+  entryCount: number;
+}
+
+interface Frame {
+  type: string;
+  sessionId?: string;
+  conversations?: Row[];
+  code?: string;
+}
+
+const servers: HalServer[] = [];
+const clients: WebSocket[] = [];
+
+// Silenced for the file: Jest isolates the module registry per file, so no restore is needed and no late close logs after the run.
+beforeAll(() => {
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined});
+});
+
+afterEach(async () => {
+  for (const client of clients.splice(0)) client.terminate();
+  for (const hal of servers.splice(0)) await hal.stop();
+});
+
+// Each conversation's activity is its newest entry, so these stamps fix the order the list must answer in.
+const seed = (store: InMemorySessionStore, userId: string, stamps: Array<[string, string]>): void => {
+  for (const [sessionId, timestamp] of stamps) {
+    store.create(sessionId, userId).entries.push({role: 'user', content: 'hi', timestamp});
+  }
+};
+
+const startWithHistory = async (store: InMemorySessionStore): Promise<string> => {
+  // Built as a variable so the option reaches createServer without tripping its excess-property check.
+  const options = {
+    app: (() => undefined) as unknown as Express,
+    wsAuth: async () => ({id: 'u1'}),
+    sessionStore: store,
+    orchestrator: answeringOrchestrator,
+    history: {enabled: true},
+  };
+  const hal = createServer(options);
+  await hal.start(0);
+  servers.push(hal);
+  const {port} = hal.server.address() as AddressInfo;
+  return `ws://127.0.0.1:${port}/hal/ws/c1`;
+};
+
+// Every frame the client receives, in order, so a test can take the next one whatever its type.
+const inboxOf = (client: WebSocket): {next: () => Promise<Frame>} => {
+  const queued: Frame[] = [];
+  let wake: (() => void) | undefined;
+  client.on('message', raw => {
+    queued.push(JSON.parse(String(raw)) as Frame);
+    wake?.();
+  });
+  const next = async (): Promise<Frame> => {
+    while (queued.length === 0) await new Promise<void>(resolve => (wake = () => resolve()));
+    return queued.shift() as Frame;
+  };
+  return {next};
+};
+
+// Opens a socket, reads its `connected` frame and asks for the list with the given frame body.
+const askForList = async (url: string, body: Record<string, unknown>) => {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 't']);
+  clients.push(client);
+  const inbox = inboxOf(client);
+  await new Promise<void>(resolve => client.once('open', () => resolve()));
+  const connected = await inbox.next();
+  client.send(JSON.stringify({type: 'list_conversations', ...body}));
+  const reply = await inbox.next();
+  // The connection's own conversation is listed like any other, so the tests set it aside to read the seeded rows.
+  const others = (reply.conversations ?? []).filter(row => row.sessionId !== connected.sessionId);
+  return {reply, others};
+};
+
+const isoTime = (value: unknown): boolean => typeof value === 'string' && Number.isFinite(Date.parse(value));
+
+describe('a client lists its own conversations over the socket', () => {
+  it("answers the connection's user's conversations newest first, with ISO-string times and no stream_end", async () => {
+    const store = new InMemorySessionStore();
+    seed(store, 'u1', [
+      ['u1-oldest', '2026-01-01T00:00:00.000Z'],
+      ['u1-middle', '2026-02-01T00:00:00.000Z'],
+      ['u1-newest', '2026-03-01T00:00:00.000Z'],
+    ]);
+    const url = await startWithHistory(store);
+
+    const {reply, others} = await askForList(url, {});
+
+    expect({
+      type: reply.type,
+      code: reply.code,
+      order: others.map(row => row.sessionId),
+      isoTimes: others.every(row => isoTime(row.createdAt) && isoTime(row.updatedAt)),
+    }).toEqual({
+      type: 'conversation_list',
+      code: undefined,
+      order: ['u1-newest', 'u1-middle', 'u1-oldest'],
+      isoTimes: true,
+    });
+  });
+
+  it("answers with the connecting user's own list even when the frame names another user", async () => {
+    const store = new InMemorySessionStore();
+    seed(store, 'u1', [['u1-only', '2026-01-01T00:00:00.000Z']]);
+    seed(store, 'u2', [['u2-private', '2026-02-01T00:00:00.000Z']]);
+    const url = await startWithHistory(store);
+
+    const {reply, others} = await askForList(url, {userId: 'u2'});
+
+    expect({type: reply.type, order: others.map(row => row.sessionId)}).toEqual({
+      type: 'conversation_list',
+      order: ['u1-only'],
+    });
+  });
+});