+++ b/src/transport/listConversations.acceptance.test.ts
@@ -0,0 +1,130 @@
+import {jest} from '@jest/globals';
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import type {Express} from 'express';
+import {createServer} from './createServer.js';
+import type {HalServer} from './createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {answeringOrchestrator} from './wsTestSupport.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {setLogger} from '../shared/logger.js';
+
+// Real upgrades over a real socket: the list a client is sent over the wire is the contract, and no double can observe it.
+
+interface Frame {
+  type: string;
+  sessionId?: string;
+  code?: string;
+  conversations?: Array<{sessionId: string; createdAt: string; updatedAt: string; entryCount: number}>;
+}
+
+const USER = 'u1';
+const OTHER_USER = 'u2';
+
+const servers: HalServer[] = [];
+const clients: WebSocket[] = [];
+
+// Silenced for the whole file: the server logs every connection, and these tests read frames, not logs.
+beforeAll(() => {
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined});
+});
+
+afterAll(() => {
+  setLogger();
+});
+
+// Each server sees its sockets close before it stops, so no close is logged after the logger above is restored.
+afterEach(async () => {
+  for (const client of clients.splice(0)) client.terminate();
+  for (const hal of servers.splice(0)) {
+    for (let attempt = 0; attempt < 50 && hal.wss.clients.size > 0; attempt++) {
+      await new Promise(resolve => setTimeout(resolve, 10));
+    }
+    await hal.stop();
+  }
+});
+
+// The authenticated user is the one the upgrade names; the store is real, seeded before any socket opens.
+const startEngine = async (store: InMemorySessionStore, history?: {enabled: boolean}) => {
+  const hal = createServer({
+    app: (() => undefined) as unknown as Express,
+    wsAuth: async () => ({id: USER}),
+    sessionStore: store,
+    orchestrator: answeringOrchestrator,
+    history,
+  });
+  await hal.start(0);
+  servers.push(hal);
+  const {port} = hal.server.address() as AddressInfo;
+  return `ws://127.0.0.1:${port}/hal/ws/c1`;
+};
+
+// Opens a client, sends one frame once `connected` arrives, and resolves with the frames that answer it.
+const askFor = (url: string, question: Record<string, unknown>): Promise<Frame[]> => {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 't']);
+  clients.push(client);
+  return new Promise<Frame[]>(resolve => {
+    const frames: Frame[] = [];
+    client.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as Frame;
+      frames.push(frame);
+      if (frame.type === 'connected') client.send(JSON.stringify(question));
+      if (frame.type === 'conversation_list' || frame.type === 'error') resolve(frames.slice(1));
+    });
+  });
+};
+
+// Seeds a conversation whose last activity is `at`, so the order a list answers in is the order the test sets.
+const seed = (store: InMemorySessionStore, sessionId: string, userId: string, at: string): void => {
+  const session = store.create(sessionId, userId);
+  session.entries.push({role: 'user', content: 'hello', timestamp: at});
+};
+
+describe('list_conversations over the WebSocket', () => {
+  it('answers the connecting user’s conversations as one conversation_list, newest first, with ISO times', async () => {
+    const store = new InMemorySessionStore();
+    seed(store, 'conv-oldest', USER, '2026-01-01T10:00:00.000Z');
+    seed(store, 'conv-middle', USER, '2026-01-02T10:00:00.000Z');
+    seed(store, 'conv-newest', USER, '2026-01-03T10:00:00.000Z');
+    const url = await startEngine(store, {enabled: true});
+
+    const frames = await askFor(url, {type: 'list_conversations'});
+
+    expect(frames.map(frame => frame.type)).toEqual(['conversation_list']);
+    const rows = frames[0].conversations ?? [];
+    const seeded = rows.map(row => row.sessionId).filter(id => id.startsWith('conv-'));
+    expect(seeded).toEqual(['conv-newest', 'conv-middle', 'conv-oldest']);
+    for (const row of rows) {
+      expect(new Date(row.createdAt).toISOString()).toBe(row.createdAt);
+      expect(new Date(row.updatedAt).toISOString()).toBe(row.updatedAt);
+    }
+  });
+
+  it('ignores a userId in the frame and lists by the connection’s authenticated user', async () => {
+    const store = new InMemorySessionStore();
+    seed(store, 'conv-mine', USER, '2026-01-01T10:00:00.000Z');
+    seed(store, 'conv-theirs', OTHER_USER, '2026-01-02T10:00:00.000Z');
+    const listFor = jest.spyOn(store, 'listFor');
+    const url = await startEngine(store, {enabled: true});
+
+    const frames = await askFor(url, {type: 'list_conversations', userId: OTHER_USER});
+
+    expect(frames.map(frame => frame.type)).toEqual(['conversation_list']);
+    const ids = (frames[0].conversations ?? []).map(row => row.sessionId);
+    expect(ids).toContain('conv-mine');
+    expect(ids).not.toContain('conv-theirs');
+    expect(listFor.mock.calls[0]?.[0]).toBe(USER);
+  });
+
+  it('answers UNSUPPORTED with no conversation_list when transport.history is absent', async () => {
+    const store = new InMemorySessionStore();
+    seed(store, 'conv-mine', USER, '2026-01-01T10:00:00.000Z');
+    const url = await startEngine(store);
+
+    const frames = await askFor(url, {type: 'list_conversations'});
+
+    expect(frames.map(frame => frame.type)).toEqual(['error']);
+    expect(frames[0].code).toBe('UNSUPPORTED');
+  });
+});