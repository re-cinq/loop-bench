+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {setLogger} from '../shared/logger.js';
+import {startEngineWith, stopEngines, connectClient} from './wsTestSupport.js';
+
+// Acceptance for #144: a client asks over the socket which conversations its user has, and is answered from the
+// connection's own user. Real upgrade, real socket, the engine's own store; nothing here is a double.
+
+interface Frame {
+  type: string;
+  code?: string;
+  conversations?: Array<{sessionId: string; createdAt: unknown; updatedAt: unknown; entryCount: number}>;
+}
+
+// Spread in rather than written as a literal: the `history` option is the one this ticket adds, so it is not yet on
+// HalServerOptions, and a spread is the form that reaches the engine without a type error standing in for the red.
+const historyOn = {history: {enabled: true}};
+
+const at = (second: number): string => new Date(Date.UTC(2026, 0, 1, 0, 0, second)).toISOString();
+
+// Each conversation's activity is its newest entry, so the three are ordered by when the user last spoke in them.
+const seedStore = (): InMemorySessionStore => {
+  const store = new InMemorySessionStore();
+  store.create('conv-a', 'u1').entries.push({role: 'user', content: 'a', timestamp: at(1)});
+  store.create('conv-b', 'u1').entries.push({role: 'user', content: 'b', timestamp: at(2)});
+  store.create('conv-c', 'u1').entries.push({role: 'user', content: 'c', timestamp: at(3)});
+  store.create('someone-elses', 'u2').entries.push({role: 'user', content: 'x', timestamp: at(4)});
+  return store;
+};
+
+// Sends one frame after the connected greeting, and resolves with the first answer that is either a list or an error.
+const askForList = (url: string, frame: unknown): Promise<Frame> => {
+  const client = connectClient(url);
+  return new Promise<Frame>((resolve, reject) => {
+    const timer = setTimeout(() => reject(new Error('no list or error answer within 2s')), 2000);
+    client.on('message', raw => {
+      const message = JSON.parse(String(raw)) as Frame;
+      if (message.type === 'connected') client.send(JSON.stringify(frame));
+      if (message.type === 'conversation_list' || message.type === 'error') {
+        clearTimeout(timer);
+        resolve(message);
+      }
+    });
+  });
+};
+
+beforeAll(() => {
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined});
+});
+
+afterAll(() => {
+  setLogger();
+});
+
+afterEach(async () => {
+  await stopEngines();
+});
+
+describe('a client lists its own conversations over the socket', () => {
+  it("is answered with one conversation_list of its user's conversations, newest first, with ISO times", async () => {
+    const {url} = await startEngineWith({sessionStore: seedStore(), ...historyOn});
+
+    const answer = await askForList(url, {type: 'list_conversations'});
+
+    expect(answer).toMatchObject({type: 'conversation_list'});
+    expect(answer.conversations?.map(row => row.sessionId)).toEqual(['conv-c', 'conv-b', 'conv-a']);
+    expect(
+      answer.conversations?.every(
+        row =>
+          typeof row.createdAt === 'string' &&
+          typeof row.updatedAt === 'string' &&
+          new Date(row.createdAt).toISOString() === row.createdAt &&
+          new Date(row.updatedAt as string).toISOString() === row.updatedAt
+      )
+    ).toBe(true);
+  });
+
+  it("is answered with the connecting user's list even when the frame names another user", async () => {
+    const {url} = await startEngineWith({sessionStore: seedStore(), ...historyOn});
+
+    const answer = await askForList(url, {type: 'list_conversations', userId: 'u2'});
+
+    expect(answer).toMatchObject({type: 'conversation_list'});
+    expect(answer.conversations?.map(row => row.sessionId)).toEqual(['conv-c', 'conv-b', 'conv-a']);
+  });
+});