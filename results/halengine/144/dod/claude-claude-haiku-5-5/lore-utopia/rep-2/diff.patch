+import type {WebSocket} from 'ws';
+import {connectClient, startEngineWith, stopEngines} from './wsTestSupport.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {SessionEntry} from '../types/session.js';
+import {setLogger} from '../shared/logger.js';
+
+// Acceptance tests for re-cinq/HALEngine#144: a connected client asks the socket for its user's conversations.
+
+interface Frame {
+  type: string;
+  [key: string]: unknown;
+}
+
+const HISTORY_ON = {history: {enabled: true}};
+
+const at = (second: number): string => new Date(Date.UTC(2026, 0, 1, 0, 0, second)).toISOString();
+const turn = (second: number): SessionEntry => ({role: 'user', content: 'hello', timestamp: at(second)});
+const isIsoString = (value: unknown): boolean =>
+  typeof value === 'string' && Number.isFinite(Date.parse(value)) && new Date(value).toISOString() === value;
+
+// Every frame the socket receives, from the connect on, until the first answer to a list request.
+function framesUntilAnswer(client: WebSocket): Promise<Frame[]> {
+  const seen: Frame[] = [];
+  return new Promise<Frame[]>(resolve => {
+    client.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as Frame;
+      seen.push(frame);
+      if (frame.type === 'conversation_list' || frame.type === 'error') resolve(seen);
+    });
+  });
+}
+
+// The connection's own conversation is listed like any other, so it is set aside by the id its `connected` frame names.
+function otherRowsOf(frames: Frame[]): Array<Record<string, unknown>> {
+  const own = frames.find(frame => frame.type === 'connected')?.sessionId;
+  const list = frames.find(frame => frame.type === 'conversation_list');
+  const rows = (list?.conversations ?? []) as Array<Record<string, unknown>>;
+  return rows.filter(row => row.sessionId !== own);
+}
+
+describe('a client listing its conversations over the WebSocket', () => {
+  // The server logs every connection and frame; these tests read frames, not logs.
+  beforeAll(() => {
+    setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined});
+  });
+
+  afterEach(async () => {
+    await stopEngines();
+  });
+
+  it('is answered with its user conversations, newest first, with ISO times and no stream_end', async () => {
+    const store = new InMemorySessionStore();
+    store.create('older', 'u1').entries.push(turn(1));
+    store.create('middle', 'u1').entries.push(turn(2));
+    store.create('newest', 'u1').entries.push(turn(3), turn(4));
+    const {url} = await startEngineWith({sessionStore: store, ...HISTORY_ON});
+
+    const client = connectClient(url);
+    const answer = framesUntilAnswer(client);
+    client.once('open', () => client.send(JSON.stringify({type: 'list_conversations'})));
+    const frames = await answer;
+
+    const rows = otherRowsOf(frames);
+    expect({
+      answers: frames.filter(frame => frame.type === 'conversation_list').length,
+      streamEnds: frames.filter(frame => frame.type === 'stream_end').length,
+      rows: rows.map(row => ({sessionId: row.sessionId, entryCount: row.entryCount, updatedAt: row.updatedAt})),
+      timesAreIso: rows.every(row => isIsoString(row.createdAt) && isIsoString(row.updatedAt)),
+    }).toEqual({
+      answers: 1,
+      streamEnds: 0,
+      rows: [
+        {sessionId: 'newest', entryCount: 2, updatedAt: at(4)},
+        {sessionId: 'middle', entryCount: 1, updatedAt: at(2)},
+        {sessionId: 'older', entryCount: 1, updatedAt: at(1)},
+      ],
+      timesAreIso: true,
+    });
+  });
+
+  it('lists the connecting user, never the user named in the frame', async () => {
+    const store = new InMemorySessionStore();
+    store.create('mine', 'u1').entries.push(turn(1));
+    store.create('theirs', 'u2').entries.push(turn(2));
+    const {url} = await startEngineWith({sessionStore: store, ...HISTORY_ON});
+
+    const client = connectClient(url);
+    const answer = framesUntilAnswer(client);
+    client.once('open', () => client.send(JSON.stringify({type: 'list_conversations', userId: 'u2'})));
+    const frames = await answer;
+
+    expect({
+      errors: frames.filter(frame => frame.type === 'error'),
+      sessionIds: otherRowsOf(frames).map(row => row.sessionId),
+    }).toEqual({errors: [], sessionIds: ['mine']});
+  });
+});