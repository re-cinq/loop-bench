+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {connectClient, startEngineWith, stopEngines} from './wsTestSupport.js';
+
+// Real upgrades over a real socket: the frame a client sends and the frame it gets back are the contract.
+
+interface Frame {
+  type: string;
+  conversations?: Array<{sessionId: string; createdAt: string; updatedAt: string; entryCount: number}>;
+  code?: string;
+}
+
+afterEach(stopEngines);
+
+// Resolves with the first frame of one of the given types, attached before anything is sent so none is missed.
+function nextFrame(client: WebSocket, types: string[]): Promise<Frame> {
+  return new Promise<Frame>(resolve => {
+    client.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as Frame;
+      if (types.includes(frame.type)) resolve(frame);
+    });
+  });
+}
+
+// Opens a client once its `connected` frame has arrived, so the list request is never sent before the handler is up.
+async function connectedClient(url: string): Promise<WebSocket> {
+  const client = connectClient(url);
+  await nextFrame(client, ['connected']);
+  return client;
+}
+
+describe('a client asks the socket for its own conversation list', () => {
+  it('is answered with one conversation_list of the connecting user’s conversations, as ISO-dated summaries', async () => {
+    const store = new InMemorySessionStore();
+    store.create('conv-a', 'u1');
+    store.create('conv-b', 'u1');
+    store.create('conv-c', 'u1');
+    const url = await startEngineWith({sessionStore: store, history: {enabled: true}}).then(({url}) => url);
+    const client = await connectedClient(url);
+
+    const answer = nextFrame(client, ['conversation_list', 'error']);
+    client.send(JSON.stringify({type: 'list_conversations'}));
+    const frame = await answer;
+
+    const expected = store.listFor('u1').map(summary => summary.sessionId);
+    expect({
+      type: frame.type,
+      ids: frame.conversations?.map(summary => summary.sessionId),
+      datesAreIso: frame.conversations?.every(
+        summary =>
+          new Date(summary.createdAt).toISOString() === summary.createdAt &&
+          new Date(summary.updatedAt).toISOString() === summary.updatedAt
+      ),
+    }).toEqual({type: 'conversation_list', ids: expected, datesAreIso: true});
+    expect(expected).toEqual(expect.arrayContaining(['conv-a', 'conv-b', 'conv-c']));
+  });
+
+  it('answers with the connecting user list even when the frame names another user', async () => {
+    const store = new InMemorySessionStore();
+    store.create('mine', 'u1');
+    store.create('theirs', 'u2');
+    const url = await startEngineWith({sessionStore: store, history: {enabled: true}}).then(({url}) => url);
+    const client = await connectedClient(url);
+
+    const answer = nextFrame(client, ['conversation_list', 'error']);
+    client.send(JSON.stringify({type: 'list_conversations', userId: 'u2'}));
+    const frame = await answer;
+
+    expect(frame.type).toBe('conversation_list');
+    const ids = frame.conversations?.map(summary => summary.sessionId) ?? [];
+    expect(ids).toContain('mine');
+    expect(ids).not.toContain('theirs');
+  });
+});