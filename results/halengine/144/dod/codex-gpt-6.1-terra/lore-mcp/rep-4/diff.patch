@@ -0,0 +1,102 @@
+import {validateMessage} from './ws/validation.js';
+import {connectClient, startEngineWith, stopEngines} from './wsTestSupport.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {SessionListOptions, SessionStore} from '../types/sessionStore.js';
+
+// specs/hal-engine-websocket-protocol/spec.md
+
+afterEach(async () => stopEngines());
+
+class RecordingStore extends InMemorySessionStore {
+  calls: Array<{userId: string | number; options?: SessionListOptions}> = [];
+  override listFor(userId: string | number, options?: SessionListOptions) {
+    this.calls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+const request = async (store: SessionStore, enabled: boolean, payload: object) => {
+  const options = {sessionStore: store, ...(enabled ? {history: {enabled: true}} : {}), resume: {enabled: true}};
+  const {url} = await startEngineWith(options);
+  const client = connectClient(url);
+  return new Promise<Array<Record<string, unknown>>>(resolve => {
+    const frames: Array<Record<string, unknown>> = [];
+    client.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as Record<string, unknown>;
+      if (frame.type === 'connected') {
+        client.send(JSON.stringify(payload));
+        client.send(JSON.stringify({type: 'ping', timestamp: 1}));
+      } else if (frame.type === 'pong') resolve(frames);
+      else frames.push(frame);
+    });
+  });
+};
+
+describe('conversation lists over WebSocket', () => {
+  it('validates the list frame and its composite cursor independently of configuration', () => {
+    const before = {updatedAt: '2090-01-01T00:00:00.000Z', sessionId: 's1'};
+    expect(validateMessage({type: 'list_conversations'})).toEqual({valid: true, data: {type: 'list_conversations'}});
+    expect(validateMessage({type: 'list_conversations', limit: 1, before, userId: 'other'})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations', limit: 1, before},
+    });
+    for (const limit of [0, 201, 1.5, '10']) {
+      expect(validateMessage({type: 'list_conversations', limit})).toEqual({
+        valid: false,
+        error: expect.stringMatching(/limit/i),
+      });
+    }
+    for (const cursor of [
+      'not a date',
+      {updatedAt: 'bad', sessionId: 's1'},
+      {updatedAt: before.updatedAt},
+      {sessionId: 's1'},
+    ]) {
+      expect(validateMessage({type: 'list_conversations', before: cursor})).toEqual({
+        valid: false,
+        error: expect.stringMatching(/before/i),
+      });
+    }
+  });
+
+  it('answers only the authenticated user with wire summaries and passes the requested page to the store', async () => {
+    const store = new RecordingStore();
+    store.create('older', 'u1').entries.push({role: 'user', content: 'private', timestamp: '2090-01-01T00:00:00.000Z'});
+    store.create('newer', 'u1').entries.push({role: 'user', content: 'private', timestamp: '2090-01-02T00:00:00.000Z'});
+    store.create('theirs', 'u2');
+    const before = {updatedAt: '2099-01-01T00:00:00.000Z', sessionId: 'z'};
+    const frames = await request(store, true, {type: 'list_conversations', userId: 'u2', limit: 2, before});
+    const rows = store
+      .listFor('u1', {limit: 2, before})
+      .map(row => ({...row, createdAt: row.createdAt.toISOString(), updatedAt: row.updatedAt.toISOString()}));
+    expect(frames).toEqual([{type: 'conversation_list', conversations: rows}]);
+    expect(store.calls[0]).toEqual({userId: 'u1', options: {limit: 2, before}});
+    expect(rows.map(row => row.sessionId)).toEqual(['newer', 'older']);
+  });
+
+  it('refuses a list when history is disabled', async () => {
+    const frames = await request(new InMemorySessionStore(), false, {type: 'list_conversations'});
+    expect(frames).toEqual([{type: 'error', code: 'UNSUPPORTED', message: expect.any(String)}]);
+  });
+  it('reports unavailable and failing stores without presenting an empty history', async () => {
+    const backing = new InMemorySessionStore();
+    const withoutList: SessionStore = {
+      create: backing.create.bind(backing),
+      get: backing.get.bind(backing),
+      delete: backing.delete.bind(backing),
+      count: backing.count.bind(backing),
+      clear: backing.clear.bind(backing),
+    };
+    const unsupported = await request(withoutList, true, {type: 'list_conversations'});
+    expect(unsupported).toEqual([{type: 'error', code: 'UNSUPPORTED', message: expect.any(String)}]);
+    class FailingStore extends InMemorySessionStore {
+      override listFor(): never {
+        throw new Error('private database detail');
+      }
+    }
+    const failed = await request(new FailingStore(), true, {type: 'list_conversations'});
+    expect(failed).toEqual([
+      {type: 'error', code: 'SERVER_ERROR', message: expect.not.stringContaining('private database detail')},
+    ]);
+  });
+});