@@ -0,0 +1,90 @@
+import type {AddressInfo} from 'node:net';
+import type {Express} from 'express';
+import {WebSocket} from 'ws';
+import {createServer} from './createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+import {answeringOrchestrator} from './wsTestSupport.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+
+// specs/hal-engine-websocket-protocol/spec.md#conversation-list-validation
+it('validates conversation list requests and their composite cursors', () => {
+  expect(validateMessage({type: 'list_conversations'})).toEqual({valid: true, data: {type: 'list_conversations'}});
+  for (const limit of [0, 201, 1.5, '10']) {
+    expect(validateMessage({type: 'list_conversations', limit})).toEqual({
+      valid: false,
+      error: expect.stringMatching(/limit/i),
+    });
+  }
+  for (const before of [
+    'not a date',
+    {updatedAt: 'bad', sessionId: 'a'},
+    {updatedAt: '2026-01-01T00:00:00.000Z'},
+    {sessionId: 'a'},
+  ]) {
+    expect(validateMessage({type: 'list_conversations', before})).toEqual({
+      valid: false,
+      error: expect.stringMatching(/before/i),
+    });
+  }
+  const before = {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: 'a'};
+  expect(validateMessage({type: 'list_conversations', limit: 1, before, userId: 'other'})).toEqual({
+    valid: true,
+    data: {type: 'list_conversations', limit: 1, before},
+  });
+});
+
+async function request(history: boolean, payload: object): Promise<Array<Record<string, unknown>>> {
+  const store = new InMemorySessionStore();
+  store.create('owned', 'alice');
+  store.create('private', 'bob');
+  const options = {
+    app: (() => undefined) as unknown as Express,
+    wsAuth: async () => ({id: 'alice'}),
+    sessionStore: store,
+    orchestrator: answeringOrchestrator,
+    history: {enabled: history},
+  };
+  const server = createServer(options);
+  await server.start(0);
+  const {port} = server.server.address() as AddressInfo;
+  const client = new WebSocket(`ws://127.0.0.1:${port}/hal/ws`, [HAL_WS_SUBPROTOCOL, 'token']);
+  try {
+    return await new Promise((resolve, reject) => {
+      const frames: Array<Record<string, unknown>> = [];
+      client.on('error', reject);
+      client.on('message', raw => {
+        const frame = JSON.parse(String(raw)) as Record<string, unknown>;
+        if (frame.type === 'connected') {
+          client.send(JSON.stringify(payload));
+          client.send(JSON.stringify({type: 'ping', timestamp: 1}));
+        } else if (frame.type === 'pong') resolve(frames);
+        else frames.push(frame);
+      });
+    });
+  } finally {
+    client.terminate();
+    await server.stop();
+  }
+}
+
+// specs/hal-engine-websocket-protocol/spec.md#conversation-list-delivery
+it('delivers only the authenticated user’s summaries when history is enabled', async () => {
+  const frames = await request(true, {type: 'list_conversations', userId: 'bob'});
+  expect(frames).toEqual([{type: 'conversation_list', conversations: expect.any(Array)}]);
+  const rows = frames[0].conversations as Array<Record<string, unknown>>;
+  expect(rows).toHaveLength(2);
+  expect(rows.map(row => row.sessionId)).toContain('owned');
+  expect(rows.map(row => row.sessionId)).not.toContain('private');
+  for (const row of rows) {
+    expect(Object.keys(row).sort()).toEqual(['createdAt', 'entryCount', 'sessionId', 'updatedAt']);
+    expect(new Date(row.createdAt as string).toISOString()).toBe(row.createdAt);
+    expect(new Date(row.updatedAt as string).toISOString()).toBe(row.updatedAt);
+  }
+});
+
+// specs/hal-engine-websocket-protocol/spec.md#conversation-list-opt-in
+it('refuses a conversation list when history is disabled', async () => {
+  const frames = await request(false, {type: 'list_conversations'});
+  expect(frames).toEqual([{type: 'error', code: 'UNSUPPORTED', message: expect.any(String)}]);
+});