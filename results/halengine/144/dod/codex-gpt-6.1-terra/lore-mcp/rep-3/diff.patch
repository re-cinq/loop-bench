+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import type {Express} from 'express';
+import {WebSocket} from 'ws';
+import {createServer} from './createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+import {answeringOrchestrator} from './wsTestSupport.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+
+describe('conversation list over WebSocket', () => {
+  it('validates the list request and its composite cursor', () => {
+    expect(validateMessage({type: 'list_conversations'})).toEqual({valid: true, data: {type: 'list_conversations'}});
+    for (const limit of [0, 201, 1.5, '10']) {
+      expect(validateMessage({type: 'list_conversations', limit})).toEqual({
+        valid: false,
+        error: expect.stringMatching(/limit/i),
+      });
+    }
+    for (const before of [
+      'not a date',
+      {updatedAt: 'bad', sessionId: 'a'},
+      {updatedAt: '2026-01-01T00:00:00.000Z'},
+      {sessionId: 'a'},
+    ]) {
+      expect(validateMessage({type: 'list_conversations', before})).toEqual({
+        valid: false,
+        error: expect.stringMatching(/before/i),
+      });
+    }
+    const before = {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: 'a'};
+    expect(validateMessage({type: 'list_conversations', limit: 1, before})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations', limit: 1, before},
+    });
+  });
+
+  it('answers only the authenticated user with ordered wire summaries and pages by cursor', async () => {
+    const store = new InMemorySessionStore();
+    store.create('own-a', 'u1');
+    store.create('own-b', 'u1');
+    store.create('other', 'u2');
+    const frames = await exchange(store, true, {
+      type: 'list_conversations',
+      userId: 'u2',
+      limit: 1,
+      before: {updatedAt: '9999-01-01T00:00:00.000Z', sessionId: 'z'},
+    });
+    const expected = JSON.parse(
+      JSON.stringify(store.listFor('u1', {limit: 1, before: {updatedAt: '9999-01-01T00:00:00.000Z', sessionId: 'z'}}))
+    );
+    expect(frames).toEqual([{type: 'conversation_list', conversations: expected}]);
+  });
+
+  it('refuses a list when history is disabled', async () => {
+    const frames = await exchange(new InMemorySessionStore(), false, {type: 'list_conversations'});
+    expect(frames).toEqual([expect.objectContaining({type: 'error', code: 'UNSUPPORTED'})]);
+  });
+});
+
+async function exchange(store: InMemorySessionStore, enabled: boolean, request: object): Promise<unknown[]> {
+  const options = {
+    app: (() => undefined) as unknown as Express,
+    wsAuth: async () => ({id: 'u1'}),
+    sessionStore: store,
+    orchestrator: answeringOrchestrator,
+    ...(enabled ? {history: {enabled: true}} : {}),
+  };
+  const server = createServer(options);
+  await server.start(0);
+  const {port} = server.server.address() as AddressInfo;
+  const serverClosed = new Promise<void>(resolve => {
+    server.wss.once('connection', ws => ws.once('close', () => resolve()));
+  });
+  const socket = new WebSocket(`ws://127.0.0.1:${port}/hal/ws`, [HAL_WS_SUBPROTOCOL, 'token']);
+  const frames: unknown[] = [];
+  try {
+    await new Promise<void>((resolve, reject) => {
+      socket.on('error', reject);
+      socket.on('message', raw => {
+        const frame = JSON.parse(String(raw)) as {type: string};
+        if (frame.type === 'connected') {
+          socket.send(JSON.stringify(request));
+          socket.send(JSON.stringify({type: 'ping', timestamp: 1}));
+        } else if (frame.type === 'pong') resolve();
+        else frames.push(frame);
+      });
+    });
+    return frames;
+  } finally {
+    const closed = once(socket, 'close');
+    socket.close();
+    await closed;
+    await serverClosed;
+    await server.stop();
+  }
+}