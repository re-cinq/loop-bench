diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..147ef94
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,113 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import type {Express} from 'express';
+import {WebSocket} from 'ws';
+import {createServer} from './createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+import {answeringOrchestrator} from './wsTestSupport.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+
+// specs/hal-engine-websocket-protocol/spec.md: conversation-list wire contract.
+describe('conversation lists over WebSocket', () => {
+  it('validates list requests and their composite paging cursor', () => {
+    const before = {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: 'older'};
+    expect(validateMessage({type: 'list_conversations'})).toEqual({valid: true, data: {type: 'list_conversations'}});
+    expect(validateMessage({type: 'list_conversations', limit: 2, before})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations', limit: 2, before},
+    });
+    for (const limit of [0, 201, 1.5, '10']) {
+      expect(validateMessage({type: 'list_conversations', limit})).toEqual({
+        valid: false,
+        error: expect.stringMatching(/limit/i),
+      });
+    }
+    for (const cursor of [
+      'not a date',
+      {updatedAt: 'bad', sessionId: 's'},
+      {updatedAt: before.updatedAt},
+      {sessionId: 's'},
+    ]) {
+      expect(validateMessage({type: 'list_conversations', before: cursor})).toEqual({
+        valid: false,
+        error: expect.stringMatching(/before/i),
+      });
+    }
+  });
+
+  it('answers with the authenticated user’s paged summaries over the socket', async () => {
+    const store = new InMemorySessionStore();
+    store.create('own-a', 'u1').entries.push({role: 'user', content: 'private', timestamp: '2026-01-01T00:00:00.000Z'});
+    store.create('own-b', 'u1');
+    store.create('other', 'u2');
+    const options = {
+      app: (() => undefined) as unknown as Express,
+      wsAuth: async () => ({id: 'u1'}),
+      sessionStore: store,
+      orchestrator: answeringOrchestrator,
+      history: {enabled: true},
+    };
+    const server = createServer(options);
+    await server.start(0);
+    const socket = new WebSocket(`ws://127.0.0.1:${(server.server.address() as AddressInfo).port}/hal/ws`, [
+      HAL_WS_SUBPROTOCOL,
+      't',
+    ]);
+    try {
+      const frames: Array<Record<string, unknown>> = [];
+      await new Promise<void>(resolve =>
+        socket.on('message', raw => {
+          const frame = JSON.parse(String(raw)) as Record<string, unknown>;
+          frames.push(frame);
+          if (frame.type === 'connected') {
+            socket.send(JSON.stringify({type: 'list_conversations', userId: 'u2', limit: 1}));
+            socket.send(JSON.stringify({type: 'ping', timestamp: 1}));
+          }
+          if (frame.type === 'pong') resolve();
+        })
+      );
+      const expected = (await store.listFor('u1', {limit: 1})).map(row => ({
+        ...row,
+        createdAt: row.createdAt.toISOString(),
+        updatedAt: row.updatedAt.toISOString(),
+      }));
+      expect(frames.slice(1)).toEqual([
+        {type: 'conversation_list', conversations: expected},
+        {type: 'pong', timestamp: 1},
+      ]);
+    } finally {
+      socket.terminate();
+      await once(socket, 'close');
+      await server.stop();
+    }
+  });
+
+  it('refuses a list when history is not enabled', async () => {
+    const server = createServer({
+      app: (() => undefined) as unknown as Express,
+      wsAuth: async () => ({id: 'u1'}),
+      sessionStore: new InMemorySessionStore(),
+      orchestrator: answeringOrchestrator,
+    });
+    await server.start(0);
+    const socket = new WebSocket(`ws://127.0.0.1:${(server.server.address() as AddressInfo).port}/hal/ws`, [
+      HAL_WS_SUBPROTOCOL,
+      't',
+    ]);
+    try {
+      const answer = await new Promise<Record<string, unknown>>(resolve =>
+        socket.on('message', raw => {
+          const frame = JSON.parse(String(raw)) as Record<string, unknown>;
+          if (frame.type === 'connected') socket.send(JSON.stringify({type: 'list_conversations'}));
+          else resolve(frame);
+        })
+      );
+      expect(answer).toMatchObject({type: 'error', code: 'UNSUPPORTED'});
+    } finally {
+      socket.terminate();
+      await once(socket, 'close');
+      await server.stop();
+    }
+  });
+});