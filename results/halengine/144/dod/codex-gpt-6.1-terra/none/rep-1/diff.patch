@@ -0,0 +1,94 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import type {Express} from 'express';
+import {WebSocket} from 'ws';
+import {createServer} from './createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+import {answeringOrchestrator} from './wsTestSupport.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+
+// specs/hal-engine-websocket-protocol/spec.md#1
+it('validates conversation list requests and their composite cursor', () => {
+  const before = {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: 'one'};
+  expect(validateMessage({type: 'list_conversations', limit: 2, before, userId: 'other'})).toEqual({
+    valid: true,
+    data: {type: 'list_conversations', limit: 2, before},
+  });
+  for (const payload of [
+    {limit: 0},
+    {limit: 201},
+    {limit: 1.5},
+    {limit: '10'},
+    {before: 'not a date'},
+    {before: {updatedAt: before.updatedAt}},
+    {before: {sessionId: 'one'}},
+  ]) {
+    const result = validateMessage({type: 'list_conversations', ...payload});
+    expect(result.valid).toBe(false);
+    if (!result.valid) expect(result.error).toMatch(Object.keys(payload)[0]!);
+  }
+});
+
+async function exchange(history: boolean, request: object) {
+  const store = new InMemorySessionStore();
+  store.create('one', 'u1').entries.push({role: 'user', content: 'private', timestamp: '2026-01-01T00:00:00.000Z'});
+  store.create('two', 'u1');
+  store.create('theirs', 'u2');
+  const options = {
+    app: (() => undefined) as unknown as Express,
+    wsAuth: async () => ({id: 'u1'}),
+    sessionStore: store,
+    orchestrator: answeringOrchestrator,
+    ...(history ? {history: {enabled: true}} : {}),
+  };
+  const hal = createServer(options);
+  await hal.start(0);
+  const port = (hal.server.address() as AddressInfo).port;
+  const client = new WebSocket(`ws://127.0.0.1:${port}/hal/ws`, [HAL_WS_SUBPROTOCOL, 'token']);
+  try {
+    const frames = await new Promise<Array<Record<string, unknown>>>(resolve => {
+      const received: Array<Record<string, unknown>> = [];
+      client.on('message', raw => {
+        const frame = JSON.parse(String(raw)) as Record<string, unknown>;
+        if (frame.type === 'connected') {
+          client.send(JSON.stringify(request));
+          client.send(JSON.stringify({type: 'ping', timestamp: 1}));
+        } else if (frame.type === 'pong') resolve(received);
+        else received.push(frame);
+      });
+    });
+    return {frames, store};
+  } finally {
+    const closed = once(client, 'close');
+    const serverClosed = once([...hal.wss.clients][0]!, 'close');
+    client.close();
+    await Promise.all([closed, serverClosed]);
+    await hal.stop();
+  }
+}
+
+// specs/hal-engine-websocket-protocol/spec.md#2
+it('lists only the authenticated user’s metadata and pages using the wire cursor', async () => {
+  const first = await exchange(true, {type: 'list_conversations', userId: 'u2', limit: 2});
+  const expected = first.store
+    .listFor('u1', {limit: 2})
+    .map(row => ({...row, createdAt: row.createdAt.toISOString(), updatedAt: row.updatedAt.toISOString()}));
+  expect(first.frames).toEqual([{type: 'conversation_list', conversations: expected}]);
+  const cursor = expected[0]!;
+  const next = await exchange(true, {
+    type: 'list_conversations',
+    limit: 1,
+    before: {updatedAt: cursor.updatedAt, sessionId: cursor.sessionId},
+  });
+  const nextExpected = next.store
+    .listFor('u1', {limit: 1, before: cursor})
+    .map(row => ({...row, createdAt: row.createdAt.toISOString(), updatedAt: row.updatedAt.toISOString()}));
+  expect(next.frames).toEqual([{type: 'conversation_list', conversations: nextExpected}]);
+});
+
+// specs/hal-engine-websocket-protocol/spec.md#3
+it('refuses a list request when history is not enabled', async () => {
+  const {frames} = await exchange(false, {type: 'list_conversations'});
+  expect(frames).toEqual([expect.objectContaining({type: 'error', code: 'UNSUPPORTED'})]);
+});