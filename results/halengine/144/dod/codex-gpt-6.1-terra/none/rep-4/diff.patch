index 0000000..10cd04d
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,104 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import type {Express} from 'express';
+import {WebSocket} from 'ws';
+import {createServer} from './createServer.js';
+import {answeringOrchestrator} from './wsTestSupport.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {setLogger} from '../shared/logger.js';
+
+// specs/hal-engine-websocket-protocol/spec.md#conversation-list
+const exchange = async (enabled: boolean, request: object) => {
+  const store = new InMemorySessionStore();
+  store.create('own-a', 'alice');
+  store.create('own-b', 'alice');
+  store.create('other', 'bob');
+  const options = {
+    app: (() => undefined) as unknown as Express,
+    wsAuth: async () => ({id: 'alice'}),
+    sessionStore: store,
+    orchestrator: answeringOrchestrator,
+    ...(enabled ? {history: {enabled: true}} : {}),
+  };
+  const server = createServer(options);
+  await server.start(0);
+  const {port} = server.server.address() as AddressInfo;
+  const socket = new WebSocket(`ws://127.0.0.1:${port}/hal/ws`, [HAL_WS_SUBPROTOCOL, 'token']);
+  try {
+    return await new Promise<Array<Record<string, unknown>>>((resolve, reject) => {
+      const frames: Array<Record<string, unknown>> = [];
+      const timeout = setTimeout(() => reject(new Error('No response to list request')), 2000);
+      socket.on('error', reject);
+      socket.on('message', raw => {
+        const frame = JSON.parse(String(raw)) as Record<string, unknown>;
+        if (frame.type === 'connected') {
+          socket.send(JSON.stringify(request));
+          socket.send(JSON.stringify({type: 'ping', timestamp: 1}));
+        } else if (frame.type === 'pong') {
+          clearTimeout(timeout);
+          resolve(frames);
+        } else frames.push(frame);
+      });
+    });
+  } finally {
+    const closed = once(socket, 'close');
+    socket.terminate();
+    await closed;
+    while (server.wss.clients.size > 0) await new Promise(resolve => setTimeout(resolve, 10));
+    await server.stop();
+  }
+};
+
+beforeAll(() =>
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined})
+);
+afterAll(() => setLogger());
+
+describe('conversation lists over WebSocket', () => {
+  it('validates the list request and its composite cursor', () => {
+    const before = {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: 'own-a'};
+    expect(validateMessage({type: 'list_conversations', limit: 2, before})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations', limit: 2, before},
+    });
+    expect(validateMessage({type: 'list_conversations'}).valid).toBe(true);
+    for (const limit of [0, 201, 1.5, '10']) {
+      expect(validateMessage({type: 'list_conversations', limit})).toEqual(
+        expect.objectContaining({valid: false, error: expect.stringMatching(/limit/i)})
+      );
+    }
+    for (const before of [
+      'not a date',
+      {updatedAt: 'bad', sessionId: 'a'},
+      {updatedAt: '2026-01-01T00:00:00.000Z'},
+      {sessionId: 'a'},
+    ]) {
+      expect(validateMessage({type: 'list_conversations', before})).toEqual(
+        expect.objectContaining({valid: false, error: expect.stringMatching(/before/i)})
+      );
+    }
+  });
+
+  it('answers only the authenticated user with paged wire summaries', async () => {
+    const before = {updatedAt: '9999-01-01T00:00:00.000Z', sessionId: 'z'};
+    const frames = await exchange(true, {type: 'list_conversations', userId: 'bob', limit: 2, before});
+    expect(frames).toHaveLength(1);
+    expect(frames[0].type).toBe('conversation_list');
+    const rows = frames[0].conversations as Array<Record<string, unknown>>;
+    expect(rows).toHaveLength(2);
+    expect(rows.every(row => row.sessionId !== 'other')).toBe(true);
+    for (const row of rows) {
+      expect(Object.keys(row).sort()).toEqual(['createdAt', 'entryCount', 'sessionId', 'updatedAt']);
+      expect(new Date(row.createdAt as string).toISOString()).toBe(row.createdAt);
+      expect(new Date(row.updatedAt as string).toISOString()).toBe(row.updatedAt);
+    }
+    expect(Date.parse(rows[0].updatedAt as string)).toBeGreaterThanOrEqual(Date.parse(rows[1].updatedAt as string));
+  });
+
+  it('refuses a list when history is not enabled', async () => {
+    const frames = await exchange(false, {type: 'list_conversations'});
+    expect(frames).toEqual([expect.objectContaining({type: 'error', code: 'UNSUPPORTED'})]);
+  });
+});