new file mode 100644
index 0000000..1b691c8
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,96 @@
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {validateMessage} from './ws/validation.js';
+import {connectClient, startEngineWith, stopEngines} from './wsTestSupport.js';
+import type {SessionStore} from '../types/sessionStore.js';
+
+// specs/hal-engine-websocket-protocol/spec.md#conversation-list-validation
+it('validates list requests and their composite cursor independently of configuration', () => {
+  expect(validateMessage({type: 'list_conversations'})).toEqual({valid: true, data: {type: 'list_conversations'}});
+  for (const limit of [0, 201, 1.5, '10']) {
+    expect(validateMessage({type: 'list_conversations', limit})).toEqual({
+      valid: false,
+      error: expect.stringMatching(/limit/i),
+    });
+  }
+  for (const before of [
+    'not a date',
+    {updatedAt: 'bad', sessionId: 's'},
+    {updatedAt: '2099-01-01T00:00:00.000Z'},
+    {sessionId: 's'},
+  ]) {
+    expect(validateMessage({type: 'list_conversations', before})).toEqual({
+      valid: false,
+      error: expect.stringMatching(/before/i),
+    });
+  }
+});
+
+afterEach(async () => {
+  await stopEngines();
+  await new Promise(resolve => setTimeout(resolve, 20));
+});
+
+async function request(
+  store: SessionStore,
+  enabled: boolean | undefined,
+  payload: object
+): Promise<Array<Record<string, unknown>>> {
+  const options = {sessionStore: store, ...(enabled === undefined ? {} : {history: {enabled}})};
+  const {url} = await startEngineWith(options);
+  const client = connectClient(url);
+  const frames: Array<Record<string, unknown>> = [];
+  await new Promise<void>(resolve => {
+    client.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as Record<string, unknown>;
+      if (frame.type === 'connected') {
+        client.send(JSON.stringify(payload));
+      } else if (frame.type === 'pong') resolve();
+      else {
+        frames.push(frame);
+        if (frames.length === 1) client.send(JSON.stringify({type: 'ping', timestamp: 1}));
+      }
+    });
+  });
+  return frames;
+}
+
+// specs/hal-engine-websocket-protocol/spec.md#conversation-list-ownership-and-paging
+it('answers the authenticated user with wire summaries and pages using the supplied cursor', async () => {
+  const store = new InMemorySessionStore();
+  for (const [id, time] of [
+    ['a', '2099-01-01T00:00:00.000Z'],
+    ['b', '2099-01-02T00:00:00.000Z'],
+    ['c', '2099-01-03T00:00:00.000Z'],
+    ['other', '2099-01-04T00:00:00.000Z'],
+  ]) {
+    const session = store.create(id, id === 'other' ? 'u2' : 'u1');
+    session.entries.push({role: 'user', content: 'private', timestamp: time});
+  }
+  const before = {updatedAt: '2099-01-03T00:00:00.000Z', sessionId: 'c'};
+  const frames = await request(store, true, {type: 'list_conversations', userId: 'u2', limit: 2, before});
+  const expected = store
+    .listFor('u1', {limit: 2, before})
+    .map(row => ({...row, createdAt: row.createdAt.toISOString(), updatedAt: row.updatedAt.toISOString()}));
+  expect(frames).toEqual([{type: 'conversation_list', conversations: expected}]);
+  expect(expected.map(row => row.sessionId)).toEqual(['b', 'a']);
+});
+
+// specs/hal-engine-websocket-protocol/spec.md#conversation-list-unsupported
+it('reports unsupported when history is disabled or the store cannot list', async () => {
+  const store = new InMemorySessionStore();
+  const withoutList: SessionStore = {
+    create: store.create.bind(store),
+    get: store.get.bind(store),
+    delete: store.delete.bind(store),
+    count: store.count.bind(store),
+    clear: store.clear.bind(store),
+  };
+  for (const [candidate, enabled] of [
+    [store, undefined],
+    [withoutList, true],
+  ] as const) {
+    expect(await request(candidate, enabled, {type: 'list_conversations'})).toEqual([
+      expect.objectContaining({type: 'error', code: 'UNSUPPORTED'}),
+    ]);
+  }
+});