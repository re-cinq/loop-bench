diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..f4137bc
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,183 @@
+import {validateMessage} from './ws/validation.js';
+import {
+  announcedId,
+  answeringOrchestrator,
+  connectClient,
+  deferred,
+  framesUntil,
+  startEngineWith,
+  stopEngines,
+} from './wsTestSupport.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {ChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import type {MessageChunk} from '../types/ai.js';
+import type {SessionListOptions, SessionStore} from '../types/sessionStore.js';
+import {setLogger} from '../shared/logger.js';
+
+// Contract: specs/hal-engine-websocket-protocol/spec.md (conversation_list) and #144.
+// A real engine over a real socket; the history option is passed as a plain object because it does not exist yet.
+
+interface Frame {
+  type: string;
+  code?: string;
+  message?: string;
+  conversations?: Array<{sessionId: string; createdAt: string; updatedAt: string; entryCount: number}>;
+}
+
+const HISTORY_ON = {history: {enabled: true}};
+
+beforeAll(() => {
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined});
+});
+afterAll(() => {
+  setLogger();
+});
+afterEach(stopEngines);
+
+const seeded = (): InMemorySessionStore => {
+  const store = new InMemorySessionStore();
+  const older = store.create('older', 'u1');
+  older.entries.push({role: 'user', content: 'x', timestamp: '2026-01-01T00:00:00.000Z'});
+  const newer = store.create('newer', 'u1');
+  newer.entries.push({role: 'user', content: 'x', timestamp: '2026-02-01T00:00:00.000Z'});
+  const theirs = store.create('theirs', 'u2');
+  theirs.entries.push({role: 'user', content: 'x', timestamp: '2026-03-01T00:00:00.000Z'});
+  return store;
+};
+
+// A store with only the required members, so listFor can be recorded or left out.
+const without = (inner: InMemorySessionStore): SessionStore => ({
+  create: (sessionId, userId, options) => inner.create(sessionId, userId, options),
+  get: sessionId => inner.get(sessionId),
+  delete: sessionId => inner.delete(sessionId),
+  count: () => inner.count(),
+  clear: () => inner.clear(),
+});
+
+// Sends the frame on connect, then a ping as a barrier: every answer to the frame precedes the pong.
+const askList = async (url: string, frame: Record<string, unknown>): Promise<{frames: Frame[]; ownId: string}> => {
+  const client = connectClient(url);
+  const ownId = announcedId(client);
+  const frames: Frame[] = [];
+  client.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  const done = framesUntil(client, 'pong');
+  client.on('message', raw => {
+    if ((JSON.parse(String(raw)) as Frame).type === 'connected') {
+      client.send(JSON.stringify(frame));
+      client.send(JSON.stringify({type: 'ping', timestamp: 1}));
+    }
+  });
+  await done;
+  return {frames: frames.filter(f => f.type !== 'connected' && f.type !== 'pong'), ownId: ownId()};
+};
+
+describe('a user’s conversation list over the WebSocket (#144)', () => {
+  it('accepts list_conversations and names the field of a bad limit or before', () => {
+    const verdicts = [
+      {type: 'list_conversations'},
+      {type: 'list_conversations', limit: 200, before: {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: 's'}},
+    ].map(frame => validateMessage(frame).valid);
+    const refusals = [{limit: 0}, {limit: 201}, {limit: 1.5}, {limit: '10'}, {before: 'not a date'}].map(extra =>
+      validateMessage({type: 'list_conversations', ...extra})
+    );
+
+    expect({
+      verdicts,
+      refused: refusals.map(r => !r.valid),
+      named: refusals.map(r => (r.valid ? '' : /limit|before/.exec(r.error)?.[0])),
+    }).toEqual({
+      verdicts: [true, true],
+      refused: [true, true, true, true, true],
+      named: ['limit', 'limit', 'limit', 'limit', 'before'],
+    });
+  });
+
+  it('answers with one conversation_list of the connecting user’s own, newest first, as ISO strings, ignoring a userId in the frame', async () => {
+    const calls: Array<{userId: string | number; options?: SessionListOptions}> = [];
+    const inner = seeded();
+    const store: SessionStore = {
+      ...without(inner),
+      listFor: (userId, options) => {
+        calls.push({userId, options});
+        return inner.listFor(userId, options);
+      },
+    };
+    const {url} = await startEngineWith({sessionStore: store, ...HISTORY_ON});
+
+    const {frames, ownId} = await askList(url, {type: 'list_conversations', userId: 'u2', limit: 10});
+
+    expect({
+      types: frames.map(f => f.type),
+      ids: frames[0]?.conversations?.map(c => c.sessionId),
+      iso: frames[0]?.conversations?.every(
+        c => new Date(c.createdAt).toISOString() === c.createdAt && new Date(c.updatedAt).toISOString() === c.updatedAt
+      ),
+      asked: calls.map(c => [c.userId, c.options?.limit]),
+      ownId: ownId.length > 0,
+    }).toEqual({
+      types: ['conversation_list'],
+      ids: [ownId, 'newer', 'older'],
+      iso: true,
+      asked: [['u1', 10]],
+      ownId: true,
+    });
+  });
+
+  it('answers UNSUPPORTED, and sends no list, with history off or with a store that cannot list', async () => {
+    const off = await startEngineWith({sessionStore: seeded()});
+    const noListFor = await startEngineWith({sessionStore: without(seeded()), ...HISTORY_ON});
+
+    const answers = [
+      (await askList(off.url, {type: 'list_conversations'})).frames,
+      (await askList(noListFor.url, {type: 'list_conversations'})).frames,
+    ];
+
+    expect(answers.map(frames => frames.map(f => [f.type, f.code]))).toEqual([
+      [['error', 'UNSUPPORTED']],
+      [['error', 'UNSUPPORTED']],
+    ]);
+  });
+
+  it('answers SERVER_ERROR without store detail when listFor rejects, and keeps the socket open', async () => {
+    const store: SessionStore = {
+      ...without(seeded()),
+      listFor: () => Promise.reject(new Error('mongo password=hunter2')),
+    };
+    const {url} = await startEngineWith({sessionStore: store, ...HISTORY_ON});
+
+    const {frames} = await askList(url, {type: 'list_conversations'});
+
+    expect({answer: frames.map(f => [f.type, f.code]), leaked: JSON.stringify(frames).includes('hunter2')}).toEqual({
+      answer: [['error', 'SERVER_ERROR']],
+      leaked: false,
+    });
+  });
+
+  it('answers a list request before the stream_end of a turn still streaming on the same session', async () => {
+    const gate = deferred();
+    const blocked: ChatOrchestrator = {
+      ...answeringOrchestrator,
+      async *processMessageStream(): AsyncGenerator<MessageChunk> {
+        await gate.until;
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+    };
+    const {url} = await startEngineWith({sessionStore: seeded(), orchestrator: blocked, ...HISTORY_ON});
+    const client = connectClient(url);
+    const seen = framesUntil(client, 'conversation_list');
+    client.on('message', raw => {
+      if ((JSON.parse(String(raw)) as Frame).type !== 'connected') return;
+      client.send(JSON.stringify({type: 'user_message', content: 'hello'}));
+      client.send(JSON.stringify({type: 'list_conversations'}));
+    });
+
+    const types = await Promise.race([
+      seen,
+      new Promise<string[]>(resolve => setTimeout(() => resolve(['timed out']), 1500)),
+    ]);
+    gate.release();
+
+    expect(types).not.toContain('stream_end');
+    expect(types.at(-1)).toBe('conversation_list');
+  });
+});