diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..f2869a8
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,141 @@
+import {validateMessage} from './ws/validation.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {SessionListOptions, SessionStore} from '../types/sessionStore.js';
+import {setLogger} from '../shared/logger.js';
+import {announcedId, connectClient, startEngineWith, stopEngines} from './wsTestSupport.js';
+import type {WebSocket} from 'ws';
+
+// A client reaches its own conversation list over the socket it is already authenticated on (specs/hal-engine-websocket-protocol/spec.md).
+
+interface Frame {
+  type: string;
+  code?: string;
+  message?: string;
+  conversations?: Array<{sessionId: string; createdAt: string; updatedAt: string; entryCount: number}>;
+}
+
+// Spread into the server options, so this file compiles before `history` exists on them.
+const HISTORY_ON = {history: {enabled: true}};
+
+beforeAll(() => {
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined});
+});
+
+afterAll(() => {
+  setLogger();
+});
+
+afterEach(stopEngines);
+
+const talkedAt = (store: InMemorySessionStore, sessionId: string, userId: string, at: string): void => {
+  store.create(sessionId, userId).entries.push({role: 'user', content: 'private words', timestamp: at});
+};
+
+// Three of the connecting user's conversations, oldest first by activity, and one of someone else's.
+const seeded = (): InMemorySessionStore => {
+  const store = new InMemorySessionStore();
+  talkedAt(store, 'a-oldest', 'u1', '2026-01-01T00:00:00.000Z');
+  talkedAt(store, 'b-middle', 'u1', '2026-01-02T00:00:00.000Z');
+  talkedAt(store, 'c-newest', 'u1', '2026-01-03T00:00:00.000Z');
+  talkedAt(store, 'x-theirs', 'u2', '2026-01-04T00:00:00.000Z');
+  return store;
+};
+
+/** The first answer to one frame sent once the connection is announced, with every frame type seen up to it. */
+const ask = (
+  url: string,
+  frame: Record<string, unknown>,
+  until: string[] = ['conversation_list', 'error']
+): Promise<{answer: Frame; seen: string[]; client: WebSocket; sessionId: () => string}> => {
+  const client = connectClient(url);
+  const sessionId = announcedId(client);
+  const seen: string[] = [];
+  return new Promise(resolve => {
+    client.on('message', raw => {
+      const parsed = JSON.parse(String(raw)) as Frame;
+      seen.push(parsed.type);
+      if (parsed.type === 'connected') client.send(JSON.stringify(frame));
+      if (until.includes(parsed.type)) resolve({answer: parsed, seen, client, sessionId});
+    });
+  });
+};
+
+describe('conversation list over the WebSocket protocol', () => {
+  it('rejects a list_conversations frame whose limit or before cannot be honoured, naming the field', () => {
+    const verdicts = [{}, {limit: 0}, {limit: 201}, {limit: 1.5}, {limit: '10'}, {before: 'not a date'}].map(extra => {
+      const result = validateMessage({type: 'list_conversations', ...extra});
+      return result.valid ? 'valid' : result.error;
+    });
+
+    expect({first: verdicts[0], rest: verdicts.slice(1).map(error => /limit|before/.test(error))}).toEqual({
+      first: 'valid',
+      rest: [true, true, true, true, true],
+    });
+  });
+
+  it("answers the connection's own user, newest first, from the connection and never from the frame", async () => {
+    const calls: Array<{userId: string | number; options?: SessionListOptions}> = [];
+    const store = seeded();
+    const listFor = store.listFor.bind(store);
+    store.listFor = (userId, options) => {
+      calls.push({userId, options});
+      return listFor(userId, options);
+    };
+    const {url} = await startEngineWith({sessionStore: store, ...HISTORY_ON});
+
+    const {answer, seen} = await ask(url, {type: 'list_conversations', userId: 'u2', limit: 50});
+
+    const rows = answer.conversations ?? [];
+    expect({
+      type: answer.type,
+      seededOrder: rows.map(row => row.sessionId).filter(id => id.includes('-')),
+      iso: rows.every(
+        row =>
+          new Date(row.createdAt).toISOString() === row.createdAt &&
+          new Date(row.updatedAt).toISOString() === row.updatedAt
+      ),
+      askedFor: calls.map(call => call.userId),
+      limit: calls[0]?.options?.limit,
+      noStreamEnd: !seen.includes('stream_end'),
+    }).toEqual({
+      type: 'conversation_list',
+      seededOrder: ['c-newest', 'b-middle', 'a-oldest'],
+      iso: true,
+      askedFor: ['u1'],
+      limit: 50,
+      noStreamEnd: true,
+    });
+  });
+
+  it('answers UNSUPPORTED, and no list, when history is not enabled', async () => {
+    const {url} = await startEngineWith({sessionStore: seeded()});
+
+    const {answer, seen} = await ask(url, {type: 'list_conversations'});
+
+    expect({type: answer.type, code: answer.code, listed: seen.includes('conversation_list')}).toEqual({
+      type: 'error',
+      code: 'UNSUPPORTED',
+      listed: false,
+    });
+  });
+
+  it('answers UNSUPPORTED, not an empty list, when the store cannot list', async () => {
+    const inner = seeded();
+    const store: SessionStore = {
+      create: (id, userId, options) => inner.create(id, userId, options),
+      get: id => inner.get(id),
+      delete: id => inner.delete(id),
+      evict: id => inner.evict(id),
+      count: () => inner.count(),
+    } as SessionStore;
+    const {url} = await startEngineWith({sessionStore: store, ...HISTORY_ON});
+
+    const {answer, seen} = await ask(url, {type: 'list_conversations'});
+
+    expect({type: answer.type, code: answer.code, listed: seen.includes('conversation_list')}).toEqual({
+      type: 'error',
+      code: 'UNSUPPORTED',
+      listed: false,
+    });
+  });
+});