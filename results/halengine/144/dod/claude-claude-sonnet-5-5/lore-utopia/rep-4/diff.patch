+### 4.3 list_conversations
+
+Asks which conversations the connection's user has. It carries no user id: the list is always the authenticated user's.
+
+| Field    | Type   | Required | Description                                          |
+| -------- | ------ | -------- | ---------------------------------------------------- |
+| `type`   | string | Yes      | `"list_conversations"`                               |
+| `limit`  | number | No       | An integer from 1 to 200                             |
+| `before` | object | No       | The cursor of the last row seen, to page past it     |
+
+- A `limit` that is not an integer from 1 to 200, or a `before` that is not a usable cursor, is answered with `INVALID_MESSAGE` naming the field ([validated by: accepts a bare list_conversations frame and refuses a bad limit or cursor naming the field](../../src/transport/conversationList.acceptance.test.ts#L60)).
+- The user id is taken from the connection and never from the frame: a frame naming another user is answered with the connecting user's own list ([validated by: answers the connection’s own conversations newest first, whoever the frame names, and passes limit and before on](../../src/transport/conversationList.acceptance.test.ts#L77)).
+- When `transport.history` is off, or the store cannot list, the frame is answered with an `error` of code `UNSUPPORTED` and never with an empty list ([validated by: answers an UNSUPPORTED error and no list when history is off, or the store cannot list](../../src/transport/conversationList.acceptance.test.ts#L111)).
+- It is answered without waiting for a streaming turn on the same session ([validated by: answers a list request while a turn is still streaming, before that turn’s stream_end](../../src/transport/conversationList.acceptance.test.ts#L127)).
+
 ## 5. Server-to-Client Messages
 
 ### 5.1 connected
@@ -357,6 +372,17 @@ Semantics:
 - The client SHOULD use this message to clear any "processing" or "loading" indicators.
 - The client MUST treat a run as complete only at `stream_end` or when the socket closes. Unparseable JSON is the one frame answered with `INVALID_FORMAT` and no `stream_end`, because the server cannot tell what it was meant to be; for it the client falls back on the socket closing.
 
+### 5.9 conversation_list
+
+Answers `list_conversations` with one authenticated user's own conversation metadata and no conversation content, newest activity first, each time as an ISO string.
+
+| Field           | Type   | Description                                                         |
+| --------------- | ------ | ------------------------------------------------------------------- |
+| `type`          | string | `"conversation_list"`                                               |
+| `conversations` | array  | Rows of `sessionId`, `createdAt`, `updatedAt` and `entryCount`      |
+
+- The server sends it only when asked, and sends no `stream_end` with it ([validated by: answers the connection’s own conversations newest first, whoever the frame names, and passes limit and before on](../../src/transport/conversationList.acceptance.test.ts#L77)).
+
 ## 6. SessionEntry Objects
 
 A SessionEntry represents a single piece of content in the conversation. Every entry has a `role` field that determines its shape. The `role` acts as a discriminant for the union type.
diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..2131740
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,160 @@
+import type {WebSocket} from 'ws';
+import {validateMessage} from './ws/validation.js';
+import {announcedId, connectClient, deferred, startEngineWith, stopEngines} from './wsTestSupport.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {ChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import type {MessageChunk} from '../types/ai.js';
+import type {SessionListOptions, SessionSummary} from '../types/sessionStore.js';
+import {setLogger} from '../shared/logger.js';
+
+// Ticket #144: a client asks over its own socket which conversations it has, and is answered from the store
+// for the user the connection authenticated as, never for the user a frame names.
+
+interface Frame {
+  type: string;
+  code?: string;
+  message?: string;
+  conversations?: Array<{sessionId: string; createdAt: string; updatedAt: string; entryCount: number}>;
+}
+
+// The real in-memory store, which also remembers what the transport asked it.
+class RecordingStore extends InMemorySessionStore {
+  readonly asked: Array<{userId: string | number; options?: SessionListOptions}> = [];
+  override listFor(userId: string | number, options?: SessionListOptions): SessionSummary[] {
+    this.asked.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+// Passed as a variable so the options read as what a consumer writes, not as a literal checked against today's type.
+const HISTORY_ON = {history: {enabled: true}};
+
+const seed = (store: InMemorySessionStore): void => {
+  store.create('mine-old', 'u1').entries.push({role: 'user', content: 'a', timestamp: '2026-01-02T00:00:00.000Z'});
+  store.create('mine-newer', 'u1').entries.push({role: 'user', content: 'b', timestamp: '2026-01-03T00:00:00.000Z'});
+  store.create('theirs', 'u2').entries.push({role: 'user', content: 'c', timestamp: '2026-01-04T00:00:00.000Z'});
+};
+
+// A ping is answered off the lock, so its pong is a barrier: every frame the earlier requests earn precedes it.
+const settled = (client: WebSocket, requests: unknown[]): Promise<Frame[]> =>
+  new Promise<Frame[]>(resolve => {
+    const frames: Frame[] = [];
+    client.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as Frame;
+      frames.push(frame);
+      if (frame.type === 'connected') {
+        for (const request of requests) client.send(JSON.stringify(request));
+        client.send(JSON.stringify({type: 'ping', timestamp: 1}));
+      }
+      if (frame.type === 'pong') resolve(frames);
+    });
+  });
+
+beforeAll(() =>
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined})
+);
+afterAll(() => setLogger());
+afterEach(stopEngines);
+
+describe('a user lists their conversations over the WebSocket', () => {
+  it('accepts a bare list_conversations frame and refuses a bad limit or cursor naming the field', () => {
+    const verdicts = [
+      {type: 'list_conversations'},
+      {type: 'list_conversations', limit: 1},
+      {type: 'list_conversations', limit: 200},
+      {type: 'list_conversations', limit: 0},
+      {type: 'list_conversations', limit: 201},
+      {type: 'list_conversations', limit: 1.5},
+      {type: 'list_conversations', limit: '10'},
+      {type: 'list_conversations', before: 'not a date'},
+    ].map(frame => {
+      const result = validateMessage(frame);
+      return result.valid ? 'valid' : (/limit|before/.exec(result.error)?.[0] ?? `unnamed: ${result.error}`);
+    });
+    expect(verdicts).toEqual(['valid', 'valid', 'valid', 'limit', 'limit', 'limit', 'limit', 'before']);
+  });
+
+  it('answers the connection’s own conversations newest first, whoever the frame names, and passes limit and before on', async () => {
+    const store = new RecordingStore();
+    seed(store);
+    const {url} = await startEngineWith({sessionStore: store, ...HISTORY_ON});
+    const client = connectClient(url);
+    const idOf = announcedId(client);
+    const cursor = {updatedAt: '2026-01-03T00:00:00.000Z', sessionId: 'mine-newer'};
+
+    const frames = await settled(client, [
+      {type: 'list_conversations', userId: 'u2'},
+      {type: 'list_conversations', limit: 1, before: cursor},
+    ]);
+
+    const lists = frames.filter(frame => frame.type === 'conversation_list');
+    const first = lists[0]?.conversations ?? [];
+    expect({
+      types: frames.map(frame => frame.type).filter(type => type !== 'connected' && type !== 'pong'),
+      ids: first.map(row => row.sessionId),
+      isoTimes: first.every(
+        row =>
+          new Date(row.createdAt).toISOString() === row.createdAt &&
+          new Date(row.updatedAt).toISOString() === row.updatedAt
+      ),
+      askedAs: store.asked.map(call => call.userId),
+      passedOn: store.asked[1]?.options,
+    }).toEqual({
+      types: ['conversation_list', 'conversation_list'],
+      ids: [idOf(), 'mine-newer', 'mine-old'],
+      isoTimes: true,
+      askedAs: ['u1', 'u1'],
+      passedOn: {limit: 1, before: cursor},
+    });
+  });
+
+  it('answers an UNSUPPORTED error and no list when history is off, or the store cannot list', async () => {
+    const outcomes: Array<{type: string; code?: string}[]> = [];
+    const noListFor = new InMemorySessionStore();
+    (noListFor as {listFor?: unknown}).listFor = undefined;
+    for (const options of [{sessionStore: new InMemorySessionStore()}, {sessionStore: noListFor, ...HISTORY_ON}]) {
+      const {url} = await startEngineWith(options);
+      const frames = await settled(connectClient(url), [{type: 'list_conversations'}]);
+      outcomes.push(
+        frames
+          .filter(frame => frame.type !== 'connected' && frame.type !== 'pong')
+          .map(({type, code}) => ({type, code}))
+      );
+    }
+    expect(outcomes).toEqual([[{type: 'error', code: 'UNSUPPORTED'}], [{type: 'error', code: 'UNSUPPORTED'}]]);
+  });
+
+  it('answers a list request while a turn is still streaming, before that turn’s stream_end', async () => {
+    const hold = deferred();
+    const streaming: ChatOrchestrator = {
+      processMessage: async () => 'hi',
+      async *processMessageStream(): AsyncGenerator<MessageChunk> {
+        yield {type: 'text', text: 'first'};
+        await hold.until;
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+    };
+    const {url} = await startEngineWith({
+      sessionStore: new InMemorySessionStore(),
+      orchestrator: streaming,
+      ...HISTORY_ON,
+    });
+    const client = connectClient(url);
+    const seen: string[] = [];
+    const answered = new Promise<void>(resolve => {
+      client.on('message', raw => {
+        const frame = JSON.parse(String(raw)) as Frame;
+        seen.push(frame.type);
+        if (frame.type === 'connected') client.send(JSON.stringify({type: 'user_message', content: 'hello'}));
+        if (frame.type === 'entry_upsert') client.send(JSON.stringify({type: 'list_conversations'}));
+        if (frame.type === 'conversation_list' || frame.type === 'error') resolve();
+      });
+    });
+
+    await answered;
+    hold.release();
+
+    expect(seen).toContain('conversation_list');
+    expect(seen).not.toContain('stream_end');
+  });
+});