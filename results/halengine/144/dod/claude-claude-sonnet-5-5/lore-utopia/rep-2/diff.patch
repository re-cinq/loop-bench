diff --git a/src/transport/ws/conversationList.acceptance.test.ts b/src/transport/ws/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..bfde629
--- /dev/null
+++ b/src/transport/ws/conversationList.acceptance.test.ts
@@ -0,0 +1,139 @@
+import type {WebSocket} from 'ws';
+import {InMemorySessionStore} from '../../infrastructure/stores/inMemorySessionStore.js';
+import type {ChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import type {MessageChunk} from '../../types/ai.js';
+import type {SessionEntry} from '../../types/session.js';
+import type {SessionListOptions, SessionStore} from '../../types/sessionStore.js';
+import {setLogger} from '../../shared/logger.js';
+import {announcedId, connectClient, deferred, startEngineWith, stopEngines} from '../wsTestSupport.js';
+
+// A real upgrade over a real socket: what a client is sent for "which conversations do I have" is the contract.
+
+interface Frame {
+  type: string;
+  code?: string;
+  conversations?: Array<{sessionId: string; createdAt: string; updatedAt: string; entryCount: number}>;
+}
+
+// Spread from a variable so this file compiles before the option exists; the engine reads it like `resume`.
+const HISTORY_ON = {history: {enabled: true}};
+
+const entryAt = (timestamp: string): SessionEntry => ({role: 'user', content: 'secret words', timestamp});
+
+/** An in-memory store that records what `listFor` was asked, so the argument itself can be asserted. */
+class RecordingStore extends InMemorySessionStore {
+  readonly asked: Array<{userId: string | number; options?: SessionListOptions}> = [];
+  override listFor(userId: string | number, options?: SessionListOptions) {
+    this.asked.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+const seed = (store: InMemorySessionStore): void => {
+  store.create('older', 'u1').entries.push(entryAt('2020-01-01T00:00:00.000Z'));
+  store.create('newer', 'u1').entries.push(entryAt('2020-06-01T00:00:00.000Z'));
+  store.create('theirs', 'u2').entries.push(entryAt('2020-03-01T00:00:00.000Z'));
+};
+
+/** Sends one frame once connected and resolves with the frames up to and including a pong that follows it. */
+const ask = (client: WebSocket, frame: object): Promise<Frame[]> =>
+  new Promise<Frame[]>(resolve => {
+    const frames: Frame[] = [];
+    client.on('message', raw => {
+      const received = JSON.parse(String(raw)) as Frame;
+      frames.push(received);
+      if (received.type === 'connected') {
+        client.send(JSON.stringify(frame));
+        client.send(JSON.stringify({type: 'ping', timestamp: 1}));
+      }
+      if (received.type === 'pong') resolve(frames);
+    });
+  });
+
+beforeAll(() => {
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined});
+});
+afterAll(() => {
+  setLogger();
+});
+afterEach(stopEngines);
+
+describe('delivering a user’s conversation list over the socket', () => {
+  it('answers list_conversations with the connecting user’s own list, newest first, as ISO strings, whatever userId the frame carries', async () => {
+    const store = new RecordingStore();
+    seed(store);
+    const {url} = await startEngineWith({sessionStore: store, ...HISTORY_ON});
+    const client = connectClient(url);
+    const idOf = announcedId(client);
+
+    const frames = await ask(client, {type: 'list_conversations', userId: 'u2', limit: 10});
+
+    const lists = frames.filter(frame => frame.type === 'conversation_list');
+    expect(lists).toHaveLength(1);
+    const rows = lists[0].conversations ?? [];
+    // The connection's own, empty conversation is listed like any other, and is the newest.
+    expect(rows.map(row => row.sessionId)).toEqual([idOf(), 'newer', 'older']);
+    expect(
+      rows.every(row => /^\d{4}-\d\d-\d\dT.*Z$/.test(row.createdAt) && /^\d{4}-\d\d-\d\dT.*Z$/.test(row.updatedAt))
+    ).toBe(true);
+    expect(rows[1].entryCount).toBe(1);
+    expect(frames.map(frame => frame.type)).not.toContain('stream_end');
+    expect(store.asked.map(call => call.userId)).toEqual(['u1']);
+    expect(store.asked[0].options?.limit).toBe(10);
+  });
+
+  it('answers list_conversations with one UNSUPPORTED error and no list when history is off or the store cannot list', async () => {
+    const off = new RecordingStore();
+    seed(off);
+    const withoutHistory = await startEngineWith({sessionStore: off});
+    const offFrames = await ask(connectClient(withoutHistory.url), {type: 'list_conversations'});
+
+    const inMemory = new InMemorySessionStore();
+    const noList: SessionStore = {
+      create: (sessionId, userId, options) => inMemory.create(sessionId, userId, options),
+      get: sessionId => inMemory.get(sessionId),
+      delete: sessionId => inMemory.delete(sessionId),
+      save: session => inMemory.save(session),
+      size: () => inMemory.size(),
+    } as unknown as SessionStore;
+    const withoutListFor = await startEngineWith({sessionStore: noList, ...HISTORY_ON});
+    const noListFrames = await ask(connectClient(withoutListFor.url), {type: 'list_conversations'});
+
+    for (const frames of [offFrames, noListFrames]) {
+      const answers = frames.filter(frame => frame.type === 'error' || frame.type === 'conversation_list');
+      expect(answers.map(frame => [frame.type, frame.code])).toEqual([['error', 'UNSUPPORTED']]);
+    }
+    expect(off.asked).toEqual([]);
+  });
+
+  it('answers list_conversations while a user_message is streaming, before that turn’s stream_end', async () => {
+    const store = new InMemorySessionStore();
+    const held = deferred();
+    const slow: ChatOrchestrator = {
+      processMessage: async () => 'hi',
+      async *processMessageStream(): AsyncGenerator<MessageChunk> {
+        yield {type: 'text', text: 'hi'};
+        await held.until;
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+    };
+    const {url} = await startEngineWith({sessionStore: store, orchestrator: slow, ...HISTORY_ON});
+    const client = connectClient(url);
+    const types: string[] = [];
+    const listed = new Promise<void>(resolve => {
+      client.on('message', raw => {
+        const {type} = JSON.parse(String(raw)) as Frame;
+        types.push(type);
+        if (type === 'connected') client.send(JSON.stringify({type: 'user_message', content: 'hello'}));
+        if (type === 'entry_delta') client.send(JSON.stringify({type: 'list_conversations'}));
+        if (type === 'conversation_list' || type === 'error') resolve();
+      });
+    });
+
+    await listed;
+    held.release();
+
+    expect(types).toContain('conversation_list');
+    expect(types).not.toContain('stream_end');
+  });
+});