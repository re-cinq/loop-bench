@@ -0,0 +1,422 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import type {Express} from 'express';
+import {createServer} from './createServer.js';
+import type {HalServer, HalServerOptions} from './createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+import {answeringOrchestrator} from './wsTestSupport.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {ChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import type {MessageChunk} from '../types/ai.js';
+import type {SessionEntry} from '../types/session.js';
+import type {SessionStore} from '../types/sessionStore.js';
+import {captureErrors} from '../shared/logCaptureTestSupport.js';
+import * as publicApi from '../index.js';
+
+// Acceptance tests for re-cinq/HALEngine#144: the user's conversation list, answered on the socket itself.
+
+// The opt-in this ticket adds beside `resume`, typed here until the transport options carry it.
+type WithHistory = HalServerOptions & {history?: {enabled: boolean}};
+
+interface Frame {
+  type: string;
+  sessionId?: string;
+  code?: string;
+  message?: string;
+  conversations?: unknown;
+  resumed?: boolean;
+  entryCount?: number;
+  index?: number;
+  entry?: SessionEntry;
+}
+
+// One row of a conversation_list on the wire: a SessionSummary whose two times went through JSON.
+interface Row {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+
+interface ListCall {
+  userId: string | number;
+  options: unknown;
+}
+
+const CONTENT = 'my booking 4711';
+
+// One user entry per conversation, sent at a fixed past moment that reads as the conversation's activity.
+const seededWith = (
+  conversations: Array<[sessionId: string, userId: string, sentAt: string]>
+): InMemorySessionStore => {
+  const store = new InMemorySessionStore();
+  for (const [sessionId, userId, sentAt] of conversations) {
+    const {entries} = store.create(sessionId, userId);
+    entries.push({role: 'user', content: `${CONTENT} (${sessionId})`, timestamp: sentAt});
+  }
+  return store;
+};
+
+// A store with only the five required members, so an optional one can be added, replaced or left out per test.
+const fiveMembers = (inner: InMemorySessionStore): SessionStore => ({
+  create: (sessionId, userId, options) => inner.create(sessionId, userId, options),
+  get: sessionId => inner.get(sessionId),
+  delete: sessionId => inner.delete(sessionId),
+  count: () => inner.count(),
+  clear: () => inner.clear(),
+});
+
+// The real store, wrapped so each listFor call is recorded for asserting the argument the engine passed.
+const recordingListFor = (inner: InMemorySessionStore, calls: ListCall[]): SessionStore => ({
+  ...fiveMembers(inner),
+  listFor: (userId, options) => {
+    calls.push({userId, options});
+    return inner.listFor(userId, options);
+  },
+});
+
+const servers: HalServer[] = [];
+const clients: WebSocket[] = [];
+
+// The upgrade always authenticates u1: a list is scoped to the connection, so one identity is enough.
+const startEngine = async (options: WithHistory): Promise<string> => {
+  const hal = createServer({
+    app: (() => undefined) as unknown as Express,
+    wsAuth: async () => ({id: 'u1'}),
+    orchestrator: answeringOrchestrator,
+    ...options,
+  });
+  await hal.start(0);
+  servers.push(hal);
+  const {port} = hal.server.address() as AddressInfo;
+  return `ws://127.0.0.1:${port}/hal/ws`;
+};
+
+const open = (url: string): WebSocket => {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 't']);
+  clients.push(client);
+  return client;
+};
+
+const settle = async (): Promise<void> => {
+  await new Promise(resolve => setTimeout(resolve, 100));
+};
+
+// Connects, sends one frame, collects until the first answer lands, then settles so any late frame is counted too.
+const ask = async (base: string, frame: Record<string, unknown>): Promise<{client: WebSocket; frames: Frame[]}> => {
+  const client = open(base);
+  const frames: Frame[] = [];
+  await new Promise<void>(resolve => {
+    client.on('message', raw => {
+      const parsed = JSON.parse(String(raw)) as Frame;
+      frames.push(parsed);
+      if (parsed.type === 'connected') client.send(JSON.stringify(frame));
+      if (frames.length === 2) resolve();
+    });
+  });
+  await settle();
+  return {client, frames};
+};
+
+const rowsOf = (frames: Frame[]): Row[] => {
+  const list = frames.find(({type}) => type === 'conversation_list');
+  return (list?.conversations ?? []) as Row[];
+};
+
+// A ping sent on connect is a barrier: its pong can only follow every frame the replay wrote.
+const connectAndSettle = async (url: string): Promise<Frame[]> => {
+  const client = open(url);
+  const frames: Frame[] = [];
+  await new Promise<void>(resolve => {
+    client.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as Frame;
+      frames.push(frame);
+      if (frame.type === 'connected') client.send(JSON.stringify({type: 'ping', timestamp: 1}));
+      if (frame.type === 'pong') resolve();
+    });
+  });
+  return frames;
+};
+
+const upserts = (frames: Frame[]) =>
+  frames.filter(({type}) => type === 'entry_upsert').map(({index, entry}) => ({index, entry}));
+
+const deferredTurn = (): {held: Promise<void>; release: () => void} => {
+  let release = (): void => undefined;
+  const held = new Promise<void>(resolve => {
+    release = resolve;
+  });
+  return {held, release: () => release()};
+};
+
+// Rejects with a named message if the awaited frame never lands, so a missing answer fails instead of hanging.
+const within = async <T>(pending: Promise<T>, ifNever: string): Promise<T> => {
+  let giveUp: ReturnType<typeof setTimeout> | undefined;
+  try {
+    return await Promise.race([
+      pending,
+      new Promise<never>((_, reject) => {
+        giveUp = setTimeout(() => reject(new Error(ifNever)), 2000);
+      }),
+    ]);
+  } finally {
+    clearTimeout(giveUp);
+  }
+};
+
+describe("a user's conversation list over the WebSocket protocol", () => {
+  // Declared before captureErrors, so every socket closes while the capture logger is still installed.
+  afterEach(async () => {
+    for (const client of clients.splice(0)) client.terminate();
+    for (const hal of servers.splice(0)) {
+      const {wss} = hal;
+      for (let attempt = 0; attempt < 50 && wss.clients.size > 0; attempt++) {
+        await new Promise(resolve => setTimeout(resolve, 10));
+      }
+      await hal.stop();
+    }
+  });
+
+  const loggedErrors = captureErrors();
+
+  it('answers a list_conversations frame with the user conversations newest first, own row included, and no stream_end', async () => {
+    const store = seededWith([
+      ['c1', 'u1', '2026-09-30T08:00:00.000Z'],
+      ['c2', 'u1', '2026-09-30T09:00:00.000Z'],
+      ['c3', 'u1', '2026-09-30T10:00:00.000Z'],
+    ]);
+    const base = await startEngine({sessionStore: store, resume: {enabled: true}, history: {enabled: true}});
+
+    const {client, frames} = await ask(base, {type: 'list_conversations'});
+    const connectedId = frames[0].sessionId ?? '';
+    const rows = rowsOf(frames);
+
+    // The conversation the connection is in is listed like any other, so a fresh connect sees a row of its own.
+    expect({
+      types: frames.map(({type}) => type),
+      lists: frames.filter(({type}) => type === 'conversation_list').length,
+      sessionIds: rows.map(({sessionId}) => sessionId),
+      entryCounts: rows.map(({entryCount}) => entryCount),
+      isoTimes: rows.map(({createdAt, updatedAt}) => [
+        typeof createdAt,
+        typeof updatedAt,
+        Number.isNaN(Date.parse(createdAt)),
+        Number.isNaN(Date.parse(updatedAt)),
+      ]),
+      rowKeys: rows.map(row => Object.keys(row).sort()),
+      leakedContent: JSON.stringify(frames).includes(CONTENT),
+    }).toEqual({
+      types: ['connected', 'conversation_list'],
+      lists: 1,
+      sessionIds: [connectedId, 'c3', 'c2', 'c1'],
+      entryCounts: [0, 1, 1, 1],
+      isoTimes: rows.map(() => ['string', 'string', false, false]),
+      rowKeys: rows.map(() => ['createdAt', 'entryCount', 'sessionId', 'updatedAt']),
+      leakedContent: false,
+    });
+
+    client.close();
+    await once(client, 'close');
+
+    // An id from a row opens the conversation through the resume path that already exists; no second replay path.
+    const reopened = await connectAndSettle(`${base}?sessionId=c2`);
+
+    expect({connected: reopened[0], replay: upserts(reopened)}).toMatchObject({
+      connected: {type: 'connected', sessionId: 'c2', resumed: true, entryCount: 1},
+      replay: [{index: 0, entry: {role: 'user', content: `${CONTENT} (c2)`}}],
+    });
+  });
+
+  it('lists the connecting user even when the frame names another, asking the store for the connection userId', async () => {
+    const inner = seededWith([
+      ['mine', 'u1', '2026-09-30T08:00:00.000Z'],
+      ['theirs', 'u2', '2026-09-30T09:00:00.000Z'],
+    ]);
+    const calls: ListCall[] = [];
+    const base = await startEngine({sessionStore: recordingListFor(inner, calls), history: {enabled: true}});
+
+    const {frames} = await ask(base, {type: 'list_conversations', userId: 'u2'});
+    const connectedId = frames[0].sessionId ?? '';
+
+    expect({
+      askedFor: calls.map(({userId}) => userId),
+      listed: rowsOf(frames).map(({sessionId}) => sessionId),
+      answered: frames.filter(({type}) => type === 'conversation_list').length,
+    }).toEqual({
+      askedFor: ['u1'],
+      listed: [connectedId, 'mine'],
+      answered: 1,
+    });
+  });
+
+  it('hands limit and before to the store as the frame sent them and pages from the cursor it carried', async () => {
+    const inner = seededWith([
+      ['c1', 'u1', '2026-09-30T08:00:00.000Z'],
+      ['c2', 'u1', '2026-09-30T09:00:00.000Z'],
+      ['c3', 'u1', '2026-09-30T10:00:00.000Z'],
+    ]);
+    const calls: ListCall[] = [];
+    const base = await startEngine({sessionStore: recordingListFor(inner, calls), history: {enabled: true}});
+    const before = {updatedAt: '2026-09-30T09:00:00.000Z', sessionId: 'c2'};
+
+    const {frames} = await ask(base, {type: 'list_conversations', limit: 2, before});
+
+    expect({
+      call: calls.map(({userId, options}) => ({userId, options})),
+      page: rowsOf(frames).map(({sessionId}) => sessionId),
+    }).toEqual({
+      call: [{userId: 'u1', options: {limit: 2, before}}],
+      page: ['c1'],
+    });
+  });
+
+  it('answers UNSUPPORTED and never a list when history is off, the store cannot list, or the store raises StoreCannotList', async () => {
+    // New public surface: a store says "I can never list" so a permanent misconfiguration is not read as a failure.
+    const storeCannotList = (publicApi as unknown as {StoreCannotList?: new (message: string) => Error})
+      .StoreCannotList;
+    expect(storeCannotList).toEqual(expect.any(Function));
+    const StoreCannotList = storeCannotList as new (message: string) => Error;
+
+    const inner = seededWith([
+      ['c1', 'u1', '2026-09-30T08:00:00.000Z'],
+      ['c2', 'u1', '2026-09-30T09:00:00.000Z'],
+    ]);
+    const cases: Record<string, WithHistory> = {
+      off: {sessionStore: inner},
+      noListFor: {sessionStore: fiveMembers(inner), history: {enabled: true}},
+      storeCannotList: {
+        sessionStore: {
+          ...fiveMembers(inner),
+          listFor: () => {
+            throw new StoreCannotList('the collection this store was built on implements no find, so it cannot list');
+          },
+        },
+        history: {enabled: true},
+      },
+    };
+
+    const answers: Record<string, unknown> = {};
+    for (const [name, options] of Object.entries(cases)) {
+      const {frames} = await ask(await startEngine(options), {type: 'list_conversations'});
+      answers[name] = {
+        types: frames.slice(1).map(({type}) => type),
+        codes: frames.filter(({type}) => type === 'error').map(({code}) => code),
+        listed: frames.some(({type}) => type === 'conversation_list'),
+      };
+    }
+
+    expect(answers).toEqual({
+      off: {types: ['error'], codes: ['UNSUPPORTED'], listed: false},
+      noListFor: {types: ['error'], codes: ['UNSUPPORTED'], listed: false},
+      storeCannotList: {types: ['error'], codes: ['UNSUPPORTED'], listed: false},
+    });
+  });
+
+  it('answers a rejecting store with SERVER_ERROR and no store detail, keeps the socket open, and logs the session id alone', async () => {
+    const DETAIL = 'ECONNREFUSED 127.0.0.1:27017';
+    const inner = seededWith([['c1', 'u1', '2026-09-30T08:00:00.000Z']]);
+    const store: SessionStore = {
+      ...fiveMembers(inner),
+      listFor: async () => {
+        throw new Error(DETAIL);
+      },
+    };
+    const base = await startEngine({sessionStore: store, history: {enabled: true}});
+
+    const {client, frames} = await ask(base, {type: 'list_conversations'});
+    const sessionId = frames[0].sessionId ?? '';
+
+    client.send(JSON.stringify({type: 'ping', timestamp: 9}));
+    const [pong] = (await once(client, 'message')) as [Buffer];
+
+    expect({
+      errors: frames.filter(({type}) => type === 'error').map(({code, message}) => ({code, message})),
+      stillAnswering: JSON.parse(String(pong)),
+      loggedSessions: loggedErrors.map(({sessionId: id}) => id),
+      leaked:
+        JSON.stringify({frames, log: loggedErrors}).includes(DETAIL) ||
+        JSON.stringify({frames, log: loggedErrors}).includes(CONTENT),
+    }).toEqual({
+      errors: [{code: 'SERVER_ERROR', message: expect.any(String)}],
+      stillAnswering: {type: 'pong', timestamp: 9},
+      loggedSessions: [sessionId],
+      leaked: false,
+    });
+  });
+
+  it('accepts a bare list_conversations frame at the validator and refuses a bad limit or a one-half cursor, naming the field', () => {
+    const cursor = {updatedAt: '2026-09-30T09:00:00.000Z', sessionId: 'c2'};
+
+    expect(validateMessage({type: 'list_conversations'})).toEqual({valid: true, data: {type: 'list_conversations'}});
+    expect(validateMessage({type: 'list_conversations', limit: 200, before: cursor}).valid).toBe(true);
+
+    // `before` is the store's two-part cursor: the validator refuses either half alone, as the frame must carry both.
+    const refusals: Array<[Record<string, unknown>, string]> = [
+      [{limit: 0}, 'limit'],
+      [{limit: 201}, 'limit'],
+      [{limit: 1.5}, 'limit'],
+      [{limit: '10'}, 'limit'],
+      [{before: 'not a date'}, 'before'],
+      [{before: {updatedAt: cursor.updatedAt}}, 'before'],
+      [{before: {sessionId: cursor.sessionId}}, 'before'],
+      [{before: {updatedAt: 'not a date', sessionId: 'c2'}}, 'before'],
+    ];
+    const verdicts = refusals.map(([fields, field]) => {
+      const verdict = validateMessage({type: 'list_conversations', ...fields});
+      return {valid: verdict.valid, namesField: verdict.valid ? false : verdict.error.includes(field)};
+    });
+
+    expect(verdicts).toEqual(refusals.map(() => ({valid: false, namesField: true})));
+  });
+
+  it('answers a list request while a user_message streams on the session, before that turn stream_end', async () => {
+    const turn = deferredTurn();
+    const store = seededWith([['c1', 'u1', '2026-09-30T08:00:00.000Z']]);
+    const holdingOrchestrator: ChatOrchestrator = {
+      processMessage: async () => 'hi',
+      async *processMessageStream(): AsyncGenerator<MessageChunk> {
+        await turn.held;
+        yield {type: 'text', text: 'late'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+    };
+    const base = await startEngine({sessionStore: store, orchestrator: holdingOrchestrator, history: {enabled: true}});
+
+    const client = open(base);
+    const types: string[] = [];
+    client.on('message', raw => types.push((JSON.parse(String(raw)) as {type: string}).type));
+    const seen = (until: string): Promise<void> =>
+      new Promise(resolve => {
+        const onMessage = (raw: Buffer): void => {
+          if ((JSON.parse(String(raw)) as {type: string}).type === until) {
+            client.off('message', onMessage);
+            resolve();
+          }
+        };
+        client.on('message', onMessage);
+      });
+
+    await seen('connected');
+    const listed = seen('conversation_list');
+    const ended = seen('stream_end');
+    client.send(JSON.stringify({type: 'user_message', content: 'hold this'}));
+    await seen('entry_upsert');
+
+    await within(listed, 'conversation_list was not answered while the turn was held');
+
+    expect({
+      seenWhileHeld: types.includes('conversation_list'),
+      endedWhileHeld: types.includes('stream_end'),
+    }).toEqual({seenWhileHeld: true, endedWhileHeld: false});
+
+    turn.release();
+    await ended;
+
