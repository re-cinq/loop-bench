+++ b/src/transport/conversationListTransport.acceptance.test.ts
@@ -0,0 +1,434 @@
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import type {Express} from 'express';
+import {createServer} from './createServer.js';
+import type {HalServer, HalServerOptions} from './createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {answeringOrchestrator, deferred} from './wsTestSupport.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {validateMessage} from './ws/validation.js';
+import {captureErrors} from '../shared/logCaptureTestSupport.js';
+import {setLogger} from '../shared/logger.js';
+import type {ChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import type {MessageChunk} from '../types/ai.js';
+import type {SessionListOptions, SessionStore, SessionSummary} from '../types/sessionStore.js';
+
+// Acceptance tests for the conversation list over the WebSocket (re-cinq/HALEngine#144): whose list a
+// `list_conversations` frame answers, what the wire carries, and what the engine refuses. Real upgrades
+// over real sockets, which no double can stand in for.
+
+interface SummaryRow {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+
+interface Frame {
+  type: string;
+  code?: string;
+  message?: string;
+  sessionId?: string;
+  resumed?: boolean;
+  entryCount?: number;
+  conversations?: SummaryRow[];
+  index?: number;
+  entry?: {role: string; content?: string};
+  [key: string]: unknown;
+}
+
+const USER = {id: 'u1'};
+const T = (ms: number): string => new Date(Date.UTC(2026, 0, 1, 0, 0, 0, ms)).toISOString();
+const ISO = (value: unknown): boolean =>
+  typeof value === 'string' && !Number.isNaN(Date.parse(value)) && new Date(value).toISOString() === value;
+
+// A real store that remembers what the handler asked of `listFor`, so the test can read the recorded
+// argument rather than infer it from the answer.
+class RecordingStore extends InMemorySessionStore {
+  readonly listCalls: Array<{userId: string | number; options: SessionListOptions | undefined}> = [];
+
+  override listFor(userId: string | number, options?: SessionListOptions): SessionSummary[] {
+    this.listCalls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+// A store written against the five original members, before `listFor` existed: a real shape, not a double.
+const storeWithoutListFor: SessionStore = {
+  create: (sessionId, userId) => ({sessionId, userId, entries: []}),
+  get: async () => undefined,
+  delete: async () => true,
+  count: async () => 0,
+  clear: async () => undefined,
+};
+
+class FailingStore extends InMemorySessionStore {
+  override listFor(): Promise<SessionSummary[]> {
+    return Promise.reject(new Error('ECONNREFUSED 127.0.0.1:27017: the conversations collection failed'));
+  }
+}
+
+const servers: HalServer[] = [];
+const clients: WebSocket[] = [];
+
+const eventually = async (check: () => boolean): Promise<void> => {
+  for (let attempt = 0; attempt < 50 && !check(); attempt++) await new Promise(resolve => setTimeout(resolve, 10));
+};
+
+const settle = async (ms = 250): Promise<void> => {
+  await new Promise(resolve => setTimeout(resolve, ms));
+};
+
+// Bounded wait that never rejects: a frame that never comes leaves the later assertions to say so.
+const waitFor = async (check: () => boolean, ms = 3000): Promise<void> => {
+  const deadline = Date.now() + ms;
+  while (!check() && Date.now() < deadline) await new Promise(resolve => setTimeout(resolve, 10));
+};
+
+// Silence the engine's own logging for the whole file; the last test captures errors of its own.
+const quiet = {debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined};
+
+beforeAll(() => {
+  setLogger(quiet);
+});
+
+afterAll(() => {
+  setLogger();
+});
+
+afterEach(async () => {
+  // CaptureErrors restores the console logger on its way out; the teardown below must stay silent.
+  setLogger(quiet);
+  for (const client of clients.splice(0)) client.terminate();
+  for (const hal of servers.splice(0)) {
+    const {wss} = hal;
+    await eventually(() => wss.clients.size === 0);
+    await hal.stop();
+  }
+});
+
+type ServerOptions = Partial<HalServerOptions> & Pick<HalServerOptions, 'sessionStore'>;
+
+const startServer = async (options: ServerOptions): Promise<string> => {
+  const hal = createServer({
+    app: (() => undefined) as unknown as Express,
+    wsAuth: async () => USER,
+    orchestrator: answeringOrchestrator,
+    ...options,
+  });
+  await hal.start(0);
+  servers.push(hal);
+  const {port} = hal.server.address() as AddressInfo;
+  return `ws://127.0.0.1:${port}/hal/ws`;
+};
+
+// `history` is this ticket's new option. Cast at the one boundary: it keeps the file compiling before
+// and after the option exists, and the behaviour behind it is what the tests judge.
+const withHistory = (options: ServerOptions): ServerOptions =>
+  ({...options, history: {enabled: true}}) as ServerOptions;
+
+const connect = (url: string): WebSocket => {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 't']);
+  clients.push(client);
+  return client;
+};
+
+// One listener per socket, kept for its whole life: the frames, in order, are the contract.
+const recorder = (client: WebSocket): {frames: Frame[]; types: () => string[]} => {
+  const frames: Frame[] = [];
+  client.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  return {frames, types: () => frames.map(frame => frame.type)};
+};
+
+const send = (client: WebSocket, frame: unknown): void => {
+  client.send(JSON.stringify(frame));
+};
+
+const listOf = (frames: Frame[]): SummaryRow[] =>
+  frames.find(frame => frame.type === 'conversation_list')?.conversations ?? [];
+
+// [type] for the frames that carry no code, so an expectation names exactly what the wire held.
+const shape = (frame: Frame): unknown[] => (frame.code === undefined ? [frame.type] : [frame.type, frame.code]);
+
+const seed = (store: InMemorySessionStore, id: string, userId: string, at: string, contents: string[]): void => {
+  const session = store.create(id, userId);
+  for (const content of contents) session.entries.push({role: 'user', content, timestamp: at});
+};
+
+describe('the conversation list on the websocket', () => {
+  it('answers a list_conversations with exactly one conversation_list, newest first, its times as ISO strings, and no stream_end', async () => {
+    const store = new RecordingStore();
+    seed(store, 'conv-1', 'u1', T(1000), ['oldest question']);
+    seed(store, 'conv-2', 'u1', T(2000), ['middle question']);
+    seed(store, 'conv-3', 'u1', T(3000), ['newest question']);
+    seed(store, 'conv-other', 'u2', T(4000), ["another user's conversation"]);
+    const base = await startServer(
+      // Resume on, so the connection rejoins `conv-3` and the store holds exactly three for u1.
+      withHistory({sessionStore: store, resume: {enabled: true, latest: true}})
+    );
+
+    const client = connect(base);
+    const {frames, types} = recorder(client);
+    await waitFor(() => types().includes('entry_upsert'));
+    await settle();
+
+    send(client, {type: 'list_conversations'});
+    await settle();
+
+    expect(types()).toEqual(['connected', 'entry_upsert', 'conversation_list']);
+
+    const rows = listOf(frames);
+    expect(rows.map(row => [row.sessionId, row.updatedAt, row.entryCount])).toEqual([
+      ['conv-3', T(3000), 1],
+      ['conv-2', T(2000), 1],
+      ['conv-1', T(1000), 1],
+    ]);
+    for (const row of rows) {
+      expect(`${row.sessionId} createdAt ${ISO(row.createdAt)}`).toBe(`${row.sessionId} createdAt true`);
+      expect(Object.keys(row).sort().join(',')).toBe('createdAt,entryCount,sessionId,updatedAt');
+    }
+
+    // ConnectedMessage is unchanged by this issue: resume's own fields, and nothing new.
+    const connected = frames.find(frame => frame.type === 'connected');
+    expect(Object.keys(connected ?? {}).sort()).toEqual([
+      'entryCount',
+      'examplePrompts',
+      'message',
+      'resumed',
+      'sessionId',
+      'type',
+    ]);
+  });
+
+  it('passes limit and before to listFor exactly as the frame sent them, taking the user from the connection and never the frame', async () => {
+    const store = new RecordingStore();
+    seed(store, 'conv-1', 'u1', T(1000), ['oldest question']);
+    seed(store, 'conv-2', 'u1', T(2000), ['middle question']);
+    seed(store, 'conv-3', 'u1', T(3000), ['newest question']);
+    seed(store, 'conv-other', 'u2', T(4000), ["another user's conversation"]);
+    const base = await startServer(withHistory({sessionStore: store, resume: {enabled: true, latest: true}}));
+
+    const client = connect(base);
+    const {frames, types} = recorder(client);
+    await waitFor(() => types().includes('entry_upsert'));
+    await settle();
+
+    send(client, {type: 'list_conversations'});
+    await settle();
+
+    // A frame naming another user is still answered with this connection's own list, and the store was
+    // asked for the connecting user - read on the recorded argument, not inferred from the answer.
+    send(client, {
+      type: 'list_conversations',
+      limit: 2,
+      before: {updatedAt: T(2000), sessionId: 'conv-2'},
+      userId: 'u2-the-impostor',
+    });
+    await settle();
+
+    expect(frames.filter(frame => frame.type === 'conversation_list')).toHaveLength(2);
+    expect(listOf(frames.slice(-1)).map(row => row.sessionId)).toEqual(['conv-1']);
+
+    expect(store.listCalls.map(call => call.userId)).toEqual(['u1', 'u1']);
+    // The options object is passed on with both keys, undefined included, rather than omitted.
+    expect(store.listCalls[0]?.options).toStrictEqual({limit: undefined, before: undefined});
+    expect(store.listCalls[1]?.options).toStrictEqual({
+      limit: 2,
+      before: {updatedAt: T(2000), sessionId: 'conv-2'},
+    });
+    expect(store.listCalls[1]?.options?.before?.updatedAt).toBe(T(2000));
+  });
+
+  it('answers a list_conversations asked while a turn streams, before the stream_end of that turn', async () => {
+    const gate = deferred();
+    const store = new InMemorySessionStore();
+    const pausing: ChatOrchestrator = {
+      processMessage: async () => 'hi',
+      async *processMessageStream(): AsyncGenerator<MessageChunk> {
+        yield {type: 'text', text: 'half an answer'};
+        await gate.until;
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+    };
+    const base = await startServer(withHistory({sessionStore: store, orchestrator: pausing}));
+
+    const client = connect(base);
+    const {frames, types} = recorder(client);
+    await waitFor(() => types().includes('connected'));
+    send(client, {type: 'user_message', content: 'a question that streams slowly'});
+    await waitFor(() => types().includes('entry_delta'));
+
+    // The turn still holds the lock, mid-stream: the history request must not queue behind it.
+    send(client, {type: 'list_conversations'});
+    await settle(300);
+    expect(types().includes('conversation_list')).toBe(true);
+
+    gate.release();
+    await waitFor(() => types().includes('stream_end'));
+    await settle();
+
+    expect(types().filter(type => type === 'conversation_list')).toHaveLength(1);
+    expect(types().filter(type => type === 'error')).toEqual([]);
+    expect(types().indexOf('conversation_list')).toBeLessThan(types().indexOf('stream_end'));
+  });
+
+  it('hands a conversation_list row to ?sessionId= and rejoins that conversation, with no new transport path', async () => {
+    const store = new InMemorySessionStore();
