index 0000000..836e497
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,410 @@
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import type {Express} from 'express';
+import {createServer} from './createServer.js';
+import type {HalServerOptions} from './createServer.js';
+import type {SessionResumeOptions} from './ws/sessionResume.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+import {answeringOrchestrator, deferred} from './wsTestSupport.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {ChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import type {MessageChunk} from '../types/ai.js';
+import type {SessionListOptions, SessionStore, SessionSummary} from '../types/sessionStore.js';
+import {setLogger} from '../shared/logger.js';
+
+// A conversation list delivered over the WebSocket itself, so no consumer has to stand up a second,
+// authenticated HTTP route over the same personal data the engine authenticated on the upgrade.
+
+interface Row {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+
+interface Frame {
+  type: string;
+  sessionId?: string;
+  resumed?: boolean;
+  code?: string;
+  message?: string;
+  conversations?: Row[];
+}
+
+// Typed beside HalServerOptions rather than inside it, so the file compiles before the option is named and after.
+type ServerOptions = HalServerOptions & {history?: {enabled: boolean}};
+
+const SILENT = {debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined};
+const servers: Array<ReturnType<typeof createServer>> = [];
+const clients: WebSocket[] = [];
+
+// Entry stamps are fixed far ahead of any run date, so the newest-first order never depends on the clock.
+const sentAt = (second: number): string => `2031-01-01T00:00:0${second}.000Z`;
+const CURSOR_AT_A = '2031-01-01T00:00:04.000Z';
+
+const seed = (store: InMemorySessionStore, conversations: Array<[id: string, owner: string, at: string]>): void => {
+  for (const [sessionId, userId, timestamp] of conversations) {
+    const {entries} = store.create(sessionId, userId);
+    entries.push({role: 'user', content: sessionId, timestamp});
+  }
+};
+
+const storeWith = (conversations: Array<[id: string, owner: string, at: string]>): InMemorySessionStore => {
+  const store = new InMemorySessionStore();
+  seed(store, conversations);
+  return store;
+};
+
+// Records what the transport asked the store for, which is where the authorisation assertion lives.
+class RecordingListStore extends InMemorySessionStore {
+  readonly calls: Array<{userId: string | number; options: {limit?: number; before?: unknown}}> = [];
+  override listFor(userId: string | number, options?: SessionListOptions): SessionSummary[] {
+    this.calls.push({userId, options: {limit: options?.limit, before: options?.before}});
+    return super.listFor(userId, options);
+  }
+}
+
+// A store written against the five original members, with no listFor to answer a history frame with.
+const withoutList = (inner: InMemorySessionStore): SessionStore => ({
+  create: (sessionId, userId, options) => inner.create(sessionId, userId, options),
+  get: sessionId => inner.get(sessionId),
+  delete: sessionId => inner.delete(sessionId),
+  count: () => inner.count(),
+  clear: () => inner.clear(),
+});
+
+// A database that failed mid-read, whose own detail must never reach the client's frame.
+const withFailingList = (inner: InMemorySessionStore): SessionStore => ({
+  ...withoutList(inner),
+  listFor: async () => {
+    throw new Error('replica set rs/eu-west-1 unreachable');
+  },
+});
+
+const parkedAnswer = (gate: {until: Promise<void>}): ChatOrchestrator => ({
+  processMessage: async () => 'hi',
+  async *processMessageStream(): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'first '};
+    await gate.until;
+    yield {type: 'text', text: 'second'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+});
+
+const startEngine = async (
+  sessionStore: SessionStore,
+  extra: {history?: {enabled: boolean}; resume?: SessionResumeOptions; orchestrator?: ChatOrchestrator} = {}
+): Promise<string> => {
+  const options: ServerOptions = {
+    app: (() => undefined) as unknown as Express,
+    wsAuth: async () => ({id: 'u1'}),
+    sessionStore,
+    orchestrator: extra.orchestrator ?? answeringOrchestrator,
+    resume: extra.resume,
+    history: extra.history,
+  };
+  const hal = createServer(options);
+  await hal.start(0);
+  servers.push(hal);
+  const {port} = hal.server.address() as AddressInfo;
+  return `ws://127.0.0.1:${port}/hal/ws`;
+};
+
+const connect = (
+  url: string
+): {client: WebSocket; frames: Frame[]; send: (frame: unknown) => void; until: (type: string) => Promise<void>} => {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 't']);
+  clients.push(client);
+  const frames: Frame[] = [];
+  client.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  return {
+    client,
+    frames,
+    send: frame => client.send(JSON.stringify(frame)),
+    // Capped well under jest's own five second timeout, so a red test reports its diff instead of dying.
+    until: async type => {
+      for (let attempt = 0; attempt < 250 && !frames.some(frame => frame.type === type); attempt++) {
+        await new Promise(resolve => setTimeout(resolve, 10));
+      }
+    },
+  };
+};
+
+const list = (fields: Record<string, unknown> = {}): Record<string, unknown> => ({
+  type: 'list_conversations',
+  ...fields,
+});
+const typesOf = (frames: Frame[]): string[] => frames.map(frame => frame.type);
+const frameOf = (frames: Frame[], type: string): Frame | undefined => frames.find(frame => frame.type === type);
+const iso = (value: string): boolean => Number.isFinite(Date.parse(value));
+
+beforeAll(() => {
+  setLogger(SILENT);
+});
+
+afterAll(() => {
+  setLogger();
+});
+
+// Each server sees its sockets close before it stops, so no close is logged after the logger is restored.
+afterEach(async () => {
+  for (const client of clients.splice(0)) client.terminate();
+  for (const hal of servers.splice(0)) {
+    const {wss} = hal;
+    for (let attempt = 0; attempt < 50 && wss.clients.size > 0; attempt++) {
+      await new Promise(resolve => setTimeout(resolve, 10));
+    }
+    await hal.stop();
+  }
+});
+
+describe('a conversation list delivered over the websocket', () => {
+  it('accepts list_conversations and refuses a limit or a cursor it cannot use, naming the field', () => {
+    const verdictOf = (frame: unknown): string => {
+      const result = validateMessage(frame);
+      if (!result.valid) {
+        return /limit/.test(result.error)
+          ? 'invalid: limit'
+          : /before/.test(result.error)
+            ? 'invalid: before'
+            : 'invalid: other';
+      }
+      return 'valid';
+    };
+
+    expect({
+      bare: verdictOf({type: 'list_conversations'}),
+      // There is no user id field on the frame, so an extra one is an ignored field, not a validation failure.
+      carryingAnotherUsersId: verdictOf({type: 'list_conversations', userId: 'mallory'}),
+      smallestLimit: verdictOf({type: 'list_conversations', limit: 1}),
+      largestLimit: verdictOf({type: 'list_conversations', limit: 200}),
+      wholeCursor: verdictOf({type: 'list_conversations', before: {updatedAt: CURSOR_AT_A, sessionId: 's1'}}),
+      zeroLimit: verdictOf({type: 'list_conversations', limit: 0}),
+      overLargeLimit: verdictOf({type: 'list_conversations', limit: 201}),
+      fractionalLimit: verdictOf({type: 'list_conversations', limit: 1.5}),
+      stringLimit: verdictOf({type: 'list_conversations', limit: '10'}),
+      unusableBefore: verdictOf({type: 'list_conversations', before: 'not a date'}),
+      epochBefore: verdictOf({type: 'list_conversations', before: {updatedAt: 1767225604000, sessionId: 's1'}}),
+      cursorWithoutId: verdictOf({type: 'list_conversations', before: {updatedAt: CURSOR_AT_A}}),
