+      await watch.once('connected');
+      await askForList(watch);
+      const answer = watch.seen.find(frame => frame.type === 'error');
+      return {
+        frames: watch.seen.map(frame => frame.type),
+        code: answer?.code ?? '',
+        hadList: watch.seen.some(frame => frame.type === 'conversation_list'),
