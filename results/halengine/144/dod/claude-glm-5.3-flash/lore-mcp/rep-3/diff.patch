+    const switchedOff = await refusalFrom(sessionsHolding([['seed-summer', 'u1', '2025-06-01T09:00:00.000Z']]).store);
+    const withoutListFor = await refusalFrom(sessionsHolding([], 'absent').store, {enabled: true});
+    const cannotList = await refusalFrom(sessionsHolding([], 'cannot').store, {enabled: true});
+
+    const rejecting = sessionsHolding([['seed-summer', 'u1', '2025-06-01T09:00:00.000Z']], 'rejects').store;
+    const rejectUrl = await startEngine({store: rejecting, asUser: 'u1', history: {enabled: true}});
+    const client = open(rejectUrl);
