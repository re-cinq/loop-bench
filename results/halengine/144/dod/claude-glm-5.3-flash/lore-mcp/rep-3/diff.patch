+        hadList: watch.seen.some(frame => frame.type === 'conversation_list'),
+        storeDetail: (answer?.message ?? '').includes('collection'),
+        socketOpen: client.readyState === WebSocket.OPEN,
+        loggedSessionId: errorLines.some(line => line.sessionId === sessionId),
+      },
