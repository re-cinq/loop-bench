+    await watch.once('connected');
+    const sessionId = watch.seen[0].sessionId ?? '';
+    const errorLines: Array<Record<string, unknown>> = [];
+    setLogger({...quiet, error: (category, message, fields) => void errorLines.push({category, message, ...fields})});
+    try {
+      await askForList(watch);
+    } finally {
+      setLogger(quiet);
+    }
+    const answer = watch.seen.find(frame => frame.type === 'error');
