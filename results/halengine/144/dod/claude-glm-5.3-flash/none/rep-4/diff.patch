+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import type {Express} from 'express';
+import {createHalEngine} from '../config.js';
+import type {HalEngineConfig} from '../config.js';
+import {createServer} from './createServer.js';
+import type {HalServer, HalServerOptions} from './createServer.js';
+import {validateMessage} from './ws/validation.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import type {SessionResumeOptions} from './ws/sessionResume.js';
+import {answeringOrchestrator, deferred} from './wsTestSupport.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {ChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import type {MessageChunk} from '../types/ai.js';
+import type {IncomingMessage, OutgoingMessage} from '../types/messages.js';
+import type {SessionListOptions, SessionStore} from '../types/sessionStore.js';
+import {setLogger} from '../shared/logger.js';
+
+// A user's conversation list answered over the authenticated socket itself: real engine, real store, real socket.
+
+const USER = {id: 'u1'};
+
+// Every frame the protocol answered before this ticket: the typed half of the messages.ts additive pin.
+const BEFORE: {incoming: IncomingMessage[]; outgoing: OutgoingMessage[]} = {
+  incoming: [
+    {type: 'ping', timestamp: 1},
+    {type: 'user_message', content: 'hello'},
+  ],
+  outgoing: [
+    {type: 'connected', sessionId: 's', message: 'Connected', examplePrompts: []},
+    {type: 'entry_upsert', index: 0, entry: {role: 'user', content: 'hi', timestamp: '2026-01-01T00:00:00.000Z'}},
+    {type: 'entry_delta', index: 1, delta: 'more'},
+    {type: 'entry_commit', index: 1},
+    {type: 'entry_skip', index: 2},
+    {type: 'error', code: 'SERVER_ERROR', message: 'x'},
+    {type: 'pong', timestamp: 1},
+    {type: 'stream_end'},
+  ],
+};
+
+interface Summary {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+
+interface Frame {
+  type: string;
+  sessionId?: string;
+  resumed?: boolean;
+  entryCount?: number;
+  index?: number;
+  code?: string;
+  message?: string;
+  conversations?: Summary[];
+  entry?: {role: string; content?: string};
+  timestamp?: number;
+}
+
+const SUMMARY_KEYS = ['createdAt', 'entryCount', 'sessionId', 'updatedAt'];
+
+// Activity stamped ahead of the run, so the order a list answers in is decided by these stamps alone.
+const AT = ['2030-01-01T00:00:01.000Z', '2030-01-01T00:00:02.000Z', '2030-01-01T00:00:03.000Z'];
+
+const seedConversation = (store: InMemorySessionStore, sessionId: string, at: string, entries: number): void => {
+  const session = store.create(sessionId, USER.id);
+  for (let n = 0; n < entries; n++) session.entries.push({role: 'user', content: `entry ${n}`, timestamp: at});
+};
+
+interface ListCall {
+  userId: string | number;
+  options?: SessionListOptions;
+}
+
+// A real in-memory store with a recorder over its list: the handler's call is asserted on the recorded argument.
+const storeOver = (listFor?: NonNullable<SessionStore['listFor']>): {store: SessionStore; calls: ListCall[]} => {
+  const inner = new InMemorySessionStore();
+  const calls: ListCall[] = [];
+  const store: SessionStore = {
+    create: (sessionId, userId, options) => inner.create(sessionId, userId, options),
+    get: sessionId => inner.get(sessionId),
+    delete: sessionId => inner.delete(sessionId),
+    count: () => inner.count(),
+    clear: () => inner.clear(),
+    lookup: sessionId => inner.lookup(sessionId),
+    listFor:
+      listFor ??
+      ((userId, options) => {
+        calls.push({userId, options});
+        return inner.listFor(userId, options);
+      }),
+  };
+  return {store, calls};
+};
+
+// The same store written against its five original members: it holds conversations but cannot list them.
+const fiveMemberStore = (): SessionStore => {
+  const holding = storeOver();
+  const {listFor: _omitted, ...members} = holding.store;
+  return members;
+};
+
+const servers: HalServer[] = [];
+const clients: WebSocket[] = [];
+
+const quiet = (): void => undefined;
+const SILENT = {debug: quiet, info: quiet, warn: quiet, error: quiet};
+
+const settle = (ms: number): Promise<void> => new Promise(resolve => setTimeout(resolve, ms));
+
+const eventually = async (check: () => boolean): Promise<void> => {
+  for (let attempt = 0; attempt < 50 && !check(); attempt++) await new Promise(resolve => setTimeout(resolve, 10));
+};
+
+beforeAll(() => setLogger(SILENT));
+afterAll(() => setLogger());
+
+afterEach(async () => {
+  for (const client of clients.splice(0)) client.terminate();
+  for (const hal of servers.splice(0)) {
+    const {wss} = hal;
+    await eventually(() => wss.clients.size === 0);
+    await hal.stop();
+  }
+});
+
+const startEngine = async (options: {
+  sessionStore: SessionStore;
+  history?: {enabled: boolean};
+  resume?: SessionResumeOptions;
+  orchestrator?: ChatOrchestrator;
+}): Promise<{url: string; hal: HalServer}> => {
+  const hal = createServer({
+    app: (() => undefined) as unknown as Express,
+    wsAuth: async () => USER,
+    sessionStore: options.sessionStore,
+    orchestrator: options.orchestrator ?? answeringOrchestrator,
+    resume: options.resume,
+    // The opt-in this ticket adds beside `resume`; the assertion carries the key while the option type lacks it.
+    history: options.history,
+  } as HalServerOptions);
+  await hal.start(0);
+  servers.push(hal);
+  const {port} = hal.server.address() as AddressInfo;
+  return {url: `ws://127.0.0.1:${port}/hal/ws`, hal};
+};
+
+const open = (url: string): WebSocket => {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 't']);
+  clients.push(client);
+  return client;
+};
+
+// Every frame the engine sends, in arrival order, with a wait that resolves on the first frame of a kind.
+const transcript = (client: WebSocket) => {
+  const seen: Frame[] = [];
+  client.on('message', raw => seen.push(JSON.parse(String(raw)) as Frame));
+  return {
+    seen,
+    firstOf: (type: string) => seen.findIndex(frame => frame.type === type),
+    wait: (type: string) =>
+      new Promise<Frame>(resolve => {
+        const already = seen.find(frame => frame.type === type);
+        if (already !== undefined) {
+          resolve(already);
+          return;
+        }
+        client.on('message', raw => {
+          const frame = JSON.parse(String(raw)) as Frame;
+          if (frame.type === type) resolve(frame);
+        });
+      }),
+  };
+};
+
+const send = (client: WebSocket, frame: Record<string, unknown>): void => {
+  client.send(JSON.stringify(frame));
+};
+
+describe('the conversation list over the websocket protocol', () => {
+  describe('validateMessage', () => {
+    it('still accepts the frames the protocol already answered, pinned by the messages.ts fixture', () => {
+      const oldFrames = BEFORE.incoming.map(frame => validateMessage(frame));
+      expect({
+        stillValid: oldFrames.map(result => result.valid),
+        outgoingTypes: BEFORE.outgoing.map(frame => frame.type),
+      }).toEqual({
+        stillValid: [true, true],
+        outgoingTypes: [
+          'connected',
+          'entry_upsert',
+          'entry_delta',
+          'entry_commit',
+          'entry_skip',
+          'error',
+          'pong',
+          'stream_end',
+        ],
+      });
+    });
+
+    it('accepts a bare frame, a limit inside 1-200, and a whole cursor', () => {
+      const cursor = {updatedAt: AT[1], sessionId: 's2'};
+      const bare = validateMessage({type: 'list_conversations'});
+      const capped = validateMessage({type: 'list_conversations', limit: 200});
+      const paged = validateMessage({type: 'list_conversations', limit: 200, before: cursor});
+      expect({
+        bare: bare.valid,
+        capped: capped.valid,
+        paged: paged.valid,
+        carried: paged.valid ? paged.data : paged.error,
+      }).toEqual({
+        bare: true,
+        capped: true,
+        paged: true,
+        carried: {type: 'list_conversations', limit: 200, before: cursor},
+      });
+    });
+
+    it('refuses a limit outside 1-200 or not an integer, naming the field', () => {
+      const verdictOf = (limit: unknown): {valid: boolean; namesLimit: boolean} => {
+        const result = validateMessage({type: 'list_conversations', limit});
+        return {valid: result.valid, namesLimit: !result.valid && result.error.includes('limit')};
+      };
+      expect({
+        zero: verdictOf(0),
+        over: verdictOf(201),
+        fractional: verdictOf(1.5),
+        string: verdictOf('10'),
+      }).toEqual({
+        zero: {valid: false, namesLimit: true},
+        over: {valid: false, namesLimit: true},
+        fractional: {valid: false, namesLimit: true},
+        string: {valid: false, namesLimit: true},
+      });
+    });
+
+    it('refuses a cursor that is not a whole one, naming before', () => {
+      const verdictOf = (before: unknown): {valid: boolean; namesBefore: boolean} => {
+        const result = validateMessage({type: 'list_conversations', before});
+        return {valid: result.valid, namesBefore: !result.valid && result.error.includes('before')};
+      };
+      expect({
+        string: verdictOf('not a date'),
+        stampOnly: verdictOf({updatedAt: AT[1]}),
+        idOnly: verdictOf({sessionId: 's2'}),
+        unusableStamp: verdictOf({updatedAt: 'not a date', sessionId: 's2'}),
+      }).toEqual({
+        string: {valid: false, namesBefore: true},
+        stampOnly: {valid: false, namesBefore: true},
+        idOnly: {valid: false, namesBefore: true},
+        unusableStamp: {valid: false, namesBefore: true},
+      });
+    });
+  });
+
+  describe('over the wire', () => {
+    it('answers a list_conversations frame with the conversations of the authenticated user, newest first', async () => {
+      const store = new InMemorySessionStore();
+      seedConversation(store, 's1', AT[0], 1);
+      seedConversation(store, 's2', AT[1], 2);
+      seedConversation(store, 's3', AT[2], 3);
+
+      const config: HalEngineConfig = {
+        provider: {type: 'mock'},
+        prompt: {identity: 'test'},
+        auth: {ws: async () => USER},
+        session: store,
+        // The opt-in rides `transport` beside `resume`; the assertion carries the key while the type lacks it.
+        transport: {history: {enabled: true}} as unknown as HalEngineConfig['transport'],
+      };
+      const hal = createHalEngine(config);
+      await hal.start(0);
+      servers.push(hal);
+      const {port} = hal.server.address() as AddressInfo;
+
+      const client = open(`ws://127.0.0.1:${port}/hal/ws`);
+      const wire = transcript(client);
+      const connected = await wire.wait('connected');
+      send(client, {type: 'list_conversations'});
+      await settle(200);
+
+      const rows = wire.seen.find(frame => frame.type === 'conversation_list')?.conversations ?? [];
+      const live = connected.sessionId ?? '';
+      expect({
+        afterConnected: wire.seen.slice(wire.firstOf('connected') + 1).map(frame => frame.type),
+        order: rows.map(row => row.sessionId),
+        entryCounts: rows.map(row => row.entryCount),
+        stamps: rows.slice(0, 3).map(row => row.updatedAt),
+        createdISO: rows.every(row => !Number.isNaN(Date.parse(row.createdAt))),
+        updatedISO: rows.every(row => !Number.isNaN(Date.parse(row.updatedAt))),
+        keys: rows.map(row => Object.keys(row).sort()),
+        ownRowLast: rows.at(-1)?.sessionId === live && rows.at(-1)?.entryCount === 0,
+        connectedFields: Object.keys(connected).sort(),
+      }).toEqual({
+        afterConnected: ['conversation_list'],
+        order: ['s3', 's2', 's1', live],
+        entryCounts: [3, 2, 1, 0],
+        stamps: [AT[2], AT[1], AT[0]],
+        createdISO: true,
+        updatedISO: true,
+        keys: [SUMMARY_KEYS, SUMMARY_KEYS, SUMMARY_KEYS, SUMMARY_KEYS],
+        ownRowLast: true,
+        connectedFields: ['examplePrompts', 'message', 'sessionId', 'type'],
+      });
+    });
+
+    it('answers with the list of the connecting user alone, even when the frame names another', async () => {
+      const {store, calls} = storeOver();
+      store.create('mine-1', USER.id);
+      store.create('theirs-1', 'u2');
+
+      const {url} = await startEngine({sessionStore: store, history: {enabled: true}});
+      const client = open(url);
+      const wire = transcript(client);
+      const connected = await wire.wait('connected');
+      send(client, {type: 'list_conversations', userId: 'u2'});
+      await settle(150);
+
+      const rows = wire.seen.find(frame => frame.type === 'conversation_list')?.conversations ?? [];
+      expect({
+        askedAbout: calls.at(-1)?.userId,
+        rows: rows.map(row => row.sessionId),
+        theirsListed: rows.some(row => row.sessionId === 'theirs-1'),
+      }).toEqual({
+        askedAbout: USER.id,
+        rows: [connected.sessionId, 'mine-1'],
+        theirsListed: false,
+      });
+    });
+
+    it('hands the frame limit and cursor to the store the frame sent them', async () => {
+      const {store, calls} = storeOver();
+      store.create('s1', USER.id);
+
+      const {url} = await startEngine({sessionStore: store, history: {enabled: true}});
+      const client = open(url);
+      const wire = transcript(client);
+      await wire.wait('connected');
+      send(client, {type: 'list_conversations', limit: 2, before: {updatedAt: AT[1], sessionId: 's1'}});
+      await settle(150);
+      send(client, {type: 'list_conversations'});
+      await settle(150);
+
+      const bare = calls.at(-1);
+      expect({
+        paged: calls[0],
+        bareLimit: bare?.options?.limit,
+        bareCursor: bare?.options?.before,
+        askedAbout: calls.map(call => call.userId),
+      }).toEqual({
+        paged: {userId: USER.id, options: {limit: 2, before: {updatedAt: AT[1], sessionId: 's1'}}},
+        bareLimit: undefined,
+        bareCursor: undefined,
+        askedAbout: [USER.id, USER.id],
+      });
+    });
+
+    it('answers UNSUPPORTED while history is off, and while the store cannot list at all', async () => {
+      const {url: offUrl} = await startEngine({sessionStore: new InMemorySessionStore()});
+      const offClient = open(offUrl);
+      const offWire = transcript(offClient);
+      await offWire.wait('connected');
+      send(offClient, {type: 'list_conversations'});
+      await settle(150);
+
+      const unable = fiveMemberStore();
+      unable.create('held-1', USER.id);
+      const {url: unableUrl} = await startEngine({sessionStore: unable, history: {enabled: true}});
+      const unableClient = open(unableUrl);
+      const unableWire = transcript(unableClient);
+      await unableWire.wait('connected');
+      send(unableClient, {type: 'list_conversations'});
+      await settle(150);
+
+      const refusalOf = (wire: ReturnType<typeof transcript>) => ({
+        frames: wire.seen.slice(1).map(frame => frame.type),
+        code: wire.seen.find(frame => frame.type === 'error')?.code,
+        listed: wire.firstOf('conversation_list') !== -1,
+      });
+      expect({off: refusalOf(offWire), unableStore: refusalOf(unableWire)}).toEqual({
+        off: {frames: ['error'], code: 'UNSUPPORTED', listed: false},
+        unableStore: {frames: ['error'], code: 'UNSUPPORTED', listed: false},
+      });
+    });
+
+    it('answers a rejecting store with a server error that names nothing, the socket kept and the session logged', async () => {
+      const detail = 'ECONNREFUSED 10.1.2.3:27017';
+      const {store} = storeOver(async () => {
+        throw new Error(detail);
+      });
+      const logged: Array<Record<string, unknown>> = [];
+      setLogger({
+        debug: quiet,
+        info: quiet,
+        warn: quiet,
+        error: (category, message, fields) => void logged.push({category, message, ...fields}),
+      });
+      try {
+        const {url} = await startEngine({sessionStore: store, history: {enabled: true}});
+        const client = open(url);
