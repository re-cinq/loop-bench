+  it('answers list_conversations while a turn on the same session is still streaming, before that turn ends', async () => {
+    const gate = deferred();
+    try {
+      const streaming: ChatOrchestrator = {
+        processMessage: async () => 'late',
+        async *processMessageStream(): AsyncGenerator<MessageChunk> {
+          yield {type: 'text', text: 'half'};
+          await gate.until;
+          yield {type: 'stop', stopReason: 'end_turn'};
+        },
+      };
+      const base = await startEngine({
+        store: new InMemorySessionStore(),
+        history: {enabled: true},
+        orchestrator: streaming,
+      });
+      const {client, wire, sessionId} = await openConnection(base);
+
+      send(client, {type: 'user_message', content: 'a long question'});
+      await wire.next('the turn to start', frame => frame.type === 'entry_upsert');
+      send(client, {type: 'list_conversations'});
+      const listed = await wire.next(
+        'a conversation_list frame while the turn is still streaming',
+        frame => frame.type === 'conversation_list'
+      );
+      const turnStillStreaming = !wire.frames.some(frame => frame.type === 'stream_end');
+      gate.release();
+      await wire.next('the turn to end', frame => frame.type === 'stream_end');
+
+      expect({
+        answered: (listed.frame.conversations ?? []).map(row => row.sessionId),
+        answeredBeforeTurnEnd: turnStillStreaming,
+        order: wire.frames
+          .map(frame => frame.type)
+          .filter(type => type === 'conversation_list' || type === 'stream_end' || type === 'error'),
+      }).toEqual({
+        answered: [sessionId],
+        answeredBeforeTurnEnd: true,
+        order: ['conversation_list', 'stream_end'],
+      });
+    } finally {
+      gate.release();
+    }
+  });
