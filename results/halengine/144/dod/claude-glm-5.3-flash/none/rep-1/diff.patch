+  it('validates the frame whether or not history is on, refusing a bad limit or before with the field named', async () => {
+    const base = await startEngine({store: new InMemorySessionStore(), history: {enabled: true}});
+    const {client, wire} = await openConnection(base);
+    const cases: Array<[Record<string, unknown>, string]> = [
+      [{type: 'list_conversations', limit: 0}, 'limit'],
+      [{type: 'list_conversations', limit: 201}, 'limit'],
+      [{type: 'list_conversations', limit: 1.5}, 'limit'],
+      [{type: 'list_conversations', limit: '10'}, 'limit'],
+      [{type: 'list_conversations', before: 'not a date'}, 'before'],
+      [{type: 'list_conversations', before: {updatedAt: '2026-03-01T00:00:00.000Z'}}, 'before|sessionId'],
+      [{type: 'list_conversations', before: {sessionId: 'conv-old'}}, 'before|updatedAt'],
+    ];
+    const refusals: Array<{code: string; named: boolean}> = [];
+    let cursor = 0;
+    for (const [frame, field] of cases) {
+      send(client, frame);
+      const answered = await wire.next(
+        `an error for ${JSON.stringify(frame)}`,
+        frame => frame.type === 'error',
+        cursor
+      );
+      cursor = answered.after;
+      refusals.push({code: answered.frame.code ?? '', named: new RegExp(field).test(String(answered.frame.message))});
+    }
+    await settle(100);
+
+    const offBase = await startEngine({store: new InMemorySessionStore()});
+    const off = await openConnection(offBase);
+    send(off.client, {type: 'list_conversations', limit: 0});
+    const offAnswered = await off.wire.next('an error with history off', frame => frame.type === 'error');
+    await settle(100);
+
+    expect({
+      refusals,
+      historyOnList: wire.frames.some(frame => frame.type === 'conversation_list'),
+      offCode: offAnswered.frame.code,
+      offNamed: /limit/.test(String(offAnswered.frame.message)),
+    }).toEqual({
+      refusals: Array.from({length: cases.length}, () => ({code: 'INVALID_MESSAGE', named: true})),
+      historyOnList: false,
+      offCode: 'INVALID_MESSAGE',
+      offNamed: true,
+    });
+  });
