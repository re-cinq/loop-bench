+function installLogSink(warnings: string[], errors: Array<{message: string; meta?: Record<string, unknown>}>): void {
+  const ignore = (): void => undefined;
+  setLogger({
+    debug: ignore,
+    info: ignore,
+    warn: (_category, message) => {
+      warnings.push(message);
+    },
+    error: (_category, message, meta) => {
+      errors.push({message, meta});
+    },
+  });
