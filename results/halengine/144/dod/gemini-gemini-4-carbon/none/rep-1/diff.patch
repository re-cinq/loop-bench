+function collectionLackingFind(): CollectionLike<MongoSessionDocument> {
+  return {
+    findOne: async () => null,
+    updateOne: async () => undefined,
+    deleteOne: async () => ({deletedCount: 0}),
+    deleteMany: async () => ({deletedCount: 0}),
+    countDocuments: async () => 0,
+  };
+}
