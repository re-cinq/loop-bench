+
+function seededStore(): {
+  backing: InMemorySessionStore;
+  store: SessionStore;
+  recorded: RecordedListCall[];
+} {
+  const backing = new InMemorySessionStore();
+  const older = backing.create('s1', 'u1');
+  older.entries.push({role: 'user', content: 'older chat', timestamp: '2099-01-01T00:01:00.000Z'});
+  const newer = backing.create('s2', 'u1');
+  newer.entries.push(
+    {role: 'user', content: 'pick me', timestamp: '2099-01-01T00:02:00.000Z'},
+    {role: 'assistant', content: 'picked reply', timestamp: '2099-01-01T00:02:05.000Z', isStreaming: false}
+  );
+  const otherUsers = backing.create('theirs', 'u2');
+  otherUsers.entries.push({role: 'user', content: 'other user chat', timestamp: '2099-01-01T00:05:00.000Z'});
+  const recorded: RecordedListCall[] = [];
+  return {backing, store: recordingStore(backing, recorded), recorded};
+}
+
+function recordingStore(backing: InMemorySessionStore, recorded: RecordedListCall[]): SessionStore {
+  return delegatingStore(backing, {
+    listFor: (userId, options) => {
+      recorded.push({
+        userId,
+        limit: options?.limit,
+        before: normalizedCursor(options?.before),
+      });
+      return backing.listFor(userId, options);
+    },
+  });
+}
+
+function normalizedCursor(before: SessionListOptions['before']): {updatedAt: string; sessionId: string} | undefined {
+  if (!before) return undefined;
+  const updatedAt = before.updatedAt instanceof Date ? before.updatedAt.toISOString() : String(before.updatedAt);
+  return {updatedAt, sessionId: before.sessionId};
+}
+
+async function twoPagesFrom(
+  client: OpenClient
+): Promise<{first: WireSummary[]; second: WireSummary[]; cursor: {updatedAt: string; sessionId: string}}> {
+  const firstFrames = await askFrames(client, {type: 'list_conversations', limit: 2}, 2);
+  const first = firstFrames[0]?.conversations ?? [];
+  const secondRow = first[1];
+  const cursor = {
+    updatedAt: secondRow?.updatedAt ?? '2099-01-01T00:01:00.000Z',
+    sessionId: secondRow?.sessionId ?? 's1',
+  };
+  const secondFrames = await askFrames(client, {type: 'list_conversations', limit: 2, before: cursor}, 3);
+  const second = secondFrames[0]?.conversations ?? [];
+  return {first, second, cursor};
+}
+
+function wireRowsFrom(store: InMemorySessionStore, userId: string): WireSummary[] {
+  return store.listFor(userId).map(row => ({
+    sessionId: row.sessionId,
+    createdAt: row.createdAt.toISOString(),
+    updatedAt: row.updatedAt.toISOString(),
+    entryCount: row.entryCount,
+  }));
+}
+
+function areIsoStamps(rows: WireSummary[]): boolean {
+  return rows.length > 0 && rows.every(row => isIsoString(row.createdAt) && isIsoString(row.updatedAt));
+}
+
+function isIsoString(stamp: unknown): boolean {
+  return typeof stamp === 'string' && ISO_STAMP.test(stamp) && !Number.isNaN(Date.parse(stamp));
+}
+
+async function resumeListedConversation(
+  baseUrl: string,
+  sessionId: string,
+  userToken: string
+): Promise<{
+  resumed: boolean | undefined;
+  sessionId: string | undefined;
+  entryCount: number | undefined;
+  replayedTexts: string[];
+}> {
+  const client = await openClient(`${baseUrl}?sessionId=${encodeURIComponent(sessionId)}`, userToken);
+  const expected = client.connected.entryCount ?? 0;
+  const needed = expected - client.replayed.length;
+  const remaining = needed > 0 ? await takeCount(client, needed) : [];
+  const replayed = [...client.replayed, ...remaining];
+  const replayedTexts = replayed
+    .filter(frame => frame.type === 'entry_upsert')
+    .map(frame => frame.entry?.content ?? '');
+  client.close();
+  return {
+    resumed: client.connected.resumed,
+    sessionId: client.connected.sessionId,
+    entryCount: client.connected.entryCount,
+    replayedTexts,
+  };
+}
+
+function takeCount(client: OpenClient, count: number): Promise<WireFrame[]> {
+  let seen = 0;
+  return client.take(() => {
+    seen += 1;
+    return seen >= count;
+  });
+}
+
+function rejectingListStore(failure: Error): SessionStore {
+  return delegatingStore(new InMemorySessionStore(), {
+    listFor: () => Promise.reject(failure),
+  });
+}
+
+function delegatingStore(backing: InMemorySessionStore, overrides: Partial<SessionStore>): SessionStore {
+  return {
+    ...fiveMemberStore(backing),
+    lookup: sessionId => backing.lookup(sessionId),
+    evict: sessionId => backing.evict(sessionId),
+    latestFor: userId => backing.latestFor(userId),
+    ...overrides,
+  };
+}
+
+function fiveMemberStore(backing = new InMemorySessionStore()): SessionStore {
+  return {
+    create: (sessionId, userId, options) => backing.create(sessionId, userId, options),
+    get: sessionId => backing.get(sessionId),
+    delete: sessionId => backing.delete(sessionId),
+    count: () => backing.count(),
+    clear: () => backing.clear(),
+  };
+}
+
+function bareMongoStore(): SessionStore {
+  const collection: CollectionLike = {
+    findOne: async () => null,
+    updateOne: async () => undefined,
+    deleteOne: async () => ({deletedCount: 0}),
+    countDocuments: async () => 0,
+    deleteMany: async () => undefined,
+  };
+  return new MongoSessionStore({collection});
+}
+
+async function startupWarningCount(transport: HistoryTransport): Promise<number> {
+  const capture = createLogCapture();
+  await startConversationEngine({transport, logger: capture.logger});
+  const count = capture.warnings.length;
+  setLogger(createLogCapture().logger);
+  return count;
+}
+
+function createLogCapture(): {
+  logger: Logger;
+  warnings: Array<Record<string, unknown>>;
+  errors: Array<Record<string, unknown>>;
+  all: Array<Record<string, unknown>>;
+} {
+  const warnings: Array<Record<string, unknown>> = [];
+  const errors: Array<Record<string, unknown>> = [];
+  const all: Array<Record<string, unknown>> = [];
+  const logger: Logger = {
+    debug: (_category, message, fields) => void all.push({level: 'debug', message, ...fields}),
+    info: (_category, message, fields) => void all.push({level: 'info', message, ...fields}),
+    warn: (_category, message, fields) => {
+      const record = {level: 'warn', message, ...fields};
+      warnings.push(record);
+      all.push(record);
+    },
+    error: (_category, message, fields) => {
+      const record = {level: 'error', message, ...fields};
+      errors.push(record);
+      all.push(record);
+    },
+  };
+  return {logger, warnings, errors, all};
+}
+
+function gatePair(): {wait: Promise<void>; open: () => void} {
+  let open = (): void => undefined;
+  const wait = new Promise<void>(resolve => {
+    open = resolve;
+  });
+  return {wait, open};
+}
+
+async function listReplyFrom(spec: EngineSpec, pingStamp: number): Promise<WireFrame[]> {
+  const baseUrl = await startConversationEngine(spec);
+  const client = await openClient(baseUrl, 'u1');
+  const frames = await askFrames(client, {type: 'list_conversations'}, pingStamp);
+  client.close();
+  return frames;
+}
+
+async function startConversationEngine(spec: EngineSpec): Promise<string> {
+  const transport = spec.transport ?? {port: 0};
+  const engine = createHalEngine({
+    provider: {type: 'mock'},
+    prompt: {identity: 'Conversation history acceptance test.'},
+    session: spec.session,
+    transport,
+    orchestrator: spec.hooks ? {hooks: spec.hooks} : undefined,
+    logger: spec.logger,
+    auth: {
+      ws: async request => {
+        const token = credentialFromSubprotocol(request.headers['sec-websocket-protocol']);
+        return token ? {id: token} : null;
+      },
+    },
+  });
+  await engine.start(0);
+  activeEngines.push(engine);
+  const port = boundPort(engine);
+  return `ws://127.0.0.1:${port}/hal/ws`;
+}
+
+function boundPort(engine: HalEngine): number {
+  const address = engine.server.address();
+  if (typeof address === 'object' && address !== null) return address.port;
+  throw new Error('Expected bound TCP address');
+}
+
+function openClient(url: string, userToken: string): Promise<OpenClient> {
+  const socket = new WebSocket(url, [HAL_WS_SUBPROTOCOL, userToken]);
+  activeSockets.push(socket);
+  const backlog: WireFrame[] = [];
+  const waiters: Array<(frame: WireFrame) => void> = [];
+
+  socket.on('message', raw => {
+    const parsed = JSON.parse(String(raw)) as WireFrame;
+    const nextWaiter = waiters.shift();
+    if (nextWaiter) {
+      nextWaiter(parsed);
+      return;
+    }
+    backlog.push(parsed);
+  });
+
+  function take(predicate: (frame: WireFrame) => boolean): Promise<WireFrame[]> {
+    const collected: WireFrame[] = [];
+    return new Promise((resolve, reject) => {
+      const step = (frame: WireFrame): void => {
+        collected.push(frame);
+        if (predicate(frame)) {
+          resolve(collected);
+          return;
+        }
+        const buffered = backlog.shift();
+        if (buffered) {
+          step(buffered);
+          return;
+        }
+        waiters.push(step);
+      };
+
+      socket.once('error', reject);
+      const initial = backlog.shift();
+      if (initial) {
+        step(initial);
+        return;
+      }
+      waiters.push(step);
+    });
+  }
+
+  return take(frame => frame.type === 'connected').then(frames => ({
+    connected: frames[0]!,
+    replayed: backlog.splice(0),
+    send: payload => socket.send(JSON.stringify(payload)),
+    take,
+    isOpen: () => socket.readyState === WebSocket.OPEN,
+    close: () => socket.close(),
+  }));
+}
+
+async function askFrames(
+  client: OpenClient,
+  payload: Record<string, unknown>,
+  pingStamp: number
+): Promise<WireFrame[]> {
+  client.send(payload);
+  const firstBatch = await collectUntilPong(client, pingStamp);
+  // One second ping round-trip lets an async store.listFor settle before we stop reading.
+  const secondBatch = await collectUntilPong(client, pingStamp + 1000);
+  return [...firstBatch, ...secondBatch];
+}
+
+async function collectUntilPong(client: OpenClient, stamp: number): Promise<WireFrame[]> {
+  client.send({type: 'ping', timestamp: stamp});
+  const frames = await client.take(frame => frame.type === 'pong' && frame.timestamp === stamp);
+  return frames.filter(frame => frame.type !== 'pong');
+}
+
+function drainThrough(client: OpenClient, terminalType: string): Promise<WireFrame[]> {
+  return client.take(frame => frame.type === terminalType);
+}
+
+async function stopActive(): Promise<void> {
+  const serverCloses = activeEngines
+    .flatMap(engine => [...engine.wss.clients])
+    .filter(peer => peer.readyState !== WebSocket.CLOSED)
+    .map(peer => once(peer, 'close'));
+  for (const socket of activeSockets.splice(0)) {
+    if (socket.readyState === WebSocket.CLOSED) continue;
+    const closed = once(socket, 'close');
+    socket.terminate();
+    await closed;
+  }
+  await Promise.all(serverCloses);
+  for (const engine of activeEngines.splice(0)) await engine.stop();
+}