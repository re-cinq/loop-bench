+import {once} from 'node:events';
+import {WebSocket} from 'ws';
+import * as halRoot from './index.js';
+import {MongoSessionStore} from './infrastructure/stores/mongo/index.js';
+import {fakeCollection} from './infrastructure/stores/mongo/mongoTestSupport.js';
+import {setLogger} from './shared/logger.js';
+import {connectClient, deferred, startEngineWith, stopEngines} from './transport/wsTestSupport.js';
+import {validateMessage} from './transport/ws/validation.js';
+import type {ChatOrchestrator} from './orchestration/chatOrchestrator.js';
+import type {ProviderConfig} from './providers/providerFactory.js';
+import type {MessageChunk} from './types/ai.js';
+import type {WsAuthenticator} from './types/auth.js';
+import type {SessionCursor, SessionListOptions, SessionStore} from './types/sessionStore.js';
+
+interface WireSummary {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+
+interface WireFrame {
+  type: string;
+  keys: string[];
+  sessionId?: string;
+  resumed?: boolean;
+  entryCount?: number;
+  code?: string;
+  message?: string;
+  timestamp?: number;
+  entryContent?: string;
+  conversations?: WireSummary[];
+  conversationRowKeys?: string[][];
+}
+
+interface RecordedListCall {
+  userId: string | number;
+  limit: number | undefined;
+  before: SessionCursor | undefined;
+}
+
+interface PagedHistoryResult {
+  connectedKeys: string[];
+  connectedSessionId: string | undefined;
+  firstFrameTypes: string[];
+  pageOne: WireSummary[];
+  rowKeys: string[][];
+  pageTwo: WireSummary[];
+  sentCursor: SessionCursor;
+  targetId: string;
+}
+
+const MOCK_PROVIDER: ProviderConfig = {type: 'mock'};
+const CURSOR_SAMPLE = {updatedAt: '2026-09-30T08:00:00.000Z', sessionId: 's1'};
+const runningEngines: Array<{wss: {clients: Set<WebSocket>}; stop: () => Promise<void>}> = [];
+
+describe('delivering a user conversation list over WebSocket', () => {
+  beforeEach(() => {
+    const quiet = () => undefined;
+    setLogger({debug: quiet, info: quiet, warn: quiet, error: quiet});
+  });
+
+  afterEach(async () => {
+    await stopEngines();
+    for (const engine of runningEngines.splice(0)) {
+      const {wss} = engine;
+      await drainClients(() => wss.clients.size === 0);
+      await engine.stop();
+    }
+  });
+
+  afterAll(async () => {
+    await pauseMs(25);
+    setLogger();
+  });
+
+  it('lists the authenticated user conversations, pages by cursor, and resumes a chosen id', async () => {
+    const recorded: RecordedListCall[] = [];
+    const store = recordingListCalls(new halRoot.InMemorySessionStore(), recorded);
+    const authState = {userId: 'u1'};
+    const base = await startConfiguredEngine(store, authState, {
+      port: 0,
+      resume: {enabled: true},
+      history: {enabled: true},
+    });
+    const seeded = await seedConversations(base, authState);
+    const listing = await openAndPageHistory(base);
+    const resumedFrames = await reconnectAndSettle(`${base}?sessionId=${listing.targetId}`);
+    const firstReplay = resumedFrames[1];
+
+    expect({
+      connectedKeys: listing.connectedKeys,
+      firstFrameTypes: listing.firstFrameTypes,
+      pageOneIds: listing.pageOne.map(row => row.sessionId),
+      pageOneCounts: listing.pageOne.map(row => row.entryCount),
+      rowKeys: listing.rowKeys,
+      isoStamps: listing.pageOne.every(row => isIsoTimestamp(row.createdAt) && isIsoTimestamp(row.updatedAt)),
+      pageTwoIds: listing.pageTwo.map(row => row.sessionId),
+      recorded,
+      resumedConnected: {
+        sessionId: resumedFrames[0]?.sessionId,
+        resumed: resumedFrames[0]?.resumed,
+        entryCount: resumedFrames[0]?.entryCount,
+      },
+      replayedFirstUserEntry: firstReplay?.entryContent,
+    }).toEqual({
+      connectedKeys: ['examplePrompts', 'message', 'resumed', 'sessionId', 'type'],
+      firstFrameTypes: ['conversation_list', 'pong'],
+      pageOneIds: [listing.connectedSessionId, seeded.secondId, seeded.firstId],
+      pageOneCounts: [0, 2, 2],
+      rowKeys: [
+        ['createdAt', 'entryCount', 'sessionId', 'updatedAt'],
+        ['createdAt', 'entryCount', 'sessionId', 'updatedAt'],
+        ['createdAt', 'entryCount', 'sessionId', 'updatedAt'],
+      ],
+      isoStamps: true,
+      pageTwoIds: [seeded.firstId],
+      recorded: [
+        {userId: 'u1', limit: undefined, before: undefined},
+        {userId: 'u1', limit: 1, before: listing.sentCursor},
+      ],
+      resumedConnected: {sessionId: seeded.firstId, resumed: true, entryCount: 2},
+      replayedFirstUserEntry: 'first chat',
+    });
+  });
+
+  it('answers list_conversations while a turn streams without waiting on the session lock', async () => {
+    const gate = deferred();
+    const streamingOrchestrator: ChatOrchestrator = {
+      processMessage: async () => 'streaming reply',
+      async *processMessageStream(): AsyncGenerator<MessageChunk> {
+        yield {type: 'text', text: 'Working...'};
+        await gate.until;
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+    };
+    const options = {
+      sessionStore: new halRoot.InMemorySessionStore(),
+      orchestrator: streamingOrchestrator,
+      resume: {enabled: true},
+      history: {enabled: true},
+    };
+    const {url} = await startEngineWith(options);
+    const outcome = await listDuringActiveStream(url, gate.release);
+
+    expect(outcome).toEqual({
+      beforeRelease: ['connected', 'entry_upsert', 'entry_upsert', 'entry_delta', 'conversation_list'],
+      afterRelease: ['entry_commit', 'stream_end'],
+      listedCountWhileStreaming: 1,
+    });
+  });
+
+  it('validates list_conversations limits and composite cursors, naming the bad field', async () => {
+    const base = await startConfiguredEngine(new halRoot.InMemorySessionStore(), {userId: 'u1'}, {port: 0});
+    const wireSocket = connectClient(base);
+    await framesThroughPong(wireSocket, 0);
+    const wireInvalid = await sendAndSettle(wireSocket, {type: 'list_conversations', limit: 0}, 1);
+    const bare = validateMessage({type: 'list_conversations', userId: 'u2'});
+    const paged = validateMessage({type: 'list_conversations', limit: 25, before: CURSOR_SAMPLE});
+    const invalidLimits = [0, 201, 1.5, '10'].map(limit => validateMessage({type: 'list_conversations', limit}));
+    const invalidCursors = [
+      validateMessage({type: 'list_conversations', before: 'not a date'}),
+      validateMessage({type: 'list_conversations', before: {updatedAt: CURSOR_SAMPLE.updatedAt}}),
+      validateMessage({type: 'list_conversations', before: {sessionId: 's1'}}),
+      validateMessage({type: 'list_conversations', before: {updatedAt: 'not a date', sessionId: 's1'}}),
+    ];
+
+    expect({
+      bare,
+      paged,
+      invalidLimits,
+      invalidCursors,
+      wireInvalidTypes: wireInvalid.map(frame => `${frame.type}:${frame.code ?? frame.timestamp}`),
+    }).toEqual({
+      bare: {valid: true, data: {type: 'list_conversations'}},
+      paged: {valid: true, data: {type: 'list_conversations', limit: 25, before: CURSOR_SAMPLE}},
+      invalidLimits: [
+        {valid: false, error: expect.stringMatching(/limit/i)},
+        {valid: false, error: expect.stringMatching(/limit/i)},
+        {valid: false, error: expect.stringMatching(/limit/i)},
+        {valid: false, error: expect.stringMatching(/limit/i)},
+      ],
+      invalidCursors: [
+        {valid: false, error: expect.stringMatching(/before/i)},
+        {valid: false, error: expect.stringMatching(/before|sessionId/i)},
+        {valid: false, error: expect.stringMatching(/before|updatedAt/i)},
+        {valid: false, error: expect.stringMatching(/before|updatedAt/i)},
+      ],
+      wireInvalidTypes: ['error:INVALID_MESSAGE', 'pong:1'],
+    });
+  });
+
+  it('answers UNSUPPORTED when history is off, listFor is absent, or a collection lacks find', async () => {
+    const warnings = installWarningCapture();
+    const warnOnlyUrl = await startConfiguredEngine(
+      new halRoot.InMemorySessionStore(),
+      {userId: 'u1'},
+      {
+        port: 0,
+        history: {enabled: true},
+      }
+    );
+    const [historyOff, warnOnly, absentListFor, absentFind] = await Promise.all([
+      startHistoryOffUrl().then(askListOnce),
+      askListOnce(warnOnlyUrl),
+      startAbsentListForUrl().then(askListOnce),
+      startAbsentFindUrl().then(askListOnce),
+    ]);
+    const exportsByName: Record<string, unknown> = {...halRoot};
+    const codesByName: Record<string, unknown> = {...halRoot.ErrorCodes};
+
+    expect({
+      exportedErrorClass: typeof exportsByName.StoreCannotList,
+      unsupportedCode: codesByName.UNSUPPORTED,
+      warnedWithoutResume: warnings.some(message => /history|resume/i.test(message)),
+      warnOnlyTypes: warnOnly.map(frame => frame.type),
+      historyOff: summaryError(historyOff),
+      absentListFor: summaryError(absentListFor),
+      absentFind: summaryError(absentFind),
+    }).toEqual({
+      exportedErrorClass: 'function',
+      unsupportedCode: 'UNSUPPORTED',
+      warnedWithoutResume: true,
+      warnOnlyTypes: ['conversation_list', 'pong'],
+      historyOff: {types: ['error', 'pong'], code: 'UNSUPPORTED'},
+      absentListFor: {types: ['error', 'pong'], code: 'UNSUPPORTED'},
+      absentFind: {types: ['error', 'pong'], code: 'UNSUPPORTED'},
+    });
+  });
+
+  it('answers a failing store with a generic SERVER_ERROR, stays open, and logs safely', async () => {
+    const loggedErrors = installErrorCapture();
+    const {client, sessionId} = await openWithConfidentialTurn(await startFailingListUrl());
+    const replyFrames = await sendAndSettle(client, {type: 'list_conversations'}, 9);
+    const errorMessage = replyFrames[0]?.message ?? '';
+    const serializedLogs = JSON.stringify(loggedErrors);
+
+    expect({
+      types: replyFrames.map(frame => frame.type),
+      code: replyFrames[0]?.code,
+      pongEcho: replyFrames[1]?.timestamp,
+      socketStillOpen: client.readyState === WebSocket.OPEN,
+      leakedHost: errorMessage.includes('10.0.4.12') || errorMessage.includes('stepdown'),
+      loggedSessionId: loggedErrors.some(entry => entry.sessionId === sessionId),
+      leakedUserContent: serializedLogs.includes('confidential medical note'),
+    }).toEqual({
+      types: ['error', 'pong'],
+      code: 'SERVER_ERROR',
+      pongEcho: 9,
+      socketStillOpen: true,
+      leakedHost: false,
+      loggedSessionId: true,
+      leakedUserContent: false,
+    });
+  });
+});
+
+function recordingListCalls(
+  inner: InstanceType<typeof halRoot.InMemorySessionStore>,
+  recorded: RecordedListCall[]
+): SessionStore {
+  return {
+    create: (sessionId, userId, options) => inner.create(sessionId, userId, options),
+    get: sessionId => inner.get(sessionId),
+    lookup: sessionId => inner.lookup(sessionId),
+    latestFor: userId => inner.latestFor(userId),
+    listFor: (userId: string | number, options?: SessionListOptions) => {
+      recorded.push({userId, limit: options?.limit, before: options?.before});
+      return inner.listFor(userId, options);
+    },
+    delete: sessionId => inner.delete(sessionId),
+    evict: sessionId => inner.evict(sessionId),
+    count: () => inner.count(),
+    clear: () => inner.clear(),
+  };
+}
+
+async function seedConversations(
+  base: string,
+  authState: {userId: string}
+): Promise<{firstId: string; secondId: string}> {
+  const firstId = await runSpacedTurn(base, 'first chat');
+  const secondId = await runSpacedTurn(base, 'second chat');
+  await runAsUser(base, authState, 'u2');
+  return {firstId, secondId};
+}
+
+async function runAsUser(base: string, authState: {userId: string}, userId: string): Promise<void> {
+  const previous = authState.userId;
+  authState.userId = userId;
+  await runSpacedTurn(base, 'stranger chat');
+  authState.userId = previous;
+}
+
+async function runSpacedTurn(base: string, content: string): Promise<string> {
+  const sessionId = await runOneTurn(base, content);
+  await pauseMs(10);
+  return sessionId;
+}
+
+async function runOneTurn(base: string, content: string): Promise<string> {
+  const client = connectClient(base);
+  const [connected] = await framesThroughPong(client, 0);
+  await sendTurnOnSocket(client, content);
+  client.close();
+  await once(client, 'close');
+  return connected?.sessionId ?? '';
+}
+
+async function openAndPageHistory(base: string): Promise<PagedHistoryResult> {
+  const listingSocket = connectClient(base);
+  const [connected] = await framesThroughPong(listingSocket, 0);
+  const firstBatch = await sendAndSettle(listingSocket, {type: 'list_conversations', userId: 'u2'}, 1);
+  const pageOne = firstBatch[0]?.conversations ?? [];
+  const sentCursor = cursorFromRow(pageOne[1]);
+  const secondBatch = await sendAndSettle(listingSocket, {type: 'list_conversations', limit: 1, before: sentCursor}, 2);
+  const pageTwo = secondBatch[0]?.conversations ?? [];
+
+  return {
+    connectedKeys: connected?.keys ?? [],
+    connectedSessionId: connected?.sessionId,
+    firstFrameTypes: firstBatch.map(frame => frame.type),
+    pageOne,
+    rowKeys: firstBatch[0]?.conversationRowKeys ?? [],
+    pageTwo,
+    sentCursor,
+    targetId: pageTwo[0]?.sessionId ?? 'missing',
+  };
+}
+
+function cursorFromRow(row: WireSummary | undefined): SessionCursor {
+  if (!row) return CURSOR_SAMPLE;
+  return {updatedAt: row.updatedAt, sessionId: row.sessionId};
+}
+
+async function reconnectAndSettle(url: string): Promise<WireFrame[]> {
+  const client = connectClient(url);
+  return framesThroughPong(client, 99);
+}
+
+async function listDuringActiveStream(
+  url: string,
+  releaseStream: () => void
+): Promise<{beforeRelease: string[]; afterRelease: string[]; listedCountWhileStreaming: number}> {
+  const client = connectClient(url);
+  const beforeRelease: string[] = [];
+  const afterRelease: string[] = [];
+  let released = false;
+  let listedCountWhileStreaming = -1;
+
+  await new Promise<void>(resolve => {
+    client.on('message', raw => {
+      const frame = parseFrame(raw);
+      if (!released) beforeRelease.push(frame.type);
+      if (released) afterRelease.push(frame.type);
+      if (frame.type === 'connected') {
+        client.send(JSON.stringify({type: 'user_message', content: 'hold the lock'}));
+        return;
+      }
+      if (frame.type === 'entry_delta') {
+        client.send(JSON.stringify({type: 'list_conversations'}));
+        return;
+      }
+      if (!released && (frame.type === 'conversation_list' || frame.type === 'error')) {
+        listedCountWhileStreaming = frame.conversations?.length ?? -1;
+        released = true;
+        releaseStream();
+        return;
+      }
+      if (frame.type === 'stream_end') resolve();
+    });
+  });
+
+  return {beforeRelease, afterRelease, listedCountWhileStreaming};
+}
