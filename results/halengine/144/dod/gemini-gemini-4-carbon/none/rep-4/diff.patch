+async function requestPagedRows(
+  socketClient: Awaited<ReturnType<typeof openConnectedSocket>>,
+  cursor: {updatedAt: unknown; sessionId: unknown}
+): Promise<WireConversationRow[]> {
+  socketClient.send({type: 'list_conversations', limit: 1, before: cursor});
+  const pagedReply = await socketClient.nextFrame();
+  return readConversationRows(pagedReply);
+}
