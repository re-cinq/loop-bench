+async function requestListAndSettle(
+  socketClient: Awaited<ReturnType<typeof openConnectedSocket>>,
+  payload: Record<string, unknown>
+) {
+  socketClient.send(payload);
+  const reply = await socketClient.nextFrame();
+  socketClient.send({type: 'ping', timestamp: 1});
+  const trailing = await socketClient.framesThrough('pong');
+  return {
+    replyType: reply.type,
+    trailingTypes: trailing.map(frame => frame.type),
+    rawRows: readRawRows(reply),
+    rows: readConversationRows(reply),
+  };
+}
