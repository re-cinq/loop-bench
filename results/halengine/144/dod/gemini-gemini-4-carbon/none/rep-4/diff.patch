@@ -0,0 +1,607 @@
+import {WebSocket} from 'ws';
+import * as publicApi from './index.js';
+import {createHalEngine} from './config.js';
+import type {HalEngine, HalEngineConfig} from './config.js';
+import {InMemorySessionStore} from './infrastructure/stores/inMemorySessionStore.js';
+import {MongoSessionStore} from './infrastructure/stores/mongo/mongoSessionStore.js';
+import type {CollectionLike} from './infrastructure/stores/mongo/mongoDriverTypes.js';
+import type {MongoSessionDocument} from './infrastructure/stores/mongo/mongoSessionDocument.js';
+import {setLogger} from './shared/logger.js';
+import type {Logger} from './shared/logger.js';
+import {HAL_WS_SUBPROTOCOL} from './transport/ws/subprotocol.js';
+import {validateMessage} from './transport/ws/validation.js';
+import type {ValidationResult} from './transport/ws/validation.js';
+import {deferred} from './transport/wsTestSupport.js';
+import type {WsAuthenticator} from './types/auth.js';
+import type {SessionListOptions, SessionStore} from './types/sessionStore.js';
+
+interface RecordedListCall {
+  userId: string | number;
+  limit: number | undefined;
+  before: unknown;
+}
+
+interface WireConversationRow {
+  sessionId: unknown;
+  createdAt: unknown;
+  updatedAt: unknown;
+  entryCount: unknown;
+}
+
+const HISTORY_AND_RESUME = {port: 0, history: {enabled: true}, resume: {enabled: true}};
+const HISTORY_ONLY = {port: 0, history: {enabled: true}};
+const SUMMARY_KEYS = ['createdAt', 'entryCount', 'sessionId', 'updatedAt'];
+const runningEngines: HalEngine[] = [];
+const openSockets: WebSocket[] = [];
+const silentLogger: Logger = {
+  debug: () => undefined,
+  info: () => undefined,
+  warn: () => undefined,
+  error: () => undefined,
+};
+
+beforeAll(() => {
+  setLogger(silentLogger);
+});
+
+afterEach(async () => {
+  for (const socket of openSockets.splice(0)) {
+    socket.terminate();
+  }
+  for (const engine of runningEngines.splice(0)) {
+    await drainServerClients(engine);
+    await engine.stop();
+  }
+  setLogger(silentLogger);
+});
+
+afterAll(() => {
+  setLogger();
+});
+
+it("lists the authenticated user's conversations newest first, pages by cursor, ignores a frame userId, and resumes a listed id", async () => {
+  const {backing, baseMs} = seededUserStore();
+  const storeCalls: RecordedListCall[] = [];
+  const wsUrl = await bootEngine({session: observedListStore(backing, storeCalls), transport: HISTORY_AND_RESUME});
+
+  const sessionClient = await openConnectedSocket(wsUrl);
+  const firstList = await requestListAndSettle(sessionClient, {type: 'list_conversations', userId: 'u2'});
+  const [headRow] = firstList.rows;
+  const expectedCursor = {updatedAt: new Date(baseMs + 120_000).toISOString(), sessionId: 'conv-newer'};
+  const nextCursor = headRow ? {updatedAt: headRow.updatedAt, sessionId: headRow.sessionId} : expectedCursor;
+  const pagedRows = await requestPagedRows(sessionClient, nextCursor);
+  const rejoined = await rejoinListedConversation(wsUrl, pagedRows);
+  const liveSessionId = String(sessionClient.connected.sessionId ?? '');
+
+  expect({
+    replyType: firstList.replyType,
+    trailingTypes: firstList.trailingTypes,
+    listedIds: firstList.rows.map(row => row.sessionId),
+    entryCounts: firstList.rows.map(row => row.entryCount),
+    rowKeys: firstList.rawRows.map(row => Object.keys(row).sort()),
+    isoTimes: areIsoRowTimestamps(firstList.rows),
+    newestUpdatedAt: headRow?.updatedAt,
+    pagedIds: pagedRows.map(row => row.sessionId),
+    storeCalls,
+    rejoined,
+  }).toEqual({
+    replyType: 'conversation_list',
+    trailingTypes: ['pong'],
+    listedIds: ['conv-newer', 'conv-older', liveSessionId],
+    entryCounts: [2, 1, 0],
+    rowKeys: [SUMMARY_KEYS, SUMMARY_KEYS, SUMMARY_KEYS],
+    isoTimes: true,
+    newestUpdatedAt: new Date(baseMs + 120_000).toISOString(),
+    pagedIds: ['conv-older'],
+    storeCalls: [
+      {userId: 'u1', limit: undefined, before: undefined},
+      {userId: 'u1', limit: 1, before: expectedCursor},
+    ],
+    rejoined: {
+      resumed: true,
+      sessionId: 'conv-older',
+      replayedCount: 1,
+    },
+  });
+});
+
+it('validates list_conversations limits and composite cursors, rejecting malformed fields as INVALID_MESSAGE', async () => {
+  const wireRejection = await probeWireLimitRejection();
+  const cursorValue = {updatedAt: '2026-01-15T10:00:00.000Z', sessionId: 's1'};
+  const bare = validateMessage({type: 'list_conversations'});
+  const withExtraField = validateMessage({type: 'list_conversations', userId: 'u2'});
+  const withCursor = validateMessage({
+    type: 'list_conversations',
+    limit: 200,
+    before: cursorValue,
+  });
+  const badLimits = [0, 201, 1.5, '10'].map(limit => validateMessage({type: 'list_conversations', limit}));
+  const bareBefore = validateMessage({type: 'list_conversations', before: 'not a date'});
+  const badCursors = malformedCursorInputs().map(before => validateMessage({type: 'list_conversations', before}));
+
+  expect({
+    bare,
+    withExtraField,
+    withCursor,
+    limitsNameField: badLimits.every(result => namesField(result, 'limit')),
+    bareBeforeNamesField: namesField(bareBefore, 'before'),
