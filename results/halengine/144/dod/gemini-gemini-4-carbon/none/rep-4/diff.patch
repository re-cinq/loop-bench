+
+async function openConnectedSocket(url: string) {
+  const socket = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'test-token']);
+  openSockets.push(socket);
+  const reader = createSocketReader(socket);
+  const connected = await reader.nextFrame();
+  return {
+    connected,
+    send: (payload: Record<string, unknown>) => socket.send(JSON.stringify(payload)),
+    nextFrame: reader.nextFrame,
+    framesThrough: reader.framesThrough,
+    nextListOrErrorWithin: reader.nextListOrErrorWithin,
+  };
+}
+
+function createSocketReader(socket: WebSocket) {
+  const queue: Record<string, unknown>[] = [];
+  const waiters: Array<(frame: Record<string, unknown>) => void> = [];
+
+  socket.on('message', raw => {
+    const parsed = parseJsonFrame(raw);
+    const waiter = waiters.shift();
+    if (waiter) {
+      waiter(parsed);
+      return;
+    }
+    queue.push(parsed);
+  });
+
+  const takeFrame = (): {promise: Promise<Record<string, unknown>>; cancel: () => void} => {
+    const buffered = queue.shift();
+    if (buffered) return {promise: Promise.resolve(buffered), cancel: () => undefined};
+    let waiter: ((frame: Record<string, unknown>) => void) | undefined;
+    const promise = new Promise<Record<string, unknown>>(resolve => {
+      waiter = resolve;
+      waiters.push(resolve);
+    });
+    const cancel = (): void => {
+      const index = waiter ? waiters.indexOf(waiter) : -1;
+      if (index >= 0) waiters.splice(index, 1);
+    };
+    return {promise, cancel};
+  };
+
+  const nextFrame = (): Promise<Record<string, unknown>> => takeFrame().promise;
+
+  const framesThrough = async (terminalType: string): Promise<Record<string, unknown>[]> => {
+    const collected: Record<string, unknown>[] = [];
+    while (collected.at(-1)?.type !== terminalType) {
+      collected.push(await nextFrame());
+    }
+    return collected;
+  };
+
+  const nextListOrErrorWithin = async (timeoutMs: number): Promise<Record<string, unknown>> => {
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    let stopped = false;
+    let cancelPending = (): void => undefined;
+    const timeoutPromise = new Promise<Record<string, unknown>>(resolve => {
+      timer = setTimeout(() => {
+        stopped = true;
+        cancelPending();
+        resolve({type: 'timed_out_behind_lock'});
+      }, timeoutMs);
+    });
+    const matchingFrame = async (): Promise<Record<string, unknown>> => {
+      while (!stopped && socket.readyState === WebSocket.OPEN) {
+        const pending = takeFrame();
+        cancelPending = pending.cancel;
+        const frame = await pending.promise;
+        if (frame.type === 'conversation_list' || frame.type === 'error') return frame;
+      }
+      return {type: 'socket_closed'};
+    };
+    const winner = await Promise.race([matchingFrame(), timeoutPromise]);
+    if (timer !== undefined) clearTimeout(timer);
+    return winner;
+  };
+
+  return {nextFrame, framesThrough, nextListOrErrorWithin};
+}
+
+function readConversationRows(frame: Record<string, unknown>): WireConversationRow[] {
+  return readRawRows(frame).map(row => ({
+    sessionId: row.sessionId,
+    createdAt: row.createdAt,
+    updatedAt: row.updatedAt,
+    entryCount: row.entryCount,
+  }));
+}
+
+function readRawRows(frame: Record<string, unknown>): Record<string, unknown>[] {
+  const {conversations} = frame;
+  if (!Array.isArray(conversations)) return [];
+  return conversations.filter(isRecord);
+}
+
+function parseJsonFrame(raw: unknown): Record<string, unknown> {
+  const parsed: unknown = JSON.parse(String(raw));
+  if (isRecord(parsed)) return parsed;
+  throw new Error('Expected JSON object frame');
+}
+
+function isRecord(candidate: unknown): candidate is Record<string, unknown> {
+  return typeof candidate === 'object' && candidate !== null && !Array.isArray(candidate);
+}
+
+async function drainServerClients(engine: HalEngine): Promise<void> {
+  const {clients} = engine.wss;
+  for (let i = 0; i < 50 && clients.size > 0; i++) {
+    await new Promise<void>(resolve => setTimeout(resolve, 5));
+  }
+}
+
+function areIsoRowTimestamps(rows: WireConversationRow[]): boolean {
+  if (rows.length === 0) return false;
+  return rows.every(row => isIsoTimestamp(row.createdAt) && isIsoTimestamp(row.updatedAt));
+}
+
+function isIsoTimestamp(candidate: unknown): boolean {
+  if (typeof candidate !== 'string') return false;
+  const parsedMs = Date.parse(candidate);
+  return Number.isFinite(parsedMs) && new Date(parsedMs).toISOString() === candidate;
+}