+async function rejoinListedConversation(wsUrl: string, pagedRows: WireConversationRow[]) {
+  const [pagedHead] = pagedRows;
+  if (typeof pagedHead?.sessionId !== 'string') return null;
+  const resumedClient = await openConnectedSocket(`${wsUrl}?sessionId=${pagedHead.sessionId}`);
+  resumedClient.send({type: 'ping', timestamp: 2});
+  const resumedFrames = await resumedClient.framesThrough('pong');
+  const replayedUpserts = resumedFrames.filter(frame => frame.type === 'entry_upsert');
+  return {
+    resumed: resumedClient.connected.resumed,
+    sessionId: resumedClient.connected.sessionId,
+    replayedCount: replayedUpserts.length,
+  };
+}
