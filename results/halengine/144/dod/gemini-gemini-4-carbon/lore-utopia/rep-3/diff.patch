+
+function captureLogs(): CapturedLogs {
+  const warnings: Array<{category: string; message: string; fields?: Record<string, unknown>}> = [];
+  const errors: Array<{category: string; message: string; fields?: Record<string, unknown>}> = [];
+  const logger: Logger = {
+    debug: () => undefined,
+    info: () => undefined,
+    warn: (category, message, fields) => void warnings.push({category, message, fields}),
+    error: (category, message, fields) => void errors.push({category, message, fields}),
+  };
+  return {logger, warnings, errors};
+}
+
+function silentLogger(): Logger {
+  const quiet = (): void => undefined;
+  return {debug: quiet, info: quiet, warn: quiet, error: quiet};
+}