@@ -0,0 +1,536 @@
+import {jest} from '@jest/globals';
+import type {AddressInfo} from 'node:net';
+import type {WebSocket} from 'ws';
+import * as publicSurface from './index.js';
+import {createHalEngine} from './config.js';
+import type {HalEngine, HalEngineConfig} from './config.js';
+import {InMemorySessionStore} from './infrastructure/stores/inMemorySessionStore.js';
+import {MongoSessionStore} from './infrastructure/stores/mongo/mongoSessionStore.js';
+import {fakeCollection} from './infrastructure/stores/mongo/mongoTestSupport.js';
+import {fiveMemberStore} from './infrastructure/stores/sessionStoreTestSupport.js';
+import {setLogger} from './shared/logger.js';
+import type {Logger} from './shared/logger.js';
+import {connectClient, deferred, stopEngines} from './transport/wsTestSupport.js';
+import {validateMessage} from './transport/ws/validation.js';
+import type {ValidationResult} from './transport/ws/validation.js';
+import {ErrorCodes} from './types/messages.js';
+import type {IncomingMessage, OutgoingMessage} from './types/messages.js';
+import type {ChatSession, SessionEntry} from './types/session.js';
+import type {SessionListOptions, SessionStore} from './types/sessionStore.js';
+
+interface WireSummary {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+
+interface WireFrame {
+  type: string;
+  sessionId?: string;
+  resumed?: boolean;
+  entryCount?: number;
+  conversations?: WireSummary[];
+  code?: string;
+  message?: string;
+  timestamp?: number;
+  index?: number;
+  entry?: SessionEntry;
+}
+
+interface RecordedListCall {
+  userId: string | number;
+  limit: number | undefined;
+  before: SessionListOptions['before'];
+}
+
+interface EngineSetup {
+  store: SessionStore;
+  userId?: string;
+  transport?: {
+    port: number;
+    resume?: {enabled: boolean; latest?: boolean};
+    history?: {enabled: boolean};
+  };
+  afterModelResponse?: () => Promise<void>;
+}
+
+interface CapturedLogs {
+  logger: Logger;
+  warnings: Array<{category: string; message: string; fields?: Record<string, unknown>}>;
+  errors: Array<{category: string; message: string; fields?: Record<string, unknown>}>;
+}
+
+const runningEngines: HalEngine[] = [];
+
+describe('delivering a conversation list over the websocket', () => {
+  beforeAll(() => {
+    setLogger(silentLogger());
+  });
+
+  afterAll(() => {
+    setLogger();
+  });
+
+  afterEach(async () => {
+    await stopEngines();
+    await closeRunningEngines();
+  });
+
+  it('validates list_conversations bounds and cursor, and drops any extra field', () => {
+    const cursor = {updatedAt: '2026-01-02T00:00:01.000Z', sessionId: 's2'};
+    const rejectedBefores = [
+      'not a date',
+      {updatedAt: 'not a date', sessionId: 's1'},
+      {updatedAt: '2026-01-02T00:00:01.000Z'},
+      {sessionId: 's1'},
+    ];
+
+    expect({
+      existingFramesCount: preExistingProtocolLiterals().length,
+      bare: validateMessage({type: 'list_conversations'}),
+      lowerBound: validateMessage({type: 'list_conversations', limit: 1}),
+      upperBound: validateMessage({type: 'list_conversations', limit: 200}),
+      paged: validateMessage({type: 'list_conversations', limit: 20, before: cursor, userId: 'u2'}),
+      rejectedLimits: [0, 201, 1.5, '10'].map(limit =>
+        namesField(validateMessage({type: 'list_conversations', limit}), 'limit')
+      ),
+      rejectedBefores: rejectedBefores.map(before =>
+        namesField(validateMessage({type: 'list_conversations', before}), 'before')
+      ),
+    }).toEqual({
+      existingFramesCount: 10,
+      bare: {valid: true, data: {type: 'list_conversations'}},
+      lowerBound: {valid: true, data: {type: 'list_conversations', limit: 1}},
+      upperBound: {valid: true, data: {type: 'list_conversations', limit: 200}},
+      paged: {valid: true, data: {type: 'list_conversations', limit: 20, before: cursor}},
+      rejectedLimits: [true, true, true, true],
+      rejectedBefores: [true, true, true, true],
+    });
+  });
+
+  it('lists the connected user conversations newest first, pages, and resumes a picked id', async () => {
+    const recorded = seededRecordingStore();
+    const {url} = await startConversationEngine({store: recorded.store});
+    const client = await openConnectedSocket(url);
+
+    const firstFrames = await askAndSettle(client.socket, {type: 'list_conversations', userId: 'u2'});
+    const firstRows = firstFrames[0]?.conversations ?? [];
+    const topCursor = {updatedAt: firstRows[0]?.updatedAt ?? '', sessionId: firstRows[0]?.sessionId ?? ''};
+    const pagedFrames = await askAndSettle(client.socket, {
+      type: 'list_conversations',
+      limit: 1,
+      before: topCursor,
+    });
+    const rejoined = await connectAndCollectUntilPong(`${url}?sessionId=${firstRows[2]?.sessionId ?? 'older'}`);
+
+    expect({
+      connectedKeys: Object.keys(client.connected).sort(),
+      firstTypes: firstFrames.map(frame => frame.type),
+      listedIds: firstRows.map(row => row.sessionId),
+      shapes: firstRows.map(summaryShape),
+      middleStamps: {createdAt: firstRows[1]?.createdAt, updatedAt: firstRows[1]?.updatedAt},
+      pagedIds: (pagedFrames[0]?.conversations ?? []).map(row => row.sessionId),
+      recordedCalls: recorded.calls,
+      rejoinedHead: {
+        sessionId: rejoined[0]?.sessionId,
+        resumed: rejoined[0]?.resumed,
+        entryCount: rejoined[0]?.entryCount,
+        replayed: rejoined.filter(frame => frame.type === 'entry_upsert').length,
+      },
+    }).toEqual({
+      connectedKeys: ['examplePrompts', 'message', 'resumed', 'sessionId', 'type'],
+      firstTypes: ['conversation_list', 'pong'],
+      listedIds: [client.connected.sessionId, 'middle', 'older'],
+      shapes: [
+        {keys: ['createdAt', 'entryCount', 'sessionId', 'updatedAt'], isoStamps: true, entryCount: 0},
+        {keys: ['createdAt', 'entryCount', 'sessionId', 'updatedAt'], isoStamps: true, entryCount: 1},
+        {keys: ['createdAt', 'entryCount', 'sessionId', 'updatedAt'], isoStamps: true, entryCount: 2},
+      ],
+      middleStamps: {createdAt: '2026-01-02T00:00:00.000Z', updatedAt: '2026-01-02T00:00:01.000Z'},
+      pagedIds: ['middle'],
+      recordedCalls: [
+        {userId: 'u1', limit: undefined, before: undefined},
+        {userId: 'u1', limit: 1, before: topCursor},
+      ],
+      rejoinedHead: {sessionId: 'older', resumed: true, entryCount: 2, replayed: 2},
+    });
+  });
+
+  it('answers list_conversations before stream_end while a turn is still streaming', async () => {
+    const turnMidStream = deferred();
+    const finishTurn = deferred();
+    const {url} = await startConversationEngine({
+      store: new InMemorySessionStore(),
+      afterModelResponse: async () => {
+        turnMidStream.release();
+        await finishTurn.until;
+      },
+    });
+    const client = await openConnectedSocket(url);
+    const relevantFrames = await framesDuringStreamingTurn(client.socket, turnMidStream, finishTurn);
+
+    expect({
+      order: relevantFrames.map(frame => frame.type),
+      listedIds: (relevantFrames[0]?.conversations ?? []).map(row => row.sessionId),
+    }).toEqual({
+      order: ['conversation_list', 'stream_end'],
+      listedIds: [client.connected.sessionId],
+    });
+  });
+
+  it('answers UNSUPPORTED when disabled or incapable, and SERVER_ERROR when listFor rejects', async () => {
+    const outcomes = await collectGatingAndFailureOutcomes();
+
+    expect(outcomes).toEqual({
+      exportedErrorClass: true,
+      exportedErrorCode: true,
+      mongoThrowsStoreCannotList: true,
+      warnedWhenResumeOmitted: true,
+      warnedWithResume: false,
+      historyOmitted: {types: ['error', 'pong'], code: 'UNSUPPORTED'},
+      historyOff: {types: ['error', 'pong'], code: 'UNSUPPORTED'},
+      fiveMember: {types: ['error', 'pong'], code: 'UNSUPPORTED'},
+      bareMongo: {types: ['error', 'pong'], code: 'UNSUPPORTED'},
+      failingStore: {
+        types: ['error', 'pong'],
+        code: 'SERVER_ERROR',
+        keptStoreErrorInternal: true,
+        loggedSessionId: true,
+        keptEntryTextPrivate: true,
+      },
+    });
+  });
+});
+
+async function closeRunningEngines(): Promise<void> {
+  for (const engine of runningEngines.splice(0)) {
+    const {wss} = engine;
+    const closingPeers = [...wss.clients].map(peer =>
+      peer.readyState === peer.CLOSED ? Promise.resolve() : new Promise<void>(resolve => peer.once('close', resolve))
+    );
+    await engine.stop();
+    await Promise.all(closingPeers);
+  }
+}
+
+function preExistingProtocolLiterals(): Array<IncomingMessage | OutgoingMessage> {
+  const incoming: IncomingMessage[] = [
+    {type: 'user_message', content: 'hello'},
+    {type: 'ping', timestamp: 1},
+  ];
+  const outgoing: OutgoingMessage[] = [
+    {type: 'connected', sessionId: 's1', message: 'Connected', examplePrompts: []},
+    {type: 'entry_upsert', index: 0, entry: {role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}},
+    {type: 'entry_delta', index: 1, delta: 'hi'},
+    {type: 'entry_commit', index: 1},
+    {type: 'entry_skip', index: 2},
+    {type: 'error', code: 'SERVER_ERROR', message: 'Failed'},
+    {type: 'pong', timestamp: 1},
+    {type: 'stream_end'},
+  ];
+  return [...incoming, ...outgoing];
+}
+
+function namesField(outcome: ValidationResult, field: string): boolean {
+  if (outcome.valid) return false;
+  return outcome.error.toLowerCase().includes(field);
+}
+
+function seededRecordingStore(): {store: SessionStore; calls: RecordedListCall[]} {
+  const inner = new InMemorySessionStore({maxAgeMs: Number.POSITIVE_INFINITY});
+  jest.useFakeTimers();
+  jest.setSystemTime(new Date('2026-01-01T00:00:00.000Z'));
+  const older = inner.create('older', 'u1', {authHeaders: {authorization: 'Bearer secret-token'}});
+  older.entries.push(
+    {role: 'user', content: 'first turn', timestamp: '2026-01-01T00:00:01.000Z'},
+    {role: 'assistant', content: 'first reply', timestamp: '2026-01-01T00:00:02.000Z', isStreaming: false}
+  );
+  jest.setSystemTime(new Date('2026-01-02T00:00:00.000Z'));
+  const middle = inner.create('middle', 'u1');
+  middle.entries.push({role: 'user', content: 'second turn', timestamp: '2026-01-02T00:00:01.000Z'});
+  jest.setSystemTime(new Date('2026-01-03T00:00:00.000Z'));
+  const theirs = inner.create('theirs', 'u2');
+  theirs.entries.push({role: 'user', content: 'other user turn', timestamp: '2026-01-03T00:00:01.000Z'});
+  jest.useRealTimers();
+
+  const calls: RecordedListCall[] = [];
+  const store: SessionStore = {
+    create: (sessionId, userId, options) => inner.create(sessionId, userId, options),
+    get: sessionId => inner.get(sessionId),
+    lookup: sessionId => inner.lookup(sessionId),
+    delete: sessionId => inner.delete(sessionId),
+    evict: sessionId => inner.evict(sessionId),
+    count: () => inner.count(),
+    clear: () => inner.clear(),
+    latestFor: userId => inner.latestFor(userId),
+    listFor: (userId, options) => {
+      calls.push({userId, limit: options?.limit, before: options?.before});
+      return inner.listFor(userId, options);
+    },
+  };
+  return {store, calls};
+}
+
+function summaryShape(row: WireSummary): {keys: string[]; isoStamps: boolean; entryCount: number} {
+  return {
+    keys: Object.keys(row).sort(),
+    isoStamps: isIsoTimestamp(row.createdAt) && isIsoTimestamp(row.updatedAt),
+    entryCount: row.entryCount,
+  };
+}
+
+function isIsoTimestamp(stamp: unknown): boolean {
+  if (typeof stamp !== 'string') return false;
+  return /^\d{4}-\d{2}-\d{2}T/.test(stamp) && Number.isFinite(Date.parse(stamp));
+}
+
+async function framesDuringStreamingTurn(
+  socket: WebSocket,
+  turnMidStream: {until: Promise<void>},
+  finishTurn: {release: () => void}
+): Promise<WireFrame[]> {
+  socket.send(JSON.stringify({type: 'user_message', content: 'stream while listing'}));
+  await turnMidStream.until;
+
+  const relevantTypes = new Set(['conversation_list', 'error', 'stream_end']);
+  const collected: WireFrame[] = [];
+  const streamEnded = deferred();
+  socket.on('message', wireText => {
+    const frame: WireFrame = JSON.parse(String(wireText));
+    if (relevantTypes.has(frame.type)) collected.push(frame);
+    if (frame.type === 'stream_end') streamEnded.release();
+  });
+
+  socket.send(JSON.stringify({type: 'list_conversations'}));
+  await roundTripPing(socket, 81);
+  await roundTripPing(socket, 82);
+  finishTurn.release();
+  await streamEnded.until;
+  return collected;
+}
+
+async function roundTripPing(socket: WebSocket, marker: number): Promise<void> {
+  const ponged = new Promise<void>(resolve => {
+    const onMessage = (wireText: unknown): void => {
+      const frame: WireFrame = JSON.parse(String(wireText));
+      if (frame.type !== 'pong' || frame.timestamp !== marker) return;
+      socket.off('message', onMessage);
+      resolve();
+    };
+    socket.on('message', onMessage);
+  });
+  socket.send(JSON.stringify({type: 'ping', timestamp: marker}));
+  await ponged;
+}
+
+async function collectGatingAndFailureOutcomes() {
+  const captured = captureLogs();
+  setLogger(captured.logger);
+  try {
+    const historyOffOutcomes = await collectHistoryOffOutcomes();
+    const capableOutcomes = await collectCapableAndWarningOutcomes(captured);
+    const failingStore = await collectFailingStoreOutcome(captured);
+    const exportedCtor = (publicSurface as Record<string, unknown>)['StoreCannotList'];
+    return {
+      exportedErrorClass: typeof exportedCtor === 'function',
+      exportedErrorCode: 'UNSUPPORTED' in ErrorCodes,
+      mongoThrowsStoreCannotList:
+        typeof exportedCtor === 'function' &&
+        capableOutcomes.bareMongoRejection instanceof (exportedCtor as ErrorConstructor),
+      ...historyOffOutcomes,
+      ...capableOutcomes.summaries,
+      failingStore,
+    };
+  } finally {
+    setLogger(silentLogger());
+  }
+}
+
+async function collectHistoryOffOutcomes() {
+  const historyOmitted = await askOnceEngine({
+    store: new InMemorySessionStore(),
+    transport: {port: 0, resume: {enabled: true}},
+  });
+  const historyOff = await askOnceEngine({
+    store: new InMemorySessionStore(),
+    transport: {port: 0, resume: {enabled: true}, history: {enabled: false}},
+  });
+  return {
+    historyOmitted: frameSummary(historyOmitted.frames),
+    historyOff: frameSummary(historyOff.frames),
+  };
+}
+
+async function collectCapableAndWarningOutcomes(captured: CapturedLogs) {
+  const warningsBefore = captured.warnings.length;
+  const resumeOmittedEngine = await startConversationEngine({
+    store: fiveMemberStore,
+    transport: {port: 0, history: {enabled: true}},
+  });
+  const resumeOmittedWarnings = captured.warnings.slice(warningsBefore);
+  const fiveMemberClient = await openConnectedSocket(resumeOmittedEngine.url);
+  const fiveMemberFrames = await askAndSettle(fiveMemberClient.socket, {type: 'list_conversations'});
+  const mongoProbe = await probeBareMongoStore(captured);
+
+  return {
+    bareMongoRejection: mongoProbe.rejection,
+    summaries: {
+      warnedWhenResumeOmitted: resumeOmittedWarnings.some(entry => entry.message.toLowerCase().includes('resume')),
+      warnedWithResume: mongoProbe.startupWarnings > 0,
+      fiveMember: frameSummary(fiveMemberFrames),
+      bareMongo: frameSummary(mongoProbe.frames),
+    },
+  };
+}
+
+async function probeBareMongoStore(
+  captured: CapturedLogs
+): Promise<{rejection: unknown; startupWarnings: number; frames: WireFrame[]}> {
+  const bareMongoStore = new MongoSessionStore({
+    collection: fakeCollection(),
+    now: () => new Date('2026-01-01T00:00:00.000Z'),
+  });
+  const rejection = await bareMongoStore.listFor('u1').then(
+    () => undefined,
+    (reason: unknown) => reason
+  );
+  const warningsBefore = captured.warnings.length;
+  const started = await startConversationEngine({
+    store: bareMongoStore,
+    transport: {port: 0, resume: {enabled: true}, history: {enabled: true}},
+  });
+  const startupWarnings = captured.warnings.length - warningsBefore;
+  const client = await openConnectedSocket(started.url);
+  const frames = await askAndSettle(client.socket, {type: 'list_conversations'});
+  return {rejection, startupWarnings, frames};
+}
+
+async function collectFailingStoreOutcome(captured: CapturedLogs) {
+  const errorsBefore = captured.errors.length;
+  const failingReply = await askOnceEngine({
+    store: failingListStore(),
+    transport: {port: 0, resume: {enabled: true}, history: {enabled: true}},
+  });
+  const failureLogs = JSON.stringify(captured.errors.slice(errorsBefore));
+  const failingMessage = failingReply.frames[0]?.message ?? '';
+  return {
+    ...frameSummary(failingReply.frames),
+    keptStoreErrorInternal: !failingMessage.includes('db-internal-host-01'),
+    loggedSessionId: failureLogs.includes(failingReply.sessionId),
+    keptEntryTextPrivate: !failureLogs.includes('private-medical-note'),
+  };
+}
+
+async function askOnceEngine(setup: EngineSetup): Promise<{sessionId: string; frames: WireFrame[]}> {
+  const {url} = await startConversationEngine(setup);
+  const client = await openConnectedSocket(url);
+  const frames = await askAndSettle(client.socket, {type: 'list_conversations'});
+  return {sessionId: client.connected.sessionId ?? '', frames};
+}
+
+async function startConversationEngine(setup: EngineSetup): Promise<{engine: HalEngine; url: string}> {
+  const transport = setup.transport ?? {port: 0, resume: {enabled: true}, history: {enabled: true}};
+  const config: HalEngineConfig = {
+    provider: {type: 'mock'},
+    prompt: {identity: 'Conversation list test.'},
+    session: setup.store,
+    transport,
+    auth: {ws: async () => ({id: setup.userId ?? 'u1'})},
+    orchestrator: setup.afterModelResponse ? {hooks: {afterModelResponse: setup.afterModelResponse}} : undefined,
+  };
+  const engine = createHalEngine(config);
+  await engine.start(0);
+  runningEngines.push(engine);
+  const {port} = engine.server.address() as AddressInfo;
+  return {engine, url: `ws://127.0.0.1:${port}/hal/ws`};
+}
+
+async function connectAndCollectUntilPong(url: string): Promise<WireFrame[]> {
+  const socket = connectClient(url, 'token-1');
+  const frames: WireFrame[] = [];
+  await new Promise<void>(resolve => {
+    socket.on('message', wireText => {
+      const frame: WireFrame = JSON.parse(String(wireText));
+      frames.push(frame);
+      if (frame.type === 'connected') socket.send(JSON.stringify({type: 'ping', timestamp: 9}));
+      if (frame.type === 'pong') resolve();
+    });
+  });
+  return frames;
+}
+
+async function openConnectedSocket(url: string): Promise<{socket: WebSocket; connected: WireFrame}> {
+  const socket = connectClient(url, 'token-1');
+  const connected = await new Promise<WireFrame>(resolve => {
+    const onMessage = (wireText: unknown): void => {
+      const frame: WireFrame = JSON.parse(String(wireText));
+      if (frame.type !== 'connected') return;
+      socket.off('message', onMessage);
+      resolve(frame);
+    };
+    socket.on('message', onMessage);
+  });
+  return {socket, connected};
+}
+
+async function askAndSettle(socket: WebSocket, payload: Record<string, unknown>): Promise<WireFrame[]> {
+  const frames: WireFrame[] = [];
+  const settled = new Promise<WireFrame[]>(resolve => {
+    const onMessage = (wireText: unknown): void => {
+      const frame: WireFrame = JSON.parse(String(wireText));
+      frames.push(frame);
+      if (frames.length === 1) socket.send(JSON.stringify({type: 'ping', timestamp: 77}));
+      if (frame.type === 'pong' && frame.timestamp === 77) {
+        socket.off('message', onMessage);
+        resolve(frames);
+      }
+    };
+    socket.on('message', onMessage);
+    socket.once('close', () => {
+      socket.off('message', onMessage);
+      resolve(frames);
+    });
+  });
+  socket.send(JSON.stringify(payload));
+  return settled;
+}
+
+function frameSummary(frames: WireFrame[]): {types: string[]; code: string | undefined} {
+  return {types: frames.map(frame => frame.type), code: frames[0]?.code};
+}
