+import {jest} from '@jest/globals';
+import {once} from 'node:events';
+import type {WebSocket} from 'ws';
+import {createHalEngine} from './config.js';
+import {InMemorySessionStore} from './infrastructure/stores/inMemorySessionStore.js';
+import {MongoSessionStore} from './infrastructure/stores/mongo/mongoSessionStore.js';
+import {fakeCollection} from './infrastructure/stores/mongo/mongoTestSupport.js';
+import {fiveMemberStore} from './infrastructure/stores/sessionStoreTestSupport.js';
+import type {ChatOrchestrator} from './orchestration/chatOrchestrator.js';
+import type {ProviderConfig} from './providers/providerFactory.js';
+import {setLogger} from './shared/logger.js';
+import type {Logger} from './shared/logger.js';
+import {createApp} from './transport/createApp.js';
+import {createServer} from './transport/createServer.js';
+import type {HalServer} from './transport/createServer.js';
+import {validateMessage} from './transport/ws/validation.js';
+import type {ValidationResult} from './transport/ws/validation.js';
+import {connectClient, deferred, stopEngines} from './transport/wsTestSupport.js';
+import type {MessageChunk} from './types/ai.js';
+import type {SessionEntry} from './types/session.js';
+import type {SessionListOptions, SessionStore} from './types/sessionStore.js';
+
+interface WireSummary {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+
+interface WireFrame {
+  type: string;
+  sessionId?: string;
+  message?: string;
+  examplePrompts?: string[];
+  resumed?: boolean;
+  entryCount?: number;
+  code?: string;
+  timestamp?: number;
+  index?: number;
+  delta?: string;
+  entry?: SessionEntry;
+  conversations?: WireSummary[];
+}
+
+interface HistoryTransportConfig {
+  port: number;
+  resume?: {enabled: boolean};
+  history?: {enabled: boolean};
+}
+
+const START = new Date('2026-09-30T08:00:00.000Z');
+const MOCK_PROVIDER: ProviderConfig = {type: 'mock'};
+const CLOCK_ONLY_FAKE_TIMERS: Parameters<typeof jest.useFakeTimers>[0] = {
+  now: START,
+  doNotFake: ['nextTick', 'setImmediate', 'setTimeout', 'clearTimeout', 'setInterval', 'clearInterval'],
+};
+
+const runningServers: HalServer[] = [];
+
+describe('delivering a user conversation list over WebSocket', () => {
+  beforeEach(() => {
+    jest.useFakeTimers(CLOCK_ONLY_FAKE_TIMERS);
+    setLogger(silentLogger());
+  });
+
+  afterEach(async () => {
+    while (runningServers.length > 0) {
+      const running = runningServers.pop();
+      if (running) await stopServer(running);
+    }
+    await stopEngines();
+    setLogger();
+    jest.useRealTimers();
+  });
+
+  it('lists the user conversations newest first, pages with before, and resumes a chosen id', async () => {
+    const store = seededHistoryStore();
+    const base = await startConfiguredEngine(store, {
+      port: 0,
+      resume: {enabled: true},
+      history: {enabled: true},
+    });
+    jest.setSystemTime(new Date('2026-09-30T08:05:00.000Z'));
+
+    const {socket, connected} = await connectSocket(base);
+    const freshId = connected.sessionId ?? '';
+    const fullReply = await sendAndFlushWithPing(socket, {type: 'list_conversations'}, 1);
+    const pagedReply = await sendAndFlushWithPing(
+      socket,
+      {
+        type: 'list_conversations',
+        limit: 1,
+        before: {updatedAt: '2026-09-30T08:05:00.000Z', sessionId: freshId},
+      },
+      2
+    );
+    const pagedRows = pagedReply[0]?.conversations ?? [];
+    const chosenId = pagedRows[0]?.sessionId ?? 'missing';
+    const rejoined = await collectReconnectFrames(`${base}?sessionId=${chosenId}`);
+
+    expect({
+      connectedKeys: Object.keys(connected).sort(),
+      resumedOnFresh: connected.resumed,
+      fullFrameTypes: fullReply.map(frame => frame.type),
+      listed: fullReply[0]?.conversations,
+      paged: pagedRows,
+      rejoinedHead: {
+        sessionId: rejoined[0]?.sessionId,
+        resumed: rejoined[0]?.resumed,
+        entryCount: rejoined[0]?.entryCount,
+      },
+      replayedContent: replayedTexts(rejoined),
+    }).toEqual({
+      connectedKeys: ['examplePrompts', 'message', 'resumed', 'sessionId', 'type'],
+      resumedOnFresh: false,
+      fullFrameTypes: ['conversation_list', 'pong'],
+      listed: [
+        {
+          sessionId: freshId,
+          createdAt: '2026-09-30T08:05:00.000Z',
+          updatedAt: '2026-09-30T08:05:00.000Z',
+          entryCount: 0,
+        },
+        {
+          sessionId: 's2',
+          createdAt: '2026-09-30T08:02:00.000Z',
+          updatedAt: '2026-09-30T08:03:00.000Z',
+          entryCount: 2,
+        },
+        {
+          sessionId: 's1',
+          createdAt: '2026-09-30T08:00:00.000Z',
+          updatedAt: '2026-09-30T08:01:00.000Z',
+          entryCount: 1,
+        },
+      ],
+      paged: [
+        {
+          sessionId: 's2',
+          createdAt: '2026-09-30T08:02:00.000Z',
+          updatedAt: '2026-09-30T08:03:00.000Z',
+          entryCount: 2,
+        },
+      ],
+      rejoinedHead: {sessionId: 's2', resumed: true, entryCount: 2},
+      replayedContent: ['second question', 'second answer'],
+    });
+  });
+
+  it('reads the user id from the socket, forwards the cursor, and answers while a turn streams', async () => {
+    const backing = new InMemorySessionStore();
+    const ownSession = backing.create('mine', 'u1');
+    ownSession.entries.push({role: 'user', content: 'hello', timestamp: '2026-09-30T08:01:00.000Z'});
+    const otherSession = backing.create('theirs', 'u2');
+    otherSession.entries.push({role: 'user', content: 'secret', timestamp: '2026-09-30T08:02:00.000Z'});
+    const recorded: Array<{userId: string | number; options: SessionListOptions | undefined}> = [];
+    const store = recordingListStore(backing, recorded);
+    const gate = deferred();
+    const base = await startStreamingServer(store, pausingOrchestrator(gate.until));
+    jest.setSystemTime(new Date('2026-09-30T08:05:00.000Z'));
+
+    const {socket, connected} = await connectSocket(base);
+    const cursor = {updatedAt: '2099-01-01T00:00:00.000Z', sessionId: 'z'};
+    const frames = await askListMidStream(
+      socket,
+      {type: 'list_conversations', userId: 'u2', limit: 5, before: cursor},
+      gate.release
+    );
+    const listFrame = frames.find(frame => frame.type === 'conversation_list');
+    const listedRows = listFrame?.conversations ?? [];
+
+    expect({
+      recorded,
+      listedIds: listedRows.map(row => row.sessionId),
+      frameTypes: frames.map(frame => frame.type),
+    }).toEqual({
+      recorded: [{userId: 'u1', options: {limit: 5, before: cursor}}],
+      listedIds: [connected.sessionId, 'mine'],
+      frameTypes: ['entry_upsert', 'entry_upsert', 'entry_delta', 'conversation_list', 'entry_commit', 'stream_end'],
+    });
+  });
+
+  it('validates list_conversations statically, checking integer limits and two-part cursors', () => {
+    const cursor = {updatedAt: '2026-09-30T08:00:00.000Z', sessionId: 's1'};
+    const minimal = validateMessage({type: 'list_conversations'});
+    const stripped = validateMessage({type: 'list_conversations', userId: 'u2'});
+    const bounded = validateMessage({type: 'list_conversations', limit: 200, before: cursor});
+    const badLimits = [0, 201, 1.5, '10'].map(limit =>
+      errorField(validateMessage({type: 'list_conversations', limit}))
+    );
+    const badBeforeString = errorField(validateMessage({type: 'list_conversations', before: 'not a date'}));
+    const badCursors = [
+      {updatedAt: 'not a date', sessionId: 's1'},
+      {updatedAt: '2026-09-30T08:00:00.000Z'},
+      {sessionId: 's1'},
+      {updatedAt: '2026-09-30T08:00:00.000Z', sessionId: ''},
+    ].map(before => errorField(validateMessage({type: 'list_conversations', before})));
+
+    expect({
+      minimal,
+      stripped,
+      bounded,
+      badLimits,
+      badBeforeString,
+      badCursors,
+    }).toEqual({
+      minimal: {valid: true, data: {type: 'list_conversations'}},
+      stripped: {valid: true, data: {type: 'list_conversations'}},
+      bounded: {valid: true, data: {type: 'list_conversations', limit: 200, before: cursor}},
+      badLimits: [
+        expect.stringMatching(/limit/i),
+        expect.stringMatching(/limit/i),
+        expect.stringMatching(/limit/i),
+        expect.stringMatching(/limit/i),
+      ],
+      badBeforeString: expect.stringMatching(/before/i),
+      badCursors: [
+        expect.stringMatching(/before|updatedAt|sessionId/i),
+        expect.stringMatching(/before|updatedAt|sessionId/i),
+        expect.stringMatching(/before|updatedAt|sessionId/i),
+        expect.stringMatching(/before|updatedAt|sessionId/i),
+      ],
+    });
+  });
+
+  it('answers UNSUPPORTED when history is off or the store cannot list, and warns without resume', async () => {
+    const omitted = await probeHistoryConfig(new InMemorySessionStore(), {port: 0});
+    const disabled = await probeHistoryConfig(new InMemorySessionStore(), {
+      port: 0,
+      history: {enabled: false},
+    });
+    const fiveOnly = await probeHistoryConfig(fiveMemberStore, {
+      port: 0,
+      history: {enabled: true},
+    });
+    const minimalMongo = new MongoSessionStore({collection: fakeCollection(), now: () => START});
+    const unfindable = await probeHistoryConfig(minimalMongo, {
+      port: 0,
+      resume: {enabled: true},
+      history: {enabled: true},
+    });
+
+    expect({omitted, disabled, fiveOnly, unfindable}).toEqual({
+      omitted: {warned: false, frames: [{type: 'error', code: 'UNSUPPORTED'}, {type: 'pong'}]},
+      disabled: {warned: false, frames: [{type: 'error', code: 'UNSUPPORTED'}, {type: 'pong'}]},
+      fiveOnly: {warned: true, frames: [{type: 'error', code: 'UNSUPPORTED'}, {type: 'pong'}]},
+      unfindable: {warned: false, frames: [{type: 'error', code: 'UNSUPPORTED'}, {type: 'pong'}]},
+    });
+  });
+
+  it('answers a rejecting listFor with SERVER_ERROR, hides store detail, and keeps the socket open', async () => {
+    const loggedErrors: Array<Record<string, unknown>> = [];
+    setLogger(errorLogger(loggedErrors));
+    const failingCollection = fakeCollection({
+      find: () => ({toArray: () => Promise.reject(new Error('ECONNREFUSED 10.0.0.12:27017'))}),
+    });
+    const failingStore = new MongoSessionStore({collection: failingCollection, now: () => START});
+    const base = await startConfiguredEngine(failingStore, {
+      port: 0,
+      resume: {enabled: true},
+      history: {enabled: true},
+    });
+
+    const {socket, connected} = await connectSocket(base);
+    await completeTurn(socket, 'my secret booking ZX-99');
+    loggedErrors.length = 0;
+    const frames = await sendAndFlushWithPing(socket, {type: 'list_conversations'}, 77);
+    const errorMessage = frames[0]?.message ?? '';
+    const serializedLog = JSON.stringify(loggedErrors);
+
+    expect({
+      frames: frames.map(frame => ({type: frame.type, code: frame.code, timestamp: frame.timestamp})),
+      hasMessage: errorMessage.length > 0,
+      leakedStoreDetail: errorMessage.includes('ECONNREFUSED') || errorMessage.includes('10.0.0.12'),
+      loggedSessionId: loggedErrors.some(entry => entry.sessionId === connected.sessionId),
+      loggedUserContent: serializedLog.includes('ZX-99'),
+    }).toEqual({
+      frames: [
+        {type: 'error', code: 'SERVER_ERROR', timestamp: undefined},
+        {type: 'pong', code: undefined, timestamp: 77},
+      ],
+      hasMessage: true,
+      leakedStoreDetail: false,
+      loggedSessionId: true,
+      loggedUserContent: false,
+    });
+  });
+});
+
+async function stopServer(running: HalServer): Promise<void> {
+  const {wss} = running;
+  const closed = [...wss.clients].map(socket => once(socket, 'close'));
+  await running.stop();
+  await Promise.all(closed);
+}
+
+function seededHistoryStore(): InMemorySessionStore {
+  const store = new InMemorySessionStore();
+  const first = store.create('s1', 'u1');
+  first.entries.push({
+    role: 'user',
+    content: 'first question',
+    timestamp: '2026-09-30T08:01:00.000Z',
+  });
+  jest.setSystemTime(new Date('2026-09-30T08:02:00.000Z'));
+  const second = store.create('s2', 'u1');
+  second.entries.push(
+    {role: 'user', content: 'second question', timestamp: '2026-09-30T08:02:30.000Z'},
+    {role: 'assistant', content: 'second answer', timestamp: '2026-09-30T08:03:00.000Z', isStreaming: false}
+  );
+  jest.setSystemTime(new Date('2026-09-30T08:04:00.000Z'));
+  const stranger = store.create('s-other', 'u2');
+  stranger.entries.push({
+    role: 'user',
+    content: 'stranger',
+    timestamp: '2026-09-30T08:04:30.000Z',
+  });
+  return store;
+}
+
+async function probeHistoryConfig(
+  store: SessionStore,
+  transport: HistoryTransportConfig
+): Promise<{warned: boolean; frames: Array<{type: string; code?: string}>}> {
+  const warnings: string[] = [];
+  setLogger(warningLogger(warnings));
+  const base = await startConfiguredEngine(store, transport);
+  const warned = warnings.length > 0;
+  const {socket} = await connectSocket(base);
+  const frames = await sendAndFlushWithPing(socket, {type: 'list_conversations'}, 9);
+  return {warned, frames: summaryOfFrames(frames)};
+}
+
+async function startConfiguredEngine(store: SessionStore, transport: HistoryTransportConfig): Promise<string> {
+  const config = {
+    provider: MOCK_PROVIDER,
+    prompt: {identity: 'assistant'},
+    auth: {ws: async () => ({id: 'u1'})},
+    session: store,
+    transport,
+  };
+  const engine = createHalEngine(config);
+  await engine.start();
+  runningServers.push(engine);
+  return wsUrlOf(engine);
+}
+
+async function startStreamingServer(store: SessionStore, orchestrator: ChatOrchestrator): Promise<string> {
+  const serverOptions = {
+    app: createApp(),
+    wsAuth: async () => ({id: 'u1'}),
+    sessionStore: store,
+    orchestrator,
+    resume: {enabled: true},
+    history: {enabled: true},
+  };
+  const running = createServer(serverOptions);
+  await running.start(0);
+  runningServers.push(running);
+  return wsUrlOf(running);
+}
+
+function wsUrlOf(running: HalServer): string {
+  const {server} = running;
+  const address = server.address();
+  if (address === null || typeof address === 'string') throw new Error('Expected bound TCP port');
+  return `ws://127.0.0.1:${address.port}/hal/ws`;
+}
+
+async function connectSocket(url: string): Promise<{socket: WebSocket; connected: WireFrame}> {
+  const socket = connectClient(url, 'token-u1');
+  const connected = await new Promise<WireFrame>(resolve => {
+    const onMessage = (raw: unknown) => {
+      const frame = parseFrame(raw);
+      if (frame.type !== 'connected') return;
+      socket.off('message', onMessage);
+      resolve(frame);
+    };
+    socket.on('message', onMessage);
+  });
+  return {socket, connected};
+}
+
+async function collectReconnectFrames(url: string): Promise<WireFrame[]> {
+  const socket = connectClient(url, 'token-u1');
+  const collected: WireFrame[] = [];
+  await new Promise<void>(resolve => {
+    const onFrame = (raw: unknown) => {
+      const frame = parseFrame(raw);
+      collected.push(frame);
+      if (frame.type === 'connected') {
+        socket.send(JSON.stringify({type: 'ping', timestamp: 3}));
+        return;
+      }
+      if (frame.type !== 'pong') return;
+      socket.off('message', onFrame);
+      resolve();
+    };
+    socket.on('message', onFrame);
+  });
+  return collected;
+}
+
+async function sendAndFlushWithPing(
+  socket: WebSocket,
+  payload: Record<string, unknown>,
+  timestamp: number
+): Promise<WireFrame[]> {
+  const frames: WireFrame[] = [];
+  await new Promise<void>(resolve => {
+    const onMessage = (raw: unknown) => {
+      const frame = parseFrame(raw);
+      frames.push(frame);
+      if (frame.type !== 'pong' || frame.timestamp !== timestamp) return;
+      socket.off('message', onMessage);
+      resolve();
+    };
+    socket.on('message', onMessage);
+    socket.send(JSON.stringify(payload));
+    socket.send(JSON.stringify({type: 'ping', timestamp}));
+  });
+  return frames;
+}
+
+async function completeTurn(socket: WebSocket, content: string): Promise<void> {
+  await new Promise<void>(resolve => {
+    const onMessage = (raw: unknown) => {
+      const frame = parseFrame(raw);
+      if (frame.type !== 'stream_end') return;
+      socket.off('message', onMessage);
+      resolve();
+    };
+    socket.on('message', onMessage);
+    socket.send(JSON.stringify({type: 'user_message', content}));
+  });
+}
+
+async function askListMidStream(
+  socket: WebSocket,
+  listFrame: Record<string, unknown>,
+  releaseStream: () => void
+): Promise<WireFrame[]> {
+  const frames: WireFrame[] = [];
+  let askedForList = false;
+  await new Promise<void>(resolve => {
+    const onMessage = (raw: unknown) => {
+      const frame = parseFrame(raw);
+      frames.push(frame);
+      if (frame.type === 'entry_delta' && !askedForList) {
+        askedForList = true;
+        socket.send(JSON.stringify(listFrame));
+        return;
+      }
+      if (askedForList && isListReply(frame)) {
+        releaseStream();
+        return;
+      }
+      if (frame.type !== 'stream_end') return;
+      socket.off('message', onMessage);
+      resolve();
+    };
+    socket.on('message', onMessage);
+    socket.send(JSON.stringify({type: 'user_message', content: 'stream now'}));
+  });
+  return frames;
+}
+
+function isListReply(frame: WireFrame): boolean {
+  return frame.type === 'conversation_list' || frame.type === 'error';
+}
+
+function parseFrame(raw: unknown): WireFrame {
+  const parsed: WireFrame = JSON.parse(String(raw));
+  return parsed;
+}
+
+function replayedTexts(frames: WireFrame[]): string[] {
+  return frames
+    .filter(frame => frame.type === 'entry_upsert')
+    .map(frame => (frame.entry && 'content' in frame.entry ? frame.entry.content : ''));
+}
+
+function summaryOfFrames(frames: WireFrame[]): Array<{type: string; code?: string}> {
+  return frames.map(frame => (frame.code === undefined ? {type: frame.type} : {type: frame.type, code: frame.code}));
+}
+
+function errorField(verdict: ValidationResult): string {
+  return verdict.valid ? 'accepted unexpectedly' : verdict.error;
+}
+
+function recordingListStore(
+  backing: InMemorySessionStore,
+  calls: Array<{userId: string | number; options: SessionListOptions | undefined}>
+): SessionStore {
+  return {
+    listFor(userId, options) {
+      calls.push({userId, options});
+      return backing.listFor(userId, options);
+    },
+    create: backing.create.bind(backing),
+    get: backing.get.bind(backing),
+    delete: backing.delete.bind(backing),
+    count: backing.count.bind(backing),
+    clear: backing.clear.bind(backing),
+  };
+}
+
+function pausingOrchestrator(untilReleased: Promise<void>): ChatOrchestrator {
+  return {
+    processMessage: async () => 'paused reply',
+    async *processMessageStream(): AsyncGenerator<MessageChunk> {
+      yield {type: 'text', text: 'streaming...'};
+      await untilReleased;
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+  };
+}
+
+function silentLogger(): Logger {
+  const noop = () => undefined;
+  return {debug: noop, info: noop, warn: noop, error: noop};
+}
+
+function warningLogger(warnings: string[]): Logger {
+  const noop = () => undefined;
+  return {
+    debug: noop,
+    info: noop,
+    warn: (_category, message) => void warnings.push(message),
+    error: noop,
+  };
+}
+
+function errorLogger(loggedErrors: Array<Record<string, unknown>>): Logger {
+  const noop = () => undefined;
+  return {
+    debug: noop,
+    info: noop,
+    warn: noop,
+    error: (category, message, fields) => void loggedErrors.push({category, message, ...fields}),
+  };
+}