@@ -0,0 +1,453 @@
+import type {AddressInfo} from 'node:net';
+import {WebSocket, type RawData} from 'ws';
+import * as publicSurface from './index.js';
+import {ErrorCodes, HAL_WS_SUBPROTOCOL, InMemorySessionStore, MongoSessionStore, createHalEngine} from './index.js';
+import type {
+  HalEngine,
+  HalEngineConfig,
+  OrchestratorHooks,
+  SessionEntry,
+  SessionListOptions,
+  SessionStore,
+} from './index.js';
+import {fakeCollection} from './infrastructure/stores/mongo/mongoTestSupport.js';
+import {setLogger} from './shared/logger.js';
+import {validateMessage} from './transport/ws/validation.js';
+import {deferred} from './transport/wsTestSupport.js';
+
+interface WireSummary {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+
+interface WireFrame {
+  type: string;
+  sessionId?: string;
+  resumed?: boolean;
+  entryCount?: number;
+  index?: number;
+  entry?: SessionEntry;
+  code?: string;
+  message?: string;
+  conversations?: WireSummary[];
+}
+
+interface RecordedListCall {
+  userId: string | number;
+  limit: number | undefined;
+  before: SessionListOptions['before'];
+}
+
+interface SuiteLogs {
+  warnings: Array<Record<string, unknown>>;
+  errors: Array<Record<string, unknown>>;
+}
+
+const engines: HalEngine[] = [];
+const sockets: WebSocket[] = [];
+const historyTransport = {port: 0, history: {enabled: true}};
+const historyAndResume = {port: 0, history: {enabled: true}, resume: {enabled: true}};
+
+describe('conversation list over WebSocket', () => {
+  afterEach(async () => {
+    for (const socket of sockets.splice(0)) socket.terminate();
+    for (const engine of engines.splice(0)) await drainAndStop(engine);
+  });
+
+  const logs = captureSuiteLogs();
+
+  it('lists only the authenticated user conversations, pages by cursor, and resumes a chosen id', async () => {
+    const outcome = await exerciseHistoryAndResume(logs);
+
+    expect(outcome.actual).toEqual(outcome.expected);
+  });
+
+  it('answers list_conversations while a user_message is still running, before stream_end', async () => {
+    const inTurn = deferred();
+    const gate = deferred();
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async () => {
+        inTurn.release();
+        await gate.until;
+      },
+    };
+    const {wsUrl} = await startHalEngine(new InMemorySessionStore(), historyTransport, hooks);
+    const {socket, sessionId} = await openSessionSocket(wsUrl);
+    const observed = await listDuringActiveTurn(socket, inTurn.until, gate.release);
+
+    expect(observed).toEqual({
+      order: ['conversation_list', 'stream_end'],
+      listedIds: [sessionId],
+    });
+  });
+
+  it('validates list_conversations limits and cursors, refusing out-of-range or partial values', () => {
+    const bare = validateMessage({type: 'list_conversations'});
+    const validCursor = {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: 's1'};
+    const paged = validateMessage({
+      type: 'list_conversations',
+      limit: 25,
+      before: validCursor,
+      userId: 'u2',
+    });
+    const upperBound = validateMessage({type: 'list_conversations', limit: 200});
+    const rejectedLimits = [0, -1, 201, 1.5, '10'].map(limitVerdict);
+    const rejectedCursors = [
+      'not a date',
+      {updatedAt: 'not a date', sessionId: 's1'},
+      {updatedAt: '2026-01-01T00:00:00.000Z'},
+      {sessionId: 's1'},
+      {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: ''},
+    ].map(beforeVerdict);
+
+    expect({bare, paged, upperBound, rejectedLimits, rejectedCursors}).toEqual({
+      bare: {valid: true, data: {type: 'list_conversations'}},
+      paged: {valid: true, data: {type: 'list_conversations', limit: 25, before: validCursor}},
+      upperBound: {valid: true, data: {type: 'list_conversations', limit: 200}},
+      rejectedLimits: [true, true, true, true, true],
+      rejectedCursors: [true, true, true, true, true],
+    });
+  });
+
+  it('answers UNSUPPORTED when listing is off or unavailable, and SERVER_ERROR without store detail', async () => {
+    const historyOff = await checkUnsupportedCase(new InMemorySessionStore(), {port: 0});
+    const fiveMember = await checkUnsupportedCase(fiveMemberStore(), historyTransport);
+    const lackingFind = await checkUnsupportedCase(
+      new MongoSessionStore({collection: fakeCollection()}),
+      historyTransport
+    );
+    const failure = await exerciseFailingStore(logs);
+
+    expect({
+      unsupportedCode: Reflect.get(ErrorCodes, 'UNSUPPORTED'),
+      storeCannotListExport: typeof Reflect.get(publicSurface, 'StoreCannotList'),
+      historyOff,
+      fiveMember,
+      lackingFind,
+      ...failure,
+    }).toEqual({
+      unsupportedCode: 'UNSUPPORTED',
+      storeCannotListExport: 'function',
+      historyOff: {types: ['error', 'pong'], code: 'UNSUPPORTED'},
+      fiveMember: {types: ['error', 'pong'], code: 'UNSUPPORTED'},
+      lackingFind: {types: ['error', 'pong'], code: 'UNSUPPORTED'},
+      warnedWithoutResume: true,
+      failureTypes: ['error', 'pong'],
+      failureCode: 'SERVER_ERROR',
+      detailSentToClient: false,
+      loggedWithSessionId: true,
+      userContentLogged: false,
+    });
+  });
+});
+
+function captureSuiteLogs(): SuiteLogs {
+  const warnings: Array<Record<string, unknown>> = [];
+  const errors: Array<Record<string, unknown>> = [];
+  const quiet = () => undefined;
+
+  beforeEach(() => {
+    warnings.length = 0;
+    errors.length = 0;
+    setLogger({
+      debug: quiet,
+      info: quiet,
+      warn: (category, message, fields) => void warnings.push({category, message, ...fields}),
+      error: (category, message, fields) => void errors.push({category, message, ...fields}),
+    });
+  });
+
+  afterEach(() => setLogger());
+  return {warnings, errors};
+}
+
+async function drainAndStop(engine: HalEngine): Promise<void> {
+  const {wss} = engine;
+  for (let attempt = 0; attempt < 50 && wss.clients.size > 0; attempt++) {
+    await new Promise(resolve => setTimeout(resolve, 10));
+  }
+  await engine.stop();
+}
+
+async function exerciseHistoryAndResume(logs: SuiteLogs) {
+  const seeded = seededStore();
+  const started = await startTrackingWarnings(seeded.store, historyAndResume, logs);
+  const initial = await openSessionSocket(started.wsUrl);
+  const firstFrames = await collectFramesUntilPong(initial.socket, {type: 'list_conversations', userId: 'u2'});
+  const listed = firstFrames[0]?.conversations ?? [];
+  const cursor = {
+    updatedAt: listed[0]?.updatedAt ?? seeded.newerStamp,
+    sessionId: listed[0]?.sessionId ?? 'newer',
+  };
+  const pagedFrames = await collectFramesUntilPong(initial.socket, {
+    type: 'list_conversations',
+    limit: 1,
+    before: cursor,
+  });
+  const resumedFrames = await collectFramesUntilPong(
+    dialSubprotocolSocket(`${started.wsUrl}?sessionId=${listed[1]?.sessionId ?? 'older'}`)
+  );
+
+  return {
+    actual: {
+      warnedWithResume: started.warned,
+      connectedKeys: initial.connectedKeys,
+      firstTypes: firstFrames.map(frame => frame.type),
+      listedIds: listed.map(row => row.sessionId),
+      entryCounts: listed.map(row => row.entryCount),
+      summaryKeys: listed.map(row => Object.keys(row).sort()),
+      allIsoStrings: listed.every(row => isoTimestamp(row.createdAt) && isoTimestamp(row.updatedAt)),
+      pagedTypes: pagedFrames.map(frame => frame.type),
+      pagedIds: (pagedFrames[0]?.conversations ?? []).map(row => row.sessionId),
+      recorded: seeded.recorded,
+      resumedConnected: {
+        sessionId: resumedFrames[0]?.sessionId,
+        resumed: resumedFrames[0]?.resumed,
+        entryCount: resumedFrames[0]?.entryCount,
+        keys: Object.keys(resumedFrames[0] ?? {}).sort(),
+      },
+      replayed: resumedFrames
+        .filter(frame => frame.type === 'entry_upsert')
+        .map(frame => ({index: frame.index, entry: frame.entry})),
+    },
+    expected: {
+      warnedWithResume: false,
+      connectedKeys: ['examplePrompts', 'message', 'resumed', 'sessionId', 'type'],
+      firstTypes: ['conversation_list', 'pong'],
+      listedIds: ['newer', 'older', initial.sessionId],
+      entryCounts: [1, 1, 0],
+      summaryKeys: [
+        ['createdAt', 'entryCount', 'sessionId', 'updatedAt'],
+        ['createdAt', 'entryCount', 'sessionId', 'updatedAt'],
+        ['createdAt', 'entryCount', 'sessionId', 'updatedAt'],
+      ],
+      allIsoStrings: true,
+      pagedTypes: ['conversation_list', 'pong'],
+      pagedIds: ['older'],
+      recorded: [
+        {userId: 'u1', limit: undefined, before: undefined},
+        {userId: 'u1', limit: 1, before: {updatedAt: seeded.newerStamp, sessionId: 'newer'}},
+      ],
+      resumedConnected: {
+        sessionId: 'older',
+        resumed: true,
+        entryCount: 1,
+        keys: ['entryCount', 'examplePrompts', 'message', 'resumed', 'sessionId', 'type'],
+      },
+      replayed: [{index: 0, entry: {role: 'user', content: 'first question', timestamp: seeded.olderStamp}}],
+    },
+  };
+}
+
+function seededStore() {
+  const inner = new InMemorySessionStore();
+  const older = inner.create('older', 'u1');
+  const [anchor] = inner.listFor('u1');
+  const baseMs = anchor ? anchor.createdAt.getTime() : 0;
+  const olderStamp = new Date(baseMs + 60_000).toISOString();
+  older.entries.push({role: 'user', content: 'first question', timestamp: olderStamp});
+
+  const newer = inner.create('newer', 'u1');
+  const newerStamp = new Date(baseMs + 120_000).toISOString();
+  newer.entries.push({role: 'user', content: 'second question', timestamp: newerStamp});
+
+  const theirs = inner.create('theirs', 'u2');
+  const theirsStamp = new Date(baseMs + 180_000).toISOString();
+  theirs.entries.push({role: 'user', content: 'other user question', timestamp: theirsStamp});
+
+  const recorded: RecordedListCall[] = [];
+  const store: SessionStore = {
+    create: (id, userId, options) => inner.create(id, userId, options),
+    get: id => inner.get(id),
+    delete: id => inner.delete(id),
+    evict: id => inner.evict(id),
+    lookup: id => inner.lookup(id),
+    latestFor: userId => inner.latestFor(userId),
+    count: () => inner.count(),
+    clear: () => inner.clear(),
+    listFor: (userId, options) => {
+      recorded.push({userId, limit: options?.limit, before: options?.before});
+      return inner.listFor(userId, options);
+    },
+  };
+  return {store, recorded, olderStamp, newerStamp};
+}
+
+async function listDuringActiveTurn(
+  socket: WebSocket,
+  inTurn: Promise<void>,
+  releaseTurn: () => void
+): Promise<{order: string[]; listedIds: string[] | undefined}> {
+  const order: string[] = [];
+  let listedIds: string[] | undefined;
+  const replyOrFallback = deferred();
+  const turnEnded = deferred();
+
+  socket.on('message', (raw: RawData) => {
+    const frame = JSON.parse(String(raw)) as WireFrame;
+    if (frame.type === 'conversation_list') {
+      listedIds = frame.conversations?.map(row => row.sessionId);
+      order.push(frame.type);
+      replyOrFallback.release();
+      return;
+    }
+    if (frame.type === 'error') {
+      order.push(frame.type);
+      replyOrFallback.release();
+      return;
+    }
+    if (frame.type !== 'stream_end') return;
+    order.push(frame.type);
+    turnEnded.release();
+  });
+
+  socket.send(JSON.stringify({type: 'user_message', content: 'hold the turn'}));
+  await inTurn;
+  const fallbackTimer = setTimeout(() => replyOrFallback.release(), 150);
+  socket.send(JSON.stringify({type: 'list_conversations'}));
+  await replyOrFallback.until;
+  clearTimeout(fallbackTimer);
+  releaseTurn();
+  await turnEnded.until;
+  return {order, listedIds};
+}
+
+function limitVerdict(candidate: unknown): boolean {
+  const verdict = validateMessage({type: 'list_conversations', limit: candidate});
+  return !verdict.valid && verdict.error.includes('limit');
+}
+
+function beforeVerdict(candidate: unknown): boolean {
+  const verdict = validateMessage({type: 'list_conversations', before: candidate});
+  return !verdict.valid && verdict.error.includes('before');
+}
+
+async function checkUnsupportedCase(
+  session: SessionStore,
+  transport: HalEngineConfig['transport']
+): Promise<{types: string[]; code: string | undefined}> {
+  const {wsUrl} = await startHalEngine(session, transport);
+  const {socket} = await openSessionSocket(wsUrl);
+  const frames = await collectFramesUntilPong(socket, {type: 'list_conversations'});
+  return {types: frames.map(frame => frame.type), code: frames[0]?.code};
+}
+
+async function exerciseFailingStore(logs: SuiteLogs) {
+  const userContent = 'private-medical-prompt-7788';
+  const storeDetail = 'mongo-primary-10.0.4.9 unreachable';
+  const store = fiveMemberStore({
+    initialUserContent: userContent,
+    listFor: () => Promise.reject(new Error(storeDetail)),
+  });
+  const started = await startTrackingWarnings(store, historyTransport, logs);
+  const connection = await openSessionSocket(started.wsUrl);
+  logs.errors.length = 0;
+  const frames = await collectFramesUntilPong(connection.socket, {type: 'list_conversations'});
+  const serializedErrors = JSON.stringify(logs.errors);
+
+  return {
+    warnedWithoutResume: started.warned,
+    failureTypes: frames.map(frame => frame.type),
+    failureCode: frames[0]?.code,
+    detailSentToClient: (frames[0]?.message ?? '').includes('mongo-primary-10.0.4.9'),
+    loggedWithSessionId: logs.errors.some(entry => entry['sessionId'] === connection.sessionId),
+    userContentLogged: serializedErrors.includes(userContent),
+  };
+}
+
+function fiveMemberStore(overrides?: {initialUserContent?: string; listFor?: SessionStore['listFor']}): SessionStore {
+  const inner = new InMemorySessionStore();
+  const base: SessionStore = {
+    create: (id, userId, options) => {
+      const session = inner.create(id, userId, options);
+      if (overrides?.initialUserContent !== undefined) {
+        session.entries.push({
+          role: 'user',
+          content: overrides.initialUserContent,
+          timestamp: '2026-01-01T00:00:00.000Z',
+        });
+      }
+      return session;
+    },
+    get: id => inner.get(id),
+    delete: id => inner.delete(id),
+    count: () => inner.count(),
+    clear: () => inner.clear(),
+  };
+  return overrides?.listFor ? {...base, listFor: overrides.listFor} : base;
+}
+
+async function startTrackingWarnings(
+  session: SessionStore,
+  transport: HalEngineConfig['transport'],
+  logs: SuiteLogs
+): Promise<{wsUrl: string; warned: boolean}> {
+  logs.warnings.length = 0;
+  const {wsUrl} = await startHalEngine(session, transport);
+  return {wsUrl, warned: logs.warnings.length > 0};
+}
+
+async function startHalEngine(
+  session: SessionStore,
+  transport: HalEngineConfig['transport'],
+  hooks?: OrchestratorHooks
+): Promise<{wsUrl: string}> {
+  const engine = createHalEngine({
+    provider: {type: 'mock'},
+    prompt: {identity: 'Conversation list acceptance test.'},
+    session,
+    transport,
+    auth: {ws: async () => ({id: 'u1'})},
+    orchestrator: hooks ? {hooks} : undefined,
+  });
+  await engine.start(0);
+  engines.push(engine);
+  const address = engine.server.address() as AddressInfo;
+  return {wsUrl: `ws://127.0.0.1:${address.port}/hal/ws`};
+}
+
+async function openSessionSocket(
+  url: string
+): Promise<{socket: WebSocket; sessionId: string; connectedKeys: string[]}> {
+  const socket = dialSubprotocolSocket(url);
+  const [connected] = await collectFramesUntilPong(socket);
+  return {
+    socket,
+    sessionId: connected?.sessionId ?? '',
+    connectedKeys: Object.keys(connected ?? {}).sort(),
+  };
+}
+
+function dialSubprotocolSocket(url: string): WebSocket {
+  const socket = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'token-1']);
+  sockets.push(socket);
+  return socket;
+}
+
+async function collectFramesUntilPong(
+  socket: WebSocket,
+  initialPayload?: Record<string, unknown>
+): Promise<WireFrame[]> {
+  const frames: WireFrame[] = [];
+  return new Promise(resolve => {
+    const onMessage = (raw: RawData) => {
+      const frame = JSON.parse(String(raw)) as WireFrame;
+      frames.push(frame);
+      if (frames.length === 1) {
+        socket.send(JSON.stringify({type: 'ping', timestamp: 1}));
+        return;
+      }
+      if (frame.type !== 'pong') return;
+      socket.off('message', onMessage);
+      resolve(frames);
+    };
+    socket.on('message', onMessage);
+    if (initialPayload) socket.send(JSON.stringify(initialPayload));
+  });
+}
+
+function isoTimestamp(stamp: unknown): boolean {
+  return typeof stamp === 'string' && Number.isFinite(Date.parse(stamp));
+}