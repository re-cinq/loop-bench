diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..109363b
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,247 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import {MongoClient} from 'mongodb';
+import type {CollectionLike} from '../infrastructure/stores/mongo/mongoDriverTypes.js';
+import type {MongoSessionDocument} from '../infrastructure/stores/mongo/mongoSessionDocument.js';
+import {createHalEngine} from '../config.js';
+import type {HalEngineConfig, HalEngine} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {MongoSessionStore} from '../infrastructure/stores/mongo/mongoSessionStore.js';
+import type {SessionStore, SessionListOptions} from '../types/sessionStore.js';
+import {validateMessage} from './ws/validation.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {setLogger} from '../shared/logger.js';
+
+interface Row {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+interface Frame {
+  type: string;
+  conversations?: Row[];
+  code?: string;
+  sessionId?: string;
+  resumed?: boolean;
+  entry?: {content?: string};
+}
+const engines: HalEngine[] = [];
+const sockets: WebSocket[] = [];
+const errors: unknown[] = [];
+const start = async (
+  store: SessionStore,
+  history?: {enabled: boolean},
+  hooks?: NonNullable<HalEngineConfig['orchestrator']>['hooks']
+) => {
+  const transport = {resume: {enabled: true}, history};
+  const engine = createHalEngine({
+    provider: {type: 'bedrock', modelId: 'unused', region: 'eu-central-1', maxTokens: 10},
+    prompt: {identity: 'Acceptance test'},
+    session: store,
+    transport,
+    auth: {ws: async () => ({id: 'owner'})},
+    orchestrator: {hooks},
+    logger: {
+      debug() {},
+      info() {},
+      warn() {},
+      error(category, message, fields) {
+        errors.push({category, message, fields});
+      },
+    },
+  });
+  engines.push(engine);
+  await engine.start(0);
+  return `ws://127.0.0.1:${(engine.server.address() as AddressInfo).port}/hal/ws`;
+};
+const open = async (url: string) => {
+  const socket = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'credential']);
+  sockets.push(socket);
+  const frames: Frame[] = [];
+  socket.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  await once(socket, 'message');
+  return {socket, frames};
+};
+const waitFor = async (condition: () => boolean) => {
+  for (let n = 0; n < 100 && !condition(); n++) await new Promise(resolve => setTimeout(resolve, 5));
+  expect(condition()).toBe(true);
+};
+const request = async (socket: WebSocket, frames: Frame[], payload: unknown) => {
+  const offset = frames.length;
+  socket.send(JSON.stringify(payload));
+  await waitFor(() => frames.slice(offset).some(frame => ['error', 'conversation_list'].includes(frame.type)));
+  socket.send(JSON.stringify({type: 'ping', timestamp: 1}));
+  await waitFor(() => frames.slice(offset).some(frame => frame.type === 'pong'));
+  return frames.slice(offset).filter(frame => frame.type !== 'pong');
+};
+const seeded = () => {
+  const store = new InMemorySessionStore();
+  for (const [id, user] of [
+    ['a', 'owner'],
+    ['b', 'owner'],
+    ['foreign', 'stranger'],
+  ]) {
+    store
+      .create(id, user, {authHeaders: {authorization: 'private credential'}})
+      .entries.push({role: 'user', content: `private ${id}`, timestamp: '2026-10-28T08:00:00.000Z'});
+  }
+  return store;
+};
+const requiredMembers = (inner: InMemorySessionStore): SessionStore => ({
+  create: (id, user, options) => inner.create(id, user, options),
+  get: id => inner.get(id),
+  delete: id => inner.delete(id),
+  count: () => inner.count(),
+  clear: () => inner.clear(),
+});
+afterEach(async () => {
+  for (const socket of sockets.splice(0)) socket.terminate();
+  for (const engine of engines.splice(0)) {
+    await waitFor(() => engine.wss.clients.size === 0);
+    await engine.stop();
+  }
+  errors.length = 0;
+  setLogger();
+});
+
+// Spec: specs/hal-engine-websocket-protocol/spec.md#4.3
+it('validates bounded history requests and complete wire cursors independently of configuration', () => {
+  expect(validateMessage({type: 'list_conversations'})).toEqual({valid: true, data: {type: 'list_conversations'}});
+  const before = {updatedAt: '2026-10-28T08:00:00.000Z', sessionId: 'b'};
+  for (const limit of [1, 200])
+    expect(validateMessage({type: 'list_conversations', limit, before, userId: 'stranger'})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations', limit, before},
+    });
+  for (const [field, values] of Object.entries({
+    limit: [0, 201, 1.5, '10', null],
+    before: [
+      'not a date',
+      {},
+      {updatedAt: before.updatedAt},
+      {sessionId: 'b'},
+      {...before, updatedAt: 'bad'},
+      {...before, sessionId: 1},
+    ],
+  })) {
+    for (const value of values)
+      expect(validateMessage({type: 'list_conversations', [field]: value})).toEqual({
+        valid: false,
+        error: expect.stringContaining(field),
+      });
+  }
+});
+
+// Spec: specs/hal-engine-conversation-list/spec.md#client-history
+it('lists only the socket owner, pages composite cursors and resumes a listed conversation', async () => {
+  const store = seeded();
+  const calls: Array<{user: string | number; options?: SessionListOptions}> = [];
+  const original = store.listFor.bind(store);
+  store.listFor = (user, options) => {
+    calls.push({user, options});
+    return original(user, options);
+  };
+  const url = await start(store, {enabled: true});
+  const {socket, frames} = await open(url);
+  expect(frames.map(frame => frame.type)).toEqual(['connected']);
+  const all = await request(socket, frames, {type: 'list_conversations', userId: 'stranger'});
+  const expected = JSON.parse(JSON.stringify(original('owner'))) as Row[];
+  expect(all).toEqual([{type: 'conversation_list', conversations: expected}]);
+  expect(expected).toHaveLength(3);
+  for (const row of all[0].conversations ?? []) {
+    expect(Object.keys(row).sort()).toEqual(['createdAt', 'entryCount', 'sessionId', 'updatedAt']);
+    expect(new Date(row.createdAt).toISOString()).toBe(row.createdAt);
+    expect(new Date(row.updatedAt).toISOString()).toBe(row.updatedAt);
+  }
+  const first = await request(socket, frames, {type: 'list_conversations', limit: 2});
+  const row = first[0].conversations?.at(-1);
+  const before = {updatedAt: row?.updatedAt, sessionId: row?.sessionId};
+  const next = await request(socket, frames, {type: 'list_conversations', limit: 2, before});
+  expect([...(first[0].conversations ?? []), ...(next[0].conversations ?? [])]).toEqual(expected);
+  expect(calls).toEqual([
+    {user: 'owner', options: {limit: undefined, before: undefined}},
+    {user: 'owner', options: {limit: 2, before: undefined}},
+    {user: 'owner', options: {limit: 2, before}},
+  ]);
+  const listed = expected.find(summary => summary.sessionId === 'a');
+  const resumed = await open(`${url}?sessionId=${listed?.sessionId}`);
+  await waitFor(() => resumed.frames.some(frame => frame.type === 'entry_upsert'));
+  expect(resumed.frames[0]).toMatchObject({resumed: true, sessionId: 'a'});
+  expect(resumed.frames[1]).toMatchObject({type: 'entry_upsert', entry: {content: 'private a'}});
+});
+
+// Spec: specs/hal-engine-conversation-list/spec.md#history-unavailable
+it('answers UNSUPPORTED when history is off or the store has no list capability', async () => {
+  const client = new MongoClient('mongodb://127.0.0.1:1');
+  const collection = client.db('history').collection('sessions');
+  Object.defineProperty(collection, 'find', {value: undefined});
+  const cannotList = new MongoSessionStore({collection: collection as unknown as CollectionLike<MongoSessionDocument>});
+  const unsupported: SessionStore = {
+    ...requiredMembers(seeded()),
+    listFor: (user, options) => cannotList.listFor(user, options),
+  };
+  for (const [store, history] of [
+    [seeded(), undefined],
+    [seeded(), {enabled: false}],
+    [requiredMembers(seeded()), {enabled: true}],
+    [unsupported, {enabled: true}],
+  ] as const) {
+    const {socket, frames} = await open(await start(store, history));
+    const answer = await request(socket, frames, {type: 'list_conversations'});
+    expect(answer).toEqual([{type: 'error', code: 'UNSUPPORTED', message: expect.any(String)}]);
+    expect(socket.readyState).toBe(WebSocket.OPEN);
+  }
+});
+
+// Spec: specs/hal-engine-conversation-list/spec.md#history-concurrency
+it('answers history while a turn holds the session lock', async () => {
+  let entered = false;
+  let release = () => {};
+  const gate = new Promise<void>(resolve => {
+    release = resolve;
+  });
+  const {socket, frames} = await open(
+    await start(
+      seeded(),
+      {enabled: true},
+      {
+        beforeModelResponse: async (_session, prompt) => {
+          entered = true;
+          await gate;
+          return prompt;
+        },
+      }
+    )
+  );
+  try {
