diff --git a/specs/hal-engine-conversation-list/spec.md b/specs/hal-engine-conversation-list/spec.md
index c9ee424..5c1603e 100644
--- a/specs/hal-engine-conversation-list/spec.md
+++ b/specs/hal-engine-conversation-list/spec.md
@@ -68,3 +68,9 @@ Resume gets a client back into one conversation: the id it names, or the user's
 ## When the store cannot answer
 
 - A store whose collection fails rejects rather than answering a partial or empty list: what to show a user who may have conversations is the caller's decision, and an empty history is not a safe guess ([validated by: rejects rather than answering a partial list when the collection fails](../../src/infrastructure/stores/mongo/mongoConversationList.test.ts#L225)).
+
+## Client access over WebSocket (re-cinq/HALEngine#144)
+
+- With `transport.history.enabled`, an explicit `list_conversations` request returns exactly one `conversation_list` containing the authenticated connection user's summaries in store order, including the current conversation, with only `sessionId`, ISO-string `createdAt` and `updatedAt`, and `entryCount`; the handler calls `listFor` with the connection's user id and `{limit, before}` unchanged from the frame, never a frame-supplied user id, and a client can page with the composite cursor and reconnect to a listed id through the existing authenticated resume and replay path ([validated by: lists only the socket owner metadata, pages with the wire cursor and resumes a listed conversation](../../src/transport/conversationList.acceptance.test.ts#L137)).
+
+**GDPR.** These summaries are one authenticated user's personal metadata and carry no conversation content; `transport.history` is the deployer's independent decision to make that user's history reachable from the client, and retention remains the consumer's responsibility under re-cinq/HALEngine#41.
diff --git a/specs/hal-engine-websocket-protocol/spec.md b/specs/hal-engine-websocket-protocol/spec.md
index e648542..6bd79e0 100644
--- a/specs/hal-engine-websocket-protocol/spec.md
+++ b/specs/hal-engine-websocket-protocol/spec.md
@@ -655,3 +655,10 @@ After 5 failed attempts, the client MUST stop reconnecting and report a disconne
 | Message validation       | `src/transport/ws/validation.ts`                  |
 | Message handling         | `src/transport/ws/messageHandler.ts`              |
 | Connection handler       | `src/transport/ws/connectionHandler.ts`           |
+
+## 14. Conversation list (re-cinq/HALEngine#144)
+
+- `list_conversations` accepts an optional integer `limit` from 1 through 200 and an optional `before` object containing a parseable ISO `updatedAt` string and a string `sessionId`, rejects malformed paging fields with an error naming the field, and discards extra fields including `userId` independently of feature configuration ([validated by: validates history frames and composite cursors without accepting malformed paging fields](../../src/transport/conversationList.acceptance.test.ts#L107)).
+- A history request returns exactly one `error` with code `UNSUPPORTED` and no list when `transport.history` is absent or disabled, the store has no `listFor`, or its collection has no `find` (the exported `StoreCannotList` condition), rather than claiming the user has no conversations ([validated by: answers UNSUPPORTED without a list when history is off or the store cannot list](../../src/transport/conversationList.acceptance.test.ts#L176)).
+- A rejected store list returns one generic `SERVER_ERROR`, reveals no store detail, logs the failure with the session id and no user content, and leaves the socket usable ([validated by: reports a real database list failure safely and keeps the socket usable](../../src/transport/conversationList.acceptance.test.ts#L213)).
+- A history request is answered outside the per-session turn lock, before an active turn ends, and does not emit `stream_end` ([validated by: answers history before an active turn releases the per-session lock](../../src/transport/conversationList.acceptance.test.ts#L240)).
diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..68707c5
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,264 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import {MongoClient} from 'mongodb';
+import type {MongoSessionDocument} from '../infrastructure/stores/mongo/mongoSessionDocument.js';
+import {createHalEngine} from '../config.js';
+import type {HalEngineConfig, HalEngine} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {MongoSessionStore} from '../infrastructure/stores/mongo/mongoSessionStore.js';
+import type {SessionStore, SessionListOptions, SessionSummary} from '../types/sessionStore.js';
+import {validateMessage} from './ws/validation.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {captureErrors} from '../shared/logCaptureTestSupport.js';
+
+interface Row {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+interface Frame {
+  type: string;
+  code?: string;
+  message?: string;
+  sessionId?: string;
+  resumed?: boolean;
+  conversations?: Row[];
+  entry?: {content?: string};
+}
+
+const engines: HalEngine[] = [];
+const clients: WebSocket[] = [];
+
+// Records real list calls without replacing their implementation.
+class RecordedStore extends InMemorySessionStore {
+  readonly calls: Array<{userId: string | number; options?: SessionListOptions}> = [];
+  override listFor(userId: string | number, options?: SessionListOptions): SessionSummary[] {
+    this.calls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+const requiredMembers = (store: InMemorySessionStore): SessionStore => ({
+  create: (...args) => store.create(...args),
+  get: id => store.get(id),
+  delete: id => store.delete(id),
+  count: () => store.count(),
+  clear: () => store.clear(),
+});
+
+const start = async (
+  session: SessionStore,
+  enabled?: boolean,
+  hooks?: NonNullable<HalEngineConfig['orchestrator']>['hooks']
+) => {
+  // The extra option is deliberately structural so this red test compiles before the option exists.
+  const transport = {resume: {enabled: true}, ...(enabled === undefined ? {} : {history: {enabled}})};
+  const engine = createHalEngine({
+    session,
+    transport,
+    provider: {type: 'bedrock', region: 'eu-central-1', modelId: 'unused-history-test', maxTokens: 1},
+    prompt: {identity: 'History acceptance'},
+    auth: {ws: async () => ({id: 'owner'})},
+    orchestrator: {hooks},
+  });
+  engines.push(engine);
+  await engine.start(0);
+  return `ws://127.0.0.1:${(engine.server.address() as AddressInfo).port}/hal/ws`;
+};
+
+const connect = async (url: string) => {
+  const socket = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'acceptance']);
+  clients.push(socket);
+  const frames: Frame[] = [];
+  socket.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  await once(socket, 'open');
+  const exchange = async (frame: object): Promise<Frame[]> => {
+    const from = frames.length;
+    socket.send(JSON.stringify(frame));
+    socket.send(JSON.stringify({type: 'ping', timestamp: 42}));
+    await waitFor(() => frames.slice(from).some(item => item.type === 'pong'));
+    if (Reflect.get(frame, 'type') === 'list_conversations') {
+      await waitFor(() => frames.slice(from).some(item => ['error', 'conversation_list'].includes(item.type)));
+    }
+    return frames.slice(from).filter(item => item.type !== 'pong');
+  };
+  await exchange({type: 'ping', timestamp: 0});
+  return {socket, frames, exchange};
+};
+
+const waitFor = async (ready: () => boolean) => {
+  for (let i = 0; i < 200 && !ready(); i++) await new Promise(resolve => setTimeout(resolve, 10));
+  expect(ready()).toBe(true);
+};
+
+afterEach(async () => {
+  for (const client of clients.splice(0)) client.terminate();
+  for (const engine of engines.splice(0)) {
+    await waitFor(() => engine.wss.clients.size === 0);
+    await engine.stop();
+  }
+});
+
+const errors = captureErrors();
+
+// spec: specs/hal-engine-websocket-protocol/spec.md#214
+it('validates history frames and composite cursors without accepting malformed paging fields', () => {
+  const before = {updatedAt: '2026-10-01T00:00:00.000Z', sessionId: 'row-b'};
+  for (const fields of [{}, {limit: 1}, {limit: 200, before}]) {
+    expect(validateMessage({type: 'list_conversations', ...fields, userId: 'intruder'})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations', ...fields},
+    });
+  }
+  for (const limit of [0, 201, 1.5, '10', null]) {
+    expect(validateMessage({type: 'list_conversations', limit})).toEqual({
+      valid: false,
+      error: expect.stringMatching(/limit/i),
+    });
+  }
+  for (const cursor of [
+    'not a date',
+    {},
+    {updatedAt: before.updatedAt},
+    {sessionId: 'row-b'},
+    {...before, updatedAt: 'invalid'},
+    {...before, sessionId: 2},
+  ]) {
+    expect(validateMessage({type: 'list_conversations', before: cursor})).toEqual({
+      valid: false,
+      error: expect.stringMatching(/before/i),
+    });
+  }
+});
+
+// spec: specs/hal-engine-conversation-list/spec.md#37
+it('lists only the socket owner metadata, pages with the wire cursor and resumes a listed conversation', async () => {
+  const store = new RecordedStore();
+  for (const id of ['row-a', 'row-b']) {
+    store.create(id, 'owner', {authHeaders: {Authorization: 'secret'}}).entries.push({
+      role: 'user',
+      content: `private ${id}`,
+      timestamp: '2026-10-01T00:00:00.000Z',
+    });
+  }
+  store.create('other-user', 'intruder');
+  const base = await start(store, true);
+  const client = await connect(base);
+  expect(client.frames.filter(frame => frame.type !== 'pong').map(frame => frame.type)).toEqual(['connected']);
+  const expected = JSON.parse(JSON.stringify(store.listFor('owner'))) as Row[];
+  store.calls.length = 0;
+  const reply = await client.exchange({type: 'list_conversations', userId: 'intruder'});
+  expect(reply).toEqual([{type: 'conversation_list', conversations: expected}]);
+  expect(expected).toHaveLength(3);
+  expect(store.calls).toEqual([{userId: 'owner', options: {limit: undefined, before: undefined}}]);
+  for (const row of reply[0].conversations ?? []) {
+    expect(Object.keys(row).sort()).toEqual(['createdAt', 'entryCount', 'sessionId', 'updatedAt']);
+    expect(new Date(row.createdAt).toISOString()).toBe(row.createdAt);
+    expect(new Date(row.updatedAt).toISOString()).toBe(row.updatedAt);
+  }
+  const first = await client.exchange({type: 'list_conversations', limit: 1});
+  const head = first[0].conversations![0];
+  const before = {updatedAt: head.updatedAt, sessionId: head.sessionId};
+  const next = await client.exchange({type: 'list_conversations', limit: 2, before});
+  expect([...first[0].conversations!, ...next[0].conversations!]).toEqual(expected);
+  expect(store.calls.at(-1)).toEqual({userId: 'owner', options: {limit: 2, before}});
+  const selected = next[0].conversations!.find(row => row.entryCount > 0)!;
+  const resumed = await connect(`${base}?sessionId=${selected.sessionId}`);
+  expect(resumed.frames[0]).toMatchObject({type: 'connected', sessionId: selected.sessionId, resumed: true});
+  expect(resumed.frames.filter(frame => frame.type === 'entry_upsert').map(frame => frame.entry?.content)).toEqual([
+    `private ${selected.sessionId}`,
+  ]);
+});
+
+// spec: specs/hal-engine-websocket-protocol/spec.md#215
+it('answers UNSUPPORTED without a list when history is off or the store cannot list', async () => {
+  const memory = new InMemorySessionStore();
+  memory.create('existing', 'owner');
+  const driver = new MongoClient('mongodb://127.0.0.1:1');
+  const collection = driver.db('history').collection<MongoSessionDocument>('sessions');
+  const legacy = new MongoSessionStore({
+    collection: {
+      findOne: collection.findOne.bind(collection),
+      updateOne: collection.updateOne.bind(collection),
+      deleteOne: collection.deleteOne.bind(collection),
+      deleteMany: collection.deleteMany.bind(collection),
+      countDocuments: collection.countDocuments.bind(collection),
+    },
+  });
+  const cannotList: SessionStore = {
+    ...requiredMembers(memory),
+    listFor: (userId, options) => legacy.listFor(userId, options),
+  };
+  try {
+    const cases = [
+      {store: memory, enabled: undefined},
+      {store: memory, enabled: false},
+      {store: requiredMembers(memory), enabled: true},
+      {store: cannotList, enabled: true},
+    ];
+    const replies: Frame[][] = [];
+    for (const {store, enabled} of cases) {
+      const client = await connect(await start(store, enabled));
+      replies.push(await client.exchange({type: 'list_conversations'}));
+    }
+    expect(replies).toEqual(cases.map(() => [{type: 'error', code: 'UNSUPPORTED', message: expect.any(String)}]));
+  } finally {
+    await driver.close();
+  }
+});
+
+// spec: specs/hal-engine-websocket-protocol/spec.md#216
+it('reports a real database list failure safely and keeps the socket usable', async () => {
+  const memory = new InMemorySessionStore();
+  const database = new MongoSessionStore({
+    url: 'mongodb://127.0.0.1:1/?serverSelectionTimeoutMS=50',
+    dbName: 'private_history_detail',
+  });
+  const store: SessionStore = {
+    ...requiredMembers(memory),
+    listFor: (userId, options) => database.listFor(userId, options),
+  };
+  try {
+    const client = await connect(await start(store, true));
+    client.socket.send(JSON.stringify({type: 'list_conversations'}));
+    await waitFor(() => client.frames.some(frame => frame.type === 'error'));
+    const replies = client.frames.filter(frame => !['connected', 'pong'].includes(frame.type));
+    expect(replies).toEqual([{type: 'error', code: 'SERVER_ERROR', message: expect.any(String)}]);
+    expect(JSON.stringify(replies)).not.toMatch(/private_history_detail|127\.0\.0\.1|ECONNREFUSED|Mongo/);
+    expect(errors).toEqual(expect.arrayContaining([expect.objectContaining({sessionId: client.frames[0].sessionId})]));
+    expect(JSON.stringify(errors)).not.toContain('private_history_detail');
+    expect(await client.exchange({type: 'ping', timestamp: 7})).toEqual([]);
+    expect(client.socket.readyState).toBe(WebSocket.OPEN);
+  } finally {
+    await database.close();
+  }
+});
+
+// spec: specs/hal-engine-websocket-protocol/spec.md#217
+it('answers history before an active turn releases the per-session lock', async () => {
+  let release!: () => void;
+  let entered = false;
+  const gate = new Promise<void>(resolve => {
+    release = resolve;
+  });
+  const base = await start(new InMemorySessionStore(), true, {
+    beforeModelResponse: async () => {
+      entered = true;
+      await gate;
+      throw new Error('Consumer policy stopped the turn before contacting the provider');
+    },
+  });
+  const client = await connect(base);
+  try {
+    client.socket.send(JSON.stringify({type: 'user_message', content: 'hold this turn'}));
+    await waitFor(() => entered);
+    const replies = await client.exchange({type: 'list_conversations'});
+    expect(replies.map(frame => frame.type)).toEqual(['conversation_list']);
+    expect(client.frames.some(frame => frame.type === 'stream_end')).toBe(false);
+  } finally {
+    release();
+    await waitFor(() => client.frames.some(frame => frame.type === 'stream_end'));
+  }
+});