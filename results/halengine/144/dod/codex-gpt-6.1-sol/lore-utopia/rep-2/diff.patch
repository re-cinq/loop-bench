+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,312 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {MongoClient} from 'mongodb';
+import {WebSocket} from 'ws';
+import {createHalEngine} from '../config.js';
+import type {HalEngine, HalEngineConfig} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {MongoSessionStore} from '../infrastructure/stores/mongo/mongoSessionStore.js';
+import type {CollectionLike, MongoClientLike} from '../infrastructure/stores/mongo/mongoDriverTypes.js';
+import type {MongoSessionDocument} from '../infrastructure/stores/mongo/mongoSessionDocument.js';
+import type {SessionStore, SessionListOptions} from '../types/sessionStore.js';
+import {captureErrors} from '../shared/logCaptureTestSupport.js';
+import {validateMessage} from './ws/validation.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {deferred} from './wsTestSupport.js';
+
+interface Row {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+
+interface Frame {
+  type: string;
+  sessionId?: string;
+  resumed?: boolean;
+  entryCount?: number;
+  conversations?: Row[];
+  code?: string;
+  message?: string;
+  entry?: unknown;
+}
+
+class RecordingStore extends InMemorySessionStore {
+  readonly requests: Array<{userId: string | number; options: SessionListOptions | undefined}> = [];
+
+  override listFor(userId: string | number, options?: SessionListOptions) {
+    this.requests.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+const engines: HalEngine[] = [];
+const clients: WebSocket[] = [];
+const errors = captureErrors();
+const AT = '2030-10-01T12:00:00.000Z';
+const historyOn = {enabled: true};
+
+async function start(
+  session: SessionStore,
+  history?: {enabled: boolean},
+  hooks?: NonNullable<HalEngineConfig['orchestrator']>['hooks']
+): Promise<{url: string; engine: HalEngine}> {
+  const transport = {history, resume: {enabled: true}};
+  const engine = createHalEngine({
+    provider: {type: 'bedrock', modelId: 'unused', region: 'eu-west-1', maxTokens: 1},
+    prompt: {identity: 'Conversation list acceptance'},
+    session,
+    auth: {ws: async () => ({id: 'owner'})},
+    transport,
+    orchestrator: {hooks},
+  });
+  engines.push(engine);
+  await engine.start(0);
+  const {port} = engine.server.address() as AddressInfo;
+  return {url: `ws://127.0.0.1:${port}/hal/ws`, engine};
+}
+
+function open(url: string) {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'private-token']);
+  clients.push(client);
+  const frames: Frame[] = [];
+  client.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  return {client, frames};
+}
+
+async function until(frames: Frame[], predicate: (frame: Frame) => boolean): Promise<Frame> {
+  const deadline = Date.now() + 1500;
+  while (Date.now() < deadline) {
+    const frame = frames.find(predicate);
+    if (frame) return frame;
+    await new Promise(resolve => setTimeout(resolve, 5));
+  }
+  throw new Error(`Expected WebSocket response did not arrive; received ${JSON.stringify(frames)}`);
+}
+
+async function barrier(client: WebSocket, frames: Frame[]): Promise<void> {
+  const offset = frames.length;
+  client.send(JSON.stringify({type: 'ping', timestamp: 144}));
+  await until(frames, frame => frame.type === 'pong' && frames.indexOf(frame) >= offset);
+}
+
+async function ask(client: WebSocket, frames: Frame[], payload: unknown): Promise<Frame[]> {
+  const offset = frames.length;
+  client.send(JSON.stringify(payload));
+  await until(frames, frame => frames.indexOf(frame) >= offset && ['conversation_list', 'error'].includes(frame.type));
+  await barrier(client, frames);
+  return frames.slice(offset).filter(frame => frame.type !== 'pong');
+}
+
+function seed(store: InMemorySessionStore): void {
+  for (const id of ['a', 'b', 'c']) {
+    store.create(id, 'owner', {authHeaders: {cookie: 'private-cookie'}}).entries.push({
+      role: 'user',
+      content: `private-content-${id}`,
+      timestamp: AT,
+    });
+  }
+  store.create('foreign', 'other').entries.push({role: 'user', content: 'foreign-content', timestamp: AT});
+}
+
+// A real storage adapter retaining only the original five capabilities; no canned results replace store behavior.
+function originalPort(inner: InMemorySessionStore): SessionStore {
+  return {
+    create: inner.create.bind(inner),
+    get: inner.get.bind(inner),
+    delete: inner.delete.bind(inner),
+    count: inner.count.bind(inner),
+    clear: inner.clear.bind(inner),
+  };
+}
+
+afterEach(async () => {
+  for (const client of clients.splice(0)) client.terminate();
+  for (const engine of engines.splice(0)) await engine.stop();
+});
+
+describe('conversation history over the authenticated WebSocket', () => {
+  // @spec specs/hal-engine-conversation-list/spec.md#99
+  it('validates bounded list requests and complete composite cursors independently of configuration', () => {
+    const valid = [
+      {type: 'list_conversations'},
+      {type: 'list_conversations', limit: 1},
+      {type: 'list_conversations', limit: 200, before: {updatedAt: AT, sessionId: 'b'}},
+    ];
+    const invalid = [
+      ...[0, 201, 1.5, '10', null].map(limit => ({field: 'limit', payload: {type: 'list_conversations', limit}})),
+      ...[
+        'not a date',
+        null,
+        {},
+        {updatedAt: AT},
+        {sessionId: 'b'},
+        {updatedAt: 'bad', sessionId: 'b'},
+        {updatedAt: 0, sessionId: 'b'},
+        {updatedAt: AT, sessionId: 3},
+      ].map(before => ({
+        field: 'before',
+        payload: {type: 'list_conversations', before},
+      })),
+    ];
+
+    expect(valid.map(payload => validateMessage(payload))).toEqual(valid.map(data => ({valid: true, data})));
+    for (const {payload, field} of invalid) {
+      expect(validateMessage(payload)).toEqual({valid: false, error: expect.stringMatching(new RegExp(field, 'i'))});
+    }
+    expect(validateMessage({type: 'list_conversations', userId: 'other'})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations'},
+    });
+  });
+
+  // @spec specs/hal-engine-conversation-list/spec.md#100
+  it('lists only the socket owner, pages tied activity without gaps, and reopens a listed conversation', async () => {
+    const store = new RecordingStore();
+    seed(store);
+    const {url} = await start(store, historyOn);
+    const {client, frames} = open(`${url}?sessionId=c`);
+    await until(frames, frame => frame.type === 'connected');
+    await barrier(client, frames);
+    expect(frames.map(frame => frame.type)).toEqual(['connected', 'entry_upsert', 'pong']);
+    const expected = JSON.parse(JSON.stringify(store.listFor('owner'))) as Row[];
+    const offset = store.requests.length;
+
+    const response = await ask(client, frames, {type: 'list_conversations', userId: 'other'});
+    expect(response).toEqual([{type: 'conversation_list', conversations: expected}]);
+    expect(response[0].conversations?.map(row => row.sessionId)).toEqual(['c', 'b', 'a']);
+    expect(store.requests[offset]).toEqual({userId: 'owner', options: {limit: undefined, before: undefined}});
+    for (const row of response[0].conversations ?? []) {
+      expect(Object.keys(row).sort()).toEqual(['createdAt', 'entryCount', 'sessionId', 'updatedAt']);
+      expect(new Date(row.createdAt).toISOString()).toBe(row.createdAt);
