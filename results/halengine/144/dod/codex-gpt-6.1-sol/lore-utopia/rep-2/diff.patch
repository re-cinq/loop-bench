+      expect(connection.frames.some(frame => frame.type === 'stream_end')).toBe(false);
+    } finally {
+      // Closing aborts the real provider before the hook releases, so no cloud request is needed to exercise the lock.
+      const closed = once(serverSocket, 'close');
+      connection.client.terminate();
+      await closed;
+      held.release();
+      await finished.until;
