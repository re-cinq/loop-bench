+  it('answers a history request before the active user turn can finish', async () => {
+    const store = new InMemorySessionStore();
+    const entered = deferred();
+    const held = deferred();
+    const finished = deferred();
+    const {url, engine} = await start(store, historyOn, {
+      beforeModelResponse: async (_session, prompt) => {
+        entered.release();
+        await held.until;
+        return prompt;
+      },
+      afterSession: async () => finished.release(),
+    });
+    const connection = open(url);
+    await until(connection.frames, frame => frame.type === 'connected');
+    const serverSocket = [...engine.wss.clients][0];
+    connection.client.send(JSON.stringify({type: 'user_message', content: 'private-content-in-flight'}));
+    await entered.until;
+    await until(connection.frames, frame => frame.type === 'entry_upsert');
+    try {
+      const response = await ask(connection.client, connection.frames, {type: 'list_conversations'});
