+      deleteOne: collection.deleteOne.bind(collection),
+      deleteMany: collection.deleteMany.bind(collection),
+      countDocuments: collection.countDocuments.bind(collection),
+    };
+    const cannotList = new MongoSessionStore({collection: originalCollection});
+    const unavailable = new MongoSessionStore({
+      client: client as unknown as MongoClientLike,
+      dbName: 'private-store-detail',
+    });
+    await client.close();
+    const cases = [
+      {store: memory, history: undefined, code: 'UNSUPPORTED'},
+      {store: memory, history: {enabled: false}, code: 'UNSUPPORTED'},
+      {store: originalPort(memory), history: historyOn, code: 'UNSUPPORTED'},
+      {
+        store: {...originalPort(memory), listFor: cannotList.listFor.bind(cannotList)},
+        history: historyOn,
+        code: 'UNSUPPORTED',
