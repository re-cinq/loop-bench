index 0000000..3c87e72
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,259 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import WebSocket from 'ws';
+import {MongoClient} from 'mongodb';
+import {MongoSessionStore} from '../infrastructure/stores/mongo/mongoSessionStore.js';
+import type {CollectionLike} from '../infrastructure/stores/mongo/mongoDriverTypes.js';
+import type {MongoSessionDocument} from '../infrastructure/stores/mongo/mongoSessionDocument.js';
+import {captureErrors} from '../shared/logCaptureTestSupport.js';
+import {createHalEngine} from '../config.js';
+import type {HalEngineConfig, HalEngine} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {SessionStore, SessionListOptions} from '../types/sessionStore.js';
+import {validateMessage} from './ws/validation.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+
+interface Frame {
+  type: string;
+  sessionId?: string;
+  conversations?: Array<{sessionId: string; createdAt: string; updatedAt: string; entryCount: number}>;
+  [key: string]: unknown;
+}
+
+const errors = captureErrors();
+const engines: HalEngine[] = [];
+const clients: WebSocket[] = [];
+
+async function start(session: SessionStore, enabled?: boolean, hooks?: HalEngineConfig['orchestrator']) {
+  const transport = {resume: {enabled: true}, ...(enabled === undefined ? {} : {history: {enabled}})};
+  const engine = createHalEngine({
+    provider: {type: 'mock'},
+    prompt: {identity: 'Conversation history acceptance'},
+    auth: {ws: async () => ({id: 'owner'})},
+    session,
+    transport,
+    orchestrator: hooks,
+  });
+  engines.push(engine);
+  await engine.start(0);
+  return `ws://127.0.0.1:${(engine.server.address() as AddressInfo).port}/hal/ws`;
+}
+
+async function connect(url: string) {
+  const socket = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'token']);
+  clients.push(socket);
+  const frames: Frame[] = [];
+  socket.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  await once(socket, 'message');
+  return {socket, frames};
+}
+
+async function until(check: () => boolean) {
+  for (let i = 0; i < 100 && !check(); i++) await new Promise(resolve => setTimeout(resolve, 5));
+  expect(check()).toBe(true);
+}
+
+async function request(socket: WebSocket, frames: Frame[], payload: object) {
+  const offset = frames.length;
+  socket.send(JSON.stringify(payload));
+  socket.send(JSON.stringify({type: 'ping', timestamp: 144}));
+  await until(() => frames.slice(offset).some(frame => frame.type === 'pong'));
+  return frames.slice(offset).filter(frame => frame.type !== 'pong');
+}
+
+afterEach(async () => {
+  for (const socket of clients.splice(0)) {
+    if (socket.readyState === WebSocket.CLOSED) continue;
+    const closed = once(socket, 'close');
+    socket.terminate();
+    await closed;
+  }
+  for (const engine of engines.splice(0)) await engine.stop();
+});
+
+// spec: specs/hal-engine-websocket-protocol/spec.md#209
+it('accepts history requests and composite cursors, rejecting invalid fields by name', () => {
+  const before = {updatedAt: '2026-10-01T12:00:00.000Z', sessionId: 'older'};
+  for (const payload of [{type: 'list_conversations'}, {type: 'list_conversations', limit: 200, before}]) {
+    expect(validateMessage(payload)).toEqual({valid: true, data: payload});
+  }
+  for (const [field, value] of [
+    ...[0, 201, 1.5, '10', null].map(value => ['limit', value]),
+    ...[
+      'not a date',
+      {},
+      {updatedAt: before.updatedAt},
+      {sessionId: 'older'},
+      {updatedAt: 'bad', sessionId: 'older'},
+      {updatedAt: before.updatedAt, sessionId: 7},
+    ].map(value => ['before', value]),
+  ]) {
+    expect(validateMessage({type: 'list_conversations', [field as string]: value})).toEqual({
+      valid: false,
+      error: expect.stringContaining(field as string),
+    });
+  }
+});
+
+// spec: specs/hal-engine-conversation-list/spec.md#36
+it('delivers only the authenticated owner metadata, pages tied rows, and resumes a listed conversation', async () => {
+  const calls: Array<[string | number, SessionListOptions | undefined]> = [];
+  class RecordedStore extends InMemorySessionStore {
+    override listFor(userId: string | number, options?: SessionListOptions) {
+      calls.push([userId, options]);
+      return super.listFor(userId, options);
+    }
+  }
+  const store = new RecordedStore();
+  for (const [id, user] of [
+    ['a', 'owner'],
+    ['b', 'owner'],
+    ['c', 'owner'],
+    ['secret', 'stranger'],
+  ]) {
+    store
+      .create(id, user)
+      .entries.push({role: 'user', content: `private-${id}`, timestamp: '2099-01-01T00:00:00.000Z'});
+  }
+  const base = await start(store, true);
+  const {socket, frames} = await connect(`${base}?sessionId=a`);
+  const expected = JSON.parse(JSON.stringify(store.listFor('owner'))) as unknown;
+  calls.length = 0;
+  const response = await request(socket, frames, {type: 'list_conversations', userId: 'stranger'});
+  expect(response).toEqual([{type: 'conversation_list', conversations: expected}]);
+  expect(calls).toEqual([['owner', {limit: undefined, before: undefined}]]);
+  const rows = response[0].conversations!;
+  expect(rows.map(row => row.sessionId)).toEqual(['c', 'b', 'a']);
+  for (const row of rows) {
+    expect(Object.keys(row).sort()).toEqual(['createdAt', 'entryCount', 'sessionId', 'updatedAt']);
+    expect(new Date(row.createdAt).toISOString()).toBe(row.createdAt);
+    expect(new Date(row.updatedAt).toISOString()).toBe(row.updatedAt);
+  }
+  const before = {updatedAt: rows[0].updatedAt, sessionId: rows[0].sessionId};
+  const page = await request(socket, frames, {type: 'list_conversations', limit: 1, before});
+  expect(page).toEqual([{type: 'conversation_list', conversations: [rows[1]]}]);
+  expect(calls.at(-1)).toEqual(['owner', {limit: 1, before}]);
+  const resumed = await connect(`${base}?sessionId=${rows[1].sessionId}`);
+  const replay = await request(resumed.socket, resumed.frames, {type: 'ping', timestamp: 1});
+  expect(resumed.frames[0]).toMatchObject({type: 'connected', resumed: true, sessionId: 'b', entryCount: 1});
+  expect(resumed.frames.filter(frame => frame.type === 'entry_upsert')).toMatchObject([
+    {index: 0, entry: {role: 'user', content: 'private-b'}},
+  ]);
+  expect(replay).toEqual([]);
+});
+
+// spec: specs/hal-engine-websocket-protocol/spec.md#210
+it('refuses history with UNSUPPORTED when disabled or the store has no listFor', async () => {
+  const inner = new InMemorySessionStore();
+  const requiredOnly: SessionStore = {
+    create: (...args) => inner.create(...args),
+    get: id => inner.get(id),
+    delete: id => inner.delete(id),
+    count: () => inner.count(),
+    clear: () => inner.clear(),
+  };
+  const results = [];
+  for (const [store, enabled] of [
+    [inner, undefined],
+    [inner, false],
+    [requiredOnly, true],
+  ] as const) {
+    const {socket, frames} = await connect(await start(store, enabled));
+    results.push(await request(socket, frames, {type: 'list_conversations'}));
+  }
+  expect(results).toEqual(
+    Array.from({length: 3}, () => [{type: 'error', code: 'UNSUPPORTED', message: expect.any(String)}])
+  );
+});
+
+// spec: specs/hal-engine-websocket-protocol/spec.md#211
+it('answers a history request before the pending turn ends and never pushes a list unsolicited', async () => {
+  let release!: () => void;
+  let entered!: () => void;
+  const held = new Promise<void>(resolve => {
+    release = resolve;
+  });
+  const pending = new Promise<void>(resolve => {
+    entered = resolve;
+  });
+  const base = await start(new InMemorySessionStore(), true, {
+    hooks: {
+      beforeModelResponse: async (_session, prompt) => {
+        entered();
+        await held;
+        return prompt;
+      },
+    },
+  });
+  const {socket, frames} = await connect(base);
+  await request(socket, frames, {type: 'ping', timestamp: 1});
+  expect(frames.some(frame => frame.type === 'conversation_list')).toBe(false);
+  socket.send(JSON.stringify({type: 'user_message', content: 'hello'}));
+  await pending;
+  await until(() => frames.some(frame => frame.type === 'entry_upsert'));
+  try {
+    const response = await request(socket, frames, {type: 'list_conversations'});
+    expect(response).toEqual([
+      {
+        type: 'conversation_list',
+        conversations: [
+          expect.objectContaining({
+            sessionId: frames[0].sessionId,
+            entryCount: 1,
+          }),
+        ],
+      },
+    ]);
+    expect(frames.some(frame => frame.type === 'stream_end')).toBe(false);
+  } finally {
+    release();
+  }
+  await until(() => frames.some(frame => frame.type === 'stream_end'));
+  expect(frames.filter(frame => frame.type === 'conversation_list')).toHaveLength(1);
+});
+
+// spec: specs/hal-engine-websocket-protocol/spec.md#212
+it('sanitizes store failures, distinguishes an adapter without find, and keeps the socket usable', async () => {
+  const client = new MongoClient('mongodb://127.0.0.1:1/private-database');
+  await client.close();
+  const collection = client.db('private-database').collection<MongoSessionDocument>('sessions');
+  const withoutFind: CollectionLike<MongoSessionDocument> = {
+    findOne: (...args) => collection.findOne(...args),
+    updateOne: (...args) => collection.updateOne(...args),
+    deleteOne: (...args) => collection.deleteOne(...args),
+    deleteMany: (...args) => collection.deleteMany(...args),
