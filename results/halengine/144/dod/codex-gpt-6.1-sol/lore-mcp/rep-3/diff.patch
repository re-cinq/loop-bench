@@ -0,0 +1,267 @@
+import {MongoClient} from 'mongodb';
+import type {CollectionLike} from '../infrastructure/stores/mongo/mongoDriverTypes.js';
+import type {MongoSessionDocument} from '../infrastructure/stores/mongo/mongoSessionDocument.js';
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {WebSocket, WebSocketServer} from 'ws';
+import {createHalEngine} from '../config.js';
+import type {HalEngineConfig} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {MongoSessionStore} from '../infrastructure/stores/mongo/mongoSessionStore.js';
+import type {SessionListOptions, SessionStore} from '../types/sessionStore.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+import {createMessageHandler} from './ws/messageHandler.js';
+import {captureErrors} from '../shared/logCaptureTestSupport.js';
+
+interface Row {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+interface Frame {
+  type: string;
+  sessionId?: string;
+  resumed?: boolean;
+  conversations?: Row[];
+  code?: string;
+  message?: string;
+  entry?: unknown;
+}
+const clients: WebSocket[] = [];
+const engines: Array<ReturnType<typeof createHalEngine>> = [];
+const errors = captureErrors();
+
+class RecordedStore extends InMemorySessionStore {
+  readonly calls: Array<{userId: string | number; options: SessionListOptions | undefined}> = [];
+  override listFor(userId: string | number, options?: SessionListOptions) {
+    this.calls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+const start = async (store: SessionStore, enabled?: boolean, hooks?: HalEngineConfig['orchestrator']) => {
+  const transport = {resume: {enabled: true}, ...(enabled === undefined ? {} : {history: {enabled}})};
+  const engine = createHalEngine({
+    provider: {type: 'mock'},
+    prompt: {identity: 'Test assistant'},
+    session: store,
+    auth: {ws: async () => ({id: 'owner'})},
+    transport,
+    orchestrator: hooks,
+  });
+  engines.push(engine);
+  await engine.start(0);
+  return {engine, url: `ws://127.0.0.1:${(engine.server.address() as AddressInfo).port}/hal/ws`};
+};
+
+const connect = async (url: string) => {
+  const socket = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'credential']);
+  clients.push(socket);
+  const frames: Frame[] = [];
+  socket.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  await once(socket, 'message');
+  const waitFor = async (type: string, from = 0) => {
+    for (let i = 0; i < 100 && !frames.slice(from).some(frame => frame.type === type); i++)
+      await new Promise(resolve => setTimeout(resolve, 5));
+    return frames.slice(from).find(frame => frame.type === type);
+  };
+  const history = async (message: unknown = {type: 'list_conversations'}) => {
+    const from = frames.length;
+    socket.send(JSON.stringify(message));
+    for (let i = 0; i < 100 && !frames.slice(from).some(f => ['error', 'conversation_list'].includes(f.type)); i++)
+      await new Promise(resolve => setTimeout(resolve, 5));
+    socket.send(JSON.stringify({type: 'ping', timestamp: 1}));
+    await waitFor('pong', from);
+    return frames.slice(from).filter(frame => frame.type !== 'pong');
+  };
+  return {socket, frames, waitFor, history};
+};
+
+afterEach(async () => {
+  for (const socket of clients.splice(0)) socket.terminate();
+  for (const engine of engines.splice(0)) await engine.stop();
+});
+
+// spec: specs/hal-engine-websocket-protocol/spec.md#77
+it('validates history limits and composite cursors independently of deployment options', () => {
+  const before = {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: 'last'};
+  expect(validateMessage({type: 'list_conversations'})).toEqual({valid: true, data: {type: 'list_conversations'}});
+  expect(validateMessage({type: 'list_conversations', limit: 200, before, userId: 'stranger'})).toEqual({
+    valid: true,
+    data: {type: 'list_conversations', limit: 200, before},
+  });
+  for (const limit of [0, 201, 1.5, '10', null])
+    expect(validateMessage({type: 'list_conversations', limit})).toEqual({
+      valid: false,
+      error: expect.stringMatching(/limit/i),
+    });
+  for (const cursor of [
+    'not a date',
+    null,
+    {},
+    {updatedAt: before.updatedAt},
+    {sessionId: 'last'},
+    {...before, updatedAt: 'not a date'},
+    {...before, updatedAt: 123},
+    {...before, sessionId: 1},
+  ])
+    expect(validateMessage({type: 'list_conversations', before: cursor})).toEqual({
+      valid: false,
+      error: expect.stringMatching(/before/i),
+    });
+});
+
+// spec: specs/hal-engine-conversation-list/spec.md#37
+it('lists only the socket owner metadata, pages ties with the wire cursor, and resumes a listed conversation', async () => {
+  const store = new RecordedStore();
+  for (const id of ['a', 'b', 'c', 'private']) {
+    const session = store.create(id, id === 'private' ? 'stranger' : 'owner', {authHeaders: {authorization: 'secret'}});
+    session.entries.push({role: 'user', content: `content-${id}`, timestamp: '2099-01-01T00:00:00.000Z'});
+  }
+  const {url} = await start(store, true);
+  const client = await connect(`${url}?sessionId=c`);
+  expect(client.frames[0]).toMatchObject({type: 'connected', sessionId: 'c', resumed: true});
+  expect(client.frames.some(f => f.type === 'conversation_list')).toBe(false);
+  const expected = JSON.parse(JSON.stringify(store.listFor('owner'))) as Row[];
+  store.calls.length = 0;
+  expect(await client.history({type: 'list_conversations', userId: 'stranger'})).toEqual([
+    {type: 'conversation_list', conversations: expected},
+  ]);
+  expect(store.calls).toEqual([{userId: 'owner', options: {limit: undefined, before: undefined}}]);
+  expect(expected.map(row => row.sessionId)).toEqual(['c', 'b', 'a']);
+  for (const row of expected) {
+    expect(Object.keys(row).sort()).toEqual(['createdAt', 'entryCount', 'sessionId', 'updatedAt']);
+    expect(new Date(row.createdAt).toISOString()).toBe(row.createdAt);
+    expect(new Date(row.updatedAt).toISOString()).toBe(row.updatedAt);
+  }
+  const before = {updatedAt: expected[0].updatedAt, sessionId: expected[0].sessionId};
+  expect(await client.history({type: 'list_conversations', limit: 1, before})).toEqual([
+    {type: 'conversation_list', conversations: [expected[1]]},
+  ]);
+  expect(store.calls.at(-1)).toEqual({userId: 'owner', options: {limit: 1, before}});
+  const resumed = await connect(`${url}?sessionId=${expected[1].sessionId}`);
+  await resumed.waitFor('entry_upsert');
+  expect(resumed.frames).toMatchObject([
+    {type: 'connected', resumed: true, sessionId: 'b'},
+    {type: 'entry_upsert', entry: {content: 'content-b'}},
+  ]);
+  const fresh = await connect(url);
+  const [list] = await fresh.history();
+  expect(list.conversations?.some(row => row.sessionId === fresh.frames[0].sessionId && row.entryCount === 0)).toBe(
+    true
+  );
+});
+
+// spec: specs/hal-engine-websocket-protocol/spec.md#78
+it('answers UNSUPPORTED with no list when history is absent, disabled, or the store cannot list', async () => {
+  const inner = new InMemorySessionStore();
+  const legacy: SessionStore = {
+    create: inner.create.bind(inner),
+    get: inner.get.bind(inner),
+    delete: inner.delete.bind(inner),
+    count: inner.count.bind(inner),
+    clear: inner.clear.bind(inner),
+  };
+  const outcomes: Frame[][] = [];
+  for (const [store, enabled] of [
+    [inner, undefined],
+    [inner, false],
+    [legacy, true],
+  ] as const) {
+    const {url} = await start(store, enabled);
+    const client = await connect(url);
+    outcomes.push(await client.history());
+    expect(client.socket.readyState).toBe(WebSocket.OPEN);
+  }
+  expect(outcomes).toEqual(
+    Array.from({length: 3}, () => [{type: 'error', code: 'UNSUPPORTED', message: expect.any(String)}])
+  );
+});
+
+// spec: specs/hal-engine-websocket-protocol/spec.md#79
+it('answers a history request before the active turn ends without acquiring its lock', async () => {
+  let release = () => undefined as void;
+  const held = new Promise<void>(resolve => {
+    release = resolve;
+  });
+  let entered = () => undefined as void;
+  const running = new Promise<void>(resolve => {
+    entered = resolve;
