+// specs/hal-engine-websocket-protocol/spec.md#list-lock
+it('answers a history request before stream_end while a turn holds the session lock and never pushes a list', async () => {
+  let release!: () => void;
+  const gate = new Promise<void>(resolve => {
+    release = resolve;
+  });
+  releases.push(() => release());
+  let entered!: () => void;
+  const pending = new Promise<void>(resolve => {
+    entered = resolve;
+  });
+  const client = await connect(
+    await start(new InMemorySessionStore(), true, {
+      beforeModelResponse: async (_session, prompt) => {
+        entered();
+        await gate;
+        return prompt;
+      },
+    })
+  );
+  expect(client.frames.map(frame => frame.type)).toEqual(['connected']);
+  client.socket.send(JSON.stringify({type: 'user_message', content: 'hello'}));
+  await pending;
+  const response = (await request(client, {type: 'list_conversations'})).filter(frame => frame.type !== 'entry_upsert');
+  expect(response).toEqual([
+    {type: 'conversation_list', conversations: [expect.objectContaining({sessionId: client.frames[0].sessionId})]},
+  ]);
+  expect(client.frames.some(frame => frame.type === 'stream_end')).toBe(false);
+  const ended = new Promise<void>(resolve =>
+    client.socket.on('message', raw => {
+      if ((JSON.parse(String(raw)) as Frame).type === 'stream_end') resolve();
+    })
+  );
+  release();
+  await ended;
+});