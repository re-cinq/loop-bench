index 0000000..19fb03e
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,253 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import {MongoClient} from 'mongodb';
+import type {MongoSessionDocument} from '../infrastructure/stores/mongo/mongoSessionDocument.js';
+import {createHalEngine} from '../config.js';
+import type {HalEngineConfig, HalEngine} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {MongoSessionStore} from '../infrastructure/stores/mongo/mongoSessionStore.js';
+import type {SessionStore, SessionListOptions} from '../types/sessionStore.js';
+import type {IncomingMessage, OutgoingMessage} from '../types/messages.js';
+import {validateMessage} from './ws/validation.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {captureErrors} from '../shared/logCaptureTestSupport.js';
+
+const engines: HalEngine[] = [];
+const sockets: WebSocket[] = [];
+const releases: Array<() => void> = [];
+interface Row {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+interface Frame {
+  type: string;
+  sessionId?: string;
+  resumed?: boolean;
+  conversations?: Row[];
+  code?: string;
+  message?: string;
+  entry?: {content?: string};
+}
+
+async function start(
+  store: SessionStore,
+  enabled?: boolean,
+  hooks?: NonNullable<HalEngineConfig['orchestrator']>['hooks']
+) {
+  const transport = {resume: {enabled: true}, ...(enabled === undefined ? {} : {history: {enabled}})};
+  const engine = createHalEngine({
+    provider: {type: 'mock'},
+    prompt: {identity: 'Acceptance test'},
+    session: store,
+    auth: {ws: async () => ({id: 'owner'})},
+    transport,
+    orchestrator: {hooks},
+  });
+  engines.push(engine);
+  await engine.start(0);
+  return `ws://127.0.0.1:${(engine.server.address() as AddressInfo).port}/hal/ws`;
+}
+
+async function connect(url: string) {
+  const socket = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'credential']);
+  sockets.push(socket);
+  const frames: Frame[] = [];
+  socket.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  await once(socket, 'message');
+  return {socket, frames};
+}
+
+async function request(client: Awaited<ReturnType<typeof connect>>, frame: unknown) {
+  const offset = client.frames.length;
+  const answer = once(client.socket, 'message');
+  client.socket.send(JSON.stringify(frame));
+  await answer;
+  await new Promise(resolve => setTimeout(resolve, 20));
+  return client.frames.slice(offset);
+}
+
+function fiveMembers(store: InMemorySessionStore): SessionStore {
+  return {
+    create: store.create.bind(store),
+    get: store.get.bind(store),
+    delete: store.delete.bind(store),
+    count: store.count.bind(store),
+    clear: store.clear.bind(store),
+  };
+}
+
+afterEach(async () => {
+  for (const release of releases.splice(0)) release();
+  await new Promise(resolve => setTimeout(resolve, 20));
+  for (const socket of sockets.splice(0)) {
+    if (socket.readyState === WebSocket.CLOSED) continue;
+    const closed = once(socket, 'close');
+    socket.terminate();
+    await closed;
+  }
+  for (const engine of engines.splice(0)) await engine.stop();
+});
+
+const errors = captureErrors();
+
+// specs/hal-engine-websocket-protocol/spec.md#list-request
+it('validates history requests and composite cursors independently of configuration', () => {
+  const compatible: Array<IncomingMessage | OutgoingMessage> = [
+    {type: 'user_message', content: 'hello'},
+    {type: 'ping', timestamp: 1},
+    {type: 'connected', sessionId: 'old', message: 'hello', examplePrompts: []},
+    {type: 'entry_upsert', index: 0, entry: {role: 'user', content: 'hello', timestamp: '2026-10-01T12:00:00.000Z'}},
+    {type: 'entry_delta', index: 0, delta: 'hello'},
+    {type: 'entry_commit', index: 0},
+    {type: 'entry_skip', index: 0},
+    {type: 'error', code: 'SERVER_ERROR', message: 'failed'},
+    {type: 'pong', timestamp: 1},
+    {type: 'stream_end'},
+  ];
+  expect(JSON.parse(JSON.stringify(compatible))).toEqual(compatible);
+  const before = {updatedAt: '2026-10-01T12:00:00.000Z', sessionId: 'row'};
+  expect(validateMessage({type: 'list_conversations'})).toEqual({valid: true, data: {type: 'list_conversations'}});
+  for (const limit of [1, 200]) {
+    expect(validateMessage({type: 'list_conversations', limit, before, userId: 'intruder'})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations', limit, before},
+    });
+  }
+  for (const [field, value] of [
+    ...[0, 201, 1.5, '10', null].map(value => ['limit', value]),
+    ...[
+      'not a date',
+      {},
+      {updatedAt: before.updatedAt},
+      {sessionId: 'row'},
+      {...before, updatedAt: 'bad'},
+      {...before, sessionId: 1},
+    ].map(value => ['before', value]),
+  ]) {
+    expect(validateMessage({type: 'list_conversations', [String(field)]: value})).toEqual({
+      valid: false,
+      error: expect.stringContaining(String(field)),
+    });
+  }
+});
+
+// specs/hal-engine-websocket-protocol/spec.md#list-response
+it('lists only the authenticated user metadata, forwards paging, and opens a listed conversation through resume', async () => {
+  const store = new InMemorySessionStore();
+  for (const id of ['a', 'b', 'c']) {
+    store
+      .create(id, 'owner', {authHeaders: {Authorization: 'secret'}})
+      .entries.push({role: 'user', content: `private ${id}`, timestamp: `2026-10-28T23:00:00.000Z`});
+  }
+  store.create('foreign', 'other');
+  const calls: Array<{userId: string | number; options?: SessionListOptions}> = [];
+  const observed: SessionStore = {
+    ...fiveMembers(store),
+    listFor(userId, options) {
+      calls.push({userId, options});
+      return store.listFor(userId, options);
+    },
+  };
+  const url = await start(observed, true);
+  const client = await connect(`${url}?sessionId=a`);
+  const expected = JSON.parse(JSON.stringify(store.listFor('owner'))) as Row[];
+  expect(await request(client, {type: 'list_conversations', userId: 'other'})).toEqual([
+    {type: 'conversation_list', conversations: expected},
+  ]);
+  expect(expected.map(row => row.sessionId)).toEqual(['c', 'b', 'a']);
+  const before = {updatedAt: expected[0].updatedAt, sessionId: expected[0].sessionId};
+  expect(await request(client, {type: 'list_conversations', limit: 1, before})).toEqual([
+    {type: 'conversation_list', conversations: [expected[1]]},
+  ]);
+  expect(calls).toEqual([
+    {userId: 'owner', options: {limit: undefined, before: undefined}},
+    {userId: 'owner', options: {limit: 1, before}},
+  ]);
+  const resumed = await connect(`${url}?sessionId=${expected[1].sessionId}`);
+  await request(resumed, {type: 'ping', timestamp: 1});
+  expect(resumed.frames[0]).toMatchObject({type: 'connected', resumed: true, sessionId: 'b'});
+  expect(resumed.frames.filter(frame => frame.type === 'entry_upsert')).toEqual([
+    expect.objectContaining({entry: expect.objectContaining({content: 'private b'})}),
+  ]);
+});
+
+// specs/hal-engine-websocket-protocol/spec.md#list-opt-in
+it('refuses history with UNSUPPORTED when disabled or the store cannot list, without sending a list', async () => {
+  const collection = new MongoClient('mongodb://127.0.0.1:27017')
+    .db('history')
+    .collection<MongoSessionDocument>('sessions');
+  const legacy = new MongoSessionStore({
+    collection: {
+      findOne: collection.findOne.bind(collection),
+      updateOne: collection.updateOne.bind(collection),
+      deleteOne: collection.deleteOne.bind(collection),
+      deleteMany: collection.deleteMany.bind(collection),
+      countDocuments: collection.countDocuments.bind(collection),
+    },
+  });
+  const memory = new InMemorySessionStore();
+  for (const [store, enabled] of [
+    [new InMemorySessionStore(), undefined],
+    [new InMemorySessionStore(), false],
+    [fiveMembers(new InMemorySessionStore()), true],
