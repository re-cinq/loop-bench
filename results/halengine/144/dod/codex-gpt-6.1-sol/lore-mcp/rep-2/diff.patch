index 0000000..5ca78fa
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,233 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import {MongoClient} from 'mongodb';
+import type {MongoSessionDocument} from '../infrastructure/stores/mongo/mongoSessionDocument.js';
+import {createHalEngine} from '../config.js';
+import type {HalEngineConfig, HalEngine} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {MongoSessionStore} from '../infrastructure/stores/mongo/mongoSessionStore.js';
+import type {SessionStore, SessionListOptions} from '../types/sessionStore.js';
+import {validateMessage} from './ws/validation.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {setLogger} from '../shared/logger.js';
+
+interface Row {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+interface Frame {
+  type: string;
+  sessionId?: string;
+  resumed?: boolean;
+  conversations?: Row[];
+  code?: string;
+  message?: string;
+  entry?: unknown;
+}
+const engines: HalEngine[] = [];
+const sockets: WebSocket[] = [];
+const errors: Array<Record<string, unknown>> = [];
+beforeEach(() => {
+  errors.length = 0;
+  setLogger({
+    debug: () => {},
+    info: () => {},
+    warn: () => {},
+    error: (category, message, fields) => {
+      errors.push({category, message, ...fields});
+    },
+  });
+});
+afterEach(async () => {
+  const closed = engines.flatMap(engine => [...engine.wss.clients].map(socket => once(socket, 'close')));
+  for (const socket of sockets.splice(0)) socket.terminate();
+  await Promise.all(closed);
+  for (const engine of engines.splice(0)) await engine.stop();
+  setLogger();
+});
+
+async function start(session: SessionStore, enabled?: boolean, hooks?: HalEngineConfig['orchestrator']) {
+  const transport = {resume: {enabled: true}, ...(enabled === undefined ? {} : {history: {enabled}})};
+  const engine = createHalEngine({
+    provider: {type: 'mock'},
+    prompt: {identity: 'Acceptance'},
+    session,
+    auth: {ws: async () => ({id: 'owner'})},
+    transport,
+    orchestrator: hooks,
+  });
+  engines.push(engine);
+  await engine.start(0);
+  return `ws://127.0.0.1:${(engine.server.address() as AddressInfo).port}/hal/ws`;
+}
+async function connect(url: string) {
+  const socket = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'credential']);
+  sockets.push(socket);
+  const frames: Frame[] = [];
+  socket.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  await once(socket, 'message');
+  return {socket, frames};
+}
+async function request(socket: WebSocket, frame: unknown): Promise<Frame> {
+  const response = new Promise<Frame>(resolve => {
+    const onMessage = (raw: Buffer) => {
+      const received = JSON.parse(String(raw)) as Frame;
+      if (!['conversation_list', 'error', 'pong'].includes(received.type)) return;
+      socket.off('message', onMessage);
+      resolve(received);
+    };
+    socket.on('message', onMessage);
+  });
+  socket.send(JSON.stringify(frame));
+  return response;
+}
+function legacyStore(inner: InMemorySessionStore): SessionStore {
+  return {
+    create: (id, user, options) => inner.create(id, user, options),
+    get: id => inner.get(id),
+    delete: id => inner.delete(id),
+    count: () => inner.count(),
+    clear: () => inner.clear(),
+  };
+}
+
+// specs/hal-engine-websocket-protocol/spec.md#214
+it('validates conversation-list requests and composite cursors independently of configuration', () => {
+  const before = {updatedAt: '2099-01-01T00:00:00.000Z', sessionId: 'b'};
+  expect(validateMessage({type: 'list_conversations'})).toEqual({valid: true, data: {type: 'list_conversations'}});
+  for (const limit of [1, 200])
+    expect(validateMessage({type: 'list_conversations', limit, before, userId: 'stranger'})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations', limit, before},
+    });
+  for (const [field, values] of Object.entries({
+    limit: [0, 201, 1.5, '10', null],
+    before: [
+      'not a date',
+      null,
+      {},
+      {updatedAt: before.updatedAt},
+      {sessionId: 'b'},
+      {...before, updatedAt: 'bad'},
+      {...before, sessionId: 1},
+    ],
+  })) {
+    for (const value of values)
+      expect(validateMessage({type: 'list_conversations', [field]: value})).toEqual({
+        valid: false,
+        error: expect.stringContaining(field),
+      });
+  }
+});
+
+// specs/hal-engine-conversation-list/spec.md#37
+it('delivers only the authenticated users metadata, pages ties, and opens a listed conversation during a pending turn', async () => {
+  class RecordedStore extends InMemorySessionStore {
+    calls: Array<[string | number, SessionListOptions | undefined]> = [];
+    override listFor(user: string | number, options?: SessionListOptions) {
+      this.calls.push([user, options]);
+      return super.listFor(user, options);
+    }
+  }
+  const store = new RecordedStore();
+  for (const id of ['a', 'b', 'c', 'stranger'])
+    store
+      .create(id, id === 'stranger' ? 'other' : 'owner')
+      .entries.push({role: 'user', content: `private-${id}`, timestamp: '2099-01-01T00:00:00.000Z'});
+  let release = () => {};
+  let entered = () => {};
+  const held = new Promise<void>(resolve => {
+    release = resolve;
+  });
+  const started = new Promise<void>(resolve => {
+    entered = resolve;
+  });
+  const url = await start(store, true, {
+    hooks: {
+      afterModelResponse: async () => {
+        entered();
+        await held;
+      },
+    },
+  });
+  const {socket, frames} = await connect(`${url}?sessionId=c`);
+  try {
+    expect(frames.map(frame => frame.type)).toEqual(['connected', 'entry_upsert']);
+    socket.send(JSON.stringify({type: 'user_message', content: 'pending-private'}));
+    await started;
+    const list = await request(socket, {type: 'list_conversations', userId: 'other'});
+    const expected = JSON.parse(JSON.stringify(store.listFor('owner'))) as Row[];
+    store.calls.pop();
+    expect(list).toEqual({type: 'conversation_list', conversations: expected});
+    expect(list.conversations?.map(row => row.sessionId)).toEqual(['c', 'b', 'a']);
+    expect(store.calls).toEqual([['owner', {limit: undefined, before: undefined}]]);
+    for (const row of list.conversations ?? []) {
+      expect(Object.keys(row).sort()).toEqual(['createdAt', 'entryCount', 'sessionId', 'updatedAt']);
+      expect(new Date(row.createdAt).toISOString()).toBe(row.createdAt);
+      expect(new Date(row.updatedAt).toISOString()).toBe(row.updatedAt);
+    }
+    const before = {updatedAt: expected[0].updatedAt, sessionId: expected[0].sessionId};
+    const page = await request(socket, {type: 'list_conversations', limit: 1, before});
+    expect(page).toEqual({type: 'conversation_list', conversations: [expected[1]]});
+    expect(store.calls.at(-1)).toEqual(['owner', {limit: 1, before}]);
+    expect(frames.some(frame => frame.type === 'stream_end')).toBe(false);
+    const reopened = await connect(`${url}?sessionId=${page.conversations?.[0].sessionId}`);
+    await request(reopened.socket, {type: 'ping', timestamp: 1});
+    expect(reopened.frames[0]).toMatchObject({type: 'connected', sessionId: 'b', resumed: true});
+    expect(reopened.frames[1]).toMatchObject({type: 'entry_upsert', entry: {content: 'private-b'}});
+    const fresh = await connect(url);
+    const ownList = await request(fresh.socket, {type: 'list_conversations'});
+    expect(ownList.conversations).toContainEqual(
+      expect.objectContaining({sessionId: fresh.frames[0].sessionId, entryCount: 0})
+    );
+  } finally {
+    release();
+  }
+});
+
+// specs/hal-engine-websocket-protocol/spec.md#215
+it('answers disabled history and a store without listing with UNSUPPORTED, never an empty list', async () => {
+  const inner = new InMemorySessionStore();
+  const client = new MongoClient('mongodb://127.0.0.1:1');
+  const collection = client.db('acceptance').collection<MongoSessionDocument>('sessions');
+  const cannotList = new MongoSessionStore({
+    collection: {
+      findOne: collection.findOne.bind(collection),
+      updateOne: collection.updateOne.bind(collection),
+      deleteOne: collection.deleteOne.bind(collection),
+      deleteMany: collection.deleteMany.bind(collection),
+      countDocuments: collection.countDocuments.bind(collection),
+    },
+  });
+  const unsupported = {...legacyStore(inner), listFor: cannotList.listFor.bind(cannotList)};
+  for (const [store, enabled] of [
+    [inner, undefined],
+    [inner, false],
+    [legacyStore(inner), true],
+    [unsupported, true],
+  ] as const) {
+    const {socket, frames} = await connect(await start(store, enabled));
+    const answer = await request(socket, {type: 'list_conversations'});
+    expect(answer).toMatchObject({type: 'error', code: 'UNSUPPORTED'});
+    await request(socket, {type: 'ping', timestamp: 1});
+    expect(frames.map(frame => frame.type)).toEqual(['connected', 'error', 'pong']);
+  }
+});
