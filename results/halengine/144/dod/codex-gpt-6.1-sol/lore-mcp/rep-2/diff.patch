+// specs/hal-engine-websocket-protocol/spec.md#216
+it('contains real store failures in a sanitized SERVER_ERROR and keeps the connection usable', async () => {
+  const detail = 'private-database-detail';
+  const database = new MongoSessionStore({url: detail, dbName: 'acceptance'});
+  const store = {...legacyStore(new InMemorySessionStore()), listFor: database.listFor.bind(database)};
+  const {socket, frames} = await connect(await start(store, true));
+  const answer = await request(socket, {type: 'list_conversations'});
+  expect(answer).toMatchObject({type: 'error', code: 'SERVER_ERROR'});
+  expect(JSON.stringify(answer)).not.toContain(detail);
+  expect(await request(socket, {type: 'ping', timestamp: 1})).toEqual({type: 'pong', timestamp: 1});
+  expect(frames.map(frame => frame.type)).toEqual(['connected', 'error', 'pong']);
+  expect(errors.some(error => error.sessionId === frames[0].sessionId)).toBe(true);
+  expect(JSON.stringify(errors)).not.toContain(detail);
+});