+// Spec: specs/hal-engine-websocket-protocol/spec.md#4 (Conversation list).
+it('answers history before an in-flight turn finishes without entering its session lock', async () => {
+  let entered = (): void => undefined;
+  const started = new Promise<void>(resolve => {
+    entered = resolve;
+  });
+  let release = (): void => undefined;
+  const held = new Promise<void>(resolve => {
+    release = resolve;
+  });
+  const store = new InMemorySessionStore();
+  const url = await start(store, true, {
+    beforeSession: async () => {
+      entered();
+      await held;
+    },
+  });
+  const {socket, frames} = await open(url);
+  socket.send(JSON.stringify({type: 'user_message', content: 'hold this turn'}));
+  await started;
+  try {
+    const answer = await request(socket, frames, {type: 'list_conversations'});
+    expect(answer.filter(frame => frame.type !== 'entry_upsert')).toEqual([
+      {type: 'conversation_list', conversations: JSON.parse(JSON.stringify(store.listFor('owner')))},
+    ]);
+    expect(frames.some(frame => frame.type === 'stream_end')).toBe(false);
+  } finally {
+    socket.terminate();
+    await once(socket, 'close');
+    release();
+  }
+});
