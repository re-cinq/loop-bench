+## 14. Conversation list
+
+The history opt-in makes one authenticated user’s conversation metadata reachable from their client. Retention and erasure remain the deployer’s responsibility (re-cinq/HALEngine#41). Resume must also be enabled for a client to reopen a listed row.
+
+- `list_conversations` is validated independently of configuration: optional `limit` is an integer from 1 through 200 and optional `before` is a composite cursor containing a parseable date string `updatedAt` and a string `sessionId`; invalid fields are refused with an error naming the field. ([validated by: validates history requests and rejects invalid limits and incomplete composite cursors](../../src/transport/conversationList.acceptance.test.ts#L105)).
+- With `transport.history.enabled`, a request receives exactly one `conversation_list`, containing only the authenticated connection user’s metadata (including the current conversation), newest first, with ISO string times and no content, credentials or `stream_end`; the frame’s `userId` is ignored, and `{limit, before}` is passed unchanged to `listFor` with the connection user id. A listed id can be reopened through the existing resume and replay path. ([validated by: lists only the authenticated owner with wire summaries, forwards paging and resumes a listed conversation](../../src/transport/conversationList.acceptance.test.ts#L126)).
+- History is a separate deployer opt-in, off by default: absent or disabled history, a store without `listFor`, and a store raising `StoreCannotList` because its collection adapter has no `find`, answer one `UNSUPPORTED` error rather than an empty list. ([validated by: answers disabled history and a store without listing with UNSUPPORTED rather than an empty history](../../src/transport/conversationList.acceptance.test.ts#L174)).
+- A history request is answered outside the per-session turn lock, before an in-flight turn finishes. ([validated by: answers history before an in-flight turn finishes without entering its session lock](../../src/transport/conversationList.acceptance.test.ts#L206)).
+- A rejected store list answers one sanitised `SERVER_ERROR`, logs the session id without user content or credentials, and leaves the connection usable. ([validated by: contains a real store failure in SERVER_ERROR, logs its session and keeps the socket usable](../../src/transport/conversationList.acceptance.test.ts#L239)).
+
+### 14.1 Request fields
+
+| Field    | Type    | Required | Description                                                       |
+| -------- | ------- | -------- | ----------------------------------------------------------------- |
+| `type`   | string  | Yes      | `list_conversations`                                              |
+| `limit`  | integer | No       | Page size, 1–200                                                  |
+| `before` | object  | No       | `{updatedAt: string, sessionId: string}` cursor from the last row |
+
+### 14.2 Response fields
+
+| Field           | Type   | Description                                                                                           |
+| --------------- | ------ | ----------------------------------------------------------------------------------------------------- |
+| `type`          | string | `conversation_list`                                                                                   |
+| `conversations` | array  | Rows containing `sessionId`, ISO string `createdAt`, ISO string `updatedAt`, and numeric `entryCount` |
diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..8a63011
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,253 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import {MongoClient} from 'mongodb';
+import {createHalEngine} from '../config.js';
+import type {HalEngineConfig, HalEngine} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {MongoSessionStore} from '../infrastructure/stores/mongo/mongoSessionStore.js';
+import type {MongoSessionDocument} from '../infrastructure/stores/mongo/mongoSessionDocument.js';
+import type {SessionStore, SessionListOptions} from '../types/sessionStore.js';
+import {validateMessage} from './ws/validation.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {setLogger} from '../shared/logger.js';
+
+interface Row {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+interface Frame {
+  type: string;
+  code?: string;
+  message?: string;
+  sessionId?: string;
+  resumed?: boolean;
+  entry?: {content?: string};
+  conversations?: Row[];
+}
+
+const engines: HalEngine[] = [];
+const clients: WebSocket[] = [];
+const errors: Array<Record<string, unknown>> = [];
+beforeEach(() => {
+  errors.length = 0;
+  setLogger({
+    debug: () => undefined,
+    info: () => undefined,
+    warn: () => undefined,
+    error: (category, message, fields) => {
+      errors.push({category, message, ...fields});
+    },
+  });
+});
+afterAll(() => setLogger());
+
+afterEach(async () => {
+  for (const client of clients.splice(0)) client.terminate();
+  for (const engine of engines.splice(0)) {
+    while (engine.wss.clients.size > 0) await new Promise(resolve => setTimeout(resolve, 5));
+    await engine.stop();
+  }
+});
+
+async function start(
+  session: SessionStore,
+  enabled?: boolean,
+  hooks?: NonNullable<HalEngineConfig['orchestrator']>['hooks']
+) {
+  // A variable permits the additive option before its public type exists, without suppressing type checking.
+  const transport = {resume: {enabled: true}, ...(enabled === undefined ? {} : {history: {enabled}})};
+  const engine = createHalEngine({
+    provider: {type: 'bedrock', region: 'eu-central-1', modelId: 'unused-by-history', maxTokens: 1},
+    prompt: {identity: 'History acceptance'},
+    auth: {ws: async () => ({id: 'owner'})},
+    session,
+    transport,
+    orchestrator: {hooks},
+  });
+  engines.push(engine);
+  await engine.start(0);
+  return `ws://127.0.0.1:${(engine.server.address() as AddressInfo).port}/hal/ws`;
+}
+
+async function open(url: string) {
+  const socket = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'credential']);
+  clients.push(socket);
+  const frames: Frame[] = [];
+  socket.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  await once(socket, 'message');
+  return {socket, frames};
+}
+
+async function request(socket: WebSocket, frames: Frame[], payload: unknown): Promise<Frame[]> {
+  const offset = frames.length;
+  const answer = once(socket, 'message');
+  socket.send(JSON.stringify(payload));
+  await answer;
+  // Wait for asynchronous list handling too: the first response itself, rather than a pong, is the barrier.
+  await new Promise(resolve => setTimeout(resolve, 20));
+  return frames.slice(offset);
+}
+
+function legacyStore(inner: InMemorySessionStore): SessionStore {
+  return {
+    create: inner.create.bind(inner),
+    get: inner.get.bind(inner),
+    delete: inner.delete.bind(inner),
+    count: inner.count.bind(inner),
+    clear: inner.clear.bind(inner),
+  };
+}
+
+// Spec: specs/hal-engine-websocket-protocol/spec.md#1 (Conversation list).
+it('validates history requests and rejects invalid limits and incomplete composite cursors', () => {
+  for (const payload of [
+    {type: 'list_conversations'},
+    {type: 'list_conversations', limit: 1},
+    {type: 'list_conversations', limit: 200, before: {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: 's'}},
+  ])
+    expect(validateMessage(payload)).toEqual({valid: true, data: payload});
+  for (const [field, value] of [
+    ...[0, 201, 1.5, '10', null].map(value => ['limit', value]),
+    ...['not a date', {}, {updatedAt: '2026-01-01'}, {sessionId: 's'}, {updatedAt: 'bad', sessionId: 's'}].map(
+      value => ['before', value]
+    ),
+  ]) {
+    expect(validateMessage({type: 'list_conversations', [field as string]: value})).toEqual({
+      valid: false,
+      error: expect.stringContaining(field as string),
+    });
+  }
+});
+
+// Spec: specs/hal-engine-websocket-protocol/spec.md#2 (Conversation list).
+it('lists only the authenticated owner with wire summaries, forwards paging and resumes a listed conversation', async () => {
+  const inner = new InMemorySessionStore();
+  for (const [id, user] of [
+    ['older', 'owner'],
+    ['newer', 'owner'],
+    ['private', 'stranger'],
+  ]) {
+    inner.create(id, user, {authHeaders: {authorization: 'secret'}}).entries.push({
+      role: 'user',
+      content: id,
+      timestamp: id === 'older' ? '2026-01-01T00:00:00.000Z' : '2026-01-02T00:00:00.000Z',
+    });
+  }
+  const calls: Array<{userId: string | number; options?: SessionListOptions}> = [];
+  const store: SessionStore = {
+    ...legacyStore(inner),
+    listFor: (userId, options) => {
+      calls.push({userId, options});
+      return inner.listFor(userId, options);
+    },
+  };
+  const url = await start(store, true);
+  const {socket, frames} = await open(url);
+  expect(frames.map(frame => frame.type)).toEqual(['connected']);
+  const expected = JSON.parse(JSON.stringify(inner.listFor('owner'))) as Row[];
+  const answer = await request(socket, frames, {type: 'list_conversations', userId: 'stranger'});
+  expect(answer).toEqual([{type: 'conversation_list', conversations: expected}]);
+  expect(expected).toHaveLength(3);
+  for (const row of answer[0].conversations ?? []) {
+    expect(Object.keys(row).sort()).toEqual(['createdAt', 'entryCount', 'sessionId', 'updatedAt']);
+    expect(new Date(row.createdAt).toISOString()).toBe(row.createdAt);
+    expect(new Date(row.updatedAt).toISOString()).toBe(row.updatedAt);
+  }
+  const before = {updatedAt: expected[0].updatedAt, sessionId: expected[0].sessionId};
+  expect(await request(socket, frames, {type: 'list_conversations', limit: 1, before})).toEqual([
+    {type: 'conversation_list', conversations: expected.slice(1, 2)},
+  ]);
+  expect(calls).toEqual([
+    {userId: 'owner', options: {limit: undefined, before: undefined}},
+    {userId: 'owner', options: {limit: 1, before}},
+  ]);
+  const resumed = await open(`${url}?sessionId=older`);
+  await request(resumed.socket, resumed.frames, {type: 'ping', timestamp: 1});
+  expect(resumed.frames[0]).toMatchObject({sessionId: 'older', resumed: true});
+  expect(resumed.frames.filter(frame => frame.type === 'entry_upsert')).toMatchObject([{entry: {content: 'older'}}]);
+});
+
+// Spec: specs/hal-engine-websocket-protocol/spec.md#3 (Conversation list).
+it('answers disabled history and a store without listing with UNSUPPORTED rather than an empty history', async () => {
+  const client = new MongoClient('mongodb://127.0.0.1:1');
+  const collection = client.db('legacy_adapter').collection<MongoSessionDocument>('sessions');
+  const withoutFind = new MongoSessionStore({
+    collection: {
+      findOne: collection.findOne.bind(collection),
+      updateOne: collection.updateOne.bind(collection),
+      deleteOne: collection.deleteOne.bind(collection),
+      deleteMany: collection.deleteMany.bind(collection),
+      countDocuments: collection.countDocuments.bind(collection),
+    },
+  });
+  await client.close();
+  const cannotList: SessionStore = {
+    ...legacyStore(new InMemorySessionStore()),
+    listFor: withoutFind.listFor.bind(withoutFind),
+  };
+  const outcomes: Frame[][] = [];
+  for (const [store, enabled] of [
+    [new InMemorySessionStore(), undefined],
+    [new InMemorySessionStore(), false],
+    [legacyStore(new InMemorySessionStore()), true],
+    [cannotList, true],
+  ] as const) {
+    const {socket, frames} = await open(await start(store, enabled));
