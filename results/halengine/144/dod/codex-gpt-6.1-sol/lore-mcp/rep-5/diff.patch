diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..11f5ec9
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,278 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import {createHalEngine} from '../config.js';
+import type {HalEngineConfig, HalEngine} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {SessionStore, SessionListOptions} from '../types/sessionStore.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+import {setLogger} from '../shared/logger.js';
+
+interface Row {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+interface Frame {
+  type: string;
+  code?: string;
+  message?: string;
+  sessionId?: string;
+  resumed?: boolean;
+  conversations?: Row[];
+  entry?: {content: string};
+}
+
+const engines: HalEngine[] = [];
+const sockets: WebSocket[] = [];
+const errors: Array<Record<string, unknown>> = [];
+beforeEach(() => {
+  errors.length = 0;
+  setLogger({
+    debug: () => {},
+    info: () => {},
+    warn: () => {},
+    error: (category, message, fields) => {
+      errors.push({category, message, ...fields});
+    },
+  });
+});
+
+afterEach(async () => {
+  for (const socket of sockets.splice(0)) socket.terminate();
+  for (const engine of engines.splice(0)) {
+    for (let attempt = 0; attempt < 100 && engine.wss.clients.size; attempt++) {
+      await new Promise(resolve => setTimeout(resolve, 5));
+    }
+    await engine.stop();
+  }
+  setLogger();
+});
+
+class RecordingStore extends InMemorySessionStore {
+  readonly calls: Array<{userId: string | number; options?: SessionListOptions}> = [];
+  override listFor(userId: string | number, options?: SessionListOptions) {
+    this.calls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+const seeded = () => {
+  const store = new RecordingStore();
+  for (const [id, owner, day] of [
+    ['one', 'owner', '01'],
+    ['two', 'owner', '02'],
+    ['three', 'owner', '03'],
+    ['foreign', 'other', '04'],
+  ]) {
+    store.create(id, owner, {authHeaders: {authorization: 'private credential'}}).entries.push({
+      role: 'user',
+      content: `private ${id}`,
+      timestamp: `2099-01-${day}T00:00:00.000Z`,
+    });
+  }
+  return store;
+};
+
+async function start(
+  store: SessionStore,
+  enabled?: boolean,
+  hooks?: NonNullable<HalEngineConfig['orchestrator']>['hooks']
+) {
+  const transport = {resume: {enabled: true}, ...(enabled === undefined ? {} : {history: {enabled}})};
+  const engine = createHalEngine({
+    provider: {type: 'mock'},
+    prompt: {identity: 'Acceptance test'},
+    session: store,
+    auth: {ws: async () => ({id: 'owner'})},
+    transport,
+    orchestrator: {hooks},
+  });
+  engines.push(engine);
+  await engine.start(0);
+  const {port} = engine.server.address() as AddressInfo;
+  return `ws://127.0.0.1:${port}/hal/ws`;
+}
+
+async function connect(url: string) {
+  const socket = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'token']);
+  sockets.push(socket);
+  const frames: Frame[] = [];
+  socket.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  await once(socket, 'message');
+  return {socket, frames};
+}
+
+async function exchange(socket: WebSocket, frames: Frame[], request: unknown) {
+  const from = frames.length;
+  const barrier = Date.now();
+  const settled = new Promise<void>(resolve => {
+    const read = (raw: WebSocket.RawData) => {
+      const frame = JSON.parse(String(raw)) as {type: string; timestamp?: number};
+      if (frame.type === 'pong' && frame.timestamp === barrier) {
+        socket.off('message', read);
+        resolve();
+      }
+    };
+    socket.on('message', read);
+  });
+  const isHistory =
+    typeof request === 'object' && request !== null && Reflect.get(request, 'type') === 'list_conversations';
+  const answered = isHistory
+    ? new Promise<void>(resolve => {
+        const read = (raw: WebSocket.RawData) => {
+          const {type} = JSON.parse(String(raw)) as Frame;
+          if (type === 'conversation_list' || type === 'error') {
+            socket.off('message', read);
+            resolve();
+          }
+        };
+        socket.on('message', read);
+      })
+    : Promise.resolve();
+  socket.send(JSON.stringify(request));
+  await answered;
+  socket.send(JSON.stringify({type: 'ping', timestamp: barrier}));
+  await settled;
+  return frames.slice(from).filter(frame => frame.type !== 'pong');
+}
+
+// specs/hal-engine-websocket-protocol/spec.md#history-1
+it('validates history limits and composite cursors independently of configuration', () => {
+  expect(validateMessage({type: 'list_conversations'})).toEqual({valid: true, data: {type: 'list_conversations'}});
+  const before = {updatedAt: '2099-01-02T00:00:00.000Z', sessionId: 'two'};
+  for (const limit of [1, 200]) {
+    expect(validateMessage({type: 'list_conversations', limit, before, userId: 'other'})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations', limit, before},
+    });
+  }
+  for (const [field, value] of [
+    ['limit', 0],
+    ['limit', 201],
+    ['limit', 1.5],
+    ['limit', '10'],
+    ['before', 'not a date'],
+    ['before', {updatedAt: 'bad', sessionId: 'two'}],
+    ['before', {updatedAt: before.updatedAt}],
+    ['before', {sessionId: 'two'}],
+  ]) {
+    expect(validateMessage({type: 'list_conversations', [field as string]: value})).toEqual({
+      valid: false,
+      error: expect.stringContaining(field as string),
+    });
+  }
+});
+
+// specs/hal-engine-websocket-protocol/spec.md#history-2
+it('lists only the authenticated owner and pages wire summaries into the existing resume path', async () => {
+  const store = seeded();
+  const base = await start(store, true);
+  const {socket, frames} = await connect(`${base}?sessionId=three`);
+  expect(frames.some(frame => frame.type === 'conversation_list')).toBe(false);
+  const answer = await exchange(socket, frames, {type: 'list_conversations', userId: 'other'});
+  const expected = JSON.parse(JSON.stringify(store.listFor('owner'))) as Row[];
+  store.calls.pop();
+  expect(answer).toEqual([{type: 'conversation_list', conversations: expected}]);
+  expect(expected.map(row => row.sessionId)).toEqual(['three', 'two', 'one']);
+  for (const row of answer[0].conversations ?? []) {
+    expect(Object.keys(row).sort()).toEqual(['createdAt', 'entryCount', 'sessionId', 'updatedAt']);
+    expect(new Date(row.createdAt).toISOString()).toBe(row.createdAt);
+    expect(new Date(row.updatedAt).toISOString()).toBe(row.updatedAt);
+  }
+  const before = {updatedAt: expected[0].updatedAt, sessionId: expected[0].sessionId};
+  expect(await exchange(socket, frames, {type: 'list_conversations', limit: 1, before})).toEqual([
+    {type: 'conversation_list', conversations: [expected[1]]},
+  ]);
+  expect(store.calls).toEqual([
+    {userId: 'owner', options: {limit: undefined, before: undefined}},
+    {userId: 'owner', options: {limit: 1, before}},
+  ]);
+  const resumed = await connect(`${base}?sessionId=${expected[1].sessionId}`);
+  await exchange(resumed.socket, resumed.frames, {type: 'ping', timestamp: 0});
+  expect(resumed.frames[0]).toMatchObject({type: 'connected', resumed: true, sessionId: 'two'});
+  expect(resumed.frames.filter(frame => frame.type === 'entry_upsert').map(frame => frame.entry?.content)).toEqual([
+    'private two',
+  ]);
+});
+
+// specs/hal-engine-websocket-protocol/spec.md#history-3
+it('reports unsupported history for an absent or disabled opt-in and for a legacy store', async () => {
+  const inner = seeded();
+  const legacy: SessionStore = {
+    create: (...args) => inner.create(...args),
+    get: id => inner.get(id),
+    delete: id => inner.delete(id),
+    count: () => inner.count(),
+    clear: () => inner.clear(),
+  };
+  const answers = [];
+  for (const [store, enabled] of [
+    [inner, undefined],
+    [inner, false],
+    [legacy, true],
+  ] as const) {
+    const {socket, frames} = await connect(await start(store, enabled));
+    answers.push(await exchange(socket, frames, {type: 'list_conversations'}));
+  }
+  expect(answers).toEqual(
+    Array.from({length: 3}, () => [{type: 'error', code: 'UNSUPPORTED', message: expect.any(String)}])
+  );
+  expect(inner.calls).toEqual([]);
+});
+
+// specs/hal-engine-websocket-protocol/spec.md#history-4
+it('keeps a history request outside the active turn lock', async () => {
+  let release = () => {};
+  const held = new Promise<void>(resolve => {
+    release = resolve;
+  });
+  let entered = () => {};
+  const active = new Promise<void>(resolve => {
+    entered = resolve;
+  });
+  const base = await start(seeded(), true, {
+    beforeModelResponse: async (_session, prompt) => {
+      entered();
+      await held;
+      return prompt;
+    },
+  });
+  const {socket, frames} = await connect(`${base}?sessionId=three`);
+  socket.send(JSON.stringify({type: 'user_message', content: 'hello'}));
+  await active;
+  try {
+    const answer = await exchange(socket, frames, {type: 'list_conversations'});
+    expect(answer.filter(frame => frame.type !== 'entry_upsert').map(frame => frame.type)).toEqual([
+      'conversation_list',
+    ]);
+    expect(frames.some(frame => frame.type === 'stream_end')).toBe(false);
+  } finally {
+    const finished = new Promise<void>(resolve => {
+      const read = (raw: WebSocket.RawData) => {
+        if ((JSON.parse(String(raw)) as Frame).type === 'stream_end') {
+          socket.off('message', read);
+          resolve();
+        }
+      };
+      socket.on('message', read);
+    });
+    release();
+    await finished;
+  }
+});
+
+// specs/hal-engine-websocket-protocol/spec.md#history-5
+it('answers a real store access failure with a sanitized error and keeps the socket usable', async () => {
+  const capability = Proxy.revocable(seeded(), {});
+  const {socket, frames} = await connect(`${await start(capability.proxy, true)}?sessionId=three`);
+  capability.revoke();
+  const answer = await exchange(socket, frames, {type: 'list_conversations'});
+  expect(answer).toEqual([{type: 'error', code: 'SERVER_ERROR', message: expect.any(String)}]);
+  expect(JSON.stringify(answer)).not.toMatch(/proxy|revoked|private|credential/i);
+  expect(socket.readyState).toBe(WebSocket.OPEN);
+  expect(errors).toEqual(expect.arrayContaining([expect.objectContaining({sessionId: 'three'})]));
+  expect(JSON.stringify(errors)).not.toMatch(/private|credential/);
+});