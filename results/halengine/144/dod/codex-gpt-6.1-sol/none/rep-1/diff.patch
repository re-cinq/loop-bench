new file mode 100644
index 0000000..3104aa2
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,206 @@
+import {MongoSessionStore} from '../infrastructure/stores/mongo/mongoSessionStore.js';
+import {captureErrors} from '../shared/logCaptureTestSupport.js';
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import {createHalEngine} from '../config.js';
+import type {HalEngineConfig} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {SessionListOptions, SessionStore} from '../types/sessionStore.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+
+class RecordedStore extends InMemorySessionStore {
+  readonly calls: Array<[string | number, SessionListOptions | undefined]> = [];
+  override listFor(userId: string | number, options?: SessionListOptions) {
+    this.calls.push([userId, options]);
+    return super.listFor(userId, options);
+  }
+}
+
+type Frame = Record<string, unknown> & {type: string};
+const errors = captureErrors();
+const engines: Array<ReturnType<typeof createHalEngine>> = [];
+const sockets: WebSocket[] = [];
+const releases: Array<() => void> = [];
+
+afterEach(async () => {
+  for (const socket of sockets.splice(0)) {
+    const closed = once(socket, 'close');
+    socket.terminate();
+    await closed;
+  }
+  for (const engine of engines) {
+    while (engine.wss.clients.size > 0) await new Promise(resolve => setTimeout(resolve, 5));
+  }
+  for (const release of releases.splice(0)) release();
+  for (const engine of engines.splice(0)) await engine.stop();
+});
+
+async function start(store: SessionStore, history?: {enabled: boolean}, holdTurn = false) {
+  let enter: () => void = () => undefined;
+  let release: () => void = () => undefined;
+  const entered = new Promise<void>(resolve => {
+    enter = resolve;
+  });
+  const held = new Promise<void>(resolve => {
+    release = resolve;
+  });
+  releases.push(release);
+  const transport = {resume: {enabled: true}, history};
+  const config: HalEngineConfig = {
+    provider: {type: 'openai', apiKey: 'unused', model: 'unused'},
+    prompt: {identity: 'History acceptance'},
+    session: store,
+    auth: {ws: async () => ({id: 'owner'})},
+    transport,
+    orchestrator: {
+      hooks: {
+        beforeModelResponse: async (_session, prompt) => {
+          if (holdTurn) {
+            enter();
+            await held;
+          }
+          return prompt;
+        },
+      },
+    },
+  };
+  const engine = createHalEngine(config);
+  engines.push(engine);
+  await engine.start(0);
+  const {port} = engine.server.address() as AddressInfo;
+  const url = `ws://127.0.0.1:${port}/hal/ws`;
+  return {url, entered};
+}
+
+async function connect(url: string) {
+  const socket = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'credential']);
+  sockets.push(socket);
+  const frames: Frame[] = [];
+  socket.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  await once(socket, 'message');
+  return {socket, frames};
+}
+
+async function ask(socket: WebSocket, frames: Frame[], frame: unknown): Promise<Frame[]> {
+  const offset = frames.length;
+  socket.send(JSON.stringify(frame));
+  for (let attempt = 0; attempt < 100; attempt++) {
+    const answer = frames.slice(offset).filter(row => ['conversation_list', 'error', 'stream_end'].includes(row.type));
+    if (answer.some(row => row.type === 'conversation_list' || row.type === 'error')) return answer;
+    await new Promise(resolve => setTimeout(resolve, 5));
+  }
+  return frames.slice(offset);
+}
+
+// specs/hal-engine-websocket-protocol/spec.md#list-conversations
+it('validates conversation-list limits and complete ISO cursors without accepting a frame user id', () => {
+  const before = {updatedAt: '2026-10-01T00:00:00.000Z', sessionId: 'row'};
+  for (const fields of [{}, {limit: 1}, {limit: 200, before}]) {
+    expect(validateMessage({type: 'list_conversations', ...fields, userId: 'intruder'})).toEqual({
+      valid: true,
+      data: {type: 'list_conversations', ...fields},
+    });
+  }
+  for (const [field, value] of [
+    ['limit', 0],
+    ['limit', 201],
+    ['limit', 1.5],
+    ['limit', '10'],
+    ['limit', null],
+    ['before', 'not a date'],
+    ['before', {updatedAt: before.updatedAt}],
+    ['before', {sessionId: 'row'}],
+    ['before', {...before, updatedAt: 'bad'}],
+  ]) {
+    expect(validateMessage({type: 'list_conversations', [String(field)]: value})).toEqual({
+      valid: false,
+      error: expect.stringContaining(String(field)),
+    });
+  }
+});
+
+// specs/hal-engine-websocket-protocol/spec.md#conversation-list
+it('lists only the socket owner with wire summaries, pages tied rows and resumes a selected conversation during a pending turn', async () => {
+  const store = new RecordedStore();
+  for (const id of ['a', 'b']) {
+    store.create(id, 'owner', {authHeaders: {Authorization: 'secret'}}).entries.push({
+      role: 'user',
+      content: `private ${id}`,
+      timestamp: '2099-01-01T00:00:00.000Z',
+    });
+  }
+  store.create('foreign', 'intruder');
+  const {url, entered} = await start(store, {enabled: true}, true);
+  const {socket, frames} = await connect(url);
+  expect(frames.map(frame => frame.type)).toEqual(['connected']);
+  socket.send(JSON.stringify({type: 'user_message', content: 'pending turn'}));
+  await entered;
+  const answer = await ask(socket, frames, {type: 'list_conversations', userId: 'intruder'});
+  const expected = JSON.parse(JSON.stringify(store.listFor('owner'))) as unknown;
+  store.calls.pop();
+  expect(answer).toEqual([{type: 'conversation_list', conversations: expected}]);
+  expect(store.calls).toEqual([['owner', {limit: undefined, before: undefined}]]);
+  expect(frames.some(frame => frame.type === 'stream_end')).toBe(false);
+  const first = await ask(socket, frames, {type: 'list_conversations', limit: 1});
+  const rows = first[0].conversations as Array<{sessionId: string; updatedAt: string}>;
+  expect(rows.map(row => row.sessionId)).toEqual(['b']);
+  const before = {updatedAt: rows[0].updatedAt, sessionId: rows[0].sessionId};
+  const second = await ask(socket, frames, {type: 'list_conversations', limit: 1, before});
+  expect(store.calls.at(-1)).toEqual(['owner', {limit: 1, before}]);
+  expect((second[0].conversations as Array<{sessionId: string}>).map(row => row.sessionId)).toEqual(['a']);
+  const resumed = await connect(`${url}?sessionId=${rows[0].sessionId}`);
+  await ask(resumed.socket, resumed.frames, {type: 'list_conversations'});
+  expect(resumed.frames[0]).toMatchObject({type: 'connected', resumed: true, sessionId: 'b'});
+  expect(resumed.frames[1]).toMatchObject({type: 'entry_upsert', index: 0, entry: {content: 'private b'}});
+});
+
+// specs/hal-engine-websocket-protocol/spec.md#history-availability
+it('answers disabled history and a legacy store without listFor with UNSUPPORTED and keeps the socket usable', async () => {
+  const inner = new InMemorySessionStore();
+  const legacy: SessionStore = {
+    create: inner.create.bind(inner),
+    get: inner.get.bind(inner),
+    delete: inner.delete.bind(inner),
+    count: inner.count.bind(inner),
+    clear: inner.clear.bind(inner),
+  };
+  for (const [store, history] of [
+    [inner, undefined],
+    [inner, {enabled: false}],
+    [legacy, {enabled: true}],
+  ] as const) {
+    const {url} = await start(store, history);
+    const {socket, frames} = await connect(url);
+    const answer = await ask(socket, frames, {type: 'list_conversations'});
+    expect(answer).toEqual([{type: 'error', code: 'UNSUPPORTED', message: expect.any(String)}]);
+    const pong = once(socket, 'message');
+    socket.send(JSON.stringify({type: 'ping', timestamp: 42}));
+    expect(JSON.parse(String((await pong)[0]))).toEqual({type: 'pong', timestamp: 42});
+  }
+});
+
+// specs/hal-engine-websocket-protocol/spec.md#history-failure
+it('sanitizes a rejected store list into SERVER_ERROR and logs only safe session context', async () => {
+  const inner = new InMemorySessionStore();
+  const unavailable = new MongoSessionStore({url: 'invalid-private-database-url', dbName: 'private-db'});
+  const store: SessionStore = {
+    create: inner.create.bind(inner),
+    get: inner.get.bind(inner),
+    delete: inner.delete.bind(inner),
+    count: inner.count.bind(inner),
+    clear: inner.clear.bind(inner),
+    listFor: unavailable.listFor.bind(unavailable),
+  };
+  const {url} = await start(store, {enabled: true});
+  const {socket, frames} = await connect(url);
+  const answer = await ask(socket, frames, {type: 'list_conversations'});
+  expect(answer).toEqual([{type: 'error', code: 'SERVER_ERROR', message: expect.any(String)}]);
+  expect(JSON.stringify(answer)).not.toMatch(/invalid-private|private-db|Mongo/);
+  expect(errors).toEqual(expect.arrayContaining([expect.objectContaining({sessionId: frames[0].sessionId})]));
+  expect(JSON.stringify(errors)).not.toMatch(/invalid-private|private-db|credential/);
+  const pong = once(socket, 'message');
+  socket.send(JSON.stringify({type: 'ping', timestamp: 43}));
+  expect(JSON.parse(String((await pong)[0]))).toEqual({type: 'pong', timestamp: 43});
+});