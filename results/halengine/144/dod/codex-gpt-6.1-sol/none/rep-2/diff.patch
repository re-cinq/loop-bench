+## Conversation list validation
+
+- The validator accepts `list_conversations` independently of feature configuration, with optional integer `limit` from 1 to 200 and optional `before: {updatedAt, sessionId}`; it rejects malformed limits and incomplete or invalid cursors with an error naming the field ([validated by: validates list requests and both halves of the composite cursor without accepting malformed fields](../../src/transport/conversationList.acceptance.test.ts#L126)).
diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..6dab82f
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,244 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import type {RawData} from 'ws';
+import {createHalEngine} from '../config.js';
+import type {HalEngineConfig, HalEngine} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {SessionListOptions} from '../types/sessionStore.js';
+import {validateMessage} from './ws/validation.js';
+import {setLogger} from '../shared/logger.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+
+interface Row {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+interface Frame {
+  type: string;
+  code?: string;
+  sessionId?: string;
+  resumed?: boolean;
+  conversations?: Row[];
+  entry?: {content: string};
+}
+
+class RecordingStore extends InMemorySessionStore {
+  readonly calls: Array<{userId: string | number; options?: SessionListOptions}> = [];
+  override listFor(userId: string | number, options?: SessionListOptions) {
+    this.calls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+const errors: Array<Record<string, unknown>> = [];
+beforeEach(() => {
+  errors.length = 0;
+  setLogger({
+    debug: () => {},
+    info: () => {},
+    warn: () => {},
+    error: (category, message, fields) => {
+      errors.push({category, message, ...fields});
+    },
+  });
+});
+const engines: HalEngine[] = [];
+const clients: WebSocket[] = [];
+afterEach(async () => {
+  await Promise.all(
+    clients.splice(0).map(async client => {
+      if (client.readyState === WebSocket.CLOSED) return;
+      const closed = once(client, 'close');
+      client.terminate();
+      await closed;
+    })
+  );
+  for (const engine of engines.splice(0)) {
+    await Promise.all(
+      [...engine.wss.clients].map(async client => {
+        const closed = once(client, 'close');
+        client.terminate();
+        await closed;
+      })
+    );
+    await engine.stop();
+  }
+  setLogger();
+});
+
+const start = async (store: InMemorySessionStore, enabled?: boolean, hooks?: HalEngineConfig['orchestrator']) => {
+  const transport = {resume: {enabled: true}, ...(enabled === undefined ? {} : {history: {enabled}})};
+  const engine = createHalEngine({
+    provider: {type: 'mock'},
+    prompt: {identity: 'Answer briefly'},
+    auth: {ws: async () => ({id: 'owner'})},
+    session: store,
+    transport,
+    orchestrator: hooks,
+  });
+  engines.push(engine);
+  await engine.start(0);
+  return `ws://127.0.0.1:${(engine.server.address() as AddressInfo).port}/hal/ws`;
+};
+
+const connect = async (url: string) => {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'credential']);
+  clients.push(client);
+  const frames: Frame[] = [];
+  client.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  await once(client, 'message');
+  return {client, frames};
+};
+
+const request = async (client: WebSocket, payload: object): Promise<Frame[]> => {
+  const frames: Frame[] = [];
+  const collect = (raw: RawData) => frames.push(JSON.parse(String(raw)) as Frame);
+  client.on('message', collect);
+  const answered = new Promise<void>(resolve => {
+    const answer = (raw: RawData) => {
+      const {type} = JSON.parse(String(raw)) as Frame;
+      if (!['conversation_list', 'error', 'pong'].includes(type)) return;
+      client.off('message', answer);
+      resolve();
+    };
+    client.on('message', answer);
+  });
+  const pong = new Promise<void>(resolve => {
+    const barrier = (raw: RawData) => {
+      if ((JSON.parse(String(raw)) as Frame).type !== 'pong') return;
+      client.off('message', barrier);
+      resolve();
+    };
+    client.on('message', barrier);
+  });
+  client.send(JSON.stringify(payload));
+  await answered;
+  client.send(JSON.stringify({type: 'ping', timestamp: 144}));
+  await pong;
+  client.off('message', collect);
+  return frames.filter(frame => frame.type !== 'pong');
+};
+
+// specs/hal-engine-websocket-protocol/spec.md — Conversation list validation
+it('validates list requests and both halves of the composite cursor without accepting malformed fields', () => {
+  const before = {updatedAt: '2026-10-28T12:00:00.000Z', sessionId: 'row'};
+  for (const payload of [{type: 'list_conversations'}, {type: 'list_conversations', limit: 200, before}]) {
+    expect(validateMessage(payload)).toEqual({valid: true, data: payload});
+  }
+  for (const [field, value] of [
+    ['limit', 0],
+    ['limit', 201],
+    ['limit', 1.5],
+    ['limit', '10'],
+    ['before', 'not a date'],
+    ['before', {updatedAt: before.updatedAt}],
+    ['before', {sessionId: 'row'}],
+    ['before', {...before, updatedAt: 'not a date'}],
+    ['before', {...before, sessionId: 42}],
+  ] as const) {
+    expect(validateMessage({type: 'list_conversations', [field]: value})).toEqual({
+      valid: false,
+      error: expect.stringContaining(field),
+    });
+  }
+});
+
+// specs/hal-engine-conversation-list/spec.md — Listing over the socket
+it('lists only the authenticated owner, forwards paging unchanged, and resumes a listed conversation', async () => {
+  const store = new RecordingStore();
+  for (const [id, owner, timestamp] of [
+    ['older', 'owner', '2099-01-01T00:00:00.000Z'],
+    ['newer', 'owner', '2099-01-02T00:00:00.000Z'],
+    ['private', 'stranger', '2099-01-03T00:00:00.000Z'],
+  ]) {
+    store.create(id, owner).entries.push({role: 'user', content: id, timestamp});
+  }
+  const url = await start(store, true);
+  const {client, frames} = await connect(url);
+  expect(frames.map(frame => frame.type)).toEqual(['connected']);
+  const expected = JSON.parse(JSON.stringify(store.listFor('owner'))) as Row[];
+  store.calls.length = 0;
+  const listed = await request(client, {type: 'list_conversations', userId: 'stranger'});
+  expect(listed).toEqual([{type: 'conversation_list', conversations: expected}]);
+  expect(expected).toHaveLength(3);
+  expect(store.calls).toEqual([{userId: 'owner', options: {limit: undefined, before: undefined}}]);
+  for (const row of listed[0].conversations ?? []) {
+    expect(Object.keys(row).sort()).toEqual(['createdAt', 'entryCount', 'sessionId', 'updatedAt']);
+    expect(new Date(row.createdAt).toISOString()).toBe(row.createdAt);
+    expect(new Date(row.updatedAt).toISOString()).toBe(row.updatedAt);
+  }
+  const before = {updatedAt: expected[0].updatedAt, sessionId: expected[0].sessionId};
+  const page = await request(client, {type: 'list_conversations', limit: 1, before});
+  expect(page).toEqual([{type: 'conversation_list', conversations: [expected[1]]}]);
+  expect(store.calls[1]).toEqual({userId: 'owner', options: {limit: 1, before}});
+  const resumed = await connect(`${url}?sessionId=${listed[0].conversations?.[0].sessionId}`);
+  await request(resumed.client, {type: 'ping', timestamp: 1});
+  expect(resumed.frames[0]).toMatchObject({resumed: true, sessionId: 'newer'});
+  expect(resumed.frames.filter(frame => frame.type === 'entry_upsert')).toMatchObject([{entry: {content: 'newer'}}]);
+});
+
+// specs/hal-engine-conversation-list/spec.md — Refusing unavailable history
+it('answers UNSUPPORTED when history is absent, disabled, or the store has no listing capability', async () => {
+  const results: Frame[][] = [];
+  for (const enabled of [undefined, false, true]) {
+    const store = new InMemorySessionStore();
+    if (enabled === true) Object.defineProperty(store, 'listFor', {value: undefined});
+    const {client} = await connect(await start(store, enabled));
+    results.push(await request(client, {type: 'list_conversations'}));
+    expect(client.readyState).toBe(WebSocket.OPEN);
+  }
+  expect(results).toEqual(
+    Array.from({length: 3}, () => [expect.objectContaining({type: 'error', code: 'UNSUPPORTED'})])
+  );
+});
+
+// specs/hal-engine-conversation-list/spec.md — Listing during a turn
+it('answers a history request before stream_end while the same session has a running turn', async () => {
+  let release = () => {};
+  let entered = () => {};
+  const held = new Promise<void>(resolve => {
+    release = resolve;
+  });
+  const running = new Promise<void>(resolve => {
+    entered = resolve;
+  });
+  const {client, frames} = await connect(
+    await start(new InMemorySessionStore(), true, {
+      hooks: {
+        afterModelResponse: async () => {
+          entered();
+          await held;
+        },
+      },
+    })
+  );
+  try {
+    client.send(JSON.stringify({type: 'user_message', content: 'hello'}));
+    await running;
+    const listed = await request(client, {type: 'list_conversations'});
+    expect(listed.filter(frame => ['conversation_list', 'error', 'stream_end'].includes(frame.type))).toEqual([
+      {type: 'conversation_list', conversations: expect.any(Array)},
+    ]);
+    expect(frames.some(frame => frame.type === 'stream_end')).toBe(false);
+  } finally {
+    release();
+  }
+});
+
+// specs/hal-engine-conversation-list/spec.md — Store failures
+it('contains a failed store call as SERVER_ERROR without leaking details or closing the socket', async () => {
+  const store = new InMemorySessionStore();
+  const resource = Proxy.revocable(store.listFor.bind(store), {});
+  Object.defineProperty(store, 'listFor', {value: resource.proxy});
+  const {client, frames} = await connect(await start(store, true));
+  resource.revoke();
+  const response = await request(client, {type: 'list_conversations'});
+  expect(response).toEqual([expect.objectContaining({type: 'error', code: 'SERVER_ERROR'})]);
+  expect(JSON.stringify(response)).not.toMatch(/revoked|proxy|TypeError/i);
+  expect(client.readyState).toBe(WebSocket.OPEN);
+  expect(errors).toEqual(expect.arrayContaining([expect.objectContaining({sessionId: frames[0].sessionId})]));
+  expect(JSON.stringify(errors)).not.toContain('credential');
+});