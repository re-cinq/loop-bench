+// @spec specs/hal-engine-conversation-list/spec.md#41 (WebSocket history store failures)
+it('sanitizes a real disconnected database failure and distinguishes a collection without find', async () => {
+  const logs: unknown[] = [];
+  const record = (category: string, message: string, fields?: Record<string, unknown>) => {
+    logs.push({category, message, ...fields});
+  };
+  setLogger({debug: () => undefined, info: () => undefined, warn: record, error: record});
+  const database = new MongoClient('mongodb://127.0.0.1:1');
+  await database.close();
+  try {
+    for (const absentFind of [false, true]) {
+      const collection = database.db('private_database_detail').collection<MongoSessionDocument>('sessions');
+      if (absentFind) Object.defineProperty(collection, 'find', {value: undefined});
+      const history = new MongoSessionStore({
+        collection: collection as unknown as CollectionLike<MongoSessionDocument>,
+      });
+      const storeFailure = await history.listFor('owner').then(
+        () => undefined,
+        (error: unknown) => error
+      );
+      expect(storeFailure).toBeInstanceOf(Error);
+      const memory = seed();
+      // A real session cache with a real database history reader; the disconnected driver rejects without a network request.
+      const store: SessionStore = {
+        create: memory.create.bind(memory),
+        get: memory.get.bind(memory),
+        delete: memory.delete.bind(memory),
+        count: memory.count.bind(memory),
+        clear: memory.clear.bind(memory),
+        listFor: history.listFor.bind(history),
+      };
+      const url = await start(store, {enabled: true});
+      const {client} = await connect(`${url}?sessionId=a`);
+      logs.length = 0;
+      const response = await request(client, {type: 'list_conversations'});
+      expect(response).toEqual([
+        expect.objectContaining({type: 'error', code: absentFind ? 'UNSUPPORTED' : 'SERVER_ERROR'}),
+      ]);
+      expect(JSON.stringify(response)).not.toMatch(/private_database_detail|MongoNotConnectedError|secret|content of/);
+      expect(JSON.stringify(response)).not.toContain((storeFailure as Error).message);
+      expect(client.readyState).toBe(WebSocket.OPEN);
+      expect(logs).toContainEqual(expect.objectContaining({sessionId: 'a'}));
+      expect(JSON.stringify(logs)).not.toMatch(/secret|content of/);
+      await history.close();
+    }
+  } finally {
+    await database.close();
+    setLogger();
+  }
+});