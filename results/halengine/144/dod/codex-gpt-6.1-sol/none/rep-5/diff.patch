index 0000000..7de9d97
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,279 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import type {RawData} from 'ws';
+import {MongoClient} from 'mongodb';
+import {MongoSessionStore} from '../infrastructure/stores/mongo/mongoSessionStore.js';
+import type {CollectionLike} from '../infrastructure/stores/mongo/mongoDriverTypes.js';
+import type {MongoSessionDocument} from '../infrastructure/stores/mongo/mongoSessionDocument.js';
+import {setLogger} from '../shared/logger.js';
+import type {SessionStore, SessionListOptions} from '../types/sessionStore.js';
+import {createHalEngine} from '../config.js';
+import type {HalEngineConfig, HalEngine} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+
+interface Row {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+interface Frame {
+  type: string;
+  code?: string;
+  sessionId?: string;
+  resumed?: boolean;
+  conversations?: Row[];
+  entry?: {content?: string};
+}
+class RecordedStore extends InMemorySessionStore {
+  readonly calls: Array<{userId: string | number; options?: SessionListOptions}> = [];
+  override listFor(userId: string | number, options?: SessionListOptions) {
+    this.calls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+const engines: HalEngine[] = [];
+const clients: WebSocket[] = [];
+afterEach(async () => {
+  for (const client of clients.splice(0)) client.terminate();
+  for (const engine of engines.splice(0)) {
+    const closed = [...engine.wss.clients].map(socket => once(socket, 'close'));
+    for (const socket of engine.wss.clients) socket.terminate();
+    await Promise.all(closed);
+    await engine.stop();
+  }
+});
+
+async function start(store: SessionStore, history?: {enabled: boolean}, hooks?: HalEngineConfig['orchestrator']) {
+  // Exercise the shipped local provider and real orchestrator, with no provider or transport test double.
+  const transport = {resume: {enabled: true}, history};
+  const engine = createHalEngine({
+    provider: {type: 'mock'},
+    prompt: {identity: 'Answer briefly'},
+    session: store,
+    auth: {ws: async () => ({id: 'owner'})},
+    transport,
+    orchestrator: hooks,
+  });
+  engines.push(engine);
+  await engine.start(0);
+  return `ws://127.0.0.1:${(engine.server.address() as AddressInfo).port}/hal/ws`;
+}
+async function connect(url: string) {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'credential']);
+  clients.push(client);
+  const frames: Frame[] = [];
+  client.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  await once(client, 'message');
+  return {client, frames};
+}
+async function request(client: WebSocket, frame: unknown): Promise<Frame[]> {
+  const frames: Frame[] = [];
+  const collect = (raw: RawData) => frames.push(JSON.parse(String(raw)) as Frame);
+  client.on('message', collect);
+  const answer = once(client, 'message');
+  client.send(JSON.stringify(frame));
+  await answer;
+  // A ping is a barrier for any extra frames the completed request writes.
+  const settled = new Promise<void>(resolve => {
+    const listener = (raw: RawData) => {
+      if ((JSON.parse(String(raw)) as Frame).type === 'pong') {
+        client.off('message', listener);
+        resolve();
+      }
+    };
+    client.on('message', listener);
+  });
+  client.send(JSON.stringify({type: 'ping', timestamp: 1}));
+  await settled;
+  client.off('message', collect);
+  return frames.filter(frame => frame.type !== 'pong');
+}
+function seed() {
+  const store = new RecordedStore();
+  for (const [id, user, timestamp] of [
+    ['a', 'owner', '2099-10-01T00:00:00.000Z'],
+    ['b', 'owner', '2099-10-02T00:00:00.000Z'],
+    ['c', 'owner', '2099-10-02T00:00:00.000Z'],
+    ['private', 'stranger', '2099-10-03T00:00:00.000Z'],
+  ]) {
+    store.create(id, user, {authHeaders: {authorization: 'secret'}}).entries.push({
+      role: 'user',
+      content: `content of ${id}`,
+      timestamp,
+    });
+  }
+  return store;
+}
+
+// @spec specs/hal-engine-conversation-list/spec.md#37 (WebSocket history validation)
+it('validates history limits and complete ISO cursors independently of opt-in', () => {
+  const before = {updatedAt: '2099-10-02T00:00:00.000Z', sessionId: 'c'};
+  const valid = [{type: 'list_conversations'}, {type: 'list_conversations', limit: 200, before}];
+  expect(valid.map(validateMessage)).toEqual(valid.map(data => ({valid: true, data})));
+  for (const [field, values] of Object.entries({
+    limit: [0, 201, 1.5, '10'],
+    before: ['not a date', {updatedAt: before.updatedAt}, {sessionId: 'c'}, {...before, updatedAt: 'bad'}],
+  })) {
+    for (const value of values) {
+      expect(validateMessage({type: 'list_conversations', [field]: value})).toEqual({
+        valid: false,
+        error: expect.stringContaining(field),
+      });
+    }
+  }
+});
+
+// @spec specs/hal-engine-conversation-list/spec.md#38 (WebSocket history delivery)
+it('lists only the authenticated owner, pages ties without loss, and reopens a listed conversation', async () => {
+  const store = seed();
+  const url = await start(store, {enabled: true});
+  const {client, frames} = await connect(`${url}?sessionId=a`);
+  const initial = await request(client, {type: 'ping', timestamp: 2});
+  expect(initial).toEqual([]);
+  expect(frames.some(frame => frame.type === 'conversation_list')).toBe(false);
+  const expected = JSON.parse(JSON.stringify(await store.listFor('owner'))) as Row[];
+  store.calls.length = 0;
+  const all = await request(client, {type: 'list_conversations', userId: 'stranger'});
+  expect(store.calls).toEqual([{userId: 'owner', options: {limit: undefined, before: undefined}}]);
+  expect(all).toEqual([{type: 'conversation_list', conversations: expected}]);
+  expect(expected.map(row => row.sessionId)).toEqual(['c', 'b', 'a']);
+  for (const row of all[0].conversations ?? []) {
+    expect(Object.keys(row).sort()).toEqual(['createdAt', 'entryCount', 'sessionId', 'updatedAt']);
+    expect(new Date(row.createdAt).toISOString()).toBe(row.createdAt);
+    expect(new Date(row.updatedAt).toISOString()).toBe(row.updatedAt);
+  }
+  const page = await request(client, {type: 'list_conversations', limit: 1});
+  expect(page).toEqual([{type: 'conversation_list', conversations: [expected[0]]}]);
+  const next = await request(client, {
+    type: 'list_conversations',
+    limit: 2,
+    before: {updatedAt: expected[0].updatedAt, sessionId: expected[0].sessionId},
+  });
+  expect(store.calls.at(-1)).toEqual({
+    userId: 'owner',
+    options: {limit: 2, before: {updatedAt: expected[0].updatedAt, sessionId: expected[0].sessionId}},
+  });
+  expect(next).toEqual([{type: 'conversation_list', conversations: expected.slice(1)}]);
+  const reopened = await connect(`${url}?sessionId=${all[0].conversations?.[0].sessionId}`);
+  await request(reopened.client, {type: 'ping', timestamp: 3});
+  expect(reopened.frames[0]).toMatchObject({resumed: true, sessionId: 'c'});
+  expect(reopened.frames.find(frame => frame.type === 'entry_upsert')?.entry?.content).toBe('content of c');
+});
+
+// @spec specs/hal-engine-conversation-list/spec.md#39 (WebSocket history capability refusal)
+it('answers disabled history and a store without listFor with UNSUPPORTED rather than an empty history', async () => {
+  const outcomes: Frame[][] = [];
+  for (const history of [undefined, {enabled: false}, {enabled: true}]) {
+    const store = seed();
+    if (history?.enabled) Object.defineProperty(store, 'listFor', {value: undefined});
+    const url = await start(store, history);
+    const {client} = await connect(`${url}?sessionId=a`);
+    outcomes.push(await request(client, {type: 'list_conversations'}));
+    expect(client.readyState).toBe(WebSocket.OPEN);
+  }
+  expect(outcomes).toEqual(
+    Array.from({length: 3}, () => [expect.objectContaining({type: 'error', code: 'UNSUPPORTED'})])
+  );
+});
