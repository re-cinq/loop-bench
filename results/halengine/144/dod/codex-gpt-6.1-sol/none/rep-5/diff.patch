+// @spec specs/hal-engine-conversation-list/spec.md#40 (WebSocket history bypasses the turn lock)
+it('answers history while a real turn is held in its lifecycle hook, before stream_end', async () => {
+  let entered = (): void => undefined;
+  let release = (): void => undefined;
+  const running = new Promise<void>(resolve => {
+    entered = resolve;
+  });
+  const held = new Promise<void>(resolve => {
+    release = resolve;
+  });
+  const url = await start(
+    seed(),
+    {enabled: true},
+    {
+      hooks: {
+        beforeModelResponse: async (_session, prompt) => {
+          entered();
+          await held;
+          return prompt;
+        },
+      },
+    }
+  );
+  const {client, frames} = await connect(`${url}?sessionId=a`);
+  client.send(JSON.stringify({type: 'user_message', content: 'hello'}));
+  await running;
+  try {
+    const response = await request(client, {type: 'list_conversations'});
+    expect(response.filter(frame => ['conversation_list', 'error', 'stream_end'].includes(frame.type))).toEqual([
+      expect.objectContaining({type: 'conversation_list'}),
+    ]);
+    expect(frames.some(frame => frame.type === 'stream_end')).toBe(false);
+  } finally {
+    const completed = new Promise<void>(resolve => {
+      const listener = (raw: RawData) => {
+        if ((JSON.parse(String(raw)) as Frame).type === 'stream_end') {
+          client.off('message', listener);
+          resolve();
+        }
+      };
+      client.on('message', listener);
+    });
+    release();
+    await completed;
+  }
+});
