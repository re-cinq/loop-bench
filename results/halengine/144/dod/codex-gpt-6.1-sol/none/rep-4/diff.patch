+  const collection = mongo.db('acceptance').collection<MongoSessionDocument>('sessions');
+  const originalCollection = {
+    findOne: collection.findOne.bind(collection),
+    updateOne: collection.updateOne.bind(collection),
+    deleteOne: collection.deleteOne.bind(collection),
+    deleteMany: collection.deleteMany.bind(collection),
+    countDocuments: collection.countDocuments.bind(collection),
+  };
+  for (const [source, code] of [
+    [collection, 'SERVER_ERROR'],
+    [originalCollection, 'UNSUPPORTED'],
+  ] as const) {
+    const listing = new MongoSessionStore({collection: source});
+    const store = new InMemorySessionStore();
+    // Real memory sessions, real Mongo listing: failure concerns listing alone, not the upgrade.
+    const client = await connect(
