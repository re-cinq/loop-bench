+        await held;
+        // A real policy hook stops the turn before any external provider request.
+        throw new Error('Turn stopped by acceptance policy');
+      },
+    }
+  );
+  const client = await connect(url);
+  try {
+    client.socket.send(JSON.stringify({type: 'user_message', content: 'private question'}));
+    await waitFor(() => entered);
+    const response = await request(client, list);
+    expect(response.map(frame => frame.type)).toEqual(['conversation_list']);
+    expect(client.frames.some(frame => frame.type === 'stream_end')).toBe(false);
+    release();
+    await waitFor(() => client.frames.some(frame => frame.type === 'stream_end'));
+    expect(client.frames.findIndex(frame => frame.type === 'conversation_list')).toBeLessThan(
+      client.frames.findIndex(frame => frame.type === 'stream_end')
+    );
+  } finally {
+    client.socket.close();
+    await once(client.socket, 'close');
