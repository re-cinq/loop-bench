+// Enrich Jest's Lore descriptors from the acceptance tests' adjacent spec stamps.
+import {readFileSync} from 'node:fs';
+import process from 'node:process';
+
+const descriptors = JSON.parse(readFileSync(0, 'utf8'));
+for (const descriptor of descriptors) {
+  if (!descriptor.file.endsWith('.acceptance.test.ts')) continue;
+  const source = readFileSync(descriptor.file, 'utf8');
+  const stamps = source.matchAll(/\/\/ @spec (specs\/[^\s]+#\d+)\s+it\('([^']+)'/g);
+  for (const [, spec, name] of stamps) {
+    if (descriptor.name === name) descriptor.spec = spec;
+  }
+}
+process.stdout.write(`${JSON.stringify(descriptors)}\n`);
