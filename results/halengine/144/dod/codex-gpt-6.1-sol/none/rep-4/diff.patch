index 0000000..e37c363
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,266 @@
+import express from 'express';
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {MongoClient} from 'mongodb';
+import {WebSocket} from 'ws';
+import {createServer, type HalServerOptions} from './createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+import {validateMessage} from './ws/validation.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {MongoSessionStore} from '../infrastructure/stores/mongo/mongoSessionStore.js';
+import type {MongoSessionDocument} from '../infrastructure/stores/mongo/mongoSessionDocument.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createChatOrchestrator, type OrchestratorHooks} from '../orchestration/chatOrchestrator.js';
+import {createBedrockProvider} from '../providers/bedrock/bedrockProvider.js';
+import type {SessionListOptions, SessionStore} from '../types/sessionStore.js';
+import {captureErrors} from '../shared/logCaptureTestSupport.js';
+
+interface Row {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+interface Frame {
+  type: string;
+  code?: string;
+  message?: string;
+  sessionId?: string;
+  resumed?: boolean;
+  conversations?: Row[];
+  entry?: {content?: string};
+}
+
+const servers: Array<ReturnType<typeof createServer>> = [];
+const sockets: WebSocket[] = [];
+const errors = captureErrors();
+
+afterEach(async () => {
+  for (const socket of sockets.splice(0)) socket.terminate();
+  for (const server of servers.splice(0)) await server.stop();
+});
+
+// Records actual calls and delegates to the shipped store; it never supplies canned results.
+class RecordedStore extends InMemorySessionStore {
+  readonly calls: Array<{userId: string | number; options?: SessionListOptions}> = [];
+  override listFor(userId: string | number, options?: SessionListOptions) {
+    this.calls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+async function start(sessionStore: SessionStore, history?: {enabled: boolean}, hooks?: OrchestratorHooks) {
+  const options: HalServerOptions & {history?: {enabled: boolean}} = {
+    app: express(),
+    wsAuth: async () => ({id: 'owner'}),
+    sessionStore,
+    resume: {enabled: true},
+    history,
+    orchestrator: createChatOrchestrator(
+      createBedrockProvider({type: 'bedrock', region: 'eu-central-1', modelId: 'unused', maxTokens: 10}),
+      new PromptBuilder({identity: 'Acceptance test'}),
+      undefined,
+      {hooks}
+    ),
+  };
+  const server = createServer(options);
+  servers.push(server);
+  await server.start(0);
+  return `ws://127.0.0.1:${(server.server.address() as AddressInfo).port}/hal/ws`;
+}
+
+async function connect(url: string) {
+  const socket = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'acceptance-token']);
+  sockets.push(socket);
+  const frames: Frame[] = [];
+  socket.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  await waitFor(() => frames.some(frame => frame.type === 'connected'));
+  return {socket, frames};
+}
+
+async function waitFor(check: () => boolean) {
+  for (let n = 0; n < 100 && !check(); n++) await new Promise(resolve => setTimeout(resolve, 10));
+  expect(check()).toBe(true);
+}
+
+// A pong after the response drains synchronous trailing frames as well, including an erroneous stream_end.
+async function request(client: Awaited<ReturnType<typeof connect>>, payload: object): Promise<Frame[]> {
+  const offset = client.frames.length;
+  client.socket.send(JSON.stringify(payload));
+  await waitFor(() => client.frames.slice(offset).some(frame => ['conversation_list', 'error'].includes(frame.type)));
+  client.socket.send(JSON.stringify({type: 'ping', timestamp: 1}));
+  await waitFor(() => client.frames.slice(offset).some(frame => frame.type === 'pong'));
+  return client.frames.slice(offset).filter(frame => frame.type !== 'pong');
+}
+
+const list = {type: 'list_conversations'};
+
+// @spec specs/hal-engine-websocket-protocol/spec.md#216
+it('validates list requests and composite cursors independently of feature configuration', () => {
+  expect(validateMessage(list)).toEqual({valid: true, data: list});
+  const before = {updatedAt: '2026-10-01T00:00:00.000Z', sessionId: 'conversation-b'};
+  for (const limit of [1, 200]) {
+    expect(validateMessage({...list, limit, before, userId: 'intruder'})).toEqual({
+      valid: true,
+      data: {...list, limit, before},
+    });
+  }
+  for (const [field, value] of [
+    ...[0, 201, 1.5, '10', null].map(value => ['limit', value]),
+    ...[
+      'not a date',
+      null,
+      {},
+      {updatedAt: before.updatedAt},
+      {sessionId: before.sessionId},
+      {...before, updatedAt: 'not a date'},
+      {...before, sessionId: 7},
+    ].map(value => ['before', value]),
+  ]) {
+    const result = validateMessage({...list, [field as string]: value});
+    expect(result).toEqual({valid: false, error: expect.stringMatching(new RegExp(String(field), 'i'))});
+  }
+});
+
+// @spec specs/hal-engine-websocket-protocol/spec.md#217
+it('delivers only the authenticated user metadata, pages ties and opens a listed conversation through resume', async () => {
+  const store = new RecordedStore();
+  for (const id of ['conversation-a', 'conversation-b']) {
+    store.create(id, 'owner', {authHeaders: {Authorization: 'private-credential'}}).entries.push({
+      role: 'user',
+      content: `private-${id}`,
+      timestamp: '2099-10-01T00:00:00.000Z',
+    });
+  }
+  store.create('foreign', 'intruder');
+  const url = await start(store, {enabled: true});
+  const client = await connect(url);
+  expect(client.frames.map(frame => frame.type)).toEqual(['connected']);
+  const expected = JSON.parse(JSON.stringify(store.listFor('owner'))) as Row[];
+  store.calls.length = 0;
+  expect(await request(client, {...list, userId: 'intruder'})).toEqual([
+    {type: 'conversation_list', conversations: expected},
+  ]);
+  expect(expected.map(row => row.sessionId)).toEqual(['conversation-b', 'conversation-a', client.frames[0].sessionId]);
+  expect(expected).toHaveLength(3); // The connecting conversation is a real row too.
+  for (const row of expected) {
+    expect(Object.keys(row).sort()).toEqual(['createdAt', 'entryCount', 'sessionId', 'updatedAt']);
+    expect(new Date(row.createdAt).toISOString()).toBe(row.createdAt);
