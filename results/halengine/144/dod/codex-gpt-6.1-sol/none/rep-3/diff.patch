+
+## 14. Conversation list
+
+- `list_conversations` is accepted independently of feature configuration, with an optional integer `limit` from 1 through 200 and optional composite `before` cursor containing a parseable date string `updatedAt` and nonempty string `sessionId`; invalid windows name the invalid field, and unrecognized fields including `userId` are discarded ([validated by: validates history windows and rejects invalid limits or incomplete composite cursors](../../src/transport/conversationList.acceptance.test.ts#L78)).
+- Without `transport.history.enabled: true`, or with a store lacking `listFor`, the server answers exactly one `error` with code `UNSUPPORTED`, keeps the socket open and sends no list ([validated by: refuses history unless opted in and supported by the store](../../src/transport/conversationList.acceptance.test.ts#L151)).
+- A requested list is answered while a turn on the same session is pending, before that turn's `stream_end`, independently of the per-session turn lock ([validated by: answers history before a pending turn can send stream_end](../../src/transport/conversationList.acceptance.test.ts#L176)).
+- A store failure is answered with one `SERVER_ERROR` containing no store detail, logged with the session id and no user content or credentials, and leaves the socket open ([validated by: reports a failing store safely and keeps the socket usable](../../src/transport/conversationList.acceptance.test.ts#L211)).
+
+### Client frame fields
+
+| Field              | Type    | Required    | Description                                     |
+| ------------------ | ------- | ----------- | ----------------------------------------------- |
+| `type`             | string  | Yes         | `list_conversations`                            |
+| `limit`            | integer | No          | Page size, 1–200                                |
+| `before`           | object  | No          | `{updatedAt, sessionId}` from the last row seen |
+| `before.updatedAt` | string  | With cursor | Activity time accepted by `Date.parse`          |
+| `before.sessionId` | string  | With cursor | Nonempty session id breaking activity ties      |
+
+### Server frame fields
+
+| Field                        | Type                  | Description                                       |
+| ---------------------------- | --------------------- | ------------------------------------------------- |
+| `type`                       | string                | `conversation_list`                               |
+| `conversations`              | ConversationSummary[] | Requested page of the connection owner's metadata |
+| `conversations[].sessionId`  | string                | Conversation id usable with resume                |
+| `conversations[].createdAt`  | string                | ISO creation time                                 |
+| `conversations[].updatedAt`  | string                | ISO activity time                                 |
+| `conversations[].entryCount` | number                | Stored entry count                                |
+
+**GDPR.** `transport.history` is the deployer's separate opt-in decision to expose one authenticated user's own conversation metadata to the client; the authorization and metadata-only wire contract are specified in [Conversation List](../hal-engine-conversation-list/spec.md#over-the-websocket).
diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..ca99a3c
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,225 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import {createHalEngine} from '../config.js';
+import type {HalEngineConfig, HalEngine} from '../config.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {SessionListOptions, SessionStore} from '../types/sessionStore.js';
+import {validateMessage} from './ws/validation.js';
+import {captureErrors} from '../shared/logCaptureTestSupport.js';
+import {HAL_WS_SUBPROTOCOL} from './ws/subprotocol.js';
+
+interface Frame {
+  type: string;
+  sessionId?: string;
+  conversations?: Array<{sessionId: string; createdAt: string; updatedAt: string; entryCount: number}>;
+  code?: string;
+}
+
+class RecordingStore extends InMemorySessionStore {
+  readonly calls: unknown[] = [];
+  override listFor(userId: string | number, options?: SessionListOptions) {
+    this.calls.push([userId, options]);
+    return super.listFor(userId, options);
+  }
+}
+
+const errors = captureErrors();
+const engines: HalEngine[] = [];
+const sockets: WebSocket[] = [];
+
+afterEach(async () => {
+  for (const socket of sockets.splice(0)) socket.terminate();
+  for (const engine of engines.splice(0)) {
+    while (engine.wss.clients.size > 0) await new Promise(resolve => setTimeout(resolve, 5));
+    await engine.stop();
+  }
+});
+
+async function start(session: SessionStore, history?: {enabled: boolean}, hooks?: HalEngineConfig['orchestrator']) {
+  const transport = {resume: {enabled: true}, history};
+  const engine = createHalEngine({
+    provider: {type: 'mock'},
+    prompt: {identity: 'Answer the user.'},
+    session,
+    transport,
+    auth: {ws: async () => ({id: 'owner'})},
+    orchestrator: hooks,
+  });
+  engines.push(engine);
+  await engine.start(0);
+  return `ws://127.0.0.1:${(engine.server.address() as AddressInfo).port}/hal/ws`;
+}
+
+async function connect(url: string) {
+  const socket = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'credential']);
+  sockets.push(socket);
+  const frames: Frame[] = [];
+  socket.on('message', raw => frames.push(JSON.parse(String(raw)) as Frame));
+  await once(socket, 'message');
+  return {socket, frames};
+}
+
+async function request(socket: WebSocket, frames: Frame[], payload: object) {
+  const from = frames.length;
+  socket.send(JSON.stringify(payload));
+  // A pong is a barrier for immediate replies; bounded polling also accommodates an asynchronous store.
+  socket.send(JSON.stringify({type: 'ping', timestamp: 1}));
+  for (let i = 0; i < 100; i++) {
+    const answer = frames.slice(from);
+    if (answer.some(frame => ['conversation_list', 'error'].includes(frame.type)))
+      return answer.filter(f => ['conversation_list', 'error'].includes(f.type));
+    await new Promise(resolve => setTimeout(resolve, 5));
+  }
+  return frames.slice(from).filter(frame => frame.type !== 'pong');
+}
+
+// specs/hal-engine-websocket-protocol/spec.md#21514
+it('validates history windows and rejects invalid limits or incomplete composite cursors', () => {
+  const before = {updatedAt: '2026-10-01T00:00:00.000Z', sessionId: 'last'};
+  expect(validateMessage({type: 'list_conversations'})).toEqual({valid: true, data: {type: 'list_conversations'}});
+  expect(validateMessage({type: 'list_conversations', limit: 200, before, userId: 'stranger'})).toEqual({
+    valid: true,
+    data: {type: 'list_conversations', limit: 200, before},
+  });
+  for (const limit of [0, 201, 1.5, '10', null]) {
+    expect(validateMessage({type: 'list_conversations', limit})).toEqual({
+      valid: false,
+      error: expect.stringMatching(/limit/i),
+    });
+  }
+  for (const cursor of [
+    '2026-10-01',
+    {},
+    {updatedAt: before.updatedAt},
+    {sessionId: 'last'},
+    {...before, updatedAt: 'bad'},
+    {...before, sessionId: ''},
+  ]) {
+    expect(validateMessage({type: 'list_conversations', before: cursor})).toEqual({
+      valid: false,
+      error: expect.stringMatching(/before/i),
+    });
+  }
+});
+
+// specs/hal-engine-conversation-list/spec.md#37
+it('lists only the authenticated owner, pages wire summaries and resumes a listed conversation', async () => {
+  const store = new RecordingStore();
+  for (const [id, user] of [
+    ['a', 'owner'],
+    ['b', 'owner'],
+    ['private', 'stranger'],
+  ]) {
+    store
+      .create(id, user)
+      .entries.push({role: 'user', content: `content-${id}`, timestamp: '2099-10-01T00:00:00.000Z'});
+  }
+  const base = await start(store, {enabled: true});
+  const {socket, frames} = await connect(base);
+  expect(frames.map(f => f.type)).toEqual(['connected']);
+  const expected = JSON.parse(JSON.stringify(store.listFor('owner')));
+  store.calls.length = 0;
+  const answer = await request(socket, frames, {type: 'list_conversations', userId: 'stranger'});
+  expect(answer).toEqual([{type: 'conversation_list', conversations: expected}]);
+  expect(expected).toHaveLength(3);
+  expect(store.calls).toEqual([['owner', {limit: undefined, before: undefined}]]);
+  for (const row of answer[0].conversations ?? []) {
+    expect(Object.keys(row).sort()).toEqual(['createdAt', 'entryCount', 'sessionId', 'updatedAt']);
+    expect(new Date(row.createdAt).toISOString()).toBe(row.createdAt);
+    expect(new Date(row.updatedAt).toISOString()).toBe(row.updatedAt);
+  }
+  const before = {
+    updatedAt: expected.find((row: {sessionId: string}) => row.sessionId === 'b').updatedAt as string,
+    sessionId: 'b',
+  };
+  expect(await request(socket, frames, {type: 'list_conversations', limit: 1, before})).toEqual([
+    {type: 'conversation_list', conversations: expected.filter((row: {sessionId: string}) => row.sessionId === 'a')},
+  ]);
+  expect(store.calls.at(-1)).toEqual(['owner', {limit: 1, before}]);
+  const reopened = await connect(`${base}?sessionId=b`);
+  reopened.socket.send(JSON.stringify({type: 'ping', timestamp: 2}));
+  while (!reopened.frames.some(f => f.type === 'pong')) await new Promise(resolve => setTimeout(resolve, 5));
+  expect(reopened.frames).toMatchObject([
+    {type: 'connected', sessionId: 'b', resumed: true},
+    {type: 'entry_upsert', entry: {content: 'content-b'}},
+    {type: 'pong'},
+  ]);
+});
+
+// specs/hal-engine-websocket-protocol/spec.md#215
+it('refuses history unless opted in and supported by the store', async () => {
+  const inner = new InMemorySessionStore();
+  const originalStore: SessionStore = {
+    create: (...args) => inner.create(...args),
+    get: id => inner.get(id),
+    delete: id => inner.delete(id),
+    count: () => inner.count(),
+    clear: () => inner.clear(),
+  };
+  const answers = [];
+  for (const [store, history] of [
+    [inner, undefined],
+    [inner, {enabled: false}],
+    [originalStore, {enabled: true}],
+  ] as const) {
+    const {socket, frames} = await connect(await start(store, history));
+    answers.push(await request(socket, frames, {type: 'list_conversations'}));
+    expect(socket.readyState).toBe(WebSocket.OPEN);
+  }
+  expect(answers).toEqual(
+    Array.from({length: 3}, () => [{type: 'error', code: 'UNSUPPORTED', message: expect.any(String)}])
+  );
+});
+
+// specs/hal-engine-websocket-protocol/spec.md#216
+it('answers history before a pending turn can send stream_end', async () => {
+  let entered: () => void = () => undefined;
+  let release: () => void = () => undefined;
+  const pending = new Promise<void>(resolve => {
+    entered = resolve;
+  });
+  const gate = new Promise<void>(resolve => {
+    release = resolve;
+  });
+  const base = await start(
+    new InMemorySessionStore(),
+    {enabled: true},
+    {
+      hooks: {
+        beforeModelResponse: async (_session, prompt) => {
+          entered();
+          await gate;
+          return prompt;
+        },
+      },
+    }
+  );
+  const {socket, frames} = await connect(base);
+  socket.send(JSON.stringify({type: 'user_message', content: 'hello'}));
+  await pending;
+  try {
+    const answer = await request(socket, frames, {type: 'list_conversations'});
+    expect(answer).toMatchObject([{type: 'conversation_list'}]);
+    expect(frames.some(frame => frame.type === 'stream_end')).toBe(false);
+  } finally {
+    release();
+  }
+});
