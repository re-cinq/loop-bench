+// specs/hal-engine-websocket-protocol/spec.md#217
+it('reports a failing store safely and keeps the socket usable', async () => {
+  const store = new InMemorySessionStore();
+  const {proxy, revoke} = Proxy.revocable(store.listFor.bind(store), {});
+  store.listFor = proxy;
+  const base = await start(store, {enabled: true});
+  const {socket, frames} = await connect(base);
+  // A revoked callable throws on invocation without replacing the store with a canned response.
+  revoke();
+  const answer = await request(socket, frames, {type: 'list_conversations'});
+  expect(answer).toEqual([{type: 'error', code: 'SERVER_ERROR', message: expect.any(String)}]);
+  expect(JSON.stringify(answer)).not.toMatch(/proxy|revoked|TypeError/i);
+  expect(socket.readyState).toBe(WebSocket.OPEN);
+  expect(errors).toEqual(expect.arrayContaining([expect.objectContaining({sessionId: frames[0].sessionId})]));
+  expect(JSON.stringify(errors)).not.toMatch(/credential|content-|authorization/i);
+});