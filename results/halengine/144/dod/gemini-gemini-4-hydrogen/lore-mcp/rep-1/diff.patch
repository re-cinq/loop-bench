@@ -0,0 +1,456 @@
+import {once} from 'node:events';
+import type {AddressInfo} from 'node:net';
+import type {WebSocket, WebSocketServer} from 'ws';
+import {createHalEngine} from './config.js';
+import type {HalEngine, HalEngineConfig} from './config.js';
+import type {HalServerOptions} from './transport/createServer.js';
+import {InMemorySessionStore} from './infrastructure/stores/inMemorySessionStore.js';
+import {MongoSessionStore} from './infrastructure/stores/mongo/mongoSessionStore.js';
+import {fakeCollection} from './infrastructure/stores/mongo/mongoTestSupport.js';
+import {createChatOrchestrator} from './orchestration/chatOrchestrator.js';
+import {PromptBuilder} from './infrastructure/builders/promptBuilder.js';
+import {setLogger} from './shared/logger.js';
+import type {AIProvider} from './types/ai.js';
+import type {SessionListOptions, SessionStore} from './types/sessionStore.js';
+import {connectClient, deferred, startEngineWith, stopEngines} from './transport/wsTestSupport.js';
+
+interface WireSummary {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+
+interface WireFrame {
+  type: string;
+  code?: string;
+  message?: string;
+  timestamp?: number;
+  sessionId?: string;
+  resumed?: boolean;
+  entryCount?: number;
+  conversations?: WireSummary[];
+  index?: number;
+  entry?: {role: string; content?: string};
+}
+
+interface RecordedCall {
+  userId: string | number;
+  options: SessionListOptions | undefined;
+}
+
+const engines: HalEngine[] = [];
+const serverSocketCloses: Array<Promise<unknown>> = [];
+
+describe('delivering a user conversation list over WebSocket', () => {
+  afterEach(async () => {
+    await stopAll();
+    setLogger();
+  });
+
+  it("returns the authenticated user's conversations newest first as ISO summaries without stream_end, ignoring any userId on the frame", async () => {
+    const baseMs = Date.now() + 10_000;
+    const inner = seededStore([
+      {id: 'c1', userId: 'u1', at: isoAt(baseMs + 1_000), text: 'first'},
+      {id: 'c2', userId: 'u1', at: isoAt(baseMs + 2_000), text: 'second'},
+      {id: 'c3', userId: 'u1', at: isoAt(baseMs + 3_000), text: 'third'},
+      {id: 'theirs', userId: 'u2', at: isoAt(baseMs + 4_000), text: 'other'},
+    ]);
+    const calls: RecordedCall[] = [];
+    const store = recordingStore(inner, calls);
+    const baseUrl = await startHalEngine(store, {resume: {enabled: true}, history: {enabled: true}});
+    const {client} = await openAndGreet(`${baseUrl}?sessionId=c3`);
+
+    const frames = await sendAndCollectUntilPong(client, [{type: 'list_conversations', userId: 'u2'}], 1);
+    const listFrame = frames.find(frame => frame.type === 'conversation_list');
+    const summaries = listFrame?.conversations ?? [];
+
+    expect({
+      types: frames.map(frame => frame.type),
+      streamEnded: frames.some(frame => frame.type === 'stream_end'),
+      ids: summaries.map(summary => summary.sessionId),
+      shapes: summaries.map(summary => Object.keys(summary).sort()),
+      isoValid: summaries.length === 3 && summaries.every(summaryHasIsoTimes),
+      recordedCall: calls[0]
+        ? {userId: calls[0].userId, limit: calls[0].options?.limit, before: calls[0].options?.before}
+        : undefined,
+    }).toEqual({
+      types: ['conversation_list', 'pong'],
+      streamEnded: false,
+      ids: ['c3', 'c2', 'c1'],
+      shapes: [
+        ['createdAt', 'entryCount', 'sessionId', 'updatedAt'],
+        ['createdAt', 'entryCount', 'sessionId', 'updatedAt'],
+        ['createdAt', 'entryCount', 'sessionId', 'updatedAt'],
+      ],
+      isoValid: true,
+      recordedCall: {userId: 'u1', limit: undefined, before: undefined},
+    });
+  });
+
+  it('pages with limit and a composite before cursor, and lets a client resume any listed sessionId', async () => {
+    const baseMs = Date.now() + 10_000;
+    const tied = isoAt(baseMs + 2_000);
+    const inner = seededStore([
+      {id: 'c1', userId: 'u1', at: isoAt(baseMs + 1_000), text: 'remember 4711'},
+      {id: 'c2', userId: 'u1', at: tied, text: 'second'},
+      {id: 'c3', userId: 'u1', at: tied, text: 'third'},
+    ]);
+    const calls: RecordedCall[] = [];
+    const store = recordingStore(inner, calls);
+    const baseUrl = await startHalEngine(store, {resume: {enabled: true}, history: {enabled: true}});
+    const {client} = await openAndGreet(`${baseUrl}?sessionId=c3`);
+
+    const [page1] = await sendAndCollectUntilPong(client, [{type: 'list_conversations', limit: 2}], 1);
+    const outcome = await continuePagingAndResume(client, baseUrl, page1);
+
+    expect({
+      page1Type: page1.type,
+      page1Ids: page1.conversations?.map(summary => summary.sessionId),
+      page2Ids: outcome.page2Ids,
+      recordedOptions: calls.map(call => call.options),
+      resumedConnected: outcome.resumedConnected,
+      replayedContent: outcome.replayedContent,
+    }).toEqual({
+      page1Type: 'conversation_list',
+      page1Ids: ['c3', 'c2'],
+      page2Ids: ['c1'],
+      recordedOptions: [
+        {limit: 2, before: undefined},
+        {limit: 2, before: {updatedAt: tied, sessionId: 'c2'}},
+      ],
+      resumedConnected: {sessionId: 'c1', resumed: true, entryCount: 1},
+      replayedContent: 'remember 4711',
+    });
+  });
+
+  it('answers list_conversations without waiting on a streaming turn, and rejects malformed limit or before with INVALID_MESSAGE', async () => {
+    const {url, gate} = await startGatedStreamingServer();
+    const {client, frames} = await openAndGreet(url);
+
+    client.send(JSON.stringify({type: 'user_message', content: 'hello'}));
+    await waitForFrame(frames, client, frame => frame.type === 'entry_delta');
+
+    client.send(JSON.stringify({type: 'list_conversations'}));
+    const midStream = await waitForFrame(
+      frames,
+      client,
+      frame => frame.type === 'conversation_list' || frame.type === 'error'
+    );
+    const streamEndedBeforeReply = frames.some(frame => frame.type === 'stream_end');
+
+    gate.release();
+    await waitForFrame(frames, client, frame => frame.type === 'stream_end');
+
+    const malformedPayloads = [
+      {type: 'list_conversations', limit: 0},
+      {type: 'list_conversations', limit: 201},
+      {type: 'list_conversations', limit: 1.5},
+      {type: 'list_conversations', limit: '10'},
+      {type: 'list_conversations', before: {updatedAt: 'not-a-date', sessionId: 'c1'}},
+      {type: 'list_conversations', before: {updatedAt: new Date(Date.now()).toISOString()}},
+    ];
+    const validationFrames = await sendAndCollectUntilPong(client, malformedPayloads, 8);
+    const errorReplies = validationFrames.filter(frame => frame.type === 'error');
+
+    expect({
+      midStreamType: midStream.type,
+      streamEndedBeforeReply,
+      validationTypes: validationFrames.map(frame => frame.type),
+      errorCodes: errorReplies.map(frame => frame.code),
