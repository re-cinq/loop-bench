+async function continuePagingAndResume(
+  client: WebSocket,
+  baseUrl: string,
+  page1: WireFrame
+): Promise<{
+  page2Ids: string[] | undefined;
+  resumedConnected: {sessionId?: string; resumed?: boolean; entryCount?: number} | undefined;
+  replayedContent: string | undefined;
+}> {
+  if (page1.type !== 'conversation_list' || !page1.conversations || page1.conversations.length < 2) {
+    return {page2Ids: undefined, resumedConnected: undefined, replayedContent: undefined};
+  }
+  const cursorRow = page1.conversations[1];
+  const [page2] = await sendAndCollectUntilPong(
+    client,
+    [{type: 'list_conversations', limit: 2, before: {updatedAt: cursorRow.updatedAt, sessionId: cursorRow.sessionId}}],
+    2
+  );
+  const page2Ids = page2.conversations?.map(summary => summary.sessionId);
+  const targetId = page2Ids?.[0];
+  if (!targetId) {
+    return {page2Ids, resumedConnected: undefined, replayedContent: undefined};
+  }
+  const {greeting, frames: resumedFrames} = await openAndGreet(`${baseUrl}?sessionId=${targetId}`);
+  const replayed = resumedFrames.find(frame => frame.type === 'entry_upsert');
+  return {
+    page2Ids,
+    resumedConnected: {
+      sessionId: greeting.sessionId,
+      resumed: greeting.resumed,
+      entryCount: greeting.entryCount,
+    },
+    replayedContent: replayed?.entry?.content,
+  };
+}
+
+async function queryUnsupported(
+  store: SessionStore,
+  history: {enabled: boolean} | undefined
+): Promise<Array<{type: string; code?: string; timestamp?: number}>> {
+  const baseUrl = await startHalEngine(store, history ? {history} : {});
+  const {client} = await openAndGreet(baseUrl);
+  const frames = await sendAndCollectUntilPong(client, [{type: 'list_conversations'}], 9);
+  return frames.map(frame =>
+    frame.type === 'pong' ? {type: frame.type, timestamp: frame.timestamp} : {type: frame.type, code: frame.code}
+  );
+}
+
+async function startGatedStreamingServer(): Promise<{url: string; gate: ReturnType<typeof deferred>}> {
+  const gate = deferred();
+  const provider: AIProvider = {
+    async *sendMessage() {
+      yield {type: 'text', text: 'working...'};
+      await gate.until;
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Gated test.'}));
+  const options = {
+    sessionStore: new InMemorySessionStore(),
+    orchestrator,
+    history: {enabled: true},
+  } as Partial<HalServerOptions> & Pick<HalServerOptions, 'sessionStore'>;
+  const {url, hal} = await startEngineWith(options);
+  trackServerCloses(hal.wss);
+  return {url, gate};
+}
+
+async function startHalEngine(
+  session: SessionStore,
+  extraTransport: {resume?: {enabled: boolean}; history?: {enabled: boolean}}
+): Promise<string> {
+  const transport = {port: 0, ...extraTransport} as HalEngineConfig['transport'];
+  const engine = createHalEngine({
+    provider: {type: 'mock'},
+    prompt: {identity: 'Conversation list acceptance test.'},
+    auth: {ws: async () => ({id: 'u1'})},
+    session,
+    transport,
+  });
+  await engine.start(0);
+  engines.push(engine);
+  trackServerCloses(engine.wss);
+  const {port} = engine.server.address() as AddressInfo;
+  return `ws://127.0.0.1:${port}/hal/ws`;
+}
+
+function trackServerCloses(wss: WebSocketServer): void {
+  wss.on('connection', socket => {
+    serverSocketCloses.push(once(socket, 'close'));
+  });
+}
+
+async function openAndGreet(url: string): Promise<{client: WebSocket; greeting: WireFrame; frames: WireFrame[]}> {
+  const client = connectClient(url);
+  const frames: WireFrame[] = [];
+  client.on('message', raw => {
+    frames.push(JSON.parse(String(raw)) as WireFrame);
+  });
+  const greeting = await waitForFrame(frames, client, frame => frame.type === 'connected');
+  if (greeting.resumed && greeting.entryCount) {
+    const expected = greeting.entryCount;
+    await waitForFrame(
+      frames,
+      client,
+      () => frames.filter(frame => frame.type === 'entry_upsert' || frame.type === 'entry_skip').length >= expected
+    );
+  }
+  return {client, greeting, frames};
+}
+
+async function sendAndCollectUntilPong(
+  client: WebSocket,
+  payloads: Array<Record<string, unknown>>,
+  pongTimestamp: number
+): Promise<WireFrame[]> {
+  const collected: WireFrame[] = [];
+  const settled = new Promise<WireFrame[]>(resolve => {
+    const onMessage = (raw: WebSocket.RawData) => {
+      const parsed = JSON.parse(String(raw)) as WireFrame;
+      collected.push(parsed);
+      if (parsed.type === 'pong' && parsed.timestamp === pongTimestamp) {
+        client.off('message', onMessage);
+        resolve(collected);
+      }
+    };
+    client.on('message', onMessage);
+  });
+  for (const payload of payloads) client.send(JSON.stringify(payload));
+  client.send(JSON.stringify({type: 'ping', timestamp: pongTimestamp}));
+  return settled;
+}
+
+async function waitForFrame(
+  existing: WireFrame[],
+  client: WebSocket,
+  matches: (frame: WireFrame) => boolean
+): Promise<WireFrame> {
+  const already = existing.find(matches);
+  if (already) return already;
+  return new Promise<WireFrame>((resolve, reject) => {
+    const onMessage = (raw: WebSocket.RawData) => {
+      const parsed = JSON.parse(String(raw)) as WireFrame;
+      if (!matches(parsed)) return;
+      clearTimeout(timer);
+      client.off('message', onMessage);
+      resolve(parsed);
+    };
+    const timer = setTimeout(() => {
+      client.off('message', onMessage);
+      reject(new Error('timed out waiting for expected WebSocket frame'));
+    }, 1_500);
+    client.on('message', onMessage);
+  });
+}
+
+function summaryHasIsoTimes(summary: WireSummary): boolean {
+  return isIsoTimestamp(summary.createdAt) && isIsoTimestamp(summary.updatedAt);
+}
+
+function isIsoTimestamp(value: unknown): boolean {
+  if (typeof value !== 'string') return false;
+  const parsed = Date.parse(value);
+  return Number.isFinite(parsed) && new Date(parsed).toISOString() === value;
+}