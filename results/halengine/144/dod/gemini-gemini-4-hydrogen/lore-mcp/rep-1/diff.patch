+async function stopAll(): Promise<void> {
+  await stopEngines();
+  for (const engine of engines.splice(0)) await engine.stop();
+  await Promise.all(serverSocketCloses.splice(0));
+}
+
+function isoAt(ms: number): string {
+  return new Date(ms).toISOString();
+}
+
+function seededStore(
+  conversations: Array<{id: string; userId: string; at: string; text: string}>
+): InMemorySessionStore {
+  const store = new InMemorySessionStore();
+  for (const conv of conversations) {
+    const session = store.create(conv.id, conv.userId);
+    session.entries.push({role: 'user', content: conv.text, timestamp: conv.at});
+  }
+  return store;
+}
+
+function recordingStore(inner: InMemorySessionStore, calls: RecordedCall[]): SessionStore {
+  return {
+    create: (sessionId, userId, options) => inner.create(sessionId, userId, options),
+    get: sessionId => inner.get(sessionId),
+    delete: sessionId => inner.delete(sessionId),
+    count: () => inner.count(),
+    clear: () => inner.clear(),
+    lookup: sessionId => inner.lookup(sessionId),
+    latestFor: userId => inner.latestFor(userId),
+    listFor: (userId, options) => {
+      calls.push({userId, options});
+      return inner.listFor(userId, options);
+    },
+  };
+}
