+  function openSocket(url: string): WebSocket {
+    const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 't']);
+    sockets.push(client);
+    return client;
+  }
+
+  async function launchEngine(options: {session: SessionStore; transport: Record<string, unknown>}) {
+    const engine = createHalEngine({
+      provider: {type: 'mock'},
+      prompt: {identity: 'test'},
+      auth: {ws: async () => ({id: 'u1'})},
+      session: options.session,
+      transport: options.transport,
+    });
+    servers.push(engine);
+    await engine.start();
+    const {port} = engine.server.address() as AddressInfo;
+    return {engine, wsBase: `ws://127.0.0.1:${port}/hal/ws`};
+  }
+
+  async function askListOverEngine(session: SessionStore, transport: Record<string, unknown>) {
+    const {wsBase} = await launchEngine({session, transport});
+    const client = openSocket(wsBase);
+    const connected = await nextFrameMatching(client, frame => frame.type === 'connected');
+    client.send(JSON.stringify({type: 'list_conversations'}));
+    client.send(JSON.stringify({type: 'ping', timestamp: 9}));
+    const frames = await framesUntilType(client, 'pong');
+    const reply = frames.find(frame => frame.type === 'conversation_list' || frame.type === 'error');
+    const pongSeen = frames.some(frame => frame.type === 'pong');
+    return {connected, reply, pongSeen};
+  }
+
+  function connectAndSettle(url: string): Promise<WireFrame[]> {
+    const client = openSocket(url);
+    const collected: WireFrame[] = [];
+    return new Promise<WireFrame[]>(resolve => {
+      const onMessage = (raw: unknown) => {
+        const frame = JSON.parse(String(raw)) as WireFrame;
+        collected.push(frame);
+        if (frame.type === 'connected') client.send(JSON.stringify({type: 'ping', timestamp: 3}));
+        if (frame.type !== 'pong') return;
+        client.off('message', onMessage);
+        resolve(collected);
+      };
+      client.on('message', onMessage);
+    });
+  }
+});
+
+function seededTrackedStore(): {store: SessionStore; recordedCalls: RecordedListCall[]} {
+  const inner = new InMemorySessionStore();
+  seedConversation(inner, 'conv-1', 'u1', 'topic 1', '2099-01-01T00:00:00.000Z');
+  seedConversation(inner, 'conv-2', 'u1', 'topic 2', '2099-01-02T00:00:00.000Z');
+  seedConversation(inner, 'conv-3', 'u1', 'topic 3', '2099-01-03T00:00:00.000Z');
+  seedConversation(inner, 'conv-other', 'u2', 'other secret', '2099-01-04T00:00:00.000Z');
+
+  const recordedCalls: RecordedListCall[] = [];
+  const store: SessionStore = {
+    create: (sessionId, userId, options) => inner.create(sessionId, userId, options),
+    get: sessionId => inner.get(sessionId),
+    delete: sessionId => inner.delete(sessionId),
+    count: () => inner.count(),
+    clear: () => inner.clear(),
+    lookup: sessionId => inner.lookup(sessionId),
+    latestFor: userId => inner.latestFor(userId),
+    listFor: (userId, options) => {
+      recordedCalls.push({userId, options});
+      return inner.listFor(userId, options);
+    },
+  };
+  return {store, recordedCalls};
+}
+
+function seedConversation(
+  store: InMemorySessionStore,
+  sessionId: string,
+  userId: string,
+  content: string,
+  timestamp: string
+): void {
+  const session = store.create(sessionId, userId);
+  session.entries.push({role: 'user', content, timestamp});
+}
+
+function isIsoDate(text: string): boolean {
+  const parsed = new Date(text);
+  return Number.isFinite(parsed.getTime()) && parsed.toISOString() === text;
+}
+
+function nextFrameMatching(client: WebSocket, predicate: (frame: WireFrame) => boolean): Promise<WireFrame> {
+  return new Promise<WireFrame>(resolve => {
+    const onMessage = (raw: unknown) => {
+      const frame = JSON.parse(String(raw)) as WireFrame;
+      if (!predicate(frame)) return;
+      client.off('message', onMessage);
+      resolve(frame);
+    };
+    client.on('message', onMessage);
+  });
+}
+
+function framesUntilType(client: WebSocket, targetType: string): Promise<WireFrame[]> {
+  const collected: WireFrame[] = [];
+  return new Promise<WireFrame[]>(resolve => {
+    const onMessage = (raw: unknown) => {
+      const frame = JSON.parse(String(raw)) as WireFrame;
+      collected.push(frame);
+      if (frame.type !== targetType) return;
+      client.off('message', onMessage);
+      resolve(collected);
+    };
+    client.on('message', onMessage);
+  });
+}
+
+async function eventually(check: () => boolean): Promise<void> {
+  for (let attempt = 0; attempt < 50 && !check(); attempt++) await new Promise(resolve => setTimeout(resolve, 10));
+}