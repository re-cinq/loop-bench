+import type {AddressInfo} from 'node:net';
+import type {Express} from 'express';
+import {WebSocket} from 'ws';
+import {createHalEngine} from './config.js';
+import {createServer} from './transport/createServer.js';
+import type {HalServer} from './transport/createServer.js';
+import {validateMessage} from './transport/ws/validation.js';
+import {HAL_WS_SUBPROTOCOL} from './transport/ws/subprotocol.js';
+import {deferred} from './transport/wsTestSupport.js';
+import {createChatOrchestrator} from './orchestration/chatOrchestrator.js';
+import {PromptBuilder} from './infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './orchestration/tools/registry.js';
+import {InMemorySessionStore} from './infrastructure/stores/inMemorySessionStore.js';
+import {MongoSessionStore} from './infrastructure/stores/mongo/mongoSessionStore.js';
+import {fakeCollection} from './infrastructure/stores/mongo/mongoTestSupport.js';
+import {fiveMemberStore} from './infrastructure/stores/sessionStoreTestSupport.js';
+import {setLogger} from './shared/logger.js';
+import {ErrorCodes} from './types/messages.js';
+import type {AIProvider, MessageChunk} from './types/ai.js';
+import type {SessionEntry} from './types/session.js';
+import type {SessionListOptions, SessionStore} from './types/sessionStore.js';
+
+// Acceptance tests for #144: delivering a user's conversation list over the WebSocket protocol.
+
+interface WireSummary {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+
+interface WireFrame {
+  type: string;
+  sessionId?: string;
+  resumed?: boolean;
+  entryCount?: number;
+  code?: string;
+  message?: string;
+  index?: number;
+  entry?: SessionEntry;
+  conversations?: WireSummary[];
+}
+
+interface RecordedListCall {
+  userId: string | number;
+  options: SessionListOptions | undefined;
+}
+
+const silentLogger = () => {
+  const quiet = () => undefined;
+  setLogger({debug: quiet, info: quiet, warn: quiet, error: quiet});
+};
+
+describe('conversation list over the WebSocket protocol', () => {
+  const servers: HalServer[] = [];
+  const sockets: WebSocket[] = [];
+
+  beforeAll(silentLogger);
+  afterAll(() => setLogger());
+
+  afterEach(async () => {
+    for (const socket of sockets.splice(0)) socket.terminate();
+    for (const hal of servers.splice(0)) {
+      const {wss} = hal;
+      await eventually(() => wss.clients.size === 0);
+      await hal.stop();
+    }
+    silentLogger();
+  });
+
+  it('validates list_conversations with optional integer limit 1-200 and composite before cursor, and refuses bad values by field name', () => {
+    const bare = validateMessage({type: 'list_conversations'});
+    const paged = validateMessage({
+      type: 'list_conversations',
+      limit: 10,
+      before: {updatedAt: '2099-01-02T00:00:00.000Z', sessionId: 'conv-2'},
+      userId: 'u2',
+    });
+    const badLimits = [0, 201, 1.5, '10'].map(limit => validateMessage({type: 'list_conversations', limit}));
+    const badCursors = [
+      'not a date',
+      {updatedAt: 'not a date', sessionId: 'conv-1'},
+      {updatedAt: '2099-01-01T00:00:00.000Z'},
+      {sessionId: 'conv-1'},
+    ].map(before => validateMessage({type: 'list_conversations', before}));
+
+    expect({bare, paged, badLimits, badCursors}).toEqual({
+      bare: {valid: true, data: {type: 'list_conversations'}},
+      paged: {
+        valid: true,
+        data: {
+          type: 'list_conversations',
+          limit: 10,
+          before: {updatedAt: '2099-01-02T00:00:00.000Z', sessionId: 'conv-2'},
+        },
+      },
+      badLimits: badLimits.map(() => ({valid: false, error: expect.stringContaining('limit')})),
+      badCursors: badCursors.map(() => ({valid: false, error: expect.stringContaining('before')})),
+    });
+  });
+
+  it('delivers the connecting user own conversation list newest first with ISO timestamps, ignores frame userId, pages with limit and before, and resumes a listed id', async () => {
+    const {store, recordedCalls} = seededTrackedStore();
+    const transport = {port: 0, resume: {enabled: true}, history: {enabled: true}};
+    const {wsBase} = await launchEngine({session: store, transport});
+    const client = openSocket(wsBase);
+    const connected = await nextFrameMatching(client, frame => frame.type === 'connected');
+    const currentSessionId = connected.sessionId ?? '';
+
+    client.send(JSON.stringify({type: 'list_conversations', userId: 'u2'}));
+    client.send(JSON.stringify({type: 'ping', timestamp: 1}));
+    const firstTurn = await framesUntilType(client, 'pong');
+    const firstList = firstTurn.find(frame => frame.type === 'conversation_list');
+
+    const cursorRow = firstList?.conversations?.[1];
+    const cursor = cursorRow ? {updatedAt: cursorRow.updatedAt, sessionId: cursorRow.sessionId} : undefined;
+    client.send(JSON.stringify({type: 'list_conversations', limit: 2, before: cursor}));
+    client.send(JSON.stringify({type: 'ping', timestamp: 2}));
+    const secondTurn = await framesUntilType(client, 'pong');
+    const secondList = secondTurn.find(frame => frame.type === 'conversation_list');
+
+    const firstRows = firstList?.conversations ?? [];
+    const listedId = firstRows.find(row => row.sessionId === 'conv-1')?.sessionId ?? '';
+    const resumeFrames = await connectAndSettle(`${wsBase}?sessionId=${listedId}`);
+    const resumeConnected = resumeFrames.find(frame => frame.type === 'connected');
+    const firstSummaryKeys = firstRows[0] ? Object.keys(firstRows[0]).sort() : [];
+    const timestampsIso =
+      firstRows.length > 0 && firstRows.every(row => isIsoDate(row.createdAt) && isIsoDate(row.updatedAt));
+
+    expect({
+      firstTypes: firstTurn.map(frame => frame.type),
+      firstIds: firstRows.map(row => row.sessionId),
+      firstSummaryKeys,
+      timestampsIso,
+      recordedCalls,
+      secondIds: (secondList?.conversations ?? []).map(row => row.sessionId),
+      resumeConnected,
+      resumeUpserts: resumeFrames.filter(frame => frame.type === 'entry_upsert'),
+    }).toEqual({
+      firstTypes: ['conversation_list', 'pong'],
+      firstIds: ['conv-3', 'conv-2', 'conv-1', currentSessionId],
+      firstSummaryKeys: ['createdAt', 'entryCount', 'sessionId', 'updatedAt'],
+      timestampsIso: true,
+      recordedCalls: [
+        {userId: 'u1', options: {limit: undefined, before: undefined}},
+        {userId: 'u1', options: {limit: 2, before: {updatedAt: '2099-01-02T00:00:00.000Z', sessionId: 'conv-2'}}},
