+function seedStore(): InMemorySessionStore {
+  const store = new InMemorySessionStore();
+  const c1 = store.create('c1', 'u1');
+  c1.entries.push({role: 'user', content: 'first chat', timestamp: '2099-01-01T08:00:00.000Z'});
+  const c2 = store.create('c2', 'u1');
+  c2.entries.push(
+    {role: 'user', content: 'second chat', timestamp: '2099-01-01T09:00:00.000Z'},
+    {role: 'assistant', content: 'answer two', timestamp: '2099-01-01T09:00:05.000Z', isStreaming: false}
+  );
+  const theirs = store.create('theirs', 'u2');
+  theirs.entries.push({role: 'user', content: 'other user chat', timestamp: '2099-01-01T10:00:00.000Z'});
+  return store;
+}
+
+function delegatingStore(inner: InMemorySessionStore): SessionStore {
+  return {
+    create: (sessionId, userId, options) => inner.create(sessionId, userId, options),
+    get: sessionId => inner.get(sessionId),
+    delete: sessionId => inner.delete(sessionId),
+    count: () => inner.count(),
+    clear: () => inner.clear(),
+  };
+}
+
+async function askUnsupported(store: SessionStore, transportSetup: TransportSetup) {
+  const {base} = await startHalEngine(store, transportSetup);
+  const client = openSocket(base);
+  await nextMatching(client, frame => frame.type === 'connected');
+  const exchange = await requestListAndSettle(client, {type: 'list_conversations'});
+  const errorFrame = exchange.find(frame => frame.type === 'error');
+  return {types: exchange.map(frame => frame.type), code: errorFrame?.code};
+}
+
+async function startHalEngine(store: SessionStore, transportSetup: TransportSetup, hooks?: OrchestratorHooks) {
+  const transport = {port: 0, ...transportSetup};
+  const engine = createHalEngine({
+    provider: {type: 'mock'},
+    prompt: {identity: 'Conversation list acceptance test.'},
+    auth: {ws: async () => ({id: 'u1'})},
+    session: store,
+    orchestrator: hooks ? {hooks} : undefined,
+    transport,
+  });
+  await engine.start(0);
+  engines.push(engine);
+  const {port} = engine.server.address() as AddressInfo;
+  return {engine, base: `ws://127.0.0.1:${port}/hal/ws`};
+}
+
+function openSocket(url: string): WebSocket {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'test-token']);
+  clients.push(client);
+  return client;
+}
+
+async function requestListAndSettle(client: WebSocket, payload: Record<string, unknown>): Promise<WireFrame[]> {
+  const frames: WireFrame[] = [];
+  let pongSent = false;
+  const done = new Promise<void>(resolve => {
+    const onMessage = (raw: Buffer | string): void => {
+      const frame = JSON.parse(String(raw)) as WireFrame;
+      frames.push(frame);
+      if (!pongSent && (frame.type === 'conversation_list' || frame.type === 'error')) {
+        pongSent = true;
+        client.send(JSON.stringify({type: 'ping', timestamp: 1}));
+        return;
+      }
+      if (frame.type === 'pong') {
+        client.off('message', onMessage);
+        resolve();
+      }
+    };
+    client.on('message', onMessage);
+  });
+  client.send(JSON.stringify(payload));
+  await done;
+  return frames;
+}
+
+function nextMatching(client: WebSocket, predicate: (frame: WireFrame) => boolean): Promise<WireFrame> {
+  return new Promise(resolve => {
+    const onMessage = (raw: Buffer | string): void => {
+      const frame = JSON.parse(String(raw)) as WireFrame;
+      if (!predicate(frame)) return;
+      client.off('message', onMessage);
+      resolve(frame);
+    };
+    client.on('message', onMessage);
+  });
+}
+
+function collectUntilPong(client: WebSocket): Promise<WireFrame[]> {
+  const frames: WireFrame[] = [];
+  return new Promise(resolve => {
+    const onMessage = (raw: Buffer | string): void => {
+      const frame = JSON.parse(String(raw)) as WireFrame;
+      frames.push(frame);
+      if (frame.type === 'connected') client.send(JSON.stringify({type: 'ping', timestamp: 1}));
+      if (frame.type === 'pong') {
+        client.off('message', onMessage);
+        resolve(frames);
+      }
+    };
+    client.on('message', onMessage);
+  });
+}
+
+function hasIsoDates(summary: WireSummary): boolean {
+  return isIsoString(summary.createdAt) && isIsoString(summary.updatedAt);
+}
+
+function isIsoString(text: string): boolean {
+  return ISO_TIMESTAMP.test(text) && Number.isFinite(Date.parse(text));
+}
+
+async function eventually(check: () => boolean): Promise<void> {
+  for (let attempt = 0; attempt < 50 && !check(); attempt++) await new Promise(resolve => setTimeout(resolve, 10));
+}