+async function seededRecordingStore() {
+  const inner = new InMemorySessionStore();
+  inner.create('c1', 'u1');
+  await nextMillisecond();
+  const second = inner.create('c2', 'u1');
+  second.entries.push({role: 'user', content: 'remembered from c2', timestamp: '2026-09-30T09:00:00.000Z'});
+  await nextMillisecond();
+  inner.create('c3', 'u1');
+  await nextMillisecond();
+  inner.create('other', 'u2');
+
+  const recordedCalls: Array<{userId: string | number; options: SessionListOptions | undefined}> = [];
+  const store: SessionStore = {
+    ...fiveMemberStore(inner),
+    lookup: sessionId => inner.lookup(sessionId),
+    evict: sessionId => inner.evict(sessionId),
+    latestFor: userId => inner.latestFor(userId),
+    listFor: (userId, options) => {
+      recordedCalls.push({userId, options});
+      return inner.listFor(userId, options);
+    },
+  };
+  return {store, recordedCalls};
+}
+
+function fiveMemberStore(inner: InMemorySessionStore): SessionStore {
+  return {
+    create: (sessionId, userId, options) => inner.create(sessionId, userId, options),
+    get: sessionId => inner.get(sessionId),
+    delete: sessionId => inner.delete(sessionId),
+    count: () => inner.count(),
+    clear: () => inner.clear(),
+  };
+}
+
+async function nextMillisecond(): Promise<void> {
+  const startedAt = Date.now();
+  while (Date.now() <= startedAt) await new Promise(resolve => setTimeout(resolve, 1));
+}
+
+async function startEngineWith(
+  session: SessionStore,
+  tuning: TransportTuning,
+  hooks?: OrchestratorHooks
+): Promise<string> {
+  const transport = {port: 0, ...tuning};
+  const engine = createHalEngine({
+    provider: {type: 'mock', responses: ['hello']},
+    prompt: {identity: 'Conversation list acceptance test.'},
+    auth: {ws: (async () => ({id: 'u1'})) as unknown as WsAuthenticator},
+    session,
+    orchestrator: hooks ? {hooks} : undefined,
+    transport,
+  });
+  await engine.start(0);
+  engines.push(engine);
+  const {port} = engine.server.address() as AddressInfo;
+  return `ws://127.0.0.1:${port}/hal/ws`;
+}
+
+async function connectAndSettle(url: string): Promise<{client: WebSocket; frames: WireFrame[]}> {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'token-1']);
+  sockets.push(client);
+  const frames: WireFrame[] = [];
+  await new Promise<void>(resolve => {
+    const onMessage = (raw: Buffer | string) => {
+      const frame = JSON.parse(String(raw)) as WireFrame;
+      frames.push(frame);
+      if (frame.type === 'connected') client.send(JSON.stringify({type: 'ping', timestamp: 1}));
+      if (frame.type === 'pong') {
+        client.off('message', onMessage);
+        resolve();
+      }
+    };
+    client.on('message', onMessage);
+  });
+  return {client, frames};
+}
+
+async function openStreamReader(url: string) {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'token-1']);
+  sockets.push(client);
+  const seen: WireFrame[] = [];
+  const waiters: Array<{match: (frame: WireFrame) => boolean; resolve: () => void}> = [];
+
+  client.on('message', raw => {
+    const frame = JSON.parse(String(raw)) as WireFrame;
+    seen.push(frame);
+    notifyWaiters(waiters, frame);
+  });
+
+  await once(client, 'open');
+  return {
+    client,
+    frames: {
+      seen: () => [...seen],
+      nextMatching: (match: (frame: WireFrame) => boolean) => {
+        if (seen.some(match)) return Promise.resolve();
+        return new Promise<void>(resolve => waiters.push({match, resolve}));
+      },
+    },
+  };
+}
+
+function notifyWaiters(
+  waiters: Array<{match: (frame: WireFrame) => boolean; resolve: () => void}>,
+  frame: WireFrame
+): void {
+  for (let index = waiters.length - 1; index >= 0; index--) {
+    if (!waiters[index].match(frame)) continue;
+    const [matched] = waiters.splice(index, 1);
+    matched.resolve();
+  }
+}
+
+async function sendListAndSettle(client: WebSocket, payload: Record<string, unknown>): Promise<WireFrame[]> {
+  const received: WireFrame[] = [];
+  await new Promise<void>(resolve => {
+    let pingSent = false;
+    const onMessage = (raw: Buffer | string) => {
+      const frame = JSON.parse(String(raw)) as WireFrame;
+      received.push(frame);
+      if (!pingSent && (frame.type === 'conversation_list' || frame.type === 'error')) {
+        pingSent = true;
+        client.send(JSON.stringify({type: 'ping', timestamp: 1}));
+      }
+      if (frame.type === 'pong') {
+        client.off('message', onMessage);
+        resolve();
+      }
+    };
+    client.on('message', onMessage);
+    client.send(JSON.stringify(payload));
+  });
+  return received;
+}
+
+function listRows(frames: WireFrame[]): WireSummary[] {
+  return frames.find(frame => frame.type === 'conversation_list')?.conversations ?? [];
+}
+
+async function sendListOver(store: SessionStore, tuning: TransportTuning) {
+  const url = await startEngineWith(store, tuning);
+  const {client} = await connectAndSettle(url);
+  const frames = await sendListAndSettle(client, {type: 'list_conversations'});
+  return {
+    code: frames.find(frame => frame.type === 'error')?.code,
+    listFrames: frames.filter(frame => frame.type === 'conversation_list').length,
+    socketStayedOpen: frames.some(frame => frame.type === 'pong'),
+  };
+}
+
+async function waitForFrame(client: WebSocket, match: (frame: WireFrame) => boolean): Promise<void> {
+  await new Promise<void>(resolve => {
+    const onMessage = (raw: Buffer | string) => {
+      const frame = JSON.parse(String(raw)) as WireFrame;
+      if (match(frame)) {
+        client.off('message', onMessage);
+        resolve();
+      }
+    };
+    client.on('message', onMessage);
+  });
+}
+
+function deferredGate() {
+  let release = (): void => undefined;
+  const until = new Promise<void>(resolve => {
+    release = resolve;
+  });
+  return {until, release: () => release()};
+}
+
+async function eventually(check: () => boolean): Promise<void> {
+  for (let attempt = 0; attempt < 50 && !check(); attempt++) await new Promise(resolve => setTimeout(resolve, 10));
+}