+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import {createHalEngine} from './config.js';
+import {createApp} from './transport/createApp.js';
+import {createServer} from './transport/createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './transport/ws/subprotocol.js';
+import {validateMessage} from './transport/ws/validation.js';
+import {createChatOrchestrator} from './orchestration/chatOrchestrator.js';
+import {PromptBuilder} from './infrastructure/builders/promptBuilder.js';
+import {InMemorySessionStore} from './infrastructure/stores/inMemorySessionStore.js';
+import {MongoSessionStore} from './infrastructure/stores/mongo/mongoSessionStore.js';
+import {fiveMemberStore} from './infrastructure/stores/sessionStoreTestSupport.js';
+import {fakeCollection} from './infrastructure/stores/mongo/mongoTestSupport.js';
+import {deferred} from './transport/wsTestSupport.js';
+import {setLogger} from './shared/logger.js';
+import type {AIProvider, MessageChunk} from './types/ai.js';
+import type {SessionListOptions, SessionStore} from './types/sessionStore.js';
+
+interface WireSummary {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+
+interface WireFrame {
+  type: string;
+  sessionId?: string;
+  resumed?: boolean;
+  entryCount?: number;
+  code?: string;
+  message?: string;
+  timestamp?: number;
+  conversations?: WireSummary[];
+  entry?: {role?: string; content?: string};
+}
+
+interface BufferedSocket {
+  socket: WebSocket;
+  frames: WireFrame[];
+}
+
+interface TrackedServer {
+  stop: () => Promise<void>;
+  wss: {clients: Set<unknown>};
+}
+
+interface RecordedError {
+  category: string;
+  message: string;
+  fields?: Record<string, unknown>;
+}
+
+const trackedServers: TrackedServer[] = [];
+const trackedClients: WebSocket[] = [];
+const errorLogs: RecordedError[] = [];
+
+beforeEach(() => {
+  errorLogs.length = 0;
+  const silent = () => undefined;
+  setLogger({
+    debug: silent,
+    info: silent,
+    warn: silent,
+    error: (category, message, fields) => void errorLogs.push({category, message, fields}),
+  });
+});
+
+afterEach(async () => {
+  for (const client of trackedClients.splice(0)) client.terminate();
+  for (const server of trackedServers.splice(0)) {
+    await eventually(() => server.wss.clients.size === 0);
+    await server.stop();
+  }
+  setLogger();
+});
+
+describe('WebSocket conversation list', () => {
+  it('refuses list_conversations with UNSUPPORTED when history is off, when the store omits listFor, or when the store throws StoreCannotList', async () => {
+    const offBase = await startHistoryEngine({session: new InMemorySessionStore()});
+    const offClient = await connectWs(offBase);
+    const offFrames = await sendAndCollect(offClient, {type: 'list_conversations'});
+
+    const bareBase = await startHistoryEngine({session: fiveMemberStore, history: {enabled: true}});
+    const bareClient = await connectWs(bareBase);
+    const bareFrames = await sendAndCollect(bareClient, {type: 'list_conversations'});
+
+    const writeOnlyMongo = new MongoSessionStore({collection: fakeCollection()});
+    const mongoBase = await startHistoryEngine({session: writeOnlyMongo, history: {enabled: true}});
+    const mongoClient = await connectWs(mongoBase);
+    const mongoFrames = await sendAndCollect(mongoClient, {type: 'list_conversations'});
+
+    expect({
+      off: frameTags(offFrames),
+      bareStore: frameTags(bareFrames),
+      cannotList: frameTags(mongoFrames),
+    }).toEqual({
+      off: [{type: 'error', code: 'UNSUPPORTED'}],
+      bareStore: [{type: 'error', code: 'UNSUPPORTED'}],
+      cannotList: [{type: 'error', code: 'UNSUPPORTED'}],
+    });
+  });
+
+  it('answers list_conversations with the authenticated user summaries newest first as ISO strings, ignores frame userId, pages with cursor, and lets a listed id resume', async () => {
+    const recordedCalls: Array<{userId: string | number; options: SessionListOptions | undefined}> = [];
+    const memoryStore = new InMemorySessionStore();
+    const boundListFor = memoryStore.listFor.bind(memoryStore);
+    const trackedStore: InMemorySessionStore = Object.assign(memoryStore, {
+      listFor(userId: string | number, options?: SessionListOptions) {
+        recordedCalls.push({userId, options});
+        return boundListFor(userId, options);
+      },
+    });
+
+    const oldest = trackedStore.create('conv-oldest', 'u1');
+    oldest.entries.push(
+      {role: 'user', content: 'first question', timestamp: '2099-01-01T00:00:01.000Z'},
+      {role: 'assistant', content: 'first answer', timestamp: '2099-01-01T00:00:02.000Z', isStreaming: false}
+    );
+    const middle = trackedStore.create('conv-middle', 'u1');
+    middle.entries.push({role: 'user', content: 'second question', timestamp: '2099-01-01T00:00:03.000Z'});
+    const newest = trackedStore.create('conv-newest', 'u1');
+    newest.entries.push({role: 'user', content: 'third question', timestamp: '2099-01-01T00:00:04.000Z'});
+    const otherUser = trackedStore.create('conv-u2', 'u2');
+    otherUser.entries.push({role: 'user', content: 'other user question', timestamp: '2099-01-01T00:00:05.000Z'});
+
+    const base = await startHistoryEngine({
+      session: trackedStore,
+      resume: {enabled: true},
+      history: {enabled: true},
+    });
+
+    const firstClient = openBufferedSocket(`${base}?sessionId=conv-newest`);
+    const initialFrames = await settleOnConnect(firstClient);
+    const connected = initialFrames[0] ?? {type: 'missing'};
+
+    const allFrames = await sendAndCollect(firstClient, {type: 'list_conversations', userId: 'u2'});
+    const listFrame = allFrames[0];
+    const summaries = listFrame?.conversations ?? [];
+
+    const pageOneFrames = await sendAndCollect(firstClient, {type: 'list_conversations', limit: 1});
+    const pageOne = pageOneFrames[0]?.conversations ?? [];
+    const firstCursor = {updatedAt: pageOne[0]?.updatedAt ?? '', sessionId: pageOne[0]?.sessionId ?? ''};
+
+    const pageTwoFrames = await sendAndCollect(firstClient, {
+      type: 'list_conversations',
+      limit: 2,
+      before: firstCursor,
+    });
+    const pageTwo = pageTwoFrames[0]?.conversations ?? [];
+
+    const pickedId = pageTwo[1]?.sessionId ?? '';
+    const secondClient = openBufferedSocket(`${base}?sessionId=${pickedId}`);
+    const resumedFrames = await settleOnConnect(secondClient);
+    const resumedConnected = resumedFrames[0] ?? {type: 'missing'};
+    const replayedRoles = resumedFrames.slice(1).map(frame => frame.entry?.role);
+
+    expect({
+      connectedKeys: Object.keys(connected).sort(),
+      frameCount: allFrames.length,
+      frameType: listFrame?.type,
+      ids: summaries.map(row => row.sessionId),
+      counts: summaries.map(row => row.entryCount),
+      summaryKeys: summaries.map(row => Object.keys(row).sort()),
+      isoDates: summaries.every(row => isIsoDate(row.createdAt) && isIsoDate(row.updatedAt)),
+      pageOneIds: pageOne.map(row => row.sessionId),
+      pageTwoIds: pageTwo.map(row => row.sessionId),
+      recordedCalls,
+      rejoined: {
+        resumed: resumedConnected.resumed,
+        entryCount: resumedConnected.entryCount,
+        sessionId: resumedConnected.sessionId,
+        replayedRoles,
+      },
+    }).toEqual({
+      connectedKeys: ['entryCount', 'examplePrompts', 'message', 'resumed', 'sessionId', 'type'],
+      frameCount: 1,
+      frameType: 'conversation_list',
+      ids: ['conv-newest', 'conv-middle', 'conv-oldest'],
+      counts: [1, 1, 2],
+      summaryKeys: [
+        ['createdAt', 'entryCount', 'sessionId', 'updatedAt'],
+        ['createdAt', 'entryCount', 'sessionId', 'updatedAt'],
+        ['createdAt', 'entryCount', 'sessionId', 'updatedAt'],
+      ],
+      isoDates: true,
+      pageOneIds: ['conv-newest'],
+      pageTwoIds: ['conv-middle', 'conv-oldest'],
+      recordedCalls: [
+        {userId: 'u1', options: {limit: undefined, before: undefined}},
+        {userId: 'u1', options: {limit: 1, before: undefined}},
+        {
+          userId: 'u1',
+          options: {limit: 2, before: {updatedAt: '2099-01-01T00:00:04.000Z', sessionId: 'conv-newest'}},
+        },
+      ],
+      rejoined: {
+        resumed: true,
+        entryCount: 2,
+        sessionId: 'conv-oldest',
+        replayedRoles: ['user', 'assistant'],
+      },
+    });
+  });
+
+  it('validates list_conversations limit and before cursor and rejects invalid shapes naming the field', async () => {
+    const validBare = validateMessage({type: 'list_conversations'});
+    const validStripped = validateMessage({type: 'list_conversations', userId: 'u2'});
+    const validPaged = validateMessage({
+      type: 'list_conversations',
+      limit: 25,
+      before: {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: 's1'},
+    });
+
+    const refusedLimits = [0, 201, 1.5, '10'].map(limit => validateMessage({type: 'list_conversations', limit}));
+    const refusedBefores = [
+      'not a date',
+      {updatedAt: 'not a date', sessionId: 's1'},
+      {updatedAt: '2026-01-01T00:00:00.000Z'},
+      {sessionId: 's1'},
+    ].map(before => validateMessage({type: 'list_conversations', before}));
+
+    const base = await startHistoryEngine({session: new InMemorySessionStore(), history: {enabled: true}});
+    const client = await connectWs(base);
+    const wireFrames = await sendAndCollect(client, {type: 'list_conversations', limit: 0});
+
+    expect({
+      validBare,
+      validStripped,
+      validPaged,
+      limitFailures: refusedLimits.map(outcome => ({
+        valid: outcome.valid,
+        namesField: !outcome.valid && outcome.error.includes('limit'),
+      })),
+      beforeFailures: refusedBefores.map(outcome => ({
+        valid: outcome.valid,
+        namesField: !outcome.valid && /before|updatedAt|sessionId/i.test(outcome.error),
+      })),
+      wire: wireFrames.map(frame => ({
+        type: frame.type,
+        code: frame.code,
+        namesLimit: String(frame.message).includes('limit'),
+      })),
+    }).toEqual({
+      validBare: {valid: true, data: {type: 'list_conversations'}},
+      validStripped: {valid: true, data: {type: 'list_conversations'}},
+      validPaged: {
+        valid: true,
+        data: {
+          type: 'list_conversations',
+          limit: 25,
+          before: {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: 's1'},
+        },
+      },
+      limitFailures: [
+        {valid: false, namesField: true},
+        {valid: false, namesField: true},
+        {valid: false, namesField: true},
+        {valid: false, namesField: true},
+      ],
+      beforeFailures: [
+        {valid: false, namesField: true},
+        {valid: false, namesField: true},
+        {valid: false, namesField: true},
+        {valid: false, namesField: true},
+      ],
+      wire: [{type: 'error', code: 'INVALID_MESSAGE', namesLimit: true}],
+    });
+  });
+
+  it('answers list_conversations while a user_message turn is streaming on the same session before stream_end', async () => {
+    const gate = deferred();
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        yield {type: 'text', text: 'first '};
+        await gate.until;
+        yield {type: 'text', text: 'second'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Stream lock test.'}));
+    const serverOptions = {
+      app: createApp(),
+      wsAuth: async () => ({id: 'u1'}),
+      sessionStore: new InMemorySessionStore(),
+      orchestrator,
+      history: {enabled: true},
+    };
+    const server = createServer(serverOptions);
+    trackedServers.push(server);
+    await server.start(0);
+    const {port} = server.server.address() as AddressInfo;
+
+    const client = await connectWs(`ws://127.0.0.1:${port}/hal/ws`);
+    client.socket.send(JSON.stringify({type: 'user_message', content: 'hold turn open'}));
+    await eventually(() => client.frames.some(frame => frame.type === 'entry_delta'));
+
+    client.socket.send(JSON.stringify({type: 'list_conversations'}));
+    await eventually(() => client.frames.some(frame => frame.type === 'conversation_list' || frame.type === 'error'));
+
+    gate.release();
+    await eventually(() => client.frames.some(frame => frame.type === 'stream_end'));
+
+    const collectedTypes = client.frames.map(frame => frame.type);
+    const listAt = collectedTypes.indexOf('conversation_list');
+    const endAt = collectedTypes.indexOf('stream_end');
+
+    expect({
+      hasList: listAt >= 0,
+      hasEnd: endAt >= 0,
+      beforeEnd: listAt >= 0 && listAt < endAt,
+    }).toEqual({hasList: true, hasEnd: true, beforeEnd: true});
+  });
+
+  it('answers a rejecting listFor with SERVER_ERROR hiding store details, keeps the socket open, and logs sessionId without user content', async () => {
+    const failingStore = new MongoSessionStore({
+      collection: fakeCollection({
+        find: () => ({
+          toArray: () => Promise.reject(new Error('mongodb://admin:topsecret@db.internal/sessions unreachable')),
+        }),
+      }),
+    });
+
+    const base = await startHistoryEngine({session: failingStore, history: {enabled: true}});
+    const client = openBufferedSocket(base);
+    const initialFrames = await settleOnConnect(client);
+    const sessionId = initialFrames[0]?.sessionId ?? '';
+
+    client.socket.send(JSON.stringify({type: 'user_message', content: 'confidential prompt text'}));
+    await eventually(() => client.frames.some(frame => frame.type === 'stream_end'));
+    client.frames.length = 0;
+
+    errorLogs.length = 0;
+    const listFrames = await sendAndCollect(client, {type: 'list_conversations'});
+    const listReply = listFrames[0];
+
+    const pongFrames = await sendAndCollect(client, {type: 'ping', timestamp: 77});
+    const pongReply = pongFrames[0];
+
+    const serializedLogs = JSON.stringify(errorLogs);
+    const replyMessage = String(listReply?.message ?? '');
+
+    expect({
+      errorCode: listReply?.code,
+      hidesSecret: !replyMessage.includes('topsecret') && !replyMessage.includes('db.internal'),
+      pongTimestamp: pongReply?.timestamp,
+      loggedSessionId: errorLogs.some(entry => entry.fields?.sessionId === sessionId),
+      hidesUserContent: !serializedLogs.includes('confidential prompt text'),
+    }).toEqual({
+      errorCode: 'SERVER_ERROR',
+      hidesSecret: true,
+      pongTimestamp: 77,
+      loggedSessionId: true,
+      hidesUserContent: true,
+    });
+  });
+});
+
+interface EngineSetup {
+  session: SessionStore;
+  resume?: {enabled: boolean};
+  history?: {enabled: boolean};
+}
+
+async function startHistoryEngine(setup: EngineSetup): Promise<string> {
+  const transport = {
+    port: 0,
+    ...(setup.resume ? {resume: setup.resume} : {}),
+    ...(setup.history ? {history: setup.history} : {}),
+  };
+  const engine = createHalEngine({
+    provider: {type: 'mock'},
+    prompt: {identity: 'Conversation list acceptance test.'},
+    auth: {ws: async () => ({id: 'u1'})},
+    session: setup.session,
+    transport,
+  });
+  trackedServers.push(engine);
+  await engine.start();
+  const {port} = engine.server.address() as AddressInfo;
+  return `ws://127.0.0.1:${port}/hal/ws`;
+}
+
+async function connectWs(url: string): Promise<BufferedSocket> {
+  const client = openBufferedSocket(url);
+  await settleOnConnect(client);
+  return client;
+}
+
+function openBufferedSocket(url: string): BufferedSocket {
+  const socket = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'test-token']);
+  trackedClients.push(socket);
+  const frames: WireFrame[] = [];
+  socket.on('message', raw => void frames.push(parseFrame(raw)));
+  return {socket, frames};
+}
+
+// A ping sent after connected acts as a barrier so every replay frame arrives before frames resets.
+async function settleOnConnect(client: BufferedSocket): Promise<WireFrame[]> {
+  await eventually(() => client.frames.some(frame => frame.type === 'connected'));
+  client.socket.send(JSON.stringify({type: 'ping', timestamp: 1}));
+  await eventually(() => client.frames.some(frame => frame.type === 'pong'));
+  const settled = client.frames.filter(frame => frame.type !== 'pong');
+  client.frames.length = 0;
+  return settled;
+}
+
+async function sendAndCollect(client: BufferedSocket, payload: Record<string, unknown>): Promise<WireFrame[]> {
+  client.frames.length = 0;
+  client.socket.send(JSON.stringify(payload));
+  await eventually(() => client.frames.length > 0);
+  await new Promise(resolve => setTimeout(resolve, 25));
+  return client.frames.splice(0);
+}
+
+function frameTags(frames: WireFrame[]): Array<{type: string; code: string | undefined}> {
+  return frames.map(frame => ({type: frame.type, code: frame.code}));
+}
+
+function isIsoDate(candidate: unknown): boolean {
+  if (typeof candidate !== 'string') return false;
+  const parsed = Date.parse(candidate);
+  return Number.isFinite(parsed) && new Date(parsed).toISOString() === candidate;
+}
+
+function parseFrame(raw: unknown): WireFrame {
+  return JSON.parse(String(raw)) as WireFrame;
+}
+
+async function eventually(check: () => boolean): Promise<void> {
+  for (let attempt = 0; attempt < 50 && !check(); attempt++) await new Promise(resolve => setTimeout(resolve, 10));
+}