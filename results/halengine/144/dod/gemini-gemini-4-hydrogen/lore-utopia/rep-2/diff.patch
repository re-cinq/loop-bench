@@ -0,0 +1,379 @@
+import type {AddressInfo} from 'node:net';
+import {WebSocket} from 'ws';
+import type {Express} from 'express';
+import {createHalEngine} from './config.js';
+import type {HalEngine} from './config.js';
+import {createChatOrchestrator} from './orchestration/chatOrchestrator.js';
+import {PromptBuilder} from './infrastructure/builders/promptBuilder.js';
+import {InMemorySessionStore} from './infrastructure/stores/inMemorySessionStore.js';
+import {MongoSessionStore} from './infrastructure/stores/mongo/mongoSessionStore.js';
+import {fakeCollection} from './infrastructure/stores/mongo/mongoTestSupport.js';
+import {fiveMemberStore} from './infrastructure/stores/sessionStoreTestSupport.js';
+import {setLogger} from './shared/logger.js';
+import {createServer} from './transport/createServer.js';
+import type {HalServer} from './transport/createServer.js';
+import {HAL_WS_SUBPROTOCOL} from './transport/ws/subprotocol.js';
+import {validateMessage} from './transport/ws/validation.js';
+import type {AIProvider} from './types/ai.js';
+import type {SessionStore} from './types/sessionStore.js';
+
+// Acceptance criteria for re-cinq/HALEngine#144: delivering a user's conversation list over WebSocket.
+
+interface SummaryRow {
+  sessionId: string;
+  createdAt: string;
+  updatedAt: string;
+  entryCount: number;
+}
+
+interface WireFrame {
+  type: string;
+  code?: string;
+  message?: string;
+  sessionId?: string;
+  resumed?: boolean;
+  entryCount?: number;
+  timestamp?: number;
+  conversations?: SummaryRow[];
+  entry?: {role: string; content?: string};
+}
+
+const EARLIER = '2026-01-01T00:00:00.000Z';
+const silentLogger = {debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined};
+const engines: Array<HalEngine | HalServer> = [];
+const sockets: WebSocket[] = [];
+
+describe('delivering a user conversation list over WebSocket', () => {
+  beforeEach(() => {
+    setLogger(silentLogger);
+  });
+
+  afterEach(async () => {
+    for (const socket of sockets.splice(0)) socket.terminate();
+    for (const running of engines.splice(0)) {
+      const {wss} = running;
+      await eventually(() => wss.clients.size === 0);
+      await running.stop();
+    }
+  });
+
+  afterAll(() => {
+    setLogger();
+  });
+
+  it("delivers the connecting user's conversations newest first with ISO dates, ignores a forged userId, pages with before, and lets the client resume a listed id", async () => {
+    const store = new InMemorySessionStore();
+    await seedConversation(store, 's1', 'u1', 'topic one');
+    await seedConversation(store, 's2', 'u1', 'topic two');
+    await seedConversation(store, 's3', 'u1', 'topic three');
+    await seedConversation(store, 'theirs', 'u2', 'private');
+    await pause(5);
+
+    const transport = {port: 0, resume: {enabled: true}, history: {enabled: true}};
+    const baseUrl = await startHal(store, transport);
+    const client = openSocket(baseUrl);
+    const [greeting] = await collectUntil(client, 'connected');
+    const currentSessionId = greeting.sessionId ?? '';
+
+    client.send(JSON.stringify({type: 'list_conversations', userId: 'u2'}));
+    client.send(JSON.stringify({type: 'ping', timestamp: 1}));
+    const allFrames = await collectUntil(client, 'pong');
+    const allRows = allFrames[0]?.conversations ?? [];
+
+    client.send(JSON.stringify({type: 'list_conversations', limit: 2}));
+    client.send(JSON.stringify({type: 'ping', timestamp: 2}));
+    const page1Frames = await collectUntil(client, 'pong');
+    const page1 = page1Frames.find(frame => frame.type === 'conversation_list')?.conversations ?? [];
+
+    const cursor = page1[1];
+    client.send(
+      JSON.stringify({
+        type: 'list_conversations',
+        limit: 2,
+        before: {updatedAt: cursor?.updatedAt, sessionId: cursor?.sessionId},
+      })
+    );
+    client.send(JSON.stringify({type: 'ping', timestamp: 3}));
+    const page2Frames = await collectUntil(client, 'pong');
+    const page2 = page2Frames.find(frame => frame.type === 'conversation_list')?.conversations ?? [];
+
+    const resumedSocket = openSocket(`${baseUrl}?sessionId=s2`);
+    const replay = await collectResumed(resumedSocket);
+
+    expect({
+      allTypes: allFrames.map(frame => frame.type),
+      allIds: allRows.map(row => row.sessionId),
+      isoTimestamps: allRows.every(row => isIsoStamp(row.createdAt) && isIsoStamp(row.updatedAt)),
+      currentEntryCount: allRows[0]?.entryCount,
+      s2EntryCount: allRows.find(row => row.sessionId === 's2')?.entryCount,
+      page1Ids: page1.map(row => row.sessionId),
+      page2Ids: page2.map(row => row.sessionId),
+      replay,
+    }).toEqual({
+      allTypes: ['conversation_list', 'pong'],
+      allIds: [currentSessionId, 's3', 's2', 's1'],
+      isoTimestamps: true,
+      currentEntryCount: 0,
+      s2EntryCount: 1,
+      page1Ids: [currentSessionId, 's3'],
+      page2Ids: ['s2', 's1'],
+      replay: {sessionId: 's2', resumed: true, entryCount: 1, firstContent: 'topic two'},
+    });
+  });
+
+  it('rejects malformed list_conversations frames in validation and on the wire without stream_end', async () => {
+    const accepted = validateMessage({type: 'list_conversations'});
+    const badLimits = [0, 201, 1.5, '10'].map(limit => validateMessage({type: 'list_conversations', limit}));
+    const badCursors = [
+      'not a date',
+      {updatedAt: 'not a date', sessionId: 's1'},
+      {updatedAt: EARLIER},
+      {sessionId: 's1'},
+    ].map(before => validateMessage({type: 'list_conversations', before}));
+
+    const transport = {port: 0, resume: {enabled: true}, history: {enabled: true}};
+    const baseUrl = await startHal(new InMemorySessionStore(), transport);
+    const client = openSocket(baseUrl);
+    await collectUntil(client, 'connected');
+    client.send(JSON.stringify({type: 'list_conversations', limit: 0}));
+    client.send(JSON.stringify({type: 'ping', timestamp: 9}));
+    const wireFrames = await collectUntil(client, 'pong');
+
+    expect({
+      accepted,
+      limitsRefused: badLimits.every(outcome => !outcome.valid && /limit/i.test(outcome.error)),
