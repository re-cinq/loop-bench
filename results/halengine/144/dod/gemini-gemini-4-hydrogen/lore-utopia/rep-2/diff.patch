+async function seedConversation(
+  store: InMemorySessionStore,
+  sessionId: string,
+  userId: string,
+  content: string
+): Promise<void> {
+  await pause(5);
+  const session = store.create(sessionId, userId);
+  session.entries.push({role: 'user', content, timestamp: EARLIER});
+}
+
+async function startHal(store: SessionStore, transport: Record<string, unknown>): Promise<string> {
+  const engine = createHalEngine({
+    provider: {type: 'mock'},
+    prompt: {identity: 'History acceptance test.'},
+    auth: {ws: async () => ({id: 'u1'})},
+    session: store,
+    transport: transport as NonNullable<Parameters<typeof createHalEngine>[0]['transport']>,
+  });
+  await engine.start();
+  engines.push(engine);
+  const {port} = engine.server.address() as AddressInfo;
+  return `ws://127.0.0.1:${port}/hal/ws`;
+}
+
+async function requestListErrorCode(url: string): Promise<string | undefined> {
+  const client = openSocket(url);
+  await collectUntil(client, 'connected');
+  client.send(JSON.stringify({type: 'list_conversations'}));
+  const [errorFrame] = await collectUntil(client, 'error');
+  return errorFrame?.code;
+}
+
+function openSocket(url: string): WebSocket {
+  const client = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'test-token']);
+  sockets.push(client);
+  return client;
+}
+
+function collectUntil(client: WebSocket, targetType: string): Promise<WireFrame[]> {
+  const seen: WireFrame[] = [];
+  return new Promise<WireFrame[]>((resolve, reject) => {
+    const onMessage = (raw: Buffer) => {
+      const frame = JSON.parse(String(raw)) as WireFrame;
+      seen.push(frame);
+      if (frame.type !== targetType) return;
+      cleanup();
+      resolve(seen);
+    };
+    const onClose = () => {
+      cleanup();
+      reject(new Error(`Socket closed before ${targetType}`));
+    };
+    const cleanup = () => {
+      client.off('message', onMessage);
+      client.off('close', onClose);
+    };
+    client.on('message', onMessage);
+    client.on('close', onClose);
+  });
+}
+
+async function collectResumed(client: WebSocket): Promise<{
+  sessionId?: string;
+  resumed?: boolean;
+  entryCount?: number;
+  firstContent?: string;
+}> {
+  const frames: WireFrame[] = [];
+  await new Promise<void>(resolve => {
+    client.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as WireFrame;
+      frames.push(frame);
+      if (frame.type === 'connected') client.send(JSON.stringify({type: 'ping', timestamp: 7}));
+      if (frame.type === 'pong') resolve();
+    });
+  });
+  const connected = frames.find(frame => frame.type === 'connected');
+  const firstUpsert = frames.find(frame => frame.type === 'entry_upsert');
+  return {
+    sessionId: connected?.sessionId,
+    resumed: connected?.resumed,
+    entryCount: connected?.entryCount,
+    firstContent: firstUpsert?.entry?.content,
+  };
+}
+
+function isIsoStamp(value: unknown): boolean {
+  return typeof value === 'string' && /^\d{4}-\d{2}-\d{2}T/.test(value) && Number.isFinite(Date.parse(value));
+}
+
+async function eventually(check: () => boolean): Promise<void> {
+  for (let attempt = 0; attempt < 50 && !check(); attempt++) await pause(10);
+}
+
+function pause(ms: number): Promise<void> {
+  return new Promise(resolve => setTimeout(resolve, ms));
+}
+
+function deferred(): {until: Promise<void>; release: () => void} {
+  let release = (): void => undefined;
+  const until = new Promise<void>(resolve => {
+    release = resolve;
+  });
+  return {until, release};
+}