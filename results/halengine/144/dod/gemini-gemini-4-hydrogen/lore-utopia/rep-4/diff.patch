+    prior.entries.push({role: 'user', content: 'private user prompt', timestamp: '2030-01-01T08:00:00.000Z'});
+    const store = failingListStore(inner, new Error('ECONNREFUSED db.internal:27017'));
+
+    const {baseUrl} = await startListEngine({store, history: {enabled: true}});
+    const channel = await openChannel(baseUrl);
+    const connected = await channel.nextFrame();
+    channel.socket.send(JSON.stringify({type: 'list_conversations'}));
+    const reply = await channel.nextFrame();
+    channel.socket.send(JSON.stringify({type: 'ping', timestamp: 9}));
+    const afterReply = await channel.nextFrame();
+
+    const errorLines = captured.filter(line => line.level === 'error');
+    const leaked = ['ECONNREFUSED', 'db.internal', '27017'].filter(term => String(reply.message).includes(term));
