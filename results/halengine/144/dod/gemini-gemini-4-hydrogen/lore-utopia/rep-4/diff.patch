+function seedConversations(): InMemorySessionStore {
+  const store = new InMemorySessionStore();
+  const oldest = store.create('s-oldest', 'u1');
+  oldest.entries.push({role: 'user', content: 'oldest', timestamp: '2030-01-01T08:00:00.000Z'});
+  const middle = store.create('s-middle', 'u1');
+  middle.entries.push({role: 'user', content: 'middle', timestamp: '2030-01-01T09:00:00.000Z'});
+  const newest = store.create('s-newest', 'u1');
+  newest.entries.push(
+    {role: 'user', content: 'newest', timestamp: '2030-01-01T10:00:00.000Z'},
+    {role: 'assistant', content: 'reply', timestamp: '2030-01-01T10:00:01.000Z', isStreaming: false}
+  );
+  const other = store.create('s-other', 'u2');
+  other.entries.push({role: 'user', content: 'secret', timestamp: '2030-01-01T11:00:00.000Z'});
+  return store;
+}
+
+function recordingListStore(inner: InMemorySessionStore, calls: RecordedListCall[]): SessionStore {
+  return {
+    create: (sessionId, userId, options) => inner.create(sessionId, userId, options),
+    get: sessionId => inner.get(sessionId),
+    lookup: sessionId => inner.lookup(sessionId),
+    delete: sessionId => inner.delete(sessionId),
+    evict: sessionId => inner.evict(sessionId),
+    count: () => inner.count(),
+    clear: () => inner.clear(),
+    latestFor: userId => inner.latestFor(userId),
+    listFor: (userId, options): SessionSummary[] => {
+      calls.push({userId, options});
+      return inner.listFor(userId, options);
+    },
+  };
+}
+
+function failingListStore(inner: InMemorySessionStore, failure: Error): SessionStore {
+  return {
+    create: (sessionId, userId, options) => inner.create(sessionId, userId, options),
+    get: sessionId => inner.get(sessionId),
+    delete: sessionId => inner.delete(sessionId),
+    count: () => inner.count(),
+    clear: () => inner.clear(),
+    listFor: async () => {
+      throw failure;
+    },
+  };
+}
+
+function collectionWithoutFind(): CollectionLike<MongoSessionDocument> {
+  const emptyWrite = async () => ({deletedCount: 0});
+  return {
+    findOne: async () => null,
+    updateOne: emptyWrite,
+    deleteOne: emptyWrite,
+    deleteMany: emptyWrite,
+    countDocuments: async () => 0,
+  };
+}
+
+function installLogCapture(): CapturedLog[] {
+  const lines: CapturedLog[] = [];
+  const collect = (level: string) => (category: string, message: string, fields?: Record<string, unknown>) =>
+    void lines.push({level, category, message, fields});
+  setLogger({debug: collect('debug'), info: collect('info'), warn: collect('warn'), error: collect('error')});
+  return lines;
+}
+
+async function probeUnsupported(options: {store: SessionStore; history?: {enabled: boolean}}) {
+  const {baseUrl} = await startListEngine(options);
+  const channel = await openChannel(baseUrl);
+  await channel.nextFrame();
+  channel.socket.send(JSON.stringify({type: 'list_conversations'}));
+  const reply = await channel.nextFrame();
+  channel.socket.send(JSON.stringify({type: 'ping', timestamp: 2}));
+  const fence = await channel.framesUntil('pong');
+  return {
+    type: reply.type,
+    code: reply.code,
+    hasMessage: typeof reply.message === 'string',
+    afterTypes: fence.map(frame => frame.type),
+  };
+}
+
+async function startListEngine(options: {
+  store: SessionStore;
+  history?: {enabled: boolean};
+  resume?: {enabled: boolean};
+  beforeModelResponse?: (session: ChatSession, prompt: string) => Promise<string>;
+}): Promise<{engine: HalEngine; baseUrl: string}> {
+  const transport = {
+    port: 0,
+    ...(options.resume ? {resume: options.resume} : {}),
+    ...(options.history ? {history: options.history} : {}),
+  };
+  const orchestrator = options.beforeModelResponse ? {hooks: {beforeModelResponse: options.beforeModelResponse}} : {};
+  const engine = createHalEngine({
+    provider: {type: 'mock'},
+    prompt: {identity: 'Acceptance test.'},
+    auth: {ws: async () => ({id: 'u1'})},
+    session: options.store,
+    transport,
+    orchestrator,
+  });
+  await engine.start();
+  startedEngines.push(engine);
+  const {port} = engine.server.address() as AddressInfo;
+  return {engine, baseUrl: `ws://127.0.0.1:${port}/hal/ws`};
+}
+
+async function openChannel(url: string): Promise<SocketChannel> {
+  const socket = new WebSocket(url, [HAL_WS_SUBPROTOCOL, 'test-token']);
+  openedSockets.push(socket);
+  const channel = attachChannel(socket);
+  await once(socket, 'open');
+  return channel;
+}
+
+function attachChannel(socket: WebSocket): SocketChannel {
+  const queue: WireFrame[] = [];
+  const seen: WireFrame[] = [];
+  const waiters: Array<(frame: WireFrame) => void> = [];
+
+  socket.on('message', raw => {
+    const frame = JSON.parse(String(raw)) as WireFrame;
+    seen.push(frame);
+    const waiter = waiters.shift();
+    if (waiter) {
+      waiter(frame);
+      return;
+    }
+    queue.push(frame);
+  });
+
+  const nextFrame = (): Promise<WireFrame> => {
+    const buffered = queue.shift();
+    if (buffered) return Promise.resolve(buffered);
+    return new Promise(resolve => waiters.push(resolve));
+  };
+
+  const framesUntil = async (targetType: string): Promise<WireFrame[]> => {
+    const collected: WireFrame[] = [];
+    while (true) {
+      const frame = await nextFrame();
+      collected.push(frame);
+      if (frame.type === targetType) return collected;
+    }
+  };
+
+  const waitFor = async (match: (frame: WireFrame) => boolean): Promise<WireFrame> => {
+    while (true) {
+      const frame = await nextFrame();
+      if (match(frame)) return frame;
+    }
+  };
+
+  return {socket, seen, nextFrame, framesUntil, waitFor};
+}
+
+async function tearDown(): Promise<void> {
+  const closed = openedSockets.splice(0).map(socket => {
+    if (socket.readyState === WebSocket.CLOSED) return Promise.resolve();
+    const closing = once(socket, 'close');
+    socket.terminate();
+    return closing;
+  });
+  await Promise.all(closed);
+  for (const engine of startedEngines.splice(0)) await engine.stop();
+  await new Promise(resolve => setImmediate(resolve));
+}