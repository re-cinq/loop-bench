diff --git a/src/transport/ws/conversationList.acceptance.test.ts b/src/transport/ws/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..0ddb8b8
--- /dev/null
+++ b/src/transport/ws/conversationList.acceptance.test.ts
@@ -0,0 +1,193 @@
+import {WebSocket} from 'ws';
+import {validateMessage} from './validation.js';
+import {createMessageHandler} from './messageHandler.js';
+import {InMemorySessionStore} from '../../infrastructure/stores/inMemorySessionStore.js';
+import type {ChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import type {ChatSession} from '../../types/session.js';
+import type {SessionStore, SessionListOptions, SessionSummary} from '../../types/sessionStore.js';
+import type {MessageChunk} from '../../types/ai.js';
+import {deferred} from '../wsTestSupport.js';
+
+// The expected new API — createMessageHandler(orchestrator, store, options) — does not exist yet.
+// The cast lets the test call it correctly without a type error so that the failure lands at runtime,
+// on the missing behaviour, not at compile time, on a wrong call shape.
+type CreateHandler = (
+  orchestrator: ChatOrchestrator,
+  store: SessionStore,
+  options: {history?: {enabled: boolean}}
+) => ReturnType<typeof createMessageHandler>;
+const makeHandler = createMessageHandler as unknown as CreateHandler;
+
+type Frame = {type: string} & Record<string, unknown>;
+
+function capture(): {ws: WebSocket; sent: Frame[]} {
+  const sent: Frame[] = [];
+  const ws = {send: (raw: string) => sent.push(JSON.parse(raw) as Frame)} as unknown as WebSocket;
+  return {ws, sent};
+}
+
+function newSession(userId: string): ChatSession {
+  return {sessionId: 'sess-0', userId, entries: []};
+}
+
+const noop: ChatOrchestrator = {
+  processMessage: async () => '',
+  async *processMessageStream(): AsyncGenerator<MessageChunk> {
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+};
+
+class SpyStore extends InMemorySessionStore {
+  readonly calls: Array<{userId: string | number; options: SessionListOptions | undefined}> = [];
+
+  override listFor(userId: string | number, options?: SessionListOptions): ReturnType<InMemorySessionStore['listFor']> {
+    this.calls.push({userId, options});
+    return super.listFor(userId, options);
+  }
+}
+
+function noListStore(): SessionStore {
+  return {
+    create: async (id: string, uid: string | number): Promise<ChatSession> =>
+      ({sessionId: id, userId: uid, entries: []}) as ChatSession,
+    get: async () => undefined,
+    delete: async () => false,
+    count: async () => 0,
+    clear: async () => undefined,
+  };
+}
+
+function throwingListStore(): SessionStore {
+  return {
+    create: async (id: string, uid: string | number): Promise<ChatSession> =>
+      ({sessionId: id, userId: uid, entries: []}) as ChatSession,
+    get: async () => undefined,
+    delete: async () => false,
+    count: async () => 0,
+    clear: async () => undefined,
+    listFor: async (): Promise<SessionSummary[]> => {
+      throw new Error('db down');
+    },
+  };
+}
+
+const tick = (): Promise<void> => new Promise(resolve => setImmediate(resolve));
+
+describe('conversation list over WebSocket (re-cinq/HALEngine#144)', () => {
+  it('validateMessage accepts list_conversations and rejects out-of-range limit and non-cursor before', () => {
+    expect({
+      bare: validateMessage({type: 'list_conversations'}),
+      withLimit: validateMessage({type: 'list_conversations', limit: 50}),
+      withCursor: validateMessage({
+        type: 'list_conversations',
+        before: {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: 's1'},
+      }),
+      limit0: validateMessage({type: 'list_conversations', limit: 0}),
+      limit201: validateMessage({type: 'list_conversations', limit: 201}),
+      limitFloat: validateMessage({type: 'list_conversations', limit: 1.5}),
+      limitString: validateMessage({type: 'list_conversations', limit: '10'}),
+      beforeString: validateMessage({type: 'list_conversations', before: 'not a date'}),
+    }).toMatchObject({
+      bare: {valid: true, data: {type: 'list_conversations'}},
+      withLimit: {valid: true},
+      withCursor: {valid: true},
+      limit0: {valid: false, error: expect.stringContaining('limit')},
+      limit201: {valid: false, error: expect.stringContaining('limit')},
+      limitFloat: {valid: false, error: expect.stringContaining('limit')},
+      limitString: {valid: false, error: expect.stringContaining('limit')},
+      beforeString: {valid: false, error: expect.stringContaining('before')},
+    });
+  });
+
+  it('answers conversation_list from ws.userId with ISO-string dates and no stream_end', async () => {
+    const store = new SpyStore();
+    await store.create('s1', 'u1');
+    await store.create('s2', 'u1');
+    await store.create('s3', 'u1');
+    await store.create('s4', 'u2');
+
+    const handle = makeHandler(noop, store, {history: {enabled: true}});
+    const {ws, sent} = capture();
+    await handle(ws, newSession('u1'), {type: 'list_conversations', userId: 'u2'});
+
+    const listFrame = sent.find(f => f.type === 'conversation_list');
+    const conversations = listFrame?.conversations as Array<{createdAt: unknown; updatedAt: unknown}> | undefined;
+    expect({
+      calledWithUserId: store.calls[0]?.userId,
+      conversationCount: conversations?.length,
+      firstCreatedAtType: typeof conversations?.[0]?.createdAt,
+      firstUpdatedAtType: typeof conversations?.[0]?.updatedAt,
+      hasStreamEnd: sent.some(f => f.type === 'stream_end'),
+    }).toEqual({
+      calledWithUserId: 'u1',
+      conversationCount: 3,
+      firstCreatedAtType: 'string',
+      firstUpdatedAtType: 'string',
+      hasStreamEnd: false,
+    });
+  });
+
+  it('answers UNSUPPORTED when history is off or the store lacks listFor, SERVER_ERROR when listFor rejects', async () => {
+    const noHistory = makeHandler(noop, noListStore(), {});
+    const a = capture();
+    await noHistory(a.ws, newSession('u1'), {type: 'list_conversations'});
+
+    const noList = makeHandler(noop, noListStore(), {history: {enabled: true}});
+    const b = capture();
+    await noList(b.ws, newSession('u1'), {type: 'list_conversations'});
+
+    const rejects = makeHandler(noop, throwingListStore(), {history: {enabled: true}});
+    const c = capture();
+    await rejects(c.ws, newSession('u1'), {type: 'list_conversations'});
+
+    expect({
+      noHistoryCode: a.sent.find(f => f.type === 'error')?.code,
+      noListCode: b.sent.find(f => f.type === 'error')?.code,
+      rejectCode: c.sent.find(f => f.type === 'error')?.code,
+      noHistoryHasList: a.sent.some(f => f.type === 'conversation_list'),
+    }).toEqual({
+      noHistoryCode: 'UNSUPPORTED',
+      noListCode: 'UNSUPPORTED',
+      rejectCode: 'SERVER_ERROR',
+      noHistoryHasList: false,
+    });
+  });
+
+  it('answers list_conversations before the user_message stream_end of a concurrent turn', async () => {
+    const gate = deferred();
+    const streaming: ChatOrchestrator = {
+      processMessage: async () => '',
+      async *processMessageStream(): AsyncGenerator<MessageChunk> {
+        yield {type: 'text', text: 'hello'};
+        await gate.until;
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+    };
+
+    const store = new SpyStore();
+    await store.create('s1', 'u1');
+
+    const handle = makeHandler(streaming, store, {history: {enabled: true}});
+    const {ws, sent} = capture();
+    const sess = newSession('u1');
+
+    const userTurn = handle(ws, sess, {type: 'user_message', content: 'hello'});
+    await tick();
+
+    await handle(ws, sess, {type: 'list_conversations'});
+    const noStreamEndYet = !sent.some(f => f.type === 'stream_end');
+    const convListArrived = sent.some(f => f.type === 'conversation_list');
+
+    gate.release();
+    await userTurn;
+
+    const listIdx = sent.findIndex(f => f.type === 'conversation_list');
+    const endIdx = sent.findIndex(f => f.type === 'stream_end');
+
+    expect({noStreamEndYet, convListArrived, listBeforeEnd: convListArrived && listIdx < endIdx}).toEqual({
+      noStreamEndYet: true,
+      convListArrived: true,
+      listBeforeEnd: true,
+    });
+  });
+});