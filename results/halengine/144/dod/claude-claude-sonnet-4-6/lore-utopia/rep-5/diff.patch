+// Acceptance tests for re-cinq/HALEngine#144: deliver a user's conversation list over WebSocket.
+// Strategy: direct — validateMessage and createMessageHandler are real entry points.
+import {WebSocket} from 'ws';
+import {validateMessage} from './validation.js';
+import {createMessageHandler} from './messageHandler.js';
+import type {ChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import type {SessionStore, SessionSummary} from '../../types/sessionStore.js';
+import type {ChatSession} from '../../types/session.js';
+
+// createMessageHandler will gain (orchestrator, store, options?) once implemented.
+type HistoryOptions = {history?: {enabled: boolean}};
+type CreateHandlerFn = (
+  orchestrator: ChatOrchestrator,
+  store: SessionStore,
+  options?: HistoryOptions
+) => (ws: WebSocket, session: ChatSession, raw: unknown, signal?: AbortSignal) => Promise<void>;
+const createHandlerWithHistory = createMessageHandler as unknown as CreateHandlerFn;
+
+function fakeSocket(userId: string | number = 'u1') {
+  const sent: unknown[] = [];
+  const ws = {
+    send: (raw: string) => sent.push(JSON.parse(raw) as unknown),
+    readyState: WebSocket.OPEN,
+    userId,
+  };
+  return {ws: ws as unknown as WebSocket, sent};
+}
+
+function noopOrchestrator(): ChatOrchestrator {
+  return {
+    processMessage: async () => 'hi',
+    async *processMessageStream() {},
+  } as unknown as ChatOrchestrator;
+}
+
+function session(userId: string | number = 'u1'): ChatSession {
+  return {sessionId: 's1', userId, entries: []};
+}
+
+const NOW = new Date('2024-03-01T12:00:00.000Z');
+const OLDER = new Date('2024-02-01T12:00:00.000Z');
+const OLDEST = new Date('2024-01-01T12:00:00.000Z');
+
+const THREE_SUMMARIES: SessionSummary[] = [
+  {sessionId: 'c3', createdAt: NOW, updatedAt: NOW, entryCount: 7},
+  {sessionId: 'c2', createdAt: OLDER, updatedAt: OLDER, entryCount: 3},
+  {sessionId: 'c1', createdAt: OLDEST, updatedAt: OLDEST, entryCount: 1},
+];
+
+function storeWith(
+  summaries: SessionSummary[],
+  spy?: {lastUserId?: string | number; lastOptions?: unknown}
+): SessionStore {
+  return {
+    create: async () => session(),
+    get: async () => undefined,
+    delete: async () => false,
+    count: async () => 0,
+    clear: async () => {},
+    listFor: async (userId, opts) => {
+      if (spy) {
+        spy.lastUserId = userId;
+        spy.lastOptions = opts;
+      }
+      return summaries;
+    },
+  } as unknown as SessionStore;
+}
+
+function storeWithoutListFor(): SessionStore {
+  return {
+    create: async () => session(),
+    get: async () => undefined,
+    delete: async () => false,
+    count: async () => 0,
+    clear: async () => {},
+  } as unknown as SessionStore;
+}
+
+// Finds the first frame of a given type in the sent array.
+function firstOfType(sent: unknown[], type: string): Record<string, unknown> | undefined {
+  return (sent as Array<Record<string, unknown>>).find(f => f['type'] === type);
+}
+
+describe('Ticket #144: deliver conversation list over WebSocket', () => {
+  // spec: specs/hal-engine-websocket-protocol/spec.md
+  it('validateMessage accepts {type: list_conversations} and rejects invalid limit/before values naming the field', () => {
+    expect(validateMessage({type: 'list_conversations'})).toMatchObject({valid: true});
+    expect(validateMessage({type: 'list_conversations', limit: 1})).toMatchObject({valid: true});
+    expect(validateMessage({type: 'list_conversations', limit: 200})).toMatchObject({valid: true});
+
+    const badLimit0 = validateMessage({type: 'list_conversations', limit: 0});
+    expect(badLimit0.valid).toBe(false);
+    expect((badLimit0 as {valid: false; error: string}).error).toMatch(/limit/i);
+
+    const badLimit201 = validateMessage({type: 'list_conversations', limit: 201});
+    expect(badLimit201.valid).toBe(false);
+    expect((badLimit201 as {valid: false; error: string}).error).toMatch(/limit/i);
+
+    const badLimitFraction = validateMessage({type: 'list_conversations', limit: 1.5});
+    expect(badLimitFraction.valid).toBe(false);
+    expect((badLimitFraction as {valid: false; error: string}).error).toMatch(/limit/i);
+
+    const badLimitString = validateMessage({type: 'list_conversations', limit: '10'});
+    expect(badLimitString.valid).toBe(false);
+    expect((badLimitString as {valid: false; error: string}).error).toMatch(/limit/i);
+
+    const badBefore = validateMessage({type: 'list_conversations', before: 'not a date'});
+    expect(badBefore.valid).toBe(false);
+    expect((badBefore as {valid: false; error: string}).error).toMatch(/before/i);
+  });
+
+  // spec: specs/hal-engine-websocket-protocol/spec.md
+  it('with history enabled and a store with conversations, answers list_conversations with a conversation_list whose times are ISO strings, and no stream_end', async () => {
+    const {ws, sent} = fakeSocket('u1');
+    const handle = createHandlerWithHistory(noopOrchestrator(), storeWith(THREE_SUMMARIES), {history: {enabled: true}});
+
+    await handle(ws, session('u1'), {type: 'list_conversations'});
+
+    const listFrame = firstOfType(sent, 'conversation_list');
+    expect(listFrame).toBeDefined();
+    const conversations = listFrame!['conversations'] as Array<{
+      sessionId: string;
+      createdAt: unknown;
+      updatedAt: unknown;
+      entryCount: number;
+    }>;
+    expect(conversations).toHaveLength(3);
+    expect(conversations[0]!.sessionId).toBe('c3');
+
+    // Times must be ISO strings on the wire, not Date objects (Date does not survive JSON.stringify as a Date).
+    expect(typeof conversations[0]!.createdAt).toBe('string');
+    expect(typeof conversations[0]!.updatedAt).toBe('string');
+    expect(new Date(conversations[0]!.createdAt as string).toISOString()).toBe(NOW.toISOString());
+
+    // list_conversations is not a turn: no stream_end.
+    const hasStreamEnd = (sent as Array<{type: string}>).some(f => f.type === 'stream_end');
+    expect(hasStreamEnd).toBe(false);
+  });
+
+  // spec: specs/hal-engine-websocket-protocol/spec.md
+  it('uses ws.userId for the list, ignoring any userId in the frame, and passes the frame cursor to listFor', async () => {
+    const spy: {lastUserId?: string | number; lastOptions?: unknown} = {};
+    const {ws, sent} = fakeSocket('connecting-user');
+    const handle = createHandlerWithHistory(noopOrchestrator(), storeWith(THREE_SUMMARIES, spy), {
+      history: {enabled: true},
+    });
+
+    await handle(ws, session('connecting-user'), {type: 'list_conversations', userId: 'other-user', limit: 5});
+
+    // The store must be called with the connection's userId, never the frame's.
+    expect(spy.lastUserId).toBe('connecting-user');
+    expect(spy.lastUserId).not.toBe('other-user');
+
+    // limit from the frame reaches listFor.
+    const opts = spy.lastOptions as {limit?: number} | undefined;
+    expect(opts?.limit).toBe(5);
+
+    // The response is the connecting user's list, not an error.
+    expect(firstOfType(sent, 'conversation_list')).toBeDefined();
+  });
+
+  // spec: specs/hal-engine-websocket-protocol/spec.md
+  it('answers list_conversations with UNSUPPORTED when history is not enabled in config', async () => {
+    const {ws, sent} = fakeSocket('u1');
+    // No history option passed — feature is off by default.
+    const handle = createHandlerWithHistory(noopOrchestrator(), storeWith([]), undefined);
+
+    await handle(ws, session('u1'), {type: 'list_conversations'});
+
+    const errorFrame = firstOfType(sent, 'error') as {code: string} | undefined;
+    expect(errorFrame).toBeDefined();
+    expect(errorFrame!.code).toBe('UNSUPPORTED');
+    expect(firstOfType(sent, 'conversation_list')).toBeUndefined();
+  });
+
+  // spec: specs/hal-engine-websocket-protocol/spec.md
+  it('answers UNSUPPORTED when history is enabled but the store implements no listFor', async () => {
+    const {ws, sent} = fakeSocket('u1');
+    const handle = createHandlerWithHistory(noopOrchestrator(), storeWithoutListFor(), {history: {enabled: true}});
+
+    await handle(ws, session('u1'), {type: 'list_conversations'});
+
+    const errorFrame = firstOfType(sent, 'error') as {code: string} | undefined;
+    expect(errorFrame).toBeDefined();
+    expect(errorFrame!.code).toBe('UNSUPPORTED');
+    expect(firstOfType(sent, 'conversation_list')).toBeUndefined();
+  });
+});