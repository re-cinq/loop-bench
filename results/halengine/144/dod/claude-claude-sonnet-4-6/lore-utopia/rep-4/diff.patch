@@ -0,0 +1,157 @@
+import {jest} from '@jest/globals';
+import {WebSocket} from 'ws';
+import {createMessageHandler} from './messageHandler.js';
+import type {ChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import type {MessageChunk} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+import type {SessionStore, SessionSummary} from '../../types/sessionStore.js';
+import {validateMessage} from './validation.js';
+import {deferred} from '../wsTestSupport.js';
+
+// spec: specs/hal-engine-websocket-protocol/spec.md (§ 4.3 list_conversations, § 5.9 conversation_list)
+
+const STOP: MessageChunk = {type: 'stop', stopReason: 'end_turn'};
+const afterPendingWork = () => new Promise<void>(resolve => setImmediate(resolve));
+
+const makeWs = () => {
+  const sent: {type: string; [key: string]: unknown}[] = [];
+  const ws = {
+    send: (raw: string) => sent.push(JSON.parse(raw) as {type: string; [key: string]: unknown}),
+  } as unknown as WebSocket;
+  return {ws, sent};
+};
+
+const makeSession = (userId: string | number = 'u1'): ChatSession => ({
+  sessionId: 's0',
+  userId,
+  entries: [],
+});
+
+const makeStore = (summaries: SessionSummary[] = []) => {
+  const listFor = jest.fn().mockResolvedValue(summaries);
+  const store = {
+    create: async () => ({sessionId: 's0', userId: 'u1', entries: []}) as ChatSession,
+    get: async () => undefined,
+    delete: async () => false,
+    count: async () => 0,
+    clear: async () => {},
+    listFor,
+  } as unknown as SessionStore;
+  return {store, listFor};
+};
+
+describe('list_conversations WebSocket frame', () => {
+  describe('validateMessage', () => {
+    it('accepts list_conversations with no optional fields', () => {
+      const result = validateMessage({type: 'list_conversations'});
+
+      expect(result).toMatchObject({valid: true, data: {type: 'list_conversations'}});
+    });
+
+    it.each<[Record<string, unknown>, string]>([
+      [{limit: 0}, 'limit'],
+      [{limit: 201}, 'limit'],
+      [{limit: 1.5}, 'limit'],
+      [{limit: '10'}, 'limit'],
+      [{before: 'not a date'}, 'before'],
+    ])('rejects list_conversations %p and names the invalid field in the error', (fields, field) => {
+      const result = validateMessage({type: 'list_conversations', ...fields});
+
+      expect(result.valid).toBe(false);
+      if (!result.valid) expect(result.error).toMatch(field);
+    });
+  });
+
+  describe('handler', () => {
+    it('answers with conversation_list carrying ISO-string dates when history is enabled', async () => {
+      const summaries: SessionSummary[] = [
+        {
+          sessionId: 's3',
+          createdAt: new Date('2026-01-03T10:00:00Z'),
+          updatedAt: new Date('2026-01-03T12:00:00Z'),
+          entryCount: 5,
+        },
+        {
+          sessionId: 's2',
+          createdAt: new Date('2026-01-02T10:00:00Z'),
+          updatedAt: new Date('2026-01-02T12:00:00Z'),
+          entryCount: 3,
+        },
+        {
+          sessionId: 's1',
+          createdAt: new Date('2026-01-01T10:00:00Z'),
+          updatedAt: new Date('2026-01-01T12:00:00Z'),
+          entryCount: 1,
+        },
+      ];
+      const {store} = makeStore(summaries);
+      const {ws, sent} = makeWs();
+      // @ts-expect-error -- the second and third arguments are not yet part of the signature; this test is the red bar for the new api
+      const handle = createMessageHandler({} as unknown as ChatOrchestrator, store, {history: {enabled: true}});
+
+      await handle(ws, makeSession(), {type: 'list_conversations'});
+
+      type ListFrame = {conversations: {sessionId: string; createdAt: string; updatedAt: string; entryCount: number}[]};
+      const listFrame = sent.find(f => f.type === 'conversation_list') as ListFrame | undefined;
+      expect(sent.map(f => f.type)).not.toContain('stream_end');
+      expect(listFrame).toBeDefined();
+      expect(listFrame?.conversations).toHaveLength(3);
+      expect(typeof listFrame?.conversations[0].createdAt).toBe('string');
+      expect(typeof listFrame?.conversations[0].updatedAt).toBe('string');
+      expect(listFrame?.conversations[0].sessionId).toBe('s3');
+    });
+
+    it('calls listFor with the connection userId, ignoring any userId in the frame', async () => {
+      const {store, listFor} = makeStore([]);
+      const {ws} = makeWs();
+      // @ts-expect-error -- the second and third arguments are not yet part of the signature
+      const handle = createMessageHandler({} as unknown as ChatOrchestrator, store, {history: {enabled: true}});
+
+      await handle(ws, makeSession('user-A'), {type: 'list_conversations', userId: 'user-B'});
+
+      expect(listFor).toHaveBeenCalled();
+      expect(listFor.mock.calls[0][0]).toBe('user-A');
+      const calledUserIds = listFor.mock.calls.map(call => call[0]);
+      expect(calledUserIds).not.toContain('user-B');
+    });
+
+    it('answers with error code UNSUPPORTED when history is not configured', async () => {
+      const handle = createMessageHandler({} as unknown as ChatOrchestrator);
+      const {ws, sent} = makeWs();
+
+      await handle(ws, makeSession(), {type: 'list_conversations'});
+
+      const error = sent.find(f => f.type === 'error') as {code: string} | undefined;
+      expect(error?.code).toBe('UNSUPPORTED');
+      expect(sent.map(f => f.type)).not.toContain('conversation_list');
+    });
+
+    it('answers list_conversations before stream_end when a user_message is streaming on the same session', async () => {
+      const gate = deferred();
+      const {store} = makeStore([]);
+      const processMessageStream = async function* (): AsyncGenerator<MessageChunk> {
+        yield {type: 'text', text: 'thinking...'};
+        await gate.until;
+        yield STOP;
+      };
+      const orchestrator = {processMessageStream} as unknown as ChatOrchestrator;
+      // @ts-expect-error -- the second and third arguments are not yet part of the signature
+      const handle = createMessageHandler(orchestrator, store, {history: {enabled: true}});
+      const session = makeSession();
+      const {ws, sent} = makeWs();
+
+      const run = handle(ws, session, {type: 'user_message', content: 'hello'});
+      await afterPendingWork();
+
+      void handle(ws, session, {type: 'list_conversations'});
+      await afterPendingWork();
+
+      const framesBeforeStreamEnd = sent.map(f => f.type);
+      gate.release();
+      await run;
+
+      expect(framesBeforeStreamEnd).toContain('conversation_list');
+      expect(framesBeforeStreamEnd).not.toContain('stream_end');
+    });
+  });
+});