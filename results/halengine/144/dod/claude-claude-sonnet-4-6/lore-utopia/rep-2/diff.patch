new file mode 100644
index 0000000..78bd96e
--- /dev/null
+++ b/src/transport/ws/conversationList.acceptance.test.ts
@@ -0,0 +1,133 @@
+import {validateMessage} from './validation.js';
+import {createMessageHandler} from './messageHandler.js';
+import type {ChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import type {ChatSession} from '../../types/session.js';
+import type {SessionStore, SessionSummary} from '../../types/sessionStore.js';
+import type {OutgoingMessage} from '../../types/messages.js';
+import type {MessageChunk} from '../../types/ai.js';
+import {WebSocket} from 'ws';
+import {deferred} from '../wsTestSupport.js';
+
+// Extended signature the ticket adds; extra args are silently ignored until implemented.
+const makeHandler = createMessageHandler as unknown as (
+  orchestrator: ChatOrchestrator,
+  store: SessionStore,
+  options?: {history?: {enabled: boolean}}
+) => ReturnType<typeof createMessageHandler>;
+
+const FIXED = new Date('2026-01-01T00:00:00.000Z');
+const FIXED_ISO = FIXED.toISOString();
+
+function makeWs(): {ws: WebSocket; sent: OutgoingMessage[]} {
+  const sent: OutgoingMessage[] = [];
+  return {
+    ws: {send: (raw: string) => sent.push(JSON.parse(raw) as OutgoingMessage), userId: 'u1'} as unknown as WebSocket,
+    sent,
+  };
+}
+
+function makeSession(): ChatSession {
+  return {sessionId: 's1', userId: 'u1', entries: []};
+}
+
+function makeStore(ids: string[], record?: Array<string | number>): SessionStore {
+  const summaries: SessionSummary[] = ids.map(sessionId => ({
+    sessionId,
+    createdAt: FIXED,
+    updatedAt: FIXED,
+    entryCount: 0,
+  }));
+  return {
+    async create() {
+      throw new Error('unused');
+    },
+    async get() {
+      return undefined;
+    },
+    async delete() {
+      return false;
+    },
+    async count() {
+      return 0;
+    },
+    async clear() {},
+    async listFor(userId: string | number) {
+      record?.push(userId);
+      return summaries;
+    },
+  };
+}
+
+const noopOrchestrator = {
+  processMessage: async () => '',
+  async *processMessageStream(): AsyncGenerator<MessageChunk> {},
+} as unknown as ChatOrchestrator;
+
+describe('delivering a conversation list over WebSocket (re-cinq/HALEngine#144)', () => {
+  it('accepts list_conversations with no extra fields', () => {
+    expect(validateMessage({type: 'list_conversations'})).toMatchObject({valid: true});
+  });
+
+  it('rejects list_conversations with limit 0, naming the field in the error', () => {
+    expect(validateMessage({type: 'list_conversations', limit: 0})).toMatchObject({
+      valid: false,
+      error: expect.stringContaining('limit'),
+    });
+  });
+
+  it('with history enabled answers list_conversations with a conversation_list of three ISO-string summaries, calling listFor with ws.userId not the frame field', async () => {
+    const calledWith: Array<string | number> = [];
+    const {ws, sent} = makeWs();
+    const handle = makeHandler(noopOrchestrator, makeStore(['s1', 's2', 's3'], calledWith), {history: {enabled: true}});
+
+    await handle(ws, makeSession(), {type: 'list_conversations', userId: 'other'});
+
+    expect({calledWith, sent}).toEqual({
+      calledWith: ['u1'],
+      sent: [
+        {
+          type: 'conversation_list',
+          conversations: [
+            {sessionId: 's1', createdAt: FIXED_ISO, updatedAt: FIXED_ISO, entryCount: 0},
+            {sessionId: 's2', createdAt: FIXED_ISO, updatedAt: FIXED_ISO, entryCount: 0},
+            {sessionId: 's3', createdAt: FIXED_ISO, updatedAt: FIXED_ISO, entryCount: 0},
+          ],
+        },
+      ],
+    });
+  });
+
+  it('with history absent answers list_conversations with an UNSUPPORTED error frame', async () => {
+    const {ws, sent} = makeWs();
+    const handle = makeHandler(noopOrchestrator, makeStore([]), undefined);
+
+    await handle(ws, makeSession(), {type: 'list_conversations'});
+
+    expect(sent).toEqual([{type: 'error', code: 'UNSUPPORTED', message: expect.any(String)}]);
+  });
+
+  it('answers list_conversations before the in-flight stream_end when a user_message is streaming', async () => {
+    const gate = deferred();
+    const holdingOrchestrator = {
+      processMessage: async () => '',
+      async *processMessageStream(): AsyncGenerator<MessageChunk> {
+        yield {type: 'text', text: 'thinking'};
+        await gate.until;
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+    } as unknown as ChatOrchestrator;
+    const {ws, sent} = makeWs();
+    const handle = makeHandler(holdingOrchestrator, makeStore(['s1']), {history: {enabled: true}});
+    const session = makeSession();
+
+    const turn = handle(ws, session, {type: 'user_message', content: 'hello'});
+    await new Promise(resolve => setImmediate(resolve));
+    await handle(ws, session, {type: 'list_conversations'});
+
+    const typesBeforeStreamEnd = sent.map(f => f.type);
+    gate.release();
+    await turn;
+
+    expect(typesBeforeStreamEnd).toContain('conversation_list');
+  });
+});