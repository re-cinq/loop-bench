+/**
+ * Acceptance tests for re-cinq/HALEngine#144: conversation list over WebSocket.
+ *
+ * @spec specs/hal-engine-websocket-protocol/spec.md
+ */
+import {WebSocket} from 'ws';
+import {validateMessage} from './validation.js';
+import {createMessageHandler as _createMessageHandler} from './messageHandler.js';
+import type {ChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import type {ChatSession} from '../../types/session.js';
+import type {SessionStore} from '../../types/sessionStore.js';
+import {InMemorySessionStore} from '../../infrastructure/stores/inMemorySessionStore.js';
+import {deferred} from '../wsTestSupport.js';
+import type {MessageChunk} from '../../types/ai.js';
+
+// Cast to the new three-argument signature this ticket adds; the extra args are accepted at JS runtime
+// and silently ignored until the implementation lands.
+const createMessageHandler = _createMessageHandler as unknown as (
+  orchestrator: ChatOrchestrator,
+  store: SessionStore,
+  options?: {history?: {enabled: boolean}}
+) => (ws: WebSocket, session: ChatSession, rawMessage: unknown, signal?: AbortSignal) => Promise<void>;
+
+type Frame = {type: string; [key: string]: unknown};
+
+const afterPending = () => new Promise<void>(resolve => setImmediate(resolve));
+
+describe('list_conversations — WebSocket delivery (#144)', () => {
+  describe('validation', () => {
+    it('accepts {type: list_conversations} as valid, and rejects invalid limit or before with the field name', () => {
+      expect(validateMessage({type: 'list_conversations'})).toMatchObject({valid: true});
+
+      for (const badLimit of [0, 201, 1.5, '10']) {
+        expect(validateMessage({type: 'list_conversations', limit: badLimit})).toMatchObject({
+          valid: false,
+          error: expect.stringContaining('limit'),
+        });
+      }
+
+      expect(validateMessage({type: 'list_conversations', before: 'not a date'})).toMatchObject({
+        valid: false,
+        error: expect.stringContaining('before'),
+      });
+    });
+  });
+
+  describe('handler', () => {
+    const silentOrchestrator: ChatOrchestrator = {
+      processMessageStream: async function* (): AsyncGenerator<MessageChunk> {},
+    } as unknown as ChatOrchestrator;
+
+    it('answers conversation_list with ISO-string dates when history is enabled', async () => {
+      const store = new InMemorySessionStore();
+      store.create('sess-a', 'u1');
+      store.create('sess-b', 'u1');
+      store.create('sess-c', 'u1');
+
+      const handle = createMessageHandler(silentOrchestrator, store, {history: {enabled: true}});
+      const sent: Frame[] = [];
+      const ws = {userId: 'u1', send: (raw: string) => sent.push(JSON.parse(raw) as Frame)} as unknown as WebSocket;
+      const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+
+      await handle(ws, session, {type: 'list_conversations'});
+
+      const listFrame = sent.find(f => f.type === 'conversation_list') as
+        {conversations: Array<{sessionId: string; createdAt: string; updatedAt: string}>} | undefined;
+      expect(listFrame).toBeDefined();
+      expect(listFrame!.conversations).toHaveLength(3);
+      expect(sent.map(f => f.type)).not.toContain('stream_end');
+      const {createdAt, updatedAt} = listFrame!.conversations[0];
+      expect(typeof createdAt).toBe('string');
+      expect(new Date(createdAt).toISOString()).toBe(createdAt);
+      expect(typeof updatedAt).toBe('string');
+      expect(new Date(updatedAt).toISOString()).toBe(updatedAt);
+    });
+
+    it('answers UNSUPPORTED when history is not configured', async () => {
+      const store = new InMemorySessionStore();
+      const handle = createMessageHandler(silentOrchestrator, store);
+      const sent: Frame[] = [];
+      const ws = {userId: 'u1', send: (raw: string) => sent.push(JSON.parse(raw) as Frame)} as unknown as WebSocket;
+      const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+
+      await handle(ws, session, {type: 'list_conversations'});
+
+      const errFrame = sent.find(f => f.type === 'error') as {code: string} | undefined;
+      expect(errFrame).toBeDefined();
+      expect(errFrame!.code).toBe('UNSUPPORTED');
+      expect(sent.map(f => f.type)).not.toContain('conversation_list');
+    });
+
+    it("answers list_conversations before the streaming turn's stream_end, without queueing on the lock", async () => {
+      const gate = deferred();
+      const store = new InMemorySessionStore();
+      store.create('sess-u1', 'u1');
+
+      const streamingOrchestrator: ChatOrchestrator = {
+        processMessageStream: async function* (): AsyncGenerator<MessageChunk> {
+          yield {type: 'text', text: 'thinking…'};
+          await gate.until;
+          yield {type: 'stop', stopReason: 'end_turn'};
+        },
+      } as unknown as ChatOrchestrator;
+
+      const handle = createMessageHandler(streamingOrchestrator, store, {history: {enabled: true}});
+      const sent: Frame[] = [];
+      const ws = {
+        userId: 'u1',
+        readyState: WebSocket.OPEN as number,
+        send: (raw: string) => sent.push(JSON.parse(raw) as Frame),
+      } as unknown as WebSocket;
+      const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+
+      const streaming = handle(ws, session, {type: 'user_message', content: 'hello'});
+      await afterPending();
+
+      // Sent while the user_message is still streaming; must resolve before stream_end.
+      await handle(ws, session, {type: 'list_conversations'});
+
+      const listIdx = sent.findIndex(f => f.type === 'conversation_list');
+      const streamEndIdx = sent.findIndex(f => f.type === 'stream_end');
+      expect(listIdx).toBeGreaterThanOrEqual(0);
+      expect(streamEndIdx).toBe(-1); // stream_end must not have arrived yet
+
+      gate.release();
+      await streaming;
+      expect(sent.map(f => f.type)).toContain('stream_end');
+    });
+  });
+});