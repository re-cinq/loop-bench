diff --git a/src/transport/ws/conversationList.acceptance.test.ts b/src/transport/ws/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..9c334ac
--- /dev/null
+++ b/src/transport/ws/conversationList.acceptance.test.ts
@@ -0,0 +1,116 @@
+import type {ChatSession} from '../../types/session.js';
+import type {SessionStore, SessionSummary} from '../../types/sessionStore.js';
+import type {ChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import type {OutgoingMessage} from '../../types/messages.js';
+import {WebSocket} from 'ws';
+import {validateMessage} from './validation.js';
+import {createMessageHandler} from './messageHandler.js';
+
+type ListHandler = (ws: WebSocket, session: ChatSession, raw: unknown, signal?: AbortSignal) => Promise<void>;
+
+type HandlerFactory = (
+  orchestrator: ChatOrchestrator,
+  store?: SessionStore,
+  opts?: {history?: {enabled: boolean}}
+) => ListHandler;
+
+const makeHandler = createMessageHandler as unknown as HandlerFactory;
+
+function makeSummary(id: string, created: string, updated: string, count: number): SessionSummary {
+  return {sessionId: id, createdAt: new Date(created), updatedAt: new Date(updated), entryCount: count};
+}
+
+function minimalStore(extra?: Partial<SessionStore>): SessionStore {
+  return {
+    create: async () => ({sessionId: 'x', userId: 'u1', entries: []}),
+    get: async () => undefined,
+    delete: async () => false,
+    count: async () => 0,
+    clear: async () => {},
+    ...extra,
+  };
+}
+
+function fakeWs(): {ws: WebSocket; sent: OutgoingMessage[]} {
+  const sent: OutgoingMessage[] = [];
+  const ws = {send: (raw: string) => sent.push(JSON.parse(raw) as OutgoingMessage)} as unknown as WebSocket;
+  return {ws, sent};
+}
+
+function newSession(): ChatSession {
+  return {sessionId: 's1', userId: 'u1', entries: []};
+}
+
+describe('conversation list over WebSocket', () => {
+  it('validateMessage accepts list_conversations and rejects invalid limit and before values', () => {
+    expect({
+      base: validateMessage({type: 'list_conversations'}),
+      limitZero: validateMessage({type: 'list_conversations', limit: 0}),
+      limitTooHigh: validateMessage({type: 'list_conversations', limit: 201}),
+      limitFractional: validateMessage({type: 'list_conversations', limit: 1.5}),
+      limitString: validateMessage({type: 'list_conversations', limit: '10'}),
+      beforeString: validateMessage({type: 'list_conversations', before: 'not a date'}),
+    }).toMatchObject({
+      base: {valid: true},
+      limitZero: {valid: false, error: expect.stringContaining('limit')},
+      limitTooHigh: {valid: false, error: expect.stringContaining('limit')},
+      limitFractional: {valid: false, error: expect.stringContaining('limit')},
+      limitString: {valid: false, error: expect.stringContaining('limit')},
+      beforeString: {valid: false, error: expect.stringContaining('before')},
+    });
+  });
+
+  it('with history enabled, answers list_conversations with a conversation_list of ISO-stamped summaries', async () => {
+    const isoDate = expect.stringMatching(/^\d{4}-/);
+    const summaries: SessionSummary[] = [
+      makeSummary('s3', '2026-01-03T00:00:00Z', '2026-01-03T10:00:00Z', 5),
+      makeSummary('s2', '2026-01-02T00:00:00Z', '2026-01-02T10:00:00Z', 3),
+      makeSummary('s1', '2026-01-01T00:00:00Z', '2026-01-01T10:00:00Z', 1),
+    ];
+    const store = minimalStore({listFor: async () => summaries});
+    const orchestrator = {} as unknown as ChatOrchestrator;
+    const {ws, sent} = fakeWs();
+
+    const handle = makeHandler(orchestrator, store, {history: {enabled: true}});
+    await handle(ws, newSession(), {type: 'list_conversations'});
+
+    expect(sent).toEqual([
+      {
+        type: 'conversation_list',
+        conversations: [
+          {sessionId: 's3', createdAt: isoDate, updatedAt: isoDate, entryCount: 5},
+          {sessionId: 's2', createdAt: isoDate, updatedAt: isoDate, entryCount: 3},
+          {sessionId: 's1', createdAt: isoDate, updatedAt: isoDate, entryCount: 1},
+        ],
+      },
+    ]);
+  });
+
+  it('calls listFor with the session userId, ignoring any userId field in the frame', async () => {
+    let capturedUserId: string | number | undefined;
+    const store = minimalStore({
+      listFor: async userId => {
+        capturedUserId = userId;
+        return [];
+      },
+    });
+    const orchestrator = {} as unknown as ChatOrchestrator;
+    const {ws} = fakeWs();
+
+    const handle = makeHandler(orchestrator, store, {history: {enabled: true}});
+    await handle(ws, newSession(), {type: 'list_conversations', userId: 'u-other'});
+
+    expect(capturedUserId).toBe('u1');
+  });
+
+  it('with history absent, answers list_conversations with UNSUPPORTED error and no conversation_list', async () => {
+    const store = minimalStore();
+    const orchestrator = {} as unknown as ChatOrchestrator;
+    const {ws, sent} = fakeWs();
+
+    const handle = makeHandler(orchestrator, store);
+    await handle(ws, newSession(), {type: 'list_conversations'});
+
+    expect(sent).toEqual([{type: 'error', code: 'UNSUPPORTED', message: expect.any(String)}]);
+  });
+});