+import {validateMessage} from './validation.js';
+import {createMessageHandler} from './messageHandler.js';
+import {InMemorySessionStore} from '../../infrastructure/stores/inMemorySessionStore.js';
+import type {ChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import type {SessionStore} from '../../types/sessionStore.js';
+import type {ChatSession} from '../../types/session.js';
+import {WebSocket} from 'ws';
+
+// Never called — these tests send list_conversations, not user_message.
+const noop: ChatOrchestrator = {
+  processMessage: async () => '',
+  async *processMessageStream() {},
+};
+
+// Future signature: createMessageHandler gains (store, options) when the ticket lands.
+// The cast lets the tests compile and fail on behaviour, not on a missing overload.
+type FutureCreateMessageHandler = (
+  orchestrator: ChatOrchestrator,
+  store: SessionStore,
+  options?: {history?: {enabled: boolean}}
+) => ReturnType<typeof createMessageHandler>;
+
+const createHandlerWith = createMessageHandler as unknown as FutureCreateMessageHandler;
+
+function collectFrames(): {ws: WebSocket; frames: () => Array<Record<string, unknown>>} {
+  const sent: Array<Record<string, unknown>> = [];
+  const ws = {
+    send: (raw: string) => sent.push(JSON.parse(raw) as Record<string, unknown>),
+  } as unknown as WebSocket;
+  return {ws, frames: () => sent};
+}
+
+// specs/hal-engine-websocket-protocol — conversation list section (to be added during implementation)
+describe('conversation list over WebSocket (acceptance)', () => {
+  it('accepts a bare list_conversations frame and rejects one with an out-of-range limit', () => {
+    expect(validateMessage({type: 'list_conversations'})).toMatchObject({valid: true});
+
+    const tooLow = validateMessage({type: 'list_conversations', limit: 0});
+    expect(tooLow).toMatchObject({valid: false, error: expect.stringContaining('limit')});
+
+    const tooHigh = validateMessage({type: 'list_conversations', limit: 201});
+    expect(tooHigh).toMatchObject({valid: false, error: expect.stringContaining('limit')});
+  });
+
+  it('answers list_conversations with one conversation_list frame when history is enabled, using the connection userId', async () => {
+    const store = new InMemorySessionStore();
+    store.create('s1', 'u1');
+    store.create('s2', 'u1');
+    store.create('s3', 'u1');
+    store.create('sX', 'other'); // must not appear in u1's list
+
+    const handle = createHandlerWith(noop, store, {history: {enabled: true}});
+    const {ws, frames} = collectFrames();
+    const session: ChatSession = {sessionId: 'conn1', userId: 'u1', entries: []};
+
+    // frame carries a spurious userId — the list must be the connection owner's, never the frame field's
+    await handle(ws, session, {type: 'list_conversations', userId: 'other'});
+
+    const all = frames();
+    const listFrame = all.find(f => f.type === 'conversation_list') as
+      {conversations: Array<{createdAt: unknown; updatedAt: unknown}>} | undefined;
+
+    expect(listFrame).toBeDefined();
+    expect(listFrame!.conversations).toHaveLength(3);
+    expect(all.some(f => f.type === 'stream_end')).toBe(false);
+    expect(typeof listFrame!.conversations[0].createdAt).toBe('string');
+    expect(typeof listFrame!.conversations[0].updatedAt).toBe('string');
+  });
+
+  it('answers list_conversations with an UNSUPPORTED error when history is not configured', async () => {
+    const store = new InMemorySessionStore();
+    const handle = createHandlerWith(noop, store); // no history option
+
+    const {ws, frames} = collectFrames();
+    const session: ChatSession = {sessionId: 'conn1', userId: 'u1', entries: []};
+
+    await handle(ws, session, {type: 'list_conversations'});
+
+    const all = frames();
+    const err = all.find(f => f.type === 'error') as {code: string} | undefined;
+
+    expect(err?.code).toBe('UNSUPPORTED');
+    expect(all.some(f => f.type === 'conversation_list')).toBe(false);
+  });
+});