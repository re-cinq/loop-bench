@@ -0,0 +1,169 @@
+import {jest} from '@jest/globals';
+import {WebSocket} from 'ws';
+import {validateMessage} from './validation.js';
+import {createMessageHandler} from './messageHandler.js';
+import type {ChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import type {ChatSession} from '../../types/session.js';
+import type {OutgoingMessage} from '../../types/messages.js';
+import type {SessionStore, SessionSummary} from '../../types/sessionStore.js';
+import type {MessageChunk} from '../../types/ai.js';
+import {deferred} from '../wsTestSupport.js';
+
+// Acceptance tests for re-cinq/HALEngine#144: deliver a user's conversation list over WebSocket.
+// Central claim: a client holding an authenticated socket has no way to ask "which conversations
+// do I have?" without the consumer standing up a second authenticated HTTP route. These tests
+// define done: list_conversations → conversation_list over the same socket.
+
+// createMessageHandler will gain (orchestrator, store, options) once the feature is implemented.
+// Until then the extra args are ignored and all five tests fail for the right reason.
+type ExtendedHandlerFactory = (
+  orchestrator: ChatOrchestrator,
+  store: Partial<SessionStore>,
+  options?: {history?: {enabled: boolean}}
+) => (ws: WebSocket, session: ChatSession, raw: unknown, signal?: AbortSignal) => Promise<void>;
+
+const createHandler = createMessageHandler as unknown as ExtendedHandlerFactory;
+
+const STOP: MessageChunk = {type: 'stop', stopReason: 'end_turn'};
+const afterPendingWork = () => new Promise(resolve => setImmediate(resolve));
+
+const NOW = new Date('2026-01-03T10:00:00.000Z');
+const OLDER = new Date('2026-01-02T10:00:00.000Z');
+const OLDEST = new Date('2026-01-01T10:00:00.000Z');
+
+const threeConversations: SessionSummary[] = [
+  {sessionId: 's3', createdAt: OLDEST, updatedAt: NOW, entryCount: 5},
+  {sessionId: 's2', createdAt: OLDEST, updatedAt: OLDER, entryCount: 2},
+  {sessionId: 's1', createdAt: OLDEST, updatedAt: OLDEST, entryCount: 1},
+];
+
+const makeWs = (userId: string | number = 'u1') => {
+  const sent: OutgoingMessage[] = [];
+  const ws = {
+    send: (raw: string) => sent.push(JSON.parse(raw) as OutgoingMessage),
+    readyState: WebSocket.OPEN as number,
+    userId,
+  } as unknown as WebSocket;
+  return {ws, sent};
+};
+
+const makeOrchestrator = () => ({processMessageStream: jest.fn(async function* () {})}) as unknown as ChatOrchestrator;
+
+describe('conversation list over WebSocket (re-cinq/HALEngine#144)', () => {
+  it('list_conversations validation: accepts a bare frame and rejects invalid limit and before values naming the field', () => {
+    expect(validateMessage({type: 'list_conversations'})).toMatchObject({valid: true});
+    expect(validateMessage({type: 'list_conversations', limit: 1})).toMatchObject({valid: true});
+    expect(validateMessage({type: 'list_conversations', limit: 200})).toMatchObject({valid: true});
+
+    const badLimit0 = validateMessage({type: 'list_conversations', limit: 0}) as {valid: false; error: string};
+    expect(badLimit0.valid).toBe(false);
+    expect(badLimit0.error).toMatch(/limit/);
+
+    const badLimit201 = validateMessage({type: 'list_conversations', limit: 201}) as {valid: false; error: string};
+    expect(badLimit201.valid).toBe(false);
+    expect(badLimit201.error).toMatch(/limit/);
+
+    const badLimitFloat = validateMessage({type: 'list_conversations', limit: 1.5}) as {valid: false; error: string};
+    expect(badLimitFloat.valid).toBe(false);
+    expect(badLimitFloat.error).toMatch(/limit/);
+
+    const badLimitStr = validateMessage({type: 'list_conversations', limit: '10'}) as {valid: false; error: string};
+    expect(badLimitStr.valid).toBe(false);
+    expect(badLimitStr.error).toMatch(/limit/);
+
+    const badBefore = validateMessage({type: 'list_conversations', before: 'not a date'}) as {
+      valid: false;
+      error: string;
+    };
+    expect(badBefore.valid).toBe(false);
+    expect(badBefore.error).toMatch(/before/);
+  });
+
+  it('with history enabled answers list_conversations with conversation_list carrying summaries newest first with ISO times and no stream_end', async () => {
+    const {ws, sent} = makeWs('u1');
+    const listFor = jest.fn(async () => threeConversations);
+    const store: Partial<SessionStore> = {listFor: listFor as unknown as SessionStore['listFor']};
+    const session: ChatSession = {sessionId: 's-conn', userId: 'u1', entries: []};
+
+    const handle = createHandler(makeOrchestrator(), store, {history: {enabled: true}});
+    await handle(ws, session, {type: 'list_conversations'});
+
+    const listFrame = sent.find(f => f.type === 'conversation_list') as Record<string, unknown> | undefined;
+
+    expect(listFrame).toBeDefined();
+
+    const conversations = listFrame?.conversations as
+      Array<{sessionId: string; createdAt: string; updatedAt: string; entryCount: number}> | undefined;
+
+    expect(conversations).toHaveLength(3);
+    expect(conversations?.[0].sessionId).toBe('s3');
+    expect(conversations?.[0].updatedAt).toBe(NOW.toISOString());
+    expect(typeof conversations?.[0].createdAt).toBe('string');
+    expect(sent.some(f => f.type === 'stream_end')).toBe(false);
+  });
+
+  it('frame userId is ignored: listFor is called with the socket user id, not a userId carried in the frame', async () => {
+    const {ws, sent} = makeWs('u1');
+    const listFor = jest.fn(async () => threeConversations);
+    const store: Partial<SessionStore> = {listFor: listFor as unknown as SessionStore['listFor']};
+    const session: ChatSession = {sessionId: 's-conn', userId: 'u1', entries: []};
+
+    const handle = createHandler(makeOrchestrator(), store, {history: {enabled: true}});
+    await handle(ws, session, {type: 'list_conversations', userId: 'other-user'});
+
+    // listFor must receive the authenticated socket user id, never the frame field
+    expect(listFor).toHaveBeenCalledWith('u1', expect.anything());
+    expect(sent.some(f => f.type === 'conversation_list')).toBe(true);
+  });
+
+  it('without history config answers list_conversations with UNSUPPORTED error and no conversation_list', async () => {
+    const {ws, sent} = makeWs('u1');
+    const store: Partial<SessionStore> = {
+      listFor: jest.fn(async () => threeConversations) as unknown as SessionStore['listFor'],
+    };
+    const session: ChatSession = {sessionId: 's-conn', userId: 'u1', entries: []};
+
+    const handle = createHandler(makeOrchestrator(), store);
+    await handle(ws, session, {type: 'list_conversations'});
+
+    const errorFrame = sent.find(f => f.type === 'error') as {type: 'error'; code: string} | undefined;
+    expect(errorFrame?.code).toBe('UNSUPPORTED');
+    expect(sent.some(f => f.type === 'conversation_list')).toBe(false);
+  });
+
+  it('list_conversations is answered before the stream_end of a concurrent user_message: not waiting on the session lock', async () => {
+    const sent: OutgoingMessage[] = [];
+    const socket = {
+      readyState: WebSocket.OPEN as number,
+      send: (raw: string) => sent.push(JSON.parse(raw) as OutgoingMessage),
+      userId: 'u1',
+    };
+    const ws = socket as unknown as WebSocket;
+
+    const gate = deferred();
+    const processMessageStream = async function* (): AsyncGenerator<MessageChunk> {
+      yield {type: 'text', text: 'thinking...'};
+      await gate.until;
+      yield STOP;
+    };
+    const listFor = jest.fn(async () => threeConversations);
+    const store: Partial<SessionStore> = {listFor: listFor as unknown as SessionStore['listFor']};
+    const orchestrator = {processMessageStream} as unknown as ChatOrchestrator;
+    const session: ChatSession = {sessionId: 's-lock', userId: 'u1', entries: []};
+
+    const handle = createHandler(orchestrator, store, {history: {enabled: true}});
+    const streaming = handle(ws, session, {type: 'user_message', content: 'hello'});
+    await afterPendingWork();
+
+    void handle(ws, session, {type: 'list_conversations'});
+    await afterPendingWork();
+
+    const typesBeforeRelease = sent.map(f => f.type);
+    gate.release();
+    await streaming;
+
+    // conversation_list must be present before stream_end fires for the user_message
+    expect(typesBeforeRelease).toContain('conversation_list');
+    expect(typesBeforeRelease).not.toContain('stream_end');
+  });
+});