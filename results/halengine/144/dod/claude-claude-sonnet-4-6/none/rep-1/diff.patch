+import {jest} from '@jest/globals';
+import {WebSocket} from 'ws';
+import {validateMessage} from './validation.js';
+import {createMessageHandler as _createMessageHandler} from './messageHandler.js';
+import type {ChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import type {ChatSession} from '../../types/session.js';
+import type {SessionStore, SessionSummary} from '../../types/sessionStore.js';
+import type {MessageChunk} from '../../types/ai.js';
+import {deferred} from '../wsTestSupport.js';
+
+// Cast to expected post-ticket signature; at runtime the extra args are ignored until the feature lands.
+const createMessageHandler = _createMessageHandler as unknown as (
+  orchestrator: ChatOrchestrator,
+  store: SessionStore,
+  options?: {history?: {enabled: boolean}}
+) => (ws: WebSocket, session: ChatSession, raw: unknown, signal?: AbortSignal) => Promise<void>;
+
+const STOP: MessageChunk = {type: 'stop', stopReason: 'end_turn'};
+
+const SUMMARIES: SessionSummary[] = [
+  {
+    sessionId: 's3',
+    createdAt: new Date('2024-01-03T00:00:00Z'),
+    updatedAt: new Date('2024-01-03T00:00:00Z'),
+    entryCount: 2,
+  },
+  {
+    sessionId: 's2',
+    createdAt: new Date('2024-01-02T00:00:00Z'),
+    updatedAt: new Date('2024-01-02T00:00:00Z'),
+    entryCount: 1,
+  },
+  {
+    sessionId: 's1',
+    createdAt: new Date('2024-01-01T00:00:00Z'),
+    updatedAt: new Date('2024-01-01T00:00:00Z'),
+    entryCount: 0,
+  },
+];
+
+function makeStore(summaries: SessionSummary[] = SUMMARIES, includeListFor = true): SessionStore {
+  const store: Record<string, unknown> = {
+    create: async (id: string, userId: string | number) => ({sessionId: id, userId, entries: []}),
+    get: async () => undefined,
+    delete: async () => true,
+    count: async () => 0,
+    clear: async () => {},
+  };
+  if (includeListFor) {
+    store.listFor = jest.fn(async () => summaries);
+  }
+  return store as unknown as SessionStore;
+}
+
+function makeOrchestrator(pause?: Promise<void>): ChatOrchestrator {
+  return {
+    async *processMessageStream(): AsyncGenerator<MessageChunk> {
+      yield {type: 'text', text: 'thinking'};
+      if (pause) await pause;
+      yield STOP;
+    },
+  } as unknown as ChatOrchestrator;
+}
+
+function makeWs(): {ws: WebSocket; sent: Array<Record<string, unknown>>} {
+  const sent: Array<Record<string, unknown>> = [];
+  const ws = {send: (raw: string) => sent.push(JSON.parse(raw) as Record<string, unknown>)} as unknown as WebSocket;
+  return {ws, sent};
+}
+
+function session(userId: string | number = 'u1'): ChatSession {
+  return {sessionId: 's1', userId, entries: []};
+}
+
+describe('list_conversations acceptance', () => {
+  it('accepts list_conversations as valid and rejects it with any bad limit or non-object before, naming the field', () => {
+    expect({
+      bare: validateMessage({type: 'list_conversations'}),
+      limitZero: validateMessage({type: 'list_conversations', limit: 0}),
+      limitOverMax: validateMessage({type: 'list_conversations', limit: 201}),
+      limitFractional: validateMessage({type: 'list_conversations', limit: 1.5}),
+      limitString: validateMessage({type: 'list_conversations', limit: '10'}),
+      beforeString: validateMessage({type: 'list_conversations', before: 'not a date'}),
+    }).toMatchObject({
+      bare: {valid: true},
+      limitZero: {valid: false, error: expect.stringContaining('limit')},
+      limitOverMax: {valid: false, error: expect.stringContaining('limit')},
+      limitFractional: {valid: false, error: expect.stringContaining('limit')},
+      limitString: {valid: false, error: expect.stringContaining('limit')},
+      beforeString: {valid: false, error: expect.stringContaining('before')},
+    });
+  });
+
+  it('with history enabled and three conversations in the store, answers list_conversations with one conversation_list carrying three summaries with ISO string dates and no stream_end', async () => {
+    const {ws, sent} = makeWs();
+    const handle = createMessageHandler(makeOrchestrator(), makeStore(), {history: {enabled: true}});
+
+    await handle(ws, session(), {type: 'list_conversations'});
+
+    const list = sent.find(f => f.type === 'conversation_list') as
+      {type: string; conversations: Array<{createdAt: unknown; updatedAt: unknown}>} | undefined;
+    expect({
+      listFrameCount: sent.filter(f => f.type === 'conversation_list').length,
+      streamEndCount: sent.filter(f => f.type === 'stream_end').length,
+      summaryCount: list?.conversations?.length,
+      createdAtType: typeof list?.conversations?.[0]?.createdAt,
+      updatedAtType: typeof list?.conversations?.[0]?.updatedAt,
+    }).toEqual({
+      listFrameCount: 1,
+      streamEndCount: 0,
+      summaryCount: 3,
+      createdAtType: 'string',
+      updatedAtType: 'string',
+    });
+  });
+
+  it('calls listFor with session.userId regardless of a userId field in the frame, forwarding limit and before', async () => {
+    const store = makeStore();
+    const {ws, sent} = makeWs();
+    const handle = createMessageHandler(makeOrchestrator(), store, {history: {enabled: true}});
+    const before = {updatedAt: '2024-01-02T00:00:00Z', sessionId: 's2'};
+
+    await handle(ws, session('u1'), {type: 'list_conversations', userId: 'other-user', limit: 5, before});
+
+    const listFor = (store as unknown as {listFor: jest.Mock}).listFor;
+    expect({
+      calledWithUserId: listFor.mock.calls[0]?.[0],
+      calledWithOptions: listFor.mock.calls[0]?.[1],
+      hasConvList: sent.some(f => f.type === 'conversation_list'),
+    }).toEqual({
+      calledWithUserId: 'u1',
+      calledWithOptions: {limit: 5, before},
+      hasConvList: true,
+    });
+  });
+
+  it('with history absent answers UNSUPPORTED and no conversation_list; with history on but no listFor on the store, also UNSUPPORTED', async () => {
+    const {ws: ws1, sent: sent1} = makeWs();
+    const handle1 = createMessageHandler(makeOrchestrator(), makeStore());
+    await handle1(ws1, session(), {type: 'list_conversations'});
+
+    const {ws: ws2, sent: sent2} = makeWs();
+    const handle2 = createMessageHandler(makeOrchestrator(), makeStore([], false), {history: {enabled: true}});
+    await handle2(ws2, session(), {type: 'list_conversations'});
+
+    expect({
+      historyAbsentCode: (sent1.find(f => f.type === 'error') as {code?: string} | undefined)?.code,
+      historyAbsentHasConvList: sent1.some(f => f.type === 'conversation_list'),
+      noListForCode: (sent2.find(f => f.type === 'error') as {code?: string} | undefined)?.code,
+      noListForHasConvList: sent2.some(f => f.type === 'conversation_list'),
+    }).toEqual({
+      historyAbsentCode: 'UNSUPPORTED',
+      historyAbsentHasConvList: false,
+      noListForCode: 'UNSUPPORTED',
+      noListForHasConvList: false,
+    });
+  });
+
+  it('answers list_conversations while a user_message is streaming, before that stream_end', async () => {
+    const gate = deferred();
+    const {ws, sent} = makeWs();
+    const handle = createMessageHandler(makeOrchestrator(gate.until), makeStore(), {history: {enabled: true}});
+    const sess = session();
+
+    const run = handle(ws, sess, {type: 'user_message', content: 'hello'});
+    await new Promise(resolve => setImmediate(resolve));
+
+    await handle(ws, sess, {type: 'list_conversations'});
+
+    const beforeRelease = [...sent];
+    gate.release();
+    await run;
+
+    expect({
+      hasConvListBeforeEnd: beforeRelease.some(f => f.type === 'conversation_list'),
+      hasStreamEndBeforeEnd: beforeRelease.some(f => f.type === 'stream_end'),
+    }).toEqual({
+      hasConvListBeforeEnd: true,
+      hasStreamEndBeforeEnd: false,
+    });
+  });
+});