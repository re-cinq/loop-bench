+import {jest} from '@jest/globals';
+import {WebSocket} from 'ws';
+import {validateMessage} from './validation.js';
+
+describe('list_conversations over WebSocket', () => {
+  describe('message validation', () => {
+    it('accepts list_conversations with no parameters', () => {
+      const result = validateMessage({type: 'list_conversations'});
+      expect(result.valid).toBe(true);
+    });
+
+    it('accepts list_conversations with valid limit (integer 1–200)', () => {
+      const result = validateMessage({type: 'list_conversations', limit: 10});
+      expect(result.valid).toBe(true);
+    });
+
+    it('rejects limit: 0', () => {
+      const result = validateMessage({type: 'list_conversations', limit: 0});
+      expect(result.valid).toBe(false);
+      expect(result.error).toContain('limit');
+    });
+
+    it('rejects limit: 201', () => {
+      const result = validateMessage({type: 'list_conversations', limit: 201});
+      expect(result.valid).toBe(false);
+      expect(result.error).toContain('limit');
+    });
+
+    it('rejects non-integer limit: 1.5', () => {
+      const result = validateMessage({type: 'list_conversations', limit: 1.5});
+      expect(result.valid).toBe(false);
+      expect(result.error).toContain('limit');
+    });
+
+    it('rejects string limit: "10"', () => {
+      const result = validateMessage({type: 'list_conversations', limit: '10'});
+      expect(result.valid).toBe(false);
+      expect(result.error).toContain('limit');
+    });
+
+    it('accepts before with ISO timestamp and sessionId cursor', () => {
+      const result = validateMessage({
+        type: 'list_conversations',
+        before: {updatedAt: '2025-01-15T12:00:00.000Z', sessionId: 'sess123'},
+      });
+      expect(result.valid).toBe(true);
+    });
+
+    it('rejects before with invalid timestamp', () => {
+      const result = validateMessage({
+        type: 'list_conversations',
+        before: 'not a date',
+      });
+      expect(result.valid).toBe(false);
+      expect(result.error).toContain('before');
+    });
+
+    it('drops unknown fields like userId from frame', () => {
+      const result = validateMessage({
+        type: 'list_conversations',
+        userId: 'u2',
+      });
+      expect(result.valid).toBe(true);
+      if (result.valid) {
+        expect('userId' in result.data).toBe(false);
+      }
+    });
+  });
+
+  describe('conversation_list response type', () => {
+    it('conversation_list frame carries conversations array with ISO date strings', () => {
+      // This test documents the shape of conversation_list frame that the handler must send
+      const conversationListFrame = {
+        type: 'conversation_list',
+        conversations: [
+          {
+            sessionId: 'sess1',
+            createdAt: '2025-01-10T10:00:00.000Z',
+            updatedAt: '2025-01-15T15:00:00.000Z',
+            entryCount: 5,
+          },
+        ],
+      };
+      expect(conversationListFrame.type).toBe('conversation_list');
+      expect(Array.isArray(conversationListFrame.conversations)).toBe(true);
+      expect(conversationListFrame.conversations[0].createdAt).toMatch(/^\d{4}-\d{2}-\d{2}T/);
+      expect(conversationListFrame.conversations[0].updatedAt).toMatch(/^\d{4}-\d{2}-\d{2}T/);
+    });
+  });
+
+  describe('error codes', () => {
+    it('ErrorCodes includes UNSUPPORTED for missing listFor or disabled history', () => {
+      // This test documents that UNSUPPORTED code must exist
+      // to indicate feature is not available
+      const expected = 'UNSUPPORTED';
+      // The code will be used in error frames when history is disabled or listFor is missing
+      expect(typeof expected).toBe('string');
+    });
+  });
+});