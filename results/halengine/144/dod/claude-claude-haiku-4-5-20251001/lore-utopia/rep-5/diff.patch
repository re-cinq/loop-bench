+import {jest} from '@jest/globals';
+import type {WebSocket} from 'ws';
+import {createMessageHandler} from './messageHandler.js';
+import {createChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import type {ChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import {ToolRegistry} from '../../orchestration/tools/registry.js';
+import {PromptBuilder} from '../../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../../types/ai.js';
+import type {ChatSession, AuthenticatedUser} from '../../types/session.js';
+import type {OutgoingMessage} from '../../types/messages.js';
+import {validateMessage} from './validation.js';
+import {PerSessionLock} from '../../shared/perSessionLock.js';
+import type {SessionStore, SessionSummary, SessionListOptions} from '../../types/sessionStore.js';
+import {deferred} from '../wsTestSupport.js';
+
+describe('conversation list over websocket', () => {
+  describe('message validation', () => {
+    it('accepts list_conversations with no parameters', () => {
+      const result = validateMessage({type: 'list_conversations'});
+
+      expect(result.valid).toBe(true);
+      if (result.valid) {
+        expect(result.data.type).toBe('list_conversations');
+      }
+    });
+
+    it('accepts list_conversations with valid limit (1-200)', () => {
+      const result = validateMessage({type: 'list_conversations', limit: 10});
+
+      expect(result.valid).toBe(true);
+      if (result.valid) {
+        expect(result.data).toMatchObject({type: 'list_conversations', limit: 10});
+      }
+    });
+
+    it('accepts list_conversations with valid before cursor', () => {
+      const cursor = {updatedAt: '2026-01-15T14:30:00Z', sessionId: 'sess-123'};
+      const result = validateMessage({type: 'list_conversations', before: cursor});
+
+      expect(result.valid).toBe(true);
+      if (result.valid) {
+        expect(result.data).toMatchObject({type: 'list_conversations', before: cursor});
+      }
+    });
+
+    it('rejects list_conversations with limit: 0', () => {
+      const result = validateMessage({type: 'list_conversations', limit: 0});
+
+      expect(result.valid).toBe(false);
+      if (!result.valid) {
+        expect(result.error).toContain('limit');
+      }
+    });
+
+    it('rejects list_conversations with limit: 201', () => {
+      const result = validateMessage({type: 'list_conversations', limit: 201});
+
+      expect(result.valid).toBe(false);
+      if (!result.valid) {
+        expect(result.error).toContain('limit');
+      }
+    });
+
+    it('rejects list_conversations with limit: 1.5 (non-integer)', () => {
+      const result = validateMessage({type: 'list_conversations', limit: 1.5});
+
+      expect(result.valid).toBe(false);
+      if (!result.valid) {
+        expect(result.error).toContain('limit');
+      }
+    });
+
+    it('rejects list_conversations with limit as string', () => {
+      const result = validateMessage({type: 'list_conversations', limit: '10'});
+
+      expect(result.valid).toBe(false);
+      if (!result.valid) {
+        expect(result.error).toContain('limit');
+      }
+    });
+
+    it('rejects list_conversations with invalid before cursor date', () => {
+      const cursor = {updatedAt: 'not a date', sessionId: 'sess-123'};
+      const result = validateMessage({type: 'list_conversations', before: cursor});
+
+      expect(result.valid).toBe(false);
+      if (!result.valid) {
+        expect(result.error).toContain('before');
+      }
+    });
+  });
+
+  describe('server response with history enabled', () => {
+    const harness = (
+      storeListFor?: jest.Mock<(userId: string | number, options?: SessionListOptions) => Promise<SessionSummary[]>>,
+      useSessionLock: boolean = false
+    ) => {
+      const sent: OutgoingMessage[] = [];
+      const ws = {
+        send: (raw: string) => sent.push(JSON.parse(raw) as OutgoingMessage),
+        userId: 'user-123',
+      } as unknown as WebSocket;
+
+      const orchestrator = {
+        processMessageStream: jest.fn(),
+      } as unknown as ChatOrchestrator;
+
+      const session: ChatSession = {sessionId: 's1', userId: 'user-123', entries: []};
+
+      // Create message handler with history enabled
+      const store = {
+        create: jest.fn(),
+        get: jest.fn(),
+        delete: jest.fn(),
+        count: jest.fn(),
+        clear: jest.fn(),
+        listFor: storeListFor,
+      } as unknown as SessionStore;
+
+      const handle = createMessageHandler(orchestrator, store, {history: {enabled: true}}, useSessionLock ? new PerSessionLock() : undefined);
+
+      return {
+        session,
+        sent,
+        ws,
+        handle,
+        store,
+      };
+    };
+
+    it('responds with conversation_list when store has conversations', async () => {
+      const summaries: SessionSummary[] = [
+        {sessionId: 'sess-1', createdAt: new Date('2026-01-15T15:00:00Z'), updatedAt: new Date('2026-01-15T15:05:00Z'), entryCount: 5},
+        {sessionId: 'sess-2', createdAt: new Date('2026-01-14T10:00:00Z'), updatedAt: new Date('2026-01-14T14:00:00Z'), entryCount: 3},
+        {sessionId: 'sess-3', createdAt: new Date('2026-01-13T09:00:00Z'), updatedAt: new Date('2026-01-13T11:00:00Z'), entryCount: 1},
+      ];
+
+      const listFor = jest.fn().mockResolvedValue(summaries);
+      const h = harness(listFor);
+
+      await h.handle(h.ws, h.session, {type: 'list_conversations'});
+
+      expect(h.sent).toHaveLength(1);
+      expect(h.sent[0]).toMatchObject({type: 'conversation_list'});
+      if ('conversations' in h.sent[0]) {
+        expect(h.sent[0].conversations).toHaveLength(3);
+        expect((h.sent[0].conversations as SessionSummary[])[0]).toMatchObject({
+          sessionId: 'sess-1',
+          entryCount: 5,
+        });
+        // Check that dates are ISO strings
+        expect(typeof (h.sent[0].conversations as SessionSummary[])[0].createdAt).toBe('string');
+        expect(typeof (h.sent[0].conversations as SessionSummary[])[0].updatedAt).toBe('string');
+      }
+    });
+
+    it('ignores userId in frame and uses ws.userId', async () => {
+      const listFor = jest.fn().mockResolvedValue([]);
+      const h = harness(listFor);
+
+      await h.handle(h.ws, h.session, {type: 'list_conversations', userId: 'attacker-user'});
+
+      expect(listFor).toHaveBeenCalledWith('user-123', expect.any(Object));
+      expect(listFor).not.toHaveBeenCalledWith('attacker-user', expect.any(Object));
+    });
+
+    it('passes limit and before to store listFor', async () => {
+      const listFor = jest.fn().mockResolvedValue([]);
+      const h = harness(listFor);
+
+      const cursor = {updatedAt: '2026-01-15T14:30:00Z', sessionId: 'sess-123'};
+      await h.handle(h.ws, h.session, {type: 'list_conversations', limit: 10, before: cursor});
+
+      expect(listFor).toHaveBeenCalledWith('user-123', {limit: 10, before: cursor});
+    });
+
+    it('returns empty conversation_list when store has no conversations', async () => {
+      const listFor = jest.fn().mockResolvedValue([]);
+      const h = harness(listFor);
+
+      await h.handle(h.ws, h.session, {type: 'list_conversations'});
+
+      expect(h.sent).toHaveLength(1);
+      expect(h.sent[0]).toMatchObject({type: 'conversation_list'});
+      if ('conversations' in h.sent[0]) {
+        expect((h.sent[0].conversations as SessionSummary[])).toHaveLength(0);
+      }
+    });
+
+    it('does not send stream_end after conversation_list', async () => {
+      const listFor = jest.fn().mockResolvedValue([
+        {sessionId: 'sess-1', createdAt: new Date(), updatedAt: new Date(), entryCount: 1},
+      ]);
+      const h = harness(listFor);
+
+      await h.handle(h.ws, h.session, {type: 'list_conversations'});
+
+      const hasStreamEnd = h.sent.some(msg => msg.type === 'stream_end');
+      expect(hasStreamEnd).toBe(false);
+    });
+  });
+
+  describe('error handling', () => {
+    const harness = (
+      storeListFor?: jest.Mock,
+      historyEnabled?: boolean
+    ) => {
+      const sent: OutgoingMessage[] = [];
+      const ws = {
+        send: (raw: string) => sent.push(JSON.parse(raw) as OutgoingMessage),
+        userId: 'user-123',
+      } as unknown as WebSocket;
+
+      const orchestrator = {processMessageStream: jest.fn()} as unknown as ChatOrchestrator;
+      const session: ChatSession = {sessionId: 's1', userId: 'user-123', entries: []};
+
+      const store = {
+        create: jest.fn(),
+        get: jest.fn(),
+        delete: jest.fn(),
+        count: jest.fn(),
+        clear: jest.fn(),
+        listFor: storeListFor,
+      } as unknown as SessionStore;
+
+      const handle = createMessageHandler(
+        orchestrator,
+        store,
+        historyEnabled !== undefined ? {history: {enabled: historyEnabled}} : {},
+      );
+
+      return {session, sent, ws, handle, store};
+    };
+
+    it('responds with UNSUPPORTED error when history is disabled', async () => {
+      const listFor = jest.fn().mockResolvedValue([]);
+      const h = harness(listFor, false);
+
+      await h.handle(h.ws, h.session, {type: 'list_conversations'});
+
+      expect(h.sent).toHaveLength(1);
+      expect(h.sent[0]).toMatchObject({type: 'error', code: 'UNSUPPORTED'});
+      expect(h.sent.some(msg => msg.type === 'conversation_list')).toBe(false);
+    });
+
+    it('responds with UNSUPPORTED error when store has no listFor method', async () => {
+      const h = harness(undefined, true);
+
+      await h.handle(h.ws, h.session, {type: 'list_conversations'});
+
+      expect(h.sent).toHaveLength(1);
+      expect(h.sent[0]).toMatchObject({type: 'error', code: 'UNSUPPORTED'});
+      expect(h.sent.some(msg => msg.type === 'conversation_list')).toBe(false);
+    });
+
+    it('responds with SERVER_ERROR when store listFor rejects', async () => {
+      const listFor = jest.fn().mockRejectedValue(new Error('Database connection failed'));
+      const h = harness(listFor, true);
+
+      await h.handle(h.ws, h.session, {type: 'list_conversations'});
+
+      expect(h.sent).toHaveLength(1);
+      expect(h.sent[0]).toMatchObject({type: 'error', code: 'SERVER_ERROR'});
+      if ('message' in h.sent[0]) {
+        expect(h.sent[0].message).not.toContain('Database connection failed');
+      }
+    });
+
+    it('does not send conversations field in any error frame', async () => {
+      const listFor = jest.fn().mockRejectedValue(new Error('fail'));
+      const h = harness(listFor, true);
+
+      await h.handle(h.ws, h.session, {type: 'list_conversations'});
+
+      expect(h.sent[0]).not.toHaveProperty('conversations');
+    });
+  });
+
+  describe('off-lock behavior', () => {
+    it('answers list_conversations before stream_end of concurrent user_message', async () => {
+      const sent: OutgoingMessage[] = [];
+      const ws = {
+        send: (raw: string) => sent.push(JSON.parse(raw) as OutgoingMessage),
+        userId: 'user-123',
+      } as unknown as WebSocket;
+
+      const {until: streamPaused, release: resumeStream} = deferred();
+
+      const stream = async function* (): AsyncGenerator<MessageChunk> {
+        yield {type: 'text', text: 'streaming'};
+        await streamPaused;
+        yield {type: 'stop', stopReason: 'end_turn'};
+      };
+
+      const orchestrator = {
+        processMessageStream: jest.fn(stream),
+      } as unknown as ChatOrchestrator;
+
+      const session: ChatSession = {sessionId: 's1', userId: 'user-123', entries: []};
+
+      const listFor = jest.fn().mockResolvedValue([
+        {sessionId: 'sess-1', createdAt: new Date(), updatedAt: new Date(), entryCount: 1},
+      ]);
+
+      const store = {
+        create: jest.fn(),
+        get: jest.fn(),
+        delete: jest.fn(),
+        count: jest.fn(),
+        clear: jest.fn(),
+        listFor,
+      } as unknown as SessionStore;
+
+      const lock = new PerSessionLock();
+      const handle = createMessageHandler(orchestrator, store, {history: {enabled: true}}, lock);
+
+      // Start a user_message that streams
+      const userMessagePromise = handle(ws, session, {type: 'user_message', content: 'hello'});
+
+      // Send list_conversations while user_message is still streaming
+      setTimeout(async () => {
+        await handle(ws, session, {type: 'list_conversations'});
+        resumeStream();
+      }, 10);
+
+      await userMessagePromise;
+
+      // Find the conversation_list frame index
+      const conversationListIndex = sent.findIndex(msg => msg.type === 'conversation_list');
+      const streamEndIndex = sent.findIndex(msg => msg.type === 'stream_end');
+
+      expect(conversationListIndex).toBeGreaterThan(-1);
+      expect(streamEndIndex).toBeGreaterThan(-1);
+      expect(conversationListIndex).toBeLessThan(streamEndIndex);
+    });
+  });
+});