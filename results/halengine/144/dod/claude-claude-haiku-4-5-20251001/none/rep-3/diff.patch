+import {jest} from '@jest/globals';
+import {WebSocket} from 'ws';
+import {createMessageHandler} from './messageHandler.js';
+import {validateMessage} from './validation.js';
+import type {ChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import type {ChatSession, SessionSummary} from '../../types/session.js';
+import type {OutgoingMessage} from '../../types/messages.js';
+import {ErrorCodes} from '../../types/messages.js';
+import type {SessionStore} from '../../types/sessionStore.js';
+import type {MessageChunk} from '../../types/ai.js';
+
+describe('conversation list over websocket', () => {
+  describe('validation', () => {
+    it('accepts list_conversations with no fields', () => {
+      const result = validateMessage({type: 'list_conversations'});
+
+      expect(result.valid).toBe(true);
+    });
+
+    it('accepts list_conversations with valid limit', () => {
+      const result = validateMessage({type: 'list_conversations', limit: 10});
+
+      expect(result.valid).toBe(true);
+      expect(result.valid && result.data).toMatchObject({type: 'list_conversations', limit: 10});
+    });
+
+    it('rejects list_conversations with limit 0', () => {
+      const result = validateMessage({type: 'list_conversations', limit: 0});
+
+      expect(result.valid).toBe(false);
+    });
+
+    it('rejects list_conversations with limit > 200', () => {
+      const result = validateMessage({type: 'list_conversations', limit: 201});
+
+      expect(result.valid).toBe(false);
+    });
+
+    it('rejects list_conversations with fractional limit', () => {
+      const result = validateMessage({type: 'list_conversations', limit: 1.5});
+
+      expect(result.valid).toBe(false);
+    });
+
+    it('rejects list_conversations with string limit', () => {
+      const result = validateMessage({type: 'list_conversations', limit: '10'});
+
+      expect(result.valid).toBe(false);
+    });
+
+    it('accepts list_conversations with valid before cursor', () => {
+      const result = validateMessage({
+        type: 'list_conversations',
+        before: {updatedAt: '2026-01-15T14:30:00Z', sessionId: 's1'},
+      });
+
+      expect(result.valid).toBe(true);
+    });
+
+    it('rejects list_conversations with invalid before cursor', () => {
+      const result = validateMessage({type: 'list_conversations', before: 'not a date'});
+
+      expect(result.valid).toBe(false);
+    });
+
+    it('drops unknown fields', () => {
+      const result = validateMessage({type: 'list_conversations', userId: 'someone-else', limit: 5});
+
+      expect(result.valid).toBe(true);
+      expect(result.valid && result.data).toMatchObject({type: 'list_conversations', limit: 5});
+      expect(result.valid && 'userId' in result.data).toBe(false);
+    });
+  });
+
+  describe('message handler', () => {
+    interface HandlerOptions {
+      sessionStore?: SessionStore;
+      historyEnabled?: boolean;
+    }
+
+    const harness = (options?: HandlerOptions) => {
+      const sent: OutgoingMessage[] = [];
+      const ws = {
+        send: (raw: string) => sent.push(JSON.parse(raw) as OutgoingMessage),
+        userId: 'u1',
+      } as unknown as WebSocket;
+
+      const orchestrator = {
+        processMessageStream: jest.fn(),
+      } as unknown as ChatOrchestrator;
+
+      const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+
+      const handle = createMessageHandler(orchestrator, {
+        sessionStore: options?.sessionStore,
+        historyEnabled: options?.historyEnabled ?? false,
+      });
+
+      return {
+        session,
+        sent,
+        frames: () => sent.map(f => f.type),
+        send: (raw: unknown = {type: 'list_conversations'}) => handle(ws, session, raw),
+      };
+    };
+
+    it('answers list_conversations with conversation_list when history is enabled', async () => {
+      const summaries: SessionSummary[] = [
+        {
+          sessionId: 'sess1',
+          createdAt: new Date('2026-01-01T00:00:00Z'),
+          updatedAt: new Date('2026-01-15T14:30:00Z'),
+          entryCount: 5,
+        },
+        {
+          sessionId: 'sess2',
+          createdAt: new Date('2026-01-02T00:00:00Z'),
+          updatedAt: new Date('2026-01-14T10:00:00Z'),
+          entryCount: 3,
+        },
+      ];
+
+      const store = {
+        listFor: jest.fn().mockResolvedValue(summaries),
+      } as unknown as SessionStore;
+
+      const h = harness({sessionStore: store, historyEnabled: true});
+      await h.send({type: 'list_conversations', limit: 10});
+
+      expect(h.frames()).toEqual(['conversation_list']);
+      const response = h.sent[0] as Extract<OutgoingMessage, {type: 'conversation_list'}>;
+      expect(response.conversations).toEqual(summaries);
+      expect(store.listFor).toHaveBeenCalledWith('u1', {limit: 10, before: undefined});
+    });
+
+    it('uses ws.userId not frame userId', async () => {
+      const store = {
+        listFor: jest.fn().mockResolvedValue([]),
+      } as unknown as SessionStore;
+
+      const h = harness({sessionStore: store, historyEnabled: true});
+      await h.send({type: 'list_conversations', userId: 'someone-else'});
+
+      expect(store.listFor).toHaveBeenCalledWith('u1', expect.any(Object));
+    });
+
+    it('passes limit and before to listFor', async () => {
+      const store = {
+        listFor: jest.fn().mockResolvedValue([]),
+      } as unknown as SessionStore;
+
+      const h = harness({sessionStore: store, historyEnabled: true});
+      const cursor = {updatedAt: '2026-01-15T14:30:00Z', sessionId: 'sess1'};
+      await h.send({type: 'list_conversations', limit: 20, before: cursor});
+
+      expect(store.listFor).toHaveBeenCalledWith('u1', {limit: 20, before: cursor});
+    });
+
+    it('answers error UNSUPPORTED when history is disabled', async () => {
+      const h = harness({historyEnabled: false});
+      await h.send({type: 'list_conversations'});
+
+      expect(h.frames()).toEqual(['error']);
+      const response = h.sent[0] as Extract<OutgoingMessage, {type: 'error'}>;
+      expect(response.code).toBe(ErrorCodes.UNSUPPORTED);
+    });
+
+    it('answers error UNSUPPORTED when store has no listFor', async () => {
+      const store = {} as unknown as SessionStore;
+      const h = harness({sessionStore: store, historyEnabled: true});
+      await h.send({type: 'list_conversations'});
+
+      expect(h.frames()).toEqual(['error']);
+      const response = h.sent[0] as Extract<OutgoingMessage, {type: 'error'}>;
+      expect(response.code).toBe(ErrorCodes.UNSUPPORTED);
+    });
+
+    it('answers error SERVER_ERROR when listFor rejects', async () => {
+      const store = {
+        listFor: jest.fn().mockRejectedValue(new Error('Database error')),
+      } as unknown as SessionStore;
+
+      const h = harness({sessionStore: store, historyEnabled: true});
+      await h.send({type: 'list_conversations'});
+
+      expect(h.frames()).toEqual(['error']);
+      const response = h.sent[0] as Extract<OutgoingMessage, {type: 'error'}>;
+      expect(response.code).toBe(ErrorCodes.SERVER_ERROR);
+    });
+
+    it('does not send stream_end after conversation_list', async () => {
+      const summaries: SessionSummary[] = [
+        {
+          sessionId: 'sess1',
+          createdAt: new Date('2026-01-01T00:00:00Z'),
+          updatedAt: new Date('2026-01-15T14:30:00Z'),
+          entryCount: 5,
+        },
+      ];
+
+      const store = {
+        listFor: jest.fn().mockResolvedValue(summaries),
+      } as unknown as SessionStore;
+
+      const h = harness({sessionStore: store, historyEnabled: true});
+      await h.send({type: 'list_conversations'});
+
+      expect(h.frames()).toEqual(['conversation_list']);
+    });
+
+    it('does not send stream_end after error', async () => {
+      const h = harness({historyEnabled: false});
+      await h.send({type: 'list_conversations'});
+
+      expect(h.frames()).toEqual(['error']);
+    });
+
+    it('answers list_conversations immediately while a user_message is streaming', async () => {
+      const summaries: SessionSummary[] = [
+        {
+          sessionId: 'sess1',
+          createdAt: new Date('2026-01-01T00:00:00Z'),
+          updatedAt: new Date('2026-01-15T14:30:00Z'),
+          entryCount: 5,
+        },
+      ];
+
+      const store = {
+        listFor: jest.fn().mockResolvedValue(summaries),
+      } as unknown as SessionStore;
+
+      const sent: OutgoingMessage[] = [];
+      const ws = {
+        send: (raw: string) => sent.push(JSON.parse(raw) as OutgoingMessage),
+        userId: 'u1',
+      } as unknown as WebSocket;
+
+      let resolveStream: () => void;
+      const streamPromise = new Promise<void>(resolve => {
+        resolveStream = resolve;
+      });
+
+      const orchestrator = {
+        processMessageStream: jest.fn(async function* () {
+          yield {type: 'text', text: 'streaming...'} as MessageChunk;
+          await streamPromise;
+          yield {type: 'stop', stopReason: 'end_turn'} as MessageChunk;
+        }),
+      } as unknown as ChatOrchestrator;
+
+      const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+      const handle = createMessageHandler(orchestrator, {sessionStore: store, historyEnabled: true});
+
+      const userMessagePromise = handle(ws, session, {type: 'user_message', content: 'hello'});
+
+      // Give the user message time to start streaming
+      await new Promise(resolve => setTimeout(resolve, 10));
+
+      // While user_message is streaming, list_conversations should be answered immediately
+      await handle(ws, session, {type: 'list_conversations'});
+
+      const conversationListFrames = sent.filter(f => f.type === 'conversation_list');
+      expect(conversationListFrames).toHaveLength(1);
+
+      // Now let the user message finish
+      resolveStream!();
+      await userMessagePromise;
+    });
+  });
+});