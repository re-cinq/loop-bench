+  clientsToStop: WebSocket[],
+  serversToStop: Array<{wss: {clients: {size: number}}; stop: () => Promise<void>}>
+): Promise<void> {
+  for (const client of clientsToStop.splice(0)) client.terminate();
+  for (const hal of serversToStop.splice(0)) {
+    const {clients} = hal.wss;
+    await eventually(() => clients.size === 0);
+    await hal.stop();
+  }
