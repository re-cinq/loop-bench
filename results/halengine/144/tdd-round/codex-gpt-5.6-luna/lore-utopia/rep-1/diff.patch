+      expect({sent, errorCalls: error.mock.calls}).toEqual({
+        sent: [{type: 'error', code: 'SERVER_ERROR', message: 'Failed to list conversations'}],
+        errorCalls: [['ws', 'conversation list failed', {sessionId: 'active', error: 'Error'}]],
+      });
+    } finally {
+      setLogger();
+    }
+  });
+});
