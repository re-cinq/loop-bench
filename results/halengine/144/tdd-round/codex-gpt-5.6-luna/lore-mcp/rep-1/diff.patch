+import {ErrorCodes} from './index.js';
+import type {
+  ConversationListMessage,
+  ConversationSummary,
+  ListConversationsMessage,
+  ListSessionsMessage,
+  SessionListMessage,
+  SessionSummaryFrame,
+} from './index.js';
+
+describe('public WebSocket message types', () => {
+  // spec: specs/hal-engine-websocket-protocol#80
+  it('exports the conversation-list message types from the package entry point', () => {
+    const incoming: ListSessionsMessage | ListConversationsMessage = {type: 'list_conversations'};
+    const summary: SessionSummaryFrame | ConversationSummary = {
+      sessionId: 's1',
+      createdAt: '2026-01-01T00:00:00.000Z',
+      updatedAt: '2026-01-01T00:01:00.000Z',
+      entryCount: 0,
+    };
+    const outgoing: SessionListMessage | ConversationListMessage = {
+      type: 'conversation_list',
+      conversations: [summary],
+    };
+
+    expect({incoming, outgoing, unsupported: ErrorCodes.UNSUPPORTED}).toEqual({
+      incoming: {type: 'list_conversations'},
+      outgoing: {type: 'conversation_list', conversations: [summary]},
+      unsupported: 'UNSUPPORTED',
+    });
+  });
+});
