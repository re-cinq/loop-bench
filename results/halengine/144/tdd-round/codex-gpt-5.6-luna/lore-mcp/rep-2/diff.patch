+import {WebSocket} from 'ws';
+import {jest} from '@jest/globals';
+import {createMessageHandler} from './messageHandler.js';
+import type {ChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import type {ChatSession} from '../../types/session.js';
+import type {OutgoingMessage} from '../../types/messages.js';
+import {StoreCannotList} from '../../types/sessionStore.js';
+import type {SessionStore} from '../../types/sessionStore.js';
+import {captureErrors} from '../../shared/logCaptureTestSupport.js';
+
+describe('list_sessions handling', () => {
+  const errors = captureErrors();
+  const makeStore = (listFor: SessionStore['listFor']): SessionStore => ({
+    create: () => ({sessionId: 'unused', userId: 'unused', entries: []}),
+    get: () => undefined,
+    delete: () => false,
+    count: () => 0,
+    clear: () => undefined,
+    listFor,
+  });
+
+  it("answers with the authenticated user's summaries and ISO dates", async () => {
+    const sent: OutgoingMessage[] = [];
+    const ws = {send: (raw: string) => sent.push(JSON.parse(raw) as OutgoingMessage)} as unknown as WebSocket;
+    const store = makeStore(userId => [
+      {
+        sessionId: String(userId),
+        createdAt: new Date('2026-01-01T00:00:00.000Z'),
+        updatedAt: new Date('2026-01-02T00:00:00.000Z'),
+        entryCount: 2,
+      },
+    ]);
+    const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+
+    await createMessageHandler({} as ChatOrchestrator, store)(ws, session, {type: 'list_sessions', userId: 'u2'});
+
+    expect(sent).toEqual([
+      {
+        type: 'session_list',
+        sessions: [
+          {
+            sessionId: 'u1',
+            createdAt: '2026-01-01T00:00:00.000Z',
+            updatedAt: '2026-01-02T00:00:00.000Z',
+            entryCount: 2,
+          },
+        ],
+      },
+    ]);
+  });
+
+  // spec: specs/hal-engine-conversation-list/spec.md#31
+  it("answers an enabled list_conversations frame with the authenticated user's ISO summaries", async () => {
+    const sent: OutgoingMessage[] = [];
+    const createdAt = new Date('2026-01-01T00:00:00.000Z');
+    const updatedAt = new Date('2026-01-02T00:00:00.000Z');
+    let received: unknown[] | undefined;
+    const listFor = jest.fn((...args: unknown[]) => {
+      received = args;
+      return [{sessionId: 's1', createdAt, updatedAt, entryCount: 2}];
+    });
+    const store = makeStore(listFor);
+    const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+    const ws = {send: (raw: string) => sent.push(JSON.parse(raw) as OutgoingMessage)} as unknown as WebSocket;
+
+    await createMessageHandler({} as ChatOrchestrator, store, {enabled: true})(ws, session, {
+      type: 'list_conversations',
+      limit: 10,
+      before: {updatedAt: updatedAt.toISOString(), sessionId: 's2', userId: 'u2'},
+    });
+
+    expect({call: received, sent}).toEqual({
+      call: ['u1', {limit: 10, before: {updatedAt: updatedAt.toISOString(), sessionId: 's2'}}],
+      sent: [
+        {
+          type: 'conversation_list',
+          conversations: [
+            {sessionId: 's1', createdAt: createdAt.toISOString(), updatedAt: updatedAt.toISOString(), entryCount: 2},
+          ],
+        },
+      ],
+    });
+  });
+
+  // A store that cannot list is unsupported, rather than an empty history. ([validated by: answers UNSUPPORTED and logs the session when the store cannot list](../../specs/hal-engine-conversation-list/spec.md#L79))
+  it('answers UNSUPPORTED and logs the session when the store cannot list', async () => {
+    const sent: OutgoingMessage[] = [];
+    const ws = {send: (raw: string) => sent.push(JSON.parse(raw) as OutgoingMessage)} as unknown as WebSocket;
+    const store = makeStore(() => {
+      throw new StoreCannotList();
+    });
+    const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+
+    await createMessageHandler({} as ChatOrchestrator, store, {enabled: true})(ws, session, {
+      type: 'list_conversations',
+    });
+
+    expect({sent, errors}).toEqual({
+      sent: [{type: 'error', code: 'UNSUPPORTED', message: 'This session store cannot list conversations'}],
+      errors: [
+        {
+          category: 'ws',
+          message: 'store cannot list conversations',
+          sessionId: 's1',
+          userId: 'u1',
+          errorType: 'StoreCannotList',
+        },
+      ],
+    });
+  });
+
+  // A disabled history feature refuses the frame rather than returning a list. ([validated by: refuses conversation listing when history is disabled](../../specs/hal-engine-conversation-list/spec.md#L79))
+  it('refuses conversation listing when history is disabled', async () => {
+    const sent: OutgoingMessage[] = [];
+    const ws = {send: (raw: string) => sent.push(JSON.parse(raw) as OutgoingMessage)} as unknown as WebSocket;
+    const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+
+    await createMessageHandler({} as ChatOrchestrator, undefined, {enabled: false})(ws, session, {
+      type: 'list_conversations',
+    });
+
+    expect(sent).toEqual([
+      {type: 'error', code: 'UNSUPPORTED', message: 'Conversation history is not enabled on this server'},
+    ]);
+  });
+});
