+
+function limitError(limit: unknown): string | null {
+  if (limit === undefined) return null;
+  if (typeof limit !== 'number' || !Number.isInteger(limit) || limit < 0) {
+    return 'list_sessions limit must be a non-negative integer';
+  }
+  return null;
