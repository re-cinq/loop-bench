+function validateListSessionsMessage(message: Record<string, unknown>): ValidationResult {
+  const limitErr = limitError(message.limit);
+  if (limitErr) return {valid: false, error: limitErr};
+
+  const beforeErr = beforeError(message.before);
+  if (beforeErr) return {valid: false, error: beforeErr};
