+  if (message.before !== undefined) {
+    const b = message.before as Record<string, unknown>;
+    sessionMsg.before = {updatedAt: b.updatedAt as string | number, sessionId: b.sessionId as string};
+  }
+  return {valid: true, data: sessionMsg};
