+    const req: ListSessionsMessage = {type: 'list_sessions'};
+    const summary: SessionSummaryWire = {
+      sessionId: 's1',
+      createdAt: '2026-01-01T00:00:00.000Z',
+      updatedAt: '2026-01-01T00:00:00.000Z',
+      entryCount: 1,
+    };
