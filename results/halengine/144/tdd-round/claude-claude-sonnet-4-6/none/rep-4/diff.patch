+import {WebSocket} from 'ws';
+import {createMessageHandler} from './messageHandler.js';
+import type {ChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import type {ChatSession} from '../../types/session.js';
+import type {SessionStore, SessionSummary} from '../../types/sessionStore.js';
+import type {OutgoingMessage} from '../../types/messages.js';
+
+// list_sessions does not start a stream
+const noOp = {
+  async *processMessageStream(): AsyncGenerator<never> {},
+} as unknown as ChatOrchestrator;
+
+const makeWs = (): {ws: WebSocket; sent: OutgoingMessage[]} => {
+  const sent: OutgoingMessage[] = [];
+  const ws = {send: (raw: string) => sent.push(JSON.parse(raw) as OutgoingMessage)} as unknown as WebSocket;
+  return {ws, sent};
+};
+
+const makeSession = (userId = 'u1'): ChatSession => ({sessionId: 's1', userId, entries: []});
+
+describe('list_sessions dispatch', () => {
+  it('calls listFor with the session userId (ignoring any frame userId) and returns ISO-serialised summaries', async () => {
+    const calls: Array<{userId: string | number; options: unknown}> = [];
+    const summaries: SessionSummary[] = [
+      {
+        sessionId: 'past1',
+        createdAt: new Date('2026-03-01T00:00:00.000Z'),
+        updatedAt: new Date('2026-03-01T12:00:00.000Z'),
+        entryCount: 3,
+      },
+    ];
+    const store: SessionStore = {
+      create: async () => ({sessionId: 'x', userId: 'u1', entries: []}),
+      get: async () => undefined,
+      delete: async () => false,
+      count: async () => 0,
+      clear: async () => {},
+      listFor: (userId, options) => {
+        calls.push({userId, options: options ?? null});
+        return summaries;
+      },
+    };
+    const {ws, sent} = makeWs();
+    const handle = createMessageHandler(noOp, store);
+
+    // userId in the frame must be ignored; limit is forwarded
+    await handle(ws, makeSession('u1'), {type: 'list_sessions', limit: 5, userId: 'other'} as unknown as object);
+
+    expect(sent).toEqual([
+      {
+        type: 'session_list',
+        sessions: [
+          {
+            sessionId: 'past1',
+            createdAt: '2026-03-01T00:00:00.000Z',
+            updatedAt: '2026-03-01T12:00:00.000Z',
+            entryCount: 3,
+          },
+        ],
+      },
+    ]);
+    expect(calls[0]?.userId).toBe('u1');
+  });
+
+  it('returns an empty session_list when the store has no listFor', async () => {
+    const store: SessionStore = {
+      create: async () => ({sessionId: 'x', userId: 'u1', entries: []}),
+      get: async () => undefined,
+      delete: async () => false,
+      count: async () => 0,
+      clear: async () => {},
+    };
+    const {ws, sent} = makeWs();
+    const handle = createMessageHandler(noOp, store);
+
+    await handle(ws, makeSession(), {type: 'list_sessions'});
+
+    expect(sent).toEqual([{type: 'session_list', sessions: []}]);
+  });
+});
