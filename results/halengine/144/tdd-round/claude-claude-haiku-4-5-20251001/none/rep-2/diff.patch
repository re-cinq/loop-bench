+import {WebSocket} from 'ws';
+import type {ChatSession} from '../../types/session.js';
+import type {SessionStore, SessionSummary} from '../../types/sessionStore.js';
+import {createMessageHandler} from './messageHandler.js';
+import {answeringOrchestrator} from '../wsTestSupport.js';
+import {setLogger} from '../../shared/logger.js';
+
+describe('messageHandler list_sessions handling', () => {
+  let mockWs: Partial<WebSocket>;
+  let sentMessages: unknown[];
+  let session: ChatSession;
+  let sessionStore: SessionStore;
+
+  beforeEach(() => {
+    setLogger({debug: () => {}, info: () => {}, warn: () => {}, error: () => {}});
+    sentMessages = [];
+    mockWs = {
+      send: (data: string) => sentMessages.push(JSON.parse(data)),
+      readyState: WebSocket.OPEN,
+    };
+    session = {
+      sessionId: 'test-session',
+      userId: 'test-user',
+      entries: [],
+    };
+  });
+
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('calls sessionStore.listFor with session userId and message options', async () => {
+    const seen: Array<{userId: string | number; options?: unknown}> = [];
+    const summaries: SessionSummary[] = [
+      {
+        sessionId: 's1',
+        createdAt: new Date('2026-01-01T00:00:00.000Z'),
+        updatedAt: new Date('2026-01-01T00:01:00.000Z'),
+        entryCount: 2,
+      },
+    ];
+
+    const store: SessionStore = {
+      create: async () => '',
+      get: async () => null,
+      delete: async () => {},
+      count: async () => 0,
+      clear: async () => {},
+      listFor: async (userId, options) => {
+        seen.push({userId, options});
+        return summaries;
+      },
+    };
+
+    const handler = createMessageHandler(answeringOrchestrator, store);
+
+    await handler(mockWs as WebSocket, session, {
+      type: 'list_sessions',
+      limit: 10,
+      before: {updatedAt: '2026-01-01T00:05:00.000Z', sessionId: 's2'},
+    });
+
+    expect(seen).toEqual([
+      {
+        userId: 'test-user',
+        options: {limit: 10, before: {updatedAt: '2026-01-01T00:05:00.000Z', sessionId: 's2'}},
+      },
+    ]);
+  });
+});
