@@ -30,6 +30,8 @@ export function validateMessage(payload: unknown): ValidationResult {
       return validateUserMessage(message);
     case 'ping':
       return validatePingMessage(message);
+    case 'list_sessions':
+      return validateListSessionsMessage(message);
     default:
       return {valid: false, error: `Unknown message type: ${message.type}`};
   }
@@ -72,3 +74,69 @@ function validatePingMessage(message: Record<string, unknown>): ValidationResult
     },
   };
 }
+
+function validateListSessionsMessage(message: Record<string, unknown>): ValidationResult {
+  const data: Record<string, unknown> = {type: 'list_sessions'};
+
+  if (message.limit !== undefined) {
+    if (typeof message.limit !== 'number' || !Number.isInteger(message.limit) || message.limit < 0) {
+      return {valid: false, error: 'list_sessions limit must be a non-negative integer'};
+    }
+    data.limit = message.limit;
+  }
+
+  if (message.before !== undefined) {
+    const cursorValidation = validateSessionCursor(message.before);
+    if (!cursorValidation.valid) {
+      return {valid: false, error: cursorValidation.error};
+    }
+    data.before = cursorValidation.data;
+  }
+
+  return {
+    valid: true,
+    data: data as any,
+  };
+}
+
+interface CursorValidationSuccess {
+  valid: true;
+  data: {updatedAt: string; sessionId: string};
+}
+
+interface CursorValidationFailure {
+  valid: false;
+  error: string;
+}
+
+function validateSessionCursor(cursor: unknown): CursorValidationSuccess | CursorValidationFailure {
+  if (typeof cursor !== 'object' || cursor === null) {
+    return {valid: false, error: 'list_sessions before must be an object'};
+  }
+
+  const cursorObj = cursor as Record<string, unknown>;
+
+  if (typeof cursorObj.sessionId !== 'string') {
+    return {valid: false, error: 'list_sessions before.sessionId must be a string'};
+  }
+
+  if (cursorObj.sessionId.length === 0 || cursorObj.sessionId.length > 128) {
+    return {valid: false, error: 'list_sessions before.sessionId must be 1-128 characters'};
+  }
+
+  if (typeof cursorObj.updatedAt !== 'string') {
+    return {valid: false, error: 'list_sessions before.updatedAt must be a string'};
+  }
+
+  if (Number.isNaN(Date.parse(cursorObj.updatedAt))) {
+    return {valid: false, error: 'list_sessions before.updatedAt must be a valid date string'};
+  }
+
+  return {
+    valid: true,
+    data: {
+      updatedAt: cursorObj.updatedAt,
+      sessionId: cursorObj.sessionId,
+    },
+  };
+}
