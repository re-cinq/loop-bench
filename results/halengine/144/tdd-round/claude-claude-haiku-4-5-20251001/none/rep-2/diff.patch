@@ -333,3 +353,30 @@ function commitOpenEntries(ws: WebSocket, session: ChatSession, state: StreamSta
 function handlePing(ws: WebSocket, timestamp: number): void {
   ws.send(JSON.stringify({type: 'pong', timestamp}));
 }
+
+async function handleListSessions(
+  ws: WebSocket,
+  session: ChatSession,
+  sessionStore: SessionStore | undefined,
+  message: {type: 'list_sessions'; limit?: number; before?: {updatedAt: string; sessionId: string}}
+): Promise<void> {
+  try {
+    if (!sessionStore?.listFor) {
+      sendSessionList(ws, []);
+      return;
+    }
+
+    const summaries = await sessionStore.listFor(session.userId, {limit: message.limit, before: message.before});
+    const sessions = summaries.map(s => ({
+      sessionId: s.sessionId,
+      createdAt: s.createdAt.toISOString(),
+      updatedAt: s.updatedAt.toISOString(),
+      entryCount: s.entryCount,
+    }));
+    sendSessionList(ws, sessions);
+  } catch (error) {
+    const errorMsg = error instanceof Error ? error.message : 'Unknown error';
+    log.error('ws', 'listFor failed', {userId: session.userId, error: errorMsg});
+    sendError(ws, ErrorCodes.SERVER_ERROR, 'Failed to list sessions');
+  }
+}
