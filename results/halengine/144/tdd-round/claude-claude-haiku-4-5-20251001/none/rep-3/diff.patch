 }
+
+export function sendSessionList(
+  ws: WebSocket,
+  sessions: Array<{sessionId: string; createdAt: Date; updatedAt: Date; entryCount: number}>
+): void {
+  const converted = sessions.map(s => ({
+    sessionId: s.sessionId,
+    createdAt: s.createdAt.toISOString(),
+    updatedAt: s.updatedAt.toISOString(),
+    entryCount: s.entryCount,
+  }));
+  sendJson(ws, {type: 'session_list', sessions: converted});
+}
