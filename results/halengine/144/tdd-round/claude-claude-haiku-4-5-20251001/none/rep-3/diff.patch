   }
@@ -72,3 +74,46 @@ function validatePingMessage(message: Record<string, unknown>): ValidationResult
     },
   };
 }
+
+function validateListSessionsMessage(message: Record<string, unknown>): ValidationResult {
+  const data: Record<string, unknown> = {type: 'list_sessions'};
+
+  if ('limit' in message) {
+    const limit = message.limit;
+    if (typeof limit !== 'number' || !Number.isInteger(limit) || limit < 1 || limit > 200) {
+      return {valid: false, error: 'list_sessions limit must be an integer between 1 and 200'};
+    }
+    data.limit = limit;
+  }
+
+  if ('before' in message) {
+    const before = message.before;
+    if (typeof before !== 'object' || before === null) {
+      return {valid: false, error: 'list_sessions before must be an object'};
+    }
+    const beforeObj = before as Record<string, unknown>;
+
+    const sessionId = beforeObj.sessionId;
+    if (typeof sessionId !== 'string' || sessionId.length < 1 || sessionId.length > 128) {
+      return {valid: false, error: 'list_sessions before.sessionId must be a string 1-128 chars'};
+    }
+
+    const updatedAt = beforeObj.updatedAt;
+    if (typeof updatedAt !== 'string' && typeof updatedAt !== 'number') {
+      return {valid: false, error: 'list_sessions before.updatedAt must be a string or number'};
+    }
+    if (typeof updatedAt === 'string') {
+      const parsed = Date.parse(updatedAt);
+      if (isNaN(parsed)) {
+        return {valid: false, error: 'list_sessions before.updatedAt must be a valid date'};
+      }
+    }
+
+    data.before = {sessionId, updatedAt};
+  }
+
+  return {
+    valid: true,
+    data: data as any,
+  };
+}
