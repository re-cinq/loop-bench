+  }
+
+  if (typeof updatedAt !== 'string' && typeof updatedAt !== 'number') {
+    return 'before.updatedAt must be a string or number';
+  }
+
+  if (typeof updatedAt !== 'string') {
+    return null;
+  }
+
+  if (isNaN(Date.parse(updatedAt))) {
+    return 'before.updatedAt must be a valid date';
+  }
+
+  return null;
+}
