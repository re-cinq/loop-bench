+import {jest} from '@jest/globals';
+import {WebSocket} from 'ws';
+import {createMessageHandler} from './messageHandler.js';
+import type {ChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import type {ChatSession} from '../../types/session.js';
+import type {OutgoingMessage} from '../../types/messages.js';
+import type {SessionStore} from '../../types/sessionStore.js';
+
+// The reply carries ISO dates on the wire, and the store is asked for the connection's own user, never a frame's.
+describe("listing a user's conversations through the message handler", () => {
+  it('answers list_sessions with session_list, serialising both times to ISO strings', async () => {
+    const sent: OutgoingMessage[] = [];
+    const ws = {send: (raw: string) => sent.push(JSON.parse(raw) as OutgoingMessage)} as unknown as WebSocket;
+    const listFor = jest.fn(async () => [
+      {
+        sessionId: 's2',
+        createdAt: new Date('2026-01-01T00:00:00.000Z'),
+        updatedAt: new Date('2026-01-01T00:02:00.000Z'),
+        entryCount: 4,
+      },
+    ]);
+    const store = {listFor} as unknown as SessionStore;
+    const orchestrator = {} as unknown as ChatOrchestrator;
+    const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+
+    await createMessageHandler(orchestrator, store)(ws, session, {type: 'list_sessions', limit: 10});
+
+    expect({listFor: listFor.mock.calls, sent}).toEqual({
+      listFor: [['u1', {limit: 10, before: undefined}]],
+      sent: [
+        {
+          type: 'session_list',
+          sessions: [
+            {
+              sessionId: 's2',
+              createdAt: '2026-01-01T00:00:00.000Z',
+              updatedAt: '2026-01-01T00:02:00.000Z',
+              entryCount: 4,
+            },
+          ],
+        },
+      ],
+    });
+  });
+});
