@@ -30,6 +30,8 @@ export function validateMessage(payload: unknown): ValidationResult {
       return validateUserMessage(message);
     case 'ping':
       return validatePingMessage(message);
+    case 'list_sessions':
+      return validateListSessionsMessage(message);
     default:
       return {valid: false, error: `Unknown message type: ${message.type}`};
   }
@@ -59,6 +61,22 @@ function validateUserMessage(message: Record<string, unknown>): ValidationResult
   };
 }
 
+function validateListSessionsMessage(message: Record<string, unknown>): ValidationResult {
+  if (message.before !== undefined && (typeof message.before !== 'object' || message.before === null)) {
+    return {valid: false, error: 'list_sessions before must be a cursor object'};
+  }
+
+  if (message.limit === undefined) {
+    return {valid: true, data: {type: 'list_sessions'}};
+  }
+
+  if (typeof message.limit !== 'number' || !Number.isInteger(message.limit) || message.limit < 0) {
+    return {valid: false, error: 'list_sessions limit must be a non-negative integer'};
+  }
+
+  return {valid: true, data: {type: 'list_sessions', limit: message.limit}};
+}
+
 function validatePingMessage(message: Record<string, unknown>): ValidationResult {
