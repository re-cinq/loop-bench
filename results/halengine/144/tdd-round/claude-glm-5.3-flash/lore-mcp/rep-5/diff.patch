+interface Frame {
+  type: string;
+  sessions?: unknown;
+  code?: string;
+}
+
+const summary = (sessionId: string): SessionSummary => ({
+  sessionId,
+  createdAt: new Date('2026-01-01T00:00:00.000Z'),
+  updatedAt: new Date('2026-01-01T00:02:00.000Z'),
+  entryCount: 2,
