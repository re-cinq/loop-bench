new file mode 100644
index 0000000..f2eb258
--- /dev/null
+++ b/scripts/mongoBinaryWarmup.mjs
@@ -0,0 +1,8 @@
+// Downloads the mongod binary once in the parent process, before any worker spawns.
+// The mongo suites share one download directory, and workers racing a cold download
+// corrupt each other's archive - jest reports it as a rename or lock ENOENT mid-suite.
+import mongoMemoryServer from 'mongodb-memory-server';
+
+export default async function mongoBinaryWarmup() {
+  await mongoMemoryServer.MongoBinary.getPath();
+}
