+import {jest} from '@jest/globals';
+import {WebSocket} from 'ws';
+import {createMessageHandler} from './messageHandler.js';
+import type {ChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import type {ChatSession} from '../../types/session.js';
+import type {OutgoingMessage} from '../../types/messages.js';
+import type {SessionStore} from '../../types/sessionStore.js';
+
+describe('list_sessions dispatch', () => {
+  // spec: specs/hal-engine-conversation-list/spec.md#96
+  it('reads the authenticated user and forwards the cursor to the session store', async () => {
+    const sent: OutgoingMessage[] = [];
+    const ws = {send: (raw: string) => sent.push(JSON.parse(raw) as OutgoingMessage)} as unknown as WebSocket;
+    const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+    const before = {sessionId: 's0', updatedAt: '2026-01-01T00:00:00.000Z'};
+    const listFor = jest.fn(async () => [
+      {
+        sessionId: 's1',
+        createdAt: new Date('2026-01-01T00:00:00.000Z'),
+        updatedAt: new Date('2026-01-02T00:00:00.000Z'),
+        entryCount: 2,
+      },
+    ]);
+    const store = {listFor} as unknown as SessionStore;
+    const orchestrator = {} as ChatOrchestrator;
+
+    await createMessageHandler(orchestrator, store)(ws, session, {
+      type: 'list_sessions',
+      limit: 10,
+      before,
+      userId: 'u2',
+    });
+
+    expect({
+      calls: listFor.mock.calls,
+      frames: sent,
+    }).toEqual({
+      calls: [['u1', {limit: 10, before}]],
+      frames: [
+        {
+          type: 'session_list',
+          sessions: [
+            {
+              sessionId: 's1',
+              createdAt: '2026-01-01T00:00:00.000Z',
+              updatedAt: '2026-01-02T00:00:00.000Z',
+              entryCount: 2,
+            },
+          ],
+        },
+      ],
+    });
+  });
+});
