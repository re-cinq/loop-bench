+import {jest} from '@jest/globals';
+import {WebSocket} from 'ws';
+import {createMessageHandler} from './ws/messageHandler.js';
+import type {ChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import type {ChatSession} from '../types/session.js';
+import type {SessionStore} from '../types/sessionStore.js';
+import type {MessageChunk} from '../types/ai.js';
+
+describe('conversation list concurrency', () => {
+  it('answers a list request before a streaming turn ends', async () => {
+    let releaseStream!: () => void;
+    const streamPaused = new Promise<void>(resolve => {
+      releaseStream = resolve;
+    });
+    let signalStreamPaused!: () => void;
+    const streamStarted = new Promise<void>(resolve => {
+      signalStreamPaused = resolve;
+    });
+    const chunks = async function* (): AsyncGenerator<MessageChunk> {
+      signalStreamPaused();
+      await streamPaused;
+      yield {type: 'text', text: 'answer'};
+      yield {type: 'stop', stopReason: 'end_turn'};
+    };
+    const orchestrator = {processMessageStream: jest.fn(chunks)} as unknown as ChatOrchestrator;
+    const sessionStore = {
+      listFor: jest.fn(() => []),
+    } as unknown as SessionStore;
+    const frames: Array<{type: string}> = [];
+    const ws = {
+      send(raw: string) {
+        frames.push(JSON.parse(raw) as {type: string});
+      },
+    } as unknown as WebSocket;
+    const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+    const handle = createMessageHandler(orchestrator, sessionStore, {history: {enabled: true}});
+
+    const turn = handle(ws, session, {type: 'user_message', content: 'hello'});
+    await streamStarted;
+    await handle(ws, session, {type: 'list_conversations'});
+    releaseStream();
+    await turn;
+
+    expect(frames.findIndex(frame => frame.type === 'conversation_list')).toBeLessThan(
+      frames.findIndex(frame => frame.type === 'stream_end')
+    );
+  });
+});
