+    });
+    const store = {listFor} as unknown as SessionStore;
+    const errors: unknown[][] = [];
+    setLogger({
+      debug: () => undefined,
+      info: () => undefined,
+      warn: () => undefined,
+      error: (...args) => errors.push(args),
+    });
+
+    try {
+      await createMessageHandler({} as ChatOrchestrator, store)(ws, session, {type: 'list_sessions'});
+    } finally {
+      setLogger();
