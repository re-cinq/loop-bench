+describe('session list dispatch', () => {
+  it('passes the authenticated session user and paging options to listFor', async () => {
+    const sent: unknown[] = [];
+    const ws = {send: (raw: string) => sent.push(JSON.parse(raw))} as unknown as WebSocket;
+    const session: ChatSession = {sessionId: 's1', userId: 'owner', entries: []};
+    const listFor = jest.fn(async () => []);
+    const store = {listFor} as unknown as SessionStore;
+    const handler = createMessageHandler({} as ChatOrchestrator, store);
+
+    await handler(ws, session, {
+      type: 'list_sessions',
+      limit: 5,
+      before: {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: 's0'},
+      userId: 'attacker',
+    });
+
+    expect({calls: listFor.mock.calls, sent}).toEqual({
+      calls: [['owner', {limit: 5, before: {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: 's0'}}]],
+      sent: [{type: 'session_list', sessions: []}],
+    });
+  });
