@@ -0,0 +1,71 @@
+import {WebSocket} from 'ws';
+import {createMessageHandler} from './messageHandler.js';
+import type {ChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import type {ChatSession} from '../../types/session.js';
+import type {MessageChunk} from '../../types/ai.js';
+import type {SessionStore} from '../../types/sessionStore.js';
+import {deferred} from '../wsTestSupport.js';
+
+describe('list_sessions concurrency', () => {
+  it('answers list_sessions at once while a run is pending', async () => {
+    // ([validated by](src/transport/ws/listConcurrency.test.ts#L11))
+    const holdStream = deferred();
+    const orchestrator: ChatOrchestrator = {
+      processMessage: async () => 'hi',
+      async *processMessageStream(): AsyncGenerator<MessageChunk> {
+        await holdStream.until;
+        yield {type: 'text', text: 'hi'};
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+    };
+
+    const sessionStore: SessionStore = {
+      listFor: async () => [
+        {
+          sessionId: 's1',
+          createdAt: new Date('2026-01-01T00:00:00.000Z'),
+          updatedAt: new Date('2026-01-01T00:01:00.000Z'),
+          entryCount: 0,
+        },
+      ],
+      create: () => Promise.reject(new Error('not implemented')),
+      get: () => Promise.reject(new Error('not implemented')),
+      delete: () => Promise.reject(new Error('not implemented')),
+      count: () => Promise.reject(new Error('not implemented')),
+      clear: () => Promise.reject(new Error('not implemented')),
+    };
+
+    const sent: unknown[] = [];
+    const ws = {
+      send: (raw: string) => sent.push(JSON.parse(raw)),
+      readyState: WebSocket.OPEN,
+    } as unknown as WebSocket;
+
+    const handler = createMessageHandler(orchestrator, sessionStore, {history: {enabled: true}});
+    const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+
+    // 1. Start a user message (it will hang on holdStream)
+    const turn = handler(ws, session, {type: 'user_message', content: 'hello'});
+
+    // 2. Send list_sessions (it should NOT wait for the turn)
+    await handler(ws, session, {type: 'list_sessions'});
+
+    // At this point, session_list should be in `sent`, but NOT stream_end (which is sent after the turn finishes)
+    const beforeRelease = sent.map(f => (f as {type: string}).type);
+
+    // 3. Release the stream and wait for the turn to finish
+    holdStream.release();
+    await turn;
+    const afterRelease = sent.map(f => (f as {type: string}).type);
+
+    expect({
+      hasListBefore: beforeRelease.includes('session_list'),
