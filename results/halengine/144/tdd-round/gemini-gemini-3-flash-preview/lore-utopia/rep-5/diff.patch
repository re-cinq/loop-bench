+import {jest} from '@jest/globals';
+import {WebSocket} from 'ws';
+import {createMessageHandler} from './messageHandler.js';
+import type {ChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import type {ChatSession} from '../../types/session.js';
+import type {OutgoingMessage} from '../../types/messages.js';
+import {SessionStore, StoreCannotList} from '../../types/sessionStore.js';
+
+const harness = (sessionStore?: SessionStore) => {
+  return createHarness(sessionStore, {historyEnabled: true});
+};
+
+const harnessWithHistoryDisabled = (sessionStore?: SessionStore) => {
+  return createHarness(sessionStore, {historyEnabled: false});
+};
+
+const createHarness = (sessionStore: SessionStore | undefined, options: {historyEnabled: boolean}) => {
+  const {historyEnabled} = options;
+  const sent: OutgoingMessage[] = [];
+  const ws = {send: (raw: string) => sent.push(JSON.parse(raw) as OutgoingMessage)} as unknown as WebSocket;
+
+  const orchestrator = {} as unknown as ChatOrchestrator;
+  const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+
+  const handle = createMessageHandler(orchestrator, sessionStore, {
+    history: {enabled: historyEnabled},
+  });
+
+  return {
+    session,
+    sent,
+    send: (raw: unknown) => handle(ws, session, raw),
+  };
+};
+
+describe('messageHandler › list_sessions', () => {
+  it('answers UNSUPPORTED when history is disabled', async () => {
+    const h = harnessWithHistoryDisabled();
+
+    await h.send({type: 'list_sessions'});
+
+    expect(h.sent).toEqual([{type: 'error', code: 'UNSUPPORTED', message: 'Conversation history is not enabled'}]);
+  });
+
+  it('answers UNSUPPORTED when sessionStore is missing', async () => {
+    const h = harness();
+
+    await h.send({type: 'list_sessions'});
+
+    expect(h.sent).toEqual([
+      {type: 'error', code: 'UNSUPPORTED', message: 'Session store does not support listing conversations'},
+    ]);
+  });
+
+  const expectUnsupported = async (store: SessionStore) => {
+    const h = harness(store);
+    await h.send({type: 'list_sessions'});
+    expect(h.sent).toEqual([
+      {type: 'error', code: 'UNSUPPORTED', message: 'Session store does not support listing conversations'},
+    ]);
+  };
+
+  it('answers UNSUPPORTED when listFor is missing on sessionStore', async () => {
+    await expectUnsupported({
+      create: jest.fn(),
+      get: jest.fn(),
+      delete: jest.fn(),
+      count: jest.fn(),
+      clear: jest.fn(),
+    } as unknown as SessionStore);
+  });
+
+  it('answers UNSUPPORTED when listFor throws StoreCannotList', async () => {
+    await expectUnsupported({
+      listFor: () => Promise.reject(new StoreCannotList('misconfigured')),
+    } as unknown as SessionStore);
+  });
+});
