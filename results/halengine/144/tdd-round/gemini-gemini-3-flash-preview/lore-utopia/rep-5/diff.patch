+import {jest} from '@jest/globals';
+import {WebSocket} from 'ws';
+import {createMessageHandler} from './messageHandler.js';
+import type {ChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import type {ChatSession} from '../../types/session.js';
+import type {OutgoingMessage} from '../../types/messages.js';
+import type {SessionStore} from '../../types/sessionStore.js';
+
+describe('messageHandler concurrency', () => {
+  it('answers list_sessions while a user_message is streaming, without waiting for the lock', async () => {
+    const sent: OutgoingMessage[] = [];
+
+    // A delayed stream: it stays open until we resolve the trigger.
+    let resolveStream: () => void;
+    const streamTrigger = new Promise<void>(resolve => {
+      resolveStream = resolve;
+    });
+
+    const orchestrator = {
+      processMessageStream: async function* () {
+        yield {type: 'text', text: 'starting...'};
+        await streamTrigger;
+        yield {type: 'text', text: '...finished'};
+      },
+    } as unknown as ChatOrchestrator;
+
+    const store = {
+      listFor: jest.fn().mockReturnValue(Promise.resolve([])),
+    } as unknown as SessionStore;
+
+    const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+    const handle = createMessageHandler(orchestrator, store, {history: {enabled: true}});
+    const ws = {
+      readyState: WebSocket.OPEN,
+      send: (raw: string) => sent.push(JSON.parse(raw) as OutgoingMessage),
+    } as unknown as WebSocket;
+
+    // Start a user_message turn. It will yield once and then wait on streamTrigger.
+    const turn = handle(ws, session, {type: 'user_message', content: 'hello'});
+
+    // Wait for the first chunk to be processed and sent.
+    while (sent.length === 0) {
+      await new Promise(resolve => setTimeout(resolve, 10));
+    }
+
+    // Now send list_sessions. If it's concurrent, it should be answered IMMEDIATELY.
+    await handle(ws, session, {type: 'list_sessions'});
+
+    const noStreamEndYet = !sent.some(m => m.type === 'stream_end');
+
+    // Now finish the turn.
+    resolveStream!();
+    await turn;
+
+    expect({
+      hasEntryUpsert: sent.some(m => m.type === 'entry_upsert'),
+      hasSessionList: sent.some(m => m.type === 'session_list'),
+      noStreamEndYet,
+      hasStreamEndFinally: sent.some(m => m.type === 'stream_end'),
+    }).toEqual({
+      hasEntryUpsert: true,
+      hasSessionList: true,
+      noStreamEndYet: true,
+      hasStreamEndFinally: true,
+    });
+  });
+});
