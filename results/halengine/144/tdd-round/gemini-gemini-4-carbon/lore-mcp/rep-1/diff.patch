+
+describe('handling list_sessions in the message handler', () => {
+  it('answers list_sessions with ISO dates before a trailing ping and logs SERVER_ERROR on failure', async () => {
+    const recordedCalls: Array<{userId: string | number; options?: SessionListOptions}> = [];
+    const listingStore = stubStore(async (userId, options) => {
+      recordedCalls.push({userId, options});
+      return [
+        {
+          sessionId: 'conv-1',
+          createdAt: new Date('2026-02-01T00:00:00.000Z'),
+          updatedAt: new Date('2026-02-01T00:03:00.000Z'),
+          entryCount: 2,
+        },
+      ];
+    });
+    const cursor = {updatedAt: '2026-02-01T00:05:00.000Z', sessionId: 'cursor-1'};
+    const failingStore = stubStore(() => Promise.reject(new Error('store unreachable')));
+    const stringFailingStore = stubStore(() => Promise.reject('plain failure'));
+
+    const listed = await runBurst(listingStore, [
+      {type: 'list_sessions', limit: 5, before: cursor, userId: 'spoofed-user'},
+      {type: 'ping', timestamp: 77},
+    ]);
+    const omittedStore = await runBurst(undefined, [{type: 'list_sessions'}]);
+    const omittedMember = await runBurst(stubStore(), [{type: 'list_sessions'}]);
+    const rejectedError = await runBurst(failingStore, [{type: 'list_sessions'}]);
+    const rejectedReason = await runBurst(stringFailingStore, [{type: 'list_sessions'}]);
+
+    expect({recordedCalls, listed, omittedStore, omittedMember, rejectedError, rejectedReason, wsErrors}).toEqual({
+      recordedCalls: [{userId: 'user-7', options: {limit: 5, before: cursor}}],
+      listed: [
+        {
+          type: 'session_list',
+          sessions: [
+            {
+              sessionId: 'conv-1',
+              createdAt: '2026-02-01T00:00:00.000Z',
+              updatedAt: '2026-02-01T00:03:00.000Z',
+              entryCount: 2,
+            },
+          ],
+        },
+        {type: 'pong', timestamp: 77},
+      ],
+      omittedStore: [{type: 'session_list', sessions: []}],
+      omittedMember: [{type: 'session_list', sessions: []}],
+      rejectedError: [{type: 'error', code: 'SERVER_ERROR', message: expect.any(String)}],
+      rejectedReason: [{type: 'error', code: 'SERVER_ERROR', message: expect.any(String)}],
+      wsErrors: [
+        {category: 'ws', message: expect.any(String), fields: {userId: 'user-7', error: 'store unreachable'}},
+        {category: 'ws', message: expect.any(String), fields: {userId: 'user-7', error: 'plain failure'}},
+      ],
+    });
+  });
+});
+
+async function runBurst(sessionStore: SessionStore | undefined, inbound: unknown[]): Promise<OutgoingMessage[]> {
+  const outbound: OutgoingMessage[] = [];
+  const send = (raw: string) => void outbound.push(JSON.parse(raw) as OutgoingMessage);
+  const socket = {send} as unknown as WebSocket;
+  const orchestrator = {} as ChatOrchestrator;
+  const session: ChatSession = {sessionId: 'sess-7', userId: 'user-7', entries: []};
+  const runWithStore = (store: SessionStore) => createMessageHandler(orchestrator, store);
+  const handle = sessionStore ? runWithStore(sessionStore) : createMessageHandler(orchestrator);
+
+  const tasks = inbound.map(frame => handle(socket, session, frame));
+  await Promise.all(tasks);
+  return outbound;
+}
+
+function stubStore(listFor?: SessionStore['listFor']): SessionStore {
+  return {
+    create: (sessionId, userId) => ({sessionId, userId, entries: []}),
+    get: () => undefined,
+    delete: () => false,
+    count: () => 0,
+    clear: () => undefined,
+    ...(listFor ? {listFor} : {}),
+  };
+}
