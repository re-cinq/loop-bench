+type ParsedField<T> = {valid: true; value: T} | ValidationFailure;
+
+function validateListSessionsMessage(message: Record<string, unknown>): ValidationResult {
+  const limit = parseLimit(message.limit);
+  if (!limit.valid) {
+    return limit;
+  }
+
+  const before = parseBeforeCursor(message.before);
+  if (!before.valid) {
+    return before;
+  }
+
+  const frame: ListSessionsMessage = {type: 'list_sessions'};
+  if (limit.value !== undefined) {
+    frame.limit = limit.value;
+  }
+  if (before.value !== undefined) {
+    frame.before = before.value;
+  }
+
+  return {valid: true, data: frame};
+}
+
+function parseLimit(limit: unknown): ParsedField<number | undefined> {
+  if (limit === undefined) {
+    return {valid: true, value: undefined};
+  }
+  if (typeof limit !== 'number' || !Number.isInteger(limit)) {
+    return {valid: false, error: 'list_sessions limit must be a non-negative integer'};
+  }
+  if (limit < 0) {
+    return {valid: false, error: 'list_sessions limit must be a non-negative integer'};
+  }
+  return {valid: true, value: limit};
+}
+
+function parseBeforeCursor(before: unknown): ParsedField<{updatedAt: string | number; sessionId: string} | undefined> {
+  if (before === undefined) {
+    return {valid: true, value: undefined};
+  }
+  if (!isPlainRecord(before)) {
+    return {valid: false, error: 'list_sessions before must be an object'};
+  }
+  const {sessionId, updatedAt} = before;
+  if (!isBoundedSessionId(sessionId)) {
+    return {valid: false, error: 'list_sessions before.sessionId must be 1 to 128 characters'};
+  }
+  if (!isFiniteTimestamp(updatedAt)) {
+    return {valid: false, error: 'list_sessions before.updatedAt must be a valid timestamp'};
+  }
+  return {valid: true, value: {updatedAt, sessionId}};
+}
+
+function isPlainRecord(candidate: unknown): candidate is Record<string, unknown> {
+  if (typeof candidate !== 'object' || candidate === null) {
+    return false;
+  }
+  return !Array.isArray(candidate);
+}
+
+const MAX_SESSION_ID_LENGTH = 128;
+
+function isBoundedSessionId(candidate: unknown): candidate is string {
+  if (typeof candidate !== 'string') {
+    return false;
+  }
+  return candidate.length >= 1 && candidate.length <= MAX_SESSION_ID_LENGTH;
+}
+
+function isFiniteTimestamp(candidate: unknown): candidate is string | number {
+  if (typeof candidate !== 'string' && typeof candidate !== 'number') {
+    return false;
+  }
+  const epochMs = new Date(candidate).getTime();
+  return Number.isFinite(epochMs);
+}
