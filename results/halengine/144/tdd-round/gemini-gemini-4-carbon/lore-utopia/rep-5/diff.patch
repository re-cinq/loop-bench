@@ -0,0 +1,107 @@
+import type {WebSocket} from 'ws';
+import {createMessageHandler} from './messageHandler.js';
+import type {ChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import type {ChatSession} from '../../types/session.js';
+import type {OutgoingMessage} from '../../types/messages.js';
+import type {SessionCursor, SessionListOptions, SessionStore} from '../../types/sessionStore.js';
+import {captureErrors} from '../../shared/logCaptureTestSupport.js';
+
+const idleOrchestrator = {} as ChatOrchestrator;
+
+describe('handling list_sessions in createMessageHandler', () => {
+  const errors = captureErrors();
+
+  it('answers list_sessions for the session owner with ISO dates, empty list when omitted, and SERVER_ERROR on failure', async () => {
+    const queries: Array<{owner: string | number; options?: SessionListOptions}> = [];
+    const createdAt = new Date('2026-03-10T12:00:00.000Z');
+    const updatedAt = new Date('2026-03-10T12:15:00.000Z');
+    const cursor: SessionCursor = {updatedAt: '2026-03-10T12:30:00.000Z', sessionId: 'conv-10'};
+    const listingStore: SessionStore = {
+      ...minimalSessionStore(),
+      listFor: (owner, options) => {
+        queries.push({owner, options});
+        return [{sessionId: 'conv-9', createdAt, updatedAt, entryCount: 7}];
+      },
+    };
+    const errorStore: SessionStore = {
+      ...minimalSessionStore(),
+      listFor: () => Promise.reject(new Error('storage offline')),
+    };
+    const nonErrorStore: SessionStore = {
+      ...minimalSessionStore(),
+      listFor: () => Promise.reject('raw rejection'),
+    };
+
+    const paged = await dispatchToHandler(createMessageHandler(idleOrchestrator, listingStore), {
