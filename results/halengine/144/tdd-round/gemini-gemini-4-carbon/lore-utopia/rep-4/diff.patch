--- /dev/null
+++ b/src/transport/serverSessionList.test.ts
@@ -0,0 +1,74 @@
+import express from 'express';
+import {createServer, type HalServer} from './createServer.js';
+import {answeringOrchestrator, connectClient, deferred, requiredStoreMembers, stopEngines} from './wsTestSupport.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {captureErrors} from '../shared/logCaptureTestSupport.js';
+import type {SessionStore} from '../types/sessionStore.js';
+
+describe('createServer conversation list wiring', () => {
+  const errors = captureErrors();
+
+  it('forwards sessionStore to the message handler so list_sessions reads the configured store', async () => {
+    const store: SessionStore = {
+      ...requiredStoreMembers(new InMemorySessionStore()),
+      listFor: userId => [
+        {
+          sessionId: `owned-by-${userId}`,
+          createdAt: new Date('2026-03-01T10:00:00.000Z'),
+          updatedAt: new Date('2026-03-01T10:05:00.000Z'),
+          entryCount: 2,
+        },
+      ],
+    };
+    const disconnected = deferred();
+    const hal = createServer({
+      app: express(),
+      wsAuth: async () => ({id: 'u1'}),
+      sessionStore: store,
+      orchestrator: answeringOrchestrator,
+      onDisconnect: disconnected.release,
+    });
+    await hal.start(0);
+
+    try {
+      const listedIds = await requestSessionIds(boundWsUrl(hal));
+      await disconnected.until;
+      expect({listedIds, errors}).toEqual({listedIds: ['owned-by-u1'], errors: []});
+    } finally {
+      await stopEngines();
+      await hal.stop();
+    }
+  });
+});
+
+function boundWsUrl(hal: HalServer): string {
+  const address = hal.server.address();
+  if (typeof address !== 'object' || address === null) {
+    throw new Error('Expected server to bind an ephemeral TCP port');
+  }
+  return `ws://127.0.0.1:${address.port}/hal/ws`;
+}
+
+function requestSessionIds(url: string): Promise<string[]> {
+  const client = connectClient(url);
+  return new Promise((resolve, reject) => {
+    client.on('error', reject);
+    client.on('message', raw => {
+      const frame: unknown = JSON.parse(String(raw));
+      if (!isObjectFrame(frame)) return;
+      if (frame.type === 'connected') {
+        client.send(JSON.stringify({type: 'list_sessions'}));
+        return;
+      }
+      if (frame.type !== 'session_list' || !Array.isArray(frame.sessions)) return;
+      client.close();
+      resolve(
+        frame.sessions.flatMap(row => (isObjectFrame(row) && typeof row.sessionId === 'string' ? [row.sessionId] : []))
+      );
+    });
+  });
+}
+
+function isObjectFrame(candidate: unknown): candidate is Record<string, unknown> {
+  return typeof candidate === 'object' && candidate !== null;
+}
