@@ -0,0 +1,54 @@
+import type {WebSocket} from 'ws';
+import {createMessageHandler} from './ws/messageHandler.js';
+import {answeringOrchestrator, connectClient, framesUntil, startEngineWith, stopEngines} from './wsTestSupport.js';
+import {fiveMemberStore} from '../infrastructure/stores/sessionStoreTestSupport.js';
+import type {ChatSession} from '../types/session.js';
+import type {OutgoingMessage} from '../types/messages.js';
+import type {SessionStore} from '../types/sessionStore.js';
+
+// createMessageHandler takes an optional store so existing callers keep working while createServer wires its store in.
+
+describe('wiring sessionStore into the WebSocket message handler', () => {
+  afterEach(stopEngines);
+
+  it('threads an optional sessionStore into createMessageHandler and wires options.sessionStore in createServer', async () => {
+    const listedUsers: Array<string | number> = [];
+    const store: SessionStore = {
+      ...fiveMemberStore,
+      listFor: userId => {
+        listedUsers.push(userId);
+        return [];
+      },
+    };
+    const directFrames: OutgoingMessage[] = [];
+    const socket = {
+      send: (raw: string) => void directFrames.push(JSON.parse(raw) as OutgoingMessage),
+    } as unknown as WebSocket;
+    const session: ChatSession = {sessionId: 's1', userId: 'direct-user', entries: []};
+
+    await createMessageHandler(answeringOrchestrator)(socket, session, {type: 'list_sessions'});
+    await createMessageHandler(answeringOrchestrator, undefined)(socket, session, {type: 'list_sessions'});
+    await createMessageHandler(answeringOrchestrator, store)(socket, session, {type: 'list_sessions'});
+
+    const {url} = await startEngineWith({sessionStore: store, wsAuth: async () => ({id: 'server-user'})});
+    const client = connectClient(url);
+    const settled = framesUntil(client, 'pong');
+    client.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as {type: string};
+      if (frame.type !== 'connected') return;
+      client.send(JSON.stringify({type: 'list_sessions'}));
+      client.send(JSON.stringify({type: 'ping', timestamp: 1}));
+    });
+    const seenTypes = await settled;
+
+    expect({
+      listedUsers,
+      directErrors: directFrames.filter(frame => frame.type === 'error'),
+      endedOnPong: seenTypes.at(-1),
+    }).toEqual({
+      listedUsers: ['direct-user', 'server-user'],
+      directErrors: [],
+      endedOnPong: 'pong',
+    });
+  });
+});
diff --git a/src/transport/ws/listSessionsHandler.test.ts b/src/transport/ws/listSessionsHandler.test.ts
new file mode 100644
