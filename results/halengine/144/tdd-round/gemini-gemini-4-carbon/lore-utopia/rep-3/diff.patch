+++ b/src/transport/ws/listSessionsHandler.test.ts
@@ -0,0 +1,89 @@
+import type {WebSocket} from 'ws';
+import {createMessageHandler} from './messageHandler.js';
+import {answeringOrchestrator} from '../wsTestSupport.js';
+import {fiveMemberStore} from '../../infrastructure/stores/sessionStoreTestSupport.js';
+import {captureErrors} from '../../shared/logCaptureTestSupport.js';
+import type {OutgoingMessage} from '../../types/messages.js';
+import type {SessionCursor, SessionListOptions, SessionStore} from '../../types/sessionStore.js';
+
+// list_sessions answers from session.userId with ISO timestamps, empty when unimplemented, and SERVER_ERROR on failure.
+
+const askList = async (store?: SessionStore, frame: unknown = {type: 'list_sessions'}): Promise<OutgoingMessage[]> => {
+  const sentFrames: OutgoingMessage[] = [];
+  const fakeSocket = {send: (payload: string) => sentFrames.push(JSON.parse(payload) as OutgoingMessage)};
+  await createMessageHandler(answeringOrchestrator, store)(
+    fakeSocket as unknown as WebSocket,
+    {sessionId: 'active-1', userId: 'owner-1', entries: []},
+    frame
+  );
+  return sentFrames;
+};
+
+describe('handling list_sessions in the WebSocket message handler', () => {
+  const loggedErrors = captureErrors();
+
+  it('answers session_list with ISO dates for session.userId, empty without listFor, and SERVER_ERROR on failure', async () => {
+    const recordedCalls: Array<{userId: string | number; options?: SessionListOptions}> = [];
+    const cursor: SessionCursor = {updatedAt: '2026-02-01T10:10:00.000Z', sessionId: 's9'};
+    const listed = await askList(
+      {
+        ...fiveMemberStore,
+        listFor: (userId, options) => {
+          recordedCalls.push({userId, options});
+          return [
+            {
+              sessionId: 's2',
+              createdAt: new Date('2026-02-01T10:00:00.000Z'),
+              updatedAt: new Date('2026-02-01T10:05:00.000Z'),
+              entryCount: 3,
+            },
+          ];
+        },
+      },
+      {type: 'list_sessions', limit: 5, before: cursor, userId: 'spoofed-user'}
+    );
+    const omittedStore = await askList();
+    const minimalStore = await askList(fiveMemberStore);
+    const rejectedError = await askList({
+      ...fiveMemberStore,
+      listFor: () => Promise.reject(new Error('store unreachable')),
+    });
+    const rejectedString = await askList({
+      ...fiveMemberStore,
+      listFor: () => Promise.reject('raw outage'),
+    });
+
+    expect({
+      recordedCalls,
+      listed,
+      omittedStore,
+      minimalStore,
+      rejectedError,
+      rejectedString,
+      loggedErrors,
+    }).toEqual({
+      recordedCalls: [{userId: 'owner-1', options: {limit: 5, before: cursor}}],
+      listed: [
+        {
+          type: 'session_list',
+          sessions: [
+            {
+              sessionId: 's2',
+              createdAt: '2026-02-01T10:00:00.000Z',
+              updatedAt: '2026-02-01T10:05:00.000Z',
+              entryCount: 3,
+            },
+          ],
+        },
+      ],
+      omittedStore: [{type: 'session_list', sessions: []}],
+      minimalStore: [{type: 'session_list', sessions: []}],
+      rejectedError: [{type: 'error', code: 'SERVER_ERROR', message: 'Could not list sessions'}],
+      rejectedString: [{type: 'error', code: 'SERVER_ERROR', message: 'Could not list sessions'}],
+      loggedErrors: [
+        {category: 'ws', message: 'session list failed', userId: 'owner-1', error: 'store unreachable'},
+        {category: 'ws', message: 'session list failed', userId: 'owner-1', error: 'raw outage'},
+      ],
+    });
+  });
+});
