+function validateListSessionsMessage(message: Record<string, unknown>): ValidationResult {
+  const limitResult = parseOptionalLimit(message.limit);
+  if (!limitResult.ok) return {valid: false, error: limitResult.error};
+
+  const beforeResult = parseOptionalBefore(message.before);
+  if (!beforeResult.ok) return {valid: false, error: beforeResult.error};
+
+  const validated: ListSessionsMessage = {
+    type: 'list_sessions',
+    ...(limitResult.limit !== undefined ? {limit: limitResult.limit} : {}),
+    ...(beforeResult.before !== undefined ? {before: beforeResult.before} : {}),
+  };
+  return {valid: true, data: validated};
+}
+
+type LimitParseResult = {ok: true; limit: number | undefined} | {ok: false; error: string};
+
+function parseOptionalLimit(rawLimit: unknown): LimitParseResult {
+  if (rawLimit === undefined) return {ok: true, limit: undefined};
+  if (!isWholeNumber(rawLimit)) {
+    return {ok: false, error: 'list_sessions limit must be a non-negative integer'};
+  }
+  return {ok: true, limit: rawLimit};
+}
+
+function isWholeNumber(limit: unknown): limit is number {
+  return typeof limit === 'number' && Number.isInteger(limit) && limit >= 0;
+}
+
+type BeforeCursor = NonNullable<ListSessionsMessage['before']>;
+type BeforeParseResult = {ok: true; before: BeforeCursor | undefined} | {ok: false; error: string};
+
+function parseOptionalBefore(rawBefore: unknown): BeforeParseResult {
+  if (rawBefore === undefined) return {ok: true, before: undefined};
+  if (!isCursorRecord(rawBefore)) {
+    return {ok: false, error: 'list_sessions before must be an object'};
+  }
+  if (!isBoundedSessionId(rawBefore.sessionId)) {
+    return {ok: false, error: 'list_sessions before.sessionId must be 1 to 128 characters'};
+  }
+  if (!isParseableTimestamp(rawBefore.updatedAt)) {
+    return {ok: false, error: 'list_sessions before.updatedAt must be a valid timestamp'};
+  }
+  return {
+    ok: true,
+    before: {
+      updatedAt: rawBefore.updatedAt,
+      sessionId: rawBefore.sessionId,
+    },
+  };
+}
+
+function isCursorRecord(cursor: unknown): cursor is Record<string, unknown> {
+  return typeof cursor === 'object' && cursor !== null && !Array.isArray(cursor);
+}
+
+const MAX_SESSION_ID_LENGTH = 128;
+
+function isBoundedSessionId(sessionId: unknown): sessionId is string {
+  return typeof sessionId === 'string' && sessionId.length >= 1 && sessionId.length <= MAX_SESSION_ID_LENGTH;
+}
+
+function isParseableTimestamp(updatedAt: unknown): updatedAt is string | number {
+  if (typeof updatedAt !== 'string' && typeof updatedAt !== 'number') return false;
+  return Number.isFinite(new Date(updatedAt).getTime());
+}
