+function validateListSessionsMessage(message: Record<string, unknown>): ValidationResult {
+  const limitResult = parseLimit(message.limit);
+  if (!limitResult.valid) return {valid: false, error: limitResult.error};
+
+  const cursorResult = parseCursor(message.before);
+  if (!cursorResult.valid) return {valid: false, error: cursorResult.error};
+
+  const frame: ListSessionsMessage = {type: 'list_sessions'};
+  if (limitResult.limit !== undefined) frame.limit = limitResult.limit;
+  if (cursorResult.cursor !== undefined) frame.before = cursorResult.cursor;
+  return {valid: true, data: frame};
+}
+
+type ParsedLimit = {valid: true; limit?: number} | {valid: false; error: string};
+
+function parseLimit(limit: unknown): ParsedLimit {
+  if (limit === undefined) return {valid: true};
+  if (!isValidLimit(limit)) return {valid: false, error: 'list_sessions limit must be a non-negative integer'};
+  return {valid: true, limit};
+}
+
+function isValidLimit(candidate: unknown): candidate is number {
+  if (typeof candidate !== 'number' || !Number.isInteger(candidate)) return false;
+  return candidate >= 0;
+}
+
+type ParsedCursor = {valid: true; cursor?: SessionCursor} | {valid: false; error: string};
+
+function parseCursor(before: unknown): ParsedCursor {
+  if (before === undefined) return {valid: true};
+  if (!isPlainObject(before)) return {valid: false, error: 'list_sessions before must be an object'};
+  if (!isCursorSessionId(before.sessionId)) {
+    return {valid: false, error: 'list_sessions before.sessionId must be 1 to 128 characters'};
+  }
+  if (!isCursorTimestamp(before.updatedAt)) {
+    return {valid: false, error: 'list_sessions before.updatedAt must be a valid timestamp'};
+  }
+  return {valid: true, cursor: {updatedAt: before.updatedAt, sessionId: before.sessionId}};
+}
+
+function isPlainObject(candidate: unknown): candidate is Record<string, unknown> {
+  if (typeof candidate !== 'object' || candidate === null) return false;
+  return !Array.isArray(candidate);
+}
+
+const MAX_SESSION_ID_LENGTH = 128;
+
+function isCursorSessionId(candidate: unknown): candidate is string {
+  if (typeof candidate !== 'string') return false;
+  return candidate.length >= 1 && candidate.length <= MAX_SESSION_ID_LENGTH;
+}
+
+function isCursorTimestamp(candidate: unknown): candidate is string | number {
+  if (typeof candidate !== 'string' && typeof candidate !== 'number') return false;
+  return Number.isFinite(new Date(candidate).getTime());
+}
