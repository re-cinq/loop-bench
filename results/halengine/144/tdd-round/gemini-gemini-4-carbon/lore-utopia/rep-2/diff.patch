@@ -0,0 +1,83 @@
+import type {WebSocket} from 'ws';
+import {createMessageHandler} from './messageHandler.js';
+import {fiveMemberStore} from '../../infrastructure/stores/sessionStoreTestSupport.js';
+import {captureErrors} from '../../shared/logCaptureTestSupport.js';
+import type {ChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import type {OutgoingMessage, SessionSummaryFrame} from '../../types/messages.js';
+import type {ChatSession} from '../../types/session.js';
+import type {SessionListOptions, SessionStore, SessionSummary} from '../../types/sessionStore.js';
+
+// Message-handler unit seam for list_sessions: store wiring, ISO date serialisation, absent listFor, and ws error reporting.
+
+const sendFrame = async (rawMessage: unknown, sessionStore?: SessionStore): Promise<OutgoingMessage[]> => {
+  const sent: OutgoingMessage[] = [];
+  const ws = {send: (raw: string) => void sent.push(JSON.parse(raw) as OutgoingMessage)} as unknown as WebSocket;
+  const session: ChatSession = {sessionId: 's-active', userId: 'owner-7', entries: []};
+  const orchestrator = {} as ChatOrchestrator;
+  await createMessageHandler(orchestrator, sessionStore)(ws, session, rawMessage);
+  return sent;
+};
+
+const minimalStore = (listFor?: SessionStore['listFor']): SessionStore =>
+  listFor ? {...fiveMemberStore, listFor} : {...fiveMemberStore};
+
+describe('handling list_sessions frames', () => {
+  const errors = captureErrors();
+
+  it('lists the session owner conversations with ISO dates, defaults to empty without listFor, and logs SERVER_ERROR on failure', async () => {
+    const createdAt = new Date('2026-02-01T10:00:00.000Z');
+    const updatedAt = new Date('2026-02-01T10:05:00.000Z');
+    const calls: Array<{userId: string | number; options?: SessionListOptions}> = [];
+    const rows: SessionSummary[] = [{sessionId: 's-1', createdAt, updatedAt, entryCount: 3}];
+    const listingStore = minimalStore((userId, options) => {
+      calls.push({userId, options});
+      return rows;
+    });
+    const before = {updatedAt: '2026-02-01T12:00:00.000Z', sessionId: 's-9'};
+
+    const listed = await sendFrame({type: 'list_sessions', limit: 5, before, userId: 'intruder'}, listingStore);
+    const bare = await sendFrame({type: 'list_sessions'}, listingStore);
+    const omittedFrames = [
+      await sendFrame({type: 'list_sessions'}),
+      await sendFrame({type: 'list_sessions'}, minimalStore()),
+    ];
+    const thrownFrames = [
+      ...(await sendFrame(
+        {type: 'list_sessions'},
+        minimalStore(() => Promise.reject(new Error('store timeout')))
+      )),
+      ...(await sendFrame(
+        {type: 'list_sessions'},
+        minimalStore(() => Promise.reject('plain failure'))
+      )),
+    ];
+    const expectedRow: SessionSummaryFrame = {
+      sessionId: 's-1',
+      createdAt: '2026-02-01T10:00:00.000Z',
+      updatedAt: '2026-02-01T10:05:00.000Z',
+      entryCount: 3,
+    };
+
+    expect({
+      calls,
+      listed,
+      bare,
+      omittedFrames,
+      thrownCodes: thrownFrames.map(frame => (frame.type === 'error' ? frame.code : frame.type)),
+      errors,
+    }).toEqual({
+      calls: [
+        {userId: 'owner-7', options: {limit: 5, before}},
+        {userId: 'owner-7', options: {}},
+      ],
+      listed: [{type: 'session_list', sessions: [expectedRow]}],
+      bare: [{type: 'session_list', sessions: [expectedRow]}],
+      omittedFrames: [[{type: 'session_list', sessions: []}], [{type: 'session_list', sessions: []}]],
+      thrownCodes: ['SERVER_ERROR', 'SERVER_ERROR'],
+      errors: [
+        {category: 'ws', message: 'session list failed', userId: 'owner-7', error: 'store timeout'},
+        {category: 'ws', message: 'session list failed', userId: 'owner-7', error: 'plain failure'},
+      ],
+    });
+  });
+});
