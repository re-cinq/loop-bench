+import type {ChatSession} from '../../types/session.js';
+import type {OutgoingMessage} from '../../types/messages.js';
+import type {SessionCursor, SessionListOptions, SessionSummary} from '../../types/sessionStore.js';
+
+const openCaptureSocket = () => {
+  const sent: OutgoingMessage[] = [];
+  const ws = {send: (raw: string) => void sent.push(JSON.parse(raw) as OutgoingMessage)} as unknown as WebSocket;
+  return {ws, sent};
+};
+
+describe('handling list_sessions frames', () => {
+  const errorLogs = captureErrors();
+  const session: ChatSession = {sessionId: 'sess-active', userId: 'owner-1', entries: []};
+
+  it('answers session_list with ISO dates for session.userId, empty when listFor is absent, and SERVER_ERROR on ws log when listFor fails', async () => {
+    const orchestrator = {} as ChatOrchestrator;
+    const recorded: Array<{userId: string | number; options?: SessionListOptions}> = [];
+    const handleListed = createMessageHandler(orchestrator, {
+      ...fiveMemberStore,
+      listFor: async (userId, options): Promise<SessionSummary[]> => {
+        recorded.push({userId, options});
+        return [
+          {
+            sessionId: 'conv-1',
+            createdAt: new Date('2026-03-10T08:00:00.000Z'),
+            updatedAt: new Date('2026-03-10T08:15:00.000Z'),
+            entryCount: 3,
+          },
+        ];
+      },
+    });
+    const listedSocket = openCaptureSocket();
+    const before: SessionCursor = {updatedAt: '2026-03-10T09:00:00.000Z', sessionId: 'conv-9'};
+    const listPending = handleListed(listedSocket.ws, session, {
+      type: 'list_sessions',
+      limit: 25,
+      before,
+      userId: 'other-user',
+    });
+    const pingPending = handleListed(listedSocket.ws, session, {type: 'ping', timestamp: 7});
+    await Promise.all([listPending, pingPending]);
+
+    const omittedSocket = openCaptureSocket();
+    await createMessageHandler(orchestrator, fiveMemberStore)(omittedSocket.ws, session, {type: 'list_sessions'});
+    await createMessageHandler(orchestrator)(omittedSocket.ws, session, {type: 'list_sessions'});
+
+    const failedSocket = openCaptureSocket();
+    await createMessageHandler(orchestrator, {
+      ...fiveMemberStore,
+      listFor: () => Promise.reject(new Error('store unavailable')),
+    })(failedSocket.ws, session, {type: 'list_sessions'});
+    await createMessageHandler(orchestrator, {
+      ...fiveMemberStore,
+      listFor: () => Promise.reject('string rejection'),
+    })(failedSocket.ws, session, {type: 'list_sessions'});
+
+    expect({
+      recorded,
+      listed: listedSocket.sent,
+      omitted: omittedSocket.sent,
+      failed: failedSocket.sent,
+      errorLogs,
+    }).toEqual({
+      recorded: [{userId: 'owner-1', options: {limit: 25, before}}],
+      listed: [
+        {
+          type: 'session_list',
+          sessions: [
+            {
+              sessionId: 'conv-1',
+              createdAt: '2026-03-10T08:00:00.000Z',
+              updatedAt: '2026-03-10T08:15:00.000Z',
+              entryCount: 3,
+            },
+          ],
+        },
+        {type: 'pong', timestamp: 7},
+      ],
+      omitted: [
+        {type: 'session_list', sessions: []},
+        {type: 'session_list', sessions: []},
+      ],
+      failed: [
+        {type: 'error', code: 'SERVER_ERROR', message: 'Could not list sessions'},
+        {type: 'error', code: 'SERVER_ERROR', message: 'Could not list sessions'},
+      ],
+      errorLogs: [
+        {
+          category: 'ws',
+          message: 'session list failed',
+          sessionId: 'sess-active',
+          userId: 'owner-1',
+          error: 'store unavailable',
+        },
+        {
+          category: 'ws',
+          message: 'session list failed',
+          sessionId: 'sess-active',
+          userId: 'owner-1',
+          error: 'string rejection',
+        },
+      ],
+    });
+  });
+});
