+import type {WebSocket} from 'ws';
+import {createMessageHandler} from './messageHandler.js';
+import type {ChatOrchestrator} from '../../orchestration/chatOrchestrator.js';
+import type {MessageChunk} from '../../types/ai.js';
+import type {ChatSession} from '../../types/session.js';
+import type {OutgoingMessage} from '../../types/messages.js';
+import type {SessionListOptions, SessionStore} from '../../types/sessionStore.js';
+import {fiveMemberStore} from '../../infrastructure/stores/sessionStoreTestSupport.js';
+import {captureErrors} from '../../shared/logCaptureTestSupport.js';
+import {deferred} from '../wsTestSupport.js';
+
+// Listing conversations runs outside the per-session turn lock and serialises store summaries onto the wire.
+
+const harness = (sessionStore?: SessionStore, hold?: Promise<void>) => {
+  const sent: OutgoingMessage[] = [];
+  const ws = {send: (raw: string) => sent.push(JSON.parse(raw) as OutgoingMessage)} as unknown as WebSocket;
+  const orchestrator = {
+    async *processMessageStream(): AsyncGenerator<MessageChunk> {
+      yield {type: 'text', text: 'working'};
+      if (hold) await hold;
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+  } as unknown as ChatOrchestrator;
+  const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+  const handle = sessionStore ? createMessageHandler(orchestrator, sessionStore) : createMessageHandler(orchestrator);
+
+  return {
+    sent,
+    send: (raw: unknown) => handle(ws, session, raw),
+  };
+};
+
+describe('listing a user conversations in the message handler', () => {
+  const errors = captureErrors();
+
+  it('answers list_sessions immediately with ISO dates for session.userId, empty without listFor, and a ws SERVER_ERROR when listFor fails', async () => {
+    const withoutStore = harness();
+    await withoutStore.send({type: 'list_sessions'});
+
+    const withoutMethod = harness(fiveMemberStore);
+    await withoutMethod.send({type: 'list_sessions'});
+
+    const failing = harness({...fiveMemberStore, listFor: () => Promise.reject(new Error('db down'))});
+    await failing.send({type: 'list_sessions'});
+
+    const stringFailing = harness({...fiveMemberStore, listFor: () => Promise.reject('timeout')});
+    await stringFailing.send({type: 'list_sessions'});
+
+    const calls: Array<{userId: string | number; options?: SessionListOptions}> = [];
+    const listingStore: SessionStore = {
+      ...fiveMemberStore,
+      listFor: async (userId, options) => {
+        calls.push({userId, options});
+        return [
+          {
+            sessionId: 's0',
+            createdAt: new Date('2026-01-01T00:00:00.000Z'),
+            updatedAt: new Date('2026-01-01T00:02:00.000Z'),
+            entryCount: 3,
+          },
+        ];
+      },
+    };
+    const gate = deferred();
+    const active = harness(listingStore, gate.until);
+    const cursor = {updatedAt: '2026-01-01T00:05:00.000Z', sessionId: 's9'};
+    const turn = active.send({type: 'user_message', content: 'A'});
+    await new Promise(resolve => setImmediate(resolve));
+    await active.send({type: 'list_sessions', limit: 5, before: cursor, userId: 'u2'});
+    const listedDuringTurn = active.sent.at(-1);
+    gate.release();
+    await turn;
+
+    expect({
+      calls,
+      listedDuringTurn,
+      withoutStore: withoutStore.sent,
+      withoutMethod: withoutMethod.sent,
+      failing: failing.sent.map(frame => (frame.type === 'error' ? `${frame.type} ${frame.code}` : frame.type)),
+      stringFailing: stringFailing.sent.map(frame =>
+        frame.type === 'error' ? `${frame.type} ${frame.code}` : frame.type
+      ),
+      errors,
+    }).toEqual({
+      calls: [{userId: 'u1', options: {limit: 5, before: cursor}}],
+      listedDuringTurn: {
+        type: 'session_list',
+        sessions: [
+          {
+            sessionId: 's0',
+            createdAt: '2026-01-01T00:00:00.000Z',
+            updatedAt: '2026-01-01T00:02:00.000Z',
+            entryCount: 3,
+          },
+        ],
+      },
+      withoutStore: [{type: 'session_list', sessions: []}],
+      withoutMethod: [{type: 'session_list', sessions: []}],
+      failing: ['error SERVER_ERROR'],
+      stringFailing: ['error SERVER_ERROR'],
+      errors: [
+        {category: 'ws', message: 'session list failed', sessionId: 's1', userId: 'u1', error: 'db down'},
+        {category: 'ws', message: 'session list failed', sessionId: 's1', userId: 'u1', error: 'timeout'},
+      ],
+    });
+  });
+});
