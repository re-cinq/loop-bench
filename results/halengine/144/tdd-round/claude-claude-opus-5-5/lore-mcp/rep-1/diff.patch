+function validateListSessionsMessage(message: Record<string, unknown>): ValidationResult {
+  const {limit, before} = message;
+  if (limit !== undefined && !isPageSize(limit)) {
+    return {valid: false, error: 'list_sessions limit must be a non-negative integer'};
+  }
+  if (before !== undefined && !isSessionCursor(before)) {
+    return {valid: false, error: 'list_sessions before must be an {updatedAt, sessionId} cursor'};
+  }
