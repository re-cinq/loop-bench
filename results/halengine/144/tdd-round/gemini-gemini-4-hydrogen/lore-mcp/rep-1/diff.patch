+    sendSessionList(ws, []);
+    return;
+  }
+  try {
+    const summaries = await sessionStore.listFor(session.userId, {
+      limit: message.limit,
+      before: message.before,
+    });
+    sendSessionList(ws, summaries.map(toSessionSummaryFrame));
+  } catch (error) {
+    const detail = error instanceof Error ? error.message : 'Unknown error';
+    log.error('ws', 'failed to list sessions', {userId: session.userId, error: detail});
+    sendError(ws, ErrorCodes.SERVER_ERROR, 'Failed to list sessions');
+  }
+}
+
+function toSessionSummaryFrame(summary: SessionSummary): SessionSummaryFrame {
+  return {
+    sessionId: summary.sessionId,
+    createdAt: summary.createdAt.toISOString(),
+    updatedAt: summary.updatedAt.toISOString(),
+    entryCount: summary.entryCount,
+  };
+}
