+
+type ParseCheck<T> = {ok: true; value: T} | {ok: false; error: string};
+
+function validateListSessionsMessage(message: Record<string, unknown>): ValidationResult {
+  const limit = parseOptionalLimit(message.limit);
+  if (!limit.ok) {
+    return {valid: false, error: limit.error};
+  }
+
+  const before = parseOptionalBefore(message.before);
+  if (!before.ok) {
+    return {valid: false, error: before.error};
+  }
+
+  const frame: ListSessionsMessage = {type: 'list_sessions'};
+  if (limit.value !== undefined) {
+    frame.limit = limit.value;
+  }
+  if (before.value !== undefined) {
+    frame.before = before.value;
+  }
+
+  return {valid: true, data: frame};
+}
+
+function parseOptionalLimit(raw: unknown): ParseCheck<number | undefined> {
+  if (raw === undefined) {
+    return {ok: true, value: undefined};
+  }
+  if (typeof raw !== 'number' || !Number.isInteger(raw) || raw < 0) {
+    return {ok: false, error: 'list_sessions limit must be a non-negative integer'};
+  }
+  return {ok: true, value: raw};
+}
+
+function parseOptionalBefore(raw: unknown): ParseCheck<SessionCursor | undefined> {
+  if (raw === undefined) {
+    return {ok: true, value: undefined};
+  }
+  if (typeof raw !== 'object' || raw === null || Array.isArray(raw)) {
+    return {ok: false, error: 'list_sessions before must be an object'};
+  }
+
+  const record = raw as Record<string, unknown>;
+  const sessionId = record.sessionId;
+  if (typeof sessionId !== 'string' || sessionId.length < 1 || sessionId.length > MAX_SESSION_ID_LENGTH) {
+    return {ok: false, error: 'list_sessions before.sessionId must be a 1-128 character string'};
+  }
+
+  const updatedAt = record.updatedAt;
+  if (!isValidTimestamp(updatedAt)) {
+    return {ok: false, error: 'list_sessions before.updatedAt must be a valid timestamp'};
+  }
+
+  return {ok: true, value: {sessionId, updatedAt}};
+}
+
+function isValidTimestamp(candidate: unknown): candidate is string | number {
+  if (typeof candidate !== 'string' && typeof candidate !== 'number') {
+    return false;
+  }
+  return Number.isFinite(new Date(candidate).getTime());
+}
