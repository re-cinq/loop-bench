diff --git a/src/transport/ws/validation.ts b/src/transport/ws/validation.ts
index 6e67a6a..9b2a386 100644
--- a/src/transport/ws/validation.ts
+++ b/src/transport/ws/validation.ts
@@ -1,6 +1,8 @@
-import type {IncomingMessage} from '../../types/messages.js';
+import type {IncomingMessage, ListSessionsMessage} from '../../types/messages.js';
+import type {SessionCursor} from '../../types/sessionStore.js';
 
 const MAX_CONTENT_LENGTH = 10000;
+const MAX_SESSION_ID_LENGTH = 128;
 
 interface ValidationSuccess {
   valid: true;
@@ -25,11 +27,14 @@ export function validateMessage(payload: unknown): ValidationResult {
     return {valid: false, error: 'Message must have a type field'};
   }
 
+  // eslint-disable-next-line re-lint/prefer-polymorphism -- the switch narrows an untrusted WebSocket frame through a discriminated union (adrs/ADR-006-lint-suppressions.md)
   switch (message.type) {
     case 'user_message':
       return validateUserMessage(message);
     case 'ping':
       return validatePingMessage(message);
+    case 'list_sessions':
+      return validateListSessionsMessage(message);
     default:
       return {valid: false, error: `Unknown message type: ${message.type}`};
   }
@@ -72,3 +77,63 @@ function validatePingMessage(message: Record<string, unknown>): ValidationResult
     },
   };
 }
+
+function validateListSessionsMessage(message: Record<string, unknown>): ValidationResult {
+  const limit = message.limit;
+  if (!isValidOptionalLimit(limit)) {
+    return {valid: false, error: 'list_sessions limit must be a non-negative integer'};
+  }
+
+  const cursorCheck = validateBeforeCursor(message.before);
+  if (!cursorCheck.valid) {
+    return cursorCheck;
+  }
+
+  return {
+    valid: true,
+    data: buildListSessionsFrame(limit, cursorCheck.before),
+  };
+}
+
+function isValidOptionalLimit(limit: unknown): limit is number | undefined {
+  if (limit === undefined) return true;
+  if (typeof limit !== 'number') return false;
+  return Number.isInteger(limit) && limit >= 0;
+}
+
+function validateBeforeCursor(before: unknown): {valid: true; before?: SessionCursor} | {valid: false; error: string} {
+  if (before === undefined) return {valid: true};
+  if (typeof before !== 'object' || before === null) {
+    return {valid: false, error: 'list_sessions before must be an object'};
+  }
+  if (Array.isArray(before)) {
+    return {valid: false, error: 'list_sessions before must be an object'};
+  }
+
+  const {sessionId, updatedAt} = before as Record<string, unknown>;
+  if (!isValidSessionId(sessionId)) {
+    return {valid: false, error: 'list_sessions before.sessionId must be a 1-128 character string'};
+  }
+  if (!isValidCursorDate(updatedAt)) {
+    return {valid: false, error: 'list_sessions before.updatedAt must be a valid date string or number'};
+  }
+
+  return {valid: true, before: {updatedAt, sessionId}};
+}
+
+function isValidSessionId(sessionId: unknown): sessionId is string {
+  if (typeof sessionId !== 'string') return false;
+  return sessionId.length >= 1 && sessionId.length <= MAX_SESSION_ID_LENGTH;
+}
+
+function isValidCursorDate(updatedAt: unknown): updatedAt is string | number {
+  if (typeof updatedAt !== 'string' && typeof updatedAt !== 'number') return false;
+  return Number.isFinite(new Date(updatedAt).getTime());
+}
+
+function buildListSessionsFrame(limit: number | undefined, before: SessionCursor | undefined): ListSessionsMessage {
+  const frame: ListSessionsMessage = {type: 'list_sessions'};
+  if (limit !== undefined) frame.limit = limit;
+  if (before !== undefined) frame.before = before;
+  return frame;
+}
