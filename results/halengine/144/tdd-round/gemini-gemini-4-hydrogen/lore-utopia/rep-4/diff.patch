+
+    expect({seen, reply: sent.at(-1)}).toEqual({
+      seen: [{userId: 'u1', options: {limit: 5}}],
+      reply: {
+        type: 'session_list',
+        sessions: [
+          {
+            sessionId: 's1',
+            createdAt: '2026-01-01T00:00:00.000Z',
