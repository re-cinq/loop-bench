+function validateListSessionsMessage(message: Record<string, unknown>): ValidationResult {
+  if (message.limit !== undefined) {
+    if (typeof message.limit !== 'number' || !Number.isInteger(message.limit) || message.limit < 0) {
+      return {valid: false, error: 'list_sessions limit must be a non-negative integer'};
+    }
+  }
+
+  if (message.before !== undefined) {
+    if (typeof message.before !== 'object' || message.before === null || Array.isArray(message.before)) {
+      return {valid: false, error: 'list_sessions before must be an object'};
+    }
+    const before = message.before as Record<string, unknown>;
+    if (typeof before.sessionId !== 'string' || before.sessionId.length < 1 || before.sessionId.length > 128) {
+      return {valid: false, error: 'list_sessions before.sessionId must be between 1 and 128 characters'};
