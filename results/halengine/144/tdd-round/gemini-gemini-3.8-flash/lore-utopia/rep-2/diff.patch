+      ...(message.limit !== undefined ? {limit: message.limit as number} : {}),
+      ...(beforeObj !== undefined
+        ? {
+            before: {
+              sessionId: beforeObj.sessionId as string,
+              updatedAt: beforeObj.updatedAt as string | number,
+            },
+          }
+        : {}),
