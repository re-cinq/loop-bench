+function validateListSessionsMessage(message: Record<string, unknown>): ValidationResult {
+  if (message.limit !== undefined) {
+    if (typeof message.limit !== 'number' || !Number.isInteger(message.limit) || message.limit < 0) {
+      return {valid: false, error: 'limit must be a non-negative integer'};
+    }
+  }
+
+  let validatedBefore: SessionCursor | undefined;
+  if (message.before !== undefined) {
+    if (typeof message.before !== 'object' || message.before === null || Array.isArray(message.before)) {
+      return {valid: false, error: 'before must be an object'};
+    }
+
+    const before = message.before as Record<string, unknown>;
+
+    if (typeof before.sessionId !== 'string' || before.sessionId.length < 1 || before.sessionId.length > 128) {
+      return {valid: false, error: 'before.sessionId must be between 1 and 128 characters'};
+    }
+
+    if (typeof before.updatedAt !== 'string' && typeof before.updatedAt !== 'number') {
+      return {valid: false, error: 'before.updatedAt must be a date string or timestamp'};
+    }
+
+    const time = new Date(before.updatedAt).getTime();
+    if (!Number.isFinite(time)) {
+      return {valid: false, error: 'before.updatedAt must parse as a valid timestamp'};
+    }
+
+    validatedBefore = {
+      sessionId: before.sessionId,
+      updatedAt: before.updatedAt,
+    };
+  }
+
+  return {
+    valid: true,
+    data: {
+      type: 'list_sessions',
+      ...(message.limit !== undefined ? {limit: message.limit as number} : {}),
+      ...(validatedBefore !== undefined ? {before: validatedBefore} : {}),
+    },
+  };
+}
