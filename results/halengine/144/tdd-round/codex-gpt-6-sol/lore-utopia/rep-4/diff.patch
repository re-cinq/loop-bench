+  if (typeof value !== 'object' || value === null || Array.isArray(value)) return false;
+  const {sessionId, updatedAt} = value as Record<string, unknown>;
+  return isValidSessionId(sessionId) && isValidUpdatedAt(updatedAt);
+}
+
+function isValidSessionId(value: unknown): boolean {
+  if (typeof value !== 'string') return false;
+  const length = [...value].length;
+  return length >= 1 && length <= 128;
+}
+
+function isValidUpdatedAt(value: unknown): boolean {
+  if (typeof value === 'string') return value.trim() !== '' && Number.isFinite(Date.parse(value));
+  return typeof value === 'number' && Number.isFinite(value) && Number.isFinite(new Date(value).getTime());
+}
