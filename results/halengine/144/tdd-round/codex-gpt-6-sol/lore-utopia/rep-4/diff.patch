+function validateListSessionsMessage(message: Record<string, unknown>): ValidationResult {
+  if (message.limit !== undefined && !isValidListLimit(message.limit)) {
+    return {valid: false, error: 'list_sessions limit must be a non-negative integer'};
+  }
+
+  const before = message.before;
+  if (before !== undefined && !isValidSessionCursor(before)) {
+    return {valid: false, error: 'list_sessions before must have a valid sessionId and updatedAt'};
+  }
+
+  return {
+    valid: true,
+    data: {
+      type: 'list_sessions',
+      ...(message.limit !== undefined ? {limit: message.limit as number} : {}),
+      ...(before !== undefined ? {before: {sessionId: before.sessionId, updatedAt: before.updatedAt}} : {}),
