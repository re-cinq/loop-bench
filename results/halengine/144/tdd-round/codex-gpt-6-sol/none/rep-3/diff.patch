+
+function validateListSessionsMessage(message: Record<string, unknown>): ValidationResult {
+  const limit = message.limit;
+  if (limit !== undefined && !isNonNegativeInteger(limit)) {
+    return {valid: false, error: 'list_sessions limit must be a non-negative integer'};
+  }
+
+  const cursor = message.before;
+  if (cursor === undefined) return {valid: true, data: {type: 'list_sessions', ...(limit !== undefined && {limit})}};
+  if (typeof cursor !== 'object' || cursor === null || Array.isArray(cursor)) {
+    return {valid: false, error: 'list_sessions before must be a cursor'};
+  }
+  const before = cursor as Record<string, unknown>;
+  if (!isSessionId(before.sessionId)) {
+    return {valid: false, error: 'list_sessions before.sessionId must be 1–128 characters'};
+  }
+  if (!isValidTimestamp(before.updatedAt)) {
+    return {valid: false, error: 'list_sessions before.updatedAt must be a valid timestamp'};
+  }
+
+  return {
+    valid: true,
+    data: {
+      type: 'list_sessions',
+      ...(limit !== undefined && {limit}),
+      before: {updatedAt: before.updatedAt, sessionId: before.sessionId},
+    },
+  };
+}
+
+function isNonNegativeInteger(value: unknown): value is number {
+  return typeof value === 'number' && Number.isInteger(value) && value >= 0;
+}
+
+function isSessionId(value: unknown): value is string {
+  return typeof value === 'string' && value.length >= 1 && value.length <= 128;
+}
+
+function isValidTimestamp(value: unknown): value is string | number {
+  if (typeof value === 'number') return Number.isFinite(new Date(value).getTime());
+  return typeof value === 'string' && Number.isFinite(Date.parse(value));
+}
