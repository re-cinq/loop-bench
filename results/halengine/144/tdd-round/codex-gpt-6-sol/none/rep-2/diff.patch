+function validateListSessionsMessage(message: Record<string, unknown>): ValidationResult {
+  if (message.limit !== undefined && !isValidLimit(message.limit)) {
+    return {valid: false, error: 'list_sessions limit must be a non-negative integer'};
+  }
+
+  const cursorResult = validateCursor(message.before);
+  if (!cursorResult.valid) return cursorResult;
+  const before = cursorResult.before;
+
+  return {
+    valid: true,
+    data: {
+      type: 'list_sessions',
+      ...(message.limit !== undefined && {limit: message.limit as number}),
+      ...(before !== undefined && {before}),
+    },
+  };
+}
+
+function isValidLimit(value: unknown): value is number {
+  return typeof value === 'number' && Number.isInteger(value) && value >= 0;
+}
+
+function validateCursor(
+  value: unknown
+): {valid: true; before?: {updatedAt: string | number; sessionId: string}} | ValidationFailure {
+  if (value === undefined) return {valid: true};
+  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
+    return {valid: false, error: 'list_sessions before must be a cursor object'};
+  }
+  const cursor = value as Record<string, unknown>;
+  if (!isValidSessionId(cursor.sessionId)) {
+    return {valid: false, error: 'list_sessions before.sessionId must be 1–128 characters'};
+  }
+  if (!isValidTimestamp(cursor.updatedAt)) {
+    return {valid: false, error: 'list_sessions before.updatedAt must be a valid timestamp'};
+  }
+  return {valid: true, before: {updatedAt: cursor.updatedAt, sessionId: cursor.sessionId}};
+}
+
+function isValidSessionId(value: unknown): value is string {
+  return typeof value === 'string' && value.length >= 1 && value.length <= 128;
+}
+
+function isValidTimestamp(value: unknown): value is string | number {
+  if (typeof value === 'string') return Number.isFinite(Date.parse(value));
+  if (typeof value === 'number') return Number.isFinite(value) && Number.isFinite(new Date(value).getTime());
+  return false;
+}
