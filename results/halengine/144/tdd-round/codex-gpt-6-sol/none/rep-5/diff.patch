+import {createMessageHandler} from './messageHandler.js';
+import {setLogger} from '../../shared/logger.js';
+
+// specs/hal-engine-conversation-list/spec.md#1
+it('answers a list request from the authenticated session with ISO dates', async () => {
+  const seen: unknown[] = [];
+  const store = {
+    listFor: (userId: string | number, options: unknown) => {
+      seen.push({userId, options});
+      return [
+        {
+          sessionId: 'older',
+          createdAt: new Date('2026-01-01T00:00:00.000Z'),
+          updatedAt: new Date('2026-01-02T00:00:00.000Z'),
+          entryCount: 2,
+        },
+      ];
+    },
+  } as SessionStore;
+  const sent: string[] = [];
+  const ws = {send: (frame: string) => sent.push(frame)} as unknown as WebSocket;
+  const before = {updatedAt: '2026-01-03T00:00:00.000Z', sessionId: 'cursor'};
+  const handler = createMessageHandler({} as ChatOrchestrator, store);
+  const session = await new InMemorySessionStore().create('current', 'owner');
+
+  await handler(ws, session, {type: 'list_sessions', limit: 3, before, userId: 'intruder'});
+
+  expect({seen, sent: sent.map(frame => JSON.parse(frame))}).toEqual({
+    seen: [{userId: 'owner', options: {limit: 3, before}}],
+    sent: [
+      {
+        type: 'session_list',
+        sessions: [
+          {
+            sessionId: 'older',
+            createdAt: '2026-01-01T00:00:00.000Z',
+            updatedAt: '2026-01-02T00:00:00.000Z',
+            entryCount: 2,
+          },
+        ],
+      },
+    ],
+  });
+});
+
+// specs/hal-engine-conversation-list/spec.md#2
+it('logs a failed list request in the ws category and sends SERVER_ERROR', async () => {
+  const errors: Array<{category: string; fields?: Record<string, unknown>}> = [];
+  setLogger({
+    debug: () => undefined,
+    info: () => undefined,
+    warn: () => undefined,
+    error: (category, _message, fields) => void errors.push({category, fields}),
+  });
+  try {
+    const store = {listFor: () => Promise.reject(new Error('database offline'))} as unknown as SessionStore;
+    const sent: string[] = [];
+    const ws = {send: (frame: string) => sent.push(frame)} as unknown as WebSocket;
+    const handler = createMessageHandler({} as ChatOrchestrator, store);
+    const session = await new InMemorySessionStore().create('current', 'owner');
+
+    await handler(ws, session, {type: 'list_sessions'});
+
+    expect({sent: sent.map(frame => JSON.parse(frame)), errors}).toEqual({
+      sent: [{type: 'error', code: 'SERVER_ERROR', message: 'Failed to process message'}],
+      errors: [{category: 'ws', fields: expect.objectContaining({userId: 'owner', error: 'database offline'})}],
+    });
+  } finally {
+    setLogger();
+  }
+});
