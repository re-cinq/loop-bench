+import {once} from 'node:events';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {connectClient, startEngineWith, stopEngines} from './wsTestSupport.js';
+
+afterEach(stopEngines);
+
+// specs/hal-engine-conversation-list/spec.md#1
+it('passes the configured session store to a list request over the WebSocket', async () => {
+  const store = new InMemorySessionStore();
+  const {url} = await startEngineWith({sessionStore: store});
+  const client = connectClient(url);
+  const answer = new Promise<unknown>(resolve => {
+    client.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as {type: string};
+      if (frame.type === 'connected') client.send(JSON.stringify({type: 'list_sessions'}));
+      if (frame.type === 'session_list') resolve(frame);
+    });
+  });
+
+  await expect(answer).resolves.toMatchObject({
+    type: 'session_list',
+    sessions: [expect.objectContaining({entryCount: 0})],
+  });
+  client.close();
+  await once(client, 'close');
+});
