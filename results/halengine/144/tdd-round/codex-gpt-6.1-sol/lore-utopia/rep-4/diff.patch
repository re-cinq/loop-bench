+import {validateMessage} from './validation.js';
+
+// @spec specs/hal-engine-websocket-protocol/spec.md#215
+it('accepts list_sessions pagination and rejects malformed fields while discarding userId', () => {
+  expect(validateMessage({type: 'list_sessions'})).toEqual({valid: true, data: {type: 'list_sessions'}});
+
+  for (const updatedAt of ['2026-10-28T12:00:00Z', 0]) {
+    const before = {sessionId: 'conversation-1', updatedAt};
+    expect(validateMessage({type: 'list_sessions', limit: 0, before, userId: 'another-user'})).toEqual({
+      valid: true,
+      data: {type: 'list_sessions', limit: 0, before},
+    });
+  }
+
+  for (const limit of [-1, 1.5, '10', null, Infinity, NaN]) {
+    expect(validateMessage({type: 'list_sessions', limit})).toEqual({
+      valid: false,
+      error: expect.stringContaining('limit'),
+    });
+  }
+
+  for (const before of [
+    null,
+    'yesterday',
+    {},
+    {sessionId: '', updatedAt: 0},
+    {sessionId: 'a'.repeat(129), updatedAt: 0},
+    {sessionId: 'a', updatedAt: 'not a date'},
+    {sessionId: 'a', updatedAt: Infinity},
+    {sessionId: 'a', updatedAt: null},
+  ]) {
+    expect(validateMessage({type: 'list_sessions', before})).toEqual({
+      valid: false,
+      error: expect.stringContaining('before'),
+    });
+  }
+});
