+import {jest} from '@jest/globals';
+import {connectClient, deferred, startEngineWith, stopEngines} from './wsTestSupport.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+
+let disconnected: Promise<void>;
+
+afterEach(async () => {
+  await stopEngines();
+  await disconnected;
+  jest.useRealTimers();
+});
+
+describe('session list delivery [spec: specs/hal-engine-conversation-list/spec.md#37]', () => {
+  it('delivers one owned summary after the cursor with ISO dates', async () => {
+    const store = new InMemorySessionStore();
+    const now = Date.parse('2026-01-01T00:00:00.000Z');
+    jest.useFakeTimers({
+      now,
+      doNotFake: [
+        'nextTick',
+        'setImmediate',
+        'setTimeout',
+        'setInterval',
+        'clearImmediate',
+        'clearTimeout',
+        'clearInterval',
+        'performance',
+        'hrtime',
+        'queueMicrotask',
+      ],
+    });
+    for (const [sessionId, userId, offset] of [
+      ['newest', 'u1', 3000],
+      ['selected', 'u1', 1000],
+      ['private', 'u2', 1500],
+    ] as const) {
+      const session = store.create(sessionId, userId);
+      session.entries.push({
+        role: 'user',
+        content: 'private content',
+        timestamp: new Date(now + offset).toISOString(),
+      });
+    }
+    const closed = deferred();
+    disconnected = closed.until;
+    const {url} = await startEngineWith({sessionStore: store, onDisconnect: closed.release});
+    const client = connectClient(url);
+    const frames: unknown[] = [];
+    await new Promise<void>(resolve => {
+      client.on('message', raw => {
+        const frame = JSON.parse(String(raw)) as {type: string};
+        if (frame.type === 'pong') return resolve();
+        if (frame.type !== 'connected') {
+          frames.push(frame);
+          return;
+        }
+        client.send(
+          JSON.stringify({
+            type: 'list_sessions',
+            userId: 'u2',
+            limit: 1,
+            before: {sessionId: 'cursor', updatedAt: new Date(now + 2000).toISOString()},
+          })
+        );
+        client.send(JSON.stringify({type: 'ping', timestamp: 1}));
+      });
+    });
+    const selected = store.listFor('u1').find(row => row.sessionId === 'selected')!;
+    expect(frames).toEqual([
+      {
+        type: 'session_list',
+        sessions: [
+          {
+            sessionId: 'selected',
+            createdAt: selected.createdAt.toISOString(),
+            updatedAt: new Date(now + 1000).toISOString(),
+            entryCount: 1,
+          },
+        ],
+      },
+    ]);
+  });
+});
