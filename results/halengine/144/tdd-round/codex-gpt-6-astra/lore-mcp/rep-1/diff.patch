+// @spec specs/hal-engine-conversation-list/spec.md#42
+import {validateMessage} from './validation.js';
+
+it('preserves valid list cursors, strips unknown fields and rejects malformed cursors', () => {
+  const cursors = [
+    {sessionId: 's', updatedAt: '2026-01-01T00:00:00.000Z'},
+    {sessionId: 's'.repeat(128), updatedAt: 0},
+  ];
+  const malformed = [
+    null,
+    'cursor',
+    [],
+    {},
+    {sessionId: '', updatedAt: 0},
+    {sessionId: 's'.repeat(129), updatedAt: 0},
+    {sessionId: 1, updatedAt: 0},
+    {sessionId: 's'},
+    {sessionId: 's', updatedAt: 'not-a-date'},
+    {sessionId: 's', updatedAt: true},
+    {sessionId: 's', updatedAt: null},
+    {sessionId: 's', updatedAt: Infinity},
+    {sessionId: 's', updatedAt: 9e15},
+    {sessionId: 's', updatedAt: new Date(0)},
+  ];
+
+  expect({
+    accepted: cursors.map(before =>
+      validateMessage({type: 'list_sessions', limit: 10, before: {...before, userId: 'u2'}, userId: 'u2'})
+    ),
+    rejected: malformed.map(before => validateMessage({type: 'list_sessions', before})),
+  }).toEqual({
+    accepted: cursors.map(before => ({valid: true, data: {type: 'list_sessions', limit: 10, before}})),
+    rejected: malformed.map(() => ({valid: false, error: expect.stringContaining('before')})),
+  });
+});
