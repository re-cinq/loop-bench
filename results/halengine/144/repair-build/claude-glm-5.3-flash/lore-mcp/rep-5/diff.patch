diff --git a/src/transport/conversationList.acceptance.test.ts b/src/transport/conversationList.acceptance.test.ts
new file mode 100644
index 0000000..c07c69f
--- /dev/null
+++ b/src/transport/conversationList.acceptance.test.ts
@@ -0,0 +1,351 @@
+import {
+  announcedId,
+  askOnOpen,
+  connectClient,
+  deferred,
+  delegatingTo,
+  eventually,
+  onlySession,
+  startEngineWith,
+  stopEngines,
+} from './wsTestSupport.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {StoreCannotList} from '../types/sessionStore.js';
+import type {SessionListOptions, SessionStore, SessionSummary} from '../types/sessionStore.js';
+import type {ChatOrchestrator} from '../orchestration/chatOrchestrator.js';
+import type {MessageChunk} from '../types/ai.js';
+import type {SessionEntry} from '../types/session.js';
+import {setLogger} from '../shared/logger.js';
+
+// Real upgrades over a real socket: what a list answers is the wire contract, and no double can observe it.
+
+interface Frame {
+  type: string;
+  sessionId?: string;
+  resumed?: boolean;
+  entryCount?: number;
+  code?: string;
+  message?: string;
+  index?: number;
+  entry?: SessionEntry;
+  conversations?: Array<{sessionId: string; createdAt: string; updatedAt: string; entryCount: number}>;
+}
+
+const lines: Array<{level: string; category: string; message: string; fields?: Record<string, unknown>}> = [];
+const listen = (level: string) => (category: string, message: string, fields?: Record<string, unknown>) => {
+  lines.push({level, category, message, fields});
+};
+
+beforeEach(() => {
+  lines.length = 0;
+  setLogger({debug: listen('debug'), info: listen('info'), warn: listen('warn'), error: listen('error')});
+});
+
+afterEach(async () => {
+  // Each server sees its sockets close before it stops, so no close lands after the logger below is restored.
+  await stopEngines();
+  setLogger();
+});
+
+// An ask sent once the handshake answers, settled by the first frame of the type the ask waits for, which the answer must reach the socket to deliver.
+const askAfterConnect = async (
+  url: string,
+  outbound?: object,
+  until = 'pong'
+): Promise<{connected: Frame; frames: Frame[]}> => {
+  const client = connectClient(url);
+  const frames: Frame[] = [];
+  let connected: Frame = {type: ''};
+  const ask = (frame: Frame): void => {
+    connected = frame;
+    if (outbound !== undefined) client.send(JSON.stringify(outbound));
+  };
+  await new Promise<void>(resolve => {
+    client.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as Frame;
+      if (frame.type === 'connected') return ask(frame);
+      frames.push(frame);
+      if (frame.type === until) return resolve();
+    });
+  });
+  return {connected, frames};
+};
+
+const codesOf = (frames: Frame[]): Array<{type: string; code?: string}> => frames.map(({type, code}) => ({type, code}));
+
+const upserts = (frames: Frame[]): Array<{index?: number; entry?: SessionEntry}> =>
+  frames.filter(frame => frame.type === 'entry_upsert').map(({index, entry}) => ({index, entry}));
+
+/** A store whose listFor counts its asks and answers none, so a test can tell whether the store was consulted. */
+const countingStore = (): {store: SessionStore; asks: () => number} => {
+  let asks = 0;
+  return {
+    store: {
+      ...delegatingTo(new InMemorySessionStore()),
+      listFor: () => {
+        asks += 1;
+        return [];
+      },
+    },
+    asks: () => asks,
+  };
+};
+
+describe('a conversation list over the WebSocket protocol', () => {
+  it('answers the connected user with ISO summaries, forwarding limit and before while ignoring any client userId', async () => {
+    const seen: Array<{userId: string | number; options?: SessionListOptions}> = [];
+    const newestFirst: SessionSummary[] = [
+      {
+        sessionId: 's3',
+        createdAt: new Date('2026-01-03T00:00:00.000Z'),
+        updatedAt: new Date('2026-01-03T00:03:00.000Z'),
+        entryCount: 9,
+      },
+      {
+        sessionId: 's2',
+        createdAt: new Date('2026-01-02T00:00:00.000Z'),
+        updatedAt: new Date('2026-01-02T00:02:00.000Z'),
+        entryCount: 4,
+      },
+      {
+        sessionId: 's1',
+        createdAt: new Date('2026-01-01T00:00:00.000Z'),
+        updatedAt: new Date('2026-01-01T00:01:00.000Z'),
+        entryCount: 2,
+      },
+    ];
+    const store: SessionStore = {
+      ...delegatingTo(new InMemorySessionStore()),
+      listFor: (userId, options) => {
+        seen.push({userId, options});
+        return newestFirst;
+      },
+    };
+
+    const {frames} = await askAfterConnect(
+      (await startEngineWith({sessionStore: store, history: {enabled: true}})).url,
+      {
+        type: 'list_conversations',
+        limit: 10,
+        before: {updatedAt: '2026-01-03T00:03:00.000Z', sessionId: 's3'},
+        userId: 'u2',
+      },
+      'conversation_list'
+    );
+
+    expect({seen, frames}).toEqual({
+      seen: [{userId: 'u1', options: {limit: 10, before: {updatedAt: '2026-01-03T00:03:00.000Z', sessionId: 's3'}}}],
+      frames: [
+        {
+          type: 'conversation_list',
+          conversations: [
+            {
+              sessionId: 's3',
+              createdAt: '2026-01-03T00:00:00.000Z',
+              updatedAt: '2026-01-03T00:03:00.000Z',
+              entryCount: 9,
+            },
+            {
+              sessionId: 's2',
+              createdAt: '2026-01-02T00:00:00.000Z',
+              updatedAt: '2026-01-02T00:02:00.000Z',
+              entryCount: 4,
+            },
+            {
+              sessionId: 's1',
+              createdAt: '2026-01-01T00:00:00.000Z',
+              updatedAt: '2026-01-01T00:01:00.000Z',
+              entryCount: 2,
+            },
+          ],
+        },
+      ],
+    });
+  });
+
+  it('with history off or absent, answers UNSUPPORTED and never asks the store', async () => {
+    const absent = countingStore();
+    const off = countingStore();
+
+    const withoutFlag = await askAfterConnect(
+      (await startEngineWith({sessionStore: absent.store})).url,
+      {
+        type: 'list_conversations',
+      },
+      'error'
+    );
+    const disabled = await askAfterConnect(
+      (await startEngineWith({sessionStore: off.store, history: {enabled: false}})).url,
+      {type: 'list_conversations'},
+      'error'
+    );
+
+    expect({
+      withoutFlag: codesOf(withoutFlag.frames),
+      disabled: codesOf(disabled.frames),
+      asks: [absent.asks(), off.asks()],
+    }).toEqual({
+      withoutFlag: [{type: 'error', code: 'UNSUPPORTED'}],
+      disabled: [{type: 'error', code: 'UNSUPPORTED'}],
+      asks: [0, 0],
+    });
+  });
+
+  it('answers UNSUPPORTED when the store cannot list, whether listFor is absent or the store refuses', async () => {
+    const bare = (
+      await startEngineWith({sessionStore: delegatingTo(new InMemorySessionStore()), history: {enabled: true}})
+    ).url;
+    const refusing = (
+      await startEngineWith({
+        history: {enabled: true},
+        sessionStore: {
+          ...delegatingTo(new InMemorySessionStore()),
+          listFor: () => Promise.reject(new StoreCannotList('this store holds conversations but cannot list them')),
+        },
+      })
+    ).url;
+
+    const withoutListFor = await askAfterConnect(bare, {type: 'list_conversations'}, 'error');
+    const refused = await askAfterConnect(refusing, {type: 'list_conversations'}, 'error');
+
+    expect({withoutListFor: codesOf(withoutListFor.frames), refused: codesOf(refused.frames)}).toEqual({
+      withoutListFor: [{type: 'error', code: 'UNSUPPORTED'}],
+      refused: [{type: 'error', code: 'UNSUPPORTED'}],
+    });
+  });
+
+  it('answers a rejecting listFor with SERVER_ERROR on a socket left open, logging the session id without the store detail', async () => {
+    const store: SessionStore = {
+      ...delegatingTo(new InMemorySessionStore()),
+      listFor: () => Promise.reject(new Error('database offline')),
+    };
+
+    // The error frame itself is the proof the socket stayed open: it is read on the same socket the ask went out on.
+    const {connected, frames} = await askAfterConnect(
+      (await startEngineWith({sessionStore: store, history: {enabled: true}})).url,
+      {
+        type: 'list_conversations',
+      },
+      'error'
+    );
+    const failures = lines.filter(line => line.level === 'error' && line.category === 'ws');
+
+    expect({
+      failed: frames.map(({type, code, message}) => ({
+        type,
+        code,
+        carriesStoreDetail: message?.includes('database offline'),
+      })),
+      failures,
+    }).toEqual({
+      failed: [{type: 'error', code: 'SERVER_ERROR', carriesStoreDetail: false}],
+      failures: [
+        {
+          level: 'error',
+          category: 'ws',
+          message: 'conversation list failed',
+          fields: {sessionId: connected.sessionId, error: 'database offline'},
+        },
+      ],
+    });
+  });
+
+  it('accepts a bare list_conversations frame and rejects a malformed limit or before with INVALID_MESSAGE without calling listFor', async () => {
+    const listed = countingStore();
+    const url = (await startEngineWith({sessionStore: listed.store, history: {enabled: true}})).url;
+    const malformed = [
+      {type: 'list_conversations', limit: '10'},
+      {type: 'list_conversations', limit: 0},
+      {type: 'list_conversations', limit: -1},
+      {type: 'list_conversations', limit: 1.5},
+      {type: 'list_conversations', limit: 201},
+      {type: 'list_conversations', before: 'not an object'},
+      {type: 'list_conversations', before: {updatedAt: '2026-01-01T00:00:00.000Z'}},
+      {type: 'list_conversations', before: {sessionId: 's1'}},
+      {type: 'list_conversations', before: {updatedAt: 'not a date', sessionId: 's1'}},
+      {type: 'list_conversations', before: {updatedAt: 1767225600000, sessionId: 's1'}},
+    ];
+
+    const codes: Array<string | undefined> = [];
+    for (const frame of malformed) {
+      const {frames} = await askAfterConnect(url, frame, 'error');
+      codes.push(frames[0]?.code);
+    }
+    const bare = await askAfterConnect(url, {type: 'list_conversations'}, 'conversation_list');
+
+    expect({codes, bare: bare.frames, asks: listed.asks()}).toEqual({
+      codes: malformed.map(() => 'INVALID_MESSAGE'),
+      bare: [{type: 'conversation_list', conversations: []}],
+      asks: 1,
+    });
+  });
+
+  it('answers a list asked while a turn streams on the same session before that turn streams its end', async () => {
+    const held = deferred();
+    const midAnswer: ChatOrchestrator = {
+      processMessage: async () => 'half',
+      async *processMessageStream(): AsyncGenerator<MessageChunk> {
+        yield {type: 'text', text: 'half'};
+        await held.until;
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+    };
+    const store: SessionStore = {
+      ...delegatingTo(new InMemorySessionStore()),
+      listFor: () => [{sessionId: 's1', createdAt: new Date(0), updatedAt: new Date(0), entryCount: 0}],
+    };
+    const {url} = await startEngineWith({sessionStore: store, history: {enabled: true}, orchestrator: midAnswer});
+
+    const client = connectClient(url);
+    const during: string[] = [];
+    const afterRelease: string[] = [];
+    let seen = during;
+    await new Promise<void>(resolve => {
+      client.on('message', raw => {
+        const frame = JSON.parse(String(raw)) as Frame;
+        seen.push(frame.type);
+        if (frame.type === 'connected') return client.send(JSON.stringify({type: 'user_message', content: 'hello'}));
+        if (frame.type === 'entry_delta') return client.send(JSON.stringify({type: 'list_conversations', limit: 5}));
+        if (frame.type === 'conversation_list') return resolve();
+      });
+    });
+    seen = afterRelease;
+    held.release();
+    await eventually(() => afterRelease.includes('stream_end'));
+
+    expect({during, afterRelease}).toEqual({
+      during: ['connected', 'entry_upsert', 'entry_upsert', 'entry_delta', 'conversation_list'],
+      afterRelease: ['entry_commit', 'stream_end'],
+    });
+  });
+
+  it('hands a client that reconnects with a listed id its own conversation back, resumed and replayed', async () => {
+    const store = new InMemorySessionStore();
+    const {url} = await startEngineWith({sessionStore: store, history: {enabled: true}, resume: {enabled: true}});
+    const {client, finished} = askOnOpen(url);
+    const idOf = announcedId(client);
+    await finished;
+    const listed = idOf();
+    const stored = (await onlySession(store, listed))?.entries ?? [];
+
+    const rows = await askAfterConnect(url, {type: 'list_conversations'}, 'conversation_list');
+    const row = rows.frames[0].conversations?.find(conversation => conversation.sessionId === listed);
+    const reconnected = await askAfterConnect(`${url}?sessionId=${listed}`, {type: 'ping', timestamp: 1});
+
+    expect({row, connected: reconnected.connected, replay: upserts(reconnected.frames)}).toEqual({
+      row: {sessionId: listed, createdAt: expect.any(String), updatedAt: expect.any(String), entryCount: 2},
+      connected: {
+        type: 'connected',
+        sessionId: listed,
+        message: 'Connected to HAL Engine',
+        examplePrompts: [],
+        resumed: true,
+        entryCount: 2,
+      },
+      replay: [
+        {index: 0, entry: stored[0]},
+        {index: 1, entry: stored[1]},
+      ],
+    });
+  });
+});
