+// The user is the connection's own, never read from the frame, so a client cannot list another user's conversations.
+async function handleListSessions(
+  ws: WebSocket,
+  session: ChatSession,
+  sessionStore: SessionStore | undefined,
+  {limit, before}: ListSessionsMessage
+): Promise<void> {
+  const options: SessionListOptions = {};
+  if (limit !== undefined) options.limit = limit;
+  if (before !== undefined) options.before = before;
+  try {
+    const summaries = (await sessionStore?.listFor?.(session.userId, options)) ?? [];
+    sendJson(ws, {
+      type: 'session_list',
+      sessions: summaries.map(({sessionId, createdAt, updatedAt, entryCount}) => ({
+        sessionId,
+        createdAt: new Date(createdAt).toISOString(),
+        updatedAt: new Date(updatedAt).toISOString(),
+        entryCount,
+      })),
+    });
+  } catch (error) {
+    log.error('ws', 'session list failed', {
+      userId: session.userId,
+      error: error instanceof Error ? error.message : String(error),
+    });
+    sendError(ws, ErrorCodes.SERVER_ERROR, 'Failed to list sessions');
+  }
 }
 
