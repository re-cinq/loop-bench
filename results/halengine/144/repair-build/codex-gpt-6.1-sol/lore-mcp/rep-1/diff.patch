+/** Waits for socket teardown to reach the server. */
+export const eventually = async (check: () => boolean): Promise<void> => {
+  for (let attempt = 0; attempt < 50 && !check(); attempt++) await new Promise(resolve => setTimeout(resolve, 10));
+};
+
+/** Closes tracked clients before stopping their servers. */
+export async function stopTrackedEngines(clients: WebSocket[], servers: HalServer[]): Promise<void> {
+  for (const client of clients.splice(0)) client.terminate();
+  for (const hal of servers.splice(0)) {
+    await eventually(() => hal.wss.clients.size === 0);
+    await hal.stop();
+  }
