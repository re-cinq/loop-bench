+    const handedToHook: Parameters<NonNullable<OrchestratorHooks['afterModelResponse']>>[2] = turnTotal;
+
+    expect(handedToHook).toEqual({inputTokens: 9, outputTokens: 5, totalTokens: 14});
+  });
+});
