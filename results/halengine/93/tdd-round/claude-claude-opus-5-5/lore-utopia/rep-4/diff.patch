+    expect(addUsage(skipped, {inputTokens: 7, outputTokens: 4, totalTokens: 11})).toEqual({
+      inputTokens: 9,
+      outputTokens: 5,
+      totalTokens: 14,
+    });
+  });
+
+  it('stays undefined when no round reported usage', () => {
+    expect(addUsage(undefined, undefined)).toBeUndefined();
+  });
+});
diff --git a/src/orchestration/orchestratorHelpers.ts b/src/orchestration/orchestratorHelpers.ts
index 717eb9a..1ba269c 100644
--- a/src/orchestration/orchestratorHelpers.ts
+++ b/src/orchestration/orchestratorHelpers.ts
@@ -40,3 +40,17 @@ export function extractStopReason(chunk: MessageChunk): string | null {
 export function extractUsage(chunk: MessageChunk): UsageMetadata | undefined {
   return chunk.type === 'stop' ? chunk.usage : undefined;
 }
+
+// A round that reported no usage leaves the total as it was; a turn where none reported stays undefined.
+export function addUsage(
+  total: UsageMetadata | undefined,
+  round: UsageMetadata | undefined
+): UsageMetadata | undefined {
+  if (!round) return total;
+  if (!total) return round;
+  return {
+    inputTokens: total.inputTokens + round.inputTokens,
+    outputTokens: total.outputTokens + round.outputTokens,
+    totalTokens: total.totalTokens + round.totalTokens,
+  };
+}