+    expect(addRoundUsage(undefined, undefined)).toBeUndefined();
+  });
+
+  it('folds every provider round of a turn into one TurnUsage', () => {
+    const turn: TurnUsage | undefined = [ROUND, undefined, LATER].reduce<TurnUsage | undefined>(
+      addRoundUsage,
+      undefined
+    );
+    expect(turn).toEqual({inputTokens: 9, outputTokens: 5, totalTokens: 14});
+  });
+});
