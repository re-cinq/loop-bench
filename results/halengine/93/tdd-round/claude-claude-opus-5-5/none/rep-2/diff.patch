@@ -0,0 +1,38 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {TurnUsage} from '../index.js';
+
+type HookUsage = Parameters<NonNullable<OrchestratorHooks['afterModelResponse']>>[2];
+
+describe('TurnUsage', () => {
+  it('is the public type afterModelResponse receives for a turn', async () => {
+    const reported: HookUsage[] = [];
+    const toTurnUsage = (usage: HookUsage): TurnUsage | undefined => usage;
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        yield {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 4, outputTokens: 1, totalTokens: 5}};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      provider,
+      new PromptBuilder({identity: 'Turn usage test.'}),
+      undefined,
+      {
+        hooks: {afterModelResponse: async (_session, _text, turnUsage) => void reported.push(toTurnUsage(turnUsage))},
+      }
+    );
+
+    await orchestrator.processMessage({
+      sessionId: 'turn-usage',
+      userId: 'turn-usage-user',
+      entries: [{role: 'user', content: 'Hi.', timestamp: '2026-01-01T00:00:00.000Z'}],
+    });
+
+    expect(reported).toEqual([{inputTokens: 4, outputTokens: 1, totalTokens: 5}]);
+  });
+});
