@@ -0,0 +1,16 @@
+import {addTurnUsage} from './turnUsage.js';
+import type {UsageMetadata} from '../types/ai.js';
+
+// specs/hal-engine-config-hooks/spec.md#10
+it('counts reported rounds while preserving no usage when every round omits it', () => {
+  const first: UsageMetadata = {inputTokens: 2, outputTokens: 1, totalTokens: 3};
+  const last: UsageMetadata = {inputTokens: 7, outputTokens: 4, totalTokens: 11};
+
+  const withGap = [first, undefined, last].reduce<UsageMetadata | undefined>(addTurnUsage, undefined);
+  const withoutUsage = [undefined, undefined].reduce<UsageMetadata | undefined>(addTurnUsage, undefined);
+
+  expect({withGap, withoutUsage}).toEqual({
+    withGap: {inputTokens: 9, outputTokens: 5, totalTokens: 14},
+    withoutUsage: undefined,
+  });
+});
