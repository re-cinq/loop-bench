+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// specs/hal-engine-config-hooks/spec.md#9
+it('sums every token field across provider calls in a tool turn', async () => {
+  const rounds: MessageChunk[][] = [
+    [
+      {type: 'tool_use', toolCall: {id: 'lookup-1', name: 'lookup', input: {}}},
+      {
+        type: 'stop',
+        stopReason: 'tool_use',
+        usage: {inputTokens: 2, outputTokens: 3, totalTokens: 5},
+      },
+    ],
+    [
+      {type: 'text', text: 'Found it.'},
+      {
+        type: 'stop',
+        stopReason: 'end_turn',
+        usage: {inputTokens: 7, outputTokens: 11, totalTokens: 18},
+      },
+    ],
+  ];
+  let round = 0;
+  const provider: AIProvider = {
+    async *sendMessage() {
+      yield* rounds[round++] ?? [];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Looks up a value.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reported = usage;
+    },
+  };
+  const session: ChatSession = {
+    sessionId: 'usage-session',
+    userId: 'usage-user',
+    entries: [{role: 'user', content: 'Look it up.', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Usage test.'}), registry, {
+    hooks,
+  });
+
+  await orchestrator.processMessage(session);
+
+  expect(reported).toEqual({inputTokens: 9, outputTokens: 14, totalTokens: 23});
+});
