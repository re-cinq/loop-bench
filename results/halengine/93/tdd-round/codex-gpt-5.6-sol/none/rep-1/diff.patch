+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {ToolRegistry} from './tools/registry.js';
+import {scriptedProvider} from './turnUsageTestSupport.js';
+
+// Validates specs/hal-engine-config-hooks/spec.md#1, "Usage reported to afterModelResponse".
+it('adds provider usage from a tool round to the final round', async () => {
+  const rounds: MessageChunk[][] = [
+    [
+      {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {}}},
+      {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 10, outputTokens: 2, totalTokens: 12}},
+    ],
+    [
+      {type: 'text', text: 'done'},
+      {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 20, outputTokens: 3, totalTokens: 23}},
+    ],
+  ];
+  const provider = scriptedProvider(rounds);
+  const tools = new ToolRegistry();
+  tools.register({name: 'lookup', description: 'lookup', inputSchema: {type: 'object'}}, async () => ({result: 'ok'}));
+  let reportedUsage: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _responseText, usage) => {
+      reportedUsage = usage;
+    },
+  };
+  const session: ChatSession = {
+    sessionId: 'session',
+    userId: 'user',
+    entries: [{role: 'user', content: 'question', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+
+  await createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), tools, {hooks}).processMessage(session);
+
+  expect(reportedUsage).toEqual({inputTokens: 30, outputTokens: 5, totalTokens: 35});
+});
