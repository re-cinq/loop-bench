new file mode 100644
index 0000000..ebfec9d
--- /dev/null
+++ b/src/orchestration/turnUsage.acceptance.test.ts
@@ -0,0 +1,71 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {scriptedProvider} from './turnUsageTestSupport.js';
+
+// Validates specs/hal-engine-config-hooks/spec.md, "Usage reported to afterModelResponse" (re-cinq/HALEngine#93).
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+
+const toolRound = (usage?: UsageMetadata): MessageChunk[] => [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage}];
+const finalRound = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'done'},
+  {type: 'stop', stopReason: 'end_turn', usage},
+];
+
+const lookupRegistry = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found it',
+  }));
+  return registry;
+};
+
+const reportedUsage = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reported = usage;
+    },
+  };
+  const session: ChatSession = {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'ask', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+
+  await createChatOrchestrator(scriptedProvider(rounds), new PromptBuilder({identity: 'test'}), lookupRegistry(), {
+    hooks,
+  }).processMessage(session);
+
+  return reported;
+};
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports 600 input, 60 output, 660 total for a two-tool-round turn whose calls report 100/10, 200/20 and 300/30', async () => {
+    const usage = await reportedUsage([
+      toolRound({inputTokens: 100, outputTokens: 10, totalTokens: 110}),
+      toolRound({inputTokens: 200, outputTokens: 20, totalTokens: 220}),
+      finalRound({inputTokens: 300, outputTokens: 30, totalTokens: 330}),
+    ]);
+
+    expect(usage).toEqual({inputTokens: 600, outputTokens: 60, totalTokens: 660});
+  });
+
+  it('counts only the rounds that reported usage, and reports undefined when none did', async () => {
+    const partlyReported = await reportedUsage([
+      toolRound({inputTokens: 100, outputTokens: 10, totalTokens: 110}),
+      toolRound(),
+      finalRound({inputTokens: 300, outputTokens: 30, totalTokens: 330}),
+    ]);
+    const neverReported = await reportedUsage([toolRound(), toolRound(), finalRound()]);
+
+    expect({partlyReported, neverReported}).toEqual({
+      partlyReported: {inputTokens: 400, outputTokens: 40, totalTokens: 440},
+      neverReported: undefined,
+    });
+  });
+});
