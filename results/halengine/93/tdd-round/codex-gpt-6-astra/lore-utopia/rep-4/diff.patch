+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+
+// Contract fixture: one tool request followed by its final provider response.
+const provider: AIProvider = {
+  async *sendMessage({messages}): AsyncGenerator<MessageChunk> {
+    if (messages.length === 1) {
+      yield {type: 'tool_use', toolCall: {id: 'lookup', name: 'lookup', input: {}}};
+      yield {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 2, outputTokens: 3, totalTokens: 5}};
+      return;
+    }
+    yield {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 7, outputTokens: 11, totalTokens: 18}};
+  },
+  async generateStructured<T>(): Promise<T> {
+    throw new Error('Structured output is outside this contract.');
+  },
+};
+
+describe('turn usage hook [specs/hal-engine-turn-usage/spec.md#3]', () => {
+  it('includes the tool request usage in the final hook total', async () => {
+    const registry = new ToolRegistry();
+    registry.register({name: 'lookup', description: 'Lookup', inputSchema: {type: 'object'}}, async () => 'found');
+    const reports: Array<UsageMetadata | undefined> = [];
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Usage contract'}), registry, {
+      hooks: {
+        afterModelResponse: async (_session, _text, usage) => {
+          reports.push(usage);
+        },
+      },
+    });
+
+    await orchestrator.processMessage({
+      sessionId: 'usage-contract',
+      userId: 'user',
+      entries: [{role: 'user', content: 'Lookup', timestamp: '2026-01-01T00:00:00.000Z'}],
+    });
+
+    expect(reports).toEqual([{inputTokens: 9, outputTokens: 14, totalTokens: 23}]);
+  });
+});
