+import {addUsage} from './turnUsage.js';
+
+describe('turn usage [specs/hal-engine-turn-usage/spec.md#1]', () => {
+  it('sums each reported token field across three provider calls', () => {
+    const first = {inputTokens: 11, outputTokens: 2, totalTokens: 20};
+    const second = {inputTokens: 23, outputTokens: 3, totalTokens: 30};
+    const third = {inputTokens: 37, outputTokens: 5, totalTokens: 50};
+
+    expect(addUsage(addUsage(first, second), third)).toEqual({
+      inputTokens: 71,
+      outputTokens: 10,
+      totalTokens: 100,
+    });
+  });
+});
