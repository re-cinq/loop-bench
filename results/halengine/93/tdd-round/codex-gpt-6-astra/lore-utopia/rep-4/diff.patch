+import {addUsage} from './turnUsage.js';
+
+describe('missing turn usage [specs/hal-engine-turn-usage/spec.md#2]', () => {
+  it('counts reported usage across gaps and leaves unreported turns undefined', () => {
+    const first = {inputTokens: 2, outputTokens: 1, totalTokens: 3};
+    const unreported = addUsage(undefined, undefined);
+    const reported = addUsage(unreported, first);
+    const withGap = addUsage(reported, undefined);
+
+    const last = {inputTokens: 7, outputTokens: 4, totalTokens: 11};
+    expect({unreported, reported, withGap, total: addUsage(withGap, last)}).toEqual({
+      unreported: undefined,
+      reported: first,
+      withGap: first,
+      total: {inputTokens: 9, outputTokens: 5, totalTokens: 14},
+    });
+  });
+});