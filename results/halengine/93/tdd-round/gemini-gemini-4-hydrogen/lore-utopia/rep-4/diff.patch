 export function shouldContinueToolLoop(
@@ -40,3 +40,16 @@ export function extractStopReason(chunk: MessageChunk): string | null {
 export function extractUsage(chunk: MessageChunk): UsageMetadata | undefined {
   return chunk.type === 'stop' ? chunk.usage : undefined;
 }
+
+export function accumulateUsage(
+  accumulated: TurnTotalUsage | undefined,
+  roundUsage: UsageMetadata | undefined
+): TurnTotalUsage | undefined {
+  if (roundUsage === undefined) return accumulated;
+  if (accumulated === undefined) return roundUsage;
+  return {
+    inputTokens: accumulated.inputTokens + roundUsage.inputTokens,
+    outputTokens: accumulated.outputTokens + roundUsage.outputTokens,
+    totalTokens: accumulated.totalTokens + roundUsage.totalTokens,
+  };
+}
