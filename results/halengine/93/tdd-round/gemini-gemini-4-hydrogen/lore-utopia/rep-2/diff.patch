+import type {Message, MessageChunk, ToolCall, TotalUsage, UsageMetadata} from '../types/ai.js';
 import type {ToolRegistry} from './tools/registry.js';
 
 export function shouldContinueToolLoop(
@@ -40,3 +40,16 @@ export function extractStopReason(chunk: MessageChunk): string | null {
 export function extractUsage(chunk: MessageChunk): UsageMetadata | undefined {
   return chunk.type === 'stop' ? chunk.usage : undefined;
 }
+
+export function accumulateUsage(
+  total: TotalUsage | undefined,
+  roundUsage: UsageMetadata | undefined
+): TotalUsage | undefined {
+  if (!roundUsage) return total;
+  if (!total) return {...roundUsage};
+  return {
+    inputTokens: total.inputTokens + roundUsage.inputTokens,
+    outputTokens: total.outputTokens + roundUsage.outputTokens,
+    totalTokens: total.totalTokens + roundUsage.totalTokens,
+  };
+}
