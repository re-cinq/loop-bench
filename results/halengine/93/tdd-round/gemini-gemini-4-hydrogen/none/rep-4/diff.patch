+      accumulateUsage,
+      undefined
+    );
+    const withoutReportedRounds = [undefined, undefined].reduce<UsageMetadata | undefined>(accumulateUsage, undefined);
+
+    expect({withReportedRounds, withoutReportedRounds, firstRound}).toEqual({
+      withReportedRounds: {inputTokens: 34, outputTokens: 5, totalTokens: 39},
+      withoutReportedRounds: undefined,
+      firstRound: {inputTokens: 11, outputTokens: 2, totalTokens: 13},
+    });
+  });
+});
diff --git a/src/orchestration/orchestratorHelpers.ts b/src/orchestration/orchestratorHelpers.ts
index 717eb9a..aae0719 100644
--- a/src/orchestration/orchestratorHelpers.ts
+++ b/src/orchestration/orchestratorHelpers.ts
@@ -40,3 +40,16 @@ export function extractStopReason(chunk: MessageChunk): string | null {
 export function extractUsage(chunk: MessageChunk): UsageMetadata | undefined {
   return chunk.type === 'stop' ? chunk.usage : undefined;
 }
+
+export function accumulateUsage(
+  previousTotal: UsageMetadata | undefined,
+  roundUsage: UsageMetadata | undefined
+): UsageMetadata | undefined {
+  if (!roundUsage) return previousTotal;
+  if (!previousTotal) return {...roundUsage};
+  return {
+    inputTokens: previousTotal.inputTokens + roundUsage.inputTokens,
+    outputTokens: previousTotal.outputTokens + roundUsage.outputTokens,
+    totalTokens: previousTotal.totalTokens + roundUsage.totalTokens,
+  };
+}