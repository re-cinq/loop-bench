@@ -0,0 +1,52 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, SendMessageParams, TotalUsageMetadata, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('afterModelResponse usage aggregation', () => {
+  it('exposes an explicitly named total usage type', () => {
+    const total: TotalUsageMetadata = {inputTokens: 8, outputTokens: 3, totalTokens: 11};
+
+    expect(total).toEqual({inputTokens: 8, outputTokens: 3, totalTokens: 11});
+  });
+
+  it('sums token counts from each provider round that reports usage', async () => {
+    const toolCall: MessageChunk = {type: 'tool_use', toolCall: {id: 'lookup', name: 'lookup', input: {}}};
+    const rounds: MessageChunk[][] = [
+      [toolCall, {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 3, outputTokens: 1, totalTokens: 4}}],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 5, outputTokens: 2, totalTokens: 7}},
+      ],
+    ];
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        yield* rounds[round++];
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const registry = new ToolRegistry();
+    registry.register({name: 'lookup', description: 'Lookup', inputSchema: {type: 'object'}}, async () => 'found');
+    const session: ChatSession = {
+      sessionId: 'usage-test',
+      userId: 'user',
+      entries: [{role: 'user', content: 'lookup', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    let reported: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        reported = usage;
+      },
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), registry, {hooks});
+
+    await orchestrator.processMessage(session);
+
+    expect(reported).toEqual({inputTokens: 8, outputTokens: 3, totalTokens: 11});
+  });
+});
