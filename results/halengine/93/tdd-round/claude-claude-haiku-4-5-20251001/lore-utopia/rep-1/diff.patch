@@ -24,3 +24,29 @@ describe('shouldContinueToolLoop', () => {
     expect(shouldContinueToolLoop('end_turn', A_TOOL, REGISTRY)).toBe(false);
   });
 });
+
+describe('accumulateUsage', () => {
+  it('returns the new usage when nothing is accumulated yet', () => {
+    const usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    expect(accumulateUsage(undefined, usage)).toEqual(usage);
+  });
+
+  it('sums both usages when both are defined', () => {
+    const accumulated: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const newUsage: UsageMetadata = {inputTokens: 20, outputTokens: 3, totalTokens: 23};
+    expect(accumulateUsage(accumulated, newUsage)).toEqual({
+      inputTokens: 30,
+      outputTokens: 8,
+      totalTokens: 38,
+    });
+  });
+
+  it('skips the new usage when it is undefined', () => {
+    const accumulated: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    expect(accumulateUsage(accumulated, undefined)).toEqual(accumulated);
+  });
+
+  it('returns undefined when both are undefined', () => {
+    expect(accumulateUsage(undefined, undefined)).toBeUndefined();
+  });
+});
diff --git a/src/orchestration/orchestratorHelpers.ts b/src/orchestration/orchestratorHelpers.ts
index 717eb9a..0224b7d 100644
--- a/src/orchestration/orchestratorHelpers.ts
+++ b/src/orchestration/orchestratorHelpers.ts
@@ -40,3 +40,16 @@ export function extractStopReason(chunk: MessageChunk): string | null {
 export function extractUsage(chunk: MessageChunk): UsageMetadata | undefined {
   return chunk.type === 'stop' ? chunk.usage : undefined;
 }
+
+export function accumulateUsage(
+  accumulated: UsageMetadata | undefined,
+  newUsage: UsageMetadata | undefined
+): UsageMetadata | undefined {
+  if (accumulated === undefined) return newUsage;
+  if (newUsage === undefined) return accumulated;
+  return {
+    inputTokens: accumulated.inputTokens + newUsage.inputTokens,
+    outputTokens: accumulated.outputTokens + newUsage.outputTokens,
+    totalTokens: accumulated.totalTokens + newUsage.totalTokens,
+  };
+}