+import {aggregateUsage} from './aggregateUsage.js';
+import type {UsageMetadata} from '../types/ai.js';
+
+describe('aggregateUsage', () => {
+  it('sums usage from multiple rounds', () => {
+    const rounds: Array<UsageMetadata | undefined> = [
+      {inputTokens: 11, outputTokens: 2, totalTokens: 13},
+      {inputTokens: 23, outputTokens: 3, totalTokens: 26},
+      {inputTokens: 37, outputTokens: 5, totalTokens: 42},
+    ];
+
+    const result = aggregateUsage(rounds);
+
+    expect(result).toEqual({inputTokens: 71, outputTokens: 10, totalTokens: 81});
+  });
+
+  it('returns undefined when no rounds report usage', () => {
+    const result = aggregateUsage([undefined, undefined]);
+
+    expect(result).toBeUndefined();
+  });
+
+  it('sums only rounds that report usage, ignoring undefined', () => {
+    const rounds: Array<UsageMetadata | undefined> = [
+      {inputTokens: 2, outputTokens: 1, totalTokens: 3},
+      undefined,
+      {inputTokens: 7, outputTokens: 4, totalTokens: 11},
+    ];
+
+    const result = aggregateUsage(rounds);
+
+    expect(result).toEqual({inputTokens: 9, outputTokens: 5, totalTokens: 14});
+  });
+});
