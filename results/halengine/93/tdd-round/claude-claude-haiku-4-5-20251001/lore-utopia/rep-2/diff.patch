+++ b/src/orchestration/aggregateUsage.ts
@@ -0,0 +1,21 @@
+import type {UsageMetadata} from '../types/ai.js';
+
+export type AggregatedUsage = UsageMetadata | undefined;
+
+export function aggregateUsage(rounds: Array<UsageMetadata | undefined>): AggregatedUsage {
+  let total: UsageMetadata | undefined;
+
+  for (const usage of rounds) {
+    if (usage === undefined) continue;
+
+    if (total === undefined) {
+      total = {inputTokens: 0, outputTokens: 0, totalTokens: 0};
+    }
+
+    total.inputTokens += usage.inputTokens;
+    total.outputTokens += usage.outputTokens;
+    total.totalTokens += usage.totalTokens;
+  }
+
+  return total;
+}
