+import {shouldContinueToolLoop, sumUsage} from './orchestratorHelpers.js';
 import type {ToolRegistry} from './tools/registry.js';
-import type {ToolCall} from '../types/ai.js';
+import type {ToolCall, UsageMetadata} from '../types/ai.js';
 
 // All three conditions matter; dropping the registry check spins the tool loop.
 
@@ -24,3 +24,28 @@ describe('shouldContinueToolLoop', () => {
     expect(shouldContinueToolLoop('end_turn', A_TOOL, REGISTRY)).toBe(false);
   });
 });
+
+describe('sumUsage', () => {
+  it('sums two complete usage objects', () => {
+    const usage1: UsageMetadata = {inputTokens: 10, outputTokens: 2, totalTokens: 12};
+    const usage2: UsageMetadata = {inputTokens: 20, outputTokens: 3, totalTokens: 23};
+    expect(sumUsage(usage1, usage2)).toEqual({inputTokens: 30, outputTokens: 5, totalTokens: 35});
+  });
+
+  it('returns the only usage when one is undefined', () => {
+    const usage: UsageMetadata = {inputTokens: 10, outputTokens: 2, totalTokens: 12};
+    expect([sumUsage(usage, undefined), sumUsage(undefined, usage)]).toEqual([usage, usage]);
+  });
+
+  it('returns undefined when both usages are undefined', () => {
+    expect(sumUsage(undefined, undefined)).toBeUndefined();
+  });
+
+  it('sums multiple rounds with gaps', () => {
+    const usage1: UsageMetadata = {inputTokens: 2, outputTokens: 1, totalTokens: 3};
+    const usage2: UsageMetadata = {inputTokens: 7, outputTokens: 4, totalTokens: 11};
+    const withGap = sumUsage(usage1, undefined);
+    const result = sumUsage(withGap, usage2);
+    expect(result).toEqual({inputTokens: 9, outputTokens: 5, totalTokens: 14});
+  });
+});
diff --git a/src/orchestration/orchestratorHelpers.ts b/src/orchestration/orchestratorHelpers.ts
index 717eb9a..64898c3 100644
--- a/src/orchestration/orchestratorHelpers.ts
+++ b/src/orchestration/orchestratorHelpers.ts
@@ -40,3 +40,16 @@ export function extractStopReason(chunk: MessageChunk): string | null {
 export function extractUsage(chunk: MessageChunk): UsageMetadata | undefined {
   return chunk.type === 'stop' ? chunk.usage : undefined;
 }
+
+export function sumUsage(
+  current: UsageMetadata | undefined,
+  incoming: UsageMetadata | undefined
+): UsageMetadata | undefined {
+  if (!current) return incoming;
+  if (!incoming) return current;
+  return {
+    inputTokens: current.inputTokens + incoming.inputTokens,
+    outputTokens: current.outputTokens + incoming.outputTokens,
+    totalTokens: current.totalTokens + incoming.totalTokens,
+  };
+}