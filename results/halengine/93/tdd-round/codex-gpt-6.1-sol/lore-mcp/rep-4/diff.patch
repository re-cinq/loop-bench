+import {accumulateUsage} from './turnUsage.js';
+import type {UsageMetadata} from '../types/ai.js';
+
+describe('[specs/hal-engine-turn-usage/spec.md#1]', () => {
+  it('sums reported token fields and skips missing rounds', () => {
+    const rounds: (UsageMetadata | undefined)[] = [
+      undefined,
+      {inputTokens: 11, outputTokens: 3, totalTokens: 14},
+      undefined,
+      {inputTokens: 7, outputTokens: 5, totalTokens: 12},
+      undefined,
+    ];
+
+    expect({
+      reported: rounds.reduce(accumulateUsage, undefined),
+      missing: [undefined, undefined].reduce(accumulateUsage, undefined),
+    }).toEqual({reported: {inputTokens: 18, outputTokens: 8, totalTokens: 26}, missing: undefined});
+  });
+});
diff --git a/src/orchestration/turnUsage.ts b/src/orchestration/turnUsage.ts
new file mode 100644
index 0000000..98b7865
--- /dev/null
+++ b/src/orchestration/turnUsage.ts
@@ -0,0 +1,14 @@
+import type {UsageMetadata} from '../types/ai.js';
+
+export function accumulateUsage(
+  total: UsageMetadata | undefined,
+  round: UsageMetadata | undefined
+): UsageMetadata | undefined {
+  if (!total) return round;
+  if (!round) return total;
+  return {
+    inputTokens: total.inputTokens + round.inputTokens,
+    outputTokens: total.outputTokens + round.outputTokens,
+    totalTokens: total.totalTokens + round.totalTokens,
+  };
+}
