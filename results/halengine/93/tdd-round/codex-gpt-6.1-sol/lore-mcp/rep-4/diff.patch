+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+
+describe('[specs/hal-engine-turn-usage/spec.md#2]', () => {
+  it('includes the tool-request call in hook usage', async () => {
+    // Contract at the provider boundary: a tool request followed by its answer.
+    const rounds: MessageChunk[][] = [
+      [
+        {type: 'tool_use', toolCall: {id: 'lookup-1', name: 'lookup', input: {}}},
+        {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 11, outputTokens: 2, totalTokens: 13}},
+      ],
+      [{type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 7, outputTokens: 3, totalTokens: 10}}],
+    ];
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        yield* rounds.shift() ?? [];
+      },
+      async generateStructured<T>(): Promise<T> {
+        throw new Error('Structured output is outside this contract.');
+      },
+    };
+    const registry = new ToolRegistry();
+    registry.register(
+      {name: 'lookup', description: 'Look up a value.', inputSchema: {type: 'object'}},
+      async () => 'found'
+    );
+    let reported: UsageMetadata | undefined;
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Usage contract.'}), registry, {
+      hooks: {
+        afterModelResponse: async (_session, _text, usage) => {
+          reported = usage;
+        },
+      },
+    });
+
+    await orchestrator.processMessage({
+      sessionId: 'usage-contract',
+      userId: 'user',
+      entries: [{role: 'user', content: 'Look up a value.', timestamp: '2026-01-01T00:00:00.000Z'}],
+    });
+
+    expect(reported).toEqual({inputTokens: 18, outputTokens: 5, totalTokens: 23});
+  });
+});