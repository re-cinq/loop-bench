@@ -1,4 +1,4 @@
-import type {Message, MessageChunk, ToolCall, UsageMetadata} from '../types/ai.js';
+import type {Message, MessageChunk, ToolCall, TurnUsage, UsageMetadata} from '../types/ai.js';
 import type {ToolRegistry} from './tools/registry.js';
 
 export function shouldContinueToolLoop(
@@ -40,3 +40,14 @@ export function extractStopReason(chunk: MessageChunk): string | null {
 export function extractUsage(chunk: MessageChunk): UsageMetadata | undefined {
   return chunk.type === 'stop' ? chunk.usage : undefined;
 }
+
+// A round that reported nothing contributes nothing, and a turn where no round reported has no total at all.
+export function sumReportedUsage(roundUsages: Array<UsageMetadata | undefined>): TurnUsage | undefined {
+  const reported = roundUsages.filter((usage): usage is UsageMetadata => usage !== undefined);
+  if (reported.length === 0) return undefined;
+  return {
+    inputTokens: reported.reduce((total, usage) => total + usage.inputTokens, 0),
+    outputTokens: reported.reduce((total, usage) => total + usage.outputTokens, 0),
+    totalTokens: reported.reduce((total, usage) => total + usage.totalTokens, 0),
+  };
+}
