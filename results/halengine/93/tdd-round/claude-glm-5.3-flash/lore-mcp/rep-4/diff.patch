+
+    expect(sumUsage(first, undefined)).toEqual(first);
+  });
+
+  it('adopts the first reported round as the total when earlier rounds reported none', () => {
+    const second = {inputTokens: 23, outputTokens: 3, totalTokens: 26};
+
+    expect(sumUsage(undefined, second)).toEqual(second);
+  });
+
+  it('leaves a turn where no round reported usage undefined', () => {
+    expect(sumUsage(undefined, undefined)).toBeUndefined();
+  });
+});
