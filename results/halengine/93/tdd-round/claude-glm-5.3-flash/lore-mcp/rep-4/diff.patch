index 717eb9a..3d20f3c 100644
--- a/src/orchestration/orchestratorHelpers.ts
+++ b/src/orchestration/orchestratorHelpers.ts
@@ -1,4 +1,4 @@
-import type {Message, MessageChunk, ToolCall, UsageMetadata} from '../types/ai.js';
+import type {Message, MessageChunk, ToolCall, TurnUsage, UsageMetadata} from '../types/ai.js';
 import type {ToolRegistry} from './tools/registry.js';
 
 export function shouldContinueToolLoop(
@@ -40,3 +40,14 @@ export function extractStopReason(chunk: MessageChunk): string | null {
 export function extractUsage(chunk: MessageChunk): UsageMetadata | undefined {
   return chunk.type === 'stop' ? chunk.usage : undefined;
 }
+
+// Only reported rounds add: a round without usage leaves the total as it was, so a provider gap cannot NaN a turn.
+export function sumUsage(total: TurnUsage | undefined, round: UsageMetadata | undefined): TurnUsage | undefined {
+  if (!round) return total;
+  if (!total) return round;
+  return {
+    inputTokens: total.inputTokens + round.inputTokens,
+    outputTokens: total.outputTokens + round.outputTokens,
+    totalTokens: total.totalTokens + round.totalTokens,
+  };
+}
