@@ -1,4 +1,4 @@
-import type {Message, MessageChunk, ToolCall, UsageMetadata} from '../types/ai.js';
+import type {Message, MessageChunk, ToolCall, TurnUsage, UsageMetadata} from '../types/ai.js';
 import type {ToolRegistry} from './tools/registry.js';
 
 export function shouldContinueToolLoop(
@@ -40,3 +40,19 @@ export function extractStopReason(chunk: MessageChunk): string | null {
 export function extractUsage(chunk: MessageChunk): UsageMetadata | undefined {
   return chunk.type === 'stop' ? chunk.usage : undefined;
 }
+
+// A round without usage is the provider not reporting, not zero: skip it, and a turn where none reported stays undefined.
+export function turnUsage(roundUsages: Array<UsageMetadata | undefined>): TurnUsage | undefined {
+  let total: TurnUsage | undefined;
+  for (const usage of roundUsages) {
+    if (usage === undefined) continue;
+    total = total
+      ? {
+          inputTokens: total.inputTokens + usage.inputTokens,
+          outputTokens: total.outputTokens + usage.outputTokens,
+          totalTokens: total.totalTokens + usage.totalTokens,
+        }
+      : usage;
+  }
+  return total;
+}
