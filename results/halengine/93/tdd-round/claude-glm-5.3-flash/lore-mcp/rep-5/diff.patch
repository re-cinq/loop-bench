+import type {Message, MessageChunk, ToolCall, TurnUsage, UsageMetadata} from '../types/ai.js';
 import type {ToolRegistry} from './tools/registry.js';
 
 export function shouldContinueToolLoop(
@@ -40,3 +40,17 @@ export function extractStopReason(chunk: MessageChunk): string | null {
 export function extractUsage(chunk: MessageChunk): UsageMetadata | undefined {
   return chunk.type === 'stop' ? chunk.usage : undefined;
 }
+
+// Undefined is the identity: a round that reports nothing leaves the total, and an unreported turn stays unreported.
+export function addRoundUsage(
+  total: TurnUsage | undefined,
+  roundUsage: UsageMetadata | undefined
+): TurnUsage | undefined {
+  if (roundUsage === undefined) return total;
+  if (total === undefined) return {...roundUsage};
+  return {
+    inputTokens: total.inputTokens + roundUsage.inputTokens,
+    outputTokens: total.outputTokens + roundUsage.outputTokens,
+    totalTokens: total.totalTokens + roundUsage.totalTokens,
+  };
+}
