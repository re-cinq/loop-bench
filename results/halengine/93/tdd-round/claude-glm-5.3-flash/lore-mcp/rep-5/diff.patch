@@ -0,0 +1,41 @@
+import http from 'node:http';
+import type {AddressInfo} from 'node:net';
+import {connectClient, framesUntil, stopEngines} from './wsTestSupport.js';
+
+// The helper's contract on a transport failure: the awaiting test learns the reason, and no unhandled error reaches the worker.
+
+// A real socket that answers every upgrade with HTTP 404, the response a ws client reports as "Unexpected server response".
+const refusingUpgrade = (): Promise<http.Server> =>
+  new Promise(resolve => {
+    const server = http.createServer((_request, response) => {
+      response.writeHead(404);
+      response.end();
+    });
+    server.on('upgrade', (_request, socket) => {
+      socket.write('HTTP/1.1 404 Not Found\r\n\r\n');
+      socket.destroy();
+    });
+    server.listen(0, '127.0.0.1', () => resolve(server));
+  });
+
+describe('a ws test client whose upgrade fails', () => {
+  let server: http.Server | undefined;
+
+  afterEach(async () => {
+    await stopEngines();
+    const opened = server;
+    server = undefined;
+    if (opened) await new Promise<void>(resolve => opened.close(() => resolve()));
+  });
+
+  it('rejects the awaiting frames promise with the handshake error the client received', async () => {
+    server = await refusingUpgrade();
+    const {port} = server.address() as AddressInfo;
+    const client = connectClient(`ws://127.0.0.1:${port}/hal/ws/c1`);
+    const hung = new Promise<never>((_resolve, reject) => {
+      setTimeout(() => reject(new Error('the frames promise neither resolved nor rejected')), 1000).unref();
+    });
