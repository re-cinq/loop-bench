+  });
+
+  it('preserves the running total when the new round reports nothing', () => {
+    const usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    expect(accumulateUsage(usage, undefined)).toEqual(usage);
+  });
+
+  it('sums all three token fields from both rounds', () => {
+    const a: UsageMetadata = {inputTokens: 11, outputTokens: 3, totalTokens: 14};
+    const b: UsageMetadata = {inputTokens: 7, outputTokens: 2, totalTokens: 9};
+    expect(accumulateUsage(a, b)).toEqual({inputTokens: 18, outputTokens: 5, totalTokens: 23});
+  });
+});
diff --git a/src/orchestration/orchestratorHelpers.ts b/src/orchestration/orchestratorHelpers.ts
index 717eb9a..c5efef4 100644
--- a/src/orchestration/orchestratorHelpers.ts
+++ b/src/orchestration/orchestratorHelpers.ts
@@ -40,3 +40,16 @@ export function extractStopReason(chunk: MessageChunk): string | null {
 export function extractUsage(chunk: MessageChunk): UsageMetadata | undefined {
   return chunk.type === 'stop' ? chunk.usage : undefined;
 }
+
+export function accumulateUsage(
+  accumulated: UsageMetadata | undefined,
+  round: UsageMetadata | undefined
+): UsageMetadata | undefined {
+  if (!accumulated) return round;
+  if (!round) return accumulated;
+  return {
+    inputTokens: accumulated.inputTokens + round.inputTokens,
+    outputTokens: accumulated.outputTokens + round.outputTokens,
+    totalTokens: accumulated.totalTokens + round.totalTokens,
+  };
+}