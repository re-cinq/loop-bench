@@ -0,0 +1,84 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+async function runUsageTurn(provider: AIProvider): Promise<UsageMetadata | undefined> {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Looks up a value.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reported = usage;
+    },
+  };
+  const session: ChatSession = {
+    sessionId: 'total-usage-session',
+    userId: 'usage-user',
+    entries: [{role: 'user', content: 'Use the tool.', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Usage test.'}), registry, {
+    hooks,
+  });
+
+  await orchestrator.processMessage(session);
+  return reported;
+}
+
+// spec: specs/hal-engine-config-hooks/spec.md#10
+it('adds usage from a tool round and its answering provider call', async () => {
+  const rounds: MessageChunk[][] = [
+    [
+      {type: 'tool_use', toolCall: {id: 'lookup-1', name: 'lookup', input: {}}},
+      {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 11, outputTokens: 2, totalTokens: 13}},
+    ],
+    [
+      {type: 'text', text: 'Done.'},
+      {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 23, outputTokens: 5, totalTokens: 28}},
+    ],
+  ];
+  let round = 0;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield* rounds[round++] ?? [];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const reported = await runUsageTurn(provider);
+
+  expect(reported).toEqual({inputTokens: 34, outputTokens: 7, totalTokens: 41});
+});
+
+// spec: specs/hal-engine-config-hooks/spec.md#12
+it('keeps each reported round count when a provider reuses its usage object', async () => {
+  const reusedUsage: UsageMetadata = {inputTokens: 2, outputTokens: 1, totalTokens: 3};
+  let round = 0;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      if (round++ === 0) {
+        yield {type: 'tool_use', toolCall: {id: 'lookup-1', name: 'lookup', input: {}}};
+        yield {type: 'stop', stopReason: 'tool_use', usage: reusedUsage};
+        return;
+      }
+      reusedUsage.inputTokens = 7;
+      reusedUsage.outputTokens = 4;
+      reusedUsage.totalTokens = 11;
+      yield {type: 'text', text: 'Done.'};
+      yield {type: 'stop', stopReason: 'end_turn', usage: reusedUsage};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+
+  const reported = await runUsageTurn(provider);
+
+  expect(reported).toEqual({inputTokens: 9, outputTokens: 5, totalTokens: 14});
+});
diff --git a/src/orchestration/chatOrchestratorUsage.acceptance.test.ts b/src/orchestration/chatOrchestratorUsage.acceptance.test.ts
new file mode 100644
index 0000000..37b5256
--- /dev/null
