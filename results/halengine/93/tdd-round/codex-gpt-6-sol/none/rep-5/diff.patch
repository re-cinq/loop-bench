@@ -0,0 +1,47 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {TotalUsageMetadata} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+it('reports total usage from a tool round and its final provider call', async () => {
+  const rounds: MessageChunk[][] = [
+    [
+      {type: 'tool_use', toolCall: {id: 'lookup-1', name: 'lookup', input: {}}},
+      {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 11, outputTokens: 2, totalTokens: 13}},
+    ],
+    [
+      {type: 'text', text: 'Done.'},
+      {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 23, outputTokens: 3, totalTokens: 26}},
+    ],
+  ];
+  let round = 0;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield* rounds[round++] ?? [];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'Lookup', inputSchema: {type: 'object'}}, async () => 'found');
+  const session: ChatSession = {
+    sessionId: 'usage-round',
+    userId: 'usage-user',
+    entries: [{role: 'user', content: 'Use the tool.', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  let reported: TotalUsageMetadata | undefined;
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Usage test.'}), registry, {
+    hooks: {
+      afterModelResponse: async (_session, _text, totalUsage) => {
+        reported = totalUsage;
+      },
+    },
+  });
+
+  await orchestrator.processMessage(session);
+
+  expect(reported).toEqual({inputTokens: 34, outputTokens: 5, totalTokens: 39});
+});
