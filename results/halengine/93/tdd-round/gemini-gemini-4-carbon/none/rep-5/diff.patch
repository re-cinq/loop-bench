+import type {Message, MessageChunk, ToolCall, TurnUsage, UsageMetadata} from '../types/ai.js';
 import type {ToolRegistry} from './tools/registry.js';
 
 export function shouldContinueToolLoop(
@@ -40,3 +40,16 @@ export function extractStopReason(chunk: MessageChunk): string | null {
 export function extractUsage(chunk: MessageChunk): UsageMetadata | undefined {
   return chunk.type === 'stop' ? chunk.usage : undefined;
 }
+
+export function accumulateUsage(
+  priorUsage: TurnUsage | undefined,
+  roundUsage: UsageMetadata | undefined
+): TurnUsage | undefined {
+  if (!roundUsage) return priorUsage;
+  if (!priorUsage) return {...roundUsage};
+  return {
+    inputTokens: priorUsage.inputTokens + roundUsage.inputTokens,
+    outputTokens: priorUsage.outputTokens + roundUsage.outputTokens,
+    totalTokens: priorUsage.totalTokens + roundUsage.totalTokens,
+  };
+}
diff --git a/src/turnUsage.test.ts b/src/turnUsage.test.ts
new file mode 100644
index 0000000..8ad065c
--- /dev/null
+++ b/src/turnUsage.test.ts
@@ -0,0 +1,46 @@
+import {createChatOrchestrator, PromptBuilder, ToolRegistry} from './index.js';
+import type {AIProvider, ChatSession, MessageChunk, OrchestratorHooks, TurnUsage, UsageMetadata} from './index.js';
+
+describe('OrchestratorHooks.afterModelResponse total usage contract', () => {
+  it('passes TurnUsage summed across tool rounds through OrchestratorHooks.afterModelResponse', async () => {
+    const stepChunks: MessageChunk[][] = [
+      [
+        {type: 'tool_use', toolCall: {id: 'step-1', name: 'ping', input: {}}},
+        {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 15, outputTokens: 4, totalTokens: 19}},
+      ],
+      [
+        {type: 'text', text: 'Complete.'},
+        {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 30, outputTokens: 6, totalTokens: 36}},
+      ],
+    ];
+    let stepIndex = 0;
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        yield* stepChunks[stepIndex++] ?? [];
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const registry = new ToolRegistry();
+    registry.register({name: 'ping', description: 'Checks liveness.', inputSchema: {type: 'object'}}, async () => 'ok');
+    let observedTotal: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _responseText, totalUsage?: TurnUsage) => {
+        observedTotal = totalUsage;
+      },
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Turn usage test.'}), registry, {
+      hooks,
+    });
+    const turnSession: ChatSession = {
+      sessionId: 'turn-1',
+      userId: 'caller-1',
+      entries: [{role: 'user', content: 'Check status.', timestamp: '2026-02-01T00:00:00.000Z'}],
+    };
+
+    await orchestrator.processMessage(turnSession);
+
+    expect(observedTotal).toEqual({inputTokens: 45, outputTokens: 10, totalTokens: 55});
+  });
+});
