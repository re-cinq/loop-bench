-import type {Message, MessageChunk, ToolCall, UsageMetadata} from '../types/ai.js';
+import type {Message, MessageChunk, ToolCall, TurnUsage, UsageMetadata} from '../types/ai.js';
 import type {ToolRegistry} from './tools/registry.js';
 
 export function shouldContinueToolLoop(
@@ -40,3 +40,16 @@ export function extractStopReason(chunk: MessageChunk): string | null {
 export function extractUsage(chunk: MessageChunk): UsageMetadata | undefined {
   return chunk.type === 'stop' ? chunk.usage : undefined;
 }
+
+export function accumulateTurnUsage(
+  turnTotal: TurnUsage | undefined,
+  roundUsage: UsageMetadata | undefined
+): TurnUsage | undefined {
+  if (!roundUsage) return turnTotal;
+  if (!turnTotal) return {...roundUsage};
+  return {
+    inputTokens: turnTotal.inputTokens + roundUsage.inputTokens,
+    outputTokens: turnTotal.outputTokens + roundUsage.outputTokens,
+    totalTokens: turnTotal.totalTokens + roundUsage.totalTokens,
+  };
+}
