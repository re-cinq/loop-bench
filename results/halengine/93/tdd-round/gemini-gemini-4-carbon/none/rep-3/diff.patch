+      rounds.reduce<UsageMetadata | undefined>(accumulateUsage, undefined);
+
+    expect({
+      allReported: sumRounds([firstRound, secondRound, thirdRound]),
+      sparseReported: sumRounds([undefined, firstRound, undefined, thirdRound]),
+      singleZeroRound: sumRounds([{inputTokens: 0, outputTokens: 0, totalTokens: 0}]),
+      emptyTurn: sumRounds([undefined, undefined]),
+    }).toEqual({
+      allReported: {inputTokens: 71, outputTokens: 10, totalTokens: 81},
+      sparseReported: {inputTokens: 48, outputTokens: 7, totalTokens: 55},
+      singleZeroRound: {inputTokens: 0, outputTokens: 0, totalTokens: 0},
+      emptyTurn: undefined,
+    });
+  });
+});
