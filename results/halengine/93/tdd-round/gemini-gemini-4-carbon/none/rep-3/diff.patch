--- /dev/null
+++ b/src/orchestration/totalUsage.test.ts
@@ -0,0 +1,50 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, TotalUsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('ChatOrchestrator total usage contract', () => {
+  it('passes afterModelResponse the total usage summed across tool rounds as TotalUsageMetadata', async () => {
+    const roundQueue: MessageChunk[][] = [
+      [
+        {type: 'tool_use', toolCall: {id: 'meter-1', name: 'meter', input: {}}},
+        {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 10, outputTokens: 3, totalTokens: 13}},
+      ],
+      [
+        {type: 'text', text: 'Measured.'},
+        {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 30, outputTokens: 6, totalTokens: 36}},
+      ],
+    ];
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        yield* roundQueue.shift() ?? [];
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const tools = new ToolRegistry();
+    tools.register({name: 'meter', description: 'Reads a meter.', inputSchema: {type: 'object'}}, async () => 'ok');
+
+    let receivedTotal: TotalUsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _responseText, totalUsage: TotalUsageMetadata | undefined) => {
+        receivedTotal = totalUsage;
+      },
+    };
+    const session: ChatSession = {
+      sessionId: 'total-usage-session',
+      userId: 'total-usage-user',
+      entries: [{role: 'user', content: 'Measure now.', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Meter agent.'}), tools, {
+      hooks,
+    });
+
+    await orchestrator.processMessage(session);
+
+    expect(receivedTotal).toEqual({inputTokens: 40, outputTokens: 9, totalTokens: 49});
+  });
+});
