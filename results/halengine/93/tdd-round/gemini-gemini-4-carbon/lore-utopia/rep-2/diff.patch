+import type {AggregatedUsage, Message, MessageChunk, ToolCall, UsageMetadata} from '../types/ai.js';
 import type {ToolRegistry} from './tools/registry.js';
 
 export function shouldContinueToolLoop(
@@ -40,3 +40,16 @@ export function extractStopReason(chunk: MessageChunk): string | null {
 export function extractUsage(chunk: MessageChunk): UsageMetadata | undefined {
   return chunk.type === 'stop' ? chunk.usage : undefined;
 }
+
+export function accumulateUsage(
+  totalUsage: AggregatedUsage | undefined,
+  roundUsage: UsageMetadata | undefined
+): AggregatedUsage | undefined {
+  if (!roundUsage) return totalUsage;
+  if (!totalUsage) return {...roundUsage};
+  return {
+    inputTokens: totalUsage.inputTokens + roundUsage.inputTokens,
+    outputTokens: totalUsage.outputTokens + roundUsage.outputTokens,
+    totalTokens: totalUsage.totalTokens + roundUsage.totalTokens,
+  };
+}
