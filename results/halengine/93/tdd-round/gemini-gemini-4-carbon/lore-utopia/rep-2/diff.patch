@@ -0,0 +1,54 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AggregatedUsage, AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('OrchestratorHooks.afterModelResponse AggregatedUsage contract', () => {
+  it('delivers summed usage across tool rounds through the AggregatedUsage hook contract', async () => {
+    let recordedTotal: AggregatedUsage | undefined;
+    const receiveTotalUsage: NonNullable<OrchestratorHooks['afterModelResponse']> = async (
+      _session: ChatSession,
+      _responseText: string,
+      totalUsage?: AggregatedUsage
+    ) => {
+      recordedTotal = totalUsage;
+    };
+    const plannedChunks: MessageChunk[][] = [
+      [
+        {type: 'tool_use', toolCall: {id: 'fetch-1', name: 'fetchQuote', input: {}}},
+        {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 8, outputTokens: 2, totalTokens: 10}},
+      ],
+      [
+        {type: 'text', text: 'Answered.'},
+        {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 12, outputTokens: 4, totalTokens: 16}},
+      ],
+    ];
+    let callIndex = 0;
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        yield* plannedChunks[callIndex++] ?? [];
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const registry = new ToolRegistry();
+    registry.register(
+      {name: 'fetchQuote', description: 'Fetches a quote.', inputSchema: {type: 'object'}},
+      async () => 'quoted'
+    );
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Billing audit.'}), registry, {
+      hooks: {afterModelResponse: receiveTotalUsage},
+    });
+
+    await orchestrator.processMessage({
+      sessionId: 'turn-1',
+      userId: 'deployer-1',
+      entries: [{role: 'user', content: 'Quote please.', timestamp: '2026-01-01T00:00:00.000Z'}],
+    });
+
+    expect(recordedTotal).toEqual({inputTokens: 20, outputTokens: 6, totalTokens: 26});
+  });
+});
