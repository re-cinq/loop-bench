+++ b/src/orchestration/turnUsage.test.ts
@@ -0,0 +1,65 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../shared/logger.js';
+import type {AIProvider, MessageChunk, TurnUsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const providerFromSteps = (steps: MessageChunk[][]): AIProvider => {
+  let stepIndex = 0;
+  return {
+    async *sendMessage() {
+      yield* steps[stepIndex++] ?? [];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+describe('OrchestratorHooks.afterModelResponse turn usage contract', () => {
+  beforeEach(() => {
+    const silent = () => undefined;
+    setLogger({debug: silent, info: silent, warn: silent, error: silent});
+  });
+
+  afterEach(() => setLogger());
+
+  it('delivers summed TurnUsageMetadata across rounds through afterModelResponse', async () => {
+    const recordedTotals: Array<TurnUsageMetadata | undefined> = [];
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _responseText, totalUsage?: TurnUsageMetadata) => {
+        recordedTotals.push(totalUsage);
+      },
+    };
+    const registry = new ToolRegistry();
+    registry.register({name: 'ping', description: 'Pings a target.', inputSchema: {type: 'object'}}, async () => 'ok');
+    const promptBuilder = new PromptBuilder({identity: 'Usage test.'});
+    const userTurn = (): ChatSession => ({
+      sessionId: 'turn-1',
+      userId: 'user-1',
+      entries: [{role: 'user', content: 'ping', timestamp: '2026-01-01T00:00:00.000Z'}],
+    });
+
+    const multiRound = createChatOrchestrator(
+      providerFromSteps([
+        [
+          {type: 'tool_use', toolCall: {id: 't1', name: 'ping', input: {}}},
+          {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 12, outputTokens: 4, totalTokens: 16}},
+        ],
+        [
+          {type: 'text', text: 'pong'},
+          {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 19, outputTokens: 6, totalTokens: 25}},
+        ],
+      ]),
+      promptBuilder,
+      registry,
+      {hooks}
+    );
+
+    await multiRound.processMessage(userTurn());
+
+    expect(recordedTotals).toEqual([{inputTokens: 31, outputTokens: 10, totalTokens: 41}]);
+  });
+});
