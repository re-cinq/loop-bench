+export function descriptor(file, assertion, source) {
+  const result = {id: `${file}::${assertion.fullName}`, name: assertion.fullName, file};
+  const lines = source.split(/\r?\n/);
+  const preceding = lines[assertion.location?.line - 2] ?? '';
+  const anchor = preceding.match(/\b(specs\/[^\s]+\/spec\.md#\d+)\b/);
+  if (anchor) result.spec = anchor[1];
+  return result;
+}
