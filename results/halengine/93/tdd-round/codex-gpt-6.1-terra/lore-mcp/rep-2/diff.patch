@@ -0,0 +1,17 @@
+import {reportedUsage} from './usageTestFixture.js';
+import type {MessageChunk} from '../types/ai.js';
+
+it('retains reported counts when a provider reuses its usage object (specs/hal-engine-config-hooks/spec.md#10)', async () => {
+  const usage = {inputTokens: 2, outputTokens: 3, totalTokens: 5};
+  let round = 0;
+  const total = await reportedUsage(async function* (): AsyncGenerator<MessageChunk> {
+    if (round++ === 0) {
+      yield {type: 'tool_use', toolCall: {id: '1', name: 'lookup', input: {}}};
+      yield {type: 'stop', stopReason: 'tool_use', usage};
+      return;
+    }
+    Object.assign(usage, {inputTokens: 7, outputTokens: 11, totalTokens: 18});
+    yield {type: 'stop', stopReason: 'end_turn', usage};
+  });
+  expect(total).toEqual({inputTokens: 9, outputTokens: 14, totalTokens: 23});
+});
