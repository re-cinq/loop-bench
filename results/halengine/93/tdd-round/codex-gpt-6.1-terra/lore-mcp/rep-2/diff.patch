@@ -0,0 +1,15 @@
+import {reportedUsage} from './usageTestFixture.js';
+import type {MessageChunk} from '../types/ai.js';
+
+it('adds usage from two provider calls (specs/hal-engine-config-hooks/spec.md#10)', async () => {
+  let round = 0;
+  const total = await reportedUsage(async function* (): AsyncGenerator<MessageChunk> {
+    if (round++ === 0) {
+      yield {type: 'tool_use', toolCall: {id: '1', name: 'lookup', input: {}}};
+      yield {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 2, outputTokens: 3, totalTokens: 5}};
+      return;
+    }
+    yield {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 7, outputTokens: 11, totalTokens: 18}};
+  });
+  expect(total).toEqual({inputTokens: 9, outputTokens: 14, totalTokens: 23});
+});
