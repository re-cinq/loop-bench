+import {reportedUsage, structuredResult} from './usageTestSupport.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+
+// specs/hal-engine-config-hooks/spec.md#11
+it('sums reported usage across a missing tool round', async () => {
+  const rounds: MessageChunk[][] = [
+    [
+      {type: 'tool_use', toolCall: {id: '1', name: 'lookup', input: {}}},
+      {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 2, outputTokens: 3, totalTokens: 5}},
+    ],
+    [
+      {type: 'tool_use', toolCall: {id: '2', name: 'lookup', input: {}}},
+      {type: 'stop', stopReason: 'tool_use'},
+    ],
+    [{type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 7, outputTokens: 11, totalTokens: 18}}],
+  ];
+  let index = 0;
+  const provider: AIProvider = {
+    async *sendMessage() {
+      yield* rounds[index++];
+    },
+    generateStructured: structuredResult,
+  };
+  expect(await reportedUsage(provider)).toEqual({inputTokens: 9, outputTokens: 14, totalTokens: 23});
+});