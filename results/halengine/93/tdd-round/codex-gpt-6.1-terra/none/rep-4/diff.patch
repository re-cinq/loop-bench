+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, UsageMetadata} from '../types/ai.js';
+
+export async function structuredResult<T>(): Promise<T> {
+  return {} as T;
+}
+
+export async function reportedUsage(provider: AIProvider): Promise<UsageMetadata | undefined> {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'Look up', inputSchema: {type: 'object'}}, async () => 'found');
+  let reported: UsageMetadata | undefined;
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), registry, {
+    hooks: {
+      afterModelResponse: async (_session, _text, usage) => {
+        reported = usage;
+      },
+    },
+  });
+  await orchestrator.processMessage({
+    sessionId: '1',
+    userId: '1',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  });
+  return reported;
+}
