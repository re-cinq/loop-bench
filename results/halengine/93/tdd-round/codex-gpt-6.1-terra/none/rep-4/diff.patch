+import {reportedUsage, structuredResult} from './usageTestSupport.js';
+import type {AIProvider, UsageMetadata} from '../types/ai.js';
+
+// specs/hal-engine-config-hooks/spec.md#10
+it('counts each round when the provider reuses its usage object', async () => {
+  const usage: UsageMetadata = {inputTokens: 2, outputTokens: 3, totalTokens: 5};
+  let round = 0;
+  const provider: AIProvider = {
+    async *sendMessage() {
+      if (round++ === 0) {
+        yield {type: 'tool_use', toolCall: {id: '1', name: 'lookup', input: {}}};
+        yield {type: 'stop', stopReason: 'tool_use', usage};
+        return;
+      }
+      Object.assign(usage, {inputTokens: 7, outputTokens: 11, totalTokens: 18});
+      yield {type: 'stop', stopReason: 'end_turn', usage};
+    },
+    generateStructured: structuredResult,
+  };
+  expect(await reportedUsage(provider)).toEqual({inputTokens: 9, outputTokens: 14, totalTokens: 23});
+});
