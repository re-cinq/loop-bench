@@ -0,0 +1,83 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {MessageChunk, TurnUsageMetadata, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {scriptedProvider} from './chatOrchestratorUsage.testSupport.js';
+
+const promptBuilder = new PromptBuilder({identity: 'Usage test.'});
+const session = (): ChatSession => ({
+  sessionId: 'usage-session',
+  userId: 'usage-user',
+  entries: [{role: 'user', content: 'Use the tool.', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const usageStop = (stopReason: string, usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason, usage});
+
+const lookupRegistry = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'Looks up a value.', inputSchema: {type: 'object'}}, () =>
+    Promise.resolve('found')
+  );
+  return registry;
+};
+
+describe('afterModelResponse usage', () => {
+  it('reports the total usage from every provider call in a tool turn', async () => {
+    const rounds: MessageChunk[][] = [
+      [
+        {type: 'tool_use', toolCall: {id: 'lookup-1', name: 'lookup', input: {}}},
+        usageStop('tool_use', {inputTokens: 11, outputTokens: 2, totalTokens: 13}),
+      ],
+      [{type: 'text', text: 'Done.'}, usageStop('end_turn', {inputTokens: 23, outputTokens: 3, totalTokens: 26})],
+    ];
+    const provider = scriptedProvider(rounds);
+    let reported: TurnUsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        reported = usage;
+      },
+    };
+
+    await createChatOrchestrator(provider, promptBuilder, lookupRegistry(), {hooks}).processMessage(session());
+
+    expect(reported).toEqual({inputTokens: 34, outputTokens: 5, totalTokens: 39});
+  });
+
+  it('counts reported rounds while leaving a turn with no reported usage undefined', async () => {
+    const reports: Array<TurnUsageMetadata | undefined> = [];
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        reports.push(usage);
+      },
+    };
+    const rounds: MessageChunk[][] = [
+      [
+        {type: 'tool_use', toolCall: {id: 'lookup-1', name: 'lookup', input: {}}},
+        usageStop('tool_use', {inputTokens: 2, outputTokens: 1, totalTokens: 3}),
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'lookup-2', name: 'lookup', input: {}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [{type: 'text', text: 'Done.'}, usageStop('end_turn', {inputTokens: 7, outputTokens: 4, totalTokens: 11})],
+    ];
+    const provider = scriptedProvider(rounds);
+    await createChatOrchestrator(provider, promptBuilder, lookupRegistry(), {hooks}).processMessage(session());
+    await createChatOrchestrator(
+      {
+        ...provider,
+        async *sendMessage(): AsyncGenerator<MessageChunk> {
+          yield {type: 'text', text: 'Done.'};
+          yield {type: 'stop', stopReason: 'end_turn'};
+        },
+      },
+      promptBuilder,
+      undefined,
+      {hooks}
+    ).processMessage(session());
+
+    expect(reports).toEqual([{inputTokens: 9, outputTokens: 5, totalTokens: 14}, undefined]);
+  });
+});
