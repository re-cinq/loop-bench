+export function accumulateUsage(
+  current: TotalUsage | undefined,
+  round: UsageMetadata | undefined
+): TotalUsage | undefined {
+  if (!round) return current;
+  const input = round.inputTokens ?? 0;
+  const output = round.outputTokens ?? 0;
