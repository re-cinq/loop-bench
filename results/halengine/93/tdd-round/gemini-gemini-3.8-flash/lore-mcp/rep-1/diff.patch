 export function shouldContinueToolLoop(
@@ -40,3 +40,15 @@ export function extractStopReason(chunk: MessageChunk): string | null {
 export function extractUsage(chunk: MessageChunk): UsageMetadata | undefined {
   return chunk.type === 'stop' ? chunk.usage : undefined;
 }
+
+export function accumulateUsage(
+  totalUsage: TotalUsage | undefined,
+  roundUsage: UsageMetadata | undefined
+): TotalUsage | undefined {
+  if (!roundUsage) return totalUsage;
+  return {
+    inputTokens: (totalUsage?.inputTokens ?? 0) + roundUsage.inputTokens,
+    outputTokens: (totalUsage?.outputTokens ?? 0) + roundUsage.outputTokens,
+    totalTokens: (totalUsage?.totalTokens ?? 0) + roundUsage.totalTokens,
+  };
+}
