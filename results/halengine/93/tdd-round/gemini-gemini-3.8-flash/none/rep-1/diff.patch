 export function shouldContinueToolLoop(
@@ -40,3 +40,15 @@ export function extractStopReason(chunk: MessageChunk): string | null {
 export function extractUsage(chunk: MessageChunk): UsageMetadata | undefined {
   return chunk.type === 'stop' ? chunk.usage : undefined;
 }
+
+export function accumulateUsage(
+  total: TotalUsage | undefined,
+  round: UsageMetadata | undefined
+): TotalUsage | undefined {
+  if (!round) return total;
+  return {
+    inputTokens: (total?.inputTokens ?? 0) + (round.inputTokens ?? 0),
+    outputTokens: (total?.outputTokens ?? 0) + (round.outputTokens ?? 0),
+    totalTokens: (total?.totalTokens ?? 0) + (round.totalTokens ?? 0),
+  };
+}
