new file mode 100644
index 0000000..c3ad387
--- /dev/null
+++ b/src/orchestration/afterModelResponse-usage.acceptance.test.ts
@@ -0,0 +1,81 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {MessageChunk, UsageMetadata} from '../types/ai.js';
+import {scriptedProvider} from './testUtils.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const STOP_DONE = {type: 'stop' as const, stopReason: 'end_turn'};
+const STOP_FOR_TOOL = {type: 'stop' as const, stopReason: 'tool_use'};
+const TOOL_CALL = {type: 'tool_use' as const, toolCall: {id: 'c1', name: 'test_tool', input: {}}};
+
+const ROUND_TOOL_CALL_10_20_30: MessageChunk[] = [
+  TOOL_CALL,
+  {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 10, outputTokens: 20, totalTokens: 30}},
+];
+const ROUND_FINAL_DONE_5_5_10: MessageChunk[] = [
+  {type: 'text', text: 'done'},
+  {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 5, outputTokens: 5, totalTokens: 10}},
+];
+
+function captureUsage(): {hooks: OrchestratorHooks; reportedUsage: () => UsageMetadata | undefined} {
+  let captured: UsageMetadata | undefined;
+  return {
+    hooks: {
+      afterModelResponse: async (_session, _text, usage) => {
+        captured = usage;
+      },
+    },
+    reportedUsage: () => captured,
+  };
+}
+
+describe('afterModelResponse usage reporting', () => {
+  const promptBuilder = new PromptBuilder({identity: 'test'});
+  const registry = new ToolRegistry();
+  registry.register({name: 'test_tool', description: 'desc', inputSchema: {type: 'object'}}, async () => ({
+    result: 'result',
+    clientMessages: [],
+    suppressAssistantResponse: false,
+  }));
+
+  async function runWith(rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> {
+    const {hooks, reportedUsage} = captureUsage();
+    const orchestrator = createChatOrchestrator(scriptedProvider(rounds), promptBuilder, registry, {hooks});
+    await orchestrator.processMessage(createSession('ask'));
+    return reportedUsage();
+  }
+
+  it('reports usage covering every provider call in that turn when driven through two tool rounds', async () => {
+    const usage = await runWith([
