+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const reportedUsageFor = async (roundUsages: Array<UsageMetadata | undefined>): Promise<UsageMetadata | undefined> => {
+  let roundIndex = 0;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const currentRound = roundIndex++;
+      const usage = roundUsages[currentRound];
+      if (currentRound < roundUsages.length - 1) {
+        yield {type: 'tool_use', toolCall: {id: `call-${currentRound}`, name: 'lookup', input: {}}};
+        yield {type: 'stop', stopReason: 'tool_use', usage};
+        return;
+      }
+      yield {type: 'text', text: 'done'};
+      yield {type: 'stop', stopReason: 'end_turn', usage};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'Looks up an entry.', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found',
+  }));
+
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _responseText, usage) => {
+      reported = usage;
+    },
+  };
+
+  const session: ChatSession = {
+    sessionId: 's-usage',
+    userId: 'u-usage',
+    entries: [{role: 'user', content: 'question', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Usage test.'}), registry, {
+    hooks,
+  });
+  await orchestrator.processMessage(session);
+  return reported;
+};
+
+describe('ChatOrchestrator multi-round usage reporting', () => {
+  it('reports usage summed across every provider call when a turn runs through two tool rounds', async () => {
+    const usage = await reportedUsageFor([
+      {inputTokens: 10, outputTokens: 4, totalTokens: 14},
+      {inputTokens: 25, outputTokens: 8, totalTokens: 33},
+      {inputTokens: 40, outputTokens: 12, totalTokens: 52},
+    ]);
+
+    expect(usage).toEqual({inputTokens: 75, outputTokens: 24, totalTokens: 99});
+  });
+
+  it('counts the rounds that reported usage when some omit it, and reports undefined when none did', async () => {
+    const someReported = await reportedUsageFor([
+      {inputTokens: 12, outputTokens: 5, totalTokens: 17},
+      undefined,
+      {inputTokens: 20, outputTokens: 7, totalTokens: 27},
+    ]);
+    const noneReported = await reportedUsageFor([undefined, undefined]);
+
+    expect({someReported, noneReported}).toEqual({
+      someReported: {inputTokens: 32, outputTokens: 12, totalTokens: 44},
+      noneReported: undefined,
+    });
+  });
+});
