+// spec: specs/hal-engine-config-hooks/spec.md
+
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function session(content: string): ChatSession {
+  return {sessionId: 's1', userId: 'u1', entries: [{role: 'user', content, timestamp: SENT_AT}]};
+}
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const toolRegistry = (): ToolRegistry => {
+  const r = new ToolRegistry();
+  r.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+    result: 'ok',
+  }));
+  return r;
+};
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'c1', name: 'lookup', input: {}}};
+const promptBuilder = new PromptBuilder({identity: 'test'});
+
+describe('afterModelResponse usage accumulation', () => {
+  it('afterModelResponse receives summed usage across all tool rounds, not only the last round', async () => {
+    // Round 1 (tool call): 10 input, 5 output = 15 total
+    // Round 2 (final answer): 20 input, 8 output = 28 total
+    // Expected total: 30 input, 13 output, 43 total
+    // Current behaviour: hook receives round 2 only — {20, 8, 28} — which under-counts round 1.
+    const usageRound1: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const usageRound2: UsageMetadata = {inputTokens: 20, outputTokens: 8, totalTokens: 28};
+    let received: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        received = usage;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usageRound1}],
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn', usage: usageRound2},
+        ],
+      ]),
+      promptBuilder,
+      toolRegistry(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(session('ask'));
+
+    expect(received).toEqual<UsageMetadata>({
+      inputTokens: 30,
+      outputTokens: 13,
+      totalTokens: 43,
+    });
+  });
+});