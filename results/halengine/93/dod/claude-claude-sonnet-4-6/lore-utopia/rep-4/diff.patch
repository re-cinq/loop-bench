+// spec: specs/hal-engine-config-hooks/spec.md
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const promptBuilder = new PromptBuilder({identity: 'Usage test.'});
+
+const session: ChatSession = {
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'go', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+function registryWithLookup(): ToolRegistry {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Look up something.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  return registry;
+}
+
+// Emits one round per call: rounds 0..(n-2) ask for the 'lookup' tool, round n-1 finishes.
+function scriptedProvider(usagePerRound: (UsageMetadata | undefined)[]): AIProvider {
+  let call = 0;
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const round = call++;
+      const usage = usagePerRound[round];
+      const isLast = round === usagePerRound.length - 1;
+      if (isLast) {
+        yield {type: 'text', text: 'Done.'};
+        yield {type: 'stop', stopReason: 'end_turn', usage};
+      } else {
+        yield {type: 'tool_use', toolCall: {id: `c${round}`, name: 'lookup', input: {}}};
+        yield {type: 'stop', stopReason: 'tool_use', usage};
+      }
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+describe('afterModelResponse usage across all tool rounds', () => {
+  it('sums usage over two tool rounds so a deployer sees the full turn cost', async () => {
+    // spec: specs/hal-engine-config-hooks/spec.md#accumulated-usage
+    const round0: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const round1: UsageMetadata = {inputTokens: 20, outputTokens: 8, totalTokens: 28};
+    const round2: UsageMetadata = {inputTokens: 15, outputTokens: 6, totalTokens: 21};
+
+    let receivedUsage: UsageMetadata | undefined;
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([round0, round1, round2]),
+      promptBuilder,
+      registryWithLookup(),
+      {
+        maxToolRounds: 2,
+        hooks: {
+          afterModelResponse: async (_session, _text, usage) => {
+            receivedUsage = usage;
+          },
+        },
+      }
+    );
+
+    await orchestrator.processMessage(session);
+
+    expect(receivedUsage).toEqual({
+      inputTokens: round0.inputTokens + round1.inputTokens + round2.inputTokens,
+      outputTokens: round0.outputTokens + round1.outputTokens + round2.outputTokens,
+      totalTokens: round0.totalTokens + round1.totalTokens + round2.totalTokens,
+    });
+  });
+
+  it('counts rounds that reported when an intermediate round reports no usage', async () => {
+    // spec: specs/hal-engine-config-hooks/spec.md#accumulated-usage
+    const round0: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const round1: UsageMetadata | undefined = undefined;
+    const round2: UsageMetadata = {inputTokens: 20, outputTokens: 8, totalTokens: 28};
+
+    let receivedUsage: UsageMetadata | undefined;
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([round0, round1, round2]),
+      promptBuilder,
+      registryWithLookup(),
+      {
+        maxToolRounds: 2,
+        hooks: {
+          afterModelResponse: async (_session, _text, usage) => {
+            receivedUsage = usage;
+          },
+        },
+      }
+    );
+
+    await orchestrator.processMessage(session);
+
+    expect(receivedUsage).toEqual({
+      inputTokens: round0.inputTokens + round2.inputTokens,
+      outputTokens: round0.outputTokens + round2.outputTokens,
+      totalTokens: round0.totalTokens + round2.totalTokens,
+    });
+  });
+});