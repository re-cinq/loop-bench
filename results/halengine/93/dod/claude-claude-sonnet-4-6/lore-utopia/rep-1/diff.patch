+// Acceptance tests for re-cinq/HALEngine#93: afterModelResponse must receive
+// usage that covers every provider call in the turn, not just the last round.
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryReturning = (result: string): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => result
+  );
+  return registry;
+};
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+const STOP_FOR_TOOL: MessageChunk = {type: 'stop', stopReason: 'tool_use'};
+const STOP_DONE: MessageChunk = {type: 'stop', stopReason: 'end_turn'};
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+// spec: specs/hal-engine-config-hooks/spec.md
+describe('afterModelResponse usage — across all rounds (HALEngine#93)', () => {
+  it('reports the sum of every round when two tool rounds each return known token counts', async () => {
+    // Round 1 (tool): 10 in + 5 out = 15 total. Round 2 (final): 20 in + 8 out = 28 total.
+    // Expected sum: 30 in + 13 out = 43 total.
+    const usageRound1: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const usageRound2: UsageMetadata = {inputTokens: 20, outputTokens: 8, totalTokens: 28};
+
+    let receivedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const provider = scriptedProvider([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usageRound1}],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn', usage: usageRound2},
+      ],
+    ]);
+
+    await createChatOrchestrator(provider, promptBuilder, registryReturning('found'), {hooks}).processMessage(
+      createSession('ask')
+    );
+
+    expect(receivedUsage).toEqual({inputTokens: 30, outputTokens: 13, totalTokens: 43});
+  });
+
+  it('accumulates only the rounds that reported usage when some rounds report none', async () => {
+    // Round 1 reports usage; round 2 (tool) reports none; round 3 (final) reports usage.
+    // Expected: sum of round 1 + round 3 (round 2 is skipped, no NaN).
+    const usageRound1: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const usageRound3: UsageMetadata = {inputTokens: 20, outputTokens: 8, totalTokens: 28};
+
+    let receivedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const provider = scriptedProvider([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usageRound1}],
+      [TOOL_CALL, STOP_FOR_TOOL],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn', usage: usageRound3},
+      ],
+    ]);
+
+    await createChatOrchestrator(provider, promptBuilder, registryReturning('found'), {hooks}).processMessage(
+      createSession('ask')
+    );
+
+    expect(receivedUsage).toEqual({inputTokens: 30, outputTokens: 13, totalTokens: 43});
+  });
+});