+
+export function accumulateUsage(
+  accumulator: UsageMetadata | undefined,
+  incoming: UsageMetadata | undefined
+): UsageMetadata | undefined {
+  if (!accumulator) return incoming;
+  if (!incoming) return accumulator;
+  return {
+    inputTokens: accumulator.inputTokens + incoming.inputTokens,
+    outputTokens: accumulator.outputTokens + incoming.outputTokens,
+    totalTokens: accumulator.totalTokens + incoming.totalTokens,
+  };
+}
