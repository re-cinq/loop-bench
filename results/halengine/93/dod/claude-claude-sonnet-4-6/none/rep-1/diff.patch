@@ -24,3 +24,24 @@ describe('shouldContinueToolLoop', () => {
     expect(shouldContinueToolLoop('end_turn', A_TOOL, REGISTRY)).toBe(false);
   });
 });
+
+describe('accumulateUsage', () => {
+  const U1: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+  const U2: UsageMetadata = {inputTokens: 20, outputTokens: 8, totalTokens: 28};
+
+  it('sums all fields when both values are defined', () => {
+    expect(accumulateUsage(U1, U2)).toEqual({inputTokens: 30, outputTokens: 13, totalTokens: 43});
+  });
+
+  it('returns the incoming value when the accumulator is undefined', () => {
+    expect(accumulateUsage(undefined, U2)).toEqual(U2);
+  });
+
+  it('keeps the accumulated value when the incoming round reported nothing', () => {
+    expect(accumulateUsage(U1, undefined)).toEqual(U1);
+  });
+
+  it('returns undefined when neither side has reported usage', () => {
+    expect(accumulateUsage(undefined, undefined)).toBeUndefined();
+  });
+});
diff --git a/src/orchestration/orchestratorHelpers.ts b/src/orchestration/orchestratorHelpers.ts
index 717eb9a..78e38f6 100644
--- a/src/orchestration/orchestratorHelpers.ts
+++ b/src/orchestration/orchestratorHelpers.ts
@@ -40,3 +40,16 @@ export function extractStopReason(chunk: MessageChunk): string | null {
 export function extractUsage(chunk: MessageChunk): UsageMetadata | undefined {
   return chunk.type === 'stop' ? chunk.usage : undefined;
 }
+
+export function accumulateUsage(
+  acc: UsageMetadata | undefined,
+  incoming: UsageMetadata | undefined
+): UsageMetadata | undefined {
+  if (!acc) return incoming;
+  if (!incoming) return acc;
+  return {
+    inputTokens: acc.inputTokens + incoming.inputTokens,
+    outputTokens: acc.outputTokens + incoming.outputTokens,
+    totalTokens: acc.totalTokens + incoming.totalTokens,
+  };
+}