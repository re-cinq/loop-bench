@@ -0,0 +1,79 @@
+// specs/hal-engine-config-hooks/spec.md
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import {scriptedProvider} from './chatOrchestratorTestHelpers.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const registryWith = (result: string): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => result
+  );
+  return registry;
+};
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {}}};
+
+async function runAndCapture(rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> {
+  const capture = makeCapture();
+  const orchestrator = createChatOrchestrator(scriptedProvider(rounds), promptBuilder, registryWith('result'), {
+    hooks: capture.hooks,
+  });
+  await orchestrator.processMessage(createSession('ask'));
+  return capture.get();
+}
+
+function makeCapture() {
+  let seenUsage: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      seenUsage = usage;
+    },
+  };
+  return {hooks, get: () => seenUsage};
+}
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports the sum of usage across two tool rounds, not only the last', async () => {
+    const usageR1: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const usageR2: UsageMetadata = {inputTokens: 20, outputTokens: 8, totalTokens: 28};
+    const usage = await runAndCapture([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usageR1}],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn', usage: usageR2},
+      ],
+    ]);
+    expect(usage).toEqual({inputTokens: 30, outputTokens: 13, totalTokens: 43});
+  });
+
+  it('sums only the rounds that reported usage, treating absent rounds as zero contribution', async () => {
+    const usageR1: UsageMetadata = {inputTokens: 100, outputTokens: 50, totalTokens: 150};
+    const usageR3: UsageMetadata = {inputTokens: 20, outputTokens: 8, totalTokens: 28};
+    const usage = await runAndCapture([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usageR1}],
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn', usage: usageR3},
+      ],
+    ]);
+    expect(usage).toEqual({inputTokens: 120, outputTokens: 58, totalTokens: 178});
+  });
+});
