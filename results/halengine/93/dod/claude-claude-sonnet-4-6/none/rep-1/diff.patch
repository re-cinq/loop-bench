@@ -0,0 +1,70 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import {scriptedProvider} from './orchestratorTestSupport.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const createLookupRegistry = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  return registry;
+};
+
+const round1Usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+const laterRoundUsage: UsageMetadata = {inputTokens: 20, outputTokens: 8, totalTokens: 28};
+const firstToolRound: MessageChunk[] = [
+  {type: 'tool_use', toolCall: {id: 'c1', name: 'lookup', input: {}}},
+  {type: 'stop', stopReason: 'tool_use', usage: round1Usage},
+];
+const finalTextRound: MessageChunk[] = [
+  {type: 'text', text: 'done'},
+  {type: 'stop', stopReason: 'end_turn', usage: laterRoundUsage},
+];
+const expectedSummedUsage: UsageMetadata = {inputTokens: 30, outputTokens: 13, totalTokens: 43};
+
+async function runScriptedOrchestrator(rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> {
+  let reportedUsage: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reportedUsage = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(scriptedProvider(rounds), promptBuilder, createLookupRegistry(), {hooks});
+  await orchestrator.processMessage(createSession('ask'));
+  return reportedUsage;
+}
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+describe('afterModelResponse usage accumulation', () => {
+  it('reports summed usage across all provider rounds when tools are called', async () => {
+    const reportedUsage = await runScriptedOrchestrator([firstToolRound, finalTextRound]);
+
+    expect(reportedUsage).toEqual(expectedSummedUsage);
+  });
+
+  it('skips rounds with no usage and does not produce undefined or NaN in the total', async () => {
+    const noUsageRound: MessageChunk[] = [
+      {type: 'tool_use', toolCall: {id: 'c2', name: 'lookup', input: {}}},
+      {type: 'stop', stopReason: 'tool_use'},
+    ];
+    const reportedUsage = await runScriptedOrchestrator([firstToolRound, noUsageRound, finalTextRound]);
+
+    expect(reportedUsage).toEqual(expectedSummedUsage);
+  });
+});
