+// specs/hal-engine-config-hooks/spec.md (statement on afterModelResponse usage will be updated by the implementation round)
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryWith = (result: string): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => result
+  );
+  return registry;
+};
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {}}};
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports the sum of usage across two tool rounds, not only the last', async () => {
+    const usageR1: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const usageR2: UsageMetadata = {inputTokens: 20, outputTokens: 8, totalTokens: 28};
+    let seenUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        seenUsage = usage;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usageR1}],
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn', usage: usageR2},
+        ],
+      ]),
+      promptBuilder,
+      registryWith('result'),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(seenUsage).toEqual({inputTokens: 30, outputTokens: 13, totalTokens: 43});
+  });
+
+  it('sums only the rounds that reported usage, treating absent rounds as zero contribution', async () => {
+    const usageR1: UsageMetadata = {inputTokens: 100, outputTokens: 50, totalTokens: 150};
+    const usageR3: UsageMetadata = {inputTokens: 20, outputTokens: 8, totalTokens: 28};
+    let seenUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        seenUsage = usage;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usageR1}],
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn', usage: usageR3},
+        ],
+      ]),
+      promptBuilder,
+      registryWith('result'),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(seenUsage).toEqual({inputTokens: 120, outputTokens: 58, totalTokens: 178});
+  });
+});