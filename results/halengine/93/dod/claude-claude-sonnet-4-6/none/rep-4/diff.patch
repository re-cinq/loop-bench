+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryWithTool = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found',
+  }));
+  return registry;
+};
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {}}};
+
+describe('afterModelResponse usage accumulation', () => {
+  it('reports the sum of usage across all tool rounds, not just the last', async () => {
+    const round1Usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const round2Usage: UsageMetadata = {inputTokens: 20, outputTokens: 8, totalTokens: 28};
+
+    const provider = scriptedProvider([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: round1Usage}],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn', usage: round2Usage},
+      ],
+    ]);
+
+    let capturedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        capturedUsage = usage;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registryWithTool(), {hooks});
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(capturedUsage).toEqual({inputTokens: 30, outputTokens: 13, totalTokens: 43});
+  });
+
+  it('counts only the rounds that reported usage when some rounds have none', async () => {
+    const round1Usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const round3Usage: UsageMetadata = {inputTokens: 20, outputTokens: 8, totalTokens: 28};
+
+    const provider = scriptedProvider([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: round1Usage}],
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn', usage: round3Usage},
+      ],
+    ]);
+
+    let capturedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        capturedUsage = usage;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registryWithTool(), {hooks, maxToolRounds: 5});
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(capturedUsage).toEqual({inputTokens: 30, outputTokens: 13, totalTokens: 43});
+  });
+});