+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ChatSession} from '../types/session.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function makeSession(): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'ask', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+}
+
+function scripted(rounds: MessageChunk[][]): AIProvider {
+  let round = 0;
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+function registryWithLookup(): ToolRegistry {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found',
+  }));
+  return registry;
+}
+
+const CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'tc-1', name: 'lookup', input: {}}};
+
+function stop(reason: string, usage?: UsageMetadata): MessageChunk {
+  return {type: 'stop', stopReason: reason, usage};
+}
+
+describe('afterModelResponse usage accumulation', () => {
+  it('reports summed usage across all provider rounds to afterModelResponse', async () => {
+    const r1: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const r2: UsageMetadata = {inputTokens: 20, outputTokens: 8, totalTokens: 28};
+    let received: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_s, _t, u) => {
+        received = u;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scripted([
+        [CALL, stop('tool_use', r1)],
+        [{type: 'text', text: 'done'}, stop('end_turn', r2)],
+      ]),
+      promptBuilder,
+      registryWithLookup(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(makeSession());
+
+    expect(received).toEqual({inputTokens: 30, outputTokens: 13, totalTokens: 43});
+  });
+
+  it('counts only rounds that reported usage, skipping rounds that did not', async () => {
+    const r1: UsageMetadata = {inputTokens: 5, outputTokens: 2, totalTokens: 7};
+    const r3: UsageMetadata = {inputTokens: 10, outputTokens: 4, totalTokens: 14};
+    let received: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_s, _t, u) => {
+        received = u;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scripted([
+        [CALL, stop('tool_use', r1)],
+        [CALL, stop('tool_use')],
+        [{type: 'text', text: 'done'}, stop('end_turn', r3)],
+      ]),
+      promptBuilder,
+      registryWithLookup(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(makeSession());
+
+    expect(received).toEqual({inputTokens: 15, outputTokens: 6, totalTokens: 21});
+  });
+});