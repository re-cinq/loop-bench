+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+// Spec: specs/hal-engine-config-hooks/spec.md#8
+it('reports summed usage for every provider call while preserving missing usage and direct answers', async () => {
+  const first = {inputTokens: 11, outputTokens: 3, totalTokens: 14};
+  const second = {inputTokens: 23, outputTokens: 5, totalTokens: 28};
+  const last = {inputTokens: 37, outputTokens: 7, totalTokens: 44};
+  const scenarios: {name: string; rounds: (UsageMetadata | undefined)[]; expected?: UsageMetadata}[] = [
+    {
+      name: 'two tool rounds',
+      rounds: [first, second, last],
+      expected: {inputTokens: 71, outputTokens: 15, totalTokens: 86},
+    },
+    {
+      name: 'missing middle',
+      rounds: [first, undefined, last],
+      expected: {inputTokens: 48, outputTokens: 10, totalTokens: 58},
+    },
+    {
+      name: 'missing first',
+      rounds: [undefined, second, last],
+      expected: {inputTokens: 60, outputTokens: 12, totalTokens: 72},
+    },
+    {
+      name: 'missing last',
+      rounds: [first, second, undefined],
+      expected: {inputTokens: 34, outputTokens: 8, totalTokens: 42},
+    },
+    {name: 'nothing reported', rounds: [undefined, undefined, undefined]},
+    {name: 'direct answer', rounds: [first], expected: first},
+  ];
+  const observed = [];
+  for (const scenario of scenarios) {
+    let providerCalls = 0;
+    let toolCalls = 0;
+    const received: (UsageMetadata | undefined)[] = [];
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        const round = providerCalls++;
+        if (round >= scenario.rounds.length) throw new Error('Unexpected provider call');
+        const needsTool = round < scenario.rounds.length - 1;
+        if (needsTool) {
+          yield {type: 'tool_use', toolCall: {id: `call-${round}`, name: 'lookup', input: {}}};
+        } else {
+          yield {type: 'text', text: 'done'};
+        }
+        yield {type: 'stop', stopReason: needsTool ? 'tool_use' : 'end_turn', usage: scenario.rounds[round]};
+      },
+      async generateStructured<T>(): Promise<T> {
+        throw new Error('Structured generation is not part of this turn');
+      },
+    };
+    const registry = new ToolRegistry();
+    registry.register({name: 'lookup', description: 'Look up a value', inputSchema: {type: 'object'}}, async () => {
+      toolCalls++;
+      return {result: 'found'};
+    });
+    const orchestrator = createChatOrchestrator(
+      provider,
+      new PromptBuilder({identity: 'Answer the question.'}),
+      registry,
+      {
+        hooks: {
+          afterModelResponse: async (_session, _text, usage) => {
+            received.push(usage);
+          },
+        },
+      }
+    );
+    const text = await orchestrator.processMessage({
+      sessionId: 'usage-session',
+      userId: 'usage-user',
+      entries: [{role: 'user', content: 'Look it up twice', timestamp: '2026-01-01T00:00:00.000Z'}],
+    });
+    observed.push({name: scenario.name, providerCalls, toolCalls, text, received});
+  }
+
+  expect(observed).toEqual(
+    scenarios.map(scenario => ({
+      name: scenario.name,
+      providerCalls: scenario.rounds.length,
+      toolCalls: scenario.rounds.length - 1,
+      text: 'done',
+      received: [scenario.expected],
+    }))
+  );
+});