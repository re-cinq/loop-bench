+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const first = {inputTokens: 11, outputTokens: 2, totalTokens: 13};
+const second = {inputTokens: 23, outputTokens: 5, totalTokens: 28};
+const last = {inputTokens: 37, outputTokens: 7, totalTokens: 44};
+
+async function observeTurn(rounds: (UsageMetadata | undefined)[]) {
+  let providerCalls = 0;
+  let toolCalls = 0;
+  const reports: (UsageMetadata | undefined)[] = [];
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const round = providerCalls++;
+      if (round >= rounds.length) throw new Error('Unexpected provider call');
+      const more = round < rounds.length - 1;
+      if (more) {
+        yield {type: 'tool_use', toolCall: {id: `call-${round}`, name: 'add', input: {value: round}}};
+      } else {
+        yield {type: 'text', text: 'done'};
+      }
+      yield {type: 'stop', stopReason: more ? 'tool_use' : 'end_turn', usage: rounds[round]};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured generation is not part of this turn');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'add', description: 'Add one', inputSchema: {type: 'object', properties: {value: {type: 'number'}}}},
+    async input => {
+      toolCalls++;
+      return String(Number(input.value) + 1);
+    }
+  );
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Calculate.'}), registry, {
+    hooks: {
+      afterModelResponse: async (_session, _text, usage) => {
+        reports.push(usage);
+      },
+    },
+  });
+  const text = await orchestrator.processMessage({
+    sessionId: 'usage-turn',
+    userId: 'usage-user',
+    entries: [{role: 'user', content: 'Calculate twice.', timestamp: '2026-01-01T00:00:00.000Z'}],
+  });
+  return {providerCalls, toolCalls, reports, text};
+}
+
+// spec: specs/hal-engine-config-hooks/spec.md#10
+it('reports the sum of every provider call once per turn, counting only rounds with usage', async () => {
+  const scenarios = [
+    [first, second, last],
+    [first, undefined, last],
+    [undefined, second, last],
+    [first, second, undefined],
+    [undefined, undefined, undefined],
+    [first],
+    [undefined],
+  ];
+  const observed = [];
+  for (const rounds of scenarios) observed.push(await observeTurn(rounds));
+
+  expect(observed).toEqual([
+    {providerCalls: 3, toolCalls: 2, reports: [{inputTokens: 71, outputTokens: 14, totalTokens: 85}], text: 'done'},
+    {providerCalls: 3, toolCalls: 2, reports: [{inputTokens: 48, outputTokens: 9, totalTokens: 57}], text: 'done'},
+    {providerCalls: 3, toolCalls: 2, reports: [{inputTokens: 60, outputTokens: 12, totalTokens: 72}], text: 'done'},
+    {providerCalls: 3, toolCalls: 2, reports: [{inputTokens: 34, outputTokens: 7, totalTokens: 41}], text: 'done'},
+    {providerCalls: 3, toolCalls: 2, reports: [undefined], text: 'done'},
+    {providerCalls: 1, toolCalls: 0, reports: [first], text: 'done'},
+    {providerCalls: 1, toolCalls: 0, reports: [undefined], text: 'done'},
+  ]);
+});