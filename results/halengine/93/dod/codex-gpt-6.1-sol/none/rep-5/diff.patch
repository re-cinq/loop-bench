+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+// spec: specs/hal-engine-config-hooks/spec.md#10
+it('reports turn usage across every provider call, preserving absent usage and direct answers', async () => {
+  const first = {inputTokens: 11, outputTokens: 3, totalTokens: 14};
+  const second = {inputTokens: 23, outputTokens: 5, totalTokens: 28};
+  const final = {inputTokens: 37, outputTokens: 7, totalTokens: 44};
+  const scripts: (UsageMetadata | undefined)[][] = [
+    [first, second, final],
+    [first, undefined, final],
+    [first, second, undefined],
+    [undefined, undefined, undefined],
+    [final],
+    [undefined],
+  ];
+  const observations = [];
+
+  for (const usages of scripts) {
+    let providerCalls = 0;
+    let toolCalls = 0;
+    const received: (UsageMetadata | undefined)[] = [];
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        const round = providerCalls++;
+        if (round >= usages.length) throw new Error('Unexpected provider call');
+        if (round < usages.length - 1) {
+          yield {type: 'tool_use', toolCall: {id: `call-${round}`, name: 'add', input: {left: round, right: 1}}};
+          yield {type: 'stop', stopReason: 'tool_use', usage: usages[round]};
+        } else {
+          yield {type: 'text', text: 'done'};
+          yield {type: 'stop', stopReason: 'end_turn', usage: usages[round]};
+        }
+      },
+      async generateStructured<T>(): Promise<T> {
+        throw new Error('Structured generation is not part of this turn');
+      },
+    };
+    const tools = new ToolRegistry();
+    tools.register(
+      {
+        name: 'add',
+        description: 'Add two numbers',
+        inputSchema: {
+          type: 'object',
+          properties: {left: {type: 'number'}, right: {type: 'number'}},
+          required: ['left', 'right'],
+        },
+      },
+      async input => {
+        toolCalls++;
+        return String(Number(input.left) + Number(input.right));
+      }
+    );
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Calculate.'}), tools, {
+      hooks: {
+        afterModelResponse: async (_session, _text, usage) => {
+          received.push(usage);
+        },
+      },
+    });
+    const text = await orchestrator.processMessage({
+      sessionId: 'usage-turn',
+      userId: 'customer',
+      entries: [{role: 'user', content: 'Calculate twice.', timestamp: '2026-01-01T00:00:00.000Z'}],
+    });
+    observations.push({providerCalls, toolCalls, text, received});
+  }
+
+  expect(observations).toEqual([
+    {providerCalls: 3, toolCalls: 2, text: 'done', received: [{inputTokens: 71, outputTokens: 15, totalTokens: 86}]},
+    {providerCalls: 3, toolCalls: 2, text: 'done', received: [{inputTokens: 48, outputTokens: 10, totalTokens: 58}]},
+    {providerCalls: 3, toolCalls: 2, text: 'done', received: [{inputTokens: 34, outputTokens: 8, totalTokens: 42}]},
+    {providerCalls: 3, toolCalls: 2, text: 'done', received: [undefined]},
+    {providerCalls: 1, toolCalls: 0, text: 'done', received: [final]},
+    {providerCalls: 1, toolCalls: 0, text: 'done', received: [undefined]},
+  ]);
+});