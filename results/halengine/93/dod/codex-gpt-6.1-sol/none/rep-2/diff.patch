+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const first: UsageMetadata = {inputTokens: 11, outputTokens: 2, totalTokens: 13};
+const second: UsageMetadata = {inputTokens: 23, outputTokens: 5, totalTokens: 28};
+const third: UsageMetadata = {inputTokens: 37, outputTokens: 7, totalTokens: 44};
+
+async function reportTurn(rounds: (UsageMetadata | undefined)[]) {
+  let providerCalls = 0;
+  let toolCalls = 0;
+  const reports: (UsageMetadata | undefined)[] = [];
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const round = providerCalls++;
+      if (round >= rounds.length) throw new Error('Unexpected provider call');
+      if (round < rounds.length - 1) {
+        yield {type: 'tool_use', toolCall: {id: `call-${round}`, name: 'count', input: {}}};
+        yield {type: 'stop', stopReason: 'tool_use', usage: rounds[round]};
+      } else {
+        yield {type: 'text', text: 'done'};
+        yield {type: 'stop', stopReason: 'end_turn', usage: rounds[round]};
+      }
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured output is not supported by this scripted provider');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'count', description: 'Count executed tool calls', inputSchema: {type: 'object'}},
+    async () => {
+      toolCalls++;
+      return String(toolCalls);
+    }
+  );
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reports.push(usage);
+    },
+  };
+  const orchestrator = createChatOrchestrator(
+    provider,
+    new PromptBuilder({identity: 'Answer the question.'}),
+    registry,
+    {
+      hooks,
+    }
+  );
+  const text = await orchestrator.processMessage({
+    sessionId: 'usage-turn',
+    userId: 'usage-user',
+    entries: [{role: 'user', content: 'Count twice then answer.', timestamp: '2026-01-01T00:00:00.000Z'}],
+  });
+  return {text, providerCalls, toolCalls, reports};
+}
+
+// Spec: specs/hal-engine-config-hooks/spec.md#9
+it('reports the sum of every provider call once per turn, preserving missing usage and the direct-answer path', async () => {
+  const scenarios = [
+    {
+      name: 'two tool rounds',
+      rounds: [first, second, third],
+      total: {inputTokens: 71, outputTokens: 14, totalTokens: 85},
+    },
+    {
+      name: 'missing first',
+      rounds: [undefined, second, third],
+      total: {inputTokens: 60, outputTokens: 12, totalTokens: 72},
+    },
+    {
+      name: 'missing middle',
+      rounds: [first, undefined, third],
+      total: {inputTokens: 48, outputTokens: 9, totalTokens: 57},
+    },
+    {
+      name: 'missing last',
+      rounds: [first, second, undefined],
+      total: {inputTokens: 34, outputTokens: 7, totalTokens: 41},
+    },
+    {name: 'no usage', rounds: [undefined, undefined, undefined], total: undefined},
+    {
+      name: 'zero usage',
+      rounds: [{inputTokens: 0, outputTokens: 0, totalTokens: 0}],
+      total: {inputTokens: 0, outputTokens: 0, totalTokens: 0},
+    },
+    {name: 'direct answer', rounds: [first], total: first},
+    {name: 'direct answer without usage', rounds: [undefined], total: undefined},
+  ];
+  const actual = [];
+  for (const scenario of scenarios) {
+    actual.push({name: scenario.name, ...(await reportTurn(scenario.rounds))});
+  }
+
+  expect(actual).toEqual(
+    scenarios.map(({name, rounds, total}) => ({
+      name,
+      text: 'done',
+      providerCalls: rounds.length,
+      toolCalls: rounds.length - 1,
+      reports: [total],
+    }))
+  );
+});