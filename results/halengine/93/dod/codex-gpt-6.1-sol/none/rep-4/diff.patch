+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const first: UsageMetadata = {inputTokens: 11, outputTokens: 3, totalTokens: 14};
+const second: UsageMetadata = {inputTokens: 23, outputTokens: 5, totalTokens: 28};
+const final: UsageMetadata = {inputTokens: 37, outputTokens: 7, totalTokens: 44};
+
+async function runTurn(usages: (UsageMetadata | undefined)[]) {
+  let providerCalls = 0;
+  let toolExecutions = 0;
+  const reports: (UsageMetadata | undefined)[] = [];
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const round = providerCalls++;
+      if (round >= usages.length) throw new Error('Unexpected provider call');
+      if (round < usages.length - 1) {
+        yield {type: 'tool_use', toolCall: {id: `call-${round}`, name: 'add', input: {left: round, right: 1}}};
+      } else {
+        yield {type: 'text', text: 'done'};
+      }
+      yield {type: 'stop', stopReason: round < usages.length - 1 ? 'tool_use' : 'end_turn', usage: usages[round]};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured output is not part of this turn');
+    },
+  };
+  const tools = new ToolRegistry();
+  tools.register(
+    {
+      name: 'add',
+      description: 'Add two numbers',
+      inputSchema: {
+        type: 'object',
+        properties: {left: {type: 'number'}, right: {type: 'number'}},
+        required: ['left', 'right'],
+      },
+    },
+    async input => {
+      toolExecutions++;
+      return String(Number(input.left) + Number(input.right));
+    }
+  );
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reports.push(usage);
+    },
+  };
+  const response = await createChatOrchestrator(provider, new PromptBuilder({identity: 'Answer using tools.'}), tools, {
+    hooks,
+  }).processMessage({
+    sessionId: 'usage-turn',
+    userId: 'customer',
+    entries: [{role: 'user', content: 'Calculate the answer', timestamp: '2026-01-01T00:00:00.000Z'}],
+  });
+  return {providerCalls, toolExecutions, response, reports};
+}
+
+// spec: specs/hal-engine-config-hooks/spec.md#9
+it('reports whole-turn usage across two tool rounds, preserving missing usage and the direct-answer path', async () => {
+  const actual = [];
+  for (const usages of [
+    [first, second, final],
+    [first, undefined, final],
+    [undefined, second, final],
+    [first, second, undefined],
+    [undefined, undefined, undefined],
+    [first],
+    [undefined],
+  ]) {
+    actual.push(await runTurn(usages));
+  }
+
+  expect(actual).toEqual([
+    {
+      providerCalls: 3,
+      toolExecutions: 2,
+      response: 'done',
+      reports: [{inputTokens: 71, outputTokens: 15, totalTokens: 86}],
+    },
+    {
+      providerCalls: 3,
+      toolExecutions: 2,
+      response: 'done',
+      reports: [{inputTokens: 48, outputTokens: 10, totalTokens: 58}],
+    },
+    {
+      providerCalls: 3,
+      toolExecutions: 2,
+      response: 'done',
+      reports: [{inputTokens: 60, outputTokens: 12, totalTokens: 72}],
+    },
+    {
+      providerCalls: 3,
+      toolExecutions: 2,
+      response: 'done',
+      reports: [{inputTokens: 34, outputTokens: 8, totalTokens: 42}],
+    },
+    {providerCalls: 3, toolExecutions: 2, response: 'done', reports: [undefined]},
+    {providerCalls: 1, toolExecutions: 0, response: 'done', reports: [first]},
+    {providerCalls: 1, toolExecutions: 0, response: 'done', reports: [undefined]},
+  ]);
+});