+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const first: UsageMetadata = {inputTokens: 11, outputTokens: 2, totalTokens: 13};
+const middle: UsageMetadata = {inputTokens: 23, outputTokens: 5, totalTokens: 28};
+const last: UsageMetadata = {inputTokens: 37, outputTokens: 7, totalTokens: 44};
+
+async function reportFor(rounds: (UsageMetadata | undefined)[]) {
+  let providerCalls = 0;
+  let toolCalls = 0;
+  const reports: (UsageMetadata | undefined)[] = [];
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const index = providerCalls++;
+      if (index >= rounds.length) throw new Error('Unexpected provider call');
+      const needsTool = index < rounds.length - 1;
+      if (needsTool) {
+        yield {type: 'tool_use', toolCall: {id: `call-${index}`, name: 'lookup', input: {}}};
+      } else {
+        yield {type: 'text', text: 'done'};
+      }
+      yield {type: 'stop', stopReason: needsTool ? 'tool_use' : 'end_turn', usage: rounds[index]};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('This turn does not request structured output');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'Look up a value', inputSchema: {type: 'object'}}, async () => {
+    toolCalls++;
+    return {result: 'found'};
+  });
+  const orchestrator = createChatOrchestrator(
+    provider,
+    new PromptBuilder({identity: 'Answer the question.'}),
+    registry,
+    {
+      hooks: {
+        afterModelResponse: async (_session, _text, usage) => {
+          reports.push(usage);
+        },
+      },
+    }
+  );
+  const text = await orchestrator.processMessage({
+    sessionId: 'usage-session',
+    userId: 'usage-user',
+    entries: [{role: 'user', content: 'Look it up twice', timestamp: '2026-01-01T00:00:00.000Z'}],
+  });
+  return {text, providerCalls, toolCalls, reports};
+}
+
+// specs/hal-engine-config-hooks/spec.md#9
+it('reports summed usage for every provider call while preserving missing usage and direct turns', async () => {
+  const cases = [
+    {rounds: [first, middle, last], total: {inputTokens: 71, outputTokens: 14, totalTokens: 85}},
+    {rounds: [undefined, middle, last], total: {inputTokens: 60, outputTokens: 12, totalTokens: 72}},
+    {rounds: [first, undefined, last], total: {inputTokens: 48, outputTokens: 9, totalTokens: 57}},
+    {rounds: [first, middle, undefined], total: {inputTokens: 34, outputTokens: 7, totalTokens: 41}},
+    {rounds: [undefined, undefined, undefined], total: undefined},
+    {rounds: [last], total: last},
+    {rounds: [undefined], total: undefined},
+  ];
+
+  const actual = [];
+  for (const {rounds} of cases) actual.push(await reportFor(rounds));
+
+  expect(actual).toEqual(
+    cases.map(({rounds, total}) => ({
+      text: 'done',
+      providerCalls: rounds.length,
+      toolCalls: rounds.length - 1,
+      reports: [total],
+    }))
+  );
+});