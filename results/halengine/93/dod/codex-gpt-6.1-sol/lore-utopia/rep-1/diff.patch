@@ -0,0 +1,73 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const first: UsageMetadata = {inputTokens: 11, outputTokens: 3, totalTokens: 14};
+const second: UsageMetadata = {inputTokens: 23, outputTokens: 5, totalTokens: 28};
+const final: UsageMetadata = {inputTokens: 37, outputTokens: 7, totalTokens: 44};
+
+async function reportFor(rounds: (UsageMetadata | undefined)[]) {
+  let calls = 0;
+  let executions = 0;
+  const reports: (UsageMetadata | undefined)[] = [];
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const round = calls++;
+      if (round >= rounds.length) throw new Error('Unexpected provider call');
+      const needsTool = round < rounds.length - 1;
+      if (needsTool) {
+        yield {type: 'tool_use', toolCall: {id: `call-${round}`, name: 'add', input: {left: round, right: 1}}};
+      } else {
+        yield {type: 'text', text: 'done'};
+      }
+      yield {type: 'stop', stopReason: needsTool ? 'tool_use' : 'end_turn', usage: rounds[round]};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured output is not part of this turn');
+    },
+  };
+  const tools = new ToolRegistry();
+  tools.register({name: 'add', description: 'Add two numbers', inputSchema: {type: 'object'}}, async input => {
+    executions++;
+    return {result: String(Number(input.left) + Number(input.right))};
+  });
+  const session: ChatSession = {
+    sessionId: 'usage-turn',
+    userId: 'customer',
+    entries: [{role: 'user', content: 'Add the numbers', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Calculate'}), tools, {
+    hooks: {
+      afterModelResponse: async (_session, _text, usage) => {
+        reports.push(usage);
+      },
+    },
+  });
+  const response = await orchestrator.processMessage(session);
+  return {calls, executions, reports, response};
+}
+
+// spec: specs/hal-engine-config-hooks/spec.md#9
+it('reports the sum of every provider call once per turn, ignoring absent usage without inventing usage', async () => {
+  const observed = await Promise.all([
+    reportFor([first, second, final]),
+    reportFor([first, undefined, final]),
+    reportFor([undefined, first, final]),
+    reportFor([first, second, undefined]),
+    reportFor([undefined, undefined, undefined]),
+    reportFor([first]),
+    reportFor([undefined]),
+  ]);
+
+  expect(observed).toEqual([
+    {calls: 3, executions: 2, reports: [{inputTokens: 71, outputTokens: 15, totalTokens: 86}], response: 'done'},
+    {calls: 3, executions: 2, reports: [{inputTokens: 48, outputTokens: 10, totalTokens: 58}], response: 'done'},
+    {calls: 3, executions: 2, reports: [{inputTokens: 48, outputTokens: 10, totalTokens: 58}], response: 'done'},
+    {calls: 3, executions: 2, reports: [{inputTokens: 34, outputTokens: 8, totalTokens: 42}], response: 'done'},
+    {calls: 3, executions: 2, reports: [undefined], response: 'done'},
+    {calls: 1, executions: 0, reports: [first], response: 'done'},
+    {calls: 1, executions: 0, reports: [undefined], response: 'done'},
+  ]);
+});