+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const first: UsageMetadata = {inputTokens: 11, outputTokens: 2, totalTokens: 13};
+const second: UsageMetadata = {inputTokens: 23, outputTokens: 5, totalTokens: 28};
+const last: UsageMetadata = {inputTokens: 37, outputTokens: 7, totalTokens: 44};
+
+async function runTurn(rounds: (UsageMetadata | undefined)[]) {
+  let providerCalls = 0;
+  let toolExecutions = 0;
+  const reports: (UsageMetadata | undefined)[] = [];
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const index = providerCalls++;
+      if (index >= rounds.length) throw new Error('Unexpected extra provider call');
+      if (index < rounds.length - 1) {
+        yield {type: 'tool_use', toolCall: {id: `lookup-${index}`, name: 'lookup', input: {}}};
+      } else {
+        yield {type: 'text', text: 'done'};
+      }
+      yield {
+        type: 'stop',
+        stopReason: index < rounds.length - 1 ? 'tool_use' : 'end_turn',
+        usage: rounds[index],
+      };
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('This turn must use the streaming provider entry point');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'Look up a value', inputSchema: {type: 'object'}}, async () => {
+    toolExecutions++;
+    return {result: 'found'};
+  });
+  const orchestrator = createChatOrchestrator(
+    provider,
+    new PromptBuilder({identity: 'Answer the question.'}),
+    registry,
+    {
+      hooks: {
+        afterModelResponse: async (_session, _text, usage) => {
+          reports.push(usage);
+        },
+      },
+    }
+  );
+  const text = await orchestrator.processMessage({
+    sessionId: 'usage-turn',
+    userId: 'customer',
+    entries: [{role: 'user', content: 'Look it up twice', timestamp: '2026-01-01T00:00:00.000Z'}],
+  });
+  return {text, providerCalls, toolExecutions, reports};
+}
+
+// Spec: specs/hal-engine-config-hooks/spec.md#8 (Turn usage, issue #93).
+it('reports the sum of every provider call once per turn, counting only rounds that report usage', async () => {
+  const actual = [];
+  for (const rounds of [
+    [first, second, last],
+    [first, undefined, last],
+    [undefined, second, last],
+    [first, second, undefined],
+    [undefined, undefined, undefined],
+    [first],
+    [undefined],
+  ]) {
+    actual.push(await runTurn(rounds));
+  }
+
+  expect(actual).toEqual([
+    {
+      text: 'done',
+      providerCalls: 3,
+      toolExecutions: 2,
+      reports: [{inputTokens: 71, outputTokens: 14, totalTokens: 85}],
+    },
+    {text: 'done', providerCalls: 3, toolExecutions: 2, reports: [{inputTokens: 48, outputTokens: 9, totalTokens: 57}]},
+    {
+      text: 'done',
+      providerCalls: 3,
+      toolExecutions: 2,
+      reports: [{inputTokens: 60, outputTokens: 12, totalTokens: 72}],
+    },
+    {text: 'done', providerCalls: 3, toolExecutions: 2, reports: [{inputTokens: 34, outputTokens: 7, totalTokens: 41}]},
+    {text: 'done', providerCalls: 3, toolExecutions: 2, reports: [undefined]},
+    {text: 'done', providerCalls: 1, toolExecutions: 0, reports: [first]},
+    {text: 'done', providerCalls: 1, toolExecutions: 0, reports: [undefined]},
+  ]);
+});