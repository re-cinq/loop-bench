+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const first: UsageMetadata = {inputTokens: 11, outputTokens: 3, totalTokens: 14};
+const second: UsageMetadata = {inputTokens: 23, outputTokens: 5, totalTokens: 28};
+const third: UsageMetadata = {inputTokens: 37, outputTokens: 7, totalTokens: 44};
+
+// @spec specs/hal-engine-config-hooks/spec.md#8
+it('reports turn totals across two tool rounds while preserving missing-usage and direct-answer semantics', async () => {
+  const turns = [
+    {usage: [first, second, third], total: {inputTokens: 71, outputTokens: 15, totalTokens: 86}},
+    {usage: [first, undefined, third], total: {inputTokens: 48, outputTokens: 10, totalTokens: 58}},
+    {usage: [first, second, undefined], total: {inputTokens: 34, outputTokens: 8, totalTokens: 42}},
+    {usage: [undefined, second, third], total: {inputTokens: 60, outputTokens: 12, totalTokens: 72}},
+    {usage: [undefined, undefined, undefined], total: undefined},
+    {usage: [first], total: first},
+    {usage: [undefined], total: undefined},
+  ];
+  const script = turns.flatMap(turn =>
+    turn.usage.map((usage, round) => ({
+      usage,
+      useTool: round < turn.usage.length - 1,
+    }))
+  );
+  let providerCalls = 0;
+  let toolExecutions = 0;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const round = script[providerCalls++];
+      if (!round) throw new Error('Provider called beyond the turn script');
+      if (round.useTool) {
+        yield {type: 'tool_use', toolCall: {id: `call-${providerCalls}`, name: 'add', input: {a: 2, b: 3}}};
+      } else {
+        yield {type: 'text', text: '5'};
+      }
+      yield {type: 'stop', stopReason: round.useTool ? 'tool_use' : 'end_turn', usage: round.usage};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured generation is outside this conversation script');
+    },
+  };
+  const tools = new ToolRegistry();
+  tools.register(
+    {
+      name: 'add',
+      description: 'Add two numbers',
+      inputSchema: {
+        type: 'object',
+        properties: {a: {type: 'number'}, b: {type: 'number'}},
+        required: ['a', 'b'],
+      },
+    },
+    async input => {
+      toolExecutions++;
+      return String(Number(input.a) + Number(input.b));
+    }
+  );
+  const reported: (UsageMetadata | undefined)[] = [];
+  const orchestrator = createChatOrchestrator(
+    provider,
+    new PromptBuilder({identity: 'Calculate using tools.'}),
+    tools,
+    {
+      hooks: {
+        afterModelResponse: async (_session, _text, usage) => {
+          reported.push(usage);
+        },
+      },
+    }
+  );
+
+  for (const [index] of turns.entries()) {
+    await orchestrator.processMessage({
+      sessionId: `usage-turn-${index}`,
+      userId: 'usage-user',
+      entries: [{role: 'user', content: 'Add 2 and 3', timestamp: '2026-01-01T00:00:00.000Z'}],
+    });
+  }
+
+  expect({reported, providerCalls, toolExecutions}).toEqual({
+    reported: turns.map(turn => turn.total),
+    providerCalls: 17,
+    toolExecutions: 10,
+  });
+});