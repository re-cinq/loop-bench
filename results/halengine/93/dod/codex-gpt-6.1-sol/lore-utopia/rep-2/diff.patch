+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const first: UsageMetadata = {inputTokens: 11, outputTokens: 2, totalTokens: 13};
+const second: UsageMetadata = {inputTokens: 23, outputTokens: 5, totalTokens: 28};
+const final: UsageMetadata = {inputTokens: 37, outputTokens: 7, totalTokens: 44};
+
+// Spec: specs/hal-engine-config-hooks/spec.md#12
+it('reports turn usage across every provider call, preserving missing usage and direct turns', async () => {
+  const cases = [
+    {name: 'two tool rounds', rounds: [first, second, final]},
+    {name: 'missing middle usage', rounds: [first, undefined, final]},
+    {name: 'missing first usage', rounds: [undefined, second, final]},
+    {name: 'missing final usage', rounds: [first, second, undefined]},
+    {name: 'no reported usage', rounds: [undefined, undefined, undefined]},
+    {name: 'direct answer', rounds: [first]},
+    {name: 'direct answer without usage', rounds: [undefined]},
+  ];
+  const observed = [];
+
+  for (const {name, rounds} of cases) {
+    let calls = 0;
+    let toolCalls = 0;
+    const reports: (UsageMetadata | undefined)[] = [];
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        const index = calls++;
+        if (index >= rounds.length) throw new Error('Unexpected provider call');
+        if (index < rounds.length - 1) {
+          yield {type: 'tool_use', toolCall: {id: `call-${index}`, name: 'lookup', input: {query: 'usage'}}};
+        } else {
+          yield {type: 'text', text: 'done'};
+        }
+        yield {
+          type: 'stop',
+          stopReason: index < rounds.length - 1 ? 'tool_use' : 'end_turn',
+          usage: rounds[index],
+        };
+      },
+      generateStructured<T>(): Promise<T> {
+        throw new Error('This turn does not request structured output');
+      },
+    };
+    const registry = new ToolRegistry();
+    registry.register({name: 'lookup', description: 'Return the query', inputSchema: {type: 'object'}}, async input => {
+      toolCalls++;
+      return {result: String(input.query)};
+    });
+    const orchestrator = createChatOrchestrator(
+      provider,
+      new PromptBuilder({identity: 'Answer the question.'}),
+      registry,
+      {
+        hooks: {
+          afterModelResponse: async (_session, _text, usage) => {
+            reports.push(usage);
+          },
+        },
+      }
+    );
+    const text = await orchestrator.processMessage({
+      sessionId: name,
+      userId: 'usage-customer',
+      entries: [{role: 'user', content: 'Look up usage', timestamp: '2026-01-01T00:00:00.000Z'}],
+    });
+    observed.push({name, calls, toolCalls, text, reports});
+  }
+
+  expect(observed).toEqual([
+    {
+      name: 'two tool rounds',
+      calls: 3,
+      toolCalls: 2,
+      text: 'done',
+      reports: [{inputTokens: 71, outputTokens: 14, totalTokens: 85}],
+    },
+    {
+      name: 'missing middle usage',
+      calls: 3,
+      toolCalls: 2,
+      text: 'done',
+      reports: [{inputTokens: 48, outputTokens: 9, totalTokens: 57}],
+    },
+    {
+      name: 'missing first usage',
+      calls: 3,
+      toolCalls: 2,
+      text: 'done',
+      reports: [{inputTokens: 60, outputTokens: 12, totalTokens: 72}],
+    },
+    {
+      name: 'missing final usage',
+      calls: 3,
+      toolCalls: 2,
+      text: 'done',
+      reports: [{inputTokens: 34, outputTokens: 7, totalTokens: 41}],
+    },
+    {name: 'no reported usage', calls: 3, toolCalls: 2, text: 'done', reports: [undefined]},
+    {name: 'direct answer', calls: 1, toolCalls: 0, text: 'done', reports: [first]},
+    {name: 'direct answer without usage', calls: 1, toolCalls: 0, text: 'done', reports: [undefined]},
+  ]);
+});