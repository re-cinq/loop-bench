+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+// spec: specs/hal-engine-config-hooks/spec.md#9
+it('reports total turn usage across two tool rounds, counting only calls that report usage', async () => {
+  const counts: UsageMetadata[] = [
+    {inputTokens: 11, outputTokens: 2, totalTokens: 13},
+    {inputTokens: 23, outputTokens: 5, totalTokens: 28},
+    {inputTokens: 37, outputTokens: 7, totalTokens: 44},
+  ];
+  const cases = [
+    {name: 'every call reports', rounds: counts, expected: {inputTokens: 71, outputTokens: 14, totalTokens: 85}},
+    {
+      name: 'middle call omits usage',
+      rounds: [counts[0], undefined, counts[2]],
+      expected: {inputTokens: 48, outputTokens: 9, totalTokens: 57},
+    },
+    {
+      name: 'final call omits usage',
+      rounds: [counts[0], counts[1], undefined],
+      expected: {inputTokens: 34, outputTokens: 7, totalTokens: 41},
+    },
+    {
+      name: 'first call omits usage',
+      rounds: [undefined, counts[1], counts[2]],
+      expected: {inputTokens: 60, outputTokens: 12, totalTokens: 72},
+    },
+    {name: 'no call reports', rounds: [undefined, undefined, undefined], expected: undefined},
+    {name: 'no tools', rounds: [counts[0]], expected: counts[0]},
+    {name: 'no tools or usage', rounds: [undefined], expected: undefined},
+  ];
+  const actual = [];
+  for (const scenario of cases) {
+    let providerCalls = 0;
+    let toolCalls = 0;
+    const observed: (UsageMetadata | undefined)[] = [];
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        const round = providerCalls++;
+        if (round >= scenario.rounds.length) throw new Error('Unexpected provider call');
+        const usage = scenario.rounds[round];
+        if (round < scenario.rounds.length - 1) {
+          yield {type: 'tool_use', toolCall: {id: `call-${round}`, name: 'lookup', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use', usage};
+        } else {
+          yield {type: 'text', text: 'done'};
+          yield {type: 'stop', stopReason: 'end_turn', usage};
+        }
+      },
+      async generateStructured<T>(): Promise<T> {
+        throw new Error('This turn does not request structured output');
+      },
+    };
+    const registry = new ToolRegistry();
+    registry.register({name: 'lookup', description: 'Look up a value', inputSchema: {type: 'object'}}, async () => {
+      toolCalls++;
+      return {result: 'found'};
+    });
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Answer questions'}), registry, {
+      hooks: {
+        afterModelResponse: async (_session, _text, usage) => {
+          observed.push(usage);
+        },
+      },
+    });
+    const text = await orchestrator.processMessage({
+      sessionId: scenario.name,
+      userId: 'customer',
+      entries: [{role: 'user', content: 'Look it up twice', timestamp: '2026-01-01T00:00:00.000Z'}],
+    });
+    actual.push({name: scenario.name, providerCalls, toolCalls, text, observed});
+  }
+
+  expect(actual).toEqual(
+    cases.map(scenario => ({
+      name: scenario.name,
+      providerCalls: scenario.rounds.length,
+      toolCalls: scenario.rounds.length - 1,
+      text: 'done',
+      observed: [scenario.expected],
+    }))
+  );
+});