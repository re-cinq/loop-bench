+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const first: UsageMetadata = {inputTokens: 11, outputTokens: 3, totalTokens: 14};
+const second: UsageMetadata = {inputTokens: 23, outputTokens: 5, totalTokens: 28};
+const final: UsageMetadata = {inputTokens: 37, outputTokens: 7, totalTokens: 44};
+
+// spec: specs/hal-engine-config-hooks/spec.md#8
+it('reports the sum of every provider call once per turn, preserving missing usage and direct answers', async () => {
+  const cases = [
+    {
+      name: 'two tool rounds',
+      rounds: [first, second, final],
+      total: {inputTokens: 71, outputTokens: 15, totalTokens: 86},
+    },
+    {
+      name: 'missing middle',
+      rounds: [first, undefined, final],
+      total: {inputTokens: 48, outputTokens: 10, totalTokens: 58},
+    },
+    {
+      name: 'missing last',
+      rounds: [first, second, undefined],
+      total: {inputTokens: 34, outputTokens: 8, totalTokens: 42},
+    },
+    {
+      name: 'missing first',
+      rounds: [undefined, second, final],
+      total: {inputTokens: 60, outputTokens: 12, totalTokens: 72},
+    },
+    {name: 'nothing reported', rounds: [undefined, undefined, undefined], total: undefined},
+    {name: 'direct answer', rounds: [first], total: first},
+    {name: 'direct without usage', rounds: [undefined], total: undefined},
+    {
+      name: 'reported zero',
+      rounds: [{inputTokens: 0, outputTokens: 0, totalTokens: 0}],
+      total: {inputTokens: 0, outputTokens: 0, totalTokens: 0},
+    },
+  ];
+  const actual = [];
+  for (const scenario of cases) {
+    let calls = 0;
+    let executions = 0;
+    const reports: (UsageMetadata | undefined)[] = [];
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        const round = calls++;
+        if (round >= scenario.rounds.length) throw new Error('Unexpected provider call');
+        if (round < scenario.rounds.length - 1) {
+          yield {type: 'tool_use', toolCall: {id: `lookup-${round}`, name: 'lookup', input: {}}};
+        } else {
+          yield {type: 'text', text: 'done'};
+        }
+        yield {
+          type: 'stop',
+          stopReason: round < scenario.rounds.length - 1 ? 'tool_use' : 'end_turn',
+          usage: scenario.rounds[round],
+        };
+      },
+      async generateStructured<T>(): Promise<T> {
+        throw new Error('Structured generation is not part of this turn');
+      },
+    };
+    const registry = new ToolRegistry();
+    registry.register(
+      {name: 'lookup', description: 'Return a lookup result', inputSchema: {type: 'object'}},
+      async () => {
+        executions++;
+        return {result: 'found'};
+      }
+    );
+    const orchestrator = createChatOrchestrator(
+      provider,
+      new PromptBuilder({identity: 'Answer questions.'}),
+      registry,
+      {
+        hooks: {
+          afterModelResponse: async (_session, _text, usage) => {
+            reports.push(usage);
+          },
+        },
+      }
+    );
+    const text = await orchestrator.processMessage({
+      sessionId: scenario.name,
+      userId: 'customer',
+      entries: [{role: 'user', content: 'Look this up', timestamp: '2026-01-01T00:00:00.000Z'}],
+    });
+    actual.push({name: scenario.name, calls, executions, text, reports});
+  }
+  expect(actual).toEqual(
+    cases.map(scenario => ({
+      name: scenario.name,
+      calls: scenario.rounds.length,
+      executions: scenario.rounds.length - 1,
+      text: 'done',
+      reports: [scenario.total],
+    }))
+  );
+});