+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+async function reportedUsage(rounds: (UsageMetadata | undefined)[]) {
+  let providerCalls = 0;
+  let toolCalls = 0;
+  const reports: (UsageMetadata | undefined)[] = [];
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const round = providerCalls++;
+      if (round >= rounds.length) throw new Error('Unexpected provider call');
+      if (round < rounds.length - 1) {
+        yield {type: 'tool_use', toolCall: {id: `call-${round}`, name: 'add', input: {left: round, right: 1}}};
+      } else {
+        yield {type: 'text', text: 'done'};
+      }
+      yield {type: 'stop', stopReason: round < rounds.length - 1 ? 'tool_use' : 'end_turn', usage: rounds[round]};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('This turn does not request structured output');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {
+      name: 'add',
+      description: 'Add two numbers',
+      inputSchema: {
+        type: 'object',
+        properties: {left: {type: 'number'}, right: {type: 'number'}},
+        required: ['left', 'right'],
+      },
+    },
+    async input => {
+      toolCalls++;
+      return String(Number(input.left) + Number(input.right));
+    }
+  );
+  const orchestrator = createChatOrchestrator(
+    provider,
+    new PromptBuilder({identity: 'Use add to calculate.'}),
+    registry,
+    {
+      hooks: {
+        afterModelResponse: async (_session, _text, usage) => {
+          reports.push(usage);
+        },
+      },
+    }
+  );
+  const text = await orchestrator.processMessage({
+    sessionId: 'usage-session',
+    userId: 'usage-user',
+    entries: [{role: 'user', content: 'Calculate with two tool rounds.', timestamp: '2026-01-01T00:00:00.000Z'}],
+  });
+  return {providerCalls, toolCalls, text, reports};
+}
+
+// @spec specs/hal-engine-config-hooks/spec.md#9
+it('reports total usage across two tool rounds while preserving missing and direct usage', async () => {
+  const first = {inputTokens: 11, outputTokens: 2, totalTokens: 13};
+  const second = {inputTokens: 23, outputTokens: 5, totalTokens: 28};
+  const last = {inputTokens: 37, outputTokens: 7, totalTokens: 44};
+  const cases = [
+    {rounds: [first, second, last], total: {inputTokens: 71, outputTokens: 14, totalTokens: 85}},
+    {rounds: [first, undefined, last], total: {inputTokens: 48, outputTokens: 9, totalTokens: 57}},
+    {rounds: [first, second, undefined], total: {inputTokens: 34, outputTokens: 7, totalTokens: 41}},
+    {rounds: [undefined, first, last], total: {inputTokens: 48, outputTokens: 9, totalTokens: 57}},
+    {rounds: [undefined, undefined, undefined], total: undefined},
+    {rounds: [first], total: first},
+    {rounds: [undefined], total: undefined},
+  ];
+  const actual = [];
+  for (const scenario of cases) actual.push(await reportedUsage(scenario.rounds));
+
+  expect(actual).toEqual(
+    cases.map(({rounds, total}) => ({
+      providerCalls: rounds.length,
+      toolCalls: rounds.length - 1,
+      text: 'done',
+      reports: [total],
+    }))
+  );
+});