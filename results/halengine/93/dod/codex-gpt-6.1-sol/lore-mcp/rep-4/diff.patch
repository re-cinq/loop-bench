+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const first: UsageMetadata = {inputTokens: 11, outputTokens: 3, totalTokens: 14};
+const second: UsageMetadata = {inputTokens: 23, outputTokens: 5, totalTokens: 28};
+const final: UsageMetadata = {inputTokens: 37, outputTokens: 7, totalTokens: 44};
+
+async function reportedUsage(rounds: (UsageMetadata | undefined)[]): Promise<unknown> {
+  let nextRound = 0;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const round = nextRound++;
+      if (round >= rounds.length) throw new Error('Unexpected provider call');
+      const needsTool = round < rounds.length - 1;
+      if (needsTool) yield {type: 'tool_use', toolCall: {id: `call-${round}`, name: 'lookup', input: {}}};
+      else yield {type: 'text', text: 'done'};
+      yield {type: 'stop', stopReason: needsTool ? 'tool_use' : 'end_turn', usage: rounds[round]};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured generation is not part of this turn');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'Look up a value', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found',
+  }));
+  const received: unknown[] = [];
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      received.push(usage);
+    },
+  };
+  await createChatOrchestrator(provider, new PromptBuilder({identity: 'Assistant'}), registry, {hooks}).processMessage({
+    sessionId: 'usage-session',
+    userId: 'customer',
+    entries: [{role: 'user', content: 'Look up twice', timestamp: '2026-01-01T00:00:00.000Z'}],
+  });
+  return {providerCalls: nextRound, received};
+}
+
+// spec: specs/hal-engine-config-hooks/spec.md#9
+it('reports whole-turn usage across tool rounds while preserving absent usage and direct answers', async () => {
+  const actual = {
+    twoToolRounds: await reportedUsage([first, second, final]),
+    missingMiddle: await reportedUsage([first, undefined, final]),
+    missingFirstAndLast: await reportedUsage([undefined, first, second, undefined]),
+    noneReported: await reportedUsage([undefined, undefined, undefined]),
+    directAnswer: await reportedUsage([first]),
+    directWithoutUsage: await reportedUsage([undefined]),
+  };
+
+  expect(actual).toEqual({
+    twoToolRounds: {providerCalls: 3, received: [{inputTokens: 71, outputTokens: 15, totalTokens: 86}]},
+    missingMiddle: {providerCalls: 3, received: [{inputTokens: 48, outputTokens: 10, totalTokens: 58}]},
+    missingFirstAndLast: {providerCalls: 4, received: [{inputTokens: 34, outputTokens: 8, totalTokens: 42}]},
+    noneReported: {providerCalls: 3, received: [undefined]},
+    directAnswer: {providerCalls: 1, received: [first]},
+    directWithoutUsage: {providerCalls: 1, received: [undefined]},
+  });
+});