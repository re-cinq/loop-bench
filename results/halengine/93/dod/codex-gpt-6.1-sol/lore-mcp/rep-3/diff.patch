+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const first: UsageMetadata = {inputTokens: 11, outputTokens: 2, totalTokens: 13};
+const middle: UsageMetadata = {inputTokens: 23, outputTokens: 5, totalTokens: 28};
+const last: UsageMetadata = {inputTokens: 37, outputTokens: 7, totalTokens: 44};
+
+async function reportTurn(rounds: (UsageMetadata | undefined)[]) {
+  let providerCalls = 0;
+  let toolCalls = 0;
+  const reports: (UsageMetadata | undefined)[] = [];
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const index = providerCalls++;
+      if (index >= rounds.length) throw new Error('Unexpected provider call');
+      if (index < rounds.length - 1) {
+        yield {type: 'tool_use', toolCall: {id: `call-${index}`, name: 'add', input: {left: index, right: 1}}};
+      } else {
+        yield {type: 'text', text: 'done'};
+      }
+      yield {type: 'stop', stopReason: index < rounds.length - 1 ? 'tool_use' : 'end_turn', usage: rounds[index]};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('This turn does not request structured output');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register({name: 'add', description: 'Add two numbers', inputSchema: {type: 'object'}}, async input => {
+    toolCalls++;
+    return String(Number(input.left) + Number(input.right));
+  });
+  const orchestrator = createChatOrchestrator(
+    provider,
+    new PromptBuilder({identity: 'Answer using tools.'}),
+    registry,
+    {
+      hooks: {
+        afterModelResponse: async (_session, _text, usage) => {
+          reports.push(usage);
+        },
+      },
+    }
+  );
+  const text = await orchestrator.processMessage({
+    sessionId: 'usage-turn',
+    userId: 'customer',
+    entries: [{role: 'user', content: 'Add numbers twice', timestamp: '2026-01-01T00:00:00.000Z'}],
+  });
+  return {providerCalls, toolCalls, reports, text};
+}
+
+// spec: specs/hal-engine-config-hooks/spec.md#8
+it('reports total usage across every provider call and preserves missing-usage and direct-turn semantics', async () => {
+  const cases = [
+    [first, middle, last],
+    [undefined, middle, last],
+    [first, undefined, last],
+    [first, middle, undefined],
+    [undefined, undefined, undefined],
+    [last],
+    [undefined],
+  ];
+  const observed = [];
+  for (const rounds of cases) observed.push(await reportTurn(rounds));
+
+  expect(observed).toEqual([
+    {providerCalls: 3, toolCalls: 2, reports: [{inputTokens: 71, outputTokens: 14, totalTokens: 85}], text: 'done'},
+    {providerCalls: 3, toolCalls: 2, reports: [{inputTokens: 60, outputTokens: 12, totalTokens: 72}], text: 'done'},
+    {providerCalls: 3, toolCalls: 2, reports: [{inputTokens: 48, outputTokens: 9, totalTokens: 57}], text: 'done'},
+    {providerCalls: 3, toolCalls: 2, reports: [{inputTokens: 34, outputTokens: 7, totalTokens: 41}], text: 'done'},
+    {providerCalls: 3, toolCalls: 2, reports: [undefined], text: 'done'},
+    {providerCalls: 1, toolCalls: 0, reports: [last], text: 'done'},
+    {providerCalls: 1, toolCalls: 0, reports: [undefined], text: 'done'},
+  ]);
+});