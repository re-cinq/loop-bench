--- a/src/orchestration/orchestratorHelpers.ts
+++ b/src/orchestration/orchestratorHelpers.ts
@@ -40,3 +40,16 @@ export function extractStopReason(chunk: MessageChunk): string | null {
 export function extractUsage(chunk: MessageChunk): UsageMetadata | undefined {
   return chunk.type === 'stop' ? chunk.usage : undefined;
 }
+
+export function accumulateUsage(
+  accumulated: UsageMetadata | undefined,
+  next: UsageMetadata | undefined
+): UsageMetadata | undefined {
+  if (!accumulated) return next;
+  if (!next) return accumulated;
+  return {
+    inputTokens: accumulated.inputTokens + next.inputTokens,
+    outputTokens: accumulated.outputTokens + next.outputTokens,
+    totalTokens: accumulated.totalTokens + next.totalTokens,
+  };
+}
diff --git a/src/orchestration/turnUsage.acceptance.test.ts b/src/orchestration/turnUsage.acceptance.test.ts
new file mode 100644
index 0000000..d202cea
--- /dev/null
+++ b/src/orchestration/turnUsage.acceptance.test.ts
@@ -0,0 +1,73 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const FIRST: UsageMetadata = {inputTokens: 11, outputTokens: 2, totalTokens: 13};
+const SECOND: UsageMetadata = {inputTokens: 17, outputTokens: 3, totalTokens: 20};
+const THIRD: UsageMetadata = {inputTokens: 23, outputTokens: 5, totalTokens: 28};
+
+const session = (): ChatSession => ({
+  sessionId: 'usage-turn',
+  userId: 'user',
+  entries: [{role: 'user', content: 'Look up two things', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const providerFor = (roundUsage: Array<UsageMetadata | undefined>): AIProvider => {
+  let call = 0;
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const round = call++;
+      if (round < 2) {
+        yield {type: 'tool_use', toolCall: {id: `lookup-${round}`, name: 'lookup', input: {}}};
+        yield {type: 'stop', stopReason: 'tool_use', usage: roundUsage[round]};
+        return;
+      }
+      yield {type: 'text', text: 'Both lookups are complete.'};
+      yield {type: 'stop', stopReason: 'end_turn', usage: roundUsage[round]};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('The orchestrator must not request structured output');
+    },
+  };
+};
+
+const usageAfterTwoToolRounds = async (roundUsage: Array<UsageMetadata | undefined>) => {
+  const reports: Array<UsageMetadata | undefined> = [];
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reports.push(usage);
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Look up an item', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  const orchestrator = createChatOrchestrator(
+    providerFor(roundUsage),
+    new PromptBuilder({identity: 'Help.'}),
+    registry,
+    {
+      hooks,
+    }
+  );
+
+  await orchestrator.processMessage(session());
+  return reports;
+};
+
+// specs/hal-engine-config-hooks/spec.md#9
+it('reports turn usage across every provider call, ignoring missing rounds', async () => {
+  const everyRound = await usageAfterTwoToolRounds([FIRST, SECOND, THIRD]);
+  const missingMiddle = await usageAfterTwoToolRounds([FIRST, undefined, THIRD]);
+  const noUsage = await usageAfterTwoToolRounds([undefined, undefined, undefined]);
+
+  expect({everyRound, missingMiddle, noUsage}).toEqual({
+    everyRound: [{inputTokens: 51, outputTokens: 10, totalTokens: 61}],
+    missingMiddle: [{inputTokens: 34, outputTokens: 7, totalTokens: 41}],
+    noUsage: [undefined],
+  });
+});