+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const promptBuilder = new PromptBuilder({identity: 'Answer the question.'});
+
+async function reportFor(roundUsages: Array<UsageMetadata | undefined>): Promise<{
+  providerCalls: number;
+  usage: UsageMetadata | undefined;
+}> {
+  let providerCalls = 0;
+  let usage: UsageMetadata | undefined;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const round = providerCalls++;
+      if (round < 2) {
+        yield {type: 'tool_use', toolCall: {id: `lookup-${round}`, name: 'lookup', input: {}}};
+      } else {
+        yield {type: 'text', text: 'The answer.'};
+      }
+      yield {type: 'stop', stopReason: round < 2 ? 'tool_use' : 'end_turn', usage: roundUsages[round]};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured output is not part of this turn');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Looks up a fact.', inputSchema: {type: 'object'}},
+    async () => 'fact'
+  );
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _responseText, reportedUsage) => {
+      usage = reportedUsage;
+    },
+  };
+  const session: ChatSession = {
+    sessionId: 'usage-turn',
+    userId: 'reader',
+    entries: [{role: 'user', content: 'What is the answer?', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+
+  await createChatOrchestrator(provider, promptBuilder, registry, {hooks}).processMessage(session);
+  return {providerCalls, usage};
+}
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports the sum of every provider call with usage and nothing when no call reports it', async () => {
+    const first = {inputTokens: 4, outputTokens: 2, totalTokens: 6};
+    const second = {inputTokens: 7, outputTokens: 3, totalTokens: 10};
+    const third = {inputTokens: 11, outputTokens: 5, totalTokens: 16};
+
+    const complete = await reportFor([first, second, third]);
+    const missingMiddle = await reportFor([first, undefined, third]);
+    const noUsage = await reportFor([undefined, undefined, undefined]);
+
+    expect({complete, missingMiddle, noUsage}).toEqual({
+      complete: {providerCalls: 3, usage: {inputTokens: 22, outputTokens: 10, totalTokens: 32}},
+      missingMiddle: {providerCalls: 3, usage: {inputTokens: 15, outputTokens: 7, totalTokens: 22}},
+      noUsage: {providerCalls: 3, usage: undefined},
+    });
+  });
+});