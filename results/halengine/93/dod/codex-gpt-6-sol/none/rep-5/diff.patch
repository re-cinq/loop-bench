+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const first: UsageMetadata = {inputTokens: 11, outputTokens: 2, totalTokens: 13};
+const second: UsageMetadata = {inputTokens: 23, outputTokens: 5, totalTokens: 28};
+const third: UsageMetadata = {inputTokens: 37, outputTokens: 7, totalTokens: 44};
+
+const session = (): ChatSession => ({
+  sessionId: 'usage-turn',
+  userId: 'user',
+  entries: [{role: 'user', content: 'Look up two things', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+async function reportedUsage(roundUsages: Array<UsageMetadata | undefined>): Promise<UsageMetadata | undefined> {
+  let round = 0;
+  let reported: UsageMetadata | undefined;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const usage = roundUsages[round];
+      if (round++ < 2) {
+        yield {type: 'tool_use', toolCall: {id: `lookup-${round}`, name: 'lookup', input: {}}};
+        yield {type: 'stop', stopReason: 'tool_use', usage};
+      } else {
+        yield {type: 'text', text: 'Done.'};
+        yield {type: 'stop', stopReason: 'end_turn', usage};
+      }
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('This turn does not request structured output');
+    },
+  };
+  const tools = new ToolRegistry();
+  tools.register(
+    {name: 'lookup', description: 'Look something up', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reported = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Usage test assistant.'}), tools, {
+    hooks,
+  });
+
+  await orchestrator.processMessage(session());
+  return reported;
+}
+
+// specs/hal-engine-config-hooks/spec.md#9
+it('reports usage across every provider call in two tool rounds, including when a round omits usage', async () => {
+  const allRounds = await reportedUsage([first, second, third]);
+  const missingMiddle = await reportedUsage([first, undefined, third]);
+  const noUsage = await reportedUsage([undefined, undefined, undefined]);
+
+  expect({allRounds, missingMiddle, noUsage}).toEqual({
+    allRounds: {inputTokens: 71, outputTokens: 14, totalTokens: 85},
+    missingMiddle: {inputTokens: 48, outputTokens: 9, totalTokens: 57},
+    noUsage: undefined,
+  });
+});