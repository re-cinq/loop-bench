+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const first: UsageMetadata = {inputTokens: 7, outputTokens: 3, totalTokens: 10};
+const second: UsageMetadata = {inputTokens: 13, outputTokens: 5, totalTokens: 18};
+const third: UsageMetadata = {inputTokens: 17, outputTokens: 11, totalTokens: 28};
+
+async function runTurn(rounds: Array<UsageMetadata | undefined>): Promise<{
+  calls: number;
+  executions: number;
+  reported: UsageMetadata | undefined;
+}> {
+  let calls = 0;
+  let executions = 0;
+  let reported: UsageMetadata | undefined;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const round = calls++;
+      if (round < rounds.length - 1) {
+        yield {type: 'tool_use', toolCall: {id: `lookup-${round}`, name: 'lookup', input: {}}};
+      } else {
+        yield {type: 'text', text: 'Done.'};
+      }
+      yield {type: 'stop', stopReason: round < rounds.length - 1 ? 'tool_use' : 'end_turn', usage: rounds[round]};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('This provider only handles chat turns');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'Look up a result', inputSchema: {type: 'object'}}, async () => {
+    executions++;
+    return 'found';
+  });
+  const session: ChatSession = {
+    sessionId: 'usage-acceptance',
+    userId: 'user',
+    entries: [{role: 'user', content: 'Look this up twice', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Usage test'}), registry, {
+    hooks: {afterModelResponse: async (_session, _response, usage) => void (reported = usage)},
+  });
+  await orchestrator.processMessage(session);
+  return {calls, executions, reported};
+}
+
+// specs/hal-engine-config-hooks/spec.md#8
+it('reports summed provider usage across two tool rounds and skips rounds without usage', async () => {
+  const allReported = await runTurn([first, second, third]);
+  const someReported = await runTurn([first, undefined, third]);
+  const noneReported = await runTurn([undefined, undefined, undefined]);
+
+  expect({allReported, someReported, noneReported}).toEqual({
+    allReported: {calls: 3, executions: 2, reported: {inputTokens: 37, outputTokens: 19, totalTokens: 56}},
+    someReported: {calls: 3, executions: 2, reported: {inputTokens: 24, outputTokens: 14, totalTokens: 38}},
+    noneReported: {calls: 3, executions: 2, reported: undefined},
+  });
+});