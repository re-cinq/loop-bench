+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+async function runTurn(usages: Array<UsageMetadata | undefined>): Promise<{
+  providerCalls: number;
+  toolExecutions: number;
+  reportedUsage: UsageMetadata | undefined;
+}> {
+  let providerCalls = 0;
+  let toolExecutions = 0;
+  let reportedUsage: UsageMetadata | undefined;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const round = providerCalls++;
+      if (round >= usages.length) throw new Error('Unexpected provider call');
+      if (round < usages.length - 1) {
+        yield {type: 'tool_use', toolCall: {id: `call-${round}`, name: 'lookup', input: {}}};
+      } else {
+        yield {type: 'text', text: 'Done.'};
+      }
+      yield {type: 'stop', stopReason: round < usages.length - 1 ? 'tool_use' : 'end_turn', usage: usages[round]};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Unexpected structured request');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'Looks things up.', inputSchema: {type: 'object'}}, async () => {
+    toolExecutions++;
+    return 'Found.';
+  });
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reportedUsage = usage;
+    },
+  };
+  const session: ChatSession = {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'Look this up', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const orchestrator = createChatOrchestrator(provider, promptBuilder, registry, {hooks});
+
+  await orchestrator.processMessage(session);
+
+  return {providerCalls, toolExecutions, reportedUsage};
+}
+
+it('reports total usage from every provider call in a tool turn, including when a round omits usage', async () => {
+  const complete = await runTurn([
+    {inputTokens: 10, outputTokens: 2, totalTokens: 12},
+    {inputTokens: 20, outputTokens: 3, totalTokens: 23},
+    {inputTokens: 30, outputTokens: 5, totalTokens: 35},
+  ]);
+  const partial = await runTurn([
+    {inputTokens: 11, outputTokens: 3, totalTokens: 14},
+    undefined,
+    {inputTokens: 5, outputTokens: 7, totalTokens: 12},
+  ]);
+  const absent = await runTurn([undefined, undefined, undefined]);
+
+  expect({complete, partial, absent}).toEqual({
+    complete: {
+      providerCalls: 3,
+      toolExecutions: 2,
+      reportedUsage: {inputTokens: 60, outputTokens: 10, totalTokens: 70},
+    },
+    partial: {
+      providerCalls: 3,
+      toolExecutions: 2,
+      reportedUsage: {inputTokens: 16, outputTokens: 10, totalTokens: 26},
+    },
+    absent: {providerCalls: 3, toolExecutions: 2, reportedUsage: undefined},
+  });
+});