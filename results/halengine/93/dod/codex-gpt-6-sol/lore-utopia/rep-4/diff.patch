+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const toolCall = (id: string): MessageChunk => ({type: 'tool_use', toolCall: {id, name: 'lookup', input: {}}});
+const stop = (reason: string, usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason: reason, usage});
+
+async function runTurn(rounds: MessageChunk[][]): Promise<{calls: number; reports: Array<UsageMetadata | undefined>}> {
+  let calls = 0;
+  const reports: Array<UsageMetadata | undefined> = [];
+  const provider: AIProvider = {
+    async *sendMessage() {
+      const round = rounds[calls++];
+      if (!round) throw new Error('Provider called beyond scripted rounds');
+      yield* round;
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Unexpected structured output request');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Look up a value', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reports.push(usage);
+    },
+  };
+  const session: ChatSession = {
+    sessionId: 'usage-turn',
+    userId: 'user',
+    entries: [{role: 'user', content: 'look up twice', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Test assistant'}), registry, {
+    hooks,
+  });
+
+  await orchestrator.processMessage(session);
+  return {calls, reports};
+}
+
+describe('afterModelResponse turn usage', () => {
+  it('sums every provider call across two tool rounds', async () => {
+    const first = {inputTokens: 11, outputTokens: 3, totalTokens: 14};
+    const second = {inputTokens: 17, outputTokens: 5, totalTokens: 22};
+    const third = {inputTokens: 23, outputTokens: 7, totalTokens: 30};
+
+    const result = await runTurn([
+      [toolCall('first'), stop('tool_use', first)],
+      [toolCall('second'), stop('tool_use', second)],
+      [{type: 'text', text: 'Done'}, stop('end_turn', third)],
+    ]);
+
+    expect(result).toEqual({calls: 3, reports: [{inputTokens: 51, outputTokens: 15, totalTokens: 66}]});
+  });
+
+  it('counts reported rounds when another omits usage and leaves an entirely unreported turn undefined', async () => {
+    const first = {inputTokens: 11, outputTokens: 3, totalTokens: 14};
+    const third = {inputTokens: 23, outputTokens: 7, totalTokens: 30};
+    const withGap = await runTurn([
+      [toolCall('first'), stop('tool_use', first)],
+      [toolCall('second'), stop('tool_use')],
+      [{type: 'text', text: 'Done'}, stop('end_turn', third)],
+    ]);
+    const withoutUsage = await runTurn([
+      [toolCall('first'), stop('tool_use')],
+      [toolCall('second'), stop('tool_use')],
+      [{type: 'text', text: 'Done'}, stop('end_turn')],
+    ]);
+
+    expect({withGap, withoutUsage}).toEqual({
+      withGap: {calls: 3, reports: [{inputTokens: 34, outputTokens: 10, totalTokens: 44}]},
+      withoutUsage: {calls: 3, reports: [undefined]},
+    });
+  });
+});