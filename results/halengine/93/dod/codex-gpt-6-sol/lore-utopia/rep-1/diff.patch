+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const promptBuilder = new PromptBuilder({identity: 'Usage acceptance test.'});
+const session = (): ChatSession => ({
+  sessionId: 'usage-test',
+  userId: 'user',
+  entries: [{role: 'user', content: 'Look this up', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+const usage = (inputTokens: number, outputTokens: number): UsageMetadata => ({
+  inputTokens,
+  outputTokens,
+  totalTokens: inputTokens + outputTokens,
+});
+
+function toolRound(reported?: UsageMetadata): MessageChunk[] {
+  return [
+    {type: 'tool_use', toolCall: {id: 'lookup-call', name: 'lookup', input: {}}},
+    {type: 'stop', stopReason: 'tool_use', usage: reported},
+  ];
+}
+
+function answerRound(reported?: UsageMetadata): MessageChunk[] {
+  return [
+    {type: 'text', text: 'Found it'},
+    {type: 'stop', stopReason: 'end_turn', usage: reported},
+  ];
+}
+
+async function reportedUsage(rounds: MessageChunk[][]): Promise<{calls: number; received: UsageMetadata | undefined}> {
+  let calls = 0;
+  let received: UsageMetadata | undefined;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield* rounds[calls++] ?? [];
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured output is not part of this turn');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Looks up an answer', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, reported) => {
+      received = reported;
+    },
+  };
+
+  await createChatOrchestrator(provider, promptBuilder, registry, {hooks}).processMessage(session());
+  return {calls, received};
+}
+
+// specs/hal-engine-config-hooks/spec.md#2
+describe('afterModelResponse turn usage', () => {
+  it('reports the sum of every provider call across two tool rounds', async () => {
+    const result = await reportedUsage([toolRound(usage(11, 2)), toolRound(usage(17, 3)), answerRound(usage(23, 5))]);
+
+    expect(result).toEqual({calls: 3, received: usage(51, 10)});
+  });
+
+  it('counts reported rounds when another round omits usage and leaves all-missing usage undefined', async () => {
+    const someReported = await reportedUsage([toolRound(usage(11, 2)), toolRound(), answerRound(usage(23, 5))]);
+    const noneReported = await reportedUsage([toolRound(), toolRound(), answerRound()]);
+
+    expect({someReported, noneReported}).toEqual({
+      someReported: {calls: 3, received: usage(34, 7)},
+      noneReported: {calls: 3, received: undefined},
+    });
+  });
+});