+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+const session = (): ChatSession => ({
+  sessionId: 'usage-session',
+  userId: 'usage-user',
+  entries: [{role: 'user', content: 'Look up the answer', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+function providerFor(rounds: MessageChunk[][]): AIProvider {
+  let nextRound = 0;
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield* rounds[nextRound++] ?? [];
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured output is outside this turn');
+    },
+  };
+}
+
+function lookupRegistry(): ToolRegistry {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Looks up an answer', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  return registry;
+}
+
+function toolRound(id: string, usage?: UsageMetadata): MessageChunk[] {
+  return [
+    {type: 'tool_use', toolCall: {id, name: 'lookup', input: {}}},
+    {type: 'stop', stopReason: 'tool_use', usage},
+  ];
+}
+
+function answerRound(usage?: UsageMetadata): MessageChunk[] {
+  return [
+    {type: 'text', text: 'The answer is found.'},
+    {type: 'stop', stopReason: 'end_turn', usage},
+  ];
+}
+
+async function reportedUsage(rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> {
+  let received: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      received = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(providerFor(rounds), promptBuilder, lookupRegistry(), {hooks});
+  await orchestrator.processMessage(session());
+  return received;
+}
+
+describe('afterModelResponse turn usage', () => {
+  // specs/hal-engine-config-hooks/spec.md#8
+  it('sums usage from both tool rounds and the final provider call', async () => {
+    const first = {inputTokens: 11, outputTokens: 3, totalTokens: 14};
+    const second = {inputTokens: 7, outputTokens: 5, totalTokens: 12};
+    const last = {inputTokens: 13, outputTokens: 2, totalTokens: 15};
+
+    const usage = await reportedUsage([toolRound('first', first), toolRound('second', second), answerRound(last)]);
+
+    expect(usage).toEqual({inputTokens: 31, outputTokens: 10, totalTokens: 41});
+  });
+
+  // specs/hal-engine-config-hooks/spec.md#8
+  it('counts reported rounds across gaps and leaves an all-unreported turn without usage', async () => {
+    const first = {inputTokens: 11, outputTokens: 3, totalTokens: 14};
+    const last = {inputTokens: 7, outputTokens: 5, totalTokens: 12};
+
+    const partial = await reportedUsage([toolRound('first', first), toolRound('second'), answerRound(last)]);
+    const unreported = await reportedUsage([toolRound('first'), toolRound('second'), answerRound()]);
+
+    expect({partial, unreported}).toEqual({
+      partial: {inputTokens: 18, outputTokens: 8, totalTokens: 26},
+      unreported: undefined,
+    });
+  });
+});