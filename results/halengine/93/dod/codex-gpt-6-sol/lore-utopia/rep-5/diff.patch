+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ChatSession} from '../types/session.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const session = (): ChatSession => ({
+  sessionId: 'usage-session',
+  userId: 'usage-user',
+  entries: [{role: 'user', content: 'Look up the answer', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const toolRegistry = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'Looks up an answer', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found',
+  }));
+  return registry;
+};
+
+const providerWithUsage = (usages: Array<UsageMetadata | undefined>): AIProvider => {
+  let round = 0;
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const usage = usages[round];
+      const asksForTool = round++ < usages.length - 1;
+      if (asksForTool) {
+        yield {type: 'tool_use', toolCall: {id: `lookup-${round}`, name: 'lookup', input: {}}};
+      } else {
+        yield {type: 'text', text: 'The answer is found.'};
+      }
+      yield {type: 'stop', stopReason: asksForTool ? 'tool_use' : 'end_turn', usage};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured output is not used in this turn');
+    },
+  };
+};
+
+const reportedUsage = async (usages: Array<UsageMetadata | undefined>): Promise<UsageMetadata | undefined> => {
+  let reported: UsageMetadata | undefined;
+  const orchestrator = createChatOrchestrator(providerWithUsage(usages), promptBuilder, toolRegistry(), {
+    hooks: {
+      afterModelResponse: async (_session, _text, usage) => {
+        reported = usage;
+      },
+    },
+  });
+  await orchestrator.processMessage(session());
+  return reported;
+};
+
+describe('afterModelResponse turn usage', () => {
+  // specs/hal-engine-config-hooks/spec.md#9
+  it('reports the sum of every provider call across two tool rounds', async () => {
+    const reported = await reportedUsage([
+      {inputTokens: 11, outputTokens: 2, totalTokens: 13},
+      {inputTokens: 17, outputTokens: 3, totalTokens: 20},
+      {inputTokens: 23, outputTokens: 5, totalTokens: 28},
+    ]);
+
+    expect(reported).toEqual({inputTokens: 51, outputTokens: 10, totalTokens: 61});
+  });
+
+  // specs/hal-engine-config-hooks/spec.md#10
+  it('sums reported rounds when another has no usage and leaves an unreported turn undefined', async () => {
+    const partial = await reportedUsage([
+      {inputTokens: 11, outputTokens: 2, totalTokens: 13},
+      undefined,
+      {inputTokens: 23, outputTokens: 5, totalTokens: 28},
+    ]);
+    const absent = await reportedUsage([undefined, undefined, undefined]);
+
+    expect({partial, absent}).toEqual({
+      partial: {inputTokens: 34, outputTokens: 7, totalTokens: 41},
+      absent: undefined,
+    });
+  });
+});