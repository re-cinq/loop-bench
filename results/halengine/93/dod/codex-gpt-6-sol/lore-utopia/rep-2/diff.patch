@@ -0,0 +1,68 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const usage = (inputTokens: number, outputTokens: number): UsageMetadata => ({
+  inputTokens,
+  outputTokens,
+  totalTokens: inputTokens + outputTokens,
+});
+
+async function reportFor(roundUsage: Array<UsageMetadata | undefined>): Promise<{
+  calls: number;
+  reported: UsageMetadata | undefined;
+}> {
+  let calls = 0;
+  let reported: UsageMetadata | undefined;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const round = calls++;
+      if (round < 2) {
+        yield {type: 'tool_use', toolCall: {id: `lookup-${round}`, name: 'lookup', input: {}}};
+        yield {type: 'stop', stopReason: 'tool_use', usage: roundUsage[round]};
+      } else {
+        yield {type: 'text', text: 'Answer.'};
+        yield {type: 'stop', stopReason: 'end_turn', usage: roundUsage[round]};
+      }
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured output is not part of this turn');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Looks up an answer', inputSchema: {type: 'object'}},
+    async () => 'Found'
+  );
+  const session: ChatSession = {
+    sessionId: 'usage-turn',
+    userId: 'user',
+    entries: [{role: 'user', content: 'Look up an answer', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Answer questions.'}), registry, {
+    hooks: {
+      afterModelResponse: async (_session, _text, turnUsage) => {
+        reported = turnUsage;
+      },
+    },
+  });
+
+  await orchestrator.processMessage(session);
+  return {calls, reported};
+}
+
+it('sums usage from every provider call across two tool rounds (specs/hal-engine-config-hooks/spec.md#8)', async () => {
+  const reports = await Promise.all([
+    reportFor([usage(11, 2), usage(7, 3), usage(5, 13)]),
+    reportFor([usage(11, 2), undefined, usage(5, 13)]),
+    reportFor([undefined, undefined, undefined]),
+  ]);
+
+  expect(reports).toEqual([
+    {calls: 3, reported: usage(23, 18)},
+    {calls: 3, reported: usage(16, 15)},
+    {calls: 3, reported: undefined},
+  ]);
+});