+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+const toolCall: MessageChunk = {type: 'tool_use', toolCall: {id: 'lookup-1', name: 'lookup', input: {}}};
+
+function createSession(): ChatSession {
+  return {
+    sessionId: 'usage-turn',
+    userId: 'user-1',
+    entries: [{role: 'user', content: 'Look this up', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+}
+
+async function reportUsage(rounds: MessageChunk[][]): Promise<{calls: number; usage: UsageMetadata | undefined}> {
+  let calls = 0;
+  let usage: UsageMetadata | undefined;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[calls++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured output is outside this turn');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Looks up a value', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, reported) => {
+      usage = reported;
+    },
+  };
+
+  await createChatOrchestrator(provider, promptBuilder, registry, {hooks}).processMessage(createSession());
+  return {calls, usage};
+}
+
+// specs/hal-engine-config-hooks/spec.md#2
+it('reports total provider usage across tool rounds, ignoring rounds without usage', async () => {
+  const everyRound = await reportUsage([
+    [toolCall, {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 11, outputTokens: 3, totalTokens: 14}}],
+    [toolCall, {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 17, outputTokens: 5, totalTokens: 22}}],
+    [
+      {type: 'text', text: 'done'},
+      {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 7, outputTokens: 2, totalTokens: 9}},
+    ],
+  ]);
+  const someRounds = await reportUsage([
+    [toolCall, {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 4, outputTokens: 1, totalTokens: 5}}],
+    [toolCall, {type: 'stop', stopReason: 'tool_use'}],
+    [
+      {type: 'text', text: 'done'},
+      {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 6, outputTokens: 2, totalTokens: 8}},
+    ],
+  ]);
+  const noRounds = await reportUsage([
+    [toolCall, {type: 'stop', stopReason: 'tool_use'}],
+    [
+      {type: 'text', text: 'done'},
+      {type: 'stop', stopReason: 'end_turn'},
+    ],
+  ]);
+
+  expect({everyRound, someRounds, noRounds}).toEqual({
+    everyRound: {calls: 3, usage: {inputTokens: 35, outputTokens: 10, totalTokens: 45}},
+    someRounds: {calls: 3, usage: {inputTokens: 10, outputTokens: 3, totalTokens: 13}},
+    noRounds: {calls: 2, usage: undefined},
+  });
+});