+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const UNREPORTED_SENTINEL: UsageMetadata = {inputTokens: -1, outputTokens: -1, totalTokens: -1};
+
+describe('ChatOrchestrator multi-round usage reporting', () => {
+  it('sums usage across every provider call when a turn runs two tool rounds', async () => {
+    const turn = await runTurnWithRoundUsages([
+      {inputTokens: 100, outputTokens: 20, totalTokens: 120},
+      {inputTokens: 250, outputTokens: 35, totalTokens: 285},
+      {inputTokens: 410, outputTokens: 60, totalTokens: 470},
+    ]);
+
+    expect(turn).toEqual({
+      toolRoundsExecuted: 2,
+      providerCalls: 3,
+      reportedUsage: {inputTokens: 760, outputTokens: 115, totalTokens: 875},
+    });
+  });
+
+  it('counts only the rounds that reported usage, and reports undefined when none did', async () => {
+    const partial = await runTurnWithRoundUsages([
+      undefined,
+      {inputTokens: 40, outputTokens: 10, totalTokens: 50},
+      undefined,
+      {inputTokens: 90, outputTokens: 15, totalTokens: 105},
+      undefined,
+    ]);
+    const silent = await runTurnWithRoundUsages([undefined, undefined]);
+
+    expect({
+      partialUsage: partial.reportedUsage,
+      silentUsage: silent.reportedUsage,
+    }).toEqual({
+      partialUsage: {inputTokens: 130, outputTokens: 25, totalTokens: 155},
+      silentUsage: undefined,
+    });
+  });
+});
+
+async function runTurnWithRoundUsages(roundUsages: Array<UsageMetadata | undefined>): Promise<{
+  toolRoundsExecuted: number;
+  providerCalls: number;
+  reportedUsage: UsageMetadata | undefined;
+}> {
+  let providerCalls = 0;
+  let toolRoundsExecuted = 0;
+  let reportedUsage: UsageMetadata | undefined = UNREPORTED_SENTINEL;
+
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const callIndex = providerCalls++;
+      const usage = roundUsages[callIndex];
+      const isFinalRound = callIndex >= roundUsages.length - 1;
+      if (!isFinalRound) {
+        yield {type: 'tool_use', toolCall: {id: `round-${callIndex}`, name: 'lookup', input: {}}};
+        yield usage ? {type: 'stop', stopReason: 'tool_use', usage} : {type: 'stop', stopReason: 'tool_use'};
+        return;
+      }
+      yield {type: 'text', text: 'answered'};
+      yield usage ? {type: 'stop', stopReason: 'end_turn', usage} : {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'Looks up a record.', inputSchema: {type: 'object'}}, async () => {
+    toolRoundsExecuted++;
+    return 'record';
+  });
+
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _responseText, usage) => {
+      reportedUsage = usage;
+    },
+  };
+
+  const session: ChatSession = {
+    sessionId: 's-usage',
+    userId: 'u-usage',
+    entries: [{role: 'user', content: 'cost this turn', timestamp: SENT_AT}],
+  };
+
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Usage test.'}), registry, {
+    hooks,
+  });
+  await orchestrator.processMessage(session);
+
+  return {toolRoundsExecuted, providerCalls, reportedUsage};
+}