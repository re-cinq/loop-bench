+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+interface ScriptedRound {
+  kind: 'tool' | 'answer';
+  usage?: UsageMetadata;
+}
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('sums usage across every provider call in a multi-round tool turn', async () => {
+    const reported = await recordedTurnUsage([
+      {kind: 'tool', usage: {inputTokens: 10, outputTokens: 4, totalTokens: 14}},
+      {kind: 'tool', usage: {inputTokens: 25, outputTokens: 6, totalTokens: 31}},
+      {kind: 'answer', usage: {inputTokens: 40, outputTokens: 12, totalTokens: 52}},
+    ]);
+
+    expect(reported).toEqual({inputTokens: 75, outputTokens: 22, totalTokens: 97});
+  });
+
+  it('sums the rounds that reported usage and keeps undefined when no round reported any', async () => {
+    const partial = await recordedTurnUsage([
+      {kind: 'tool'},
+      {kind: 'tool', usage: {inputTokens: 12, outputTokens: 5, totalTokens: 17}},
+      {kind: 'tool', usage: {inputTokens: 30, outputTokens: 8, totalTokens: 38}},
+      {kind: 'answer'},
+    ]);
+    const unreported = await recordedTurnUsage([{kind: 'tool'}, {kind: 'answer'}]);
+
+    expect({partial, unreported}).toEqual({
+      partial: {inputTokens: 42, outputTokens: 13, totalTokens: 55},
+      unreported: undefined,
+    });
+  });
+});
+
+async function recordedTurnUsage(rounds: ScriptedRound[]): Promise<UsageMetadata | undefined> {
+  let seen: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _responseText, usage) => {
+      seen = usage;
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Looks up an entry.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  const orchestrator = createChatOrchestrator(
+    providerFromRounds(rounds),
+    new PromptBuilder({identity: 'Usage test assistant.'}),
+    registry,
+    {hooks}
+  );
+  const session: ChatSession = {
+    sessionId: 's-usage',
+    userId: 'u-usage',
+    entries: [{role: 'user', content: 'run lookup', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+
+  await orchestrator.processMessage(session);
+  return seen;
+}
+
+function providerFromRounds(rounds: ScriptedRound[]): AIProvider {
+  let cursor = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const current = rounds[cursor++] ?? {kind: 'answer' as const};
+      if (current.kind === 'tool') {
+        yield {type: 'tool_use', toolCall: {id: `call-${cursor}`, name: 'lookup', input: {}}};
+        yield current.usage
+          ? {type: 'stop', stopReason: 'tool_use', usage: current.usage}
+          : {type: 'stop', stopReason: 'tool_use'};
+        return;
+      }
+      yield {type: 'text', text: 'all done'};
+      yield current.usage
+        ? {type: 'stop', stopReason: 'end_turn', usage: current.usage}
+        : {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}