+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {AIError} from '../types/ai.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const PROMPT = new PromptBuilder({identity: 'Usage test assistant.'});
+
+const toolRound = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {topic: 'usage'}}},
+  usage === undefined ? {type: 'stop', stopReason: 'tool_use'} : {type: 'stop', stopReason: 'tool_use', usage},
+];
+
+const finalRound = (text: string, usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text},
+  usage === undefined ? {type: 'stop', stopReason: 'end_turn'} : {type: 'stop', stopReason: 'end_turn', usage},
+];
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let cursor = 0;
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[cursor++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new AIError('generateStructured is not exercised in chat turns', 'NOT_IMPLEMENTED');
+    },
+  };
+};
+
+const lookupRegistry = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Reads a record.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  return registry;
+};
+
+const userSession = (): ChatSession => ({
+  sessionId: 'turn-usage-session',
+  userId: 'user-1',
+  entries: [{role: 'user', content: 'summarise my account', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const runTurn = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _responseText, usage) => {
+      reported = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(scriptedProvider(rounds), PROMPT, lookupRegistry(), {hooks});
+  await orchestrator.processMessage(userSession());
+  return reported;
+};
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('sums usage across two tool rounds and the final answer', async () => {
+    const reported = await runTurn([
+      toolRound({inputTokens: 100, outputTokens: 20, totalTokens: 120}),
+      toolRound({inputTokens: 250, outputTokens: 35, totalTokens: 285}),
+      finalRound('Done.', {inputTokens: 400, outputTokens: 50, totalTokens: 450}),
+    ]);
+
+    expect(reported).toMatchObject({inputTokens: 750, outputTokens: 105, totalTokens: 855});
+  });
+
+  it('counts only rounds that reported usage and reports undefined when none did', async () => {
+    const partial = await runTurn([
+      toolRound({inputTokens: 110, outputTokens: 15, totalTokens: 125}),
+      toolRound(),
+      toolRound({inputTokens: 230, outputTokens: 25, totalTokens: 255}),
+      finalRound('Done.'),
+    ]);
+    const silent = await runTurn([toolRound(), finalRound('Done.')]);
+
+    expect({partial, silent}).toEqual({
+      partial: expect.objectContaining({inputTokens: 340, outputTokens: 40, totalTokens: 380}),
+      silent: undefined,
+    });
+  });
+});