+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('afterModelResponse turn usage', () => {
+  it('sums usage across every provider call in a multi-round tool turn', async () => {
+    const reportedUsage = await runTurnWithRounds([
+      toolRound('call-1', {inputTokens: 10, outputTokens: 4, totalTokens: 14}),
+      toolRound('call-2', {inputTokens: 25, outputTokens: 7, totalTokens: 32}),
+      finalRound('done', {inputTokens: 40, outputTokens: 9, totalTokens: 49}),
+    ]);
+
+    expect(reportedUsage).toEqual({inputTokens: 75, outputTokens: 20, totalTokens: 95});
+  });
+
+  it('sums the rounds that report usage when some omit it, or undefined when none do', async () => {
+    const partialRoundsUsage = await runTurnWithRounds([
+      toolRound('call-1', {inputTokens: 12, outputTokens: 5, totalTokens: 17}),
+      toolRound('call-2'),
+      toolRound('call-3', {inputTokens: 30, outputTokens: 8, totalTokens: 38}),
+      finalRound('done'),
+    ]);
+    const silentTurnUsage = await runTurnWithRounds([toolRound('call-1'), finalRound('done')]);
+
+    expect({partialRoundsUsage, silentTurnUsage}).toEqual({
+      partialRoundsUsage: {inputTokens: 42, outputTokens: 13, totalTokens: 55},
+      silentTurnUsage: undefined,
+    });
+  });
+});
+
+async function runTurnWithRounds(rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> {
+  let reportedUsage: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _responseText, usage) => {
+      reportedUsage = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(
+    providerForRounds(rounds),
+    new PromptBuilder({identity: 'HAL'}),
+    lookupRegistry(),
+    {hooks}
+  );
+  const session: ChatSession = {
+    sessionId: 'turn-usage-session',
+    userId: 'turn-usage-user',
+    entries: [{role: 'user', content: 'run', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+
+  await orchestrator.processMessage(session);
+  return reportedUsage;
+}
+
+function providerForRounds(rounds: MessageChunk[][]): AIProvider {
+  let callIndex = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[callIndex++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+function lookupRegistry(): ToolRegistry {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'Looks up a record', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found',
+  }));
+  return registry;
+}
+
+function toolRound(callId: string, usage?: UsageMetadata): MessageChunk[] {
+  return [
+    {type: 'tool_use', toolCall: {id: callId, name: 'lookup', input: {}}},
+    {type: 'stop', stopReason: 'tool_use', ...(usage ? {usage} : {})},
+  ];
+}
+
+function finalRound(text: string, usage?: UsageMetadata): MessageChunk[] {
+  return [
+    {type: 'text', text},
+    {type: 'stop', stopReason: 'end_turn', ...(usage ? {usage} : {})},
+  ];
+}