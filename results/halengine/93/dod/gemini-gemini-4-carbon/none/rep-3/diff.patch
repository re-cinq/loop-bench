+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+describe('afterModelResponse usage across tool rounds', () => {
+  const runUsageTurn = async (roundUsages: Array<UsageMetadata | undefined>) => {
+    let callIndex = 0;
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        const currentIndex = callIndex++;
+        const roundUsage = roundUsages[currentIndex];
+        if (currentIndex < roundUsages.length - 1) {
+          yield {
+            type: 'tool_use',
+            toolCall: {id: `step-${currentIndex}`, name: 'fetchStep', input: {step: currentIndex}},
+          };
+          yield roundUsage === undefined
+            ? {type: 'stop', stopReason: 'tool_use'}
+            : {type: 'stop', stopReason: 'tool_use', usage: roundUsage};
+          return;
+        }
+        yield {type: 'text', text: 'completed'};
+        yield roundUsage === undefined
+          ? {type: 'stop', stopReason: 'end_turn'}
+          : {type: 'stop', stopReason: 'end_turn', usage: roundUsage};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    let toolExecutions = 0;
+    const registry = new ToolRegistry();
+    registry.register(
+      {name: 'fetchStep', description: 'Fetches one step.', inputSchema: {type: 'object'}},
+      async () => {
+        toolExecutions++;
+        return 'step-done';
+      }
+    );
+
+    let reported: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        reported = usage;
+      },
+    };
+
+    const session: ChatSession = {
+      sessionId: 's-usage',
+      userId: 'u-usage',
+      entries: [{role: 'user', content: 'run steps', timestamp: SENT_AT}],
+    };
+
+    const orchestrator = createChatOrchestrator(
+      provider,
+      new PromptBuilder({identity: 'Usage test assistant.'}),
+      registry,
+      {hooks}
+    );
+    await orchestrator.processMessage(session);
+
+    return {toolExecutions, reported};
+  };
+
+  it('sums usage across every provider call when a turn runs two tool rounds', async () => {
+    const turnOutcome = await runUsageTurn([
+      {inputTokens: 100, outputTokens: 20, totalTokens: 120},
+      {inputTokens: 230, outputTokens: 35, totalTokens: 265},
+      {inputTokens: 410, outputTokens: 50, totalTokens: 460},
+    ]);
+
+    expect(turnOutcome).toEqual({
+      toolExecutions: 2,
+      reported: {inputTokens: 740, outputTokens: 105, totalTokens: 845},
+    });
+  });
+
+  it('counts rounds that reported usage when other rounds omit it, and reports undefined when none did', async () => {
+    const partial = await runUsageTurn([
+      {inputTokens: 100, outputTokens: 20, totalTokens: 120},
+      undefined,
+      {inputTokens: 310, outputTokens: 45, totalTokens: 355},
+    ]);
+    const silent = await runUsageTurn([undefined, undefined]);
+
+    expect({partial: partial.reported, silent: silent.reported}).toEqual({
+      partial: {inputTokens: 410, outputTokens: 65, totalTokens: 475},
+      silent: undefined,
+    });
+  });
+});