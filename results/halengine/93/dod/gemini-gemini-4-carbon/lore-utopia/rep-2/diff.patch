+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const usageReportedFor = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let roundIndex = 0;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[roundIndex++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Reads reference rates.', inputSchema: {type: 'object'}},
+    async () => 'rate=42'
+  );
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _responseText, usage) => {
+      reported = usage;
+    },
+  };
+  const session: ChatSession = {
+    sessionId: 'turn-usage-session',
+    userId: 'deployer-1',
+    entries: [{role: 'user', content: 'Quote the rate.', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const orchestrator = createChatOrchestrator(
+    provider,
+    new PromptBuilder({identity: 'Usage test assistant.'}),
+    registry,
+    {hooks}
+  );
+  await orchestrator.processMessage(session);
+  return reported;
+};
+
+const toolRound = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id: 'call-lookup', name: 'lookup', input: {topic: 'rates'}}},
+  {type: 'stop', stopReason: 'tool_use', ...(usage ? {usage} : {})},
+];
+
+const answerRound = (text: string, usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text},
+  {type: 'stop', stopReason: 'end_turn', ...(usage ? {usage} : {})},
+];
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports the sum of every provider call across two tool rounds', async () => {
+    const reported = await usageReportedFor([
+      toolRound({inputTokens: 100, outputTokens: 12, totalTokens: 112}),
+      toolRound({inputTokens: 250, outputTokens: 23, totalTokens: 273}),
+      answerRound('The rate is 42.', {inputTokens: 400, outputTokens: 34, totalTokens: 434}),
+    ]);
+
+    expect(reported).toEqual({inputTokens: 750, outputTokens: 69, totalTokens: 819});
+  });
+
+  it('sums the rounds that reported usage when another omits it, and reports undefined when none did', async () => {
+    const partialTurn = await usageReportedFor([
+      toolRound({inputTokens: 120, outputTokens: 15, totalTokens: 135}),
+      toolRound(),
+      answerRound('The rate is 42.', {inputTokens: 80, outputTokens: 10, totalTokens: 90}),
+    ]);
+    const silentTurn = await usageReportedFor([toolRound(), answerRound('The rate is 42.')]);
+
+    expect({partialTurn, silentTurn}).toEqual({
+      partialTurn: {inputTokens: 200, outputTokens: 25, totalTokens: 225},
+      silentTurn: undefined,
+    });
+  });
+});