+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const stepChunks = (callIndex: number, totalCalls: number, usage?: UsageMetadata): MessageChunk[] => {
+  if (callIndex < totalCalls - 1) {
+    return [
+      {type: 'tool_use', toolCall: {id: `step-${callIndex}`, name: 'fetch_step', input: {}}},
+      {type: 'stop', stopReason: 'tool_use', usage},
+    ];
+  }
+  return [
+    {type: 'text', text: 'completed'},
+    {type: 'stop', stopReason: 'end_turn', usage},
+  ];
+};
+
+const runTurnWithRoundUsages = async (
+  roundUsages: Array<UsageMetadata | undefined>
+): Promise<UsageMetadata | undefined> => {
+  let callIndex = 0;
+  let reportedUsage: UsageMetadata | undefined;
+
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const current = callIndex++;
+      yield* stepChunks(current, roundUsages.length, roundUsages[current]);
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'fetch_step', description: 'fetches a step', inputSchema: {type: 'object'}},
+    async () => 'step_output'
+  );
+
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _responseText, usage) => {
+      reportedUsage = usage;
+    },
+  };
+
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Usage test.'}), registry, {
+    hooks,
+  });
+  const session: ChatSession = {
+    sessionId: 's-usage',
+    userId: 'u-usage',
+    entries: [{role: 'user', content: 'run steps', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+
+  await orchestrator.processMessage(session);
+  return reportedUsage;
+};
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports the sum of every provider call across two tool rounds', async () => {
+    const reportedUsage = await runTurnWithRoundUsages([
+      {inputTokens: 100, outputTokens: 15, totalTokens: 115},
+      {inputTokens: 210, outputTokens: 25, totalTokens: 235},
+      {inputTokens: 340, outputTokens: 45, totalTokens: 385},
+    ]);
+
+    expect(reportedUsage).toEqual({inputTokens: 650, outputTokens: 85, totalTokens: 735});
+  });
+
+  it('sums the rounds that reported usage and reports undefined when none did', async () => {
+    const partialTurn = await runTurnWithRoundUsages([
+      {inputTokens: 40, outputTokens: 10, totalTokens: 50},
+      undefined,
+      {inputTokens: 80, outputTokens: 20, totalTokens: 100},
+    ]);
+    const silentTurn = await runTurnWithRoundUsages([undefined, undefined]);
+
+    expect({partialTurn, silentTurn}).toEqual({
+      partialTurn: {inputTokens: 120, outputTokens: 30, totalTokens: 150},
+      silentTurn: undefined,
+    });
+  });
+});