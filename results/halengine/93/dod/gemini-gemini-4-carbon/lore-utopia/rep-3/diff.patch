+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// Drives one multi-round turn whose final round ends the loop and earlier rounds each invoke the registered tool.
+const usageReportedFor = async (roundUsages: Array<UsageMetadata | undefined>): Promise<UsageMetadata | undefined> => {
+  let callIndex = 0;
+  const finalCallIndex = roundUsages.length - 1;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const currentIndex = callIndex++;
+      const usage = roundUsages[currentIndex];
+      if (currentIndex < finalCallIndex) {
+        yield {type: 'tool_use', toolCall: {id: `call-${currentIndex}`, name: 'lookup', input: {}}};
+        yield usage === undefined
+          ? {type: 'stop', stopReason: 'tool_use'}
+          : {type: 'stop', stopReason: 'tool_use', usage};
+        return;
+      }
+      yield {type: 'text', text: 'answered'};
+      yield usage === undefined
+        ? {type: 'stop', stopReason: 'end_turn'}
+        : {type: 'stop', stopReason: 'end_turn', usage};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Looks up records.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+
+  let reportedUsage: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _responseText, usage) => {
+      reportedUsage = usage;
+    },
+  };
+
+  const session: ChatSession = {
+    sessionId: 'session-usage',
+    userId: 'user-usage',
+    entries: [{role: 'user', content: 'calculate total cost', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const orchestrator = createChatOrchestrator(
+    provider,
+    new PromptBuilder({identity: 'Usage accounting assistant.'}),
+    registry,
+    {hooks}
+  );
+  await orchestrator.processMessage(session);
+  return reportedUsage;
+};
+
+describe('ChatOrchestrator afterModelResponse usage across tool rounds', () => {
+  it('reports the sum of three provider calls when a turn runs two tool rounds', async () => {
+    const reportedUsage = await usageReportedFor([
+      {inputTokens: 100, outputTokens: 10, totalTokens: 110},
+      {inputTokens: 200, outputTokens: 20, totalTokens: 220},
+      {inputTokens: 300, outputTokens: 30, totalTokens: 330},
+    ]);
+
+    expect(reportedUsage).toEqual({
+      inputTokens: 600,
+      outputTokens: 60,
+      totalTokens: 660,
+    });
+  });
+
+  it('counts the rounds that reported usage when one round reports none, and reports undefined when none did', async () => {
+    const sparse = await usageReportedFor([
+      {inputTokens: 40, outputTokens: 8, totalTokens: 48},
+      undefined,
+      {inputTokens: 60, outputTokens: 12, totalTokens: 72},
+    ]);
+    const silent = await usageReportedFor([undefined, undefined]);
+
+    expect({sparse, silent}).toEqual({
+      sparse: {inputTokens: 100, outputTokens: 20, totalTokens: 120},
+      silent: undefined,
+    });
+  });
+});