+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {AIError} from '../types/ai.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const roundChunks = (callIndex: number, totalCalls: number, usage?: UsageMetadata): MessageChunk[] => {
+  if (callIndex < totalCalls - 1) {
+    return [
+      {type: 'tool_use', toolCall: {id: `call-${callIndex}`, name: 'lookup', input: {}}},
+      {type: 'stop', stopReason: 'tool_use', usage},
+    ];
+  }
+  return [
+    {type: 'text', text: 'Answer.'},
+    {type: 'stop', stopReason: 'end_turn', usage},
+  ];
+};
+
+describe('ChatOrchestrator afterModelResponse usage across tool rounds', () => {
+  const runTurn = async (roundUsages: Array<UsageMetadata | undefined>): Promise<Array<UsageMetadata | undefined>> => {
+    let callIndex = 0;
+    const provider: AIProvider = {
+      async *sendMessage() {
+        const index = callIndex++;
+        yield* roundChunks(index, roundUsages.length, roundUsages[index]);
+      },
+      async generateStructured(): Promise<never> {
+        throw new AIError('Structured output is not scripted in this test.', 'UNEXPECTED_CALL');
+      },
+    };
+
+    const registry = new ToolRegistry();
+    registry.register(
+      {name: 'lookup', description: 'Looks up a fact.', inputSchema: {type: 'object'}},
+      async () => 'found'
+    );
+
+    const reported: Array<UsageMetadata | undefined> = [];
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _responseText, usage) => void reported.push(usage),
+    };
+
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Usage test.'}), registry, {
+      hooks,
+    });
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'ask', timestamp: SENT_AT}],
+    };
+
+    await orchestrator.processMessage(session);
+    return reported;
+  };
+
+  it('reports summed usage across three provider calls in a two-tool-round turn', async () => {
+    const reported = await runTurn([
+      {inputTokens: 100, outputTokens: 10, totalTokens: 110},
+      {inputTokens: 200, outputTokens: 20, totalTokens: 220},
+      {inputTokens: 300, outputTokens: 30, totalTokens: 330},
+    ]);
+
+    expect(reported).toEqual([{inputTokens: 600, outputTokens: 60, totalTokens: 660}]);
+  });
+
+  it('sums reporting rounds when one omits usage and reports undefined when none did', async () => {
+    const partialTurn = await runTurn([
+      undefined,
+      {inputTokens: 7, outputTokens: 2, totalTokens: 9},
+      {inputTokens: 5, outputTokens: 1, totalTokens: 6},
+      undefined,
+    ]);
+    const silentTurn = await runTurn([undefined, undefined]);
+
+    expect({partialTurn, silentTurn}).toEqual({
+      partialTurn: [{inputTokens: 12, outputTokens: 3, totalTokens: 15}],
+      silentTurn: [undefined],
+    });
+  });
+});