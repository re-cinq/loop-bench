+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+
+const roundChunks = (usage: UsageMetadata | undefined, index: number, totalRounds: number): MessageChunk[] => {
+  const stopUsage = usage ? {usage} : {};
+  if (index < totalRounds - 1) {
+    return [
+      {type: 'tool_use', toolCall: {id: `round-${index}`, name: 'fetch_fact', input: {}}},
+      {type: 'stop', stopReason: 'tool_use', ...stopUsage},
+    ];
+  }
+  return [
+    {type: 'text', text: 'Answered.'},
+    {type: 'stop', stopReason: 'end_turn', ...stopUsage},
+  ];
+};
+
+const usageProvider = (roundUsages: Array<UsageMetadata | undefined>): AIProvider => {
+  let currentRound = 0;
+  return {
+    async *sendMessage() {
+      const index = currentRound++;
+      yield* roundChunks(roundUsages[index], index, roundUsages.length);
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const factRegistry = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'fetch_fact', description: 'Fetches a fact.', inputSchema: {type: 'object'}},
+    async () => 'ok'
+  );
+  return registry;
+};
+
+const reportedUsageFor = async (roundUsages: Array<UsageMetadata | undefined>): Promise<UsageMetadata | undefined> => {
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _responseText, usage) => {
+      reported = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(
+    usageProvider(roundUsages),
+    new PromptBuilder({identity: 'Usage test.'}),
+    factRegistry(),
+    {hooks}
+  );
+  await orchestrator.processMessage({
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'Question?', timestamp: '2026-01-01T00:00:00.000Z'}],
+  });
+  return reported;
+};
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('sums usage across every provider call when a turn runs two tool rounds', async () => {
+    const reported = await reportedUsageFor([
+      {inputTokens: 100, outputTokens: 10, totalTokens: 110},
+      {inputTokens: 200, outputTokens: 20, totalTokens: 220},
+      {inputTokens: 300, outputTokens: 30, totalTokens: 330},
+    ]);
+
+    expect(reported).toEqual({inputTokens: 600, outputTokens: 60, totalTokens: 660});
+  });
+
+  it('counts the rounds that reported usage when some omit it, and reports undefined when none did', async () => {
+    const partial = await reportedUsageFor([
+      {inputTokens: 40, outputTokens: 8, totalTokens: 48},
+      undefined,
+      {inputTokens: 60, outputTokens: 12, totalTokens: 72},
+    ]);
+    const unreported = await reportedUsageFor([undefined, undefined]);
+
+    expect({partial, unreported}).toEqual({
+      partial: {inputTokens: 100, outputTokens: 20, totalTokens: 120},
+      unreported: undefined,
+    });
+  });
+});