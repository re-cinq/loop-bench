+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {captureErrors} from '../shared/logCaptureTestSupport.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('afterModelResponse usage across tool rounds', () => {
+  captureErrors();
+
+  it('sums usage across every provider call in a turn driven through two tool rounds', async () => {
+    const reported = await usageReportedFor([
+      {inputTokens: 10, outputTokens: 4, totalTokens: 14},
+      {inputTokens: 25, outputTokens: 6, totalTokens: 31},
+      {inputTokens: 40, outputTokens: 9, totalTokens: 49},
+    ]);
+
+    expect(reported).toEqual({inputTokens: 75, outputTokens: 19, totalTokens: 94});
+  });
+
+  it('counts the rounds that reported usage when another round reports none, and reports undefined when no round reports usage', async () => {
+    const sparse = await usageReportedFor([
+      {inputTokens: 12, outputTokens: 5, totalTokens: 17},
+      undefined,
+      {inputTokens: 30, outputTokens: 8, totalTokens: 38},
+    ]);
+    const silent = await usageReportedFor([undefined, undefined]);
+
+    expect({sparse, silent}).toEqual({
+      sparse: {inputTokens: 42, outputTokens: 13, totalTokens: 55},
+      silent: undefined,
+    });
+  });
+});
+
+async function usageReportedFor(roundUsages: Array<UsageMetadata | undefined>): Promise<UsageMetadata | undefined> {
+  let callIndex = 0;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const current = callIndex++;
+      yield* chunksForRound(current, roundUsages.length, roundUsages[current]);
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('generateStructured is unused in stream tests');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register({name: 'fetchStep', description: 'Fetches one step.', inputSchema: {type: 'object'}}, async () => ({
+    result: 'step-result',
+  }));
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _responseText, usage) => {
+      reported = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(
+    provider,
+    new PromptBuilder({identity: 'Usage test assistant.'}),
+    registry,
+    {hooks}
+  );
+  const session: ChatSession = {
+    sessionId: 'session-usage',
+    userId: 'user-usage',
+    entries: [{role: 'user', content: 'run steps', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+
+  await orchestrator.processMessage(session);
+  return reported;
+}
+
+function chunksForRound(index: number, totalCalls: number, usage: UsageMetadata | undefined): MessageChunk[] {
+  if (index < totalCalls - 1) {
+    return [
+      {type: 'tool_use', toolCall: {id: `step-${index}`, name: 'fetchStep', input: {}}},
+      {type: 'stop', stopReason: 'tool_use', usage},
+    ];
+  }
+  return [
+    {type: 'text', text: 'complete'},
+    {type: 'stop', stopReason: 'end_turn', usage},
+  ];
+}