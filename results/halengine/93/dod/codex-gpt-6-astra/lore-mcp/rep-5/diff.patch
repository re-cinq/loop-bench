+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const first: UsageMetadata = {inputTokens: 11, outputTokens: 3, totalTokens: 14};
+const second: UsageMetadata = {inputTokens: 23, outputTokens: 5, totalTokens: 28};
+const final: UsageMetadata = {inputTokens: 37, outputTokens: 7, totalTokens: 44};
+
+async function recordTurns(turns: (UsageMetadata | undefined)[][]) {
+  const rounds: MessageChunk[][] = turns.flatMap(turn =>
+    turn.map((usage, index) => {
+      const last = index === turn.length - 1;
+      return [
+        last
+          ? {type: 'text', text: 'answer'}
+          : {type: 'tool_use', toolCall: {id: `call-${index}`, name: 'lookup', input: {}}},
+        {type: 'stop', stopReason: last ? 'end_turn' : 'tool_use', usage},
+      ];
+    })
+  );
+  let providerCalls = 0;
+  let toolCalls = 0;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const chunks = rounds[providerCalls++];
+      if (!chunks) throw new Error('Unexpected provider call beyond the scripted turn');
+      yield* chunks;
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured generation is not part of this conversation');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'Count lookups', inputSchema: {type: 'object'}}, async () => {
+    toolCalls++;
+    return {result: `Lookup ${toolCalls}`};
+  });
+  const reports: {text: string; usage: UsageMetadata | undefined}[] = [];
+  const orchestrator = createChatOrchestrator(
+    provider,
+    new PromptBuilder({identity: 'Answer the question.'}),
+    registry,
+    {
+      hooks: {
+        afterModelResponse: async (_session, text, usage) => {
+          reports.push({text, usage});
+        },
+      },
+    }
+  );
+  for (const [index] of turns.entries()) {
+    await orchestrator.processMessage({
+      sessionId: `session-${index}`,
+      userId: 'user',
+      entries: [{role: 'user', content: 'Look it up', timestamp: '2026-01-01T00:00:00.000Z'}],
+    });
+  }
+  return {providerCalls, toolCalls, reports};
+}
+
+// @spec specs/hal-engine-config-hooks/spec.md#8
+it('reports the sum of every provider call across two tool rounds once per turn', async () => {
+  const observed = await recordTurns([[first, second, final], [first]]);
+
+  expect(observed).toEqual({
+    providerCalls: 4,
+    toolCalls: 2,
+    reports: [
+      {text: 'answer', usage: {inputTokens: 71, outputTokens: 15, totalTokens: 86}},
+      {text: 'answer', usage: first},
+    ],
+  });
+});
+
+// @spec specs/hal-engine-config-hooks/spec.md#9
+it('sums reported rounds despite missing usage and leaves wholly unreported turns undefined', async () => {
+  const observed = await recordTurns([
+    [undefined, second, final],
+    [first, undefined, final],
+    [first, second, undefined],
+    [undefined, undefined, undefined],
+    [undefined],
+    [{inputTokens: 0, outputTokens: 0, totalTokens: 0}],
+  ]);
+
+  expect(observed).toEqual({
+    providerCalls: 14,
+    toolCalls: 8,
+    reports: [
+      {text: 'answer', usage: {inputTokens: 60, outputTokens: 12, totalTokens: 72}},
+      {text: 'answer', usage: {inputTokens: 48, outputTokens: 10, totalTokens: 58}},
+      {text: 'answer', usage: {inputTokens: 34, outputTokens: 8, totalTokens: 42}},
+      {text: 'answer', usage: undefined},
+      {text: 'answer', usage: undefined},
+      {text: 'answer', usage: {inputTokens: 0, outputTokens: 0, totalTokens: 0}},
+    ],
+  });
+});