+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const first: UsageMetadata = {inputTokens: 11, outputTokens: 2, totalTokens: 13};
+const second: UsageMetadata = {inputTokens: 23, outputTokens: 5, totalTokens: 28};
+const last: UsageMetadata = {inputTokens: 37, outputTokens: 7, totalTokens: 44};
+
+async function reportTurn(rounds: (UsageMetadata | undefined)[]) {
+  let providerCalls = 0;
+  const executed: number[] = [];
+  const reports: (UsageMetadata | undefined)[] = [];
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const index = providerCalls++;
+      if (index >= rounds.length) throw new Error('Unexpected provider call');
+      const callsTool = index < rounds.length - 1;
+      if (callsTool) {
+        yield {type: 'tool_use', toolCall: {id: `call-${index}`, name: 'double', input: {value: index + 1}}};
+      } else {
+        yield {type: 'text', text: 'done'};
+      }
+      yield {type: 'stop', stopReason: callsTool ? 'tool_use' : 'end_turn', usage: rounds[index]};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured generation is not part of this turn');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {
+      name: 'double',
+      description: 'Double a number',
+      inputSchema: {type: 'object', required: ['value'], properties: {value: {type: 'number'}}},
+    },
+    async input => {
+      const result = Number(input.value) * 2;
+      executed.push(result);
+      return String(result);
+    }
+  );
+  const session: ChatSession = {
+    sessionId: 'usage-session',
+    userId: 'usage-user',
+    entries: [{role: 'user', content: 'Double one and two', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Assistant'}), registry, {
+    hooks: {
+      afterModelResponse: async (_session, _text, usage) => {
+        reports.push(usage);
+      },
+    },
+  });
+  const text = await orchestrator.processMessage(session);
+  return {providerCalls, executed, reports, text};
+}
+
+// spec: specs/hal-engine-config-hooks/spec.md#9
+it('reports the sum of every provider call after two tool rounds', async () => {
+  const result = await reportTurn([first, second, last]);
+  expect(result).toEqual({
+    providerCalls: 3,
+    executed: [2, 4],
+    reports: [{inputTokens: 71, outputTokens: 14, totalTokens: 85}],
+    text: 'done',
+  });
+});
+
+// spec: specs/hal-engine-config-hooks/spec.md#10
+it('sums reported rounds across missing usage and preserves an entirely unreported turn', async () => {
+  const results = [];
+  for (const rounds of [
+    [undefined, first, second],
+    [first, undefined, second],
+    [first, second, undefined],
+    [undefined, undefined, undefined],
+  ]) {
+    results.push(await reportTurn(rounds));
+  }
+  const total = {inputTokens: 34, outputTokens: 7, totalTokens: 41};
+  expect(results).toEqual(
+    [total, total, total, undefined].map(usage => ({
+      providerCalls: 3,
+      executed: [2, 4],
+      reports: [usage],
+      text: 'done',
+    }))
+  );
+});