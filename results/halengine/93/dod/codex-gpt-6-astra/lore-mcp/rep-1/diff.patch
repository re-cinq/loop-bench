index 0000000..b0d35a1
--- /dev/null
+++ b/src/orchestration/chatOrchestrator.usage.acceptance.test.ts
@@ -0,0 +1,80 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const first = {inputTokens: 11, outputTokens: 3, totalTokens: 14};
+const second = {inputTokens: 23, outputTokens: 7, totalTokens: 30};
+const third = {inputTokens: 41, outputTokens: 13, totalTokens: 54};
+
+// The ticket's scripted provider supplies protocol values; orchestration and tool execution are real.
+async function reportTurn(rounds: (UsageMetadata | undefined)[]) {
+  let calls = 0;
+  const executions: unknown[] = [];
+  const reports: (UsageMetadata | undefined)[] = [];
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const round = calls++;
+      if (round >= rounds.length) throw new Error('Unexpected provider call');
+      if (round < rounds.length - 1) {
+        yield {type: 'tool_use', toolCall: {id: `call-${round}`, name: 'echo', input: {value: round}}};
+        yield {type: 'stop', stopReason: 'tool_use', usage: rounds[round]};
+        return;
+      }
+      yield {type: 'text', text: 'done'};
+      yield {type: 'stop', stopReason: 'end_turn', usage: rounds[round]};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured generation is outside this conversation');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register({name: 'echo', description: 'Echo a value', inputSchema: {type: 'object'}}, async input => {
+    executions.push(input.value);
+    return {result: JSON.stringify(input.value)};
+  });
+  const orchestrator = createChatOrchestrator(
+    provider,
+    new PromptBuilder({identity: 'Answer the question.'}),
+    registry,
+    {
+      hooks: {
+        afterModelResponse: async (_session, _text, usage) => {
+          reports.push(usage);
+        },
+      },
+    }
+  );
+  const response = await orchestrator.processMessage({
+    sessionId: 'usage-session',
+    userId: 'usage-user',
+    entries: [{role: 'user', content: 'Echo twice', timestamp: '2026-01-01T00:00:00.000Z'}],
+  });
+  return {calls, executions, response, reports};
+}
+
+// @spec specs/hal-engine-config-hooks/spec.md#9
+it('reports the sum of all three provider calls after two tool rounds', async () => {
+  expect(await reportTurn([first, second, third])).toEqual({
+    calls: 3,
+    executions: [0, 1],
+    response: 'done',
+    reports: [{inputTokens: 75, outputTokens: 23, totalTokens: 98}],
+  });
+});
+
+// @spec specs/hal-engine-config-hooks/spec.md#10
+it('sums reported rounds across missing usage and preserves wholly absent usage', async () => {
+  const results = [];
+  for (const rounds of [
+    [undefined, first, second],
+    [first, undefined, second],
+    [first, second, undefined],
+    [undefined, undefined, undefined],
+    [undefined],
+  ]) {
+    results.push((await reportTurn(rounds)).reports);
+  }
+  const sum = {inputTokens: 34, outputTokens: 10, totalTokens: 44};
+  expect(results).toEqual([[sum], [sum], [sum], [undefined], [undefined]]);
+});
