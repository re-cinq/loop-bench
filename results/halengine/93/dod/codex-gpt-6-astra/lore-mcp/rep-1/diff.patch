+  });
+
+  it('returns the accumulated total when the incoming usage is undefined', () => {
+    const u = {inputTokens: 5, outputTokens: 2, totalTokens: 7};
+    expect(accumulateUsage(u, undefined)).toEqual(u);
+  });
+
+  it('returns undefined when both are undefined', () => {
+    expect(accumulateUsage(undefined, undefined)).toBeUndefined();
+  });
+});
diff --git a/src/orchestration/orchestratorHelpers.ts b/src/orchestration/orchestratorHelpers.ts
index 717eb9a..2d1caa4 100644
--- a/src/orchestration/orchestratorHelpers.ts
+++ b/src/orchestration/orchestratorHelpers.ts
@@ -40,3 +40,16 @@ export function extractStopReason(chunk: MessageChunk): string | null {
 export function extractUsage(chunk: MessageChunk): UsageMetadata | undefined {
   return chunk.type === 'stop' ? chunk.usage : undefined;
 }
+
+export function accumulateUsage(
+  total: UsageMetadata | undefined,
+  incoming: UsageMetadata | undefined
+): UsageMetadata | undefined {
+  if (!total) return incoming;
+  if (!incoming) return total;
+  return {
+    inputTokens: total.inputTokens + incoming.inputTokens,
+    outputTokens: total.outputTokens + incoming.outputTokens,
+    totalTokens: total.totalTokens + incoming.totalTokens,
+  };
+}