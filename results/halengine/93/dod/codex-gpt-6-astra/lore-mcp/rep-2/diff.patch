--- /dev/null
+++ b/src/orchestration/chatOrchestrator.acceptance.test.ts
@@ -0,0 +1,97 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const FIRST: UsageMetadata = {inputTokens: 11, outputTokens: 3, totalTokens: 14};
+const SECOND: UsageMetadata = {inputTokens: 23, outputTokens: 5, totalTokens: 28};
+const FINAL: UsageMetadata = {inputTokens: 37, outputTokens: 7, totalTokens: 44};
+
+// The ticket's scripted provider drives the real orchestrator and real tool registry without replacing either.
+async function reportTurn(rounds: (UsageMetadata | undefined)[]) {
+  let providerCalls = 0;
+  const executed: number[] = [];
+  const reports: (UsageMetadata | undefined)[] = [];
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const round = providerCalls++;
+      if (round >= rounds.length) throw new Error('Unexpected provider call');
+      if (round < rounds.length - 1) {
+        yield {type: 'tool_use', toolCall: {id: `call-${round}`, name: 'double', input: {value: round + 1}}};
+        yield {type: 'stop', stopReason: 'tool_use', usage: rounds[round]};
+      } else {
+        yield {type: 'text', text: 'done'};
+        yield {type: 'stop', stopReason: 'end_turn', usage: rounds[round]};
+      }
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('This turn does not request structured output');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {
+      name: 'double',
+      description: 'Double a number',
+      inputSchema: {type: 'object', properties: {value: {type: 'number'}}, required: ['value']},
+    },
+    async input => {
+      const result = Number(input.value) * 2;
+      executed.push(result);
+      return String(result);
+    }
+  );
+  const orchestrator = createChatOrchestrator(
+    provider,
+    new PromptBuilder({identity: 'Use the double tool.'}),
+    registry,
+    {
+      hooks: {
+        afterModelResponse: async (_session, _text, usage) => {
+          reports.push(usage);
+        },
+      },
+    }
+  );
+  const text = await orchestrator.processMessage({
+    sessionId: 'usage-turn',
+    userId: 'usage-user',
+    entries: [{role: 'user', content: 'Double one and two.', timestamp: '2026-01-01T00:00:00.000Z'}],
+  });
+  return {providerCalls, executed, text, reports};
+}
+
+describe('afterModelResponse turn usage', () => {
+  // @spec specs/hal-engine-config-hooks/spec.md#9
+  it('sums usage from both tool rounds and the final provider call', async () => {
+    expect(await reportTurn([FIRST, SECOND, FINAL])).toEqual({
+      providerCalls: 3,
+      executed: [2, 4],
+      text: 'done',
+      reports: [{inputTokens: 71, outputTokens: 15, totalTokens: 86}],
+    });
+  });
+
+  // @spec specs/hal-engine-config-hooks/spec.md#10
+  it('sums reported rounds despite missing usage and preserves entirely absent usage', async () => {
+    const scripts = [
+      [undefined, SECOND, FINAL],
+      [FIRST, undefined, FINAL],
+      [FIRST, SECOND, undefined],
+      [undefined, undefined, undefined],
+      [undefined],
+      [FIRST],
+    ];
+    const reports = [];
+    for (const rounds of scripts) reports.push((await reportTurn(rounds)).reports);
+
+    expect(reports).toEqual([
+      [{inputTokens: 60, outputTokens: 12, totalTokens: 72}],
+      [{inputTokens: 48, outputTokens: 10, totalTokens: 58}],
+      [{inputTokens: 34, outputTokens: 8, totalTokens: 42}],
+      [undefined],
+      [undefined],
+      [FIRST],
+    ]);
+  });
+});