+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const FIRST: UsageMetadata = {inputTokens: 11, outputTokens: 3, totalTokens: 14};
+const SECOND: UsageMetadata = {inputTokens: 23, outputTokens: 7, totalTokens: 30};
+const FINAL: UsageMetadata = {inputTokens: 41, outputTokens: 13, totalTokens: 54};
+
+async function runTurns(turns: (UsageMetadata | undefined)[][]) {
+  const rounds = turns.flatMap(turn => turn.map((usage, index) => ({usage, callsTool: index < turn.length - 1})));
+  let providerCalls = 0;
+  const executed: number[] = [];
+  const reported: (UsageMetadata | undefined)[] = [];
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const round = rounds[providerCalls++];
+      if (!round) throw new Error('Unexpected provider call');
+      if (round.callsTool) {
+        yield {
+          type: 'tool_use',
+          toolCall: {id: `call-${providerCalls}`, name: 'double', input: {value: providerCalls}},
+        };
+      } else {
+        yield {type: 'text', text: 'done'};
+      }
+      yield {type: 'stop', stopReason: round.callsTool ? 'tool_use' : 'end_turn', usage: round.usage};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured output is not part of this turn');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {
+      name: 'double',
+      description: 'Double a number',
+      inputSchema: {type: 'object', properties: {value: {type: 'number'}}, required: ['value']},
+    },
+    async input => {
+      const value = Number(input.value) * 2;
+      executed.push(value);
+      return {result: String(value)};
+    }
+  );
+  const orchestrator = createChatOrchestrator(
+    provider,
+    new PromptBuilder({identity: 'Answer the question.'}),
+    registry,
+    {
+      hooks: {
+        afterModelResponse: async (_session, _text, usage) => {
+          reported.push(usage === undefined ? undefined : {...usage});
+        },
+      },
+    }
+  );
+  const responses: string[] = [];
+  for (const [index] of turns.entries()) {
+    responses.push(
+      await orchestrator.processMessage({
+        sessionId: `session-${index}`,
+        userId: 'user',
+        entries: [{role: 'user', content: 'Double the numbers.', timestamp: '2026-01-01T00:00:00.000Z'}],
+      })
+    );
+  }
+  return {reported, providerCalls, executed, responses};
+}
+
+// @spec specs/hal-engine-config-hooks/spec.md#9
+it('reports the sum of all three provider calls across two tool rounds', async () => {
+  expect(await runTurns([[FIRST, SECOND, FINAL]])).toEqual({
+    reported: [{inputTokens: 75, outputTokens: 23, totalTokens: 98}],
+    providerCalls: 3,
+    executed: [2, 4],
+    responses: ['done'],
+  });
+});
+
+// @spec specs/hal-engine-config-hooks/spec.md#10
+it('sums reported rounds despite missing usage and reports nothing when every round omits it', async () => {
+  const turns = [
+    [undefined, FIRST, SECOND],
+    [FIRST, undefined, SECOND],
+    [FIRST, SECOND, undefined],
+    [FIRST, undefined, undefined],
+    [undefined, FIRST, undefined],
+    [undefined, undefined, FIRST],
+    [undefined, undefined, undefined],
+  ];
+  const result = await runTurns(turns);
+  expect(result).toEqual({
+    reported: [
+      {inputTokens: 34, outputTokens: 10, totalTokens: 44},
+      {inputTokens: 34, outputTokens: 10, totalTokens: 44},
+      {inputTokens: 34, outputTokens: 10, totalTokens: 44},
+      FIRST,
+      FIRST,
+      FIRST,
+      undefined,
+    ],
+    providerCalls: 21,
+    executed: [2, 4, 8, 10, 14, 16, 20, 22, 26, 28, 32, 34, 38, 40],
+    responses: Array<string>(7).fill('done'),
+  });
+});