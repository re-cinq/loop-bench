+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const first = {inputTokens: 11, outputTokens: 2, totalTokens: 13};
+const second = {inputTokens: 23, outputTokens: 5, totalTokens: 28};
+const third = {inputTokens: 37, outputTokens: 7, totalTokens: 44};
+
+// The ticket's scripted provider emits one known usage value per real orchestrator round.
+async function runTurn(usages: (UsageMetadata | undefined)[]) {
+  let providerCalls = 0;
+  const executed: number[] = [];
+  const reported: (UsageMetadata | undefined)[] = [];
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const round = providerCalls++;
+      if (round >= usages.length) throw new Error('Unexpected provider call');
+      const hasTool = round < usages.length - 1;
+      if (hasTool) {
+        yield {type: 'tool_use', toolCall: {id: `call-${round}`, name: 'double', input: {value: round + 1}}};
+      } else {
+        yield {type: 'text', text: 'done'};
+      }
+      yield {type: 'stop', stopReason: hasTool ? 'tool_use' : 'end_turn', usage: usages[round]};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured generation is not part of this turn');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {
+      name: 'double',
+      description: 'Double a number',
+      inputSchema: {type: 'object', required: ['value'], properties: {value: {type: 'number'}}},
+    },
+    async input => {
+      const result = Number(input.value) * 2;
+      executed.push(result);
+      return String(result);
+    }
+  );
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Use the tools.'}), registry, {
+    hooks: {
+      afterModelResponse: async (_session, _text, usage) => {
+        reported.push(usage);
+      },
+    },
+  });
+  const response = await orchestrator.processMessage({
+    sessionId: 'usage-session',
+    userId: 'usage-user',
+    entries: [{role: 'user', content: 'Double 1 and 2.', timestamp: '2026-01-01T00:00:00.000Z'}],
+  });
+  return {providerCalls, executed, reported, response};
+}
+
+// @spec specs/hal-engine-config-hooks/spec.md#8
+it('reports the sum of all three provider calls after two tool rounds', async () => {
+  expect(await runTurn([first, second, third])).toEqual({
+    providerCalls: 3,
+    executed: [2, 4],
+    reported: [{inputTokens: 71, outputTokens: 14, totalTokens: 85}],
+    response: 'done',
+  });
+});
+
+// @spec specs/hal-engine-config-hooks/spec.md#9
+it('sums reported rounds around missing usage and leaves wholly unreported turns undefined', async () => {
+  const observed = [];
+  for (const usages of [
+    [undefined, first, second],
+    [first, undefined, second],
+    [first, second, undefined],
+    [undefined, undefined, undefined],
+    [first],
+    [undefined],
+  ]) {
+    observed.push((await runTurn(usages)).reported);
+  }
+  const total = {inputTokens: 34, outputTokens: 7, totalTokens: 41};
+  expect(observed).toEqual([[total], [total], [total], [undefined], [first], [undefined]]);
+});