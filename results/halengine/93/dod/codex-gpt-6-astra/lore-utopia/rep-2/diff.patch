+++ b/src/orchestration/chatOrchestrator.usage.acceptance.test.ts
@@ -0,0 +1,96 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const FIRST: UsageMetadata = {inputTokens: 11, outputTokens: 3, totalTokens: 14};
+const SECOND: UsageMetadata = {inputTokens: 23, outputTokens: 5, totalTokens: 28};
+const FINAL: UsageMetadata = {inputTokens: 37, outputTokens: 7, totalTokens: 44};
+
+// The ticket explicitly calls for scripted provider rounds; only the provider's input data is scripted.
+async function reportTurn(rounds: (UsageMetadata | undefined)[]) {
+  let providerCalls = 0;
+  const toolInputs: number[] = [];
+  const reports: (UsageMetadata | undefined)[] = [];
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const round = providerCalls++;
+      if (round >= rounds.length) throw new Error('Unexpected provider call');
+      const usage = rounds[round];
+      if (round < rounds.length - 1) {
+        yield {type: 'tool_use', toolCall: {id: `call-${round}`, name: 'double', input: {value: round}}};
+        yield {type: 'stop', stopReason: 'tool_use', usage};
+      } else {
+        yield {type: 'text', text: 'done'};
+        yield {type: 'stop', stopReason: 'end_turn', usage};
+      }
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured output is not part of this turn');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {
+      name: 'double',
+      description: 'Double a number',
+      inputSchema: {type: 'object', properties: {value: {type: 'number'}}, required: ['value']},
+    },
+    async input => {
+      const value = Number(input.value);
+      toolInputs.push(value);
+      return String(value * 2);
+    }
+  );
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Use the tools.'}), registry, {
+    hooks: {
+      afterModelResponse: async (_session, _text, usage) => {
+        reports.push(usage);
+      },
+    },
+  });
+  const text = await orchestrator.processMessage({
+    sessionId: 'usage-acceptance',
+    userId: 'user',
+    entries: [{role: 'user', content: 'Double two numbers', timestamp: '2026-01-01T00:00:00.000Z'}],
+  });
+  return {providerCalls, toolInputs, reports, text};
+}
+
+// @spec specs/hal-engine-config-hooks/spec.md#10
+it('reports the sum of all three provider calls after two tool rounds', async () => {
+  const result = await reportTurn([FIRST, SECOND, FINAL]);
+
+  expect(result).toEqual({
+    providerCalls: 3,
+    toolInputs: [0, 1],
+    reports: [{inputTokens: 71, outputTokens: 15, totalTokens: 86}],
+    text: 'done',
+  });
+});
+
+// @spec specs/hal-engine-config-hooks/spec.md#11
+it('sums reported rounds despite missing usage and preserves absent and single-call usage', async () => {
+  const cases = [
+    [FIRST, undefined, FINAL],
+    [undefined, FIRST, FINAL],
+    [FIRST, FINAL, undefined],
+    [undefined, undefined, undefined],
+    [undefined],
+    [FIRST],
+    [{inputTokens: 0, outputTokens: 0, totalTokens: 0}],
+  ];
+  const reports = [];
+  for (const rounds of cases) reports.push((await reportTurn(rounds)).reports);
+
+  const sum = {inputTokens: 48, outputTokens: 10, totalTokens: 58};
+  expect(reports).toEqual([
+    [sum],
+    [sum],
+    [sum],
+    [undefined],
+    [undefined],
+    [FIRST],
+    [{inputTokens: 0, outputTokens: 0, totalTokens: 0}],
+  ]);
+});