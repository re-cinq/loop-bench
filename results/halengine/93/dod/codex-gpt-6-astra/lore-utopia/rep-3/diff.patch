+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const first = {inputTokens: 11, outputTokens: 3, totalTokens: 14};
+const second = {inputTokens: 23, outputTokens: 5, totalTokens: 28};
+const final = {inputTokens: 37, outputTokens: 7, totalTokens: 44};
+
+async function runTurn(rounds: (UsageMetadata | undefined)[]) {
+  let providerCalls = 0;
+  const toolInputs: unknown[] = [];
+  const reports: (UsageMetadata | undefined)[] = [];
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const round = providerCalls++;
+      if (round >= rounds.length) throw new Error('Unexpected provider call');
+      if (round < rounds.length - 1) {
+        yield {type: 'tool_use', toolCall: {id: `call-${round}`, name: 'double', input: {value: round + 1}}};
+        yield {type: 'stop', stopReason: 'tool_use', usage: rounds[round]};
+      } else {
+        yield {type: 'text', text: 'done'};
+        yield {type: 'stop', stopReason: 'end_turn', usage: rounds[round]};
+      }
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured output is not part of this turn');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {
+      name: 'double',
+      description: 'Double a number',
+      inputSchema: {type: 'object', properties: {value: {type: 'number'}}, required: ['value']},
+    },
+    async input => {
+      toolInputs.push(input.value);
+      return String(Number(input.value) * 2);
+    }
+  );
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Calculate.'}), registry, {
+    maxToolRounds: 2,
+    hooks: {
+      afterModelResponse: async (_session, _text, usage) => {
+        reports.push(usage);
+      },
+    },
+  });
+  const response = await orchestrator.processMessage({
+    sessionId: 'usage-session',
+    userId: 'usage-user',
+    entries: [{role: 'user', content: 'Double 1 and 2.', timestamp: '2026-01-01T00:00:00.000Z'}],
+  });
+  return {response, providerCalls, toolInputs, reports};
+}
+
+// spec: specs/hal-engine-config-hooks/spec.md#9
+it('reports the sum of all three provider calls after two tool rounds', async () => {
+  expect(await runTurn([first, second, final])).toEqual({
+    response: 'done',
+    providerCalls: 3,
+    toolInputs: [1, 2],
+    reports: [{inputTokens: 71, outputTokens: 15, totalTokens: 86}],
+  });
+});
+
+// spec: specs/hal-engine-config-hooks/spec.md#10
+it('counts reported rounds despite missing usage and preserves wholly absent usage', async () => {
+  const cases = [
+    [undefined, first, second],
+    [first, undefined, second],
+    [first, second, undefined],
+    [undefined, undefined, undefined],
+    [undefined],
+    [{inputTokens: 0, outputTokens: 0, totalTokens: 0}],
+  ];
+  const reports = [];
+  for (const rounds of cases) reports.push((await runTurn(rounds)).reports);
+  const total = {inputTokens: 34, outputTokens: 8, totalTokens: 42};
+  expect(reports).toEqual([
+    [total],
+    [total],
+    [total],
+    [undefined],
+    [undefined],
+    [{inputTokens: 0, outputTokens: 0, totalTokens: 0}],
+  ]);
+});