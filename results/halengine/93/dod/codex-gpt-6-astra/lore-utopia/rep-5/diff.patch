+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const FIRST = {inputTokens: 11, outputTokens: 3, totalTokens: 14};
+const SECOND = {inputTokens: 23, outputTokens: 5, totalTokens: 28};
+const FINAL = {inputTokens: 37, outputTokens: 7, totalTokens: 44};
+
+// The ticket explicitly calls for a scripted provider; the orchestrator and tool registry run unchanged.
+async function runTurn(rounds: (UsageMetadata | undefined)[]) {
+  let providerCalls = 0;
+  const executed: number[] = [];
+  const reported: (UsageMetadata | undefined)[] = [];
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const round = providerCalls++;
+      if (round >= rounds.length) throw new Error('Provider script exhausted');
+      const needsTool = round < rounds.length - 1;
+      if (needsTool) {
+        yield {type: 'tool_use', toolCall: {id: `call-${round}`, name: 'double', input: {value: round + 1}}};
+      } else {
+        yield {type: 'text', text: 'Done'};
+      }
+      yield {type: 'stop', stopReason: needsTool ? 'tool_use' : 'end_turn', usage: rounds[round]};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured output is outside this provider script');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {
+      name: 'double',
+      description: 'Double a number',
+      inputSchema: {type: 'object', properties: {value: {type: 'number'}}, required: ['value']},
+    },
+    async input => {
+      const result = Number(input.value) * 2;
+      executed.push(result);
+      return String(result);
+    }
+  );
+  const session: ChatSession = {
+    sessionId: 'usage-turn',
+    userId: 'usage-user',
+    entries: [{role: 'user', content: 'Double one and two', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Calculate'}), registry, {
+    hooks: {
+      afterModelResponse: async (_session, _text, usage) => {
+        reported.push(usage);
+      },
+    },
+  });
+  const text = await orchestrator.processMessage(session);
+  return {text, providerCalls, executed, reported};
+}
+
+// spec: specs/hal-engine-config-hooks/spec.md#9
+it('reports the sum of every provider call across two tool rounds', async () => {
+  const result = await runTurn([FIRST, SECOND, FINAL]);
+  expect(result).toEqual({
+    text: 'Done',
+    providerCalls: 3,
+    executed: [2, 4],
+    reported: [{inputTokens: 71, outputTokens: 15, totalTokens: 86}],
+  });
+});
+
+// spec: specs/hal-engine-config-hooks/spec.md#10
+it('counts reported rounds when usage is missing and preserves absent usage', async () => {
+  const scripts = [
+    [undefined, SECOND, FINAL],
+    [FIRST, undefined, FINAL],
+    [FIRST, SECOND, undefined],
+    [undefined, undefined, undefined],
+    [undefined],
+    [FIRST],
+  ];
+  const reports = [];
+  for (const script of scripts) reports.push((await runTurn(script)).reported);
+  expect(reports).toEqual([
+    [{inputTokens: 60, outputTokens: 12, totalTokens: 72}],
+    [{inputTokens: 48, outputTokens: 10, totalTokens: 58}],
+    [{inputTokens: 34, outputTokens: 8, totalTokens: 42}],
+    [undefined],
+    [undefined],
+    [FIRST],
+  ]);
+});