+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+
+const first: UsageMetadata = {inputTokens: 11, outputTokens: 3, totalTokens: 14};
+const second: UsageMetadata = {inputTokens: 23, outputTokens: 5, totalTokens: 28};
+const final: UsageMetadata = {inputTokens: 37, outputTokens: 7, totalTokens: 44};
+
+// Scripted provider input at the public AIProvider seam, as required by #93.
+async function runTurn(rounds: (UsageMetadata | undefined)[]) {
+  let providerCalls = 0;
+  const executed: number[] = [];
+  const received: (UsageMetadata | undefined)[] = [];
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const round = providerCalls++;
+      if (round >= rounds.length) throw new Error('Unexpected provider call beyond the script');
+      const usage = rounds[round];
+      if (round < rounds.length - 1) {
+        yield {type: 'tool_use', toolCall: {id: `call-${round}`, name: 'square', input: {value: round + 2}}};
+        yield {type: 'stop', stopReason: 'tool_use', usage};
+      } else {
+        yield {type: 'text', text: 'Finished'};
+        yield {type: 'stop', stopReason: 'end_turn', usage};
+      }
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured output is not part of this turn');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {
+      name: 'square',
+      description: 'Square a number',
+      inputSchema: {type: 'object', properties: {value: {type: 'number'}}, required: ['value']},
+    },
+    async input => {
+      const result = Number(input.value) ** 2;
+      executed.push(result);
+      return String(result);
+    }
+  );
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Calculate squares.'}), registry, {
+    hooks: {
+      afterModelResponse: async (_session, _text, usage) => {
+        received.push(usage);
+      },
+    },
+  });
+  const text = await orchestrator.processMessage({
+    sessionId: 'usage-session',
+    userId: 'usage-user',
+    entries: [{role: 'user', content: 'Square two and three.', timestamp: '2026-01-01T00:00:00.000Z'}],
+  });
+  return {providerCalls, executed, received, text};
+}
+
+// @spec specs/hal-engine-config-hooks/spec.md#9
+it('reports the sum of every provider call after two tool rounds', async () => {
+  expect(await runTurn([first, second, final])).toEqual({
+    providerCalls: 3,
+    executed: [4, 9],
+    received: [{inputTokens: 71, outputTokens: 15, totalTokens: 86}],
+    text: 'Finished',
+  });
+});
+
+// @spec specs/hal-engine-config-hooks/spec.md#10
+it('sums reported rounds when usage is missing and preserves absent usage when none report', async () => {
+  const scripts = [
+    [undefined, second, final],
+    [first, undefined, final],
+    [first, second, undefined],
+    [undefined, undefined, undefined],
+    [undefined, {inputTokens: 0, outputTokens: 0, totalTokens: 0}, undefined],
+  ];
+  const results = [];
+  for (const rounds of scripts) results.push((await runTurn(rounds)).received);
+
+  expect(results).toEqual([
+    [{inputTokens: 60, outputTokens: 12, totalTokens: 72}],
+    [{inputTokens: 48, outputTokens: 10, totalTokens: 58}],
+    [{inputTokens: 34, outputTokens: 8, totalTokens: 42}],
+    [undefined],
+    [{inputTokens: 0, outputTokens: 0, totalTokens: 0}],
+  ]);
+});