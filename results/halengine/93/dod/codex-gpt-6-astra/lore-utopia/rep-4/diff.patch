+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+
+const first = {inputTokens: 11, outputTokens: 2, totalTokens: 13};
+const second = {inputTokens: 23, outputTokens: 5, totalTokens: 28};
+const last = {inputTokens: 37, outputTokens: 7, totalTokens: 44};
+
+// A finite provider script supplies real stream chunks through the public provider boundary.
+async function runTurn(rounds: (UsageMetadata | undefined)[]) {
+  let providerCalls = 0;
+  const executed: number[] = [];
+  const reports: (UsageMetadata | undefined)[] = [];
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const round = providerCalls++;
+      if (round >= rounds.length) throw new Error('Provider script exhausted');
+      if (round < rounds.length - 1) {
+        yield {type: 'tool_use', toolCall: {id: `call-${round}`, name: 'square', input: {value: round + 2}}};
+      } else {
+        yield {type: 'text', text: 'Finished'};
+      }
+      yield {type: 'stop', stopReason: round < rounds.length - 1 ? 'tool_use' : 'end_turn', usage: rounds[round]};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('This script supports streaming turns only');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {
+      name: 'square',
+      description: 'Square a number',
+      inputSchema: {type: 'object', properties: {value: {type: 'number'}}, required: ['value']},
+    },
+    async input => {
+      const value = Number(input.value);
+      executed.push(value);
+      return String(value * value);
+    }
+  );
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Calculate squares.'}), registry, {
+    hooks: {
+      afterModelResponse: async (_session, _text, usage) => {
+        reports.push(usage);
+      },
+    },
+  });
+  const text = await orchestrator.processMessage({
+    sessionId: 'usage-session',
+    userId: 'usage-user',
+    entries: [{role: 'user', content: 'Square two and three.', timestamp: '2026-01-01T00:00:00.000Z'}],
+  });
+  return {providerCalls, executed, reports, text};
+}
+
+// @spec specs/hal-engine-config-hooks/spec.md#9
+it('reports the sum of every provider call after two tool rounds', async () => {
+  expect(await runTurn([first, second, last])).toEqual({
+    providerCalls: 3,
+    executed: [2, 3],
+    reports: [{inputTokens: 71, outputTokens: 14, totalTokens: 85}],
+    text: 'Finished',
+  });
+});
+
+// @spec specs/hal-engine-config-hooks/spec.md#10
+it('sums reported rounds despite missing usage and preserves an entirely unreported turn', async () => {
+  const scripts = [
+    [undefined, second, last],
+    [first, undefined, last],
+    [first, second, undefined],
+    [undefined, undefined, undefined],
+  ];
+  const results = [];
+  for (const script of scripts) results.push(await runTurn(script));
+  expect(results).toEqual(
+    [
+      {inputTokens: 60, outputTokens: 12, totalTokens: 72},
+      {inputTokens: 48, outputTokens: 9, totalTokens: 57},
+      {inputTokens: 34, outputTokens: 7, totalTokens: 41},
+      undefined,
+    ].map(usage => ({providerCalls: 3, executed: [2, 3], reports: [usage], text: 'Finished'}))
+  );
+});