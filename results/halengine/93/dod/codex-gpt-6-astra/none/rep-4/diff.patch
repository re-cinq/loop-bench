+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const FIRST: UsageMetadata = {inputTokens: 11, outputTokens: 3, totalTokens: 14};
+const SECOND: UsageMetadata = {inputTokens: 23, outputTokens: 5, totalTokens: 28};
+const LAST: UsageMetadata = {inputTokens: 37, outputTokens: 7, totalTokens: 44};
+
+async function reportTurn(rounds: (UsageMetadata | undefined)[]) {
+  let providerCalls = 0;
+  let toolCalls = 0;
+  const reports: (UsageMetadata | undefined)[] = [];
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const index = providerCalls++;
+      if (index >= rounds.length) throw new Error('Unexpected provider call');
+      const more = index < rounds.length - 1;
+      if (more) yield {type: 'tool_use', toolCall: {id: `call-${index}`, name: 'add', input: {left: index, right: 1}}};
+      else yield {type: 'text', text: 'done'};
+      yield {type: 'stop', stopReason: more ? 'tool_use' : 'end_turn', usage: rounds[index]};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured output is not part of this turn');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {
+      name: 'add',
+      description: 'Add two numbers',
+      inputSchema: {
+        type: 'object',
+        properties: {left: {type: 'number'}, right: {type: 'number'}},
+        required: ['left', 'right'],
+      },
+    },
+    async input => {
+      toolCalls++;
+      return {result: String(Number(input.left) + Number(input.right))};
+    }
+  );
+  const orchestrator = createChatOrchestrator(
+    provider,
+    new PromptBuilder({identity: 'Use add to calculate.'}),
+    registry,
+    {
+      hooks: {
+        afterModelResponse: async (_session, _text, usage) => {
+          reports.push(usage);
+        },
+      },
+    }
+  );
+  const text = await orchestrator.processMessage({
+    sessionId: 'usage-turn',
+    userId: 'usage-user',
+    entries: [{role: 'user', content: 'Calculate using tools.', timestamp: '2026-01-01T00:00:00.000Z'}],
+  });
+  return {providerCalls, toolCalls, text, reports};
+}
+
+// @spec specs/hal-engine-config-hooks/spec.md#9
+it('reports the sum of all three provider calls after two tool rounds', async () => {
+  expect(await reportTurn([FIRST, SECOND, LAST])).toEqual({
+    providerCalls: 3,
+    toolCalls: 2,
+    text: 'done',
+    reports: [{inputTokens: 71, outputTokens: 15, totalTokens: 86}],
+  });
+});
+
+// @spec specs/hal-engine-config-hooks/spec.md#10
+it('sums reported rounds despite missing usage and preserves wholly absent usage', async () => {
+  const cases = [
+    [undefined, FIRST, LAST],
+    [FIRST, undefined, LAST],
+    [FIRST, LAST, undefined],
+    [undefined, undefined, undefined],
+    [undefined],
+    [FIRST],
+  ];
+  const results = [];
+  for (const rounds of cases) results.push((await reportTurn(rounds)).reports);
+
+  const sum = {inputTokens: 48, outputTokens: 10, totalTokens: 58};
+  expect(results).toEqual([[sum], [sum], [sum], [undefined], [undefined], [FIRST]]);
+});