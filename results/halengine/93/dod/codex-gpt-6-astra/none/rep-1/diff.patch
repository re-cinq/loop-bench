diff --git a/src/orchestration/chatOrchestrator.usage.acceptance.test.ts b/src/orchestration/chatOrchestrator.usage.acceptance.test.ts
new file mode 100644
index 0000000..d4e9a58
--- /dev/null
+++ b/src/orchestration/chatOrchestrator.usage.acceptance.test.ts
@@ -0,0 +1,79 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const first = Object.freeze({inputTokens: 11, outputTokens: 3, totalTokens: 14});
+const second = Object.freeze({inputTokens: 23, outputTokens: 7, totalTokens: 30});
+const last = Object.freeze({inputTokens: 41, outputTokens: 13, totalTokens: 54});
+
+// spec: specs/hal-engine-config-hooks/spec.md#9
+it('reports the sum of every provider call per turn, preserving absent usage and direct replies', async () => {
+  const turns: (UsageMetadata | undefined)[][] = [
+    [first, second, last],
+    [first, undefined, last],
+    [first, second, undefined],
+    [undefined, second, last],
+    [undefined, undefined, undefined],
+    [last],
+  ];
+  const script = turns.flatMap(turn => turn.map((usage, index) => ({usage, requestsTool: index < turn.length - 1})));
+  let providerCalls = 0;
+  let executedTools = 0;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const round = script[providerCalls++];
+      if (!round) throw new Error('Unexpected provider call beyond the scripted turns');
+      if (round.requestsTool) {
+        yield {type: 'tool_use', toolCall: {id: `call-${providerCalls}`, name: 'increment', input: {}}};
+      }
+      if (!round.requestsTool) {
+        yield {type: 'text', text: 'done'};
+      }
+      yield {type: 'stop', stopReason: round.requestsTool ? 'tool_use' : 'end_turn', usage: round.usage};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured output is not part of this conversation');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'increment', description: 'Increment the counter', inputSchema: {type: 'object'}},
+    async () => ({result: String(++executedTools)})
+  );
+  const reports: {text: string; usage: UsageMetadata | undefined}[] = [];
+  const orchestrator = createChatOrchestrator(
+    provider,
+    new PromptBuilder({identity: 'Count tool executions.'}),
+    registry,
+    {
+      hooks: {
+        afterModelResponse: async (_session, text, usage) => {
+          reports.push({text, usage});
+        },
+      },
+    }
+  );
+  for (let index = 0; index < turns.length; index++) {
+    const session: ChatSession = {
+      sessionId: `turn-${index}`,
+      userId: 'usage-consumer',
+      entries: [{role: 'user', content: 'Count twice then answer.', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    await orchestrator.processMessage(session);
+  }
+
+  expect({providerCalls, executedTools, reports}).toEqual({
+    providerCalls: 16,
+    executedTools: 10,
+    reports: [
+      {text: 'done', usage: {inputTokens: 75, outputTokens: 23, totalTokens: 98}},
+      {text: 'done', usage: {inputTokens: 52, outputTokens: 16, totalTokens: 68}},
+      {text: 'done', usage: {inputTokens: 34, outputTokens: 10, totalTokens: 44}},
+      {text: 'done', usage: {inputTokens: 64, outputTokens: 20, totalTokens: 84}},
+      {text: 'done', usage: undefined},
+      {text: 'done', usage: last},
+    ],
+  });
+});
diff --git a/src/orchestration/orchestratorHelpers.ts b/src/orchestration/orchestratorHelpers.ts
index 717eb9a..2ed3dc1 100644
--- a/src/orchestration/orchestratorHelpers.ts
+++ b/src/orchestration/orchestratorHelpers.ts
@@ -40,3 +40,16 @@ export function extractStopReason(chunk: MessageChunk): string | null {
 export function extractUsage(chunk: MessageChunk): UsageMetadata | undefined {
   return chunk.type === 'stop' ? chunk.usage : undefined;
 }
+
+export function accumulateUsage(
+  acc: UsageMetadata | undefined,
+  next: UsageMetadata | undefined
+): UsageMetadata | undefined {
+  if (!acc) return next;
+  if (!next) return acc;
+  return {
+    inputTokens: acc.inputTokens + next.inputTokens,
+    outputTokens: acc.outputTokens + next.outputTokens,
+    totalTokens: acc.totalTokens + next.totalTokens,
+  };
+}