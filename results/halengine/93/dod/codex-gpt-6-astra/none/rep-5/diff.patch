@@ -0,0 +1,98 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+// The ticket explicitly calls for a scripted provider; orchestration and tool execution remain real.
+async function reportTurns(turns: (UsageMetadata | undefined)[][]) {
+  let turn = 0;
+  let round = 0;
+  let providerCalls = 0;
+  const toolResults: number[] = [];
+  const reports: (UsageMetadata | undefined)[] = [];
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const usages = turns[turn];
+      const current = round++;
+      providerCalls++;
+      if (current < usages.length - 1) {
+        yield {type: 'tool_use', toolCall: {id: `${turn}-${current}`, name: 'add', input: {a: current, b: 1}}};
+        yield {type: 'stop', stopReason: 'tool_use', usage: usages[current]};
+      } else {
+        yield {type: 'text', text: 'done'};
+        yield {type: 'stop', stopReason: 'end_turn', usage: usages[current]};
+      }
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('This conversation uses streaming responses only');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {
+      name: 'add',
+      description: 'Add two numbers',
+      inputSchema: {type: 'object', properties: {a: {type: 'number'}, b: {type: 'number'}}, required: ['a', 'b']},
+    },
+    async input => {
+      const sum = Number(input.a) + Number(input.b);
+      toolResults.push(sum);
+      return {result: String(sum)};
+    }
+  );
+  const orchestrator = createChatOrchestrator(
+    provider,
+    new PromptBuilder({identity: 'Answer using addition.'}),
+    registry,
+    {
+      hooks: {
+        afterModelResponse: async (_session, _text, usage) => {
+          reports.push(usage);
+        },
+      },
+    }
+  );
+  for (turn = 0; turn < turns.length; turn++) {
+    round = 0;
+    await orchestrator.processMessage({
+      sessionId: `session-${turn}`,
+      userId: 'user',
+      entries: [{role: 'user', content: 'Add the numbers', timestamp: '2026-01-01T00:00:00.000Z'}],
+    });
+  }
+  return {reports, providerCalls, toolResults};
+}
+
+const first: UsageMetadata = {inputTokens: 11, outputTokens: 2, totalTokens: 13};
+const second: UsageMetadata = {inputTokens: 23, outputTokens: 5, totalTokens: 28};
+const final: UsageMetadata = {inputTokens: 37, outputTokens: 7, totalTokens: 44};
+
+// spec: specs/hal-engine-config-hooks/spec.md#10
+it('reports the sum of all three provider calls after two tool rounds', async () => {
+  expect(await reportTurns([[first, second, final]])).toEqual({
+    reports: [{inputTokens: 71, outputTokens: 14, totalTokens: 85}],
+    providerCalls: 3,
+    toolResults: [1, 2],
+  });
+});
+
+// spec: specs/hal-engine-config-hooks/spec.md#11
+it('sums reported rounds around missing usage and leaves wholly unreported turns undefined', async () => {
+  expect(
+    await reportTurns([
+      [first, undefined, final],
+      [undefined, first, final],
+      [first, final, undefined],
+      [undefined, undefined, undefined],
+    ])
+  ).toEqual({
+    reports: [
+      {inputTokens: 48, outputTokens: 9, totalTokens: 57},
+      {inputTokens: 48, outputTokens: 9, totalTokens: 57},
+      {inputTokens: 48, outputTokens: 9, totalTokens: 57},
+      undefined,
+    ],
+    providerCalls: 12,
+    toolResults: [1, 2, 1, 2, 1, 2, 1, 2],
+  });
+});