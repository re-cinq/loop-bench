+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const first: UsageMetadata = {inputTokens: 11, outputTokens: 3, totalTokens: 14};
+const second: UsageMetadata = {inputTokens: 23, outputTokens: 7, totalTokens: 30};
+const third: UsageMetadata = {inputTokens: 41, outputTokens: 13, totalTokens: 54};
+
+async function reportTurns(turns: (UsageMetadata | undefined)[][]) {
+  const rounds = turns.flatMap(turn => turn.map((usage, index) => ({usage, callsTool: index < turn.length - 1})));
+  let providerCalls = 0;
+  let toolCalls = 0;
+  const reports: (UsageMetadata | undefined)[] = [];
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const round = rounds[providerCalls++];
+      if (!round) throw new Error('Unexpected provider call beyond the scripted turn');
+      if (round.callsTool) {
+        yield {type: 'tool_use', toolCall: {id: `call-${providerCalls}`, name: 'count', input: {}}};
+      } else {
+        yield {type: 'text', text: 'done'};
+      }
+      yield {type: 'stop', stopReason: round.callsTool ? 'tool_use' : 'end_turn', usage: round.usage};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured generation is not part of a chat turn');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register({name: 'count', description: 'Count calls', inputSchema: {type: 'object'}}, async () => {
+    toolCalls++;
+    return {result: String(toolCalls)};
+  });
+  const orchestrator = createChatOrchestrator(
+    provider,
+    new PromptBuilder({identity: 'Answer the question.'}),
+    registry,
+    {
+      hooks: {
+        afterModelResponse: async (_session, _text, usage) => {
+          reports.push(usage === undefined ? undefined : {...usage});
+        },
+      },
+    }
+  );
+  for (const [index] of turns.entries()) {
+    await orchestrator.processMessage({
+      sessionId: `session-${index}`,
+      userId: 'user',
+      entries: [{role: 'user', content: 'Count twice', timestamp: '2026-01-01T00:00:00.000Z'}],
+    });
+  }
+  return {reports, providerCalls, toolCalls};
+}
+
+describe('afterModelResponse turn usage', () => {
+  // spec: specs/hal-engine-config-hooks/spec.md#8
+  it('reports the sum of every provider call across two tool rounds', async () => {
+    const observed = await reportTurns([[first, second, third]]);
+
+    expect(observed).toEqual({
+      reports: [{inputTokens: 75, outputTokens: 23, totalTokens: 98}],
+      providerCalls: 3,
+      toolCalls: 2,
+    });
+  });
+
+  // spec: specs/hal-engine-config-hooks/spec.md#9
+  it('counts reported rounds around missing usage and reports nothing for an unmetered turn', async () => {
+    const observed = await reportTurns([
+      [undefined, first, third],
+      [first, undefined, third],
+      [first, third, undefined],
+      [undefined, undefined, undefined],
+    ]);
+
+    expect(observed).toEqual({
+      reports: [
+        {inputTokens: 52, outputTokens: 16, totalTokens: 68},
+        {inputTokens: 52, outputTokens: 16, totalTokens: 68},
+        {inputTokens: 52, outputTokens: 16, totalTokens: 68},
+        undefined,
+      ],
+      providerCalls: 12,
+      toolCalls: 8,
+    });
+  });
+});