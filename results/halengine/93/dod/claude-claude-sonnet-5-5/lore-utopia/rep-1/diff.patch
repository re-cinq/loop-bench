+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../shared/logger.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// Issue #93: afterModelResponse must receive usage covering every provider call in the turn (a sum), not the last round's.
+
+const usage = (inputTokens: number, outputTokens: number): UsageMetadata => ({
+  inputTokens,
+  outputTokens,
+  totalTokens: inputTokens + outputTokens,
+});
+
+const toolRound = (u?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id: 'c', name: 'lookup', input: {}}},
+  {type: 'stop', stopReason: 'tool_use', ...(u ? {usage: u} : {})},
+];
+const finalRound = (u?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'Done.'},
+  {type: 'stop', stopReason: 'end_turn', ...(u ? {usage: u} : {})},
+];
+
+const reportedUsage = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let call = 0;
+  const provider: AIProvider = {
+    async *sendMessage() {
+      yield* rounds[call++];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'Looks up.', inputSchema: {type: 'object'}}, async () => 'found');
+  let received: UsageMetadata | undefined;
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Usage test.'}), registry, {
+    hooks: {
+      afterModelResponse: async (_session, _text, u) => {
+        received = u;
+      },
+    },
+  });
+  const session: ChatSession = {sessionId: 's', userId: 'u', entries: [{role: 'user', content: 'go', timestamp: 't'}]};
+  for await (const _chunk of orchestrator.processMessageStream(session)) void _chunk;
+  return received;
+};
+
+describe('afterModelResponse usage across tool rounds', () => {
+  beforeEach(() => {
+    const quiet = () => undefined;
+    setLogger({debug: quiet, info: quiet, warn: quiet, error: quiet});
+  });
+
+  afterEach(() => setLogger());
+
+  it('reports the sum of every provider call in a turn with two tool rounds', async () => {
+    const reported = await reportedUsage([
+      toolRound(usage(1000, 10)),
+      toolRound(usage(200, 20)),
+      finalRound(usage(30, 3)),
+    ]);
+
+    expect(reported).toEqual({inputTokens: 1230, outputTokens: 33, totalTokens: 1263});
+  });
+
+  it('still counts the rounds that reported when others report no usage', async () => {
+    const reported = await reportedUsage([toolRound(usage(1000, 10)), toolRound(), finalRound(usage(30, 3))]);
+
+    expect(reported).toEqual({inputTokens: 1030, outputTokens: 13, totalTokens: 1043});
+  });
+
+  it('reports nothing when no round reported usage', async () => {
+    const reported = await reportedUsage([toolRound(), finalRound()]);
+
+    expect(reported).toBeUndefined();
+  });
+});