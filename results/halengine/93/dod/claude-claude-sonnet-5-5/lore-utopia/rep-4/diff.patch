+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// Each inner array is one provider call; a round's usage is optional, as providers may report none.
+const toolRound = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id: 'c', name: 'lookup', input: {}}},
+  {type: 'stop', stopReason: 'tool_use', usage},
+];
+const finalRound = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'done'},
+  {type: 'stop', stopReason: 'end_turn', usage},
+];
+const u = (inputTokens: number, outputTokens: number): UsageMetadata => ({
+  inputTokens,
+  outputTokens,
+  totalTokens: inputTokens + outputTokens,
+});
+
+// What afterModelResponse is handed for a turn whose provider calls are scripted as `rounds`.
+const usageHandedToHook = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let call = 0;
+  const provider: AIProvider = {
+    async *sendMessage() {
+      yield* rounds[call++];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'Looks up.', inputSchema: {type: 'object'}}, async () => 'found');
+  let seen: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      seen = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Usage test.'}), registry, {
+    hooks,
+  });
+  const session: ChatSession = {sessionId: 's', userId: 'u', entries: [{role: 'user', content: 'go', timestamp: 't'}]};
+  await orchestrator.processMessage(session);
+  return seen;
+};
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports the sum of every provider call in a turn with two tool rounds', async () => {
+    expect(await usageHandedToHook([toolRound(u(1000, 10)), toolRound(u(1500, 20)), finalRound(u(2000, 30))])).toEqual({
+      inputTokens: 4500,
+      outputTokens: 60,
+      totalTokens: 4560,
+    });
+  });
+
+  it('still counts the rounds that reported when another round reports no usage', async () => {
+    expect(await usageHandedToHook([toolRound(u(1000, 10)), toolRound(), finalRound(u(2000, 30))])).toEqual({
+      inputTokens: 3000,
+      outputTokens: 40,
+      totalTokens: 3040,
+    });
+  });
+
+  it('reports nothing when no round reported usage', async () => {
+    expect(await usageHandedToHook([toolRound(), finalRound()])).toBeUndefined();
+  });
+});