+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// Drives a real orchestrator over a scripted provider and returns what afterModelResponse receives as usage.
+const usageSeenByHook = async (rounds: Array<UsageMetadata | undefined>): Promise<UsageMetadata | undefined> => {
+  let call = 0;
+  const provider: AIProvider = {
+    async *sendMessage() {
+      const usage = rounds[call];
+      const last = call === rounds.length - 1;
+      call++;
+      if (last) yield {type: 'text', text: 'Done.'};
+      else yield {type: 'tool_use', toolCall: {id: `c${call}`, name: 'lookup', input: {}}};
+      const stop: MessageChunk = {type: 'stop', stopReason: last ? 'end_turn' : 'tool_use'};
+      yield usage && stop.type === 'stop' ? {...stop, usage} : stop;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'Looks up.', inputSchema: {type: 'object'}}, async () => 'found');
+  let seen: UsageMetadata | undefined;
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Usage test.'}), registry, {
+    hooks: {
+      afterModelResponse: async (_session, _text, usage) => {
+        seen = usage;
+      },
+    },
+  });
+  const session: ChatSession = {sessionId: 's', userId: 'u', entries: [{role: 'user', content: 'go', timestamp: 't'}]};
+  await orchestrator.processMessage(session);
+  return seen;
+};
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports the sum of every provider call in a turn with two tool rounds', async () => {
+    const usage = await usageSeenByHook([
+      {inputTokens: 100, outputTokens: 10, totalTokens: 110},
+      {inputTokens: 200, outputTokens: 20, totalTokens: 220},
+      {inputTokens: 300, outputTokens: 30, totalTokens: 330},
+    ]);
+
+    expect(usage).toEqual({inputTokens: 600, outputTokens: 60, totalTokens: 660});
+  });
+
+  it('counts the rounds that reported usage when others reported none, never NaN or undefined', async () => {
+    const usage = await usageSeenByHook([
+      {inputTokens: 100, outputTokens: 10, totalTokens: 110},
+      undefined,
+      {inputTokens: 300, outputTokens: 30, totalTokens: 330},
+    ]);
+
+    expect(usage).toEqual({inputTokens: 400, outputTokens: 40, totalTokens: 440});
+  });
+});