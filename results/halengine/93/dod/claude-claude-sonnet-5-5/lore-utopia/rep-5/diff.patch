+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const use = (inputTokens: number, outputTokens: number): UsageMetadata => ({
+  inputTokens,
+  outputTokens,
+  totalTokens: inputTokens + outputTokens,
+});
+
+const askForTool = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id: 'c', name: 'lookup', input: {}}},
+  {type: 'stop', stopReason: 'tool_use', ...(usage && {usage})},
+];
+const finish = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'Done.'},
+  {type: 'stop', stopReason: 'end_turn', ...(usage && {usage})},
+];
+
+/** Drives one turn through a provider whose Nth call yields rounds[N]; returns what afterModelResponse received. */
+const reportedUsage = async (rounds: MessageChunk[][]): Promise<{calls: number; usage?: UsageMetadata}> => {
+  let calls = 0;
+  const provider: AIProvider = {
+    async *sendMessage() {
+      yield* rounds[calls++];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'Looks up.', inputSchema: {type: 'object'}}, async () => 'found');
+  let usage: UsageMetadata | undefined;
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Usage test.'}), registry, {
+    maxToolRounds: 5,
+    hooks: {
+      afterModelResponse: async (_session, _text, reported) => {
+        usage = reported;
+      },
+    },
+  });
+  const session: ChatSession = {sessionId: 's', userId: 'u', entries: [{role: 'user', content: 'go', timestamp: 't'}]};
+  await orchestrator.processMessage(session);
+  return {calls, usage};
+};
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports the sum of every provider call in a turn with two tool rounds', async () => {
+    const {calls, usage} = await reportedUsage([
+      askForTool(use(100, 10)),
+      askForTool(use(250, 20)),
+      finish(use(400, 30)),
+    ]);
+
+    expect({calls, usage}).toEqual({calls: 3, usage: use(750, 60)});
+  });
+
+  it('counts the rounds that reported, and reports nothing for a turn where none did', async () => {
+    const partial = await reportedUsage([askForTool(use(100, 10)), askForTool(), finish(use(400, 30))]);
+    const none = await reportedUsage([askForTool(), finish()]);
+
+    expect({partial: partial.usage, none: none.usage}).toEqual({partial: use(500, 40), none: undefined});
+  });
+});