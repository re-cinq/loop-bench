+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const usage = (inputTokens: number, outputTokens: number): UsageMetadata => ({
+  inputTokens,
+  outputTokens,
+  totalTokens: inputTokens + outputTokens,
+});
+
+const toolRound = (u?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id: 'c', name: 'lookup', input: {}}},
+  {type: 'stop', stopReason: 'tool_use', ...(u && {usage: u})},
+];
+const finalRound = (u?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'Done.'},
+  {type: 'stop', stopReason: 'end_turn', ...(u && {usage: u})},
+];
+
+/** Runs one turn against a provider that replays `rounds`, returning what afterModelResponse received. */
+const reportedUsage = async (rounds: MessageChunk[][]): Promise<{calls: number; usage?: UsageMetadata}> => {
+  let call = 0;
+  const provider: AIProvider = {
+    async *sendMessage() {
+      yield* rounds[call++];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Looks something up.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  let received: UsageMetadata | undefined;
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Usage test.'}), registry, {
+    hooks: {
+      afterModelResponse: async (_session, _text, u) => {
+        received = u;
+      },
+    },
+  });
+  const session: ChatSession = {sessionId: 's', userId: 'u', entries: [{role: 'user', content: 'go', timestamp: 't'}]};
+  await orchestrator.processMessage(session);
+  return {calls: call, usage: received};
+};
+
+describe('afterModelResponse usage across tool rounds', () => {
+  // specs/hal-engine-config-hooks/spec.md: afterModelResponse usage
+  it('reports the sum of every provider call in a turn that ran two tool rounds', async () => {
+    const {calls, usage: seen} = await reportedUsage([
+      toolRound(usage(100, 10)),
+      toolRound(usage(200, 20)),
+      finalRound(usage(300, 30)),
+    ]);
+
+    expect({calls, seen}).toEqual({calls: 3, seen: usage(600, 60)});
+  });
+
+  it('counts the rounds that reported when others did not, and reports nothing when no round did', async () => {
+    const partial = await reportedUsage([toolRound(usage(100, 10)), toolRound(), finalRound(usage(300, 30))]);
+    const none = await reportedUsage([toolRound(), finalRound()]);
+
+    expect({partial: partial.usage, none: none.usage}).toEqual({partial: usage(400, 40), none: undefined});
+  });
+});