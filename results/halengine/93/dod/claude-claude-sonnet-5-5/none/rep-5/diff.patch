+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// Acceptance for HALEngine#93: afterModelResponse must receive usage covering every provider call in the turn.
+
+const usage = (inputTokens: number, outputTokens: number): UsageMetadata => ({
+  inputTokens,
+  outputTokens,
+  totalTokens: inputTokens + outputTokens,
+});
+const ASK: MessageChunk = {type: 'tool_use', toolCall: {id: 'c', name: 'lookup', input: {}}};
+const toolStop = (u?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason: 'tool_use', usage: u});
+const endStop = (u?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason: 'end_turn', usage: u});
+
+// Runs a turn whose rounds are scripted; returns what the hook was handed as its usage argument.
+const hookUsage = async (rounds: MessageChunk[][]) => {
+  let call = 0;
+  const provider: AIProvider = {
+    async *sendMessage() {
+      yield* rounds[call++];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'Looks up.', inputSchema: {type: 'object'}}, async () => 'found');
+  let received: unknown = 'hook not called';
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Usage test.'}), registry, {
+    hooks: {
+      afterModelResponse: async (_s, _t, u) => {
+        received = u;
+      },
+    },
+  });
+  const session: ChatSession = {sessionId: 's', userId: 'u', entries: [{role: 'user', content: 'go', timestamp: 't'}]};
+  await orchestrator.processMessage(session);
+  // Either documented shape is acceptable: a summed UsageMetadata, or an object carrying the sum as `total`.
+  const asObject = received as {total?: UsageMetadata} | undefined;
+  return asObject && typeof asObject === 'object' && 'total' in asObject ? asObject.total : received;
+};
+
+describe('afterModelResponse usage across tool rounds (HALEngine#93)', () => {
+  it('sums the usage of every provider call in a turn with two tool rounds', async () => {
+    const reported = await hookUsage([
+      [ASK, toolStop(usage(100, 10))],
+      [ASK, toolStop(usage(200, 20))],
+      [{type: 'text', text: 'done'}, endStop(usage(300, 30))],
+    ]);
+
+    expect(reported).toEqual(usage(600, 60));
+  });
+
+  it('still counts the rounds that reported when another round reports no usage', async () => {
+    const reported = await hookUsage([
+      [ASK, toolStop(usage(100, 10))],
+      [ASK, toolStop()],
+      [{type: 'text', text: 'done'}, endStop(usage(300, 30))],
+    ]);
+
+    expect(reported).toEqual(usage(400, 40));
+  });
+
+  it('reports nothing when no round reported usage', async () => {
+    const reported = await hookUsage([
+      [ASK, toolStop()],
+      [{type: 'text', text: 'done'}, endStop()],
+    ]);
+
+    expect(reported).toBeUndefined();
+  });
+});