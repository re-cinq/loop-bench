+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// Scripts one provider call per entry: the entry is the usage that call reports (undefined: none).
+// Every call but the last asks for a tool; the last ends the turn.
+type Round = UsageMetadata | undefined;
+
+const toolRound = (usage: Round): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id: 'c', name: 'lookup', input: {}}},
+  {type: 'stop', stopReason: 'tool_use', usage},
+];
+const finalRound = (usage: Round): MessageChunk[] => [
+  {type: 'text', text: 'Done.'},
+  {type: 'stop', stopReason: 'end_turn', usage},
+];
+
+const usageReportedFor = async (rounds: Round[]): Promise<{called: number; usage?: UsageMetadata}> => {
+  let call = 0;
+  const provider: AIProvider = {
+    async *sendMessage() {
+      const index = call++;
+      yield* (index === rounds.length - 1 ? finalRound : toolRound)(rounds[index]);
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'Looks up.', inputSchema: {type: 'object'}}, async () => 'found');
+  const reports: Array<UsageMetadata | undefined> = [];
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Usage test.'}), registry, {
+    hooks: {afterModelResponse: async (_session, _text, usage) => void reports.push(usage)},
+  });
+  const session: ChatSession = {sessionId: 's', userId: 'u', entries: [{role: 'user', content: 'go', timestamp: 't'}]};
+  for await (const _chunk of orchestrator.processMessageStream(session));
+  return {called: reports.length, usage: reports[0]};
+};
+
+const usage = (inputTokens: number, outputTokens: number): UsageMetadata => ({
+  inputTokens,
+  outputTokens,
+  totalTokens: inputTokens + outputTokens,
+});
+
+// Decision recorded in .lore/dod.md: afterModelResponse keeps one `usage` argument, now the sum of the turn.
+describe('afterModelResponse usage across tool rounds', () => {
+  it('sums the usage of every provider call in a turn with two tool rounds', async () => {
+    const result = await usageReportedFor([usage(100, 10), usage(250, 20), usage(400, 30)]);
+
+    expect(result).toEqual({called: 1, usage: usage(750, 60)});
+  });
+
+  it('still counts the rounds that reported when others reported nothing', async () => {
+    const result = await usageReportedFor([usage(100, 10), undefined, usage(400, 30)]);
+
+    expect(result).toEqual({called: 1, usage: usage(500, 40)});
+  });
+
+  it('reports nothing when no round reported usage', async () => {
+    const result = await usageReportedFor([undefined, undefined, undefined]);
+
+    expect(result).toEqual({called: 1, usage: undefined});
+  });
+});