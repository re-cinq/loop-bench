+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../shared/logger.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// Scripted provider: each round is a tool request except the last, and each reports the usage given (or none).
+const usageOf = (inputTokens: number, outputTokens: number): UsageMetadata => ({
+  inputTokens,
+  outputTokens,
+  totalTokens: inputTokens + outputTokens,
+});
+
+const usageSeenByHook = async (rounds: (UsageMetadata | undefined)[]): Promise<UsageMetadata | undefined> => {
+  let seen: UsageMetadata | undefined;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const index = calls++;
+      const usage = rounds[index];
+      if (index < rounds.length - 1) yield {type: 'tool_use', toolCall: {id: `c${index}`, name: 'lookup', input: {}}};
+      else yield {type: 'text', text: 'Done.'};
+      yield {type: 'stop', stopReason: index < rounds.length - 1 ? 'tool_use' : 'end_turn', ...(usage && {usage})};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  let calls = 0;
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'Looks up.', inputSchema: {type: 'object'}}, async () => 'found');
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Usage test.'}), registry, {
+    hooks: {
+      afterModelResponse: async (_session, _text, usage) => {
+        seen = usage;
+      },
+    },
+  });
+  const session: ChatSession = {sessionId: 's', userId: 'u', entries: [{role: 'user', content: 'go', timestamp: 't'}]};
+  for await (const _chunk of orchestrator.processMessageStream(session)) void _chunk;
+  return seen;
+};
+
+describe('afterModelResponse usage across tool rounds', () => {
+  beforeAll(() => {
+    const quiet = () => undefined;
+    setLogger({debug: quiet, info: quiet, warn: quiet, error: quiet});
+  });
+  afterAll(() => setLogger());
+
+  it('reports the sum of every provider call in a turn with two tool rounds', async () => {
+    const usage = await usageSeenByHook([usageOf(1000, 20), usageOf(1500, 30), usageOf(1700, 400)]);
+
+    expect(usage).toEqual({inputTokens: 4200, outputTokens: 450, totalTokens: 4650});
+  });
+
+  it('counts the rounds that reported usage, and reports nothing when none did', async () => {
+    const partial = await usageSeenByHook([usageOf(1000, 20), undefined, usageOf(1700, 400)]);
+    const none = await usageSeenByHook([undefined, undefined, undefined]);
+
+    expect({partial, none}).toEqual({
+      partial: {inputTokens: 2700, outputTokens: 420, totalTokens: 3120},
+      none: undefined,
+    });
+  });
+});