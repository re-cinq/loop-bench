@@ -0,0 +1,75 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {setLogger} from '../shared/logger.js';
+import type {ChatSession} from '../types/session.js';
+import {makeSimpleLookupRegistry, silenceLogger} from './testFixtures.js';
+
+const usageOf = (inputTokens: number, outputTokens: number): UsageMetadata => ({
+  inputTokens,
+  outputTokens,
+  totalTokens: inputTokens + outputTokens,
+});
+
+const askForTool = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id: 'c', name: 'lookup', input: {}}},
+  {type: 'stop', stopReason: 'tool_use', usage},
+];
+const finish = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'Done.'},
+  {type: 'stop', stopReason: 'end_turn', usage},
+];
+
+// Resolves to what afterModelResponse received as its usage argument; one scripted provider call per entry.
+const usageReportedFor = async (providerCalls: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let callIndex = 0;
+  const provider: AIProvider = {
+    async *sendMessage() {
+      yield* providerCalls[callIndex++];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const registry = makeSimpleLookupRegistry();
+  let reported: UsageMetadata | undefined;
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Usage test.'}), registry, {
+    hooks: {
+      afterModelResponse: async (_session, _text, usage) => {
+        reported = usage;
+      },
+    },
+  });
+  const session: ChatSession = {sessionId: 's', userId: 'u', entries: [{role: 'user', content: 'go', timestamp: 't'}]};
+
+  await orchestrator.processMessage(session);
+  return reported;
+};
+
+describe('afterModelResponse usage across tool rounds', () => {
+  beforeEach(() => silenceLogger());
+
+  afterEach(() => setLogger());
+
+  it('reports 600 input and 35 output tokens summed over three provider calls of a two-tool-round turn', async () => {
+    const reported = await usageReportedFor([
+      askForTool(usageOf(100, 10)),
+      askForTool(usageOf(200, 20)),
+      finish(usageOf(300, 5)),
+    ]);
+
+    expect(reported).toEqual({inputTokens: 600, outputTokens: 35, totalTokens: 635});
+  });
+
+  it('counts the rounds that reported when the middle tool round reports no usage', async () => {
+    const reported = await usageReportedFor([askForTool(usageOf(100, 10)), askForTool(), finish(usageOf(300, 5))]);
+
+    expect(reported).toEqual({inputTokens: 400, outputTokens: 15, totalTokens: 415});
+  });
+
+  it('reports no usage when no round of a tool turn reported any', async () => {
+    const reported = await usageReportedFor([askForTool(), askForTool(), finish()]);
+
+    expect(reported).toBeUndefined();
+  });
+});