+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// Acceptance for #93: afterModelResponse reports usage summed across every provider call of the turn.
+
+const usage = (inputTokens: number, outputTokens: number): UsageMetadata => ({
+  inputTokens,
+  outputTokens,
+  totalTokens: inputTokens + outputTokens,
+});
+const ask = (u?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id: 'c', name: 'lookup', input: {}}},
+  {type: 'stop', stopReason: 'tool_use', usage: u},
+];
+const finish = (u?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'Done.'},
+  {type: 'stop', stopReason: 'end_turn', usage: u},
+];
+
+// Runs one turn against a provider that replays `rounds` in order; returns what the hook received.
+const reported = async (rounds: MessageChunk[][]): Promise<{called: boolean; usage?: UsageMetadata}> => {
+  let call = 0;
+  const provider: AIProvider = {
+    async *sendMessage() {
+      yield* rounds[call++];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'Looks up.', inputSchema: {type: 'object'}}, async () => 'found');
+  const result: {called: boolean; usage?: UsageMetadata} = {called: false};
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Usage test.'}), registry, {
+    hooks: {
+      afterModelResponse: async (_session, _text, u) => {
+        result.called = true;
+        result.usage = u;
+      },
+    },
+  });
+  const session: ChatSession = {sessionId: 's', userId: 'u', entries: [{role: 'user', content: 'go', timestamp: 't'}]};
+  for await (const _chunk of orchestrator.processMessageStream(session)) void _chunk;
+  return result;
+};
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports the sum of every provider call in a two-tool-round turn', async () => {
+    const got = await reported([ask(usage(100, 10)), ask(usage(200, 20)), finish(usage(300, 30))]);
+    expect(got.usage).toEqual({inputTokens: 600, outputTokens: 60, totalTokens: 660});
+  });
+
+  it('still counts the rounds that reported when others did not', async () => {
+    const got = await reported([ask(usage(100, 10)), ask(), finish(usage(300, 30))]);
+    expect(got.usage).toEqual({inputTokens: 400, outputTokens: 40, totalTokens: 440});
+  });
+});
