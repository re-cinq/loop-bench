+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const session = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'ask', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const registry = (): ToolRegistry => {
+  const r = new ToolRegistry();
+  r.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => 'r');
+  return r;
+};
+
+const toolRound = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}},
+  {type: 'stop', stopReason: 'tool_use', usage},
+];
+const finalRound = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'done'},
+  {type: 'stop', stopReason: 'end_turn', usage},
+];
+
+// What afterModelResponse is handed for a turn whose provider calls play out the given rounds.
+const reportedUsage = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let call = 0;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[call++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  let seen: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      seen = usage;
+    },
+  };
+  await createChatOrchestrator(provider, promptBuilder, registry(), {hooks}).processMessage(session());
+  return seen;
+};
+
+describe('afterModelResponse usage across tool rounds (#93)', () => {
+  it('reports the sum of every provider call in a turn with two tool rounds', async () => {
+    const seen = await reportedUsage([
+      toolRound({inputTokens: 100, outputTokens: 10, totalTokens: 110}),
+      toolRound({inputTokens: 200, outputTokens: 20, totalTokens: 220}),
+      finalRound({inputTokens: 300, outputTokens: 40, totalTokens: 340}),
+    ]);
+
+    expect(seen).toEqual({inputTokens: 600, outputTokens: 70, totalTokens: 670});
+  });
+
+  it('counts the rounds that reported usage when others reported none', async () => {
+    const seen = await reportedUsage([
+      toolRound({inputTokens: 100, outputTokens: 10, totalTokens: 110}),
+      toolRound(),
+      finalRound({inputTokens: 300, outputTokens: 40, totalTokens: 340}),
+    ]);
+
+    expect(seen).toEqual({inputTokens: 400, outputTokens: 50, totalTokens: 450});
+  });
+});