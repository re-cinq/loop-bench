+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ChatSession} from '../types/session.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const toolCall: MessageChunk = {
+  type: 'tool_use',
+  toolCall: {id: 'call-1', name: 'lookup', input: {query: 'answer'}},
+};
+const toolStop: MessageChunk = {type: 'stop', stopReason: 'tool_use'};
+const doneStop: MessageChunk = {type: 'stop', stopReason: 'end_turn'};
+
+function createSession(): ChatSession {
+  return {
+    sessionId: 'usage-acceptance',
+    userId: 'user-1',
+    entries: [{role: 'user', content: 'ask', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+}
+
+function createToolRegistry(): ToolRegistry {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  return registry;
+}
+
+function scriptedProvider(rounds: MessageChunk[][]): AIProvider {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+// spec: specs/hal-engine-config-hooks#9
+describe('afterModelResponse usage reporting', () => {
+  it('reports usage summed across every provider call in a two-round tool turn', async () => {
+    const firstRound: UsageMetadata = {inputTokens: 100, outputTokens: 20, totalTokens: 120};
+    const secondRound: UsageMetadata = {inputTokens: 30, outputTokens: 10, totalTokens: 40};
+    let reported: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        reported = usage;
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [toolCall, {...toolStop, usage: firstRound}],
+        [
+          {type: 'text', text: 'done'},
+          {...doneStop, usage: secondRound},
+        ],
+      ]),
+      promptBuilder,
+      createToolRegistry(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession());
+
+    expect(reported).toEqual({inputTokens: 130, outputTokens: 30, totalTokens: 160});
+  });
+
+  it('counts reported rounds even when an intervening provider call omits usage', async () => {
+    let reported: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        reported = usage;
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [toolCall, {...toolStop, usage: {inputTokens: 7, outputTokens: 2, totalTokens: 9}}],
+        [toolCall, toolStop],
+        [
+          {type: 'text', text: 'done'},
+          {...doneStop, usage: {inputTokens: 3, outputTokens: 1, totalTokens: 4}},
+        ],
+      ]),
+      promptBuilder,
+      createToolRegistry(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession());
+
+    expect(reported).toEqual({inputTokens: 10, outputTokens: 3, totalTokens: 13});
+
+    reported = undefined;
+    const noUsageOrchestrator = createChatOrchestrator(
+      scriptedProvider([[{type: 'text', text: 'done'}, doneStop]]),
+      promptBuilder,
+      undefined,
+      {hooks}
+    );
+
+    await noUsageOrchestrator.processMessage(createSession());
+
+    expect(reported).toBeUndefined();
+  });
+});