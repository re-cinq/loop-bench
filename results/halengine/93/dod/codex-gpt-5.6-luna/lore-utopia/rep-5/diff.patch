+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'ask', timestamp: SENT_AT}],
+  };
+}
+
+function scriptedProvider(rounds: MessageChunk[][]): AIProvider {
+  let round = 0;
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+function toolRegistry(): ToolRegistry {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found',
+  }));
+  return registry;
+}
+
+const toolCall: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {}}};
+const stopForTool: MessageChunk = {type: 'stop', stopReason: 'tool_use'};
+const stopDone: MessageChunk = {type: 'stop', stopReason: 'end_turn'};
+
+describe('afterModelResponse usage aggregation', () => {
+  it('reports the sum of usage from every provider call in a tool turn', async () => {
+    const firstRound: UsageMetadata = {inputTokens: 10, outputTokens: 4, totalTokens: 14};
+    const secondRound: UsageMetadata = {inputTokens: 20, outputTokens: 7, totalTokens: 27};
+    let received: UsageMetadata | undefined;
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [toolCall, {...stopForTool, usage: firstRound}],
+        [
+          {type: 'text', text: 'done'},
+          {...stopDone, usage: secondRound},
+        ],
+      ]),
+      promptBuilder,
+      toolRegistry(),
+      {
+        hooks: {
+          afterModelResponse: async (_session, _text, usage) => {
+            received = usage;
+          },
+        },
+      }
+    );
+
+    await orchestrator.processMessage(createSession());
+
+    expect(received).toEqual({inputTokens: 30, outputTokens: 11, totalTokens: 41});
+  });
+
+  it('counts reported rounds while leaving an all-unreported turn without usage', async () => {
+    const firstReported: UsageMetadata = {inputTokens: 9, outputTokens: 3, totalTokens: 12};
+    const secondReported: UsageMetadata = {inputTokens: 6, outputTokens: 2, totalTokens: 8};
+    let partial: UsageMetadata | undefined;
+    const partialTurn = createChatOrchestrator(
+      scriptedProvider([
+        [toolCall, {...stopForTool, usage: firstReported}],
+        [toolCall, stopForTool],
+        [
+          {type: 'text', text: 'done'},
+          {...stopDone, usage: secondReported},
+        ],
+      ]),
+      promptBuilder,
+      toolRegistry(),
+      {
+        hooks: {
+          afterModelResponse: async (_session, _text, usage) => {
+            partial = usage;
+          },
+        },
+      }
+    );
+    await partialTurn.processMessage(createSession());
+
+    let none: UsageMetadata | undefined;
+    const unreportedTurn = createChatOrchestrator(
+      scriptedProvider([[{type: 'text', text: 'done'}, stopDone]]),
+      promptBuilder,
+      undefined,
+      {
+        hooks: {
+          afterModelResponse: async (_session, _text, usage) => {
+            none = usage;
+          },
+        },
+      }
+    );
+    await unreportedTurn.processMessage(createSession());
+
+    expect({partial, none}).toEqual({
+      partial: {inputTokens: 15, outputTokens: 5, totalTokens: 20},
+      none: undefined,
+    });
+  });
+});