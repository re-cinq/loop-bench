+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(): ChatSession {
+  return {
+    sessionId: 'usage-acceptance',
+    userId: 'user-1',
+    entries: [{role: 'user', content: 'ask', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+}
+
+function scriptedProvider(rounds: MessageChunk[][]): AIProvider {
+  let round = 0;
+
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+function toolRegistry(): ToolRegistry {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  return registry;
+}
+
+function toolUse(id: string): MessageChunk {
+  return {type: 'tool_use', toolCall: {id, name: 'lookup', input: {}}};
+}
+
+function usage(inputTokens: number, outputTokens: number, totalTokens: number): UsageMetadata {
+  return {inputTokens, outputTokens, totalTokens};
+}
+
+describe('afterModelResponse usage aggregation acceptance', () => {
+  it('sums usage from every provider call in two tool rounds', async () => {
+    let reported: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, totalUsage) => {
+        reported = totalUsage;
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [toolUse('call-1'), {type: 'stop', stopReason: 'tool_use', usage: usage(10, 5, 15)}],
+        [toolUse('call-2'), {type: 'stop', stopReason: 'tool_use', usage: usage(20, 7, 27)}],
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn', usage: usage(3, 2, 5)},
+        ],
+      ]),
+      promptBuilder,
+      toolRegistry(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession());
+
+    expect(reported).toEqual({inputTokens: 33, outputTokens: 14, totalTokens: 47});
+  });
+
+  it('counts reporting rounds around a silent round and leaves an entirely silent turn undefined', async () => {
+    let sparseReported: UsageMetadata | undefined;
+    const sparseHooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, totalUsage) => {
+        sparseReported = totalUsage;
+      },
+    };
+    const sparseOrchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [toolUse('call-1'), {type: 'stop', stopReason: 'tool_use', usage: usage(10, 5, 15)}],
+        [toolUse('call-2'), {type: 'stop', stopReason: 'tool_use'}],
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn', usage: usage(1, 2, 3)},
+        ],
+      ]),
+      promptBuilder,
+      toolRegistry(),
+      {hooks: sparseHooks}
+    );
+
+    await sparseOrchestrator.processMessage(createSession());
+
+    let silentReported: UsageMetadata | undefined = usage(99, 99, 99);
+    const silentHooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, totalUsage) => {
+        silentReported = totalUsage;
+      },
+    };
+    const silentOrchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ],
+      ]),
+      promptBuilder,
+      undefined,
+      {hooks: silentHooks}
+    );
+
+    await silentOrchestrator.processMessage(createSession());
+
+    expect({sparseReported, silentReported}).toEqual({
+      sparseReported: {inputTokens: 11, outputTokens: 7, totalTokens: 18},
+      silentReported: undefined,
+    });
+  });
+});