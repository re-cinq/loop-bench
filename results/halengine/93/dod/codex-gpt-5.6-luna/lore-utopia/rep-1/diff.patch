+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const session: ChatSession = {
+  sessionId: 'usage-acceptance',
+  userId: 'user-1',
+  entries: [{role: 'user', content: 'find it', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+function scriptedProvider(rounds: MessageChunk[][]): AIProvider {
+  let round = 0;
+
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      yield* rounds[round++];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+function stop(usage?: UsageMetadata, stopReason = 'end_turn'): MessageChunk {
+  return {type: 'stop', stopReason, usage};
+}
+
+async function usageReportedBy(rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> {
+  let reported: UsageMetadata | undefined;
+  const tools = new ToolRegistry();
+  tools.register(
+    {
+      name: 'lookup',
+      description: 'looks something up',
+      inputSchema: {type: 'object'},
+    },
+    async () => 'found'
+  );
+
+  const orchestrator = createChatOrchestrator(scriptedProvider(rounds), new PromptBuilder({identity: 'test'}), tools, {
+    hooks: {
+      afterModelResponse: async (_session, _response, usage) => {
+        reported = usage;
+      },
+    },
+  });
+
+  await orchestrator.processMessage({...session, entries: [...session.entries]});
+  return reported;
+}
+
+describe('afterModelResponse usage reporting', () => {
+  it('reports every provider round and preserves absence when no round reports usage', async () => {
+    const twoToolRounds = await usageReportedBy([
+      [
+        {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {}}},
+        stop({inputTokens: 10, outputTokens: 2, totalTokens: 12}, 'tool_use'),
+      ],
+      [{type: 'text', text: 'done'}, stop({inputTokens: 30, outputTokens: 4, totalTokens: 34})],
+    ]);
+    const oneMissingRound = await usageReportedBy([
+      [{type: 'tool_use', toolCall: {id: 'call-2', name: 'lookup', input: {}}}, stop(undefined, 'tool_use')],
+      [{type: 'text', text: 'done'}, stop({inputTokens: 30, outputTokens: 4, totalTokens: 34})],
+    ]);
+    const noUsage = await usageReportedBy([[{type: 'text', text: 'done'}, stop()]]);
+
+    expect({twoToolRounds, oneMissingRound, noUsage}).toEqual({
+      twoToolRounds: {inputTokens: 40, outputTokens: 6, totalTokens: 46},
+      oneMissingRound: {inputTokens: 30, outputTokens: 4, totalTokens: 34},
+      noUsage: undefined,
+    });
+  });
+});