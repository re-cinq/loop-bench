+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const promptBuilder = new PromptBuilder({identity: 'Acceptance test assistant.'});
+const session = (): ChatSession => ({
+  sessionId: 'acceptance-session',
+  userId: 'acceptance-user',
+  entries: [{role: 'user', content: 'look this up', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const toolCall: MessageChunk = {type: 'tool_use', toolCall: {id: 'lookup-1', name: 'lookup', input: {}}};
+const toolStop: MessageChunk = {type: 'stop', stopReason: 'tool_use'};
+const doneStop: MessageChunk = {type: 'stop', stopReason: 'end_turn'};
+
+function registry(): ToolRegistry {
+  const tools = new ToolRegistry();
+  tools.register(
+    {name: 'lookup', description: 'Looks something up.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  return tools;
+}
+
+function scriptedProvider(rounds: MessageChunk[][]): AIProvider {
+  let call = 0;
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      yield* rounds[call++] ?? [];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+async function runWithUsage(rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> {
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reported = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(scriptedProvider(rounds), promptBuilder, registry(), {hooks});
+  await orchestrator.processMessage(session());
+  return reported;
+}
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports the sum of usage from every provider call in a two-tool-round turn', async () => {
+    const first = {inputTokens: 10, outputTokens: 2, totalTokens: 12};
+    const second = {inputTokens: 20, outputTokens: 3, totalTokens: 23};
+    const third = {inputTokens: 30, outputTokens: 4, totalTokens: 34};
+
+    const reported = await runWithUsage([
+      [toolCall, {...toolStop, usage: first}],
+      [toolCall, {...toolStop, usage: second}],
+      [
+        {type: 'text', text: 'done'},
+        {...doneStop, usage: third},
+      ],
+    ]);
+
+    expect(reported).toEqual({inputTokens: 60, outputTokens: 9, totalTokens: 69});
+  });
+
+  it('counts reported rounds when another round omits usage and reports nothing when all rounds omit it', async () => {
+    const first = {inputTokens: 10, outputTokens: 2, totalTokens: 12};
+    const third = {inputTokens: 30, outputTokens: 4, totalTokens: 34};
+
+    const partial = await runWithUsage([
+      [toolCall, {...toolStop, usage: first}],
+      [toolCall, toolStop],
+      [
+        {type: 'text', text: 'done'},
+        {...doneStop, usage: third},
+      ],
+    ]);
+    const absent = await runWithUsage([
+      [toolCall, toolStop],
+      [{type: 'text', text: 'done'}, doneStop],
+    ]);
+
+    expect({partial, absent}).toEqual({
+      partial: {inputTokens: 40, outputTokens: 6, totalTokens: 46},
+      absent: undefined,
+    });
+  });
+});