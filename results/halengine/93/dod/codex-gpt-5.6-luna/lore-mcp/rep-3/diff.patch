+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const promptBuilder = new PromptBuilder({identity: 'Usage acceptance test'});
+
+function session(): ChatSession {
+  return {
+    sessionId: 'usage-acceptance',
+    userId: 'user-1',
+    entries: [{role: 'user', content: 'Find the answer', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+}
+
+function registry(): ToolRegistry {
+  const tools = new ToolRegistry();
+  tools.register({name: 'lookup', description: 'look up a value', inputSchema: {type: 'object'}}, async () => 'result');
+  return tools;
+}
+
+function scriptedProvider(rounds: MessageChunk[][]): AIProvider {
+  let call = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[call++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const toolCall: MessageChunk = {type: 'tool_use', toolCall: {id: 'lookup-1', name: 'lookup', input: {}}};
+
+const usage = (inputTokens: number, outputTokens: number): UsageMetadata => ({
+  inputTokens,
+  outputTokens,
+  totalTokens: inputTokens + outputTokens,
+});
+
+describe('afterModelResponse usage reporting', () => {
+  it('reports usage summed across every provider round in a two-tool-round turn', async () => {
+    let reported: UsageMetadata | undefined;
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [toolCall, {type: 'stop', stopReason: 'tool_use', usage: usage(10, 2)}],
+        [toolCall, {type: 'stop', stopReason: 'tool_use', usage: usage(20, 3)}],
+        [
+          {type: 'text', text: 'answer'},
+          {type: 'stop', stopReason: 'end_turn', usage: usage(30, 4)},
+        ],
+      ]),
+      promptBuilder,
+      registry(),
+      {hooks: {afterModelResponse: async (_session, _text, received) => void (reported = received)}}
+    );
+
+    await orchestrator.processMessage(session());
+
+    expect(reported).toEqual(usage(60, 9));
+  });
+
+  it('counts reported rounds when another round is silent and reports undefined when all rounds are silent', async () => {
+    let reported: UsageMetadata | undefined = undefined;
+    const hook = {
+      afterModelResponse: async (_session: ChatSession, _text: string, received?: UsageMetadata) => {
+        reported = received;
+      },
+    };
+    const partialUsageOrchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [toolCall, {type: 'stop', stopReason: 'tool_use', usage: usage(7, 1)}],
+        [toolCall, {type: 'stop', stopReason: 'tool_use'}],
+        [
+          {type: 'text', text: 'answer'},
+          {type: 'stop', stopReason: 'end_turn', usage: usage(13, 2)},
+        ],
+      ]),
+      promptBuilder,
+      registry(),
+      {hooks: hook}
+    );
+
+    await partialUsageOrchestrator.processMessage(session());
+    expect(reported).toEqual(usage(20, 3));
+
+    reported = usage(1, 1);
+    const noUsageOrchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [toolCall, {type: 'stop', stopReason: 'tool_use'}],
+        [
+          {type: 'text', text: 'answer'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ],
+      ]),
+      promptBuilder,
+      registry(),
+      {hooks: hook}
+    );
+
+    await noUsageOrchestrator.processMessage(session());
+    expect(reported).toBeUndefined();
+  });
+});