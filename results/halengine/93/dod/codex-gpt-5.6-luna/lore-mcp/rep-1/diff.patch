+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+
+const promptBuilder = new PromptBuilder({identity: 'Usage acceptance test.'});
+const session = (): ChatSession => ({
+  sessionId: 'usage-acceptance',
+  userId: 'user-1',
+  entries: [{role: 'user', content: 'look this up', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      yield* rounds[round++] ?? [];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registry = (): ToolRegistry => {
+  const tools = new ToolRegistry();
+  tools.register(
+    {name: 'lookup', description: 'Looks something up.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  return tools;
+};
+
+const toolCall = (id: string): MessageChunk => ({
+  type: 'tool_use',
+  toolCall: {id, name: 'lookup', input: {}},
+});
+
+const stop = (stopReason: string, usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason, usage});
+
+describe('afterModelResponse usage acceptance', () => {
+  it('reports the sum of usage from every provider call across two tool rounds', async () => {
+    let receivedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _responseText, usage) => {
+        receivedUsage = usage;
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [toolCall('call-1'), stop('tool_use', {inputTokens: 10, outputTokens: 5, totalTokens: 15})],
+        [toolCall('call-2'), stop('tool_use', {inputTokens: 20, outputTokens: 7, totalTokens: 27})],
+        [{type: 'text', text: 'done'}, stop('end_turn', {inputTokens: 30, outputTokens: 9, totalTokens: 39})],
+      ]),
+      promptBuilder,
+      registry(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(session());
+
+    expect(receivedUsage).toEqual({inputTokens: 60, outputTokens: 21, totalTokens: 81});
+  });
+
+  it('sums reported rounds around a missing usage value and leaves all-missing usage undefined', async () => {
+    let reportedAroundMissingRound: UsageMetadata | undefined;
+    const partialHooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _responseText, usage) => {
+        reportedAroundMissingRound = usage;
+      },
+    };
+    const partial = createChatOrchestrator(
+      scriptedProvider([
+        [toolCall('call-1'), stop('tool_use', {inputTokens: 4, outputTokens: 2, totalTokens: 6})],
+        [toolCall('call-2'), stop('tool_use')],
+        [{type: 'text', text: 'done'}, stop('end_turn', {inputTokens: 8, outputTokens: 3, totalTokens: 11})],
+      ]),
+      promptBuilder,
+      registry(),
+      {hooks: partialHooks}
+    );
+
+    await partial.processMessage(session());
+
+    let reportedWithNoUsage: UsageMetadata | undefined;
+    const none = createChatOrchestrator(
+      scriptedProvider([[{type: 'text', text: 'done'}, stop('end_turn')]]),
+      promptBuilder,
+      undefined,
+      {hooks: {afterModelResponse: async (_session, _responseText, usage) => void (reportedWithNoUsage = usage)}}
+    );
+
+    await none.processMessage(session());
+
+    expect({reportedAroundMissingRound, reportedWithNoUsage}).toEqual({
+      reportedAroundMissingRound: {inputTokens: 12, outputTokens: 5, totalTokens: 17},
+      reportedWithNoUsage: undefined,
+    });
+  });
+});