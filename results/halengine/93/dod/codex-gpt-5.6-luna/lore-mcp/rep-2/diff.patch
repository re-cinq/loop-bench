+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const session = (): ChatSession => ({
+  sessionId: 'usage-acceptance',
+  userId: 'user',
+  entries: [{role: 'user', content: 'find it', timestamp: 'now'}],
+});
+
+const toolRound = (id: string, usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id, name: 'lookup', input: {}}},
+  {type: 'stop', stopReason: 'tool_use', usage},
+];
+
+const finalRound = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'Found it.'},
+  {type: 'stop', stopReason: 'end_turn', usage},
+];
+
+function runUsageScript(script: (providerCall: number) => MessageChunk[]) {
+  let providerCalls = 0;
+  let receivedUsage: UsageMetadata | undefined;
+  const provider: AIProvider = {
+    async *sendMessage() {
+      yield* script(providerCalls++);
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const tools = new ToolRegistry();
+  tools.register(
+    {name: 'lookup', description: 'Looks something up.', inputSchema: {type: 'object'}},
+    async () => 'result'
+  );
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Usage test.'}), tools, {
+    hooks: {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    },
+  });
+
+  return {orchestrator, receivedUsage: () => receivedUsage};
+}
+
+describe('afterModelResponse usage reporting', () => {
+  it('reports usage covering every provider call in a two-tool-round turn', async () => {
+    const run = runUsageScript(providerCall => {
+      if (providerCall === 0) return toolRound('first', {inputTokens: 10, outputTokens: 2, totalTokens: 12});
+      if (providerCall === 1) return toolRound('second', {inputTokens: 20, outputTokens: 3, totalTokens: 23});
+      return finalRound({inputTokens: 30, outputTokens: 4, totalTokens: 34});
+    });
+
+    await run.orchestrator.processMessage(session());
+
+    expect(run.receivedUsage()).toEqual({inputTokens: 60, outputTokens: 9, totalTokens: 69});
+  });
+
+  it('counts reported rounds without producing NaN, and reports nothing when no round reports usage', async () => {
+    const partial = runUsageScript(providerCall => {
+      if (providerCall === 0) return toolRound('reported', {inputTokens: 10, outputTokens: 2, totalTokens: 12});
+      if (providerCall === 1) return toolRound('missing');
+      return finalRound({inputTokens: 30, outputTokens: 4, totalTokens: 34});
+    });
+    await partial.orchestrator.processMessage(session());
+
+    const none = runUsageScript(providerCall => (providerCall === 0 ? toolRound('missing') : finalRound()));
+    await none.orchestrator.processMessage(session());
+
+    expect({partial: partial.receivedUsage(), none: none.receivedUsage()}).toEqual({
+      partial: {inputTokens: 40, outputTokens: 6, totalTokens: 46},
+      none: undefined,
+    });
+  });
+});