+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const session: ChatSession = {
+  sessionId: 'usage-acceptance',
+  userId: 'user-1',
+  entries: [{role: 'user', content: 'ask', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+const promptBuilder = new PromptBuilder({identity: 'Test assistant.'});
+const toolCall: MessageChunk = {
+  type: 'tool_use',
+  toolCall: {id: 'call-1', name: 'lookup', input: {query: 'answer'}},
+};
+
+function scriptedProvider(rounds: MessageChunk[][]): AIProvider {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+function lookupRegistry(): ToolRegistry {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'Looks up an answer.', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found',
+  }));
+  return registry;
+}
+
+function usage(inputTokens: number, outputTokens: number): UsageMetadata {
+  return {inputTokens, outputTokens, totalTokens: inputTokens + outputTokens};
+}
+
+describe('usage reporting acceptance', () => {
+  it('reports usage covering every provider call in a tool turn', async () => {
+    let reported: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, value) => {
+        reported = value;
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [toolCall, {type: 'stop', stopReason: 'tool_use', usage: usage(10, 4)}],
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn', usage: usage(20, 7)},
+        ],
+      ]),
+      promptBuilder,
+      lookupRegistry(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage({...session, entries: [...session.entries]});
+
+    expect(reported).toEqual({inputTokens: 30, outputTokens: 11, totalTokens: 41});
+  });
+
+  it('counts reported rounds while leaving a turn with no usage undefined', async () => {
+    let reported: UsageMetadata | undefined = undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, value) => {
+        reported = value;
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [toolCall, {type: 'stop', stopReason: 'tool_use'}],
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn', usage: usage(8, 2)},
+        ],
+      ]),
+      promptBuilder,
+      lookupRegistry(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage({...session, entries: [...session.entries]});
+
+    expect(reported).toEqual(usage(8, 2));
+
+    reported = undefined;
+    const noUsageOrchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ],
+      ]),
+      promptBuilder,
+      undefined,
+      {hooks}
+    );
+
+    await noUsageOrchestrator.processMessage({...session, entries: [...session.entries]});
+
+    expect(reported).toBeUndefined();
+  });
+});