+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+const promptBuilder = new PromptBuilder({identity: 'A test assistant.'});
+const session = (): ChatSession => ({
+  sessionId: 'usage-test',
+  userId: 'user-1',
+  entries: [{role: 'user', content: 'answer this', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const toolRound = (id: string, usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id, name: 'lookup', input: {query: id}}},
+  {type: 'stop', stopReason: 'tool_use', usage},
+];
+
+const answerRound = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'done'},
+  {type: 'stop', stopReason: 'end_turn', usage},
+];
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let call = 0;
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[call++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const lookupRegistry = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  return registry;
+};
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports the sum from every provider call in a two-tool-round turn', async () => {
+    let reported: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        reported = usage;
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        toolRound('first', {inputTokens: 10, outputTokens: 2, totalTokens: 12}),
+        toolRound('second'),
+        answerRound({inputTokens: 30, outputTokens: 4, totalTokens: 34}),
+      ]),
+      promptBuilder,
+      lookupRegistry(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(session());
+
+    expect(reported).toEqual({inputTokens: 40, outputTokens: 6, totalTokens: 46});
+  });
+
+  it('ignores rounds without usage and reports undefined when no round reports usage', async () => {
+    let reported: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        reported = usage;
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        toolRound('first', {inputTokens: 5, outputTokens: 1, totalTokens: 6}),
+        toolRound('middle'),
+        answerRound({inputTokens: 7, outputTokens: 2, totalTokens: 9}),
+      ]),
+      promptBuilder,
+      lookupRegistry(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(session());
+    const partialUsage = reported;
+
+    reported = undefined;
+    const noUsageOrchestrator = createChatOrchestrator(
+      scriptedProvider([toolRound('only'), answerRound()]),
+      promptBuilder,
+      lookupRegistry(),
+      {hooks}
+    );
+
+    await noUsageOrchestrator.processMessage(session());
+
+    expect({partialUsage, noUsage: reported}).toEqual({
+      partialUsage: {inputTokens: 12, outputTokens: 3, totalTokens: 15},
+      noUsage: undefined,
+    });
+  });
+});