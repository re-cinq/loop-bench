+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ChatSession} from '../types/session.js';
+
+const promptBuilder = new PromptBuilder({identity: 'acceptance test assistant'});
+
+const session = (): ChatSession => ({
+  sessionId: 'usage-acceptance',
+  userId: 'user-1',
+  entries: [{role: 'user', content: 'answer this', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const registry = (): ToolRegistry => {
+  const tools = new ToolRegistry();
+  tools.register({name: 'lookup', description: 'look something up', inputSchema: {type: 'object'}}, async () => ({
+    result: 'lookup result',
+  }));
+  return tools;
+};
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const toolCall: MessageChunk = {type: 'tool_use', toolCall: {id: 'lookup-1', name: 'lookup', input: {}}};
+const usageA: UsageMetadata = {inputTokens: 11, outputTokens: 7, totalTokens: 18};
+const usageB: UsageMetadata = {inputTokens: 23, outputTokens: 13, totalTokens: 36};
+
+// spec: specs/hal-engine-config-hooks#9
+describe('afterModelResponse usage reporting', () => {
+  it('reports usage covering every provider call in a two-round tool turn', async () => {
+    let received: UsageMetadata | undefined;
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [toolCall, {type: 'stop', stopReason: 'tool_use', usage: usageA}],
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn', usage: usageB},
+        ],
+      ]),
+      promptBuilder,
+      registry(),
+      {
+        hooks: {
+          afterModelResponse: async (_session, _text, usage) => {
+            received = usage;
+          },
+        },
+      }
+    );
+
+    await orchestrator.processMessage(session());
+
+    expect(received).toEqual({inputTokens: 34, outputTokens: 20, totalTokens: 54});
+  });
+
+  it('counts reported rounds while leaving a turn with no reported usage undefined', async () => {
+    let received: UsageMetadata | undefined;
+    const partialOrchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [toolCall, {type: 'stop', stopReason: 'tool_use', usage: usageA}],
+        [toolCall, {type: 'stop', stopReason: 'tool_use'}],
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn', usage: usageB},
+        ],
+      ]),
+      promptBuilder,
+      registry(),
+      {hooks: {afterModelResponse: async (_session, _text, usage) => void (received = usage)}}
+    );
+
+    await partialOrchestrator.processMessage(session());
+
+    expect(received).toEqual({inputTokens: 34, outputTokens: 20, totalTokens: 54});
+
+    let noUsage: UsageMetadata | undefined;
+    const noUsageOrchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ],
+      ]),
+      promptBuilder,
+      undefined,
+      {hooks: {afterModelResponse: async (_session, _text, usage) => void (noUsage = usage)}}
+    );
+
+    await noUsageOrchestrator.processMessage(session());
+
+    expect(noUsage).toBeUndefined();
+  });
+});