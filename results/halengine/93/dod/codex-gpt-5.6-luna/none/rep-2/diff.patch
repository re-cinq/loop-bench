+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 'usage-acceptance',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function createToolRegistry(): ToolRegistry {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found it',
+  }));
+  return registry;
+}
+
+function scriptedProvider(rounds: MessageChunk[][]): AIProvider {
+  let round = 0;
+
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const toolCall = (id: string): MessageChunk => ({
+  type: 'tool_use',
+  toolCall: {id, name: 'lookup', input: {q: id}},
+});
+
+const toolStop = (usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason: 'tool_use', usage});
+const doneStop = (usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason: 'end_turn', usage});
+
+// spec: specs/hal-engine-config-hooks/spec.md#9
+describe('afterModelResponse usage reporting', () => {
+  it('reports the sum of every reported provider call across tool rounds and remains undefined when none report', async () => {
+    let reported: UsageMetadata | undefined;
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [toolCall('first'), toolStop({inputTokens: 10, outputTokens: 2, totalTokens: 12})],
+        [toolCall('second'), toolStop()],
+        [{type: 'text', text: 'done'}, doneStop({inputTokens: 7, outputTokens: 11, totalTokens: 18})],
+      ]),
+      promptBuilder,
+      createToolRegistry(),
+      {hooks: {afterModelResponse: async (_session, _text, usage) => void (reported = usage)}}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(reported).toEqual({inputTokens: 17, outputTokens: 13, totalTokens: 30});
+
+    reported = undefined;
+    const noUsageOrchestrator = createChatOrchestrator(
+      scriptedProvider([[{type: 'text', text: 'done'}, doneStop()]]),
+      promptBuilder,
+      undefined,
+      {hooks: {afterModelResponse: async (_session, _text, usage) => void (reported = usage)}}
+    );
+
+    await noUsageOrchestrator.processMessage(createSession('ask'));
+
+    expect(reported).toBeUndefined();
+  });
+});