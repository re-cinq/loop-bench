+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+const session = (): ChatSession => ({
+  sessionId: 'usage-acceptance',
+  userId: 'user-1',
+  entries: [{role: 'user', content: 'ask', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const toolRegistry = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found',
+  }));
+  return registry;
+};
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const toolCall: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+
+const usage = (inputTokens: number, outputTokens: number): UsageMetadata => ({
+  inputTokens,
+  outputTokens,
+  totalTokens: inputTokens + outputTokens,
+});
+
+describe('afterModelResponse usage acceptance contract', () => {
+  it('reports the sum of usage from every provider call in a two-round tool turn', async () => {
+    let reported: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, received) => {
+        reported = received;
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [toolCall, {type: 'stop', stopReason: 'tool_use', usage: usage(12, 4)}],
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn', usage: usage(7, 3)},
+        ],
+      ]),
+      promptBuilder,
+      toolRegistry(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(session());
+
+    expect(reported).toEqual({inputTokens: 19, outputTokens: 7, totalTokens: 26});
+  });
+
+  it('counts usage-bearing rounds without producing NaN and reports nothing when all rounds omit usage', async () => {
+    const reportedValues: Array<UsageMetadata | undefined> = [];
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, received) => {
+        reportedValues.push(received);
+      },
+    };
+
+    const partialUsageOrchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [toolCall, {type: 'stop', stopReason: 'tool_use', usage: usage(9, 2)}],
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn', usage: usage(4, 1)},
+        ],
+      ]),
+      promptBuilder,
+      toolRegistry(),
+      {hooks}
+    );
+    await partialUsageOrchestrator.processMessage(session());
+
+    const noUsageOrchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [toolCall, {type: 'stop', stopReason: 'tool_use'}],
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ],
+      ]),
+      promptBuilder,
+      toolRegistry(),
+      {hooks}
+    );
+    await noUsageOrchestrator.processMessage(session());
+
+    expect(reportedValues).toEqual([{inputTokens: 13, outputTokens: 3, totalTokens: 16}, undefined]);
+  });
+});