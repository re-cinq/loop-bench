+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+const toolCall: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+const toolStop = (usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason: 'tool_use', usage});
+const doneStop = (usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason: 'end_turn', usage});
+
+function createSession(): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'ask', timestamp: SENT_AT}],
+  };
+}
+
+function scriptedProvider(rounds: MessageChunk[][]): AIProvider {
+  let round = 0;
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+function lookupTool(): ToolRegistry {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found it',
+  }));
+  return registry;
+}
+
+describe('afterModelResponse usage aggregation acceptance', () => {
+  it('reports the usage from every provider call across two tool rounds', async () => {
+    const seen: UsageMetadata[] = [];
+    const provider = scriptedProvider([
+      [toolCall, toolStop({inputTokens: 10, outputTokens: 2, totalTokens: 12})],
+      [toolCall, toolStop({inputTokens: 20, outputTokens: 4, totalTokens: 24})],
+      [{type: 'text', text: 'done'}, doneStop({inputTokens: 30, outputTokens: 6, totalTokens: 36})],
+    ]);
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, lookupTool(), {
+      hooks: {afterModelResponse: async (_session, _text, usage) => seen.push(usage as UsageMetadata)},
+    });
+
+    await orchestrator.processMessage(createSession());
+
+    expect(seen).toEqual([{inputTokens: 60, outputTokens: 12, totalTokens: 72}]);
+  });
+
+  it('counts reported rounds without producing undefined or NaN when usage is absent', async () => {
+    const reported: Array<UsageMetadata | undefined> = [];
+    const run = async (rounds: MessageChunk[][]): Promise<void> => {
+      const orchestrator = createChatOrchestrator(scriptedProvider(rounds), promptBuilder, lookupTool(), {
+        hooks: {afterModelResponse: async (_session, _text, usage) => reported.push(usage)},
+      });
+      await orchestrator.processMessage(createSession());
+    };
+
+    await run([
+      [toolCall, toolStop({inputTokens: 7, outputTokens: 3, totalTokens: 10})],
+      [toolCall, toolStop()],
+      [doneStop({inputTokens: 11, outputTokens: 5, totalTokens: 16})],
+    ]);
+    await run([[doneStop()]]);
+
+    expect(reported).toEqual([{inputTokens: 18, outputTokens: 8, totalTokens: 26}, undefined]);
+  });
+});