+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const session: ChatSession = {
+  sessionId: 'usage-session',
+  userId: 'usage-user',
+  entries: [{role: 'user', content: 'Find the answer.', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+const usageFor = (inputTokens: number, outputTokens: number): UsageMetadata => ({
+  inputTokens,
+  outputTokens,
+  totalTokens: inputTokens + outputTokens,
+});
+
+const toolRound = (usage: UsageMetadata | undefined, id: string): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id, name: 'lookup', input: {}}},
+  {type: 'stop', stopReason: 'tool_use', usage},
+];
+
+function createScriptedProvider(rounds: MessageChunk[][]): AIProvider {
+  let call = 0;
+
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      yield* rounds[call++];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+// spec: specs/hal-engine-config-hooks/spec.md#9
+it('reports summed usage across every provider call and nothing when none report', async () => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Looks something up.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+
+  let receivedUsage: UsageMetadata | undefined;
+  const orchestrator = createChatOrchestrator(
+    createScriptedProvider([
+      toolRound(usageFor(11, 2), 'first-call'),
+      toolRound(undefined, 'second-call'),
+      [
+        {type: 'text', text: 'The answer.'},
+        {type: 'stop', stopReason: 'end_turn', usage: usageFor(7, 5)},
+      ],
+    ]),
+    new PromptBuilder({identity: 'Acceptance test assistant.'}),
+    registry,
+    {hooks: {afterModelResponse: async (_session, _text, usage) => void (receivedUsage = usage)}}
+  );
+
+  await orchestrator.processMessage({...session, entries: [...session.entries]});
+
+  expect(receivedUsage).toEqual(usageFor(18, 7));
+
+  const noUsageOrchestrator = createChatOrchestrator(
+    createScriptedProvider([[{type: 'stop', stopReason: 'end_turn'}]]),
+    new PromptBuilder({identity: 'Acceptance test assistant.'}),
+    undefined,
+    {hooks: {afterModelResponse: async (_session, _text, usage) => void (receivedUsage = usage)}}
+  );
+
+  await noUsageOrchestrator.processMessage({...session, entries: [...session.entries]});
+
+  expect(receivedUsage).toBeUndefined();
+});