+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+
+async function usageForTurn(usages: (UsageMetadata | undefined)[]): Promise<UsageMetadata | undefined> {
+  let round = 0;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const index = round++;
+      if (index < 2) yield {type: 'tool_use', toolCall: {id: `call-${index}`, name: 'lookup', input: {}}};
+      yield {type: 'stop', stopReason: index < 2 ? 'tool_use' : 'end_turn', usage: usages[index]};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('This turn does not request structured output');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'look up', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found',
+  }));
+  let received: UsageMetadata | undefined;
+  await createChatOrchestrator(provider, new PromptBuilder({identity: 'Assistant'}), registry, {
+    hooks: {
+      afterModelResponse: async (_session, _text, usage) => {
+        received = usage;
+      },
+    },
+  }).processMessage({
+    sessionId: 's',
+    userId: 'u',
+    entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  });
+  expect(round).toBe(3);
+  return received;
+}
+
+// specs/hal-engine-config-hooks/spec.md#9
+it('reports usage across every provider call in a turn', async () => {
+  const first = {inputTokens: 10, outputTokens: 2, totalTokens: 12};
+  const second = {inputTokens: 20, outputTokens: 3, totalTokens: 23};
+  const last = {inputTokens: 30, outputTokens: 5, totalTokens: 35};
+  const reported = await Promise.all([
+    usageForTurn([first, second, last]),
+    usageForTurn([first, undefined, last]),
+    usageForTurn([undefined, undefined, undefined]),
+  ]);
+  expect(reported).toEqual([
+    {inputTokens: 60, outputTokens: 10, totalTokens: 70},
+    {inputTokens: 40, outputTokens: 7, totalTokens: 47},
+    undefined,
+  ]);
+});