+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+
+// specs/hal-engine-config-hooks/spec.md#10
+it('reports usage across all provider calls, including when some rounds omit it', async () => {
+  const first = {inputTokens: 10, outputTokens: 2, totalTokens: 12};
+  const second = {inputTokens: 20, outputTokens: 3, totalTokens: 23};
+  const last = {inputTokens: 30, outputTokens: 4, totalTokens: 34};
+  const run = async (usages: (UsageMetadata | undefined)[]): Promise<UsageMetadata | undefined> => {
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        const index = round++;
+        if (index < usages.length - 1) {
+          yield {type: 'tool_use', toolCall: {id: `call-${index}`, name: 'lookup', input: {}}};
+        }
+        yield {type: 'stop', stopReason: index < usages.length - 1 ? 'tool_use' : 'end_turn', usage: usages[index]};
+      },
+      async generateStructured<T>(): Promise<T> {
+        throw new Error('Structured output is not used');
+      },
+    };
+    const registry = new ToolRegistry();
+    registry.register({name: 'lookup', description: 'lookup', inputSchema: {type: 'object'}}, async () => ({
+      result: 'found',
+    }));
+    let received: UsageMetadata | undefined;
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Assistant'}), registry, {
+      hooks: {
+        afterModelResponse: async (_session, _text, usage) => {
+          received = usage;
+        },
+      },
+    });
+    await orchestrator.processMessage({
+      sessionId: 's',
+      userId: 'u',
+      entries: [{role: 'user', content: 'ask', timestamp: '2026-01-01T00:00:00.000Z'}],
+    });
+    return received;
+  };
+
+  expect(
+    await Promise.all([
+      run([first, second, last]),
+      run([first, undefined, last]),
+      run([undefined, undefined, undefined]),
+    ])
+  ).toEqual([
+    {inputTokens: 60, outputTokens: 9, totalTokens: 69},
+    {inputTokens: 40, outputTokens: 6, totalTokens: 46},
+    undefined,
+  ]);
+});