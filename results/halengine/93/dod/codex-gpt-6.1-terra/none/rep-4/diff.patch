+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+
+const first = {inputTokens: 11, outputTokens: 3, totalTokens: 14};
+const second = {inputTokens: 20, outputTokens: 5, totalTokens: 25};
+const third = {inputTokens: 7, outputTokens: 2, totalTokens: 9};
+
+async function usageForTurn(usages: (UsageMetadata | undefined)[]): Promise<UsageMetadata | undefined> {
+  let round = 0;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const current = round++;
+      if (current < 2) yield {type: 'tool_use', toolCall: {id: `call-${current}`, name: 'lookup', input: {}}};
+      yield {type: 'stop', stopReason: current < 2 ? 'tool_use' : 'end_turn', usage: usages[current]};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured output is not used in this turn');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'lookup', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found',
+  }));
+  let seen: UsageMetadata | undefined;
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'assistant'}), registry, {
+    hooks: {afterModelResponse: async (_session, _text, usage) => void (seen = usage)},
+  });
+  await orchestrator.processMessage({
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'question', timestamp: '2026-01-01T00:00:00.000Z'}],
+  });
+  return seen;
+}
+
+// specs/hal-engine-config-hooks/spec.md#2
+it('reports usage across all provider calls, including when some rounds omit it', async () => {
+  const all = await usageForTurn([first, second, third]);
+  const missing = await usageForTurn([first, undefined, third]);
+  const none = await usageForTurn([undefined, undefined, undefined]);
+
+  expect({all, missing, none}).toEqual({
+    all: {inputTokens: 38, outputTokens: 10, totalTokens: 48},
+    missing: {inputTokens: 18, outputTokens: 5, totalTokens: 23},
+    none: undefined,
+  });
+});