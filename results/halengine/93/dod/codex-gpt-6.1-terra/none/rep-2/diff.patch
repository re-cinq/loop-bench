+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const usageForTurn = async (usages: (UsageMetadata | undefined)[]): Promise<(UsageMetadata | undefined)[]> => {
+  let round = 0;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const index = round++;
+      if (index < usages.length - 1) {
+        yield {type: 'tool_use', toolCall: {id: `call-${index}`, name: 'lookup', input: {}}};
+      }
+      yield {type: 'stop', stopReason: index < usages.length - 1 ? 'tool_use' : 'end_turn', usage: usages[index]};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured output is not used in this turn');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'look up a value', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found',
+  }));
+  const received: (UsageMetadata | undefined)[] = [];
+  const session: ChatSession = {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'ask', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  await createChatOrchestrator(provider, new PromptBuilder({identity: 'assistant'}), registry, {
+    hooks: {afterModelResponse: async (_session, _text, usage) => void received.push(usage)},
+  }).processMessage(session);
+  return received;
+};
+
+// specs/hal-engine-config-hooks/spec.md#12
+it('reports turn usage across provider calls including when some rounds omit usage', async () => {
+  const first = {inputTokens: 11, outputTokens: 2, totalTokens: 13};
+  const second = {inputTokens: 23, outputTokens: 5, totalTokens: 28};
+  const third = {inputTokens: 37, outputTokens: 7, totalTokens: 44};
+  const results = await Promise.all([
+    usageForTurn([first, second, third]),
+    usageForTurn([first, undefined, third]),
+    usageForTurn([undefined, undefined, undefined]),
+  ]);
+
+  expect(results).toEqual([
+    [{inputTokens: 71, outputTokens: 14, totalTokens: 85}],
+    [{inputTokens: 48, outputTokens: 9, totalTokens: 57}],
+    [undefined],
+  ]);
+});