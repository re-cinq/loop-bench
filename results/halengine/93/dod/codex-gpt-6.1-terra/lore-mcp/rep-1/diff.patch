+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const runTurn = async (usages: (UsageMetadata | undefined)[]): Promise<(UsageMetadata | undefined)[]> => {
+  let round = 0;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const current = round++;
+      if (current < 2) yield {type: 'tool_use', toolCall: {id: `call-${current}`, name: 'lookup', input: {}}};
+      yield {type: 'stop', stopReason: current < 2 ? 'tool_use' : 'end_turn', usage: usages[current]};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured output is not used in this turn');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'look up a value', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  const received: (UsageMetadata | undefined)[] = [];
+  const session: ChatSession = {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'look it up', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Assistant'}), registry, {
+    hooks: {afterModelResponse: async (_session, _text, usage) => void received.push(usage)},
+  });
+  await orchestrator.processMessage(session);
+  return received;
+};
+
+describe('afterModelResponse turn usage', () => {
+  // specs/hal-engine-config-hooks/spec.md#11
+  it('reports the sum of every reported provider call across tool rounds', async () => {
+    const first = {inputTokens: 10, outputTokens: 2, totalTokens: 12};
+    const second = {inputTokens: 20, outputTokens: 3, totalTokens: 23};
+    const third = {inputTokens: 30, outputTokens: 5, totalTokens: 35};
+
+    const all = await runTurn([first, second, third]);
+    const missing = await runTurn([first, undefined, third]);
+    const none = await runTurn([undefined, undefined, undefined]);
+
+    expect({all, missing, none}).toEqual({
+      all: [{inputTokens: 60, outputTokens: 10, totalTokens: 70}],
+      missing: [{inputTokens: 40, outputTokens: 7, totalTokens: 47}],
+      none: [undefined],
+    });
+  });
+});