+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// specs/hal-engine-config-hooks/spec.md#2
+it('reports usage across every provider call, including when some rounds omit it', async () => {
+  const runTurn = async (usages: (UsageMetadata | undefined)[]): Promise<UsageMetadata | undefined> => {
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        const current = round++;
+        if (current < usages.length - 1) {
+          yield {type: 'tool_use', toolCall: {id: `call-${current}`, name: 'lookup', input: {}}};
+        }
+        yield {type: 'stop', stopReason: current < usages.length - 1 ? 'tool_use' : 'end_turn', usage: usages[current]};
+      },
+      async generateStructured<T>(): Promise<T> {
+        throw new Error('Structured output is not used in this turn');
+      },
+    };
+    const registry = new ToolRegistry();
+    registry.register({name: 'lookup', description: 'Lookup', inputSchema: {type: 'object'}}, async () => ({
+      result: 'ok',
+    }));
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    let seen: UsageMetadata | undefined;
+    await createChatOrchestrator(provider, new PromptBuilder({identity: 'Assistant'}), registry, {
+      hooks: {
+        afterModelResponse: async (_session, _text, usage) => {
+          seen = usage;
+        },
+      },
+    }).processMessage(session);
+    return seen;
+  };
+
+  const first = {inputTokens: 10, outputTokens: 2, totalTokens: 12};
+  const second = {inputTokens: 20, outputTokens: 3, totalTokens: 23};
+  const third = {inputTokens: 30, outputTokens: 4, totalTokens: 34};
+  const observed = await Promise.all([
+    runTurn([first, second, third]),
+    runTurn([first, undefined, third]),
+    runTurn([undefined, undefined, undefined]),
+  ]);
+
+  expect(observed).toEqual([
+    {inputTokens: 60, outputTokens: 9, totalTokens: 69},
+    {inputTokens: 40, outputTokens: 6, totalTokens: 46},
+    undefined,
+  ]);
+});