+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+
+// specs/hal-engine-config-hooks/spec.md#9
+it('reports usage across tool rounds even when some rounds omit it', async () => {
+  const first = {inputTokens: 11, outputTokens: 3, totalTokens: 14};
+  const second = {inputTokens: 7, outputTokens: 5, totalTokens: 12};
+  const last = {inputTokens: 13, outputTokens: 2, totalTokens: 15};
+
+  async function run(usages: (UsageMetadata | undefined)[]): Promise<UsageMetadata | undefined> {
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        const current = round++;
+        if (current < 2) yield {type: 'tool_use', toolCall: {id: `call-${current}`, name: 'lookup', input: {}}};
+        yield {type: 'stop', stopReason: current < 2 ? 'tool_use' : 'end_turn', usage: usages[current]};
+      },
+      async generateStructured<T>(): Promise<T> {
+        throw new Error('Structured output is not used in a chat turn');
+      },
+    };
+    const registry = new ToolRegistry();
+    registry.register({name: 'lookup', description: 'look up', inputSchema: {type: 'object'}}, async () => ({
+      result: 'ok',
+    }));
+    let seen: UsageMetadata | undefined;
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Assistant'}), registry, {
+      hooks: {afterModelResponse: async (_session, _text, usage) => void (seen = usage)},
+    });
+    await orchestrator.processMessage({
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    });
+    return seen;
+  }
+
+  const results = await Promise.all([
+    run([first, second, last]),
+    run([first, undefined, last]),
+    run([undefined, undefined, undefined]),
+  ]);
+  expect(results).toEqual([
+    {inputTokens: 31, outputTokens: 10, totalTokens: 41},
+    {inputTokens: 24, outputTokens: 5, totalTokens: 29},
+    undefined,
+  ]);
+});