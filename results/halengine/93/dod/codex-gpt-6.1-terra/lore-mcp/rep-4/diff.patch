+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// specs/hal-engine-config-hooks/spec.md#1
+it('reports usage across every provider call, including when some calls omit it', async () => {
+  const runTurn = async (usages: (UsageMetadata | undefined)[]): Promise<(UsageMetadata | undefined)[]> => {
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        const index = round++;
+        if (index < 2) {
+          yield {type: 'tool_use', toolCall: {id: `call-${index}`, name: 'lookup', input: {}}};
+        }
+        yield {type: 'stop', stopReason: index < 2 ? 'tool_use' : 'end_turn', usage: usages[index]};
+      },
+      async generateStructured<T>(): Promise<T> {
+        throw new Error('Structured generation is not used in this turn');
+      },
+    };
+    const registry = new ToolRegistry();
+    registry.register({name: 'lookup', description: 'look up', inputSchema: {type: 'object'}}, async () => ({
+      result: 'found',
+    }));
+    const received: (UsageMetadata | undefined)[] = [];
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'question', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'assistant'}), registry, {
+      hooks: {
+        afterModelResponse: async (_session, _text, usage) => {
+          received.push(usage);
+        },
+      },
+    });
+    await orchestrator.processMessage(session);
+    return received;
+  };
+
+  const first = {inputTokens: 10, outputTokens: 2, totalTokens: 12};
+  const second = {inputTokens: 20, outputTokens: 3, totalTokens: 23};
+  const third = {inputTokens: 30, outputTokens: 4, totalTokens: 34};
+  expect(
+    await Promise.all([
+      runTurn([first, second, third]),
+      runTurn([first, undefined, third]),
+      runTurn([undefined, undefined, undefined]),
+    ])
+  ).toEqual([
+    [{inputTokens: 60, outputTokens: 9, totalTokens: 69}],
+    [{inputTokens: 40, outputTokens: 6, totalTokens: 46}],
+    [undefined],
+  ]);
+});