@@ -0,0 +1,48 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+
+async function usageForTurn(rounds: (UsageMetadata | undefined)[]): Promise<(UsageMetadata | undefined)[]> {
+  let round = 0;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const current = round++;
+      const isToolRound = current < rounds.length - 1;
+      if (isToolRound) yield {type: 'tool_use', toolCall: {id: `call-${current}`, name: 'lookup', input: {}}};
+      yield {type: 'stop', stopReason: isToolRound ? 'tool_use' : 'end_turn', usage: rounds[current]};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured output is not used by this turn');
+    },
+  };
+  const tools = new ToolRegistry();
+  tools.register({name: 'lookup', description: 'Look up a value', inputSchema: {type: 'object'}}, async () => 'found');
+  const received: (UsageMetadata | undefined)[] = [];
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Assistant'}), tools, {
+    hooks: {afterModelResponse: async (_session, _text, usage) => void received.push(usage)},
+  });
+  await orchestrator.processMessage({
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'Look it up', timestamp: '2026-01-01T00:00:00.000Z'}],
+  });
+  return received;
+}
+
+// specs/hal-engine-config-hooks/spec.md#9
+it('reports usage across all provider calls, including when some rounds omit usage', async () => {
+  const first = {inputTokens: 10, outputTokens: 2, totalTokens: 12};
+  const second = {inputTokens: 20, outputTokens: 3, totalTokens: 23};
+  const third = {inputTokens: 30, outputTokens: 4, totalTokens: 34};
+
+  const allReported = await usageForTurn([first, second, third]);
+  const someReported = await usageForTurn([first, undefined, third]);
+  const noneReported = await usageForTurn([undefined, undefined, undefined]);
+
+  expect({allReported, someReported, noneReported}).toEqual({
+    allReported: [{inputTokens: 60, outputTokens: 9, totalTokens: 69}],
+    someReported: [{inputTokens: 40, outputTokens: 6, totalTokens: 46}],
+    noneReported: [undefined],
+  });
+});