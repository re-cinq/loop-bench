+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const PROMPT = new PromptBuilder({identity: 'You are a test assistant.'});
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const callTool = (id: string, usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id, name: 'lookup', input: {}}},
+  {type: 'stop', stopReason: 'tool_use', usage},
+];
+
+const finishTurn = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'Done.'},
+  {type: 'stop', stopReason: 'end_turn', usage},
+];
+
+const runTurn = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let round = 0;
+  const provider: AIProvider = {
+    async *sendMessage() {
+      const chunks = rounds[round] ?? finishTurn();
+      round += 1;
+      yield* chunks;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'Looks up data.', inputSchema: {type: 'object'}}, async () => 'ok');
+
+  let reported: UsageMetadata | undefined = {inputTokens: -1, outputTokens: -1, totalTokens: -1};
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _responseText, usage) => {
+      reported = usage;
+    },
+  };
+
+  const orchestrator = createChatOrchestrator(provider, PROMPT, registry, {hooks});
+  const session: ChatSession = {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'check', timestamp: SENT_AT}],
+  };
+
+  await orchestrator.processMessage(session);
+  return reported;
+};
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('sums inputTokens, outputTokens, and totalTokens across every provider round that reported usage during the turn', async () => {
+    const round1: UsageMetadata = {inputTokens: 100, outputTokens: 25, totalTokens: 125};
+    const round3: UsageMetadata = {inputTokens: 160, outputTokens: 40, totalTokens: 200};
+
+    const reported = await runTurn([callTool('c1', round1), callTool('c2'), finishTurn(round3)]);
+
+    expect(reported).toEqual({inputTokens: 260, outputTokens: 65, totalTokens: 325});
+  });
+
+  it('reports undefined when no round in a multi-round tool turn reported usage, and sums the rounds that did when another round reported', async () => {
+    const round1: UsageMetadata = {inputTokens: 110, outputTokens: 15, totalTokens: 125};
+    const round2: UsageMetadata = {inputTokens: 140, outputTokens: 35, totalTokens: 175};
+
+    const noneReported = await runTurn([callTool('c1'), finishTurn()]);
+    const twoReported = await runTurn([callTool('c1', round1), finishTurn(round2)]);
+
+    expect({noneReported, twoReported}).toEqual({
+      noneReported: undefined,
+      twoReported: {inputTokens: 250, outputTokens: 50, totalTokens: 300},
+    });
+  });
+});