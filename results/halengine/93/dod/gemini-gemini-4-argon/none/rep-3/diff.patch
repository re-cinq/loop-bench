+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const promptBuilder = new PromptBuilder({identity: 'Usage accounting test.'});
+
+const toolUseRound = (id: string, usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id, name: 'lookup', input: {}}},
+  {type: 'stop', stopReason: 'tool_use', usage},
+];
+
+const finalRound = (text: string, usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text},
+  {type: 'stop', stopReason: 'end_turn', usage},
+];
+
+const runTurnForUsage = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let reportedUsage: UsageMetadata | undefined;
+  let callIndex = 0;
+  const provider: AIProvider = {
+    async *sendMessage() {
+      const chunks = rounds[callIndex] ?? [];
+      callIndex += 1;
+      yield* chunks;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'Looks up data.', inputSchema: {type: 'object'}}, async () => 'ok');
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reportedUsage = usage;
+    },
+  };
+  const session: ChatSession = {
+    sessionId: 'test-session',
+    userId: 'user-1',
+    entries: [{role: 'user', content: 'run', timestamp: SENT_AT}],
+  };
+  const orchestrator = createChatOrchestrator(provider, promptBuilder, registry, {hooks});
+
+  await orchestrator.processMessage(session);
+  return reportedUsage;
+};
+
+describe('afterModelResponse usage accounting across tool rounds', () => {
+  it('sums inputTokens, outputTokens, and totalTokens across every round that reported usage', async () => {
+    const reportedUsage = await runTurnForUsage([
+      toolUseRound('call-1', {inputTokens: 100, outputTokens: 20, totalTokens: 120}),
+      toolUseRound('call-2', {inputTokens: 150, outputTokens: 30, totalTokens: 180}),
+      finalRound('All done.', {inputTokens: 220, outputTokens: 40, totalTokens: 260}),
+    ]);
+
+    expect(reportedUsage).toEqual({
+      inputTokens: 470,
+      outputTokens: 90,
+      totalTokens: 560,
+    });
+  });
+
+  it('includes rounds that reported usage, skips rounds that omitted it, and reports undefined when none did', async () => {
+    const partial = await runTurnForUsage([
+      toolUseRound('call-1', {inputTokens: 100, outputTokens: 25, totalTokens: 125}),
+      toolUseRound('call-2', undefined),
+      finalRound('Finished.', {inputTokens: 200, outputTokens: 35, totalTokens: 235}),
+    ]);
+    const none = await runTurnForUsage([toolUseRound('call-1', undefined), finalRound('Quiet.', undefined)]);
+
+    expect({partial, none}).toEqual({
+      partial: {
+        inputTokens: 300,
+        outputTokens: 60,
+        totalTokens: 360,
+      },
+      none: undefined,
+    });
+  });
+});