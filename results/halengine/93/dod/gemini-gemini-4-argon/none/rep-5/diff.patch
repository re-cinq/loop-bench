+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+
+const createSession = (content: string): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content, timestamp: SENT_AT}],
+});
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const lookupRegistry = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found it',
+  }));
+  return registry;
+};
+
+describe('ChatOrchestrator afterModelResponse usage across tool rounds', () => {
+  it('sums usage across every provider call when a turn runs two tool rounds', async () => {
+    const round1Usage: UsageMetadata = {inputTokens: 100, outputTokens: 20, totalTokens: 120};
+    const round2Usage: UsageMetadata = {inputTokens: 250, outputTokens: 35, totalTokens: 285};
+    const round3Usage: UsageMetadata = {inputTokens: 400, outputTokens: 50, totalTokens: 450};
+    let reported: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        reported = usage;
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: round1Usage}],
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: round2Usage}],
+        [
+          {type: 'text', text: 'all done'},
+          {type: 'stop', stopReason: 'end_turn', usage: round3Usage},
+        ],
+      ]),
+      promptBuilder,
+      lookupRegistry(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(reported).toEqual({
+      inputTokens: 750,
+      outputTokens: 105,
+      totalTokens: 855,
+    });
+  });
+
+  it('sums the rounds that reported usage when another round in the turn reports none, and reports undefined when no round reports usage', async () => {
+    const round1Usage: UsageMetadata = {inputTokens: 80, outputTokens: 15, totalTokens: 95};
+    const round3Usage: UsageMetadata = {inputTokens: 120, outputTokens: 25, totalTokens: 145};
+    const reported: Array<UsageMetadata | undefined> = [];
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        reported.push(usage);
+      },
+    };
+    const partialOrchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: round1Usage}],
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+        [
+          {type: 'text', text: 'all done'},
+          {type: 'stop', stopReason: 'end_turn', usage: round3Usage},
+        ],
+      ]),
+      promptBuilder,
+      lookupRegistry(),
+      {hooks}
+    );
+    const silentOrchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+        [
+          {type: 'text', text: 'all done'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ],
+      ]),
+      promptBuilder,
+      lookupRegistry(),
+      {hooks}
+    );
+
+    await partialOrchestrator.processMessage(createSession('ask partial'));
+    await silentOrchestrator.processMessage(createSession('ask silent'));
+
+    expect(reported).toEqual([
+      {
+        inputTokens: 200,
+        outputTokens: 40,
+        totalTokens: 240,
+      },
+      undefined,
+    ]);
+  });
+});