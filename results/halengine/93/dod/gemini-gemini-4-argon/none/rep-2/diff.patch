+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+const STOP_FOR_TOOL: MessageChunk = {type: 'stop', stopReason: 'tool_use'};
+const STOP_DONE: MessageChunk = {type: 'stop', stopReason: 'end_turn'};
+
+const createSession = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'ask', timestamp: SENT_AT}],
+});
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const lookupRegistry = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found',
+  }));
+  return registry;
+};
+
+const runWithRounds = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let seen: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      seen = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(scriptedProvider(rounds), promptBuilder, lookupRegistry(), {hooks});
+
+  await orchestrator.processMessage(createSession());
+
+  return seen;
+};
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('sums inputTokens, outputTokens and totalTokens across two tool rounds and the answering round', async () => {
+    const reported = await runWithRounds([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 10, outputTokens: 4, totalTokens: 14}}],
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 25, outputTokens: 6, totalTokens: 31}}],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 40, outputTokens: 12, totalTokens: 52}},
+      ],
+    ]);
+
+    expect(reported).toEqual({inputTokens: 75, outputTokens: 22, totalTokens: 97});
+  });
+
+  it('counts the rounds that reported when a middle round reports no usage, and reports undefined when no round reported', async () => {
+    const withSilentRound = await runWithRounds([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 11, outputTokens: 3, totalTokens: 14}}],
+      [TOOL_CALL, STOP_FOR_TOOL],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 19, outputTokens: 7, totalTokens: 26}},
+      ],
+    ]);
+    const allSilent = await runWithRounds([
+      [TOOL_CALL, STOP_FOR_TOOL],
+      [{type: 'text', text: 'done'}, STOP_DONE],
+    ]);
+
+    expect({withSilentRound, allSilent}).toEqual({
+      withSilentRound: {inputTokens: 30, outputTokens: 10, totalTokens: 40},
+      allSilent: undefined,
+    });
+  });
+});