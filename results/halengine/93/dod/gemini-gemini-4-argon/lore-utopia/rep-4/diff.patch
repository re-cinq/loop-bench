+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+const STOP_FOR_TOOL: MessageChunk = {type: 'stop', stopReason: 'tool_use'};
+const STOP_DONE: MessageChunk = {type: 'stop', stopReason: 'end_turn'};
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function scriptedProvider(rounds: MessageChunk[][]): AIProvider {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+function lookupRegistry(): ToolRegistry {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found it',
+  }));
+  return registry;
+}
+
+describe('ChatOrchestrator afterModelResponse usage across tool rounds', () => {
+  it('reports the sum of three provider calls when a turn runs two tool rounds', async () => {
+    let seen: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        seen = usage;
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [
+          TOOL_CALL,
+          {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 100, outputTokens: 10, totalTokens: 110}},
+        ],
+        [
+          TOOL_CALL,
+          {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 200, outputTokens: 20, totalTokens: 220}},
+        ],
+        [
+          {type: 'text', text: 'answer'},
+          {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 300, outputTokens: 30, totalTokens: 330}},
+        ],
+      ]),
+      promptBuilder,
+      lookupRegistry(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(seen).toEqual({inputTokens: 600, outputTokens: 60, totalTokens: 660});
+  });
+
+  it('counts the rounds that reported usage when one round reports none, and reports nothing when no round did', async () => {
+    const seen: {partial?: UsageMetadata; none?: UsageMetadata} = {};
+    const partialOrchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 7, outputTokens: 2, totalTokens: 9}}],
+        [TOOL_CALL, STOP_FOR_TOOL],
+        [
+          {type: 'text', text: 'answer'},
+          {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 5, outputTokens: 1, totalTokens: 6}},
+        ],
+      ]),
+      promptBuilder,
+      lookupRegistry(),
+      {
+        hooks: {
+          afterModelResponse: async (_session, _text, usage) => {
+            seen.partial = usage;
+          },
+        },
+      }
+    );
+    const noneOrchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, STOP_FOR_TOOL],
+        [{type: 'text', text: 'answer'}, STOP_DONE],
+      ]),
+      promptBuilder,
+      lookupRegistry(),
+      {
+        hooks: {
+          afterModelResponse: async (_session, _text, usage) => {
+            seen.none = usage;
+          },
+        },
+      }
+    );
+
+    await partialOrchestrator.processMessage(createSession('ask'));
+    await noneOrchestrator.processMessage(createSession('ask'));
+
+    expect(seen).toEqual({
+      partial: {inputTokens: 12, outputTokens: 3, totalTokens: 15},
+      none: undefined,
+    });
+  });
+});