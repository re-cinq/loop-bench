+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const TOOL_CALL: MessageChunk = {
+  type: 'tool_use',
+  toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}},
+};
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const lookupRegistry = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found',
+  }));
+  return registry;
+};
+
+const scriptedRounds = (rounds: MessageChunk[][]): AIProvider => {
+  let index = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[index++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const runTurnForUsage = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reported = usage;
+    },
+  };
+  const session: ChatSession = {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'ask', timestamp: SENT_AT}],
+  };
+
+  await createChatOrchestrator(scriptedRounds(rounds), promptBuilder, lookupRegistry(), {
+    hooks,
+  }).processMessage(session);
+
+  return reported;
+};
+
+describe('ChatOrchestrator usage reporting across tool rounds', () => {
+  it('reports the sum of three provider calls when a turn runs two tool rounds', async () => {
+    const usage = await runTurnForUsage([
+      [
+        TOOL_CALL,
+        {
+          type: 'stop',
+          stopReason: 'tool_use',
+          usage: {inputTokens: 100, outputTokens: 10, totalTokens: 110},
+        },
+      ],
+      [
+        TOOL_CALL,
+        {
+          type: 'stop',
+          stopReason: 'tool_use',
+          usage: {inputTokens: 200, outputTokens: 20, totalTokens: 220},
+        },
+      ],
+      [
+        {type: 'text', text: 'done'},
+        {
+          type: 'stop',
+          stopReason: 'end_turn',
+          usage: {inputTokens: 300, outputTokens: 30, totalTokens: 330},
+        },
+      ],
+    ]);
+
+    expect(usage).toEqual({inputTokens: 600, outputTokens: 60, totalTokens: 660});
+  });
+
+  it('counts the rounds that reported usage when one round reports none, and reports nothing when no round did', async () => {
+    const partial = await runTurnForUsage([
+      [
+        TOOL_CALL,
+        {
+          type: 'stop',
+          stopReason: 'tool_use',
+          usage: {inputTokens: 7, outputTokens: 2, totalTokens: 9},
+        },
+      ],
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+      [
+        {type: 'text', text: 'done'},
+        {
+          type: 'stop',
+          stopReason: 'end_turn',
+          usage: {inputTokens: 5, outputTokens: 1, totalTokens: 6},
+        },
+      ],
+    ]);
+    const none = await runTurnForUsage([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ]);
+
+    expect({partial, none}).toEqual({
+      partial: {inputTokens: 12, outputTokens: 3, totalTokens: 15},
+      none: undefined,
+    });
+  });
+});