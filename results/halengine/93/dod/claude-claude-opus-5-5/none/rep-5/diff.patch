+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../shared/logger.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// Each round of a scripted turn reports its own usage; afterModelResponse must see the whole turn's cost.
+
+const usage = (inputTokens: number, outputTokens: number): UsageMetadata => ({
+  inputTokens,
+  outputTokens,
+  totalTokens: inputTokens + outputTokens,
+});
+
+const askForTool = (id: string, reported?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id, name: 'lookup', input: {}}},
+  {type: 'stop', stopReason: 'tool_use', usage: reported},
+];
+const finish = (reported?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'Done.'},
+  {type: 'stop', stopReason: 'end_turn', usage: reported},
+];
+
+const usageReportedFor = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let call = 0;
+  const provider: AIProvider = {
+    async *sendMessage() {
+      yield* rounds[call++];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'Looks something up.', inputSchema: {type: 'object'}}, async () => {
+    return 'found';
+  });
+  let reported: UsageMetadata | undefined;
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Usage test.'}), registry, {
+    hooks: {
+      afterModelResponse: async (_session, _text, u) => {
+        reported = u;
+      },
+    },
+  });
+  const session: ChatSession = {sessionId: 's', userId: 'u', entries: [{role: 'user', content: 'go', timestamp: 't'}]};
+  await orchestrator.processMessage(session);
+  expect(call).toBe(rounds.length);
+  return reported;
+};
+
+beforeAll(() => setLogger({info: () => {}, warn: () => {}, error: () => {}, debug: () => {}}));
+afterAll(() => setLogger());
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports the sum of every provider call in a turn that ran two tool rounds', async () => {
+    const reported = await usageReportedFor([
+      askForTool('a', usage(1000, 40)),
+      askForTool('b', usage(1500, 60)),
+      finish(usage(2000, 300)),
+    ]);
+
+    expect(reported).toEqual(usage(4500, 400));
+  });
+
+  it('counts the rounds that reported usage when others report none, and reports nothing when none did', async () => {
+    const partial = await usageReportedFor([askForTool('a', usage(700, 20)), askForTool('b'), finish(usage(900, 80))]);
+    const silent = await usageReportedFor([askForTool('a'), askForTool('b'), finish()]);
+
+    expect({partial, silent}).toEqual({partial: usage(1600, 100), silent: undefined});
+  });
+});