+// Acceptance tests for re-cinq/HALEngine#93 (specs/hal-engine-config-hooks/spec.md, "Usage across tool rounds").
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const createSession = (content: string): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content, timestamp: SENT_AT}],
+});
+
+// One scripted round per sendMessage call, to drive the tool loop round by round.
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const lookupRegistry = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found',
+  }));
+  return registry;
+};
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+const toolStop = (usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason: 'tool_use', usage});
+const doneStop = (usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason: 'end_turn', usage});
+
+// Runs one user message and returns the usage afterModelResponse was handed.
+async function reportedUsage(rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> {
+  let seen: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      seen = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(
+    scriptedProvider(rounds),
+    new PromptBuilder({identity: 'You are a test assistant.'}),
+    lookupRegistry(),
+    {hooks}
+  );
+
+  await orchestrator.processMessage(createSession('ask'));
+
+  return seen;
+}
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports the sum of every provider call in a turn that ran two tool rounds', async () => {
+    const usage = await reportedUsage([
+      [TOOL_CALL, toolStop({inputTokens: 100, outputTokens: 10, totalTokens: 110})],
+      [TOOL_CALL, toolStop({inputTokens: 200, outputTokens: 20, totalTokens: 220})],
+      [{type: 'text', text: 'answer'}, doneStop({inputTokens: 300, outputTokens: 30, totalTokens: 330})],
+    ]);
+
+    expect(usage).toEqual({inputTokens: 600, outputTokens: 60, totalTokens: 660});
+  });
+
+  it('counts the rounds that reported usage, and reports none when no round reported any', async () => {
+    const partly = await reportedUsage([
+      [TOOL_CALL, toolStop({inputTokens: 100, outputTokens: 10, totalTokens: 110})],
+      [TOOL_CALL, toolStop()],
+      [{type: 'text', text: 'answer'}, doneStop({inputTokens: 300, outputTokens: 30, totalTokens: 330})],
+    ]);
+    const never = await reportedUsage([
+      [TOOL_CALL, toolStop()],
+      [{type: 'text', text: 'answer'}, doneStop()],
+    ]);
+
+    expect({partly, never}).toEqual({partly: {inputTokens: 400, outputTokens: 40, totalTokens: 440}, never: undefined});
+  });
+});