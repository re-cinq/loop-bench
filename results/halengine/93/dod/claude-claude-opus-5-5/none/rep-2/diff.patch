+// Acceptance tests for re-cinq/HALEngine#93 (specs/hal-engine-config-hooks/spec.md#usage-across-tool-rounds).
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+
+const usageOf = (inputTokens: number, outputTokens: number): UsageMetadata => ({
+  inputTokens,
+  outputTokens,
+  totalTokens: inputTokens + outputTokens,
+});
+
+const toolRound = (usage?: UsageMetadata): MessageChunk[] => [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage}];
+const finalRound = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'done'},
+  {type: 'stop', stopReason: 'end_turn', usage},
+];
+
+// One scripted round per sendMessage call, to drive the tool loop round by round.
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const lookupRegistry = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found it',
+  }));
+  return registry;
+};
+
+const createSession = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'ask', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+async function usageReportedFor(rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> {
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reported = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(scriptedProvider(rounds), promptBuilder, lookupRegistry(), {hooks});
+
+  await orchestrator.processMessage(createSession());
+
+  return reported;
+}
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports the sum of every provider call in a turn driven through two tool rounds', async () => {
+    const reported = await usageReportedFor([
+      toolRound(usageOf(100, 20)),
+      toolRound(usageOf(300, 40)),
+      finalRound(usageOf(500, 60)),
+    ]);
+
+    expect(reported).toEqual(usageOf(900, 120));
+  });
+
+  it('counts the rounds that reported usage when others did not, and reports nothing when none did', async () => {
+    const partial = await usageReportedFor([toolRound(usageOf(100, 20)), toolRound(), finalRound(usageOf(500, 60))]);
+    const silent = await usageReportedFor([toolRound(), toolRound(), finalRound()]);
+
+    expect({partial, silent}).toEqual({partial: usageOf(600, 80), silent: undefined});
+  });
+});