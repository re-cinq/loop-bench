+// Acceptance tests for re-cinq/HALEngine#93: afterModelResponse must report usage
+// covering every provider call in a turn, not only the last round's.
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const createSession = (content: string): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content, timestamp: SENT_AT}],
+});
+
+// Each provider call plays the next scripted round.
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const lookupRegistry = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found',
+  }));
+  return registry;
+};
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+const toolStop = (usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason: 'tool_use', usage});
+const doneStop = (usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason: 'end_turn', usage});
+
+// Runs one turn and returns the usage afterModelResponse was handed.
+const usageReportedFor = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reported = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(scriptedProvider(rounds), promptBuilder, lookupRegistry(), {hooks});
+  await orchestrator.processMessage(createSession('ask'));
+  return reported;
+};
+
+const ROUND_1: UsageMetadata = {inputTokens: 100, outputTokens: 7, totalTokens: 107};
+const ROUND_2: UsageMetadata = {inputTokens: 230, outputTokens: 11, totalTokens: 241};
+const ROUND_3: UsageMetadata = {inputTokens: 405, outputTokens: 42, totalTokens: 447};
+
+describe('afterModelResponse turn usage (#93)', () => {
+  it('reports usage summed over every provider call of a turn that ran two tool rounds', async () => {
+    const reported = await usageReportedFor([
+      [TOOL_CALL, toolStop(ROUND_1)],
+      [TOOL_CALL, toolStop(ROUND_2)],
+      [{type: 'text', text: 'the answer'}, doneStop(ROUND_3)],
+    ]);
+
+    expect(reported).toEqual({inputTokens: 735, outputTokens: 60, totalTokens: 795});
+  });
+
+  it('counts the rounds that reported usage when another round reported none, and reports nothing when none did', async () => {
+    const withGap = await usageReportedFor([
+      [TOOL_CALL, toolStop(ROUND_1)],
+      [TOOL_CALL, toolStop()],
+      [{type: 'text', text: 'the answer'}, doneStop(ROUND_3)],
+    ]);
+    const withNone = await usageReportedFor([
+      [TOOL_CALL, toolStop()],
+      [{type: 'text', text: 'the answer'}, doneStop()],
+    ]);
+
+    expect({withGap, withNone}).toEqual({
+      withGap: {inputTokens: 505, outputTokens: 49, totalTokens: 554},
+      withNone: undefined,
+    });
+  });
+});