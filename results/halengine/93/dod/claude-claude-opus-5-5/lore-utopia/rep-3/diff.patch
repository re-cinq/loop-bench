+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// Issue #93: afterModelResponse must report usage covering every provider call of a turn, not only the last.
+
+const askForTool = (id: string, usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id, name: 'lookup', input: {}}},
+  {type: 'stop', stopReason: 'tool_use', usage},
+];
+const finish = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'Done.'},
+  {type: 'stop', stopReason: 'end_turn', usage},
+];
+
+// Three provider calls, two tool rounds: each round yields its own scripted chunks.
+const usageOfTurn = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let call = 0;
+  const provider: AIProvider = {
+    async *sendMessage() {
+      yield* rounds[call++];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Looks something up.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reported = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Usage test.'}), registry, {
+    hooks,
+  });
+  const session: ChatSession = {sessionId: 's', userId: 'u', entries: [{role: 'user', content: 'go', timestamp: 't'}]};
+  await orchestrator.processMessage(session);
+  return reported;
+};
+
+const ROUND_1: UsageMetadata = {inputTokens: 100, outputTokens: 10, totalTokens: 110};
+const ROUND_2: UsageMetadata = {inputTokens: 300, outputTokens: 20, totalTokens: 320};
+const ROUND_3: UsageMetadata = {inputTokens: 500, outputTokens: 40, totalTokens: 540};
+
+describe('turn usage reported to afterModelResponse', () => {
+  it('sums the usage of every provider call in a turn driven through two tool rounds', async () => {
+    const usage = await usageOfTurn([askForTool('c1', ROUND_1), askForTool('c2', ROUND_2), finish(ROUND_3)]);
+
+    expect(usage).toEqual({inputTokens: 900, outputTokens: 70, totalTokens: 970});
+  });
+
+  it('counts the rounds that reported usage, and reports nothing when no round did', async () => {
+    const partial = await usageOfTurn([askForTool('c1', ROUND_1), askForTool('c2'), finish(ROUND_3)]);
+    const silent = await usageOfTurn([askForTool('c1'), askForTool('c2'), finish()]);
+
+    expect({partial, silent}).toEqual({
+      partial: {inputTokens: 600, outputTokens: 50, totalTokens: 650},
+      silent: undefined,
+    });
+  });
+});