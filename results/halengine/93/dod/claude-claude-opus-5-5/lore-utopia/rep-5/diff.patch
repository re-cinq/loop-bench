+// Acceptance tests for re-cinq/HALEngine#93: afterModelResponse reports the usage of every
+// provider call in a turn, not only the last round's.
+// Spec: specs/hal-engine-config-hooks/spec.md#installing-hooks-through-config
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+
+const session = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'ask', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+// Each entry is one provider call; a round asks for a tool unless it is the last one.
+const scriptedProvider = (usages: (UsageMetadata | undefined)[]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const index = round++;
+      const last = index === usages.length - 1;
+      if (last) yield {type: 'text', text: 'done'};
+      else yield TOOL_CALL;
+      yield {type: 'stop', stopReason: last ? 'end_turn' : 'tool_use', usage: usages[index]};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const lookupRegistry = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found it',
+  }));
+  return registry;
+};
+
+const reportedUsage = async (usages: (UsageMetadata | undefined)[]): Promise<UsageMetadata | undefined> => {
+  let seen: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      seen = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(scriptedProvider(usages), promptBuilder, lookupRegistry(), {hooks});
+
+  await orchestrator.processMessage(session());
+
+  return seen;
+};
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports the sum of every provider call in a turn that ran two tool rounds', async () => {
+    const usage = await reportedUsage([
+      {inputTokens: 100, outputTokens: 10, totalTokens: 110},
+      {inputTokens: 200, outputTokens: 20, totalTokens: 220},
+      {inputTokens: 400, outputTokens: 40, totalTokens: 440},
+    ]);
+
+    expect(usage).toEqual({inputTokens: 700, outputTokens: 70, totalTokens: 770});
+  });
+
+  it('counts the rounds that reported usage and reports nothing when no round did', async () => {
+    const partial = await reportedUsage([
+      {inputTokens: 100, outputTokens: 10, totalTokens: 110},
+      undefined,
+      {inputTokens: 400, outputTokens: 40, totalTokens: 440},
+    ]);
+    const none = await reportedUsage([undefined, undefined, undefined]);
+
+    expect({partial, none}).toEqual({
+      partial: {inputTokens: 500, outputTokens: 50, totalTokens: 550},
+      none: undefined,
+    });
+  });
+});