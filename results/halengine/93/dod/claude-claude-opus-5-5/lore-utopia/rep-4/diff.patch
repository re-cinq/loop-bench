+// Acceptance tests for re-cinq/HALEngine#93: afterModelResponse reports the usage of every provider call in a turn.
+// Validates specs/hal-engine-config-hooks/spec.md, the afterModelResponse usage statement under "Measured semantics".
+// The no-tool path is pinned by the unedited 'receives collected response text and usage' in chatOrchestrator.test.ts.
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const session = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'ask', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+// One scripted round per sendMessage call, so each provider call reports its own known usage.
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const lookupRegistry = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found',
+  }));
+  return registry;
+};
+
+const toolRound = (id: string, usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id, name: 'lookup', input: {q: id}}},
+  {type: 'stop', stopReason: 'tool_use', usage},
+];
+
+const finalRound = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'answer'},
+  {type: 'stop', stopReason: 'end_turn', usage},
+];
+
+const usageReportedFor = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reported = usage;
+    },
+  };
+
+  await createChatOrchestrator(scriptedProvider(rounds), promptBuilder, lookupRegistry(), {hooks}).processMessage(
+    session()
+  );
+
+  return reported;
+};
+
+describe('afterModelResponse usage across tool rounds (specs/hal-engine-config-hooks/spec.md#measured-semantics)', () => {
+  it('reports usage covering every provider call of a turn driven through two tool rounds', async () => {
+    const reported = await usageReportedFor([
+      toolRound('call-1', {inputTokens: 100, outputTokens: 10, totalTokens: 110}),
+      toolRound('call-2', {inputTokens: 200, outputTokens: 20, totalTokens: 220}),
+      finalRound({inputTokens: 300, outputTokens: 30, totalTokens: 330}),
+    ]);
+
+    expect(reported).toEqual({inputTokens: 600, outputTokens: 60, totalTokens: 660});
+  });
+
+  it('counts the rounds that reported usage when others did not, and reports nothing when none did', async () => {
+    const partial = await usageReportedFor([
+      toolRound('call-1', {inputTokens: 100, outputTokens: 10, totalTokens: 110}),
+      toolRound('call-2'),
+      finalRound({inputTokens: 300, outputTokens: 30, totalTokens: 330}),
+    ]);
+    const none = await usageReportedFor([toolRound('call-1'), toolRound('call-2'), finalRound()]);
+
+    expect({partial, none}).toEqual({
+      partial: {inputTokens: 400, outputTokens: 40, totalTokens: 440},
+      none: undefined,
+    });
+  });
+});