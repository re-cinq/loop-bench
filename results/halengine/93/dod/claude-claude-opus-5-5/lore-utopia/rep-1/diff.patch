+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../shared/logger.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// Acceptance for re-cinq/HALEngine#93: specs/hal-engine-config-hooks/spec.md, "Turn usage".
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const lookupRegistry = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => 'r');
+  return registry;
+};
+
+const toolRound = (id: string, usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id, name: 'lookup', input: {}}},
+  usage ? {type: 'stop', stopReason: 'tool_use', usage} : {type: 'stop', stopReason: 'tool_use'},
+];
+const finalRound = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'done'},
+  usage ? {type: 'stop', stopReason: 'end_turn', usage} : {type: 'stop', stopReason: 'end_turn'},
+];
+
+const usageOfTurn = async (rounds: MessageChunk[][]): Promise<{called: boolean; usage?: UsageMetadata}> => {
+  const seen: {called: boolean; usage?: UsageMetadata} = {called: false};
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      seen.called = true;
+      seen.usage = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(
+    scriptedProvider(rounds),
+    new PromptBuilder({identity: 'Usage test.'}),
+    lookupRegistry(),
+    {hooks}
+  );
+  const session: ChatSession = {sessionId: 's', userId: 'u', entries: [{role: 'user', content: 'go', timestamp: 't'}]};
+  await orchestrator.processMessage(session);
+  return seen;
+};
+
+describe('afterModelResponse usage for a turn that ran tools', () => {
+  beforeEach(() => {
+    const quiet = () => undefined;
+    setLogger({debug: quiet, info: quiet, warn: quiet, error: quiet});
+  });
+
+  it('reports the sum of every provider call in a turn driven through two tool rounds', async () => {
+    const seen = await usageOfTurn([
+      toolRound('c1', {inputTokens: 100, outputTokens: 10, totalTokens: 110}),
+      toolRound('c2', {inputTokens: 200, outputTokens: 20, totalTokens: 220}),
+      finalRound({inputTokens: 300, outputTokens: 30, totalTokens: 330}),
+    ]);
+
+    expect(seen).toEqual({called: true, usage: {inputTokens: 600, outputTokens: 60, totalTokens: 660}});
+  });
+
+  it('counts the rounds that reported usage when others did not, and reports nothing when none did', async () => {
+    const partly = await usageOfTurn([
+      toolRound('c1', {inputTokens: 100, outputTokens: 10, totalTokens: 110}),
+      toolRound('c2'),
+      finalRound({inputTokens: 300, outputTokens: 30, totalTokens: 330}),
+    ]);
+    const silent = await usageOfTurn([toolRound('c1'), toolRound('c2'), finalRound()]);
+
+    expect({partly, silent}).toEqual({
+      partly: {called: true, usage: {inputTokens: 400, outputTokens: 40, totalTokens: 440}},
+      silent: {called: true, usage: undefined},
+    });
+  });
+});