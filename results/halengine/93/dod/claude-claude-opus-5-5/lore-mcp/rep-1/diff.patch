+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+
+const session = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'ask', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+// One scripted provider call per entry: the first two ask for a tool, the last answers.
+const threeCallProvider = (usages: (UsageMetadata | undefined)[]): AIProvider => {
+  const rounds: MessageChunk[][] = [
+    [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usages[0]}],
+    [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usages[1]}],
+    [
+      {type: 'text', text: 'done'},
+      {type: 'stop', stopReason: 'end_turn', usage: usages[2]},
+    ],
+  ];
+  let call = 0;
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[call++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const lookupRegistry = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => 'r');
+  return registry;
+};
+
+// Runs one turn through two tool rounds and returns what afterModelResponse was handed as usage.
+const reportedUsage = async (usages: (UsageMetadata | undefined)[]): Promise<UsageMetadata | undefined | 'unset'> => {
+  let seen: UsageMetadata | undefined | 'unset' = 'unset';
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      seen = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(threeCallProvider(usages), promptBuilder, lookupRegistry(), {hooks});
+  await orchestrator.processMessage(session());
+  return seen;
+};
+
+describe('afterModelResponse usage across tool rounds (specs/hal-engine-config-hooks/spec.md#8)', () => {
+  it('reports the sum of every provider call in a turn that ran two tool rounds', async () => {
+    const usage = await reportedUsage([
+      {inputTokens: 100, outputTokens: 10, totalTokens: 110},
+      {inputTokens: 200, outputTokens: 20, totalTokens: 220},
+      {inputTokens: 300, outputTokens: 30, totalTokens: 330},
+    ]);
+
+    expect(usage).toEqual({inputTokens: 600, outputTokens: 60, totalTokens: 660});
+  });
+});
+
+describe('afterModelResponse usage when some rounds report none (specs/hal-engine-config-hooks/spec.md#9)', () => {
+  it('counts only the rounds that reported usage, and reports none when no round did', async () => {
+    const partial = await reportedUsage([
+      {inputTokens: 100, outputTokens: 10, totalTokens: 110},
+      undefined,
+      {inputTokens: 300, outputTokens: 30, totalTokens: 330},
+    ]);
+    const none = await reportedUsage([undefined, undefined, undefined]);
+
+    expect({partial, none}).toEqual({partial: {inputTokens: 400, outputTokens: 40, totalTokens: 440}, none: undefined});
+  });
+});