+++ b/src/orchestration/chatOrchestrator.turnUsage.acceptance.test.ts
@@ -0,0 +1,90 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import {scriptedProvider} from './chatOrchestrator.fixture.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function lookupRegistry(): ToolRegistry {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found it',
+  }));
+  return registry;
+}
+
+const toolRound = (usage: UsageMetadata | undefined): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}},
+  {type: 'stop', stopReason: 'tool_use', usage},
+];
+
+const answerRound = (usage: UsageMetadata | undefined): MessageChunk[] => [
+  {type: 'text', text: 'done'},
+  {type: 'stop', stopReason: 'end_turn', usage},
+];
+
+function captureUsage(): {hooks: OrchestratorHooks; reported: () => UsageMetadata | undefined} {
+  let captured: UsageMetadata | undefined;
+  return {
+    hooks: {
+      afterModelResponse: async (_session, _text, usage) => {
+        captured = usage;
+      },
+    },
+    reported: () => captured,
+  };
+}
+
+describe('turn usage across tool rounds', () => {
+  it('reports the sum of every provider call in a turn that ran two tool rounds', async () => {
+    const {hooks, reported} = captureUsage();
+    const provider = scriptedProvider([
+      toolRound({inputTokens: 100, outputTokens: 20, totalTokens: 120}),
+      toolRound({inputTokens: 300, outputTokens: 40, totalTokens: 340}),
+      answerRound({inputTokens: 500, outputTokens: 60, totalTokens: 560}),
+    ]);
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, lookupRegistry(), {hooks});
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(reported()).toEqual({inputTokens: 900, outputTokens: 120, totalTokens: 1020});
+  });
+
+  it('keeps the usage of an earlier round when a round in between reports none', async () => {
+    const {hooks, reported} = captureUsage();
+    const provider = scriptedProvider([
+      toolRound({inputTokens: 11, outputTokens: 3, totalTokens: 14}),
+      toolRound(undefined),
+      answerRound({inputTokens: 7, outputTokens: 2, totalTokens: 9}),
+    ]);
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, lookupRegistry(), {hooks});
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(reported()).toEqual({inputTokens: 18, outputTokens: 5, totalTokens: 23});
+  });
+
+  it('reports nothing when no round in the turn reports usage', async () => {
+    const {hooks, reported} = captureUsage();
+    const provider = scriptedProvider([toolRound(undefined), answerRound(undefined)]);
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, lookupRegistry(), {hooks});
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(reported()).toBeUndefined();
+  });
+});
