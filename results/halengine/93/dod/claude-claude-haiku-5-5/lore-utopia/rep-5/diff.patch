@@ -40,3 +40,13 @@ export function extractStopReason(chunk: MessageChunk): string | null {
 export function extractUsage(chunk: MessageChunk): UsageMetadata | undefined {
   return chunk.type === 'stop' ? chunk.usage : undefined;
 }
+
+export function addUsage(acc: UsageMetadata | undefined, round: UsageMetadata | undefined): UsageMetadata | undefined {
+  if (!round) return acc;
+  if (!acc) return round;
+  return {
+    inputTokens: acc.inputTokens + round.inputTokens,
+    outputTokens: acc.outputTokens + round.outputTokens,
+    totalTokens: acc.totalTokens + round.totalTokens,
+  };
+}