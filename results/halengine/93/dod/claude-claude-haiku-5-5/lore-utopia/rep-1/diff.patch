@@ -0,0 +1,89 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+// One scripted round per provider call, so each round reports the usage the test set for it.
+const providerReplaying = (rounds: MessageChunk[][]): AIProvider => {
+  let call = 0;
+
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[call++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const lookupTool = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found',
+  }));
+  return registry;
+};
+
+const askForTool = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}},
+  {type: 'stop', stopReason: 'tool_use', usage},
+];
+const finish = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'done'},
+  {type: 'stop', stopReason: 'end_turn', usage},
+];
+
+// Runs one user turn and returns the usage the afterModelResponse hook was handed.
+const usageHandedToHook = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let handed: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      handed = usage;
+    },
+  };
+  const session: ChatSession = {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'ask', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const orchestrator = createChatOrchestrator(
+    providerReplaying(rounds),
+    new PromptBuilder({identity: 'test'}),
+    lookupTool(),
+    {
+      hooks,
+    }
+  );
+
+  await orchestrator.processMessage(session);
+  return handed;
+};
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('hands the hook the usage summed over every provider call in a turn that ran two tool rounds', async () => {
+    const handed = await usageHandedToHook([
+      askForTool({inputTokens: 100, outputTokens: 20, totalTokens: 120}),
+      askForTool({inputTokens: 300, outputTokens: 40, totalTokens: 340}),
+      finish({inputTokens: 500, outputTokens: 60, totalTokens: 560}),
+    ]);
+
+    expect(handed).toEqual({inputTokens: 900, outputTokens: 120, totalTokens: 1020});
+  });
+
+  it('counts the rounds that reported when a middle round reports none, and reports nothing when no round did', async () => {
+    const withGap = await usageHandedToHook([
+      askForTool({inputTokens: 100, outputTokens: 20, totalTokens: 120}),
+      askForTool(),
+      finish({inputTokens: 500, outputTokens: 60, totalTokens: 560}),
+    ]);
+    const nothingReported = await usageHandedToHook([askForTool(), finish()]);
+
+    expect({withGap, nothingReported}).toEqual({
+      withGap: {inputTokens: 600, outputTokens: 80, totalTokens: 680},
+      nothingReported: undefined,
+    });
+  });
+});