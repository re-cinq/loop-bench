@@ -0,0 +1,71 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {scriptedProvider, registryReturning} from './chatOrchestrator.testFixtures.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+const STOP_FOR_TOOL: MessageChunk = {type: 'stop', stopReason: 'tool_use'};
+const STOP_FOR_TOOL_WITH = (usage: UsageMetadata): MessageChunk => ({type: 'stop', stopReason: 'tool_use', usage});
+const STOP_DONE_WITH = (usage: UsageMetadata): MessageChunk => ({type: 'stop', stopReason: 'end_turn', usage});
+
+const createSession = (content: string): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content, timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const usageReportedToHook = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reported = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(
+    scriptedProvider(rounds),
+    promptBuilder,
+    registryReturning({result: 'r'}),
+    {
+      hooks,
+    }
+  );
+
+  await orchestrator.processMessage(createSession('ask'));
+  return reported;
+};
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports 660 total tokens for a turn of two tool rounds and a final answer', async () => {
+    const reported = await usageReportedToHook([
+      [TOOL_CALL, STOP_FOR_TOOL_WITH({inputTokens: 100, outputTokens: 10, totalTokens: 110})],
+      [TOOL_CALL, STOP_FOR_TOOL_WITH({inputTokens: 200, outputTokens: 20, totalTokens: 220})],
+      [{type: 'text', text: 'done'}, STOP_DONE_WITH({inputTokens: 300, outputTokens: 30, totalTokens: 330})],
+    ]);
+
+    expect(reported).toEqual({inputTokens: 600, outputTokens: 60, totalTokens: 660});
+  });
+
