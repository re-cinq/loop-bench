+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// Each round's provider call reports its own usage, and the hook must see the turn's total, not the last round's.
+
+const ASK_FOR_TOOL: MessageChunk = {type: 'tool_use', toolCall: {id: 'c', name: 'lookup', input: {}}};
+const SAY_DONE: MessageChunk = {type: 'text', text: 'Done.'};
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let call = 0;
+  return {
+    async *sendMessage() {
+      yield* rounds[call++];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+// Resolves with whatever usage afterModelResponse was handed for the one turn.
+const usageReportedForTurn = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reported = usage;
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Looks something up.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  const orchestrator = createChatOrchestrator(
+    scriptedProvider(rounds),
+    new PromptBuilder({identity: 'Usage test.'}),
+    registry,
+    {hooks}
+  );
+  const session: ChatSession = {
+    sessionId: 's',
+    userId: 'u',
+    entries: [{role: 'user', content: 'look it up', timestamp: 't'}],
+  };
+  await orchestrator.processMessage(session);
+  return reported;
+};
+
+describe('usage reported to afterModelResponse for a turn that ran tools', () => {
+  it('reports the sum of the usage of every provider call across two tool rounds', async () => {
+    const usage = await usageReportedForTurn([
+      [
+        ASK_FOR_TOOL,
+        {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 100, outputTokens: 20, totalTokens: 120}},
+      ],
+      [
+        ASK_FOR_TOOL,
+        {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 300, outputTokens: 50, totalTokens: 350}},
+      ],
+      [SAY_DONE, {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 500, outputTokens: 30, totalTokens: 530}}],
+    ]);
+
+    expect(usage).toEqual({inputTokens: 900, outputTokens: 100, totalTokens: 1000});
+  });
+
+  it('adds up the rounds that reported and leaves out a round that reported none', async () => {
+    const usage = await usageReportedForTurn([
+      [
+        ASK_FOR_TOOL,
+        {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 100, outputTokens: 20, totalTokens: 120}},
+      ],
+      [ASK_FOR_TOOL, {type: 'stop', stopReason: 'tool_use'}],
+      [SAY_DONE, {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 500, outputTokens: 30, totalTokens: 530}}],
+    ]);
+
+    expect(usage).toEqual({inputTokens: 600, outputTokens: 50, totalTokens: 650});
+  });
+});