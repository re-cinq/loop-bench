+++ b/src/orchestration/usageAcrossRounds.acceptance.test.ts
@@ -0,0 +1,88 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+
+// Each inner list is what one provider call streams, in order.
+function scriptedProvider(calls: MessageChunk[][]): AIProvider {
+  let call = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of calls[call++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const toolRound = (usage?: UsageMetadata): MessageChunk[] => [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage}];
+
+const finalRound = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'done'},
+  {type: 'stop', stopReason: 'end_turn', usage},
+];
+
+// The usage afterModelResponse is handed for one whole user turn.
+async function usageReportedFor(provider: AIProvider): Promise<UsageMetadata | undefined> {
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reported = usage;
+    },
+  };
+
+  const orchestrator = createChatOrchestrator(provider, promptBuilder, lookupRegistry(), {hooks});
+  await orchestrator.processMessage(createSession('ask'));
+
+  return reported;
+}
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function lookupRegistry(): ToolRegistry {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => 'r');
+  return registry;
+}
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports the summed usage of every provider call when a turn runs two tool rounds', async () => {
+    const provider = scriptedProvider([
+      toolRound({inputTokens: 100, outputTokens: 20, totalTokens: 120}),
+      toolRound({inputTokens: 300, outputTokens: 40, totalTokens: 340}),
+      finalRound({inputTokens: 500, outputTokens: 60, totalTokens: 560}),
+    ]);
+
+    expect(await usageReportedFor(provider)).toEqual({inputTokens: 900, outputTokens: 120, totalTokens: 1020});
+  });
+
+  it('leaves a silent round out of the total when some rounds report usage', async () => {
+    const someSilent = scriptedProvider([
+      toolRound({inputTokens: 10, outputTokens: 5, totalTokens: 15}),
+      toolRound(),
+      finalRound({inputTokens: 20, outputTokens: 10, totalTokens: 30}),
+    ]);
+    expect(await usageReportedFor(someSilent)).toEqual({inputTokens: 30, outputTokens: 15, totalTokens: 45});
+  });
+
+  it('reports nothing when no round reports usage', async () => {
+    const allSilent = scriptedProvider([toolRound(), finalRound()]);
+    expect(await usageReportedFor(allSilent)).toBeUndefined();
+  });
+});