@@ -0,0 +1,87 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {setLogger} from '../shared/logger.js';
+
+// Each inner array is one provider call: the rounds the scripted provider answers in order.
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let call = 0;
+  return {
+    async *sendMessage() {
+      yield* rounds[call++];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const lookupRegistry = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Looks something up.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  return registry;
+};
+
+const ASK_FOR_TOOL: MessageChunk = {type: 'tool_use', toolCall: {id: 'c', name: 'lookup', input: {}}};
+const toolRound = (usage?: UsageMetadata): MessageChunk[] => [
+  ASK_FOR_TOOL,
+  {type: 'stop', stopReason: 'tool_use', usage},
+];
+const finalRound = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'Done.'},
+  {type: 'stop', stopReason: 'end_turn', usage},
+];
+
+const session: ChatSession = {sessionId: 's', userId: 'u', entries: [{role: 'user', content: 'ask', timestamp: ''}]};
+
+// The usage afterModelResponse receives for one user message driven through the scripted rounds.
+const usageOfTurn = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let received: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      received = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(
+    scriptedProvider(rounds),
+    new PromptBuilder({identity: 'Usage test.'}),
+    lookupRegistry(),
+    {hooks}
+  );
+  await orchestrator.processMessage(session);
+  return received;
+};
+
+const FIRST: UsageMetadata = {inputTokens: 100, outputTokens: 20, totalTokens: 120};
+const SECOND: UsageMetadata = {inputTokens: 300, outputTokens: 40, totalTokens: 340};
+const THIRD: UsageMetadata = {inputTokens: 500, outputTokens: 60, totalTokens: 560};
+const FIRST_AND_THIRD: UsageMetadata = {inputTokens: 600, outputTokens: 80, totalTokens: 680};
+
+describe('afterModelResponse usage across tool rounds', () => {
+  beforeEach(() => {
+    const quiet = () => undefined;
+    setLogger({debug: quiet, info: quiet, error: quiet, warn: quiet});
+  });
+
+  afterEach(() => setLogger());
+
+  it('reports the sum of every provider call in a turn that ran two tool rounds', async () => {
+    const usage = await usageOfTurn([toolRound(FIRST), toolRound(SECOND), finalRound(THIRD)]);
+
+    expect(usage).toEqual({inputTokens: 900, outputTokens: 120, totalTokens: 1020});
+  });
+
+  it('counts the rounds that reported usage and reports nothing when no round did', async () => {
+    const mixed = await usageOfTurn([toolRound(FIRST), toolRound(), finalRound(THIRD)]);
+    const silent = await usageOfTurn([toolRound(), finalRound()]);
+
+    expect(mixed).toEqual(FIRST_AND_THIRD);
+    expect(silent).toBeUndefined();
+  });
+});