diff --git a/src/orchestration/chatOrchestratorUsage.acceptance.test.ts b/src/orchestration/chatOrchestratorUsage.acceptance.test.ts
new file mode 100644
index 0000000..63bf1b6
--- /dev/null
+++ b/src/orchestration/chatOrchestratorUsage.acceptance.test.ts
@@ -0,0 +1,80 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import {scriptedProvider} from './chatOrchestrator.testHelpers.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const lookupRegistry = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found',
+  }));
+  return registry;
+};
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+
+const toolRound = (usage?: UsageMetadata): MessageChunk[] => [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage}];
+
+const finalRound = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'answer'},
+  {type: 'stop', stopReason: 'end_turn', usage},
+];
+
+// Runs one turn and returns the usage the afterModelResponse hook was handed.
+async function usageReportedBy(provider: AIProvider): Promise<UsageMetadata | undefined> {
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reported = usage;
+    },
+  };
+
+  await createChatOrchestrator(provider, promptBuilder, lookupRegistry(), {hooks}).processMessage(createSession('ask'));
+  return reported;
+}
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports the sum of every provider call in a turn that ran two tool rounds', async () => {
+    const reported = await usageReportedBy(
+      scriptedProvider([
+        toolRound({inputTokens: 10, outputTokens: 5, totalTokens: 15}),
+        toolRound({inputTokens: 20, outputTokens: 7, totalTokens: 27}),
+        finalRound({inputTokens: 30, outputTokens: 9, totalTokens: 39}),
+      ])
+    );
+
+    expect(reported).toEqual({inputTokens: 60, outputTokens: 21, totalTokens: 81});
+  });
+
+  it('leaves out a round that reported nothing, and reports nothing when no round did', async () => {
+    const partial = await usageReportedBy(
+      scriptedProvider([
+        toolRound({inputTokens: 10, outputTokens: 5, totalTokens: 15}),
+        toolRound(),
+        finalRound({inputTokens: 20, outputTokens: 7, totalTokens: 27}),
+      ])
+    );
+    const silent = await usageReportedBy(scriptedProvider([toolRound(), finalRound()]));
+
+    expect({partial, silent}).toEqual({
+      partial: {inputTokens: 30, outputTokens: 12, totalTokens: 42},
+      silent: undefined,
+    });
+  });
+});
