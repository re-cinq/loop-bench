+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../shared/logger.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// Each provider call reports its own counts, so a total that covers only the last call is visibly wrong.
+const toolRound = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}},
+  {type: 'stop', stopReason: 'tool_use', usage},
+];
+const finalRound = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'done'},
+  {type: 'stop', stopReason: 'end_turn', usage},
+];
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let call = 0;
+  return {
+    async *sendMessage() {
+      yield* rounds[call++] ?? [];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+// Runs one turn and returns the usage the afterModelResponse hook received.
+const usageOfTurn = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let received: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      received = usage;
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Looks something up.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  const orchestrator = createChatOrchestrator(
+    scriptedProvider(rounds),
+    new PromptBuilder({identity: 'Usage test.'}),
+    registry,
+    {hooks}
+  );
+  const session: ChatSession = {sessionId: 's', userId: 'u', entries: [{role: 'user', content: 'go', timestamp: 't'}]};
+  await orchestrator.processMessage(session);
+  return received;
+};
+
+describe('afterModelResponse usage across tool rounds', () => {
+  beforeEach(() => {
+    const quiet = () => undefined;
+    setLogger({debug: quiet, info: quiet, error: quiet, warn: quiet});
+  });
+
+  it('reports the usage of every provider call in a turn that ran two tool rounds', async () => {
+    const received = await usageOfTurn([
+      toolRound({inputTokens: 100, outputTokens: 20, totalTokens: 120}),
+      toolRound({inputTokens: 300, outputTokens: 40, totalTokens: 340}),
+      finalRound({inputTokens: 500, outputTokens: 60, totalTokens: 560}),
+    ]);
+
+    expect(received).toEqual({inputTokens: 900, outputTokens: 120, totalTokens: 1020});
+  });
+
+  it('counts the rounds that reported and leaves the total undefined only when no round reported', async () => {
+    const mixed = await usageOfTurn([
+      toolRound({inputTokens: 100, outputTokens: 20, totalTokens: 120}),
+      toolRound(),
+      finalRound({inputTokens: 500, outputTokens: 60, totalTokens: 560}),
+    ]);
+    const silent = await usageOfTurn([toolRound(), finalRound()]);
+
+    expect({mixed, silent}).toEqual({
+      mixed: {inputTokens: 600, outputTokens: 80, totalTokens: 680},
+      silent: undefined,
+    });
+  });
+});