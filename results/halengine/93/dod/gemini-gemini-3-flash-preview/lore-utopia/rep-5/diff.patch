+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registry = new ToolRegistry();
+registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+  result: 'found it',
+}));
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+
+describe('Usage reporting across tool rounds', () => {
+  // specs/hal-engine-config-hooks/spec.md#L28
+  it('reports cumulative usage across multiple tool rounds', async () => {
+    const usage1: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const usage2: UsageMetadata = {inputTokens: 20, outputTokens: 10, totalTokens: 30};
+    const usage3: UsageMetadata = {inputTokens: 30, outputTokens: 15, totalTokens: 45};
+
+    let receivedUsage: any;
+    const hooks = {
+      afterModelResponse: async (_session: ChatSession, _text: string, usage?: any) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const provider = scriptedProvider([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usage1}],
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usage2}],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn', usage: usage3},
+      ],
+    ]);
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry, {hooks});
+    await orchestrator.processMessage(createSession('ask'));
+
+    // Should be the sum: (10+20+30, 5+10+15, 15+30+45) = (60, 30, 90)
+    // Currently it will be just usage3: (30, 15, 45)
+    expect(receivedUsage).toMatchObject({
+      inputTokens: 60,
+      outputTokens: 30,
+      totalTokens: 90,
+    });
+  });
+
+  it('reports usage for turns with no tool calls', async () => {
+    const usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    let receivedUsage: any;
+    const hooks = {
+      afterModelResponse: async (_session: ChatSession, _text: string, u?: any) => {
+        receivedUsage = u;
+      },
+    };
+
+    const provider = scriptedProvider([
+      [
+        {type: 'text', text: 'hi'},
+        {type: 'stop', stopReason: 'end_turn', usage},
+      ],
+    ]);
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+    await orchestrator.processMessage(createSession('hello'));
+
+    expect(receivedUsage).toMatchObject(usage);
+  });
+
+  it('handles partial usage reporting by summing only what is present', async () => {
+    const usage1: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    // round 2 reports no usage
+    const usage3: UsageMetadata = {inputTokens: 30, outputTokens: 15, totalTokens: 45};
+
+    let receivedUsage: any;
+    const hooks = {
+      afterModelResponse: async (_session: ChatSession, _text: string, usage?: any) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const provider = scriptedProvider([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usage1}],
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}], // missing usage
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn', usage: usage3},
+      ],
+    ]);
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry, {hooks});
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(receivedUsage).toMatchObject({
+      inputTokens: 40,
+      outputTokens: 20,
+      totalTokens: 60,
+    });
+  });
+
+  it('provides an unambiguous type with roundCount', async () => {
+    const usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    let receivedUsage: any;
+    const hooks = {
+      afterModelResponse: async (_session: ChatSession, _text: string, u?: any) => {
+        receivedUsage = u;
+      },
+    };
+
+    const provider = scriptedProvider([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage}],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn', usage},
+      ],
+    ]);
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry, {hooks});
+    await orchestrator.processMessage(createSession('ask'));
+
+    // This will fail because roundCount doesn't exist yet
+    expect(receivedUsage.roundCount).toBe(2);
+  });
+});