diff --git a/src/orchestration/usage-reporting.acceptance.test.ts b/src/orchestration/usage-reporting.acceptance.test.ts
new file mode 100644
index 0000000..e0b08d3
--- /dev/null
+++ b/src/orchestration/usage-reporting.acceptance.test.ts
@@ -0,0 +1,174 @@
+import {describe, it, expect} from '@jest/globals';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'Test assistant'});
+
+describe('Usage reporting acceptance', () => {
+  it('reports usage across multiple tool rounds', async () => {
+    // Round 0: Model calls a tool. Usage: 10 in, 5 out
+    // Round 1: Model calls another tool. Usage: 20 in, 10 out
+    // Round 2: Model answers. Usage: 30 in, 15 out
+    // Total should be: 60 in, 30 out
+
+    const usages: UsageMetadata[] = [
+      {inputTokens: 10, outputTokens: 5, totalTokens: 15},
+      {inputTokens: 20, outputTokens: 10, totalTokens: 30},
+      {inputTokens: 30, outputTokens: 15, totalTokens: 45},
+    ];
+
+    let roundCount = 0;
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        const usage = usages[roundCount];
+        if (roundCount < 2) {
+          yield {
+            type: 'tool_use',
+            toolCall: {id: `call-${roundCount}`, name: 'test_tool', input: {}},
+          };
+          yield {type: 'stop', stopReason: 'tool_use', usage};
+        } else {
+          yield {type: 'text', text: 'Final answer'};
+          yield {type: 'stop', stopReason: 'end_turn', usage};
+        }
+        roundCount++;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const toolRegistry = new ToolRegistry();
+    toolRegistry.register(
+      {
+        name: 'test_tool',
+        description: 'A test tool',
+        inputSchema: {type: 'object', properties: {}},
+      },
+      async () => ({result: 'tool result'})
+    );
+
+    let capturedUsage: any;
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, toolRegistry, {
+      hooks: {
+        afterModelResponse: async (_session, _text, usage) => {
+          capturedUsage = usage;
+        },
+      },
+    });
+
+    await orchestrator.processMessage(createSession());
+
+    // Currently, it only reports the last usage: {inputTokens: 30, outputTokens: 15, totalTokens: 45}
+    // We want it to be an object with total and rounds.
+    expect(capturedUsage).toBeDefined();
+    expect(capturedUsage.total).toEqual({
+      inputTokens: 60,
+      outputTokens: 30,
+      totalTokens: 90,
+    });
+    expect(capturedUsage.rounds).toHaveLength(3);
+    expect(capturedUsage.rounds).toEqual(usages);
+  });
+
+  it('reports exact usage for turns without tools', async () => {
+    const usage: UsageMetadata = {inputTokens: 5, outputTokens: 2, totalTokens: 7};
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        yield {type: 'text', text: 'hello'};
+        yield {type: 'stop', stopReason: 'end_turn', usage};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    let capturedUsage: any;
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {
+      hooks: {
+        afterModelResponse: async (_session, _text, usage) => {
+          capturedUsage = usage;
+        },
+      },
+    });
+
+    await orchestrator.processMessage(createSession());
+
+    // Should still use the new structure even for single-round turns
+    expect(capturedUsage.total).toEqual(usage);
+    expect(capturedUsage.rounds).toEqual([usage]);
+  });
+
+  it('handles missing usage on some rounds', async () => {
+    const usages: (UsageMetadata | undefined)[] = [
+      {inputTokens: 10, outputTokens: 5, totalTokens: 15},
+      undefined,
+      {inputTokens: 30, outputTokens: 15, totalTokens: 45},
+    ];
+
+    let roundCount = 0;
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        const usage = usages[roundCount];
+        if (roundCount < 2) {
+          yield {
+            type: 'tool_use',
+            toolCall: {id: `call-${roundCount}`, name: 'test_tool', input: {}},
+          };
+          yield {type: 'stop', stopReason: 'tool_use', usage};
+        } else {
+          yield {type: 'text', text: 'Final answer'};
+          yield {type: 'stop', stopReason: 'end_turn', usage};
+        }
+        roundCount++;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const toolRegistry = new ToolRegistry();
+    toolRegistry.register(
+      {
+        name: 'test_tool',
+        description: 'A test tool',
+        inputSchema: {type: 'object', properties: {}},
+      },
+      async () => ({result: 'tool result'})
+    );
+
+    let capturedUsage: any;
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, toolRegistry, {
+      hooks: {
+        afterModelResponse: async (_session, _text, usage) => {
+          capturedUsage = usage;
+        },
+      },
+    });
+
+    await orchestrator.processMessage(createSession());
+
+    expect(capturedUsage.total).toEqual({
+      inputTokens: 40,
+      outputTokens: 20,
+      totalTokens: 60,
+    });
+    // The rounds array should include the undefined round as-is (or we decide how to represent it)
+    // The ticket says "a provider that reports no usage on some rounds does not make the total undefined or NaN"
+    expect(capturedUsage.rounds).toHaveLength(3);
+    expect(capturedUsage.rounds[1]).toBeUndefined();
+  });
+});
