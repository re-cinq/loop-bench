+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolResponse} from './tools/registry.js';
+
+const SENT_AT = '2026-11-08T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryReturning = (response: ToolResponse): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => response
+  );
+  return registry;
+};
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+
+describe('Usage aggregation across tool rounds (acceptance)', () => {
+  const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+  it('reports summed usage across multiple tool rounds', async () => {
+    const usage1: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const usage2: UsageMetadata = {inputTokens: 20, outputTokens: 10, totalTokens: 30};
+
+    let receivedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const provider = scriptedProvider([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usage1}],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn', usage: usage2},
+      ],
+    ]);
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registryReturning({result: 'r'}), {hooks});
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    // Fails today: receives only usage2 {20, 10, 30}
+    expect(receivedUsage).toEqual({
+      inputTokens: 30,
+      outputTokens: 15,
+      totalTokens: 45,
+    });
+  });
+
+  it('reports single-round usage when no tools are called', async () => {
+    const usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+
+    let receivedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const provider = scriptedProvider([
+      [
+        {type: 'text', text: 'hello'},
+        {type: 'stop', stopReason: 'end_turn', usage},
+      ],
+    ]);
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+
+    await orchestrator.processMessage(createSession('hi'));
+
+    expect(receivedUsage).toEqual(usage);
+  });
+
+  it('handles missing usage on some rounds gracefully', async () => {
+    const usage1: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+
+    let receivedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const provider = scriptedProvider([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usage1}],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ]);
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registryReturning({result: 'r'}), {hooks});
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    // Fails today if it mistakenly overwrites with undefined from the last round
+    expect(receivedUsage).toEqual(usage1);
+  });
+
+  it('reports nothing when no rounds report usage', async () => {
+    let hookCalled = false;
+    let receivedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        hookCalled = true;
+        receivedUsage = usage;
+      },
+    };
+
+    const provider = scriptedProvider([
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ]);
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+
+    await orchestrator.processMessage(createSession('hi'));
+
+    expect(hookCalled).toBe(true);
+    expect(receivedUsage).toBeUndefined();
+  });
+});