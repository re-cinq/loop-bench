+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+/**
+ * The expected new type for aggregated usage.
+ * It extends UsageMetadata to be backwards compatible with consumers
+ * who only read the total counts, but adds a 'rounds' field for granularity.
+ */
+interface AggregatedUsage extends UsageMetadata {
+  rounds: UsageMetadata[];
+}
+
+describe('Usage Reporting Acceptance', () => {
+  const promptBuilder = new PromptBuilder({identity: 'test'});
+  const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+  function createSession(): ChatSession {
+    return {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+    };
+  }
+
+  it('reports cumulative usage across tool rounds', async () => {
+    // Round 1 usage
+    const usage1: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    // Round 2 usage
+    const usage2: UsageMetadata = {inputTokens: 8, outputTokens: 4, totalTokens: 12};
+
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        // If it's the first call (no tool results yet)
+        if (params.messages.length === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'tc1', name: 'test_tool', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use', usage: usage1};
+        } else {
+          yield {type: 'text', text: 'final answer'};
+          yield {type: 'stop', stopReason: 'end_turn', usage: usage2};
+        }
+      },
+      async generateStructured() {
+        return {} as any;
+      },
+    };
+
+    const toolRegistry = new ToolRegistry();
+    toolRegistry.register(
+      {
+        name: 'test_tool',
+        description: 'test',
+        inputSchema: {},
+      },
+      async () => 'tool result'
+    );
+
+    let reportedUsage: any;
+    const hooks = {
+      afterModelResponse: async (_session: ChatSession, _text: string, usage?: any) => {
+        reportedUsage = usage;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, toolRegistry, {hooks});
+    const session = createSession();
+
+    // Consume the generator to trigger the orchestrator
+    for await (const _ of orchestrator.processMessageStream(session)) {
+    }
+
+    // Should be sum of usage1 and usage2: 18, 9, 27
+    // and should contain the individual rounds.
+    expect(reportedUsage).toMatchObject({
+      inputTokens: 18,
+      outputTokens: 9,
+      totalTokens: 27,
+      rounds: [usage1, usage2],
+    });
+  });
+
+  it('reports single round usage for direct answers', async () => {
+    // specs/hal-engine-config-hooks/spec.md#1
+    const usage: UsageMetadata = {inputTokens: 5, outputTokens: 2, totalTokens: 7};
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        yield {type: 'text', text: 'direct answer'};
+        yield {type: 'stop', stopReason: 'end_turn', usage};
+      },
+      async generateStructured() {
+        return {} as any;
+      },
+    };
+
+    let reportedUsage: any;
+    const hooks = {
+      afterModelResponse: async (_session: ChatSession, _text: string, usage?: any) => {
+        reportedUsage = usage;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+    const session = createSession();
+
+    for await (const _ of orchestrator.processMessageStream(session)) {
+    }
+
+    expect(reportedUsage).toMatchObject({
+      inputTokens: 5,
+      outputTokens: 2,
+      totalTokens: 7,
+      rounds: [usage],
+    });
+  });
+
+  it('ignores rounds with missing usage in the sum', async () => {
+    const usage1: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    // Round 2 reports NO usage
+
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        if (params.messages.length === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'tc1', name: 'test_tool', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use', usage: usage1};
+        } else {
+          yield {type: 'text', text: 'final answer'};
+          yield {type: 'stop', stopReason: 'end_turn'}; // No usage
+        }
+      },
+      async generateStructured() {
+        return {} as any;
+      },
+    };
+
+    const toolRegistry = new ToolRegistry();
+    toolRegistry.register(
+      {
+        name: 'test_tool',
+        description: 'test',
+        inputSchema: {},
+      },
+      async () => 'tool result'
+    );
+
+    let reportedUsage: any;
+    const hooks = {
+      afterModelResponse: async (_session: ChatSession, _text: string, usage?: any) => {
+        reportedUsage = usage;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, toolRegistry, {hooks});
+    const session = createSession();
+
+    for await (const _ of orchestrator.processMessageStream(session)) {
+    }
+
+    expect(reportedUsage).toMatchObject({
+      inputTokens: 10,
+      outputTokens: 5,
+      totalTokens: 15,
+      rounds: [usage1],
+    });
+  });
+
+  it('reports nothing if no rounds reported usage', async () => {
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        yield {type: 'text', text: 'answer'};
+        yield {type: 'stop', stopReason: 'end_turn'}; // No usage
+      },
+      async generateStructured() {
+        return {} as any;
+      },
+    };
+
+    let reportedUsage: any;
+    const hooks = {
+      afterModelResponse: async (_session: ChatSession, _text: string, usage?: any) => {
+        reportedUsage = usage;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+    const session = createSession();
+
+    for await (const _ of orchestrator.processMessageStream(session)) {
+    }
+
+    expect(reportedUsage).toBeUndefined();
+  });
+});