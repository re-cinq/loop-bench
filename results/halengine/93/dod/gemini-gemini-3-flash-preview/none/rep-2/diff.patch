+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const STOP_FOR_TOOL = (usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason: 'tool_use', usage});
+const STOP_DONE = (usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason: 'end_turn', usage});
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('Usage reporting (acceptance)', () => {
+  it('reports summed usage across two tool rounds', async () => {
+    const usage1: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const usage2: UsageMetadata = {inputTokens: 20, outputTokens: 10, totalTokens: 30};
+    const usage3: UsageMetadata = {inputTokens: 5, outputTokens: 2, totalTokens: 7};
+
+    let receivedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const toolRegistry = new ToolRegistry();
+    toolRegistry.register(
+      {name: 'weather', description: 'get weather', inputSchema: {type: 'object', properties: {}}},
+      async () => 'sunny'
+    );
+
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        const assistantMessages = params.messages.filter(m => m.role === 'assistant');
+        const round = assistantMessages.length;
+        if (round === 0) {
+          yield {type: 'tool_use', toolCall: {id: 'c1', name: 'weather', input: {}}};
+          yield STOP_FOR_TOOL(usage1);
+        } else if (round === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'c2', name: 'weather', input: {}}};
+          yield STOP_FOR_TOOL(usage2);
+        } else {
+          yield {type: 'text', text: 'all done'};
+          yield STOP_DONE(usage3);
+        }
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, toolRegistry, {hooks});
+    await orchestrator.processMessage(createSession('what is the weather?'));
+
+    expect(receivedUsage).toEqual({
+      inputTokens: usage1.inputTokens + usage2.inputTokens + usage3.inputTokens,
+      outputTokens: usage1.outputTokens + usage2.outputTokens + usage3.outputTokens,
+      totalTokens: usage1.totalTokens + usage2.totalTokens + usage3.totalTokens,
+    });
+  });
+
+  it('handles missing usage data gracefully', async () => {
+    const usage1: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    // usage2 is missing
+    const usage3: UsageMetadata = {inputTokens: 5, outputTokens: 2, totalTokens: 7};
+
+    let receivedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const toolRegistry = new ToolRegistry();
+    toolRegistry.register(
+      {name: 'weather', description: 'get weather', inputSchema: {type: 'object', properties: {}}},
+      async () => 'sunny'
+    );
+
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        const assistantMessages = params.messages.filter(m => m.role === 'assistant');
+        const round = assistantMessages.length;
+        if (round === 0) {
+          yield {type: 'tool_use', toolCall: {id: 'c1', name: 'weather', input: {}}};
+          yield STOP_FOR_TOOL(usage1);
+        } else if (round === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'c2', name: 'weather', input: {}}};
+          yield STOP_FOR_TOOL(undefined);
+        } else {
+          yield {type: 'text', text: 'all done'};
+          yield STOP_DONE(usage3);
+        }
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, toolRegistry, {hooks});
+    await orchestrator.processMessage(createSession('what is the weather?'));
+
+    expect(receivedUsage).toEqual({
+      inputTokens: usage1.inputTokens + usage3.inputTokens,
+      outputTokens: usage1.outputTokens + usage3.outputTokens,
+      totalTokens: usage1.totalTokens + usage3.totalTokens,
+    });
+  });
+
+  it('reports undefined if no rounds report usage', async () => {
+    let receivedUsage: UsageMetadata | undefined = {inputTokens: 99, outputTokens: 99, totalTokens: 198};
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        yield {type: 'text', text: 'hello'};
+        yield STOP_DONE(undefined);
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+    await orchestrator.processMessage(createSession('hi'));
+
+    expect(receivedUsage).toBeUndefined();
+  });
+
+  it('reports original usage for turns with no tools', async () => {
+    const usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    let receivedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, u) => {
+        receivedUsage = u;
+      },
+    };
+
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        yield {type: 'text', text: 'hello'};
+        yield STOP_DONE(usage);
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+    await orchestrator.processMessage(createSession('hi'));
+
+    expect(receivedUsage).toEqual(usage);
+  });
+});