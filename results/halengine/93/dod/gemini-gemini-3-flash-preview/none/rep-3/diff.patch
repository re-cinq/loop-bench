+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('Usage Reporting Acceptance Tests', () => {
+  const promptBuilder = new PromptBuilder({identity: 'Test'});
+
+  function createSession(): ChatSession {
+    return {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: new Date().toISOString()}],
+    };
+  }
+
+  it('reports accumulated usage across multiple tool rounds', async () => {
+    // specs/hal-engine-config-hooks/spec.md
+    const usages: UsageMetadata[] = [
+      {inputTokens: 10, outputTokens: 5, totalTokens: 15},
+      {inputTokens: 20, outputTokens: 10, totalTokens: 30},
+    ];
+
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        const usage = usages[round];
+        if (round === 0) {
+          yield {
+            type: 'tool_use',
+            toolCall: {id: 'call1', name: 'test_tool', input: {}},
+          };
+          yield {type: 'stop', stopReason: 'tool_use', usage};
+        } else {
+          yield {type: 'text', text: 'Done'};
+          yield {type: 'stop', stopReason: 'end_turn', usage};
+        }
+        round++;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const toolRegistry = new ToolRegistry();
+    toolRegistry.register(
+      {
+        name: 'test_tool',
+        description: 'A test tool',
+        inputSchema: {},
+      },
+      async () => 'tool result'
+    );
+
+    let reportedUsage: UsageMetadata | undefined;
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, toolRegistry, {
+      hooks: {
+        afterModelResponse: async (_session, _text, usage) => {
+          reportedUsage = usage;
+        },
+      },
+    });
+
+    await orchestrator.processMessage(createSession());
+
+    // EXPECTATION: It should be the sum (10+20, 5+10, 15+30) = (30, 15, 45)
+    // CURRENT BEHAVIOR: It is the last round (20, 10, 30)
+    expect(reportedUsage).toEqual({
+      inputTokens: 30,
+      outputTokens: 15,
+      totalTokens: 45,
+    });
+  });
+
+  it('reports correct usage for turns with no tools', async () => {
+    // specs/hal-engine-config-hooks/spec.md
+    const usage: UsageMetadata = {inputTokens: 5, outputTokens: 2, totalTokens: 7};
+    const provider: AIProvider = {
+      async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        yield {type: 'text', text: 'Hello'};
+        yield {type: 'stop', stopReason: 'end_turn', usage};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    let reportedUsage: UsageMetadata | undefined;
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {
+      hooks: {
+        afterModelResponse: async (_session, _text, usage) => {
+          reportedUsage = usage;
+        },
+      },
+    });
+
+    await orchestrator.processMessage(createSession());
+
+    expect(reportedUsage).toEqual(usage);
+  });
+
+  it('handles missing usage on some rounds gracefully', async () => {
+    // specs/hal-engine-config-hooks/spec.md
+    const usages: (UsageMetadata | undefined)[] = [
+      {inputTokens: 10, outputTokens: 5, totalTokens: 15},
+      undefined,
+      {inputTokens: 5, outputTokens: 2, totalTokens: 7},
+    ];
+
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        const usage = usages[round];
+        if (round < 2) {
+          yield {
+            type: 'tool_use',
+            toolCall: {id: `call${round}`, name: 'test_tool', input: {}},
+          };
+          yield {type: 'stop', stopReason: 'tool_use', usage};
+        } else {
+          yield {type: 'text', text: 'Done'};
+          yield {type: 'stop', stopReason: 'end_turn', usage};
+        }
+        round++;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const toolRegistry = new ToolRegistry();
+    toolRegistry.register(
+      {
+        name: 'test_tool',
+        description: 'A test tool',
+        inputSchema: {},
+      },
+      async () => 'tool result'
+    );
+
+    let reportedUsage: UsageMetadata | undefined;
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, toolRegistry, {
+      hooks: {
+        afterModelResponse: async (_session, _text, usage) => {
+          reportedUsage = usage;
+        },
+      },
+    });
+
+    await orchestrator.processMessage(createSession());
+
+    // EXPECTATION: It should be the sum (10+5, 5+2, 15+7) = (15, 7, 22)
+    // CURRENT BEHAVIOR: It is the last round (5, 2, 7)
+    expect(reportedUsage).toEqual({
+      inputTokens: 15,
+      outputTokens: 7,
+      totalTokens: 22,
+    });
+  });
+});