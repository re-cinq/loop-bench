+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('Usage Aggregation Acceptance Tests', () => {
+  const promptBuilder = new PromptBuilder({identity: 'Test'});
+
+  function createSession(): ChatSession {
+    return {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: new Date().toISOString()}],
+    };
+  }
+
+  it('aggregates usage from multiple tool rounds into a single total', async () => {
+    // [re-cinq/HALEngine#93]
+    // specs/hal-engine-config-hooks/spec.md#L48
+    const roundUsages: UsageMetadata[] = [
+      {inputTokens: 10, outputTokens: 5, totalTokens: 15},
+      {inputTokens: 20, outputTokens: 10, totalTokens: 30},
+    ];
+
+    let roundCount = 0;
+    const provider: AIProvider = {
+      async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        const usage = roundUsages[roundCount];
+        if (roundCount === 0) {
+          yield {
+            type: 'tool_use',
+            toolCall: {id: 'call1', name: 'test_tool', input: {}},
+          };
+          yield {type: 'stop', stopReason: 'tool_use', usage};
+        } else {
+          yield {type: 'text', text: 'Done'};
+          yield {type: 'stop', stopReason: 'end_turn', usage};
+        }
+        roundCount++;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const toolRegistry = new ToolRegistry();
+    toolRegistry.register(
+      {
+        name: 'test_tool',
+        description: 'A test tool',
+        inputSchema: {},
+      },
+      async () => 'tool result'
+    );
+
+    let reportedTotal: UsageMetadata | undefined;
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, toolRegistry, {
+      hooks: {
+        afterModelResponse: async (_session, _text, totalUsage) => {
+          reportedTotal = totalUsage;
+        },
+      },
+    });
+
+    await orchestrator.processMessage(createSession());
+
+    expect(reportedTotal).toEqual({
+      inputTokens: 30,
+      outputTokens: 15,
+      totalTokens: 45,
+    });
+  });
+
+  it('provides a per-round breakdown of usage for tool-heavy turns', async () => {
+    // [re-cinq/HALEngine#93]
+    // specs/hal-engine-config-hooks/spec.md#L48
+    const roundUsages: UsageMetadata[] = [
+      {inputTokens: 10, outputTokens: 5, totalTokens: 15},
+      {inputTokens: 20, outputTokens: 10, totalTokens: 30},
+    ];
+
+    let roundCount = 0;
+    const provider: AIProvider = {
+      async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        const usage = roundUsages[roundCount];
+        if (roundCount === 0) {
+          yield {
+            type: 'tool_use',
+            toolCall: {id: 'call1', name: 'test_tool', input: {}},
+          };
+          yield {type: 'stop', stopReason: 'tool_use', usage};
+        } else {
+          yield {type: 'text', text: 'Done'};
+          yield {type: 'stop', stopReason: 'end_turn', usage};
+        }
+        roundCount++;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const toolRegistry = new ToolRegistry();
+    toolRegistry.register(
+      {
+        name: 'test_tool',
+        description: 'A test tool',
+        inputSchema: {},
+      },
+      async () => 'tool result'
+    );
+
+    let reportedRounds: UsageMetadata[] | undefined;
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, toolRegistry, {
+      hooks: {
+        // @ts-ignore: testing new signature not yet in types
+        afterModelResponse: async (_session, _text, _total, rounds) => {
+          reportedRounds = rounds;
+        },
+      },
+    });
+
+    await orchestrator.processMessage(createSession());
+
+    expect(reportedRounds).toEqual(roundUsages);
+  });
+
+  it('handles rounds with missing usage by excluding them from the total', async () => {
+    // [re-cinq/HALEngine#93]
+    // specs/hal-engine-config-hooks/spec.md#L48
+    const usages: (UsageMetadata | undefined)[] = [
+      {inputTokens: 10, outputTokens: 5, totalTokens: 15},
+      undefined,
+      {inputTokens: 5, outputTokens: 2, totalTokens: 7},
+    ];
+
+    let roundCount = 0;
+    const provider: AIProvider = {
+      async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        const usage = usages[roundCount];
+        if (roundCount < 2) {
+          yield {
+            type: 'tool_use',
+            toolCall: {id: `call${roundCount}`, name: 'test_tool', input: {}},
+          };
+          yield {type: 'stop', stopReason: 'tool_use', usage};
+        } else {
+          yield {type: 'text', text: 'Done'};
+          yield {type: 'stop', stopReason: 'end_turn', usage};
+        }
+        roundCount++;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const toolRegistry = new ToolRegistry();
+    toolRegistry.register(
+      {
+        name: 'test_tool',
+        description: 'A test tool',
+        inputSchema: {},
+      },
+      async () => 'tool result'
+    );
+
+    let reportedTotal: UsageMetadata | undefined;
+    let reportedRounds: UsageMetadata[] | undefined;
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, toolRegistry, {
+      hooks: {
+        // @ts-ignore: testing new signature not yet in types
+        afterModelResponse: async (_session, _text, totalUsage, rounds) => {
+          reportedTotal = totalUsage;
+          reportedRounds = rounds;
+        },
+      },
+    });
+
+    await orchestrator.processMessage(createSession());
+
+    expect(reportedTotal).toEqual({
+      inputTokens: 15,
+      outputTokens: 7,
+      totalTokens: 22,
+    });
+    expect(reportedRounds).toEqual([usages[0]!, usages[2]!]);
+  });
+});
