@@ -0,0 +1,160 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('Usage reporting (acceptance)', () => {
+  const promptBuilder = new PromptBuilder({identity: 'Test'});
+  const toolRegistry = new ToolRegistry();
+  toolRegistry.register({name: 'lookup', description: 'test', inputSchema: {type: 'object'}}, async () => 'result');
+
+  const session: ChatSession = {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: new Date().toISOString()}],
+  };
+
+  it('reports aggregated usage across multiple tool rounds', async () => {
+    // Round 0: 15 tokens
+    const round1Usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    // Round 1: 30 tokens
+    const round2Usage: UsageMetadata = {inputTokens: 20, outputTokens: 10, totalTokens: 30};
+    // Round 2 (final): 45 tokens
+    const finalUsage: UsageMetadata = {inputTokens: 30, outputTokens: 15, totalTokens: 45};
+
+    const provider: AIProvider = {
+      async *sendMessage(params) {
+        if (params.messages.length === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'c1', name: 'lookup', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use', usage: round1Usage};
+        } else if (params.messages.length === 3) {
+          yield {type: 'tool_use', toolCall: {id: 'c2', name: 'lookup', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use', usage: round2Usage};
+        } else {
+          yield {type: 'text', text: 'done'};
+          yield {type: 'stop', stopReason: 'end_turn', usage: finalUsage};
+        }
+      },
+      async generateStructured() {
+        return {} as any;
+      },
+    };
+
+    let reportedUsage: any;
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, toolRegistry, {
+      hooks: {
+        afterModelResponse: async (_session, _text, usage) => {
+          reportedUsage = usage;
+        },
+      },
+    });
+
+    const iterator = orchestrator.processMessageStream(session);
+    while (!(await iterator.next()).done);
+
+    // Should be SUM: 15 + 30 + 45 = 90
+    expect(reportedUsage).toMatchObject({
+      inputTokens: 60,
+      outputTokens: 30,
+      totalTokens: 90,
+    });
+  });
+
+  it('reports exact usage for turns without tools', async () => {
+    const usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const provider: AIProvider = {
+      async *sendMessage() {
+        yield {type: 'text', text: 'hi'};
+        yield {type: 'stop', stopReason: 'end_turn', usage};
+      },
+      async generateStructured() {
+        return {} as any;
+      },
+    };
+
+    let reportedUsage: any;
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, toolRegistry, {
+      hooks: {
+        afterModelResponse: async (_session, _text, usage) => {
+          reportedUsage = usage;
+        },
+      },
+    });
+
+    const iterator = orchestrator.processMessageStream(session);
+    while (!(await iterator.next()).done);
+
+    expect(reportedUsage).toEqual(usage);
+  });
+
+  it('ignores rounds with missing usage metadata', async () => {
+    const round1Usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    // Round 2 has no usage
+    const finalUsage: UsageMetadata = {inputTokens: 30, outputTokens: 15, totalTokens: 45};
+
+    const provider: AIProvider = {
+      async *sendMessage(params) {
+        if (params.messages.length === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'c1', name: 'lookup', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use', usage: round1Usage};
+        } else if (params.messages.length === 3) {
+          yield {type: 'tool_use', toolCall: {id: 'c2', name: 'lookup', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use', usage: undefined};
+        } else {
+          yield {type: 'text', text: 'done'};
+          yield {type: 'stop', stopReason: 'end_turn', usage: finalUsage};
+        }
+      },
+      async generateStructured() {
+        return {} as any;
+      },
+    };
+
+    let reportedUsage: any;
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, toolRegistry, {
+      hooks: {
+        afterModelResponse: async (_session, _text, usage) => {
+          reportedUsage = usage;
+        },
+      },
+    });
+
+    const iterator = orchestrator.processMessageStream(session);
+    while (!(await iterator.next()).done);
+
+    expect(reportedUsage).toMatchObject({
+      inputTokens: 40,
+      outputTokens: 20,
+      totalTokens: 60,
+    });
+  });
+
+  it('exposes usage granularity in the hook signature', async () => {
+    const provider: AIProvider = {
+      async *sendMessage() {
+        yield {type: 'text', text: 'hi'};
+        yield {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 1, outputTokens: 1, totalTokens: 2}};
+      },
+      async generateStructured() {
+        return {} as any;
+      },
+    };
+
+    let reportedUsage: any;
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, toolRegistry, {
+      hooks: {
+        afterModelResponse: async (_session, _text, usage) => {
+          reportedUsage = usage;
+        },
+      },
+    });
+
+    const iterator = orchestrator.processMessageStream(session);
+    while (!(await iterator.next()).done);
+
+    // This will fail because the current type is just UsageMetadata, not an object with 'total' and 'rounds'
+    expect(reportedUsage).toHaveProperty('total');
+    expect(reportedUsage).toHaveProperty('rounds');
+  });
+});