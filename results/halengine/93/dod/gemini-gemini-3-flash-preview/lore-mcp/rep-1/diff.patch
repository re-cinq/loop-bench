+import {describe, it, expect} from '@jest/globals';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {scriptedProvider, TOOL_CALL, STOP_FOR_TOOL, STOP_DONE} from './testHelpers.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+describe('Usage accumulation (acceptance)', () => {
+  const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found it',
+  }));
+
+  async function runAndCaptureUsage(provider: AIProvider): Promise<UsageMetadata | undefined> {
+    let reportedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        reportedUsage = usage;
+      },
+    };
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry, {hooks});
+    await orchestrator.processMessage(createSession('test'));
+    return reportedUsage;
+  }
+
+  it('accumulates usage across every tool round, not just the last', async () => {
+    const usage1: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const usage2: UsageMetadata = {inputTokens: 20, outputTokens: 10, totalTokens: 30};
+
+    const provider = scriptedProvider([
+      [TOOL_CALL, {...STOP_FOR_TOOL, usage: usage1}],
+      [
+        {type: 'text', text: 'final answer'},
+        {...STOP_DONE, usage: usage2},
+      ],
+    ]);
+
+    expect(await runAndCaptureUsage(provider)).toEqual({
+      inputTokens: 30,
+      outputTokens: 15,
+      totalTokens: 45,
+    });
+  });
+
+  it('reports correct usage for a single round turn', async () => {
+    const usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const provider = scriptedProvider([
+      [
+        {type: 'text', text: 'answer'},
+        {...STOP_DONE, usage},
+      ],
+    ]);
+
+    expect(await runAndCaptureUsage(provider)).toEqual(usage);
+  });
+
+  it('ignores rounds with missing usage in the total', async () => {
+    const usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const provider = scriptedProvider([
+      [TOOL_CALL, STOP_FOR_TOOL],
+      [
+        {type: 'text', text: 'answer'},
+        {...STOP_DONE, usage},
+      ],
+    ]);
+
+    expect(await runAndCaptureUsage(provider)).toEqual(usage);
+  });
+});