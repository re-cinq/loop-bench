+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+describe('chatOrchestrator usage accumulation (#93)', () => {
+  it('reports sum of usage covering every provider call in a turn with multiple rounds', async () => {
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        round++;
+        if (round === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'c1', name: 'lookup', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 10, outputTokens: 5, totalTokens: 15}};
+          return;
+        }
+        yield {type: 'text', text: 'done'};
+        yield {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 20, outputTokens: 10, totalTokens: 30}};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const registry = new ToolRegistry();
+    registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+      data: 'found',
+    }));
+
+    let receivedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry, {hooks});
+    await orchestrator.processMessage(createSession('test'));
+
+    expect(receivedUsage).toEqual({
+      inputTokens: 30,
+      outputTokens: 15,
+      totalTokens: 45,
+    });
+  });
+
+  it('handles missing usage on some rounds without turning the sum into NaN or losing the counted rounds', async () => {
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        round++;
+        if (round === 1) {
+          yield {type: 'tool_use', toolCall: {id: 'c1', name: 'lookup', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 10, outputTokens: 5, totalTokens: 15}};
+          return;
+        }
+        if (round === 2) {
+          yield {type: 'tool_use', toolCall: {id: 'c2', name: 'lookup', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use'};
+          return;
+        }
+        yield {type: 'text', text: 'done'};
+        yield {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 20, outputTokens: 10, totalTokens: 30}};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const registry = new ToolRegistry();
+    registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+      data: 'found',
+    }));
+
+    let receivedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry, {hooks});
+    await orchestrator.processMessage(createSession('test'));
+
+    expect(receivedUsage).toEqual({
+      inputTokens: 30,
+      outputTokens: 15,
+      totalTokens: 45,
+    });
+  });
+});