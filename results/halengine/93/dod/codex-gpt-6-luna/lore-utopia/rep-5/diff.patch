+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+const toolCall = (id: string): MessageChunk => ({type: 'tool_use', toolCall: {id, name: 'lookup', input: {}}});
+const toolStop = (usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason: 'tool_use', usage});
+const doneStop = (usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason: 'end_turn', usage});
+
+function session(): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'ask', timestamp: SENT_AT}],
+  };
+}
+
+function scriptedProvider(rounds: MessageChunk[][]): AIProvider {
+  let round = 0;
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+function toolRegistry(): ToolRegistry {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'lookup', inputSchema: {type: 'object'}}, async () => 'result');
+  return registry;
+}
+
+describe('usage reported across tool rounds', () => {
+  it('sums every reported provider call and leaves wholly unreported usage undefined', async () => {
+    const first: UsageMetadata = {inputTokens: 10, outputTokens: 2, totalTokens: 12};
+    const last: UsageMetadata = {inputTokens: 30, outputTokens: 6, totalTokens: 36};
+    const reports: (UsageMetadata | undefined)[] = [];
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        reports.push(usage);
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [toolCall('call-1'), toolStop(first)],
+        [toolCall('call-2'), toolStop()],
+        [{type: 'text', text: 'answer'}, doneStop(last)],
+      ]),
+      promptBuilder,
+      toolRegistry(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(session());
+
+    const noUsageOrchestrator = createChatOrchestrator(
+      scriptedProvider([[{type: 'text', text: 'answer'}, doneStop()]]),
+      promptBuilder,
+      undefined,
+      {hooks}
+    );
+    await noUsageOrchestrator.processMessage(session());
+
+    expect(reports).toEqual([{inputTokens: 40, outputTokens: 8, totalTokens: 48}, undefined]);
+  });
+});