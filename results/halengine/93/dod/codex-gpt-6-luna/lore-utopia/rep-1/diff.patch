+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// @spec specs/hal-engine-config-hooks/spec.md#10
+describe('usage reported after tool rounds', () => {
+  it('reports the sum of usage from every provider call in a two-tool-round turn', async () => {
+    const rounds: MessageChunk[][] = [
+      [
+        {type: 'tool_use', toolCall: {id: 'one', name: 'lookup', input: {}}},
+        {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 10, outputTokens: 2, totalTokens: 12}},
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'two', name: 'lookup', input: {}}},
+        {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 20, outputTokens: 3, totalTokens: 23}},
+      ],
+      [
+        {type: 'text', text: 'Done'},
+        {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 30, outputTokens: 4, totalTokens: 34}},
+      ],
+    ];
+    const provider: AIProvider = {
+      async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        yield* rounds.shift()!;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const registry = new ToolRegistry();
+    registry.register(
+      {name: 'lookup', description: 'Looks something up.', inputSchema: {type: 'object'}},
+      async () => 'found'
+    );
+    let receivedUsage: UsageMetadata | undefined;
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Test.'}), registry, {
+      hooks: {
+        afterModelResponse: async (_session, _text, usage) => {
+          receivedUsage = usage;
+        },
+      },
+    });
+    const session: ChatSession = {
+      sessionId: 's',
+      userId: 'u',
+      entries: [{role: 'user', content: 'go', timestamp: 't'}],
+    };
+
+    await orchestrator.processMessage(session);
+
+    expect(receivedUsage).toEqual({inputTokens: 60, outputTokens: 9, totalTokens: 69});
+  });
+
+  it('counts reported rounds when an intervening provider call omits usage', async () => {
+    const rounds: MessageChunk[][] = [
+      [
+        {type: 'tool_use', toolCall: {id: 'one', name: 'lookup', input: {}}},
+        {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 4, outputTokens: 1, totalTokens: 5}},
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'two', name: 'lookup', input: {}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'text', text: 'Done'},
+        {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 8, outputTokens: 2, totalTokens: 10}},
+      ],
+    ];
+    const provider: AIProvider = {
+      async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        yield* rounds.shift()!;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const registry = new ToolRegistry();
+    registry.register(
+      {name: 'lookup', description: 'Looks something up.', inputSchema: {type: 'object'}},
+      async () => 'found'
+    );
+    let receivedUsage: UsageMetadata | undefined;
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Test.'}), registry, {
+      hooks: {
+        afterModelResponse: async (_session, _text, usage) => {
+          receivedUsage = usage;
+        },
+      },
+    });
+    const session: ChatSession = {
+      sessionId: 's',
+      userId: 'u',
+      entries: [{role: 'user', content: 'go', timestamp: 't'}],
+    };
+
+    await orchestrator.processMessage(session);
+
+    expect(receivedUsage).toEqual({inputTokens: 12, outputTokens: 3, totalTokens: 15});
+  });
+});