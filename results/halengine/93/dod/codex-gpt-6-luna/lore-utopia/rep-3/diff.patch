+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+// specs/hal-engine-config-hooks/spec.md#9
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(): ChatSession {
+  return {
+    sessionId: 'usage-session',
+    userId: 'usage-user',
+    entries: [{role: 'user', content: 'look this up', timestamp: SENT_AT}],
+  };
+}
+
+function scriptedProvider(rounds: MessageChunk[][]): AIProvider {
+  let nextRound = 0;
+
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[nextRound++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+function lookupTool(): ToolRegistry {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => 'found it'
+  );
+  return registry;
+}
+
+function toolRound(id: string, usage?: UsageMetadata): MessageChunk[] {
+  return [
+    {type: 'tool_use', toolCall: {id, name: 'lookup', input: {q: id}}},
+    {type: 'stop', stopReason: 'tool_use', usage},
+  ];
+}
+
+describe('tool round usage acceptance', () => {
+  it('reports the sum from every provider call across two tool rounds', async () => {
+    const received: Array<UsageMetadata | undefined> = [];
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        received.push(usage);
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        toolRound('call-1', {inputTokens: 3, outputTokens: 2, totalTokens: 5}),
+        toolRound('call-2', {inputTokens: 7, outputTokens: 1, totalTokens: 8}),
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 11, outputTokens: 4, totalTokens: 15}},
+        ],
+      ]),
+      promptBuilder,
+      lookupTool(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession());
+
+    expect(received).toEqual([{inputTokens: 21, outputTokens: 7, totalTokens: 28}]);
+  });
+
+  it('counts reported rounds when other rounds omit usage and reports undefined when none do', async () => {
+    const received: Array<UsageMetadata | undefined> = [];
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        received.push(usage);
+      },
+    };
+    const partiallyReported = createChatOrchestrator(
+      scriptedProvider([
+        toolRound('call-1', {inputTokens: 4, outputTokens: 2, totalTokens: 6}),
+        toolRound('call-2'),
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 2, outputTokens: 1, totalTokens: 3}},
+        ],
+      ]),
+      promptBuilder,
+      lookupTool(),
+      {hooks}
+    );
+    const neverReported = createChatOrchestrator(
+      scriptedProvider([
+        toolRound('call-3'),
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ],
+      ]),
+      promptBuilder,
+      lookupTool(),
+      {hooks}
+    );
+
+    await partiallyReported.processMessage(createSession());
+    await neverReported.processMessage(createSession());
+
+    expect(received).toEqual([{inputTokens: 6, outputTokens: 3, totalTokens: 9}, undefined]);
+  });
+});