+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const session: ChatSession = {
+  sessionId: 'usage-session',
+  userId: 'usage-user',
+  entries: [{role: 'user', content: 'Please look this up.', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+const usage = (inputTokens: number, outputTokens: number): UsageMetadata => ({
+  inputTokens,
+  outputTokens,
+  totalTokens: inputTokens + outputTokens,
+});
+
+const toolRound = (id: string, roundUsage?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id, name: 'lookup', input: {}}},
+  {type: 'stop', stopReason: 'tool_use', usage: roundUsage},
+];
+
+const makeProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let call = 0;
+  return {
+    async *sendMessage(_params: SendMessageParams) {
+      yield* rounds[call++];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const makeRegistry = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Lookup a value.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  return registry;
+};
+
+const run = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let received: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, reportedUsage) => {
+      received = reportedUsage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(
+    makeProvider(rounds),
+    new PromptBuilder({identity: 'Usage test.'}),
+    makeRegistry(),
+    {hooks}
+  );
+
+  await orchestrator.processMessage(session);
+  return received;
+};
+
+// @spec specs/hal-engine-config-hooks/spec.md#9
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports usage from every provider call and ignores rounds with no usage', async () => {
+    const partial = await run([
+      toolRound('first', usage(10, 2)),
+      toolRound('second'),
+      [
+        {type: 'text', text: 'Done.'},
+        {type: 'stop', stopReason: 'end_turn', usage: usage(20, 4)},
+      ],
+    ]);
+    const noneReported = await run([
+      toolRound('first'),
+      [
+        {type: 'text', text: 'Done.'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ]);
+    const noTools = await run([
+      [
+        {type: 'text', text: 'Direct answer.'},
+        {type: 'stop', stopReason: 'end_turn', usage: usage(7, 3)},
+      ],
+    ]);
+
+    expect({partial, noneReported, noTools}).toEqual({
+      partial: usage(30, 6),
+      noneReported: undefined,
+      noTools: usage(7, 3),
+    });
+  });
+});