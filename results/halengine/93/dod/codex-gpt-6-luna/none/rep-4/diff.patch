+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// spec: specs/hal-engine-config-hooks/spec.md#11
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports the sum of usage from every provider call in a tool-driven turn', async () => {
+    const usageByRound: UsageMetadata[] = [
+      {inputTokens: 10, outputTokens: 2, totalTokens: 12},
+      {inputTokens: 20, outputTokens: 4, totalTokens: 24},
+      {inputTokens: 30, outputTokens: 6, totalTokens: 36},
+    ];
+    const rounds: MessageChunk[][] = [
+      [
+        {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'first'}}},
+        {type: 'stop', stopReason: 'tool_use', usage: usageByRound[0]},
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'call-2', name: 'lookup', input: {q: 'second'}}},
+        {type: 'stop', stopReason: 'tool_use', usage: usageByRound[1]},
+      ],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn', usage: usageByRound[2]},
+      ],
+    ];
+    let roundIndex = 0;
+    const provider: AIProvider = {
+      async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        yield* rounds[roundIndex++];
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const tools = new ToolRegistry();
+    tools.register({name: 'lookup', description: 'lookup a value', inputSchema: {type: 'object'}}, async () => 'found');
+    let reportedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        reportedUsage = usage;
+      },
+    };
+    const session: ChatSession = {
+      sessionId: 'usage-rounds',
+      userId: 'user-1',
+      entries: [{role: 'user', content: 'look up two values', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const orchestrator = createChatOrchestrator(
+      provider,
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      tools,
+      {hooks}
+    );
+
+    await orchestrator.processMessage(session);
+
+    expect(reportedUsage).toEqual({inputTokens: 60, outputTokens: 12, totalTokens: 72});
+  });
+});