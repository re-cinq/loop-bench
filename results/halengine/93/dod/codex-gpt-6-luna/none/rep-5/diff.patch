+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const session: ChatSession = {
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'ask', timestamp: SENT_AT}],
+};
+
+const rounds: MessageChunk[][] = [
+  [
+    {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {}}},
+    {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 10, outputTokens: 2, totalTokens: 12}},
+  ],
+  [
+    {type: 'tool_use', toolCall: {id: 'call-2', name: 'lookup', input: {}}},
+    {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 20, outputTokens: 3, totalTokens: 23}},
+  ],
+  [
+    {type: 'text', text: 'done'},
+    {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 30, outputTokens: 4, totalTokens: 34}},
+  ],
+];
+
+const provider: AIProvider = {
+  async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    for (const chunk of rounds.shift() ?? []) yield chunk;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+const registry = new ToolRegistry();
+registry.register({name: 'lookup', description: 'lookup', inputSchema: {type: 'object'}}, async () => 'found');
+
+describe('usage across tool rounds', () => {
+  it('reports usage covering every provider call in the turn', async () => {
+    let receivedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _responseText, usage) => {
+        receivedUsage = usage;
+      },
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test assistant'}), registry, {
+      hooks,
+    });
+
+    await orchestrator.processMessage(session);
+
+    expect(receivedUsage).toEqual({inputTokens: 60, outputTokens: 9, totalTokens: 69});
+  });
+});