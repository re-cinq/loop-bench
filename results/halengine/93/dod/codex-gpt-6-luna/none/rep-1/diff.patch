@@ -0,0 +1,93 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const session: ChatSession = {
+  sessionId: 'usage-rounds',
+  userId: 'user',
+  entries: [{role: 'user', content: 'look this up', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+const usage = (inputTokens: number, outputTokens: number): UsageMetadata => ({
+  inputTokens,
+  outputTokens,
+  totalTokens: inputTokens + outputTokens,
+});
+
+function scriptedProvider(rounds: MessageChunk[][]): AIProvider {
+  let call = 0;
+
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      yield* rounds[call++];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+function createTools(): ToolRegistry {
+  const tools = new ToolRegistry();
+  tools.register({name: 'lookup', description: 'Look up a value.', inputSchema: {type: 'object'}}, async () => 'found');
+  return tools;
+}
+
+describe('afterModelResponse usage across provider rounds', () => {
+  it('reports usage summed across every provider call in a two-tool-round turn', async () => {
+    let receivedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, reportedUsage) => {
+        receivedUsage = reportedUsage;
+      },
+    };
+    const provider = scriptedProvider([
+      [
+        {type: 'tool_use', toolCall: {id: 'first', name: 'lookup', input: {}}},
+        {type: 'stop', stopReason: 'tool_use', usage: usage(10, 2)},
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'second', name: 'lookup', input: {}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'text', text: 'Found it.'},
+        {type: 'stop', stopReason: 'end_turn', usage: usage(30, 8)},
+      ],
+    ]);
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Test.'}), createTools(), {
+      hooks,
+    });
+
+    await orchestrator.processMessage({...session, entries: [...session.entries]});
+
+    let usageWhenNoneReported: UsageMetadata | undefined = usage(1, 1);
+    const noUsageOrchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [
+          {type: 'text', text: 'Hello.'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ],
+      ]),
+      new PromptBuilder({identity: 'Test.'}),
+      undefined,
+      {
+        hooks: {
+          afterModelResponse: async (_session, _text, reportedUsage) => {
+            usageWhenNoneReported = reportedUsage;
+          },
+        },
+      }
+    );
+
+    await noUsageOrchestrator.processMessage({...session, entries: [...session.entries]});
+
+    expect({receivedUsage, usageWhenNoneReported}).toEqual({
+      receivedUsage: usage(40, 10),
+      usageWhenNoneReported: undefined,
+    });
+  });
+});