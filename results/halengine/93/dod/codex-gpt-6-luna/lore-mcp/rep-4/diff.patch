+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+const toolCall: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {}}};
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage() {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+it('reports usage across every provider call in a turn with two tool rounds', async () => {
+  const usages: UsageMetadata[] = [
+    {inputTokens: 10, outputTokens: 2, totalTokens: 12},
+    {inputTokens: 20, outputTokens: 3, totalTokens: 23},
+    {inputTokens: 30, outputTokens: 4, totalTokens: 34},
+  ];
+  let receivedUsage: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _responseText, usage) => {
+      receivedUsage = usage;
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'lookup', inputSchema: {type: 'object'}}, async () => 'result');
+  const orchestrator = createChatOrchestrator(
+    scriptedProvider([
+      [toolCall, {type: 'stop', stopReason: 'tool_use', usage: usages[0]}],
+      [toolCall, {type: 'stop', stopReason: 'tool_use', usage: usages[1]}],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn', usage: usages[2]},
+      ],
+    ]),
+    promptBuilder,
+    registry,
+    {hooks}
+  );
+
+  await orchestrator.processMessage({
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'ask', timestamp: '2026-01-01T00:00:00.000Z'}],
+  });
+
+  expect(receivedUsage).toEqual({inputTokens: 60, outputTokens: 9, totalTokens: 69});
+});