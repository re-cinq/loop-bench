+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ChatSession} from '../types/session.js';
+
+const session: ChatSession = {
+  sessionId: 'usage-acceptance',
+  userId: 'user',
+  entries: [{role: 'user', content: 'question', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+const promptBuilder = new PromptBuilder({identity: 'test assistant'});
+
+const usage = (inputTokens: number, outputTokens: number): UsageMetadata => ({
+  inputTokens,
+  outputTokens,
+  totalTokens: inputTokens + outputTokens,
+});
+
+const rounds: MessageChunk[][] = [
+  [
+    {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {}}},
+    {type: 'stop', stopReason: 'tool_use', usage: usage(100, 10)},
+  ],
+  [
+    {type: 'tool_use', toolCall: {id: 'call-2', name: 'lookup', input: {}}},
+    {type: 'stop', stopReason: 'tool_use', usage: usage(40, 4)},
+  ],
+  [
+    {type: 'text', text: 'answer'},
+    {type: 'stop', stopReason: 'end_turn', usage: usage(20, 2)},
+  ],
+];
+
+const provider: AIProvider = {
+  async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    yield* rounds.shift() ?? [];
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+// @spec specs/hal-engine-config-hooks/spec.md#9
+describe('afterModelResponse usage acceptance', () => {
+  it('reports usage from every provider call in a turn with two tool rounds', async () => {
+    let reported: UsageMetadata | undefined;
+    const hooks = {
+      afterModelResponse: async (_session: ChatSession, _responseText: string, value?: UsageMetadata) => {
+        reported = value;
+      },
+    };
+    const registry = new ToolRegistry();
+    registry.register({name: 'lookup', description: 'lookup', inputSchema: {type: 'object'}}, async () => 'result');
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry, {hooks});
+
+    await orchestrator.processMessage(session);
+
+    expect(reported).toEqual(usage(160, 16));
+  });
+});