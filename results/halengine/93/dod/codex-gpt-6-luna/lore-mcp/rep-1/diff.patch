+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ChatSession} from '../types/session.js';
+
+// @spec specs/hal-engine-config-hooks/spec.md#2
+describe('usage reported across tool rounds', () => {
+  it('sums usage reported by every provider call in a turn', async () => {
+    const usagePerCall: Array<UsageMetadata | undefined> = [
+      {inputTokens: 10, outputTokens: 2, totalTokens: 12},
+      undefined,
+      {inputTokens: 30, outputTokens: 5, totalTokens: 35},
+    ];
+    let call = 0;
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        const usage = usagePerCall[call++];
+        if (call < 3) {
+          yield {type: 'tool_use', toolCall: {id: `call-${call}`, name: 'lookup', input: {}}};
+          yield {type: 'stop', stopReason: 'tool_use', usage};
+          return;
+        }
+        yield {type: 'text', text: 'done'};
+        yield {type: 'stop', stopReason: 'end_turn', usage};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const tools = new ToolRegistry();
+    tools.register({name: 'lookup', description: 'look up a value', inputSchema: {type: 'object'}}, async () => ({
+      result: 'found',
+    }));
+    const session: ChatSession = {
+      sessionId: 'usage-session',
+      userId: 'usage-user',
+      entries: [{role: 'user', content: 'look this up', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    let receivedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    await createChatOrchestrator(provider, new PromptBuilder({identity: 'You are a test assistant.'}), tools, {
+      hooks,
+    }).processMessage(session);
+
+    expect(receivedUsage).toEqual({inputTokens: 40, outputTokens: 7, totalTokens: 47});
+  });
+});