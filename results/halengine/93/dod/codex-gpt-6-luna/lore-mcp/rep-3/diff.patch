+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+const session = (): ChatSession => ({
+  sessionId: 'usage-acceptance',
+  userId: 'user',
+  entries: [{role: 'user', content: 'look this up', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+const toolCall: MessageChunk = {
+  type: 'tool_use',
+  toolCall: {id: 'lookup-1', name: 'lookup', input: {query: 'answer'}},
+};
+const toolStop: MessageChunk = {type: 'stop', stopReason: 'tool_use'};
+
+function scriptedProvider(rounds: MessageChunk[][]): AIProvider {
+  let round = 0;
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+function registry(): ToolRegistry {
+  const tools = new ToolRegistry();
+  tools.register(
+    {name: 'lookup', description: 'look something up', inputSchema: {type: 'object'}},
+    async () => 'found it'
+  );
+  return tools;
+}
+
+async function usageFrom(rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> {
+  let received: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      received = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(scriptedProvider(rounds), promptBuilder, registry(), {hooks});
+  await orchestrator.processMessage(session());
+  return received;
+}
+
+describe('usage reported across tool rounds', () => {
+  it('reports the sum from every provider call in a two-tool-round turn', async () => {
+    const received = await usageFrom([
+      [toolCall, {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 11, outputTokens: 2, totalTokens: 13}}],
+      [toolCall, {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 17, outputTokens: 3, totalTokens: 20}}],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 23, outputTokens: 5, totalTokens: 28}},
+      ],
+    ]);
+
+    const reported = {inputTokens: 11, outputTokens: 2, totalTokens: 13};
+    const partial = await usageFrom([
+      [toolCall, {type: 'stop', stopReason: 'tool_use', usage: reported}],
+      [toolCall, {type: 'stop', stopReason: 'tool_use'}],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ]);
+    const absent = await usageFrom([
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ]);
+
+    expect({received, partial, absent}).toEqual({
+      received: {inputTokens: 51, outputTokens: 10, totalTokens: 61},
+      partial: reported,
+      absent: undefined,
+    });
+  });
+});