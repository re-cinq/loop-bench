+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ChatSession} from '../types/session.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+const toolCall = (id: string): MessageChunk => ({
+  type: 'tool_use',
+  toolCall: {id, name: 'lookup', input: {query: id}},
+});
+
+it('reports summed usage from every provider call across multiple tool rounds', async () => {
+  const rounds: MessageChunk[][] = [
+    [
+      toolCall('one'),
+      {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 10, outputTokens: 2, totalTokens: 12}},
+    ],
+    [
+      toolCall('two'),
+      {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 20, outputTokens: 3, totalTokens: 23}},
+    ],
+    [
+      {type: 'text', text: 'done'},
+      {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 30, outputTokens: 4, totalTokens: 34}},
+    ],
+  ];
+  let round = 0;
+  const provider: AIProvider = {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'lookup', inputSchema: {type: 'object'}}, async () => 'found');
+  let received: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      received = usage;
+    },
+  };
+  const session: ChatSession = {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'question', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+
+  await createChatOrchestrator(provider, promptBuilder, registry, {hooks}).processMessage(session);
+
+  expect(received).toEqual({inputTokens: 60, outputTokens: 9, totalTokens: 69});
+});