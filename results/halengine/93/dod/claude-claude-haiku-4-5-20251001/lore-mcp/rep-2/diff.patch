@@ -0,0 +1,100 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {TOOL_CALL, scriptedProvider, registryReturning} from './chatOrchestratorFixtures.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator usage accumulation across tool rounds', () => {
+  it('accumulates usage from every tool round and passes the sum to afterModelResponse', async () => {
+    const usage1: UsageMetadata = {inputTokens: 100, outputTokens: 50, totalTokens: 150};
+    const usage2: UsageMetadata = {inputTokens: 80, outputTokens: 30, totalTokens: 110};
+    const received = await runAndCaptureUsage([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usage1}],
+      [
+        {type: 'text', text: 'answer'},
+        {type: 'stop', stopReason: 'end_turn', usage: usage2},
+      ],
+    ]);
+    expect(received).toEqual({
+      inputTokens: usage1.inputTokens + usage2.inputTokens,
+      outputTokens: usage1.outputTokens + usage2.outputTokens,
+      totalTokens: usage1.totalTokens + usage2.totalTokens,
+    });
+  });
+
+  it('preserves single-round usage when no tool round occurs', async () => {
+    const usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    let receivedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, u) => {
+        receivedUsage = u;
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [
+          {type: 'text', text: 'hello'},
+          {type: 'stop', stopReason: 'end_turn', usage},
+        ],
+      ]),
+      promptBuilder,
+      undefined,
+      {hooks}
+    );
+    await orchestrator.processMessage(createSession('hi'));
+    expect(receivedUsage).toEqual(usage);
+  });
+
+  it('accumulates usage when only some rounds report it', async () => {
+    const usage1: UsageMetadata = {inputTokens: 100, outputTokens: 50, totalTokens: 150};
+    const received = await runAndCaptureUsage([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usage1}],
+      [
+        {type: 'text', text: 'answer'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ]);
+    expect(received).toEqual(usage1);
+  });
+
+  it('reports undefined when no round reports usage', async () => {
+    const received = await runAndCaptureUsage([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+      [
+        {type: 'text', text: 'answer'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ]);
+    expect(received).toBeUndefined();
+  });
+});
+
+async function runAndCaptureUsage(rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> {
+  let receivedUsage: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, u) => {
+      receivedUsage = u;
+    },
+  };
+  const orchestrator = createChatOrchestrator(
+    scriptedProvider(rounds),
+    promptBuilder,
+    registryReturning({result: 'ok'}),
+    {hooks}
+  );
+  await orchestrator.processMessage(createSession('ask'));
+  return receivedUsage;
+}
