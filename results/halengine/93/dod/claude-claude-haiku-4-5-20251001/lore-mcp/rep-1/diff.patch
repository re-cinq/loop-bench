diff --git a/src/orchestration/chatOrchestrator-usage-accumulation.acceptance.test.ts b/src/orchestration/chatOrchestrator-usage-accumulation.acceptance.test.ts
new file mode 100644
index 0000000..740adf8
--- /dev/null
+++ b/src/orchestration/chatOrchestrator-usage-accumulation.acceptance.test.ts
@@ -0,0 +1,116 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolResponse} from './tools/registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+const TOOL_CALL_2: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-2', name: 'lookup', input: {q: 'y'}}};
+const STOP_FOR_TOOL: MessageChunk = {type: 'stop', stopReason: 'tool_use'};
+const STOP_DONE: MessageChunk = {type: 'stop', stopReason: 'end_turn'};
+
+const ROUND_USAGE_A: UsageMetadata = {inputTokens: 100, outputTokens: 50, totalTokens: 150};
+const ROUND_USAGE_B: UsageMetadata = {inputTokens: 80, outputTokens: 40, totalTokens: 120};
+const USAGE_SUM: UsageMetadata = {inputTokens: 180, outputTokens: 90, totalTokens: 270};
+
+type Round = {chunks: MessageChunk[]; usage?: UsageMetadata};
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+async function run(rounds: Round[]): Promise<UsageMetadata | undefined> {
+  const {hooks, captured} = captureUsage();
+  await createChatOrchestrator(scriptedProviderWithUsage(rounds), promptBuilder, makeRegistry(), {
+    hooks,
+  }).processMessage(createSession('ask'));
+  return captured.value;
+}
+
+describe('ChatOrchestrator usage accumulation acceptance tests', () => {
+  it('accumulates usage across multiple tool rounds, reporting the sum to afterModelResponse', async () => {
+    expect(
+      await run([
+        {chunks: [TOOL_CALL, STOP_FOR_TOOL], usage: ROUND_USAGE_A},
+        {chunks: [{type: 'text', text: 'answer'}, STOP_DONE], usage: ROUND_USAGE_B},
+      ])
+    ).toEqual(USAGE_SUM);
+  });
+
+  it('maintains backward compatibility: a turn with no tool calls reports usage exactly as before', async () => {
+    const singleRoundUsage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    expect(await run([{chunks: [{type: 'text', text: 'done'}, STOP_DONE], usage: singleRoundUsage}])).toEqual(
+      singleRoundUsage
+    );
+  });
+
+  it('handles partial usage gracefully: rounds that report no usage are skipped, not breaking accumulation', async () => {
+    expect(
+      await run([
+        {chunks: [TOOL_CALL, STOP_FOR_TOOL], usage: ROUND_USAGE_A},
+        {chunks: [TOOL_CALL_2, STOP_FOR_TOOL]},
+        {chunks: [{type: 'text', text: 'answer'}, STOP_DONE], usage: ROUND_USAGE_B},
+      ])
+    ).toEqual(USAGE_SUM);
+  });
+
+  it('reports no usage when no rounds report usage', async () => {
+    expect(
+      await run([{chunks: [TOOL_CALL, STOP_FOR_TOOL]}, {chunks: [{type: 'text', text: 'answer'}, STOP_DONE]}])
+    ).toBeUndefined();
+  });
+});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function captureUsage(): {hooks: OrchestratorHooks; captured: {value: UsageMetadata | undefined}} {
+  const captured: {value: UsageMetadata | undefined} = {value: undefined};
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      captured.value = usage;
+    },
+  };
+  return {hooks, captured};
+}
+
+function scriptedProviderWithUsage(rounds: Round[]): AIProvider {
+  let round = 0;
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const currentRound = rounds[round++];
+      if (!currentRound) return;
+      const {chunks, usage} = currentRound;
+      const lastChunk = chunks[chunks.length - 1];
+      for (const chunk of chunks) {
+        if (usage && chunk === lastChunk && chunk.type === 'stop') {
+          yield {type: 'stop', stopReason: chunk.stopReason, usage};
+          continue;
+        }
+        yield chunk;
+      }
+      if (usage && (!lastChunk || lastChunk.type !== 'stop')) {
+        yield {type: 'stop', stopReason: 'end_turn', usage};
+      }
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+function makeRegistry(): ToolRegistry {
+  const r = new ToolRegistry();
+  r.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async (): Promise<ToolResponse> => ({result: 'found'})
+  );
+  return r;
+}
