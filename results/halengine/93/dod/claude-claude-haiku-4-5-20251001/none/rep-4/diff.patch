+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolResponse} from './tools/registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+const STOP_FOR_TOOL: MessageChunk = {type: 'stop', stopReason: 'tool_use'};
+const STOP_DONE: MessageChunk = {type: 'stop', stopReason: 'end_turn'};
+
+// One scripted round per sendMessage call, to drive the tool loop round by round.
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryReturning = (response: ToolResponse): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => response
+  );
+  return registry;
+};
+
+describe('ChatOrchestrator usage accumulation', () => {
+  it('accumulates usage from multiple tool rounds into a sum', async () => {
+    const round1Usage: UsageMetadata = {inputTokens: 100, outputTokens: 20, totalTokens: 120};
+    const round2Usage: UsageMetadata = {inputTokens: 150, outputTokens: 30, totalTokens: 180};
+
+    let receivedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const provider = scriptedProvider([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: round1Usage}],
+      [{type: 'text', text: 'done'}, {type: 'stop', stopReason: 'end_turn', usage: round2Usage}],
+    ]);
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registryReturning({result: 'r'}), {hooks});
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(receivedUsage).toEqual({
+      inputTokens: 250,
+      outputTokens: 50,
+      totalTokens: 300,
+    });
+  });
+
+  it('reports the single round usage when a turn has no tool calls', async () => {
+    const usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    let receivedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, u) => {
+        receivedUsage = u;
+      },
+    };
+
+    const provider = scriptedProvider([[{type: 'text', text: 'answer'}, {type: 'stop', stopReason: 'end_turn', usage}]]);
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(receivedUsage).toEqual(usage);
+  });
+
+  it('accumulates only from rounds that report usage, handling undefined in some rounds', async () => {
+    const round1Usage: UsageMetadata = {inputTokens: 50, outputTokens: 10, totalTokens: 60};
+    const round3Usage: UsageMetadata = {inputTokens: 75, outputTokens: 15, totalTokens: 90};
+
+    let receivedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const provider = scriptedProvider([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: round1Usage}],
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+      [{type: 'text', text: 'done'}, {type: 'stop', stopReason: 'end_turn', usage: round3Usage}],
+    ]);
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registryReturning({result: 'r'}), {hooks});
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(receivedUsage).toEqual({
+      inputTokens: 125,
+      outputTokens: 25,
+      totalTokens: 150,
+    });
+  });
+
+  it('reports undefined when no rounds report usage', async () => {
+    let receivedUsage: UsageMetadata | undefined = {inputTokens: 999, outputTokens: 999, totalTokens: 999};
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const provider = scriptedProvider([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+      [{type: 'text', text: 'done'}, {type: 'stop', stopReason: 'end_turn'}],
+    ]);
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registryReturning({result: 'r'}), {hooks});
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(receivedUsage).toBeUndefined();
+  });
+});