@@ -0,0 +1,96 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ToolRegistry} from './tools/registry.js';
+import {TOOL_CALL, scriptedProvider, registryReturning} from './toolLoopTestHelpers.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+async function runAndCapture(rounds: MessageChunk[][], registry?: ToolRegistry): Promise<UsageMetadata | undefined> {
+  let captured: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      captured = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(scriptedProvider(rounds), promptBuilder, registry, {hooks});
+  await orchestrator.processMessage(createSession('question'));
+  return captured;
+}
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+describe('ChatOrchestrator usage accumulation acceptance tests', () => {
+  it('reports usage covering every provider call in a turn with two tool rounds, summed from each round', async () => {
+    const usage1: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const usage2: UsageMetadata = {inputTokens: 20, outputTokens: 8, totalTokens: 28};
+
+    const reported = await runAndCapture(
+      [
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usage1}],
+        [
+          {type: 'text', text: 'response'},
+          {type: 'stop', stopReason: 'end_turn', usage: usage2},
+        ],
+      ],
+      registryReturning({result: 'found'})
+    );
+
+    expect(reported).toEqual({inputTokens: 30, outputTokens: 13, totalTokens: 43});
+  });
+
+  it('reports exactly what it reports today for a turn with no tool calls, unchanged', async () => {
+    const usage: UsageMetadata = {inputTokens: 5, outputTokens: 3, totalTokens: 8};
+
+    const reported = await runAndCapture([
+      [
+        {type: 'text', text: 'direct answer'},
+        {type: 'stop', stopReason: 'end_turn', usage},
+      ],
+    ]);
+
+    expect(reported).toEqual(usage);
+  });
+
+  it('handles undefined usage in some rounds and still counts the reported rounds', async () => {
+    const usage2: UsageMetadata = {inputTokens: 20, outputTokens: 8, totalTokens: 28};
+
+    const reported = await runAndCapture(
+      [
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+        [
+          {type: 'text', text: 'response'},
+          {type: 'stop', stopReason: 'end_turn', usage: usage2},
+        ],
+      ],
+      registryReturning({result: 'found'})
+    );
+
+    expect(reported).toEqual(usage2);
+  });
+
+  it('reports undefined when no rounds report usage', async () => {
+    const reported = await runAndCapture(
+      [
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+        [
+          {type: 'text', text: 'response'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ],
+      ],
+      registryReturning({result: 'found'})
+    );
+
+    expect(reported).toBeUndefined();
+  });
+});
