+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolResponse} from './tools/registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+const STOP_FOR_TOOL: MessageChunk = {type: 'stop', stopReason: 'tool_use'};
+const STOP_DONE: MessageChunk = {type: 'stop', stopReason: 'end_turn'};
+
+// Scripted provider that yields different rounds based on index
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryReturning = (response: ToolResponse): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => response
+  );
+  return registry;
+};
+
+describe('ChatOrchestrator usage reporting across rounds', () => {
+  it('sums usage from multiple tool rounds when both report usage', async () => {
+    const usage1: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const usage2: UsageMetadata = {inputTokens: 15, outputTokens: 10, totalTokens: 25};
+
+    let receivedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usage1}],
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn', usage: usage2},
+        ],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'found it'}),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(receivedUsage).toEqual({
+      inputTokens: 25,
+      outputTokens: 15,
+      totalTokens: 40,
+    });
+  });
+
+  it('reports unchanged usage for a turn with no tool calls', async () => {
+    const usage: UsageMetadata = {inputTokens: 5, outputTokens: 3, totalTokens: 8};
+    let receivedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, u) => {
+        receivedUsage = u;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [
+          {type: 'text', text: 'answer without tools'},
+          {type: 'stop', stopReason: 'end_turn', usage},
+        ],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'never called'}),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(receivedUsage).toEqual(usage);
+  });
+
+  it('handles partial usage reporting across rounds', async () => {
+    const usage1: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+
+    let receivedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usage1}],
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'found it'}),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(receivedUsage).toEqual(usage1);
+  });
+
+  it('reports no usage when no rounds report any', async () => {
+    let receivedUsage: UsageMetadata | undefined;
+    let hookWasCalled = false;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        hookWasCalled = true;
+        receivedUsage = usage;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'found it'}),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(hookWasCalled).toBe(true);
+    expect(receivedUsage).toBeUndefined();
+  });
+
+  it('correctly accumulates usage from three tool rounds', async () => {
+    const usage1: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const usage2: UsageMetadata = {inputTokens: 8, outputTokens: 3, totalTokens: 11};
+    const usage3: UsageMetadata = {inputTokens: 12, outputTokens: 7, totalTokens: 19};
+
+    let receivedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usage1}],
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usage2}],
+        [
+          {type: 'text', text: 'final answer'},
+          {type: 'stop', stopReason: 'end_turn', usage: usage3},
+        ],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'found it'}),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(receivedUsage).toEqual({
+      inputTokens: 30,
+      outputTokens: 15,
+      totalTokens: 45,
+    });
+  });
+});