+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolResponse} from './tools/registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+// Scripted provider that yields chunks in order for each round
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryReturning = (response: ToolResponse): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => response
+  );
+  return registry;
+};
+
+describe('chatOrchestrator usage accumulation acceptance tests', () => {
+  it('reports accumulated usage across multiple tool rounds, not just the last', async () => {
+    // Two rounds with different, known usage amounts
+    const round1Usage: UsageMetadata = {inputTokens: 100, outputTokens: 50, totalTokens: 150};
+    const round2Usage: UsageMetadata = {inputTokens: 200, outputTokens: 75, totalTokens: 275};
+
+    let receivedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const TOOL_CALL: MessageChunk = {
+      type: 'tool_use',
+      toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}},
+    };
+    const STOP_FOR_TOOL: MessageChunk = {type: 'stop', stopReason: 'tool_use', usage: round1Usage};
+    const STOP_DONE: MessageChunk = {type: 'stop', stopReason: 'end_turn', usage: round2Usage};
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, STOP_FOR_TOOL],
+        [{type: 'text', text: 'done'}, STOP_DONE],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'r'}),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    // Should receive the sum of both rounds' usage
+    expect(receivedUsage).toEqual({
+      inputTokens: 300,
+      outputTokens: 125,
+      totalTokens: 425,
+    });
+  });
+
+  it('reports exact same usage for a turn with no tool calls', async () => {
+    const usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    let receivedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, u) => {
+        receivedUsage = u;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([[{type: 'text', text: 'hello world'}, {type: 'stop', stopReason: 'end_turn', usage}]]),
+      promptBuilder,
+      undefined,
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('hi'));
+
+    // Single round should report exactly what it received
+    expect(receivedUsage).toEqual(usage);
+  });
+
+  it('handles missing usage in some rounds without producing NaN or undefined', async () => {
+    // Round 1 reports usage, Round 2 reports nothing
+    const round1Usage: UsageMetadata = {inputTokens: 100, outputTokens: 50, totalTokens: 150};
+
+    let receivedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const TOOL_CALL: MessageChunk = {
+      type: 'tool_use',
+      toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}},
+    };
+    const STOP_FOR_TOOL: MessageChunk = {type: 'stop', stopReason: 'tool_use', usage: round1Usage};
+    const STOP_DONE: MessageChunk = {type: 'stop', stopReason: 'end_turn'}; // No usage reported
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, STOP_FOR_TOOL],
+        [{type: 'text', text: 'done'}, STOP_DONE],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'r'}),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    // Should still have the usage from round 1, not NaN or undefined
+    expect(receivedUsage).toEqual(round1Usage);
+    expect(Number.isNaN(receivedUsage?.totalTokens)).toBe(false);
+  });
+
+  it('handles both rounds reporting no usage without producing NaN or undefined', async () => {
+    let receivedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const TOOL_CALL: MessageChunk = {
+      type: 'tool_use',
+      toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}},
+    };
+    const STOP_FOR_TOOL: MessageChunk = {type: 'stop', stopReason: 'tool_use'}; // No usage
+    const STOP_DONE: MessageChunk = {type: 'stop', stopReason: 'end_turn'}; // No usage
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, STOP_FOR_TOOL],
+        [{type: 'text', text: 'done'}, STOP_DONE],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'r'}),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    // Should remain undefined if no round reported usage
+    expect(receivedUsage).toBeUndefined();
+  });
+});