+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {scriptedProvider, registryReturning, TOOL_CALL} from './orchestratorTestHelpers.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function captureUsage(): {hooks: OrchestratorHooks; get: () => UsageMetadata | undefined} {
+  let captured: UsageMetadata | undefined;
+  return {
+    hooks: {
+      afterModelResponse: async (_s, _t, usage) => {
+        captured = usage;
+      },
+    },
+    get: () => captured,
+  };
+}
+
+function twoRoundOrchestrator(stop1: MessageChunk, stop2: MessageChunk, hooks: OrchestratorHooks) {
+  return createChatOrchestrator(
+    scriptedProvider([
+      [TOOL_CALL, stop1],
+      [{type: 'text', text: 'done'}, stop2],
+    ]),
+    promptBuilder,
+    registryReturning({result: 'r'}),
+    {hooks}
+  );
+}
+
+describe('chatOrchestrator usage accumulation acceptance tests', () => {
+  it('reports accumulated usage across multiple tool rounds, not just the last', async () => {
+    const round1Usage: UsageMetadata = {inputTokens: 100, outputTokens: 50, totalTokens: 150};
+    const round2Usage: UsageMetadata = {inputTokens: 200, outputTokens: 75, totalTokens: 275};
+    const {hooks, get} = captureUsage();
+    const orchestrator = twoRoundOrchestrator(
+      {type: 'stop', stopReason: 'tool_use', usage: round1Usage},
+      {type: 'stop', stopReason: 'end_turn', usage: round2Usage},
+      hooks
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(get()).toEqual({inputTokens: 300, outputTokens: 125, totalTokens: 425});
+  });
+
+  it('reports exact same usage for a turn with no tool calls', async () => {
+    const usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const {hooks, get} = captureUsage();
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [
+          {type: 'text', text: 'hello world'},
+          {type: 'stop', stopReason: 'end_turn', usage},
+        ],
+      ]),
+      promptBuilder,
+      undefined,
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('hi'));
+
+    expect(get()).toEqual(usage);
+  });
+
+  it('handles missing usage in some rounds without producing NaN or undefined', async () => {
+    const round1Usage: UsageMetadata = {inputTokens: 100, outputTokens: 50, totalTokens: 150};
+    const {hooks, get} = captureUsage();
+    const orchestrator = twoRoundOrchestrator(
+      {type: 'stop', stopReason: 'tool_use', usage: round1Usage},
+      {type: 'stop', stopReason: 'end_turn'},
+      hooks
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(get()).toEqual(round1Usage);
+  });
+
+  it('handles both rounds reporting no usage without producing NaN or undefined', async () => {
+    const {hooks, get} = captureUsage();
+    const orchestrator = twoRoundOrchestrator(
+      {type: 'stop', stopReason: 'tool_use'},
+      {type: 'stop', stopReason: 'end_turn'},
+      hooks
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(get()).toBeUndefined();
+  });
+});
