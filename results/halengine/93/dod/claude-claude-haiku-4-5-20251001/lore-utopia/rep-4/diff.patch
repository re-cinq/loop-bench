@@ -0,0 +1,27 @@
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolResponse} from './tools/registry.js';
+
+export const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+
+export const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+export const registryReturning = (response: ToolResponse): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => response
+  );
+  return registry;
+};
diff --git a/src/orchestration/usage-accumulation.acceptance.test.ts b/src/orchestration/usage-accumulation.acceptance.test.ts
new file mode 100644
index 0000000..3fe3731
--- /dev/null
+++ b/src/orchestration/usage-accumulation.acceptance.test.ts
@@ -0,0 +1,108 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {scriptedProvider, registryReturning, TOOL_CALL} from './testProviderHelpers.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const runWithRounds = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let seenUsage: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      seenUsage = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(
+    scriptedProvider(rounds),
+    promptBuilder,
+    registryReturning({result: 'ok'}),
+    {hooks}
+  );
+  await orchestrator.processMessage(createSession('query'));
+  return seenUsage;
+};
+
+describe('Usage accumulation across tool rounds', () => {
+  const round1Usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+  const round2Usage: UsageMetadata = {inputTokens: 8, outputTokens: 3, totalTokens: 11};
+
+  it('accumulates usage from every tool round, not just the last', async () => {
+    const seenUsage = await runWithRounds([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: round1Usage}],
+      [
+        {type: 'text', text: 'answer'},
+        {type: 'stop', stopReason: 'end_turn', usage: round2Usage},
+      ],
+    ]);
+
+    expect(seenUsage).toEqual({inputTokens: 18, outputTokens: 8, totalTokens: 26});
+  });
+
+  it('reports the single round usage unchanged when only one round runs', async () => {
+    const usage: UsageMetadata = {inputTokens: 7, outputTokens: 4, totalTokens: 11};
+
+    const seenUsage = await runWithRounds([
+      [
+        {type: 'text', text: 'answer'},
+        {type: 'stop', stopReason: 'end_turn', usage},
+      ],
+    ]);
+
+    expect(seenUsage).toEqual(usage);
+  });
+
+  it('accumulates usage when some rounds report and others do not', async () => {
+    const seenUsage = await runWithRounds([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: round1Usage}],
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+      [
+        {type: 'text', text: 'final'},
+        {type: 'stop', stopReason: 'end_turn', usage: round2Usage},
+      ],
+    ]);
+
+    expect(seenUsage).toEqual({inputTokens: 18, outputTokens: 8, totalTokens: 26});
