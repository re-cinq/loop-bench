+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolResponse} from './tools/registry.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// One scripted round per sendMessage call, so a turn can be driven through known, different usages round by round.
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryReturning = (response: ToolResponse): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => response
+  );
+  return registry;
+};
+
+const TOOL_CALL = (id: string): MessageChunk => ({type: 'tool_use', toolCall: {id, name: 'lookup', input: {q: 'x'}}});
+
+const stopWith = (stopReason: string, usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason, usage});
+
+// Collects what the hook was handed, one element per firing.
+const recordingUsage = (received: (UsageMetadata | undefined)[]): OrchestratorHooks => ({
+  afterModelResponse: async (_session, _responseText, usage) => void received.push(usage),
+});
+
+describe('afterModelResponse turn usage', () => {
+  it('hands the hook the usage of every provider call in the turn, summed across tool rounds', async () => {
+    const received: (UsageMetadata | undefined)[] = [];
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [
+          {type: 'text', text: 'looking '},
+          TOOL_CALL('call-1'),
+          stopWith('tool_use', {inputTokens: 100, outputTokens: 10, totalTokens: 110}),
+        ],
+        [
+          {type: 'text', text: 'still '},
+          TOOL_CALL('call-2'),
+          stopWith('tool_use', {inputTokens: 40, outputTokens: 5, totalTokens: 45}),
+        ],
+        [{type: 'text', text: 'found it'}, stopWith('end_turn', {inputTokens: 50, outputTokens: 20, totalTokens: 70})],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'r'}),
+      {hooks: recordingUsage(received)}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect({firings: received.length, usage: received[0]}).toEqual({
+      firings: 1,
+      usage: {inputTokens: 190, outputTokens: 35, totalTokens: 225},
+    });
+  });
+
+  it('skips rounds that report no usage, and still reports nothing when no round reports', async () => {
+    const partialTurn: (UsageMetadata | undefined)[] = [];
+    const silentTurn: (UsageMetadata | undefined)[] = [];
+
+    await createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL('call-1'), stopWith('tool_use', {inputTokens: 100, outputTokens: 10, totalTokens: 110})],
+        [TOOL_CALL('call-2'), stopWith('tool_use')],
+        [{type: 'text', text: 'done'}, stopWith('end_turn', {inputTokens: 40, outputTokens: 5, totalTokens: 45})],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'r'}),
+      {hooks: recordingUsage(partialTurn)}
+    ).processMessage(createSession('ask'));
+
+    await createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL('call-1'), stopWith('tool_use')],
+        [{type: 'text', text: 'done'}, stopWith('end_turn')],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'r'}),
+      {hooks: recordingUsage(silentTurn)}
+    ).processMessage(createSession('ask'));
+
+    expect({partial: partialTurn[0], silent: silentTurn[0]}).toEqual({
+      partial: {inputTokens: 140, outputTokens: 15, totalTokens: 155},
+      silent: undefined,
+    });
+  });
+});