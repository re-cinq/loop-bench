+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolResponse} from './tools/registry.js';
+
+// One scripted round per sendMessage call, so a turn can be driven through known, different usage figures.
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryReturning = (response: ToolResponse): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => response
+  );
+  return registry;
+};
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+const STOP_FOR_TOOL: MessageChunk = {type: 'stop', stopReason: 'tool_use'};
+const STOP_DONE: MessageChunk = {type: 'stop', stopReason: 'end_turn'};
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const createSession = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'ask', timestamp: SENT_AT}],
+});
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+// What the hook handed back, as a value: the turn's summed usage and the per-round breakdown.
+interface ReportedUsage {
+  totalUsage: UsageMetadata | undefined;
+  roundUsage: UsageMetadata[] | undefined;
+}
+
+// The consumer-side spelling of the contract (specs/hal-engine-config-hooks/spec.md): the hook's
+// own type names the sum, so a reader never has to open the orchestrator to learn what the number is.
+const usageRecordingHooks = (recorded: ReportedUsage[]): OrchestratorHooks => ({
+  afterModelResponse: async (
+    _session: ChatSession,
+    _responseText: string,
+    totalUsage?: UsageMetadata,
+    roundUsage?: UsageMetadata[]
+  ) => {
+    recorded.push({totalUsage, roundUsage});
+  },
+});
+
+describe('ChatOrchestrator usage across rounds (acceptance)', () => {
+  it('reports usage covering every provider call of a two-tool-round turn', async () => {
+    // The expensive leg is the second call: it carries the question and the full tool results.
+    const roundOneUsage: UsageMetadata = {inputTokens: 1200, outputTokens: 300, totalTokens: 1500};
+    const roundTwoUsage: UsageMetadata = {inputTokens: 4100, outputTokens: 900, totalTokens: 5000};
+    const recorded: ReportedUsage[] = [];
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: roundOneUsage}],
+        [
+          {type: 'text', text: 'the answer'},
+          {type: 'stop', stopReason: 'end_turn', usage: roundTwoUsage},
+        ],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'found it'}),
+      {hooks: usageRecordingHooks(recorded)}
+    );
+
+    await orchestrator.processMessage(createSession());
+
+    expect(recorded).toEqual([
+      {
+        totalUsage: {inputTokens: 5300, outputTokens: 1200, totalTokens: 6500},
+        roundUsage: [roundOneUsage, roundTwoUsage],
+      },
+    ]);
+  });
+
+  it('still counts the rounds that reported usage when some rounds report none', async () => {
+    const roundOneUsage: UsageMetadata = {inputTokens: 11, outputTokens: 3, totalTokens: 14};
+    const roundThreeUsage: UsageMetadata = {inputTokens: 7, outputTokens: 2, totalTokens: 9};
+    const recorded: ReportedUsage[] = [];
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: roundOneUsage}],
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn', usage: roundThreeUsage},
+        ],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'r'}),
+      {hooks: usageRecordingHooks(recorded)}
+    );
+
+    await orchestrator.processMessage(createSession());
+
+    expect(recorded).toEqual([
+      {
+        totalUsage: {inputTokens: 18, outputTokens: 5, totalTokens: 23},
+        roundUsage: [roundOneUsage, roundThreeUsage],
+      },
+    ]);
+  });
+
+  it('reports nothing when no round of the turn reported usage', async () => {
+    const recorded: ReportedUsage[] = [];
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, STOP_FOR_TOOL],
+        [{type: 'text', text: 'done'}, STOP_DONE],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'r'}),
+      {hooks: usageRecordingHooks(recorded)}
+    );
+
+    await orchestrator.processMessage(createSession());
+
+    expect(recorded).toEqual([{totalUsage: undefined, roundUsage: []}]);
+  });
+
+  it('reports exactly what a no-tool turn reports today', async () => {
+    const usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const recorded: ReportedUsage[] = [];
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [
+          {type: 'text', text: 'hello world'},
+          {type: 'stop', stopReason: 'end_turn', usage},
+        ],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'r'}),
+      {hooks: usageRecordingHooks(recorded)}
+    );
+
+    await orchestrator.processMessage(createSession());
+
+    expect(recorded).toEqual([{totalUsage: usage, roundUsage: [usage]}]);
+  });
+});