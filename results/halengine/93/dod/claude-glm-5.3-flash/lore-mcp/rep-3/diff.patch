+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolResponse} from './tools/registry.js';
+
+// One provider call per table entry: every call but the last asks for a tool, and the entry's usage rides its stop chunk.
+const turnOfCalls = (usagePerCall: Array<UsageMetadata | undefined>): AIProvider => {
+  let call = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const reported = usagePerCall[call++];
+      if (call < usagePerCall.length) {
+        yield {type: 'tool_use', toolCall: {id: `c${call}`, name: 'fetch', input: {}}};
+        yield {type: 'stop', stopReason: 'tool_use', usage: reported};
+        return;
+      }
+      yield {type: 'text', text: 'done'};
+      yield {type: 'stop', stopReason: 'end_turn', usage: reported};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryWithFetch = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'fetch', description: 'fetches a value', inputSchema: {type: 'object', properties: {}}},
+    async (): Promise<ToolResponse> => ({result: 'fetched'})
+  );
+  return registry;
+};
+
+const session = (question: string): ChatSession => ({
+  sessionId: 'turn-usage',
+  userId: 'deployer',
+  entries: [{role: 'user', content: question, timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const promptBuilder = new PromptBuilder({identity: 'You are the usage acceptance assistant.'});
+
+// What afterModelResponse was handed, in order; the hook fires once per user message, so a turn records one entry.
+const captureUsage = (): {received: Array<UsageMetadata | undefined>; hooks: OrchestratorHooks} => {
+  const received: Array<UsageMetadata | undefined> = [];
+  return {
+    received,
+    hooks: {
+      afterModelResponse: async (_session, _responseText, usage) => {
+        received.push(usage);
+      },
+    },
+  };
+};
+
+describe('afterModelResponse usage across a turn', () => {
+  it('hands afterModelResponse the usage of every provider call in a two-round turn', async () => {
+    const {received, hooks} = captureUsage();
+    const orchestrator = createChatOrchestrator(
+      turnOfCalls([
+        {inputTokens: 100, outputTokens: 20, totalTokens: 120},
+        {inputTokens: 40, outputTokens: 60, totalTokens: 100},
+      ]),
+      promptBuilder,
+      registryWithFetch(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(session('ask'));
+
+    expect(received).toEqual([{inputTokens: 140, outputTokens: 80, totalTokens: 220}]);
+  });
+
+  it('counts only the rounds that reported usage when a middle round reports none', async () => {
+    const {received, hooks} = captureUsage();
+    const orchestrator = createChatOrchestrator(
+      turnOfCalls([
+        {inputTokens: 10, outputTokens: 4, totalTokens: 14},
+        undefined,
+        {inputTokens: 30, outputTokens: 6, totalTokens: 36},
+      ]),
+      promptBuilder,
+      registryWithFetch(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(session('ask'));
+
+    expect(received).toEqual([{inputTokens: 40, outputTokens: 10, totalTokens: 50}]);
+  });
+
+  it('hands afterModelResponse no usage when no round of the turn reported one', async () => {
+    const {received, hooks} = captureUsage();
+    const orchestrator = createChatOrchestrator(
+      turnOfCalls([undefined, undefined]),
+      promptBuilder,
+      registryWithFetch(),
+      {
+        hooks,
+      }
+    );
+
+    await orchestrator.processMessage(session('ask'));
+
+    expect(received).toEqual([undefined]);
+  });
+});