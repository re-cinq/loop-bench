@@ -0,0 +1,106 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolResponse} from './tools/registry.js';
+
+// Acceptance for re-cinq/HALEngine#93: the usage handed to afterModelResponse covers every provider call of the turn.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const createSession = (content: string): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content, timestamp: SENT_AT}],
+});
+
+// One scripted round per sendMessage call, each stop chunk carrying the usage that round's provider call reports.
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryReturning = (response: ToolResponse): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => response
+  );
+  return registry;
+};
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+
+const stopWith = (stopReason: string, usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason, usage});
+
+// The hook records the usage it was handed; each assertion reads it once the turn has ended.
+const hookReceivingUsage = (received: {usage: UsageMetadata | undefined}): OrchestratorHooks => ({
+  afterModelResponse: async (_session, _responseText, usage) => {
+    received.usage = usage;
+  },
+});
+
+describe('ChatOrchestrator afterModelResponse usage', () => {
+  it('reports usage summed across every provider call of a two-round turn', async () => {
+    const received: {usage: UsageMetadata | undefined} = {usage: undefined};
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, stopWith('tool_use', {inputTokens: 100, outputTokens: 20, totalTokens: 120})],
+        [{type: 'text', text: 'done'}, stopWith('end_turn', {inputTokens: 50, outputTokens: 10, totalTokens: 60})],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'found it'}),
+      {hooks: hookReceivingUsage(received)}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(received.usage).toEqual({inputTokens: 150, outputTokens: 30, totalTokens: 180});
+  });
+
+  it('counts the rounds that reported when a middle round reports none', async () => {
+    const received: {usage: UsageMetadata | undefined} = {usage: undefined};
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, stopWith('tool_use', {inputTokens: 100, outputTokens: 20, totalTokens: 120})],
+        [TOOL_CALL, stopWith('tool_use')],
+        [{type: 'text', text: 'done'}, stopWith('end_turn', {inputTokens: 50, outputTokens: 10, totalTokens: 60})],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'found it'}),
+      {hooks: hookReceivingUsage(received)}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(received.usage).toEqual({inputTokens: 150, outputTokens: 30, totalTokens: 180});
+  });
+
+  it('reports nothing when no round reported usage', async () => {
+    const received: {usage: UsageMetadata | undefined} = {usage: undefined};
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, stopWith('tool_use')],
+        [{type: 'text', text: 'done'}, stopWith('end_turn')],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'found it'}),
+      {hooks: hookReceivingUsage(received)}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(received.usage).toBeUndefined();
+  });
+});