+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolResponse} from './tools/registry.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// One scripted round per sendMessage call, so every provider call of the turn reports known, different usage.
+const scriptedRounds = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryReturning = (response: ToolResponse): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => response
+  );
+  return registry;
+};
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+
+const stopWith = (stopReason: string, usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason, usage});
+
+// Drives one turn through the scripted rounds and returns the usage its afterModelResponse hook received.
+async function runTurn(rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> {
+  let received: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _responseText, usage) => {
+      received = usage;
+    },
+  };
+
+  const orchestrator = createChatOrchestrator(scriptedRounds(rounds), promptBuilder, registryReturning({result: 'r'}), {
+    hooks,
+  });
+  await orchestrator.processMessage(createSession('ask'));
+
+  return received;
+}
+
+// re-cinq/HALEngine#93: the hook was handed the lastUsage local, so it reported the final provider
+// call alone and under-counted exactly the turns that ran tools.
+describe('afterModelResponse usage across a turn', () => {
+  it('reports usage covering every provider call of a turn that ran two tool rounds', async () => {
+    // Three provider calls: two tool rounds and the closing answer. 10+20+40 in, 2+4+6 out, 12+24+46 total.
+    const received = await runTurn([
+      [TOOL_CALL, stopWith('tool_use', {inputTokens: 10, outputTokens: 2, totalTokens: 12})],
+      [TOOL_CALL, stopWith('tool_use', {inputTokens: 20, outputTokens: 4, totalTokens: 24})],
+      [{type: 'text', text: 'the answer'}, stopWith('end_turn', {inputTokens: 40, outputTokens: 6, totalTokens: 46})],
+    ]);
+
+    expect(received).toEqual({inputTokens: 70, outputTokens: 12, totalTokens: 82});
+  });
+
+  it('counts the rounds that reported when a round in between reports none', async () => {
+    // A silent round must not turn the sum undefined or NaN: 11+7 in, 3+1 out, 14+8 total.
+    const received = await runTurn([
+      [TOOL_CALL, stopWith('tool_use', {inputTokens: 11, outputTokens: 3, totalTokens: 14})],
+      [TOOL_CALL, stopWith('tool_use')],
+      [{type: 'text', text: 'the answer'}, stopWith('end_turn', {inputTokens: 7, outputTokens: 1, totalTokens: 8})],
+    ]);
+
+    expect(received).toEqual({inputTokens: 18, outputTokens: 4, totalTokens: 22});
+  });
+
+  it('still reports no usage when no round of the turn reports any', async () => {
+    const received = await runTurn([
+      [TOOL_CALL, stopWith('tool_use')],
+      [{type: 'text', text: 'the answer'}, stopWith('end_turn')],
+    ]);
+
+    expect(received).toBeUndefined();
+  });
+});