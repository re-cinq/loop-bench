+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+// Round scripts read top to bottom: one array is one provider call, and `usage` rides the stop chunk.
+const asksTool = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'weather'}}},
+  {type: 'stop', stopReason: 'tool_use', usage},
+];
+
+const answers = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'the answer'},
+  {type: 'stop', stopReason: 'end_turn', usage},
+];
+
+const providerFor = (rounds: MessageChunk[][]): AIProvider => {
+  let played = 0;
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const round = rounds[played++];
+      for (const chunk of round ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+// Written as a consumer would write it: naming a fourth per-round argument makes the published signature carry it.
+async function usageReportedFor(
+  rounds: MessageChunk[][]
+): Promise<{usage: UsageMetadata | undefined; perRound: UsageMetadata[] | undefined}> {
+  const seen: {usage: UsageMetadata | undefined; perRound: UsageMetadata[] | undefined} = {
+    usage: undefined,
+    perRound: undefined,
+  };
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _responseText, usage, perRound) => {
+      seen.usage = usage;
+      seen.perRound = perRound;
+    },
+  };
+
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found it',
+  }));
+
+  const session: ChatSession = {
+    sessionId: 'turn-usage',
+    userId: 'deployer',
+    entries: [{role: 'user', content: 'ask', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+
+  const orchestrator = createChatOrchestrator(
+    providerFor(rounds),
+    new PromptBuilder({identity: 'You are a test assistant.'}),
+    registry,
+    {hooks}
+  );
+  await orchestrator.processMessage(session);
+
+  return seen;
+}
+
+describe('afterModelResponse usage across a turn', () => {
+  it('reports the sum of every provider call in a two-round turn, with each call reported apart', async () => {
+    const firstCall: UsageMetadata = {inputTokens: 10, outputTokens: 4, totalTokens: 14};
+    const secondCall: UsageMetadata = {inputTokens: 100, outputTokens: 40, totalTokens: 140};
+
+    const {usage, perRound} = await usageReportedFor([asksTool(firstCall), answers(secondCall)]);
+
+    expect({usage, perRound}).toEqual({
+      usage: {inputTokens: 110, outputTokens: 44, totalTokens: 154},
+      perRound: [firstCall, secondCall],
+    });
+  });
+
+  it('counts the calls that reported when a silent round sits between them', async () => {
+    const firstCall: UsageMetadata = {inputTokens: 10, outputTokens: 4, totalTokens: 14};
+    const lastCall: UsageMetadata = {inputTokens: 100, outputTokens: 40, totalTokens: 140};
+
+    const {usage} = await usageReportedFor([asksTool(firstCall), asksTool(), answers(lastCall)]);
+
+    expect(usage).toEqual({inputTokens: 110, outputTokens: 44, totalTokens: 154});
+  });
+
+  it('still reports nothing when no provider call in the turn reported usage', async () => {
+    const {usage} = await usageReportedFor([asksTool(), answers()]);
+
+    expect(usage).toBeUndefined();
+  });
+});