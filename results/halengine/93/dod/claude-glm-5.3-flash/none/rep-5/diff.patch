+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// One scripted round per sendMessage call, so a turn can be driven round by round with known usage on each stop.
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryReturning = (result: string): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+    result,
+  }));
+  return registry;
+};
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+const stopWith = (stopReason: string, usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason, usage});
+
+const reportingUsage = (received: Array<UsageMetadata | undefined>): OrchestratorHooks => ({
+  afterModelResponse: async (_session, _responseText, usage) => {
+    received.push(usage);
+  },
+});
+
+// Issue #93: afterModelResponse handed the last round's usage alone under-counts every turn that ran tools.
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports the usage of every provider call in a two-round tool turn, not only the last round', async () => {
+    const received: Array<UsageMetadata | undefined> = [];
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, stopWith('tool_use', {inputTokens: 100, outputTokens: 10, totalTokens: 110})],
+        [
+          {type: 'text', text: 'the answer'},
+          stopWith('end_turn', {inputTokens: 40, outputTokens: 50, totalTokens: 90}),
+        ],
+      ]),
+      promptBuilder,
+      registryReturning('found it'),
+      {hooks: reportingUsage(received)}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(received).toEqual([{inputTokens: 140, outputTokens: 60, totalTokens: 200}]);
+  });
+
+  it('still counts the rounds that reported when a middle round reports no usage, and never reports NaN', async () => {
+    const received: Array<UsageMetadata | undefined> = [];
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, stopWith('tool_use', {inputTokens: 10, outputTokens: 2, totalTokens: 12})],
+        [TOOL_CALL, stopWith('tool_use')],
+        [{type: 'text', text: 'done'}, stopWith('end_turn', {inputTokens: 5, outputTokens: 4, totalTokens: 9})],
+      ]),
+      promptBuilder,
+      registryReturning('found it'),
+      {hooks: reportingUsage(received)}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    const [reported] = received;
+    expect({
+      reported,
+      finite: reported !== undefined && Number.isFinite(reported.inputTokens) && Number.isFinite(reported.totalTokens),
+    }).toEqual({reported: {inputTokens: 15, outputTokens: 6, totalTokens: 21}, finite: true});
+  });
+
+  it('still reports nothing when no round in the turn reported usage', async () => {
+    const received: Array<UsageMetadata | undefined> = [];
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, stopWith('tool_use')],
+        [{type: 'text', text: 'done'}, stopWith('end_turn')],
+      ]),
+      promptBuilder,
+      registryReturning('found it'),
+      {hooks: reportingUsage(received)}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(received).toEqual([undefined]);
+  });
+});