+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolResponse} from './tools/registry.js';
+import type {ChatSession} from '../types/session.js';
+
+// Acceptance tests for re-cinq/HALEngine#93: the usage afterModelResponse receives must cover every provider call of the turn.
+
+const promptBuilder = new PromptBuilder({identity: 'You are a usage test assistant.'});
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const createSession = (content: string): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content, timestamp: SENT_AT}],
+});
+
+// One scripted round per sendMessage call, so every round's usage is known and the rounds differ.
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryReturning = (response: ToolResponse): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => response
+  );
+  return registry;
+};
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+
+// Runs the turn to completion and returns exactly what afterModelResponse was handed as usage.
+const usageReportedFor = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let seen: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      seen = usage;
+    },
+  };
+
+  const orchestrator = createChatOrchestrator(
+    scriptedProvider(rounds),
+    promptBuilder,
+    registryReturning({result: 'r'}),
+    {
+      hooks,
+    }
+  );
+  await orchestrator.processMessage(createSession('ask'));
+
+  return seen;
+};
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports usage covering every provider call of a two-tool-round turn, with rounds reporting known, different counts', async () => {
+    const roundOne: UsageMetadata = {inputTokens: 100, outputTokens: 10, totalTokens: 110};
+    const roundTwo: UsageMetadata = {inputTokens: 200, outputTokens: 20, totalTokens: 220};
+
+    const seen = await usageReportedFor([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: roundOne}],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn', usage: roundTwo},
+      ],
+    ]);
+
+    expect(seen).toEqual({inputTokens: 300, outputTokens: 30, totalTokens: 330});
+  });
+
+  it('counts the rounds that reported when a round reports no usage, and still reports nothing when none did', async () => {
+    const roundTwo: UsageMetadata = {inputTokens: 50, outputTokens: 5, totalTokens: 55};
+    const roundThree: UsageMetadata = {inputTokens: 60, outputTokens: 6, totalTokens: 66};
+
+    const partial = await usageReportedFor([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: roundTwo}],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn', usage: roundThree},
+      ],
+    ]);
+    const silent = await usageReportedFor([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ]);
+
+    expect({partial, silent}).toEqual({
+      partial: {inputTokens: 110, outputTokens: 11, totalTokens: 121},
+      silent: undefined,
+    });
+  });
+});