+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../shared/logger.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// afterModelResponse reports what the whole turn cost: every provider call the round loop made, not the last round alone.
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {}}};
+
+const stopForTool = (usage?: UsageMetadata): MessageChunk[] => [
+  TOOL_CALL,
+  {type: 'stop', stopReason: 'tool_use', ...(usage ? {usage} : {})},
+];
+
+const finish = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'Done.'},
+  {type: 'stop', stopReason: 'end_turn', ...(usage ? {usage} : {})},
+];
+
+// One scripted round per sendMessage call, to drive the tool loop round by round.
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryReturning = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  return registry;
+};
+
+const reportedUsage = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _responseText, usage) => {
+      reported = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(
+    scriptedProvider(rounds),
+    new PromptBuilder({identity: 'Usage test.'}),
+    registryReturning(),
+    {hooks}
+  );
+  const session: ChatSession = {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'ask', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+
+  await orchestrator.processMessage(session);
+
+  return reported;
+};
+
+describe('afterModelResponse usage across a turn', () => {
+  beforeEach(() => {
+    setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined});
+  });
+
+  afterEach(() => setLogger());
+
+  it('reports the sum of every provider call in a two-round turn, not the last round alone', async () => {
+    const first = {inputTokens: 100, outputTokens: 20, totalTokens: 120};
+    const second = {inputTokens: 5, outputTokens: 40, totalTokens: 45};
+
+    const reported = await reportedUsage([stopForTool(first), finish(second)]);
+
+    expect(reported).toEqual({inputTokens: 105, outputTokens: 60, totalTokens: 165});
+  });
+
+  it('counts only the rounds that reported usage when a round between them reports none', async () => {
+    const first = {inputTokens: 10, outputTokens: 4, totalTokens: 14};
+    const third = {inputTokens: 5, outputTokens: 6, totalTokens: 11};
+
+    const reported = await reportedUsage([stopForTool(first), stopForTool(), finish(third)]);
+
+    expect(reported).toEqual({inputTokens: 15, outputTokens: 10, totalTokens: 25});
+  });
+
+  it('reports nothing when no round in the turn reported usage', async () => {
+    const reported = await reportedUsage([stopForTool(), finish()]);
+
+    expect(reported).toBeUndefined();
+  });
+});