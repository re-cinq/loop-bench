+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolResponse} from './tools/registry.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// One scripted round per sendMessage call, so a turn's provider calls are driven round by round.
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryReturning = (response: ToolResponse): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => response
+  );
+  return registry;
+};
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+
+// Rounds carry their usage on the stop chunk, where extractUsage reads it from.
+const toolRound = (usage?: UsageMetadata): MessageChunk[] => [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage}];
+const finalRound = (text: string, usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text},
+  {type: 'stop', stopReason: 'end_turn', usage},
+];
+
+// Captures the usage argument afterModelResponse was handed, and nothing else.
+const hookReportingUsage = (): {hooks: OrchestratorHooks; reported: (UsageMetadata | undefined)[]} => {
+  const reported: (UsageMetadata | undefined)[] = [];
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _responseText, usage) => {
+      reported.push(usage);
+    },
+  };
+  return {hooks, reported};
+};
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports usage summed across every provider call of a two-round tool turn', async () => {
+    const roundOne: UsageMetadata = {inputTokens: 100, outputTokens: 40, totalTokens: 140};
+    const roundTwo: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const {hooks, reported} = hookReportingUsage();
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([toolRound(roundOne), finalRound('the answer', roundTwo)]),
+      promptBuilder,
+      registryReturning({result: 'found it'}),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(reported).toEqual([{inputTokens: 110, outputTokens: 45, totalTokens: 155}]);
+  });
+
+  it('counts the rounds that reported when a middle round reports no usage', async () => {
+    const roundOne: UsageMetadata = {inputTokens: 100, outputTokens: 40, totalTokens: 140};
+    const roundThree: UsageMetadata = {inputTokens: 8, outputTokens: 2, totalTokens: 10};
+    const {hooks, reported} = hookReportingUsage();
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([toolRound(roundOne), toolRound(), finalRound('done', roundThree)]),
+      promptBuilder,
+      registryReturning({result: 'again'}),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(reported).toEqual([{inputTokens: 108, outputTokens: 42, totalTokens: 150}]);
+  });
+
+  it('reports no usage when no round of the turn reported any', async () => {
+    const {hooks, reported} = hookReportingUsage();
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([toolRound(), finalRound('done')]),
+      promptBuilder,
+      registryReturning({result: 'r'}),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(reported).toEqual([undefined]);
+  });
+});