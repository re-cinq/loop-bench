+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const toolCall: MessageChunk = {
+  type: 'tool_use',
+  toolCall: {id: 'call-1', name: 'lookup', input: {query: 'answer'}},
+};
+
+function providerReporting(rounds: MessageChunk[][]): AIProvider {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+it('reports the sum of every provider call that supplied usage across a tool turn', async () => {
+  const first: UsageMetadata = {inputTokens: 10, outputTokens: 2, totalTokens: 12};
+  const last: UsageMetadata = {inputTokens: 30, outputTokens: 4, totalTokens: 34};
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reported = usage;
+    },
+  };
+  const tools = new ToolRegistry();
+  tools.register({name: 'lookup', description: 'looks up an answer', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found',
+  }));
+  const orchestrator = createChatOrchestrator(
+    providerReporting([
+      [toolCall, {type: 'stop', stopReason: 'tool_use', usage: first}],
+      [toolCall, {type: 'stop', stopReason: 'tool_use'}],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn', usage: last},
+      ],
+    ]),
+    new PromptBuilder({identity: 'You are a test assistant.'}),
+    tools,
+    {hooks}
+  );
+  const session: ChatSession = {
+    sessionId: 'usage-acceptance',
+    userId: 'user-1',
+    entries: [{role: 'user', content: 'answer this', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+
+  await orchestrator.processMessage(session);
+
+  expect(reported).toEqual({inputTokens: 40, outputTokens: 6, totalTokens: 46});
+});