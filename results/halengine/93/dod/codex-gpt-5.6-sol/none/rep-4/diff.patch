+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const FIRST_USAGE: UsageMetadata = {inputTokens: 11, outputTokens: 2, totalTokens: 13};
+const SECOND_USAGE: UsageMetadata = {inputTokens: 17, outputTokens: 3, totalTokens: 20};
+const LAST_USAGE: UsageMetadata = {inputTokens: 23, outputTokens: 5, totalTokens: 28};
+const TOTAL_USAGE: UsageMetadata = {inputTokens: 51, outputTokens: 10, totalTokens: 61};
+const PARTIAL_USAGE: UsageMetadata = {inputTokens: 34, outputTokens: 7, totalTokens: 41};
+
+const toolRound = (id: string, usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id, name: 'lookup', input: {}}},
+  {type: 'stop', stopReason: 'tool_use', usage},
+];
+
+const finalRound = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'Done.'},
+  {type: 'stop', stopReason: 'end_turn', usage},
+];
+
+const runTurn = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let call = 0;
+  const provider: AIProvider = {
+    async *sendMessage() {
+      yield* rounds[call++];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const tools = new ToolRegistry();
+  tools.register(
+    {name: 'lookup', description: 'Looks up a value.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+
+  let reported: UsageMetadata | undefined;
+  const orchestrator = createChatOrchestrator(
+    provider,
+    new PromptBuilder({identity: 'Usage acceptance test.'}),
+    tools,
+    {hooks: {afterModelResponse: async (_session, _text, usage) => void (reported = usage)}}
+  );
+  const session: ChatSession = {
+    sessionId: 'usage-session',
+    userId: 'usage-user',
+    entries: [{role: 'user', content: 'Look this up twice.', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+
+  await orchestrator.processMessage(session);
+  return reported;
+};
+
+describe('usage reported after a model response', () => {
+  it('sums every reported provider call across two tool rounds and preserves absent usage', async () => {
+    const everyRound = await runTurn([
+      toolRound('first', FIRST_USAGE),
+      toolRound('second', SECOND_USAGE),
+      finalRound(LAST_USAGE),
+    ]);
+    const someRounds = await runTurn([toolRound('first', FIRST_USAGE), toolRound('second'), finalRound(LAST_USAGE)]);
+    const noRounds = await runTurn([toolRound('first'), toolRound('second'), finalRound()]);
+
+    expect({everyRound, someRounds, noRounds}).toEqual({
+      everyRound: TOTAL_USAGE,
+      someRounds: PARTIAL_USAGE,
+      noRounds: undefined,
+    });
+  });
+});