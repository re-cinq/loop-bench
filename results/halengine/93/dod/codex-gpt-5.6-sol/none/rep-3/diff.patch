+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const usage = (inputTokens: number, outputTokens: number): UsageMetadata => ({
+  inputTokens,
+  outputTokens,
+  totalTokens: inputTokens + outputTokens,
+});
+
+const toolCall = (id: string): MessageChunk => ({
+  type: 'tool_use',
+  toolCall: {id, name: 'lookup', input: {}},
+});
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const runTurn = async (roundUsage: Array<UsageMetadata | undefined>): Promise<UsageMetadata | undefined> => {
+  const rounds = roundUsage.map((reported, index): MessageChunk[] => {
+    const last = index === roundUsage.length - 1;
+    return last
+      ? [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn', usage: reported},
+        ]
+      : [toolCall(`call-${index}`), {type: 'stop', stopReason: 'tool_use', usage: reported}];
+  });
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () =>
+    Promise.resolve('found')
+  );
+  let received: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, totalUsage) => {
+      received = totalUsage;
+    },
+  };
+  const session: ChatSession = {
+    sessionId: 'usage-acceptance',
+    userId: 'user-1',
+    entries: [{role: 'user', content: 'look it up twice', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+  const orchestrator = createChatOrchestrator(scriptedProvider(rounds), promptBuilder, registry, {hooks});
+
+  await orchestrator.processMessage(session);
+  return received;
+};
+
+describe('afterModelResponse turn usage', () => {
+  it('reports the sum of every provider call and ignores rounds with no usage', async () => {
+    const everyRound = await runTurn([usage(2, 3), usage(5, 7), usage(11, 13)]);
+    const someRounds = await runTurn([undefined, usage(17, 19), undefined]);
+    const noRounds = await runTurn([undefined, undefined, undefined]);
+
+    expect({everyRound, someRounds, noRounds}).toEqual({
+      everyRound: usage(18, 23),
+      someRounds: usage(17, 19),
+      noRounds: undefined,
+    });
+  });
+});