+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+const toolCall = (id: string): MessageChunk => ({
+  type: 'tool_use',
+  toolCall: {id, name: 'lookup', input: {query: id}},
+});
+
+const stop = (stopReason: 'tool_use' | 'end_turn', usage?: UsageMetadata): MessageChunk => ({
+  type: 'stop',
+  stopReason,
+  usage,
+});
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let nextRound = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[nextRound++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const tools = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks up a value', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  return registry;
+};
+
+const session = (): ChatSession => ({
+  sessionId: 'usage-acceptance',
+  userId: 'user',
+  entries: [{role: 'user', content: 'look this up twice', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const usage = (inputTokens: number, outputTokens: number): UsageMetadata => ({
+  inputTokens,
+  outputTokens,
+  totalTokens: inputTokens + outputTokens,
+});
+
+it('reports the summed usage of every provider call while ignoring rounds with no usage', async () => {
+  const first = usage(2, 3);
+  const second = usage(5, 7);
+  const final = usage(11, 13);
+  const scenarios: Array<{roundUsage: Array<UsageMetadata | undefined>; expected: UsageMetadata | undefined}> = [
+    {roundUsage: [first, second, final], expected: usage(18, 23)},
+    {roundUsage: [first, undefined, final], expected: usage(13, 16)},
+    {roundUsage: [undefined, undefined, undefined], expected: undefined},
+  ];
+  const reported: Array<UsageMetadata | undefined> = [];
+
+  for (const {roundUsage} of scenarios) {
+    const provider = scriptedProvider([
+      [toolCall('first'), stop('tool_use', roundUsage[0])],
+      [toolCall('second'), stop('tool_use', roundUsage[1])],
+      [{type: 'text', text: 'done'}, stop('end_turn', roundUsage[2])],
+    ]);
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, tools(), {
+      hooks: {
+        afterModelResponse: async (_session, _responseText, totalUsage) => void reported.push(totalUsage),
+      },
+    });
+
+    await orchestrator.processMessage(session());
+  }
+
+  expect(reported).toEqual(scenarios.map(({expected}) => expected));
+});