+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const FIRST_USAGE: UsageMetadata = {inputTokens: 11, outputTokens: 2, totalTokens: 13};
+const SECOND_USAGE: UsageMetadata = {inputTokens: 17, outputTokens: 3, totalTokens: 20};
+const FINAL_USAGE: UsageMetadata = {inputTokens: 23, outputTokens: 5, totalTokens: 28};
+const TOTAL_USAGE: UsageMetadata = {inputTokens: 51, outputTokens: 10, totalTokens: 61};
+const PARTIAL_USAGE: UsageMetadata = {inputTokens: 34, outputTokens: 7, totalTokens: 41};
+
+const toolRound = (id: string, usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id, name: 'lookup', input: {}}},
+  {type: 'stop', stopReason: 'tool_use', usage},
+];
+
+const finalRound = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'done'},
+  {type: 'stop', stopReason: 'end_turn', usage},
+];
+
+const reportedUsageFor = async (usages: Array<UsageMetadata | undefined>): Promise<UsageMetadata | undefined> => {
+  const rounds = [toolRound('first', usages[0]), toolRound('second', usages[1]), finalRound(usages[2])];
+  let round = 0;
+  const provider: AIProvider = {
+    async *sendMessage() {
+      yield* rounds[round++]!;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const tools = new ToolRegistry();
+  tools.register(
+    {name: 'lookup', description: 'Looks up a value.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+
+  let reported: UsageMetadata | undefined;
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Usage test.'}), tools, {
+    hooks: {afterModelResponse: async (_session, _text, usage) => void (reported = usage)},
+  });
+  const session: ChatSession = {
+    sessionId: 'usage-session',
+    userId: 'usage-user',
+    entries: [{role: 'user', content: 'look it up twice', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+
+  await orchestrator.processMessage(session);
+  return reported;
+};
+
+describe('afterModelResponse turn usage', () => {
+  it('reports the sum of every provider call while ignoring rounds that omit usage', async () => {
+    const everyRound = await reportedUsageFor([FIRST_USAGE, SECOND_USAGE, FINAL_USAGE]);
+    const someRounds = await reportedUsageFor([FIRST_USAGE, undefined, FINAL_USAGE]);
+    const noRounds = await reportedUsageFor([undefined, undefined, undefined]);
+
+    expect({everyRound, someRounds, noRounds}).toEqual({
+      everyRound: TOTAL_USAGE,
+      someRounds: PARTIAL_USAGE,
+      noRounds: undefined,
+    });
+  });
+});