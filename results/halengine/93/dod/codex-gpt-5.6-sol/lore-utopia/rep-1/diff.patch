+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+const session = (): ChatSession => ({
+  sessionId: 'usage-acceptance',
+  userId: 'user',
+  entries: [{role: 'user', content: 'Use the tool twice', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const toolCall = (id: string): MessageChunk => ({
+  type: 'tool_use',
+  toolCall: {id, name: 'lookup', input: {}},
+});
+
+const stop = (stopReason: string, usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason, usage});
+
+const providerFor = (rounds: MessageChunk[][]): AIProvider => {
+  let nextRound = 0;
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[nextRound++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured output is not part of this turn');
+    },
+  };
+};
+
+const registry = (): ToolRegistry => {
+  const tools = new ToolRegistry();
+  tools.register(
+    {name: 'lookup', description: 'Look something up', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  return tools;
+};
+
+const reportedUsage = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let reported: UsageMetadata | undefined;
+  const orchestrator = createChatOrchestrator(providerFor(rounds), promptBuilder, registry(), {
+    hooks: {
+      afterModelResponse: async (_session, _text, usage) => {
+        reported = usage;
+      },
+    },
+  });
+
+  await orchestrator.processMessage(session());
+  return reported;
+};
+
+describe('afterModelResponse turn usage', () => {
+  it('reports the sum of every provider call across two tool rounds', async () => {
+    const usage = await reportedUsage([
+      [toolCall('first'), stop('tool_use', {inputTokens: 10, outputTokens: 1, totalTokens: 11})],
+      [toolCall('second'), stop('tool_use', {inputTokens: 20, outputTokens: 2, totalTokens: 22})],
+      [{type: 'text', text: 'done'}, stop('end_turn', {inputTokens: 30, outputTokens: 3, totalTokens: 33})],
+    ]);
+
+    expect(usage).toEqual({inputTokens: 60, outputTokens: 6, totalTokens: 66});
+  });
+
+  it('sums the rounds that report usage and reports nothing when none do', async () => {
+    const someUsage = await reportedUsage([
+      [toolCall('first'), stop('tool_use', {inputTokens: 7, outputTokens: 2, totalTokens: 9})],
+      [toolCall('second'), stop('tool_use')],
+      [{type: 'text', text: 'done'}, stop('end_turn', {inputTokens: 11, outputTokens: 4, totalTokens: 15})],
+    ]);
+    const noUsage = await reportedUsage([
+      [toolCall('first'), stop('tool_use')],
+      [{type: 'text', text: 'done'}, stop('end_turn')],
+    ]);
+
+    expect({someUsage, noUsage}).toEqual({
+      someUsage: {inputTokens: 18, outputTokens: 6, totalTokens: 24},
+      noUsage: undefined,
+    });
+  });
+});