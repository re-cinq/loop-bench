+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+const sentAt = '2026-01-01T00:00:00.000Z';
+
+const createSession = (): ChatSession => ({
+  sessionId: 'usage-session',
+  userId: 'usage-user',
+  entries: [{role: 'user', content: 'Use the tools, then answer.', timestamp: sentAt}],
+});
+
+const usage = (inputTokens: number, outputTokens: number): UsageMetadata => ({
+  inputTokens,
+  outputTokens,
+  totalTokens: inputTokens + outputTokens,
+});
+
+const toolCall = (id: string): MessageChunk => ({
+  type: 'tool_use',
+  toolCall: {id, name: 'lookup', input: {query: id}},
+});
+
+const providerFor = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const tools = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Looks up a value', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  return registry;
+};
+
+const reportedBy = (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, turnUsage) => {
+      reported = turnUsage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(providerFor(rounds), promptBuilder, tools(), {hooks});
+
+  return orchestrator.processMessage(createSession()).then(() => reported);
+};
+
+describe('usage across tool rounds', () => {
+  // specs/hal-engine-config-hooks#9
+  it('reports the sum of every provider call across two tool rounds', async () => {
+    const reported = await reportedBy([
+      [toolCall('first'), {type: 'stop', stopReason: 'tool_use', usage: usage(10, 2)}],
+      [toolCall('second'), {type: 'stop', stopReason: 'tool_use', usage: usage(20, 3)}],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn', usage: usage(30, 4)},
+      ],
+    ]);
+
+    expect(reported).toEqual({inputTokens: 60, outputTokens: 9, totalTokens: 69});
+  });
+
+  // specs/hal-engine-config-hooks#9
+  it('counts reported rounds when some omit usage and reports nothing when all omit it', async () => {
+    const partial = await reportedBy([
+      [toolCall('first'), {type: 'stop', stopReason: 'tool_use', usage: usage(7, 2)}],
+      [toolCall('second'), {type: 'stop', stopReason: 'tool_use'}],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn', usage: usage(11, 3)},
+      ],
+    ]);
+    const absent = await reportedBy([
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ]);
+
+    expect({partial, absent}).toEqual({
+      partial: {inputTokens: 18, outputTokens: 5, totalTokens: 23},
+      absent: undefined,
+    });
+  });
+});