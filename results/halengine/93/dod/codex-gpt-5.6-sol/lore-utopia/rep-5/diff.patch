+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const INPUT: UsageMetadata = {inputTokens: 11, outputTokens: 2, totalTokens: 13};
+const TOOL_RESULT: UsageMetadata = {inputTokens: 23, outputTokens: 3, totalTokens: 26};
+const ANSWER: UsageMetadata = {inputTokens: 37, outputTokens: 5, totalTokens: 42};
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call', name: 'lookup', input: {}}};
+
+const runToolTurn = async (roundUsage: Array<UsageMetadata | undefined>): Promise<UsageMetadata | undefined> => {
+  let round = 0;
+  let reported: UsageMetadata | undefined;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const usage = roundUsage[round];
+      if (round++ < 2) {
+        yield TOOL_CALL;
+        yield {type: 'stop', stopReason: 'tool_use', usage};
+        return;
+      }
+      yield {type: 'text', text: 'done'};
+      yield {type: 'stop', stopReason: 'end_turn', usage};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Looks up a value.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, totalUsage) => {
+      reported = totalUsage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(
+    provider,
+    new PromptBuilder({identity: 'Usage test assistant.'}),
+    registry,
+    {hooks}
+  );
+  const session: ChatSession = {
+    sessionId: 'session',
+    userId: 'user',
+    entries: [{role: 'user', content: 'look twice', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+
+  await orchestrator.processMessage(session);
+
+  return reported;
+};
+
+it('reports summed usage across every provider call while preserving absent usage', async () => {
+  const everyRound = await runToolTurn([INPUT, TOOL_RESULT, ANSWER]);
+  const someRounds = await runToolTurn([INPUT, undefined, ANSWER]);
+  const noRounds = await runToolTurn([undefined, undefined, undefined]);
+
+  expect({everyRound, someRounds, noRounds}).toEqual({
+    everyRound: {inputTokens: 71, outputTokens: 10, totalTokens: 81},
+    someRounds: {inputTokens: 48, outputTokens: 7, totalTokens: 55},
+    noRounds: undefined,
+  });
+});