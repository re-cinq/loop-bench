+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const FIRST_USAGE: UsageMetadata = {inputTokens: 11, outputTokens: 2, totalTokens: 13};
+const SECOND_USAGE: UsageMetadata = {inputTokens: 23, outputTokens: 3, totalTokens: 26};
+const FINAL_USAGE: UsageMetadata = {inputTokens: 37, outputTokens: 5, totalTokens: 42};
+const TOTAL_USAGE: UsageMetadata = {inputTokens: 71, outputTokens: 10, totalTokens: 81};
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call', name: 'lookup', input: {}}};
+
+const reportFor = async (roundUsage: Array<UsageMetadata | undefined>): Promise<UsageMetadata | undefined> => {
+  let round = 0;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const usage = roundUsage[round];
+      if (round++ < 2) {
+        yield TOOL_CALL;
+        yield {type: 'stop', stopReason: 'tool_use', usage};
+        return;
+      }
+      yield {type: 'text', text: 'done'};
+      yield {type: 'stop', stopReason: 'end_turn', usage};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Looks up a value.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  let report: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, turnUsage) => {
+      report = turnUsage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(
+    provider,
+    new PromptBuilder({identity: 'Usage acceptance test.'}),
+    registry,
+    {hooks}
+  );
+  const session: ChatSession = {
+    sessionId: 'session',
+    userId: 'user',
+    entries: [{role: 'user', content: 'look this up', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+
+  await orchestrator.processMessage(session);
+
+  return report;
+};
+
+it('reports the sum of every provider call in a tool turn while ignoring rounds with no usage', async () => {
+  const everyRound = await reportFor([FIRST_USAGE, SECOND_USAGE, FINAL_USAGE]);
+  const someRounds = await reportFor([FIRST_USAGE, undefined, FINAL_USAGE]);
+  const noRounds = await reportFor([undefined, undefined, undefined]);
+
+  expect({everyRound, someRounds, noRounds}).toEqual({
+    everyRound: TOTAL_USAGE,
+    someRounds: {inputTokens: 48, outputTokens: 7, totalTokens: 55},
+    noRounds: undefined,
+  });
+});