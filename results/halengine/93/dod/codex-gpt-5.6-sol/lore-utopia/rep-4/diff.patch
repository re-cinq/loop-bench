+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+const toolCall: MessageChunk = {
+  type: 'tool_use',
+  toolCall: {id: 'call-1', name: 'lookup', input: {query: 'answer'}},
+};
+
+const usage = (inputTokens: number, outputTokens: number): UsageMetadata => ({
+  inputTokens,
+  outputTokens,
+  totalTokens: inputTokens + outputTokens,
+});
+
+const session = (): ChatSession => ({
+  sessionId: 'usage-acceptance',
+  userId: 'user-1',
+  entries: [{role: 'user', content: 'Look this up', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const providerFor = (roundUsage: Array<UsageMetadata | undefined>): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const current = roundUsage[round];
+      const asksForTool = round < roundUsage.length - 1;
+      round++;
+
+      if (asksForTool) yield toolCall;
+      else yield {type: 'text', text: 'done'};
+      yield {type: 'stop', stopReason: asksForTool ? 'tool_use' : 'end_turn', usage: current};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured output is not part of this turn');
+    },
+  };
+};
+
+const reportedUsageFor = async (roundUsage: Array<UsageMetadata | undefined>): Promise<UsageMetadata | undefined> => {
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _responseText, turnUsage) => {
+      reported = turnUsage;
+    },
+  };
+  const tools = new ToolRegistry();
+  tools.register(
+    {name: 'lookup', description: 'Looks up an answer.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+
+  await createChatOrchestrator(providerFor(roundUsage), promptBuilder, tools, {hooks}).processMessage(session());
+  return reported;
+};
+
+describe('afterModelResponse turn usage', () => {
+  // Spec: specs/hal-engine-config-hooks/spec.md#9
+  it('reports the sum of every provider call while ignoring rounds with no usage', async () => {
+    const first = usage(11, 2);
+    const second = usage(23, 4);
+    const final = usage(37, 6);
+
+    const reports = await Promise.all([
+      reportedUsageFor([first, second, final]),
+      reportedUsageFor([first, undefined, final]),
+      reportedUsageFor([undefined, undefined, undefined]),
+    ]);
+
+    expect(reports).toEqual([usage(71, 12), usage(48, 8), undefined]);
+  });
+});