+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../shared/logger.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function createToolRegistry(): ToolRegistry {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Looks something up.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  return registry;
+}
+
+function createScriptedProvider(rounds: MessageChunk[][]): AIProvider {
+  let callIndex = 0;
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      const chunks = rounds[callIndex++] ?? [];
+      for (const chunk of chunks) {
+        yield chunk;
+      }
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+describe('afterModelResponse usage aggregation across tool rounds', () => {
+  const promptBuilder = new PromptBuilder({identity: 'Test prompt.'});
+
+  beforeAll(() => {
+    const quiet = () => undefined;
+    setLogger({debug: quiet, info: quiet, warn: quiet, error: quiet});
+  });
+
+  afterAll(() => {
+    setLogger();
+  });
+
+  it('reports usage summed across every provider call in a turn with multiple tool rounds', async () => {
+    const rounds: MessageChunk[][] = [
+      [
+        {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {term: 'alpha'}}},
+        {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 10, outputTokens: 5, totalTokens: 15}},
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'call-2', name: 'lookup', input: {term: 'beta'}}},
+        {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 20, outputTokens: 8, totalTokens: 28}},
+      ],
+      [
+        {type: 'text', text: 'Alpha and beta results found.'},
+        {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 35, outputTokens: 12, totalTokens: 47}},
+      ],
+    ];
+
+    let receivedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createScriptedProvider(rounds), promptBuilder, createToolRegistry(), {
+      hooks,
+    });
+    await orchestrator.processMessage(createSession('Find alpha and beta'));
+
+    expect(receivedUsage).toEqual({inputTokens: 65, outputTokens: 25, totalTokens: 90});
+  });
+
+  it('accumulates usage across tool rounds when some rounds omit usage', async () => {
+    const partialRounds: MessageChunk[][] = [
+      [
+        {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {term: 'gamma'}}},
+        {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 10, outputTokens: 5, totalTokens: 15}},
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'call-2', name: 'lookup', input: {term: 'delta'}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'text', text: 'Gamma and delta results found.'},
+        {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 25, outputTokens: 10, totalTokens: 35}},
+      ],
+    ];
+
+    const omittedRounds: MessageChunk[][] = [
+      [
+        {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {term: 'epsilon'}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'text', text: 'Epsilon result found.'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ];
+
+    let receivedPartialUsage: UsageMetadata | undefined;
+    let receivedOmittedUsage: UsageMetadata | undefined;
+
+    const partialOrchestrator = createChatOrchestrator(
+      createScriptedProvider(partialRounds),
+      promptBuilder,
+      createToolRegistry(),
+      {
+        hooks: {
+          afterModelResponse: async (_session, _text, usage) => {
+            receivedPartialUsage = usage;
+          },
+        },
+      }
+    );
+    await partialOrchestrator.processMessage(createSession('Find gamma and delta'));
+
+    const omittedOrchestrator = createChatOrchestrator(
+      createScriptedProvider(omittedRounds),
+      promptBuilder,
+      createToolRegistry(),
+      {
+        hooks: {
+          afterModelResponse: async (_session, _text, usage) => {
+            receivedOmittedUsage = usage;
+          },
+        },
+      }
+    );
+    await omittedOrchestrator.processMessage(createSession('Find epsilon'));
+
+    expect({partial: receivedPartialUsage, omitted: receivedOmittedUsage}).toEqual({
+      partial: {inputTokens: 35, outputTokens: 15, totalTokens: 50},
+      omitted: undefined,
+    });
+  });
+});