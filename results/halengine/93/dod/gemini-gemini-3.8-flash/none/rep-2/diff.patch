+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const createSession = (): ChatSession => ({
+  sessionId: 'test-session',
+  userId: 'test-user',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const createScriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let roundIndex = 0;
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[roundIndex++] ?? []) {
+        yield chunk;
+      }
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const createRegistry = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register({name: 'compute', description: 'runs computation', inputSchema: {type: 'object'}}, async () => ({
+    result: 'done',
+  }));
+  return registry;
+};
+
+const TOOL_CALL: MessageChunk = {
+  type: 'tool_use',
+  toolCall: {id: 'call-1', name: 'compute', input: {}},
+};
+
+describe('ChatOrchestrator usage across tool rounds', () => {
+  it('sums the usage of every round, not only the last', async () => {
+    const firstUsage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const secondUsage: UsageMetadata = {inputTokens: 20, outputTokens: 7, totalTokens: 27};
+    let receivedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, reported) => {
+        receivedUsage = reported;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      createScriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: firstUsage}],
+        [
+          {type: 'text', text: 'final response'},
+          {type: 'stop', stopReason: 'end_turn', usage: secondUsage},
+        ],
+      ]),
+      promptBuilder,
+      createRegistry(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession());
+
+    expect(receivedUsage).toEqual({inputTokens: 30, outputTokens: 12, totalTokens: 42});
+  });
+
+  it('counts every reporting round even when a round between them reports none', async () => {
+    const firstUsage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const thirdUsage: UsageMetadata = {inputTokens: 1, outputTokens: 2, totalTokens: 3};
+    let receivedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, reported) => {
+        receivedUsage = reported;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      createScriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: firstUsage}],
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+        [
+          {type: 'text', text: 'final response'},
+          {type: 'stop', stopReason: 'end_turn', usage: thirdUsage},
+        ],
+      ]),
+      promptBuilder,
+      createRegistry(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession());
+
+    expect(receivedUsage).toEqual({inputTokens: 11, outputTokens: 7, totalTokens: 18});
+  });
+});