+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 'session-1',
+    userId: 'user-1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+describe('report usage across every tool round', () => {
+  const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+  it('reports usage covering every provider call in a turn driven through two tool rounds', async () => {
+    let receivedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const registry = new ToolRegistry();
+    registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+      result: 'found',
+    }));
+
+    const usageRound0: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const usageRound1: UsageMetadata = {inputTokens: 25, outputTokens: 12, totalTokens: 37};
+    const usageRound2: UsageMetadata = {inputTokens: 40, outputTokens: 18, totalTokens: 58};
+
+    const toolCall1: MessageChunk = {
+      type: 'tool_use',
+      toolCall: {id: 'call-1', name: 'lookup', input: {q: 'one'}},
+    };
+    const toolCall2: MessageChunk = {
+      type: 'tool_use',
+      toolCall: {id: 'call-2', name: 'lookup', input: {q: 'two'}},
+    };
+
+    const provider = scriptedProvider([
+      [toolCall1, {type: 'stop', stopReason: 'tool_use', usage: usageRound0}],
+      [toolCall2, {type: 'stop', stopReason: 'tool_use', usage: usageRound1}],
+      [
+        {type: 'text', text: 'final answer'},
+        {type: 'stop', stopReason: 'end_turn', usage: usageRound2},
+      ],
+    ]);
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry, {hooks});
+    await orchestrator.processMessage(createSession('run tools'));
+
+    expect(receivedUsage).toEqual({
+      inputTokens: 75,
+      outputTokens: 35,
+      totalTokens: 110,
+    });
+  });
+
+  it('accumulates usage from reporting rounds when some rounds report no usage', async () => {
+    let receivedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const registry = new ToolRegistry();
+    registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+      result: 'found',
+    }));
+
+    const usageRound0: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const usageRound2: UsageMetadata = {inputTokens: 30, outputTokens: 10, totalTokens: 40};
+
+    const toolCall1: MessageChunk = {
+      type: 'tool_use',
+      toolCall: {id: 'call-1', name: 'lookup', input: {q: 'one'}},
+    };
+    const toolCall2: MessageChunk = {
+      type: 'tool_use',
+      toolCall: {id: 'call-2', name: 'lookup', input: {q: 'two'}},
+    };
+
+    const provider = scriptedProvider([
+      [toolCall1, {type: 'stop', stopReason: 'tool_use', usage: usageRound0}],
+      [toolCall2, {type: 'stop', stopReason: 'tool_use'}],
+      [
+        {type: 'text', text: 'final answer'},
+        {type: 'stop', stopReason: 'end_turn', usage: usageRound2},
+      ],
+    ]);
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry, {hooks});
+    await orchestrator.processMessage(createSession('run tools with missing usage'));
+
+    expect(receivedUsage).toEqual({
+      inputTokens: 40,
+      outputTokens: 15,
+      totalTokens: 55,
+    });
+  });
+});