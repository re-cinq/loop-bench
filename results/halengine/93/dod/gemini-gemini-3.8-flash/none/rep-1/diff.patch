+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolResponse} from './tools/registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryReturning = (response: ToolResponse): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => response
+  );
+  return registry;
+};
+
+const TOOL_CALL_1: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: '1'}}};
+const TOOL_CALL_2: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-2', name: 'lookup', input: {q: '2'}}};
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports usage covering every provider call in a turn driven through two tool rounds', async () => {
+    const round1Usage: UsageMetadata = {inputTokens: 10, outputTokens: 2, totalTokens: 12};
+    const round2Usage: UsageMetadata = {inputTokens: 20, outputTokens: 4, totalTokens: 24};
+    const round3Usage: UsageMetadata = {inputTokens: 30, outputTokens: 6, totalTokens: 36};
+
+    let reportedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        reportedUsage = usage;
+      },
+    };
+
+    const provider = scriptedProvider([
+      [TOOL_CALL_1, {type: 'stop', stopReason: 'tool_use', usage: round1Usage}],
+      [TOOL_CALL_2, {type: 'stop', stopReason: 'tool_use', usage: round2Usage}],
+      [
+        {type: 'text', text: 'final answer'},
+        {type: 'stop', stopReason: 'end_turn', usage: round3Usage},
+      ],
+    ]);
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registryReturning({result: 'ok'}), {
+      hooks,
+    });
+
+    await orchestrator.processMessage(createSession('question'));
+
+    expect(reportedUsage).toEqual({
+      inputTokens: 60,
+      outputTokens: 12,
+      totalTokens: 72,
+    });
+  });
+
+  it('accumulates usage across rounds when some rounds report no usage', async () => {
+    const round1Usage: UsageMetadata = {inputTokens: 10, outputTokens: 2, totalTokens: 12};
+    const round3Usage: UsageMetadata = {inputTokens: 20, outputTokens: 4, totalTokens: 24};
+
+    let reportedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        reportedUsage = usage;
+      },
+    };
+
+    const provider = scriptedProvider([
+      [TOOL_CALL_1, {type: 'stop', stopReason: 'tool_use', usage: round1Usage}],
+      [TOOL_CALL_2, {type: 'stop', stopReason: 'tool_use'}],
+      [
+        {type: 'text', text: 'final answer'},
+        {type: 'stop', stopReason: 'end_turn', usage: round3Usage},
+      ],
+    ]);
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registryReturning({result: 'ok'}), {
+      hooks,
+    });
+
+    await orchestrator.processMessage(createSession('question'));
+
+    expect(reportedUsage).toEqual({
+      inputTokens: 30,
+      outputTokens: 6,
+      totalTokens: 36,
+    });
+  });
+});