+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const driveTurnWithRounds = async (rounds: MessageChunk[][], hooks: OrchestratorHooks): Promise<void> => {
+  let currentRound = 0;
+  const provider: AIProvider = {
+    async *sendMessage() {
+      for (const chunk of rounds[currentRound++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'Data lookup', inputSchema: {type: 'object'}}, async () => 'data');
+
+  const session: ChatSession = {
+    sessionId: 's-test',
+    userId: 'u-test',
+    entries: [{role: 'user', content: 'run query', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Test assistant'}), registry, {
+    hooks,
+  });
+
+  await orchestrator.processMessage(session);
+};
+
+describe('afterModelResponse usage reporting across tool rounds', () => {
+  it('accumulates usage across every provider call in a multi-round tool turn', async () => {
+    let receivedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    await driveTurnWithRounds(
+      [
+        [
+          {type: 'tool_use', toolCall: {id: 'c1', name: 'lookup', input: {}}},
+          {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 10, outputTokens: 2, totalTokens: 12}},
+        ],
+        [
+          {type: 'tool_use', toolCall: {id: 'c2', name: 'lookup', input: {}}},
+          {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 15, outputTokens: 3, totalTokens: 18}},
+        ],
+        [
+          {type: 'text', text: 'final answer'},
+          {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 20, outputTokens: 5, totalTokens: 25}},
+        ],
+      ],
+      hooks
+    );
+
+    expect(receivedUsage).toEqual({inputTokens: 45, outputTokens: 10, totalTokens: 55});
+  });
+
+  it('sums usage across rounds when some rounds report no usage', async () => {
+    let receivedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    await driveTurnWithRounds(
+      [
+        [
+          {type: 'tool_use', toolCall: {id: 'c1', name: 'lookup', input: {}}},
+          {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 10, outputTokens: 2, totalTokens: 12}},
+        ],
+        [
+          {type: 'tool_use', toolCall: {id: 'c2', name: 'lookup', input: {}}},
+          {type: 'stop', stopReason: 'tool_use'},
+        ],
+        [
+          {type: 'text', text: 'final answer'},
+          {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 20, outputTokens: 5, totalTokens: 25}},
+        ],
+      ],
+      hooks
+    );
+
+    expect(receivedUsage).toEqual({inputTokens: 30, outputTokens: 7, totalTokens: 37});
+  });
+});