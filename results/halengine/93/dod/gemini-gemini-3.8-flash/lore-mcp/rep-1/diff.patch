+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolResponse} from './tools/registry.js';
+
+const FIXED_TIMESTAMP = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 'session-acceptance-1',
+    userId: 'user-acceptance-1',
+    entries: [{role: 'user', content, timestamp: FIXED_TIMESTAMP}],
+  };
+}
+
+function createScriptedProvider(rounds: MessageChunk[][]): AIProvider {
+  let currentRound = 0;
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[currentRound++] ?? []) {
+        yield chunk;
+      }
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+function createToolRegistry(response: ToolResponse): ToolRegistry {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks up data', inputSchema: {type: 'object'}},
+    async () => response
+  );
+  return registry;
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator usage across tool rounds acceptance', () => {
+  it('reports usage covering every provider call in a turn driven through two tool rounds', async () => {
+    const round0Usage: UsageMetadata = {inputTokens: 10, outputTokens: 2, totalTokens: 12};
+    const round1Usage: UsageMetadata = {inputTokens: 20, outputTokens: 4, totalTokens: 24};
+    const round2Usage: UsageMetadata = {inputTokens: 30, outputTokens: 6, totalTokens: 36};
+
+    let receivedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const toolCall1: MessageChunk = {
+      type: 'tool_use',
+      toolCall: {id: 'call-1', name: 'lookup', input: {query: 'alpha'}},
+    };
+    const toolCall2: MessageChunk = {
+      type: 'tool_use',
+      toolCall: {id: 'call-2', name: 'lookup', input: {query: 'beta'}},
+    };
+
+    const provider = createScriptedProvider([
+      [toolCall1, {type: 'stop', stopReason: 'tool_use', usage: round0Usage}],
+      [toolCall2, {type: 'stop', stopReason: 'tool_use', usage: round1Usage}],
+      [
+        {type: 'text', text: 'final answer'},
+        {type: 'stop', stopReason: 'end_turn', usage: round2Usage},
+      ],
+    ]);
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, createToolRegistry({result: 'ok'}), {hooks});
+
+    await orchestrator.processMessage(createSession('run tools'));
+
+    expect(receivedUsage).toEqual({
+      inputTokens: 60,
+      outputTokens: 12,
+      totalTokens: 72,
+    });
+  });
+
+  it('accumulates usage when some rounds omit usage, and reports undefined when no round reported usage', async () => {
+    const round0Usage: UsageMetadata = {inputTokens: 15, outputTokens: 5, totalTokens: 20};
+    const round2Usage: UsageMetadata = {inputTokens: 25, outputTokens: 10, totalTokens: 35};
+
+    let partialRunUsage: UsageMetadata | undefined;
+    let noUsageRunUsage: UsageMetadata | undefined = {inputTokens: -1, outputTokens: -1, totalTokens: -1};
+
+    const toolCall1: MessageChunk = {
+      type: 'tool_use',
+      toolCall: {id: 'call-1', name: 'lookup', input: {query: 'alpha'}},
+    };
+    const toolCall2: MessageChunk = {
+      type: 'tool_use',
+      toolCall: {id: 'call-2', name: 'lookup', input: {query: 'beta'}},
+    };
+
+    const partialProvider = createScriptedProvider([
+      [toolCall1, {type: 'stop', stopReason: 'tool_use', usage: round0Usage}],
+      [toolCall2, {type: 'stop', stopReason: 'tool_use'}],
+      [
+        {type: 'text', text: 'partial answer'},
+        {type: 'stop', stopReason: 'end_turn', usage: round2Usage},
+      ],
+    ]);
+
+    const orchestratorPartial = createChatOrchestrator(
+      partialProvider,
+      promptBuilder,
+      createToolRegistry({result: 'ok'}),
+      {
+        hooks: {
+          afterModelResponse: async (_session, _text, usage) => {
+            partialRunUsage = usage;
+          },
+        },
+      }
+    );
+    await orchestratorPartial.processMessage(createSession('run partial'));
+
+    const noUsageProvider = createScriptedProvider([
+      [toolCall1, {type: 'stop', stopReason: 'tool_use'}],
+      [
+        {type: 'text', text: 'no usage answer'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ]);
+
+    const orchestratorNoUsage = createChatOrchestrator(
+      noUsageProvider,
+      promptBuilder,
+      createToolRegistry({result: 'ok'}),
+      {
+        hooks: {
+          afterModelResponse: async (_session, _text, usage) => {
+            noUsageRunUsage = usage;
+          },
+        },
+      }
+    );
+    await orchestratorNoUsage.processMessage(createSession('run no usage'));
+
+    expect({partialRunUsage, noUsageRunUsage}).toEqual({
+      partialRunUsage: {
+        inputTokens: 40,
+        outputTokens: 15,
+        totalTokens: 55,
+      },
+      noUsageRunUsage: undefined,
+    });
+  });
+});