+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolResponse} from './tools/registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryReturning = (response: ToolResponse): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'lookup', inputSchema: {type: 'object'}}, async () => response);
+  return registry;
+};
+
+const TOOL_CALL_1: MessageChunk = {
+  type: 'tool_use',
+  toolCall: {id: 'call-1', name: 'lookup', input: {q: '1'}},
+};
+const TOOL_CALL_2: MessageChunk = {
+  type: 'tool_use',
+  toolCall: {id: 'call-2', name: 'lookup', input: {q: '2'}},
+};
+
+describe('afterModelResponse usage across tool rounds (HALEngine#93)', () => {
+  it('reports the sum of three provider calls when a turn runs two tool rounds', async () => {
+    const round1Usage: UsageMetadata = {inputTokens: 100, outputTokens: 10, totalTokens: 110};
+    const round2Usage: UsageMetadata = {inputTokens: 200, outputTokens: 20, totalTokens: 220};
+    const round3Usage: UsageMetadata = {inputTokens: 300, outputTokens: 30, totalTokens: 330};
+
+    let seenUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        seenUsage = usage;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL_1, {type: 'stop', stopReason: 'tool_use', usage: round1Usage}],
+        [TOOL_CALL_2, {type: 'stop', stopReason: 'tool_use', usage: round2Usage}],
+        [
+          {type: 'text', text: 'final answer'},
+          {type: 'stop', stopReason: 'end_turn', usage: round3Usage},
+        ],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'ok'}),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('run tools'));
+
+    expect(seenUsage).toEqual({
+      inputTokens: 600,
+      outputTokens: 60,
+      totalTokens: 660,
+    });
+  });
+
+  it('counts the rounds that reported usage when one round reports none, and reports nothing when no round did', async () => {
+    const round1Usage: UsageMetadata = {inputTokens: 7, outputTokens: 2, totalTokens: 9};
+    const round3Usage: UsageMetadata = {inputTokens: 5, outputTokens: 1, totalTokens: 6};
+
+    let seenPartialUsage: UsageMetadata | undefined;
+    const partialHooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        seenPartialUsage = usage;
+      },
+    };
+
+    const partialOrchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL_1, {type: 'stop', stopReason: 'tool_use', usage: round1Usage}],
+        [TOOL_CALL_2, {type: 'stop', stopReason: 'tool_use'}],
+        [
+          {type: 'text', text: 'final answer'},
+          {type: 'stop', stopReason: 'end_turn', usage: round3Usage},
+        ],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'ok'}),
+      {hooks: partialHooks}
+    );
+
+    await partialOrchestrator.processMessage(createSession('partial usage'));
+
+    let seenNoneUsage: UsageMetadata | undefined = {inputTokens: -1, outputTokens: -1, totalTokens: -1};
+    const noneHooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        seenNoneUsage = usage;
+      },
+    };
+
+    const noneOrchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [
+          {type: 'text', text: 'direct answer'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'ok'}),
+      {hooks: noneHooks}
+    );
+
+    await noneOrchestrator.processMessage(createSession('no usage'));
+
+    expect({partial: seenPartialUsage, none: seenNoneUsage}).toEqual({
+      partial: {inputTokens: 12, outputTokens: 3, totalTokens: 15},
+      none: undefined,
+    });
+  });
+});