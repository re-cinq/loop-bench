+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const TOOL_CALL: MessageChunk = {
+  type: 'tool_use',
+  toolCall: {id: 'call-1', name: 'lookup', input: {query: 'test'}},
+};
+
+describe('chatOrchestrator afterModelResponse usage aggregation', () => {
+  it('reports the sum of three provider calls when a turn runs two tool rounds', async () => {
+    let seenUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        seenUsage = usage;
+      },
+    };
+
+    const roundOneUsage: UsageMetadata = {inputTokens: 100, outputTokens: 10, totalTokens: 110};
+    const roundTwoUsage: UsageMetadata = {inputTokens: 200, outputTokens: 20, totalTokens: 220};
+    const roundThreeUsage: UsageMetadata = {inputTokens: 300, outputTokens: 30, totalTokens: 330};
+
+    const provider = sequenceProvider([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: roundOneUsage}],
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: roundTwoUsage}],
+      [
+        {type: 'text', text: 'all done'},
+        {type: 'stop', stopReason: 'end_turn', usage: roundThreeUsage},
+      ],
+    ]);
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, createToolRegistry(), {hooks});
+    await orchestrator.processMessage(createSession('run tools'));
+
+    expect(seenUsage).toEqual({
+      inputTokens: 600,
+      outputTokens: 60,
+      totalTokens: 660,
+    });
+  });
+
+  it('counts the rounds that reported usage when one round reports none, and reports nothing when no round did', async () => {
+    let seenUsagePartial: UsageMetadata | undefined;
+    const partialHooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        seenUsagePartial = usage;
+      },
+    };
+
+    const firstUsage: UsageMetadata = {inputTokens: 7, outputTokens: 2, totalTokens: 9};
+    const thirdUsage: UsageMetadata = {inputTokens: 5, outputTokens: 1, totalTokens: 6};
+
+    const partialProvider = sequenceProvider([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: firstUsage}],
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+      [
+        {type: 'text', text: 'finished'},
+        {type: 'stop', stopReason: 'end_turn', usage: thirdUsage},
+      ],
+    ]);
+
+    const partialOrchestrator = createChatOrchestrator(partialProvider, promptBuilder, createToolRegistry(), {
+      hooks: partialHooks,
+    });
+    await partialOrchestrator.processMessage(createSession('partial usage'));
+
+    let seenUsageNone: UsageMetadata | undefined;
+    const noneHooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        seenUsageNone = usage;
+      },
+    };
+
+    const noneProvider = sequenceProvider([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+      [
+        {type: 'text', text: 'finished'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ]);
+
+    const noneOrchestrator = createChatOrchestrator(noneProvider, promptBuilder, createToolRegistry(), {
+      hooks: noneHooks,
+    });
+    await noneOrchestrator.processMessage(createSession('no usage'));
+
+    expect({partial: seenUsagePartial, none: seenUsageNone}).toEqual({
+      partial: {inputTokens: 12, outputTokens: 3, totalTokens: 15},
+      none: undefined,
+    });
+  });
+});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 'session-1',
+    userId: 'user-1',
+    entries: [{role: 'user', content, timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+}
+
+function sequenceProvider(rounds: MessageChunk[][]): AIProvider {
+  let roundIndex = 0;
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const chunks = rounds[roundIndex++];
+      if (chunks) {
+        for (const chunk of chunks) yield chunk;
+      }
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+function createToolRegistry(): ToolRegistry {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found',
+  }));
+  return registry;
+}