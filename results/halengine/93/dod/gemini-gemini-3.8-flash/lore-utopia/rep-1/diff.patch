+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolResponse} from './tools/registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const registryReturning = (response: ToolResponse): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => response
+  );
+  return registry;
+};
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const TOOL_CALL_1: MessageChunk = {
+  type: 'tool_use',
+  toolCall: {id: 'call-1', name: 'lookup', input: {q: 'first'}},
+};
+const TOOL_CALL_2: MessageChunk = {
+  type: 'tool_use',
+  toolCall: {id: 'call-2', name: 'lookup', input: {q: 'second'}},
+};
+const STOP_DONE: MessageChunk = {type: 'stop', stopReason: 'end_turn'};
+
+describe('ChatOrchestrator usage across tool rounds', () => {
+  it('reports the sum of three provider calls when a turn runs two tool rounds', async () => {
+    let seen: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, reported) => {
+        seen = reported;
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [
+          TOOL_CALL_1,
+          {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 100, outputTokens: 10, totalTokens: 110}},
+        ],
+        [
+          TOOL_CALL_2,
+          {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 200, outputTokens: 20, totalTokens: 220}},
+        ],
+        [
+          {type: 'text', text: 'final'},
+          {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 300, outputTokens: 30, totalTokens: 330}},
+        ],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'ok'}),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('question'));
+
+    expect(seen).toEqual({inputTokens: 600, outputTokens: 60, totalTokens: 660});
+  });
+
+  it('counts the rounds that reported usage when one round reports none, and reports nothing when no round did', async () => {
+    let seenPartial: UsageMetadata | undefined;
+    let seenNone: UsageMetadata | undefined;
+
+    const partialHooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, reported) => {
+        seenPartial = reported;
+      },
+    };
+    const partialOrchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [
+          TOOL_CALL_1,
+          {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 7, outputTokens: 2, totalTokens: 9}},
+        ],
+        [TOOL_CALL_2, {type: 'stop', stopReason: 'tool_use'}],
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 5, outputTokens: 1, totalTokens: 6}},
+        ],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'ok'}),
+      {hooks: partialHooks}
+    );
+
+    await partialOrchestrator.processMessage(createSession('first question'));
+
+    const noneHooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, reported) => {
+        seenNone = reported;
+      },
+    };
+    const noneOrchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL_1, {type: 'stop', stopReason: 'tool_use'}],
+        [{type: 'text', text: 'done'}, STOP_DONE],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'ok'}),
+      {hooks: noneHooks}
+    );
+
+    await noneOrchestrator.processMessage(createSession('second question'));
+
+    expect({partial: seenPartial, none: seenNone}).toEqual({
+      partial: {inputTokens: 12, outputTokens: 3, totalTokens: 15},
+      none: undefined,
+    });
+  });
+});