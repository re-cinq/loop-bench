+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import {setLogger} from '../shared/logger.js';
+
+const quiet = () => undefined;
+
+// specs/hal-engine-config-hooks/spec.md
+describe('afterModelResponse usage across tool rounds', () => {
+  beforeEach(() => {
+    setLogger({debug: quiet, info: quiet, warn: quiet, error: quiet});
+  });
+
+  afterEach(() => {
+    setLogger();
+  });
+
+  it('reports usage covering every provider call in a turn driven through two tool rounds', async () => {
+    const round0Usage: UsageMetadata = {inputTokens: 10, outputTokens: 2, totalTokens: 12};
+    const round1Usage: UsageMetadata = {inputTokens: 20, outputTokens: 4, totalTokens: 24};
+    const round2Usage: UsageMetadata = {inputTokens: 30, outputTokens: 6, totalTokens: 36};
+
+    const toolCall1: MessageChunk = {
+      type: 'tool_use',
+      toolCall: {id: 'call-1', name: 'toolA', input: {}},
+    };
+    const toolCall2: MessageChunk = {
+      type: 'tool_use',
+      toolCall: {id: 'call-2', name: 'toolB', input: {}},
+    };
+
+    const rounds: MessageChunk[][] = [
+      [toolCall1, {type: 'stop', stopReason: 'tool_use', usage: round0Usage}],
+      [toolCall2, {type: 'stop', stopReason: 'tool_use', usage: round1Usage}],
+      [
+        {type: 'text', text: 'final answer'},
+        {type: 'stop', stopReason: 'end_turn', usage: round2Usage},
+      ],
+    ];
+
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        for (const chunk of rounds[round++] ?? []) yield chunk;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const registry = new ToolRegistry();
+    registry.register({name: 'toolA', description: 'tool A', inputSchema: {type: 'object'}}, async () => ({
+      result: 'resA',
+    }));
+    registry.register({name: 'toolB', description: 'tool B', inputSchema: {type: 'object'}}, async () => ({
+      result: 'resB',
+    }));
+
+    let seenUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _responseText, usage) => {
+        seenUsage = usage;
+      },
+    };
+
+    const promptBuilder = new PromptBuilder({identity: 'test assistant'});
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry, {hooks});
+
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'run tools', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+
+    await orchestrator.processMessage(session);
+
+    expect(seenUsage).toEqual({
+      inputTokens: 60,
+      outputTokens: 12,
+      totalTokens: 72,
+    });
+  });
+});