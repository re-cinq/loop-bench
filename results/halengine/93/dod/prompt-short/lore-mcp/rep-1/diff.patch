+import {ToolRegistry} from './tools/registry.js';
+import type {ChatSession} from '../types/session.js';
+import {scriptedProvider} from './scripted-provider-helper.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    workspaceId: 'w1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createForecastRegistry(): ToolRegistry {
+  const registry = new ToolRegistry();
+  registry.register(
+    {
+      name: 'forecast',
+      description: 'get forecast',
+      inputSchema: {type: 'object', required: ['city'], properties: {city: {type: 'string'}}},
+    },
+    async () => 'sunny in London'
+  );
+  return registry;
+}
+
+const runWithRegistry = async (
+  rounds: MessageChunk[][],
+  registry = new ToolRegistry()
+): Promise<UsageMetadata | undefined> => {
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reported = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(scriptedProvider(rounds), promptBuilder, registry, {hooks});
+  await orchestrator.processMessage(createSession('ask'));
+  return reported;
+};
+
+const ROUND_FIRST_CALL: MessageChunk[] = [
+  {type: 'tool_use', toolCall: {id: 'c1', name: 'forecast', input: {city: 'London'}}},
+  {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 10, outputTokens: 5, totalTokens: 15}},
+];
+
+const ROUND_TEXT_DONE: MessageChunk[] = [
+  {type: 'text', text: 'done'},
+  {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 20, outputTokens: 10, totalTokens: 30}},
+];
+
+const runTwoToolRounds = (parisStop: MessageChunk): Promise<UsageMetadata | undefined> =>
+  runWithRegistry(
+    [
+      ROUND_FIRST_CALL,
+      [{type: 'tool_use', toolCall: {id: 'c2', name: 'forecast', input: {city: 'Paris'}}}, parisStop],
+      ROUND_TEXT_DONE,
+    ],
+    createForecastRegistry()
+  );
+
+describe('Report usage across every tool round', () => {
+  it('A turn driven through two tool rounds reports usage covering every provider call in that turn', async () => {
+    const usage = await runTwoToolRounds({
+      type: 'stop',
+      stopReason: 'tool_use',
+      usage: {inputTokens: 12, outputTokens: 6, totalTokens: 18},
+    });
+
+    expect(usage).toEqual({
+      inputTokens: 42,
+      outputTokens: 21,
+      totalTokens: 63,
+    });
+  });
+
+  it('A provider that reports no usage on some rounds does not make the total undefined or NaN', async () => {
+    const usage = await runTwoToolRounds({type: 'stop', stopReason: 'tool_use'});
+
+    expect(usage).toEqual({
+      inputTokens: 30,
+      outputTokens: 15,
+      totalTokens: 45,
+    });
+  });
+
+  it('A turn where nothing reported still reports nothing', async () => {
+    const usage = await runWithRegistry([
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ]);
+
+    expect(usage).toBeUndefined();
+  });
+});
