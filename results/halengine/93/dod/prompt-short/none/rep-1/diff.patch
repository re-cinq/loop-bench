@@ -0,0 +1,27 @@
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolResponse} from './tools/registry.js';
+
+export const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+export const registryReturning = (response: ToolResponse): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => response
+  );
+  return registry;
+};
+
+export const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
diff --git a/src/orchestration/usageReporting.acceptance.test.ts b/src/orchestration/usageReporting.acceptance.test.ts
new file mode 100644
index 0000000..ed8c018
--- /dev/null
+++ b/src/orchestration/usageReporting.acceptance.test.ts
@@ -0,0 +1,89 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {scriptedProvider, registryReturning, TOOL_CALL} from './orchestratorTestFixtures.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+async function runTurnAndCaptureUsage(rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> {
+  let reportedUsage: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reportedUsage = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(
+    scriptedProvider(rounds),
+    promptBuilder,
+    registryReturning({result: 'r'}),
+    {hooks}
+  );
+  await orchestrator.processMessage(createSession('ask'));
+  return reportedUsage;
+}
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const round3Usage: UsageMetadata = {inputTokens: 15, outputTokens: 10, totalTokens: 25};
+
+describe('Usage reporting across tool rounds', () => {
+  it('reports usage covering every provider call in that turn, asserted against a scripted provider whose rounds report known, different token counts', async () => {
+    const round1Usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const round2Usage: UsageMetadata = {inputTokens: 20, outputTokens: 8, totalTokens: 28};
+
+    const reportedUsage = await runTurnAndCaptureUsage([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: round1Usage}],
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: round2Usage}],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn', usage: round3Usage},
+      ],
+    ]);
+
+    expect(reportedUsage).toEqual({
+      inputTokens: 45,
+      outputTokens: 23,
+      totalTokens: 68,
+    });
+  });
+
+  it('a provider that reports no usage on some rounds does not make the total undefined or NaN: the rounds that reported are still counted', async () => {
+    const round1Usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+
+    const reportedUsage = await runTurnAndCaptureUsage([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: round1Usage}],
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn', usage: round3Usage},
+      ],
+    ]);
+
+    expect(reportedUsage).toEqual({
+      inputTokens: 25,
+      outputTokens: 15,
+      totalTokens: 40,
+    });
+  });
+
+  it('a turn where nothing reported still reports nothing', async () => {
+    const reportedUsage = await runTurnAndCaptureUsage([
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ]);
+
+    expect(reportedUsage).toBeUndefined();
+  });
+});