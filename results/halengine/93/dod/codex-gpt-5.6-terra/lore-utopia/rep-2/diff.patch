+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const promptBuilder = new PromptBuilder({identity: 'Usage acceptance test.'});
+const session = (): ChatSession => ({
+  sessionId: 'usage-session',
+  userId: 'usage-user',
+  entries: [{role: 'user', content: 'look this up twice', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const toolRound = (id: string, usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id, name: 'lookup', input: {}}},
+  {type: 'stop', stopReason: 'tool_use', usage},
+];
+
+const finishRound = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'Done.'},
+  {type: 'stop', stopReason: 'end_turn', usage},
+];
+
+const runWithRounds = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let call = 0;
+  let reported: UsageMetadata | undefined;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield* rounds[call++];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Looks something up.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reported = usage;
+    },
+  };
+
+  await createChatOrchestrator(provider, promptBuilder, registry, {hooks}).processMessage(session());
+
+  return reported;
+};
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports totals from every provider call while leaving unreported rounds absent', async () => {
+    const everyRoundReported = await runWithRounds([
+      toolRound('first', {inputTokens: 11, outputTokens: 2, totalTokens: 13}),
+      toolRound('second', {inputTokens: 17, outputTokens: 3, totalTokens: 20}),
+      finishRound({inputTokens: 23, outputTokens: 5, totalTokens: 28}),
+    ]);
+    const someReported = await runWithRounds([
+      toolRound('first'),
+      toolRound('second', {inputTokens: 17, outputTokens: 3, totalTokens: 20}),
+      finishRound(),
+    ]);
+    const noneReported = await runWithRounds([toolRound('first'), toolRound('second'), finishRound()]);
+
+    expect({everyRoundReported, someReported, noneReported}).toEqual({
+      everyRoundReported: {inputTokens: 51, outputTokens: 10, totalTokens: 61},
+      someReported: {inputTokens: 17, outputTokens: 3, totalTokens: 20},
+      noneReported: undefined,
+    });
+  });
+});