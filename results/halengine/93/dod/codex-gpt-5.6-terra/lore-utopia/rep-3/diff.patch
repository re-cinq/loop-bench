+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const createSession = (): ChatSession => ({
+  sessionId: 'usage-session',
+  userId: 'usage-user',
+  entries: [{role: 'user', content: 'look this up twice', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const toolRegistry = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found it',
+  }));
+  return registry;
+};
+
+const toolCall = (id: string): MessageChunk => ({
+  type: 'tool_use',
+  toolCall: {id, name: 'lookup', input: {query: 'test'}},
+});
+
+const toolStop = (usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason: 'tool_use', usage});
+
+const done = (usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason: 'end_turn', usage});
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports the sum of every provider call made by a turn with two tool rounds', async () => {
+    let receivedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _responseText, usage) => {
+        receivedUsage = usage;
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [toolCall('first'), toolStop({inputTokens: 2, outputTokens: 3, totalTokens: 5})],
+        [toolCall('second'), toolStop({inputTokens: 7, outputTokens: 11, totalTokens: 18})],
+        [{type: 'text', text: 'done'}, done({inputTokens: 13, outputTokens: 17, totalTokens: 30})],
+      ]),
+      promptBuilder,
+      toolRegistry(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession());
+
+    expect(receivedUsage).toEqual({inputTokens: 22, outputTokens: 31, totalTokens: 53});
+  });
+
+  it('sums reported rounds while leaving a turn with no reported usage undefined', async () => {
+    const receivedUsages: Array<UsageMetadata | undefined> = [];
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _responseText, usage) => {
+        receivedUsages.push(usage);
+      },
+    };
+    const partialUsage = createChatOrchestrator(
+      scriptedProvider([
+        [toolCall('first'), toolStop({inputTokens: 2, outputTokens: 3, totalTokens: 5})],
+        [toolCall('second'), toolStop()],
+        [{type: 'text', text: 'done'}, done({inputTokens: 7, outputTokens: 11, totalTokens: 18})],
+      ]),
+      promptBuilder,
+      toolRegistry(),
+      {hooks}
+    );
+    const noUsage = createChatOrchestrator(
+      scriptedProvider([[{type: 'text', text: 'done'}, done()]]),
+      promptBuilder,
+      undefined,
+      {
+        hooks,
+      }
+    );
+
+    await partialUsage.processMessage(createSession());
+    await noUsage.processMessage(createSession());
+
+    expect(receivedUsages).toEqual([{inputTokens: 9, outputTokens: 14, totalTokens: 23}, undefined]);
+  });
+});