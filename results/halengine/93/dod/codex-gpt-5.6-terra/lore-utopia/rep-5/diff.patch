+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const session = (): ChatSession => ({
+  sessionId: 'usage-session',
+  userId: 'usage-user',
+  entries: [{role: 'user', content: 'Look this up twice.', timestamp: '2026-10-31T00:00:00.000Z'}],
+});
+
+const toolRound = (id: string, usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id, name: 'lookup', input: {}}},
+  {type: 'stop', stopReason: 'tool_use', usage},
+];
+
+const providerFor = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const lookupTools = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Looks up a value.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  return registry;
+};
+
+it('reports the sum of every provider call to afterModelResponse across two tool rounds', async () => {
+  let reported: UsageMetadata | undefined;
+  let unreported: UsageMetadata | undefined;
+  const firstUsage = {inputTokens: 2, outputTokens: 3, totalTokens: 5};
+  const finalUsage = {inputTokens: 7, outputTokens: 11, totalTokens: 18};
+  const orchestrator = createChatOrchestrator(
+    providerFor([
+      toolRound('first', firstUsage),
+      toolRound('second'),
+      [
+        {type: 'text', text: 'Done.'},
+        {type: 'stop', stopReason: 'end_turn', usage: finalUsage},
+      ],
+    ]),
+    new PromptBuilder({identity: 'Usage acceptance test.'}),
+    lookupTools(),
+    {hooks: {afterModelResponse: async (_session, _text, usage) => void (reported = usage)}}
+  );
+
+  await orchestrator.processMessage(session());
+
+  await createChatOrchestrator(
+    providerFor([
+      [
+        {type: 'text', text: 'No usage.'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ]),
+    new PromptBuilder({identity: 'Usage acceptance test.'}),
+    undefined,
+    {hooks: {afterModelResponse: async (_session, _text, usage) => void (unreported = usage)}}
+  ).processMessage(session());
+
+  expect({reported, unreported}).toEqual({
+    reported: {inputTokens: 9, outputTokens: 14, totalTokens: 23},
+    unreported: undefined,
+  });
+});