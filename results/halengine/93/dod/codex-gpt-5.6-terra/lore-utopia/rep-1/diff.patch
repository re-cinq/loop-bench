+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const promptBuilder = new PromptBuilder({identity: 'Usage acceptance test.'});
+
+const session = (): ChatSession => ({
+  sessionId: 'usage-session',
+  userId: 'usage-user',
+  entries: [{role: 'user', content: 'Look this up twice.', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const toolRound = (id: string, usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id, name: 'lookup', input: {}}},
+  {type: 'stop', stopReason: 'tool_use', usage},
+];
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let call = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[call++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registry = (): ToolRegistry => {
+  const tools = new ToolRegistry();
+  tools.register(
+    {name: 'lookup', description: 'Looks up a value.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  return tools;
+};
+
+const reportUsage = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _response, usage) => {
+      reported = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(scriptedProvider(rounds), promptBuilder, registry(), {hooks});
+
+  await orchestrator.processMessage(session());
+  return reported;
+};
+
+describe('afterModelResponse usage across provider rounds', () => {
+  it('reports the sum of every provider call across two tool rounds', async () => {
+    const reported = await reportUsage([
+      toolRound('first', {inputTokens: 11, outputTokens: 2, totalTokens: 13}),
+      toolRound('second', {inputTokens: 19, outputTokens: 5, totalTokens: 24}),
+      [
+        {type: 'text', text: 'Done.'},
+        {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 7, outputTokens: 3, totalTokens: 10}},
+      ],
+    ]);
+
+    expect(reported).toEqual({inputTokens: 37, outputTokens: 10, totalTokens: 47});
+  });
+
+  it('counts reported rounds without making missing usage a number', async () => {
+    const partial = await reportUsage([
+      toolRound('unreported'),
+      toolRound('reported', {inputTokens: 13, outputTokens: 4, totalTokens: 17}),
+      [
+        {type: 'text', text: 'Done.'},
+        {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 5, outputTokens: 1, totalTokens: 6}},
+      ],
+    ]);
+    const absent = await reportUsage([
+      [
+        {type: 'text', text: 'Done.'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ]);
+
+    expect({partial, absent}).toEqual({
+      partial: {inputTokens: 18, outputTokens: 5, totalTokens: 23},
+      absent: undefined,
+    });
+  });
+});