+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const promptBuilder = new PromptBuilder({identity: 'Usage aggregation acceptance test.'});
+const session: ChatSession = {
+  sessionId: 'usage-aggregation',
+  userId: 'customer',
+  entries: [{role: 'user', content: 'Please investigate this.', timestamp: '2026-10-31T00:00:00.000Z'}],
+};
+
+const toolCall = (id: string): MessageChunk => ({type: 'tool_use', toolCall: {id, name: 'lookup', input: {}}});
+const stopForTool = (usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason: 'tool_use', usage});
+const done = (usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason: 'end_turn', usage});
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield* rounds[round++] ?? [];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const lookupRegistry = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Looks up a record.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  return registry;
+};
+
+const reportedUsage = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reported = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(scriptedProvider(rounds), promptBuilder, lookupRegistry(), {hooks});
+
+  await orchestrator.processMessage(structuredClone(session));
+
+  return reported;
+};
+
+/** @spec specs/hal-engine-config-hooks/spec.md#9 */
+describe('afterModelResponse usage aggregation', () => {
+  it('reports the sum of every provider call after two tool rounds', async () => {
+    const reported = await reportedUsage([
+      [toolCall('first'), stopForTool({inputTokens: 11, outputTokens: 2, totalTokens: 13})],
+      [toolCall('second'), stopForTool({inputTokens: 7, outputTokens: 5, totalTokens: 12})],
+      [{type: 'text', text: 'Done.'}, done({inputTokens: 3, outputTokens: 8, totalTokens: 11})],
+    ]);
+
+    expect(reported).toEqual({inputTokens: 21, outputTokens: 15, totalTokens: 36});
+  });
+
+  it('counts reported rounds despite missing usage, and leaves an unreported turn undefined', async () => {
+    const partlyReported = await reportedUsage([
+      [toolCall('first'), stopForTool({inputTokens: 4, outputTokens: 1, totalTokens: 5})],
+      [toolCall('second'), stopForTool()],
+      [{type: 'text', text: 'Done.'}, done({inputTokens: 6, outputTokens: 2, totalTokens: 8})],
+    ]);
+    const neverReported = await reportedUsage([[{type: 'text', text: 'Done.'}, done()]]);
+
+    expect({partlyReported, neverReported}).toEqual({
+      partlyReported: {inputTokens: 10, outputTokens: 3, totalTokens: 13},
+      neverReported: undefined,
+    });
+  });
+});