+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const session = (): ChatSession => ({
+  sessionId: 'usage-session',
+  userId: 'usage-user',
+  entries: [{role: 'user', content: 'Use the tools.', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const toolCall = (id: string): MessageChunk => ({
+  type: 'tool_use',
+  toolCall: {id, name: 'lookup', input: {}},
+});
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const lookupTool = (): ToolRegistry => {
+  const tools = new ToolRegistry();
+  tools.register(
+    {name: 'lookup', description: 'Looks up a value.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  return tools;
+};
+
+const reportUsage = (provider: AIProvider): Promise<UsageMetadata | undefined> => {
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _responseText, usage) => {
+      reported = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(provider, promptBuilder, lookupTool(), {hooks});
+
+  return orchestrator.processMessage(session()).then(() => reported);
+};
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports the sum of every provider call in a turn that executes two tool rounds', async () => {
+    const usage = await reportUsage(
+      scriptedProvider([
+        [
+          toolCall('first'),
+          {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 2, outputTokens: 3, totalTokens: 5}},
+        ],
+        [
+          toolCall('second'),
+          {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 11, outputTokens: 13, totalTokens: 24}},
+        ],
+        [
+          {type: 'text', text: 'Done.'},
+          {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 17, outputTokens: 19, totalTokens: 36}},
+        ],
+      ])
+    );
+
+    expect(usage).toEqual({inputTokens: 30, outputTokens: 35, totalTokens: 65});
+  });
+
+  it('counts reported rounds around missing usage and leaves an entirely unreported turn undefined', async () => {
+    const partialUsage = await reportUsage(
+      scriptedProvider([
+        [
+          toolCall('first'),
+          {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 2, outputTokens: 3, totalTokens: 5}},
+        ],
+        [toolCall('second'), {type: 'stop', stopReason: 'tool_use'}],
+        [
+          {type: 'text', text: 'Done.'},
+          {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 17, outputTokens: 19, totalTokens: 36}},
+        ],
+      ])
+    );
+    const noUsage = await reportUsage(
+      scriptedProvider([
+        [toolCall('first'), {type: 'stop', stopReason: 'tool_use'}],
+        [toolCall('second'), {type: 'stop', stopReason: 'tool_use'}],
+        [
+          {type: 'text', text: 'Done.'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ],
+      ])
+    );
+
+    expect({partialUsage, noUsage}).toEqual({
+      partialUsage: {inputTokens: 19, outputTokens: 22, totalTokens: 41},
+      noUsage: undefined,
+    });
+  });
+});