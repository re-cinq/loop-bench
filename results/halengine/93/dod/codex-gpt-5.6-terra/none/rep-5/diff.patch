+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const session = (id: string): ChatSession => ({
+  sessionId: id,
+  userId: 'user',
+  entries: [{role: 'user', content: 'Please investigate this.', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => ({
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    yield* rounds.shift() ?? [];
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+const registryWithTwoTools = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Looks up a record.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  registry.register(
+    {name: 'summarize', description: 'Summarizes a record.', inputSchema: {type: 'object'}},
+    async () => 'summary'
+  );
+  return registry;
+};
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports the sum of reported provider usage and remains undefined when no round reports usage', async () => {
+    const reports: Array<UsageMetadata | undefined> = [];
+    const hooks: OrchestratorHooks = {afterModelResponse: async (_session, _text, usage) => void reports.push(usage)};
+    const provider = scriptedProvider([
+      [
+        {type: 'tool_use', toolCall: {id: 'lookup-1', name: 'lookup', input: {}}},
+        {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 3, outputTokens: 2, totalTokens: 5}},
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'summarize-1', name: 'summarize', input: {}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [{type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 7, outputTokens: 11, totalTokens: 18}}],
+      [{type: 'stop', stopReason: 'end_turn'}],
+    ]);
+    const orchestrator = createChatOrchestrator(
+      provider,
+      new PromptBuilder({identity: 'Usage test assistant.'}),
+      registryWithTwoTools(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(session('tool-turn'));
+    await orchestrator.processMessage(session('no-usage-turn'));
+
+    expect(reports).toEqual([{inputTokens: 10, outputTokens: 13, totalTokens: 23}, undefined]);
+  });
+});