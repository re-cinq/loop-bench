+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {TurnUsageMetadata} from '../index.js';
+import type {ChatSession} from '../types/session.js';
+
+const session = (): ChatSession => ({
+  sessionId: 'usage-session',
+  userId: 'usage-user',
+  entries: [{role: 'user', content: 'Look this up twice.', timestamp: '2026-10-31T00:00:00.000Z'}],
+});
+
+const stop = (stopReason: string, usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason, usage});
+
+const usageAcrossTwoToolRounds = async (roundUsages: Array<UsageMetadata | undefined>) => {
+  let round = 0;
+  let toolExecutions = 0;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const usage = roundUsages[round++];
+      if (round < 3) {
+        yield {type: 'tool_use', toolCall: {id: `lookup-${round}`, name: 'lookup', input: {}}};
+        yield stop('tool_use', usage);
+        return;
+      }
+      yield {type: 'text', text: 'The lookup is complete.'};
+      yield stop('end_turn', usage);
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const tools = new ToolRegistry();
+  tools.register({name: 'lookup', description: 'Looks up a value.', inputSchema: {type: 'object'}}, async () => {
+    toolExecutions++;
+    return 'found';
+  });
+  let reportedUsage: TurnUsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _responseText, usage) => {
+      reportedUsage = usage;
+    },
+  };
+
+  await createChatOrchestrator(provider, new PromptBuilder({identity: 'Usage test.'}), tools, {hooks}).processMessage(
+    session()
+  );
+
+  return {reportedUsage, toolExecutions};
+};
+
+describe('afterModelResponse turn usage', () => {
+  it('sums reported provider usage across two tool rounds, while absent reports remain absent', async () => {
+    const partiallyReported = await usageAcrossTwoToolRounds([
+      {inputTokens: 11, outputTokens: 2, totalTokens: 13},
+      undefined,
+      {inputTokens: 5, outputTokens: 7, totalTokens: 12},
+    ]);
+    const neverReported = await usageAcrossTwoToolRounds([undefined, undefined, undefined]);
+
+    expect({partiallyReported, neverReported}).toEqual({
+      partiallyReported: {
+        reportedUsage: {inputTokens: 16, outputTokens: 9, totalTokens: 25},
+        toolExecutions: 2,
+      },
+      neverReported: {reportedUsage: undefined, toolExecutions: 2},
+    });
+  });
+});