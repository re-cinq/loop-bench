+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'lookup-1', name: 'lookup', input: {q: 'x'}}};
+
+const session = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'Look this up', timestamp: SENT_AT}],
+});
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registry = (): ToolRegistry => {
+  const tools = new ToolRegistry();
+  tools.register({name: 'lookup', description: 'Looks things up.', inputSchema: {type: 'object'}}, async () => 'found');
+  return tools;
+};
+
+const captureUsage = (): {hooks: OrchestratorHooks; reported: () => UsageMetadata | undefined} => {
+  let usage: UsageMetadata | undefined;
+  return {
+    hooks: {
+      afterModelResponse: async (_session, _text, reported) => {
+        usage = reported;
+      },
+    },
+    reported: () => usage,
+  };
+};
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports the sum from every provider call after two tool rounds', async () => {
+    const first: UsageMetadata = {inputTokens: 10, outputTokens: 2, totalTokens: 12};
+    const second: UsageMetadata = {inputTokens: 20, outputTokens: 3, totalTokens: 23};
+    const final: UsageMetadata = {inputTokens: 30, outputTokens: 5, totalTokens: 35};
+    const {hooks, reported} = captureUsage();
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: first}],
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: second}],
+        [
+          {type: 'text', text: 'Done.'},
+          {type: 'stop', stopReason: 'end_turn', usage: final},
+        ],
+      ]),
+      promptBuilder,
+      registry(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(session());
+
+    expect(reported()).toEqual({inputTokens: 60, outputTokens: 10, totalTokens: 70});
+  });
+
+  it('counts reporting rounds around missing usage and leaves an entirely unreported turn undefined', async () => {
+    const first: UsageMetadata = {inputTokens: 10, outputTokens: 2, totalTokens: 12};
+    const final: UsageMetadata = {inputTokens: 30, outputTokens: 5, totalTokens: 35};
+    const partial = captureUsage();
+    const absent = captureUsage();
+
+    await createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: first}],
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+        [
+          {type: 'text', text: 'Done.'},
+          {type: 'stop', stopReason: 'end_turn', usage: final},
+        ],
+      ]),
+      promptBuilder,
+      registry(),
+      {hooks: partial.hooks}
+    ).processMessage(session());
+    await createChatOrchestrator(
+      scriptedProvider([
+        [
+          {type: 'text', text: 'Done.'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ],
+      ]),
+      promptBuilder,
+      undefined,
+      {hooks: absent.hooks}
+    ).processMessage(session());
+
+    expect({partial: partial.reported(), absent: absent.reported()}).toEqual({
+      partial: {inputTokens: 40, outputTokens: 7, totalTokens: 47},
+      absent: undefined,
+    });
+  });
+});