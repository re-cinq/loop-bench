+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'lookup-1', name: 'lookup', input: {}}};
+
+const session = (id: string): ChatSession => ({
+  sessionId: id,
+  userId: 'user',
+  entries: [{role: 'user', content: 'Look it up', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield* rounds[round++] ?? [];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registry = (): ToolRegistry => {
+  const tools = new ToolRegistry();
+  tools.register(
+    {name: 'lookup', description: 'Looks up a value.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  return tools;
+};
+
+describe('afterModelResponse usage', () => {
+  it('reports the total from every reporting provider call in tool turns and nothing when none report', async () => {
+    const reports: Array<UsageMetadata | undefined> = [];
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => void reports.push(usage),
+    };
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 2, outputTokens: 3, totalTokens: 5}}],
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 7, outputTokens: 11, totalTokens: 18}}],
+        [
+          {type: 'text', text: 'Done.'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ],
+        [
+          {type: 'text', text: 'No usage.'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ],
+      ]),
+      new PromptBuilder({identity: 'Usage test assistant.'}),
+      registry(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(session('tool-turn'));
+    await orchestrator.processMessage(session('no-usage-turn'));
+
+    expect(reports).toEqual([{inputTokens: 9, outputTokens: 14, totalTokens: 23}, undefined]);
+  });
+});