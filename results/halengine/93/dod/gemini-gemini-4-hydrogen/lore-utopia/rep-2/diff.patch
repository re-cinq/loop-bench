+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const PROMPT = new PromptBuilder({identity: 'Acceptance test assistant.'});
+const FIXED_TIME = '2026-01-01T00:00:00.000Z';
+
+const turnSession = (text: string): ChatSession => ({
+  sessionId: 'accept-session',
+  userId: 'accept-user',
+  entries: [{role: 'user', content: text, timestamp: FIXED_TIME}],
+});
+
+const toolCallRound = (id: string, usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id, name: 'lookup', input: {key: id}}},
+  {type: 'stop', stopReason: 'tool_use', usage},
+];
+
+const finalAnswerRound = (text: string, usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text},
+  {type: 'stop', stopReason: 'end_turn', usage},
+];
+
+const runTurnWithRounds = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let index = 0;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const chunks = rounds[index++] ?? [];
+      for (const chunk of chunks) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'Lookup data', inputSchema: {type: 'object'}}, async () => 'result');
+
+  let reportedUsage: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _responseText, usage) => {
+      reportedUsage = usage;
+    },
+  };
+
+  const orchestrator = createChatOrchestrator(provider, PROMPT, registry, {hooks});
+  await orchestrator.processMessage(turnSession('run'));
+  return reportedUsage;
+};
+
+describe('afterModelResponse turn usage across tool rounds', () => {
+  it('reports the sum of every provider call when a turn runs two tool rounds', async () => {
+    const reported = await runTurnWithRounds([
+      toolCallRound('call-1', {inputTokens: 100, outputTokens: 10, totalTokens: 110}),
+      toolCallRound('call-2', {inputTokens: 200, outputTokens: 20, totalTokens: 220}),
+      finalAnswerRound('done', {inputTokens: 300, outputTokens: 30, totalTokens: 330}),
+    ]);
+
+    expect(reported).toEqual({inputTokens: 600, outputTokens: 60, totalTokens: 660});
+  });
+
+  it('sums only the rounds that reported usage and reports undefined when none did', async () => {
+    const partial = await runTurnWithRounds([
+      toolCallRound('call-1', {inputTokens: 7, outputTokens: 2, totalTokens: 9}),
+      toolCallRound('call-2'),
+      finalAnswerRound('done', {inputTokens: 5, outputTokens: 1, totalTokens: 6}),
+    ]);
+    const none = await runTurnWithRounds([finalAnswerRound('quiet')]);
+
+    expect({partial, none}).toEqual({
+      partial: {inputTokens: 12, outputTokens: 3, totalTokens: 15},
+      none: undefined,
+    });
+  });
+});