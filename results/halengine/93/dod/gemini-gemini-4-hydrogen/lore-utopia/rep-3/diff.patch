+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const runTurnWithRounds = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let callIndex = 0;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const chunks = rounds[callIndex++] ?? [];
+      for (const chunk of chunks) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'Looks up data.', inputSchema: {type: 'object'}}, async () => 'ok');
+  let reportedUsage: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reportedUsage = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Usage test.'}), registry, {
+    hooks,
+  });
+  const session: ChatSession = {
+    sessionId: 's-usage',
+    userId: 'u-usage',
+    entries: [{role: 'user', content: 'ask', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+
+  await orchestrator.processMessage(session);
+  return reportedUsage;
+};
+
+const toolRoundChunks = (id: string, usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id, name: 'lookup', input: {}}},
+  {type: 'stop', stopReason: 'tool_use', usage},
+];
+
+const finalRoundChunks = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'done'},
+  {type: 'stop', stopReason: 'end_turn', usage},
+];
+
+describe('ChatOrchestrator turn usage accounting', () => {
+  it('reports the sum of every provider call when a turn runs two tool rounds', async () => {
+    const reported = await runTurnWithRounds([
+      toolRoundChunks('c1', {inputTokens: 100, outputTokens: 10, totalTokens: 110}),
+      toolRoundChunks('c2', {inputTokens: 200, outputTokens: 20, totalTokens: 220}),
+      finalRoundChunks({inputTokens: 300, outputTokens: 30, totalTokens: 330}),
+    ]);
+
+    expect(reported).toEqual({inputTokens: 600, outputTokens: 60, totalTokens: 660});
+  });
+
+  it('counts reporting rounds when another reports none, and passes undefined when none did', async () => {
+    const partial = await runTurnWithRounds([
+      toolRoundChunks('c1', {inputTokens: 15, outputTokens: 5, totalTokens: 20}),
+      toolRoundChunks('c2'),
+      finalRoundChunks({inputTokens: 25, outputTokens: 10, totalTokens: 35}),
+    ]);
+    const silent = await runTurnWithRounds([toolRoundChunks('c1'), finalRoundChunks()]);
+
+    expect({partial, silent}).toEqual({
+      partial: {inputTokens: 40, outputTokens: 15, totalTokens: 55},
+      silent: undefined,
+    });
+  });
+});