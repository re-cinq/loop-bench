+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const runTurnWithRounds = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let callIndex = 0;
+  let reportedUsage: UsageMetadata | undefined;
+
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[callIndex++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Looks up an entry.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reportedUsage = usage;
+    },
+  };
+
+  const session: ChatSession = {
+    sessionId: 'accept-session',
+    userId: 'accept-user',
+    entries: [{role: 'user', content: 'run tools', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+
+  const orchestrator = createChatOrchestrator(
+    provider,
+    new PromptBuilder({identity: 'Acceptance assistant.'}),
+    registry,
+    {hooks}
+  );
+  await orchestrator.processMessage(session);
+  return reportedUsage;
+};
+
+describe('afterModelResponse usage reporting across tool rounds', () => {
+  it('reports the sum of all three provider calls when a turn runs two tool rounds', async () => {
+    const reported = await runTurnWithRounds([
+      [
+        {type: 'tool_use', toolCall: {id: 'c1', name: 'lookup', input: {}}},
+        {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 100, outputTokens: 10, totalTokens: 110}},
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'c2', name: 'lookup', input: {}}},
+        {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 200, outputTokens: 20, totalTokens: 220}},
+      ],
+      [
+        {type: 'text', text: 'all done'},
+        {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 300, outputTokens: 30, totalTokens: 330}},
+      ],
+    ]);
+
+    expect(reported).toEqual({inputTokens: 600, outputTokens: 60, totalTokens: 660});
+  });
+
+  it('counts reporting rounds when another round reports none, and reports undefined when none do', async () => {
+    const partial = await runTurnWithRounds([
+      [
+        {type: 'tool_use', toolCall: {id: 'c1', name: 'lookup', input: {}}},
+        {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 7, outputTokens: 2, totalTokens: 9}},
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'c2', name: 'lookup', input: {}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'text', text: 'finished'},
+        {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 5, outputTokens: 1, totalTokens: 6}},
+      ],
+    ]);
+
+    const none = await runTurnWithRounds([
+      [
+        {type: 'tool_use', toolCall: {id: 'c3', name: 'lookup', input: {}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'text', text: 'no usage'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ]);
+
+    expect({partial, none}).toEqual({
+      partial: {inputTokens: 12, outputTokens: 3, totalTokens: 15},
+      none: undefined,
+    });
+  });
+});