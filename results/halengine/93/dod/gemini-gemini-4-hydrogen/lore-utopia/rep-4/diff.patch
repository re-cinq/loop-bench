+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const FIXED_TIMESTAMP = '2026-01-01T00:00:00.000Z';
+
+describe('ChatOrchestrator usage across tool rounds', () => {
+  it('reports the sum of every provider call when a turn runs two tool rounds', async () => {
+    const reported = await captureHookUsage([
+      [
+        {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'first'}}},
+        {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 100, outputTokens: 10, totalTokens: 110}},
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'call-2', name: 'lookup', input: {q: 'second'}}},
+        {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 200, outputTokens: 20, totalTokens: 220}},
+      ],
+      [
+        {type: 'text', text: 'final answer'},
+        {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 300, outputTokens: 30, totalTokens: 330}},
+      ],
+    ]);
+
+    expect(reported).toEqual({inputTokens: 600, outputTokens: 60, totalTokens: 660});
+  });
+
+  it('counts every reporting round when some rounds omit usage, and passes undefined when none report', async () => {
+    const partial = await captureHookUsage([
+      [
+        {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'first'}}},
+        {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 7, outputTokens: 2, totalTokens: 9}},
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'call-2', name: 'lookup', input: {q: 'second'}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 5, outputTokens: 1, totalTokens: 6}},
+      ],
+    ]);
+    const unreported = await captureHookUsage([
+      [
+        {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'first'}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ]);
+
+    expect({partial, unreported}).toEqual({
+      partial: {inputTokens: 12, outputTokens: 3, totalTokens: 15},
+      unreported: undefined,
+    });
+  });
+});
+
+async function captureHookUsage(rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> {
+  let reportedUsage: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _responseText, usage) => {
+      reportedUsage = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(
+    createRoundProvider(rounds),
+    new PromptBuilder({identity: 'You are a test assistant.'}),
+    createLookupRegistry(),
+    {hooks}
+  );
+  const session: ChatSession = {
+    sessionId: 's-usage',
+    userId: 'u-usage',
+    entries: [{role: 'user', content: 'run tools', timestamp: FIXED_TIMESTAMP}],
+  };
+
+  await orchestrator.processMessage(session);
+  return reportedUsage;
+}
+
+function createRoundProvider(rounds: MessageChunk[][]): AIProvider {
+  let callIndex = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const chunks = rounds[callIndex] ?? [];
+      callIndex += 1;
+      for (const chunk of chunks) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+function createLookupRegistry(): ToolRegistry {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Looks up a value', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  return registry;
+}