+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+describe('afterModelResponse turn usage aggregation', () => {
+  it('sums usage across every provider call when a turn runs two tool rounds', async () => {
+    const reportedUsage = await runTurnWithRoundUsages([
+      {inputTokens: 100, outputTokens: 20, totalTokens: 120},
+      {inputTokens: 150, outputTokens: 30, totalTokens: 180},
+      {inputTokens: 200, outputTokens: 40, totalTokens: 240},
+    ]);
+
+    expect(reportedUsage).toEqual({inputTokens: 450, outputTokens: 90, totalTokens: 540});
+  });
+
+  it('counts rounds that reported usage when other rounds omit it, and passes undefined when none report', async () => {
+    const partial = await runTurnWithRoundUsages([
+      {inputTokens: 12, outputTokens: 4, totalTokens: 16},
+      undefined,
+      {inputTokens: 28, outputTokens: 9, totalTokens: 37},
+      undefined,
+    ]);
+    const omitted = await runTurnWithRoundUsages([undefined, undefined]);
+
+    expect({partial, omitted}).toEqual({
+      partial: {inputTokens: 40, outputTokens: 13, totalTokens: 53},
+      omitted: undefined,
+    });
+  });
+});
+
+async function runTurnWithRoundUsages(
+  roundUsages: Array<UsageMetadata | undefined>
+): Promise<UsageMetadata | undefined> {
+  let reportedUsage: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _responseText, usage) => {
+      reportedUsage = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(
+    createScriptedUsageProvider(roundUsages),
+    new PromptBuilder({identity: 'Usage test assistant.'}),
+    createLookupToolRegistry(),
+    {hooks}
+  );
+  const session: ChatSession = {
+    sessionId: 'usage-session',
+    userId: 'usage-user',
+    entries: [{role: 'user', content: 'run tools', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+
+  await orchestrator.processMessage(session);
+  return reportedUsage;
+}
+
+function createScriptedUsageProvider(roundUsages: Array<UsageMetadata | undefined>): AIProvider {
+  let callIndex = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const round = callIndex++;
+      const usage = roundUsages[round];
+      const isFinalRound = round >= roundUsages.length - 1;
+
+      if (isFinalRound) {
+        yield {type: 'text', text: 'final answer'};
+        yield {type: 'stop', stopReason: 'end_turn', usage};
+        return;
+      }
+
+      yield {type: 'tool_use', toolCall: {id: `tool-${round}`, name: 'lookup', input: {}}};
+      yield {type: 'stop', stopReason: 'tool_use', usage};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+function createLookupToolRegistry(): ToolRegistry {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'Looks up data.', inputSchema: {type: 'object'}}, async () => 'ok');
+  return registry;
+}