+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const FIXED_TIME = '2026-01-01T00:00:00.000Z';
+
+describe('afterModelResponse turn usage accumulation', () => {
+  it('sums usage across every provider call in a turn with two tool rounds', async () => {
+    const roundOneUsage: UsageMetadata = {inputTokens: 120, outputTokens: 18, totalTokens: 138};
+    const roundTwoUsage: UsageMetadata = {inputTokens: 245, outputTokens: 32, totalTokens: 277};
+    const roundThreeUsage: UsageMetadata = {inputTokens: 410, outputTokens: 55, totalTokens: 465};
+
+    const received = await runTurnWithRounds([
+      [
+        {type: 'tool_use', toolCall: {id: 'call-1', name: 'fetch_item', input: {term: 'alpha'}}},
+        {type: 'stop', stopReason: 'tool_use', usage: roundOneUsage},
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'call-2', name: 'fetch_item', input: {term: 'beta'}}},
+        {type: 'stop', stopReason: 'tool_use', usage: roundTwoUsage},
+      ],
+      [
+        {type: 'text', text: 'Final answer.'},
+        {type: 'stop', stopReason: 'end_turn', usage: roundThreeUsage},
+      ],
+    ]);
+
+    expect(received).toEqual({
+      inputTokens: 775,
+      outputTokens: 105,
+      totalTokens: 880,
+    });
+  });
+
+  it('sums only the rounds that reported usage and passes undefined when none did', async () => {
+    const partial = await runTurnWithRounds([
+      [
+        {type: 'tool_use', toolCall: {id: 'call-a', name: 'fetch_item', input: {term: 'one'}}},
+        {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 100, outputTokens: 15, totalTokens: 115}},
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'call-b', name: 'fetch_item', input: {term: 'two'}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'text', text: 'Done.'},
+        {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 300, outputTokens: 25, totalTokens: 325}},
+      ],
+    ]);
+
+    const silent = await runTurnWithRounds([
+      [
+        {type: 'tool_use', toolCall: {id: 'call-c', name: 'fetch_item', input: {term: 'three'}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'text', text: 'Still done.'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ]);
+
+    expect({partial, silent}).toEqual({
+      partial: {inputTokens: 400, outputTokens: 40, totalTokens: 440},
+      silent: undefined,
+    });
+  });
+});
+
+async function runTurnWithRounds(rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> {
+  let receivedUsage: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _responseText, usage) => {
+      receivedUsage = usage;
+    },
+  };
+  const provider = createRoundProvider(rounds);
+  const registry = createFetchItemRegistry();
+  const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+  const orchestrator = createChatOrchestrator(provider, promptBuilder, registry, {hooks});
+  const session: ChatSession = {
+    sessionId: 'usage-session',
+    userId: 'user-1',
+    entries: [{role: 'user', content: 'Fetch both items.', timestamp: FIXED_TIME}],
+  };
+
+  await orchestrator.processMessage(session);
+  return receivedUsage;
+}
+
+function createRoundProvider(rounds: MessageChunk[][]): AIProvider {
+  let index = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const roundChunks = rounds[index] ?? [];
+      index += 1;
+      for (const chunk of roundChunks) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+function createFetchItemRegistry(): ToolRegistry {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'fetch_item', description: 'Fetch item details', inputSchema: {type: 'object'}},
+    async input => `item:${String(input.term ?? '')}`
+  );
+  return registry;
+}