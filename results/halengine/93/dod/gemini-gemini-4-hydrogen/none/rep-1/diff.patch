+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const runToolTurn = async (roundUsages: Array<UsageMetadata | undefined>): Promise<UsageMetadata | undefined> => {
+  let reportedUsage: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reportedUsage = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(
+    scriptedUsageProvider(roundUsages),
+    new PromptBuilder({identity: 'Usage test.'}),
+    lookupRegistry(),
+    {hooks}
+  );
+  const session: ChatSession = {
+    sessionId: 's-usage',
+    userId: 'u-usage',
+    entries: [{role: 'user', content: 'run tools', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+
+  await orchestrator.processMessage(session);
+  return reportedUsage;
+};
+
+const scriptedUsageProvider = (roundUsages: Array<UsageMetadata | undefined>): AIProvider => {
+  let callIndex = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const round = callIndex++;
+      const usage = roundUsages[round];
+      const finalRound = round === roundUsages.length - 1;
+
+      if (finalRound) {
+        yield {type: 'text', text: 'done'};
+        yield {type: 'stop', stopReason: 'end_turn', usage};
+        return;
+      }
+
+      yield {type: 'tool_use', toolCall: {id: `call-${round}`, name: 'lookup', input: {}}};
+      yield {type: 'stop', stopReason: 'tool_use', usage};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const lookupRegistry = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Looks up a value.', inputSchema: {type: 'object'}},
+    async () => 'ok'
+  );
+  return registry;
+};
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('sums token usage across every provider call in a multi-round tool turn', async () => {
+    const reportedUsage = await runToolTurn([
+      {inputTokens: 100, outputTokens: 20, totalTokens: 120},
+      {inputTokens: 250, outputTokens: 30, totalTokens: 280},
+      {inputTokens: 400, outputTokens: 50, totalTokens: 450},
+    ]);
+
+    expect(reportedUsage).toMatchObject({inputTokens: 750, outputTokens: 100, totalTokens: 850});
+  });
+
+  it('counts reported rounds when some rounds omit usage and still reports undefined when none do', async () => {
+    const middleOmitted = await runToolTurn([
+      {inputTokens: 100, outputTokens: 20, totalTokens: 120},
+      undefined,
+      {inputTokens: 400, outputTokens: 50, totalTokens: 450},
+    ]);
+    const trailingOmitted = await runToolTurn([
+      {inputTokens: 100, outputTokens: 20, totalTokens: 120},
+      {inputTokens: 250, outputTokens: 30, totalTokens: 280},
+      undefined,
+    ]);
+    const silent = await runToolTurn([undefined, undefined]);
+
+    expect({
+      middleOmitted,
+      trailingOmitted,
+      silentIsUndefined: silent === undefined,
+    }).toMatchObject({
+      middleOmitted: {inputTokens: 500, outputTokens: 70, totalTokens: 570},
+      trailingOmitted: {inputTokens: 350, outputTokens: 50, totalTokens: 400},
+      silentIsUndefined: true,
+    });
+  });
+});