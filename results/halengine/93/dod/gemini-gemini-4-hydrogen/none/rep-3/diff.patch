+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {ToolRegistry} from './tools/registry.js';
+
+describe('afterModelResponse multi-round usage reporting', () => {
+  it('sums usage across every provider call in a multi-round tool turn', async () => {
+    const turn = await runWithUsageHook([
+      toolCallRound('call-1', {inputTokens: 100, outputTokens: 20, totalTokens: 120}),
+      toolCallRound('call-2', {inputTokens: 250, outputTokens: 35, totalTokens: 285}),
+      finalAnswerRound('All done.', {inputTokens: 400, outputTokens: 45, totalTokens: 445}),
+    ]);
+
+    expect(turn).toEqual({
+      called: true,
+      usage: {inputTokens: 750, outputTokens: 100, totalTokens: 850},
+    });
+  });
+
+  it('counts reported rounds when some omit usage, and reports undefined when none do', async () => {
+    const mixedTurn = await runWithUsageHook([
+      toolCallRound('call-1', {inputTokens: 12, outputTokens: 3, totalTokens: 15}),
+      toolCallRound('call-2'),
+      finalAnswerRound('Done.', {inputTokens: 30, outputTokens: 7, totalTokens: 37}),
+    ]);
+    const silentTurn = await runWithUsageHook([toolCallRound('call-3'), finalAnswerRound('Done.')]);
+
+    expect({mixedTurn, silentTurn}).toEqual({
+      mixedTurn: {called: true, usage: {inputTokens: 42, outputTokens: 10, totalTokens: 52}},
+      silentTurn: {called: true, usage: undefined},
+    });
+  });
+});
+
+async function runWithUsageHook(
+  rounds: MessageChunk[][]
+): Promise<{called: boolean; usage: UsageMetadata | undefined}> {
+  let called = false;
+  let capturedUsage: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      called = true;
+      capturedUsage = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(
+    createRoundProvider(rounds),
+    new PromptBuilder({identity: 'Usage test assistant.'}),
+    createLookupRegistry(),
+    {hooks}
+  );
+
+  await orchestrator.processMessage(createUserSession());
+  return {called, usage: capturedUsage};
+}
+
+function toolCallRound(callId: string, usage?: UsageMetadata): MessageChunk[] {
+  return [
+    {type: 'tool_use', toolCall: {id: callId, name: 'lookup', input: {id: callId}}},
+    {type: 'stop', stopReason: 'tool_use', usage},
+  ];
+}
+
+function finalAnswerRound(text: string, usage?: UsageMetadata): MessageChunk[] {
+  return [
+    {type: 'text', text},
+    {type: 'stop', stopReason: 'end_turn', usage},
+  ];
+}
+
+function createRoundProvider(rounds: MessageChunk[][]): AIProvider {
+  let callIndex = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const chunks = rounds[callIndex] ?? [];
+      callIndex += 1;
+      for (const chunk of chunks) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+function createLookupRegistry(): ToolRegistry {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Look up a record', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  return registry;
+}
+
+function createUserSession(): ChatSession {
+  return {
+    sessionId: 'usage-session',
+    userId: 'user-1',
+    entries: [{role: 'user', content: 'run lookup', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+}