+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const TIMESTAMP = '2026-01-01T00:00:00.000Z';
+
+describe('afterModelResponse usage reporting across tool rounds', () => {
+  it('sums token usage across every provider call in a turn with two tool rounds', async () => {
+    const reported = await runTurn([
+      [toolRequest('t1'), stopChunk('tool_use', {inputTokens: 100, outputTokens: 20, totalTokens: 120})],
+      [toolRequest('t2'), stopChunk('tool_use', {inputTokens: 250, outputTokens: 40, totalTokens: 290})],
+      [{type: 'text', text: 'all set'}, stopChunk('end_turn', {inputTokens: 400, outputTokens: 60, totalTokens: 460})],
+    ]);
+
+    expect(reported).toEqual({inputTokens: 750, outputTokens: 120, totalTokens: 870});
+  });
+
+  it('counts rounds that report usage when others omit it, and yields undefined when none report', async () => {
+    const partialUsage = await runTurn([
+      [toolRequest('t1'), stopChunk('tool_use', {inputTokens: 10, outputTokens: 2, totalTokens: 12})],
+      [toolRequest('t2'), stopChunk('tool_use')],
+      [{type: 'text', text: 'done'}, stopChunk('end_turn', {inputTokens: 30, outputTokens: 8, totalTokens: 38})],
+    ]);
+    const omittedUsage = await runTurn([
+      [toolRequest('t1'), stopChunk('tool_use')],
+      [{type: 'text', text: 'done'}, stopChunk('end_turn')],
+    ]);
+
+    expect({partialUsage, omittedUsage}).toEqual({
+      partialUsage: {inputTokens: 40, outputTokens: 10, totalTokens: 50},
+      omittedUsage: undefined,
+    });
+  });
+});
+
+async function runTurn(rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> {
+  let seen: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      seen = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(
+    scriptedProvider(rounds),
+    new PromptBuilder({identity: 'test'}),
+    lookupRegistry(),
+    {hooks}
+  );
+  const session: ChatSession = {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'check status', timestamp: TIMESTAMP}],
+  };
+
+  await orchestrator.processMessage(session);
+
+  return seen;
+}
+
+function scriptedProvider(rounds: MessageChunk[][]): AIProvider {
+  let roundIndex = 0;
+
+  return {
+    async *sendMessage() {
+      const chunks = rounds[roundIndex] ?? [];
+      roundIndex += 1;
+      yield* chunks;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+function lookupRegistry(): ToolRegistry {
+  const registry = new ToolRegistry();
+
+  registry.register({name: 'lookup', description: 'Looks up status', inputSchema: {type: 'object'}}, async () => 'ok');
+
+  return registry;
+}
+
+function toolRequest(id: string): MessageChunk {
+  return {type: 'tool_use', toolCall: {id, name: 'lookup', input: {}}};
+}
+
+function stopChunk(stopReason: 'tool_use' | 'end_turn', usage?: UsageMetadata): MessageChunk {
+  return usage ? {type: 'stop', stopReason, usage} : {type: 'stop', stopReason};
+}