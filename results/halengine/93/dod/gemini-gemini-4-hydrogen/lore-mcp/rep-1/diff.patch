+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// Acceptance tests for re-cinq/HALEngine#93: afterModelResponse must report usage summed across every round.
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('sums token usage across all provider calls in a turn with two tool rounds', async () => {
+    const reportedUsage = await runTurnWithRounds([
+      [
+        {type: 'tool_use', toolCall: {id: 'call-1', name: 'search', input: {term: 'one'}}},
+        {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 100, outputTokens: 20, totalTokens: 120}},
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'call-2', name: 'search', input: {term: 'two'}}},
+        {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 250, outputTokens: 35, totalTokens: 285}},
+      ],
+      [
+        {type: 'text', text: 'combined answer'},
+        {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 400, outputTokens: 50, totalTokens: 450}},
+      ],
+    ]);
+
+    expect(reportedUsage).toEqual({inputTokens: 750, outputTokens: 105, totalTokens: 855});
+  });
+
+  it('counts reported rounds when some omit usage and reports undefined when none report', async () => {
+    const partialTurnUsage = await runTurnWithRounds([
+      [
+        {type: 'tool_use', toolCall: {id: 'call-a', name: 'search', input: {term: 'a'}}},
+        {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 10, outputTokens: 5, totalTokens: 15}},
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'call-b', name: 'search', input: {term: 'b'}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 30, outputTokens: 8, totalTokens: 38}},
+      ],
+    ]);
+
+    const unreportedTurnUsage = await runTurnWithRounds([
+      [
+        {type: 'tool_use', toolCall: {id: 'call-c', name: 'search', input: {term: 'c'}}},
+        {type: 'stop', stopReason: 'tool_use'},
+      ],
+      [
+        {type: 'text', text: 'done without usage'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ]);
+
+    expect({partialTurnUsage, unreportedTurnUsage}).toEqual({
+      partialTurnUsage: {inputTokens: 40, outputTokens: 13, totalTokens: 53},
+      unreportedTurnUsage: undefined,
+    });
+  });
+});
+
+async function runTurnWithRounds(rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> {
+  let callIndex = 0;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const roundChunks = rounds[callIndex++] ?? [];
+      for (const chunk of roundChunks) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'search', description: 'Searches for entries.', inputSchema: {type: 'object'}},
+    async () => 'matched'
+  );
+
+  let capturedUsage: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _responseText, usage) => {
+      capturedUsage = usage;
+    },
+  };
+  const session: ChatSession = {
+    sessionId: 'session-usage-93',
+    userId: 'user-usage-93',
+    entries: [{role: 'user', content: 'find both', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Test assistant.'}), registry, {
+    hooks,
+  });
+
+  await orchestrator.processMessage(session);
+  return capturedUsage;
+}