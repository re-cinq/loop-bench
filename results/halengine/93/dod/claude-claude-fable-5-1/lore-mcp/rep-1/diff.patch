@@ -0,0 +1,78 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// Acceptance for re-cinq/HALEngine#93: afterModelResponse must report the usage of every provider call in the turn.
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+const askForTool = (usage?: UsageMetadata): MessageChunk[] => [
+  TOOL_CALL,
+  {type: 'stop', stopReason: 'tool_use', usage},
+];
+const answer = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'done'},
+  {type: 'stop', stopReason: 'end_turn', usage},
+];
+
+const lookupRegistry = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => 'r');
+  return registry;
+};
+
+// Drives one turn through the scripted rounds and returns what afterModelResponse was handed as usage.
+const usageReportedFor = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let call = 0;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[call++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reported = usage;
+    },
+  };
+  const session: ChatSession = {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'ask', timestamp: SENT_AT}],
+  };
+
+  await createChatOrchestrator(provider, promptBuilder, lookupRegistry(), {hooks}).processMessage(session);
+
+  return reported;
+};
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports the sum of three provider calls when a turn runs two tool rounds', async () => {
+    const reported = await usageReportedFor([
+      askForTool({inputTokens: 100, outputTokens: 10, totalTokens: 110}),
+      askForTool({inputTokens: 200, outputTokens: 20, totalTokens: 220}),
+      answer({inputTokens: 300, outputTokens: 30, totalTokens: 330}),
+    ]);
+
+    expect(reported).toEqual({inputTokens: 600, outputTokens: 60, totalTokens: 660});
+  });
+
+  it('counts the rounds that reported usage when one round reports none, and reports nothing when no round did', async () => {
+    const partial = await usageReportedFor([
+      askForTool({inputTokens: 7, outputTokens: 2, totalTokens: 9}),
+      askForTool(),
+      answer({inputTokens: 5, outputTokens: 1, totalTokens: 6}),
+    ]);
+    const none = await usageReportedFor([askForTool(), answer()]);
+
+    expect({partial, none}).toEqual({partial: {inputTokens: 12, outputTokens: 3, totalTokens: 15}, none: undefined});
+  });
+});
