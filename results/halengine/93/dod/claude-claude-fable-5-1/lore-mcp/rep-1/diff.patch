+describe('addUsage', () => {
+  const u1: UsageMetadata = {inputTokens: 100, outputTokens: 10, totalTokens: 110};
+  const u2: UsageMetadata = {inputTokens: 200, outputTokens: 20, totalTokens: 220};
+
+  it('sums two usage records field by field', () => {
+    expect(addUsage(u1, u2)).toEqual({inputTokens: 300, outputTokens: 30, totalTokens: 330});
+  });
+
+  it('returns the second when accumulator is undefined', () => {
+    expect(addUsage(undefined, u2)).toEqual(u2);
+  });
+
+  it('returns the accumulator when next is undefined', () => {
+    expect(addUsage(u1, undefined)).toEqual(u1);
+  });
+
+  it('returns undefined when both are undefined', () => {
+    expect(addUsage(undefined, undefined)).toBeUndefined();
+  });
+});
diff --git a/src/orchestration/orchestratorHelpers.ts b/src/orchestration/orchestratorHelpers.ts
index 717eb9a..544ebb5 100644
--- a/src/orchestration/orchestratorHelpers.ts
+++ b/src/orchestration/orchestratorHelpers.ts
@@ -40,3 +40,13 @@ export function extractStopReason(chunk: MessageChunk): string | null {
 export function extractUsage(chunk: MessageChunk): UsageMetadata | undefined {
   return chunk.type === 'stop' ? chunk.usage : undefined;
 }
+
+export function addUsage(acc: UsageMetadata | undefined, next: UsageMetadata | undefined): UsageMetadata | undefined {
+  if (!next) return acc;
+  if (!acc) return next;
+  return {
+    inputTokens: acc.inputTokens + next.inputTokens,
+    outputTokens: acc.outputTokens + next.outputTokens,
+    totalTokens: acc.totalTokens + next.totalTokens,
+  };
+}