diff --git a/packages/client/src/links/localLink.test.ts b/packages/client/src/links/localLink.test.ts
new file mode 100644
index 0000000000..a668b0e35b
--- /dev/null
+++ b/packages/client/src/links/localLink.test.ts
@@ -0,0 +1,135 @@
+import { EventEmitter, on } from 'node:events';
+import { initTRPC, tracked, TRPCError } from '@trpc/server';
+import { observable } from '@trpc/server/observable';
+import { z } from 'zod';
+import { createTRPCClient, localLink, TRPCClientError } from '../index';
+
+test('localLink executes query and mutation with context, transformer, and error handling', async () => {
+  const t = initTRPC.context<{ user: string }>().create({
+    transformer: {
+      serialize: (v: unknown) => v,
+      deserialize: (v: unknown) => v,
+    },
+  });
+
+  const router = t.router({
+    hello: t.procedure
+      .input(z.object({ name: z.string() }))
+      .query(({ ctx, input }) => {
+        return `hello ${input.name} from ${ctx.user}`;
+      }),
+    fail: t.procedure.mutation(() => {
+      throw new TRPCError({
+        code: 'BAD_REQUEST',
+        message: 'mutation failed',
+      });
+    }),
+  });
+
+  const onError = vi.fn();
+  const client = createTRPCClient<typeof router>({
+    links: [
+      localLink({
+        router,
+        createContext: async () => ({ user: 'admin' }),
+        transformer: {
+          serialize: (v: unknown) => v,
+          deserialize: (v: unknown) => v,
+        },
+        onError,
+      }),
+    ],
+  });
+
+  const res = await client.hello.query({ name: 'world' });
+  expect(res).toBe('hello world from admin');
+
+  await expect(client.fail.mutate()).rejects.toThrow(TRPCClientError);
+  await expect(client.fail.mutate()).rejects.toMatchObject({
+    message: 'mutation failed',
+  });
+  expect(onError).toHaveBeenCalled();
+});
+
+test('localLink handles async iterable and observable subscriptions with tracked envelopes and aborts on unsubscribe', async () => {
+  const ee = new EventEmitter();
+  let obsCleanedUp = false;
+  const t = initTRPC.create();
+
+  const router = t.router({
+    onTrackedMessage: t.procedure
+      .input(z.object({ prefix: z.string() }))
+      .subscription(async function* (opts) {
+        let id = 0;
+        for await (const [msg] of on(ee, 'message', {
+          signal: opts.signal,
+        })) {
+          id += 1;
+          yield tracked(String(id), `${opts.input.prefix}: ${String(msg)}`);
+        }
+      }),
+    onObservable: t.procedure.subscription(() => {
+      return observable<string>((emit) => {
+        emit.next('obs-1');
+        emit.next('obs-2');
+        return () => {
+          obsCleanedUp = true;
+        };
+      });
+    }),
+  });
+
+  const client = createTRPCClient<typeof router>({
+    links: [localLink({ router })],
+  });
+
+  const started = vi.fn();
+  const received: Array<{ id: string; data: string }> = [];
+  const sub = client.onTrackedMessage.subscribe(
+    { prefix: 'evt' },
+    {
+      onStarted: started,
+      onData(data) {
+        received.push(data);
+      },
+    },
+  );
+
+  await vi.waitFor(() => {
+    expect(ee.listenerCount('message')).toBe(1);
+  });
+  expect(started).toHaveBeenCalledTimes(1);
+
+  ee.emit('message', 'alpha');
+  ee.emit('message', 'beta');
+
+  await vi.waitFor(() => {
+    expect(received).toEqual([
+      { id: '1', data: 'evt: alpha' },
+      { id: '2', data: 'evt: beta' },
+    ]);
+  });
+
+  sub.unsubscribe();
+
+  await vi.waitFor(() => {
+    expect(ee.listenerCount('message')).toBe(0);
+  });
+
+  const obsReceived: string[] = [];
+  const obsSub = client.onObservable.subscribe(undefined, {
+    onData(data) {
+      obsReceived.push(data);
+    },
+  });
+
+  await vi.waitFor(() => {
+    expect(obsReceived).toEqual(['obs-1', 'obs-2']);
+  });
+
+  obsSub.unsubscribe();
+
+  await vi.waitFor(() => {
+    expect(obsCleanedUp).toBe(true);
+  });
+});
diff --git a/packages/client/src/links/localLink.ts b/packages/client/src/links/localLink.ts
new file mode 100644
index 0000000000..a0b0e55e63
--- /dev/null
+++ b/packages/client/src/links/localLink.ts
@@ -0,0 +1,209 @@
+import {
+  isObservable,
+  observable,
+  observableToAsyncIterable,
+} from '@trpc/server/observable';
+import type {
+  AnyRouter,
+  CreateContextCallback,
+  ErrorHandlerOptions,
+  inferClientTypes,
+  inferRouterContext,
+  MaybePromise,
+  TRPCResultMessage,
+} from '@trpc/server/unstable-core-do-not-import';
+import {
+  callProcedure,
+  getErrorShape,
+  getTRPCErrorFromUnknown,
+  isAsyncIterable,
+  isTrackedEnvelope,
+  run,
+  TRPCError,
+  Unpromise,
+} from '@trpc/server/unstable-core-do-not-import';
+import { raceAbortSignals } from '../internals/signals';
+import {
+  getTransformer,
+  type TransformerOptions,
+} from '../internals/transformer';
+import { TRPCClientError } from '../TRPCClientError';
+import type { TRPCLink } from './types';
+
+type LocalLinkOptions<TRouter extends AnyRouter> = {
+  router: TRouter;
+  /**
+   * Called when an error occurs in the handler
+   */
+  onError?: (opts: ErrorHandlerOptions<inferRouterContext<TRouter>>) => void;
+} & CreateContextCallback<
+  inferRouterContext<TRouter>,
+  () => MaybePromise<inferRouterContext<TRouter>>
+> &
+  TransformerOptions<inferClientTypes<TRouter>>;
+
+/**
+ * Create a link that runs the router in the same process as the client
+ */
+export function localLink<TRouter extends AnyRouter>(
+  opts: LocalLinkOptions<TRouter>,
+): TRPCLink<TRouter> {
+  const transformer = getTransformer(opts.transformer);
+  return () => {
+    return ({ op }) => {
+      return observable((observer) => {
+        const { type, path, input } = op;
+        const ac = new AbortController();
+        const signal = raceAbortSignals(op.signal, ac.signal);
+
+        let ctx: inferRouterContext<TRouter> | undefined = undefined;
+
+        run(async () => {
+          ctx =
+            (await opts.createContext?.()) ??
+            ({} as inferRouterContext<TRouter>);
+          const rawInput = transformer.input.serialize(input);
+
+          const result = await callProcedure({
+            router: opts.router,
+            path,
+            getRawInput: async () => rawInput,
+            ctx,
+            type,
+            signal,
+          });
+
+          if (type !== 'subscription') {
+            const transformed = transformer.output.deserialize(
+              opts.router._def._config.transformer.output.serialize(result),
+            );
+            observer.next({
+              result: {
+                type: 'data',
+                data: transformed,
+              },
+            });
+            observer.complete();
+            return;
+          }
+
+          if (!isAsyncIterable(result) && !isObservable(result)) {
+            throw new TRPCError({
+              message: `Subscription ${path} did not return an observable or a AsyncGenerator`,
+              code: 'INTERNAL_SERVER_ERROR',
+            });
+          }
+
+          if (signal.aborted) {
+            return;
+          }
+
+          const iterable = isObservable(result)
+            ? observableToAsyncIterable(result, signal)
+            : result;
+
+          observer.next({
+            result: {
+              type: 'started',
+            },
+          });
+
+          const abortPromise = new Promise<'abort'>((resolve) => {
+            if (signal.aborted) {
+              resolve('abort');
+            } else {
+              signal.addEventListener('abort', () => resolve('abort'), {
+                once: true,
+              });
+            }
+          });
+
+          const iterator = iterable[Symbol.asyncIterator]();
+          try {
+            while (true) {
+              const next = await Unpromise.race([
+                iterator.next().catch(getTRPCErrorFromUnknown),
+                abortPromise,
+              ]);
+
+              if (next === 'abort' || signal.aborted) {
+                break;
+              }
+              if (next instanceof Error) {
+                throw next;
+              }
+              if (next.done) {
+                break;
+              }
+
+              let data: unknown = next.value;
+              let resultId: string | undefined = undefined;
+              if (isTrackedEnvelope(next.value)) {
+                const [id, value] = next.value;
+                resultId = id;
+                data = {
+                  id,
+                  data: value,
+                };
+              }
+
+              const transformed = transformer.output.deserialize(
+                opts.router._def._config.transformer.output.serialize(data),
+              );
+              const resultEnvelope: TRPCResultMessage<unknown>['result'] = {
+                type: 'data',
+                data: transformed,
+              };
+              if (resultId !== undefined) {
+                resultEnvelope.id = resultId;
+              }
+              observer.next({
+                result: resultEnvelope,
+              });
+            }
+          } finally {
+            await iterator.return?.();
+          }
+
+          if (!signal.aborted) {
+            observer.next({
+              result: {
+                type: 'stopped',
+              },
+            });
+            observer.complete();
+          }
+        }).catch((cause) => {
+          const error = getTRPCErrorFromUnknown(cause);
+          opts.onError?.({
+            error,
+            type,
+            path,
+            input,
+            ctx,
+          });
+          const errorShape = getErrorShape({
+            config: opts.router._def._config,
+            error,
+            type,
+            path,
+            input,
+            ctx,
+          });
+          const transformedError = transformer.output.deserialize(
+            opts.router._def._config.transformer.output.serialize(errorShape),
+          );
+          observer.error(
+            TRPCClientError.from({
+              error: transformedError,
+            }),
+          );
+        });
+
+        return () => {
+          ac.abort();
+        };
+      });
+    };
+  };
+}
diff --git a/packages/tests/server/localLink.acceptance.test.ts b/packages/tests/server/localLink.acceptance.test.ts
