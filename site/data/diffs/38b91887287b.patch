+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const createTrackedSchema = (field: string): {schema: Record<string, unknown>; reads: () => number} => {
+  let propertyReads = 0;
+  const properties = {[field]: {type: 'string'}};
+  const schema: Record<string, unknown> = {
+    type: 'object',
+    get properties() {
+      propertyReads += 1;
+      return properties;
+    },
+    required: [field],
+  };
+  return {schema, reads: () => propertyReads};
+};
+
+describe('ToolRegistry', () => {
+  afterEach(() => {
+    setLogger(undefined);
+  });
+
+  it('throws at registration time for an uncompilable schema and names the tool', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'weather_forecast',
+          description: 'Get weather forecast for a city',
+          inputSchema: {
+            type: 'object',
+            properties: {city: {type: 'not-a-valid-type'}},
+          },
+        },
+        async () => 'sunny'
+      )
+    ).toThrow(/weather_forecast/);
+  });
+
+  it('compiles a static schema once across ten execute calls and caches function-valued schemas by reference', async () => {
+    const registry = new ToolRegistry();
+    let staticDefinitionSchemaReads = 0;
+    const staticTracked = createTrackedSchema('location');
+    const staticDefinition: ToolDefinition = {
+      name: 'static_weather',
+      description: 'Get weather for a location',
+      get inputSchema(): Record<string, unknown> {
+        staticDefinitionSchemaReads += 1;
+        return staticTracked.schema;
+      },
+    };
+
+    registry.register(staticDefinition, async () => 'sunny');
+    const staticReadsBeforeExecute = staticTracked.reads();
+    const compilationTrace: Record<string, number | boolean> = {
+      staticCompiledAtRegister: staticReadsBeforeExecute > 0,
+    };
+    for (let i = 0; i < 10; i += 1) {
+      await registry.execute('static_weather', {location: 'Paris'});
+    }
+    compilationTrace.staticRecompiledDuringExecute = staticTracked.reads() !== staticReadsBeforeExecute;
+
+    const dynamicTrackedA = createTrackedSchema('city');
+    let currentDynamicSchema = dynamicTrackedA.schema;
+    registry.register(
+      () => ({
+        name: 'dynamic_weather',
+        description: 'Get weather dynamically',
+        inputSchema: currentDynamicSchema,
+      }),
+      async () => 'cloudy'
+    );
+    compilationTrace.dynamicCompiledAtRegister = dynamicTrackedA.reads() > 0;
+
+    await registry.execute('dynamic_weather', {city: 'Paris'});
+    const dynamicAReadsAfterFirst = dynamicTrackedA.reads();
+    compilationTrace.dynamicACompiledOnFirstExecute = dynamicAReadsAfterFirst > 0;
+    await registry.execute('dynamic_weather', {city: 'Lyon'});
+    compilationTrace.dynamicARecompiledOnSecondExecute = dynamicTrackedA.reads() !== dynamicAReadsAfterFirst;
+
+    const dynamicTrackedB = createTrackedSchema('country');
+    currentDynamicSchema = dynamicTrackedB.schema;
+    await registry.execute('dynamic_weather', {country: 'France'});
+    const dynamicBReadsAfterFirst = dynamicTrackedB.reads();
+    compilationTrace.dynamicBCompiledOnFirstExecute = dynamicBReadsAfterFirst > 0;
+    await registry.execute('dynamic_weather', {country: 'Germany'});
+    compilationTrace.dynamicBRecompiledOnSecondExecute = dynamicTrackedB.reads() !== dynamicBReadsAfterFirst;
+    compilationTrace.staticDefinitionSchemaReads = staticDefinitionSchemaReads;
+
+    expect(compilationTrace).toEqual({
+      staticDefinitionSchemaReads: 1,
+      staticCompiledAtRegister: true,
+      staticRecompiledDuringExecute: false,
+      dynamicCompiledAtRegister: false,
+      dynamicACompiledOnFirstExecute: true,
+      dynamicARecompiledOnSecondExecute: false,
+      dynamicBCompiledOnFirstExecute: true,
+      dynamicBRecompiledOnSecondExecute: false,
+    });
+  });
+
+  it('rejects missing required fields and wrong-typed values without invoking the executor or leaking values', async () => {
+    const capturedLines: string[] = [];
+    const pushLog = (_category: string, message: string, logContext?: Record<string, unknown>) => {
+      capturedLines.push(`${message}:${JSON.stringify(logContext ?? {})}`);
+    };
+    setLogger({debug: pushLog, info: pushLog, warn: pushLog, error: pushLog});
+
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+            coordinates: {
+              type: 'object',
+              properties: {lat: {type: 'number'}},
+              required: ['lat'],
+            },
+          },
+          required: ['location'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'sunny';
+      }
+    );
+
+    const missingResponse = await registry.execute('get_weather', {coordinates: {}});
+    const wrongTypeResponse = await registry.execute('get_weather', {location: 987654321});
+
+    expect({
+      executorCalls,
+      missingNamesLocation: missingResponse.result.includes('location') && /required/i.test(missingResponse.result),
+      missingNamesNestedField: missingResponse.result.includes('coordinates.lat'),
+      wrongTypeNamesFieldAndType:
+        wrongTypeResponse.result.includes('location') && wrongTypeResponse.result.includes('string'),
+      leaksValueInResult: wrongTypeResponse.result.includes('987654321'),
+      leaksValueInLogs: capturedLines.some(line => line.includes('987654321')),
+    }).toEqual({
+      executorCalls: 0,
+      missingNamesLocation: true,
+      missingNamesNestedField: true,
+      wrongTypeNamesFieldAndType: true,
+      leaksValueInResult: false,
+      leaksValueInLogs: false,
+    });
+  });
+
+  it('passes valid input with undeclared extra properties through to the executor unchanged once', async () => {
+    const registry = new ToolRegistry();
+    const receivedInputs: Array<Record<string, unknown>> = [];
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+            units: {type: 'string', enum: ['celsius', 'fahrenheit'], default: 'celsius'},
+          },
+          required: ['location'],
+        },
+      },
+      async input => {
+        receivedInputs.push(input);
+        return 'sunny';
+      }
+    );
+
+    const response = await registry.execute('get_weather', {location: 'Berlin', extraTag: 'unlisted'});
+
+    expect({response, receivedInputs}).toEqual({
+      response: {result: 'sunny'},
+      receivedInputs: [{location: 'Berlin', extraTag: 'unlisted'}],
+    });
+  });
+
+  it('validates a function-valued tool definition against the schema returned on each execute call', async () => {
+    const registry = new ToolRegistry();
+    let currentRequiredField = 'city';
+    registry.register(
+      () => ({
+        name: 'lookup_place',
+        description: 'Look up a place',
+        inputSchema: {
+          type: 'object',
+          properties: {[currentRequiredField]: {type: 'string'}},
+          required: [currentRequiredField],
+        },
+      }),
+      async input => `found:${Object.keys(input).join(',')}`
+    );
+
+    const firstValid = await registry.execute('lookup_place', {city: 'Berlin'});
+    currentRequiredField = 'postalCode';
+    const staleRejected = await registry.execute('lookup_place', {city: 'Berlin'});
+    const updatedValid = await registry.execute('lookup_place', {postalCode: '10115'});
+
+    expect({
+      firstValid: firstValid.result,
+      staleRejectedMentionsPostalCode:
+        staleRejected.result.includes('postalCode') && /required/i.test(staleRejected.result),
+      updatedValid: updatedValid.result,
+    }).toEqual({
+      firstValid: 'found:city',
+      staleRejectedMentionsPostalCode: true,
+      updatedValid: 'found:postalCode',
+    });
+  });
+
+  it('throws Unknown tool when executing an unregistered tool name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('missing_tool', {})).rejects.toThrow('Unknown tool: missing_tool');
+  });
+
+  it('preserves structured ToolResponse fields and inspects registered tools', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'guided_tool',
+        description: 'Tool with instructions and examples',
+        inputSchema: {type: 'object', properties: {query: {type: 'string'}}},
+        promptInstructions: 'Use for guided queries.',
+        examplePrompts: ['Ask a guided question'],
+      },
+      async () => ({
+        result: 'structured-done',
+        clientMessages: [
+          {
+            type: 'entry_upsert',
+            index: 0,
+            entry: {role: 'assistant', content: 'card', timestamp: '2026-01-01T00:00:00.000Z', isStreaming: false},
+          },
+        ],
+        suppressAssistantResponse: true,
+      })
+    );
+    registry.register(
+      {
+        name: 'plain_tool',
+        description: 'Tool without instructions or examples',
+        inputSchema: {type: 'object'},
+      },
+      async () => 'plain-done'
+    );
+
+    const response = await registry.execute('guided_tool', {query: 'hi'});
+    const guidedTool = registry.get('guided_tool');
+    const definitions = registry.getDefinitions();
+
+    expect({
+      responseResult: response.result,
+      clientMessageTypes: response.clientMessages?.map(m => m.type),
+      suppressAssistantResponse: response.suppressAssistantResponse,
+      hasGuided: registry.has('guided_tool'),
+      hasMissing: registry.has('missing_tool'),
+      foundName: guidedTool?.definition.name,
+      missingTool: registry.get('missing_tool'),
+      definitionNames: definitions.map(d => d.name),
+      promptInstructions: registry.getPromptInstructions(),
+      examplePrompts: registry.getExamplePrompts(),
+    }).toEqual({
+      responseResult: 'structured-done',
+      clientMessageTypes: ['entry_upsert'],
+      suppressAssistantResponse: true,
+      hasGuided: true,
+      hasMissing: false,
+      foundName: 'guided_tool',
+      missingTool: undefined,
+      definitionNames: ['guided_tool', 'plain_tool'],
+      promptInstructions: ['guided_tool: Use for guided queries.'],
+      examplePrompts: ['Ask a guided question'],
+    });
+  });
+});
