+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolResponse} from './tools/registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+const STOP_FOR_TOOL: MessageChunk = {type: 'stop', stopReason: 'tool_use'};
+const STOP_DONE: MessageChunk = {type: 'stop', stopReason: 'end_turn'};
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryReturning = (response: ToolResponse): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => response
+  );
+  return registry;
+};
+
+const chunksFrom = async (stream: AsyncGenerator<MessageChunk>): Promise<MessageChunk[]> => {
+  const chunks: MessageChunk[] = [];
+  for await (const chunk of stream) chunks.push(chunk);
+  return chunks;
+};
+
+describe('Usage accumulation across tool rounds', () => {
+  it('accumulates usage from every tool round, not just the last', async () => {
+    const round1Usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const round2Usage: UsageMetadata = {inputTokens: 8, outputTokens: 3, totalTokens: 11};
+    let seenUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        seenUsage = usage;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: round1Usage}],
+        [{type: 'text', text: 'answer'}, {type: 'stop', stopReason: 'end_turn', usage: round2Usage}],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'found'}),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('question'));
+
+    expect(seenUsage).toEqual({
+      inputTokens: 18,
+      outputTokens: 8,
+      totalTokens: 26,
+    });
+  });
+
+  it('reports the single round usage unchanged when only one round runs', async () => {
+    const usage: UsageMetadata = {inputTokens: 7, outputTokens: 4, totalTokens: 11};
+    let seenUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, u) => {
+        seenUsage = u;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([[{type: 'text', text: 'answer'}, {type: 'stop', stopReason: 'end_turn', usage}]]),
+      promptBuilder,
+      registryReturning({result: 'x'}),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('hello'));
+
+    expect(seenUsage).toEqual(usage);
+  });
+
+  it('accumulates usage when some rounds report and others do not', async () => {
+    const round1Usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const round2Usage: UsageMetadata = {inputTokens: 8, outputTokens: 3, totalTokens: 11};
+    let seenUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        seenUsage = usage;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: round1Usage}],
+        [{type: 'text', text: 'done'}, {type: 'stop', stopReason: 'end_turn'}], // No usage
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}], // No usage
+        [{type: 'text', text: 'final'}, {type: 'stop', stopReason: 'end_turn', usage: round2Usage}],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'r'}),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('query'));
+
+    expect(seenUsage).toEqual({
+      inputTokens: 18,
+      outputTokens: 8,
+      totalTokens: 26,
+    });
+  });
+
+  it('reports undefined when no round reports usage', async () => {
+    let seenUsage: UsageMetadata | undefined = {inputTokens: 999, outputTokens: 999, totalTokens: 999};
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        seenUsage = usage;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}], // No usage
+        [{type: 'text', text: 'done'}, {type: 'stop', stopReason: 'end_turn'}], // No usage
+      ]),
+      promptBuilder,
+      registryReturning({result: 'r'}),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(seenUsage).toBeUndefined();
+  });
+
+  it('accumulates usage from three consecutive tool rounds', async () => {
+    const usage1: UsageMetadata = {inputTokens: 5, outputTokens: 2, totalTokens: 7};
+    const usage2: UsageMetadata = {inputTokens: 4, outputTokens: 1, totalTokens: 5};
+    const usage3: UsageMetadata = {inputTokens: 6, outputTokens: 3, totalTokens: 9};
+    let seenUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        seenUsage = usage;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usage1}],
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usage2}],
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usage3}],
+        [{type: 'text', text: 'final answer'}, {type: 'stop', stopReason: 'end_turn'}],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'ok'}),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('complex query'));
+
+    expect(seenUsage).toEqual({
+      inputTokens: 15,
+      outputTokens: 6,
+      totalTokens: 21,
+    });
+  });
+});