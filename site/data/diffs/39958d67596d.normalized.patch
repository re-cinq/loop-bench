+++ b/src/orchestration/usageAcrossToolRounds.acceptance.test.ts
@@ -0,0 +1,56 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ChatSession} from '../types/session.js';
+
+const usage = (inputTokens: number, outputTokens: number): UsageMetadata => ({
+  inputTokens,
+  outputTokens,
+  totalTokens: inputTokens + outputTokens,
+});
+
+it('reports usage from every provider call in a turn with two tool rounds', async () => {
+  const rounds: MessageChunk[][] = [
+    [
+      {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {}}},
+      {type: 'stop', stopReason: 'tool_use', usage: usage(10, 2)},
+    ],
+    [
+      {type: 'tool_use', toolCall: {id: 'call-2', name: 'lookup', input: {}}},
+      {type: 'stop', stopReason: 'tool_use', usage: usage(20, 3)},
+    ],
+    [
+      {type: 'text', text: 'done'},
+      {type: 'stop', stopReason: 'end_turn', usage: usage(30, 4)},
+    ],
+  ];
+  const provider: AIProvider = {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      yield* rounds.shift() ?? [];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const tools = new ToolRegistry();
+  tools.register({name: 'lookup', description: 'lookup', inputSchema: {type: 'object'}}, async () => 'found');
+  let receivedUsage: UsageMetadata | undefined;
+  const session: ChatSession = {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'question', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'assistant'}), tools, {
+    hooks: {
+      afterModelResponse: async (_session, _text, received) => {
+        receivedUsage = received;
+      },
+    },
+  });
+
+  await orchestrator.processMessage(session);
+
+  expect(receivedUsage).toEqual(usage(60, 9));
+});
