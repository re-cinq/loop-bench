+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+describe('onError for non-Error rejections', () => {
+  it.each([
+    ['a string', 'provider rejected'],
+    ['a plain object', {reason: 'provider rejected'}],
+    ['undefined', undefined],
+  ])(
+    'calls onError and preserves the caller rejection for %s (specs/hal-engine-config-hooks/spec.md#9)',
+    async (_label, rejection) => {
+      const onErrorValues: Error[] = [];
+      const hooks: OrchestratorHooks = {
+        onError: async (_session, error) => {
+          onErrorValues.push(error);
+        },
+      };
+      const provider: AIProvider = {
+        // eslint-disable-next-line require-yield
+        async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+          throw rejection;
+        },
+        async generateStructured<T>(): Promise<T> {
+          return {} as T;
+        },
+      };
+      const orchestrator = createChatOrchestrator(
+        provider,
+        new PromptBuilder({identity: 'Acceptance test.'}),
+        undefined,
+        {
+          hooks,
+        }
+      );
+      const session: ChatSession = {
+        sessionId: 's1',
+        userId: 'u1',
+        entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+      };
+      const callerRejection = await orchestrator.processMessage(session).then(
+        () => Symbol('resolved'),
+        value => value
+      );
+
+      expect(callerRejection).toBe(rejection);
+      expect(onErrorValues).toHaveLength(1);
+      expect(onErrorValues[0]).toBeInstanceOf(Error);
+      expect(onErrorValues[0].cause).toBe(rejection);
+    }
+  );
+});
