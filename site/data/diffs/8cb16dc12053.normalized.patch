+
+describe('list_sessions handler dispatch', () => {
+  it('reports an explicitly unsupported conversation list instead of presenting an empty history', async () => {
+    const sent: OutgoingMessage[] = [];
+    const ws = {send: (raw: string) => sent.push(JSON.parse(raw) as OutgoingMessage)} as unknown as WebSocket;
+    const session: ChatSession = {sessionId: 'active', userId: 'u1', entries: []};
+    const sessionStore = {listFor: () => Promise.reject(new StoreCannotList())} as unknown as SessionStore;
+
