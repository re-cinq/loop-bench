+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const RESOLVED = Symbol('resolved');
+
+const createSession = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+});
+
+const rejectingProvider = (rejection: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    throw rejection;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+it('calls onError for every non-Error rejection and preserves the caller rejection', async () => {
+  const rejections = ['provider said no', {code: 'PROVIDER_REJECTED'}, undefined];
+  const observed = [] as Array<{rejection: unknown; calls: number; error?: Error; callerValue: unknown}>;
+
+  for (const rejection of rejections) {
+    let calls = 0;
+    let error: Error | undefined;
+    const orchestrator = createChatOrchestrator(
+      rejectingProvider(rejection),
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      undefined,
+      {
+        hooks: {
+          onError: async (_session, receivedError) => {
+            calls += 1;
+            error = receivedError;
+          },
+        },
+      }
+    );
+
+    const callerValue = await orchestrator.processMessage(createSession()).then(
+      () => RESOLVED,
+      value => value
+    );
+    observed.push({rejection, calls, error, callerValue});
+  }
+
+  expect(observed).toHaveLength(rejections.length);
+  for (const {rejection, calls, error, callerValue} of observed) {
+    expect(calls).toBe(1);
+    expect(error).toBeInstanceOf(Error);
+    expect(error?.cause).toBe(rejection);
+    expect(callerValue).toBe(rejection);
+  }
+});
