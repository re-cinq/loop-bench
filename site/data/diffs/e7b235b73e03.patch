+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+
+// @spec specs/hal-engine-config-hooks/spec.md#13
+it('includes the tool-request usage in the completed turn total', async () => {
+  const rounds: MessageChunk[][] = [
+    [
+      {type: 'tool_use', toolCall: {id: 'lookup', name: 'lookup', input: {}}},
+      {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 4, outputTokens: 2, totalTokens: 6}},
+    ],
+    [{type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 9, outputTokens: 3, totalTokens: 12}}],
+  ];
+  const provider: AIProvider = {
+    async *sendMessage() {
+      yield* rounds.shift() ?? [];
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured generation is outside this provider contract.');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Look up a value', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  let reported: UsageMetadata | undefined;
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Usage contract'}), registry, {
+    hooks: {
+      afterModelResponse: async (_session, _text, totalUsage) => {
+        reported = totalUsage;
+      },
+    },
+  });
+
+  await orchestrator.processMessage({sessionId: 'usage-contract', userId: 'user', entries: []});
+
+  expect(reported).toEqual({inputTokens: 13, outputTokens: 5, totalTokens: 18});
+});
