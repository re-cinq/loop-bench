+import {ToolRegistry} from './registry.js';
+
+// @spec specs/hal-engine-tool-input-validation/spec.md#1
+describe('ToolRegistry input validation', () => {
+  it('rejects a missing required tool input before executor invocation', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Gets a forecast',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'forecast';
+      }
+    );
+
+    const response = await registry.execute('weather', {});
+
+    expect(response.result).toMatch(/location.*required/i);
+    expect(executorCalls).toBe(0);
+  });
+});