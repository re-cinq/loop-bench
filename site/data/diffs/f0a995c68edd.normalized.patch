+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolResponse} from './tools/registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+// scriptedProvider executes one round per sendMessage call, yielding chunks from the provided array
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryReturning = (response: ToolResponse): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => response
+  );
+  return registry;
+};
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+
+describe('Acceptance: accumulated usage across tool rounds', () => {
+  it('reports usage covering every provider call when a turn runs multiple tool rounds', async () => {
+    // Round 1: tool call with usage
+    const round1Usage: UsageMetadata = {inputTokens: 100, outputTokens: 50, totalTokens: 150};
+    // Round 2: final answer with different usage
+    const round2Usage: UsageMetadata = {inputTokens: 200, outputTokens: 75, totalTokens: 275};
+
+    let receivedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const provider = scriptedProvider([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: round1Usage}],
+      [
+        {type: 'text', text: 'the answer'},
+        {type: 'stop', stopReason: 'end_turn', usage: round2Usage},
+      ],
+    ]);
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registryReturning({result: 'found it'}), {
+      hooks,
+    });
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    // The usage passed to afterModelResponse should cover both rounds, not just the last one.
+    // The accumulated usage should be: inputTokens: 300, outputTokens: 125, totalTokens: 425
+    expect(receivedUsage).toBeDefined();
+    expect(receivedUsage?.inputTokens).toBe(300);
+    expect(receivedUsage?.outputTokens).toBe(125);
+    expect(receivedUsage?.totalTokens).toBe(425);
+  });
+
+  it('reports unmodified usage for a turn with no tool calls', async () => {
+    const usage: UsageMetadata = {inputTokens: 50, outputTokens: 25, totalTokens: 75};
+    let receivedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, u) => {
+        receivedUsage = u;
+      },
+    };
+
+    const provider = scriptedProvider([
+      [
+        {type: 'text', text: 'direct answer'},
+        {type: 'stop', stopReason: 'end_turn', usage},
+      ],
+    ]);
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    // For a turn with no tool calls, the usage should be exactly what was reported
+    expect(receivedUsage).toEqual(usage);
+  });
+
+  it('accumulates usage when some rounds report none', async () => {
+    const round1Usage: UsageMetadata = {inputTokens: 100, outputTokens: 50, totalTokens: 150};
+    // Round 2 reports no usage
+    const round2Usage: UsageMetadata | undefined = undefined;
+
+    let receivedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const provider = scriptedProvider([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: round1Usage}],
+      [
+        {type: 'text', text: 'the answer'},
+        {type: 'stop', stopReason: 'end_turn', usage: round2Usage},
+      ],
+    ]);
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registryReturning({result: 'found it'}), {
+      hooks,
+    });
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    // When round 2 reports no usage, the accumulated usage should include round 1's reported values
+    // Result should be: {inputTokens: 100, outputTokens: 50, totalTokens: 150}
+    expect(receivedUsage).toEqual(round1Usage);
+    expect(Number.isNaN(receivedUsage?.inputTokens ?? NaN)).toBe(false);
+    expect(Number.isNaN(receivedUsage?.outputTokens ?? NaN)).toBe(false);
+    expect(Number.isNaN(receivedUsage?.totalTokens ?? NaN)).toBe(false);
+  });
+});
