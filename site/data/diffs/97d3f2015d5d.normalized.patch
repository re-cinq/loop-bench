+++ b/src/orchestration/usageAccumulator.test.ts
@@ -0,0 +1,35 @@
+import {accumulateUsage} from './usageAccumulator.js';
+import type {UsageMetadata} from '../types/ai.js';
+
+describe('accumulateUsage', () => {
+  it('sums token counts from two usage records', () => {
+    const accumulated: UsageMetadata = {inputTokens: 11, outputTokens: 2, totalTokens: 13};
+    const next: UsageMetadata = {inputTokens: 23, outputTokens: 3, totalTokens: 26};
+
+    const result = accumulateUsage(accumulated, next);
+
+    expect(result).toEqual({inputTokens: 34, outputTokens: 5, totalTokens: 39});
+  });
+
+  it('returns next when accumulated is undefined', () => {
+    const next: UsageMetadata = {inputTokens: 23, outputTokens: 3, totalTokens: 26};
+
+    const result = accumulateUsage(undefined, next);
+
+    expect(result).toEqual(next);
+  });
+
+  it('returns accumulated when next is undefined', () => {
+    const accumulated: UsageMetadata = {inputTokens: 11, outputTokens: 2, totalTokens: 13};
+
+    const result = accumulateUsage(accumulated, undefined);
+
+    expect(result).toEqual(accumulated);
+  });
+
+  it('returns undefined when both are undefined', () => {
+    const result = accumulateUsage(undefined, undefined);
+
+    expect(result).toBeUndefined();
+  });
+});
diff --git a/src/orchestration/usageAccumulator.ts b/src/orchestration/usageAccumulator.ts
new file mode 100644
index 0000000..02a3bdc
--- /dev/null
+++ b/src/orchestration/usageAccumulator.ts
@@ -0,0 +1,15 @@
+import type {UsageMetadata} from '../types/ai.js';
+
+export function accumulateUsage(
+  accumulated: UsageMetadata | undefined,
+  next: UsageMetadata | undefined
+): UsageMetadata | undefined {
+  if (accumulated === undefined) return next;
+  if (next === undefined) return accumulated;
+
+  return {
+    inputTokens: accumulated.inputTokens + next.inputTokens,
+    outputTokens: accumulated.outputTokens + next.outputTokens,
+    totalTokens: accumulated.totalTokens + next.totalTokens,
+  };
+}
