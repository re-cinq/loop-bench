 export function extractUsage(chunk: MessageChunk): UsageMetadata | undefined {
   return chunk.type === 'stop' ? chunk.usage : undefined;
 }
+
+export function accumulateUsage(
+  previous: UsageMetadata | undefined,
+  current: UsageMetadata | undefined
+): UsageMetadata | undefined {
+  if (!previous) return current;
+  if (!current) return previous;
+  return {
+    inputTokens: previous.inputTokens + current.inputTokens,
+    outputTokens: previous.outputTokens + current.outputTokens,
+    totalTokens: previous.totalTokens + current.totalTokens,
+  };
+}
