@@ -0,0 +1,14 @@
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+
+// One scripted round per sendMessage call, to drive the tool loop round by round.
+export const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
diff --git a/src/orchestration/turn-usage.acceptance.test.ts b/src/orchestration/turn-usage.acceptance.test.ts
new file mode 100644
index 0000000..7007408
--- /dev/null
+++ b/src/orchestration/turn-usage.acceptance.test.ts
@@ -0,0 +1,63 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {MessageChunk, TurnUsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {scriptedProvider} from './scriptedProviderTestSupport.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const registryReturning = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found it',
+  }));
+  return registry;
+};
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {}}};
+
+async function runWithRounds(rounds: MessageChunk[][]): Promise<TurnUsageMetadata | undefined> {
+  let captured: TurnUsageMetadata | undefined;
+  const orchestrator = createChatOrchestrator(scriptedProvider(rounds), promptBuilder, registryReturning(), {
+    hooks: {afterModelResponse: async (_session, _text, usage) => void (captured = usage)},
+  });
+  await orchestrator.processMessage(createSession('ask'));
+  return captured;
+}
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+}
+
+describe('Turn Usage Reporting', () => {
+  it('reports usage covering every provider call in a multi-round turn', async () => {
+    const usage = await runWithRounds([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 10, outputTokens: 2, totalTokens: 12}}],
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 15, outputTokens: 5, totalTokens: 20}}],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 20, outputTokens: 10, totalTokens: 30}},
+      ],
+    ]);
+
+    expect(usage).toEqual({inputTokens: 45, outputTokens: 17, totalTokens: 62});
+  });
+
+  it('accumulates usage safely when some rounds report no usage', async () => {
+    const usage = await runWithRounds([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 10, outputTokens: 2, totalTokens: 12}}],
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}], // No usage this round
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 5, outputTokens: 5, totalTokens: 10}},
+      ],
+    ]);
+
+    expect(usage).toEqual({inputTokens: 15, outputTokens: 7, totalTokens: 22});
+  });
+});
