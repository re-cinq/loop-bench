+import {jest} from '@jest/globals';
+import {ToolRegistry, __TEST_SUPPORT__} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+import Ajv from 'ajv';
+
+describe('ToolRegistry', () => {
+  const weatherTool: ToolDefinition = {
+    name: 'get_weather',
+    description: 'Get weather',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        location: {type: 'string'},
+      },
+      required: ['location'],
+    },
+  };
+
+  it('throws at registration time naming the tool for an uncompilable schema', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_lookup',
+          description: 'Tool with an invalid JSON Schema type',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              query: {type: 'not-a-json-schema-type'},
+            },
+          },
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken_lookup/);
+  });
+
+  it('validates input and returns ToolResponse on failure without calling executor', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(weatherTool, async () => {
+      calls++;
+      return 'OK';
+    });
+
+    const response = await registry.execute('get_weather', {});
+    expect(response.result).toMatch(/(must|should) have required property 'location'/);
+    expect(calls).toBe(0);
+  });
+
+  it('passes through extra properties unchanged', async () => {
+    const registry = new ToolRegistry();
+    let capturedInput: any;
+    registry.register(weatherTool, async input => {
+      capturedInput = input;
+      return 'OK';
+    });
+
+    await registry.execute('get_weather', {location: 'Paris', extra: 'stuff'});
+    expect(capturedInput).toEqual({location: 'Paris', extra: 'stuff'});
+  });
+
+  it('rejects wrong-typed fields with path and type but no value', async () => {
+    const registry = new ToolRegistry();
+    registry.register(weatherTool, async () => 'OK');
+
+    const response = await registry.execute('get_weather', {location: 123});
+    expect(response.result).toMatch(/(must|should) be string at \/location/);
+    expect(response.result).not.toContain('123');
+  });
+
+  it('throws Unknown tool for unregistered name', async () => {
+    const registry = new ToolRegistry();
+    await expect(registry.execute('unknown', {})).rejects.toThrow('Unknown tool: unknown');
+  });
+
+  it('validates function-valued tools against current schema', async () => {
+    const registry = new ToolRegistry();
+    let schema: any = {type: 'object', properties: {a: {type: 'string'}}, required: ['a']};
+    registry.register(
+      () => ({...weatherTool, inputSchema: schema}),
+      async () => 'OK'
+    );
+
+    // First call with schema A
+    const res1 = await registry.execute('get_weather', {a: 'val'});
+    expect(res1.result).toBe('OK');
+
+    // Change schema to B
+    schema = {type: 'object', properties: {b: {type: 'number'}}, required: ['b']};
+    const res2 = await registry.execute('get_weather', {a: 'val'});
+    expect(res2.result).toMatch(/(must|should) have required property 'b'/);
+
+    const res3 = await registry.execute('get_weather', {b: 42});
+    expect(res3.result).toBe('OK');
+  });
+
+  it('does not echo identifying data in rejection message', async () => {
+    const registry = new ToolRegistry();
+    registry.register(weatherTool, async () => 'OK');
+
+    const secret = 'SSN-123-456';
+    const response = await registry.execute('get_weather', {location: 123, secret});
+    expect(response.result).not.toContain(secret);
+  });
+
+  it('compiles a static tool schema exactly once across multiple executions', async () => {
+    const registry = new ToolRegistry();
+    const ajv = __TEST_SUPPORT__.getAjv();
+    const spy = jest.spyOn(ajv, 'compile');
+
+    try {
+      registry.register(weatherTool, async () => 'OK');
+      const initialCompileCount = spy.mock.calls.length;
+
+      for (let i = 0; i < 10; i++) {
+        await registry.execute('get_weather', {location: 'Paris'});
+      }
+
+      // It should have been compiled once during register, and 0 more times during execute
+      expect(spy.mock.calls.length).toBe(initialCompileCount);
+    } finally {
+      spy.mockRestore();
+    }
+  });
+});
