+
+    expect({response, executorInputs}).toEqual({
+      response: {result: 'sunny'},
+      executorInputs: [input],
+    });
+  });
+
+  it('validates a function-valued definition against the schema returned for each call', async () => {
+    const registry = new ToolRegistry();
+    let requiredField = 'location';
+    const executorInputs: Array<Record<string, unknown>> = [];
+
+    registry.register(
+      () => ({
+        name: 'dynamic_weather',
+        description: 'Get weather with a dynamic schema',
+        inputSchema: {
+          type: 'object',
+          properties: {[requiredField]: {type: 'string'}},
+          required: [requiredField],
+        },
+      }),
+      async input => {
+        executorInputs.push(input);
+        return 'sunny';
+      }
+    );
+
+    const firstResponse = await registry.execute('dynamic_weather', {location: 'Paris'});
+    requiredField = 'city';
