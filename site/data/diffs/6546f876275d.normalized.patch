+    expect({
+      namesField: response.result.includes('unit'),
+      namesConstraint: response.result.includes('enum'),
+      omitsOffendingValue: !response.result.includes('kelvin'),
+    }).toEqual({
+      namesField: true,
+      namesConstraint: true,
+      omitsOffendingValue: true,
+    });
+  });
+
+  it('throws the unchanged error for an unregistered tool', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('missing_weather', {})).rejects.toThrow('Unknown tool: missing_weather');
+  });
+
+  it('names the tool when a null static schema cannot be compiled', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'invalid_weather',
+          description: 'Invalid weather schema',
+          inputSchema: null as unknown as Record<string, unknown>,
+        },
+        async () => 'sunny'
+      )
+    ).toThrow('Invalid inputSchema for tool invalid_weather');
+  });
+});
