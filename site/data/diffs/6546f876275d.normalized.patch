+    expect({firstResponse, secondResponse, executorInputs}).toEqual({
+      firstResponse: {result: 'sunny'},
+      secondResponse: {result: 'sunny'},
+      executorInputs: [{location: 'Paris'}, {city: 'Berlin'}],
+    });
+  });
+
+  it('names the complete path for a nested required property', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'nested_weather',
+        description: 'Get weather with nested location data',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {
+              type: 'object',
+              properties: {city: {type: 'string'}},
+              required: ['city'],
+            },
+          },
+          required: ['location'],
+        },
+      },
+      async () => 'sunny'
+    );
+
+    const response = await registry.execute('nested_weather', {location: {}});
+
+    expect(response.result).toMatch(/location\.city is required/);
+  });
+
+  it('names the field path for a wrong-typed property', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'typed_weather',
+        description: 'Get typed weather',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async () => 'sunny'
+    );
+
+    const response = await registry.execute('typed_weather', {location: 42});
+
+    expect({
+      namesField: response.result.includes('location'),
+      namesExpectedType: response.result.includes('string'),
+      omitsOffendingValue: !response.result.includes('42'),
+    }).toEqual({
+      namesField: true,
+      namesExpectedType: true,
+      omitsOffendingValue: true,
+    });
+  });
+
+  it('names enum as the failed constraint without echoing the rejected value', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'enum_weather',
+        description: 'Get weather with a supported unit',
+        inputSchema: {
+          type: 'object',
+          properties: {unit: {type: 'string', enum: ['celsius', 'fahrenheit']}},
+          required: ['unit'],
+        },
+      },
+      async () => 'sunny'
+    );
+
+    const response = await registry.execute('enum_weather', {unit: 'kelvin'});
