+
+const mockLogger = {
+  info: jest.fn(),
+  warn: jest.fn(),
+  error: jest.fn(),
+  debug: jest.fn(),
+};
+
+beforeEach(() => {
+  setLogger(mockLogger as unknown as Logger);
+  mockLogger.error.mockClear();
+});
+
+afterAll(() => {
+  setLogger(undefined);
+});
+
+const harness = (sessionStore?: SessionStore, history?: {enabled: boolean}) => {
+  const sent: OutgoingMessage[] = [];
+  const ws = {
+    send: (msg: string) => sent.push(JSON.parse(msg)),
+    readyState: WebSocket.OPEN,
+  } as unknown as WebSocket;
+
+  const orchestrator = {} as unknown as ChatOrchestrator;
+  const session: ChatSession = {sessionId: 's1', userId: 'u1', entries: []};
+
+  const handle = createMessageHandler(orchestrator, sessionStore, history);
+
+  return {
+    session,
+    sent,
+    send: (raw: unknown) => handle(ws, session, raw),
+    expectUnsupported: () => {
+      expect(sent).toEqual([
+        {
+          type: 'error',
+          code: ErrorCodes.UNSUPPORTED,
+          message: expect.any(String),
+        },
+      ]);
+    },
+  };
+};
+
+describe('list_sessions handling', () => {
+  it('answers UNSUPPORTED when history is disabled', async () => {
+    const h = harness(undefined, {enabled: false});
+
+    await h.send({type: 'list_sessions'});
+
+    h.expectUnsupported();
+  });
+
+  it('answers session_list when history is enabled and store supports it', async () => {
+    const sessions = [
+      {
+        sessionId: 's1',
+        createdAt: new Date('2026-01-01T00:00:00Z'),
+        updatedAt: new Date('2026-01-02T00:00:00Z'),
+        entryCount: 5,
+      },
+    ];
+    const sessionStore = {
+      listFor: jest.fn<NonNullable<SessionStore['listFor']>>().mockResolvedValue(sessions),
+    } as unknown as SessionStore;
+
+    const h = harness(sessionStore, {enabled: true});
+
+    await h.send({type: 'list_sessions', limit: 10});
+
+    expect(h.sent).toEqual([
+      {
+        type: 'session_list',
+        sessions: [
+          {
+            sessionId: 's1',
+            createdAt: '2026-01-01T00:00:00.000Z',
+            updatedAt: '2026-01-02T00:00:00.000Z',
+            entryCount: 5,
+          },
+        ],
+      },
+    ]);
+  });
+
+  it('forwards limit and before to listFor', async () => {
+    const sessionStore = {
+      listFor: jest.fn<NonNullable<SessionStore['listFor']>>().mockResolvedValue([]),
+    } as unknown as SessionStore;
+
+    const h = harness(sessionStore, {enabled: true});
+
+    await h.send({type: 'list_sessions', limit: 10, before: {updatedAt: '2026-01-01T00:00:00Z', sessionId: 's1'}});
+
+    expect(sessionStore.listFor).toHaveBeenCalledWith('u1', {
+      limit: 10,
+      before: {updatedAt: '2026-01-01T00:00:00Z', sessionId: 's1'},
+    });
+  });
+
+  it('answers SERVER_ERROR and logs when listFor fails', async () => {
+    const sessionStore = {
+      listFor: jest.fn<NonNullable<SessionStore['listFor']>>().mockRejectedValue(new Error('db down')),
+    } as unknown as SessionStore;
+
+    const h = harness(sessionStore, {enabled: true});
+
+    await h.send({type: 'list_sessions'});
+
+    const {calls} = mockLogger.error.mock;
+    const errorLogged = calls;
+    expect({
+      sent: h.sent,
+      errorLogged,
+    }).toMatchObject({
+      sent: [
+        {
+          type: 'error',
+          code: ErrorCodes.SERVER_ERROR,
+          message: expect.any(String),
