+import {validateMessage} from './validation.js';
+
+describe('list_sessions validation', () => {
+  it('accepts a valid list_sessions message', () => {
+    const payload = {type: 'list_sessions'};
+    const result = validateMessage(payload);
+    expect(result).toEqual({
+      valid: true,
+      data: {type: 'list_sessions'},
+    });
+  });
+
+  it('accepts list_sessions with limit and before', () => {
+    const payload = {
+      type: 'list_sessions',
+      limit: 10,
+      before: {
+        sessionId: 's1',
+        updatedAt: '2026-01-01T00:00:00Z',
+      },
+    };
+    const result = validateMessage(payload);
+    expect(result).toEqual({
+      valid: true,
+      data: payload,
+    });
+  });
+
+  it('rejects non-integer limit', () => {
+    const result = validateMessage({type: 'list_sessions', limit: 1.5});
+    expect(result).toEqual({valid: false, error: 'limit must be a non-negative integer'});
+  });
+
+  it('rejects negative limit', () => {
+    const result = validateMessage({type: 'list_sessions', limit: -1});
+    expect(result).toEqual({valid: false, error: 'limit must be a non-negative integer'});
+  });
+
+  it('rejects malformed before.sessionId', () => {
+    const result = validateMessage({
+      type: 'list_sessions',
+      before: {sessionId: '', updatedAt: '2026-01-01T00:00:00Z'},
+    });
+    expect(result).toMatchObject({
+      valid: false,
+      error: expect.stringContaining('before.sessionId'),
+    });
+  });
+
+  it('rejects malformed before.updatedAt', () => {
+    const result = validateMessage({
+      type: 'list_sessions',
+      before: {sessionId: 's1', updatedAt: 'not-a-date'},
+    });
+    expect(result).toMatchObject({
+      valid: false,
+      error: expect.stringContaining('before.updatedAt'),
+    });
+  });
+
+  it('strips unknown fields like userId', () => {
+    const result = validateMessage({
+      type: 'list_sessions',
+      userId: 'u2',
+    });
