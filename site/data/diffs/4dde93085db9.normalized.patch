+  it('answers an empty session_list when listFor is missing', async () => {
+    const sessionStore = {} as unknown as SessionStore;
+
+    const h = harness(sessionStore, {enabled: true});
+
+    await h.send({type: 'list_sessions'});
+
+    expect(h.sent).toEqual([
+      {
+        type: 'session_list',
+        sessions: [],
+      },
+    ]);
+  });
+
+  it('answers UNSUPPORTED when listFor throws StoreCannotList', async () => {
+    const sessionStore = {
+      listFor: jest
+        .fn<NonNullable<SessionStore['listFor']>>()
+        .mockRejectedValue(new StoreCannotList('mongo collection missing')),
+    } as unknown as SessionStore;
+
+    const h = harness(sessionStore, {enabled: true});
+
+    await h.send({type: 'list_sessions'});
+
+    h.expectUnsupported();
+  });
+});
