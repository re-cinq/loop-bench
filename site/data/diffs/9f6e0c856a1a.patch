+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const session = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'ask', timestamp: SENT_AT}],
+});
+
+// A provider call that asks for the `lookup` tool, reporting the given usage.
+const toolRound = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}},
+  {type: 'stop', stopReason: 'tool_use', usage},
+];
+
+// A provider call that answers the user and ends the turn, reporting the given usage.
+const finalRound = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'done'},
+  {type: 'stop', stopReason: 'end_turn', usage},
+];
+
+// Each call to sendMessage plays the next scripted round, so the test controls every provider call's usage.
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let call = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[call++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const lookupRegistry = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  return registry;
+};
+
+// Runs one user message through the real orchestrator and returns the usage the afterModelResponse hook received.
+const usageHandedToHook = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let received: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      received = usage;
+    },
+  };
+
+  const orchestrator = createChatOrchestrator(
+    scriptedProvider(rounds),
+    new PromptBuilder({identity: 'Acceptance test.'}),
+    lookupRegistry(),
+    {hooks}
+  );
+  await orchestrator.processMessage(session());
+
+  return received;
+};
+
+describe('usage reported to afterModelResponse across tool rounds', () => {
+  it('reports usage covering every provider call in a turn driven through two tool rounds', async () => {
+    const received = await usageHandedToHook([
+      toolRound({inputTokens: 10, outputTokens: 4, totalTokens: 14}),
+      toolRound({inputTokens: 30, outputTokens: 6, totalTokens: 36}),
+      finalRound({inputTokens: 50, outputTokens: 8, totalTokens: 58}),
+    ]);
+
+    expect(received).toEqual({inputTokens: 90, outputTokens: 18, totalTokens: 108});
+  });
+
+  it('still counts the rounds that reported when a middle round reports no usage', async () => {
+    const received = await usageHandedToHook([
+      toolRound({inputTokens: 5, outputTokens: 2, totalTokens: 7}),
+      toolRound(),
+      finalRound({inputTokens: 3, outputTokens: 1, totalTokens: 4}),
+    ]);
+
+    expect(received).toEqual({inputTokens: 8, outputTokens: 3, totalTokens: 11});
+  });
+});