+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// Each provider call reports its own usage; the hook must receive what the whole turn consumed, not the last call.
+
+const toolRound = (id: string, usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id, name: 'lookup', input: {}}},
+  {type: 'stop', stopReason: 'tool_use', usage},
+];
+const finalRound = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'Done.'},
+  {type: 'stop', stopReason: 'end_turn', usage},
+];
+
+const FIRST: UsageMetadata = {inputTokens: 100, outputTokens: 20, totalTokens: 120};
+const SECOND: UsageMetadata = {inputTokens: 300, outputTokens: 50, totalTokens: 350};
+const THIRD: UsageMetadata = {inputTokens: 700, outputTokens: 80, totalTokens: 780};
+
+// One script entry per provider call, so each round reports exactly the usage it was given.
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let call = 0;
+  return {
+    async *sendMessage() {
+      yield* rounds[call++];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+// Runs one turn through the real orchestrator and returns the usage its afterModelResponse hook received.
+const usageReportedForTurn = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let seen: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _responseText, usage) => {
+      seen = usage;
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Looks something up.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  const orchestrator = createChatOrchestrator(
+    scriptedProvider(rounds),
+    new PromptBuilder({identity: 'Usage test.'}),
+    registry,
+    {hooks}
+  );
+  const session: ChatSession = {
+    sessionId: 's',
+    userId: 'u',
+    entries: [{role: 'user', content: 'go', timestamp: 't'}],
+  };
+
+  await orchestrator.processMessage(session);
+  return seen;
+};
+
+describe('usage across tool rounds', () => {
+  it('reports the sum of every provider call in a turn that ran two tool rounds', async () => {
+    const seen = await usageReportedForTurn([toolRound('c1', FIRST), toolRound('c2', SECOND), finalRound(THIRD)]);
+
+    expect(seen).toEqual({inputTokens: 1100, outputTokens: 150, totalTokens: 1250});
+  });
+
+  it('sums only the rounds that reported usage, and reports nothing when no round did', async () => {
+    const partial = await usageReportedForTurn([toolRound('c1', FIRST), toolRound('c2'), finalRound(THIRD)]);
+    const none = await usageReportedForTurn([toolRound('c1'), toolRound('c2'), finalRound()]);
+
+    expect(partial).toEqual({inputTokens: 800, outputTokens: 100, totalTokens: 900});
+    expect(none).toBeUndefined();
+  });
+});