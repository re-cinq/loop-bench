+
+describe('ChatOrchestrator beforeSession failure', () => {
+  it('calls onError then afterSession and skips the rest of the turn when beforeSession throws', async () => {
+    const callOrder: string[] = [];
+    const session = createSession('hello');
+    let errorObservation: {sameSession: boolean; message: string} | undefined;
+
+    const hooks: OrchestratorHooks = {
+      ...recordingHooks(callOrder, [
+        'beforeUserInput',
+        'afterUserInput',
+        'beforeModelResponse',
+        'afterModelResponse',
+        'afterSession',
+      ]),
+      beforeSession: async () => {
+        callOrder.push('beforeSession');
+        throw new Error('setup failed');
+      },
+      onError: async (seenSession, error) => {
+        callOrder.push('onError');
+        errorObservation = {sameSession: seenSession === session, message: error.message};
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createMockProvider('hi'), promptBuilder, undefined, {hooks});
+    const outcome = await outcomeOf(orchestrator.processMessage(session));
+
+    expect({outcome, callOrder, errorObservation}).toEqual({
+      outcome: 'setup failed',
+      callOrder: ['beforeSession', 'onError', 'afterSession'],
+      errorObservation: {sameSession: true, message: 'setup failed'},
+    });
+  });
+});
