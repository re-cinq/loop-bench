 // All three conditions matter; dropping the registry check spins the tool loop.
 
@@ -24,3 +24,24 @@ describe('shouldContinueToolLoop', () => {
     expect(shouldContinueToolLoop('end_turn', A_TOOL, REGISTRY)).toBe(false);
   });
 });
+
+describe('sumUsage', () => {
+  const FIRST: UsageMetadata = {inputTokens: 3, outputTokens: 1, totalTokens: 4};
+  const SECOND: UsageMetadata = {inputTokens: 5, outputTokens: 2, totalTokens: 7};
+
+  it('adds each token field of two reporting rounds', () => {
+    expect(sumUsage(FIRST, SECOND)).toEqual({inputTokens: 8, outputTokens: 3, totalTokens: 11});
+  });
+
+  it('keeps the reporting round when only the earlier total reported', () => {
+    expect(sumUsage(FIRST, undefined)).toEqual(FIRST);
+  });
+
+  it('keeps the reporting round when only the new round reported', () => {
+    expect(sumUsage(undefined, SECOND)).toEqual(SECOND);
+  });
+
+  it('stays undefined when no round reported', () => {
+    expect(sumUsage(undefined, undefined)).toBeUndefined();
+  });
+});
diff --git a/src/orchestration/orchestratorHelpers.ts b/src/orchestration/orchestratorHelpers.ts
index 717eb9a..1960531 100644
--- a/src/orchestration/orchestratorHelpers.ts
+++ b/src/orchestration/orchestratorHelpers.ts
@@ -40,3 +40,17 @@ export function extractStopReason(chunk: MessageChunk): string | null {
 export function extractUsage(chunk: MessageChunk): UsageMetadata | undefined {
   return chunk.type === 'stop' ? chunk.usage : undefined;
 }
+
+// A round that reported nothing adds nothing; two silent rounds stay undefined.
+export function sumUsage(
+  total: UsageMetadata | undefined,
+  round: UsageMetadata | undefined
+): UsageMetadata | undefined {
+  if (!total) return round;
+  if (!round) return total;
+  return {
+    inputTokens: total.inputTokens + round.inputTokens,
+    outputTokens: total.outputTokens + round.outputTokens,
+    totalTokens: total.totalTokens + round.totalTokens,
+  };
+}