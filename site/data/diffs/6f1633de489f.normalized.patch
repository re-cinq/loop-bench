+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const session: ChatSession = {
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('onError for non-Error provider rejections [specs/hal-engine-config-hooks/spec.md#9]', () => {
+  it.each([
+    ['string', 'provider failed'],
+    ['plain object', {code: 'PROVIDER_FAILED'}],
+    ['undefined', undefined],
+  ])('calls onError with a wrapped %s and rethrows the original value', async (_label, rejection) => {
+    const receivedByHook: Error[] = [];
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        receivedByHook.push(error);
+      },
+    };
+    const provider: AIProvider = {
+      async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        throw rejection;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+    let callerRejection: unknown;
+
+    try {
+      await orchestrator.processMessage(session);
+    } catch (error) {
+      callerRejection = error;
+    }
+
+    expect(receivedByHook).toHaveLength(1);
+    expect(receivedByHook[0]).toBeInstanceOf(Error);
+    expect(receivedByHook[0].cause).toBe(rejection);
+    expect(callerRejection).toBe(rejection);
+  });
+});
