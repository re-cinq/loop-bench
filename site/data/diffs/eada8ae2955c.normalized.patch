+import {createMockProvider} from '../providers/mock/mockProvider.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {ChatSession} from '../types/session.js';
+
+const session: ChatSession = {
+  sessionId: 's-before-session-failure',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+// spec: specs/hal-engine-config-hooks#7
+describe('beforeSession failure lifecycle', () => {
+  it('propagates the failure, calls onError, and still calls afterSession', async () => {
+    const failure = new Error('beforeSession failed');
+    const events: Array<{name: string; session?: ChatSession; error?: Error}> = [];
+    const hooks = {
+      beforeSession: async () => {
+        throw failure;
+      },
+      onError: async (receivedSession: ChatSession, error: Error) => {
+        events.push({name: 'onError', session: receivedSession, error});
+      },
+      afterSession: async (receivedSession: ChatSession) => {
+        events.push({name: 'afterSession', session: receivedSession});
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      createMockProvider(),
+      new PromptBuilder({identity: 'test'}),
+      undefined,
+      {hooks}
+    );
+
+    await expect(orchestrator.processMessage(session)).rejects.toBe(failure);
+
+    expect(events).toEqual([
+      {name: 'onError', session, error: failure},
+      {name: 'afterSession', session},
+    ]);
+  });
+});
