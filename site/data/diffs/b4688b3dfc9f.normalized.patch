+import {describe, it, expect, afterEach} from '@jest/globals';
+import {WebSocket} from 'ws';
+import {startEngineWith, connectClient, cleanup, delegatingTo} from './wsTestSupport.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import {SessionStore, StoreCannotList} from '../types/sessionStore.js';
+import type {HalServer} from './createServer.js';
+
+describe('history opt-in', () => {
+  const clients: WebSocket[] = [];
+  const servers: HalServer[] = [];
+
+  afterEach(async () => {
+    await cleanup(clients, servers);
+  });
+
+  async function getListResponse(
+    config: Parameters<typeof startEngineWith>[0],
+    outbound: Record<string, unknown> = {type: 'list_sessions'}
+  ): Promise<Record<string, unknown>> {
+    const {url, hal} = await startEngineWith(config);
+    servers.push(hal);
+
+    const client = connectClient(url);
+    clients.push(client);
+
+    return new Promise<Record<string, unknown>>(resolve => {
+      client.on('message', raw => {
+        const f = JSON.parse(String(raw)) as Record<string, unknown>;
+        if (f.type === 'connected') {
+          client.send(JSON.stringify(outbound));
+          return;
+        }
+        if (f.type !== 'pong') {
+          resolve(f);
+        }
+      });
+    });
+  }
+
+  it('answers UNSUPPORTED when history is not enabled', async () => {
+    const store = new InMemorySessionStore();
+    const frame = await getListResponse({
+      sessionStore: delegatingTo(store),
+    });
+
+    expect(frame).toEqual({
+      type: 'error',
+      code: 'UNSUPPORTED',
+      message: 'History is not supported',
+    });
+  });
+
+  it('answers UNSUPPORTED when history is enabled but store does not support listing', async () => {
+    const store = new InMemorySessionStore();
+    const frame = await getListResponse({
+      sessionStore: delegatingTo(store), // delegatingTo strips listFor
+      history: {enabled: true},
+    });
+
+    expect(frame).toEqual({
+      type: 'error',
+      code: 'UNSUPPORTED',
+      message: 'History is not supported',
+    });
+  });
+
+  it('answers UNSUPPORTED when store throws StoreCannotList', async () => {
+    const inner = new InMemorySessionStore();
+    const store = {
+      ...delegatingTo(inner),
+      listFor: () => Promise.reject(new StoreCannotList('mongo collection has no find')),
+    };
+    const frame = await getListResponse({
+      sessionStore: store as unknown as SessionStore, // Cast because we are intentionally creating a slightly incompatible store for testing
+      history: {enabled: true},
+    });
+
+    expect(frame).toEqual({
+      type: 'error',
+      code: 'UNSUPPORTED',
+      message: 'History is not supported by the store',
+    });
+  });
+
+  it('answers session_list when history is enabled and store supports listing', async () => {
+    const store = new InMemorySessionStore();
+    const frame = await getListResponse({
+      sessionStore: store,
+      history: {enabled: true},
+    });
+
+    expect(frame).toEqual({
+      type: 'session_list',
+      sessions: [
+        expect.objectContaining({
+          sessionId: expect.any(String),
+          createdAt: expect.any(String),
+          updatedAt: expect.any(String),
+          entryCount: 0,
+        }),
+      ],
+    });
+  });
+});
