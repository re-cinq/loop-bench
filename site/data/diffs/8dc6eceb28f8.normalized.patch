@@ -0,0 +1,80 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import {scriptedProvider} from './orchestratorTestSupport.js';
+
+// Issue #93: afterModelResponse is handed the usage of every provider call in the turn, not the last round's alone.
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const createSession = (content: string): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content, timestamp: SENT_AT}],
+});
+
+const lookupRegistry = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found it',
+  }));
+  return registry;
+};
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+
+const toolRound = (usage?: UsageMetadata): MessageChunk[] => [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage}];
+
+const finalRound = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'done'},
+  {type: 'stop', stopReason: 'end_turn', usage},
+];
+
+// Drives one turn through the real orchestrator and returns the usage afterModelResponse was handed.
+async function usageReportedFor(rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> {
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reported = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(scriptedProvider(rounds), promptBuilder, lookupRegistry(), {hooks});
+
+  await orchestrator.processMessage(createSession('ask'));
+
+  return reported;
+}
+
+describe('afterModelResponse usage across tool rounds (#93)', () => {
+  // Validates specs/hal-engine-config-hooks/spec.md#8
+  it('reports the usage of every provider call in a turn that ran two tool rounds, not only the last', async () => {
+    const reported = await usageReportedFor([
+      toolRound({inputTokens: 100, outputTokens: 10, totalTokens: 110}),
+      toolRound({inputTokens: 200, outputTokens: 20, totalTokens: 220}),
+      finalRound({inputTokens: 300, outputTokens: 30, totalTokens: 330}),
+    ]);
+
+    expect(reported).toEqual({inputTokens: 600, outputTokens: 60, totalTokens: 660});
+  });
+
+  // Validates specs/hal-engine-config-hooks/spec.md#9
+  it('counts the rounds that reported usage when others reported none, and reports nothing when no round did', async () => {
+    const partlyReported = await usageReportedFor([
+      toolRound({inputTokens: 11, outputTokens: 3, totalTokens: 14}),
+      toolRound(),
+      finalRound({inputTokens: 5, outputTokens: 2, totalTokens: 7}),
+    ]);
+    const silent = await usageReportedFor([toolRound(), finalRound()]);
+
+    expect({partlyReported, silent}).toEqual({
+      partlyReported: {inputTokens: 16, outputTokens: 5, totalTokens: 21},
+      silent: undefined,
+    });
+  });
+});
