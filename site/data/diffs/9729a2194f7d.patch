+    await orchestrator.processMessage(createSession('ask'));
+
+    const toolResults = receivedMessages.filter(
+      m => m.role === 'user' && Array.isArray(m.content) && m.content.some(c => c.type === 'tool_result')
+    );
+    const firstResult = toolResults[0];
+    const contentArr = firstResult?.content;
+    const resultChunk = Array.isArray(contentArr) ? contentArr.find(c => c.type === 'tool_result') : undefined;
+    const rejectionText = resultChunk && 'content' in resultChunk ? String(resultChunk.content) : '';
+    expect({
+      hasToolResult: toolResults.length > 0,
+      containsValidation: rejectionText.includes('Validation failed'),
+      text: rejectionText,
+    }).toEqual({hasToolResult: true, containsValidation: true, text: expect.any(String)});
+  });
