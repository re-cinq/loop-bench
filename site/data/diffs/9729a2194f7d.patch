+import {describe, it, expect} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry input validation', () => {
+  it('passes valid input with an unlisted extra property through to the executor unchanged', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    let executorInput: Record<string, unknown> | undefined;
+
+    registry.register(
+      {
+        name: 'test_tool',
+        description: 'Test',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            req: {type: 'string'},
+          },
+          required: ['req'],
+        },
+      },
+      async input => {
+        executorCalls++;
+        executorInput = input;
+        return 'ok';
+      }
+    );
+
+    await registry.execute('test_tool', {req: 'value', extra: 123});
+
+    expect({executorCalls, executorInput}).toEqual({
+      executorCalls: 1,
+      executorInput: {req: 'value', extra: 123},
+    });
+  });
+
+  it('rejects input missing a required property with a ToolResponse and never calls the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+
+    registry.register(
+      {
+        name: 'test_tool',
+        description: 'Test',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            req: {type: 'string'},
+          },
+          required: ['req'],
+        },
+      },
+      async () => {
+        executorCalls++;
+        return 'ok';
+      }
+    );
+
+    const response = await registry.execute('test_tool', {});
+
+    expect({
+      executorCalls,
+      mentionsReq: response.result.includes('req'),
+      mentionsRequired: /required/i.test(response.result),
+    }).toEqual({
+      executorCalls: 0,
+      mentionsReq: true,
+      mentionsRequired: true,
+    });
+  });
+
+  it('throws Unknown tool: <name> for an unregistered name', async () => {
+    const registry = new ToolRegistry();
+    await expect(registry.execute('nonexistent', {})).rejects.toThrow('Unknown tool: nonexistent');
+  });
+
+  it('rejects a wrong-typed field naming the field path and expected type without the offending value', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {name: 'test_tool', description: 'Test', inputSchema: {type: 'object', properties: {prop: {type: 'string'}}}},
+      async () => 'ok'
+    );
+    const response = await registry.execute('test_tool', {prop: 123456789});
+    expect({
+      containsProp: response.result.includes('prop'),
+      containsString: response.result.includes('string'),
+      containsValue: response.result.includes('123456789'),
+    }).toEqual({containsProp: true, containsString: true, containsValue: false});
+  });
+
+  it('compiles a static tools schema once across multiple execute calls', async () => {
+    const registry = new ToolRegistry();
+    registry.register({name: 'test_tool', description: 'Test', inputSchema: {type: 'object'}}, async () => 'ok');
+    let successCount = 0;
+    for (let i = 0; i < 10; i++) {
+      const r = await registry.execute('test_tool', {});
+      if (r.result === 'ok') successCount++;
+    }
+    expect(successCount).toBe(10);
+  });
+
+  it('validates function-valued tool definitions against the schema current at that call', async () => {
+    const registry = new ToolRegistry();
+    let schemaToReturn: Record<string, unknown> = {type: 'object', properties: {a: {type: 'string'}}, required: ['a']};
+    registry.register(
+      () => ({name: 'test_tool', description: 'Test', inputSchema: schemaToReturn}),
+      async () => 'ok'
+    );
+    const res1 = await registry.execute('test_tool', {a: 'val'});
+    schemaToReturn = {type: 'object', properties: {b: {type: 'number'}}, required: ['b']};
+    const res2 = await registry.execute('test_tool', {a: 'val'});
+    expect({
+      res1Result: res1.result,
+      res2ContainsValidation: res2.result.includes('Validation failed'),
+      res2ContainsB: res2.result.includes('b'),
+    }).toEqual({res1Result: 'ok', res2ContainsValidation: true, res2ContainsB: true});
+  });
+});
