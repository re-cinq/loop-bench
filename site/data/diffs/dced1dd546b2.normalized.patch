+import {jest} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+import Ajv from 'ajv';
+
+describe('ToolRegistry', () => {
+  it('throws at register time naming the tool when a static inputSchema cannot be compiled', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_tool',
+          description: 'Has an invalid JSON Schema type',
+          inputSchema: {
+            type: 'object',
+            properties: {location: {type: 'not-a-json-schema-type'}},
+          },
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken_tool/);
+  });
+
+  it('validates input against the resolved definition schema before calling the executor', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(
+      {
+        name: 'test_tool',
+        description: 'A test tool',
+        inputSchema: {
+          type: 'object',
+          properties: {requiredField: {type: 'string'}},
+          required: ['requiredField'],
+        },
+      },
+      async () => {
+        calls += 1;
+        return 'ok';
+      }
+    );
+
+    const response = await registry.execute('test_tool', {});
+
+    expect({
+      calls,
+      result: response.result,
+    }).toEqual({
+      calls: 0,
+      result: expect.stringMatching(/required.*requiredField/i),
+    });
