@@ -0,0 +1,93 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const promptBuilder = new PromptBuilder({identity: 'Usage test.'});
+const session: ChatSession = {
+  sessionId: 'usage-session',
+  userId: 'usage-user',
+  entries: [{role: 'user', content: 'Use the tools.', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+const provider = (rounds: MessageChunk[][]): AIProvider => {
+  let index = 0;
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield* rounds[index++] ?? [];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const reportedUsageForToolRounds = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reported = usage;
+    },
+  };
+  const tools = new ToolRegistry();
+  tools.register({name: 'lookup', description: 'Lookup.', inputSchema: {type: 'object'}}, async () => 'found');
+  await createChatOrchestrator(provider(rounds), promptBuilder, tools, {hooks}).processMessage(session);
+  return reported;
+};
+
+const unreportedToolRound = (id: string): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id, name: 'lookup', input: {}}},
+  {type: 'stop', stopReason: 'tool_use'},
+];
+
+describe('afterModelResponse usage', () => {
+  it('reports provider usage accumulated across tool rounds', async () => {
+    const toolCall = (id: string): MessageChunk => ({
+      type: 'tool_use',
+      toolCall: {id, name: 'lookup', input: {}},
+    });
+    const usage = (inputTokens: number, outputTokens: number): MessageChunk => ({
+      type: 'stop',
+      stopReason: 'tool_use',
+      usage: {inputTokens, outputTokens, totalTokens: inputTokens + outputTokens},
+    });
+    const reported = await reportedUsageForToolRounds([
+      [toolCall('first'), usage(11, 2)],
+      [toolCall('second'), usage(23, 3)],
+      [
+        {type: 'text', text: 'Done.'},
+        {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 37, outputTokens: 5, totalTokens: 42}},
+      ],
+    ]);
+
+    expect(reported).toEqual({inputTokens: 71, outputTokens: 10, totalTokens: 81});
+  });
+
+  // spec: specs/hal-engine-config-hooks/spec.md#13
+  it('ignores rounds without usage when summing reported rounds', async () => {
+    const reported = await reportedUsageForToolRounds([
+      unreportedToolRound('first'),
+      [
+        {type: 'text', text: 'Done.'},
+        {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 7, outputTokens: 4, totalTokens: 11}},
+      ],
+    ]);
+
+    expect(reported).toEqual({inputTokens: 7, outputTokens: 4, totalTokens: 11});
+  });
+
+  // spec: specs/hal-engine-config-hooks/spec.md#13
+  it('leaves usage undefined when no provider round reports it', async () => {
+    const reported = await reportedUsageForToolRounds([
+      unreportedToolRound('first'),
+      [
+        {type: 'text', text: 'Done.'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ]);
+
+    expect(reported).toBeUndefined();
+  });
+});
