+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+
+describe('turn usage contract [spec: specs/hal-engine-config-hooks/spec.md#12]', () => {
+  it('includes both provider calls when the second tool request exhausts the budget', async () => {
+    const rounds: MessageChunk[][] = [
+      [
+        {type: 'tool_use', toolCall: {id: 'first', name: 'lookup', input: {}}},
+        {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 3, outputTokens: 2, totalTokens: 5}},
+      ],
+      [
+        {type: 'tool_use', toolCall: {id: 'second', name: 'lookup', input: {}}},
+        {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 7, outputTokens: 4, totalTokens: 11}},
+      ],
+    ];
+    const provider: AIProvider = {
+      async *sendMessage() {
+        yield* rounds.shift() ?? [];
+      },
+      async generateStructured<T>(): Promise<T> {
+        throw new Error('Structured output is outside this contract');
+      },
+    };
+    const registry = new ToolRegistry();
+    registry.register({name: 'lookup', description: 'Lookup', inputSchema: {type: 'object'}}, async () => 'found');
+    let reported: UsageMetadata | undefined;
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Usage contract'}), registry, {
+      maxToolRounds: 1,
+      hooks: {
+        afterModelResponse: async (_session, _text, usage) => {
+          reported = usage;
+        },
+      },
+    });
+
+    await orchestrator.processMessage({sessionId: 'usage', userId: 'user', entries: []});
+
+    expect(reported).toEqual({inputTokens: 10, outputTokens: 6, totalTokens: 16});
+  });
+});
