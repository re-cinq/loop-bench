+import {accumulateUsage} from './turnUsage.js';
+import type {UsageMetadata} from '../types/ai.js';
+
+describe('turn usage [spec: specs/hal-engine-config-hooks/spec.md#13]', () => {
+  it('sums reported token fields across gaps and leaves unreported turns undefined', () => {
+    const rounds: Array<UsageMetadata | undefined> = [
+      undefined,
+      {inputTokens: 11, outputTokens: 2, totalTokens: 13},
+      undefined,
+      {inputTokens: 23, outputTokens: 3, totalTokens: 26},
+      undefined,
+    ];
+
+    expect({
+      reported: rounds.reduce<UsageMetadata | undefined>(accumulateUsage, undefined),
+      unreported: [undefined, undefined].reduce<UsageMetadata | undefined>(accumulateUsage, undefined),
+    }).toEqual({
+      reported: {inputTokens: 34, outputTokens: 5, totalTokens: 39},
+      unreported: undefined,
+    });
+  });
+});
diff --git a/src/orchestration/turnUsage.ts b/src/orchestration/turnUsage.ts
new file mode 100644
index 0000000..e91de5b
--- /dev/null
+++ b/src/orchestration/turnUsage.ts
@@ -0,0 +1,13 @@
+import type {UsageMetadata} from '../types/ai.js';
+
+export function accumulateUsage(
+  total: UsageMetadata | undefined,
+  round: UsageMetadata | undefined
+): UsageMetadata | undefined {
+  if (!round) return total;
+  return {
+    inputTokens: (total?.inputTokens ?? 0) + round.inputTokens,
+    outputTokens: (total?.outputTokens ?? 0) + round.outputTokens,
+    totalTokens: (total?.totalTokens ?? 0) + round.totalTokens,
+  };
+}
