+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolResponse} from './tools/registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+// One scripted round per sendMessage call, to drive the tool loop round by round.
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryReturning = (response: ToolResponse): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => response
+  );
+  return registry;
+};
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+
+describe('ChatOrchestrator usage accumulation across tool rounds', () => {
+  it('reports accumulated usage from every provider call across two tool rounds', async () => {
+    const usage1: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const usage2: UsageMetadata = {inputTokens: 20, outputTokens: 10, totalTokens: 30};
+
+    let receivedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const provider = scriptedProvider([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usage1}],
+      [{type: 'text', text: 'final answer'}, {type: 'stop', stopReason: 'end_turn', usage: usage2}],
+    ]);
+
+    const orchestrator = createChatOrchestrator(
+      provider,
+      promptBuilder,
+      registryReturning({result: 'found it'}),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(receivedUsage).toEqual({inputTokens: 30, outputTokens: 15, totalTokens: 45});
+  });
+
+  it('reports usage across three tool rounds', async () => {
+    const usage1: UsageMetadata = {inputTokens: 5, outputTokens: 3, totalTokens: 8};
+    const usage2: UsageMetadata = {inputTokens: 15, outputTokens: 7, totalTokens: 22};
+    const usage3: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+
+    let receivedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const provider = scriptedProvider([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usage1}],
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usage2}],
+      [{type: 'text', text: 'done'}, {type: 'stop', stopReason: 'end_turn', usage: usage3}],
+    ]);
+
+    const orchestrator = createChatOrchestrator(
+      provider,
+      promptBuilder,
+      registryReturning({result: 'ok'}),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(receivedUsage).toEqual({inputTokens: 30, outputTokens: 15, totalTokens: 45});
+  });
+
+  it('reports correct accumulated usage when some rounds report no usage', async () => {
+    const usage1: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const usage2: UsageMetadata = {inputTokens: 20, outputTokens: 10, totalTokens: 30};
+
+    let receivedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const provider = scriptedProvider([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usage1}],
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+      [{type: 'text', text: 'final'}, {type: 'stop', stopReason: 'end_turn', usage: usage2}],
+    ]);
+
+    const orchestrator = createChatOrchestrator(
+      provider,
+      promptBuilder,
+      registryReturning({result: 'ok'}),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(receivedUsage).toEqual({inputTokens: 30, outputTokens: 15, totalTokens: 45});
+  });
+
+  it('reports undefined when no rounds report any usage', async () => {
+    let receivedUsage: UsageMetadata | undefined = {inputTokens: 1, outputTokens: 1, totalTokens: 2};
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const provider = scriptedProvider([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+      [{type: 'text', text: 'answer'}, {type: 'stop', stopReason: 'end_turn'}],
+    ]);
+
+    const orchestrator = createChatOrchestrator(
+      provider,
+      promptBuilder,
+      registryReturning({result: 'ok'}),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(receivedUsage).toBeUndefined();
+  });
+
+  it('reports the same single usage for a turn with no tool calls', async () => {
+    const usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    let receivedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, u) => {
+        receivedUsage = u;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([[{type: 'text', text: 'answer'}, {type: 'stop', stopReason: 'end_turn', usage}]]),
+      promptBuilder,
+      undefined,
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(receivedUsage).toEqual(usage);
+  });
+});