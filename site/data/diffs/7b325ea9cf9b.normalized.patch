+import {sumUsage} from './turnUsage.js';
+import type {UsageMetadata} from '../types/ai.js';
+
+describe('specs/hal-engine-config-hooks/spec.md#15', () => {
+  it('sums reported usage across gaps and leaves unreported turns undefined', () => {
+    const rounds: Array<UsageMetadata | undefined> = [
+      undefined,
+      {inputTokens: 2, outputTokens: 1, totalTokens: 3},
+      undefined,
+      {inputTokens: 7, outputTokens: 4, totalTokens: 11},
+      undefined,
+    ];
+    expect({
+      reported: rounds.reduce<UsageMetadata | undefined>(sumUsage, undefined),
+      unreported: sumUsage(undefined, undefined),
+    }).toEqual({
+      reported: {inputTokens: 9, outputTokens: 5, totalTokens: 14},
+      unreported: undefined,
+    });
+  });
+});
