+import {jest} from '@jest/globals';
+import Ajv from 'ajv';
+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+import type {OutgoingMessage} from '../../types/messages.js';
+
+describe('ToolRegistry', () => {
+  afterEach(() => {
+    setLogger(undefined);
+  });
+
+  it('rejects input missing a required property with a ToolResponse and never calls the executor', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'unit_test_tool',
+        description: 'A tool for unit testing',
+        inputSchema: {
+          type: 'object',
+          properties: {arg: {type: 'string'}},
+          required: ['arg'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'ok';
+      }
+    );
+
+    const response = await registry.execute('unit_test_tool', {});
+
+    expect({
+      calls: executorCalls,
+      error: response.result,
+    }).toEqual({
+      calls: 0,
+      error: expect.stringMatching(/missing required property: arg/i),
+    });
+  });
+
+  it('rejects a wrong-typed property naming the field and expected type without leaking the offending value to the result or logs', async () => {
+    const collectedLogs: string[] = [];
+    const logSpy = (level: string, msg: string, properties?: Record<string, unknown>) => {
+      collectedLogs.push(`${level}: ${msg} ${JSON.stringify(properties || {})}`);
+    };
+    const mockLogger: Logger = {
+      debug: logSpy,
+      info: logSpy,
+      warn: logSpy,
+      error: logSpy,
+    };
+    setLogger(mockLogger);
+
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(
+      {
+        name: 'typed_tool',
+        description: 'Testing types',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            val: {type: 'number'},
+          },
+          required: ['val'],
+        },
+      },
+      async () => {
+        calls += 1;
+        return 'ok';
+      }
+    );
+
+    const response = await registry.execute('typed_tool', {val: 'not-a-number'});
+
+    expect({
+      calls,
+      hasField: response.result.includes('val'),
+      hasType: response.result.includes('number'),
+      leakedInResult: response.result.includes('not-a-number'),
+      leakedInLogs: collectedLogs.some(line => line.includes('not-a-number')),
+    }).toEqual({
+      calls: 0,
+      hasField: true,
+      hasType: true,
+      leakedInResult: false,
+      leakedInLogs: false,
+    });
+  });
+
+  it('passes through valid input with extra properties unchanged', async () => {
+    const registry = new ToolRegistry();
+    let capturedInput: Record<string, unknown> | undefined;
+    registry.register(
+      {
+        name: 'echo',
+        description: 'Echo input',
+        inputSchema: {
+          type: 'object',
+          properties: {foo: {type: 'string'}},
+        },
+      },
+      async input => {
+        capturedInput = input;
+        return 'ok';
+      }
+    );
+
+    const input = {foo: 'bar', extra: 'baz'};
+    await registry.execute('echo', input);
+
+    expect(capturedInput).toEqual(input);
+  });
+
+  it('throws at register time naming the tool when a static inputSchema cannot be compiled', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'invalid_schema_tool',
+          description: 'Invalid schema',
+          inputSchema: {
+            type: 'object',
+            properties: {val: {type: 'not-a-type' as unknown as string}},
+          },
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow(/invalid_schema_tool/);
+  });
+
+  it('reuses static validator even if definition schema is mutated', async () => {
+    const registry = new ToolRegistry();
+    const definition = {
+      name: 'static',
+      description: 'Static tool',
+      inputSchema: {
+        type: 'object',
+        properties: {a: {type: 'string'}},
+      },
+    };
+    registry.register(definition, async () => 'ok');
+
+    // Mutate the original schema
+    const properties = definition.inputSchema.properties as Record<string, {type: string}>;
+    properties.a.type = 'number';
+
+    // Should still accept string because it's using the compiled validator from registration
+    const response = await registry.execute('static', {a: 'still string'});
+    expect(response.result).toBe('ok');
+  });
+
+  it('caches compiled validators for dynamic tools', async () => {
+    const registry = new ToolRegistry();
+    const schema = {type: 'object', properties: {a: {type: 'string'}}};
+    let resolvedCount = 0;
+    registry.register(
+      () => {
+        resolvedCount += 1;
+        return {
+          name: 'dynamic',
+          description: 'Dynamic tool',
+          inputSchema: schema,
+        };
+      },
+      async () => 'ok'
+    );
+
+    await registry.execute('dynamic', {a: 'v1'});
+    await registry.execute('dynamic', {a: 'v2'});
+
+    // 1 (register) + 2 (execute) = 3
+    expect(resolvedCount).toBe(3);
+  });
+
+  it('validates against the current schema for dynamic tools when it changes', async () => {
+    const registry = new ToolRegistry();
+    let useRequired = false;
+    registry.register(
+      () => ({
+        name: 'changing',
+        description: 'Schema changes',
+        inputSchema: {
+          type: 'object',
+          properties: {a: {type: 'string'}},
+          required: useRequired ? ['a'] : [],
+        },
+      }),
+      async () => 'ok'
+    );
+
+    const r1 = await registry.execute('changing', {});
+    const r1Ok = r1.result === 'ok';
+
+    useRequired = true;
+    const r2 = await registry.execute('changing', {});
+    const r2Failed = r2.result.includes('a') && /required/i.test(r2.result);
+
+    expect({r1Ok, r2Failed}).toEqual({r1Ok: true, r2Failed: true});
+  });
+
+  it('compiles static tool schema exactly once during registration and reuses it', async () => {
+    const AjvCtor = (Ajv as unknown as {default?: typeof Ajv}).default || Ajv;
+    const compileSpy = jest.spyOn(AjvCtor.prototype, 'compile');
+    const registry = new ToolRegistry();
+    const definition = {
+      name: 'counted',
+      description: 'Counted compilations',
+      inputSchema: {type: 'object', properties: {a: {type: 'string'}}},
+    };
+
+    registry.register(definition, async () => 'ok');
+    const callsAtStart = compileSpy.mock.calls;
+    const initialCount = callsAtStart.length;
+
+    for (let i = 0; i < 10; i++) {
+      await registry.execute('counted', {a: 'val'});
+    }
+
+    const callsAtEnd = compileSpy.mock.calls;
+    expect({
+      initial: initialCount,
+      total: callsAtEnd.length,
+    }).toEqual({
+      initial: 1,
+      total: 1,
+    });
+
+    compileSpy.mockRestore();
+  });
+
+  it('still throws Unknown tool for unregistered name', async () => {
+    // ([validated by](src/orchestration/tools/registry.test.ts#L227))
+    const registry = new ToolRegistry();
+    await expect(registry.execute('nonexistent', {})).rejects.toThrow(/Unknown tool: nonexistent/);
+  });
+
+  it('provides access to registered tools and definitions', () => {
+    const registry = new ToolRegistry();
+    const definition = {
+      name: 't1',
+      description: 'd1',
+      inputSchema: {type: 'object'},
+      promptInstructions: 'inst1',
+      examplePrompts: ['ex1'],
+    };
+    registry.register(definition, async () => 'ok');
+
+    const t1 = registry.get('t1');
+    expect({
+      hasT1: registry.has('t1'),
+      hasT2: registry.has('t2'),
+      t1Name: t1?.definition.name,
+      t2: registry.get('t2'),
+      defCount: registry.getDefinitions().length,
+      instructions: registry.getPromptInstructions(),
+      examples: registry.getExamplePrompts(),
+    }).toEqual({
+      hasT1: true,
+      hasT2: false,
+      t1Name: 't1',
+      t2: undefined,
+      defCount: 1,
+      instructions: ['t1: inst1'],
+      examples: ['ex1'],
+    });
+  });
+
+  it('rejects execution when dynamic schema fails to compile', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      () => ({
+        name: 'bad_dynamic',
+        description: 'Bad dynamic',
+        inputSchema: {type: 'not-a-type'} as unknown as Record<string, unknown>,
+      }),
+      async () => 'ok'
+    );
+
+    const response = await registry.execute('bad_dynamic', {});
+    expect(response.result).toMatch(/schema failed to compile/);
+  });
+
+  it('normalizes complex tool responses including client messages', async () => {
+    const registry = new ToolRegistry();
+    registry.register({name: 'complex', description: 'desc', inputSchema: {type: 'object'}}, async () => ({
+      result: 'done',
+      clientMessages: [{type: 'error', code: 'TEST_ERROR', message: 'hi'} as OutgoingMessage],
+    }));
+
+    const response = await registry.execute('complex', {});
+    const messages = response.clientMessages;
+    const firstMessage = messages?.[0];
+    expect({
+      result: response.result,
+      messageCount: messages?.length,
+      firstMessageType: firstMessage?.type,
+    }).toEqual({
+      result: 'done',
+      messageCount: 1,
+      firstMessageType: 'error',
+    });
+  });
+});
