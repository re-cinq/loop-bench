+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolResponse} from './tools/registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+const STOP_FOR_TOOL: MessageChunk = {type: 'stop', stopReason: 'tool_use'};
+const STOP_DONE: MessageChunk = {type: 'stop', stopReason: 'end_turn'};
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryReturning = (response: ToolResponse): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => response
+  );
+  return registry;
+};
+
+describe('ChatOrchestrator usage accumulation acceptance tests', () => {
+  it('reports usage covering every provider call in a turn with two tool rounds, summed from each round', async () => {
+    const usage1: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const usage2: UsageMetadata = {inputTokens: 20, outputTokens: 8, totalTokens: 28};
+    let receivedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, reported) => {
+        receivedUsage = reported;
+      },
+    };
+
+    const provider = scriptedProvider([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usage1}],
+      [{type: 'text', text: 'response'}, {type: 'stop', stopReason: 'end_turn', usage: usage2}],
+    ]);
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registryReturning({result: 'found'}), {
+      hooks,
+    });
+
+    await orchestrator.processMessage(createSession('question'));
+
+    expect(receivedUsage).toEqual({
+      inputTokens: 30,
+      outputTokens: 13,
+      totalTokens: 43,
+    });
+  });
+
+  it('reports exactly what it reports today for a turn with no tool calls, unchanged', async () => {
+    const usage: UsageMetadata = {inputTokens: 5, outputTokens: 3, totalTokens: 8};
+    let receivedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, reported) => {
+        receivedUsage = reported;
+      },
+    };
+
+    const provider = scriptedProvider([[{type: 'text', text: 'direct answer'}, {type: 'stop', stopReason: 'end_turn', usage}]]);
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+
+    await orchestrator.processMessage(createSession('question'));
+
+    expect(receivedUsage).toEqual(usage);
+  });
+
+  it('handles undefined usage in some rounds and still counts the reported rounds', async () => {
+    const usage2: UsageMetadata = {inputTokens: 20, outputTokens: 8, totalTokens: 28};
+    let receivedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, reported) => {
+        receivedUsage = reported;
+      },
+    };
+
+    const provider = scriptedProvider([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+      [{type: 'text', text: 'response'}, {type: 'stop', stopReason: 'end_turn', usage: usage2}],
+    ]);
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registryReturning({result: 'found'}), {
+      hooks,
+    });
+
+    await orchestrator.processMessage(createSession('question'));
+
+    expect(receivedUsage).toEqual(usage2);
+  });
+
+  it('reports undefined when no rounds report usage', async () => {
+    let receivedUsage: UsageMetadata | undefined = {inputTokens: -1, outputTokens: -1, totalTokens: -1};
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, reported) => {
+        receivedUsage = reported;
+      },
+    };
+
+    const provider = scriptedProvider([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+      [{type: 'text', text: 'response'}, {type: 'stop', stopReason: 'end_turn'}],
+    ]);
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registryReturning({result: 'found'}), {
+      hooks,
+    });
+
+    await orchestrator.processMessage(createSession('question'));
+
+    expect(receivedUsage).toBeUndefined();
+  });
+});