+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+
+export const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+export const FIXED_DATE = '2026-10-20T12:00:00.000Z';
+
+export const sessionWith = (content: string): ChatSession => ({
+  sessionId: 'test-session',
+  userId: 'user-1',
+  workspaceId: 'workspace-1',
+  entries: [{role: 'user', content, timestamp: FIXED_DATE}],
+  authHeaders: {},
+});
+
+export const rejectingWith = (reason: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw reason;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+export interface TestOutcome {
+  outcome: {rejected: boolean; reason: unknown};
+  seenError?: Error;
+  callOrder: string[];
+}
+
+export const runRejectionTest = async (reason: unknown): Promise<TestOutcome> => {
+  const callOrder: string[] = [];
+  let seenError: Error | undefined;
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => {
+      callOrder.push('onError');
+      seenError = error;
+    },
+    afterSession: async () => {
+      callOrder.push('afterSession');
+    },
+  };
+
+  const orchestrator = createChatOrchestrator(rejectingWith(reason), promptBuilder, undefined, {hooks});
+  const outcome = await orchestrator.processMessage(sessionWith('hello')).then(
+    value => ({rejected: false, reason: value as unknown}),
+    (thrown: unknown) => ({rejected: true, reason: thrown})
+  );
+
+  return {
+    outcome,
+    seenError,
+    callOrder,
+  };
+};