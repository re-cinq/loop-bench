@@ -0,0 +1,37 @@
+import {runRejectionTest} from './onErrorNonError.testSupport.js';
+
+describe('ChatOrchestrator onError non-Error coercion (facet)', () => {
+  it('coerces a thrown string to an Error for the onError hook', async () => {
+    const result = await runRejectionTest('string boom');
+
+    expect(result).toMatchObject({
+      outcome: {rejected: true, reason: 'string boom'},
+      seenError: {
+        message: 'string boom',
+        cause: 'string boom',
+      },
+    });
+  });
+
+  it('coerces undefined to an Error for the onError hook', async () => {
+    const result = await runRejectionTest(undefined);
+
+    expect(result).toMatchObject({
+      outcome: {rejected: true, reason: undefined},
+      seenError: {
+        message: 'undefined',
+        cause: undefined,
+      },
+    });
+  });
+
+  it('passes an existing Error instance through unchanged to the onError hook', async () => {
+    const originalError = new Error('existing error');
+    const result = await runRejectionTest(originalError);
+
+    expect(result).toMatchObject({
+      outcome: {rejected: true, reason: originalError},
+      seenError: originalError,
+    });
+  });
+});
