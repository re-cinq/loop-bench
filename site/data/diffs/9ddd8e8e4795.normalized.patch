@@ -0,0 +1,298 @@
+import {describe, it, expect, jest} from '@jest/globals';
+import {ToolRegistry, type ToolExecutor} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+import {setLogger, type Logger} from '../../shared/logger.js';
+import Ajv from 'ajv';
+
+describe('ToolRegistry', () => {
+  it('throws at register time naming the tool when a static inputSchema cannot be compiled', () => {
+    const registry = new ToolRegistry();
+    const invalidSchema: ToolDefinition = {
+      name: 'broken-tool',
+      description: 'A tool with a broken schema',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          age: {type: 'number', minimum: 'not-a-number' as unknown as number}, // Invalid JSON Schema
+        },
+      },
+    };
+
+    expect(() => registry.register(invalidSchema, async () => 'ok')).toThrow(/broken-tool/);
+  });
+
+  describe('function-valued tool definition', () => {
+    it('validates against the schema current at that call', async () => {
+      const registry = new ToolRegistry();
+      let schemaType = 'string';
+      const definitionSource = () => ({
+        name: 'dynamic-tool',
+        description: 'A tool with a dynamic schema',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            val: {type: schemaType},
+          },
+          required: ['val'],
+        },
+      });
+
+      const executor = jest.fn<ToolExecutor>().mockResolvedValue('ok');
+      registry.register(definitionSource, executor);
+
+      // First call: schema requires string
+      await registry.execute('dynamic-tool', {val: 'hello'});
+
+      // Second call: schema requires string, but we pass number
+      const response = await registry.execute('dynamic-tool', {val: 123});
+
+      // Change schema to require number
+      schemaType = 'number';
+      await registry.execute('dynamic-tool', {val: 123});
+
+      const {mock} = executor;
+      expect({
+        executorCalls: mock.calls,
+        responseResult: response.result,
+      }).toEqual({
+        executorCalls: [
+          [{val: 'hello'}, undefined],
+          [{val: 123}, undefined],
+        ],
+        responseResult: expect.stringMatching(/val.*string/),
+      });
+    });
+  });
+
+  it('compiles a static tool schema once and reuses it', async () => {
+    const registry = new ToolRegistry();
+    // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    const compileSpy = jest.spyOn((Ajv as any).prototype, 'compile');
+
+    registry.register(
+      {
+        name: 'static-tool',
+        description: 'desc',
+        inputSchema: {type: 'object', properties: {a: {type: 'string'}}},
+      },
+      async () => 'ok'
+    );
+
+    for (let i = 0; i < 10; i++) {
+      await registry.execute('static-tool', {a: 'val'});
+    }
+
+    expect(compileSpy).toHaveBeenCalledTimes(1);
+    compileSpy.mockRestore();
+  });
+
+  it('returns a formatted error message without leaking offending values', async () => {
+    const registry = new ToolRegistry();
+    const executor = jest.fn<ToolExecutor>().mockResolvedValue('ok');
+    registry.register(
+      {
+        name: 'test-tool',
+        description: 'desc',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            email: {type: 'string'},
+            age: {type: 'number'},
+          },
+          required: ['email'],
+        },
+      },
+      executor
+    );
+
+    const response = await registry.execute('test-tool', {
+      email: 'test@example.com',
+      age: 'not-a-number',
+      extra: 'secret',
+    });
+
+    const {mock} = executor;
+    const {calls} = mock;
+    expect({
+      executorCalled: calls.length > 0,
+      hasTypeError: response.result.includes('age') && response.result.includes('number'),
+      leaksValue: response.result.includes('not-a-number') || response.result.includes('secret'),
+    }).toEqual({
+      executorCalled: false,
+      hasTypeError: true,
+      leaksValue: false,
+    });
+  });
+
+  it('reports the correct path for nested property validation failures', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'nested-tool',
+        description: 'desc',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            user: {
+              type: 'object',
+              properties: {
+                details: {
+                  type: 'object',
+                  properties: {
+                    age: {type: 'number'},
+                  },
+                },
+              },
+            },
+          },
+        },
+      },
+      async () => 'ok'
+    );
+
+    const response = await registry.execute('nested-tool', {
+      user: {details: {age: 'not-a-number'}},
+    });
+
+    expect({
+      path: response.result.includes('user/details/age'),
+      type: response.result.includes('number'),
+    }).toEqual({
+      path: true,
+      type: true,
+    });
+  });
+
+  it('reports the correct path for nested required property validation failures', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'nested-req-tool',
+        description: 'desc',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            user: {
+              type: 'object',
+              required: ['id'],
+            },
+          },
+        },
+      },
+      async () => 'ok'
+    );
+
+    const response = await registry.execute('nested-req-tool', {
+      user: {},
+    });
+
+    expect({
+      path: response.result.includes('user/id') || response.result.includes('user.id'),
+      missing: response.result.includes('required'),
+    }).toEqual({
+      path: true,
+      missing: true,
+    });
+  });
+
+  it('does not leak offending values to logs on validation failure', async () => {
+    interface LogEntry {
+      category: string;
+      message: string;
+      fields?: Record<string, unknown>;
+    }
+    const recordedLogs: LogEntry[] = [];
+    const recordLine = (category: string, message: string, fields?: Record<string, unknown>) => {
+      recordedLogs.push({category, message, fields});
+    };
+    const loggerMock: Logger = {
+      debug: recordLine,
+      info: recordLine,
+      warn: recordLine,
+      error: recordLine,
+    };
+    setLogger(loggerMock);
+
+    try {
+      const registry = new ToolRegistry();
+      registry.register(
+        {
+          name: 'secret-tool',
+          description: 'desc',
+          inputSchema: {type: 'object', properties: {secret: {type: 'number'}}},
+        },
+        async () => 'ok'
+      );
+
+      await registry.execute('secret-tool', {secret: 'my-password'});
+
+      const logLine = recordedLogs.find(l => l.message === 'validation failed');
+      expect({
+        logDefined: logLine !== undefined,
+        logContent: JSON.stringify(logLine),
+      }).toEqual({
+        logDefined: true,
+        logContent: expect.not.stringContaining('my-password'),
+      });
+    } finally {
+      setLogger(undefined);
+    }
+  });
+
+  it('invokes the executor once and passes input unchanged including extra properties', async () => {
+    const registry = new ToolRegistry();
+    const executor = jest.fn<ToolExecutor>().mockResolvedValue('ok');
+    registry.register(
+      {
+        name: 'test-tool-extra',
+        description: 'desc',
+        inputSchema: {
+          type: 'object',
+          properties: {a: {type: 'string'}},
+        },
+      },
+      executor
+    );
+
+    const input = {a: 'val', extra: 'stuff'};
+    await registry.execute('test-tool-extra', input);
+
+    const {mock} = executor;
+    expect(mock.calls).toEqual([[input, undefined]]);
+  });
+
+  /** @see specs/hal-engine-tool-input-validation/spec.md */
+  it('honors additionalProperties: false when explicitly provided in the schema', async () => {
+    const registry = new ToolRegistry();
+    const executor = jest.fn<ToolExecutor>().mockResolvedValue('ok');
+    registry.register(
+      {
+        name: 'strict-tool',
+        description: 'desc',
+        inputSchema: {
+          type: 'object',
+          properties: {a: {type: 'string'}},
+          additionalProperties: false,
+        },
+      },
+      executor
+    );
+
+    const response = await registry.execute('strict-tool', {a: 'val', extra: 'stuff'});
+
+    const {mock} = executor;
+    const {calls} = mock;
+    expect({
+      calls: calls.length,
+      result: response.result,
+    }).toEqual({
+      calls: 0,
+      result: expect.stringContaining('additional properties'),
+    });
+  });
+
+  it('throws Unknown tool error for unregistered tool', async () => {
+    const registry = new ToolRegistry();
+    await expect(registry.execute('missing', {})).rejects.toThrow(/Unknown tool: missing/);
+  });
+});
