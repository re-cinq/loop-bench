+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const definition = (inputSchema: Record<string, unknown>): ToolDefinition => ({
+  name: 'weather',
+  description: 'Looks up weather',
+  inputSchema,
+});
+
+// specs/hal-engine-tool-input-validation#1
+describe('ToolRegistry input schema validation', () => {
+  it('rejects missing required input before executing and passes valid extra keys unchanged', async () => {
+    const registry = new ToolRegistry();
+    const calls: Record<string, unknown>[] = [];
+    registry.register(
+      definition({
+        type: 'object',
+        properties: {location: {type: 'string'}},
+        required: ['location'],
+      }),
+      async input => {
+        calls.push(input);
+        return 'forecast';
+      }
+    );
+
+    const rejected = await registry.execute('weather', {});
+    expect(rejected.result).toMatch(/location.*required/i);
+    expect(calls).toHaveLength(0);
+
+    const validInput = {location: 'Berlin', extra: 'kept'};
+    const accepted = await registry.execute('weather', validInput);
+    expect(accepted.result).toBe('forecast');
+    expect(calls).toEqual([validInput]);
+  });
+
+  it('rejects a wrong-typed field with its path and expected type but without its value', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      definition({type: 'object', properties: {location: {type: 'string'}}, required: ['location']}),
+      async () => 'forecast'
+    );
+
+    const rejected = await registry.execute('weather', {location: 73192});
+    expect(rejected.result).toMatch(/location.*string/i);
+    expect(rejected.result).not.toContain('73192');
+  });
+
+  it('uses the schema resolved for each function-valued definition call', async () => {
+    const registry = new ToolRegistry();
+    let currentSchema: Record<string, unknown> = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    registry.register(
+      () => definition(currentSchema),
+      async () => 'forecast'
+    );
+
+    await registry.execute('weather', {location: 'Berlin'});
+    currentSchema = {
+      type: 'object',
+      properties: {units: {type: 'string'}},
+      required: ['units'],
+    };
+    const rejected = await registry.execute('weather', {location: 'Berlin'});
+    expect(rejected.result).toMatch(/units.*required/i);
+  });
+
+  it('rejects an uncompilable static schema during registration and names the tool', () => {
+    const registry = new ToolRegistry();
+
+    expect(() => registry.register(definition({type: 'not-a-json-schema-type'}), async () => 'forecast')).toThrow(
+      /weather/i
+    );
+  });
+});
