+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+
+it('includes the budget-closing provider call in turn usage — specs/hal-engine-turn-usage/spec.md#2', async () => {
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield {type: 'tool_use', toolCall: {id: 'lookup', name: 'lookup', input: {}}};
+      yield {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 7, outputTokens: 2, totalTokens: 9}};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured generation is outside this contract.');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Look up a value.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  let reported: UsageMetadata | undefined;
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Usage contract.'}), registry, {
+    maxToolRounds: 1,
+    hooks: {
+      afterModelResponse: async (_session, _text, usage) => {
+        reported = usage;
+      },
+    },
+  });
+
+  await orchestrator.processMessage({sessionId: 's1', userId: 'u1', entries: []});
+
+  expect(reported).toEqual({inputTokens: 14, outputTokens: 4, totalTokens: 18});
+});
