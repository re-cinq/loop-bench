+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const WEATHER_SCHEMA: Record<string, unknown> = {
+  type: 'object',
+  properties: {
+    location: {type: 'string'},
+    units: {type: 'string', enum: ['celsius', 'fahrenheit']},
+  },
+  required: ['location'],
+};
+
+const WEATHER_TOOL: ToolDefinition = {
+  name: 'get_weather',
+  description: 'Fetch weather for a city',
+  inputSchema: WEATHER_SCHEMA,
+};
+
+describe('ToolRegistry', () => {
+  afterEach(() => {
+    setLogger(undefined);
+  });
+
+  it('returns a rejection naming a missing required property without calling the executor', async () => {
+    const {registry, getInvocations} = createCountingWeatherRegistry();
+
+    const outcome = await registry.execute('get_weather', {});
+
+    expect({
+      invocations: getInvocations(),
+      namesLocation: outcome.result.includes('location'),
+      mentionsRequired: /required/i.test(outcome.result),
+    }).toEqual({
+      invocations: 0,
+      namesLocation: true,
+      mentionsRequired: true,
+    });
+  });
+
+  it('rejects a wrong-typed field without echoing the offending value in the result or logs', async () => {
+    const emittedLines: string[] = [];
+    const capture = (category: string, message: string, fields?: Record<string, unknown>) => {
+      emittedLines.push(JSON.stringify({category, message, fields}));
+    };
+    const testLogger: Logger = {debug: capture, info: capture, warn: capture, error: capture};
+    setLogger(testLogger);
+
+    const {registry, getInvocations} = createCountingWeatherRegistry();
+    const outcome = await registry.execute('get_weather', {location: 987654321});
+
+    expect({
+      invocations: getInvocations(),
+      namesField: outcome.result.includes('location'),
+      namesType: outcome.result.includes('string'),
+      echoesSecretInResult: outcome.result.includes('987654321'),
+      echoesSecretInLogs: emittedLines.some(line => line.includes('987654321')),
+    }).toEqual({
+      invocations: 0,
+      namesField: true,
+      namesType: true,
+      echoesSecretInResult: false,
+      echoesSecretInLogs: false,
+    });
+  });
+
+  it('rejects a property value outside the declared enum without calling the executor', async () => {
+    const {registry, getInvocations} = createCountingWeatherRegistry();
+
+    const outcome = await registry.execute('get_weather', {location: 'Berlin', units: 'kelvin'});
+
+    expect({
+      invocations: getInvocations(),
+      namesUnits: outcome.result.includes('units'),
+    }).toEqual({
+      invocations: 0,
+      namesUnits: true,
+    });
+  });
+
+  it('passes valid input and undeclared extra properties through to the executor unchanged', async () => {
+    const registry = new ToolRegistry();
+    const receivedInputs: Array<Record<string, unknown>> = [];
+    registry.register(WEATHER_TOOL, async input => {
+      receivedInputs.push(input);
+      return 'forecast-ok';
+    });
+
+    const payload = {location: 'Berlin', units: 'celsius', extraTag: 'keep-me'};
+    const outcome = await registry.execute('get_weather', payload);
+
+    expect({outcome, receivedInputs}).toEqual({
+      outcome: {result: 'forecast-ok'},
+      receivedInputs: [{location: 'Berlin', units: 'celsius', extraTag: 'keep-me'}],
+    });
+  });
+
+  it('throws Unknown tool when executing a tool name that has not been registered', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('missing_tool', {q: 'test'})).rejects.toThrow('Unknown tool: missing_tool');
+  });
+
+  it('throws at register time naming the tool and preserving the cause when a static inputSchema is invalid', () => {
+    const registry = new ToolRegistry();
+    let caughtError: Error | undefined;
+
+    try {
+      registry.register(
+        {
+          name: 'malformed_search',
+          description: 'Invalid schema definition',
+          inputSchema: {type: 'not-a-valid-schema-type'},
+        },
+        async () => 'never'
+      );
+    } catch (error) {
+      caughtError = error as Error;
+    }
+
+    expect({
+      namesTool: caughtError?.message.includes('malformed_search') ?? false,
+      hasCause: caughtError?.cause instanceof Error,
+    }).toEqual({
+      namesTool: true,
+      hasCause: true,
+    });
+  });
+
+  it('compiles a static tool schema once at register time across ten execute calls', async () => {
+    const registry = new ToolRegistry();
+    let schemaReads = 0;
+    const rawSchema: Record<string, unknown> = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    const definition = {
+      name: 'get_weather',
+      description: 'Get weather for a location',
+      get inputSchema(): Record<string, unknown> {
+        schemaReads += 1;
+        return rawSchema;
+      },
+    };
+
+    registry.register(definition, async () => 'sunny');
+
+    for (let i = 0; i < 10; i += 1) {
+      await registry.execute('get_weather', {location: 'Paris'});
+    }
+
+    expect(schemaReads).toBe(1);
+  });
+
+  it('validates a function-valued tool definition against the schema returned for each call', async () => {
+    const registry = new ToolRegistry();
+    let currentSchema: Record<string, unknown> = {
+      type: 'object',
+      properties: {city: {type: 'string'}},
+      required: ['city'],
+    };
+    registry.register(
+      () => ({
+        name: 'lookup',
+        description: 'Dynamic schema tool',
+        inputSchema: currentSchema,
+      }),
+      async input => JSON.stringify(input)
+    );
+
+    const first = await registry.execute('lookup', {});
+    const cachedPass = await registry.execute('lookup', {city: 'Paris'});
+    currentSchema = {
+      type: 'object',
+      properties: {postalCode: {type: 'number'}},
+      required: ['postalCode'],
+    };
+    const second = await registry.execute('lookup', {city: 'Paris'});
+
+    expect({
+      firstMentionsCity: first.result.includes('city'),
+      cachedResult: cachedPass.result,
+      secondMentionsPostalCode: second.result.includes('postalCode'),
+    }).toEqual({
+      firstMentionsCity: true,
+      cachedResult: JSON.stringify({city: 'Paris'}),
+      secondMentionsPostalCode: true,
+    });
+  });
+});
+
+function createCountingWeatherRegistry(): {registry: ToolRegistry; getInvocations: () => number} {
+  const registry = new ToolRegistry();
+  let invocations = 0;
+  registry.register(WEATHER_TOOL, async () => {
+    invocations += 1;
+    return 'ok';
+  });
+  return {registry, getInvocations: () => invocations};
+}
