+        seenMessages.push([...params.messages]);
+        for (const chunk of rounds[roundIndex++] ?? []) yield chunk;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+    const answer = await orchestrator.processMessage(createSession('weather in Rome'));
+    const secondRoundMessages = seenMessages[1] ?? [];
+    const serializedSecondRound = JSON.stringify(secondRoundMessages);
+
+    expect({
+      answer,
+      executedCities,
+      rejectionReachedProvider: serializedSecondRound.includes('city') && /required/i.test(serializedSecondRound),
+    }).toEqual({
+      answer: 'Rome is clear',
+      executedCities: ['Rome'],
+      rejectionReachedProvider: true,
+    });
+  });
 });
