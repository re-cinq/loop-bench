@@ -0,0 +1,53 @@
+import {captureError} from './onErrorNonError.testSupport.js';
+
+describe('ChatOrchestrator non-Error rejections facet', () => {
+  it('coerces a string rejection to an Error and calls onError', async () => {
+    const capturedError = await captureError('string boom');
+
+    expect({
+      isError: capturedError instanceof Error,
+      message: capturedError?.message,
+      cause: capturedError?.cause,
+    }).toEqual({
+      isError: true,
+      message: 'string boom',
+      cause: 'string boom',
+    });
+  });
+
+  it('coerces a plain object rejection to an Error and calls onError', async () => {
+    const reason = {code: 503, detail: 'upstream down'};
+    const capturedError = await captureError(reason);
+
+    expect({
+      isError: capturedError instanceof Error,
+      message: capturedError?.message,
+      cause: capturedError?.cause,
+    }).toEqual({
+      isError: true,
+      message: JSON.stringify(reason),
+      cause: reason,
+    });
+  });
+
+  it('passes an Error instance through unchanged to onError', async () => {
+    const originalError = new Error('original boom');
+    const capturedError = await captureError(originalError);
+
+    expect(capturedError).toBe(originalError);
+  });
+
+  it('coerces an undefined rejection to an Error and calls onError', async () => {
+    const capturedError = await captureError(undefined);
+
+    expect({
+      isError: capturedError instanceof Error,
+      message: capturedError?.message,
+      cause: capturedError?.cause,
+    }).toEqual({
+      isError: true,
+      message: 'undefined',
+      cause: undefined,
+    });
+  });
+});
