+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+export const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+export const FIXED_TIMESTAMP = '2023-01-01T00:00:00.000Z';
+
+export const sessionWith = (content: string): ChatSession => ({
+  sessionId: 'test-session',
+  userId: 'user-1',
+  entries: [{role: 'user', content, timestamp: FIXED_TIMESTAMP}],
+});
+
+export const rejectingWith = (reason: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw reason;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+export async function captureError(reason: unknown): Promise<Error | undefined> {
+  let capturedError: Error | undefined;
+  const hooks: OrchestratorHooks = {
+    onError: async (_session, error) => {
+      capturedError = error;
+    },
+  };
+
+  const orchestrator = createChatOrchestrator(rejectingWith(reason), promptBuilder, undefined, {hooks});
+
+  try {
+    await orchestrator.processMessage(sessionWith('hello'));
+  } catch (_e) {
+    // expected
+  }
+
+  return capturedError;
+}
diff --git a/src/orchestration/orchestratorHelpers.ts b/src/orchestration/orchestratorHelpers.ts
index 717eb9a..813a146 100644
--- a/src/orchestration/orchestratorHelpers.ts
+++ b/src/orchestration/orchestratorHelpers.ts
@@ -40,3 +40,17 @@ export function extractStopReason(chunk: MessageChunk): string | null {
 export function extractUsage(chunk: MessageChunk): UsageMetadata | undefined {
   return chunk.type === 'stop' ? chunk.usage : undefined;
 }
+
+export function ensureError(error: unknown): Error {
+  if (error instanceof Error) return error;
+  if (typeof error === 'string') return new Error(error, {cause: error});
+
+  let message: string;
+  try {
+    const json = JSON.stringify(error);
+    message = typeof json === 'string' ? json : String(error);
+  } catch {
+    message = String(error);
+  }
+  return new Error(message, {cause: error});
+}
