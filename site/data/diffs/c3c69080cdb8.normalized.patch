+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const RESOLVED = Symbol('resolved');
+
+function createSession(): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content: 'hello', timestamp: SENT_AT}],
+  };
+}
+
+function rejectingProvider(rejection: unknown): AIProvider {
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      throw rejection;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const rejectionCases: Array<[string, unknown]> = [
+  ['a string', 'provider failed'],
+  ['a plain object', {code: 'PROVIDER_FAILED'}],
+  ['undefined', undefined],
+  ['an existing Error', new Error('provider failed')],
+];
+
+describe('onError rejection handling', () => {
+  it.each(rejectionCases)('calls onError for %s and preserves the caller rejection', async (_label, rejection) => {
+    let calls = 0;
+    let received: Error | undefined;
+    const orchestrator = createChatOrchestrator(
+      rejectingProvider(rejection),
+      new PromptBuilder({identity: 'You are a test assistant.'}),
+      undefined,
+      {
+        hooks: {
+          onError: async (_session, error) => {
+            calls += 1;
+            received = error;
+          },
+        },
+      }
+    );
+
+    const callerRejection = await orchestrator.processMessage(createSession()).then(
+      () => RESOLVED,
+      error => error
+    );
+
+    expect(calls).toBe(1);
+    expect(callerRejection).toBe(rejection);
+
+    if (rejection instanceof Error) {
+      expect(received).toBe(rejection);
+    } else {
+      expect(received).toBeInstanceOf(Error);
+      expect(received?.cause).toBe(rejection);
+    }
+  });
+});
