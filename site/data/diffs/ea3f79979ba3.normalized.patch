@@ -0,0 +1,113 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function makeRoundProvider(
+  round1Usage: UsageMetadata,
+  round2Usage: UsageMetadata | undefined,
+  round2Text: string
+): AIProvider {
+  let round = 0;
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      if (round !== 0) {
+        yield {type: 'text', text: round2Text};
+        yield {type: 'stop', stopReason: 'end_turn', usage: round2Usage};
+        return;
+      }
+      round++;
+      yield {type: 'tool_use', toolCall: {id: 'call1', name: 'get_weather', input: {location: 'London'}}};
+      yield {type: 'stop', stopReason: 'tool_use', usage: round1Usage};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+describe('Usage reporting across tool rounds (acceptance)', () => {
+  const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+  const toolRegistry = new ToolRegistry();
+  toolRegistry.register(
+    {
+      name: 'get_weather',
+      description: 'Get weather',
+      inputSchema: {type: 'object', properties: {location: {type: 'string'}}},
+    },
+    async () => ({result: 'sunny'})
+  );
+
+  async function runWithProvider(provider: AIProvider, message: string): Promise<UsageMetadata | undefined> {
+    let reportedUsage: UsageMetadata | undefined;
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, toolRegistry, {
+      hooks: {
+        afterModelResponse: async (_session, _text, usage) => {
+          reportedUsage = usage;
+        },
+      },
+    });
+    await orchestrator.processMessage(createSession(message));
+    return reportedUsage;
+  }
+
+  it('reports summed usage across multiple tool rounds', async () => {
+    const usage1: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const usage2: UsageMetadata = {inputTokens: 20, outputTokens: 10, totalTokens: 30};
+    const provider = makeRoundProvider(usage1, usage2, 'It is sunny.');
+
+    const reportedUsage = await runWithProvider(provider, 'What is the weather?');
+
+    expect(reportedUsage).toEqual({
+      inputTokens: usage1.inputTokens + usage2.inputTokens,
+      outputTokens: usage1.outputTokens + usage2.outputTokens,
+      totalTokens: usage1.totalTokens + usage2.totalTokens,
+    });
+  });
+
+  it('reports exact usage for a turn with no tool calls', async () => {
+    const usage: UsageMetadata = {inputTokens: 5, outputTokens: 2, totalTokens: 7};
+    const provider: AIProvider = {
+      async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        yield {type: 'text', text: 'Hello!'};
+        yield {type: 'stop', stopReason: 'end_turn', usage};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    let reportedUsage: UsageMetadata | undefined;
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {
+      hooks: {
+        afterModelResponse: async (_session, _text, reported) => {
+          reportedUsage = reported;
+        },
+      },
+    });
+
+    await orchestrator.processMessage(createSession('Hi'));
+
+    expect(reportedUsage).toEqual(usage);
+  });
+
+  it('handles rounds with no usage reported by counting only the ones that did', async () => {
+    const usage1: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const provider = makeRoundProvider(usage1, undefined, 'It is sunny.');
+
+    const reportedUsage = await runWithProvider(provider, 'Weather?');
+
+    expect(reportedUsage).toEqual(usage1);
+  });
+});
