+import {ToolRegistry} from './registry.js';
+import {jest} from '@jest/globals';
+import type {ToolDefinition} from '../../types/ai.js';
+import type {ToolExecutor} from './registry.js';
+
+describe('ToolRegistry', () => {
+  const setupRegistry = (schema: unknown, executor: ToolExecutor) => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'test-tool',
+        description: 'Test tool',
+        inputSchema: schema as Record<string, unknown>,
+      },
+      executor
+    );
+    return registry;
+  };
+
+  it('rejects input missing a required property and never calls the executor', async () => {
+    let executorCalled = false;
+    const registry = setupRegistry(
+      {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      async () => {
+        executorCalled = true;
+        return 'success';
+      }
+    );
+    const result = await registry.execute('test-tool', {});
+    expect({called: executorCalled, res: result}).toEqual({
+      called: false,
+      res: {result: expect.stringContaining('location')},
+    });
+  });
+
+  it('valid input with an unlisted extra property is passed through to the executor unchanged exactly once', async () => {
+    const executor = jest.fn<ToolExecutor>(async () => 'success');
+    const registry = setupRegistry(
+      {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      executor
+    );
+    const input = {location: 'paris', extra: 123};
+    await registry.execute('test-tool', input);
+    expect(executor).toHaveBeenCalledWith(input, undefined);
+  });
+
+  it('rejects a wrong-typed field with a message naming the field path and expected type without offending value', async () => {
+    let executorCalled = false;
+    const registry = setupRegistry({type: 'object', properties: {location: {type: 'string'}}}, async () => {
+      executorCalled = true;
+      return 'success';
+    });
+    const result = (await registry.execute('test-tool', {location: 123})) as {result: string};
+    expect({
+      called: executorCalled,
+      hasLocation: result.result.includes('location'),
+      hasString: result.result.includes('string'),
+      has123: result.result.includes('123'),
+    }).toEqual({
+      called: false,
+      hasLocation: true,
+      hasString: true,
+      has123: false,
+    });
+  });
+
+  it('throws at register time for an uncompilable schema naming the tool', () => {
+    expect(() => {
+      setupRegistry({type: 'invalid-type'}, async () => 'success');
+    }).toThrow(/test-tool/);
+  });
+
+  it('validates a function-valued tool definition against the schema current at that call', async () => {
+    const registry = new ToolRegistry();
+    let schemaType = 'string';
+    const source = () =>
+      ({
+        name: 'dynamic-tool',
+        description: 'Dynamic tool',
+        inputSchema: {type: 'object', properties: {value: {type: schemaType}}},
+      }) as ToolDefinition;
+    registry.register(source, async () => 'success');
+
+    await registry.execute('dynamic-tool', {value: 'test'});
+    schemaType = 'number';
+    const result2 = (await registry.execute('dynamic-tool', {value: 'test'})) as {result?: string};
+    expect(result2.result).toBeDefined();
+  });
+
+  it('compiles a static tool schema once across multiple execute calls', async () => {
+    const registry = new ToolRegistry();
+    let getterCalled = 0;
+    const def = {name: 'static-tool', description: 'Static tool'} as ToolDefinition;
+    Object.defineProperty(def, 'inputSchema', {
+      get: () => {
+        getterCalled++;
+        return {type: 'object', properties: {val: {type: 'string'}}};
+      },
+    });
+    registry.register(def, async () => 'success');
+    for (let i = 0; i < 10; i++) {
+      await registry.execute('static-tool', {val: 'test'});
+    }
+    expect(getterCalled).toBe(1);
+  });
+
+  it('throws Unknown tool for an unregistered name', async () => {
+    const registry = new ToolRegistry();
+    await expect(registry.execute('unknown-tool', {})).rejects.toThrow('Unknown tool: unknown-tool');
