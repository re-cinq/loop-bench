+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+export const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+export const TEST_TIMESTAMP = '2026-10-20T12:00:00.000Z';
+
+export const sessionWith = (content: string): ChatSession => ({
+  sessionId: 'test-session',
+  userId: 'user-1',
+  entries: [{role: 'user', content, timestamp: TEST_TIMESTAMP}],
+});
+
+export const rejectingWith = (reason: unknown): AIProvider => ({
+  // eslint-disable-next-line require-yield
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    throw reason;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
