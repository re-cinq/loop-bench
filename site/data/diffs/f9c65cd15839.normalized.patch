         if (hooks?.afterModelResponse) await hooks.afterModelResponse(session, responseText, totalUsage);
       } catch (error) {
-        if (hooks?.onError && error instanceof Error) {
-          await hooks.onError(session, error);
+        if (hooks?.onError) {
+          const message = getErrorMessage(error);
+          const errorInstance = error instanceof Error ? error : new Error(message, {cause: error});
+          await hooks.onError(session, errorInstance);
         }
         throw error;
       } finally {
@@ -339,7 +341,17 @@ async function saveSession(store: SessionStore | undefined, session: ChatSession
   try {
     await store.save(session);
   } catch (error) {
-    const message = error instanceof Error ? error.message : String(error);
+    const message = getErrorMessage(error);
     log.error('orchestrator', 'session save failed', {sessionId: session.sessionId, error: message});
   }
 }
+
+function getErrorMessage(error: unknown): string {
+  if (typeof error !== 'object' || error === null) {
+    return String(error);
+  }
+  if ('message' in error && typeof (error as {message: unknown}).message === 'string') {
+    return (error as {message: string}).message;
+  }
+  return String(error);
+}
