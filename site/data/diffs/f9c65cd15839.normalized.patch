+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {promptBuilder, sessionWith, rejectingWith} from './testSupport.js';
+
+describe('ChatOrchestrator onError on non-Error rejections (round test)', () => {
+  async function runTest(rejection: unknown) {
+    let receivedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        receivedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(rejectingWith(rejection), promptBuilder, undefined, {hooks});
+
+    let thrown: unknown;
+    let thrownSeen = false;
+    try {
+      await orchestrator.processMessage(sessionWith('hello'));
+    } catch (e) {
+      thrown = e;
+      thrownSeen = true;
+    }
+
+    return {thrown, thrownSeen, receivedError};
+  }
+
+  async function assertRejection(reason: unknown, expectedMessage: string) {
+    const {thrown, thrownSeen, receivedError} = await runTest(reason);
+
+    expect({
+      thrownSeen,
+      thrown,
+      isError: receivedError instanceof Error,
+      message: receivedError?.message,
+      cause: receivedError?.cause,
+    }).toEqual({
+      thrownSeen: true,
+      thrown: reason,
+      isError: true,
+      message: expectedMessage,
+      cause: reason,
+    });
+  }
+
+  it('calls onError with an Error when provider rejects with a string', async () => {
+    await assertRejection('string boom', 'string boom');
+  });
+
+  it('calls onError with an Error when provider rejects with a plain object', async () => {
+    const reason = {code: 500, message: 'internal error'};
+    await assertRejection(reason, 'internal error');
+  });
+
+  it('calls onError with an Error when provider rejects with undefined', async () => {
+    await assertRejection(undefined, 'undefined');
+  });
+
+  it('calls onError with an Error when provider rejects with null', async () => {
+    await assertRejection(null, 'null');
+  });
+});
