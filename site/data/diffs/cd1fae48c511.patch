 export function extractUsage(chunk: MessageChunk): UsageMetadata | undefined {
   return chunk.type === 'stop' ? chunk.usage : undefined;
 }
+
+export function accumulateUsage(
+  acc: UsageMetadata | undefined,
+  next: UsageMetadata | undefined
+): UsageMetadata | undefined {
+  if (!next) return acc;
+  if (!acc) return next;
+  return {
+    inputTokens: acc.inputTokens + next.inputTokens,
+    outputTokens: acc.outputTokens + next.outputTokens,
+    totalTokens: acc.totalTokens + next.totalTokens,
+  };
+}
diff --git a/src/orchestration/turnUsage.acceptance.test.ts b/src/orchestration/turnUsage.acceptance.test.ts
new file mode 100644
index 0000000..68c5cfa
--- /dev/null
+++ b/src/orchestration/turnUsage.acceptance.test.ts
@@ -0,0 +1,73 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {setLogger} from '../shared/logger.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// Each provider call reports its own usage on its stop chunk; the hook must see the whole turn, not its last leg.
+
+const ROUND_1: UsageMetadata = {inputTokens: 100, outputTokens: 10, totalTokens: 110};
+const ROUND_2: UsageMetadata = {inputTokens: 200, outputTokens: 20, totalTokens: 220};
+const ROUND_3: UsageMetadata = {inputTokens: 400, outputTokens: 40, totalTokens: 440};
+
+const askForTool = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id: 'c', name: 'lookup', input: {}}},
+  {type: 'stop', stopReason: 'tool_use', usage},
+];
+const finish = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'Done.'},
+  {type: 'stop', stopReason: 'end_turn', usage},
+];
+
+// Two tool rounds, then an answer: three provider calls, each reporting the usage given for it.
+const reportedUsage = async (rounds: [UsageMetadata?, UsageMetadata?, UsageMetadata?]) => {
+  const script = [askForTool(rounds[0]), askForTool(rounds[1]), finish(rounds[2])];
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Looks something up.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  let call = 0;
+  const provider: AIProvider = {
+    async *sendMessage() {
+      yield* script[call++];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const reports: Array<UsageMetadata | undefined> = [];
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Usage test.'}), registry, {
+    hooks: {afterModelResponse: async (_session, _text, usage) => void reports.push(usage)},
+  });
+  const session: ChatSession = {sessionId: 's', userId: 'u', entries: [{role: 'user', content: 'go', timestamp: 't'}]};
+  await orchestrator.processMessage(session);
+  return {providerCalls: call, reports};
+};
+
+describe('the usage afterModelResponse reports for a turn', () => {
+  const noop = () => undefined;
+  beforeEach(() => setLogger({debug: noop, info: noop, warn: noop, error: noop}));
+  afterEach(() => setLogger());
+
+  it('covers every provider call of a turn driven through two tool rounds', async () => {
+    const {providerCalls, reports} = await reportedUsage([ROUND_1, ROUND_2, ROUND_3]);
+
+    expect({providerCalls, hookCalls: reports.length, usage: reports[0]}).toMatchObject({
+      providerCalls: 3,
+      hookCalls: 1,
+      usage: {inputTokens: 700, outputTokens: 70, totalTokens: 770},
+    });
+  });
+
+  it('counts the rounds that reported usage, and reports none when no round did', async () => {
+    const partial = await reportedUsage([ROUND_1, undefined, ROUND_3]);
+    const none = await reportedUsage([undefined, undefined, undefined]);
+
+    expect({partial: partial.reports, none: none.reports}).toEqual({
+      partial: [expect.objectContaining({inputTokens: 500, outputTokens: 50, totalTokens: 550})],
+      none: [undefined],
+    });
+  });
+});