+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+describe('ChatOrchestrator onError rejection cause', () => {
+  const rejectThroughHook = async (reason: unknown) => {
+    const provider: AIProvider = {
+      // eslint-disable-next-line require-yield
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        throw reason;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    let seenError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        seenError = error;
+      },
+    };
+    const session: ChatSession = {
+      sessionId: 'cause-test',
+      userId: 'user-1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), undefined, {hooks});
+    const outcome = await orchestrator.processMessage(session).then(
+      () => ({rejected: false, reason: undefined}),
+      (thrown: unknown) => ({rejected: true, reason: thrown})
+    );
+
+    return {seenError, outcome};
+  };
+
+  // spec: specs/hal-engine-config-hooks/spec.md#8
+  it('wraps a thrown string with its original value as cause and rethrows the string', async () => {
+    const reason = 'string boom';
+    const {seenError, outcome} = await rejectThroughHook(reason);
+
+    expect({isError: seenError instanceof Error, cause: seenError?.cause, outcome}).toEqual({
+      isError: true,
+      cause: reason,
+      outcome: {rejected: true, reason},
+    });
+  });
+
+  // spec: specs/hal-engine-config-hooks/spec.md#8
+  it('passes a rejected Error instance to onError unchanged', async () => {
+    const reason = new Error('provider failed');
+    const {seenError} = await rejectThroughHook(reason);
+
+    expect(seenError).toBe(reason);
+  });
+});
