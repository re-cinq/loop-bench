+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry', () => {
+  it('throws at register time naming the tool when a static inputSchema cannot be compiled', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_forecast',
+          description: 'declares an impossible property type',
+          inputSchema: {type: 'object', properties: {zone: {type: 'not-a-json-schema-type'}}},
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken_forecast/);
+  });
+
+  it('validates each call against the schema the definition function returns for that call', async () => {
+    let schema: Record<string, unknown> = {
+      type: 'object',
+      required: ['region'],
+      properties: {region: {type: 'string'}},
+    };
+    const registry = new ToolRegistry();
+    registry.register(
+      () => ({
+        name: 'versioned_lookup',
+        description: 'the returned schema can change between calls',
+        inputSchema: schema,
+      }),
+      async () => 'ok'
+    );
+
+    const first = await registry.execute('versioned_lookup', {city: 'Paris'});
+    const second = await registry.execute('versioned_lookup', {region: 'eu-west-1'});
+    schema = {type: 'object', required: ['city'], properties: {city: {type: 'string'}}};
+    const third = await registry.execute('versioned_lookup', {region: 'eu-west-1'});
+
+    expect({
+      firstNamesRegion: /region/.test(first.result),
+      secondRuns: second.result,
+      thirdNamesCity: /city/.test(third.result),
+    }).toEqual({firstNamesRegion: true, secondRuns: 'ok', thirdNamesCity: true});
+  });
+
+  it('passes an undeclared extra property through to the executor unchanged and calls it once', async () => {
+    const received: Array<Record<string, unknown>> = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'echo_note',
+        description: 'echoes its input back',
