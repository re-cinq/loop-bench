diff --git a/src/orchestration/chatOrchestrator.acceptance.test.ts b/src/orchestration/chatOrchestrator.acceptance.test.ts
new file mode 100644
index 0000000..4b7d14b
--- /dev/null
+++ b/src/orchestration/chatOrchestrator.acceptance.test.ts
@@ -0,0 +1,100 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AccumulatedUsageMetadata, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import {scriptedProvider} from './orchestratorTestSupport.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'System prompt'});
+
+const TOOL_CALL: MessageChunk = {
+  type: 'tool_use',
+  toolCall: {id: 'call_1', name: 'test_tool', input: {}},
+};
+
+async function runTurn(rounds: MessageChunk[][]): Promise<AccumulatedUsageMetadata | undefined> {
+  let receivedUsage: AccumulatedUsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      receivedUsage = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(scriptedProvider(rounds), promptBuilder, registryReturning('result'), {
+    hooks,
+  });
+  await orchestrator.processMessage(createSession('ask'));
+  return receivedUsage;
+}
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function registryReturning(resultText: string): ToolRegistry {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'test_tool', description: 'A test tool', inputSchema: {type: 'object', properties: {}}},
+    async () => ({result: resultText})
+  );
+  return registry;
+}
+
+describe('Report usage across every tool round', () => {
+  it('A turn driven through two tool rounds reports usage covering every provider call in that turn', async () => {
+    const usage = await runTurn([
