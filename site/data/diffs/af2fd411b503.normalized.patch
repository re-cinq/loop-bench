 export function shouldContinueToolLoop(
@@ -40,3 +40,15 @@ export function extractStopReason(chunk: MessageChunk): string | null {
 export function extractUsage(chunk: MessageChunk): UsageMetadata | undefined {
   return chunk.type === 'stop' ? chunk.usage : undefined;
 }
+
+export function accumulateUsage(rounds: (UsageMetadata | undefined)[]): AccumulatedUsageMetadata | undefined {
+  if (rounds.length === 1) return rounds[0];
+  const reported = rounds.filter((u): u is UsageMetadata => u !== undefined);
+  if (reported.length === 0) return undefined;
+  return {
+    inputTokens: reported.reduce((s, u) => s + u.inputTokens, 0),
+    outputTokens: reported.reduce((s, u) => s + u.outputTokens, 0),
+    totalTokens: reported.reduce((s, u) => s + u.totalTokens, 0),
+    providerCalls: reported,
+  };
+}
