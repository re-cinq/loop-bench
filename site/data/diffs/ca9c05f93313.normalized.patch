@@ -40,3 +40,16 @@ export function extractStopReason(chunk: MessageChunk): string | null {
 export function extractUsage(chunk: MessageChunk): UsageMetadata | undefined {
   return chunk.type === 'stop' ? chunk.usage : undefined;
 }
+
+// `onError` is typed against Error, so a rejection that is not one still reaches the hook wrapped, original as cause.
+export function toError(reason: unknown): Error {
+  if (reason instanceof Error) return reason;
+
+  let message: string;
+  try {
+    message = typeof reason === 'string' ? reason : (JSON.stringify(reason) ?? String(reason));
+  } catch {
+    message = String(reason);
+  }
+  return new Error(message, {cause: reason});
+}
