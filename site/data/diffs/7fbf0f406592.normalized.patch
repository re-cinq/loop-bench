+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolResponse} from './tools/registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+// A provider that yields scripted rounds with explicit usage values for each round
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryReturning = (response: ToolResponse): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => response
+  );
+  return registry;
+};
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+const STOP_FOR_TOOL: MessageChunk = {type: 'stop', stopReason: 'tool_use'};
+const STOP_DONE: MessageChunk = {type: 'stop', stopReason: 'end_turn'};
+
+describe('ChatOrchestrator usage accumulation (acceptance)', () => {
+  it('reports accumulated usage across all tool rounds, not just the last', async () => {
+    // Round 1: tool call with usage
+    const round1Usage: UsageMetadata = {inputTokens: 100, outputTokens: 50, totalTokens: 150};
+    // Round 2: final response with different usage
+    const round2Usage: UsageMetadata = {inputTokens: 200, outputTokens: 75, totalTokens: 275};
+
+    let receivedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: round1Usage}],
+        [
+          {type: 'text', text: 'the answer'},
+          {type: 'stop', stopReason: 'end_turn', usage: round2Usage},
+        ],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'found it'}),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    // Should accumulate: 100+200=300 input, 50+75=125 output, 150+275=425 total
+    expect(receivedUsage).toEqual({inputTokens: 300, outputTokens: 125, totalTokens: 425});
+  });
+
+  it('preserves the baseline: a turn with no tool calls reports usage as before', async () => {
+    const usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    let receivedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, u) => {
+        receivedUsage = u;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [
+          {type: 'text', text: 'hello world'},
+          {type: 'stop', stopReason: 'end_turn', usage},
+        ],
+      ]),
+      promptBuilder,
+      undefined,
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('hi'));
+
+    // Single round: no accumulation needed, should be exactly what was reported
+    expect(receivedUsage).toEqual(usage);
+  });
+
+  it('handles missing usage in intermediate rounds gracefully', async () => {
+    // Round 1: no usage reported
+    // Round 2: has usage
+    const round2Usage: UsageMetadata = {inputTokens: 200, outputTokens: 75, totalTokens: 275};
+
+    let receivedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}], // no usage
+        [
+          {type: 'text', text: 'the answer'},
+          {type: 'stop', stopReason: 'end_turn', usage: round2Usage},
+        ],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'found it'}),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    // Should report the usage from round 2, not undefined or NaN
+    expect(receivedUsage).toEqual(round2Usage);
+  });
+
+  it('handles multiple rounds where some report usage and some do not', async () => {
+    const round1Usage: UsageMetadata = {inputTokens: 100, outputTokens: 50, totalTokens: 150};
+    // Round 2: no usage reported (e.g., for an internal call)
+    const round3Usage: UsageMetadata = {inputTokens: 250, outputTokens: 80, totalTokens: 330};
+
+    let receivedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: round1Usage}],
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}], // no usage
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn', usage: round3Usage},
+        ],
+      ]),
+      promptBuilder,
+      registryReturning({result: 'found it'}),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    // Should accumulate: 100+250=350 input, 50+80=130 output, 150+330=480 total
+    expect(receivedUsage).toEqual({inputTokens: 350, outputTokens: 130, totalTokens: 480});
+  });
+
+  it('reports undefined when no rounds report any usage', async () => {
+    let receivedUsage: UsageMetadata | undefined = {inputTokens: 999, outputTokens: 999, totalTokens: 999};
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}], // no usage
+        [
+          {type: 'text', text: 'the answer'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ], // no usage
+      ]),
+      promptBuilder,
+      registryReturning({result: 'found it'}),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    // Should be undefined, not NaN or some other falsy value
+    expect(receivedUsage).toBeUndefined();
+  });
+});
