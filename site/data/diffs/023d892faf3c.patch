+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+const STOP_FOR_TOOL: MessageChunk = {type: 'stop', stopReason: 'tool_use'};
+const STOP_DONE: MessageChunk = {type: 'stop', stopReason: 'end_turn'};
+
+// Scripted provider that yields multiple rounds with known token counts
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryReturning = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found it',
+  }));
+  return registry;
+};
+
+describe('ChatOrchestrator usage accumulation across tool rounds (acceptance)', () => {
+  it('accumulates usage across two tool rounds and reports the sum to afterModelResponse', async () => {
+    const round1Usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const round2Usage: UsageMetadata = {inputTokens: 15, outputTokens: 8, totalTokens: 23};
+    let receivedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: round1Usage}],
+        [
+          {type: 'text', text: 'answer'},
+          {type: 'stop', stopReason: 'end_turn', usage: round2Usage},
+        ],
+      ]),
+      promptBuilder,
+      registryReturning(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(receivedUsage).toEqual({
+      inputTokens: 25,
+      outputTokens: 13,
+      totalTokens: 38,
+    });
+  });
+
+  it('reports usage from a single round (no tool calls) without modification, preserving backward compatibility', async () => {
+    const usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    let receivedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, u) => {
+        receivedUsage = u;
+      },
+    };
+
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        yield {type: 'text', text: 'answer without tools'};
+        yield {type: 'stop', stopReason: 'end_turn', usage};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(receivedUsage).toEqual(usage);
+  });
+
+  it('handles a round with no usage followed by a round with usage', async () => {
+    const round2Usage: UsageMetadata = {inputTokens: 20, outputTokens: 10, totalTokens: 30};
+    let receivedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}], // No usage reported
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn', usage: round2Usage},
+        ],
+      ]),
+      promptBuilder,
+      registryReturning(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(receivedUsage).toEqual(round2Usage);
+  });
+
+  it('handles a round with usage followed by a round with no usage', async () => {
+    const round1Usage: UsageMetadata = {inputTokens: 15, outputTokens: 8, totalTokens: 23};
+    let receivedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: round1Usage}],
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ], // No usage reported
+      ]),
+      promptBuilder,
+      registryReturning(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(receivedUsage).toEqual(round1Usage);
+  });
+
+  it('handles three tool rounds accumulating usage across all of them', async () => {
+    const round1Usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const round2Usage: UsageMetadata = {inputTokens: 12, outputTokens: 4, totalTokens: 16};
+    const round3Usage: UsageMetadata = {inputTokens: 8, outputTokens: 3, totalTokens: 11};
+    let receivedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: round1Usage}],
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: round2Usage}],
+        [
+          {type: 'text', text: 'final answer'},
+          {type: 'stop', stopReason: 'end_turn', usage: round3Usage},
+        ],
+      ]),
+      promptBuilder,
+      registryReturning(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(receivedUsage).toEqual({
+      inputTokens: 30,
+      outputTokens: 12,
+      totalTokens: 42,
+    });
+  });
+
+  it('does not report undefined or NaN when some rounds report no usage', async () => {
+    const round1Usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    let receivedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: round1Usage}],
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}], // No usage
+        [
+          {type: 'text', text: 'final'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ], // No usage
+      ]),
+      promptBuilder,
+      registryReturning(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(receivedUsage).toBeDefined();
+    expect(receivedUsage).not.toBe(undefined);
+    expect(Number.isNaN(receivedUsage?.inputTokens)).toBe(false);
+    expect(Number.isNaN(receivedUsage?.outputTokens)).toBe(false);
+    expect(Number.isNaN(receivedUsage?.totalTokens)).toBe(false);
+    expect(receivedUsage).toEqual(round1Usage);
+  });
+
+  it('handles zero usage across all rounds', async () => {
+    let receivedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}], // No usage
+        [
+          {type: 'text', text: 'done'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ], // No usage
+      ]),
+      promptBuilder,
+      registryReturning(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(receivedUsage).toBeUndefined();
+  });
+
+  it('accumulates usage with partial zero rounds in the middle', async () => {
+    const round1Usage: UsageMetadata = {inputTokens: 5, outputTokens: 2, totalTokens: 7};
+    const round3Usage: UsageMetadata = {inputTokens: 8, outputTokens: 3, totalTokens: 11};
+    let receivedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: round1Usage}],
+        [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}], // No usage
+        [
+          {type: 'text', text: 'final'},
+          {type: 'stop', stopReason: 'end_turn', usage: round3Usage},
+        ],
+      ]),
+      promptBuilder,
+      registryReturning(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(receivedUsage).toEqual({
+      inputTokens: 13,
+      outputTokens: 5,
+      totalTokens: 18,
+    });
+  });
+});