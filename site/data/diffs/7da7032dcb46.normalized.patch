@@ -0,0 +1,47 @@
+import {createHalEngine} from '../config.js';
+import type {ChatSession} from '../types/session.js';
+import type {WsAuthenticator} from '../types/auth.js';
+
+// spec: specs/hal-engine-config-hooks#7
+describe('beforeSession failure lifecycle', () => {
+  it('rejects unchanged while running onError and afterSession in order', async () => {
+    const failure = new Error('beforeSession failed');
+    const order: string[] = [];
+    let onErrorArgs: {session: ChatSession; error: Error} | undefined;
+    let afterSessionArg: ChatSession | undefined;
+    const engine = createHalEngine({
+      provider: {type: 'mock'},
+      prompt: {identity: 'test'},
+      auth: {ws: (async () => null) as unknown as WsAuthenticator},
+      orchestrator: {
+        hooks: {
+          beforeSession: async () => {
+            order.push('beforeSession');
+            throw failure;
+          },
+          onError: async (session, error) => {
+            order.push('onError');
+            onErrorArgs = {session, error};
+          },
+          afterSession: async session => {
+            order.push('afterSession');
+            afterSessionArg = session;
+          },
+        },
+      },
+    });
+    const session: ChatSession = {
+      sessionId: 'before-session-failure',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: ''}],
+    };
+
+    await expect(engine.orchestrator.processMessage(session)).rejects.toBe(failure);
+
+    expect({order, onErrorArgs, afterSessionArg}).toEqual({
+      order: ['beforeSession', 'onError', 'afterSession'],
+      onErrorArgs: {session, error: failure},
+      afterSessionArg: session,
+    });
+  });
+});
