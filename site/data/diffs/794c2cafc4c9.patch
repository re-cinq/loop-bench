+import Ajv from 'ajv';
+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {Logger} from '../../shared/logger.js';
+
+describe('ToolRegistry', () => {
+  afterEach(() => {
+    setLogger(undefined);
+  });
+
+  it('throws at registration time naming the tool for an uncompilable schema', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'broken_lookup',
+          description: 'Tool with an invalid JSON Schema type',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              query: {type: 'not-a-json-schema-type'},
+            },
+          },
+        },
+        async () => 'unreachable'
+      )
+    ).toThrow(/broken_lookup/);
+  });
+
+  it('passes through extra properties to the executor unchanged', async () => {
+    const registry = new ToolRegistry();
+    let receivedInput: any;
+    registry.register(
+      {
+        name: 'test_tool',
+        description: 'test',
+        inputSchema: {type: 'object', properties: {a: {type: 'string'}}},
+      },
+      async input => {
+        receivedInput = input;
+        return 'ok';
+      }
+    );
+
+    const input = {a: 'hello', extra: 123};
+    await registry.execute('test_tool', input);
+
+    expect(receivedInput).toEqual({a: 'hello', extra: 123});
+  });
+
+  it('throws Unknown tool: <name> for an unregistered name', async () => {
+    const registry = new ToolRegistry();
+    await expect(registry.execute('missing', {})).rejects.toThrow('Unknown tool: missing');
+  });
+
+  it('validates against the current schema for function-valued definitions', async () => {
+    const registry = new ToolRegistry();
+    let schema: any = {type: 'object', properties: {a: {type: 'string'}}};
+
+    registry.register(
+      () => ({
+        name: 'dynamic_tool',
+        description: 'dynamic',
+        inputSchema: schema,
+      }),
+      async () => 'ok'
+    );
+
+    // First call: 'a' is string
+    const resp1 = await registry.execute('dynamic_tool', {a: 123});
+    expect(resp1.result).toContain('a:');
+    expect(resp1.result.toLowerCase()).toContain('string');
+
+    // Change schema object: 'a' is now number
+    schema = {type: 'object', properties: {a: {type: 'number'}}};
+    const resp2 = await registry.execute('dynamic_tool', {a: 'hello'});
+    expect(resp2.result).toContain('a:');
+    expect(resp2.result.toLowerCase()).toContain('number');
+  });
+
+  it("asserts a static tool's schema is compiled once across ten execute calls", async () => {
+    const originalCompile = Ajv.prototype.compile;
+    let callCount = 0;
+    Ajv.prototype.compile = function (...args: any[]) {
+      callCount++;
+      return originalCompile.apply(this, args);
+    };
+
+    try {
+      const registry = new ToolRegistry();
+
+      registry.register(
+        {
+          name: 'static_tool',
+          description: 'static',
+          inputSchema: {type: 'object', properties: {a: {type: 'string'}}},
+        },
+        async () => 'ok'
+      );
+
+      // Initial compile at registration
+      expect(callCount).toBe(1);
+
+      for (let i = 0; i < 10; i++) {
+        await registry.execute('static_tool', {a: 'hello'});
+      }
+
+      // Should still be 1 (cached)
+      expect(callCount).toBe(1);
+    } finally {
+      Ajv.prototype.compile = originalCompile;
+    }
+  });
+
+  it('redacts property values from rejection messages and logs', async () => {
+    const recordedLogs: any[] = [];
+    const logger: Logger = {
+      debug: () => {},
+      info: () => {},
+      warn: (_cat, _msg, fields) => recordedLogs.push(fields),
+      error: () => {},
+    };
+    setLogger(logger);
+
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'secret_tool',
+        description: 'test',
+        inputSchema: {
+          type: 'object',
+          properties: {secret: {type: 'string'}},
+          required: ['secret'],
+        },
+      },
+      async () => 'ok'
+    );
+
+    const sensitiveValue = 'MY-SECRET-123';
+    const resp = await registry.execute('secret_tool', {secret: 123}); // Wrong type
+
+    expect(resp.result).toContain('secret');
+    expect(resp.result).not.toContain(sensitiveValue);
+    expect(recordedLogs.some(f => JSON.stringify(f).includes(sensitiveValue))).toBe(false);
+  });
+});
