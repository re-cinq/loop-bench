+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+describe('ToolRegistry', () => {
+  afterEach(() => {
+    setLogger(undefined);
+  });
+
+  it('rejects input missing a required property without calling the executor', async () => {
+    const registry = new ToolRegistry();
+    let callCount = 0;
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async () => {
+        callCount += 1;
+        return 'sunny';
+      }
+    );
+
+    const response = await registry.execute('get_weather', {});
+
+    expect({
+      callCount,
+      namesLocationAsRequired: response.result.includes('location') && /required/i.test(response.result),
+    }).toEqual({
+      callCount: 0,
+      namesLocationAsRequired: true,
+    });
+  });
+
+  it('rejects a wrong-typed field naming the field path and expected type without leaking the value to the result or logs', async () => {
+    const logged: string[] = [];
+    const record = (category: string, message: string, fields?: Record<string, unknown>): void => {
+      logged.push(JSON.stringify({category, message, fields}));
+    };
+    setLogger({debug: record, info: record, warn: record, error: record});
+
+    const registry = new ToolRegistry();
+    let callCount = 0;
+    registry.register(
+      {
+        name: 'lookup_customer',
+        description: 'Lookup customer',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            taxId: {type: 'string'},
+          },
+          required: ['taxId'],
+        },
+      },
+      async () => {
+        callCount += 1;
+        return 'ok';
+      }
+    );
+
+    const offendingNumber = 987654321;
+    const response = await registry.execute('lookup_customer', {taxId: offendingNumber});
+    const secretText = String(offendingNumber);
+
+    expect({
+      callCount,
+      namesFieldPath: response.result.includes('taxId'),
+      namesExpectedType: response.result.includes('string'),
+      leakedInResult: response.result.includes(secretText),
+      leakedInLogs: logged.some(line => line.includes(secretText)),
+    }).toEqual({
+      callCount: 0,
+      namesFieldPath: true,
+      namesExpectedType: true,
+      leakedInResult: false,
+      leakedInLogs: false,
+    });
+  });
+
+  it('passes valid input with an unlisted extra property through to the executor unchanged', async () => {
+    const registry = new ToolRegistry();
+    const receivedInputs: Record<string, unknown>[] = [];
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+            units: {type: 'string', enum: ['celsius', 'fahrenheit'], default: 'celsius'},
+          },
+          required: ['location'],
+        },
+      },
+      async input => {
+        receivedInputs.push(input);
+        return `weather in ${String(input.location)}`;
+      }
+    );
+
+    const response = await registry.execute('get_weather', {location: 'Berlin', extraTag: 'preserve-me'});
+
+    expect({response, receivedInputs}).toEqual({
+      response: {result: 'weather in Berlin'},
+      receivedInputs: [{location: 'Berlin', extraTag: 'preserve-me'}],
+    });
+  });
+
+  it('throws Unknown tool when execute is called with an unregistered name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('unregistered_tool', {})).rejects.toThrow('Unknown tool: unregistered_tool');
+  });
+
+  it('throws at registration time for an uncompilable schema and names the tool', async () => {
+    const registry = new ToolRegistry();
+    const invalidTool: ToolDefinition = {
+      name: 'bad_schema_tool',
+      description: 'Carries an invalid schema type',
+      inputSchema: {type: 'not-a-json-schema-type'},
+    };
+
+    const caughtError = await Promise.resolve()
+      .then(() => registry.register(invalidTool, async () => 'unused'))
+      .catch((error: Error) => error);
+
+    expect({
+      namesTool: Boolean(caughtError?.message.includes('bad_schema_tool')),
+      preservesCause: caughtError?.cause instanceof Error,
+    }).toEqual({
+      namesTool: true,
+      preservesCause: true,
+    });
+  });
+
+  it('compiles a static tool schema once at register time across ten execute calls', async () => {
+    const registry = new ToolRegistry();
+    let schemaReads = 0;
+    let executions = 0;
+    const rawSchema: ToolDefinition['inputSchema'] = {
+      type: 'object',
+      properties: {city: {type: 'string'}},
+      required: ['city'],
+    };
+    const definition: ToolDefinition = {
+      name: 'static_weather',
+      description: 'Static tool',
+      get inputSchema(): ToolDefinition['inputSchema'] {
+        schemaReads += 1;
+        return rawSchema;
+      },
+    };
+
+    registry.register(definition, async () => {
+      executions += 1;
+      return 'ok';
+    });
+    const readsAtRegister = schemaReads;
+    for (let i = 0; i < 10; i += 1) {
+      await registry.execute('static_weather', {city: 'Berlin'});
+    }
+
+    expect({readsAtRegister, readsAfterTenCalls: schemaReads, executions}).toEqual({
+      readsAtRegister: 1,
+      readsAfterTenCalls: 1,
+      executions: 10,
+    });
+  });
+
+  it('validates a function-valued tool definition against the schema returned for each call', async () => {
+    const registry = new ToolRegistry();
+    const citySchema: ToolDefinition['inputSchema'] = {
+      type: 'object',
+      properties: {city: {type: 'string'}},
+      required: ['city'],
+    };
+    const zipSchema: ToolDefinition['inputSchema'] = {
+      type: 'object',
+      properties: {zip: {type: 'string'}},
+      required: ['zip'],
+    };
+    let activeSchema = citySchema;
+    registry.register(
+      () => ({
+        name: 'dynamic_lookup',
+        description: 'Dynamic tool',
+        inputSchema: activeSchema,
+      }),
+      async input => `ok:${Object.keys(input).join(',')}`
+    );
+
+    const firstValid = await registry.execute('dynamic_lookup', {city: 'Rome'});
+    const secondInvalidCached = await registry.execute('dynamic_lookup', {zip: '00100'});
+    activeSchema = zipSchema;
+    const thirdStaleRejected = await registry.execute('dynamic_lookup', {city: 'Rome'});
+    const fourthValidNewSchema = await registry.execute('dynamic_lookup', {zip: '00100'});
+
+    expect({
+      firstValid: firstValid.result,
+      secondNamesCity: secondInvalidCached.result.includes('city'),
+      thirdNamesZip: thirdStaleRejected.result.includes('zip'),
+      fourthValidNewSchema: fourthValidNewSchema.result,
+    }).toEqual({
+      firstValid: 'ok:city',
+      secondNamesCity: true,
+      thirdNamesZip: true,
+      fourthValidNewSchema: 'ok:zip',
+    });
+  });
+});
