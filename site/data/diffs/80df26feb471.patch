+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolResponse} from './tools/registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function registryReturning(response: ToolResponse): ToolRegistry {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => response
+  );
+  return registry;
+}
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+const STOP_FOR_TOOL: MessageChunk = {type: 'stop', stopReason: 'tool_use'};
+const STOP_DONE: MessageChunk = {type: 'stop', stopReason: 'end_turn'};
+
+function scriptedProviderWithUsage(rounds: {chunks: MessageChunk[]; usage?: UsageMetadata}[]): AIProvider {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const currentRound = rounds[round++];
+      if (!currentRound) return;
+
+      for (const chunk of currentRound.chunks) yield chunk;
+      if (currentRound.usage) {
+        yield {type: 'stop', stopReason: 'end_turn', usage: currentRound.usage};
+      }
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator usage accumulation acceptance tests', () => {
+  it('accumulates usage across multiple tool rounds, reporting the sum to afterModelResponse', async () => {
+    const firstRoundUsage: UsageMetadata = {inputTokens: 100, outputTokens: 50, totalTokens: 150};
+    const secondRoundUsage: UsageMetadata = {inputTokens: 80, outputTokens: 40, totalTokens: 120};
+
+    let receivedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const provider = scriptedProviderWithUsage([
+      {chunks: [TOOL_CALL, STOP_FOR_TOOL], usage: firstRoundUsage},
+      {chunks: [{type: 'text', text: 'answer'}, STOP_DONE], usage: secondRoundUsage},
+    ]);
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registryReturning({result: 'found'}), {
+      hooks,
+    });
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(receivedUsage).toEqual({
+      inputTokens: 180,
+      outputTokens: 90,
+      totalTokens: 270,
+    });
+  });
+
+  it('maintains backward compatibility: a turn with no tool calls reports usage exactly as before', async () => {
+    const directResponseUsage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+
+    let receivedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const provider = scriptedProviderWithUsage([{chunks: [{type: 'text', text: 'done'}, STOP_DONE], usage: directResponseUsage}]);
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registryReturning({result: 'x'}), {hooks});
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(receivedUsage).toEqual(directResponseUsage);
+  });
+
+  it('handles partial usage gracefully: rounds that report no usage are skipped, not breaking accumulation', async () => {
+    const firstRoundUsage: UsageMetadata = {inputTokens: 100, outputTokens: 50, totalTokens: 150};
+    const secondRoundUsage: UsageMetadata = {inputTokens: 80, outputTokens: 40, totalTokens: 120};
+
+    let receivedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const provider = scriptedProviderWithUsage([
+      {chunks: [TOOL_CALL, STOP_FOR_TOOL], usage: firstRoundUsage},
+      {chunks: [{type: 'text', text: 'mid'}, STOP_FOR_TOOL]}, // No usage reported
+      {chunks: [{type: 'text', text: 'answer'}, STOP_DONE], usage: secondRoundUsage},
+    ]);
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registryReturning({result: 'found'}), {
+      hooks,
+    });
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(receivedUsage).toEqual({
+      inputTokens: 180,
+      outputTokens: 90,
+      totalTokens: 270,
+    });
+  });
+
+  it('reports no usage when no rounds report usage', async () => {
+    let receivedUsage: UsageMetadata | undefined = {inputTokens: 999, outputTokens: 999, totalTokens: 999};
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const provider = scriptedProviderWithUsage([
+      {chunks: [TOOL_CALL, STOP_FOR_TOOL]}, // No usage
+      {chunks: [{type: 'text', text: 'answer'}, STOP_DONE]}, // No usage
+    ]);
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registryReturning({result: 'found'}), {
+      hooks,
+    });
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(receivedUsage).toBeUndefined();
+  });
+});