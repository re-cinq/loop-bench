+import {describe, expect, it} from '@jest/globals';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function createMockProvider(): AIProvider {
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      yield {type: 'stop', stopReason: 'end_turn'};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are HAL.'});
+
+describe('onError for a beforeSession throw', () => {
+  it('hands onError the thrown error and the session it was processing', async () => {
+    const errorToThrow = new Error('allocation failed in beforeSession');
+    const session = createSession('hello');
+
+    let seenSession: ChatSession | undefined;
+    let seenError: Error | undefined;
+
+    const orchestrator = createChatOrchestrator(createMockProvider(), promptBuilder, undefined, {
+      hooks: {
+        beforeSession: async () => {
+          throw errorToThrow;
+        },
+        onError: async (hookSession, error) => {
+          seenSession = hookSession;
+          seenError = error;
+        },
+      },
+    });
+
+    // The rejection itself is pinned by the beforeSession acceptance test; this test pins the hook's arguments.
+    await orchestrator.processMessage(session).catch(() => undefined);
+
+    expect({error: seenError, session: seenSession}).toEqual({error: errorToThrow, session});
+  });
+});
