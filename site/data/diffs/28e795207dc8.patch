+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const usage = (inputTokens: number, outputTokens: number): UsageMetadata => ({
+  inputTokens,
+  outputTokens,
+  totalTokens: inputTokens + outputTokens,
+});
+
+// A round that asks for the lookup tool, reporting the given usage or none.
+const askForTool = (reported?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id: 'c', name: 'lookup', input: {}}},
+  {type: 'stop', stopReason: 'tool_use', usage: reported},
+];
+
+// A round that ends the turn with text, reporting the given usage or none.
+const finish = (reported?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'Done.'},
+  {type: 'stop', stopReason: 'end_turn', usage: reported},
+];
+
+// Each provider call plays the next scripted round; calling past the script fails the test rather than ending it quietly.
+function scriptedProvider(rounds: MessageChunk[][]): AIProvider {
+  let call = 0;
+  return {
+    async *sendMessage() {
+      const round = rounds[call++];
+      if (!round) throw new Error(`provider called ${call} times for a script of ${rounds.length} rounds`);
+      yield* round;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+// The usage afterModelResponse is handed for a turn that runs the given rounds.
+async function reportedUsageFor(rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> {
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, turnUsage) => {
+      reported = turnUsage;
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Looks something up.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  const orchestrator = createChatOrchestrator(
+    scriptedProvider(rounds),
+    new PromptBuilder({identity: 'Usage test.'}),
+    registry,
+    {hooks}
+  );
+  const session: ChatSession = {sessionId: 's', userId: 'u', entries: [{role: 'user', content: 'go', timestamp: 't'}]};
+  await orchestrator.processMessage(session);
+  return reported;
+}
+
+describe('usage across tool rounds', () => {
+  it('reports the summed usage of every provider call in a turn that ran two tool rounds', async () => {
+    const reported = await reportedUsageFor([
+      askForTool(usage(100, 20)),
+      askForTool(usage(300, 40)),
+      finish(usage(500, 60)),
+    ]);
+
+    expect(reported).toEqual({inputTokens: 900, outputTokens: 120, totalTokens: 1020});
+  });
+
+  it('leaves out a round that reports no usage, and reports nothing when no round reports', async () => {
+    const partial = await reportedUsageFor([askForTool(usage(100, 20)), askForTool(), finish(usage(50, 5))]);
+    const none = await reportedUsageFor([askForTool(), finish()]);
+
+    expect({partial, none}).toEqual({
+      partial: {inputTokens: 150, outputTokens: 25, totalTokens: 175},
+      none: undefined,
+    });
+  });
+});