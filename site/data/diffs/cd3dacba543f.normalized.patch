@@ -0,0 +1,67 @@
+import {ToolRegistry} from './registry.js';
+
+const definition = {
+  name: 'weather',
+  description: 'Get weather',
+  inputSchema: {
+    type: 'object',
+    properties: {location: {type: 'string'}},
+    required: ['location'],
+  },
+};
+
+describe('ToolRegistry input validation', () => {
+  // spec: specs/hal-engine-tool-input-validation#1
+  it('rejects input missing a required field before invoking the executor', async () => {
+    const registry = new ToolRegistry();
+    let callCount = 0;
+    const execute = async () => {
+      callCount += 1;
+      return 'forecast';
+    };
+    registry.register(definition, execute);
+
+    const response = await registry.execute('weather', {});
+
+    expect(response.result).toContain('location');
+    expect(response.result).toMatch(/required/i);
+    expect(callCount).toBe(0);
+  });
+
+  // spec: specs/hal-engine-tool-input-validation#2
+  it('rejects a wrong field type without including the supplied value', async () => {
+    const registry = new ToolRegistry();
+    let callCount = 0;
+    const execute = async () => {
+      callCount += 1;
+      return 'forecast';
+    };
+    registry.register(definition, execute);
+
+    const response = await registry.execute('weather', {location: 12345});
+
+    expect(response.result).toContain('location');
+    expect(response.result).toMatch(/string/i);
+    expect(response.result).not.toContain('12345');
+    expect(callCount).toBe(0);
+  });
+
+  // spec: specs/hal-engine-tool-input-validation#3
+  it('passes valid input and extra properties through unchanged', async () => {
+    const registry = new ToolRegistry();
+    let callCount = 0;
+    let receivedInput: Record<string, unknown> | undefined;
+    const execute = async (received: Record<string, unknown>) => {
+      callCount += 1;
+      receivedInput = received;
+      return 'forecast';
+    };
+    const input = {location: 'Berlin', units: 'celsius'};
+    registry.register(definition, execute);
+
+    await registry.execute('weather', input);
+
+    expect(callCount).toBe(1);
+    expect(receivedInput).toEqual(input);
+  });
+});
