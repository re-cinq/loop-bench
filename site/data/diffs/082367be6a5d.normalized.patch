@@ -0,0 +1,197 @@
+import {jest} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+import type {ToolResponse, ToolExecutor} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+describe('ToolRegistry', () => {
+  it('rejects input missing a required property and does not call executor', async () => {
+    const registry = new ToolRegistry();
+    const executor = jest.fn<ToolExecutor>().mockResolvedValue('success');
+
+    registry.register(
+      {
+        name: 'test_tool',
+        description: 'A test tool',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            location: {type: 'string'},
+          },
+          required: ['location'],
+        },
+      },
+      executor
+    );
+
+    const result = (await registry.execute('test_tool', {})) as ToolResponse;
+
+    const calls = executor.mock.calls;
+
+    expect({
+      called: calls.length,
+      hasLocation: /location/i.test(result.result),
+      hasRequired: /required/i.test(result.result),
+    }).toEqual({
+      called: 0,
+      hasLocation: true,
+      hasRequired: true,
+    });
+  });
+
+  it('throws at registration time for an uncompilable schema, naming the tool', () => {
+    const registry = new ToolRegistry();
+    expect(() =>
+      registry.register(
+        {
+          name: 'bad_tool',
+          description: 'A tool with a bad schema',
+          inputSchema: {type: 'not-a-type'},
+        },
+        jest.fn<ToolExecutor>()
+      )
+    ).toThrow(/bad_tool/);
+  });
+
+  it('compiles a static tool schema once across multiple execute calls', async () => {
+    const registry = new ToolRegistry();
+    let schemaAccesses = 0;
+
+    // A getter on inputSchema allows observing ajv.compile reads.
+    const definition = {
+      name: 'static_tool',
+      description: 'Test static tool',
+      get inputSchema() {
+        schemaAccesses++;
+        return {type: 'object', properties: {a: {type: 'string'}}};
+      },
+    };
+
+    registry.register(definition as unknown as ToolDefinition, jest.fn<ToolExecutor>().mockResolvedValue('ok'));
+
