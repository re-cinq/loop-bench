@@ -519,4 +519,57 @@ describe('ChatOrchestrator tool loop', () => {
 
     expect(seen).toEqual(usage);
   });
+
+  it('feeds a schema rejection to the provider as a tool_result and resolves on the corrected retry', async () => {
+    const registry = new ToolRegistry();
+    const executedInputs: Array<Record<string, unknown>> = [];
+    const toolResultTexts: string[] = [];
+    registry.register(
+      {
+        name: 'lookup',
+        description: 'looks things up',
+        inputSchema: {
+          type: 'object',
+          properties: {q: {type: 'string'}},
+          required: ['q'],
+        },
+      },
+      async input => {
+        executedInputs.push(input);
+        return {result: `found ${String(input.q)}`};
+      }
+    );
+    // One scripted round per sendMessage call, like scriptedProvider, so the provider can read each round's messages.
+    const rounds: MessageChunk[][] = [
+      [{type: 'tool_use', toolCall: {id: 'call-bad', name: 'lookup', input: {}}}, STOP_FOR_TOOL],
+      [{type: 'tool_use', toolCall: {id: 'call-good', name: 'lookup', input: {q: 'real query'}}}, STOP_FOR_TOOL],
+      [{type: 'text', text: 'the weather is sunny'}, STOP_DONE],
+    ];
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        const lastMessage = params.messages[params.messages.length - 1];
+        if (lastMessage.role === 'user' && Array.isArray(lastMessage.content)) {
+          toolResultTexts.push(...lastMessage.content.map(block => block.content));
+        }
+        for (const chunk of rounds[round++] ?? []) yield chunk;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+
+    const reply = await orchestrator.processMessage(createSession('ask'));
+
+    expect({
+      executedInputs,
+      rejectionReachedProvider: toolResultTexts.some(text => text.includes('q') && /required/i.test(text)),
+      reply,
+    }).toEqual({
+      executedInputs: [{q: 'real query'}],
+      rejectionReachedProvider: true,
+      reply: 'the weather is sunny',
+    });
+  });
 });
diff --git a/src/orchestration/tools/registry.acceptance.test.ts b/src/orchestration/tools/registry.acceptance.test.ts
