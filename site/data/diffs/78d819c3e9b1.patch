@@ -0,0 +1,225 @@
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+// Counting executors, since input validation is judged by whether the executor is reached at all.
+const countingExecutor =
+  (into: Array<Record<string, unknown>>, answer: string) =>
+  async (input: Record<string, unknown>): Promise<string> => {
+    into.push(input);
+    return answer;
+  };
+
+describe('ToolRegistry inputSchema validation', () => {
+  it('rejects input missing a required property and does not call the executor', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(
+      {
+        name: 'weather_lookup',
+        description: 'Look up current weather',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async () => {
+        calls += 1;
+        return 'sunny';
+      }
+    );
+
+    const response = await registry.execute('weather_lookup', {});
+
+    expect({
+      calls,
+      namesLocation: /location/.test(response.result),
+      namesRequired: /required/i.test(response.result),
+    }).toEqual({
+      calls: 0,
+      namesLocation: true,
+      namesRequired: true,
+    });
+  });
+
+  it('rejects a wrong-typed value naming the field path and expected type without echoing the value', async () => {
+    const registry = new ToolRegistry();
+    const executed: Array<Record<string, unknown>> = [];
+    registry.register(
+      {
+        name: 'record_search',
+        description: 'Search records by query text',
+        inputSchema: {
+          type: 'object',
+          properties: {query: {type: 'string'}},
+          required: ['query'],
+        },
+      },
+      countingExecutor(executed, 'found')
+    );
+
+    const response = await registry.execute('record_search', {query: 8675309});
+    const result = response.result;
+
+    expect({
+      executed,
+      namesField: result.includes('query'),
+      namesType: result.includes('string'),
+      echoesValue: result.includes('8675309'),
+    }).toEqual({executed: [], namesField: true, namesType: true, echoesValue: false});
+  });
+
+  it('passes undeclared extra properties through to the executor unchanged and exactly once', async () => {
+    const registry = new ToolRegistry();
+    const executed: Array<Record<string, unknown>> = [];
+    registry.register(
+      {
+        name: 'note_creator',
+        description: 'Create a note',
+        inputSchema: {
+          type: 'object',
+          properties: {title: {type: 'string'}},
+          required: ['title'],
+        },
+      },
+      countingExecutor(executed, 'ok')
+    );
+    const input = {title: 'groceries', tagged: true, extra: 'kept'};
+
+    await registry.execute('note_creator', input);
+
+    expect(executed).toEqual([input]);
+  });
+
+  it('throws Unknown tool for an unregistered name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('never_registered', {})).rejects.toThrow('Unknown tool: never_registered');
+  });
+
+  it('keeps enforcing the schema a static tool was registered with across repeated execute calls', async () => {
+    const registry = new ToolRegistry();
+    const executed: Array<Record<string, unknown>> = [];
+    const definition: ToolDefinition = {
+      name: 'city_lookup',
+      description: 'Look up a city',
+      inputSchema: {
+        type: 'object',
+        properties: {city: {type: 'string'}},
+        required: ['city'],
+      },
+    };
+    registry.register(definition, countingExecutor(executed, 'ok'));
+    // Validation must keep using the validator compiled at register time, not re-read the definition.
+    definition.inputSchema = {type: 'object'};
+
