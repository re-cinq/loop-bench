@@ -24,3 +24,24 @@ describe('shouldContinueToolLoop', () => {
     expect(shouldContinueToolLoop('end_turn', A_TOOL, REGISTRY)).toBe(false);
   });
 });
+
+describe('addUsage', () => {
+  const ROUND: UsageMetadata = {inputTokens: 4, outputTokens: 2, totalTokens: 6};
+  const NEXT_ROUND: UsageMetadata = {inputTokens: 10, outputTokens: 3, totalTokens: 13};
+
+  it('sums each token field across reported rounds', () => {
+    expect(addUsage(ROUND, NEXT_ROUND)).toEqual({inputTokens: 14, outputTokens: 5, totalTokens: 19});
+  });
+
+  it('keeps the total when a round reported nothing', () => {
+    expect(addUsage(ROUND, undefined)).toEqual(ROUND);
+  });
+
+  it('takes the round when nothing has been reported yet', () => {
+    expect(addUsage(undefined, ROUND)).toEqual(ROUND);
+  });
+
+  it('stays undefined when no round reported usage', () => {
+    expect(addUsage(undefined, undefined)).toBeUndefined();
+  });
+});
diff --git a/src/orchestration/orchestratorHelpers.ts b/src/orchestration/orchestratorHelpers.ts
index 717eb9a..c0edefc 100644
--- a/src/orchestration/orchestratorHelpers.ts
+++ b/src/orchestration/orchestratorHelpers.ts
@@ -40,3 +40,17 @@ export function extractStopReason(chunk: MessageChunk): string | null {
 export function extractUsage(chunk: MessageChunk): UsageMetadata | undefined {
   return chunk.type === 'stop' ? chunk.usage : undefined;
 }
+
+// Undefined only when neither side reported, so a round that reported nothing never poisons the total.
+export function addUsage(
+  total: UsageMetadata | undefined,
+  round: UsageMetadata | undefined
+): UsageMetadata | undefined {
+  if (round === undefined) return total;
+  if (total === undefined) return round;
+  return {
+    inputTokens: total.inputTokens + round.inputTokens,
+    outputTokens: total.outputTokens + round.outputTokens,
+    totalTokens: total.totalTokens + round.totalTokens,
+  };
+}
