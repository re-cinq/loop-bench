+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry caching', () => {
+  const createSchema = (): Record<string, unknown> => ({
+    type: 'object',
+    properties: {count: {type: 'number'}},
+    required: ['count'],
+  });
+
+  it('caches compiled validators for function-valued schemas by schema object reference', async () => {
+    const registry = new ToolRegistry();
+    const schemaInstance = createSchema();
+
+    registry.register(
+      () => ({
+        name: 'test_tool',
+        description: 'test',
+        inputSchema: schemaInstance,
+      }),
+      async () => 'ok'
+    );
+
+    const response1 = await registry.execute('test_tool', {count: 'not-a-number'});
+    schemaInstance.required = [];
+    const response2 = await registry.execute('test_tool', {count: 'not-a-number'});
+
+    expect({
+      firstCallFailed: response1.result.includes('validation failed'),
+      firstCallMentionsCount: response1.result.includes('count'),
+      secondCallFailed: response2.result.includes('validation failed'),
+    }).toEqual({
+      firstCallFailed: true,
+      firstCallMentionsCount: true,
+      secondCallFailed: true,
+    });
+  });
+
+  it('invokes the executor once and passes the input object through unchanged when validation succeeds', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    let receivedInput: Record<string, unknown> | undefined;
+    registry.register(
+      {
+        name: 'passthrough_tool',
+        description: 'test',
+        inputSchema: {
+          type: 'object',
+          properties: {id: {type: 'number'}},
+          required: ['id'],
+        },
+      },
+      async input => {
+        executorCalls += 1;
+        receivedInput = input;
+        return 'ok';
+      }
+    );
+
+    const inputObj = {id: 42, extra: 'kept', nested: {flag: true}};
+    const response = await registry.execute('passthrough_tool', inputObj);
+
+    expect({
+      response,
+      executorCalls,
+      receivedInput,
+    }).toEqual({
+      response: {result: 'ok'},
+      executorCalls: 1,
+      receivedInput: {id: 42, extra: 'kept', nested: {flag: true}},
+    });
+  });
+
+  it('throws Unknown tool when executing an unregistered tool', async () => {
+    const registry = new ToolRegistry();
+    await expect(registry.execute('nonexistent', {})).rejects.toThrow('Unknown tool: nonexistent');
+  });
+
+  it('compiles static tool inputSchema at register time and reuses it without re-reading', async () => {
+    const registry = new ToolRegistry();
+    const schemaInstance = createSchema();
+
+    registry.register(
+      {
+        name: 'static_tool',
+        description: 'test',
+        inputSchema: schemaInstance,
+      },
+      async () => 'ok'
+    );
+
+    const response1 = await registry.execute('static_tool', {count: 'not-a-number'});
+    schemaInstance.required = [];
+    const response2 = await registry.execute('static_tool', {count: 'not-a-number'});
+
+    expect({
+      response1Failed: response1.result.includes('validation failed'),
+      response2Failed: response2.result.includes('validation failed'),
+    }).toEqual({
+      response1Failed: true,
+      response2Failed: true,
+    });
+  });
+
+  it('registers a tool requiring a location string, calls execute with {}, and asserts the returned result names location as required and the executor call count is 0', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    registry.register(
+      {
+        name: 'loc_tool',
+        description: 'test',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async () => {
+        executorCalls += 1;
+        return 'ok';
+      }
+    );
+    const response = await registry.execute('loc_tool', {});
+    expect({
+      calls: executorCalls,
+      hasLocation: /location/i.test(String(response.result)),
+      hasRequired: /required/i.test(String(response.result)),
+    }).toEqual({calls: 0, hasLocation: true, hasRequired: true});
+  });
+
+  it('asserts a wrong-typed field is rejected with a message naming the field path and the expected type, and that the message does not contain the offending value', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'type_tool',
+        description: 'test',
+        inputSchema: {
+          type: 'object',
+          properties: {name: {type: 'string'}},
+        },
+      },
+      async () => 'ok'
+    );
+    // Number where string is required
+    const response = await registry.execute('type_tool', {name: 123456789});
+    expect({
+      hasName: /name/i.test(String(response.result)),
+      hasString: /string/i.test(String(response.result)),
+      leaksValue: /123456789/.test(String(response.result)),
+    }).toEqual({hasName: true, hasString: true, leaksValue: false});
+  });
+
+  it('asserts register throws at registration time for an uncompilable schema, and that the thrown message names the tool', () => {
+    const registry = new ToolRegistry();
+    expect(() => {
+      registry.register(
+        {
+          name: 'bad_schema_tool',
+          description: 'test',
+          inputSchema: {
+            type: 'invalid-type-xyz',
+          },
+        },
+        async () => 'ok'
+      );
+    }).toThrow(/bad_schema_tool/);
+  });
+});
