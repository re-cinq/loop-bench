+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+import {createTestSession, createRejectingProvider} from './onErrorNonErrorTestSupport.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+describe('ChatOrchestrator onError with non-Error rejections', () => {
+  const captureError = async (reason: unknown) => {
+    let receivedError: Error | undefined;
+    const hooks = {
+      onError: async (_session: ChatSession, error: Error) => {
+        receivedError = error;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(createRejectingProvider(reason), promptBuilder, undefined, {hooks});
+
+    try {
+      await orchestrator.processMessage(createTestSession('hello'));
+    } catch (_e) {
+      // Expected to throw
+    }
+    return receivedError;
+  };
+
+  it('calls onError with a coerced Error when a string is thrown', async () => {
+    const receivedError = await captureError('string boom');
+
+    expect(receivedError).toMatchObject({
+      message: 'string boom',
+    });
+  });
+
+  it('calls onError with a coerced Error when a plain object is thrown', async () => {
+    const reason = {code: 503, detail: 'upstream down'};
+    const receivedError = await captureError(reason);
+
+    expect(receivedError).toMatchObject({
+      cause: reason,
+    });
+  });
+
+  it('calls onError with a coerced Error when undefined is thrown', async () => {
+    const receivedError = await captureError(undefined);
+
+    expect(receivedError).toMatchObject({
+      message: 'undefined',
+      cause: undefined,
+    });
+  });
+});
