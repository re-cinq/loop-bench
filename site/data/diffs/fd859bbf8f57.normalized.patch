+import {jest} from '@jest/globals';
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+describe('ToolRegistry', () => {
+  it('throws at registration time when a static inputSchema cannot be compiled', () => {
+    const registry = new ToolRegistry();
+    const invalidTool: ToolDefinition = {
+      name: 'invalid-tool',
+      description: 'A tool with an invalid schema',
+      inputSchema: {
+        type: 'invalid-type', // Ajv should fail to compile this
+      },
+    };
+
+    expect(() => {
+      registry.register(invalidTool, async () => 'ok');
+    }).toThrow(/invalid-tool/);
+  });
+
+  it('validates input against inputSchema and returns a ToolResponse on failure without calling executor', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(
+      {
+        name: 'weather',
+        description: 'Get weather',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async () => {
+        calls++;
+        return 'sunny';
+      }
+    );
+
+    const response = await registry.execute('weather', {});
