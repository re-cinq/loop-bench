+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolResponse} from './tools/registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}};
+const STOP_FOR_TOOL: MessageChunk = {type: 'stop', stopReason: 'tool_use'};
+const STOP_DONE: MessageChunk = {type: 'stop', stopReason: 'end_turn'};
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryReturning = (response: ToolResponse): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => response
+  );
+  return registry;
+};
+
+describe('afterModelResponse usage accumulation', () => {
+  it('accumulates usage across multiple tool rounds and reports the total', async () => {
+    const usage1: UsageMetadata = {inputTokens: 100, outputTokens: 50, totalTokens: 150};
+    const usage2: UsageMetadata = {inputTokens: 75, outputTokens: 40, totalTokens: 115};
+    let recordedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        recordedUsage = usage;
+      },
+    };
+
+    const provider = scriptedProvider([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usage1}],
+      [
+        {type: 'text', text: 'result'},
+        {type: 'stop', stopReason: 'end_turn', usage: usage2},
+      ],
+    ]);
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registryReturning({result: 'found'}), {
+      hooks,
+    });
+
+    await orchestrator.processMessage(createSession('test'));
+
+    expect(recordedUsage).toEqual({inputTokens: 175, outputTokens: 90, totalTokens: 265});
+  });
+
+  it('reports usage from single round turn unchanged for backward compatibility', async () => {
+    const usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    let recordedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, u) => {
+        recordedUsage = u;
+      },
+    };
+
+    const provider = scriptedProvider([
+      [
+        {type: 'text', text: 'hello'},
+        {type: 'stop', stopReason: 'end_turn', usage},
+      ],
+    ]);
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+
+    await orchestrator.processMessage(createSession('hi'));
+
+    expect(recordedUsage).toEqual(usage);
+  });
+
+  it('accumulates available usage when some rounds report no usage', async () => {
+    const usage1: UsageMetadata = {inputTokens: 100, outputTokens: 50, totalTokens: 150};
+    let recordedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        recordedUsage = usage;
+      },
+    };
+
+    const provider = scriptedProvider([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usage1}],
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ]);
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registryReturning({result: 'r'}), {
+      hooks,
+    });
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(recordedUsage).toEqual(usage1);
+  });
+
+  it('handles turn with no usage reported on any round', async () => {
+    let recordedUsage: UsageMetadata | undefined = {inputTokens: 1, outputTokens: 1, totalTokens: 2};
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        recordedUsage = usage;
+      },
+    };
+
+    const provider = scriptedProvider([
+      [
+        {type: 'text', text: 'hello'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ]);
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, undefined, {hooks});
+
+    await orchestrator.processMessage(createSession('hi'));
+
+    expect(recordedUsage).toBeUndefined();
+  });
+});
