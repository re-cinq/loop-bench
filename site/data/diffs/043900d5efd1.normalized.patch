diff --git a/src/orchestration/chatOrchestratorUsage.acceptance.test.ts b/src/orchestration/chatOrchestratorUsage.acceptance.test.ts
new file mode 100644
index 0000000..37b5256
--- /dev/null
+++ b/src/orchestration/chatOrchestratorUsage.acceptance.test.ts
@@ -0,0 +1,96 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const promptBuilder = new PromptBuilder({identity: 'Usage acceptance test.'});
+const session = (): ChatSession => ({
+  sessionId: 'usage-session',
+  userId: 'usage-user',
+  entries: [{role: 'user', content: 'Use the tools.', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'lookup-1', name: 'lookup', input: {}}};
+const TOOL_STOP: MessageChunk = {type: 'stop', stopReason: 'tool_use'};
+const DONE: MessageChunk = {type: 'stop', stopReason: 'end_turn'};
+
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield* rounds[round++] ?? [];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const lookupRegistry = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Looks up a value.', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  return registry;
+};
+
+const usageStop = (stopReason: string, usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason, usage});
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports the summed usage from every provider call in a turn with two tool rounds', async () => {
+    let reported: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        reported = usage;
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, usageStop('tool_use', {inputTokens: 11, outputTokens: 2, totalTokens: 13})],
+        [TOOL_CALL, usageStop('tool_use', {inputTokens: 23, outputTokens: 3, totalTokens: 26})],
+        [{type: 'text', text: 'Done.'}, usageStop('end_turn', {inputTokens: 37, outputTokens: 5, totalTokens: 42})],
+      ]),
+      promptBuilder,
+      lookupRegistry(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(session());
+
+    expect(reported).toEqual({inputTokens: 71, outputTokens: 10, totalTokens: 81});
+  });
+
+  it('counts reported rounds while leaving a turn with no reported usage undefined', async () => {
+    const reports: Array<UsageMetadata | undefined> = [];
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        reports.push(usage);
+      },
+    };
+    const withGaps = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, usageStop('tool_use', {inputTokens: 2, outputTokens: 1, totalTokens: 3})],
+        [TOOL_CALL, TOOL_STOP],
+        [{type: 'text', text: 'Done.'}, usageStop('end_turn', {inputTokens: 7, outputTokens: 4, totalTokens: 11})],
+      ]),
+      promptBuilder,
+      lookupRegistry(),
+      {hooks}
+    );
+    const withoutUsage = createChatOrchestrator(
+      scriptedProvider([[{type: 'text', text: 'Done.'}, DONE]]),
+      promptBuilder,
+      undefined,
+      {hooks}
+    );
+
+    await withGaps.processMessage(session());
+    await withoutUsage.processMessage(session());
+
+    expect(reports).toEqual([{inputTokens: 9, outputTokens: 5, totalTokens: 14}, undefined]);
+  });
+});
diff --git a/src/orchestration/usageAggregation.test.ts b/src/orchestration/usageAggregation.test.ts
new file mode 100644
index 0000000..1f7d3ab
--- /dev/null
+++ b/src/orchestration/usageAggregation.test.ts
@@ -0,0 +1,124 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const promptBuilder = new PromptBuilder({identity: 'Usage test.'});
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const createSession = (content: string): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content, timestamp: SENT_AT}],
+});
+
+const t1Registry = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register({name: 't1', description: 'tool 1', inputSchema: {type: 'object'}}, async () => 'result');
+  return registry;
+};
+
+const createMockProvider = (rounds: Array<Array<MessageChunk>>): AIProvider => {
+  let roundIdx = 0;
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      const chunks = rounds[roundIdx++];
+      if (chunks) {
+        for (const chunk of chunks) {
+          yield chunk;
+        }
+      }
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const toolRound = (id: string, usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id, name: 't1', input: {}}},
+  {type: 'stop', stopReason: 'tool_use', usage},
+];
+
+describe('Usage Aggregation', () => {
+  it('aggregates usage across multiple rounds', async () => {
+    const usage1: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const usage2: UsageMetadata = {inputTokens: 20, outputTokens: 10, totalTokens: 30};
+
+    let receivedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const provider = createMockProvider([
+      toolRound('c1', usage1),
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn', usage: usage2},
+      ],
+    ]);
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, t1Registry(), {hooks});
+    await orchestrator.processMessage(createSession('call tool'));
+
+    expect(receivedUsage).toEqual({
+      inputTokens: usage1.inputTokens + usage2.inputTokens,
+      outputTokens: usage1.outputTokens + usage2.outputTokens,
+      totalTokens: usage1.totalTokens + usage2.totalTokens,
+    });
+  });
+
+  it('counts reported rounds when some rounds have missing usage', async () => {
+    const usage1: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    const usage3: UsageMetadata = {inputTokens: 5, outputTokens: 2, totalTokens: 7};
+
+    let receivedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const providerWithGaps = createMockProvider([
+      toolRound('c1', usage1),
+      toolRound('c2'), // MISSING USAGE
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn', usage: usage3},
+      ],
+    ]);
+
+    const orchestrator = createChatOrchestrator(providerWithGaps, promptBuilder, t1Registry(), {hooks});
+    await orchestrator.processMessage(createSession('call tool'));
+
+    expect(receivedUsage).toEqual({
+      inputTokens: usage1.inputTokens + usage3.inputTokens,
+      outputTokens: usage1.outputTokens + usage3.outputTokens,
+      totalTokens: usage1.totalTokens + usage3.totalTokens,
+    });
+  });
+
+  it('leaves a turn with no reported usage undefined', async () => {
+    let receivedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        receivedUsage = usage;
+      },
+    };
+
+    const providerWithoutUsage = createMockProvider([
+      [
+        {type: 'text', text: 'done'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ]);
+
+    const orchestrator = createChatOrchestrator(providerWithoutUsage, promptBuilder, undefined, {hooks});
+    await orchestrator.processMessage(createSession('hi'));
+
+    expect(receivedUsage).toBeUndefined();
+  });
+});
