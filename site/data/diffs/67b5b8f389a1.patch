+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry', () => {
+  it('throws at registration time naming the tool when a static inputSchema cannot be compiled', () => {
+    const registry = new ToolRegistry();
+    const malformed = {
+      name: 'faulty_lookup',
+      description: 'Malformed schema tool',
+      inputSchema: {type: 'object', properties: {query: {type: 'invalid-schema-type'}}},
+    };
+
+    expect(() => registry.register(malformed, async () => 'unused')).toThrow('faulty_lookup');
+  });
+
+  it('returns a ToolResponse naming the missing required location property without calling the executor', async () => {
+    const registry = new ToolRegistry();
+    const invoked: Array<Record<string, unknown>> = [];
+    registry.register(
+      {
+        name: 'weather_by_city',
+        description: 'Fetches city weather',
+        inputSchema: {type: 'object', properties: {location: {type: 'string'}}, required: ['location']},
+      },
+      async input => {
+        invoked.push(input);
+        return 'forecast';
+      }
+    );
+
+    const {result} = await registry.execute('weather_by_city', {});
+
+    expect({calls: invoked.length, result}).toEqual({
+      calls: 0,
+      result: expect.stringMatching(/required.*location|location.*required/i),
+    });
+  });
+});
