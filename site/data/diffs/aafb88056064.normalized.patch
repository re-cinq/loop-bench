+import {describe, expect, it} from '@jest/globals';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const session: ChatSession = {
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+describe('beforeSession failure', () => {
+  it('runs onError and afterSession and preserves the original rejection', async () => {
+    const failure = new Error('setup failed');
+    const calls: string[] = [];
+    const provider: AIProvider = {
+      async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        calls.push('provider');
+        yield* [];
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), undefined, {
+      hooks: {
+        beforeSession: async () => {
+          calls.push('beforeSession');
+          throw failure;
+        },
+        onError: async (_session, error) => {
+          calls.push(error === failure ? 'onError' : 'wrong error');
+        },
+        afterSession: async () => {
+          calls.push('afterSession');
+        },
+      },
+    });
+
+    let rejection: unknown;
+    try {
+      await orchestrator.processMessage(session);
+    } catch (error) {
+      rejection = error;
+    }
+
+    expect({rejection, calls}).toEqual({rejection: failure, calls: ['beforeSession', 'onError', 'afterSession']});
+  });
+});
