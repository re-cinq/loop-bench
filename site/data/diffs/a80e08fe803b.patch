+function validateListSessionsMessage(message: Record<string, unknown>): ValidationResult {
+  const result: Extract<IncomingMessage, {type: 'list_sessions'}> = {type: 'list_sessions'};
+
+  const limit = message.limit;
+  if (limit !== undefined && !isValidLimit(limit)) {
+    return {valid: false, error: 'list_sessions limit must be a non-negative integer'};
+  }
+  if (limit !== undefined) {
+    result.limit = limit;
+  }
+
+  const before = message.before;
+  const cursorError = before !== undefined ? validateCursor(before) : undefined;
