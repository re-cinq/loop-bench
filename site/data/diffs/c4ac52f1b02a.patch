+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks, TotalTurnUsage} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+it('exposes a named total-turn usage type on the hook (specs/hal-engine-config-hooks/spec.md#15)', async () => {
+  const usage: TotalTurnUsage = {inputTokens: 4, outputTokens: 2, totalTokens: 6};
+  let reported: TotalTurnUsage | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, totalUsage: TotalTurnUsage | undefined) => {
+      reported = totalUsage;
+    },
+  };
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield {type: 'stop', stopReason: 'end_turn', usage};
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const session: ChatSession = {
+    sessionId: 'usage-type',
+    userId: 'user',
+    entries: [{role: 'user', content: 'Hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+
+  await createChatOrchestrator(provider, new PromptBuilder({identity: 'Test assistant'}), undefined, {
+    hooks,
+  }).processMessage(session);
+
+  expect(reported).toEqual(usage);
+});