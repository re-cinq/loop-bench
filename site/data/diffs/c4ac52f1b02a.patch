@@ -0,0 +1,49 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+it('sums usage from successive provider calls (specs/hal-engine-config-hooks/spec.md#13)', async () => {
+  const rounds: MessageChunk[][] = [
+    [
+      {type: 'tool_use', toolCall: {id: 'lookup-1', name: 'lookup', input: {}}},
+      {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 4, outputTokens: 2, totalTokens: 6}},
+    ],
+    [
+      {type: 'text', text: 'Found it.'},
+      {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 9, outputTokens: 3, totalTokens: 12}},
+    ],
+  ];
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield* rounds.shift() ?? [];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Look up a value', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  const session: ChatSession = {
+    sessionId: 'usage-total',
+    userId: 'user',
+    entries: [{role: 'user', content: 'Look it up', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reported = usage;
+    },
+  };
+
+  await createChatOrchestrator(provider, new PromptBuilder({identity: 'Test assistant'}), registry, {
+    hooks,
+  }).processMessage(session);
+
+  expect(reported).toEqual({inputTokens: 13, outputTokens: 5, totalTokens: 18});
+});
diff --git a/src/orchestration/chatOrchestratorUsage.acceptance.test.ts b/src/orchestration/chatOrchestratorUsage.acceptance.test.ts
