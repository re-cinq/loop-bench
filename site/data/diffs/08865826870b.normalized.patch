+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const session: ChatSession = {
+  sessionId: 'acceptance-session',
+  userId: 'acceptance-user',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+const provider: AIProvider = {
+  async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'response'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+describe('beforeSession failure acceptance', () => {
+  it('rejects with the original error, calls onError and afterSession, and does not start the turn', async () => {
+    const failure = new Error('before session failed');
+    const calls: Array<{hook: string; session?: ChatSession; error?: Error}> = [];
+    const hooks: OrchestratorHooks = {
+      beforeSession: async receivedSession => {
+        calls.push({hook: 'beforeSession', session: receivedSession});
+        throw failure;
+      },
+      onError: async (receivedSession, error) => calls.push({hook: 'onError', session: receivedSession, error}),
+      afterSession: async receivedSession => calls.push({hook: 'afterSession', session: receivedSession}),
+      beforeUserInput: async (_session, message) => {
+        calls.push({hook: 'beforeUserInput'});
+        return message;
+      },
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Test assistant'}), undefined, {
+      hooks,
+    });
+
+    await expect(orchestrator.processMessage(session)).rejects.toBe(failure);
+    expect(calls).toEqual([
+      {hook: 'beforeSession', session},
+      {hook: 'onError', session, error: failure},
+      {hook: 'afterSession', session},
+    ]);
+  });
+});
