+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const session: ChatSession = {
+  sessionId: 'failed-start',
+  userId: 'user',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+describe('beforeSession failure', () => {
+  it('calls onError and afterSession before rejecting without contacting the provider (specs/hal-engine-config-hooks/spec.md#7)', async () => {
+    const failure = new Error('start failed');
+    const calls: string[] = [];
+    let reportedSession: ChatSession | undefined;
+    let reportedError: Error | undefined;
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        calls.push('provider');
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Test'}), undefined, {
+      hooks: {
+        beforeSession: async () => {
+          calls.push('beforeSession');
+          throw failure;
+        },
+        onError: async (hookSession, error) => {
+          calls.push('onError');
+          reportedSession = hookSession;
+          reportedError = error;
+        },
+        afterSession: async hookSession => {
+          calls.push('afterSession');
+          expect(hookSession).toBe(session);
+        },
+      },
+    });
+
+    await expect(orchestrator.processMessage(session)).rejects.toBe(failure);
+    expect({calls, reportedSession, reportedError}).toEqual({
+      calls: ['beforeSession', 'onError', 'afterSession'],
+      reportedSession: session,
+      reportedError: failure,
+    });
+  });
+});
