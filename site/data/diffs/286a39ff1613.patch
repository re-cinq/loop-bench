@@ -0,0 +1,70 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, TotalUsageMetadata} from '../types/ai.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {ChatSession} from '../types/session.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const promptBuilder = new PromptBuilder({identity: 'Usage tests.'});
+const session: ChatSession = {
+  sessionId: 'usage-session',
+  userId: 'usage-user',
+  entries: [{role: 'user', content: 'Hello.', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+const reportUsage = async (
+  rounds: MessageChunk[][],
+  registry?: ToolRegistry
+): Promise<TotalUsageMetadata | undefined> => {
+  let reported: TotalUsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      reported = usage;
+    },
+  };
+
+  let round = 0;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield* rounds[round++] ?? [];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  await createChatOrchestrator(provider, promptBuilder, registry, {hooks}).processMessage(session);
+  return reported;
+};
+
+describe('afterModelResponse usage', () => {
+  it('sums reported usage while ignoring rounds that omit it', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {name: 'lookup', description: 'Looks up a value.', inputSchema: {type: 'object'}},
+      async () => 'found'
+    );
+    const toolCall: MessageChunk = {type: 'tool_use', toolCall: {id: 'lookup-1', name: 'lookup', input: {}}};
+    const reported = await reportUsage(
+      [
+        [toolCall, {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 7, outputTokens: 3, totalTokens: 10}}],
+        [toolCall, {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 5, outputTokens: 2, totalTokens: 7}}],
+        [
+          {type: 'text', text: 'Answer.'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ],
+      ],
+      registry
+    );
+
+    const noUsage = await reportUsage([
+      [
+        {type: 'text', text: 'Answer.'},
+        {type: 'stop', stopReason: 'end_turn'},
+      ],
+    ]);
+    expect({reported, noUsage}).toEqual({
+      reported: {inputTokens: 12, outputTokens: 5, totalTokens: 17},
+      noUsage: undefined,
+    });
+  });
+});
