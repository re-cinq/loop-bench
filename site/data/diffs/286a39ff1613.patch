+function addUsage(
+  total: TotalUsageMetadata | undefined,
+  roundUsage: UsageMetadata | undefined
+): TotalUsageMetadata | undefined {
+  if (!roundUsage) return total;
+  if (!total) return roundUsage;
+
+  return {
+    inputTokens: total.inputTokens + roundUsage.inputTokens,
+    outputTokens: total.outputTokens + roundUsage.outputTokens,
+    totalTokens: total.totalTokens + roundUsage.totalTokens,
+  };
+}
