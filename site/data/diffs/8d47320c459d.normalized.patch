@@ -0,0 +1,64 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const session: ChatSession = {
+  sessionId: 'test-session',
+  userId: 'user-1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+const rejectingProvider = (reason: unknown): AIProvider => ({
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: ''};
+    throw reason;
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+});
+
+describe('ChatOrchestrator non-Error rejection wrapping', () => {
+  const runRejection = async (reason: unknown) => {
+    let receivedError: Error | undefined;
+    const hooks: OrchestratorHooks = {
+      onError: async (_session, error) => {
+        receivedError = error;
+      },
+    };
+    const orchestrator = createChatOrchestrator(rejectingProvider(reason), promptBuilder, undefined, {hooks});
+
+    let rejection: unknown;
+    try {
+      await orchestrator.processMessage(session);
+    } catch (error) {
+      rejection = error;
+    }
+
+    return {rejection, receivedError};
+  };
+
+  it('passes a wrapped rejection to onError with the original cause', async () => {
+    const reason = {code: 503, detail: 'upstream down'};
+    const result = await runRejection(reason);
+
+    expect(result).toEqual({
+      rejection: reason,
+      receivedError: expect.objectContaining({cause: reason}),
+    });
+  });
+
+  it('wraps an undefined rejection for onError while preserving the caller value', async () => {
+    const reason = undefined;
+    const result = await runRejection(reason);
+
+    expect(result).toEqual({
+      rejection: reason,
+      receivedError: expect.objectContaining({cause: reason}),
+    });
+  });
+});
