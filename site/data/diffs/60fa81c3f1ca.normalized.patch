@@ -0,0 +1,86 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+async function* toolRoundChunksWithUsage(id: string): AsyncGenerator<MessageChunk> {
+  yield {type: 'tool_use', toolCall: {id, name: 'lookup', input: {}}};
+  yield {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 10, outputTokens: 5, totalTokens: 15}};
+}
+
+async function* toolRoundChunksWithoutUsage(id: string): AsyncGenerator<MessageChunk> {
+  yield {type: 'tool_use', toolCall: {id, name: 'lookup', input: {}}};
+  yield {type: 'stop', stopReason: 'tool_use'};
+}
+
+async function* finalRoundChunks(): AsyncGenerator<MessageChunk> {
+  yield {type: 'text', text: 'done'};
+  yield {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 20, outputTokens: 10, totalTokens: 30}};
+}
+
+function makeProvider(script: Array<() => AsyncGenerator<MessageChunk>>): AIProvider {
+  let i = 0;
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      yield* script[i++]();
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+}
+
+async function runAndCaptureUsage(provider: AIProvider): Promise<UsageMetadata | undefined> {
+  const {hooks, result} = captureUsage();
+  const orchestrator = createChatOrchestrator(provider, promptBuilder, createLookupRegistry(), {hooks});
+  await orchestrator.processMessage(createSession('test'));
+  return result();
+}
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+function createLookupRegistry(): ToolRegistry {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  return registry;
+}
+
+function captureUsage(): {hooks: OrchestratorHooks; result: () => UsageMetadata | undefined} {
+  let usage: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, u) => {
+      usage = u;
+    },
+  };
+  return {hooks, result: () => usage};
+}
+
+describe('chatOrchestrator usage accumulation (#93)', () => {
+  it('reports sum of usage covering every provider call in a turn with multiple rounds', async () => {
+    const provider = makeProvider([() => toolRoundChunksWithUsage('c1'), () => finalRoundChunks()]);
+    expect(await runAndCaptureUsage(provider)).toEqual({inputTokens: 30, outputTokens: 15, totalTokens: 45});
+  });
+
+  it('handles missing usage on some rounds without turning the sum into NaN or losing the counted rounds', async () => {
+    const provider = makeProvider([
+      () => toolRoundChunksWithUsage('c1'),
+      () => toolRoundChunksWithoutUsage('c2'),
+      () => finalRoundChunks(),
+    ]);
+    expect(await runAndCaptureUsage(provider)).toEqual({inputTokens: 30, outputTokens: 15, totalTokens: 45});
+  });
+});
