+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry input validation', () => {
+  it('passes valid input and undeclared properties through unchanged exactly once', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    let receivedInput: Record<string, unknown> | undefined;
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async input => {
+        executorCalls += 1;
+        receivedInput = input;
+        return JSON.stringify(input);
+      }
+    );
+    const input = {location: 'Paris', traceId: 'trace-1'};
+
+    await registry.execute('get_weather', input);
+
+    expect({executorCalls, receivedInput}).toEqual({executorCalls: 1, receivedInput: input});
+  });
+
+  it('validates function-valued definitions against the schema resolved for each call', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    let definitionCalls = 0;
+    const citySchema = {type: 'object', properties: {city: {type: 'string'}}, required: ['city']};
+    const locationSchema = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    registry.register(
+      () => {
+        definitionCalls += 1;
+        return {
+          name: 'get_weather',
+          description: 'Get weather for a location',
+          inputSchema: definitionCalls === 2 ? citySchema : locationSchema,
+        };
+      },
+      async input => {
+        executorCalls += 1;
+        return JSON.stringify(input);
+      }
+    );
+
+    await registry.execute('get_weather', {city: 'Paris'});
+    const response = await registry.execute('get_weather', {city: 'Paris'});
+
+    expect({
+      rejectionNamesCurrentRequiredField: response.result.includes('location') && /required/i.test(response.result),
+      executorCalls,
+    }).toEqual({rejectionNamesCurrentRequiredField: true, executorCalls: 1});
+  });
+
+  it('throws unchanged for an unknown tool name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('missing_tool', {})).rejects.toThrow('Unknown tool: missing_tool');
+  });
+});
