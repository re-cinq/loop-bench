+import {jest} from '@jest/globals';
+import Ajv from 'ajv';
+import {ToolRegistry} from './registry.js';
+import type {ToolDefinitionSource} from './registry.js';
+
+describe('ToolRegistry', () => {
+  it('rejects missing required property', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    registry.register(
+      {
+        name: 'weather_tool',
+        description: 'Get the weather',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async () => {
+        calls++;
+        return 'ok';
+      }
+    );
+
+    const response = await registry.execute('weather_tool', {});
+
+    expect({
+      res: response.result,
+      calls,
+    }).toMatchObject({
+      res: expect.stringMatching(/location.*required|required.*location/),
+      calls: 0,
+    });
+  });
+
+  it('passes through extra properties unchanged', async () => {
+    const registry = new ToolRegistry();
+    let captured: unknown;
+    registry.register(
+      {
+        name: 'extra_props_tool',
+        description: 'Test extra properties',
+        inputSchema: {type: 'object', properties: {foo: {type: 'string'}}},
+      },
+      async input => {
+        captured = input;
+        return 'ok';
+      }
+    );
+
+    await registry.execute('extra_props_tool', {foo: 'bar', extra: 123});
+    expect(captured).toEqual({foo: 'bar', extra: 123});
+  });
+
+  it('rejects wrong-typed fields and names the type without leaking value', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'type_tool',
+        description: 'Type checking',
+        inputSchema: {type: 'object', properties: {foo: {type: 'string'}}},
+      },
+      async () => 'ok'
+    );
+
+    const secret = 'PRIVATE';
+    const response = await registry.execute('type_tool', {foo: 123, s: secret});
+
+    expect({
+      hasFoo: response.result.includes('foo'),
+      hasString: response.result.includes('string'),
+      has123: response.result.includes('123'),
+      hasSecret: response.result.includes(secret),
+    }).toEqual({
+      hasFoo: true,
+      hasString: true,
+      has123: false,
+      hasSecret: false,
+    });
+  });
+
+  it('throws at register time for invalid schema', async () => {
+    const registry = new ToolRegistry();
+    const bad = {name: 'bad_tool', description: 'desc', inputSchema: {type: 'invalid'}};
+    expect(() => registry.register(bad as unknown as ToolDefinitionSource, async () => 'ok')).toThrow(/bad_tool/);
+  });
+
+  it('validates dynamic schemas against current version', async () => {
+    const registry = new ToolRegistry();
+    let req = 'foo';
+    registry.register(
+      () => ({
+        name: 'dyn',
+        description: 'dyn',
+        inputSchema: {type: 'object', properties: {[req]: {type: 'string'}}, required: [req]},
+      }),
+      async () => 'ok'
+    );
+
+    const r1 = await registry.execute('dyn', {foo: 'x'});
+    const r2 = await registry.execute('dyn', {baz: 'y'});
+    req = 'baz';
+    const r3 = await registry.execute('dyn', {baz: 'y'});
+    const r4 = await registry.execute('dyn', {foo: 'x'});
+
+    expect({
+      r1: r1.result,
+      r2: r2.result.includes('foo'),
+      r3: r3.result,
+      r4: r4.result.includes('baz'),
+    }).toEqual({
+      r1: 'ok',
+      r2: true,
+      r3: 'ok',
+      r4: true,
+    });
+  });
+
+  it('asserts a static tool schema is compiled once across ten execute calls', async () => {
+    const compileSpy = jest.spyOn(Ajv.prototype, 'compile');
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'static_comp',
+        description: 'static compilation test',
+        inputSchema: {type: 'object', properties: {a: {type: 'string'}}},
+      },
+      async () => 'ok'
+    );
+
+    for (let i = 0; i < 10; i++) {
+      await registry.execute('static_comp', {a: 'val'});
+    }
+    expect(compileSpy).toHaveBeenCalledTimes(1);
+    compileSpy.mockRestore();
+  });
+
+  it('throws Unknown tool for unregistered name', async () => {
+    const registry = new ToolRegistry();
+    await expect(registry.execute('none', {})).rejects.toThrow(/Unknown tool: none/);
+  });
+
+  it('produces no result text containing identifying property values', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'redact',
+        description: 'redaction',
+        inputSchema: {type: 'object', properties: {foo: {type: 'string'}}},
+      },
+      async () => 'ok'
+    );
+
+    const secret = 'SECRET_VALUE';
+    const res = await registry.execute('redact', {foo: 123, s: secret});
+    expect(res.result.includes(secret)).toBe(false);
+  });
+
+  it('rejects values not in enum', async () => {
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'enum_tool',
+        description: 'Enum checking',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            color: {type: 'string', enum: ['red', 'green', 'blue']},
+          },
+        },
+      },
+      async () => 'ok'
+    );
+
+    const response = await registry.execute('enum_tool', {color: 'yellow'});
+
+    expect({
+      mentionsColor: response.result.includes('color'),
+      mentionsAllowed: response.result.includes('allowed values') || response.result.includes('red, green, blue'),
+      executorCalled: false,
+    }).toMatchObject({
+      mentionsColor: true,
+      executorCalled: false,
+    });
+  });
+});
