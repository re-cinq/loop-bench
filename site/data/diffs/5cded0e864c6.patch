+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry', () => {
+  describe('register', () => {
+    it('throws at registration time for an uncompilable schema naming the tool', () => {
+      const registry = new ToolRegistry();
+      const invalidSchema = {
+        type: 'object',
+        properties: {
+          location: {type: 'not-a-type'},
+        },
+      };
+
+      expect(() =>
+        registry.register(
+          {
+            name: 'broken_tool',
+            description: 'A tool with a broken schema',
+            inputSchema: invalidSchema as Record<string, unknown>,
+          },
+          async () => 'unreachable'
+        )
+      ).toThrow(/broken_tool/);
+    });
+  });
+
+  describe('execute', () => {
+    it('passes valid input through to the executor unchanged', async () => {
+      const registry = new ToolRegistry();
+      const input = {location: 'London', extra: 'property'};
+      let receivedInput: Record<string, unknown> | undefined;
+
+      registry.register(
+        {
+          name: 'get_weather',
+          description: 'Get weather',
+          inputSchema: {
+            type: 'object',
+            properties: {location: {type: 'string'}},
+            required: ['location'],
+          },
+        },
+        async inp => {
+          receivedInput = inp;
+          return 'sunny';
+        }
