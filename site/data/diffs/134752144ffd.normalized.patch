@@ -0,0 +1,163 @@
+import {describe, expect, it, jest} from '@jest/globals';
+import {ToolRegistry, type ToolExecutor} from './registry.js';
+
+describe('ToolRegistry', () => {
+  function setupTestTool(schemaProps: Record<string, unknown>, required: string[]) {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    const executor = jest.fn(async () => {
+      calls++;
+      return {result: 'success'};
+    }) as unknown as ToolExecutor;
+
+    registry.register(
+      {
+        name: 'testTool',
+        description: 'A test tool',
+        inputSchema: {
+          type: 'object',
+          properties: schemaProps,
+          required,
+        },
+      },
+      executor
+    );
+
+    return {registry, getCalls: () => calls};
+  }
+
+  /** @spec specs/hal-engine-tool-input-validation/spec.md#1 */
+  it('rejects input missing a required property with a ToolResponse and never calls the executor', async () => {
+    const {registry, getCalls} = setupTestTool({location: {type: 'string'}}, ['location']);
+
+    const response = await registry.execute('testTool', {});
+
+    expect({response, calls: getCalls()}).toEqual({
+      response: {result: expect.stringContaining('location')},
+      calls: 0,
+    });
+  });
+
+  /** @spec specs/hal-engine-tool-input-validation/spec.md#2 */
+  it('rejects a wrong-typed property naming the field and expected type without leaking the offending value to the result or logs', async () => {
+    const {registry, getCalls} = setupTestTool({ssn: {type: 'string'}}, ['ssn']);
+
+    const response = await registry.execute('testTool', {ssn: 12345});
+
+    expect({
+      resultHasField: response.result.includes('ssn'),
+      resultHasType: response.result.includes('string'),
+      resultLacksValue: !response.result.includes('12345'),
+      calls: getCalls(),
+    }).toEqual({
+      resultHasField: true,
+      resultHasType: true,
+      resultLacksValue: true,
+      calls: 0,
+    });
+  });
+
+  /** @spec specs/hal-engine-tool-input-validation/spec.md#4 */
+  it('throws at register time naming the tool when a static inputSchema cannot be compiled', () => {
+    const registry = new ToolRegistry();
+    const executor = jest.fn() as unknown as ToolExecutor;
+
+    expect(() => {
+      registry.register(
+        {
+          name: 'brokenTool',
+          description: 'A tool with a broken schema',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              invalidProp: {type: 'not-a-valid-type'},
+            },
+          },
+        },
+        executor
+      );
+    }).toThrow(/brokenTool/);
+  });
+
+  /** @spec specs/hal-engine-tool-input-validation/spec.md#3 */
+  it('invokes the executor once and passes the input object through unchanged when input is valid', async () => {
+    const {registry, getCalls} = setupTestTool({str: {type: 'string'}}, ['str']);
+    const input = {str: 'test', extra: true};
+
+    const response = await registry.execute('testTool', input);
+
+    expect({response, calls: getCalls()}).toEqual({
+      response: {result: 'success'},
+      calls: 1,
+    });
+  });
+
+  /** @spec specs/hal-engine-tool-input-validation/spec.md#4 */
+  it('throws Unknown tool when called with an unregistered tool name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('unregistered', {})).rejects.toThrow('Unknown tool: unregistered');
+  });
+
+  /** @spec specs/hal-engine-tool-input-validation/spec.md#6 */
+  it('reuses the compiled schema on every execute call', async () => {
+    const registry = new ToolRegistry();
+    let schemaReads = 0;
+    const inputSchema = {
+      get type() {
+        schemaReads++;
+        return 'object';
+      },
+    };
+    // Because AJV accesses properties during compile, we proxy it to count access to 'type'.
+    registry.register(
+      {
+        name: 'test',
+        description: 'test',
+        inputSchema: new Proxy(inputSchema, {
+          get(target, prop) {
+            if (prop === 'type') schemaReads++;
+            return Reflect.get(target, prop);
+          },
+        }),
+      },
+      async () => ({result: 'ok'})
+    );
+
+    await registry.execute('test', {});
+    await registry.execute('test', {});
+
+    const readsAfterSecond = schemaReads;
+    await registry.execute('test', {});
+    expect({
+      readsWereNonZero: readsAfterSecond > 0,
+      readsAfterThirdExecution: schemaReads,
+    }).toEqual({
+      readsWereNonZero: true,
+      readsAfterThirdExecution: readsAfterSecond,
+    });
+  });
+
+  /** @spec specs/hal-engine-tool-input-validation/spec.md#7 */
+  it('caching compiled validators for function-valued schemas by reference', async () => {
+    const registry = new ToolRegistry();
+    let executeCalls = 0;
+    const schema1 = {type: 'object', properties: {a: {type: 'string'}}, required: ['a']};
+    const schema2 = {type: 'object', properties: {b: {type: 'string'}}, required: ['b']};
+    let currentSchema: Record<string, unknown> = schema1;
+
+    registry.register(
+      () => ({name: 'dynamic', description: 'dyn', inputSchema: currentSchema}),
+      async () => {
+        executeCalls++;
+        return {result: 'ok'};
+      }
+    );
+
+    await registry.execute('dynamic', {a: 'ok'});
+    currentSchema = schema2;
+    await registry.execute('dynamic', {b: 'ok'});
+
+    expect(executeCalls).toBe(2);
+  });
+});
