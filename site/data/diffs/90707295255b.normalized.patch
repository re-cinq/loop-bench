@@ -0,0 +1,80 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {makeTestRegistry} from './orchestratorTestSupport.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// Issue #93: afterModelResponse must report the usage of every provider call in the turn, not only the last one.
+
+const tokens = (inputTokens: number, outputTokens: number): UsageMetadata => ({
+  inputTokens,
+  outputTokens,
+  totalTokens: inputTokens + outputTokens,
+});
+
+// A round that asks for the `lookup` tool, so the orchestrator runs another round after it.
+const askForTool = (reported?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id: 'c', name: 'lookup', input: {}}},
+  {type: 'stop', stopReason: 'tool_use', usage: reported},
+];
+
+// A round that answers in text and ends the turn.
+const finish = (reported?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'Done.'},
+  {type: 'stop', stopReason: 'end_turn', usage: reported},
+];
+
+// Each provider call answers with the next scripted round, so the test controls what every call reports.
+async function runTurn(rounds: MessageChunk[][]): Promise<{called: boolean; usage?: UsageMetadata}> {
+  let call = 0;
+  const provider: AIProvider = {
+    async *sendMessage() {
+      yield* rounds[call++];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+
+  const registry = makeTestRegistry();
+
+  const received: {called: boolean; usage?: UsageMetadata} = {called: false};
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, usage) => {
+      received.called = true;
+      received.usage = usage;
+    },
+  };
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Usage test.'}), registry, {
+    hooks,
+  });
+  const session: ChatSession = {
+    sessionId: 's',
+    userId: 'u',
+    entries: [{role: 'user', content: 'look it up', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+
+  for await (const _chunk of orchestrator.processMessageStream(session)) {
+    // Drain the stream so the turn runs to completion and afterModelResponse fires.
+  }
+  return received;
+}
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports the sum of every provider call in a turn that ran two tool rounds', async () => {
+    const received = await runTurn([askForTool(tokens(100, 20)), askForTool(tokens(300, 40)), finish(tokens(500, 60))]);
+
+    expect(received.usage).toEqual(tokens(900, 120));
+  });
+
+  it('leaves out a round that reported nothing', async () => {
+    const partial = await runTurn([askForTool(tokens(10, 5)), askForTool(), finish(tokens(1, 2))]);
+    expect(partial.usage).toEqual(tokens(11, 7));
+  });
+
+  it('reports nothing when no round did', async () => {
+    const silent = await runTurn([askForTool(), finish()]);
+    expect(silent).toEqual({called: true, usage: undefined});
+  });
+});
