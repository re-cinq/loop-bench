+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+export const session = (sessionId = 's', userId = 'u'): ChatSession => ({
+  sessionId,
+  userId,
+  entries: [{role: 'user', content: 'Go.', timestamp: '2026-01-01T00:00:00.000Z'}],
+});
+
+export const usageStop = (stopReason: string, usage?: UsageMetadata): MessageChunk => ({
+  type: 'stop',
+  stopReason,
+  usage,
+});
+
+export const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield* rounds[round++] ?? [];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
