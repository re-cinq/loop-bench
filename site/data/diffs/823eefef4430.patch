+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {MessageChunk, TurnUsage} from '../types/ai.js';
+import {ToolRegistry} from './tools/registry.js';
+import {session, scriptedProvider, usageStop} from './orchestratorUsageTestSupport.js';
+
+const promptBuilder = new PromptBuilder({identity: 'Usage test.'});
+
+const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: 'c1', name: 't', input: {}}};
+
+const registry = (): ToolRegistry => {
+  const r = new ToolRegistry();
+  r.register({name: 't', description: 't', inputSchema: {type: 'object'}}, async () => 'ok');
+  return r;
+};
+
+describe('ChatOrchestrator usage aggregation', () => {
+  /** reports summed usage in a TurnUsage contract (specs/hal-engine-config-hooks/spec.md#L30) */
+  it('reports summed usage in a TurnUsage contract', async () => {
+    let reported: TurnUsage | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        reported = usage;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, usageStop('tool_use', {inputTokens: 10, outputTokens: 2, totalTokens: 12})],
+        [{type: 'text', text: 'Done.'}, usageStop('end_turn', {inputTokens: 20, outputTokens: 5, totalTokens: 25})],
+      ]),
+      promptBuilder,
+      registry(),
+      {hooks}
+    );
+
+    await orchestrator.processMessage(session());
+
+    expect(reported).toEqual({
+      inputTokens: 30,
+      outputTokens: 7,
+      totalTokens: 37,
+    });
+  });
+});
