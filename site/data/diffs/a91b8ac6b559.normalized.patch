diff --git a/src/orchestration/chatOrchestratorUsage.acceptance.test.ts b/src/orchestration/chatOrchestratorUsage.acceptance.test.ts
new file mode 100644
index 0000000..34bf055
--- /dev/null
+++ b/src/orchestration/chatOrchestratorUsage.acceptance.test.ts
@@ -0,0 +1,103 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks, TurnUsage} from './chatOrchestrator.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const counts = (inputTokens: number, outputTokens: number): UsageMetadata => ({
+  inputTokens,
+  outputTokens,
+  totalTokens: inputTokens + outputTokens,
+});
+
+const toolRound = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id: 'lookup-1', name: 'lookup', input: {}}},
+  {type: 'stop', stopReason: 'tool_use', usage},
+];
+
+const finalRound = (usage?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'Done.'},
+  {type: 'stop', stopReason: 'end_turn', usage},
+];
+
+async function reportedUsage(rounds: MessageChunk[][]): Promise<{providerCalls: number; usage?: UsageMetadata}> {
+  let providerCalls = 0;
+  let usage: UsageMetadata | undefined;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield* rounds[providerCalls++] ?? [];
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('This turn must not request structured output');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'Look up a value', inputSchema: {type: 'object'}},
+    async () => 'found'
+  );
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, reported) => {
+      usage = reported;
+    },
+  };
+  const session: ChatSession = {
+    sessionId: 'usage-turn',
+    userId: 'user',
+    entries: [{role: 'user', content: 'Look up twice', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  const orchestrator = createChatOrchestrator(
+    provider,
+    new PromptBuilder({identity: 'Answer after looking up values.'}),
+    registry,
+    {hooks}
+  );
+
+  await orchestrator.processMessage(session);
+  return {providerCalls, usage};
+}
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports the sum of every provider call, ignoring rounds without usage', async () => {
+    const everyRound = await reportedUsage([
+      toolRound(counts(11, 3)),
+      toolRound(counts(7, 5)),
+      finalRound(counts(2, 13)),
+    ]);
+    const missingMiddle = await reportedUsage([toolRound(counts(11, 3)), toolRound(), finalRound(counts(2, 13))]);
+    const noneReported = await reportedUsage([toolRound(), toolRound(), finalRound()]);
+
+    expect({everyRound, missingMiddle, noneReported}).toEqual({
+      everyRound: {providerCalls: 3, usage: counts(20, 21)},
+      missingMiddle: {providerCalls: 3, usage: counts(13, 16)},
+      noneReported: {providerCalls: 3, usage: undefined},
+    });
+  });
+
+  it('accepts a hook implementation that names the parameter TurnUsage, so CI typecheck confirms the alias', async () => {
+    let captured: TurnUsage | undefined;
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        yield* finalRound(counts(4, 6));
+      },
+      async generateStructured<T>(): Promise<T> {
+        throw new Error('not used');
+      },
+    };
+    const session: ChatSession = {
+      sessionId: 'type-check-turn',
+      userId: 'user',
+      entries: [{role: 'user', content: 'hi', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), undefined, {
+      hooks: {
+        afterModelResponse: async (_session, _text, totalUsage: TurnUsage | undefined) => {
+          captured = totalUsage;
+        },
+      },
+    });
+    await orchestrator.processMessage(session);
+    expect(captured).toEqual(counts(4, 6));
+  });
+});
