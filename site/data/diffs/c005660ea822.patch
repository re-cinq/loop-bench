+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+const failure = new Error('beforeSession failed');
+const session: ChatSession = {
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+const provider: AIProvider = {
+  async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+    yield {type: 'text', text: 'unused'};
+    yield {type: 'stop', stopReason: 'end_turn'};
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+describe('beforeSession failure acceptance', () => {
+  it('preserves the rejection and runs onError and afterSession with the session and original error', async () => {
+    let errorSession: ChatSession | undefined;
+    let receivedError: Error | undefined;
+    let afterSession: ChatSession | undefined;
+    const hooks: OrchestratorHooks = {
+      beforeSession: async () => {
+        throw failure;
+      },
+      onError: async (receivedSession, error) => {
+        errorSession = receivedSession;
+        receivedError = error;
+      },
+      afterSession: async receivedSession => {
+        afterSession = receivedSession;
+      },
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), undefined, {hooks});
+
+    await expect(orchestrator.processMessage(session)).rejects.toBe(failure);
+    expect({errorSession, receivedError, afterSession}).toEqual({
+      errorSession: session,
+      receivedError: failure,
+      afterSession: session,
+    });
+  });
+});