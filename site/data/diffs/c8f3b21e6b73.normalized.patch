--- /dev/null
+++ b/src/orchestration/usageAggregation.test.ts
@@ -0,0 +1,19 @@
+import {aggregateUsage} from './orchestratorHelpers.js';
+import type {UsageMetadata} from '../types/ai.js';
+
+describe('aggregateUsage', () => {
+  it('adds reported token fields and ignores an unreported round', () => {
+    const first: UsageMetadata = {inputTokens: 11, outputTokens: 2, totalTokens: 13};
+    const second: UsageMetadata = {inputTokens: 23, outputTokens: 3, totalTokens: 26};
+
+    expect({
+      bothReported: aggregateUsage(first, second),
+      oneReported: aggregateUsage(first, undefined),
+      noneReported: aggregateUsage(undefined, undefined),
+    }).toEqual({
+      bothReported: {inputTokens: 34, outputTokens: 5, totalTokens: 39},
+      oneReported: first,
+      noneReported: undefined,
+    });
+  });
+});
