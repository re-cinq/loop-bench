@@ -30,11 +30,46 @@ export function validateMessage(payload: unknown): ValidationResult {
       return validateUserMessage(message);
     case 'ping':
       return validatePingMessage(message);
+    case 'list_sessions':
+      return validateListSessionsMessage(message);
     default:
       return {valid: false, error: `Unknown message type: ${message.type}`};
   }
 }
 
+function validateListSessionsMessage(message: Record<string, unknown>): ValidationResult {
+  if (message.limit !== undefined && (!Number.isInteger(message.limit) || (message.limit as number) < 0)) {
+    return {valid: false, error: 'list_sessions limit must be a non-negative integer'};
+  }
+
+  let before: {updatedAt: string | number; sessionId: string} | undefined;
+  if (message.before !== undefined) {
+    if (typeof message.before !== 'object' || message.before === null || Array.isArray(message.before)) {
+      return {valid: false, error: 'list_sessions before must be an object'};
+    }
+    const cursor = message.before as Record<string, unknown>;
+    const dateIsValid =
+      (typeof cursor.updatedAt === 'string' && Number.isFinite(Date.parse(cursor.updatedAt))) ||
+      (typeof cursor.updatedAt === 'number' && Number.isFinite(new Date(cursor.updatedAt).getTime()));
+    if (!dateIsValid) {
+      return {valid: false, error: 'list_sessions before.updatedAt must be a finite date'};
+    }
+    if (typeof cursor.sessionId !== 'string' || cursor.sessionId.length < 1 || cursor.sessionId.length > 128) {
+      return {valid: false, error: 'list_sessions before.sessionId must be 1–128 characters'};
+    }
+    before = {updatedAt: cursor.updatedAt as string | number, sessionId: cursor.sessionId};
+  }
+
+  return {
+    valid: true,
+    data: {
+      type: 'list_sessions',
+      ...(message.limit !== undefined ? {limit: message.limit as number} : {}),
+      ...(before !== undefined ? {before} : {}),
+    },
+  };
+}
+
 function validateUserMessage(message: Record<string, unknown>): ValidationResult {
   if (typeof message.content !== 'string') {
     return {valid: false, error: 'user_message must have content string'};
