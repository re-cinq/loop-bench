+    this.schemaValidators.set(schema, compiled);
+    return compiled;
+  }
+
+  private resolveValidator(name: string, tool: StoredTool): ValidateFunction {
+    if (typeof tool.definitionSource !== 'function') return tool.validateInput;
+    const resolved = tool.definitionSource();
+    return this.getValidator(name, resolved.inputSchema);
