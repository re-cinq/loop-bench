+import {describe, expect, it} from '@jest/globals';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {createChatOrchestrator} from './chatOrchestrator.js';
+
+describe('beforeSession failure', () => {
+  it('passes the original error and session to onError before afterSession without starting the provider', async () => {
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const failure = new Error('setup failed');
+    const calls: string[] = [];
+    const observations: Record<string, boolean> = {};
+    const provider: AIProvider = {
+      async *sendMessage(): AsyncGenerator<MessageChunk> {
+        calls.push('provider');
+        yield {type: 'stop', stopReason: 'end_turn'};
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), undefined, {
+      hooks: {
+        beforeSession: async receivedSession => {
+          observations.beforeSessionReceivedSession = receivedSession === session;
+          calls.push('beforeSession');
+          throw failure;
+        },
+        beforeUserInput: async (_receivedSession, message) => {
+          calls.push('beforeUserInput');
+          return message;
+        },
+        onError: async (receivedSession, error) => {
+          observations.onErrorReceivedSession = receivedSession === session;
+          observations.onErrorReceivedFailure = error === failure;
+          calls.push('onError');
+        },
+        afterSession: async receivedSession => {
+          observations.afterSessionReceivedSession = receivedSession === session;
+          calls.push('afterSession');
+        },
+      },
+    });
+
+    try {
+      await orchestrator.processMessage(session);
+      observations.rejectedWithFailure = false;
+    } catch (error) {
+      observations.rejectedWithFailure = error === failure;
+    }
+    expect({observations, calls}).toEqual({
+      observations: {
+        beforeSessionReceivedSession: true,
+        onErrorReceivedSession: true,
+        onErrorReceivedFailure: true,
+        afterSessionReceivedSession: true,
+        rejectedWithFailure: true,
+      },
+      calls: ['beforeSession', 'onError', 'afterSession'],
+    });
+  });
+});
