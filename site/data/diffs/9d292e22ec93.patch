--- /dev/null
+++ b/src/orchestration/aggregateUsage.ts
@@ -0,0 +1,19 @@
+import type {UsageMetadata} from '../types/ai.js';
+
+export function aggregateUsage(...rounds: Array<UsageMetadata | undefined>): UsageMetadata | undefined {
+  const reported = rounds.filter((u): u is UsageMetadata => u !== undefined);
+
+  if (reported.length === 0) return undefined;
+
+  let inputTokens = 0;
+  let outputTokens = 0;
+  let totalTokens = 0;
+
+  for (const usage of reported) {
+    inputTokens += usage.inputTokens;
+    outputTokens += usage.outputTokens;
+    totalTokens += usage.totalTokens;
+  }
+
+  return {inputTokens, outputTokens, totalTokens};
+}
