+import type {UsageMetadata} from '../types/ai.js';
+import {aggregateUsage} from './aggregateUsage.js';
+
+describe('aggregateUsage', () => {
+  it('sums usage across multiple rounds', () => {
+    const round1: UsageMetadata = {inputTokens: 11, outputTokens: 2, totalTokens: 13};
+    const round2: UsageMetadata = {inputTokens: 23, outputTokens: 3, totalTokens: 26};
+    const round3: UsageMetadata = {inputTokens: 37, outputTokens: 5, totalTokens: 42};
+
+    const total = aggregateUsage(round1, round2, round3);
+
+    expect(total).toEqual({inputTokens: 71, outputTokens: 10, totalTokens: 81});
+  });
+
+  it('skips undefined rounds and sums only reported ones', () => {
+    const round1: UsageMetadata = {inputTokens: 2, outputTokens: 1, totalTokens: 3};
+    const round2: undefined = undefined;
+    const round3: UsageMetadata = {inputTokens: 7, outputTokens: 4, totalTokens: 11};
+
+    const total = aggregateUsage(round1, round2, round3);
+
+    expect(total).toEqual({inputTokens: 9, outputTokens: 5, totalTokens: 14});
+  });
+
+  it('returns undefined when all rounds are undefined', () => {
+    const total = aggregateUsage(undefined, undefined);
+
+    expect(total).toBeUndefined();
+  });
+
+  it('returns the single usage when only one round is defined', () => {
+    const usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+
+    const total = aggregateUsage(usage);
+
+    expect(total).toEqual(usage);
+  });
+});
