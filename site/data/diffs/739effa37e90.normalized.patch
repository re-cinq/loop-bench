@@ -0,0 +1,78 @@
+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, TotalUsageMetadata, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+const session: ChatSession = {
+  sessionId: 'usage-session',
+  userId: 'usage-user',
+  entries: [{role: 'user', content: 'Use the tool.', timestamp: '2026-01-01T00:00:00.000Z'}],
+};
+
+const rounds: MessageChunk[][] = [
+  [
+    {type: 'tool_use', toolCall: {id: 'lookup-1', name: 'lookup', input: {}}},
+    {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 11, outputTokens: 2, totalTokens: 13}},
+  ],
+  [{type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 23, outputTokens: 3, totalTokens: 26}}],
+];
+
+const provider: AIProvider = {
+  async *sendMessage(): AsyncGenerator<MessageChunk> {
+    yield* rounds.shift() ?? [];
+  },
+  async generateStructured<T>(): Promise<T> {
+    return {} as T;
+  },
+};
+
+describe('afterModelResponse aggregate usage', () => {
+  it('exposes the hook value as total provider-call usage', async () => {
+    let reported: TotalUsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, totalUsage) => {
+        reported = totalUsage;
+      },
+    };
+    const orchestrator = createChatOrchestrator(
+      {
+        async *sendMessage(): AsyncGenerator<MessageChunk> {
+          yield {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 4, outputTokens: 2, totalTokens: 6}};
+        },
+        async generateStructured<T>(): Promise<T> {
+          return {} as T;
+        },
+      },
+      new PromptBuilder({identity: 'Usage type test.'}),
+      undefined,
+      {hooks}
+    );
+
+    await orchestrator.processMessage(session);
+
+    expect(reported).toEqual({inputTokens: 4, outputTokens: 2, totalTokens: 6});
+  });
+
+  it('adds usage from the tool call and its follow-up provider call', async () => {
+    let reported: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, usage) => {
+        reported = usage;
+      },
+    };
+    const registry = new ToolRegistry();
+    registry.register(
+      {name: 'lookup', description: 'Looks up a value.', inputSchema: {type: 'object'}},
+      async () => 'found'
+    );
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Usage test.'}), registry, {
+      hooks,
+    });
+
+    await orchestrator.processMessage(session);
+
+    expect(reported).toEqual({inputTokens: 34, outputTokens: 5, totalTokens: 39});
+  });
+});
