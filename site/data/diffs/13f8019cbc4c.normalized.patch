+import {WebSocket} from 'ws';
+import {InMemorySessionStore} from '../../infrastructure/stores/inMemorySessionStore.js';
+import {setLogger} from '../../shared/logger.js';
+import type {HalServerOptions} from '../createServer.js';
+import {connectClient, startEngineWith, stopEngines} from '../wsTestSupport.js';
+import {validateMessage} from './validation.js';
+
+interface Frame {
+  type: string;
+  code?: string;
+  conversations?: Array<Record<string, unknown>>;
+}
+
+const history = {enabled: true};
+
+const waitForFrame = (client: WebSocket, type: string): Promise<Frame> =>
+  new Promise((resolve, reject) => {
+    client.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as Frame;
+      if (frame.type === type) resolve(frame);
+    });
+    client.on('error', reject);
+  });
+
+const waitForOneOf = (client: WebSocket, types: string[]): Promise<Frame> =>
+  new Promise((resolve, reject) => {
+    client.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as Frame;
+      if (types.includes(frame.type)) resolve(frame);
+    });
+    client.on('error', reject);
+  });
+
+const seed = (): InMemorySessionStore => {
+  const store = new InMemorySessionStore();
+  for (const [sessionId, userId, timestamp] of [
+    ['oldest', 'u1', '2026-01-01T00:00:00.000Z'],
+    ['middle', 'u1', '2026-01-02T00:00:00.000Z'],
+    ['newest', 'u1', '2026-01-03T00:00:00.000Z'],
+    ['another-user', 'u2', '2026-01-04T00:00:00.000Z'],
+  ]) {
+    const session = store.create(sessionId, userId);
+    session.entries.push({role: 'user', content: sessionId, timestamp});
+  }
+  return store;
+};
+
+afterEach(async () => {
+  await stopEngines();
+  await new Promise(resolve => setTimeout(resolve, 20));
+});
+
+beforeAll(() => {
+  setLogger({debug: () => undefined, info: () => undefined, warn: () => undefined, error: () => undefined});
+});
+
+afterAll(() => {
+  setLogger();
+});
+
+describe('conversation list over the WebSocket protocol', () => {
+  it('validates list_conversations with an optional bounded limit and composite cursor', () => {
+    expect(
+      validateMessage({
+        type: 'list_conversations',
+        limit: 20,
+        before: {updatedAt: '2026-01-03T00:00:00.000Z', sessionId: 'newest'},
+      })
+    ).toMatchObject({valid: true});
+
+    for (const [field, value] of [
+      ['limit', 0],
+      ['limit', 201],
+      ['limit', 1.5],
+      ['limit', '10'],
+      ['before', 'not a cursor'],
+      ['before', {updatedAt: 'not a date', sessionId: 'newest'}],
+      ['before', {updatedAt: '2026-01-03T00:00:00.000Z'}],
+    ] as const) {
+      const result = validateMessage({type: 'list_conversations', [field]: value});
+      expect(result).toMatchObject({valid: false, error: expect.stringContaining(field)});
+    }
+  });
+
+  it('answers the authenticated user’s paged list as ISO summaries and ignores a frame userId', async () => {
+    const store = seed();
+    const {url} = await startEngineWith({
+      sessionStore: store,
+      history,
+    } as unknown as Partial<HalServerOptions> & Pick<HalServerOptions, 'sessionStore'>);
+    const client = connectClient(url);
+    const connected = await waitForFrame(client, 'connected');
+    const received: Frame[] = [];
+    client.on('message', raw => received.push(JSON.parse(String(raw)) as Frame));
+
+    client.send(
+      JSON.stringify({
+        type: 'list_conversations',
+        userId: 'u2',
+        limit: 2,
+        before: {updatedAt: '2026-01-03T00:00:00.000Z', sessionId: 'newest'},
+      })
+    );
+    const list = await waitForOneOf(client, ['conversation_list', 'error']);
+
+    expect(connected.type).toBe('connected');
+    expect(list.type).toBe('conversation_list');
+    expect(received.map(frame => frame.type)).not.toContain('stream_end');
+    expect(list.conversations).toHaveLength(2);
+    expect(list.conversations?.map(conversation => conversation.sessionId)).toEqual(['middle', 'oldest']);
+    expect(list.conversations).toEqual(
+      expect.arrayContaining([
+        expect.objectContaining({
+          sessionId: 'middle',
+          entryCount: 1,
+          createdAt: expect.any(String),
+          updatedAt: '2026-01-02T00:00:00.000Z',
+        }),
+        expect.objectContaining({
+          sessionId: 'oldest',
+          entryCount: 1,
+          createdAt: expect.any(String),
+          updatedAt: '2026-01-01T00:00:00.000Z',
+        }),
+      ])
+    );
+  });
+
+  it('refuses the request when history is not enabled', async () => {
+    const {url} = await startEngineWith({sessionStore: seed()});
+    const client = connectClient(url);
+    await waitForFrame(client, 'connected');
+
+    client.send(JSON.stringify({type: 'list_conversations'}));
+    const error = await waitForFrame(client, 'error');
+
+    expect(error).toMatchObject({type: 'error', code: 'UNSUPPORTED'});
+  });
+});
