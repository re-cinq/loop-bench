+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// specs/hal-engine-config-hooks/spec.md#8
+it('reports both provider calls in the usage for one tool round', async () => {
+  const rounds: MessageChunk[][] = [
+    [
+      {type: 'tool_use', toolCall: {id: 'lookup-1', name: 'lookup', input: {}}},
+      {type: 'stop', stopReason: 'tool_use', usage: {inputTokens: 4, outputTokens: 2, totalTokens: 6}},
+    ],
+    [
+      {type: 'text', text: 'Done.'},
+      {type: 'stop', stopReason: 'end_turn', usage: {inputTokens: 7, outputTokens: 3, totalTokens: 10}},
+    ],
+  ];
+  let call = 0;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield* rounds[call++] ?? [];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'Lookup', inputSchema: {type: 'object'}}, async () => 'found');
+  const session: ChatSession = {
+    sessionId: 'usage-session',
+    userId: 'usage-user',
+    entries: [{role: 'user', content: 'Look it up.', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  let reported: UsageMetadata | undefined;
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Test assistant.'}), registry, {
+    hooks: {
+      afterModelResponse: async (_session, _text, totalUsage) => {
+        reported = totalUsage;
+      },
+    },
+  });
+
+  await orchestrator.processMessage(session);
+
+  expect(reported).toEqual({inputTokens: 11, outputTokens: 5, totalTokens: 16});
+});
diff --git a/src/orchestration/chatOrchestratorUsage.acceptance.test.ts b/src/orchestration/chatOrchestratorUsage.acceptance.test.ts
