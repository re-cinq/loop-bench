+import {createChatOrchestrator} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+// specs/hal-engine-config-hooks/spec.md#9
+it('keeps the sum of reported rounds when the final provider call omits usage', async () => {
+  const usageByCall: Array<UsageMetadata | undefined> = [
+    {inputTokens: 2, outputTokens: 3, totalTokens: 5},
+    {inputTokens: 7, outputTokens: 11, totalTokens: 18},
+    undefined,
+  ];
+  let call = 0;
+  const provider: AIProvider = {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      const round = call++;
+      const usage = usageByCall[round];
+      if (round < 2) {
+        yield {type: 'tool_use', toolCall: {id: `lookup-${round}`, name: 'lookup', input: {}}};
+        yield {type: 'stop', stopReason: 'tool_use', usage};
+        return;
+      }
+      yield {type: 'text', text: 'Done.'};
+      yield {type: 'stop', stopReason: 'end_turn', usage};
+    },
+    async generateStructured<T>(): Promise<T> {
+      throw new Error('Structured generation is not used in this test');
+    },
+  };
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'Lookup', inputSchema: {type: 'object'}}, async () => 'found');
+  const reports: Array<UsageMetadata | undefined> = [];
+  const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'Test assistant.'}), registry, {
+    hooks: {
+      afterModelResponse: async (_session, _text, totalUsage) => {
+        reports.push(totalUsage);
+      },
+    },
+  });
+
+  const session: ChatSession = {
+    sessionId: 'missing-usage-session',
+    userId: 'missing-usage-user',
+    entries: [{role: 'user', content: 'Look twice.', timestamp: '2026-01-01T00:00:00.000Z'}],
+  };
+  await orchestrator.processMessage(session);
+
+  expect({call, reports}).toEqual({call: 3, reports: [{inputTokens: 9, outputTokens: 14, totalTokens: 23}]});
+});
