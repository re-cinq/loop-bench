@@ -0,0 +1,179 @@
+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+const WEATHER_TOOL: ToolDefinition = {
+  name: 'get_weather',
+  description: 'Fetch forecast for a city',
+  inputSchema: {
+    type: 'object',
+    properties: {
+      location: {type: 'string'},
+      units: {type: 'string', enum: ['celsius', 'fahrenheit'], default: 'celsius'},
+    },
+    required: ['location'],
+  },
+};
+
+describe('ToolRegistry', () => {
+  it('rejects input missing a required property with a ToolResponse and never calls the executor', async () => {
+    const receivedInputs: Array<Record<string, unknown>> = [];
+    const registry = new ToolRegistry();
+    registry.register(WEATHER_TOOL, async input => {
+      receivedInputs.push(input);
+      return '20C';
+    });
+
+    const {result} = await registry.execute('get_weather', {});
+
+    expect({
+      receivedInputs,
+      namesMissingLocation: result.includes('location') && /required/i.test(result),
+    }).toEqual({
+      receivedInputs: [],
+      namesMissingLocation: true,
+    });
+  });
+
+  it('passes valid input with an unlisted extra property through to the executor unchanged once', async () => {
+    const registry = new ToolRegistry();
+    const receivedInputs: Array<Record<string, unknown>> = [];
+    registry.register(WEATHER_TOOL, async input => {
+      receivedInputs.push(input);
+      return 'ok';
+    });
+
+    await registry.execute('get_weather', {location: 'Berlin', extraKey: 42});
+
+    expect(receivedInputs).toEqual([{location: 'Berlin', extraKey: 42}]);
+  });
+
+  it('rejects a wrong-typed field naming the path and expected type without leaking the offending value to result or logs', async () => {
+    const emittedLogEntries: unknown[] = [];
+    const captureLog = (...args: unknown[]) => void emittedLogEntries.push(args);
+    setLogger({debug: captureLog, info: captureLog, warn: captureLog, error: captureLog});
+
+    try {
+      const invokedWith: unknown[] = [];
+      const registry = new ToolRegistry();
+      registry.register(WEATHER_TOOL, async input => {
+        invokedWith.push(input);
+        return 'ok';
+      });
+
+      const {result} = await registry.execute('get_weather', {location: 987654321});
+      const serializedLogs = JSON.stringify(emittedLogEntries);
+
+      expect({
+        invokedWith,
+        hasFieldAndType: result.includes('location') && result.includes('string'),
+        containsSecretValue: result.includes('987654321') || serializedLogs.includes('987654321'),
+      }).toEqual({
+        invokedWith: [],
+        hasFieldAndType: true,
+        containsSecretValue: false,
+      });
+    } finally {
+      setLogger(undefined);
+    }
+  });
+
+  it('throws Unknown tool for an unregistered tool name', async () => {
+    const registry = new ToolRegistry();
+
+    await expect(registry.execute('missing_tool', {})).rejects.toThrow('Unknown tool: missing_tool');
+  });
+
+  it('throws at register time naming the tool when inputSchema is invalid JSON Schema', () => {
+    const registry = new ToolRegistry();
+
+    expect(() =>
+      registry.register(
+        {
+          name: 'invalid_schema_tool',
+          description: 'Declares an invalid JSON Schema type',
+          inputSchema: {
+            type: 'object',
+            properties: {location: {type: 'invalid-type'}},
+          },
+        },
+        async () => 'ok'
+      )
+    ).toThrow(/invalid_schema_tool/);
+  });
+
+  it('compiles a static tool schema once at register time across ten execute calls', async () => {
+    const registry = new ToolRegistry();
+    let schemaReads = 0;
+    const rawSchema: Record<string, unknown> = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    const definition = {
+      name: 'static_weather',
+      description: 'Get weather for a location',
+      get inputSchema(): Record<string, unknown> {
+        schemaReads += 1;
+        return rawSchema;
+      },
+    };
+
+    registry.register(definition, async input => `ok:${String(input.location)}`);
+    const readsAtRegister = schemaReads;
+
+    for (let i = 0; i < 10; i += 1) {
+      await registry.execute('static_weather', {location: `City-${i}`});
+    }
+
+    expect({readsAtRegister, readsAfterTenExecutes: schemaReads}).toEqual({
+      readsAtRegister: 1,
+      readsAfterTenExecutes: 1,
+    });
+  });
+
+  it('validates a function-valued tool definition against the schema returned on each call', async () => {
+    const registry = new ToolRegistry();
+    let executorCalls = 0;
+    let activeSchema: Record<string, unknown> = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+
+    registry.register(
+      () => ({
+        name: 'dynamic_weather',
+        description: 'Get weather for a location',
+        inputSchema: activeSchema,
+      }),
+      async input => {
+        executorCalls += 1;
+        return JSON.stringify(input);
+      }
+    );
+
+    const firstCallResponse = await registry.execute('dynamic_weather', {location: 'Paris'});
+
+    activeSchema = {
+      type: 'object',
+      properties: {zipCode: {type: 'number'}},
+      required: ['zipCode'],
+    };
+    const staleInputRejection = await registry.execute('dynamic_weather', {location: 'Paris'});
+    const updatedSchemaValid = await registry.execute('dynamic_weather', {zipCode: 75001});
+
+    expect({
+      executorCalls,
+      firstCallResult: JSON.parse(firstCallResponse.result),
+      rejectedMentionsZipCode:
+        staleInputRejection.result.includes('zipCode') && /required/i.test(staleInputRejection.result),
+      updatedCallResult: JSON.parse(updatedSchemaValid.result),
+    }).toEqual({
+      executorCalls: 2,
+      firstCallResult: {location: 'Paris'},
+      rejectedMentionsZipCode: true,
+      updatedCallResult: {zipCode: 75001},
+    });
+  });
+});
