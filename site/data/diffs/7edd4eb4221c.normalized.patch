@@ -519,4 +519,58 @@ describe('ChatOrchestrator tool loop', () => {
 
     expect(seen).toEqual(usage);
   });
+
+  it('feeds a tool schema rejection back as a tool_result so the model can correct the call on the next round', async () => {
+    const executorInputs: Array<Record<string, unknown>> = [];
+    const seenMessagesPerRound: Array<SendMessageParams['messages']> = [];
+    const registry = new ToolRegistry();
+    registry.register(
+      {
+        name: 'get_weather',
+        description: 'Get weather for a location',
+        inputSchema: {
+          type: 'object',
+          properties: {location: {type: 'string'}},
+          required: ['location'],
+        },
+      },
+      async input => {
+        executorInputs.push(input);
+        return `22C in ${String(input.location)}`;
+      }
+    );
+
+    const rounds: MessageChunk[][] = [
+      [{type: 'tool_use', toolCall: {id: 'call-1', name: 'get_weather', input: {}}}, STOP_FOR_TOOL],
+      [{type: 'tool_use', toolCall: {id: 'call-2', name: 'get_weather', input: {location: 'Paris'}}}, STOP_FOR_TOOL],
+      [{type: 'text', text: '22C in Paris'}, STOP_DONE],
+    ];
+    let round = 0;
+    const provider: AIProvider = {
+      async *sendMessage(params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        seenMessagesPerRound.push([...params.messages]);
+        for (const chunk of rounds[round++] ?? []) yield chunk;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registry);
+    const reply = await orchestrator.processMessage(createSession('What is the weather in Paris?'));
+
+    const roundOneLastMsg = seenMessagesPerRound[1]?.[seenMessagesPerRound[1].length - 1];
+    const firstBlock = Array.isArray(roundOneLastMsg?.content) ? roundOneLastMsg.content[0] : undefined;
+    const rejectionResult = firstBlock && 'content' in firstBlock ? firstBlock.content : '';
+
+    expect({
+      reply,
+      executorInputs,
+      rejectedForLocation: rejectionResult.includes('location') && /required/i.test(rejectionResult),
+    }).toEqual({
+      reply: '22C in Paris',
+      executorInputs: [{location: 'Paris'}],
+      rejectedForLocation: true,
+    });
+  });
 });
