+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolResponse} from './tools/registry.js';
+
+// Fixed: nothing asserts on it, and new Date() would tie the run to the clock.
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+// One scripted round per sendMessage call, so each round reports the usage it is given.
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const lookupRegistry = (): ToolRegistry => {
+  const response: ToolResponse = {result: 'found it'};
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => response
+  );
+  return registry;
+};
+
+const toolRound = (id: string): MessageChunk => ({
+  type: 'tool_use',
+  toolCall: {id, name: 'lookup', input: {q: 'x'}},
+});
+const text = (value: string): MessageChunk => ({type: 'text', text: value});
+const stop = (stopReason: string, usage?: UsageMetadata): MessageChunk => ({type: 'stop', stopReason, usage});
+const usage = (inputTokens: number, outputTokens: number): UsageMetadata => ({
+  inputTokens,
+  outputTokens,
+  totalTokens: inputTokens + outputTokens,
+});
+
+// Captures what afterModelResponse receives as its usage argument for one turn.
+const usageReportedFor = async (provider: AIProvider): Promise<UsageMetadata | undefined> => {
+  let reported: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, turnUsage) => {
+      reported = turnUsage;
+    },
+  };
+
+  await createChatOrchestrator(provider, promptBuilder, lookupRegistry(), {hooks}).processMessage(createSession('ask'));
+  return reported;
+};
+
+describe('afterModelResponse usage across tool rounds', () => {
+  it('reports the usage of every provider call in a turn that ran two tool rounds', async () => {
+    const provider = scriptedProvider([
+      [toolRound('c1'), stop('tool_use', usage(10, 5))],
+      [toolRound('c2'), stop('tool_use', usage(20, 7))],
+      [text('the answer'), stop('end_turn', usage(30, 9))],
+    ]);
+
+    expect(await usageReportedFor(provider)).toEqual({inputTokens: 60, outputTokens: 21, totalTokens: 81});
+  });
+
+  it('counts the rounds that reported and leaves the total undefined when no round reported', async () => {
+    const partial = scriptedProvider([
+      [toolRound('c1'), stop('tool_use', usage(10, 5))],
+      [toolRound('c2'), stop('tool_use')],
+      [text('the answer'), stop('end_turn', usage(30, 9))],
+    ]);
+    const silent = scriptedProvider([
+      [toolRound('c1'), stop('tool_use')],
+      [text('the answer'), stop('end_turn')],
+    ]);
+
+    expect({
+      partial: await usageReportedFor(partial),
+      silent: await usageReportedFor(silent),
+    }).toEqual({
+      partial: {inputTokens: 40, outputTokens: 14, totalTokens: 54},
+      silent: undefined,
+    });
+  });
+});
