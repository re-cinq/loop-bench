index 0000000..d06c298
--- /dev/null
+++ b/src/orchestration/tools/registry.acceptance.test.ts
@@ -0,0 +1,73 @@
+import {ToolRegistry} from './registry.js';
+
+const tool = (inputSchema: Record<string, unknown>) => ({
+  name: 'weather',
+  description: 'gets weather',
+  inputSchema,
+});
+
+describe('ToolRegistry input validation', () => {
+  it('rejects missing required input before invoking the executor', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+
+    registry.register(
+      tool({type: 'object', required: ['location'], properties: {location: {type: 'string'}}}),
+      async () => {
+        calls += 1;
+        return 'forecast';
+      }
+    );
+
+    const response = await registry.execute('weather', {});
+
+    expect(response.result).toMatch(/location.*required/i);
+    expect(calls).toBe(0);
+  });
+
+  it('rejects wrong-typed input without leaking its value', async () => {
+    const registry = new ToolRegistry();
+    let calls = 0;
+    const identifyingValue = 'secret-location';
+
+    registry.register(tool({type: 'object', properties: {location: {type: 'string'}}}), async () => {
+      calls += 1;
+      return 'forecast';
+    });
+
+    const response = await registry.execute('weather', {location: 42, identifyingValue});
+
+    expect(response.result).toMatch(/location.*string/i);
+    expect(response.result).not.toContain('42');
+    expect(response.result).not.toContain(identifyingValue);
+    expect(calls).toBe(0);
+  });
+
+  it('rejects an uncompilable schema at registration time', () => {
+    const registry = new ToolRegistry();
+
+    expect(() => registry.register(tool({type: 'not-a-json-schema-type'}), async () => 'forecast')).toThrow(/weather/i);
+  });
+
+  it('validates function-valued definitions against the current schema', async () => {
+    const registry = new ToolRegistry();
+    let current = tool({type: 'object', required: ['location'], properties: {location: {type: 'string'}}});
+    let calls = 0;
+
+    registry.register(
+      () => current,
+      async () => {
+        calls += 1;
+        return 'forecast';
+      }
+    );
+
+    const first = await registry.execute('weather', {});
+    current = tool({type: 'object', required: ['city'], properties: {city: {type: 'string'}}});
+    const second = await registry.execute('weather', {city: 'Berlin'});
+
+    expect(first.result).toMatch(/location.*required/i);
+    expect(second.result).toBe('forecast');
+    expect(calls).toBe(1);
+  });
+});