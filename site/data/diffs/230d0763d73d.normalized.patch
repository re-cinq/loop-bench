+import {ToolRegistry} from './registry.js';
+
+function exposeLegacyDataPath(registry: ToolRegistry, path: (instancePath: string) => string): void {
+  const ajv = Reflect.get(registry, 'ajv') as {
+    compile: (schema: object) => ((input: Record<string, unknown>) => boolean) & {errors?: unknown[]};
+  };
