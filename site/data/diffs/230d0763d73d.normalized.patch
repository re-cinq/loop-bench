+import {ToolRegistry} from './registry.js';
+
+// spec: specs/hal-engine-tool-input-validation#2
+it('normalizes a slash-prefixed legacy input root in a rejected path', async () => {
+  const registry = new ToolRegistry();
+  const ajv = Reflect.get(registry, 'ajv') as {
+    compile: (schema: object) => ((input: Record<string, unknown>) => boolean) & {errors?: unknown[]};
+  };
+  const originalCompile = ajv.compile.bind(ajv);
+  ajv.compile = schema => {
+    const validator = originalCompile(schema);
+    const legacyValidator = ((input: Record<string, unknown>) => {
+      const valid = validator(input);
+      if (!valid && validator.errors) {
+        const error = validator.errors[0] as {dataPath?: string; instancePath?: string};
+        error.dataPath = `/input${error.instancePath ?? ''}`;
+        delete error.instancePath;
+      }
+      legacyValidator.errors = validator.errors;
+      return valid;
+    }) as ((input: Record<string, unknown>) => boolean) & {errors?: unknown[]};
+    return legacyValidator;
+  };
+  registry.register(
+    () => ({
+      name: 'slash_prefixed_legacy_path',
+      description: 'Validate a slash-prefixed legacy path',
+      inputSchema: {type: 'object', properties: {profile: {type: 'object', properties: {name: {type: 'string'}}}}},
+    }),
+    async () => 'found'
+  );
+
+  const response = await registry.execute('slash_prefixed_legacy_path', {profile: {name: 123}});
+
+  expect(response.result).toContain("property 'profile.name'");
+});
