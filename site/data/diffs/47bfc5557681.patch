+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+import type {ToolResponse} from './tools/registry.js';
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+function createSession(content: string): ChatSession {
+  return {
+    sessionId: 's1',
+    userId: 'u1',
+    entries: [{role: 'user', content, timestamp: SENT_AT}],
+  };
+}
+
+const promptBuilder = new PromptBuilder({identity: 'You are a test assistant.'});
+
+const TOOL_CALL: MessageChunk = {
+  type: 'tool_use',
+  toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}},
+};
+const STOP_FOR_TOOL: MessageChunk = {type: 'stop', stopReason: 'tool_use'};
+const STOP_DONE: MessageChunk = {type: 'stop', stopReason: 'end_turn'};
+
+// Provider that yields different usage on each round for testing accumulation
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const registryReturning = (response: ToolResponse): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register(
+    {name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}},
+    async () => response
+  );
+  return registry;
+};
+
+describe('ChatOrchestrator usage accumulation across tool rounds', () => {
+  it('accumulates usage from every tool round and passes the sum to afterModelResponse', async () => {
+    const usage1: UsageMetadata = {inputTokens: 100, outputTokens: 50, totalTokens: 150};
+    const usage2: UsageMetadata = {inputTokens: 80, outputTokens: 30, totalTokens: 110};
+
+    let receivedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, u) => {
+        receivedUsage = u;
+      },
+    };
+
+    const provider = scriptedProvider([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usage1}],
+      [{type: 'text', text: 'answer'}, {type: 'stop', stopReason: 'end_turn', usage: usage2}],
+    ]);
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registryReturning({result: 'ok'}), {
+      hooks,
+    });
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(receivedUsage).toEqual({
+      inputTokens: usage1.inputTokens + usage2.inputTokens,
+      outputTokens: usage1.outputTokens + usage2.outputTokens,
+      totalTokens: usage1.totalTokens + usage2.totalTokens,
+    });
+  });
+
+  it('preserves single-round usage when no tool round occurs', async () => {
+    const usage: UsageMetadata = {inputTokens: 10, outputTokens: 5, totalTokens: 15};
+    let receivedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, u) => {
+        receivedUsage = u;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([[{type: 'text', text: 'hello'}, {type: 'stop', stopReason: 'end_turn', usage}]]),
+      promptBuilder,
+      undefined,
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createSession('hi'));
+
+    expect(receivedUsage).toEqual(usage);
+  });
+
+  it('accumulates usage when only some rounds report it', async () => {
+    const usage1: UsageMetadata = {inputTokens: 100, outputTokens: 50, totalTokens: 150};
+
+    let receivedUsage: UsageMetadata | undefined;
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, u) => {
+        receivedUsage = u;
+      },
+    };
+
+    const provider = scriptedProvider([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use', usage: usage1}],
+      [{type: 'text', text: 'answer'}, {type: 'stop', stopReason: 'end_turn'}],
+    ]);
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registryReturning({result: 'ok'}), {
+      hooks,
+    });
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(receivedUsage).toEqual(usage1);
+  });
+
+  it('reports undefined when no round reports usage', async () => {
+    let receivedUsage: UsageMetadata | undefined = {inputTokens: 999, outputTokens: 999, totalTokens: 999};
+
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_session, _text, u) => {
+        receivedUsage = u;
+      },
+    };
+
+    const provider = scriptedProvider([
+      [TOOL_CALL, {type: 'stop', stopReason: 'tool_use'}],
+      [{type: 'text', text: 'answer'}, {type: 'stop', stopReason: 'end_turn'}],
+    ]);
+
+    const orchestrator = createChatOrchestrator(provider, promptBuilder, registryReturning({result: 'ok'}), {
+      hooks,
+    });
+
+    await orchestrator.processMessage(createSession('ask'));
+
+    expect(receivedUsage).toBeUndefined();
+  });
+});