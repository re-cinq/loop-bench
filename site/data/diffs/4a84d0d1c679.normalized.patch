+import type {Message, MessageChunk, ToolCall, TotalUsage, UsageMetadata} from '../types/ai.js';
 import type {ToolRegistry} from './tools/registry.js';
 
 export function shouldContinueToolLoop(
@@ -40,3 +40,13 @@ export function extractStopReason(chunk: MessageChunk): string | null {
 export function extractUsage(chunk: MessageChunk): UsageMetadata | undefined {
   return chunk.type === 'stop' ? chunk.usage : undefined;
 }
+
+// A round that reports nothing adds nothing, so a turn where no round reported stays undefined.
+export function addRoundUsage(total: TotalUsage | undefined, round: UsageMetadata | undefined): TotalUsage | undefined {
+  if (!round) return total;
+  return {
+    inputTokens: (total?.inputTokens ?? 0) + round.inputTokens,
+    outputTokens: (total?.outputTokens ?? 0) + round.outputTokens,
+    totalTokens: (total?.totalTokens ?? 0) + round.totalTokens,
+  };
+}
