+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import {ToolRegistry} from './tools/registry.js';
+
+// HALEngine#93: afterModelResponse reports the usage of every provider call in a turn.
+
+const SENT_AT = '2026-01-01T00:00:00.000Z';
+
+const usage = (inputTokens: number, outputTokens: number): UsageMetadata => ({
+  inputTokens,
+  outputTokens,
+  totalTokens: inputTokens + outputTokens,
+});
+
+// One scripted round per sendMessage call.
+const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+      for (const chunk of rounds[round++] ?? []) yield chunk;
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+const lookupRegistry = (): ToolRegistry => {
+  const registry = new ToolRegistry();
+  registry.register({name: 'lookup', description: 'looks things up', inputSchema: {type: 'object'}}, async () => ({
+    result: 'found it',
+  }));
+  return registry;
+};
+
+const toolRound = (reported?: UsageMetadata): MessageChunk[] => [
+  {type: 'tool_use', toolCall: {id: 'call-1', name: 'lookup', input: {q: 'x'}}},
+  {type: 'stop', stopReason: 'tool_use', usage: reported},
+];
+
+const textRound = (reported?: UsageMetadata): MessageChunk[] => [
+  {type: 'text', text: 'the answer'},
+  {type: 'stop', stopReason: 'end_turn', usage: reported},
+];
+
+const session = (): ChatSession => ({
+  sessionId: 's1',
+  userId: 'u1',
+  entries: [{role: 'user', content: 'ask', timestamp: SENT_AT}],
+});
+
+// Runs one turn and returns what afterModelResponse was handed as its usage argument.
+const usageHandedToHook = async (rounds: MessageChunk[][]): Promise<UsageMetadata | undefined> => {
+  let handed: UsageMetadata | undefined;
+  const hooks: OrchestratorHooks = {
+    afterModelResponse: async (_session, _text, reported) => {
+      handed = reported;
+    },
+  };
+  const orchestrator = createChatOrchestrator(
+    scriptedProvider(rounds),
+    new PromptBuilder({identity: 'Usage test.'}),
+    lookupRegistry(),
+    {hooks}
+  );
+
+  await orchestrator.processMessage(session());
+  return handed;
+};
+
+describe('turn usage across tool rounds', () => {
+  it('reports the sum of every provider call in a turn that ran two tool rounds', async () => {
+    const handed = await usageHandedToHook([
+      toolRound(usage(100, 20)),
+      toolRound(usage(150, 30)),
+      textRound(usage(210, 40)),
+    ]);
+
+    expect(handed).toEqual(usage(100 + 150 + 210, 20 + 30 + 40));
+  });
+
+  it('counts the rounds that reported usage when an earlier round reports none', async () => {
+    const handed = await usageHandedToHook([
+      toolRound(usage(100, 20)),
+      toolRound(undefined),
+      textRound(usage(210, 40)),
+    ]);
+
+    expect(handed).toEqual(usage(100 + 210, 20 + 40));
+  });
+});