+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {AIProvider, MessageChunk, SendMessageParams} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+
+describe('non-Error provider rejections', () => {
+  it.each([
+    ['a string', 'provider failed'],
+    ['a plain object', {code: 'PROVIDER_FAILURE'}],
+    ['undefined', undefined],
+  ])('calls onError with an Error caused by %s and preserves the rejection', async (_label, rejection) => {
+    const provider: AIProvider = {
+      // eslint-disable-next-line require-yield
+      async *sendMessage(_params: SendMessageParams): AsyncGenerator<MessageChunk> {
+        throw rejection;
+      },
+      async generateStructured<T>(): Promise<T> {
+        return {} as T;
+      },
+    };
+    const session: ChatSession = {
+      sessionId: 's1',
+      userId: 'u1',
+      entries: [{role: 'user', content: 'hello', timestamp: '2026-01-01T00:00:00.000Z'}],
+    };
+    const observed: Error[] = [];
+    const orchestrator = createChatOrchestrator(provider, new PromptBuilder({identity: 'test'}), undefined, {
+      hooks: {onError: async (_session, error) => void observed.push(error)},
+    });
+
+    const result = await orchestrator.processMessage(session).then(
+      () => ({rejected: false as const}),
+      reason => ({rejected: true as const, reason})
+    );
+
+    expect(result).toEqual({rejected: true, reason: rejection});
+    expect(observed).toHaveLength(1);
+    expect(observed[0]).toBeInstanceOf(Error);
+    expect(observed[0].cause).toBe(rejection);
+  });
+});