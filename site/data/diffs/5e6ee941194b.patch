+import {ToolRegistry} from './registry.js';
+import {setLogger} from '../../shared/logger.js';
+import type {ToolDefinition} from '../../types/ai.js';
+
+describe('ToolRegistry', () => {
+  afterEach(() => {
+    setLogger(undefined);
+  });
+
+  it('compiles a static inputSchema once at register time and reuses it across ten execute calls', async () => {
+    const registry = new ToolRegistry();
+    let schemaReads = 0;
+    const schema: ToolDefinition['inputSchema'] = {
+      type: 'object',
+      properties: {query: {type: 'string'}},
+      required: ['query'],
+    };
+    const definition: ToolDefinition = {
+      name: 'search_docs',
+      description: 'Search documentation',
+      get inputSchema() {
+        schemaReads += 1;
+        return schema;
+      },
+    };
+
+    registry.register(definition, async () => 'ok');
+    const readsAtRegister = schemaReads;
+
+    for (let i = 0; i < 10; i++) {
+      await registry.execute('search_docs', {query: 'hal'});
+    }
+
+    const registerFailureMessage = await Promise.resolve()
+      .then(() =>
+        registry.register(
+          {
+            name: 'broken_tool',
+            description: 'Has an invalid schema',
+            inputSchema: {
+              type: 'not-a-json-schema-type',
+              properties: {},
+            },
+          },
+          async () => 'unreachable'
+        )
+      )
+      .then(() => 'returned without throwing')
+      .catch((error: Error) => error.message);
+
+    expect({
+      readsAtRegister,
+      readsAfterTenExecutes: schemaReads,
+      mentionsBrokenTool: registerFailureMessage.includes('broken_tool'),
+    }).toEqual({
+      readsAtRegister: 1,
+      readsAfterTenExecutes: 1,
+      mentionsBrokenTool: true,
+    });
+  });
+
+  it('rejects missing required or wrong-typed input without calling the executor or leaking values', async () => {
+    const emitted: string[] = [];
+    const appendLog = (cat: string, msg: string, logFields?: Record<string, unknown>) => {
+      emitted.push(`${cat}:${msg}:${JSON.stringify(logFields)}`);
+    };
+    setLogger({debug: appendLog, info: appendLog, warn: appendLog, error: appendLog});
+
+    const registry = new ToolRegistry();
+    let invoked = 0;
+    const schema: ToolDefinition['inputSchema'] = {
+      type: 'object',
+      properties: {location: {type: 'string'}},
+      required: ['location'],
+    };
+    registry.register({name: 'forecast', description: 'Lookup forecast', inputSchema: schema}, async () => {
+      invoked += 1;
+      return 'clear';
+    });
+
+    const missingResult = (await registry.execute('forecast', {})).result;
+    const secret = '987-65-4321';
+    const wrongTypeResult = (await registry.execute('forecast', {location: 987654321, tag: secret})).result;
+
+    expect({
+      invoked,
+      missingHasLocation: missingResult.includes('location'),
+      missingHasRequired: /required/i.test(missingResult),
+      wrongHasLocation: wrongTypeResult.includes('location'),
+      wrongHasString: wrongTypeResult.includes('string'),
+      leaksNumber: wrongTypeResult.includes('987654321') || emitted.some(e => e.includes('987654321')),
+      leaksSecret: wrongTypeResult.includes(secret) || emitted.some(e => e.includes(secret)),
+    }).toEqual({
+      invoked: 0,
+      missingHasLocation: true,
+      missingHasRequired: true,
+      wrongHasLocation: true,
+      wrongHasString: true,
+      leaksNumber: false,
+      leaksSecret: false,
+    });
+  });
+
+  it('passes valid input with an unlisted extra property through to the executor unchanged and throws Unknown tool for an unregistered name', async () => {
+    const registry = new ToolRegistry();
+    const receivedInputs: Array<Record<string, unknown>> = [];
+    registry.register(
+      {
+        name: 'convert_temp',
+        description: 'Convert temperature',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            unit: {type: 'string', enum: ['celsius', 'fahrenheit'], default: 'celsius'},
+          },
+          required: ['unit'],
+        },
+      },
+      async input => {
+        receivedInputs.push(input);
+        return 'converted';
+      }
+    );
+
+    const response = await registry.execute('convert_temp', {unit: 'celsius', extraFlag: 42});
+    const unknownToolOutcome = await registry
+      .execute('missing_tool', {})
+      .then(() => 'resolved')
+      .catch((error: Error) => error.message);
+
+    expect({
+      response,
+      receivedInputs,
+      unknownToolOutcome,
+    }).toEqual({
+      response: {result: 'converted'},
+      receivedInputs: [{unit: 'celsius', extraFlag: 42}],
+      unknownToolOutcome: 'Unknown tool: missing_tool',
+    });
+  });
+
+  it('validates a function-valued tool definition against the schema returned on each execute call', async () => {
+    const registry = new ToolRegistry();
+    const firstSchema: ToolDefinition['inputSchema'] = {
+      type: 'object',
+      properties: {mode: {type: 'string', enum: ['alpha']}},
+      required: ['mode'],
+    };
+    const secondSchema: ToolDefinition['inputSchema'] = {
+      type: 'object',
+      properties: {mode: {type: 'string', enum: ['beta']}},
+      required: ['mode'],
+    };
+    let activeSchema = firstSchema;
+    const acceptedModes: string[] = [];
+
+    registry.register(
+      () => ({
+        name: 'switch_mode',
+        description: 'Switch operating mode',
+        inputSchema: activeSchema,
+      }),
+      async input => {
+        acceptedModes.push(String(input.mode));
+        return 'switched';
+      }
+    );
+
+    const alphaOnFirst = await registry.execute('switch_mode', {mode: 'alpha'});
+    activeSchema = secondSchema;
+    const alphaOnSecond = await registry.execute('switch_mode', {mode: 'alpha'});
+    const betaOnSecond = await registry.execute('switch_mode', {mode: 'beta'});
+
+    expect({
+      alphaOnFirst: alphaOnFirst.result,
+      alphaRejectedOnSecond: alphaOnSecond.result.includes('mode'),
+      betaOnSecond: betaOnSecond.result,
+      acceptedModes,
+    }).toEqual({
+      alphaOnFirst: 'switched',
+      alphaRejectedOnSecond: true,
+      betaOnSecond: 'switched',
+      acceptedModes: ['alpha', 'beta'],
+    });
+  });
+});
