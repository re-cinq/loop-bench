+++ b/src/orchestration/turnUsageMissing.test.ts
@@ -0,0 +1,16 @@
+import {sumUsage} from './turnUsage.js';
+
+// @spec specs/hal-engine-turn-usage/spec.md#2
+it('ignores missing usage before, between, and after reported rounds', () => {
+  const first = {inputTokens: 2, outputTokens: 1, totalTokens: 3};
+  const second = {inputTokens: 7, outputTokens: 4, totalTokens: 11};
+  const empty = sumUsage(undefined, undefined);
+  const started = sumUsage(empty, first);
+  const gap = sumUsage(started, undefined);
+  const total = sumUsage(gap, second);
+  expect({empty, started, total: sumUsage(total, undefined)}).toEqual({
+    empty: undefined,
+    started: first,
+    total: {inputTokens: 9, outputTokens: 5, totalTokens: 14},
+  });
+});
