+import {sumUsage} from './turnUsage.js';
+
+// @spec specs/hal-engine-turn-usage/spec.md#1
+it('sums each reported token field across two provider calls', () => {
+  const first = {inputTokens: 11, outputTokens: 3, totalTokens: 17};
+  const second = {inputTokens: 23, outputTokens: 7, totalTokens: 31};
+
+  expect(sumUsage(first, second)).toEqual({inputTokens: 34, outputTokens: 10, totalTokens: 48});
+});
diff --git a/src/orchestration/turnUsage.ts b/src/orchestration/turnUsage.ts
new file mode 100644
index 0000000..c4fc299
--- /dev/null
+++ b/src/orchestration/turnUsage.ts
@@ -0,0 +1,14 @@
+import type {UsageMetadata} from '../types/ai.js';
+
+export function sumUsage(
+  total: UsageMetadata | undefined,
+  round: UsageMetadata | undefined
+): UsageMetadata | undefined {
+  if (!total) return round;
+  if (!round) return total;
+  return {
+    inputTokens: total.inputTokens + round.inputTokens,
+    outputTokens: total.outputTokens + round.outputTokens,
+    totalTokens: total.totalTokens + round.totalTokens,
+  };
+}
