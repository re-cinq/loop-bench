+import {startEngineWith, stopEngines, askAfterConnect, delegatingTo} from './wsTestSupport.js';
+import {InMemorySessionStore} from '../infrastructure/stores/inMemorySessionStore.js';
+import type {SessionListOptions, SessionStore, SessionSummary} from '../types/sessionStore.js';
+import {setLogger} from '../shared/logger.js';
+import {ErrorCodes} from '../types/session.js';
+import type {ConversationCursor} from '../types/messages.js';
+
+interface Frame {
+  type: string;
+  sessionId?: string;
+  conversations?: Array<{sessionId: string; createdAt: string; updatedAt: string; entryCount: number}>;
+  code?: string;
+  message?: string;
+}
+
+const logLines: Array<{level: string; category: string; message: string; fields?: Record<string, unknown>}> = [];
+
+beforeEach(() => {
+  logLines.length = 0;
+  const record = (level: string) => (category: string, message: string, fields?: Record<string, unknown>) =>
+    void logLines.push({level, category, message, fields});
+  setLogger({debug: record('debug'), info: record('info'), warn: record('warn'), error: record('error')});
+});
+
+afterEach(async () => {
+  await stopEngines();
+  setLogger();
+});
+
+const startWithHistory = async (store: SessionStore, userId: string | number = 'u1') => {
+  const {url} = await startEngineWith({
+    sessionStore: store,
+    wsAuth: async () => ({id: userId}),
+    history: {enabled: true},
+  });
+  return url;
+};
+
+describe('listing conversations over the WebSocket protocol', () => {
+  it('answers list_conversations for the authenticated user with ISO dates, forwarding limit and before while ignoring any client userId', async () => {
+    const inner = new InMemorySessionStore();
+    const seen: Array<{userId: string | number; options?: SessionListOptions}> = [];
+    const summaries: SessionSummary[] = [
+      {
+        sessionId: 's2',
+        createdAt: new Date('2026-01-01T00:00:00.000Z'),
+        updatedAt: new Date('2026-01-01T00:02:00.000Z'),
+        entryCount: 4,
+      },
+    ];
+    const store: SessionStore = {
+      ...delegatingTo(inner),
+      listFor: (userId, options) => {
+        seen.push({userId, options});
+        return summaries;
+      },
+    };
+    const url = await startWithHistory(store, 'u1');
+    const before: ConversationCursor = {updatedAt: '2026-01-01T00:05:00.000Z', sessionId: 's3'};
+
+    const {frames} = await askAfterConnect<Frame>(url, {type: 'list_conversations', limit: 10, before, userId: 'u2'});
+
+    expect({seen, frames}).toEqual({
+      seen: [
+        {
+          userId: 'u1',
+          options: {limit: 10, before: {updatedAt: new Date(before.updatedAt), sessionId: before.sessionId}},
+        },
+      ],
+      frames: [
+        {
+          type: 'conversation_list',
+          conversations: [
+            {
+              sessionId: 's2',
+              createdAt: '2026-01-01T00:00:00.000Z',
+              updatedAt: '2026-01-01T00:02:00.000Z',
+              entryCount: 4,
+            },
+          ],
+        },
+      ],
+    });
+  });
+
+  it('answers UNSUPPORTED when the store has no listFor, and SERVER_ERROR with a ws error log when listFor throws', async () => {
+    const inner = new InMemorySessionStore();
+    const {url: withoutList} = await startEngineWith({
+      sessionStore: delegatingTo(inner),
+      history: {enabled: true},
+    });
+    const {url: failingList} = await startEngineWith({
+      sessionStore: {
+        ...delegatingTo(inner),
+        listFor: () => Promise.reject(new Error('database offline')),
+      },
+      history: {enabled: true},
+    });
+
+    const unimplemented = await askAfterConnect<Frame>(withoutList, {type: 'list_conversations'});
+    const failed = await askAfterConnect<Frame>(failingList, {type: 'list_conversations'});
+
+    expect({
+      unimplemented: unimplemented.frames.map(frame => ({type: frame.type, code: frame.code})),
+      failed: failed.frames.map(frame => ({type: frame.type, code: frame.code})),
+      logged: logLines.filter(line => line.level === 'error' && line.category === 'ws'),
+    }).toEqual({
+      unimplemented: [{type: 'error', code: ErrorCodes.UNSUPPORTED}],
+      failed: [{type: 'error', code: ErrorCodes.SERVER_ERROR}],
+      logged: [
+        {
+          level: 'error',
+          category: 'ws',
+          message: expect.any(String),
+          fields: expect.objectContaining({userId: 'u1', error: 'database offline'}),
+        },
+      ],
+    });
+  });
+
+  it('answers UNSUPPORTED when history is not enabled', async () => {
+    const inner = new InMemorySessionStore();
+    const {url} = await startEngineWith({
+      sessionStore: {
+        ...delegatingTo(inner),
+        listFor: () => [],
+      },
+      history: {enabled: false},
+    });
+
+    const {frames} = await askAfterConnect<Frame>(url, {type: 'list_conversations'});
+
+    expect(frames).toEqual([
+      {
+        type: 'error',
+        code: ErrorCodes.UNSUPPORTED,
+        message: expect.any(String),
+      },
+    ]);
+  });
+
+  it('accepts a bare list_conversations frame and rejects a malformed limit or before with INVALID_MESSAGE without calling listFor', async () => {
+    const inner = new InMemorySessionStore();
+    let calls = 0;
+    const store: SessionStore = {
+      ...delegatingTo(inner),
+      listFor: () => {
+        calls += 1;
+        return [];
+      },
+    };
+    const url = await startWithHistory(store);
+    const badFrames = [
+      {type: 'list_conversations', limit: 'ten'},
+      {type: 'list_conversations', limit: 0},
+      {type: 'list_conversations', limit: 201},
+      {type: 'list_conversations', limit: 1.5},
+      {type: 'list_conversations', before: 'not-an-object'},
+      {type: 'list_conversations', before: {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: ''}},
+      {type: 'list_conversations', before: {updatedAt: '2026-01-01T00:00:00.000Z', sessionId: 'a'.repeat(129)}},
+      {type: 'list_conversations', before: {updatedAt: 'not-a-date', sessionId: 's1'}},
+      {type: 'list_conversations', before: {updatedAt: true, sessionId: 's1'}},
+    ];
+
+    const codes: Array<string | undefined> = [];
+    for (const bad of badFrames) {
+      const {frames} = await askAfterConnect<Frame>(url, bad);
+      codes.push(frames[0]?.code);
+    }
+    const {frames: accepted} = await askAfterConnect<Frame>(url, {type: 'list_conversations'});
+
+    expect({codes, accepted, calls}).toEqual({
+      codes: Array(badFrames.length).fill(ErrorCodes.INVALID_MESSAGE),
+      accepted: [{type: 'conversation_list', conversations: []}],
+      calls: 1,
+    });
+  });
+});
