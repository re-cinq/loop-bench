+/** Opens a client that waits for `connected`, sends the `outbound` message and a `ping`, then resolves with all frames received before `pong`. */
+export async function askAfterConnect<T = Record<string, unknown>>(
+  url: string,
+  outbound: unknown
+): Promise<{connected: T; frames: T[]}> {
+  const client = connectClient(url);
+  const frames: T[] = [];
+  let connected: T = {type: ''} as unknown as T;
+  await new Promise<void>(resolve => {
+    client.on('message', raw => {
+      const frame = JSON.parse(String(raw)) as T;
+      switch (frame.type) {
+        case 'connected':
+          connected = frame;
+          client.send(typeof outbound === 'string' ? outbound : JSON.stringify(outbound));
+          client.send(JSON.stringify({type: 'ping', timestamp: 1}));
+          break;
+        case 'pong':
+          resolve();
+          break;
+        default:
+          frames.push(frame);
+      }
+    });
+  });
+  return {connected, frames};
+}
