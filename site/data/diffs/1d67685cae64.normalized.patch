+import {jest} from '@jest/globals';
+import Ajv from 'ajv';
+import {ToolRegistry} from './registry.js';
+
+describe('ToolRegistry input validation', () => {
+  afterEach(() => {
+    jest.restoreAllMocks();
+  });
+
+  it('rejects input omitting a required property and never reaches the executor', async () => {
+    const registry = new ToolRegistry();
+    let reached = false;
+    registry.register(
+      {
+        name: 'send_alert',
+        description: 'Send an alert to a channel',
+        inputSchema: {type: 'object', properties: {channel: {type: 'string'}}, required: ['channel']},
+      },
+      async () => {
+        reached = true;
+        return 'sent';
+      }
+    );
+
+    const response = await registry.execute('send_alert', {});
+
+    expect({reached, rejection: response.result}).toEqual({
+      reached: false,
+      rejection: expect.stringMatching(/input\.channel is required/),
