+import type {AIProvider, MessageChunk, UsageMetadata} from '../types/ai.js';
+import type {ChatSession} from '../types/session.js';
+
+export const TOOL_CALL: MessageChunk = {type: 'tool_use', toolCall: {id: '1', name: 'lookup', input: {}}};
+export const DONE: MessageChunk = {type: 'stop', stopReason: 'end_turn'};
+
+export const usageStop = (stopReason: string, usage?: UsageMetadata): MessageChunk => ({
+  type: 'stop',
+  stopReason,
+  usage,
+});
+
+export const scriptedProvider = (rounds: MessageChunk[][]): AIProvider => {
+  let round = 0;
+
+  return {
+    async *sendMessage(): AsyncGenerator<MessageChunk> {
+      yield* rounds[round++] ?? [];
+    },
+    async generateStructured<T>(): Promise<T> {
+      return {} as T;
+    },
+  };
+};
+
+export const createTestSession = (content = 'Use the tools.'): ChatSession => ({
+  sessionId: 'test-session',
+  userId: 'test-user',
+  entries: [{role: 'user', content, timestamp: '2026-01-01T00:00:00.000Z'}],
+});
