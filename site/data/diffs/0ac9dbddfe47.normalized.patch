+import {createChatOrchestrator} from './chatOrchestrator.js';
+import type {OrchestratorHooks} from './chatOrchestrator.js';
+import {ToolRegistry} from './tools/registry.js';
+import {PromptBuilder} from '../infrastructure/builders/promptBuilder.js';
+import type {UsageMetadata, AggregateUsage} from '../types/ai.js';
+import {scriptedProvider, usageStop, createTestSession, TOOL_CALL} from './orchestratorTestSupport.js';
+
+describe('ChatOrchestrator usage accumulation', () => {
+  const promptBuilder = new PromptBuilder({identity: 'Test.'});
+
+  // specs/hal-engine-config-hooks/spec.md#9
+  it('accumulates usage across multiple rounds', async () => {
+    let capturedUsage: UsageMetadata | undefined;
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_s, _t, usage) => {
+        capturedUsage = usage;
+      },
+    };
+
+    const registry = new ToolRegistry();
+    registry.register({name: 'lookup', description: 'd', inputSchema: {}}, async () => 'r');
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [TOOL_CALL, usageStop('tool_use', {inputTokens: 10, outputTokens: 5, totalTokens: 15})],
+        [{type: 'text', text: 'Done.'}, usageStop('end_turn', {inputTokens: 20, outputTokens: 10, totalTokens: 30})],
+      ]),
+      promptBuilder,
+      registry,
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createTestSession());
+
+    expect(capturedUsage).toEqual({
+      inputTokens: 30,
+      outputTokens: 15,
+      totalTokens: 45,
+    });
+  });
+
+  // specs/hal-engine-config-hooks/spec.md#10
+  it('reports undefined when no rounds report usage', async () => {
+    let capturedUsage: AggregateUsage | undefined | 'not-called' = 'not-called';
+    const hooks: OrchestratorHooks = {
+      afterModelResponse: async (_s, _t, usage) => {
+        capturedUsage = usage;
+      },
+    };
+
+    const orchestrator = createChatOrchestrator(
+      scriptedProvider([
+        [
+          {type: 'text', text: 'Done.'},
+          {type: 'stop', stopReason: 'end_turn'},
+        ],
+      ]),
+      promptBuilder,
+      undefined,
+      {hooks}
+    );
+
+    await orchestrator.processMessage(createTestSession());
+
+    expect(capturedUsage).toBeUndefined();
+  });
+});
